\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"date_unix\":1778781600,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:94\",\"about\":{\"description\":\"Dele Sosimi, the Nigerian-British Afrobeat Ambassador, Musician and Educator, has been at the heart of the global Afrobeat scene since relocating to the UK in 1995. Having started his musical career with Fela Kuti's Egypt 80 band in his teens, he then teamed up with childhood friend Fela's son Femi Kuti (back in the late eighties) to kick start the Positive Force - touring, recording and performing worldwide.\\n\\nOver forty years later, he remains a tireless ambassador for the unique musical movement all over the world. His blend of complex funk grooves, traditional Nigerian music, African percussion and an underlying sense of jazz combines with his virtuoso keyboard skills and rhythmic singing to make him one of the most respected Afrobeat authorities of his era.\\n\\n*“A true master of the form.” - Clash Magazine*\\n\\n*“Organically shimmering with sun-lit horns and synth powered grooves.” ★★★★ - Songlines Magazine*\\n\\n*“Horn fanfares create a typically joyous Afrobeat sound but there are also intriguing experiments into downtempo grooves” -The Guardian*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event. U18s must be accompanied by a full paying adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1766404800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dele Sosimi Afrobeat Orchestra\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/85a30f9c144ed157e7d7b2f43a79750ac2093fc9\"},\"artist_id\":\"8865\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/4bf35ac1-68f8-4bf4-a0a3-c8e0b8837cdc.jpg?rect=0%2C0%2C2835%2C2835\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/4bf35ac1-68f8-4bf4-a0a3-c8e0b8837cdc.jpg?rect=0%2C567%2C2835%2C1701\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/4bf35ac1-68f8-4bf4-a0a3-c8e0b8837cdc.jpg?rect=638%2C0%2C1559%2C2835\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6949321174bdc400015a2075\",\"name\":\"Dele Sosimi Afrobeat Orchestra\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T12:00:00+00:00\",\"sale_end_date\":\"2026-05-14T17:00:00+01:00\",\"sale_start_date\":\"2025-12-22T12:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:00:00+01:00\",\"event_end_date\":\"2026-05-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"oeqmpy-dele-sosimi-afrobeat-orchestra-14th-may-229-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":\"3f08e035-a015-40b4-91bc-aa5e016bbfa1\",\"price\":{\"currency\":\"GBP\",\"amount\":3060,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/ydbe7c8eeae4?dice_id=ydbe7c8eeae4\",\"post_competition_referral\":\"https://link.dice.fm/e5fab4978e0a?dice_id=e5fab4978e0a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/qbe0cb465c21?dice_id=qbe0cb465c21\",\"post_purchase_referral\":\"https://link.dice.fm/B0f8bee5145c?dice_id=B0f8bee5145c\",\"post_reminder_referral\":\"https://link.dice.fm/w74b88160bc1?dice_id=w74b88160bc1\",\"post_waitinglist_referral\":\"https://link.dice.fm/E44633d5f63e?dice_id=E44633d5f63e\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"I Didn't Know\",\"redirect_url\":\"https://open.spotify.com/track/1RI9Qpt8QbYtwfCW8npcO1\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/82ae783c4781bde13630c98c425c5213da51b1f8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I Didn't Know\"}],\"faqs\":[{\"id\":57071,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Live Nation.\",\"billing_promoter\":{\"id\":\"24\",\"name\":\"Live Nation\",\"image\":{\"url\":null},\"perm_name\":\"live-nation-z6d3\",\"profile_active\":true},\"date_unix\":1778781600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"538\",\"name\":\"O2 Shepherds Bush Empire\",\"address\":\"Shepherd's Bush Green, London W12 8TT\",\"location\":{\"lat\":51.5032636,\"lng\":-0.22311579999996},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-shepherds-bush-empire-42ap\",\"accessibility\":{\"url\":\"https://www.academymusicgroup.com/o2shepherdsbushempire/access\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1707,\"name\":\"Live Nation UK\",\"privacy_policy_link\":\"https://www.livenation.co.uk/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:95\",\"about\":{\"description\":\"Metropolis Music Presents\\n\\nSkinshape\\n\\nPlus Special Guests\\n\\nStanding: 8+ (U14 accompanied with an adult Under 14’s must also be seated in the balcony) Seated: 8+ (U14 accompanied with an adult Under 14’s must also be seated in the balcony)\",\"highlights\":[]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"3f08e035-a015-40b4-91bc-aa5e016bbfa1\",\"seats_io_public_key\":\"a695a669-bcc2-43e4-942c-124cc9914f8a\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1763546400,\"seats_io_public_key\":\"a695a669-bcc2-43e4-942c-124cc9914f8a\",\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Skinshape\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-17/3cfbf8ab-8e88-41c4-b039-f288511aa950.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"23724\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-12/5cf2b8ad-6933-4210-b484-9db4a55ab5e5.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-12/5cf2b8ad-6933-4210-b484-9db4a55ab5e5.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-12/5cf2b8ad-6933-4210-b484-9db4a55ab5e5.jpg?rect=180%2C0%2C440%2C800\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6915954a9e4ee300010334b9\",\"name\":\"Skinshape\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T10:00:00+00:00\",\"sale_end_date\":\"2026-05-14T10:00:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:00:00+01:00\",\"event_end_date\":\"2026-05-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"mx5war-skinshape-14th-may-o2-shepherds-bush-empire-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":\"c3674ac5-43ef-4d94-b89b-6c705c8c076e\",\"price\":{\"currency\":\"GBP\",\"amount\":3964,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/t1b4bfd4c40f?dice_id=t1b4bfd4c40f\",\"post_competition_referral\":\"https://link.dice.fm/J2746b1f8cb2?dice_id=J2746b1f8cb2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Dd89d77bca16?dice_id=Dd89d77bca16\",\"post_purchase_referral\":\"https://link.dice.fm/ld72b5d11436?dice_id=ld72b5d11436\",\"post_reminder_referral\":\"https://link.dice.fm/V1145ea732cf?dice_id=V1145ea732cf\",\"post_waitinglist_referral\":\"https://link.dice.fm/m2b67d239f2f?dice_id=m2b67d239f2f\"},\"previews\":[],\"faqs\":[{\"id\":55857,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":55858,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":55859,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":55860,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Action!.\",\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"date_unix\":1778781600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unic