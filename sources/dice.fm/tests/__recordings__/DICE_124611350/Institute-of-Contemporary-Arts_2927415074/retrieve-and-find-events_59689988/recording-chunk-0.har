dia.imgix.net/attachments/2024-10-22/164b893a-b87f-4c1e-acb3-f200153a0a0d.jpg?rect=0%2C67%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-10-22/164b893a-b87f-4c1e-acb3-f200153a0a0d.jpg?rect=634%2C0%2C733%2C1333\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/N940a71d166a?dice_id=N940a71d166a\",\"post_competition_referral\":\"https://link.dice.fm/Z46e0659d01c?dice_id=Z46e0659d01c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B3fd815849e1?dice_id=B3fd815849e1\",\"post_purchase_referral\":\"https://link.dice.fm/E9fb88d7d921?dice_id=E9fb88d7d921\",\"post_reminder_referral\":\"https://link.dice.fm/Hae55f07863b?dice_id=Hae55f07863b\",\"post_waitinglist_referral\":\"https://link.dice.fm/l6f4e891dc60?dice_id=l6f4e891dc60\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:27\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1729551600,\"id\":\"684ac1bd81bc760001f1df37\",\"name\":\"Iago Banet \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Described as ‘a master of the guitar’ by Sean Rafferty, BBC Radio 3 In Tune; as 'nothing short of phenomenal' in a recent review, and as a ‘highly recommended artist’ by Celtic Connections, Iago creates stories without words, enthralling audiences as he does so.\\n\\nIago Banet, ‘The Galician King of Acoustic Guitar’ launched his third album, TRES, in 2023, with a tour which has included multiple sell-out shows and sensational receptions from audiences across the UK. He has showcased his immense talent at festivals including Brecon Jazz, Hellys International Guitar Festival and Aberjazz, displaying new levels of skill, complexity and versatility, whilst fusing styles, ranging from gypsy jazz, blues, Americana, country and dixieland, to swing, pop and folk.\\n\\nAs featured on BBC Radio 2's The Blues Show with Cerys Matthews\\n\\n‘A master of the guitar’, Sean Rafferty, BBC Radio 3\\n\\n‘Fabulous’, Katie Derham, BBC Radio 3\\n\\n‘Highly recommended artist’, DKOS, Celtic Connections 2023\\n\\n‘An absolute genius talent on the guitar... Magical’, Kate Justice, BBC Hereford and Worcester\\n\\n✭✭✭✭ ‘Nothing short of phenomenal’, R'n'R Magazine (new album, TRES, review)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1772377200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T00:00:00+00:00\",\"sale_end_date\":\"2026-03-01T21:00:00+00:00\",\"sale_start_date\":\"2026-01-23T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T17:00:00+00:00\",\"event_end_date\":\"2026-03-01T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dxpp-dydd-gyl-dewist-davids-day-morn-ffrindiau-1st-mar-windmill-brixton-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"MORN - Modern Man\",\"redirect_url\":\"https://open.spotify.com/track/10VAsXITsdLNv3kWjB2Omu\",\"artist\":\"MORN\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8296d905867a15d2bc45fa45c6403aa707cc3234?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Modern Man\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Papa Jupe's T.C.\",\"image\":null,\"artist_id\":\"125585\",\"about\":null,\"is_headliner\":false},{\"name\":\"Slate\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-21/23dd97e7-aa42-4e1a-aa71-5914ef898266.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"68312\",\"about\":null,\"is_headliner\":false},{\"name\":\"MORN\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-31/81226f34-ae08-4abd-9fc0-e4397d8eeedc.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"119176\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":3},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"441\",\"name\":\"Windmill Brixton\",\"address\":\"22 Blenheim Gardens, London SW2 5BZ\",\"location\":{\"lat\":51.454073,\"lng\":-0.122336300000029},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"windmill-brixton-jxdl\",\"accessibility\":{\"url\":\"https://www.windmillbrixton.co.uk/visitor-info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T17:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/86c2f34b-ad23-4f6e-b33d-e14ab481863e.jpg?rect=0%2C0%2C1600%2C1600\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/86c2f34b-ad23-4f6e-b33d-e14ab481863e.jpg?rect=0%2C320%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/86c2f34b-ad23-4f6e-b33d-e14ab481863e.jpg?rect=360%2C0%2C880%2C1600\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Z71f973c3dfb?dice_id=Z71f973c3dfb\",\"post_competition_referral\":\"https://link.dice.fm/r8b7e66b9dd9?dice_id=r8b7e66b9dd9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Kcd02053e420?dice_id=Kcd02053e420\",\"post_purchase_referral\":\"https://link.dice.fm/u3be89fd61bd?dice_id=u3be89fd61bd\",\"post_reminder_referral\":\"https://link.dice.fm/Oc62445b1a6b?dice_id=Oc62445b1a6b\",\"post_waitinglist_referral\":\"https://link.dice.fm/ibd2d6ccdd08?dice_id=ibd2d6ccdd08\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:28\",\"properties\":[],\"presented_by\":\"Presented by Windmill Brixton.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769126400,\"id\":\"69736f85a4ecfb000139da81\",\"name\":\"Dydd Gŵyl Dewi/St David's Day:  MORN & ffrindiau \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"\\\\*\\\\*Dydd Gŵyl Dewi - St David's Day\\\\*\\\\*\\n\\nCelebrating some of the best new bands to come out of Cymru...\\n\\nMORN - return to the windmill playing brand new songs. Expect speed and the end of the world. https://www.instagram.com/morn.band/\\n\\nslate - Every band’s favourite band. A mix of gothic Welsh imagery and immensely powerful guitar. Tense, brooding, full of big and small moments, hypnotic and emotional. https://www.instagram.com/slatecaban/\\n\\nSpit Hood - Digital Welsh hardcore, Spit Hood delivers an insane noise-rap set not to be missed. For fans of Death Grips. https://www.instagram.com/spit_hood/\\n\\nTai Haf Heb Drigolyn - Elusive Welsh Music Prize Nominees, praised as late-contenders for album of the year in 2024 are a Lo-fi Welsh language band from Aberystwyth. Transcendental avant-folk. - https://www.instagram.com/taihafhebdrigolyn/\\n\\nPapa Jupes T.C. - Cardiff’s Papa Jupes TC make their windmill debut with their absurd takes on political commentary and UK culture. Bathe in the milk of Jupe. Join the Taurus. Sleazy as can be. https://www.instagram.com/papajupestc/\\n\\nLouis O’Hara & His Burley Chassis - Former Windmill sound-tech and self-professed ‘leaver of bands’ returns to the windmill after moving back to West Wales, performing a blend of folk and chamber pop with his ‘Burley Chassis’, drawing comparisons to Leonard Cohen and Sparklehorse. https://www.instagram.com/louisoharamusic/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"487\",\"name\":\"Windmill Brixton\",\"image\":{\"url\":null},\"perm_name\":\"windmill-brixton-4mgk\",\"profile_active\":false},\"date_unix\":1772384400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4260},\"unicorn\":true,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"cee8a89b-e8fe-44d9-a62c-ffc970012ac2\",\"seats_io_public_key\":\"176c36bf-8cc0-47b8-b9e4-fe9983743810\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T17:00:00+00:00\",\"sale_end_date\":\"2026-03-01T15:00:00+00:00\",\"sale_start_date\":\"2026-02-06T17:00:00+00:00\",\"event_start_date\":\"2026-03-01T17:30:00+00:00\",\"event_end_date\":\"2026-03-01T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"wwe2vn-less-than-jake-1st-mar-o2-academy-brixton-london-tickets\",\"seats_io_event_id\":\"cee8a89b-e8fe-44d9-a62c-ffc970012ac2\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Science of Selling Yourself Short\",\"redirect_url\":\"https://open.spotify.com/track/1iD0a0plhO55cWEJa5UGcZ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f614ae76b4c9e0ac6e3afe7d7636968e8b9fcc9c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Science of Selling Yourself Short\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"seats_io_public_key\":\"176c36bf-8cc0-47b8-b9e4-fe9983743810\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":74963,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth: 15cm\",\"order\":0},{\"id\":74964,\"title\":\"How tickets work for O2 Academy Brixton? \",\"body\":\"Tickets will be in the O2 Academy Venues app as they’re handling ticket scanning for this event. We will email you when your tickets are available in the app.\\n\\nHow to use your tickets:\\n\\n1\\\\. Get the O2 Academy Venues app: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\\n\\n2\\\\. Sign up using the email you used to purchase your tickets on DICE\\n\\n3\\\\. At the door, show your tickets on the O2 Academy Venues app (not DICE)\",\"order\":1},{\"id\":74965,\"title\":\"How do I download the O2 Academy Venues app?\",\"body\":\"The O2 Academy Venues app is available to download for iOS and Android: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\",\"order\":2},{\"id\":74966,\"title\":\"How do I find my ticket?\",\"body\":\"Your ticket is stored on the “Tickets” section of the O2 Academy Venues app. Simply select where you booked your tickets and log in using the email address you purchased your tickets with.\",\"order\":3},{\"id\":74967,\"title\":\"Can I change my seat?\",\"body\":\"Seats can’t be changed after booking, so please review your selection carefully before checkout.\",\"order\":4},{\"id\":74968,\"title\":\"Do I need to transfer tickets to the rest of my group?\",\"body\":\"Yes, access to the venue requires all members of your group to have their own ticket, so make sure you transfer these in the O2 Academy Venues app before arriving at the venue. Ticket transfer will not be available for this event on DICE.\",\"order\":5},{\"id\":74969,\"title\":\"I can’t make it anymore, can I sell my ticket? \",\"body\":\"DICE Wait list returns are not available for this venue. You must use the O2 Academy Venues app to securely resell your tickets to another fan.\",\"order\":6},{\"id\":74970,\"title\":\"How to book accessible tickets for O2 Academy Brixton\",\"body\":\"More info on accessibility here: https://www.academymusicgroup.com/o2academybrixton/accessibility\",\"order\":7},{\"id\":74971,\"title\":\"How do I travel to the venue?\",\"body\":\"The venue is easily accessible by public transport. There are no parking facilities. Check all local transport routes for the latest information, services and timetables.\\n\\nLocation information and all accessible travel options can be found here: https://www.academymusicgroup.com/o2academybrixton/getting-here\\n\\nPlan ahead and always know how you're going to get home.\",\"order\":8}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Less Than Jake\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb768516690f8c06f29608b827\"},\"artist_id\":\"64420\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Bouncing Souls\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2b2c1b2f838286c0f25a388f\"},\"artist_id\":\"16066\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Aquabats!\",\"image\":null,\"artist_id\":\"108724\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Bar Stool Preachers\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/70108d5270b9d246ec1ae0a630e002fb9d5e6094\"},\"artist_id\":\"12085\",\"about\":null,\"is_headliner\":false}],\"total_artists\":4,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"650\",\"name\":\"