"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-23/9acab333-004e-4935-aa21-98f444495169.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-23/9acab333-004e-4935-aa21-98f444495169.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-23/9acab333-004e-4935-aa21-98f444495169.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"68fa05ebf118ca0001e847ca\",\"name\":\"D:ream\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Things can only get better… and they just did!\\n\\nThe legendary 90s hitmakers D:Ream are back and ready to light up stages across the UK in 2026! Get ready to relive the euphoric energy, uplifting anthems, and unstoppable feel-good vibes that made them one of the decade’s most iconic acts.\\n\\nFrom the smash hit “Things Can Only Get Better” to a back catalogue of dance-pop classics, this is your chance to reunite with fellow fans and experience D:Ream like never before—live, loud, and full of heart.\\n\\nNew Album: 'Do It Anyway' out now\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+, Under 18's accompanied by an adult \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-30T10:00:00+00:00\",\"sale_end_date\":\"2026-05-28T18:00:00+01:00\",\"sale_start_date\":\"2025-10-30T10:00:00+00:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Finn Forster\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-12/1825b33a-fee1-491e-8fd3-4d4d97114cf8.jpg?rect=0%2C0%