eadliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-02/b0c62f64-40e9-44eb-9307-64af03c39e22.jpg?rect=0%2C0%2C3275%2C3275\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-02/b0c62f64-40e9-44eb-9307-64af03c39e22.jpg?rect=0%2C1474%2C3275%2C1965\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-02/b0c62f64-40e9-44eb-9307-64af03c39e22.jpg?rect=287%2C0%2C2702%2C4912\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/P4177eb09084?dice_id=P4177eb09084\",\"post_competition_referral\":\"https://link.dice.fm/Uebf047d6481?dice_id=Uebf047d6481\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/L5b18d38f9b0?dice_id=L5b18d38f9b0\",\"post_purchase_referral\":\"https://link.dice.fm/h91968673816?dice_id=h91968673816\",\"post_reminder_referral\":\"https://link.dice.fm/b514722d6032?dice_id=b514722d6032\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z18be647693a?dice_id=Z18be647693a\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:21\",\"properties\":[],\"presented_by\":\"Presented by Short Waves.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1759482000,\"id\":\"690b6f55a43c3f0001e04d9f\",\"name\":\"Balderdasch + Tina Sandwich + Ziplock\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Short Waves Presents:\\n\\nBalderdasch  is an Irish experimental pop artist based in London.\\n\\nPlayful, unpredictable, and full of sharp turns, her sonic world has been described in live performance as “avant-garde reimagined.” Her debut EP Control the Ending received support from both BBC Introducing and BBC Radio 6, and led to a showcase performance at Ireland Music Week 2025.\\n\\nHer forthcoming EP ‘Stillness Gyrating’ is slated for release in early 2026. The work comprises six wryly humoured tracks that flit between inhibition and intimacy, atop a shifting bed of oddball samples and sounds.\\n\\nTina Sandwich's music is a circus of thunder and theatrics. Fusing classic rocks with all the romp and pomp of synthesised pop. From her rip-roaring debut on the main stage of Scotland's Belladrum festival, to selling out Glasgow's legendary King Tuts, Tina Sandwich and her band kick up a fuss wherever they go.\\n\\nZiplock are synth chaos intertwined with heavy basslines and electrifying rhythms. Featuring members of Fat Dog and born out of London’s Windmill scene\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2