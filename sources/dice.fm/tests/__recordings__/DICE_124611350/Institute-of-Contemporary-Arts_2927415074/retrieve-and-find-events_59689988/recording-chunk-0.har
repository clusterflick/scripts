ttps://www.eventimapollo.com/venue-info/access-requirements/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-06T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/2948184d-aebb-4bbc-ac37-f08fb532237b.jpg?rect=0%2C240%2C960%2C960\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/2948184d-aebb-4bbc-ac37-f08fb532237b.jpg?rect=0%2C432%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/2948184d-aebb-4bbc-ac37-f08fb532237b.jpg?rect=84%2C0%2C792%2C1440\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/e875c66f8286?dice_id=e875c66f8286\",\"post_competition_referral\":\"https://link.dice.fm/E39d66696f18?dice_id=E39d66696f18\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lf42fe02e171?dice_id=lf42fe02e171\",\"post_purchase_referral\":\"https://link.dice.fm/rf62745b3167?dice_id=rf62745b3167\",\"post_reminder_referral\":\"https://link.dice.fm/Xd8b7dabc794?dice_id=Xd8b7dabc794\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ad6a40580d79?dice_id=Ad6a40580d79\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:17\",\"properties\":[],\"presented_by\":\"Presented by Bird On The Wire.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768222800,\"id\":\"6967eec98020980001435f0b\",\"name\":\"Ólafur Arnalds\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**\\\\*\\\\* REMAINING TICKETS AVAILABLE FROM VENUE AT https://www.eventim.co.uk/artist/olafur-arnalds/ \\\\*\\\\***\\n\\nFalling Apart Together  \\n19 attempts at dismantling the distance  \\nA live experience by Ólafur Arnalds\\n\\n- Award-winning artist, composer and producer Ólafur Arnalds returns with his most daring and adventurous project to date.\\n\\nFalling Apart Together is an attempt at dismantling the distance between us. A concert hybrid that reveals the layers we construct in order to feel safe, the moments in which those layers tremble and the shared humanity that emerges when we allow ourselves to be exposed.\\n\\nTogether with his team of devoted craftsmen and musicians, Ólafur presents a spellbinding blend of past and new material in a show that challenges the boundaries of what a concert can be.\\n\\nAfter his globally acclaimed tours following re:member and some kind of peace — which sold out such iconic halls as Royal Albert Hall, Elbphilharmonie, Sydney Opera House, and Walt Disney Concert Hall – performing to hundreds of thousands of fans worldwide — Ólafur returns with his most intimate and boundary-pushing work to date.\\n\\nFalling Apart Together explores what becomes possible when we let ourselves unravel just enough to collectively open up.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"3+ only (under 15s must be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"112\",\"name\":\"Bird On The Wire\",\"image\":{\"url\":null},\"perm_name\":\"bird-on-the-wire-jqo9\",\"profile_active\":true},\"date_unix\":1791309600,\"event_tag\":null}],\"title\":\"Tue 06 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_ha