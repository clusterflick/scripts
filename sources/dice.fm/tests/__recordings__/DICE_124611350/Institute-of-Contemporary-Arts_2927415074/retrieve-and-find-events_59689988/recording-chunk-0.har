ris'.\\n\\nSub Zero has been described by BOOMKAT as \\\"A slow-burn blizzard of white-out atonalities..RIYL Thomas Köner, Mika Vainio’s elemental Ø works, or GAS, gone noxious.\\\" And has already been made album of the week by BLEEP, BOOMKAT and NORMAN RECORDS on pre-order.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T13:00:00+00:00\",\"sale_end_date\":\"2026-05-30T19:30:00+01:00\",\"sale_start_date\":\"2026-02-03T13:00:00+00:00\",\"event_start_date\":\"2026-05-30T19:30:00+01:00\",\"event_end_date\":\"2026-05-30T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Kevin Richard Martin - Destroyed\",\"redirect_url\":\"https://music.apple.com/us/album/destroyed/1870239851?i=1870239865&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kevin Richard Martin\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/7b/25/3c/7b253c7a-86de-78e3-7a76-a6ffb9c6349a/mzaf_10221719646346779239.plus.aac.p.m4a\",\"track_name\":\"Destroyed\"},{\"type\":\"spotify\",\"title\":\"Kevin Richard Martin - Destroyed\",\"redirect_url\":\"https://open.spotify.com/track/4Yb4OmEI9UErDRvTYoZGee\",\"artist\":\"Kevin Richard Martin\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2e237c314d21ee09a2c20a3444e711f57b9aabfa?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Destroyed\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Recondite\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb37413a0389f25a9cf22870eb\"},\"artist_id\":\"220\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by E1 London.\",\"tty_to_extras\":[],\"is_ticket_available