logies.\\n\\nExpect loud guitars, crowd chaos, and the songs you forgot you knew every word to.\\n\\nThis is not a nostalgia act — this is a full-throttle emo revival.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771617600,\"venues\":[{\"id\":\"15346\",\"name\":\"The Castle\",\"address\":\"1 Castle Street, Luton, LU1 3AA, United Kingdom\",\"location\":{\"lat\":51.87773,\"lng\":-0.41441},\"image\":null,\"city\":{\"id\":\"61e9810a0ee924eb5436541c\",\"name\":\"Luton\",\"location\":{\"lat\":51.879768,\"lng\":-0.415161,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-castle-v3vq7\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T20:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:65\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"128716\",\"name\":\"The Castle\",\"image\":{\"url\":null},\"perm_name\":\"the-castle-yk97v\",\"profile_active\":false},\"id\":\"6971e586800edb000106ae89\",\"name\":\"Thunderlips\",\"perm_name\":\"g5dmka-thunderlips-20th-feb-the-castle-luton-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/18d4aedb-3fb5-475b-9b2f-218829ff1e10.jpg?rect=111%2C0%2C846%2C846\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/18d4aedb-3fb5-475b-9b2f-218829ff1e10.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/18d4aedb-3fb5-475b-9b2f-218829ff1e10.jpg?rect=243%2C0%2C594%2