exts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/65fa1ef1-5152-4dbe-8b4f-68c509ee1888.jpg?rect=18%2C0%2C1347%2C1347\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/65fa1ef1-5152-4dbe-8b4f-68c509ee1888.jpg?rect=0%2C259%2C1382%2C829\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/65fa1ef1-5152-4dbe-8b4f-68c509ee1888.jpg?rect=321%2C0%2C741%2C1347\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Vermelho Como Brasa\",\"redirect_url\":\"https://open.spotify.com/track/1oX0wU2JFrXznamDuckfP9\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/59e3df825c505f0052020aed3477bd151624fc7a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Vermelho Como Brasa\"},{\"type\":\"apple_music\",\"title\":\"Bike - 1943\",\"redirect_url\":\"https://itunes.apple.com/gb/album/1943/1020827560?i=1020827564&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Bike\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/Music7/v4/e4/a9/b2/e4a9b204-ce82-85a9-533b-3aa5abd875ad/mzaf_6439221938954007446.plus.aac.p.m4a\",\"track_name\":\"1943\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770595200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"***BIKE*** - Formed in 2015 by Julito Cavalcante (guitar & vocals), Diego Xavier (guitar & vocals), Daniel Fumega (drums) and Gil Mosolino (bass).\\n\\nSince the start they have been producing great albums, and now have 6 albums under their belt, “1943” (2015), “Em Busca da Viagem Eterna” (2017), “Their Shamanic Majesties' Third Request” (2018), “Quarto Templo\\\" (2019), “Arte Bruta\\\" (2023) and \\\"Noise Meditations\\\" (2025).\\n\\nThe band has performed more than 500 shows in Brazil, and have toured internationally 5 times with 100 perfomances in the United States, France, Italy, Belgium, Scotland, Wales and festivals such as SXSW (Austin, TX), Treefort Music Fest (Boise, ID), Primavera Sound (Spain), Nox Orae (Switzerland), MIL Lisboa (Portugal) and The Great Escape (England), Good Good Festival (Germany) in addition to being the only Brazilian band to have a single released by the label 30th Century Records, of the celebrated North American producer Danger Mouse.\\n\\nRecently, BIKE recorded its first session at KEXP in Seattle and recorded new songs in Berlin at the Cobra Studio of the psychedelic legend Anton Newcombe.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:3\",\"social_links\":{\"event_share\":\"https://link.dice.fm/M5b9d4f20f79?dice_id=M5b9d4f20f79\",\"post_competition_referral\":\"https://link.dice.fm/zdd71276e263?dice_id=zdd71276e263\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Vd74cfa0a095?dice_id=Vd74cfa0a095\",\"post_purchase_referral\":\"https://link.dice.fm/Y3a36f7729eb?dice_id=Y3a36f7729eb\",\"post_reminder_referral\":\"https://link.dice.fm/gde17d5eb9f7?dice_id=gde17d5eb9f7\",\"post_waitinglist_referral\":\"https://link.dice.fm/dd6d2513917b?dice_id=dd6d2513917b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-08-13T19:30:00+01:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-08-13T19:00:00+01:00\",\"event_end_date\":\"2026-08-13T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP