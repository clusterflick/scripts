image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebba27d7d46be998d7ab13147b\"},\"artist_id\":\"4915\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770804000,\"faqs\":[{\"id\":75673,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3271},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"MF Robots - Come on With the Good Thing\",\"redirect_url\":\"https://open.spotify.com/track/1Std1XXrTFErycRAInB5Er\",\"artist\":\"MF Robots\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b8487284534454157b4755b04309d1e3e11a4780?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Come on With the Good Thing\"},{\"type\":\"apple_music\",\"title\":\"MF Robots - Come on With the Good Thing\",\"redirect_url\":\"https://music.apple.com/us/album/come-on-with-the-good-thing/1828414238?i=1828414252&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"MF Robots\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/ef/7b/3e/ef7b3ed7-b44d-424f-07df-d5d48c2301fa/mzaf_10859942457642647903.plus.aac.p.m4a\",\"track_name\":\"Come on With the Good Thing\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Thu 19 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-11-20T17:00:00+00:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-11-20T18:00:00+00:00\",\"event_end_date\":\"2026-11-20T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Glasswerk\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/p1beca10b91a?dice_id=p1beca10b91a\",\"post_competition_referral\":\"https://link.dice.fm/K779c04f4e92?dice_id=K779c04f4e92\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Vd5ef9001323?dice_id=Vd5ef9001323\",\"post_purchase_referral\":\"https://link.dice.fm/i90301401703?dice_id=i90301401703\",\"post_reminder_referral\":\"https://link.dice.fm/vb8acc590c6d?dice_id=vb8acc590c6d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hd73f4d92ae5?dice_id=Hd73f4d92ae5\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Alive: A Tribute to Pearl Jam – “The World’s Greatest Pearl Jam Tribute”.\\n\\nAlive: A Tribute to Pearl Jam give the most accurate and engaging performance of Pearl Jam’s music you will find anywhere, delivered with the typical Pearl Jam intensity they are renowned for.\\n\\nChoosing songs from the entire Pearl Jam catalogue and some of the covers Pearl Jam themselves play, all culminate in a tribute band that becomes more than just a tribute.\\n\\nAlive: A Tribute to Pearl Jam is the only “International Touring Tribute to Pearl Jam”, firmly establishing themselves as the definitive tribute to the band – completing numerous sold out UK and European tours and headlining major festivals along the way, performing to thousands of dedicated fans from around the world.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Blackout Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795197600,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-20T18:00:00+00:00\",\"doors_close_date\":\"2026-11-20T22:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:23\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"6980a09510ea6e00018852ea\",\"name\":\"ALIVE, A TRIBUTE TO PEARL JAM\",\"perm_name\":\"avpblx-alive-a-tribute-to-pearl-jam-20th-nov-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/cf613856-3e58-41a8-b0f0-af044c77c97b.jpg?rect=228%2C0%2C2045%2C2045\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/cf613856-3e58-41a8-b0f0-af044c77c97b.jpg?rect=0%2C273%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/cf613856-3e58-41a8-b0f0-af044c77c97b.jpg?rect=688%2C0%2C1125%2C2045\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1769990400,\"faqs\":[{\"id\":73653,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73654,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73655,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":2987,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Pearl Jam - Alive\",\"redirect_url\":\"https://open.spotify.com/track/1L94M3KIu7QluZe63g64rv\",\"artist\":\"Pearl Jam\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0eb273fcbf4b6e5c66b88aadd050deb8336a0bff?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Alive\"},{\"type\":\"apple_music\",\"title\":\"Pearl Jam - Alive\",\"redirect_url\":\"https://music.apple.com/us/album/alive/425465247?i=425465319&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Pearl Jam\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/51/70/e5/5170e519-83fd-ec9d-bcb9-c03b14abd032/mzaf_3961506458449912549.plus.aac.p.m4a\",\"track_name\":\"Alive\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-11-20T21:00:00+00:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-11-20T18:30:00+00:00\",\"event_end_date\":\"2026-11-20T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/I40ec98e99d8?dice_id=I40ec98e99d8\",\"post_competition_referral\":\"https://link.dice.fm/Rd37cf241d57?dice_id=Rd37cf241d57\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Dba7923c399c?dice_id=Dba7923c399c\",\"post_purchase_referral\":\"https://link.dice.fm/Ha2892bd59a4?dice_id=Ha2892bd59a4\",\"post_reminder_referral\":\"https://link.dice.fm/f8f50960dae4?dice_id=f8f50960dae4\",\"post_waitinglist_referral\":\"https://link.dice.fm/F4c71827e8b4?dice_id=F4c71827e8b4\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"£1\\\\* from every ticket sold on the tour will be donated to LIVE Trust, protecting, expanding and supporting grassroots music in the UK. \\\\*Subject to taxes\\\\* Charity Number: 121125\\n\\nIf you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":