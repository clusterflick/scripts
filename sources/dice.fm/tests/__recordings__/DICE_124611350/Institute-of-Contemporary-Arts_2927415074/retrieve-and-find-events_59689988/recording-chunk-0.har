\",\"title\":\"Triphop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:ukg\",\"title\":\"Ukg\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban\",\"title\":\"Urban\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_pop\",\"title\":\"Urban pop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_underground\",\"title\":\"Urban underground\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:vikingfolk\",\"title\":\"Viking folk\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:western_swing\",\"title\":\"Western swing\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:world\",\"title\":\"World\",\"subtitle\":\"Gigs\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T10:00:00+00:00\",\"sale_end_date\":\"2026-11-07T19:00:00+00:00\",\"sale_start_date\":\"2025-12-19T10:00:00+00:00\",\"event_start_date\":\"2026-11-07T19:00:00+00:00\",\"event_end_date\":\"2026-11-07T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Columbo Music.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"1a0649dc-cfe0-4f2c-a365-1ea50f5ba8d2\",\"social_links\":{\"event_share\":\"https://link.dice.fm/N8affc4722cd?dice_id=N8affc4722cd\",\"post_competition_referral\":\"https://link.dice.fm/Nae309ac9dd0?dice_id=Nae309ac9dd0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Bc3770032a62?dice_id=Bc3770032a62\",\"post_purchase_referral\":\"https://link.dice.fm/D73b288f16fb?dice_id=D73b288f16fb\",\"post_reminder_referral\":\"https://link.dice.fm/na87764169fe?dice_id=na87764169fe\",\"post_waitinglist_referral\":\"https://link.dice.fm/E485bd9676de?dice_id=E485bd9676de\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Alceu Valença will celebrate eight decades of life in 2026 as he undertakes the largest and most significant European tour of his career.\\n\\nAs one of the most influential artists in Brazil, 80 Sunflowers arrives in London after passing through ten Brazilian capitals. It presents Alceu at the height of his artistry, performing his greatest hits with his trademark energy on stage. Alongside songs such as ‘Anunciação’, ‘Belle de Jour’ and ‘Tropicana’, the show revisits his entire artistic journey, from the very beginning to the present day.\\n\\nThroughout his career, Alceu has become known for cultivating Brazilian and Northeastern sonorities in a contemporary, urban language with irresistible popular appeal.\\n\\nAlceu Valença stars in 80 Sunflowers at Royal Festival Hall, accompanied by Tovinho (keyboards and musical direction), Cássio Cunha (drums), Zi Ferreira (guitar), Nando Barreto (bass), André Julião (accordion), Costinha (flutes). Special Guests: Lui Coimbra (cello) and Natalia Mitre (percussion).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":\"987893cf-bc40-4a74-8eee-5de2ce676631\",\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2089,\"name\":\" The Columbo Group\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"556297964005636\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt