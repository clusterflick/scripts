from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/855a1b8b-0f94-4659-92a4-e76bc0453eab.jpg?rect=0%2C0%2C3999%2C3999\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/855a1b8b-0f94-4659-92a4-e76bc0453eab.jpg?rect=0%2C800%2C3999%2C2399\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/855a1b8b-0f94-4659-92a4-e76bc0453eab.jpg?rect=900%2C0%2C2199%2C3999\"},\"id\":\"698e7bc068765d00017b7ea3\",\"name\":\"Jessie Faulkner\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join Jessie at The Forge at The Lower Third for an intimate evening of music at her first headline show of the year.\\n\\nJessie Faulkner was only 13 when she first performed an original song to her South East London school year. Since then, her debut single has been supported by Jess Iszatt on BBC Introducing, she’s worked closely with Mahogany, and has sold out her last three headline shows.\\n\\nJessie’s music centres around storytelling, framed by honest lyrics and catchy melodies. She captivates her listeners with her personal and distinctive style of writing, creating a special relationship between her and her audience.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T12:00:00+00:00\",\"sale_end_date\":\"2026-04-04T19:30:00+01:00\",\"sale_start_date\":\"2026-02-14T12:00:00+00:00\",\"event_start_date\":\"2026-04-04T19:30:00+01:00\",\"event_end_date\":\"2026-04-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Laurel Halo\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-31/7bb0a57d-f6