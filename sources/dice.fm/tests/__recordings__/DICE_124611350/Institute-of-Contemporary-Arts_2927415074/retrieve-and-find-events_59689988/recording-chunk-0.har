\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/c7d35d44-1c50-4909-853d-df1dde402d74.jpg?rect=368%2C548%2C4687%2C4687\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/c7d35d44-1c50-4909-853d-df1dde402d74.jpg?rect=0%2C1047%2C5235%2C3141\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/c7d35d44-1c50-4909-853d-df1dde402d74.jpg?rect=1178%2C0%2C2879%2C5235\"},\"properties\":[],\"about\":{\"description\":\"**A vibrant blend of afrobeat, folk and jazz.**\\n\\nLed by guitarist and songwriter Nick Rasle, Me and My Friends fuse highlife guitar, rich vocal harmonies, clarinet and cello into a sound that is unmistakably their own.\\n\\nOn stage, they balance laid-back grooves with rhythmic drive, each set flowing effortlessly between listening and dancing.\\n\\nTheir live shows are a joyful, in-the-moment celebration of music, movement and connection.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69402a2988e4a00001429961\",\"name\":\"Me and My Friends\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"All That Is You\",\"redirect_url\":\"https://open.spotify.com/track/5KHB2Ba4QKjYsZHGrlQqNw\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f9d1b54810b1903478109ba986f84443487e5639?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"All That Is You\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Me And My Friends\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb18f7319f63b92904b29070b6\"},\"artist_id\":\"2996\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":20,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T14:00:00+00:00\",\"sale