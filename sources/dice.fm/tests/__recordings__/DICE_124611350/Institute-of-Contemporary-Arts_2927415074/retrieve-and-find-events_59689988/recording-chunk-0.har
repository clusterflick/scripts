cy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-18T20:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"announcement_date_unix\":1769731200,\"social_links\":{\"event_share\":\"https://link.dice.fm/p0cebc191850?dice_id=p0cebc191850\",\"post_competition_referral\":\"https://link.dice.fm/h737815be991?dice_id=h737815be991\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/me897224e60a?dice_id=me897224e60a\",\"post_purchase_referral\":\"https://link.dice.fm/n920c8447255?dice_id=n920c8447255\",\"post_reminder_referral\":\"https://link.dice.fm/l10d97a14fd0?dice_id=l10d97a14fd0\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y0616836531b?dice_id=Y0616836531b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"l8bpgw-daniel-john-martin-trio-gypsy-jazz-legends-18th-apr-toulouse-lautrec-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776544200,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:43\",\"price\":{\"currency\":\"GBP\",\"amount\":3894,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=420%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=663%2C0%2C594%2C1080\"},\"id\":\"697cf4c031e095000111e447\",\"name\":\"Daniel John Martin Trio | Gypsy Jazz Legends\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"World-Class Gypsy Jazz – Direct from Paris\\n\\nExperience a spectacular evening of world-class gypsy jazz as Paris-based violin virtuoso Daniel John Martin joins forces with guitar masters Adrien Moignard and Julien Cattiaux. This one-night-only collaboration delivers incredible technique, irresistible swing and the distinctive spirit of Parisian jazz.\\n\\nDaniel John Martin, Paris-based jazz violinist originally from England, is a leading figure of the international gypsy jazz violin world. Deeply inspired by the lineage of Stéphane Grappelli and Didier Lockwood, his playing combines lyrical elegance, strong swing, and a highly personal improvisational voice.\\n\\nOn guitar, Adrien Moignard stands among the most influential gypsy jazz players of his generation. Rooted in the tradition of Django Reinhardt and renowned for his exceptional technique and advanced harmonic language, he brings a modern, inventive edge to the tradition while maintaining a powerful sense of swing and melodic depth.\\n\\nCompleting the trio, Julien Cattiaux provides the essential rhythmic heartbeat with his impeccable la pompe. A master of gypsy jazz rhythm guitar, his precision, drive, and musical sensitivity create the perfect framework for interaction, groove, and spontaneity.\\n\\nTogether, the trio delivers an intense, elegant, and deeply swinging performance, where virtuosity serves musical conversation and tradition meets contemporary expression.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T00:00:00+00:00\",\"sale_end_date\":\"2026-04-18T20:30:00+01:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-04-18T21:30:00+01:00\",\"event_end_date\":\"2026-04-18T22:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Daniel John Martin, Mayo Hubert, Julien Cattiaux & Claudius Dupont - Levallois Swing\",\"redirect_url\":\"https://music.apple.com/us/album/levallois-swing/1564359146?i=1564359148&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Daniel John Martin, Mayo Hubert, Julien Cattiaux & Claudius Dupont\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/c7/28/54/c728544f-de83-69bc-a75c-8cf3fd388a0e/mzaf_5044543060629089812.plus.aac.p.m4a\",\"track_name\":\"Levallois Swing\"},{\"type\":\"spotify\",\"title\":\"Adrien Moignard - La valse d'Augustine\",\"redirect_url\":\"https://open.spotify.com/track/5mTOIpBYeiFxmMzffumR9S\",\"artist\":\"Adrien Moignard\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fd5caee706141ffdf035f186ce2aa3c96547ddd6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"La valse d'Augustine\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"AMÉMÉ\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-22/01d60afb-e731-43af-bbcc-df80e66830b9.jpg?rect=0%2C342%2C1365%2C1365\"},\"artist_id\":\"28831\",\"about\":null,\"is_headliner\":false},{\"name\":\"NenaHalena\",\"image\":null,\"artist_id\":\"118764\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by E1 London.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properti