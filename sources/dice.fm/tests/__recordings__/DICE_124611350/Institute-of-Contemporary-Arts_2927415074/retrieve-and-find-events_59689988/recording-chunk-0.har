,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1763467200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-03-19T16:00:00+00:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69144303a9f8c300017d8d61\",\"name\":\"Danny Brown\",\"price\":{\"currency\":\"GBP\",\"amount\":4273,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Grown Up\",\"redirect_url\":\"https://open.spotify.com/track/2KrkWcSP0oFWBUZzvj9KjS\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c830a5dfb0b547f1419450aec7c764f2998c9963?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Grown Up\"}],\"faqs\":[{\"id\":56473,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0},{\"id\":57492,\"title\":\"T's&C's\",\"body\":\"1\\\\. Ticket purchases to be limited to six tickets per person.\\n\\n2\\\\. The official and only approved ticketing resale partners of this show are the official resale platform of the ticket platform you bought your ticket from, for example, if you bought Danny Brown tickets from DICE and cannot make it to the show, please use the official DICE fan-to-fan re-sale platform. To remain valid, tickets can only be resold/bought via official platforms. If any tickets are bought or sold through any other platform/company, then the promoter reserves the right to cancel the tickets. The ticket will IMMEDIATELY BECOME INVALID if resold OR OFFERED FOR SALE unless the sale is through our official face-value resale partners.\\n\\n3\\\\. The ticket is a personal, revocable license and, at all times, remains the property of the Promoter. This ticket must be surrendered to the Promoter upon request.\\n\\n4\\\\. The ticket is sold by the Promoter directly to the customer. Any tickets purchased by business or traders in breach of the Terms and Conditions of Ticket Sale will be cancelled.\",\"order\":1}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"pypbnw-lime-garden-19th-mar-moth-club-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773946800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-07/64f5a1e3-024c-4297-a324-518447960e15.jpg?rect=152%2C47%2C1131%2C1131\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-07/64f5a1e3-024c-4297-a324-518447960e15.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-07/64f5a1e3-024c-4297-a324-518447960e15.jpg?rect=324%2C0%2C792%2C1440\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/d9caa13605bf?dice_id=d9caa13605bf\",\"post_competition_referral\":\"https://link.dice.fm/w8102431a5a0?dice_id=w8102431a5a0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C1dd1efbeb