dice_id=gbfd154d562e\",\"post_competition_referral\":\"https://link.dice.fm/h2da8e260fa2?dice_id=h2da8e260fa2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j9ce32308f73?dice_id=j9ce32308f73\",\"post_purchase_referral\":\"https://link.dice.fm/l72a92d86a05?dice_id=l72a92d86a05\",\"post_reminder_referral\":\"https://link.dice.fm/Y530e3a50086?dice_id=Y530e3a50086\",\"post_waitinglist_referral\":\"https://link.dice.fm/K5ff93ad0a43?dice_id=K5ff93ad0a43\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ryane5-make-friends-18th-apr-strongroom-bar-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.com/privacy-policy/\",\"fb_pixel_id\":\"570786809997969\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776537000,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:35\",\"price\":{\"currency\":\"GBP\",\"amount\":1173,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/427bb6ab-1ca8-47b4-bd21-d7ed77ae57fd.jpg?rect=539%2C0%2C2923%2C2923\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/427bb6ab-1ca8-47b4-bd21-d7ed77ae57fd.jpg?rect=0%2C262%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/427bb6ab-1ca8-47b4-bd21-d7ed77ae57fd.jpg?rect=1196%2C0%2C1608%2C2923\"},\"id\":\"693832b5acb17d00018c8fbf\",\"name\":\"Make Friends\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"In 2025 Bristol-based band, Make Friends release their new single 'Hand-Delivered', aspart of their 'How Do You Know?’' EP, set to drop later in the year.\\n\\nThe band were formed after being collectively inspired by the indie-dance-punk of early era Foals' 'Antidotes', and melodic alt-pop of Bombay Bicycle Club. The band continue to bring their fresh take on modern indie music and their debut EP forged fan favourite 'Ellie', followed with a string of singles and a second EP in 2021.\\n\\nMuch of their work was written over various states of lockdown, which supplied a surprisingly creative climate for the band, with lyrics naturally gravitating towards tackling themes of isolation and mental health.\\n\\nTo date, the band have seen strong support from BBC Introducing in the West, with stand-out singles 'Falter' + 'Fever' receiving Radio 1 Airplay, culminating in Make Friends being selected for a live session at the esteemed Maida Vale Studios.\\n\\nWith the help of Ed Nash (Bombay Bicycle Club) at the helm as producer and co-writer, Make Friends' began work on their ‘Loaded Fun’ EP, released in 2024, and continuing to solidify their presence as frontrunners of the UK Indie scene. The EP received further support from Radio 6, BBC Introducing and beyond, with Single ‘Maybe Tomorrow’ being selected as part of their best of 2024 roundup, and lead single ‘Loaded Fun’ appearing on ITV’s FA Cup roundup.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T10:00:00+00:00\",\"sale_end_date\":\"2026-04-18T17:30:00+01:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-04-18T19:30:00+01:00\",\"event_end_date\":\"2026-04-18T23:00:00+01:00