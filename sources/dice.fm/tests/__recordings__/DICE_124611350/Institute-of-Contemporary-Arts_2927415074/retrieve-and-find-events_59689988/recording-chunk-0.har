06\",\"post_competition_referral\":\"https://link.dice.fm/Q232822e39cd?dice_id=Q232822e39cd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B34319724c56?dice_id=B34319724c56\",\"post_purchase_referral\":\"https://link.dice.fm/Ib7426d5be60?dice_id=Ib7426d5be60\",\"post_reminder_referral\":\"https://link.dice.fm/p0bbb713d3fb?dice_id=p0bbb713d3fb\",\"post_waitinglist_referral\":\"https://link.dice.fm/Rf3eb6bfaa27?dice_id=Rf3eb6bfaa27\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The second edition of our Diva Deep Dive series, presenting Tasha.mp4. We’re taking it back to the old skool - one DJ all night - because we do clubbing right. Expect hyperpop, UKG, dub, donk, house, ballroom, vogue, disco, and anything else lurking in the deep, dark vaults of the Diva Dungeon.\\n\\n**About Tasha.mp4**\\n\\nA DJ / Producer / Promoter / Radio Host based in London. She has DJ’d in top London venues such as Fabric, Ministry of Sound, EGG, XOYO & more. As well as all over the UK, in venues such as O2 Academy Liverpool, Leicester, Bournemouth, Engine Rooms Southampton, La Belle Angele Edinburgh & more. She has been booked for festivals such as Reading & Leeds, Boardmasters & more. She DJs a range of electronic music from house to techno, garage and drum and bass. She also has a residency at Swiftogeddon, playing to 1000+ weekly.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\"