.net/attachments/2025-12-09/70927bf7-e3e8-4eae-9132-d705297958c7.jpg?rect=812%2C0%2C937%2C1703\"},\"properties\":[],\"about\":{\"description\":\"Osees play live in London!\\n\\n\\\\+ support tbc\\n\\nThis is a 16+ event. Each under 18 must be accompanied by a responsible adult who is over 21 (1:1 ratio). In order to verify your age, ID may be requested. For this reason, we advise that all customers bring valid ID. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"highlights\":[]},\"id\":\"693824a041ae590001334234\",\"name\":\"Osees\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Thee Oh Sees - COFFIN WAX\",\"redirect_url\":\"https://open.spotify.com/track/3VU1rL4ibDAabhV85agEqx\",\"artist\":\"Thee Oh Sees\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e9a8bdb7305cefa2ebd312dd818c5cbe8fb3045a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"COFFIN WAX\"},{\"type\":\"apple_music\",\"title\":\"Thee Oh Sees - COFFIN WAX\",\"redirect_url\":\"https://music.apple.com/us/album/coffin-wax/1821912379?i=1821912386&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Thee Oh Sees\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/12/90/61/129061c3-d640-b5d6-83b2-fe26667c8d62/mzaf_7853242242397828733.plus.aac.p.m4a\",\"track_name\":\"COFFIN WAX\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Osees\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-30/7b05d339-9429-4ada-8fab-fdb0b578d01f.jpg?rect=214%2C0%2C853%2C853\"},\"artist_id\":\"10031\",\"about\":{\"description\":\"Osees’s eclectic approach to rock music has seen the Los Angeles band create garage, krautrock, psychedelic and punk across 20 albums since the late ’90s. Their live performances are just as fast-paced as their music, featuring a double drummer setup and heavy guitar feedback to intensify their sound.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T00:00:00+00:00\",\"sale_end_date\":\"2026-07-16T00:00:00+01:00\",\"sale_start_date\":\"2026-01-21T00:00:00+00:00\",\"event_start_date\":\"2026-07-16T19:00:00+01:00\",\"event_end_date\":\"2026-07-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"seating\":null,\"announcement_date_unix\":1768953600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-16T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:42\",\"date_unix\":1784224800,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/K8913a5f5eaa?dice_id=K8913a5f5eaa\",\"post_competition_referral\":\"https://link.dice.fm/D4aa543670d5?dice_id=D4aa543670d5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wc12ac908b7e?dice_id=wc12ac908b7e\",\"post_purchase_referral\":\"https://link.dice.fm/Kc749c99dba1?dice_id=Kc749c99dba1\",\"post_reminder_referral\":\"https://link.dice.fm/ab34f47ed87c?dice_id=ab34f47ed87c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Dd68c35694ee?dice_id=Dd68c35694ee\"},\"perm_name\":\"7dpmep-doris-brendel-and-lee-dunham-16th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/5dca8f72-e8a1-4569-af96-1cece4d1393c.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/5dca8f72-e8a1-4569-af96-1cece4d1393c.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/5dca8f72-e8a1-4569-af96-1cece4d1393c.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"You may do a double-take if you see Doris Brendel and her producer and guitarist Lee Dunham in a theatre with a couple of acoustic guitars. The pair have been gracing O2 venues across the country with their full electric band and have embarked on several European tours with both Wishbone Ash and former Marillion frontman Fish over the last few years...\\n\\nUnwilling to go quietly when COVID stamped a huge boot on their tour plans, Doris and Lee have decided that some ‘unplugged’ shows will be their chosen direction of travel. It may not be the theatrical pomp and melodic prog rock of the full band shows, but their acoustic set has been described as “esoteric singer-songwriter with bluesy twist meets charismatic chat and humour” - indeed songs like 'Blue Egg from another Planet' are hard to forget.\\n\\nAfter winning the 2023 HRH PROG ANGEL Award Doris and Lee released 'Big Blue Sky' which went straight in at #2 in the IBBA Blues album charts. Their current and 8th studio project is set to be a 'steam punk Celtic Prog' extravaganza, but the singer has an incredible 21 albums to her name, not to mention a vast catalogue of session work. The daughter of famed classical pianist Alfred Brendel, her distinctive vocals were the driving force behind 1990s alt-rockers The Violet Hour, who were signed to Sony when they released their now revered, classic album ‘The Fire Sermon’ in 1991.\\n\\nDoris has worked with some notable artists over the years, including Alvin Lee, Gary Moore, Sam Brown, Joe Brown and Herbie Flowers, and has toured extensively with Marillion as well as Nils Lofgren, John Farnham and Steve Marriott. She was also invited to sing with Pink Floyd on the Great Gig in the Sky tour, but had to decline due to already-contracted tour commitments. She sang backing vocals on Fish’s acclaimed album ‘Weltschmerz’.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6970f272b7830b00018bfa9d\",\"name\":\"Doris Brendel and Lee Dunham\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Doris Brendel & Lee Dunham - Red Letter Blues\",\"redirect_url\":\"https://music.apple.com/us/album/red-letter-blues/1795453386?i=1795453393&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Doris Brendel & Lee Dunham\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/4c/58/ff/4c58ff5d-33ad-49dc-48ca-671ad7e6e633/mzaf_5833334009725440093.plus.aac.p.m4a\",\"track_name\":\"Red Letter Blues\"},{\"type\":\"spotify\",\"title\":\"Doris Brendel - Red Letter Blues\",\"redirect_url\":\"https://open.spotify.com/track/1ZeqOy8XhmsjT793JjECOO\",\"artist\":\"Doris Brendel\",\"preview_url\":\"https://p.scdn.co/mp3-preview/83f44c97bfba13b5385e735edcb4ef4f3c61c2c8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Red Letter Blues\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Doris Brendel\",\"image\":null,\"artist_id\":\"132672\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T10:00:00+00:00\",\"sale_end_date\":\"2026-07-16T12:00:00+01:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-07-16T19:30:00+01:00\",\"event_end_date\":\"2026-07-16T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":1446,\"name\":\"Serious\",\"privacy_policy_link\":\"https://serious.org.uk/serious-ticketing-t-cs\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":\"9f9a81c3-5ba9-4213-a779-1c06af17c5f7\",\"presented_by\":\"Presented by Serious.\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"9f9a81c3-5ba9-4213-a779-1c06af17c5f7\",\"seats_io_public_key\":\"c36ada6d-6a62-4ea4-b2e3-d77a8688f68b\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1764064800,\"venues\":[{\"id\":\"605\",\"name\":\"Cadogan Hall\",\"address\":\"5 Sloane Terrace, London SW1X 9DQ\",\"location\":{\"lat\":51.4936625,\"lng\":-0.157574299999965},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-03/51395a8d-8b02-4ea1-9bcc-d92897eb2cd7.jpg?rect=48%2C0%2C470%2C470\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"cadogan-hall-g55p\",\"accessibility\":{\"url\":\"https://cadoganhall.com/your-visit/access-information/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-16T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":\"c36ada6d-6a62-4ea4-b2e3-d77a8688f68b\",\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1432\",\"name\":\"Serious\",\"image\":{\"url\":null},\"perm_name\":\"serious-nyo9\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:43\",\"date_unix\":1784226600,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3850},\"social_links\":{\"event_share\":\"https://link.dice.fm/t26ba4f3f774?dice_id=t26ba4f3f774\",\"post_competition_referral\":\"https://link.dice.fm/sed59f8b3bb6?dice_id=sed59f8b3bb6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P07d3f68cead?dice_id=P07d3f68cead\",\"post_purchase_referral\":\"https://link.dice.fm/l5f68ed7e90e?dice_id=l5f68ed7e90e\",\"post_reminder_referral\":\"https://link.dice.fm/z6f06c64e895?dice_id=z6f06c64e895\",\"post_waitinglist_referral\":\"https://link.dice.fm/n4170af188cf?dice_id=n4170af188cf\"},\"perm_name\":\"bbxk5o-stacey-kent-16th-jul-cadogan-hall-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/4ce025b7-31ea-47f8-8442-6f60e1bdf6b1.jpg?rect=1024%2C0%2C4096%2C4096\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/4ce025b7-31ea-47f8-8442-6f60e1bdf6b1.jpg?rect=0%2C205%2C6144%2C3686\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/4ce025b7-31ea-47f8-8442-6f60e1bdf6b1.jpg?rect=1946%2C0%2C2253%2C4096\"},\"properties\":[],\"about\":{\"description\":\"Stacey Kent is an American jazz singer in the mold of the greats, with a legion of fans and a host of honors and awards including a Grammy nomination, and most recently, the Prix Ella Fitzgerald from the Montreal Jazz Festival.\\n\\nWith Platinum and Gold-selling albums that have reached a series of chart-topping positions, and over half a billion Spotify streams, she has garnered a huge international audience with her delicately nuanced interpretations of standards, chanson, Bossas, and originals.\\n\\nHer unique multilingual repertoire includes originals written by the Nobel Prize-winning author Kazuo Ishiguro in collaboration with her saxophonist/producer/composer/arranger husband, Jim Tomlinson. Their first song, The Ice Hotel, won first prize in the jazz category of the International Songwriting Competition.\\n\\nStacey has also recorded with Brazilian legends Marcos Valle, Roberto Menescal, and Danilo Caymmi, as well as the celebrated French string quartet, the Quatuor Ébène.\\n\\nKent’s new album, A Time for Love, will be released in October 2025. It will reprise her trio collaboration with pianist Art Hirahara and Jim Tomlinson, in an eclectic collection of songs.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 14s must be accompanied by an adult. \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69296666bbd68d000151e74a\",\"name\":\"Stacey Kent\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Stacey Kent\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7773162cc90fc8dfb720fdfe\"},\"artist_id\":\"96682\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Thu 16 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-29T08:00:00+01:00\",\"sale_end_date\":\"2026-07-17T21:00:00+01:00\",\"sale_start_date\":\"2025-10-03T09:30:00+01:00\",\"event_start_date\":\"2026-07-17T17:00:00+01:00\",\"event_end_date\":\"2026-07-17T22:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":47365,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":47366,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":47367,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":47368,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":47369,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":4},{\"id\":47370,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nYou will be subject to bag checks and searches upon arrival. Chairs and other camping equipment are not allowed at the event. A full list of prohibited items can be found in the prohibited items section below.\",\"order\":5},{\"id\":47371,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":6},{\"id\":47372,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"seating\":null,\"announcement_date_unix\":1759129200,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941