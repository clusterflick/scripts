ix\":1774477800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C166%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C326%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=89%2C0%2C622%2C1131\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/vfba35087a39?dice_id=vfba35087a39\",\"post_competition_referral\":\"https://link.dice.fm/w8c209d33636?dice_id=w8c209d33636\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ufe5b3b2ff29?dice_id=ufe5b3b2ff29\",\"post_purchase_referral\":\"https://link.dice.fm/hddbd6018028?dice_id=hddbd6018028\",\"post_waitinglist_referral\":\"https://link.dice.fm/D6c70e41e9b7?dice_id=D6c70e41e9b7\",\"post_reminder_referral\":\"https://link.dice.fm/Ybf3ad2a26ca?dice_id=Ybf3ad2a26ca\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-25T22:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Wednesday Club at Egg London\\n\\nMidweek, done properly.\\n\\nEvery Wednesday, Wednesday Club brings house, tech house, electro and hip hop to Egg London — built for students and anyone looking to switch off and reset before the weekend.\\n\\nDoors open from 22:30 – 04:00, with free entry before midnight plus a free shot when claimed online.\\n\\nExpect solid music all night, a mixed crowd, and selected drinks at £5 across the event.\\n\\nWhether you’re coming straight from uni, work, or just need a midweek release — Wednesday Club keeps things moving without the weekend\\n\\nchaos.\\n\\nEgg London\\n\\n 22:30 – 04:00\\n\\n Free entry before 00:00 + free shot (online claim required) \\n\\nHouse · Tech House · Electro · Hip Hop \\n\\n£5 selected drinks all night\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:92\",\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"presented_by\":\"Presented by EGG.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1717246800,\"dates