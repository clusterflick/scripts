t\":\"https://dice-media.imgix.net/attachments/2026-01-13/40842565-0998-46a3-b1ca-e43263f2b1b7.jpg?rect=175%2C0%2C1699%2C3089\"},\"properties\":[],\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nUS underground rap innovator Xaviersobased returns to London for a headline show at EartH Hall on 2 April 2026. Blending lo-fi trap, distorted beats and internet-era aesthetics, Xaviersobased has become a cult figure in the new wave of US alternative rap.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69666dc9ed07460001e5954d\",\"name\":\" Xaviersobased - Riverside 2.0\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"so based\",\"redirect_url\":\"https://open.spotify.com/track/5vqnlZcdiju6ptWyGAtmpK\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f2ab983674101bafabcefb1c00ae65b3f5641812?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"so based\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"xaviersobased\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-04-11/d1818a4d-a377-4727-9bda-287b1373c929.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"80269\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T17:00:00+00:00\",\"sale_