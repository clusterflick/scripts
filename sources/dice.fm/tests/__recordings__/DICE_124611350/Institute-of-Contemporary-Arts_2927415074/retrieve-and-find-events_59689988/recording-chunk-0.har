inder_referral\":\"https://link.dice.fm/la81e6182f4a?dice_id=la81e6182f4a\",\"post_waitinglist_referral\":\"https://link.dice.fm/aab961f6d0ec?dice_id=aab961f6d0ec\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:85\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770076800,\"id\":\"69820abde6f6930001ff1ba7\",\"name\":\"Waves Crashing and Healees\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Brace yourselves for an enchanting evening of new wave noise-pop courtesy of Waves Crashing and Healees. Washington State’s Waves Crashing were described as “Essential for those into modern shoegaze sounds.” France-based Healees’ sound is “an intoxicating concoction of Neu-esque perpetual motion grooves”. Even Butterflies Make A Sound is delighted to present these superb bands.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1793818800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-05T21:00:00+00:00\",\"sale_end_date\":\"2026-11-04T19:00:00+00:00\",\"sale_start_date\":\"2026-01-05T21:00:00+00:00\",\"event_start_date\":\"2026-11-04T19:00:00+00:00\",\"event_end_date\":\"2026-11-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"yonexv-resonance-open-system-4th-nov-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Resonance open system\",\"image\":null,\"artist_id\":\"28224\",\"about\":{\"description\":\"Formed in 2019, Resonance are a creative collective spotlighting the freshest talent in electronic music, performance and visual art in Essex. A community project, the collective has branched into radio, livestreams and even a record label, and regularly platforms burgeoning DJs and producers as part of its Open System series.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-04T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/X14b0c497ef5?dice_id=X14b0c497ef5\",\"post_competition_referral\":\"https://link.dice.fm/bf6200d5abaa?dice_id=bf6200d5abaa\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/se39925f38e7?dice_id=se39925f38e7\",\"post_purchase_referral\":\"https://link.dice.fm/Kce55b016749?dice_id=Kce55b016749\",\"post_reminder_referral\":\"https://link.dice.fm/W82029f8398c?dice_id=W82029f8398c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Oe8012e43b7e?dice_id=Oe8012e43b7e\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:86\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767646800,\"id\":\"693c9ef693e4d400010ee11c\",\"name\":\"Resonance Open System\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Resonance are a collective based in Essex for the creation and appreciation of electronic music, visual arts and performance. This is an open call to all the electronic music producers of Essex…. It doesn’t matter how much you may have spent on a set of studio headphones or monitors, nothing quite compares to hearing your music in a club on a load soundsystem. So come down with a USB stick with your latest masterpiece on it and we’ll play it back to you at the levels that music deserves to be heard at.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 To be accompanied by an Adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v