,\"artist_id\":\"130203\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gyptian\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe33e5cf7c23d88df6c2243b7\"},\"artist_id\":\"52344\",\"about\":null,\"is_headliner\":false},{\"name\":\"Jada Kingdom\",\"image\":null,\"artist_id\":\"48816\",\"about\":null,\"is_headliner\":false},{\"name\":\"Channel One\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-13/5771abb3-6a40-4372-a095-fa85917dac99.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"75486\",\"about\":null,\"is_headliner\":false},{\"name\":\"Juls\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe3346b12761076dc1764cb3c\"},\"artist_id\":\"19759\",\"about\":null,\"is_headliner\":false}],\"total_artists\":9,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764590400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":8575},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T10:00:00+00:00\",\"sale_end_date\":\"2026-05-25T21:00:00+01:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-05-25T19:00:00+01:00\",\"event_end_date\":\"2026-05-25T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Band on The Wall & Hootananny Brixton \",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Cca46065cc63?dice_id=Cca46065cc63\",\"post_competition_referral\":\"https://link.dice.fm/M1c239e7d4d2?dice_id=M1c239e7d4d2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ye058fc71c5e?dice_id=Ye058fc71c5e\",\"post_purchase_referral\":\"https://link.dice.fm/s95ab8240acb?dice_id=s95ab8240acb\",\"post_reminder_referral\":\"https://link.dice.fm/a8463bca4fb0?dice_id=a8463bca4fb0\",\"post_waitinglist_referral\":\"https://link.dice.fm/P3daa66ca9d9?dice_id=P3daa66ca9d9\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Paris-based eight-piece disco-funk band Cotonete return to the UK for the first time in two years.\\n\\nCotonete built their reputation through a series of rare singles and collaborations, notably with Dimitri from Paris, before releasing their first album in 15 years, Super-Vilains, in 2019 on Heavenly Sweetness. That record’s moody grooves and live shows across France and the UK—especially their Dingwalls appearance hosted by Gilles Peterson and Patrick Forge—cemented their reputation. Along the way, a creative connection with Brazilian legend Di Melo produced Atemporal, an eight-track blend of funk and Brazilian soul later sampled by Drake on his 2023 album For All the Dogs Scary Hours Edition.\\n\\nRolling into 2024, the band returned with their second full-length album, Victoire de la Musique, guided by producer Guts. The album celebrates global rhythms and playful energy, drawing inspiration from 70s French cinema and jazz-funk scenes worldwide. Tracks like Venezuela and Cinq Pour L’aventure showcase their adventurous spirit, while guests such as Sabrina Malheiros (on a Jorge Ben cover), Leron Thomas, Omar, and Gystere Peskine add rich international textures. With its fusion of Brazilian, Caribbean, and soul influences, Victoire de la Musique stands as both homage and manifesto—a vibrant “victory of music” uniting diverse sounds, cultures, and generations.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\