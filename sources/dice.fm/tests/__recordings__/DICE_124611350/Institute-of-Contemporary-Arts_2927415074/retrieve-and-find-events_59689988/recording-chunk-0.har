fm/L75367e9acbc?dice_id=L75367e9acbc\"},\"perm_name\":\"6dnalq-faraquet-21st-jul-the-lexington-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/9450f232-90ed-4dc6-a342-6dfe76a5cd09.jpg?rect=21%2C0%2C829%2C829\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/9450f232-90ed-4dc6-a342-6dfe76a5cd09.jpg?rect=0%2C55%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/9450f232-90ed-4dc6-a342-6dfe76a5cd09.jpg?rect=372%2C0%2C456%2C829\"},\"properties\":[],\"about\":{\"description\":\"FORM Presents\\n\\nFARAQUET\\n\\n\\\\+ Special Guests\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6977986f62df1000018bf1cf\",\"name\":\"Faraquet\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Faraquet\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-18/3a5b2482-2b9b-477d-be21-74227f34b961.jpg?rect=0%2C202%2C1000%2C1000\"},\"artist_id\":\"122999\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-07-21T21:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-07-21T19:00:00+01:00\",\"event_end_date\":\"2026-07-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Live Nation.\",\"seating\":null,\"announcement_date_unix\":1769508000,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-21T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:60\",\"date_unix\":1784656800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3354},\"social_links\":{\"event_share\":\"https://link.dice.fm/w889a12fba5b?dice_id=w889a12fba5b\",\"post_competition_referral\":\"https://link.dice.fm/S9e7e1129d02?dice_id=S9e7e1129d02\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Uf18e591ef18?dice_id=Uf18e591ef18\",\"post_purchase_referral\":\"https://link.dice.fm/U00678d76b71?dice_id=U00678d76b71\",\"post_reminder_referral\":\"https://link.dice.fm/td665d1a9d13?dice_id=td665d1a9d13\",\"post_waitinglist_referral\":\"https://link.dice.fm/ed765dd2ab39?dice_id=ed765dd2ab39\"},\"perm_name\":\"g5kmbb-vanessa-carlton-21st-jul-islington-assembly-hall-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/e7b769c7-c7ce-4b09-bb45-0d423626e856.jpg?rect=0%2C1014%2C4472%2C4472\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/e7b769c7-c7ce-4b09-bb45-0d423626e856.jpg?rect=0%2C1909%2C4472%2C2683\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/e7b769c7-c7ce-4b09-bb45-0d423626e856.jpg?rect=449%2C0%2C3575%2C6500\"},\"properties\":[],\"about\":{\"description\":\"*Vanessa Carlton continues to expand creatively as an artist as seen in her upcoming seventh studio album Veils produced. Through her songs, Vanessa invites listeners to explore the Veils in their own lives. Which Veil are you lifting? Which Veil are you putting on?*\\n\\n*Carlton has constantly challenged both herself and the expectations that surround her throughout her lengthy, accomplished career: she was discovered as a singer-songwriter/pianist when a cassette tape demo was given to legendary music impresario Ahmet Ertegun. With her debut single \\\"A Thousand Miles,\\\" Carlton soared to the top of the Billboard charts and garnered multiple Grammy nominations, and continues to captivate audiences across generations as well as genres.*\\n\\n*Though “A Thousand Miles” is only a small fraction of her body of work and artistic identity, as she continues to evolve as a performer and songwriter.*\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6939bda7e837840001ef9b55\",\"name\":\"Vanessa Carlton\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Vanessa Carlton - A Thousand Miles\",\"redirect_url\":\"https://music.apple.com/us/album/a-thousand-miles/1440865939?i=1440865959&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Vanessa Carlton\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/3a/5e/e6/3a5ee615-b992-cba4-c351-419d2c6d1578/mzaf_9680671375190882732.plus.aac.p.m4a\",\"track_name\":\"A Thousand Miles\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/EnbiT00JIl7jt4CJxjOLbUJPpo51Mqquqlll3LYETOSk.m3u8\",\"track_name\":\"\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vanessa Carlton\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-10/03563256-a7cf-4484-bc84-578ff9b0a230.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"131251\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":8,\"event_tag\":null}],\"title\":\"Tue 21 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"