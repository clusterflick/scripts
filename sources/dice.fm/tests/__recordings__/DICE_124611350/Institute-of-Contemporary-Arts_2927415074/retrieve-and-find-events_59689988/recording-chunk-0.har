ice.fm/j11d92e2b020?dice_id=j11d92e2b020\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T27567122069?dice_id=T27567122069\",\"post_purchase_referral\":\"https://link.dice.fm/S6939a9ae401?dice_id=S6939a9ae401\",\"post_reminder_referral\":\"https://link.dice.fm/S23a65d14256?dice_id=S23a65d14256\",\"post_waitinglist_referral\":\"https://link.dice.fm/Vd0af03dd601?dice_id=Vd0af03dd601\"},\"perm_name\":\"yo6wwv-braid-17th-jul-the-dome-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/87bea843-2cc8-4895-8d71-b31027296f4d.jpg?rect=458%2C0%2C1905%2C1905\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/87bea843-2cc8-4895-8d71-b31027296f4d.jpg?rect=0%2C106%2C2821%2C1693\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/87bea843-2cc8-4895-8d71-b31027296f4d.jpg?rect=887%2C0%2C1048%2C1905\"},\"properties\":[],\"about\":{\"description\":\"Oh yes, it’s a big one: seminal US indie-emo outfit Braid at The Dome this July!\\n\\nThe band haven't visited UK shores in 13 YEARS, and we're stoked to host their long-awaited return to London.\\n\\nThe revered Illinois band are widely considereda pillar of second-wave emo, along with similarly influential acts like the Get Up Kids, the Promise Ring and Jimmy Eat World. Having recently celebrated 25 years of their seminal 1997 album Frame & Canvas, Braid remain a vital, restless force in the indie rock scene, their influence echoing loudly as ever.\\n\\nCould you really think of a better band to join them than Hey Mercedes? The band that 3/4s of Braid created following their dissolution in 1999? You could not, and that’s a fact. Hey Mercedes released an EP on Polyvinyl and two albums on Vagrant, playing 359 shows to wide acclaim before they disbanded in 2005 without ever playing the UK. So here we have it, 20 years after they split, we have a London debut. That’s worth the entry price alone.\\n\\nYou know what to do…\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14 + (Under 18s w/ Adult)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6977a476d1ca0400016b92f2\",\"name\":\"Braid\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hey Mercedes\",\"image\":null,\"artist_id\":\"132945\",\"about\":null,\"is_headliner\":false},{\"name\":\"Braid\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-10-10/f5fe93b4-44cd-4614-bf12-3700cd84108c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"87431\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-10T10:00:00+00:00\",\"sale_end_date\":\"2026-07-17T18:00:00+01:00\",\"sale_start_date\":\"2026-01-10T10:00:00+00:00\",\"event_start_date\":\"2026-07-17T19:00:00+01:00\",\"event_end_date\":\"2026-07-17T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Signature Brew.\",\"seating\":null,\"announcement_date_unix\":1768039200,\"venues\":[{\"id\":\"4259\",\"name\":\"Signature Brew Blackhorse Road\",\"address\":\"Unit 15, Uplands Business Park, Blackhorse Ln, Walthamstow, London E17 5QJ, UK\",\"location\":{\"lat\":51.5915931,\"lng\":-0.0428547},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/22392fd6-55c8-436f-b7c7-be53bd36eea2.jpg?rect=420%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-blackhorse-road-wxbg\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-17T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"3591\",\"name\":\"Signature Brew Haggerston\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/cf9f0866-c543-4008-8b08-026157cfb350.jpg\"},\"perm_name\":\"signature-brew-haggerston-3m2g\",\"profile_active\":true},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:49\",\"date_unix\":1784311200,\"price\":{\"currency\":\"GBP\",\"amount\":2020,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Dca95b8f6056?dice_id=Dca95b8f6056\",\"post_competition_referral\":\"https://link.dice.fm/ifd39e6fd187?dice_id=ifd39e6fd187\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G5e7acd61450?dice_id=G5e7acd61450\",\"post_purchase_referral\":\"https://link.dice.fm/k4c3ac3b4cd8?dice_id=k4c3ac3b4cd8\",\"post_reminder_referral\":\"https://link.dice.fm/Tf6c81e1f14f?dice_id=Tf6c81e1f14f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jf614026dda3?dice_id=Jf614026dda3\"},\"perm_name\":\"v3qrll-90s-on-brass-old-dirty-brasstards-london-17th-jul-signature-brew-blackhorse-road-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/29d1aae4-d3f3-4dcc-8166-e75c4ab9b107.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/29d1aae4-d3f3-4dcc-8166-e75c4ab9b107.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/29d1aae4-d3f3-4dcc-8166-e75c4ab9b107.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"90s On Brass - Old Dirty Brasstards | Signature Brew Blackhorse Road\\n\\nGet ready for a massive night of nostalgia as the 10-piece drum and brass powerhouse Old Dirty Brasstards take over Signature Brew Blackhorse Road. Expect high-octane, horn-heavy covers of the ultimate 90s anthems... from the Britpop bangers of Oasis and Blur to the girl power of the Spice Girls and the club classics of Gala and Vengaboys! Experience your favorite decade reimagined with wall-to-wall brass, huge singalongs and the freshest beer in London.\\n\\nhttps://www.instagram.com/olddirtybrasstards\\n\\nSignature Brew Blackhorse Road\\n\\nFriday 17th July 2026 | 7pm doors\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"696146c2bd17020001a95db7\",\"name\":\"90s On Brass - Old Dirty Brasstards | London\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Old Dirty Brasstards - Girls & Boys\",\"redirect_url\":\"https://music.apple.com/us/album/girls-boys/1586431116?i=1586431117&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Old Dirty Brasstards\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/e4/e7/a4/e4e7a4b0-1f27-54f6-f924-c79e53e937be/mzaf_1433312949445035610.plus.aac.p.m4a\",\"track_name\":\"Girls & Boys\"},{\"type\":\"spotify\",\"title\":\"Old Dirty Brasstards - Girls & Boys\",\"redirect_url\":\"https://open.spotify.com/track/5JDK0iSjiLIRZPHm3Ib7Ir\",\"artist\":\"Old Dirty Brasstards\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fde2b56adca71e36fed7ee8578ce66961e78491c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Girls & Boys\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Old Dirty Brasstards\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/de34f9f89566f51dc4e1ef76c4601bea5dcfce69\"},\"artist_id\":\"8315\",\"about\":{\"description\":\"South-east London’s Old Dirty Brasstards are a 10-piece drum and bass band known for their jazzy reimaginations of popular songs. Since emerging in 2012, they’ve covered artists from Beyoncé to Blink-182, opened for Basement Jaxx and performed at the Roundhouse and Ronnie Scott’s.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T16:00:00+00:00\",\"sale_end_date\":\"2026-07-17T17:00:00+01:00\",\"sale_start_date\":\"2025-12-11T09:00:00+00:00\",\"event_start_date\":\"2026-07-17T19:00:00+01:00\",\"event_end_date\":\"2026-07-17T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by EartH.\",\"seating\":null,\"announcement_date_unix\":1765296000,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke 