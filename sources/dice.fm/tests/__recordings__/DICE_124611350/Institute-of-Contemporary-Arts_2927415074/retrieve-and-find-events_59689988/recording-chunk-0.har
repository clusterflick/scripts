ts\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774029600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/ed660289-e52d-498a-b4f2-61f543b4ca02.jpg?rect=0%2C632%2C4760%2C4760\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/ed660289-e52d-498a-b4f2-61f543b4ca02.jpg?rect=0%2C1393%2C4760%2C2856\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/ed660289-e52d-498a-b4f2-61f543b4ca02.jpg?rect=829%2C0%2C3103%2C5642\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/l835f72fa8fb?dice_id=l835f72fa8fb\",\"post_competition_referral\":\"https://link.dice.fm/O9aae4d74ac5?dice_id=O9aae4d74ac5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g7d2e8372b05?dice_id=g7d2e8372b05\",\"post_purchase_referral\":\"https://link.dice.fm/z97ae2be7af5?dice_id=z97ae2be7af5\",\"post_waitinglist_referral\":\"https://link.dice.fm/b4738614f886?dice_id=b4738614f886\",\"post_reminder_referral\":\"https://link.dice.fm/j7564a9cdb80?dice_id=j7564a9cdb80\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-20T18:00:00+00:00\",\"doors_close_date\":\"2026-03-20T22:00:00+00:00\"}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Whether they’re rocking stadiums, making a beeline for the discotheque, or gathering around the campfire, the implicit message of Arkells is always the same: everyone is welcome here. Since the beginning, Arkells have never wavered in their mission to be the house band that soundtracks the greatest nights of your life and provides emotional support in your darkest hours. And that communal spirit is reflected in an ever-evolving sound that hits all the perennial pleasure points—fusing the anthemic power of alt-rock, the pulpit-shaking passion of vintage soul, the off-the-cuff intimacy of singer-songwriter music, the urbane edge of 21st-century indie, and the futurist aesthetics of modern R&B. Thanks to that eclectic ethos, Arkells has continued to evolve, while making everyone feel right at home. As one of the most heavily rotated acts on radio, and all-time record holders of the JUNO Award for “Group of the Year, Arkells have extended their reach beyond borders by infiltrating all corners of pop culture; from global sports telecasts and top-tier video games to the stages of Coachella and Bonnaroo. But the band’s longevity is ultimately a function of their commitment to never coasting on past glories and to always live completely in the moment. Even through their impressive history together, Arkells still approach every gig as an opportunity to prove themselves to the unconverted; as they’re fond of saying, each time they take the stage, “we understand the assignment.” The first rule of rock ‘n’ roll is to play every show like it’s your last—but as Arkells prove night after night, it’s just as important to hold onto the unbridled energy and enthusiasm of your first.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:29\",\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"presented_by\":\"Presented by Live Nation\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Arkells\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebfef53d802e5b5bb9c7e7aa21\"},\"artist_id\":\"35042\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1765274400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T10:00:00+00:00\",\"sale_end_date\":\"2026-03-20T17:00:00+00:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-03-20T18:00:00+00:00\",\"event_end_date\":\"2026-03-20T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"692f689e4510540001a7f164\",\"name\":\"ARKELLS | SOLD OUT\",\"price\":{\"currency\":\"GBP\",\"amount\":2174,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Leather Jacket\",\"redirect_url\":\"https://open.spotify.com/track/3AAtDhdFRnNKJ77kvlMN0J\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/90edc2d719434a7aaeda322eda3e91e920cc9689?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Leather Jacket\"},{\"type\":\"apple_music\",\"title\":\"Arkells - Knocking At the Door\",\"redirect_url\":\"https://music.apple.com/us/album/knocking-at-the-door/1440886868?i=1440886968&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Arkells\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/c0/25/44/c025445b-b1ec-7c14-a8e9-5bd55c589e63/mzaf_9848785672089933163.plus.aac.p.m4a\",\"track_name\":\"Knocking At the Door\"}],\"faqs\":[{\"id\":61174,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":61175,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":61176,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"xekbdk-jack-garratt-20th-mar-koko-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774029600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-15/18ab35dd-a721-49b0-967d-8211f622ec32.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-15/18ab35dd-a721-49b0-967d-8211f622ec32.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-15/18ab35dd-a721-49b0-967d-8211f622ec32.jpg?rect=270%2C0%2C660%2C1200\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/rba9eaadd3bf?dice_id=rba9eaadd3bf\",\"post_competition_referral\":\"https://link.dice.fm/b4f086b96bcf?dice_id=b4f086b96bcf\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zd64693979a5?dice_id=Zd64693979a5\",\"post_purchase_referral\":\"https://link.dice.fm/sc66afe5065e?dice_id=sc66afe5065e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Td6918faff71?dice_i