0\",\"sale_end_date\":\"2026-08-07T14:00:00+01:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-08-08T19:00:00+01:00\",\"event_end_date\":\"2026-08-08T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3248,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"id\":\"692ff7e496fff8000192b6d6\",\"seats_io_event_id\":null,\"name\":\"Kate Ceberano\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"yon76r-kate-ceberano-8th-aug-the-garage-london-london-tickets\",\"date_unix\":1786212000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"590\",\"name\":\"Cafe OTO\",\"address\":\"18-22 Ashwin St, London E8 3DL\",\"location\":{\"lat\":51.5469452,\"lng\":-0.0744654999999739},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"cafe-oto-92e6\",\"accessibility\":{\"url\":\"https://www.cafeoto.co.uk/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-08T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Christina Carter\",\"image\":null,\"artist_id\":\"132739\",\"about\":null,\"is_headliner\":false},{\"name\":\"Jeffrey Alexander + The Heavy Lidders\",\"image\":null,\"artist_id\":\"113651\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-22/bd32ab4d-542a-4145-ab8b-2f0cf7095287.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-22/bd32ab4d-542a-4145-ab8b-2f0cf7095287.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-22/bd32ab4d-542a-4145-ab8b-2f0cf7095287.jpg?rect=563%2C0%2C1375%2C2500\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Jeffrey Alexander and the Heavy Lidders - Carousel of Flowers\",\"redirect_url\":\"https://open.spotify.com/track/1n56CWRHlmPMUYtBh4mP7Z\",\"artist\":\"Jeffrey Alexander and the Heavy Lidders\",\"preview_url\":\"https://p.scdn.co/mp3-preview/37ae0e9272c327001364376de01eed728342a2db?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Carousel of Flowers\"},{\"type\":\"apple_music\",\"title\":\"Jeffrey Alexander and the Heavy Lidders - Carousel of Flowers\",\"redirect_url\":\"https://music.apple.com/us/album/carousel-of-flowers/1570647016?i=1570647023&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Jeffrey Alexander and the Heavy Lidders\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/98/8b/a5/988ba58d-647a-1b27-480d-9cfefefa949a/mzaf_14946585185481553405.plus.aac.p.m4a\",\"track_name\":\"Carousel of Flowers\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769162400,\"max_tickets\":6,\"marketeers\":[{\"id\":20,\"name\":\"Upset The Rhythm\",\"privacy_policy_link\":\"http://www.upsettherhythm.co.uk/privacypolicy.html http://www.upsettherhythm.co.uk/privacypolicy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"JEFFREY ALEXANDER has been frittering around the edges of the psychedelic underground for decades, evolving his own musical space that overlays dusty folk, cosmic jazz, deep psych, free improv, and even (gasp!) indie rock. He’s been called a “psych rock lifer” (UNCUT), crafting “digressive jams that meander through free-form jazz, bluesy kosmische” (PROG) and “extremely highgrade psych” (MOJO). Convened in 2019 on Alexander’s relocation back to his native east coast, Philadelphia’s Heavy Lidders are the latest hard-touring expression for the guitarist’s music, joining a vast and tangled discography (and tape list) that includes the beloved long-running west coast Dire Wolves Just Exactly Perfect Sisters Band and, before them, the Iditarod and Black Forest/Black Sea, as well as a bushel of solo play-all-the-instruments projects, a stint with Jackie-O Motherfucker, sessions with Kemialliset Ystävät and Avarus and others.\\n\\nThe newest studio LP, “Liquid Donnon” (released 12 June 2026 on Riot Season), catches Jeffrey Alexander & The Heavy Lidders at their heaviest, “heavy” in the Lidderverse being far from a monolithic musical idea. There’s heavy like the album-opening “From Loch Raven to Fells Point,” one of several tracks with elegant and gnarled conversational jams featuring the core Lidders lineup of Alexander alongside guitarist Drew Gardner and bassist Jesse Sheppard (both of Elkhorn) and drummer Scott Verrastro (Kohoutek, Bardo Pond). But there’s heavy, too, with tracks where Gardner shifts to dream-space vibraphone, and those with Christina Carter of Texas noise-psych legends Charalambides on veil-crossing wordless vocals, her first collaboration with Alexander in some 20 years. She will indeed be fronting the band on this brief UK tour. For fans of Meat Puppets, Trad Gras och Stenar, Ornette inspired Krautrock, Sonny + Linda Sharrock, Jerry - Jorma interplay, SPACE.\\n\\nhttps://jeffreyalexander.bandcamp.com/\\n\\nCHRISTINA CARTER was born in the bayou city of Houston, Texas in November of 1968, and co-founded the group Charalambides there in December of 1991. Ever since she has deeply mined her own vein of sound-as-music with voice, guitar, harmonica, and piano. For the past several years, Christina has utilized extended improvisational guitar passages within and without song structures and investigated 'the song' as a thing unto itself, specifically concentrating on 'the word'- both in her own lyric writing and her interpretations of the work of other lyricists. In addition to performing extensively in the US, UK and Europe as a solo artist, Christina has played and recorded in various groups and duos with Jeffrey Alexander, Maria Chavez, Loren Connors, Spencer Dobbs, Sandy Ewen, Julia Hungerford, Alistair Lingren, and Joe McPhee, amongst others.\\n\\nConcurrent with her work as a musician, Christina has expanded her involvement in writing and visual art. Her poetry has been published by Digitalis Industries, The Ecstatic Peace Poetry Journal, Glass Eye, Slow Toe, and Shelter Press. In 2007, her art piece Forever 21 appeared at Salon Mijangos in San Antonio, Texas as part of a concert/exhibit featuring Tom Carter, Warmer Milks, and Tetuzi Akiyama. Forever 21 was a labor of love and destruction: six of her handwritten diaries cut up painstakingly with scissors into miniscule pieces, which then filled a large yellow plastic shopping bag. In 2024, Unifactor published For Want Of Walls, Christina’s book of personal yet abstracted writing and watercolor paintings. Christina currently resides in Austin, Texas. Her latest release is the solo voice, guitar and accordion album Like A Bayou To Its Gulf (Bud Tapes 2025).\\n\\nhttps://christinacarter.bandcamp.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Upset The Rhythm.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:1\",\"social_links\":{\"event_share\":\"https://link.dice.fm/o2de2187b610?dice_id=o2de2187b610\",\"post_competition_referral\":\"https://link.dice.fm/O69ac59c12f7?dice_id=O69ac59c12f7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H06ce6d02a95?dice_id=H06ce6d02a95\",\"post_purchase_referral\":\"https://link.dice.fm/Fb58a6485a4c?dice_id=Fb58a6485a4c\",\"post_reminder_referral\":\"https://link.dice.fm/T580928a21e4?dice_id=T580928a21e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/J4adcdfad5a0?dice_id=J4adcdfad5a0\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T10:00:00+00:00\",\"sale_end_date\":\"2026-08-08T18:00:00+01:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-08-08T19:30:00+01:00\",\"event_end_date\":\"2026-08-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1377,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"34\",\"name\":\"Upset The Rhythm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/42ef555c-26cf-421b-b66e-2030c1977b0c.jpg\"},\"perm_name\":\"upset-the-rhythm-z8e2\",\"profile_active\":true},\"id\":\"69720871a5a94d000177cc63\",\"seats_io_event_id\":null,\"name\":\"JEFFREY ALEXANDER & THE HEAVY LIDDERS + CHRISTINA CARTER \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8b5ll-jeffrey-alexander-the-heavy-lidders-christina-carter-8th-aug-cafe-oto-london-tickets\",\"date_unix\":1786213800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 08 Aug\",\"image\":null,\"key\":null,\"action\":null,