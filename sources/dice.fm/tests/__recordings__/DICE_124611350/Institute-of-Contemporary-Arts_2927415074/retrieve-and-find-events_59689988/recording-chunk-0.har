01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kim Carnie\",\"image\":null,\"artist_id\":\"127556\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Kings Place.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-28T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"announcement_date_unix\":1759489200,\"social_links\":{\"event_share\":\"https://link.dice.fm/w74f239e3d0a?dice_id=w74f239e3d0a\",\"post_competition_referral\":\"https://link.dice.fm/S0ca44213c61?dice_id=S0ca44213c61\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b61ad3a0210a?dice_id=b61ad3a0210a\",\"post_purchase_referral\":\"https://link.dice.fm/ef06aa9ec5a4?dice_id=ef06aa9ec5a4\",\"post_reminder_referral\":\"https://link.dice.fm/T878fa507399?dice_id=T878fa507399\",\"post_waitinglist_referral\":\"https://link.dice.fm/abb4d7cb93dc?dice_id=abb4d7cb93dc\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bbyx6v-kim-carnie-28th-may-kings-place-hall-two-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1779993000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:20\",\"price\":{\"currency\":\"GBP\",\"amount\":2402,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-13/ee68ee83-2868-4dc1-a6a3-a36589b94620.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-13/ee68ee83-2868-4dc1-a6a3-a36589b94620.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-13/ee68ee83-2868-4dc1-a6a3-a36589b94620.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"68ef69fe44f9a10001a5e3ee\",\"name\":\"Kim Carnie\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"***Celebrated for her “velvet-voiced authority” (The Scotsman), Carnie blends traditional Gaelic roots with cinematic, contemporary soundscapes. One of Scotland’s most compelling musical voices, performing with her own band, as well as the lead singer of the multi-award-winning band Mànran and a founding member of the experimental folk ensemble Staran.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nRenowned for her passion for cultural collaboration, Kim Carnie has worked with a diverse range of celebrated artists across the globe. These include Malian griot supergroup Trio Da Kali, GRAMMY-nominated kora players Seckou Keita and Kadialy Kouyate, Basque trio Kalakan, Creole musician Cedric Watson, and the Indonesian National Orchestra, TRUST. She has also shared the stage with folk icons such as Carlene Carter, Lindsay Lou, and Joshua Burnside while touring with the prestigious Transatlantic Sessions, led by sixteen-time GRAMMY winner Jerry Douglas.\\n\\nHer original compositions have been commissioned by the Edinburgh Storytelling Centre, the Blas Festival, Piping Live, multiple gaming companies, and the 35-time award-winning documentary *Kim Carnie: Out Loud*. Following the critical success of her debut solo album *And So We Gather*, produced by Donald Shaw, Kim returns with her highly anticipated second release, *A’ Chailleach* – a bold new chapter in her artistic evolution.\\n\\n***This event will last approximately 2 hours, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-03T12:00:00+01:00\",\"sale_end_date\":\"2026-05-28T15:00:00+01:00\",\"sale_start_date\":\"2025-10-03T12:00:00+01:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Puma Blue\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-24/bae1483e-02b5-44a5-81ce-04e38d4c1a0a.jpg?rect=1%2C0%2C3574%2C3574\"},\"artist_id\":\"4429\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by FORM.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":50633,\"title\":\"What are the ages restrictions for this event?\",\"body\":\"This is a 16+ event. Each 16 - 17 year old must be accompanied by a responsible adult 18+ (1:1 ratio). Customers may be requested to provide a valid ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-28T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"announcement_date_unix\":1761058800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Tfa75ff83ebb?dice_id=Tfa75ff83ebb\",\"post_competition_referral\":\"https://link.dice.fm/de439e584cd9?dice_id=de439e584cd9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n0f9a4e31348?dice_id=n0f9a4e31348\",\"post_purchase_referral\":\"https://link.dice.fm/ne5e4cb15ca5?dice_id=ne5e4cb15ca5\",\"post_reminder_referral\":\"https://link.dice.fm/c0f849979d05?dice_id=c0f849979d05\",\"post_waitinglist_referral\":\"https://link.dice.fm/a2b720f78dff?dice_id=a2b720f78dff\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"xekm2k-puma-blue-28th-may-village-underground-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1779993000,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:21\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2704},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/fa6ba86c-4eb7-42ba-8186-33e5d2fe76d8.jpg?rect=0%2C776%2C4672%2C4672\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/fa6ba86c-4eb7-42ba-8186-33e5d2fe76d8.jpg?rect=0%2C1711%2C4672%2C2803\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/fa6ba86c-4eb7-42ba-8186-33e5d2fe76d8.jpg?rect=625%2C0%2C3423%2C6224\"},\"id\":\"68ee243a3b6cb80001062524\",\"name\":\"Puma Blue\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"If you knew how and when you were going to die, how would it change how you decided to live? With today’s announcement of his forthcoming studio record, Croak Dream (out February 6, 2026 via Play It Again Sam), South-London born, Atlanta-based artist Puma Blue – the alias of Jacob Allen – explores the philosophical question through daring lyrical content and bold production, gesturing toward his love of trip-hop, dub techno, jungle and forward-thinking electronic music.\\n\\nAlongside the announcement, Puma Blue also shares details of a world tour, as well as the lead single and music video “Desire”. Originally written & recorded in a hotel room, the raw, visceral sound of “Desire” went on to inspire the entirety of Croak Dream’s sonic landscape.\\n\\n“I didn’t have microphones with me or anything,” shares Allen about the early creation of the track. “I ended up embracing the raw sound of my guitar recorded with my phone, no amplification. I meant to re-dub it later, but I actually fell in love with how visceral it sounded unplugged, and so I left it as it was.\\n\\nThis approach snowballed into an appetite for these gritty and ugly sounds clashing with something more lucid and dream-like. Sometimes I feel like my music has been chronically shy and so with this song, it just felt time to be bold, let it all hang out, throw the paint around. A lot of recent songs have started this way, lonely and reaching for the guitar the way I did when I was a kid, a sort of old friend. Just using whatever limited tools within my reach. I taught myself guitar on an electric as a teenager and for years we didn’t have a guitar amp, so it felt kind of full circle for me.\\n\\nAs for the lyrics, I’m a lover asking his partner to bed, craving what she wants. It’s just a love song really. But with jungle breaks\\\"\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-21T16:00:00+01:00\",\"sale_end_date\":\"2026-05-28T21:00:00+01:00\",\"sale_start_date\":\"2025-10-24T10:00:00+01:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"(She's) Just a Phase\",\"redirect_url\":\"https://open.spotify.com/track/0NfKkSlUJWTbECFqrO0bp1\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3ce99b68138e6ff5f15db456ba5b7f2ef8491a05?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"(She's) Just a Phase\"},{\"type\":\"apple_music\",\"title\":\"Puma Blue - Opiate\",\"redirect_url\":\"https://music.apple.com/gb/album/opiate/1530464694?i=1530464840&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Puma Blue\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/f6/d0/67/f6d067e7-5f6b-cbd7-ed05-7f2ed0e4779b/mzaf_4792892109436070666.plus.aac.p.m4a\",\"track_name\":\"Opiate\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Thu 28 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pintglass\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb4d30948e45653bb76755c784\"},\"artist_id\":\"24515\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Action!\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":73089,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73090,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73091,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T18:00:00+01:00\",\"doors_close_date\":\"2026-05-29T22:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1769767200,\"social_links\":{\"event_share\":\"https://link.dice.fm/Sd69afebae4c?dice_id=Sd69afebae4c\",\"post_competition_referral\":\"https://link.dice.fm/Yedaaa2804ab?dice_id=Yedaaa2804ab\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qf613311ed79?dice_id=Qf613311ed79\",\"post_purchase_referral\":\"https://link.dice.fm/e542d7e32538?dice_id=e542d7e32538\",\"post_reminder_referral\":\"https://link.dice.fm/Hf46c29dce6d?dice_id=Hf46c29dce6d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Sf9ca65b85a0?dice_id=Sf9ca