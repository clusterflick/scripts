ckboy\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"INFINITY FARM PRESENTS\\n\\nITALIA 90\\n\\nTANZ AKADEMIE\\n\\nKICKBOY\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T20:00:00+00:00\",\"sale_start_date\":\"2025-12-22T00:00:00+00:00\",\"event_start_date\":\"2026-03-12T20:00:00+00:00\",\"event_end_date\":\"2026-03-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Italia 90 - Keeping My Hands Clean\",\"redirect_url\":\"https://open.spotify.com/track/1K5xfowo03Ig0e32uMBspJ\",\"artist\":\"Italia 90\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ddb1c1af7e66b00e0a031bc62f51150b1a80651e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Keeping My Hands Clean\"},{\"type\":\"apple_music\",\"title\":\"Italia 90 - Keeping My Hands Clean\",\"redirect_url\":\"https://music.apple.com/us/album/keeping-my-hands-clean/1246263648?i=1246263666&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Italia 90\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/64/36/63/643663db-ff64-4368-545e-9d9367dc75b5/mzaf_1662381345779348256.plus.aac.p.m4a\",\"track_name\":\"Keeping My Hands Clean\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Royal Albert Hall.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"8368\",\"name\":\"Elgar Room at Royal Albert Hall\",\"address\":\"Elgar Room at Royal Albert Hall\",\"location\":{\"lat\":51.501267,\"lng\":-0.17754},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"elgar-room-at-royal-albert-hall-da6q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-12T21:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2558\",\"name\":\"Royal Albert Hall\",\"image\":{\"url\":null},\"perm_name\":\"royal-albert-hall-8m2r\",\"profile_active\":false},\"announcement_date_unix\":1766361600,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ie6f81c59290?dice_id=Ie6f81c59290\",\"post_competition_referral\":\"https://link.dice.fm/A99dc453f580?dice_id=A99dc453f580\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e807f86244ed?dice_id=e807f86244ed\",\"post_purchase_referral\":\"https://link.dice.fm/Cf17c0eefcb9?dice_id=Cf17c0eefcb9\",\"post_reminder_referral\":\"https://link.dice.fm/u7c74faef163?dice_id=u7c74faef163\",\"post_waitinglist_referral\":\"https://link.dice.fm/t82198af06a0?dice_id=t82198af06a0\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"oeqm85-late-night-jazz-gigi-wilde-12th-mar-elgar-room-at-royal-albert-hall-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773351000,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:89\",\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/95cb5fdb-761c-449b-8af4-e659515e9a72.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/95cb5fdb-761c-449b-8af4-e659515e9a72.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/95cb5fdb-761c-449b-8af4-e659515e9a72.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69497cf7739dc2000167586e\",\"name\":\"Late Night Jazz: Gigi Wilde\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Raw, Honest and Cinematic.\\n\\nFollowing the release of her debut project ‘Life at the Kitchen Table’ and a recent sell-out headliner at St Matthias Church, Gigi Wilde brings her soulful and tender sound to the Elgar Room. Joined by her full band, Gigi will delve into our musical archives to bring alive music from the past, weaving compelling stories together into one evening of songs.\\n\\n‘Life at the Kitchen Table’, is a project of 7 tracks, each focusing on a specific unique and intimate moment that happened at or around a kitchen table. In her own words, “The project is a statement on the small moments that build us, represented by the idea of a kitchen table - somewhere where you can have tender moments, blazing rows, parties, kisses and everything in-between. It’s a metaphor that emphasises the beauty and the cinematic in the everyday.”\\n\\nOur intimate Late Night Jazz series presents sensational music in the Elgar Room, celebrating the freshest sounds on the London scene alongside the finest in jazz standards.\\n\\nWe have a laid-back attitude at Late Night Jazz at the Royal Albert Hall. Customers are welcome to dance, move around, sing along, and enjoy themselves in whatever way feels most comfortable!\\n\\nAll customers aged 14 years or below must be accompanied by an adult aged 18 years or over\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T00:00:00+00:00\",\"sale_end_date\":\"2026-03-11T12:00:00+00:00\",\"sale_start_date\":\"2025-12-22T00:00:00+00:00\",\"event_start_date\":\"2026-03-12T21:30:00+00:00\",\"event_end_date\":\"2026-03-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Oh Nina\",\"redirect_url\":\"https://open.spotify.com/track/0095pJfurRsMPYuCuUUy8R\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dc9749ce1a480528ef3eb8249856021ca34735ee?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Oh Nina\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Thu 12 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Growlers\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-17/ef5a16fe-840a-43cf-a69b-41acc5baf068.jpg?rect=0%2C0%2C1080%2C1080\"},\"artist_id\":\"3291\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Communion One. \",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":53901,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"835\",\"name\":