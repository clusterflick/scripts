8e299?dice_id=hf06a628e299\",\"post_reminder_referral\":\"https://link.dice.fm/Zb9f36655aa4?dice_id=Zb9f36655aa4\",\"post_waitinglist_referral\":\"https://link.dice.fm/ua81a66b288f?dice_id=ua81a66b288f\"},\"perm_name\":\"bb8p2k-koko-electronic-maz-28th-mar-koko-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ee7888-1cc5-411f-80a3-024574f72d16.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ee7888-1cc5-411f-80a3-024574f72d16.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ee7888-1cc5-411f-80a3-024574f72d16.jpg?rect=486%2C0%2C1188%2C2160\"},\"properties\":[],\"about\":{\"description\":\"Join us as we welcome Brazilian Afro-house royalty; Maz back to the theatre on Sat, 28th March.\\n\\nAfter a vintage KOKO Electronic session last April, we had to invite him back for another. This March, Maz returns to bring his signature blends of deep house, samba-infused percussion and soulful Portuguese vocals to the theatre.\\n\\nTickets are now on sale.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 19+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698a33ffbddd0900017d9d0f\",\"name\":\"KOKO Electronic: Maz\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Maz\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-06/b373fc8f-bed4-43f0-8d61-3530387b6d7c.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"96569\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T11:35:00+00:00\",\"sale_end_date\":\"2026-03-29T03:00:00+01:00\",\"sale_start_