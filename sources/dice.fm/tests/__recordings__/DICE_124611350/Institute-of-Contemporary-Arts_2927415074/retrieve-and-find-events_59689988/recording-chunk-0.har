te\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"QUEER CXNTRY with Pink Suits and The Northdown Rodeo is back in London y'all!\\n\\nA night for all your Queer Country fantasies…\\n\\nHosted by Dame Jame with Margate's country super group pink suits & The Northdown Rodeo ft Sue Spurs, Sugar Ray, Janet District Council, Shelly Grotto, Pretzel Cage, Lo Barnes, Em Rose and Eli!\\n\\nSpecial Cabaret guests will be gracing our stage and DJ's will be there to keep your boots a stompin' all night long!\\n\\nLittle Gay Line Dancing Club will teach a couple of dances at 7:15pm so come down early to learn some country classics!\\n\\nFirst time at The Rodeo? Come dressed to impress in your Cuntry Best and join in with Dame James Games for a chance to win some cuntry lovin' prizes! There will be performances, live music, a photobooth, linedancing and more!\\n\\nSaddle up London... This is the Cuntry night you never knew you needed! This is an LGBTQ+ safe space. There will be zero tolerance of any sexist, transphobic, homophobic or abusive behaviour. We are running that shit out of town and out of cuntry!\\n\\nTickets are on a sliding scale starting at £12.50, if you can pay more than you are welcome to! This night is for and by the queer commuity so if you are an ally and you have the means this is a great way to support.\\n\\nVenue is Signature Brew Blackhorse Road, is accessible but if you have an access requirements please get in touch!\\n\\nPresented by pink suits\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:82\",\"billing_promoter\":{\"id\":\"3591\",\"name\":\"Signature Brew Haggerston\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/cf9f0866-c543-4008-8b08-026157cfb350.jpg\"},\"perm_name\":\"signature-brew-haggerston-3m2g\",\"profile_active\":true},\"presented_by\":\"Presented by Signature Brew.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pink Suits\",\"image\":null,\"artist_id\":\"27755\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1769175000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T13:30:00+00:00\",\"sale_end_date\":\"2026-03-28T18:00:00+00:00\",\"sale_start_date\":\"2026-01-23T13:30:00+00:00\",\"event_start_date\":\"2026-03-28T19:00:00+00:00\",\"event_end_date\":\"2026-03-28T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69737689637cfd0001ae3643\",\"name\":\"Queer Cxntry London\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1377},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Wheeler Walker Jr. - Fucked By A Country Boy\",\"redirect_url\":\"https://open.spotify.com/track/63yKYYjKljMstTl4JNnSiS\",\"artist\":\"Wheeler Walker Jr.\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6f6da0e33cd2de8efbfeede173742da314d295bb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Fucked By A Country Boy\"}],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"py569y-cloudmakers-trio-28th-mar-world-heart-beat-embassy-gardens-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774724400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/439d85aa-fd59-49bb-923a-39944b3f8a7d.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/439d85aa-fd59-49bb-923a-39944b3f8a7d.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/439d85aa-fd59-49bb-923a-39944b3f8a7d.jpg?rect=169%2C0%2C743%2C1350\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/ic4a2cde5a3a?dice_id=ic4a2cde5a3a\",\"post_competition_referral\":\"https://link.dice.fm/C6aff610de8a?dice_id=C6aff610de8a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u687b1542d70?dice_id=u687b1542d70\",\"post_purchase_referral\":\"https://link.dice.fm/lc2186fbf89c?dice_id=lc2186fbf89c\",\"post_waitinglist_referral\":\"https://link.dice.fm/of4372c2d267?dice_id=of4372c2d267\",\"post_reminder_referral\":\"https://link.dice.fm/Rc174a70889c?dice_id=Rc174a70889c\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Cloudmakers Trio, as a group, blends downtown New York and European improvised music with world and rock influences. This project’s original vision – to match the textural density of a piano trio, but instead headed up by vibraphone – places exhilarating improvisation at the core, analogously emulating fleeting, ever-changing skyscapes formed by the cloud-like abstractions of power stations.\\n\\nThe founding synergy of the Cloudmakers Trio – led by vibraphonist Jim Hart (Kenny Wheeler, John Taylor, Marius Neset Quintet, Daniel Erdmann’s Revolution) with double bassist Michael Janisch and drummer Dave Smith – shaped distinctive, dynamic timbres from the outset. Their first release, Live at the Pizza Express(2010, Whirlwind), featuring guest trumpeter Ralph Alessi, became a standout recording, earning widespread acclaim for its uninhibited chemistry and superb audio capture. The trio went on to tour extensively, refining their intricate, high-energy sound through live performance.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:83\",\"billing_promoter\":{\"id\":\"139902\",\"name\":\"World Heart Beat\",\"image\":{\"url\":null},\"perm_name\":\"world-heart-beat-bmv9k\",\"profile_active\":false},\"presented_by\":\"Presented by World Heart Beat.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cloudmakers Trio\",\"image\":null,\"artist_id\":\"132438\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1768612500,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T01:15:00+00:00\",\"sale_end_date\":\"2026-03-28T18:30:00+00:00\",\"sale_start_date\":\"2026-01-17T01:30:00+00:00\",\"event_start_date\":\"2026-03-28T19:00:00+00:00\",\"event_end_date\":\"2026-03-28T21:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_st