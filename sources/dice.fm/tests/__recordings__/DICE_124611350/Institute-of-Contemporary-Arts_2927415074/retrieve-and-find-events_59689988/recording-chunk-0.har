dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-06-05T18:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"announcement_date_unix\":1770652800,\"social_links\":{\"event_share\":\"https://link.dice.fm/f01cc21d89f2?dice_id=f01cc21d89f2\",\"post_competition_referral\":\"https://link.dice.fm/H871a0cfe59c?dice_id=H871a0cfe59c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w65e8375e5e6?dice_id=w65e8375e5e6\",\"post_purchase_referral\":\"https://link.dice.fm/V6f7e21a5b59?dice_id=V6f7e21a5b59\",\"post_reminder_referral\":\"https://link.dice.fm/Xe1a73a1880b?dice_id=Xe1a73a1880b\",\"post_waitinglist_referral\":\"https://link.dice.fm/b50f8d4ddd8f?dice_id=b50f8d4ddd8f\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6d2eq8-bulletproof-festival-sprints-5th-jun-earth-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2434,\"name\":\"The Corbyn Project\",\"privacy_policy_link\":\"https://thecorbynproject.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1780678800,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:78\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2931},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/fdc79544-c200-4804-959c-6d52fd82a68f.jpg?rect=0%2C1364%2C5464%2C5464\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/fdc79544-c200-4804-959c-6d52fd82a68f.jpg?rect=0%2C2457%2C5464%2C3278\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/fdc79544-c200-4804-959c-6d52fd82a68f.jpg?rect=479%2C0%2C4506%2C8192\"},\"id\":\"6985bd7b05d5720001749cd7\",\"name\":\"Bulletproof Festival: SPRINTS\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nA new multi-venue music festival taking place in London from 4-6 June 2026, featuring Maruja, SPRINTS, Pussy Riot:Riot Days and many more.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T16:00:00+00:00\",\"sale_end_date\":\"2026-06-05T21:00:00+01:00\",\"sale_start_date\":\"2026-02-11T11:00:00+00:00\",\"event_start_date\":\"2026-06-05T18:00:00+01:00\",\"event_end_date\":\"2026-06-05T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"ACID REIGN\",\"image\":null,\"artist_id\":\"6082\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Underworld.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":73010,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73011,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73012,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-05T18:00:00+01:00\",\"doors_close_date\":\"2026-06-05T22:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1769774400,\"social_links\":{\"event_share\":\"https://link.dice.fm/M1beb74bca82?dice_id=M1beb74bca82\",\"post_competition_referral\":\"https://link.dice.fm/W50a5ce44d59?dice_id=W50a5ce44d59\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/od5c4e5223b9?dice_id=od5c4e5223b9\",\"post_purchase_referral\":\"https://link.dice.fm/Vca820ed9524?dice_id=Vca820ed9524\",\"post_reminder_referral\":\"https://link.dice.fm/K4e1341421f0?dice_id=K4e1341421f0\",\"post_waitinglist_referral\":\"https://link.dice.fm/A3029bc03da9?dice_id=A3029bc03da9\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6dnglq-acid-reign-5th-jun-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780678800,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:79\",\"price\":{\"currency\":\"GBP\",\"amount\":2704,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/262b7bf4-1d47-4dfb-8494-eb752899311b.jpg?rect=314%2C0%2C1152%2C1152\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/262b7bf4-1d47-4dfb-8494-eb752899311b.jpg?rect=64%2C0%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/262b7bf4-1d47-4dfb-8494-eb752899311b.jpg?rect=707%2C0%2C634%2C1152\"},\"id\":\"697b779b1b04b600010f60ad\",\"name\":\"ACID REIGN\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"UK Thrash metal legends ACID REIGN come to The Underworld for their headline tour in support of their upcoming album 'Daze of the Week'\\n\\nFormed in 1985, Acid Reign are one of the 'Big Four' of UK Thrash Metal along with ONSLAUGHT, SABBAT and XENTRIX. Their fourth studio album, 'Daze of the Week' is due for release on 15th May and will be the band’s first release since 2019's 'The Age of Entitlement'. Support bands TBA. Get a ticket to what will be one of the best Thrash nights of 2026!\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Blackout Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T12:00:00+00:00\",\"sale_end_date\":\"2026-06-05T17:00:00+01:00\",\"sale_start_date\":\"2026-01-30T12:00:00+00:00\",\"event_start_date\":\"2026-06-05T18:00:00+01:00\",\"event_end_date\":\"2026-06-05T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Acid Reign - Goddess - Cerebral Scar\",\"redirect_url\":\"https://music.apple.com/us/album/goddess-cerebral-scar/1613738817?i=1613744929&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Acid Reign - Goddess - Cerebral Scar\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/d0/04/fe/d004fe83-a8cc-d385-5a22-90e6062f2c77/mzaf_6759532086578836764.plus.aac.p.m4a\",\"track_name\":\"Acid Reign - Goddess - Cerebral Scar\"},{\"type\":\"spotify\",\"title\":\"Acid Reign - Goddess - Cerebral Scar\",\"redirect_url\":\"https://open.spotify.com/track/4jrxV1FLmo9ViMkPehqlfC\",\"artist\":\"Acid Reign - Goddess - Cerebral Scar\",\"preview_url\":\"https://p.scdn.co/mp3-preview/11bcf19d9b1464c2a8