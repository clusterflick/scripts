\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-27T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ata Kak\",\"image\":null,\"artist_id\":\"2908\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":76266,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/6b16e855-5c58-4745-a1b9-73647455ff40.jpg?rect=0%2C0%2C1002%2C1002\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/6b16e855-5c58-4745-a1b9-73647455ff40.jpg?rect=0%2C201%2C1002%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/6b16e855-5c58-4745-a1b9-73647455ff40.jpg?rect=226%2C0%2C551%2C1002\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770890400,\"max_tickets\":6,\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Once a mystery, now a pioneer of Twi rap and Afro-futurism.\\n\\nAta Kak, the Ghanaian artist behind the cult classic ‘Obaa Sima’, crafted a singular blend of highlife, hip-hop and funk in the early 90s that went largely unnoticed until decades later. Born Yaw Atta-Owusu in Kumasi, he developed his sound across Germany and Canada, using simple home equipment and sheer determination. The DIY cassette Obaa Sima vanished into obscurity—until it was rediscovered in 2002 and reissued in 2015 via Awesome Tapes From Africa, sparking a global cult following.\\n\\nToday, Ata Kak electrifies audiences across Europe with his infectious energy and joy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Eat Your Own Ears.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:21\",\"social_links\":{\"event_share\":\"https://link.dice.fm/b8406916fe5a?dice_id=b8406916fe5a\",\"post_competition_referral\":\"https://link.dice.fm/oa338817f327?dice_id=oa338817f327\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/rb0d9cee99e0?dice_id=rb0d9cee99e0\",\"post_purchase_referral\":\"https://link.dice.fm/Tdc596e8badc?dice_id=Tdc596e8badc\",\"post_reminder_referral\":\"https://link.dice.fm/Wbcdc87d48a7?dice_id=Wbcdc87d48a7\",\"post_waitinglist_referral\":\"https://link.dice.fm/m1c2c6857769?dice_id=m1c2c6857769\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T10:00:00+00:00\",\"sale_end_date\":\"2026-08-27T17:00:00+01:00\",\"sale_start_date\":\"2026-02-13T09:00:00+00:00\",\"event_start_date\":\"2026-08-27T19:00:00+01:00\",\"event_end_date\":\"2026-08-27T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2153,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"10\",\"name\":\"Eat Your Own Ears\",\"image\":{\"url\":null},\"perm_name\":\"eat-your-own-ears-z82z\",\"profile_active\":true},\"id\":\"698c8a8ab885ac0001ef2039\",\"seats_io_event_id\":null,\"name\":\"Ata Kak\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nv9g8l-ata-kak-27th-aug-the-jazz-cafe-london-tickets\",\"date_unix\":1787853600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-27T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Red Leather\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-20/05464312-97ba-42c4-b833-91aa0fc0e901.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"107587\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/361c47e2-ffd5-44d3-9c8a-3819faae16e6.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/361c47e2-ffd5-44d3-9c8a-3819faae16e6.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/361c47e2-ffd5-44d3-9c8a-3819faae16e6.jpg?rect=180%2C0%2C440%2C800\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Red Leather - CAN'T GET HIGH\",\"redirect_url\":\"https://open.spotify.com/track/7oRWpbKdNGqCRYPjf0phQJ\",\"artist\":\"Red Leather\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7d80a4cbdd0d036abfe3957ee89ac3496b59ab65?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"CAN'T GET HIGH\"},{\"type\":\"apple_music\",\"title\":\"Red Leather - CAN'T GET HIGH\",\"redirect_url\":\"https://music.apple.com/us/album/cant-get-high/1822653629?i=1822653863&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Red Leather\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/0f/7a/b1/0f7ab16b-f2f6-a5d3-2008-5a1f82f896f4/mzaf_13754109108425910252.plus.aac.p.m4a\",\"track_name\":\"CAN'T GET HIGH\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768557600,\"max_tickets\":8,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"*Red Leather is an anonymous alternative-rock artist from Reno, Nevada, whose music fuses the grit of classic Americana with the raw emotion of early 2000s rock. He emerged in 2022 with a bold vision: to tell the truth about addiction, sobriety, and the long, hard road to self-redemption. Now 3 years sober, Red channels that lived experience into every lyric. With lyrics rooted in real pain and transformation, Red Leather’s music speaks to anyone who’s ever struggled to find their footing in a chaotic world. Red’s debut project RENO has earned critical acclaim, and his viral, fan-first marketing strategy has helped him build an intensely loyal fanbase.*\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by AEG.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:22\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Ld5ddc2aa746?dice_id=Ld5ddc2aa746\",\"post_competition_referral\":\"https://link.dice.fm/l0229e0f8a90?dice_id=l0229e0f8a90\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P68314cf0a80?dice_id=P68314cf0a80\",\"post_purchase_referral\":\"https://link.dice.fm/y93ca0b2d16d?dice_id=y93ca0b2d16d\",\"post_reminder_referral\":\"https://link.dice.fm/b9b4e89d8fc5?dice_id=b9b4e89d8fc5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ze9166399089?dice_id=Ze9166399089\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T10:00:00+00:00\",\"sale_end_date\":\"2026-08-27T21:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-08-27T19:00:00+01:00\",\"event_end_date\":\"2026-08-27T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_