ndon\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Afla Sackey & Afrik Bawantu\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebed0cf68b6776b52537ed9a2e\"},\"artist_id\":\"13067\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"***“Highlife music is food for the soul.” – Nana Kwame Ampadu***\\n\\nA night celebrating Ghanaian Independence Day and Ghana’s greatest musical export—highlife.\\n\\nFrom its roots in Accra to its global influence, highlife infuses a mix of African melodies and rhythms with big band jazz.\\n\\nMaking their debut on our stage is special guest **Kay Slice**, with a fresh take on spirited West African rhythms, soulful grooves, and poetic rap.\\n\\nA journey into the heart and soul of Ghana, performed by a full live-band.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T13:00:00+00:00\",\"sale_end_date\":\"2026-03-05T19:00:00+00:00\",\"sale_start_date\":\"2025-11-11T13:00:00+00:00\",\"event_start_date\":\"2026-03-05T00:00:00+00:00\",\"event_end_date\":\"2026-03-05T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6911e211e38e030001e4e164\",\"name\":\"Ghana's Groove: Celebrating Highlife\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/2829be71-029a-4dc4-9017-c52ffc40befb.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"http