/E9540edd4c35?dice_id=E9540edd4c35\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Nf9dec7464c3?dice_id=Nf9dec7464c3\",\"post_purchase_referral\":\"https://link.dice.fm/H8af7a3c9948?dice_id=H8af7a3c9948\",\"post_reminder_referral\":\"https://link.dice.fm/L492f48c6209?dice_id=L492f48c6209\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y1a6f4454010?dice_id=Y1a6f4454010\"},\"perm_name\":\"v3qond-queen-bee-23rd-jul-electric-ballroom-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/9ea3c589-4a98-45ee-a6ad-ba9d5de5d598.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/9ea3c589-4a98-45ee-a6ad-ba9d5de5d598.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/9ea3c589-4a98-45ee-a6ad-ba9d5de5d598.jpg?rect=180%2C0%2C440%2C800\"},\"properties\":[],\"about\":{\"description\":\"QUEEN BEE is a band from Japan formed in 2009. With their unique and intense performances and noteworthy activities in various fields, they have created a buzz not only in the music industry but also in various other domains. Their songs consistently rank high on music charts, and their live shows sell out in many places, showcasing an overwhelming presence in terms of both popularity and ability. Their songs have also been featured in popular anime, such as \\\"Mephisto,\\\" the ending theme for \\\"OSHI NO KO,\\\" \\\"01,\\\" the opening theme for \\\"UNDEAD UNLUCK,\\\" \\\"VIOLENCE,\\\" the ending theme for \\\"Chainsaw Man,\\\" \\\"Kaen (Fire),\\\" the opening theme for \\\"Dororo,\\\" and \\\"HALF,\\\" the ending theme for \\\"Tokyo Ghoul:re.\\\" In April 2023, Queen Bee held a solo concert in LA, USA, and in October of the same year, they hosted another solo concert in Shanghai, China, attracting attention from fans around the world.\\n\\nThis event is 14 and over. 14s to 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"id\":\"6969161e738e81000132b2bb\",\"name\":\"QUEEN BEE\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"QUEEN BEE - 01\",\"redirect_url\":\"https://open.spotify.com/track/7r6pHYnNYqxSZr8e40VF8T\",\"artist\":\"QUEEN BEE\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4ff7d205376bacacacc6b07cb98ab62fc3525ee9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"01\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"QUEEN BEE\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-15/a7433c8f-704d-49b1-bbf5-63609f99be4a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"75463\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-20T13:00:00+00:00\",\"sale_end_date\":\"2026-07-23T19:00:00+01:00\",\"sale_start_date\":\"2025-11-20T13:00:00+00:00\",\"event_start_date\":\"2026-07-23T19:00:00+01:00\",\"event_end_date\":\"2026-07-23T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":58727,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversi