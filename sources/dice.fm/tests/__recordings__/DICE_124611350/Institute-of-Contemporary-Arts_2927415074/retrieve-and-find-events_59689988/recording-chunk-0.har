rchase_referral\":\"https://link.dice.fm/n1d6142852de?dice_id=n1d6142852de\",\"post_reminder_referral\":\"https://link.dice.fm/R6b830e00168?dice_id=R6b830e00168\",\"post_waitinglist_referral\":\"https://link.dice.fm/j47f8165f26e?dice_id=j47f8165f26e\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q27wy9-the-jackets-the-speedways-club-night-3rd-apr-paper-dress-vintage-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1775241000,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:34\",\"price\":{\"currency\":\"GBP\",\"amount\":2260,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-22/3993275b-eb7b-48f8-bef6-b28b696c167a.jpg?rect=0%2C0%2C1081%2C1081\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-22/3993275b-eb7b-48f8-bef6-b28b696c167a.jpg?rect=0%2C216%2C1081%2C649\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-22/3993275b-eb7b-48f8-bef6-b28b696c167a.jpg?rect=243%2C0%2C595%2C1081\"},\"id\":\"69721eef259cd30001713172\",\"name\":\"THE JACKETS + THE SPEEDWAYS + Club Night \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Le Beat Bespoke Festival - Easter 2026!**\\n\\nThe festival kicks off on Easter Friday with a co-headline from pop-punk favourites **The Speedways** & Garage Punk trio **The Jackets** followed by club night till late **🔥**\\n\\n**THE JACKETS**\\n\\nDynamic Garage-Punk trio based in Bern, Switzerland playing all around the world since 2008, known for their high energy live performances and electrifying songs.\\n\\n**THE SPEEDWAYS**\\n\\nHailed as *“London’s powerpop kings”* (Vive Le Rock), The Speedways are a harmony-driven powerpop band. They blend classic influences like The Ronettes, Cheap Trick and Tom Petty with a modern edge. Renowned for their energetic live shows, they’ve become a leading force in the European powerpop scene, touring widely across the UK and Europe.\\n\\n**CLUB NIGHT**\\n\\nInternational DJ’s Dr Robert and Edu Lobo (Spain) will be playing the coolest Freakbeat, Garage & Psych bangers til late!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T13:15:00+00:00\",\"sale_end_date\":\"2026-04-03T18:00:00+01:00\",\"sale_start_date\":\"2026-01-22T13:30:00+00:00\",\"event_start_date\":\"2026-04-03T19:30:00+01:00\",\"event_end_date\":\"2026-04-04T02:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nuns Of The Tundra\",\"image\":null,\"artist_id\":\"116054\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Gotobeat.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1238\",\"name\":\"Folklore Hoxton\",\"address\":\"186 Hackney Rd, London E2 7QL, UK\",\"location\":{\"lat\":51.5