680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:26\",\"properties\":[],\"presented_by\":\"Presented by FORM.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769688000,\"id\":\"697a28d535a6650001da44c4\",\"name\":\"Mass (Late Show)\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"FORM Presents\\n\\nMASS\\n\\n\\\\+ Barney Kass, Julia Mahrer Vinas & Pytko\\n\\nThis performance is part of a Research Project conducted by CoSTAR National Lab, MusicFutures and supported by The Music Venue Trust. We are exploring how technology innovations might connect artists, audiences and venues in new ways, and how this could support new business models in the pursuit of a more equitable live music ecosystem.\\n\\nDuring this performance, some data about you (for example, your body movements) may be captured anonymously via cameras and microphones in the venue. This data will be used to influence the live experience and will not be stored or used for any other purpose.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1813,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T10:00:00+00:00\",\"sale_end_date\":\"2026-03-07T16:00:00+00:00\",\"sal