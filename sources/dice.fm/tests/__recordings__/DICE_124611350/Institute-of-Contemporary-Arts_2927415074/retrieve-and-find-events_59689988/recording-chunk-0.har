dice_id=Q3310d963ffb\"},\"perm_name\":\"926d76-the-baker-moore-band-5th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-29/42b192a6-97e6-4fa1-95fa-99cb44acf154.jpg?rect=223%2C0%2C955%2C955\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-12-29/42b192a6-97e6-4fa1-95fa-99cb44acf154.jpg?rect=0%2C58%2C1400%2C840\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-12-29/42b192a6-97e6-4fa1-95fa-99cb44acf154.jpg?rect=438%2C0%2C525%2C955\"},\"properties\":[],\"about\":{\"description\":\"Timmy Moore says. We first got back together for Nicky Junior Moore-Fest after playing together many times over the last 20 years.\\n\\nKris Baker and Tim's Dad Nicky Moore and Uncle were both in Mammoth and the Nicky Moore Band and the lads met through that. Teaming up with Gary Hobley on Rhythm Guitar...Keith Hammond is on Bass Duties and the Fantastic Terry Carter is on Harp.\\n\\n***The Baker Moore Band*** play a Mixture of Blues, Soul and Funky music and we already have some great gigs stacking up for the year already. Definitely a band to watch!!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692e12544510540001e695d8\",\"name\":\"The Baker Moore Band\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T00:00:00+00:00\",\"sale_end_date\":\"2026-07-05T18:00:00+01:00\",\"sale_start_date\":\"2026-01-17T00:00:00+00:00\",\"event_start_date\":\"2026-07-05T18:00:00+01:00\",\"event_end_date\":\"2026-07-05T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"off