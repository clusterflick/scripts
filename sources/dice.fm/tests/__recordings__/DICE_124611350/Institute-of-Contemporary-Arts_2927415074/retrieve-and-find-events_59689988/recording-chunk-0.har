54f:8\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1761132600,\"id\":\"68f8bb706e61980001087fe3\",\"name\":\"The Offline\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Hamburg producer and multi-instrumentalist brings his atmospheric world to life.**\\n\\nInspired by 60s and 70s soundtrack pioneers and the dusty charm of analogue tape, he creates instrumental storytelling that feels like film score rescued from a forgotten archive.\\n\\nSurf guitars glide over boom-bap drums, sax lines drift in like sea fog, and deep groove carries every scene forward.\\n\\nIf you’re into the textured sound worlds of Surprise Chef, David Axelrod or BADBADNOTGOOD, this is one to lock in for.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1775671200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2639,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-17T16:00:00+01:00\",\"sale_end_date\":\"2026-04-08T14:00:00+01:00\",\"sale_start_date\":\"2025-10-17T16:00:00+01:00\",\"event_start_date\":\"2026-04-08T19:00:00+01:00\",\"event_end_date\":\"2026-04-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nv7ar8-novelists-8th-apr-the-dome-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"m