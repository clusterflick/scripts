rchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773169200,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:14\",\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/0fd56fa7-6fa4-49cb-ba75-0b9e825e81a5.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/0fd56fa7-6fa4-49cb-ba75-0b9e825e81a5.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/0fd56fa7-6fa4-49cb-ba75-0b9e825e81a5.jpg?rect=338%2C0%2C825%2C1500\"},\"id\":\"6967700a4b9de60001ba3747\",\"name\":\" Playback: Loyle Carner [Candlelit Sessions]\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Presented by Johnnie Walker Black Label × NT’s Loft**\\n\\nPlayback is a candlelit listening experience where over 200 candles transform NT’s Loft into a glowing sanctuary. Each session invites guests to slow down, connect, and fully immerse themselves in the music that defines a generation.\\n\\nOn Tuesday, 10th March, we turn our focus to Loyle Carner; a reflective, emotive journey through the tracks that have reshaped modern British hip-hop. From the raw honesty of Yesterday’s Gone and Not Waving, But Drowning to the soulful depth and growth of hugo and beyond, this session explores the stories, vulnerability and quiet power that have cemented Loyle Carner as one of the UK’s most important voices.\\n\\nExperience every lyric and nuance through the warmth and clarity of Funktion-One sound, in an intimate, candlelit setting. Johnnie Walker Black Label returns to elevate the evening, with signature serves available throughout the night. **Guests arriving before 8pm will receive a complimentary drink to begin the evening in style (Limited to First 50 Customers).**\\n\\n—\\n\\nTickets\\n\\nReserved seating ticket holders must arrive by 8:00 PM. **Seating is first come, first served.**\\n\\n—\\n\\nSchedule\\n\\n7:00 PM – Doors & Playlist\\n\\n8:15 PM – Listening Session Begins (90 mins)\\n\\nLimited capacity. Arrive early, stay late.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event. Bring your ID card with you. ID Scanner in place. \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T11:00:00+01:00\",\"sale_end_date\":\"2026-03-10T19:00:00+00:00\",\"sale_start_date\":\"2025-09-30T11:30:00+01:00\",\"event_start_date\":\"2026-03-10T19:00:00+00:00\",\"event_end_date\":\"2026-03-10T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Man The Myth The Meatslab\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-19/388dbd94-2b1f-4f9f-92b9-a237133708ac.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"116662\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Communion ONE.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"43\",\"name\":\"MOTH Club\",\"address\":\"Old Trades Hall, Valette Street, London E9 6NU\",\"location\":{\"lat\":51.5450825,\"lng\":-0.0546326999999565},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-14/0164c968-c9f6-4e55-8329-e0a12ce43b69.jpg?rect=341%2C0%2C1367%2C1367\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.5076