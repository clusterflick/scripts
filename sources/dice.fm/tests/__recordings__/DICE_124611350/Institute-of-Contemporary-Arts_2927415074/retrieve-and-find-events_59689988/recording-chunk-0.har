":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-25T19:45:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sierpinski\",\"image\":null,\"artist_id\":\"22746\",\"about\":null,\"is_headliner\":false},{\"name\":\"Strange Lot\",\"image\":null,\"artist_id\":\"116990\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-31/c1e0e146-3dc5-4e14-99c6-5569ff469456.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-31/c1e0e146-3dc5-4e14-99c6-5569ff469456.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-31/c1e0e146-3dc5-4e14-99c6-5569ff469456.jpg?rect=486%2C0%2C1188%2C2160\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"STRANGE LOT - Born\",\"redirect_url\":\"https://music.apple.com/us/album/born/1199702797?i=1199702912&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"STRANGE LOT\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview111/v4/98/23/f4/9823f40d-3a15-0d35-3517-5ec0b26af405/mzaf_8771332841215829572.plus.aac.p.m4a\",\"track_name\":\"Born\"},{\"type\":\"spotify\",\"title\":\"Strange Lot - Born\",\"redirect_url\":\"https://open.spotify.com/track/1YHwupkquHUlx6uZNBjBLr\",\"artist\":\"Strange Lot\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5e903e12430eb48c712df013842fdc3a2cfdbce0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Born\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769886900,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"OSP present a night of superb psychedelic garage rock!\\n\\n**Strange Lot (US):**\\n\\nSTRANGE LOT were formed in Phoenix, before relocating to Austin in 2019.\\n\\nTheir new self-titled album was produced by Alex Maas of The Black Angels, mixed by Jim Enoof Spoon, and mastered by Howie Weinberg.\\n\\nAfter touring with Boogarins in 2024, the band capped the year with a performance on the headlining stage at Austin’s Levitation Festival alongside The Black Angels. 2025 has broughtan official appearance at SXSW, a headlining spring tour, & a new album on the horizon -continuing their pursuit of immersive, psychedelic soundscapes.\\n\\nSTRANGE LOT has been direct support for The Jesus and Mary Chain, The Brian Jonestown Massacre, The Black Angels, Kikagaku Moyo, LA Witch + more.\\n\\nhttps://strangelot-treelink.vercel.app/\\n\\n**Sierpinski:**\\n\\nSierpinski are a reverb-Psychedelic rock/shoegaze sextet based in Southsea.\\n\\nFormed in early 2020, Sierpinski channel grooving basslines & haze-drenched riffs that blend the spirit of ’60s psych with the textures of early ’90s shoegaze. They have shared stages with The Confederate Dead, The Warlocks & Magic Shoppe.\\n\\nhttps://linktr.ee/Sierpinski\\n\\n**Glisten Trick**\\n\\nGlisten Trick tilt from deep, narcotic groove & shimmering blooms of crystalline beauty —into throbbing, acidic loops that sweep beneath unadorned, laconic delivery.\\n\\nThe six piece features members & collaborators from cult drone, neo-psych & garage acts across the US & UK.\\n\\nhttps://linktr.ee/glistentrick\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"attendan