"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-obie-theatre---the-brit-school-r5kr\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T18:45:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":73038,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":73039,\"title\":\"What is a Concession\",\"body\":\"A Student or Child Concession is available for children and students at any school, college or university.\\n\\nAn Adult Concession is available for those in receipt of Universal Credit, Working Tax Credit, Child Tax Credit, Pension Credit, Employment and Support Allowance, Income Support or Jobseeker’s Allowance.\",\"order\":1},{\"id\":73040,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/0112380a-04b9-473b-a9b8-846df8a76353.jpg?rect=0%2C0%2C3366%2C3366\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/0112380a-04b9-473b-a9b8-846df8a76353.jpg?rect=0%2C673%2C3366%2C2020\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/0112380a-04b9-473b-a9b8-846df8a76353.jpg?rect=758%2C0%2C1851%2C3366\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"SIX - Don't Lose Ur He