_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"East London’s Roscoe Roscoe fuse the epic, ’wall-of-sound’ guitars of Shoegaze and Post Rock combined with massive instrumental compostions, drawing sonic influences from 90’s genre pioneers ‘My Bloody Valentine’ & ‘Sigur Ros’, to the vast, acoustic arrangments of The Beach Boys’ ‘Pet Sounds’.\\n\\nHaving played recent shows with the likes of Tess Parks, The Orielles, Dummy and Astrel K, Roscoe Roscoe bring their sonic audio/visual live performance to The George Tavern\\n\\n\\\\-\\n\\n*🍕 £1 off our pizza with this ticket!*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T09:00:00+00:00\",\"sale_end_date\":\"2026-03-05T21:00:00+00:00\",\"sale_start_date\":\"2026-02-03T11:00:00+00:00\",\"event_start_date\":\"2026-03-05T19:30:00+00:00\",\"event_end_date\":\"2026-03-05T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6981028afe8c5a0001ea3513\",\"name\":\"Roscoe Roscoe Live\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/66c4daaa-f0a9-4782-9d54-52db971405c2.jpg?rect=0%2C167%2C960%2C960\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/66c4daaa-f0a9-4782-9d54-52db971405c2.jpg?rect=0%2C393%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/66c4daaa-f0a9-4782-9d54-52db971405c2.jpg?rect=106%2C0%2C749%2C1362\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770022800,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/G7cba6302a12?dice_id=G7cba6302a12\",\"post_competition_referral\":\"https://link.dice.fm/sc204bccc710?dice_id=sc204bccc