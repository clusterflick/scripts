ues\":[{\"id\":\"5484\",\"name\":\"Next Door Records\",\"address\":\"304 Uxbridge Rd, London W12 7LJ, UK\",\"location\":{\"lat\":51.5063731,\"lng\":-0.2315609},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"next-door-records-qgaa\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-13T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:77\",\"about\":{\"description\":\"Step into the vibrant soul of Brazil with the Matheus Prado trio for an unforgettable evening of Brazilian jazz. Led by acclaimed bassist and composer Matheus Prado, the trio brings Brazil’s rich musical traditions to life through a dynamic blend of rhythm, melody, and improvisation. Featuring original compositions from Prado’s new album Brasilidade – A Jazz Portrait Of Brazil, alongside beloved classics by Milton Nascimento, Antonio Carlos Jobim, and other iconic composers, this performance is a celebration of Brazil’s musical heritage reimagined through the lens of contemporary jazz. From the infectious grooves of samba and maracatú to the refined elegance of bossa nova, the trio creates a sound that is both deeply rooted and thrillingly modern—intimate, energetic, and irresistibly Brazilian.\\n\\nLine up:\\n\\nPaul Jones - Piano\\n\\nLiz Exell - Drums\\n\\nMatheus Prado - Bass, vocals\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1768867200,\"seats_io_public_key\":null,\