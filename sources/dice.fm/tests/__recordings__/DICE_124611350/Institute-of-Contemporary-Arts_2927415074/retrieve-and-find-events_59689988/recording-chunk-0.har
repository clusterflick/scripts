ate\":\"2026-04-08T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-06/be7f44d0-b575-43e9-b344-c10e07c42c8b.jpg?rect=0%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-06/be7f44d0-b575-43e9-b344-c10e07c42c8b.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-06/be7f44d0-b575-43e9-b344-c10e07c42c8b.jpg?rect=324%2C0%2C792%2C1440\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/ya86b45827d8?dice_id=ya86b45827d8\",\"post_competition_referral\":\"https://link.dice.fm/Hf2a18f72f5b?dice_id=Hf2a18f72f5b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/M156cff980e9?dice_id=M156cff980e9\",\"post_purchase_referral\":\"https://link.dice.fm/acf7a70b8890?dice_id=acf7a70b8890\",\"post_reminder_referral\":\"https://link.dice.fm/n514042ac72e?dice_id=n514042ac72e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q5ab7c8fea82?dice_id=Q5ab7c8fea82\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:6\",\"properties\":[],\"presented_by\":\"Presented by AM Management\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767787200,\"id\":\"695c24b751720a000112cda5\",\"name\":\"Mishaal Tamer | Home is Changing\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Saudi-Ecuadorian artist Mishaal Tamer brings his genre-blending sound to London. Mishaal rose to global attention with his 33-track debut album, Home Is Changing.\\n\\nIn late 2024, Mishaal released Home Is Changing, a coming-of-age project exploring identity, belonging, and transformation. Praised for its authenticity and emotional depth, the album has cemented his place as a leading figure in a new wave of global artists.\\n\\nHis music has entered charts and playlists worldwide, and his rapid rise has seen him transcend cultural and linguistic barriers in ways unprecedented for any Saudi artist since the country’s full legalization of music in 2017.\\n\\nHis live performances are powerful and deeply personal, marking him as one of the most exciting new voices in global music today and making this London show at The Lower Third a rare opportunity to experience his music up close and intimate.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"date_unix\":1775671200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:00:00+00:00\",\"sale_end_date\":\"2026-04-08T19:00:00+01:00\",\"sale_start_date\":\"2025-12-01T00:00:00+00:00\",\"event_start_date\":\"2026-04-08T19:00:00+01:00\",\"event_end_date\":\"2026-04-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8oeyr-debbie-bond-trio-8th-apr-hot-box-chelmsford-tickets\",\"seats_i