6-880a02ec1bdf.jpg?rect=0%2C111%2C1419%2C851\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-14/87c1ab94-5691-4622-82e6-880a02ec1bdf.jpg?rect=415%2C0%2C590%2C1073\"},\"id\":\"67fd3602d6152d0001c947ae\",\"name\":\"Open Mic At The Three Compasses\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Open mic night every 2nd Monday of the month from 7.30pm. We’ll provide a piano, mic, and courtesy of our friends at Guitar Guitar, an electro-acoustic & an electric guitar (I know!) It wouldn’t be a Monday without a drinks offer so our friends at 40FT Brewery are providing pints and house spirit & mixers for only £4.90. On the night, make yourself known to our outrageously charismatic host, Lewis, so he can organise the sets. Everyone will have the chance to perform two ‘turns’ whether that’s a song, poem, spoken word, dancing dogs….\\n\\nIt’s free entry and all performers will receive a discount for Guitar Guitar. Nice.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-14T17:15:00+01:00\",\"sale_end_date\":\"2026-03-09T21:00:00+00:00\",\"sale_start_date\":\"2025-04-14T17:15:00+01:00\",\"event_start_date\":\"2026-03-09T19:30:00+00:00\",\"event_end_date\":\"2026-03-09T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Mon 09 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by New Cross Live.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\