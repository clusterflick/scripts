433281?uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kameron Marlowe\",\"preview_url\":\"\",\"track_name\":\"Strangers\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770652800,\"max_tickets\":6,\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"One of Nashville’s most exciting up-and-coming voices, Marlowe has indeed been through some changes recently, from adapting to a new life on the road to breaking through with the Platinum-certified single “Giving You Up” and touring alongside some of country music’s biggest stars. That journey is reflected in the sixteen songs of his sophomore album, Keepin’ the Lights On, from the introspection of “On My Way Out” to the romantic turmoil of “Strangers.”\\n\\n“I grew a lot mentally,” says Marlowe of the album’s emotional range. “I had a lot of hard stuff on my plate and I had to learn to be a little stronger and not take things so personally all the time. I learned how to fall back in love—getting engaged and fixin’ to get married—after going through a situation I wrote about on the last record. I've lived a lot of life in the past few years that really opened my mind to some new ideas.”\\n\\nThe scope and maturity of the album establish Marlowe as a true force in today’s country music—a triple-threat singer, songwriter, and performer blazing his own path, marked by his distinctively soulful and resonant vocals. And it hasn’t taken him long to find a following, having already racked up almost 900 million career global streams.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"AEG Presents\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:13\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Kb664200f902?dice_id=Kb664200f902\",\"post_competition_referral\":\"https://link.dice.fm/Dec5b38adb83?dice_id=Dec5b38adb83\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/udd9f99963b1?dice_id=udd9f99963b1\",\"post_purchase_referral\":\"https://link.dice.fm/V40dffee6073?dice_id=V40dffee6073\",\"post_reminder_referral\":\"https://link.dice.fm/z727a06ad126?dice_id=z727a06ad126\",\"post_waitinglist_referral\":\"https://link.dice.fm/x99d3f113fad?dice_id=x99d3f113fad\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T16:00:00+00:00\",\"sale_end_date\":\"2026-03-16T19:00:00+00:00\",\"sale_start_date\":\"2026-02-11T10:00:00+00:00\",\"event_start_date\":\"2026-03-16T19:00:00+00:00\",\"event_end_date\":\"2026-03-16T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2448,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"id\":\"698475993cbc170001d02908\",\"seats_io_event_id\":null,\"name\":\"Kameron Marlowe\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"avp62q-kameron-marlowe-16th-mar-the-lower-third-london-tickets\",\"date_unix\":1773687600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"6109\",\"name\":\"Hootananny Brixton\",\"address\":\"95 Effra Rd, London SW2 1DF, UK\",\"location\":{\"lat\":51.4553934,\"lng\":-0.1132058},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-01-25/a335e145-034f-424c-811e-d996395babfa.jpg?rect=912%2C0%2C3648%2C3648\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hootananny-brixton-parp\",\"accessibility\":{\"url\":\"https://hootanannybrixton.co.uk/info/#:~:text=Venue%20Access%20Policy,Phone%20number%20020%2077373%207273.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-16T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ryan O'reilly\",\"image\":null,\"artist_id\":\"201\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/7a127f27-f351-45b2-ad71-b69fe95271fd.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/7a127f27-f351-45b2-ad71-b69fe95271fd.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/7a127f27-f351-45b2-ad71-b69fe95271fd.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770163200,\"max_tickets\":6,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Irish & Scottish songs old and new, traditional and modern, classic and original, performed in a Nashville-inspired ‘In-The-Round’ style.\\n\\nBerlin-based Celts – Ryan O’Reilly, Calum Bolland, & Simon Maguire will share the stage to perform the rebel, drinking, romantic, and bittersweet émigré songs that Scotland and Ireland are famous for, plus original songs inspired by their Caledonian and Hibernian roots.\\n\\nMarch 16th is the evening before Saint Patrick’s Day, so expect a few songs in his honour and prepare your drinking arm as plenty of the songs from The Celtic Songwriter Circle will require raising a glass in the air as you close your eyes and sing along.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hootananny Brixton.\",\"streaming_options\":null,\"im