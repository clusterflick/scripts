d=U70d4e656137\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X77cc2a2863b?dice_id=X77cc2a2863b\",\"post_purchase_referral\":\"https://link.dice.fm/N86a9e2ad388?dice_id=N86a9e2ad388\",\"post_reminder_referral\":\"https://link.dice.fm/s8e3bee836fe?dice_id=s8e3bee836fe\",\"post_waitinglist_referral\":\"https://link.dice.fm/ld4538c299e3?dice_id=ld4538c299e3\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:23\",\"properties\":[],\"presented_by\":\"New Cross Live presents\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764720000,\"id\":\"69301247e2c8a600013402e9\",\"name\":\"Steal This Band + Tonedefs\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"New Cross Live presents\\n\\nBringing it back for 2026... A tribute to that gig where System of a Down teamed up with Deftones for a Second Time\\n\\nSteal This Band\\n\\nRecreating the System of a Down Live experience\\n\\n+\\n\\nTonedefs\\n\\nA tribute to Deftones\\n\\nSaturday 7th March 2026\\n\\nNew Cross Inn\\n\\nLondon\\n\\nDoors 6pm\\n\\nTickets £13 adv\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"date_unix\":1772906400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2987,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-17T10:00:00+01:00\",\"sale_end_date\":\"2026-03-07T17:00:00+00:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-03-07T18:00:00+00:00\",\"event_end_date\":\"2026-03-07T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"av7ond-bucovina-7th-mar-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Spune Tu, Vant\",\"redirect_url\":\"https://open.spotify.com/track/2yTtB554djGbfa7YpwSI4P\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1823966cf59aaf4464694fd08faa330d438f3a89?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Spune Tu, Vant\"},{\"type\":\"apple_music\",\"title\":\"Bucovina - Șoim In Văzduh\",\"redirect_url\":\"https://itunes.apple.com/gb/album/%C8%99oim-in-v%C4%83zduh/744998562?i=744998622&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Bucovina\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview71/v4/8e/5e/f0/8e5ef043-818f-cdef-b89d-012b0e359928/mzaf_4631898500402814014.plus.aac.p.m4a\",\"track_name\":\"Șoim In Văzduh\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":51097,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":51098,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":51099,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"SLABS\",\"image\":null,\"artist_id\":\"128897\",\"about\":null,\"is_headliner\":false},{\"name\":\"Bucovina\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273356f5550131591e950980827\"},\"artist_id\":\"11643\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T18:00:00+00:00\",\"doors_close_date\":\"2026-03-07T22:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-15/2c87835b-8c37-4747-a155-1cf497743053.jpg?rect=0%2C0%2C2200%2C2200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-15/2c87835b-8c37-4747-a155-1cf497743053.jpg?rect=0%2C440%2C2200%2C1320\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-15/2c87835b-8c37-4747-a155-1cf497743053.jpg?rect=495%2C0%2C1210%2C2200\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/ndf3936ac59d?dice_id=ndf3936ac59d\",\"post_competition_referral\":\"https://link.dice.fm/Ne84369c4465?dice_id=Ne84369c4465\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O4f8696000ba?dice_id=O4f8696000ba\",\"post_purchase_referral\":\"https://link.dice.fm/see4f22d08e2?dice_id=see4f22d08e2\",\"post_reminder_referral\":\"https://link.dice.fm/C68c57bd189e?dice_id=C68c57bd189e\",\"post_waitinglist_referral\":\"https://link.dice.fm/l69b57530356?dice_id=l69b57530356\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:24\",\"properties\":[],\"presented_by\":\"Presented by The Underworld.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760691600,\"id\":\"68effe4385769e000190ca34\",\"name\":\"BUCOVINA\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"BUCOVINA celebrate their 25th Anniversary with yet another escapade in the heart of London, at their beloved Camden Underworld. Having preached the Folc Hevi Blec gospel across Europe and South America on numerous tours for a quarter of a century, this March BUCOVINA bring some tunes from their olden days, alongside newer songs that were never played in the UK.\\n\\nAlso, they’re bringing their Silver Jubileum 2LP, a collection of their most acclaimed hits, ranging from the incipient days up to the latest album. Make sure you mark down the date… March 7th at the Camden Underworld, as they’ll also have a special guest. UK-based band SLABS join the 25th BUCOVINA anniversary with their heavy and energetic, in-your-face Metal, both bands promising a night you won’t soon forget.\\n\\nGet your tickets and make sure to tell your friends to join this exuberant Metal party! Limited tickets, first come – first served. Miss them and you’ll miss an evening to remember!\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_activ