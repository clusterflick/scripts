3ea\",\"post_reminder_referral\":\"https://link.dice.fm/t123f9fac7d4?dice_id=t123f9fac7d4\",\"post_waitinglist_referral\":\"https://link.dice.fm/Lffe2a07cccb?dice_id=Lffe2a07cccb\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:41\",\"properties\":[],\"presented_by\":\"Presented by 100 Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770980400,\"id\":\"698f0213a426db0001cc9f1f\",\"name\":\"Stolen Nova\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Stolen Nova\\n\\nOn April 7th, 1985 Prince concluded his Purple Rain tour at The Forum in Los Angeles. The following day he ventured down to Venice Beach. He stumbled upon a house party where Suicidal Tendencies were playing and went inside. He borrowed a skateboard from Jay Adams and did a wallride in his high heels. He took a pink spray paint can and graffitied his name in the bathroom. He even sat in on guitar for a few songs with Suicidal before the party was busted by the police…None of this is true, but if it were the results may or may not sound something like Los Angeles native Josh Landau’s Stolen Nova.\\n\\nLava La Rue\\n\\nA multi-talented British musician, rapper, and visual artist from West London known for their fluid sound blending hip-hop, R&B, neo-soul, and pop, often exploring themes of queer identity, identity, and femme solidarity within their work and as founder of the NiNE8 Collective. They gained prominence with EPs like Hi-Fidelity and their 2024 debut album Starface, featuring tracks like \\\"JET LAGGED\\\" with Foster The People\\n\\n\\\\+ Baby Ghoul\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"7103\",\"name\":\"100 Club\",\"image\":{\"url\":null},\"perm_name\":\"100-club-lnlp\",\"profile_active\":true},\"date_unix\":1772393400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T00:00:00+00:00\",\"sale_end_date\":\"2026-03-01T21:00:00+00:00\",\"sale_start_date\":\"2026-02-06T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T19:30:00+00:00\",\"event_end_date\":\"2026-03-01T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l893gp-folk-night-family-stereo-solo-tesni-sienna-melella-morning-coyote-solo-1st-mar-dream-bags-jaguar-shoes-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sienna Melella\",\"image\":null,\"artist_id\":\"101152\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tesni\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-30/90a96146-a194-4ca8-868b-4c0b54a54b5c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"108475\",\"about\":null,\"is_headliner\":false},{\"name\":\"Family Stereo\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-25/8f0394d7-ef70-423f-b957-6a9a003e0fb8.jpg?rect=0%2C55%2C531%2C531\"},\"artist_id\":\"64462\"