ent you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by DHP.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:39\",\"social_links\":{\"event_share\":\"https://link.dice.fm/M4ec974e5e50?dice_id=M4ec974e5e50\",\"post_competition_referral\":\"https://link.dice.fm/J7d6f6ea69a5?dice_id=J7d6f6ea69a5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V679e6ef4b92?dice_id=V679e6ef4b92\",\"post_purchase_referral\":\"https://link.dice.fm/s8f061020e5a?dice_id=s8f061020e5a\",\"post_reminder_referral\":\"https://link.dice.fm/s84ae059a4f5?dice_id=s84ae059a4f5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ab8d5f4d9821?dice_id=Ab8d5f4d9821\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-24T10:00:00+00:00\",\"sale_end_date\":\"2026-09-04T21:00:00+01:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-09-04T19:00:00+01:00\",\"event_end_date\":\"2026-09-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4218},\"properties\":[],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"691deaac2a4bd40001f40c7d\",\"seats_io_eve