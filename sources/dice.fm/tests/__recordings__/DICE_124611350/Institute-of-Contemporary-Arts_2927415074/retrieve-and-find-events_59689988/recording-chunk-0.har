_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Spring\",\"redirect_url\":\"https://open.spotify.com/track/5FKYSEhkz7sBzlkyLOAXKl\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8670a9a87cf253b470473b6ccfedc1e27e41e3f0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Spring\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Night Tapes\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-19/0067dc29-257d-46db-9a36-75aa9d461aa5.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"29123\",\"about\":null,\"is_headliner\":false},{\"name\":\"THUMPER\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-10/0c477532-7b07-43d8-b4ed-e2e5245eef58.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"14746\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rhumba Club\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-22/6edb12d7-a2c3-485d-b046-bc9ac0f39150.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"132657\",\"about\":null,\"is_headliner\":false},{\"name\":\"KURT.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-04/215c58cf-adba-4318-9e2e-08ae6b7f2104.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"129153\",\"about\":null,\"is_headliner\":false},{\"name\":\"Brian Nasty\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-05-20/37d53b8a-42bf-497e-838b-eb07e8f2d32d.jpg?rect=0%2C2362%2C9449%2C9449\"},\"artist_id\":\"30525\",\"about\":null,\"is_headliner\":false}],\"total_artists\":26,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Kilimanjaro & ILMC.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":74351,\"title\":\"All Access Wristbands\",\"body\":\"The All Access wristband permits entry to all of Soho Calling's venues - including The 100 Club which is only accessible to All Access wristband holders!\\n\\nWith the All Access Wristband, you're able to explore each of the venues and any of the performances from Soho Calling's artists.\\n\\n\\\\*\\\\*Re-entry to venues is permitted with this wristband until venues reach capacity, at which point, admission will no longer be granted. Venues will be busy , so please arrive early at a venue if there's a particular artist you want to see\\\\*\\\\*\",\"order\":0},{\"id\":57459,\"title\":\"Where do I collect my wristband from?\",\"body\":\"\\\\- All Access wristbands need to be collected from 21Soho. Doors open at 7pm.\\n\\n\\\\- A limited number of wristbands wil also be available for collection from The Blue Basement at Third Man Records from 6:30pm.\\n\\nAll Access wristbands will not be available to collect from other venues\",\"order\":1},{\"id\":57432,\"title\":\"Venue entry\",\"body\":\"Re-entry to venues is permitted with this wristband until venues reach capacity. Venues will be busy, so please arrive early at a venue if there's a particular artist you want to see.\",\"order\":2},{\"id\":57433,\"title\":\"Accessibility\",\"body\":\"Please refer to the websites of each venue to check accessibility information.\",\"order\":3}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"10846\",\"name\":\"Various Venues, Soho, London\",\"address\":\"Soho, London\",\"location\":{\"lat\":51.513561,\"lng\":-0.137706},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"various-venues-soho-london-vdnl\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:00