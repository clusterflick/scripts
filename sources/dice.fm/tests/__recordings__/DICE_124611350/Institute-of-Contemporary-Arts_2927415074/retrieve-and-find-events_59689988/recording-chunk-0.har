ount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/p2c8f2935e4d?dice_id=p2c8f2935e4d\",\"post_competition_referral\":\"https://link.dice.fm/G9166492ddab?dice_id=G9166492ddab\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G008c577c14f?dice_id=G008c577c14f\",\"post_purchase_referral\":\"https://link.dice.fm/rcc745e7bf4f?dice_id=rcc745e7bf4f\",\"post_reminder_referral\":\"https://link.dice.fm/j108b85e3684?dice_id=j108b85e3684\",\"post_waitinglist_referral\":\"https://link.dice.fm/U4f74a6fc6a9?dice_id=U4f74a6fc6a9\"},\"perm_name\":\"av38dv-stacy-mitchhart-22nd-jul-lvls-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/3d3d4e2e-0533-46a4-bc0e-54fa86b0f69c.jpg?rect=289%2C0%2C1822%2C1822\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/3d3d4e2e-0533-46a4-bc0e-54fa86b0f69c.jpg?rect=0%2C191%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/3d3d4e2e-0533-46a4-bc0e-54fa86b0f69c.jpg?rect=699%2C0%2C1002%2C1822\"},\"properties\":[],\"about\":{\"description\":\"Stacy Mitchhart’s musical journey began in his native Cincinnati, Ohio, in a home where jazz guitar masters like Wes Montgomery and Johnny Smith were played on the stereo. Therefore it was natural that he gravitated to the six-string. As a child he saw the outrageous Little Richard on a TV show and was captivated by his showmanship. Little Richard looked and acted differently than anybody he had ever been exposed to. Today, Mitchhart has created his own brand of showmanship that brings audiences back again and again.\\n\\n​\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697ca3c91a557900015868c8\",\"name\":\"Stacy Mitchhart\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":