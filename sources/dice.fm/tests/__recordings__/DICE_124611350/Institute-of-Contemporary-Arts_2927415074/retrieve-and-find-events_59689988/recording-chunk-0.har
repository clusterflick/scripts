":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776794400,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:68\",\"price\":{\"currency\":\"GBP\",\"amount\":1326,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/f2bcadbc-c6f6-426e-93bb-4cca55811e69.jpg?rect=0%2C0%2C3957%2C3957\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/f2bcadbc-c6f6-426e-93bb-4cca55811e69.jpg?rect=0%2C792%2C3957%2C2374\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/f2bcadbc-c6f6-426e-93bb-4cca55811e69.jpg?rect=891%2C0%2C2176%2C3957\"},\"id\":\"6989c1e5fcc1b6000197809f\",\"name\":\"Orlando\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Orlando’s deeply emotional songs speak straight to the heart. His heartfelt, emotionally astute lyrics cut to the core, while his atmospheric, lo-fi piano playing captures the raw ache of heartbreak. With a rare ability to turn personal moments into universal anthems, Orlando — the piano-playing boy next door — is emerging as a voice for a new generation navigating the highs and lows of love. Intimate, honest and quietly powerful, his music offers comfort, connection and catharsis in equal measure.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T10:00:00+00:00\",\"sale_end_date\":\"2026-04-21T19:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-04-21T19:00:00+01:00\",\"event_end_date\":\"2026-04-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Orlando - are you still in love with me?\",\"redirect_url\":\"https://open.spotify.com/track/2HJPxIJ9OiE0w23CsmDfLr\",\"artist\":\"Orlando\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7aa784fc657aca04dcc828961b1b9dbabd7ca933?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"are you still in love with me?\"},{\"type\":\"apple_music\",\"title\":\"Orlando - are you still in love with me?\",\"redirect_url\":\"https://music.apple.com/us/album/are-you-still-in-love-with-me/1768448152?i=1768448160&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Orlando\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/30/9b/f4/309bf44a-0967-058d-ec80-533aacb76655/mzaf_8894866628393385500.plus.aac.p.m4a\",\"track_name\":\"are you still in love with me?\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-21T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"announcement_date_unix\":1769446800,\"social_links\":{\"event_share\":\"https://link.dice.fm/q169701f7559?dice_id=q169701f7559\",\"post_competition_referral\":\"https://link.dice.fm/gd9781c224bb?dice_id=gd9781c224bb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lec4040292b3?dice_id=lec4040292b3\",\"post_purchase_referral\":\"https://link.dice.fm/F4897a0aaa34?dice_id=F4897a0aaa34\",\"post_reminder_referral\":\"https://link.dice.fm/M2d05fd98439?dice_id=M2d05fd98439\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ia9c10d05fa0?dice_id=Ia9c10d05fa0\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eo38yd-le-mystre-des-voix-bulgares-21st-apr-the-clapham-grand-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776794400,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:69\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4070},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/d60a09c1-c3fc-4894-b794-b8b308cb188c.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/d60a09c1-c3fc-4894-b794-b8b308cb188c.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/d60a09c1-c3fc-4894-b794-b8b308cb188c.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6977a7e562df1000017d9e9c\",\"name\":\"Le Mystère des Voix Bulgares\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**TUESDAY 21ST APRIL / DOORS & BARS OPEN APPROX. 7PM / SHOW STARTS APPROX 1 HOUR AFTER DOORS / SHOW ENDS APPROX.**\\n\\n**This is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)**\\n\\nThe Mystery of the Bulgarian Voices (Le Mystere des Voix Bulgares) Female Vocal Choir known in the past as The Bulgarian State Television Female Vocal Choir is an ensemble of rare artistic gift and enormous popular appeal. The choir truly represents one of the most amazing success stories in music. Created in the early 1950’s the choir’s first mission was to record authentic and arranged for multiple voices choral folk songs to be recorded and broadcast first on the radio and later on TV.\\n\\nThe Swiss music producer Marcel Cellier discovered the beauty of the Bulgarian folk songs, folk singers, their unique voices and choral skills and in 1975 released his first album with songs performed by the choir – Volume I, which he called “Le Mystere des Voix Bulgares” (The Mystery of the Bulgarian Voices). The album soon became a best seller. In 1987 he released Volume II which in 1990 was awarded a Grammy Award for Best Traditional Folk Recording. It was at that time that the choir adopted the name \\\"Le Mystere des Voix Bulgares\\\". Since then, the choir has performed more than 1,500 concerts outside Bulgaria in some of the most prestigious venues in the world. Choir members have also worked with artists as diverse as Kate Bush and U2, the songs of the choir have been sampled and remixed by Drake, DJ Tiesto, FKA Twigs, Bring Me The Horizon and many others.\\n\\nOnce described as \\\"the marriage of the avant-garde and the Middle Ages\\\", the magic of the ensemble stems from its success in mastering Bulgaria’s diverse, age-old vocal traditions while simultaneously sounding strikingly modern and original, thanks to the unique choral music structure - multi-part a cappella arrangements that transform its collective sound into strange colours as if something other than the human voice is being heard.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T17:00:00+00:00\",\"sale_end_date\":\"2026-04-21T19:00:00+01:00\",\"sale_start_date\":\"2026-01-26T17:00:00+00:00\",\"event_start_date\":\"2026-04-21T19:00:00+01:00\",\"event_end_date\":\"2026-04-21T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Farazi\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebcb468e9aefa733dd4c2277f0\"},\"artist_id\":\"131746\",\"about\":null,\"is_headliner\":false},{\"name\":\"Savai\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb51ad11404c52ad716f6cd982\"},\"artist_id\":\"131747\",\"about\":null,\"is_headliner\":false},{\"name\":\"Sorgu\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3cc751e6057e620d3fdeb07a\"},\"artist_id\":\"131748\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kodes Kahra\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba10cab486902507540e0bdb7\"},\"artist_id\":\"131749\",\"about\":null,\"is_headliner\":false}],\"total_artists\":4,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":65974,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-21T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1766361600,\"social_links\":{\"event_share\":\"https://link.dice.fm/i57bf18cd15c?dice_id=i57bf18cd15c\",\"post_competition_referral\":\"https://link.dice.fm/r663eb04632c?dice_id=r663eb04632c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I368dcf7cd38?dice_id=I368dcf7cd38\",\"post_purchase_referral\":\"https://link.dice.fm/Sd58fd41768f?dice_id=Sd58fd41768f\",\"post_reminder_referral\":\"https://link.dice.fm/Ta8db5fb16a7?dice_id=Ta8db5fb16a7\",\"post_waitinglist_referral\":\"https://link.dice.fm/O44e78a419b3?dice_id=O44e78a419b3\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q26399-farazi-friends-savai-sorgu-kodes-kahra-21st-apr-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776794400,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:70\",\"price\":{\"currency\":\"GBP\",\"amount\":2460,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/9e5039de-39c2-43d5-b201-776916892b59.jpg?rect=169%2C83%2C996%2C997\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/9e5039de-39c2-43d5-b201-776916892b59.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/9e5039de-39c2-43d5-b201-776916892b59.jpg?rect=663%2C0%2C594%2C1080\"},\"id\":\"69492599739dc200015737b2\",\"name\":\"Farazi & Friends: Savai, Sorgu & Kodes Kahra\",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"**A powerhouse night of Turkish rap, live in London.**\\n\\nFarazi, Istanbul-born producer and one of Turkish rap’s defining voices, takes over the stage with beats that have shaped a generation. Joining him are Savai, Sorgu, and Kodes Kahra — razor-sharp emcees, masterful storytellers, and unstoppable performers.\\n\\nThis is a rare chance to see these icons together, delivering a night of energy, rhythm, and a night that London won’t forget.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T00:00:00+00:00\",\"sale_end_date\":\"2026-04-21T19:00:00+01:00\",\"sale_start_date\":\"2025-12-22T00:00:00+00:00\",\"event_start_date\":\"2026-04-21T19:00:00+01:00\",\"event_end_date\":\"2026-04-21T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Farazi & Kodes Kahra - Fırtına\",\"redirect_url\":\"https://music.apple.com/us/album/f%C4%B1rt%C4%B1na/1484722562?i=1484722839&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Farazi & Kodes Kahra\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/a2/e1/f8/a2e1f86b-639b-51c0-fc75-47ba292bbfdc/mzaf_7775482703655966301.plus.aac.p.m4a\",\"track_name\":\"Fırtına\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Maiden Races\",\"image\":null,\"artist_id\":\"133990\",\"about\":null,\"is_headliner\":false},{\"name\":\"Matt-Felix\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-28/a2c1925f-1280-43b5-82c7-5d43ac2b0b86.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"96710\",\"about\":null,\"is_headliner\":false},{\"name\":\"Balancing Act\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-08/b05bd9b6-1c31-46