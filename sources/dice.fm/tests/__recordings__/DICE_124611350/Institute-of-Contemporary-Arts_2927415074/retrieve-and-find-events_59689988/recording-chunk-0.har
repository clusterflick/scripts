ras_available_referral\":\"https://link.dice.fm/Hb6ceb875c20?dice_id=Hb6ceb875c20\",\"post_purchase_referral\":\"https://link.dice.fm/o91a91e640fc?dice_id=o91a91e640fc\",\"post_reminder_referral\":\"https://link.dice.fm/cb3072a5b0d4?dice_id=cb3072a5b0d4\",\"post_waitinglist_referral\":\"https://link.dice.fm/fd594c1baff1?dice_id=fd594c1baff1\"},\"perm_name\":\"53rw7d-prolapse-7th-aug-the-100-club-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/d4a4625c-7c66-4387-b210-4fb00e05631c.jpg?rect=321%2C0%2C1279%2C1279\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/d4a4625c-7c66-4387-b210-4fb00e05631c.jpg?rect=0%2C64%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/d4a4625c-7c66-4387-b210-4fb00e05631c.jpg?rect=609%2C0%2C703%2C1279\"},\"properties\":[],\"about\":{\"description\":\"PROLAPSE formed in Leicester in the early 90s and are now spread across the UK and Scandinavia. Still pursuing their own path of repetition and twisted melodies, they merge influences from post punk to krautrock and even folk. Their previous releases have included numerous singles and four albums on various labels, including Cherry Red and Radar. They feature vocalists Mick Derrick and Linda Steelyard, whose intense duelling vocals combine with ferocious triple guitar assault and pummelling rhythms.\\n\\nThe fifth Prolapse album “I Wonder When They’re Going to Destroy Your Face” will be released on Tapete Records and marks the bands first new recordings since their last album, “Ghosts of Dead Aeroplanes”, released 26 years ago, but in some ways it feels like there hasn’t a break at all. From the opening incessant riff of ”The Fall of Cashline”, Prolapse set their stall out, hammering the message that they’re back, over and over (and over and over) again.\\n\\nhttps://prolapse2.bandcamp.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698365de21dfbc0001253f56\",\"name\":\"Prolapse\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Prolapse - Cha Cha Cha 2000\",\"redirect_url\":\"https://open.spotify.com/track/3s4WwXxQHxadk07CvIdpm4\",\"artist\":\"Prolapse\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8fa4fd1ee3c203971555379e42a7c4f3da2cf1f3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cha Cha Cha 2000\"},{\"type\":\"apple_music\",\"title\":\"Prolapse - Cha Cha Cha 2000\",\"redirect_url\":\"https://music.apple.com/us/album/cha-cha-cha-2000/1819073208?i=1819073215&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Prolapse\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/79/b3/b8/79b3b872-9b47-05cd-2ac9-7e91bd41271c/mzaf_16172319512558860278.plus.aac.p.m4a\",\"track_name\":\"Cha Cha Cha 2000\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Prolapse\",\"image\":null,\"artist_id\":\"7936\",\"about\":{\"description\":\"PROLAPSE formed in Leicester in the early 90s and are now spread across the UK and Scandinavia. Still pursuing their own path of repetition and twisted melodies, they merge influences from post punk to krautrock and even folk. Their previous releases have included numerous singles and four albums on various labels, including Cherry Red and Radar. They feature vocalists Mick Derrick and Linda Steelyard, whose intense duelling vocals combine with ferocious triple guitar assault and pummelling rhythms.\\n\\nThe fifth Prolapse album “I Wonder When They’re Going to Destroy Your Face” will be released on Tapete Records and marks the bands first new recordings since their last album, “Ghosts of Dead Aeroplanes”, released 26 years ago, but in some ways it feels like there hasn’t a break at all. From the opening incessant riff of ”The Fall of Cashline”, Prolapse set their stall out, hammering the message that they’re back, over and over (and over and over) again.\\n\\nhttps://prolapse2.bandcamp.com/\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Fri 07 Aug\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T11:30:00+00:00\",\"sale_end_date\":\"2026-08-08T12:00:00+01:00\",\"sale_start_date\":\"2026-03-03T11:00:00+00:00\",\"event_start_date\":\"2026-08-08T17:00:00+01:00\",\"event_end_date\":\"2026-08-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by PrettyTwistedLive.\",\"seating\":null,\"announcement_date_unix\":1771241400,\"venues\":[{\"id\":\"11247\",\"name\":\"Archives LDN \",\"address\":\"N15 4QN, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.5850507,\"lng\":-0.0625218},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"archives-ldn-oawg\",\"accessibility\":{\"url\":\"https://archivesldn.com/information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-08T17:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"announced\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"10671\",\"name\":\"PrettyTwistedLive\",\"image\":{\"url\":null},\"perm_name\":\"prettytwistedlive-odwg\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:97\",\"date_unix\":1786204800,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/N765f262e17c?dice_id=N765f262e17c\",\"post_competition_referral\":\"https://link.dice.fm/ydb1712bba1b?dice_id=ydb1712bba1b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G9e91ff29ddd?dice_id=G9e91ff29ddd\",\"post_purchase_referral\":\"https://link.dice.fm/yc0ca2858898?dice_id=yc0ca2858898\",\"post_reminder_referral\":\"https://link.dice.fm/I695db1fe554?dice_id=I695db1fe554\",\"post_waitinglist_referral\":\"https://link.dice.fm/qecb766f2817?dice_id=qecb766f2817\"},\"perm_name\":\"k6n3ap-twstdfest-26-8th-aug-archives-ldn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/6af59d1e-e5d0-48f2-84d4-4df5f43267e3.jpg?rect=360%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/6af59d1e-e5d0-48f2-84d4-4df5f43267e3.jpg?rect=0%2C72%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/6af59d1e-e5d0-48f2-84d4-4df5f43267e3.jpg?rect=684%2C0%2C792%2C1440\"},\"properties\":[],\"about\":{\"description\":\"**TWSTDFEST** returns on **Saturday 8 August 2026** with our biggest show yet, taking over **Club 360** in **Tottenham Hale** for a full 360-degree stage experience. This is the next era of **PrettyTwisted\\\\*** \\\\- immersive production, breakout performances and a line-up that captures the future of Black British music.\\n\\nExpect exclusive sets, rising talent, heavy energy and a world-building atmosphere that turns the venue into its own universe. **TWSTDFEST** has built a reputation for bringing new artists to the forefront, and **2026** pushes that vision even further with bold visuals, deep sound design and a crowd that comes ready to move.\\n\\nIf you’ve been to a **PrettyTwisted\\\\*** event, you already know the feeling. If you haven’t, this is the one to start with. Capacity is extremely limited, and tickets will move quickly.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69329fbadeb0920001256fd5\",\"name\":\"TWSTDFEST 26 \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"max_tickets\":5,\"event_tag\":null}],\"title\":\"Sat 08 Aug\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
