b-b19c-3c754d3b9bb1.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/8a68a0d5-8c54-463b-b19c-3c754d3b9bb1.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/8a68a0d5-8c54-463b-b19c-3c754d3b9bb1.jpg?rect=675%2C0%2C1650%2C3000\"},\"max_tickets\":10,\"social_links\":{\"event_share\":\"https://link.dice.fm/pfa3deaff64c?dice_id=pfa3deaff64c\",\"post_competition_referral\":\"https://link.dice.fm/O20c8c6bbda4?dice_id=O20c8c6bbda4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Oaf6a758b6a1?dice_id=Oaf6a758b6a1\",\"post_purchase_referral\":\"https://link.dice.fm/R4f6ea477ade?dice_id=R4f6ea477ade\",\"post_waitinglist_referral\":\"https://link.dice.fm/x7c202c638ec?dice_id=x7c202c638ec\",\"post_reminder_referral\":\"https://link.dice.fm/Qc8f910b3e7f?dice_id=Qc8f910b3e7f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"37\",\"name\":\"The Old Blue Last\",\"address\":\"38 Great Eastern Street, London EC2A 3ES\",\"location\":{\"lat\":51.5245266,\"lng\":-0.0806281999999783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-blue-last-4ryw\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Brighton’s AMANZI is presenting her debut album The Village, live, for the very first time in London. The Village is a deeply personal body of work: a journey through AMANZI’s life told in near-chronological order, from the pains of growing up to the clarity that comes with healing. Each song is a letter: sometimes to the people she loves, sometimes to the ones she had to let go, and sometimes to herself. Together, they shape The Village - a tribute to the chosen circle who lifted her, challenged her, and changed her forever.\\n\\nAt The Old Blue Last AMANZI's Village opens its doors for her London debut. For one night, the stories, letters, and memories become a living space - and everyone in the room becomes part of the village. Come join AMANZI and step inside her world.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:33\",\"billing_promoter\":{\"id\":\"143001\",\"name\":\"AMANZI Presents: The Village\",\"image\":{\"url\":null},\"perm_name\":\"amanzi-presents-the-village-am9ld\",\"profile_active\":false},\"presented_by\":\"Presented by AMANZI \",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+Last+.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1768824000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T12:00:00+00:00\",\"sa