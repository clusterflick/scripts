vpvlK6ZORLBgNKHXuzru\",\"artist\":\"Yellow Swans\",\"preview_url\":\"https://p.scdn.co/mp3-preview/164e1b9ce4ba8322e9745cecfd8177c9909bf969?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Foiled\"},{\"type\":\"apple_music\",\"title\":\"Yellow Swans - Foiled\",\"redirect_url\":\"https://music.apple.com/us/album/foiled/350133813?i=350133820&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Yellow Swans\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/ea/f4/1e/eaf41efd-27cf-754c-9143-7413c24fe9f0/mzaf_9496165967343198520.plus.aac.p.m4a\",\"track_name\":\"Foiled\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1760518800,\"max_tickets\":6,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nYellow Swans + Dhangsha & aya (DJ Set)\\n\\nCorsica Studios - February 18th\\n\\nFrom their 2001 founding to the duo’s final shows (and subsequent hiatus) in 2008, Gabriel Mindel Saloman and Pete Swanson aka Yellow Swans carved an influential path through America’s experimental music underground, at the axis of noise, psychedelia, industrial, drone, and hardcore. During that time they released well over 50 recordings documenting studio experiments, live improvisations, and numerous collaborations. Together they relentlessly toured North America, Europe, and Oceania, performing at numerous international music festivals including Sonar (ES), Open Circuit (BE), and Sonic Protest (FR), and were invited to join Art Council England’s Free Noise Tour in 2007. After a 15 year break, they have returned to recording and performing. Their music continues to be restless, ragged, and forever in flux, untethered and unresolved.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:56\",\"social_links\":{\"event_share\":\"https://link.dice.fm/o9395677f97b?dice_id=o9395677f97b\",\"post_competition_referral\":\"https://link.dice.fm/Y0a51204dda2?dice_id=Y0a51204dda2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fe6f8660e254?dice_id=Fe6f8660e254\",\"post_purchase_referral\":\"https://link.dice.fm/Wfa93ffb9d7e?dice_id=Wfa93ffb9d7e\",\"post_reminder_referral\":\"https://link.dice.fm/t84edb3cf538?dice_id=t84edb3cf538\",\"post_waitinglist_referral\":\"https://link.dice.fm/m970010506fc?dice_id=m970010506fc\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-15T10:00:00+01:00\",\"sale_end_date\":\"2026-02-18T18:00:00+00:00\",\"sale_start_date\":\"2025-10-15T10:00:00+01:00\",\"event_start_date\":\"2026-02-18T19:30:00+00:00\",\"event_end_date\":\"2026-02-18T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2204,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"id\":\"68e3da50380d37000185b940\",\"seats_io_event_id\":null,\"name\":\"Yellow Swans + Dhangsha & aya (DJ Set)\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nv7l58-yellow-swans-dhangsha-aya-dj-set-18th-feb-corsica-studios-london-tickets\",\"date_unix\":1771443000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Westerman\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-25/8182c3e0-8f41-4ca8-8b7b-b0e25bd12c3e.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"4957\",\"about\":{\"description\":\"Singer-songwriter Westerman began his career at London open mic nights singing folk-pop, before embracing a dreamier ’70s-inspired soft rock sound with 2020’s Your Hero Is Not Dead. Born in south London and based in Athens, his gentle falsetto shines over warm atmospheric production and flourishes of electronica.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":46125,\"title\":\"What are the age restrictions?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-30/4952974c-7cc2-476b-b74c-fd8958940f51.jpg?rect=842%2C0%2C3316%2C3316\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-30/4952974c-7cc2-476b-b74c-fd8958940f51.jpg?rect=0%2C158%2C5000%2C3000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-30/4952974c-7cc2-476b-b74c-fd8958940f51.jpg?rect=1588%2C0%2C1824%2C3316\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Confirmation\",\"redirect_url\":\"https://open.spotify.com/track/6pIem0QfCkJMl4ug4byHhk\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0b534543cb8c45b12425a9ae96a0bf0490418111?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Confirmation\"},{\"type\":\"apple_music\",\"title\":\"Westerman - Take\",\"redirect_url\":\"https://music.apple.com/us/album/take/1654716814?i=1654717688&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Westerman\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/be/5c/b5/be5cb5f8-0ef7-9d79-3eb0-caffc5e41b5f/mzaf_11667430791945399148.plus.aac.p.m4a\",\"track_name\":\"Take\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1759222800,\"max_tickets\":6,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Following the release of new single “About Leaving” — the second track from his upcoming album A Jackal’s Wedding (out 7 November via Partisan Records) — Westerman announces a run of headline shows across the UK, Europe and North America for Spring 2026, including this special London date.\\n\\nWritten largely in Athens and recorded on the Greek island of Hydra with producer Marta Salogni (Björk, The xx, Sampha), A Jackal’s Wedding is a reflective, immersive album shaped by a sense of movement, place, and personal renewal. New single “About Leaving” serves as a mission statement for the record — both introspective and propulsive, it marks a matured evolution in Westerman’s sound.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_onl