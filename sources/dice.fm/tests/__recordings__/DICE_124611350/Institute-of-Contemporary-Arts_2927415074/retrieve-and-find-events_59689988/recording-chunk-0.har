event_share\":\"https://link.dice.fm/k30d79e490c5?dice_id=k30d79e490c5\",\"post_competition_referral\":\"https://link.dice.fm/v5146cef01bc?dice_id=v5146cef01bc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v7b1e96d41aa?dice_id=v7b1e96d41aa\",\"post_purchase_referral\":\"https://link.dice.fm/nec4d7411cb8?dice_id=nec4d7411cb8\",\"post_reminder_referral\":\"https://link.dice.fm/edec33bd6548?dice_id=edec33bd6548\",\"post_waitinglist_referral\":\"https://link.dice.fm/y9585223e3bf?dice_id=y9585223e3bf\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:3\",\"properties\":[],\"presented_by\":\"Presented by Folklore (Label).\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1757926800,\"id\":\"68bffe56255f4900011692ea\",\"name\":\"Trappist Afterland + The Gentle Good + Henry Parker\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Step aboard Theatre Ship for an intimate night of boundary-pushing folk. Adam Geoffrey Cole, the visionary behind Trappist Afterland, brings his acclaimed blend of spiritual psych-folk, Eastern rhythms and hypnotic instrumentation to London. Joining him are two of the UK’s most celebrated folk voices, The Gentle Good and Henry Parker, whose intricate guitar work and richly woven songs have earned them recognition across the British folk scene. Together, they promise a deeply atmospheric evening of poetic storytelling, haunting melodies and transformative soundscapes.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1711\",\"name\":\"Folklore (Label)\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-07/3bb4efaa-5b2f-48dd-818a-8fc78c758f3c.jpg\"},\"perm_name\":\"folklore-label-w8nx\",\"profile_active\":true},\"date_unix\":1772825400,\"event_tag\":null