/attachments/2026-02-09/003dc61c-b286-4ae3-88d4-ce381ab171f4.jpg?rect=304%2C0%2C743%2C1350\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"new\":false,\"announcement_date_unix\":1743678000,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4532},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-28T10:00:00+00:00\",\"sale_end_date\":\"2026-03-13T21:00:00+00:00\",\"sale_start_date\":\"2025-10-29T10:00:00+00:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Columbo Music.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/u3499f160a0b?dice_id=u3499f160a0b\",\"post_competition_referral\":\"https://link.dice.fm/xdc5f2c4e646?dice_id=xdc5f2c4e646\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ra32ccab6b58?dice_id=Ra32ccab6b58\",\"post_purchase_referral\":\"https://link.dice.fm/P6f0772fa862?dice_id=P6f0772fa862\",\"post_reminder_referral\":\"https://link.dice.fm/H86ceeea8b1b?dice_id=H86ceeea8b1b\",\"post_waitinglist_referral\":\"https://link.dice.fm/M4d82de39909?dice_id=M4d82de39909\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nOne of the most legendary figures in hip-hop history, Pete Rock returns to the capital with Amxxr to showcase one of the best live hip-hop outfits on the planet.\\n\\nDeriving from a period that many consider to be the ‘golden-era’ of hip-hop, Pete Rock is one of the true godfathers of the genre.\\n\\nKnown by many for his huge contribution to Nas’ ‘Illmatic’, referred to by many as one of the greatest hip-hop albums of all time; Pete Rock has also worked with the likes of Rakim, Wu Tang Clan, Public Enemy, Talib Kweli and Busta Rhymes to name a few.\\n\\nHis unique approach to fusing jazz elements with the east-coast hip-hop sound, coupled with his unprecedented sampling ability has led to him becoming one of the most respected producers in the game, and he now heads to EartH.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2089,\"name\":\" The Columbo Group\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"556297964005636\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":nu