rchase_referral\":\"https://link.dice.fm/M9f050d60b4d?dice_id=M9f050d60b4d\",\"post_reminder_referral\":\"https://link.dice.fm/H73b07ec96a5?dice_id=H73b07ec96a5\",\"post_waitinglist_referral\":\"https://link.dice.fm/b575da0b7acd?dice_id=b575da0b7acd\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"92wl76-fleetwood-macs-rumours-25th-feb-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772046000,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:26\",\"price\":{\"currency\":\"GBP\",\"amount\":2075,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/3d42a623-0516-4647-a19e-5fa9d3101c12.jpg?rect=0%2C0%2C960%2C960\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/3d42a623-0516-4647-a19e-5fa9d3101c12.jpg?rect=0%2C192%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/3d42a623-0516-4647-a19e-5fa9d3101c12.jpg?rect=216%2C0%2C528%2C960\"},\"id\":\"6964d2c500b0800001db59c0\",\"name\":\"Fleetwood Mac's Rumours\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Fleetwood Mac’s Rumours remains one of the most emotionally charged records ever made — a body of songs built on harmony, fracture and immaculate pop song writing.**\\n\\nPerformed live in full, this show focuses on the detail, tension and interplay that give the album its lasting power.\\n\\nA three-voice frontline and a tightly tuned rhythm section, allowing the songs to breathe without imitation or excess.\\n\\nAlongside Rumours in its entirety, the set draws from Fleetwood Mac’s wider catalogue, tracing the band’s evolution through songs that continue to resonate across generations.\\n\\n*This event does not feature a performance by Fleetwood Mac and is not affiliated with the band.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T11:00:00+00:00\",\"sale_end_date\":\"2026-02-25T19:00:00+00:00\",\"sale_start_date\":\"2026-01-12T11:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Hot Box & City Sound\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"announcement_date_unix\":1761609600,\"social_links\":{\"event_share\":\"https://link.dice.fm/r1d76c4d7e0b?dice_id=r1d76c4d7e0b\",\"post_competition_referral\":\"https://link.dice.fm/M0f4b455485f?dice_id=M0f4b455485f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Maa4a3c3b939?dice_id=Maa4a3c3b939\",\"post_purchase_referral\":\"https://link.dice.fm/k2f8d56cb121?dice_id=k2f8d56cb121\",\"post_reminder_referral\":\"https://link.dice.fm/x4c4a377fb36?dice_id=x4c4a377fb36\",\"post_waitinglist_referral\":\"https://link.dice.fm/ndee3a6d6c80?dice_id=ndee3a6d6c80\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q27y5p-nmw-myopia-oceanvein-25th-feb-hot-box-chelmsford-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772046000,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:27\",\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/25a307a2-e46e-4b94-bf8c-f650965000cc.jpg?rect=275%2C0%2C1498%2C1498\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/25a307a2-e46e-4b94-bf8c-f650965000cc.jpg?rect=0%2C135%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/25a307a2-e46e-4b94-bf8c-f650965000cc.jpg?rect=612%2C0%2C824%2C1498\"},\"id\":\"69600dd328d2a600017c4870\",\"name\":\"NMW - Myopia / Oceanvein\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"City Sound and Hot Box team up again for another New Music Wednesday, with the whole show not only live on stage but broadcast simultaneously on City Sound (citysound.radio).\\n\\n**MYOPIA**\\n\\nForming out of two small neighbouring towns near Colchester Essex comes genre-defying alternative rock band Myopia. With influences including Muse, Radiohead and Keane, Myopia released their debut album Living on Sixes in 2020. \\n\\nSince then, the band paved the way for a brand-new era of dynamic sounds and aesthetics, unleashing their second studio album Mind Party in August 2024. The project “showcased DIY music-making at its finest” and garnered attention from various radio stations, including the New Music Generator, winning ‘NMG Rock Artist of the Year’ in 2024. \\n\\nThe duo will be taking the stage once again with the 2026 tour “What Happens Next” promoting their upcoming EP, and with nine dates currently scheduled across February, March and April, each performance will showcase both current and new music. \\n\\nMyopia’s songwriting is a rich musical tapestry, with layers of meaning and emotion to be uncovered. It’s the very soul of its creator: ever-changing, ever-growing, Myopia’s sound knows no bounds.\\n\\n**OCEANVEIN**\\n\\nDiving into the depths and delights of modern heavy music, Oceanvein boasts an outrageously ambitious collective of creative explorers. Since its humble inception as a passion project between lifelong friends Lucas Colyer and David Mackay, Oceanvein has expanded to a full-on cabal of deeply motivated comrades.\\n\\nBlending hypnagogic textures and enchanting melodies with a dose of disgustingly heavy riffs, their oeuvre officially commenced in 2025 with huge releases and pulse-pounding live shows. If you have any interest in the state of modern rock music, you need to check these guys out!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"UND 18s to be accompanied by an adult in the ratio 1:1\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-25T19:00:00+00:00\",\"sale_start_date\":\"2025-10-28T00:15:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Borough Council\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-03/5c845977-7c51-4352-bb38-bb4c92ef9c55.jpg?rect=0%2C51%2C539%2C539\"},\"artist_id\":\"79305\",\"about\":null,\"is_headliner\":false},{\"name\":\"Anthony Moore\",\"image\":null,\"artist_id\":\"131973\",\"about\":null,\"is_headliner\":false},{\"name\":\"Otti Albietz\",\"image\":null,\"artist_id\":\"131974\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Resonance.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1505\",\"name\":\"The Horse Hospital\",\"address\":\"The Horse Hospital, 30 Colonnade, Bloomsbury, London WC1N 1JD, UK\",\"location\":{\"lat\":51.5230123,\"lng\":-0.12402510000003986},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238f