te\":\"2026-08-02T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1213\",\"name\":\"Bush Hall\",\"image\":{\"url\":null},\"perm_name\":\"bush-hall-r33w\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:90\",\"date_unix\":1785693600,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3909},\"social_links\":{\"event_share\":\"https://link.dice.fm/oa064b256743?dice_id=oa064b256743\",\"post_competition_referral\":\"https://link.dice.fm/kd9b0522b698?dice_id=kd9b0522b698\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p98abb5ab7f3?dice_id=p98abb5ab7f3\",\"post_purchase_referral\":\"https://link.dice.fm/t07149ab8610?dice_id=t07149ab8610\",\"post_reminder_referral\":\"https://link.dice.fm/S2d93f64eefd?dice_id=S2d93f64eefd\",\"post_waitinglist_referral\":\"https://link.dice.fm/Beecfea4b550?dice_id=Beecfea4b550\"},\"perm_name\":\"eo39p6-coleen-nolan-2nd-aug-bush-hall-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/55744635-596d-4971-92f1-23711819abe1.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/55744635-596d-4971-92f1-23711819abe1.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/55744635-596d-4971-92f1-23711819abe1.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Coleen Nolan is hitting the road for a joyous celebration of life, love, and laughter with her brand new live show ‘This Is Me’.\\n\\nShe was the girl next door who, with her sisters, set an entire generation ‘In the Mood For Dancing’ and later became the relatable long-standing panellist on Loose Women. Coleen invites audiences to get up close and personal in an unforgettable evening packed with live music, stories, heartfelt moments and plenty of laughs.\\n\\n‘This Is Me’ is Coleen like you’ve never seen her before: raw, real and ridiculously fun. Expect a night packed with unfiltered stories from her life, interactive games with her son Shane, an anything-goes audience Q&A, and a cheeky, hilarious take on turning 60, all wrapped up in Coleen’s trademark warmth and wit, plus a couple of songs that reflect on Coleen’s life.\\n\\nColeen says: “I am so excited to bring my brand new live show out on the road after the huge success of my first solo tour. I’ve had some great times in my life. I want to share the fun memories but also, there was heartache too. This show is about embracing life, telling the truth, having a laugh, and celebrating who we are, wrinkles, wobbly bits and all! I can’t wait to share this night with people up and down the country. Get ready to laugh, cry, and dance your pants off!”\\n\\nWith limited dates and intimate venues, ‘This Is Me’ promises to be one of the feel-good live events of the year — a night full of laughs, mischief, and Coleen’s unmistakable charm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event, Under 18's accompanied\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697cca68331dd70001663f76\",\"name\":\"Coleen Nolan\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T10:00:00+00:00\",\"sale_end_date\":\"2026-08-02T20:00:00+01:00\",\"sale_start_date\":\"2026-02-02T10:00:00+00:00\",\"event_start_date\":\"2026-08-02T20:00:00+01:00\",\"event_end_