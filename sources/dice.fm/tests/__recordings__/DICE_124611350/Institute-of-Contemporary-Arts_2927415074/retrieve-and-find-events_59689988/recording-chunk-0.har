"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=875%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=125%2C0%2C3750%2C2250\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=1381%2C0%2C1238%2C2250\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Zf35ee557ec0?dice_id=Zf35ee557ec0\",\"post_competition_referral\":\"https://link.dice.fm/l3c762e2df68?dice_id=l3c762e2df68\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/xf3c75fcfa43?dice_id=xf3c75fcfa43\",\"post_purchase_referral\":\"https://link.dice.fm/C36b2fdcb85f?dice_id=C36b2fdcb85f\",\"post_reminder_referral\":\"https://link.dice.fm/s5118cb21e40?dice_id=s5118cb21e40\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jfd7ee824879?dice_id=Jfd7ee824879\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:55\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764752400,\"id\":\"6930b0b835b9fc000107a7fb\",\"name\":\"Independance\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Independence project & Clubs provide a multitude of activities so that people can participate in new experiences and in things that they enjoy.\\n\\nFrom our own research we learned that previous live music events in Chelmsford that supported the learning disability community had all ceased, certainly club nights are just not happening. We've sprung into action to make a change.\\n\\nIndepenDANCE was born! We've partnered with Eazee Learning & Hot Box. Both organisations share our ethos and always go the extra mile whilst making a difference in their communities, so it’s the perfect match!\\n\\nWe are excited and hopeful that we will create a real buzz around these nights. Ultimately enabling people with additional needs the opportunity to let their hair down, meet friends & have a DANCE!\\n\\nThis is carried out in a safe environment with staff on hand to support; those attending will enjoy their night with the confidence that there are people around them that are there to help.\\n\\nOur music acts will be showcasing the superb talent within the additional needs community and the DJs providing the entertainment also have additional needs, playing the best in House, UK garage, R&B, Decades, theme nights and Club Classics.\\n\\nWe are hopeful to put on many live music events in the future and they will always be run like any other club night, promoting inclusion and diversity, and enabling people to enjoy real life experiences. Please spread the message and help us to make them a success. Let's Go!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1792605600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4725},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T10:00:00+00:00\",\"sale_end_date\":\"2026-10-21T17:30:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-10-21T19:00:00+01:00\",\"event_end_date\":\"2026-10-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eowe7o-the-mountain-goats-21st-oct-hackney-church-london-tickets\",\"seats_i