attachments/2025-12-03/b6a31994-1787-4057-9cae-494f6d9f6569.jpg?rect=0%2C1232%2C3789%2C2273\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/b6a31994-1787-4057-9cae-494f6d9f6569.jpg?rect=592%2C0%2C2605%2C4736\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q629cc31f845?dice_id=Q629cc31f845\",\"post_competition_referral\":\"https://link.dice.fm/l5d1839d7a3c?dice_id=l5d1839d7a3c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/o93d80f0d939?dice_id=o93d80f0d939\",\"post_purchase_referral\":\"https://link.dice.fm/xf062e0427a1?dice_id=xf062e0427a1\",\"post_reminder_referral\":\"https://link.dice.fm/Y7104be16794?dice_id=Y7104be16794\",\"post_waitinglist_referral\":\"https://link.dice.fm/gee9066386be?dice_id=gee9066386be\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:13\",\"properties\":[],\"presented_by\":\"Presented by Como No!.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764849600,\"id\":\"6930217529ada40001fe1331\",\"name\":\"Carminho\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Carminho returns with her seventh album, Eu vou Morrer de Amor ou Resistir (“I Will Die of Love or Resist”), a profound and intimate exploration of Fado’s emotional and artistic possibilities. This new work reinforces the artist’s unwavering dedication to expanding the boundaries of the genre, while continuing to affirm a personal voice that has made her one of the most singular figures in contemporary Portuguese music.\\n\\nHer artistic path continues to expand. Recently, she collaborated on “Memória,” a track from Rosalía’s album LUX, demonstrating how her voice moves effortlessly across musical worlds while remaining grounded in the emotional truth of Fado. That same depth, intimacy, and versatility will be present in this concert, making Eu vou Morrer de Amor ou Resistir a live experience where tradition and experimentation coexist, and where every note resonates long after the final song.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"12+ under 16s must be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"5970\",\"name\":\"Como No!\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-09/a9850c4f-895d-494f-beec-abcf15aec03e.jpg\"},\"perm_name\":\"como-no-v7rd\",\"profile_active\":true},\"date_unix\":1791135000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3116,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-10-04T15:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-10-04T19:00:00+01:00\",\"event_end_date\":\"2026-10-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"537brl-fischer-z-4th-oct-oslo-hackney-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{