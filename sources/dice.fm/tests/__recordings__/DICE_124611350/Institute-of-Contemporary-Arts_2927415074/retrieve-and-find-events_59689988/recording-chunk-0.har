ps://link.dice.fm/Q08ce0d7e693?dice_id=Q08ce0d7e693\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pd8667909673?dice_id=Pd8667909673\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:60\",\"properties\":[],\"presented_by\":\"Presented by Communion One.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769187600,\"id\":\"69736c07637cfd000161132e\",\"name\":\"Deco\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Good mood music. Deco have become one of the UK’s most intriguing viral pop acts in the last 2 years. With their knack for classic songwriting and capturing millions across social media, the quintet, formed by siblings & lifelong friends, blend the contemporary with their love of the synth pop records, thrust upon them by their parents growing up.\\n\\n2024 was a breakthrough year for the band. After a big summer of touring with music legends Nile Rodgers & CHIC + Sophie Ellis Bextor, Deco released their acclaimed debut album 'Destination: I Don't Know' which entered the Official UK Album Sales chart at Number 10 and has been endorsed by the likes of Nile Rodgers & Elton John. The album is currently on the road for festival season after Deco's sold out UK tour last Autumn.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":nul