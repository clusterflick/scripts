ndscape\":\"https://dice-media.imgix.net/attachments/2025-09-30/a5b94f25-b123-4605-8d8a-b31786ddc7fd.jpg?rect=0%2C195%2C961%2C577\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-30/a5b94f25-b123-4605-8d8a-b31786ddc7fd.jpg?rect=215%2C0%2C532%2C967\"},\"properties\":[],\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68cc0a9f6edbb0000169e8b4\",\"name\":\"Unknown Mortal Orchestra\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"So Good At Being in Trouble\",\"redirect_url\":\"https://open.spotify.com/track/5VarZFY00sO54HErJ3TPCI\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9e838a74e02187cb0a540636365500e6c4ff594e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"So Good At Being in Trouble\"},{\"type\":\"apple_music\",\"title\":\"Unknown Mortal Orchestra - Multi-Love\",\"redirect_url\":\"https://music.apple.com/us/album/multi-love/962057741?i=962057746&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Unknown Mortal Orchestra\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/13/5d/5a/135d5a6f-7e68-f23a-a7ac-6c7dfad2f415/mzaf_16572460885602912574.plus.aac.p.m4a\",\"track_name\":\"Multi-Love\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Unknown Mortal Orchestra\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-18/5c35db69-40b7-4fb5-8f07-713ab53570a7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"77\",\"about\":{\"description\":\"Formed in Auckland in 2010, Unknown Mortal Orchestra began the decade recording and anonymously releasing their psychedelic flavour of rock online. Led by frontman Ruban Nielson, the trio’s amalgamation of lo-fi, pop, disco and shoe-gaze on Multi-Love (2016) and 2018’s instrumental effort IC-01 Hanoi has won praise from Pitchfork, NME and Clash.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T18:45:00+00:00\",\"sale_end_date\":\"2026-03-31T19:00:00+01:00\",\"sale_start_date\":\"2026-02-13T18:45:00+00:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":