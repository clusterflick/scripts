},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lower-third-pply\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"The Lower Third (Up)\",\"doors_open_date\":\"2026-04-01T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:71\",\"date_unix\":1775068200,\"price\":{\"currency\":\"GBP\",\"amount\":1122,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/D45fc3700bcf?dice_id=D45fc3700bcf\",\"post_competition_referral\":\"https://link.dice.fm/G8000e15814b?dice_id=G8000e15814b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p00db3ba0402?dice_id=p00db3ba0402\",\"post_purchase_referral\":\"https://link.dice.fm/x5afd67752a1?dice_id=x5afd67752a1\",\"post_reminder_referral\":\"https://link.dice.fm/h924c219bb60?dice_id=h924c219bb60\",\"post_waitinglist_referral\":\"https://link.dice.fm/V52e53012a71?dice_id=V52e53012a71\"},\"perm_name\":\"l89e5p-noah-malcolm-jean-mikhael-stripped-in-soho-1st-apr-the-lower-third-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/d444a718-3a2c-45b3-821f-f8fda2941018.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/d444a718-3a2c-45b3-821f-f8fda2941018.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/d444a718-3a2c-45b3-821f-f8fda2941018.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"This intimate acoustic show pairs two queer artists, one rising star from Canada's East Coast and the other an incandescent London native.\\n\\nNoah Malcolm is a sought-after singer-songwriter, musical director and multi-instrumentalist from Prince Edward Island, Canada. Signed to CYMBA Publishing, his top-notch songwriting delivers 'melodic mastery' (The East Mag), and is served up with a witty stage presence and ear-catching vocals. With a playful yet poignant poetic spirit, it's easy to understand how he's acquired four Music PEI Awards, a 2025 East Coast Music Award, and three other ECMA nominations. Over 2025, Noah performed from coast to coast in Canada, making his Vancouver debut in JUNOfest, showcasing at Folk Music Ontario, and releasing the singles 'Goin' Thru It' and 'This Kind of Love', the latter used in the Hallmark film 'Kiki's Fourth Ingredient'.\\n\\nJean-Mikhael has been surrounded with creative expression since birth, and this truly shines through in his craft. Raised in London, the striking musician and model draws upon influences of pop, RnB and more, tethered to an intimate and vulnerable reflection upon past trials. He was classically trained for eight years by an opera singer while being inspired by a diversity of creative geniuses like Michael Jackson, Queen, Prince, David Bowie, Alicia Keys, and Rihanna.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6993ae35073ed7000141cd7c\",\"name\":\"Noah Malcolm & Jean-Mikhael: Stripped in Soho\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Noah Malcolm - Cereal\",\"redirect_url\":\"https://open.spotify.com/track/7Mk41WdAaFnpAyiIyGaJ8L\",\"artist\":\"Noah Malcolm\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3869540bb85d9e84856d338fd32fadbe4c70072b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cereal\"},{\"type\":\"apple_music\",\"title\":\"Noah Malcolm - Cereal\",\"redirect_url\":\"https://music.apple.com/us/album/cereal/1768840525?i=1768840528&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Noah Malcolm\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/e6/c6/ce/e6c6ce4f-dde7-6d69-69f4-412872da5d49/mzaf_167249275801083190.plus.aac.p.m4a\",\"track_name\":\"Cereal\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jean-Mikhael\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb84d010e3aa496dd32abd46bb\"},\"artist_id\":\"14658\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T18:00:00+00:00\",\"sale_end_date\":\"2026-04-01T19:00:00+01:00\",\"sale_start_date\":\"2026-02-09T18:00:00+00:00\",\"event_start_date\":\"2026-04-01T19:30:00+01:00\",\"event_end_date\":\"2026-04-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Paper Dr