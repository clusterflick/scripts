ce\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":375},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/b196df1b-4af5-4a04-ac15-acc0c4d9f867.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/b196df1b-4af5-4a04-ac15-acc0c4d9f867.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/b196df1b-4af5-4a04-ac15-acc0c4d9f867.jpg?rect=338%2C0%2C825%2C1500\"},\"id\":\"69944b452985d200019994c0\",\"name\":\"Baduizm: A Live Gospel Rendition\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Previously sold out, back for one night only.\\n\\nThis Easter Bank Holiday we celebrate Erykah Badu’s seminal album Baduizm, a stone-cold classic that instantly cemented Badu as one of her generation's most innovative musicians.\\n\\nExperience the album live and in full, with soul-healing gospel renditions of her greatest hits. An unforgettable performance that emulates the timeless and ethereal energy of the Neo-Soul Queen herself.\\n\\nOur beloved band will then take to the stage for another live set of classic soul, hip-hop and R&B, with DJs playing in between.\\n\\n£5 tickets are limited and come off sale 24 hours before the event. £9 tickets will be available all night, or you can pay the same amount on the door. We advise purchasing your tickets in advance to avoid queues.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo ID Required). \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T11:15:00+00:00\",\"sale_end_date\":\"2026-04-04T01:30:00+01:00\",\"sale_start_date\":\"2026-02-17T11:15:00+00:00\",\"event_start_date\":\"2026-04-03T20:00:00+01:00\",\"event_end_date\":\"2026-04-04T03:00:00+01:00\",\"is_multi_days_e