l\":\"https://link.dice.fm/Mcc9fbc323cc?dice_id=Mcc9fbc323cc\",\"post_waitinglist_referral\":\"https://link.dice.fm/m512bbc77cba?dice_id=m512bbc77cba\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by DHP FAMILY.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:3\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T10:00:00+00:00\",\"sale_end_date\":\"2026-04-10T14:00:00+01:00\",\"sale_start_date\":\"2025-11-19T10:00:00+00:00\",\"event_start_date\":\"2026-04-12T18:00:00+01:00\",\"event_end_date\":\"2026-04-12T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1763546400,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1473,\"sales_tax\":0,\"amount_from\":null},\"id\":\"691a2aac2d3b06000140af6c\",\"name\":\"TINY STILLS + CHEERBLEEDERZ\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tiny Stills\",\"image\":null,\"artist_id\":\"39614\",\"about\":null,\"is_headliner\":false},{\"name\":\"Cheerbleederz\",\"image\":null,\"artist_id\":\"67703\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"6dxygq-tiny-stills-cheerbleederz-12th-apr-the-lexington-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-13/f9dceb75-f060-4adf-b0b6-61c13ef01c28.jpg?rect=213%2C48%2C2563%2C2561\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-13/f9dceb75-f060-4adf-b0b6-61c13ef01c28.jpg?rect=0%2C975%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-13/f9dceb75-f060-4adf-b0b6-61c13ef01c28.jpg?rect=469%2C0%2C2063%2C3750\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"DHP Presents :\\n\\nTINY STILLS\\n\\n\\\\+ CHEERBLEEDERZ\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":50726,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":50727,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":50728,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Arched - Morning Again\",\"redirect_url\":\"https://music.apple.com/us/album/morning-again/1187425463?i=1187425473&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Arched\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview111/v4/56/5f/5a/565f5a52-63f8-1a6c-a8e2-5a2a9e3ca97b/mzaf_113740470092332371.plus.aac.p.m4a\",\"track_name\":\"Morning Again\"},{\"type\":\"spotify\",\"title\":\"vinnies x - Morning Again\",\"redirect_url\":\"https://open.spotify.com/track/1SB3dN4ZZBAQr0zL29Xj8e\",\"artist\":\"vinnies x\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8f7e45296c8d8760c3823ed5f4aad00af9a4f481?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Morning Again\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776013200,\"tty_to_extras\":[{\"ticket_type_id\":1093649,\"extra_ids\":[\"1098747\"]}],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden 