tive\":true},\"date_unix\":1776969000,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":20,\"name\":\"Upset The Rhythm\",\"privacy_policy_link\":\"http://www.upsettherhythm.co.uk/privacypolicy.html http://www.upsettherhythm.co.uk/privacypolicy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:37\",\"about\":{\"description\":\"ORCUTT SHELLEY MILLER are a guitar, bass, drums power trio. Featuring incendiary guitarist Bill Orcutt, psych-seer Ethan Miller (Comets on Fire, Howlin’ Rain), and dynamic powerhouse Steve Shelley (Sonic Youth). Despite rhythmic nods to the SoCal '60s, the overall vibe of Orcutt Shelley Miller is angular, atonal slash piled on a mid-'80s SST punk-fusionoid substrate, with Orcutt's bristling chords anchored by Miller's ebbing/ flowing bass. In the engine room, Shelley, the most beat-anchored of the trio, never quite abandons the two-and-four pocket but scrabbles around it, skitters over it, burrows under it, ultimately tapping a sort of Michael Hurley-gone-motorik vibe on the longer tracks. \\\"Four-Door Charger,\\\" easily the most tranced-out of their tracks, passes through kraut-funk on the way to a solid Klaus Dinger-meets-Lothar Meid churn.\\n\\nOrcutt Shelley Miller’s self-titled debut album is out now on Silver Current, and sounds like a fully formed beast, rather than a mere sum of its distinctive parts. For the improv shy listener, I can gladly inform you that it sounds like Orcutt sketched out a few of the heads beforehand, so there's plenty to clutch onto amidst the slashing Ginn-esque tritones, and plenty of the right-angle bursting-clockwork solos that define Orcutt's hypnotic phrasing. ‘Orcutt Shelley Miller’ reads like a \\\"big rock statement\\\" by its constituents that treads the line between good times and blown minds, and as such, it's a top-shelf repeat spinner.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1764323100,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/0dd787c5-f9d2-4311-88d6-33f61e4cbd71.jpg?rect=563%2C0%2C2178%2C2178\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/0dd787c5-f9d2-4311-88d6-33f61e4cbd71.jpg?rect=0%2C98%2C3304%2C1982\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/0dd787c5-f9d2-4311-88d6-33f61e4cbd71.jpg?rect=1053%2C0%2C1198%2C2178\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69286cfd35bac9000126de2c\",\"name\":\"Orcutt Shelley Miller \",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T09:45:00+00:00\",\"sale_end_date\":\"2026-04-23T18:00:00+01:00\",\"sale_start_date\":\"2025-11-28T09:45:00+00:00\",\"event_start_date\":\"2026-04-23T19:30:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"ave9wx-orcutt-shelley-miller-23rd-apr-the-100-club-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2987},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/I5b420e1102b?dice_id=I5b420e1102b\",\"post_competition_referral\":\"https://link.dice.fm/G22b08cdf670?dice_id=G22b08cdf670\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/A4cad8ea787b?dice_id=A4cad8ea787b\",\"post_purchase_referral\":\"https://link.dice.fm/v40e01743cd8?dice_id=v40e01743cd8\",\"post_reminder_referral\":\"https://link.dice.fm/T39d5671039f?dice_id=T39d5671039f\",\"post_waitinglist_referral\":\"https://li