952a98742958f4c8c8d4c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Original Mix\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T17:00:00+00:00\",\"sale_end_date\":\"2026-03-14T02:00:00+00:00\",\"sale_start_date\":\"2026-01-12T17:00:00+00:00\",\"event_start_date\":\"2026-03-13T22:30:00+00:00\",\"event_end_date\":\"2026-03-14T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Jazz Cafe.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Oe385635a3e0?dice_id=Oe385635a3e0\",\"post_competition_referral\":\"https://link.dice.fm/m4f57300b52c?dice_id=m4f57300b52c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X16c6e190ddc?dice_id=X16c6e190ddc\",\"post_purchase_referral\":\"https://link.dice.fm/k7035af546c7?dice_id=k7035af546c7\",\"post_reminder_referral\":\"https://link.dice.fm/I392624cab50?dice_id=I392624cab50\",\"post_waitinglist_referral\":\"https://link.dice.fm/q4a6a1c5b371?dice_id=q4a6a1c5b371\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"A cornerstone of Chicago footwork culture, Teklife arrives at Jazz Cafe marking 15 years of the pioneering label led by a rare head-to-head from DJ Spinn and Traxman.\\n\\nDJ Spinn’s unmistakably precise, stripped-back sound has cemented his role as one of footwork’s architects alongside the late DJ Rashad, and his work continues to set the standard for the genre’s most focused and physical expressions.\\n\\nEmerging from the city’s 90s ghetto-house movement, Traxman's sample-rich, futuristic approach treats rhythm and voice as a living exchange releasing foundational records on Planet Mu, Dancemania and Moveltraxx.\\n\\nHyperdub regular Ikonika is a vital force in the evolution of forward-thinking UK club music, and will showcase their captivating melodies and basslines across the bass continuum.\\n\\nTwo years on from our Rashad memorial party in April 2024, this night will celebrate the roots of Chicago footwork and its continued life on British dancefloors.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773441000,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T22:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:40\",\"tty_