.imgix.net/attachments/2026-01-19/fa183a07-65c8-4fa6-93f6-2340c23fa7ee.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/fa183a07-65c8-4fa6-93f6-2340c23fa7ee.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/fa183a07-65c8-4fa6-93f6-2340c23fa7ee.jpg?rect=180%2C0%2C440%2C800\"},\"id\":\"696e4172cd61d700010f2cb0\",\"name\":\"Friqtao \",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"Live Nation Presents:\\n\\nFriqtao\\n\\n\\\\+ Special Guests\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T15:00:00+00:00\",\"sale_end_date\":\"2026-03-10T10:00:00+00:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-03-10T19:00:00+00:00\",\"event_end_date\":\"2026-03-10T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"friqtao - Woke up in Japan\",\"redirect_url\":\"https://open.spotify.com/track/4h8ZyCqGdaDoyrXbO3mKGj\",\"artist\":\"friqtao\",\"preview_url\":\"https://p.scdn.co/mp3-preview/01b910094496970feb4911526872af2733f73213?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Woke up in Japan\"},{\"type\":\"apple_music\",\"title\":\"friqtao - Woke up in Japan\",\"redirect_url\":\"https://music.apple.com/us/album/woke-up-in-japan/1854812115?i=1854812325&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"friqtao\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/08/d4/70/08d4707c-81f3-1c22-8769-a4157f9a754a/mzaf_8342492942605307164.plus.aac.p.m4a\",\"track_name\":\"Woke up in Japan\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Crimson Veil\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-29/b6f6bf1b-c3d3-4771-8f33-bf8900624a16.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"113913\",\"about\":null,\"is_headliner\":false},{\"name\":\"Hartlight\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb584c83ffd36db6bcbfbba591\"},\"artist_id\":\"132558\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ross Jennings \",\"image\":null,\"artist_id\":\"31449\",\"about\":null,\"is_headliner\":false},{\"name\":\"Scardust\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe80dbc7d6c291fa882210efe\"},\"artist_id\":\"132557\",\"about\":null,\"is_headliner\":true}],\"total_artists\":4,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Underworld.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":70322,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":70323,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":70324,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-10T19:00:00+00:00\",\"doors_close_date\":\"2026-03-10T23:00:00+00:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1768816800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Qeb3a3d8aa18?dice_id=Qeb3a3d8aa18\",\"post_competition_referral\":\"https://link.dice.fm/n05ec2eceaad?dice_id=n05ec2eceaad\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Bef83e1a5529?dice_id=Bef83e1a5529\",\"post_purchase_referral\":\"https://link.dice.fm/G63c7d474de7?dice_id=G63c7d474de7\",\"post_reminder_referral\":\"https://link.dice.fm/Zca0bc00e526?dice_id=Zca0bc00e526\",\"post_waitinglist_referral\":\"https://link.dice.fm/m9ce0163fa87?dice_id=m9ce0163fa87\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"py5ra8-noa-grumans-scardust-10th-mar-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773169200,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:12\",\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/ce3af8c7-21ae-4428-8a48-b329ce19470b.jpg?rect=0%2C0%2C4240%2C4240\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/ce3af8c7-21ae-4428-8a48-b329ce19470b.jpg?rect=0%2C848%2C4240%2C2544\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/ce3af8c7-21ae-4428-8a48-b329ce19470b.jpg?rect=954%2C0%2C2332%2C4240\"},\"id\":\"696e04229e1db20001e19985\",\"name\":\"NOA GRUMAN’S SCARDUST\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"SOULS IN THE FLESH EUROPE TOUR\\n\\nNOA GRUMAN’S SCARDUST featuring very special guest ROSS JENNINGS plus HARTLIGHT and CRIMSON VEIL\\n\\nFrom their debut EP Shadow (2015) and breakout album Sands of Time (2017), Scardust rapidly rose as one of progressive metal’s most exciting forces—selling out shows, touring internationally and sharing stages with Symphony X, Epica and Therion. Fronted by the extraordinary Noa Gruman, whose voice spans operatic power, pristine melodies and brutal growls, the band earned major acclaim with the concept album Strangers (2020), headline festival slots at Wacken Open Air, tours with Blind Guardian, and viral releases like Evolution of the Disney – But She’s METAL. Signing a multi-album deal with Frontiers Records, Scardust’s ambitious new era culminates in Souls (2024–25), featuring Ross Jennings (Haken), while Gruman herself took centre stage conducting Sabaton’s Legendary Orchestra arena tour—setting the stage for a major international touring push in 2026.\\n\\n“Carried by progressive metal, jaw-dropping vocals, and exceptional musicianship, Scardust deliver a powerful live show that shifts between crushing heaviness and anthemic melodies.” TotalRock 2026\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T10:00:00+00:00\",\"sale_end_date\":\"2026-03-10T18:00:00+00:00\",\"sale_start_date\":\"2026-01-19T10:00:00+00:00\",\"event_start_date\":\"2026-03-10T19:00:00+00:00\",\"event_end_date\":\"2026-03-10T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Scardust - My Haven\",\"redirect_url\":\"https://open.spotify.com/track/1RqLEmkVmWXj8L9lOgu4FM\",\"artist\":\"Scardust\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2c2cf4bfb136434913e07293f30098e375ef3e93?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"My Haven\"},{\"type\":\"apple_music\",\"title\":\"Scardust - My Haven\",\"redirect_url\":\"https://music.apple.com/us/album/my-haven/1809418971?i=1809418975&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Scardust\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/e3/e1/85/e3e185b4-c5cd-15d7-9e27-a462ccf66e98/mzaf_15361821706504809123.plus.aac.p.m4a\",\"track_name\":\"My Haven\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Monsterwatch\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/2df0c6ec-e684-4ab7-8e4e-fbeb27285f19.jpg?rect=0%2C175%2C650%2C650\"},\"artist_id\":\"55732\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Hootananny Brixton.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"6109\",\"name\":\"Hootananny Brixton\",\"address\":\"95 Effra Rd, London SW2 1DF, UK\",\"location\":{\"lat\":51.4553934,\"lng\":-0.1132058},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-01-25/a335e145-034f-424c-811e-d996395babfa.jpg?rect=912%2C0%2C3648%2C3648\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europ