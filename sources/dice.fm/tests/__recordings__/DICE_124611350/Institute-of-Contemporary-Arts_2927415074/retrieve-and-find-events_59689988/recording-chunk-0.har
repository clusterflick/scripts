ixton/privacy-policy/\",\"fb_pixel_id\":\"899229490126050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780081200,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:38\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":375},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-10/093a8bf2-a64b-412d-95c3-60cba8b3497a.jpg?rect=0%2C522%2C2048%2C2048\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-10/093a8bf2-a64b-412d-95c3-60cba8b3497a.jpg?rect=0%2C931%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-10/093a8bf2-a64b-412d-95c3-60cba8b3497a.jpg?rect=174%2C0%2C1700%2C3091\"},\"id\":\"698616017176a9000109cdbd\",\"name\":\"Brixton Fridays: Hip Hop, Afrobeats & R&B ‘til 3AM\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Upstairs goes off every Friday — Afrobeats, R&B and hip-hop back-to-back ‘til 3am.\\n\\nDJs keeping you heated in the dance with old-school and new-school shakers from the likes of Kendrick, Wizkid, Lauryn Hill, Burna, J Hus and more.\\n\\nFree entry before 9pm if you’re quick, or it’s £5 adv / £9 on the door. For party bookings or table reservations call 020 7274 0591 & for more info visit our website.\\n\\n18+ only.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo I.D required).\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T13:00:00+00:00\",\"sale_end_date\":\"2026-05-30T02:00:00+01:00\",\"sale_start_date\":\"2026-02-06T13:00:00+00:00\",\"event_start_date\":\"2026-05-29T20:00:00+01:00\",\"event_end_date\":\"2026-05-30T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/fCBr2yXrzUOcGuwpkNndAPCiM28eK00IIlIxPAk2ejUM.m3u8\",\"track_name\":\"\"},{\"type\":\"apple_music\",\"title\":\"J Hus & Asake - Gold\",\"redirect_url\":\"https://music.apple.com/us/album/gold/1821304311?i=1821304312&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"J Hus & Asake\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/7e/af/c2/7eafc24c-8116-b40c-e5c8-2ecc488c5a26/mzaf_11683176181848924302.plus.aac.p.m4a\",\"track_name\":\"Gold\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rockaoke\",\"image\":null,\"artist_id\":\"126109\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Electric Star Pubs.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"13434\",\"name\":\"The Star of Kings\",\"address\":\"126 York Way, Islington, London, N1 0AX, United Kingdom\",\"location\":{\"lat\":51.53636,\"lng\":-0.12205},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-star-of-kings-8dy5\",\"accessibility\":{\"url\":\"https://starofkings.co.uk/wp-content/uploads/2024/09/SOK-Venue-Brochure-2024-compressed.pdf\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T20:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"136032\",\"name\":\"Electric Star Pubs\",\"image\":{\"url\":null},\"perm_name\":\"electric-star-pubs-nb53l\",\"profile_active\":false},\"announcement_date_unix\":1755700200,\"social_links\":{\"event_share\":\"https://link.dice.fm/g91a02c8853f?dice_id=g91a02c8853f\",\"post_competition_referral\":\"https://link.dice.fm/Ba5aed9726fd?dice_id=Ba5aed9726fd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p93eb5cda6da?dice_id=p93eb5cda6da\",\"post_purchase_referral\":\"https://link.dice.fm/m58bcf022a8d?dice_id=m58bcf022a8d\",\"post_reminder_referral\":\"https://link.dice.fm/bd5ac9adee21?dice_id=bd5ac9adee21\",\"post_waitinglist_referral\":\"https://link.dice.fm/E0217306c037?dice_id=E0217306c037\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"dknp56-rockaoke-29th-may-the-star-of-kings-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780081200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:39\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=506%2C0%2C1238%2C2250\"},\"id\":\"68a6ce118ff9a7000191357d\",\"name\":\"Rockaoke\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join us for singalong fun twice a month, every second and last Friday!\\n\\nBringing you the ultimate live band Karaoke experience that will set the tone for an unforgettable year. Be part of the action as you step into the spotlight and belt out your favourite tunes in front of a lively crowd. Channel your inner Debbie Harry, Ed Sheeran, or Justin Bieber and make this year's Rockaoke a night to remember!\\n\\nA unique Karaoke singing experience.\\n\\nA perfect experience for anyone!\\n\\n“Most fun ever? We reckon so!” – Time Out London\\n\\n“Karaoke’s much cooler older brother, ROCKAOKE” – Sunday Times\\n\\n“The best rockaoke band on the planet\\\" – Virgin Radio\\n\\n“So wrong, it’s right!” – Ibiza Rocks\\n\\n\\\"The band make you feel like a proper ROCKSTAR, they don’t make you sound like one, but they make you feel like one - \\\"Chris Moyles, Radio DJ\\n\\n“Paulo Nutini, The Fratellis and McFly were among the acts who performed exclusive live sessions for the intimate audience in the Virgin Radio VIP Sessions, setting the stage for ROCKAOKE” – OK Magazine\\n\\n“Thank you SO much. We all had a great great time and I think the warmth, enthusiasm and kindness of the band added so much.” – Kate Harwood (BBC Head of Drama & Serials)\\n\\n“I recently attended a Rockaoke night in Cardiff and was absolutely blown away by your performance and the whole atmosphere of the event. I have never witnessed anything quite like it and the talent the band demonstrated with their wide repertoire was incredible.” – Beth (Cancer Research Wales)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-20T15:30:00+01:00\",\"sale_end_date\":\"2026-05-29T23:30:00+01:00\",\"sale_start_date\":\"2025-08-20T15:30:00+01:00\",\"event_start_date\":\"2026-05-29T20:00:00+01:00\",\"event_end_date\":\"2026-05-30T00:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Fri 29 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"max_tickets\":12,\"properties\":[],\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-30T12:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"announ