":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"barbican-hall-ja9d\",\"accessibility\":{\"url\":\"https://www.barbican.org.uk/your-visit/accessibility/access-scheme\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-11T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:34\",\"date_unix\":1783792800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2545},\"social_links\":{\"event_share\":\"https://link.dice.fm/K157c0e56b2e?dice_id=K157c0e56b2e\",\"post_competition_referral\":\"https://link.dice.fm/j5636991e566?dice_id=j5636991e566\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P24e6cae2820?dice_id=P24e6cae2820\",\"post_purchase_referral\":\"https://link.dice.fm/K8775181f4d0?dice_id=K8775181f4d0\",\"post_reminder_referral\":\"https://link.dice.fm/r6c501caea23?dice_id=r6c501caea23\",\"post_waitinglist_referral\":\"https://link.dice.fm/z8f73d616e43?dice_id=z8f73d616e43\"},\"perm_name\":\"g5m9r5-nourished-by-time-11th-jul-barbican-hall-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/43b348fe-465d-40e0-88da-f5ba0f1b13d2.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/43b348fe-465d-40e0-88da-f5ba0f1b13d2.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/43b348fe-465d-40e0-88da-f5ba0f1b13d2.jpg?rect=173%2C0%2C422%2C768\"},\"properties\":[],\"about\":{\"description\":\"dollop & Barbican Presents\\n\\nNourised By Time\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"\\t 14+ (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698c4ea31ea4460001d00c80\",\"name\":\"Nourished By Time \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Nourished by Time - Automatic Love\",\"redirect_url\":\"https://open.spotify.com/track/6TLEg0rUFLH0EF9CYfRJ7B\",\"artist\":\"Nourished by Time\",\"preview_url\":\"https://p.scdn.co/mp3-preview/036dff487698406f4782c39bcf73ed5e84521f17?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Automatic Love\"},{\"type\":\"apple_music\",\"title\":\"Nourished by Time - Automatic Love\",\"redirect_url\":\"https://music.apple.com/us/album/automatic-love/1807286924?i=1807287294&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nourished by Time\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/25/df/65/25df65f2-18fc-3b6a-6893-05b9b94ac602/mzaf_78548867403966244.plus.aac.p.m4a\",\"track_name\":\"Automatic Love\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nourished by Time\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-21/4d267169-c3a0-48cc-870a-f393bb5f7088.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"70704\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sat 11 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T16:00:00+00:00\",\"sale_end_date\":\"2026-07-12T21:00:00+01:00\",\"sale_start_date\":\"2025-12-05T09:00:00+00:00\",\"event_start_date\":\"2026-07-12T17:00:00+01:00\",\"event_end_date\":\"2026-07-12T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":60060,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":60061,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":60062,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":60063,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":60064,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":4},{\"id\":60065,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nYou will be subject to bag checks and searches upon arrival. Chairs and other camping equipment are not allowed at the event. A full list of prohibited items can be found in the prohibited items section below.\",\"order\":5},{\"id\":60066,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":6},{\"id\":60067,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"seating\":null,\"announcement_date_unix\":1764345600,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Park\",\"doors_open_da