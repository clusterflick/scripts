",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"ryn8v5-wednesday-club-house-electro-and-hip-hop-4th-mar-egg-ldn-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772663400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:16\",\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-04T22:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"Wednesday Club at Egg London\\n\\nMidweek, done properly.\\n\\nEvery Wednesday, Wednesday Club brings house, tech house, electro and hip hop to Egg London — built for students and anyone looking to switch off and reset before the weekend.\\n\\nDoors open from 22:30 – 04:00, with free entry before midnight plus a free shot when claimed online.\\n\\nExpect solid music all night, a mixed crowd, and selected drinks at £5 across the event.\\n\\nWhether you’re coming straight from uni, work, or just need a midweek release — Wednesday Club keeps things moving without the weekend\\n\\nchaos.\\n\\nEgg London\\n\\n 22:30 – 04:00\\n\\n Free entry before 00:00 + free shot (online claim required) \\n\\nHouse · Tech House · Electro · Hip Hop \\n\\n£5 selected drinks all night\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-06-01T14:00:00+01:00\",\"sale_end_date\":\"2026-03-05T02:30:00+00:00\",\"sale_start_date\":\"2024-06-01T14:00:00+01:00\",\"event_start_date\":\"2026-03-04T22:30:00+00:00\",\"event_end_date\":\"2026-03-05T04:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6978090fd1ca040001abd851\",\"name\":\"Wednesday Club: House, Electro and Hip Hop\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C166%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C326%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=89%2C0%2C622%2C1131\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1717246800,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"ht