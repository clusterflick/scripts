ll,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**Our famed celebration of Brazilian musical culture makes its grand return with a majestic carnival special.**\\n\\nWe’re bringing the energy with London’s premier samba band alongside a parade of live drummers, Brazilian dancers and DJs.\\n\\nExpect explosive performances crossing a wide array of Latin music genres including bossa nova, samba, Música popular brasileira, and much more for a party like no other.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:43\",\"social_links\":{\"event_share\":\"https://link.dice.fm/V65c3c66bcb9?dice_id=V65c3c66bcb9\",\"post_competition_referral\":\"https://link.dice.fm/Sb582d763e26?dice_id=Sb582d763e26\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Pe6489f98438?dice_id=Pe6489f98438\",\"post_purchase_referral\":\"https://link.dice.fm/d646e2d904fc?dice_id=d646e2d904fc\",\"post_reminder_referral\":\"https://link.dice.fm/u70e7fca16c1?dice_id=u70e7fca16c1\",\"post_waitinglist_referral\":\"https://link.dice.fm/C5dec748fec3?dice_id=C5dec748fec3\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-22T13:00:00+01:00\",\"sale_end_date\":\"2026-02-18T19:00:00+00:00\",\"sale_start_date\":\"2025-10-22T13:00:00+01:00\",\"event_start_date\":\"2