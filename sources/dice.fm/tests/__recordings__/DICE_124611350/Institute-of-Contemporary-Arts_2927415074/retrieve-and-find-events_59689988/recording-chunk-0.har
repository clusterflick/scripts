\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-15T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/4be580f7-61c2-461c-9c11-c1a26bd689e5.jpg?rect=0%2C0%2C2048%2C2048\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/4be580f7-61c2-461c-9c11-c1a26bd689e5.jpg?rect=0%2C922%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/4be580f7-61c2-461c-9c11-c1a26bd689e5.jpg?rect=179%2C0%2C1690%2C3072\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770314400,\"max_tickets\":6,\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"R.E.M. BY STIPE\\n\\nThe Ultimate Tribute to R.E.M. play the 100 Club on August 15th with support from Kingsley Beat and The Ramshackle Music Collective\\n\\n“These guys are awesome” – Michael Stipe, R.E.M.\\n\\nThe definitive tribute to one of the most important bands in rock music. R.E.M. BY STIPE have performed to thousands of people worldwide. Formed in 1996, R.E.M. BY STIPE are a 5 piece band fronted by Richard Southern who meticulously recreate the R.E.M. sound. Expect to hear a set crammed full of R.E.M. classics such as ‘Losing My Religion”, “Everybody Hurts”, “Superman”, “Fall On Me”, “The One I Love”, “Shiny Happy People”, “It’s The End of the World As We Know It (And I Feel Fine)”, “Man On The Moon”, “Drive”, “Orange Crush”, “Stand”, “The Sidewinder Sleeps Tonite” and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by 100 Club.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:7\",\"social_links\":{\"event_share\":\"https://link.dice.fm/n6c38e24bf36?dice_id=n6c38e24bf36\",\"post_competition_referral\":\"https://link.dice.fm/Q22cea29872f?dice_id=Q22cea29872f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O46a2d0437c4?dice_id=O46a2d0437c4\",\"post_purchase_referral\":\"https://link.dice.fm/s0cd9f553aa1?dice_id=s0cd9f553aa1\",\"post_reminder_referral\":\"https://link.dice.fm/vcf301828bf0?dice_id=vcf301828bf0\",\"post_waitinglist_referral\":\"https://link.dice.fm/bf6706283bb8?dice_id=bf6706283bb8\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T18:00:00+00:00\",\"sale_end_date\":\