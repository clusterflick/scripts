k.dice.fm/Ba0317e1b664?dice_id=Ba0317e1b664\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:43\",\"properties\":[],\"presented_by\":\"Presented by DHP\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760104800,\"id\":\"68e8f6bf4c41140001706572\",\"name\":\"The Narrator\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"*DHP Presents...*\\n\\n**THE NARRATOR  \\n**https://www.instagram.com/thenarratorhc/\\n\\nPlus guests...\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"date_unix\":1792087200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1605,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T10:00:00+00:00\",\"sale_end_date\":\"2026-10-15T18:30:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-10-15T19:30:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eo33qo-alice-costelloe-15th-oct-the-lexington-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Alice Costelloe - How Can I\",\"redirect_url\":\"https://open.spotify.com/track/6ev5ii9Zpk67XEhdNTtY5z\",\"artist\":\"Alice Costelloe\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a110e99736ec363f836e9a0fa8af8d3b4d840efd?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"How Can I\"},{\"type\":\"apple_music\",\"title\":\"Alice Costelloe - How Can I\",\"redirect_url\":\"https://music.apple.com/us/album/how-can-i/1849483683?i=1849483684&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alice Costelloe\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/04/68/4c/04684c69-775a-df7d-6202-08ff753ce2c4/mzaf_7182842188405789296.plus.aac.p.m4a\",\"track_name\":\"How Can I\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":12},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":35299,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Alice Costelloe\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-08/d5f73c2a-b4cf-49a8-a4ed-6ed877c1b4ef.jpg?rect=0%2C84%2C856%2C856\"},\"artist_id\":\"45365\",\"about\":{\"description\":\"London based Alice Costelloe - formerly of critically acclaimed shoegaze duo Big Deal (Mute Records) and previously live bassist for Superfood - independently released her debut solo EP ‘ So Neurotic’ (under the name Al Costelloe) in September 2023.\\n\\nIn 2024 she signed to cult UK label Moshi Moshi Records and released her second EP 'When It's The Time' - working with producer Mike Lindsay (Lump, Tunng). Her debut album 'Move On With The Year', released February 2026, is a break-away record consisting of 10 tracks of beguiling art-pop built on self-trust, instinct, and a necessary process of creative detangling.\\n\\nProduced by Mike Lindsay in his Margate studio, the album rejects the indie-rock lineage Alice came up in, trading guitar solos for mellotron, taishogoto and flute lines recorded mid-lesson, trusting imperfection as the truest form of expression. Beneath that sound is a harder story: the weight of a complicated parental relationship and the kind of grief that doesn’t resolve neatly.\\n\\nAt its heart, this is a companion album to growing up again - not about one heartbreak, but about reshaping your entire emotional framework and identity in order to step into the next chapter of life.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-15T19:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/c0ee8e6d-a680-4c3e-b0be-fa9c01977323.jpg?rect=0%2C0%2C2680%2C2680\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/