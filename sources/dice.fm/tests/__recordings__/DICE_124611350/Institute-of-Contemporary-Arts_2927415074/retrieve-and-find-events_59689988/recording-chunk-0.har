gy\",\"redirect_url\":\"https://music.apple.com/us/album/people-with-no-energy/1798683923?i=1798683924&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Espuma\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/10/17/78/1017782a-38af-f50b-b874-061e12cb47e5/mzaf_13046078799529869519.plus.aac.p.m4a\",\"track_name\":\"People With No Energy\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776364200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"163\",\"name\":\"Sebright Arms\",\"address\":\"31-35 Coate St, London E2 9AG\",\"location\":{\"lat\":51.5320226,\"lng\":-0.0631161999999676},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sebright-arms-4mm9\",\"accessibility\":{\"url\":\"https://www.sebrightarms.com/about\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"143417\",\"name\":\"Tenebra\",\"image\":{\"url\":null},\"perm_name\":\"tenebra-xpr8a\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/q1360049bf73?dice_id=q1360049bf73\",\"post_competition_referral\":\"https://link.dice.fm/w43a7fb0e998?dice_id=w43a7fb0e998\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/L84d4a94b22c?dice_id=L84d4a94b22c\",\"post_purchase_referral\":\"https://link.dice.fm/U5f249d81b4e?dice_id=U5f249d81b4e\",\"post_reminder_referral\":\"https://link.dice.fm/K334bba004e5?dice_id=K334bba004e5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pc8c1ff5f30c?dice_id=Pc8c1ff5f30c\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Tenebra Presents\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:72\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T16:00:00+00:00\",\"sale_end_date\":\"2026-04-16T22:00:00+01:00\",\"sale_start_date\":\"2026-01-30T16:00:00+00:00\",\"event_start_date\":\"2026-04-16T19:30:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1769788800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"id\":\"697a1a859982a10001f8f888\",\"name\":\"Espuma + The Birch\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Espuma\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-04-03/b77a9aaa-924c-47b8-994e-3ae6ad54faa1.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"87331\",\"about\":{\"description\":\"Espuma is a London-based six-piece weaving a hypnotic tapestry of latin rhythms, folk tales and 60s psychedelia with influences from around the world. Arriving in the capital from across England, Bulgaria and Germany, their sound pulses with the energy of London’s vibrant psychedelic scene. After their first year the band has quickly shown immense promise through captivating live performances at key grassroots venues in the UK, US and France, with the release of the second EP, Magic Valley, featuring on BBC Radio 6 Music and KEXP.\\n\\n\\\\----------------------------------------------------------------------------------------------\\n\\nWith their driving riffs and punchy rhythms suited in psychedelic sonority, The Birch create an atmosphere of pure ecstasy. The three musicians from Quedlinburg, Germany, send their crowd on a spiritual journey of long-lost centuries, never indulging but facing themselves in the current spirit of time. The group, formed three years ago, released their debut album “Dazed Dreams” in August 2023, which has received a great response from their fanbase.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"dk3o7e-espuma-the-birch-16th-apr-sebright-arms-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/ea7c4781-784b-4cfc-ac2f-2fb3c96c49f3.jpg?rect=1072%2C0%2C8576%2C8576\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/ea7c4781-784b-4cfc-ac2f-2fb3c96c49f3.jpg?rect=0%2C1072%2C10720%2C6432\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/ea7c4781-784b-4cfc-ac2f-2fb3c96c49f3.jpg?rect=3002%2C0%2C4717%2C8576\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"London locals Espuma are joined by Germany's The Birch for a night of groovy psychedelia and blazing rock and roll.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":12},\"faqs\":[],\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Ellie O'Neill - Bohemia\",\"redirect_url\":\"https://open.spotify.com/track/3wqEjMW3sq7RzSdD64LCUf\",\"artist\":\"E