ceee8fdf\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Za0a700acf6d?dice_id=Za0a700acf6d\",\"post_purchase_referral\":\"https://link.dice.fm/k0186bb1c739?dice_id=k0186bb1c739\",\"post_reminder_referral\":\"https://link.dice.fm/dcfe02f44f48?dice_id=dcfe02f44f48\",\"post_waitinglist_referral\":\"https://link.dice.fm/de93dc045086?dice_id=de93dc045086\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:46\",\"properties\":[],\"presented_by\":\"Presented by REAL\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1748300400,\"id\":\"6835bcd7700c0c00019410b1\",\"name\":\"Special Friend\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"***Special Friend -*** French/American indie-noise-pop duo based in Paris. Formed in 2018 by Erica Ashleson (drums, vocals) and Guillaume Siracusa (guitar, vocals), after having met at a concert in Paris. At the time, Erica was learning to play drums and Guillaume accompanied on guitar and the two friends made their first compositions within just 4 months. In 2019, they released a self-titled EP recorded in their rehearsal studio in two days, unveiling a singular sound of minimalistic indie-noise-pop, recalling the likes of Yo La Tengo, Duster, and Electrelane.\\n\\n**Sofa Simulator** - London based indie band with a tinge of country twang. Music for people who’ve never owned a horse, but have cried on the Overground. It’s loose, loud-ish, and it may or may not hold together.\\n\\n***Artists:** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at realsounds.uk.*\\n\\n***Note:** 18+ ID required. These events frequently sell out so we recommend buying tickets in advance.*\\n\\n***Refunds:** Tickets are for the full event and not for individual artists. If an artist cancels your tickets are still valid for the event. We cannot offer refunds.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3713,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-05-16T09:00:00+01:00\",\"sale_end_date\":\"2026-03-07T17:00:00+00:00\",\"sale_start_date\":\"2025-05-16T09:00:00+01:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"pykq8y-omnium-gatherum-7th-mar-the-dome-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Omnium Gatherum\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-02-14/144552ed-076b-430c-9abe-bd4070238868.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"36015\",\"about\":null,\"is_headliner\":false},{\"name\":\"Fallujah\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb209ee67f14b9086098ad5d4b\"},\"artist_id\":\"11113\",\"about\":null,\"is_headliner\":false},{\"name\":\"In Mourning\",\"image\":null,\"artist_id\":\"121115\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping