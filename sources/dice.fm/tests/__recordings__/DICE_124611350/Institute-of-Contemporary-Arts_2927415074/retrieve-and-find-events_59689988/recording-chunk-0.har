\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":4,\"presented_by\":\"Presented by Spreadlove HQ.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:5\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-20T17:45:00+00:00\",\"sale_end_date\":\"2026-04-10T15:30:00+01:00\",\"sale_start_date\":\"2025-12-20T17:45:00+00:00\",\"event_start_date\":\"2026-04-12T18:30:00+01:00\",\"event_end_date\":\"2026-04-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1766252700,\"offers_extras\":false,\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":4235,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6946de1fc54ede00015df698\",\"name\":\"Protoje Live in London \",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Protoje\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-08/3cc95403-91f6-460c-8451-0a63c1034e88.jpg?rect=0%2C53%2C534%2C534\"},\"artist_id\":\"5258\",\"about\":{\"description\":\"Reggae royalty Protoje prides himself on a wide-ranging sound that complements his paradigm-shifting lyricism. Easily one of the most important artists in modern reggae, the Jamaican singer/songwriter/DJ preserves his country’s tradition of socially conscious, spiritual songcraft, standing tall above the commercialisation of his culture. Protoje performs with the Indiggnation Band, and is the founder and leader of the In.Digg.Nation Collective, an arts collective that has produced other reggae revivalists such as Kabaka Pyramid, Chronixx and Jah9.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"bbxgrk-protoje-live-in-london-12th-apr-o2-forum-kentish-town-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-19/e8a28d6e-7c46-4ee1-90b0-5bfd49eb5ce0.jpg?rect=0%2C1248%2C5000%2C5000\",\"landscape\":\"https://dic