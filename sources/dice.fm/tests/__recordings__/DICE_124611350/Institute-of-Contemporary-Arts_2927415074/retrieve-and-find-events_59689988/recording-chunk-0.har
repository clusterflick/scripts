},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1760526000,\"max_tickets\":6,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"THE FIRE DOORS - If you love the music of The Doors, then let the Fire Doors transport you back to the Sunset Strip in '67 for a night of musical abandon honouring LA's greatest band. Featuring members of Field Music and The Futureheads, The Fire Doors will embrace every aspect of The Doors' six classic albums. Expect poetry, mysticism, flamenco and jazz all wrapped up as hard-hitting rock, but with the pop smarts that led to chart-topping singles such as Light My Fire, Hello, I Love You and Touch Me.  \\n  \\nTHE INCUREABLES - Hotter than a Fire In Cairo, these 5 Imaginary Boys (who don't cry) are London's primary tribute to Crawley's finest Goth pop institution. With an uncanny resemblance physically and vocally (once the syrup's on) to Bob Smith, author, raconteur and music promoter, Andy Macleod fronts this Faith-ful and fun Cure homage playing hits and deep cuts from The Cure's back catalogue.  \\n  \\n  \\n\\\"The Fire Doors are a genuine force and pull the Doors' hits off with clout and conviction. The result achieves that magic combination of being so tight they almost sound loose.\\\"  \\nDaniel Dylan Wray, The Guardian  \\n  \\n\\\"They're called Fire Doors. If you see footage of them, they're incredible. This band are incredible musicians.\\\"  \\nRichard Osman, The Rest Is Entertainment  \\n  \\n'Close your eyes and it's The Cure, open your eyes and it's The Cure'  \\nSimon Williams Fierce Panda Records\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by AFM Concerts.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:52\",\"social_links\":{\"event_share\":\"https://link.dice.fm/mcb3563abcf1?dice_id=mcb3563abcf1\",\"post_competition_referral\":\"https://link.dice.fm/Ndf12076b549?dice_id=Ndf12076b549\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C76e485110d5?dice_id=C76e485110d5\",\"post_purchase_referral\":\"https://link.dice.fm/R6796cff6c2b?dice_id=R6796cff6c2b\",\"post_reminder_referral\":\"https://link.dice.fm/M99d615ea7cd?dice_id=M99d615ea7cd\",\"post_waitinglist_referral\":\"https://link.dice.fm/I65f2e3c6770?dice_id=I65f2e3c6770\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-15T12:00:00+01:00\",\"sale_end_date\":\"2026-09-11T17:00:00+01:00\",\"sale_start_date\":\"2025-10-17T12:00:00+01:00\",\"event_start_date\":\"2026-09-11T19:00:00+01:00\",\"event_end_date\":\"2026-09-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2000},\"properties\":[],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"id\":\"68ef60ebd86e470001a2eebc\",\"seats_io_event_id\":null,\"name\":\"The Fire Doors + The InCureables (co-headline)\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"g56956-the-fire-doors-the-incureables-co-headline-11th-sep-229-london-tickets\",\"date_unix\":1789149600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 11 Sep\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-12T13:00:00+01:00\",\"doors_close_date\":\"2026-09-12T22:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Burning Witches\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/3a1ad1f2d377f5c09fc3cb17eef4b245ef5c7cd1\"},\"artist_id\":\"10550\",\"about\":null,\"is_headliner\":false},{\"name\":\"Wretched Soul\",\"image\":null,\"artist_id\":\"133114\",\"about\":null,\"is_headliner\":false},{\"name\":\"DOOL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-05-15/ca15313a-9589-4159-9e81-1af1119434bf.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"47401\",\"about\":null,\"is_headliner\":false},{\"name\":\"Candlemass\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebdf594d5bde1494608ea2822b\"},\"artist_id\":\"37644\",\"about\":null,\"is_headliner\":true}],\"total_artists\":4,\"total_free_texts\":2},\"faqs\":[{\"id\":73005,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73006,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73007,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/6e1d556a-3589-45c7-9922-ed7cd3d90153.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/6e1d556a-3589-45c7-9922-ed7cd3d90153.jpg?rect=0%2C732%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/6e1d556a-3589-45c7-9922-ed7cd3d90153.jpg?rect=352%2C0%2C1547%2C2813\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Solitude\",\"redirect_url\":\"https://open.spotify.com/track/0v3WyEt2g04WFpfVwcnfXm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2a6019736086a155463a86fe58b8080292e32655?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Solitude\"},{\"type\":\"apple_music\",\"title\":\"Burning Witches - Inquisition\",\"redirect_url\":\"https://music.apple.com/us/album/inquisition/1815986929?i=1815986938&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Burning Witches\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/58/4b/45/584b45a8-adf2-1398-b01c-790f00930f20/mzaf_11921929441319003055.plus.aac.p.m4a\",\"track_name\":\"Inquisition\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769792400,\"max_tickets\":6,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in