l\":\"https://link.dice.fm/Ff596a980d61?dice_id=Ff596a980d61\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1122,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Fox & Firkin.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"92wmx6-3head-and-entit-double-headline-show-5th-mar-fox-and-firkin-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:32\",\"venues\":[{\"id\":\"15510\",\"name\":\"Fox And Firkin\",\"address\":\"316 Lewisham High Street, Lewisham, London, SE13 6JZ, United Kingdom\",\"location\":{\"lat\":51.45698,\"lng\":-0.01441},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-04/8f120254-16c6-4f38-a599-6dbc7a16c8db.jpg?rect=0%2C0%2C2363%2C2363\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"about\":{\"description\":\"Two boundary pushing and incredible musical acts throwing album release parties on the same night? Yes. Please.\\n\\nEntità (Entity) is a genre defying new quintet who fuse together a variety of styles from Jazz, Classical, Fusion, World and Prog. Founded by Violinist Nadine Nagen and Saxophonist Marco Marotta, the ensemble includes Guitarist Marco Punzi, Bassist Giovanni Cresseri and Drummer Filippo Galli. All active in the London Jazz scene and further afield. The compositions are a nostalgic exploration of our complex relationship with nature and the environment in our world today. Blending together acoustic and electric sounds, this band has something that will make you groove, soar high in melodic moments, and get lost in free improvisation.  This show they are celebrating their first EP, beginning with their debut single, “Froglet in the Rain\\\".\\n\\n3HEAD are a multi-cultural collective of independently recognised musicians who have just released their new album \\\"You Are More Beautiful\\\" on 5 December 2025 on Creation Youth Records, the label founded by Alan McGee and Youth (Martin Glover). The album showcases the breadth of their sound and vision. Live, 3HEAD deliver compelling, atmospheric performances that shift seamlessly from moments of romantic beauty to dangerous, fast d’n’b energy. Fronted by Ras B alongside electric guitarist and vocalist Holly Henderson, their immersive blend of dub, trip-hop, classical, and electronica is as powerful to watch as it is to dance to.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-06T15:45:00+00:00\",\"sale_end_date\":\"2026-03-05T19:00:00+00:00\",\"sale_start_date\":\"2026-01-06T15:45:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_