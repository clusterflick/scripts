x\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-03-15T16:00:00+00:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-03-15T15:30:00+00:00\",\"event_end_date\":\"2026-03-15T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ncab684e42d0?dice_id=Ncab684e42d0\",\"post_competition_referral\":\"https://link.dice.fm/z4d40365ea5f?dice_id=z4d40365ea5f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bd5b0757282c?dice_id=bd5b0757282c\",\"post_purchase_referral\":\"https://link.dice.fm/mbe9905d54ad?dice_id=mbe9905d54ad\",\"post_reminder_referral\":\"https://link.dice.fm/sdabddfc4174?dice_id=sdabddfc4174\",\"post_waitinglist_referral\":\"https://link.dice.fm/l9d1459d44cd?dice_id=l9d1459d44cd\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"On the 3rd Sunday of every month Jamie Williams & Laura Tuckey host the HOT BOX blues jam, featuring The Roots Collective as house band.\\n\\nThe full backline is already on stage so just rock up with your instrument, plug in and have a great time playing alongside some of the best in the business.\\n\\nThere's a place for all levels of musician, and if you don't know a plectrum from a g-String, just grab a drink and enjoy the show!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773588600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-15T15:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:93\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6928debd7a75730001258bec\",\"name\":\"Hot Box Blues Jam\",\"perm_name\":\"v3ga8v-hot-box-blues-jam-15th-mar-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=256%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=0%2C154%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=602%2C0%2C845%2C1536\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1764201600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":500},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T00:00:00+00:00\",\"sale_end_date\":\"2026-03-15T17:00:00+00:00\",\"sale_start_date\":\"2026-01-29T00:00:00+00:00\",\"event_start_date\":\"2026-03-15T17:00:00+00:00\",\"event_end_date\":\"2026-03-15T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Fox & Firkin.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ibb54e2e8f31?dice_id=Ibb54e2e8f31\",\"post_competition_referral\":\"https://link.dice.fm/hcc69addd237?dice_id=hcc69addd237\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Kfdfc6df8548?dice_id=Kfdfc6df8548\",\"post_purchase_referral\":\"https://link.dice.fm/R8e12c8fe18a?dice_id=R8e12c8fe18a\",\"post_reminder_referral\":\"https://link.dice.fm/w2623b7029ad?dice_id=w2623b7029ad\",\"post_waitinglist_referral\":\"https://link.dice.fm/B298977eee65?dice_id=B298977eee65\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"A unique night of original folk, trad and pop music from the whole island of Ireland. Hosted by contemporary-folk band ‘Evolution of Fishermen’.\\n\\nExpect a night of foot stamping live music that features some of London’s most exciting artists with Irish heritage.\\n\\n**Evolution of Fishermen**\\n\\nEvolution of Fishermen formed in 2021, brought together by a shared love of storytelling, unique harmonies, and original folk songs. Since their formation, the band has quickly established themselves as a prominent presence in the contemporary folk scene.\\n\\nThey’ve worked with notable promoters such as Sofar Sounds, performed at renowned venues including Green Note, O2 Islington, The Old Blue Last, and The Crescent. Their festival appearances include Wilderness, Deershed, LOOPFEST, Gate to Southwell and Medicine Festival (on Sam Lee’s ‘The Nest Stage’).\\n\\nThe band’s debut EP, Days Like These, has received multiple features on BBC Introducing and was launched with a sell-out gig at St. Bartholomew the Great’s church in London in May 2024.\\n\\nWe cant wait to share the stage at Fox and Firkin with McGovern and Little Wees.\\n\\n**Little Wees**\\n\\nLittle Wees is a collective of Lewisham local musicians who come together a few times a year to play a combination of Irish traditional folk music and pop songs. The collective was founded by Lewisham born and bred siblings of Irish Heritage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773594000,\"venues\":[{\"id\":\"15510\",\"name\":\"Fox And Firkin\",\"address\":\"316 Lewisham High Street, Lewisham, London, SE13 6JZ, United Kingdom\",\"location\":{\"lat\":51.45698,\"lng\":-0.01441},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-04/8f120254-16c6-4f38-a599-6dbc7a16c8db.jpg?rect=0%2C0%2C2363%2C2363\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-15T17:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:94\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"id\":\"697b71cef2222f00017b896c\",\"name\":\"Evolution of Fishermen’s St Paddy’s Knee’s Up\",\"perm_name\":\"6dng2q-evolution-of-fishermens-st-paddys-knees-up-15th-mar-fox-and-firkin-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/390a561a-31d2-4edf-bda0-cc15ecc5026e.jpg?rect=0%2C293%2C1414%2C1414\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/390a561a-31d2-4edf-bda0-cc15ecc5026e.jpg?rect=0%2C576%2C1414%2C848\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/390a561a-31d2-4edf-bda0-cc15ecc5026e.jpg?rect=157%2C0%2C1100%2C2000\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1769644800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1150,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-24T00:00:00+01:00\",\"sale_end_date\":\"2026-03-15T20:30:00+00:00\",\"sale_start_date\":\"2025-04-24T00:00:00+01:00\",\"event_start_date\":\"2026-03-15T18:00:00+00:00\",\"event_end_date\":\"2026-03-15T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Ninety One Living Room.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/nccf7c6b3c9c?dice_id=nccf7c6b3c9c\",\"post_competition_referral\":\"https://link.dice.fm/m31b9713f26e?dice_id=m31b9713f26e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ze39e67c44b0?dice_id=ze39e67c44b0\",\"post_purchase_referral\":\"https://link.dice.fm/hb560ab48d21?dice_id=hb560ab48d21\",\"post_reminder_referral\":\"https://link.dice.fm/Ra3b3fa96fa4?dice_id=Ra3b3fa96fa4\",\"post_waitinglist_referral\":\"https://link.dice.fm/sa5eada51ad5?dice_id=sa5eada51ad5\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"We're excited to introduce our new Sunday series, Jazz on the Lane, featuring a rotating line up of collectives and trios every week from London's thriving jazz scene, in the heart of Brick Lane. Join us as we bring the community together through incredible music & banging drinks.\\n\\nThis Sunday, we welcome the In Time jam crew, hosted by Joseph Marlow. After establishing a place in the London Jazz scene with their weekly In Time Jam at the Ritzy, they have sold out multiple shows at venues such as Ronnie Scotts, The Jazz Cafe and Pizza Express.\\n\\nFeaturing an all star house band performance this night will allow musicians to gain experience playing with the best of the best!\\n\\nBring your instruments, and your friends! For a night of listening, playing and networking with all of the familiar faces in the London music scene!\\n\\nDoors from 6pm\\n\\nReserve a table here - https://www.opentable.co.uk/r/ninety-one-living-room-london\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room\",\"privacy_policy_link\":\"https://91livingroom.com/homepage/privacy-policy/\",\"fb_pixel_id\":\"580346810496200\",\"ga_tracking_id\":\"302117538\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773597600,\"venues\":[{\"id\":\"3396\",\"name\":\"Ninety One \",\"address\":\"91 Brick Ln, Spitalfields, London E1 6QL, UK\",\"location\":{\"lat\":51.5214425,\"lng\":-0.07235059999999999},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ninety-one-6pob\",\"accessibility\":{\"url\":\"https://91livingroom.com/access-faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-15T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":2,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:95\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"10115\",\"name\":\"Ninety One\",\"image\":{\"url\":null},\"perm_name\":\"ninety-one-m75r\",\"profile_active\":true},\"id\":\"69930467be72810001bfd88c\",\"name\":\"Jazz on the Lane: In Time Jam \",\"perm_name\":\"53ryoy-jazz-on-the-lane-in-time-jam-15th-mar-ninety-one-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/ed7d70fb-01d1-4392-8c8f-424e173156e0.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/ed7d70fb-01d1-4392-8c8f-424e173156e0.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/ed7d70fb-01d1-4392-8c8f-424e173156e0.jpg?rect=506%2C0%2C1238%2C2250\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1745449200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":499,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T09:00:00+00:00\",\"sale_end_date\":\"2026-03-15T04:30:00+00:00\",\"sale_start_date\":\"2026-01-26T09:00:00+00:00\",\"event_start_date\":\"2026-03-15T18:00:00+00:00\",\"event_end_date\":\"2026-03-15T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/T385650f1787?dice_id=T385650f1787\",\"post_competition_referral\":\"https://link.dice.fm/s596048b8689?dice_id=s596048b8689\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N7be87affa49?dice_id=N7be87affa49\",\"post_purchase_referral\":\"https://link.dice.fm/hac14593c837?dice_id=hac14593c837\",\"post_reminder_referral\":\"https://link.dice.fm/md1ba937a4ee?dice_id=md1ba937a4ee\",\"post_waitinglist_referral\":\"https://link.dice.fm/me46fa875f7d?dice_id=me46fa875f7d\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"LEAVES’ EYES has always been a band of superlatives: The international group has toured on five continents, playing concerts in more than 50 countries. Their live shows are spectacular events with breathtaking stage scenery, including a Viking ship or even the “Swords In Rock” monument from Norway. LEAVES’ EYES have been setting world history to music and undeniably, by doing so, have raced to the top of the symphonic metal tree.\\n\\nWith their new and chartbreaking album “Myths Of Fate” (#17 Official German Album Charts) Leaves’ Eyes once again set sails for new winds that definitely blow from the harsh shallows of the symphonic metal genre. The fantastic world of legends from Norse and Eastern European mythology is the setting for monumental entertainment. “The early Middle Ages were a fascinating time of change. Some of these innovations have left their mark around the globe and continue to impact our modern world”, tells Alex, who created the lyrical concept. Leaves’ Eyes open up a world of magical places, spellbound weapons or supernatural creatures.\\n\\nIn order to increase their followers’ enjoyment of the captivating stories, the band produced a total of five music videos with Mastersound Entertainment. Filmed on impressive locations in Iceland, Germany and Poland, they bring the myths captivatingly to the screen. Magic creatures, great battles and enchanting warrior queens come to live.\\n\\nOnce again, Leaves’ Eyes have created an entire universe of their own imagination that showcases their talent as storytellers and music perfectionists. No doubt, the band will leave an everlasting footprint in their own genre with this album.\\n\\n“Myths Of Fate” provides a dynamic soundtrack for a vivid escape into a magical world of mythology.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773597600,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-15T18:00:00+00:00\",\"doors_close_date\":\"2026-03-15T22:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:96\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"69772d7f7752d6000177c51b\",\"name\":\"LEAVES' EYES\",\"perm_name\":\"av35lv-leaves-eyes-15th-mar-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-01/dc8447c9-4b60-48c9-8a88-69fd7d87ac6c.jpg?rect=0%2C97%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-01/dc8447c9-4b60-48c9-8a88-69fd7d87ac6c.jpg?rect=0%2C250%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-01/dc8447c9-4b60-48c9-8a88-69fd7d87ac6c.jpg?rect=120%2C0%2C529%2C961\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Catalyst Crime\",\"image\":null,\"artist_id\":\"90990\",\"about\":null,\"is_headliner\":false},{\"name\":\"Leaves’ Eyes\",\"image\":null,\"artist_id\":\"90918\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1769418000,\"faqs\":[{\"id\":72018,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":72019,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":72020,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Leaves' Eyes - Across the Sea\",\"redirect_url\":\"https://open.spotify.com/track/03qYEu1PcJMWIw1I06v7mq\",\"artist\":\"Leaves' Eyes\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6da4186fff4a1a0536f90de35c02dcecacdeb287?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Across the Sea\"},{\"type\":\"apple_music\",\"title\":\"Leaves' Eyes - Across the Sea\",\"redirect_url\":\"https://music.apple.com/us/album/across-the-sea/1308289355?i=1308290350&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Leaves' Eyes\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/89/78/10/897810a7-52fd-6037-5afa-586ec2d050f0/mzaf_15099105718328935921.plus.aac.p.m4a\",\"track_name\":\"Across the Sea\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sun 15 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
