llyket\"},{\"type\":\"apple_music\",\"title\":\"Dogshow - Dancing (Dancing)\",\"redirect_url\":\"https://music.apple.com/us/album/dancing-dancing/1670905025?i=1670905253&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dogshow\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/20/c4/c4/20c4c450-92e1-9251-bb83-b6309a9f32e7/mzaf_17588204067249115802.plus.aac.p.m4a\",\"track_name\":\"Dancing (Dancing)\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1758715200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Dogshow are an unmistakable band formed by 2 brothers traversing the astral planes of dance music – whilst dressed as poodles. These two full-bodied canine brothers are on a mission to create the ultimate party experience, and might accidentally be the most surreal band you’ll witness anytime soon. Fusing live techno, jazz, dance musicianship, their show comprises a battery-powered ‘Dog-Trolley’ placed in the centre of the audience where they conduct a ritualistic ‘howling at the moon’ ceremony. Join the spectacle and unleash your inner canine.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Boileroom.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:45\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Ub8e1e9344b9?dice_id=Ub8e1e9344b9\",\"post_competition_referral\":\"https://link.dice.fm/ka78d847d09d?dice_id=ka78d847d09d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Va9fbe808ff1?dice_id=Va9fbe808ff1\",\"post_purchase_referral\":\"https://link.dice.fm/Y3e274a842a9?dice_id=Y3e274a842a9\",\"post_reminder_referral\":\"