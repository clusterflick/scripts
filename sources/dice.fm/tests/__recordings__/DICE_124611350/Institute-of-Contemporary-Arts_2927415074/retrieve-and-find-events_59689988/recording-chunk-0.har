4},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:19\",\"venues\":[{\"id\":\"1565\",\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church St, Stoke Newington, London N16 9ES, UK\",\"location\":{\"lat\":51.5613778,\"lng\":-0.0847131000000445},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-church-stoke-newington-x9am\",\"accessibility\":{\"url\":\"https://www.theoldchurch.org.uk/access\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-11T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Twain\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/0b524cace4a09a547e4bdd980cf5d8afc5d3e8a3\"},\"artist_id\":\"27345\",\"about\":null,\"is_headliner\":true},{\"name\":\"Mat Davidson\",\"image\":null,\"artist_id\":\"133058\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"***Twain -*** “There is nothing remarkable about my life that is necessary to know in order to appreciate the songs,” says Matthew Davidson of Twain. He describes the project as “a modern folk\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\" Under 18s to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T15:00:00+00:00\",\"sale_end_date\":\"2026-06