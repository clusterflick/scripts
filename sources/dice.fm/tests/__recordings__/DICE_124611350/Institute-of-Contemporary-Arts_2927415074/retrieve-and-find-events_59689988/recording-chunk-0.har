ice.fm/M500308d0f74?dice_id=M500308d0f74\",\"post_reminder_referral\":\"https://link.dice.fm/b7da19a85124?dice_id=b7da19a85124\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T22:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"A classic KOKO Electronic session awaits as we welcome theatre favourites Horse Meat Disco back under our Disco Ball for a special all night long session, this March. Always a sell out, tickets now on sale.\\n\\n**IMPORTANT INFORMATION:**\\n\\nFeeling peckish? Join us every Friday from 7pm-12am at Don KOKO, for pizzas & cocktails curated by What Willy Cook, SG Lewis, DJ Tennis, Natasha Diggs, Carlita & many more – check your emails for a 20% discount link. Or head to @donkokofc for reservations & offers.\\n\\nFor VIP & areas please email: bookings@KOKO.co.uk (available on selected nights only).\\n\\nPlease arrive according to the time on your ticket for a smooth and guaranteed entry.\\n\\nWe have a zero tolerance policy towards harassment and prejudice. If you are made to feel uncomfortable in any way, please do not hesitate to speak to any member of staff and we will help immediately.\\n\\nAny unattended drinks will be discarded.\\n\\nPlease do not purchase tickets through social media, we are unable to help with anyone who has been scammed.\\n\\nWe operate a zero tolerance drug policy.\\n\\nKOKO is 19+. No physical ID, no entry.\\n\\nPlease bring a valid form of photographic ID with you to the event (please note, we only accept valid passports, foreign national ID cards, driving licenses, or Home Office approved PASS cards as identification and/or proof of age.\\n\\nLast entry 3am. No readmission.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 19+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:16\",\"billing_promoter\":{\"id\":\"8108\",\"name\":\"KOKO\",\"image\":{\"url\":null},\"perm_name\":\"koko-nwv5\",\"profile_active\":false},\"presented_by\":\"Presented by KOKO.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Horse Meat Disco\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-26/fb28a1f3-2d6d-450c-9f4a-ad3e4e1f6862.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"2123\",\"about\":{\"description\":\"Founded in 2004 by DJs James Hillard and Jim Stanton, Horse Meat Disco began as a queer underground basement party in south London, with a focus on giving disco a place in club culture. Since, HMD has grown into an internationally known disco event – with four resident DJs, regular Boiler Room appearances, and monthly residencies in Berlin, New York and Lisbon, alongside their traditional weekly night in Vauxhall.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":918,\"name\":\"KOKO\",\"privacy_policy_link\":