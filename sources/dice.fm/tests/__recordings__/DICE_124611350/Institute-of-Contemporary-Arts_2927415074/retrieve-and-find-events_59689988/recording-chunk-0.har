new-cross-live-y8la\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"8enev5-cydonia-knights-28th-feb-new-cross-inn-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772301600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:73\",\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cydonia Knights\",\"image\":null,\"artist_id\":\"59323\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"New Cross Live presents\\n\\nCydonia Knights - UK Muse Tribute\\n\\nThe UK's longest running & most followed Muse Tribute act. An authentic 3 piece simulation of the multi award winning rock trio.\\n\\nhttps://www.cydoniaknights.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-21T00:00:00+01:00\",\"sale_end_date\":\"2026-02-28T17:00:00+00:00\",\"sale_start_date\":\"2025-07-21T00:00:00+01:00\",\"event_start_date\":\"2026-02-28T18:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"687e29a03d604d00019b1b0d\",\"name\":\"Cydonia Knights \",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-21/086680fa-6182-4273-bde0-dd11075bb28b.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-21/086680fa-6182-4273-bde0-dd11075bb28b.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-21/086680fa-6182-4273-bde0-dd11075bb28b.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1753052400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ad4687d7d256?dice_id=Ad4687d7d256\",\"post_competition_referral\":\"https://link.dice.fm/C449a547b2ac?dice_id=C449a547b2ac\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F210a34d6fa3?dice_id=F210a34d6fa3\",\"post_purchase_referral\":\"https://link.dice.fm/w6356fed159a?dice_id=w6356fed159a\",\"post_reminder_referral\":\"https://link.dice.fm/X97aec83ee6c?dice_id=X97aec83ee6c\",\"post_waitinglist_referral\":\"https://link.dice.fm/j0c3d7774a7c?dice_id=j0c3d7774a7c\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5535},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":46941,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":46942,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":46943,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":46944,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":46945,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":4},{\"id\":46946,\"title\":\"Can I bring a bag?\",\"body\":\"BAG POLICY FOR LIVE MUSIC EVENTS AT ALEXANDRA PALACE\\n\\nWe encourage you to attend live music events without bags. Should you need to bring one for your essentials, it needs to be as small as possible.\\n\\nFor security reasons and in line with industry best practice, visitors are only permitted to bring one small bag into the venue, which must be no bigger than:\\n\\nHeight 30cm (11.8 inches)\\n\\nWidth 20cm (7.9 inches)\\n\\nDepth 10cm (3.9 inches)\\n\\nAny bags that do not meet these requirements will be directed to our bag drop (Great Hall concerts only).\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":5},{\"id\":46947,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":6},{\"id\":46948,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k6og3p-pawsa-28th-feb-alexandra-palace-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1772303400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:74\",\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-02-28T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"PAWSA\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-24/c35be8f6-1f7a-45b9-9f8c-0fe18ff59cee.jpg?rect=0%2C55%2C531%2C531\"},\