oors_close_date\":null}],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/b60480f78eda?dice_id=b60480f78eda\",\"post_competition_referral\":\"https://link.dice.fm/c012f4672e48?dice_id=c012f4672e48\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Rd395bfb0fe9?dice_id=Rd395bfb0fe9\",\"post_purchase_referral\":\"https://link.dice.fm/uc0c080702a9?dice_id=uc0c080702a9\",\"post_reminder_referral\":\"https://link.dice.fm/ta272e596603?dice_id=ta272e596603\",\"post_waitinglist_referral\":\"https://link.dice.fm/xcf3139546a8?dice_id=xcf3139546a8\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by 229.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:62\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T16:30:00+00:00\",\"sale_end_date\":\"2026-04-16T17:00:00+01:00\",\"sale_start_date\":\"2025-12-10T16:30:00+00:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1765384200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4090},\"id\":\"6939a7cca570f200011d885e\",\"name\":\"'Beats Rhymes &  Life' - The Travels of A Tribe Called Quest (Film Screening)\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"v3gy8l-beats-rhymes-life-the-travels-of-a-tribe-called-quest-film-screening-16th-apr-229-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/0d25f0c7-af48-4fd7-94cb-c14d34b9f365.jpg?rect=0%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/0d25f0c7-af48-4fd7-94cb-c14d34b9f365.jpg?rect=0%2C800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/0d25f0c7-af48-4fd7-94cb-c14d34b9f365.jpg?rect=900%2C0%2C2200%2C4000\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"229 is proud to present the second edition of the European screening of “Beats, Rhymes & Life: The travels of A Tribe Called Quest\\\"\\n\\nFollowed by an exclusive Q&A and Dj live set by original Tribesman and star of the movie JAROBI, A Tribe Called Quests manager and Phife Dawg DJ RASTA ROOT.\\n\\n**An essential night for A Tribe Called Quest enthusiasts and Hip Hop lovers**\\n\\nGrammy nominated, Sundance Film Festival selected 'BEATS, RHYMES & LIFE: THE TRAVELS OF A TRIBE CALLED QUEST' is a documentary film directed by Michael Rapaport about one of the most influential and groundbreaking musical groups in hip-hop history.\\n\\nActor and director Michael Rapaport documents the inner workings and behind the scenes drama that followed the band. He explores what’s next for, what many claim, are the pioneers of alternative Hip Hop.\\n\\nFeaturing an original soundtrack by Madlib and including humorous & insightful interviews with the likes of Questlove, Pharrell Williams, Beastie Boys, Questlove, De La Soul, Common, as well as extensive accounts from Q-Tip, Phife Dawg, Jarobi White and Ali Shaheed Muhammad, never has the story of A Tribe Called Quest been better told.\\n\\nThis is a seated event\\n\\nThis event is 14+\\n\\nU18s will must be accompanied by a full paying adult\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[