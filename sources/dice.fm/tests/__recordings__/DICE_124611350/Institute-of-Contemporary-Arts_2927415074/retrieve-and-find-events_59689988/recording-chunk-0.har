nix\":1772132400,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:81\",\"price\":{\"currency\":\"GBP\",\"amount\":1683,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-22/455f6daa-afea-4726-a9bf-668b3ec1c7c8.jpg?rect=126%2C136%2C5728%2C5721\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-22/455f6daa-afea-4726-a9bf-668b3ec1c7c8.jpg?rect=0%2C2926%2C6076%2C3646\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-22/455f6daa-afea-4726-a9bf-668b3ec1c7c8.jpg?rect=427%2C0%2C5223%2C9497\"},\"id\":\"68f8a08f50374b000143d366\",\"name\":\"Jamie Leeming\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Jamie Leeming, one of London’s most beloved Jazz guitarists, comes to The Lower Third for what will be a stunning headline show.\\n\\nA key collaborator of Alfa Mist, Tom Misch and Jas Kayser, Leeming’s musical mastery has long helped shape the sound of UK Jazz. Initially gaining notoriety through his work on Alfa Mist’s string of cult-classic albums, Leeming has since stepped out solo, most notably with album Sequent.\\n\\nCo-produced with Alfa Mist, and inspired by albums from the likes of Milton Nascimento and Egberto Gismonti, Sequent is a constantly evolving twelve-track odyssey. Recorded live, using vintage production techniques, it captures the sound of musicians at the top of their game, locked into creating an enveloping tornado of sound.\\n\\nAt The Lower Third, Leeming will bring Sequent’s sonic adventure live to the stage.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-22T12:00:00+01:00\"