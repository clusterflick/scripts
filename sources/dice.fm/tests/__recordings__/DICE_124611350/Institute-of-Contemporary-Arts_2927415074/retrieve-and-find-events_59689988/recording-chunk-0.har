.fm/z758a7662755?dice_id=z758a7662755\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Te7704b43c44?dice_id=Te7704b43c44\",\"post_purchase_referral\":\"https://link.dice.fm/fdf1ee53cf9f?dice_id=fdf1ee53cf9f\",\"post_reminder_referral\":\"https://link.dice.fm/wfa0f82b2f02?dice_id=wfa0f82b2f02\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q6f0e514734a?dice_id=Q6f0e514734a\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by RLN MUSIC\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:12\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-12T10:00:00+00:00\",\"sale_end_date\":\"2026-04-12T17:00:00+01:00\",\"sale_start_date\":\"2025-11-14T10:00:00+00:00\",\"event_start_date\":\"2026-04-12T19:30:00+01:00\",\"event_end_date\":\"2026-04-12T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1762941600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":4532,\"sales_tax\":0,\"amount_from\":null},\"id\":\"690dfbc2da071400011d555a\",\"name\":\"T'Pau\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"T'Pau\",\"image\":null,\"artist_id\":\"5446\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"v3b2md-tpau-12th-apr-bush-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-07/26dc052b-543c-453e-88eb-0c5391867705.jpg?rect=0%2C2%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-07/26dc052b-543c-453e-88eb-0c5391867705.jpg?rect=0%2C900%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-07/26dc052b-543c-453e-88eb-0c5391867705.jpg?rect=175%2C0%2C1650%2C3000\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Join Carol Decker & T’pau on their first full UK tour in a decade playing all their hits, fan favourites and songs from their forthcoming album ‘Be Wonderful’.\\n\\nT'pau burst onto the music scene in 1987 with the massive hit single Heart & Soul and the follow up, China In Your Hand, stayed at No1 for five weeks - the longest serving No1 of the year and became one of the most iconic singles of the 1980s. Simultaneously, their debut album Bridge of Spies occupied the No1 album slot for two weeks and went on to become a certified quadruple platinum in the UK - selling 1.2 million copies. Their own arena concerts followed, and the subsequent 1988 record Rage also went platinum. T’Pau enjoy the exclusive title of holding three simultaneous No.1 slots; China No.1 in the singles charts, Bridge of Spies No.1 in the album charts and the China Remix at No.1 in the dance charts! T’Pau were nominated for 5 Brit Awards, an Ivor Novello Award , and won an ASCAP Award from the USA for Heart & Soul.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event, under 18s accompanied. \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Industrial Messiah Complex\",\"redirect_url\":\"https://open.spotify.com/track/7qNbXDJpI1By1dg4VZmnl6\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-prev