,\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c35c35d45ff2?dice_id=c35c35d45ff2\",\"post_purchase_referral\":\"https://link.dice.fm/wd06b75c424c?dice_id=wd06b75c424c\",\"post_reminder_referral\":\"https://link.dice.fm/B2071dc65b7b?dice_id=B2071dc65b7b\",\"post_waitinglist_referral\":\"https://link.dice.fm/U682339e3bfb?dice_id=U682339e3bfb\"},\"perm_name\":\"6dwaab-califato-34-27th-jun-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/69470044-8a04-4aed-979f-7963e0584eab.jpg?rect=0%2C1000%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/69470044-8a04-4aed-979f-7963e0584eab.jpg?rect=0%2C1800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/69470044-8a04-4aed-979f-7963e0584eab.jpg?rect=350%2C0%2C3300%2C6000\"},\"properties\":[],\"about\":{\"description\":\"The Andalusian musical collective Califato ¾ make their London debut, fusing flamenco with revolutionary modern sounds.\\n\\nFormed in 2018 between musicians from Seville and Málaga, the collective champions a popular and mestiza vision of Andalusia, creating a unique sonic identity that is entirely its own.\\n\\nBlending raw flamenco power with funk, hip hop, dub, and electronic textures, Califato ¾ create an intoxicating, genre-bending experience–a high-energy performance that redefines the sound of the South of Spain.\\n\\nFlamenco for the 21st century.\\n\\nThis is a co-promotion between Como No, Flamenco Festival, and Jazz Café.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69403cf2ba87be0001dcc43d\",\"name\":\"Califato 3/4\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Califato ¾ - Crîtto de lâ Nabahâ\",\"redirect_url\":\"https://open.spotify.com/track/6ekCBoRDPEpNx6Sg5o9C1z\",\"artist\":\"Califato ¾\",