y_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Red Hot Riot\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7372d0f91de5a4d453737a22\"},\"artist_id\":\"120845\",\"about\":null,\"is_headliner\":false},{\"name\":\"THE ZIPHEADS\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0f8d55a552bb3f061147c24d\"},\"artist_id\":\"13922\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/165d7a4e-2417-49b2-9751-329126138cf1.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/165d7a4e-2417-49b2-9751-329126138cf1.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/165d7a4e-2417-49b2-9751-329126138cf1.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Last Man on Earth\",\"redirect_url\":\"https://open.spotify.com/track/2XKRlqAa0qg1Zh6voItdVm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/59d8d4e06a4365f5a26622b9c7b55ac4b5cba03a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Last Man on Earth\"},{\"type\":\"apple_music\",\"title\":\"The Zipheads - Manslaughter\",\"redirect_url\":\"https://music.apple.com/gb/album/manslaughter/840951121?i=840951216&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Zipheads\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/Music6/v4/83/d7/5f/83d75fac-182a-7591-30ef-6e88a8f25557/mzaf_8684936982541243027.plus.aac.p.m4a\",\"track_name\":\"Manslaughter\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1761739200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"The Zipheads\\n\\nThe Zipheads play Rock'n'Roll infused with punk, taking influence from the founding fathers of the 1950s like Little Richard and Chuck Berry, via the punk and new wave heroes of the 70s such as The Clash and Elvis Costello, along the way encompassing surf, swing, soul, country, folk, ska and reggae as well as most other types of music you could care to imagine into the mix.\\n\\nTo date, they have released 3 full-length albums, one instrumental EP and a handful of singles and have performed live at venues and festivals all over the UK and Europe as well as appearances in the USA.\\n\\nhttps://linktr.ee/zipheads\\n\\nRed Hot Riot\\n\\nFormed in February 2019, Red Hot Riot have played all over the world including a month-long EU tour supporting The Delta Bombers, Viva Las Vegas Festival in the USA and at Glastonbury Festival in England. With 2 full length albums and 3 EP’s released, the band are a strong favourites in peoples' playlists and are making waves for a new sound within the underground Neo-Rockabilly, Rock and Roll and Psychobilly Scenes.\\n\\nhttps://www.redhotriot.co.uk/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s require an adult)\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Safe As Milk.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:79\",\"social_links\":{\"event_share\":\"https://link.dice.fm/j0ac55b89fc2?dice_id=j0ac55b89fc2\",\"post_competition_referral\":\"https://link.dice.fm/P6