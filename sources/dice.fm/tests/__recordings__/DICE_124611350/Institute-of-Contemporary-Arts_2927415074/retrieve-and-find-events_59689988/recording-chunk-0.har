on_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1775574000,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:88\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1706},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/0efd62c1-dddf-4381-8d42-400b2b7ed49a.jpg?rect=749%2C0%2C3070%2C3070\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/0efd62c1-dddf-4381-8d42-400b2b7ed49a.jpg?rect=0%2C165%2C4568%2C2741\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/0efd62c1-dddf-4381-8d42-400b2b7ed49a.jpg?rect=1440%2C0%2C1689%2C3070\"},\"id\":\"697253887f85710001b201e5\",\"name\":\"Arlo Parks: Live Performance (Matinee)\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Due to phenomenal demand, Rough Trade East is very excited to present a second in-store live performance from Arlo Parks. This unique event celebrates the release of their new album 'Ambiguous Desire' released via Transgressive.\\n\\nPlease note this is a performance only, records will be pre-signed.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com › products › ambiguous-desire\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announc