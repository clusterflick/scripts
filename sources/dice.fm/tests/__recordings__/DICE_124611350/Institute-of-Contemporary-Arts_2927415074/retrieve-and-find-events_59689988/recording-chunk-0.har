s\":false,\"faqs\":[{\"id\":69082,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. All attendees 16-17s must be accompanied by a responsible adult who is 18 or older (1:1 ratio). To verify age, ID may be requested. We advise all customers to bring valid ID. For further information, see Age and ID in FAQs. Right of admission reserved.\",\"order\":0}],\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Go to beat. \",\"seating\":null,\"announcement_date_unix\":1768467600,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-04-02T18:00:00+01:00\",\"doors_close_date\":nu