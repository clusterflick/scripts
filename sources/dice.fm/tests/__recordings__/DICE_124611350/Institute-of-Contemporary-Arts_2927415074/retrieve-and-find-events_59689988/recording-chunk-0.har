":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"926ydo-the-hoosiers-live-signing-16th-may-rough-trade-east-london-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/bb9c6f90-fda5-4456-a399-05b4f16ebc7a.jpg?rect=0%2C1168%2C4672%2C4672\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/bb9c6f90-fda5-4456-a399-05b4f16ebc7a.jpg?rect=0%2C2103%2C4672%2C2803\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/bb9c6f90-fda5-4456-a399-05b4f16ebc7a.jpg?rect=409%2C0%2C3854%2C7008\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"**Acoustic Record Store Tour**\\n\\nRough Trade East is very excited to present a live performance and signing from The Hoosiers. This unique event celebrates the release of their new album 'Compassion' released via Crab Race.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com/products/compassion\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778954400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"172\",\"name\":\"Colour Factory\",\"address\":\"Ground Floor, Q