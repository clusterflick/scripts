inks\":{\"event_share\":\"https://link.dice.fm/R67c949f7845?dice_id=R67c949f7845\",\"post_competition_referral\":\"https://link.dice.fm/m116f70ad33b?dice_id=m116f70ad33b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ra95abd8a38e?dice_id=Ra95abd8a38e\",\"post_purchase_referral\":\"https://link.dice.fm/Aacaab7663de?dice_id=Aacaab7663de\",\"post_reminder_referral\":\"https://link.dice.fm/R2ee89182030?dice_id=R2ee89182030\",\"post_waitinglist_referral\":\"https://link.dice.fm/We89e29d5677?dice_id=We89e29d5677\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:39\",\"properties\":[],\"presented_by\":\"Presented by Hootananny Brixton.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766448000,\"id\":\"694a6b5d739dc200018614c0\",\"name\":\"Greg Spero: Spirit Fingers London Crew\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The amazing Greg Spero brings his Spirit Fingers London Crew to Brixton..✨🎹\\n\\nAmerican jazz pianist Greg Spero started Spirit Fingers in 2016, while on the road supporting pop star Halsey. The Spirit Fingers compositions, which he first composed in the upper level of a double-decker bus in London during a Halsey tour, were an equal and opposite reaction to the simplicity of the pop music that Spero was playing night after night.\\n\\nAfter a big 2025, this is one you wont want to miss!!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false},\"date_unix\":1772391600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3872},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T10:00:00+00:00\",\"sale_end_date\":\"2026-03-01T21:00:00+00:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-03-01T19:00:00+00:00\",\"event_end_date\":\"2026-03-01T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"538ory-ben-ottewell-and-ian-ball-gomez-by-request-buddy-1st-mar-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Pasadena\",\"redirect_url\":\"https://open.spotify.com/track/2QuKZ1pchSrl3E7AngBuzA\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1768f7f7154fcad28fb2f745de2c097f7ae37d61?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Pasadena\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ben Ottewell\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/ab0c00ef-51b2-408f-b424-f01ce7d07727.jpg?rect=14%2C0%2C972%2C972\"},\"artist_id\":\"5899\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ian Ball\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/31f3aaf9e28ce50ad8d5fbd3807f0433552c7965\"},\"artist_id\":\"130206\",\"about\":null,\"is_headliner\":false},{\"name\":\"Buddy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0d64fb99ce603a81c4a0b78b\"},\"artist_id\":\"5593\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/fb270fa8-a020-4317-bcaf-013f45f2f5ec.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/fb270fa8-a020-4317-bcaf-013f45f2f5ec.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/fb270fa8-a020-4317-bcaf-013f45f2f5ec.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/nbf97072c9a4?dice_id=nbf97072c9a4\",\"post_competition_referral\":\"https://link.dice.fm/U8e51aaf6afe?dice_id=U8e51aaf6afe\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F027c69e9a75?dice_id=F027c69e9a75\",\"post_purchase_referral\":\"https://link.dice.fm/B9e81eceecdb?dice_id=B9e81eceecdb\",\"post_reminder_referral\":\"https://link.dice.fm/H7697d8a4646?dice_id=H7697d8a4646\",\"post_waitinglist_referral\":\"https://link.dice.fm/hdbff79c771e?dice_id=hdbff79c771e\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:40\",\"properties\":[],\"presented_by\":\"Presented by DHP.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763460000,\"id\":\"691a2ce5ca4a5e00010ee476\",\"name\":\"Ben Ottewell and Ian Ball: Gomez by Request + Buddy\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"As founding members of the British band Gomez, Ian Ball and Ben Ottewell have shaped the sound of indie rock with their eclectic blend of blues, rock, folk, electronic and experimental influences.\\n\\nIn February 2026, they embark on the Gomez By Request tour where fans get to decide the setlist! You can request the tracks to be played at the gig using this link: https://forms.gle/BRrEokFagLDTSnaf7\\n\\nBoth Ian and Ben have pursued successful solo careers, but their chemistry remains as strong as ever. The Gomez By Request tour offers a rare opportunity for fans to experience the full scope of Gomez’s music, celebrating their enduring legacy and creative partnership through songs that have defined their remarkable three-decade spanning career.\\n\\nBen and Ian will be joined by LA based singer songwriter and long term collaborator Buddy.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1772391600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1710,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T11:00:00+00:00\",\"sale_end_date\":\"2026-03-01T19:15:00+00:00\",\"sale_start_date\":\"2026-02-13T11:00:00+00:00\",\"event_start_date\":\"2026-03-01T19:30:00+00:00\",\"event_end_date\":\"2026-03-01T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"dkqedo-stolen-nova-1st-mar-the-100-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lava La Rue\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9bef7d24b96052dfb8b27162\"},\"artist_id\":\"10311\",\"about\":null,\"is_headliner\":false},{\"name\":\"Stolen Nova\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba56272277c6166cffbe61f8d\"},\"art