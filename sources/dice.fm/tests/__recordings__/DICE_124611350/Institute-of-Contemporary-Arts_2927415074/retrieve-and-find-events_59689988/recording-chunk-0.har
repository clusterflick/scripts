GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"other-space-arts-bbago\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T19:15:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"129951\",\"name\":\"Riverwolf Music\",\"image\":{\"url\":null},\"perm_name\":\"riverwolf-music-l66ob\",\"profile_active\":false},\"announcement_date_unix\":1770372000,\"social_links\":{\"event_share\":\"https://link.dice.fm/B270bf9738cd?dice_id=B270bf9738cd\",\"post_competition_referral\":\"https://link.dice.fm/b55aa22ea455?dice_id=b55aa22ea455\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X01605d375d6?dice_id=X01605d375d6\",\"post_purchase_referral\":\"https://link.dice.fm/i5e353c99f61?dice_id=i5e353c99f61\",\"post_reminder_referral\":\"https://link.dice.fm/Nbda1a030767?dice_id=Nbda1a030767\",\"post_waitinglist_referral\":\"https://link.dice.fm/yc9d3a18ba18?dice_id=yc9d3a18ba18\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q279e9-alex-francis-ben-mckelvey-nick-byrne-one-eyed-man-17th-apr-other-space-arts-windsor-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776449700,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:0\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/b6e3757f-23ad-4204-aec5-71bc69adc95e.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/b6e3757f-23ad-4204-aec5-71bc69adc95e.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/b6e3757f-23ad-4204-aec5-71bc69adc95e.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6975e2fe7752d600013d8173\",\"name\":\"Alex Francis + Ben Mckelvey + Nick Byrne + One Eyed Man\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Acclaimed singer-songwriter **Alex Francis** has earned a reputation for his soulful voice and heartfelt songwriting. Originally hailing from Hitchin, Hertfordshire but now based in London, Alex's breakthrough came in 2017 when he was invited to be the guest vocalist on the Melanie C single “Hold On” released commercially throughout Europe – which led him to tour with Melanie and begin establishing himself on the continent.\\n\\nSince then he has released numerous EP’s and singles, toured internationally with Stereophonics and Sting, performed at London’s Hyde Park with Phil Collins as well as playing the Isle of Wight Festival twice. He has also accumulated over 30 million Spotify streams and 10k unique Shazams as his music continues to resonate with audiences worldwide.\\n\\nSupport:  \\nBen McKelvey  \\nNick Byrne (acoustic band)  \\nOne Eyed Man\\n\\n**About Riverwolf Music**\\n\\nWe have a mission to craft a brilliant live music experience that allows the artists to shine and provide the audience with a great atmosphere in which to enjoy the carefully curated acts. With high quality acts combined with local talent, and an ear to the ground of the best the local scene has to offer.\\n\\nPlease be advised that there is no wheelchair access or accessible toilet at this venue.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 16s accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T10:00:00+00:00\",\"sale_end_date\":\"2026-04-17T15:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-04-17T19:15:00+01:00\",\"event_end_date\":\"2026-04-17T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Alex Francis - Silver Lining\",\"redirect_url\":\"https://open.spotify.com/track/2GbKkBRw8MCzflhkwoE1dx\",\"artist\":\"Alex Francis\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bad759124b4d813dc23faba0cdbea2902a28c1de?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Silver Lining\"},{\"type\":\"apple_music\",\"title\":\"Alex Francis - Silver Lining\",\"redirect_url\":\"https://music.apple.com/us/album/silver-lining/1853599781?i=1853599788&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alex Francis\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/c8/92/d5/c892d551-8349-ae0a-d432-8de8f5a94b6b/mzaf_9218304819936313237.plus.aac.p.m4a\",\"track_name\":\"Silver Lining\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":74711,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1770249600,\"social_links\":{\"event_share\":\"https://link.dice.fm/uf2699a91efc?dice_id=uf2699a91efc\",\"post_competition_referral\":\"https://link.dice.fm/fe79394062dd?dice_id=fe79394062dd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Vddfdd90ea7a?dice_id=Vddfdd90ea7a\",\"post_purchase_referral\":\"https://link.dice.fm/Vcb60e35c8e0?dice_id=Vcb60e35c8e0\",\"post_reminder_referral\":\"https://link.dice.fm/k3f51554733d?dice_id=k3f51554733d\",\"post_waitinglist_referral\":\"https://link.dice.fm/fb225b64502c?dice_id=fb225b64502c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"53r5aw-guest-event-nick-hart-tom-moore-17th-apr-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776450600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:1\",\"price\":{\"currency\":\"GBP\",\"amount\":1339,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/57c08250-2a36-4862-bfe5-5c984f39c8dc.jpg?rect=0%2C756%2C3025%2C3025\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/57c08250-2a36-4862-bfe5-5c984f39c8dc.jpg?rect=0%2C1361%2C3025%2C1815\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/57c08250-2a36-4862-bfe5-5c984f39c8dc.jpg?rect=265%2C0%2C2495%2C4536\"},\"id\":\"69861d3e86d4e500015054bb\",\"name\":\"Guest Event - Nick Hart & Tom Moore\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Nick Hart and Tom Moore are an English folk duo whose debut album, The Colour of Amber (2023), has been widely acclaimed for its vivid interpretations of traditional songs and tunes. The album pairs Hart’s tenor viol and distinctive vocals with Moore’s expressive viola, enhanced by drones and bass from an antique church harmonium, creating a sound that is both intimate and timeless.\\n\\nBoth musicians are highly respected in the folk world. Nick, an award-winning singer and multi-instrumentalist, has been described as “probably the finest interpreter of traditional English folk songs this generation has produced” (Tradfolk). Tom, a violist, fiddle player, and producer, has been called “ingenious” (The Guardian) and “irresistible” (The Independent), and has performed across the UK and Europe.\\n\\nHart and Moore have worked together in various projects for over a decade. Tom contributed to all three of Nick’s acclaimed solo albums as strings player and engineer, and the duo have remained close collaborators. Originally from mid-Norfolk, Tom recently returned there after 12 years in London, while Nick, raised on the Essex/Cambridgeshire border, now lives in Bristol.\\n\\n“Whatever these two turn their hands to turns to gold. The Colour of Amber stands as one of 2023’s finest traditional folk albums.” — Tradfolk\\n\\n“A stately beauty… simple, yet utterly engaging. Nick and Tom bring familiar favourites vividly to life.” — At The Barrier\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 12+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T00:00:00+00:00\",\"sale_end_date\":\"2026-04-17T22:00:00+01:00\",\"sale_start_date\":\"2026-02-05T00:00:00+00:00\",\"event_start_date\":\"2026-04-17T19:30:00+01:00\",\"event_end_date\":\"2026-04-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Nick Hart & Tom Moore - Babylon\",\"redirect_url\":\"https://music.apple.com/us/album/babylon/1719106515?i=1719107224&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nick Hart & Tom Moore\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/8d/14/e7/8d14e7d1-90cf-7bf3-db73-1ddcd24c7a26/mzaf_7247325196043329358.plus.aac.p.m4a\",\"track_name\":\"Babylon\"},{\"type\":\"spotify\",\"title\":\"Nick Hart & Tom Moore - Babylon\",\"redirect_url\":\"https://open.spotify.com/track/587SJJWOo4rWGi14GbdcWp\",\"artist\":\"Nick Hart & Tom Moore\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c0e65e787f411555b709c005224535173caadce3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Babylon\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ellie O’Neill\",\"image\":null,\"artist_id\":\"104975\",\"about\":{\"description\":\"Ellie O’Neill is an artist from Co. Meath, Ireland. Her music weaves a rich, diverse and tender landscape, traversing raw and intuitive explorations of intimacy and loss, friendship and queer identity. Writing mainly with voice and acoustic guitar, her songs range from cyclical, meditative, two-chord reveries to big-hearted, muscular, grungy confessionals.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bird On The Wire\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"956\",\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road, london SE15 3BE\",\"location\":{\"lat\":51.4582576,\"lng\":-0.0521545000000287},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-ivy-house-nvk5\",\"accessibility\":{\"url\":\"https://www.ivyhousenunhead.com/about\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"112\",\"name\":\"Bird On The Wire\",\"image\":{\"url\":null},\"perm_name\":\"bird-on-the-wire-jqo9\",\"profile_active\":true},\"announcement_date_unix\":1768903200,\"social_links\":{\"event_share\":\"https://link.dice.fm/j5547f28c7bf?dice_id=j5547f28c7bf\",\"post_competition_referral\":\"https://link.dice.fm/Va63e63cee6e?dice_id=Va63e63cee6e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T8e5d21833a2?dice_id=T8e5d21833a2\",\"post_purchase_referral\":\"https://link.dice.fm/p06c619650e0?dice_id=p06c619650e0\",\"post_reminder_referral\":\"https://link.dice.fm/B16756a9ef21?dice_id=B16756a9ef21\"