lose and personal.\\n\\nSaturday 13 June | Doors 6PM\\n\\nSignature Brew Haggerston\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T10:45:00+00:00\",\"sale_end_date\":\"2026-06-13T17:45:00+01:00\",\"sale_start_date\":\"2026-02-13T10:45:00+00:00\",\"event_start_date\":\"2026-06-13T18:00:00+01:00\",\"event_end_date\":\"2026-06-13T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698cb7731715d70001cef899\",\"name\":\"Charlie Harper - An Evening of Songs & Stories with a Punk Rock Legend | London\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/a3baaaf6-25eb-4578-bc11-f8f8de6559f9.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/a3baaaf6-25eb-4578-bc11-f8f8de6559f9.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/a3baaaf6-25eb-4578-bc11-f8f8de6559f9.jpg?rect=338%2C0%2C825%2C1500\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770979500,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/wf5dbffdf121?dice_id=wf5dbffdf121\",\"post_competition_referral\":\"https://link.dice.fm/o67203fad019?dice_id=o67203fad019\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/U5f2169831a0?dice_id=U5f2169831a0\",\"post_purchase_referral\":\"https://link.dice.fm/J5e715ec92ed?dice_id=J5e715ec92ed\",\"post_reminder_referral\":\"https://link.dice.fm/fdcaaa327c72?dice_id=fdcaaa327c72\",\"post_waitinglist_referral\":\"https://link.dice.fm/ufaa5301fcef?dice_id=ufaa5301fcef\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Riot\",\"redirect_url\":\"https://