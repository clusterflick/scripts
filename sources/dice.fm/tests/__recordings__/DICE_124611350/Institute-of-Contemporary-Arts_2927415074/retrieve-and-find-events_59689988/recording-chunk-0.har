act ACCESS@koko.uk.com\",\"order\":0}],\"billing_promoter\":{\"id\":\"1141\",\"name\":\"SJM Concerts\",\"image\":{\"url\":null},\"perm_name\":\"sjm-concerts-xe8k\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"eorqaw-lexa-gates-23rd-jun-koko-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782237600,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"status\":\"announced\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:78\",\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-23T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lexa Gates\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-31/22f8393f-ab0e-45e1-b0ee-66d98eb021ca.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"96435\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"SJM Concerts Present\\n\\nLexa Gates\\n\\nplus support\\n\\nBorn and bred in Queens, New York, Lexa Gates is a talented singer/songwriter, rapper, and producer. Her journey in music began at a young age, with her passion for composing melodies and singing emerging as early as 9 years old. She initially shared her music on SoundCloud, debuting her first tracks in 2019 and eventually releasing full bodies of work, often crafted in her own DIY basement studio - her latest titled, \\\"Universe Wrapped In Flesh”. Among her repertoire, the song \\\"Angel\\\" stands out as a notable track that has garnered significant attention for Lexa. Its success has contributed to the growth of her fan base, drawing in listeners who are captivated by her bold and ambitious style of expression. Lexa's ability to seamlessly blend genres and deliver compelling lyrics keeps her audience engaged and eagerly awaiting her future releases, poised for a promising and bright future ahead.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T17:00:00+00:00\",\"sale_end_date\":\"2026-06-23T16:00:00+01:00\",\"sale_start_date\":\"2026-02-20T10:00:00+00:00\",\"event_start_date\":\"2026-06-23T19:00:00+01:00\",\"event_end_date\":\"2026-06-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698e14ed3a8ebd00012e3c15\",\"name\":\"Lexa Gates\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/b808dd31-bba2-46de-a0a2-aa1b9f14c9b7.jpg?rect=0%2C125%2C2075%2C2075\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/b808dd31-bba2-46de-a0a2-aa1b9f14c9b7.jpg?rect=0%2C943%2C2075%2C1245\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/b808dd31-bba2-46de-a0a2-aa1b9f14c9b7.jpg?rect=177%2C0%2C1722%2C3130\"},\"marketeers\":[{\"id\":918,\"name\":\"KOKO\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"421051646826847\",\"ga_tracking_id\":null,\"