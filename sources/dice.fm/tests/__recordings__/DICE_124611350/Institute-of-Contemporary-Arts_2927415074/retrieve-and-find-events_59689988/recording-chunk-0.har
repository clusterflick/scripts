nt_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Folklore (Label).\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:48\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T10:00:00+00:00\",\"sale_end_date\":\"2026-04-15T18:30:00+01:00\",\"sale_start_date\":\"2025-12-10T09:00:00+00:00\",\"event_start_date\":\"2026-04-15T19:30:00+01:00\",\"event_end_date\":\"2026-04-15T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1765274400,\"offers_extras\":false,\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2387,\"sales_tax\":0,\"amount_from\":null},\"id\":\"692f0c96c736b00001bc50f9\",\"name\":\" The Burning Hell + Carsie Blanton\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Burning Hell\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe6294a2944ade1072489a238\"},\"artist_id\":\"805\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"l8orrb--the-burning-hell-carsie-blanton-15th-apr-the-lexington-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/02b76285-a61e-403b-8266-97f5bab45f7b.jpg?rect=667%2C0%2C2667%2C2667\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/02b76285-a61e-403b-8266-97f5bab45f7b.jpg?rect=0%2C134%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/02b76285-a61e-403b-8266-97f5bab45f7b.jpg?rect=1267%2C0%2C1467%2C2667\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"The Burning Hell met Carsie Blanton at a far-flung, small-town gig, and everybody fell in love with each other. They bonded over a shared affection for science fiction and socialism, and made plans to do some writing together. Pretty soon, this new American-Canadian alliance found themselves in a little village in Ireland making a whole record.\\n\\nCarsie, Joe, Mathias and Ariel brought out the silliest and most diabolical sides of each other, shouting down billionaires and war criminals, writing muppet musicals about cybernetics and the inevitable collapse of capitalism.\\n\\nEverything is Great is the result, a co-created album of outraged, outrageous, and ultimately optimistic anthems that invite everyone to join the party. They’ll be on tour together in 2026, playing songs from each of their extensive catalogues plus plenty of new ones, in a show that they have been persuaded by more cautious friends not to call “Martinis and Molotovs.”\\n\\n—-\\n\\n\\\"Carsie Blanton is one of those hard-headed open-hearted protestors who can make revolution sound desirable to your body, even if your mind wants to resist it\\\" - Fresh Air\\n\\n\\\"\\\\[The Burning Hell’s Ghost Palace is\\\\] a warm, wonderful celebration of how the songwriter can help interpret an increasingly unfathomable world.\\\" - The Arts Desk\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"faqs\":[],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":680,\"name\":\"Blues Kitchen Camden\",\"privacy_policy_link\":\"https://theblueskitchen.com/camden/privacy-policy/\",\"fb_pixel_id\":\"1527411330907074\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixe