e,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/6a14feaf-7439-4100-9f71-cee5fb123bbb.jpg?rect=412%2C0%2C1065%2C1065\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/6a14feaf-7439-4100-9f71-cee5fb123bbb.jpg?rect=57%2C0%2C1775%2C1065\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/6a14feaf-7439-4100-9f71-cee5fb123bbb.jpg?rect=651%2C0%2C586%2C1065\"},\"id\":\"696f7dfb4abf7c0001161db2\",\"name\":\"WE ARE MAKING A FILM ABOUT MARK FISHER\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"We Are Making A Film About Mark Fisher — a 65-minute cinematic experiment exploring the continuing relevance of the late theorist’s ideas on capitalism, culture, and the future.\\n\\nBlending documentary, performance, and hauntological fiction, the film follows Parkins — a time-slipped character — through ghostly landscapes and digital spaces, tracing Fisher’s thought from the 1990s to our algorithmic present.\\n\\nCreated collaboratively by over 70 artists through Instagram (@markfisherfilm), the film embodies Fisher’s call for collective imagination beyond capitalist realism.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T13:15:00+00:00\",\"sale_end_date\":\"2026-02-28T16:00:00+00:00\",\"sale_start_date\":\"2026-01-20T13:15:00+00:00\",\"event_start_date\":\"2026-02-28T16:00:00+00:00\",\"event_end_date\":\"2026-02-28T17:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[{\"id\":57985,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T14:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/R2057e1ef6c2?dice_id=R2057e1ef6c2\",\"post_competition_referral\":\"https://link.dice.fm/cc5f28108818?dice_id=cc5f28108818\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S26089a04f62?dice_id=S26089a04f62\",\"post_purchase_referral\":\"https://link.dice.fm/s66690f24dc4?dice_id=s66690f24dc4\",\"post_reminder_referral\":\"https://link.dice.fm/zd6d218b4a09?dice_id=zd6d218b4a09\",\"post_waitinglist_referral\":\"https://link.dice.fm/F0fe70514d70?dice_id=F0fe70514d70\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"g5dx3b-battleship-potemkin-ft-live-original-score-28th-feb-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772305200,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:10\",\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"697de72936c1ab0001705844\",\"name\":\"'Battleship Potemkin' ft. live original score \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Screening of Soviet silent film classic accompanied by Body Orchestra's live score onboard a historic ship. (Supported by BFI FAN)\\n\\nBack by popular demand, Body Orchestra are performing their original score, live, to Sergei Eisenstein's seminal movie, Battleship Potemkin (1925). Featuring field recordings of Bolshevik funeral marches, and manipulating the audio using reel to reel tape machines (inspired by Eisensteins signature collage techniques), Body Orchestra will accompany the film's dramatisation of the real life Russian Battleship mutiny in 1905 performing onboard an historic cargo ship.\\n\\nReturning from sell-out performance in 2024 at Theatreship, the music ranged from extended drone pieces, inspired by Morton Feldman's Rothko Chapel, to decomposing Shostakovich's 11th symphony (an interperetation of a Bolshevik funeral march about the Russian Revolution of 1905, which the film is based on).\\n\\n**This event is part of Silent Film with New Sound season at Theatreship.**\\n\\n**Programme supported by Film Hub London, managed by Film London. Proud to be a partner of the BFI Film Audience Network, funded by the National Lottery.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-02-28T22:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Body Orchestra - Lights Out\",\"redirect_url\":\"https://open.spotify.com/track/6Aqw4mevxCANxveJcjVgCb\",\"artist\":\"Body Orchestra\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3eb669999756735f1b1ddd1e6c1a55cda6093071?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Lights Out\"},{\"type\":\"apple_music\",\"title\":\"Body Orchestra - Lights Out\",\"redirect_url\":\"https://music.apple.com/us/album/lights-out/1805030659?i=1805030811&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Body Orchestra\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/cf/79/98/cf7998c9-a4ba-0a52-9f23-28bfca2d31ca/mzaf_5027122567183477467.plus.aac.p.m4a\",\"track_name\":\"Lights Out\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 28 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Deeper Into Movies.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"43\",\"name\":\"MOTH Club\",\"address\":\"Old Trades Hall, Valette Street, London E9 6NU\",\"location\":{\"lat\":51.5450825,\"lng\":-0.0546326999999565},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-14/0164c968-c9f6-4e55-8329-e0a12ce43b69.jpg?rect=341%2C0%2C1367%2C1367\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"moth-club-43ox\",\"accessibility\":{\"url\":\"https://mothclub.co.uk/Access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"announcement_date_unix\":1764931800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ra706b3a186f?dice_id=Ra706b3a186f\",\"post_competition_referral\":\"https://link.dice.fm/Se691beda958?dice_id=Se691beda958\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V5decd940bf9?dice_id=V5decd940bf9\",\"post_purchase_referral\":\"https://link.dice.fm/S7baf0c974ed?dice_id=S7baf0c974ed\",\"post_reminder_referral\":\"https://link.dice.fm/W7554ca1bc9a?dice_id=W7554ca1bc9a\",\"post_waitinglist_referral\":\"https://link.dice.fm/d9bd90b149e2?dice_id=d9bd90b149e2\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yong3x-shortcuts-short-film-showcase-1st-mar-moth-club-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"MOTH Club\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"2195325970769692\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772393400,\"has_multiple_ticket_types\":true,\"impression_id\":\"2a9532c5f9eec3df:11\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-04/99a00ce5-bbce-4ebd-99f9-f2c5b38bd120.jpg?rect=375%2C0%2C2550%2C2550\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-04/99a00ce5-bbce-4ebd-99f9-f2c5b38bd120.jpg?rect=0%2C285%2C3300%2C1980\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-04/99a00ce5-bbce-4ebd-99f9-f2c5b38bd120.jpg?rect=949%2C0%2C1403%2C2550\"},\"id\":\"6932b8b313249f00018e86e4\",\"name\":\"SHORTCUTS (SHORT FILM SHOWCASE)\",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"Deeper Into Movies returns with another edition of SHORTCUTS—our annual celebration of bold, unforgettable short films.\\n\\nSpotlighting a new wave of emerging filmmakers, this eclectic program brings together work that is experimental, disturbing, hilarious, moving—and sometimes completely beyond classification. From boundary-pushing visions to intimate personal storytelling, SHORTCUTS is a space for discovery and cinematic surprise.\\n\\nCome through for a night of screenings, new voices, and strange beauty on the big screen\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T10:50:00+00:00\",\"sale_end_date\":\"2026-03-01T19:30:00+00:00\",\"sale_start_date\":\"2025-12-05T10:50:00+00:00\",\"event_start_date\":\"2026-03-01T19:30:00+00:00\",\"event_end_date\":\"2026-03-01T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sun 01 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship and Broadside Hacks.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[{\"id\":71727,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-03T16:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/U54a41cf7982?dice_id=U54a41cf7982\",\"post_competition_referral\":\"https://link.dice.fm/qcd923eaac42?dice_id=qcd923eaac42\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/A3dce82ad982?dice_id=A3dce82ad982\",\"post_purchase_referral\":\"https://link.dice.fm/pf9ebf5b4ffd?dice_id=pf9ebf5b4ffd\",\"post_reminder_referral\":\"https://link.dice.fm/H6059c073743?dice_id=H6059c073743\",\"post_waitinglist_referral\":\"https://link.dice.fm/ybffc40e6f8f?dice_id=ybffc40e6f8f\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"wwrdgr-man-with-a-movie-camera-ft-live-original-score-3rd-mar-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772564400,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:12\",\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/67dbfa9f-4da7-4043-b2a9-066371363800.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/67dbfa9f-4da7-4043-b2a9-066371363800.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/67dbfa9f-4da7-4043-b2a9-066371363800.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"697ce8acaaeef30001aca86b\",\"name\":\"'Man With A Movie Camera' ft. live original score\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Theatreship and Broadside Hacks Presents...\\n\\nScreening of Soviet experimental silent documentary film, Man With A Movie Camera, accompanied by live music from Joe Harvey-Whyte and Owen Spafford, aboard Theatreship; a performing arts space on a historic ship in the old docks of Canary Wharf. (Supported by BFI FAN)\\n\\nPart documentary and part cinematic art, this film follows a city in the 1920s Soviet Union throughout the day, from morning to night. Directed by Dziga Vertov, with a variety of complex and innovative camera shots, the film depicts scenes of ordinary daily life in Russia.\\n\\nJoe Harvey-Whyte is a multidisciplinary artist working at the cross section between ambient/experimental music, visual art and environmental sound. His solo work combines the sound of the pedal steel guitar with electronics and field recordings.\\n\\nOwen Spafford is a fiddle player and composer whose creative life orbits the worlds of traditional, experimental and improvised music. Spafford's understanding of the oral tradition and love for vernacular music from around the world enables an inventive and thoughtful musical voice.\\n\\n**This event is part of Silent Film with New Sound season at Theatreship.**\\n\\n**Programme supported by Film Hub London, managed by Film London. Proud to be a partner of the BFI Film Audience Network, funded by the National Lottery.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 12+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-03-03T22:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:00:00+00:00\",\"event_end_date\":\"2026-03-03T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Joe Harvey-Whyte - Sagebrush Fire\",\"redirect_url\":\"https://open.spotify.com/track/3PaiJyyDPIwHXfItiKkukV\",\"artist\":\"Joe Harvey-Whyte\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6b626fc24de16946de584a500b8534d293912734?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sagebrush Fire\"},{\"type\":\"apple_music\",\"title\":\"Joe Harvey-Whyte & Bobby Lee - Sagebrush Fire\",\"redirect_url\":\"https://music.apple.com/us/album/sagebrush-fire/1805177229?i=1805177539&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Joe Harvey-Whyte & Bobby Lee\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/bb/74/29/bb742992-ab51-173f-d2b8-97561002d49f/mzaf_10437627257706207697.plus.aac.p.m4a\",\"track_name\":\"Sagebrush Fire\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Tue 03 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Deeper Into Movies.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T14:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"announcement_date_unix\":1766846700,\"social_links\":{\"event_share\":\"https://link.dice.fm/R7d818e08f32?dice_id=R7d818e08f32\",\"post_competition_referral\":\"https://link.dice.fm/n8c5958fc9a2?dice_id=n8c5958fc9a2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p6027aa2af75?dice_id=p6027aa2af75\",\"post_purchase_referral\":\"https://link.dice.fm/w4a563849717?dice_id=w4a563849717\",\"post_reminder_referral\":\"https://link.dice.fm/b1f5c62c5acc?dice_id=b1f5c62c5acc\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y898e7f329db?dice_id=Y898e7f329db\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bb3bmg-industrial-symphony-no-1-david-lynch-angelo-badalamenti-julee-cruise-7th-mar-the-haggerston-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772892000,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:13\",\"price\":{\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=0%2C60%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=570%2C0%2C660%2C1200\"},\"id\":\"694ff0a53b83730001fe9809\",\"name\":\"INDUSTRIAL SYMPHONY NO. 1 David Lynch Angelo Badalamenti, Julee Cruise\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"TO CELEBRATE / MOURN DAVID LYNCH PASSING\\n\\nA rare screening of the Lynch directed avant-garde musical play called 'Industrial Symphony No. 1: The Dream of the Broken Hearted' with music by Angelo Badalamenti and Julee Cruise.\\n\\nThe film tells the story of a heartbroken woman (played by Laura Dern) who floats over an industrial wasteland and sings ballads of love after her boyfriend (Nicolas Cage) leaves her. Made before the unprecedented success of his cult-classic TV show Twin Peaks, it is the footage from an original play which was presented at the Brooklyn Academy of Music in 1989. The experimental work is named after a series of complex mosaics in geometric shapes designed by Lynch. He made them while he was studying at the Pennsylvania Academy of Fine Arts and called them Industrial Symphonies.\\n\\nOften seen as a spiritual companion to his 1990 film Wild at Heart because it also co-stars Dern and Cage, Industrial Symphonies No. 1 is a hallucinatory dream that explores the concepts of love and pain in the modern dystopia. Julee Cruise plays “the dreamself” of the heartbroken woman who sings beautifully, even singing from the inside of a trunk of a car at one point. Many of the songs from the musical were recycled in Twin Peaks, including two of Julee’s recordings “Rockin’ Back Inside My Heart” and “The World Spins”.\\n\\n“She’s \\\\[Cruise\\\\] got a great voice and when she sings soft and pure, it’s just what the doctor ordered,” Lynch said. “You know, the music is going along and it’s making pictures form in your mind. Build those pictures, put them up and play the music with it. If it gave you a feeling inside your head, it might do the same to others. To make a distant interpretation or intellectually try to understand them, it’s sort of not what it’s about.”\\n\\nTICKET SALES GO TO THE DAVID LYNCH FOUNDATION\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-27T14:45:00+00:00\",\"sale_end_date\":\"2026-03-07T13:30:00+00:00\",\"sale_start_date\":\"2025-12-27T14:45:00+00:00\",\"event_start_date\":\"2026-03-07T14:00:00+00:00\",\"event_end_date\":\"2026-03-07T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Film Screening\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-09-15/0b8ef9ab-63ad-41fd-bec4-98e25f9bca16.jpg?rect=67%2C0%2C798%2C798\"},\"artist_id\":\"11393\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Deeper Into Movies.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[\"selling_fast\"],\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T16:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"announcement_date_unix\":1766846700,\"social_links\":{\"event_share\":\"https://link.dice.fm/W9660db322b0?dice_id=W9660db322b0\",\"post_competition_referral\":\"https://link.dice.fm/o0722ba0cdce?dice_id=o0722ba0cdce\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c9cdd83ef9f6?dice_id=c9cdd83ef9f6\",\"post_purchase_referral\":\"https://link.dice.fm/k500021aac72?dice_id=k500021aac72\",\"post_reminder_referral\":\"https://link.dice.fm/Tc180881671a?dice_id=Tc180881671a\",\"post_waitinglist_referral\":\"https://link.dice.fm/e4d555ae537f?dice_id=e4d555ae537f\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"92wvxn-industrial-symphony-no-1-david-lynch-angelo-badalamenti-julee-cruise-7th-mar-the-haggerston-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772899200,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:14\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=0%2C60%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-01-19/b06db8a7-39c0-4b77-8153-57c575a4c709.jpg?rect=570%2C0%2C660%2C1200\"},\"id\":\"697cf5451ac30400018d2c4d\",\"name\":\"INDUSTRIAL SYMPHONY NO. 1 David Lynch Angelo Badalamenti, Julee Cruise\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"TO CELEBRATE / MOURN DAVID LYNCH PASSING\\n\\nA rare screening of the Lynch directed avant-garde musical play called 'Industrial Symphony No. 1: The Dream of the Broken Hearted' with music by Angelo Badalamenti and Julee Cruise.\\n\\nThe film tells the story of a heartbroken woman (played by Laura Dern) who floats over an industrial wasteland and sings ballads of love after her boyfriend (Nicolas Cage) leaves her. Made before the unprecedented success of his cult-classic TV show Twin Peaks, it is the footage from an original play which was presented at the Brooklyn Academy of Music in 1989. The experimental work is named after a series of complex mosaics in geometric shapes designed by Lynch. He made them while he was studying at the Pennsylvania Academy of Fine Arts and called them Industrial Symphonies.\\n\\nOften seen as a spiritual companion to his 1990 film Wild at Heart because it also co-stars Dern and Cage, Industrial Symphonies No. 1 is a hallucinatory dream that explores the concepts of love and pain in the modern dystopia. Julee Cruise plays “the dreamself” of the heartbroken woman who sings beautifully, even singing from the inside of a trunk of a car at one point. Many of the songs from the musical were recycled in Twin Peaks, including two of Julee’s recordings “Rockin’ Back Inside My Heart” and “The World Spins”.\\n\\n“She’s \\\\[Cruise\\\\] got a great voice and when she sings soft and pure, it’s just what the doctor ordered,” Lynch said. “You know, the music is going along and it’s making pictures form in your mind. Build those pictures, put them up and play the music with it. If it gave you a feeling inside your head, it might do the same to others. To make a distant interpretation or intellectually try to understand them, it’s sort of not what it’s about.”\\n\\nTICKET SALES GO TO THE DAVID LYNCH FOUNDATION\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-27T14:45:00+00:00\",\"sale_end_date\":\"2026-03-07T16:00:00+00:00\",\"sale_start_date\":\"2025-12-27T14:45:00+00:00\",\"event_start_date\":\"2026-03-07T16:00:00+00:00\",\"event_end_date\":\"2026-03-07T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 07 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Big Penny Social\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[],\"max_tickets\":12,\"properties\":[],\"venues\":[{\"id\":\"7425\",\"name\":\"Big Penny Social\",\"address\":\"1 Priestley Way, London E17 6AL, UK\",\"location\":{\"lat\":51.59085509999999,\"lng\":-0.04131809999999999},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-09-15/018322b6-65c3-40f9-851e-9d09dfa35252.jpg?rect=0%2C0%2C1000%2C1000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"big-penny-social-ayxd\",\"ac