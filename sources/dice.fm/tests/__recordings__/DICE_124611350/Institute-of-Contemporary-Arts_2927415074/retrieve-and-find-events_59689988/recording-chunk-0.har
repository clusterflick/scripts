hlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-08T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/bc939dec-2bd2-4c13-a15d-f900413d42fe.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/bc939dec-2bd2-4c13-a15d-f900413d42fe.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/bc939dec-2bd2-4c13-a15d-f900413d42fe.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/S3f665cf4f57?dice_id=S3f665cf4f57\",\"post_competition_referral\":\"https://link.dice.fm/s85223b1ee7b?dice_id=s85223b1ee7b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V2d9fe3e1420?dice_id=V2d9fe3e1420\",\"post_purchase_referral\":\"https://link.dice.fm/w3a7255891ee?dice_id=w3a7255891ee\",\"post_reminder_referral\":\"https://link.dice.fm/Z7dfd424a6af?dice_id=Z7dfd424a6af\",\"post_waitinglist_referral\":\"https://link.dice.fm/ma9e7cca0c7b?dice_id=ma9e7cca0c7b\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:7\",\"properties\":[],\"presented_by\":\"Presented by Black Frog\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764547200,\"id\":\"692d96238bd4dc0001176aa0\",\"name\":\"Debbie Bond Trio\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"DEBBIE BOND has been paying her dues in the Alabama backwoods for over 30 years. Long immersion in real-deal juke joint blues and the sweet sounds of Alabama’s Muscle Shoals soul have deeply flavored her music and original song writing. Living in the deep South, her impressive musical history includes years of performing with older traditional Alabama blues musicians, including Johnny Shines, Sam Lay, Eddie Kirkland, Willie King, Little Jimmy Reed, Shar Baby and more.\\n\\nDebbie’s collaboration with her British-born keyboard/harmonica player husband, “Radiator” Rick, has added a swampy New Orleans edge to her sound. Their recordings have received critical acclaim in the US and Europe where they tour regularly, appearing at festivals, blues joints and listening rooms.\\n\\nDebbie Bond is a longtime blues activist. She founded the award winning Alabama Blues Project, a non-profit organization dedicated to promoting and preserving the state’s blues heritage. She is the recipient of numerous awards including a KBA for blues education, has been inducted into the Blues Hall of Fame as great blues artist and is an Alabama Music Hall of Fame “Music Achiever”.\\n\\nA mouthpiece for sultry, Southern charm and whimsical musical conversation, Debbie Bond gets her heart tangled up in an intimate mess of backwoods Alabama soul. Living Blues Magazine (US)\\n\\n. . . she is one of those too rare female blues players, she clearly deserves greater recognition by blues lovers every where. Blues Matters (UK)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1775671200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1965,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-22T12:30:00+01:00\",\"sale_end_date\":\"2026-04-08T19:00:00+01:00\",\"sale_start_date\":\"2025-10-22T12:30:00+01:00\",\"event_start_date\":\"2026-04-08T19:00:00+01:00\",\"event_end_date\":\"2026-04-08T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,