,\"social_links\":{\"event_share\":\"https://link.dice.fm/O0a945a8433a?dice_id=O0a945a8433a\",\"post_competition_referral\":\"https://link.dice.fm/z734307028d8?dice_id=z734307028d8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m0d04a01f62a?dice_id=m0d04a01f62a\",\"post_purchase_referral\":\"https://link.dice.fm/Qfbf612a4235?dice_id=Qfbf612a4235\",\"post_reminder_referral\":\"https://link.dice.fm/sdcdba0dcd35?dice_id=sdcdba0dcd35\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y1bc050f9e03?dice_id=Y1bc050f9e03\"},\"perm_name\":\"k6ngao-dead-to-me-brendan-kelly-2nd-apr-new-cross-inn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-11/84043fcc-97e9-478f-a131-887ca3397da8.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-11/84043fcc-97e9-478f-a131-887ca3397da8.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-11/84043fcc-97e9-478f-a131-887ca3397da8.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Dead To Me\\n\\nSan Francisco, 2018 – One thing that always seems positive in politically turbulent times is that great art and music is born from it. Like the Clash before them, Dead to Me are a band that find themselves at the intersection of these powerful human agencies. As one of Dead to Me’s biggest influences, The Clash found themselves a constant through the original “Make America Great Again” populism of the late seventies and eighties. Today, after being a staple of Northern California for over a decade, Dead to Me has found itself back in a rebirth of this same nationalist message. It seems as if everything has come full circle.\\n\\nhttps://www.instagram.com/dead_to_me/\\n\\n\\\\+ very special guest\\n\\nBrendan Kelly\\n\\nBrendan Kelly has been voted “Best Twitter” by Chicago Reader, was a TV Host, is the guy behind Nihilist Arby’s, sings in The Lawrence Arms, works at The Onion, makes weird art… the list goes on. Now after a couple years crafting deviant songs he has something new for his cult to consume: a 10-song album called Keep Walkin’ Pal. He releases his “solo” material under the name Brendan Kelly and the Wandering Birds, but this is not some emo boy with a guitar or another “punk goes acoustic” outing, this is an artist collective like Wu-Tang Clan or Crass. It involves musicians, visual artists, studio nerds, and even a college film professor.\\n\\nhttps://www.instagram.com/dr_beexo/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"693aa1a89a95280001519d8c\",\"name\":\"Dead To Me + Brendan Kelly\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Kiss The Bottle\",\"redirect_url\":\"https://open.spotify.com/track/0HS6afE4lGwmEnhEQFcex8\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e37783d687cac2468e249574e552b9fd8db4e93a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Kiss The Bottle\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Brendan Kelly\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2734c2ef73f6f9ce36f52e61fec\"},\"artist_id\":\"10732\",\"about\":null,\"is_headliner\":false},{\"name\":\"Dead to Me\",\"image\":null,\"artist_id\":\"131309\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T10:00:00+01:00\",\"sale_end_date\":\"2026-04-02T20:00:00+01:00\",\"sale_start_date\":\"2025-10-24T10:00:00+01:00\",\"event_start_date\":\"2026-04-02T18:00:00+01:00\",\"event_end_date\":\"2026-04-02T22:00:00+01:00\",\"is_multi_days_event\":fal