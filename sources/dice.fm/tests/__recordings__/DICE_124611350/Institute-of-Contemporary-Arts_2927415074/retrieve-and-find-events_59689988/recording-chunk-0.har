",\"track_name\":\"Greenteeth\"},{\"type\":\"apple_music\",\"title\":\"Fuzzy Lights - Greenteeth\",\"redirect_url\":\"https://music.apple.com/us/album/greenteeth/1837156396?i=1837156401&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Fuzzy Lights\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/b4/7a/21/b47a2189-36fc-c9cb-e81b-070598cbd192/mzaf_12143018462651996718.plus.aac.p.m4a\",\"track_name\":\"Greenteeth\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fuzzy Lights\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb96c99fe683527c2672cbed44\"},\"artist_id\":\"30149\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"16089\",\"name\":\"The Bear Club\",\"address\":\"Mill Yard, 24A Guildford St, LU1 2NR, Luton, Luton, England, United Kingdom\",\"location\":{\"lat\":51.880929,\"lng\":-0.413522},\"image\":null,\"city\":{\"id\":\"61e9810a0ee924eb5436541c\",\"name\":\"Luton\",\"location\":{\"lat\":51.879768,\"lng\":-0.415161,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-bear-club-xeqgl\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-09T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/75185025-ed4e-498f-b500-c6fb8df655a8.jpg?rect=0%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/75185025-ed4e-498f-b500-c6fb8df655a8.jpg?rect=0%2C800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/75185025-ed4e-498f-b500-c6fb8df655a8.jpg?rect=900%2C0%2C2200%2C4000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/p08216fe5732?dice_id=p08216fe5732\",\"post_competition_referral\":\"https://link.dice.fm/h38295f6db5d?dice_id=h38295f6db5d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bb9a4102bba8?dice_id=bb9a4102bba8\",\"post_purchase_referral\":\"https://link.dice.fm/f46a5cf8397a?dice_id=f46a5cf8397a\",\"post_reminder_referral\":\"https://link.dice.fm/s1c6aab85cdc?dice_id=s1c6aab85cdc\",\"post_waitinglist_referral\":\"https://link.dice.fm/F5d736395026?dice_id=F5d736395026\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:23\",\"properties\":[],\"presented_by\":\"Presented by The Bear Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769029200,\"id\":\"6971efca3dd7fe000118285e\",\"name\":\"Fuzzy Lights\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Cambridge's acclaimed psych-folk quintet Fuzzy Lights play The Bear Club for the first time having recently put out their fifth album 'Fen Creatures' to huge acclaim.\\n\\nThe band have created their most conceptually ambitious work to date - a meditation on environmental crisis that uses the folklore and history of East Anglia as a lens to examine humanity's fractured relationship with the natural world. Their sound is an awesome amalgamation of folk and death metal based heavily around the use of drone guitar and distorted violins.Fen Creatures' expands this vision into something far more sweeping and interconnected. The album operates across multiple historical timelines, from Iron Age hill forts to medieval plague houses, from Byron's Romantic-era environmental warnings to the immediate threat of rising sea levels, creating a temporal tapestry that weaves ancient stories with contemporary concerns. The album calls attention to environmental change while exploring how folklore ties to the landscape and our connection to our ancestors.\\n\\nMusically, the quintet, Rachel Watkins (vocals/violin), Xavier Watkins (guitar/electronics), Chris Rogers (guitar), Daniel Carney (bass), and Mark Blay (drums), have pushed deeper into experimental drone territories while maintaining the crystalline folk sensibilities that have become their signature. The result is their most atmospheric and immersive work to date, with vast sonic landscapes that mirror the fenland geography they're documenting.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"134966\",\"name\":\"The Bear Club\",\"image\":{\"url\":null},\"perm_name\":\"the-bear-club-9l7y6\",\"profile_active\":false},\"date_unix\":1775757600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-04-09T19:00:00+01:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-04-09T19:00:00+01:00\",\"event_end_date\":\"2026-04-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5kr6a-steve-young-9th-apr-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Steve Young & The Real Time Players - Good Times\",\"redirect_url\":\"https://music.apple.com/us/album/good-times/1853422944?i=1853422948&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Steve Young & The Real Time Players\",\"preview_url\":\"https://audio-ssl.itunes.apple