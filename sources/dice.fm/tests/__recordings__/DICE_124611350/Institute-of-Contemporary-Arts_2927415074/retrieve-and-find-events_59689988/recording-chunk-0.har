_referral\":\"https://link.dice.fm/hc184759a111?dice_id=hc184759a111\",\"post_waitinglist_referral\":\"https://link.dice.fm/E560d2fc622c?dice_id=E560d2fc622c\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:20\",\"properties\":[],\"presented_by\":\"Presented by VIVA\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769558400,\"id\":\"697a0e25e22b7b0001474e2a\",\"name\":\"VIVA Baile\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"VIVA, The Weekend Party You Can't Miss! 🔥\\n\\nHey party people! Get ready for the ULTIMATE Saturday night vibes EVERY WEEK from 11PM - 5AM at Lightbox London, Vauxhall!\\n\\nLet's be real - weekends are precious, and we're here to make yours EPIC! VIVA is where memories are made, friendships are formed, and dance floors are destroyed (in the best way possible).\\n\\nThe Music? ABSOLUTELY MASSIVE!\\n\\nRoom 1: Baile Funk Explosion 🇧🇷\\n\\nBrazilian beats that bring the heat! For when regular dancing just isn't enough.\\n\\nRoom 2: Reggaeton Paradise 🇵🇷\\n\\nAll the reggaeton bangers that make your hips do the talking! Trust us, you won't stop moving.\\n\\nRoom 3: Pop & R&B Heaven ✨\\n\\nSinging along to your fave chart-toppers and throwbacks? Yes please! This is where anthems live.\\n\\nNeed-to-Know Stuff ⚠️\\n\\nWhen: 11PM - 5AM (last entry 3AM)\\n\\nWho: 18+ with ID (no ID = no fun, sorry!)\\n\\nWear: Look good, feel good! No sportswear/caps/hoodies\\n\\nFree Entry: Limited tickets online - but only before 11:30PM!\\n\\nGet the FREE VIVA MEMBERSHIP! 🎟️\\n\\nWant to level up your VIVA experience? Our completely FREE membership includes:\\n\\nQueue Jump + Priority Entry (bye-bye waiting!)\\n\\nDiscounted Online tickets\\n\\nDiscounted VIVA members door price\\n\\nFree Entry to selected events\\n\\nFree entry for you + 4 friends on your BIRTHDAY!\\n\\nIt takes 2 minutes to join at: https://pub1.pskt.io/t/fetevm (Works with Apple Pay, Google Pay or Samsung Pay Wallets)\\n\\nSee you on the dance floor! 💃🕺\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"185\",\"name\":\"HVYWGHT LDN\",\"image\":{\"url\":null},\"perm_name\":\"hvywght-ldn-4rxq\",\"profile_active\":false},\"date_unix\":1772319600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-28T22:00:00+00:00\",\"sale_start_date\":\"2026-01-28T00:00:00+00:00\",\"event_start_date\":\"2026-02-28T23:00:00+00:00\",\"event_end_date\":\"2026-03-01T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6dno2q-viva-reggaeton-vs-afrobeats-28th-feb-lightbox-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"389\",\"name\":\"Lightbox\",\"address\":\"6A S Lambeth Pl, London SW8 1SP\",\"location\":{\"lat\":51.485903,\"lng\":-0.123745999999983},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"lightbox-jx6m\",\"accessibility\":{\"url\":\"https://www.lightboxlondon.net/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T23:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/9441aeee-1c7f-4830-87e0-0fa200d8dba2.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/9441aeee-1c7f-4830-87e0-0fa200d8dba2.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/9441aeee-1c7f-4830-87e0-0fa200d8dba2.jpg?rect=180%2C0%2C440%2C800\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/K94c8600e41d?dice_id=K94c8600e41d\",\"post_competition_referral\":\"https://link.dice.fm/Me2f4994b643?dice_id=Me2f4994b643\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Gf09a7b1aa8d?dice_id=Gf09a7b1aa8d\",\"post_purchase_referral\":\"https://link.dice.fm/T35e40275407?dice_id=T35e40275407\",\"post_reminder_referral\":\"https://link.dice.fm/d0eb85c12c46?dice_id=d0eb85c12c46\",\"post_waitinglist_referral\":\"https://link.dice.fm/ecebeab223eb?dice_id=ecebeab223eb\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:21\",\"properties\":[],\"presented_by\":\"Presented by VIVA\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769558400,\"id\":\"697a0dc8f5418700018f396a\",\"name\":\"VIVA Reggaeton vs Afrobeats\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"VIVA, The Weekend Party You Can't Miss! 🔥\\n\\n  \\n🔥 Reggaeton vs Afrobeats - two global sounds coming together on one dancefloor. From Latin heat to African rhythm, expect feel-good energy, big tunes, and non-stop movement all night.\\n\\nHey party people! Get ready for the ULTIMATE Saturday night vibes EVERY WEEK from 11PM - 5AM at Lightbox London, Vauxhall!\\n\\n🔥 Main Room: Reggaeton vs Afrobeats Showdown! 🔥 Get ready for an electrifying Reggaeton vs Afrobeats battle! Our resident DJs will be going back-to-back, dropping all the hottest bangers from Latin America and Africa. Expect incredible energy and our dancers bringing the full vibe. Trust us, you won't stop moving - this is your first lesson in tearing up the dance floor!\\n\\n✨ Room 2: Pop & R&B Heaven ✨ Sing your heart out to all your favourite chart-toppers and classic R&B hits. This room is pure feel-good energy!\\n\\n🇧🇷 Room 3: Baile Funk Explosion 🇧🇷 Experience the vibrant, high-energy sounds of Brazilian Baile Funk. It's an electrifying beat that's perfect for a summer night.\\n\\nsential Info 🚨\\n\\nTime: 11PM - 5AM (last entry at 3AM)\\n\\nAge: 18+ with valid ID (no ID, no entry – sorry!)\\n\\nDress Code: Smart casual, ready to party! No sportswear, caps, or hoodies.\\n\\nFree Entry: Limited free tickets available online until 11:30PM! If you arrive after 11:30PM, a concession price will be charged on the door.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"185\",\"name\":\"HVYWGHT LDN\",\"image\":{\"url\":null},\"perm_name\":\"hvywght-ldn-4rxq\",\"profile_active\":false},\"date_unix\":1772319600,\"event_tag\":null}],\"title\":\"Sat 28 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:15:00+00:00\",\"sale_end_date\":\"2026-03-01T13:00:00+00:00\",\"sale_start_date\":\"2026-01-21T12:15:00+00:00\",\"event_start_date\":\"2026-03-01T13:00:00