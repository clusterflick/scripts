"url\":\"https://dice-media.imgix.net/attachments/2024-08-08/0355d05e-cfba-42b3-bc9a-9ee2a427e49f.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"8849\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-04-11T19:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-09/c8269712-5d7c-4dc2-abc7-3821a5a55c89.jpg?rect=360%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-09/c8269712-5d7c-4dc2-abc7-3821a5a55c89.jpg?rect=0%2C216%2C2880%2C1728\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-09/c8269712-5d7c-4dc2-abc7-3821a5a55c89.jpg?rect=846%2C0%2C1188%2C2160\"},\"status\":\"sold-out\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/If01abeebec0?dice_id=If01abeebec0\",\"post_competition_referral\":\"https://link.dice.fm/Oc713b2e9740?dice_id=Oc713b2e9740\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/y80ecd1b0e6c?dice_id=y80ecd1b0e6c\",\"post_purchase_referral\":\"https://link.dice.fm/P81b9faefacd?dice_id=P81b9faefacd\",\"post_reminder_referral\":\"https://link.dice.fm/Fef81f7f3946?dice_id=Fef81f7f3946\",\"post_waitinglist_referral\":\"https://link.dice.fm/I572fc5c7003?dice_id=I572fc5c7003\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:92\",\"properties\":[],\"presented_by\":\"Presented by FORM. \",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760450400,\"id\":\"68e7ce32dbe1650001beee83\",\"name\":\"Julianna Barwick & Mary Lattimor\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nJulianna Barwick and Mary Lattimore, two of contemporary music’s most celebrated composers, come together for a unique show and album collaboration, TRAGIC MAGIC, in partnership with the Philharmonie de Paris. With extraordinary access to the Musée de la Musique’s instrument collection, the album, due January 2026 via French label InFiné, features seven immersive, evocative compositions guided by the human spirit – intimate, grounded in friendship, both earthly and cosmic – and part of a greater continuum, reflecting the solace and transformative power of artistry across generations.\\n\\nCo-produced by Trevor Spencer (Fleet Foxes, Beach House), TRAGIC MAGIC was created in just nine days, a testament to the “musical telepathy” that has developed between Barwick and Lattimore over years of touring and friendship. Arriving in Paris from Los Angeles shortly after the 2025 wildfires, their sessions combined improvisation with the emotions and experiences they carried, in a setting both inspiring and deeply supportive. Lattimore selected harps tracing the instrument’s evolution from 1728 to 1873, while Barwick chose several iconic analog synthesizers, including the Roland JUPITER and Sequential Circuits PROPHET-5. In freeform dialogue between voice and instrument, they create a meditation on tragedy, wonder, and the restorative power of shared experience.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"date_unix\":1775932200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":600},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T13:00:00+00:00\",\"sale_end_date\":\"2026-04-12T01:30:00+01:00\",\"sale_start_date\":\"2026-01-30T13:00:00+00:00\",\"event_start_date\":\"2026-04-11T20:00:00+01:00\",\"event_end_date\":\"2026-04-12T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"py5