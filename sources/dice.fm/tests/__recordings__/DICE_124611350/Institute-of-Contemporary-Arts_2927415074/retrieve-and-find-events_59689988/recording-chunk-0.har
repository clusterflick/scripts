\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-19T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":64099,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-12/e6064843-6887-4eee-a4c6-7995aace7701.jpg?rect=0%2C0%2C964%2C964\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-12/e6064843-6887-4eee-a4c6-7995aace7701.jpg?rect=0%2C193%2C964%2C578\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-12/e6064843-6887-4eee-a4c6-7995aace7701.jpg?rect=217%2C0%2C530%2C964\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1765499400,\"max_tickets\":6,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**We’re celebrating the timeless sound of Otis Redding, as two of the UK’s most exciting soul acts join forces to honour the King of Soul.**\\n\\nThis uplifting show couldn’t come at a better time, as London’s original soul man Reuben Richards — widely known for his Otis Redding-inspired vocals — teams up with the Hammond organ and horn section of The Jezebel Sextet.\\n\\nThis eight-piece band, known for their incredible raw sound and energy, will perform Otis classics including Respect, My Girl, Mr. Pitiful, Hard to Handle, Love Man, and Try a Little Tenderness.\\n\\n*This event is not in association with Otis Redding.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:69\",\"social_links\":{\"event_share\":\"https://link.dice.fm/d1b595feaae4?dice_id=d1b595feaae4\",\"post_competition_referral\":\"https://link.dice.fm/Y268b88a898f?dice_id=Y268b88a898f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ee5300e1ced7?dice_id=Ee5300e1ced7\",\"post_purchase_referral\":\"https://link.dice.fm/n6dd3a533780?dice_id=n6dd3a533780\",\"post_reminder_referral\":\"https://link.dice.fm/Ba449a233413?dice_id=Ba449a233413\",\"post_waitinglist_referral\":\"https://link.dice.fm/Wd9bf70ad1b1?dice_id=Wd9bf70ad1b1\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:30:00+00:00\",\"sale_end_date\":\"2026-09-19T19:00:00+01:00\",\"sale_start_date\":\"2025-12-12T01:00:00+00:00\",\"event_start_date\":\"2026-09-19T19:00:00+01:00\",\"event_end_date\":\"2026-09-19T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2350,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"693c279062be900001fc5a29\",\"seats_io_event_id\":null,\"name\":\"The Music of Otis Redding\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"ww5d7r-the-music-of-otis-re