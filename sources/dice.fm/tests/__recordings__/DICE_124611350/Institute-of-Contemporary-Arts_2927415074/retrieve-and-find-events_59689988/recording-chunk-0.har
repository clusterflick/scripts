722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-18T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Emily Portman\",\"image\":null,\"artist_id\":\"83381\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"about\":{\"description\":\"**Hackney Folk Club**  \\nChats Palace  \\nThursday 18th June 2026  \\n7pm - 11pm, £15/£13/£12 members\\n\\n**Emily Portman** is an award-winning singer and songwriter with a passion for traditional songs, hailed as ‘one of the new British folk scene’s most beguiling presences’ (Uncut). She has toured widely for over 15 years as a band leader, with The Furrow Collective, in a duo with Leveret’s Rob Harbron and with the UK Folk chart-topping album project ‘Sea Song Sessions’, featuring Jon Boden and Seth Lakeman. Emily was previously awarded a BBC Folk award for ‘Best Original Song’ and has released three critically acclaimed albums of original songs that recast old ballads and fairytales into new shapes.\\n\\nNow, with Dominion of Spells, her first solo album in a decade set for release, 2026 promises to be an exciting year for the Glastonbury-raised and Sheffield-based singer.  Central to the album are themes of midlife metamorphosis and magic. Emily, who was raised in Glastonbury, has a lifelong fascination with folk stories and has been writing otherworldly songs since she was a child.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T00:00:00+00:00\",\"sale_end_date\":\"2026-06-18T21:00:00+01:00\",\"sale_start_date\":\"2025-12-17T00:00:00+00:00\",\"event_start_date\":\"2026-06-18T19:00:00+01:00\",\"event_end_date\":\"2026-06-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6942a21c4a5dd60001fe49c7\",\"name\":\"Hackney Folk Club - Emily Portman\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/eab2ca9d-a0be-4058-89d5-3d87894c2ef6.jpg?rect=803%2C0%2C4016%2C4016\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/eab2ca9d-a0be-4058-89d5-3d87894c2ef6.jpg?rect=0%2C322%2C5622%2C3373\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/eab2ca9d-a0be-4058-89d5-3d87894c2ef6.jpg?rect=1707%2C0%2C2209%2C4016\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1765929600,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/M8c0010932a4?dice_id=M8c0010932a4\",\"post_competition_referral\":\"https://link.dice.fm/v9cd860205fe?dice_id=v9cd860205fe\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Gcf52878cfc4?dice_id=Gcf52878cfc4\",\"post_purchase_referral\":\"https://link.dice.fm/A1510eb67370?dice_id=A1510eb67370\",\"post_reminder_referral\":\"https://link.dice.fm/t7f4c5971130?dice_id=t7f4c5971130\",\"post_waitinglist_referral\":\"https://link.dice.fm/N7700497f0bc?dice_id=N7700497f0bc\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Eliza Carthy & Jon Boden - Beautiful Star (feat. Emily Portman & Tim Van Eyken)\",\"redirect_url\":\"https://music.apple.com/us/album/beautiful-star-feat-emily-portman-tim-van-eyken/1719622990?i=1719622994&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Eliza Carthy & Jon Boden\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/14/1e/ca/141eca91-d3fc-7cde-c631-923cac8cbb92/mzaf_13750406467691194099.plus.aac.p.m4a\",\"track_name\":\"Beautiful Star (feat. Emily Portman & Tim Van Eyken)\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3066},\"seats_io_public_key\":null,\"presented_by\":\"Presented by DMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":62936,\"title\":\"Age Limit\",\"body\":\"This is a 16+ event. You may be asked to prove your age and if you’re unable to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, 16+ Zip Oyster photocards and CitizenCards. Photocopies will not be accepted.'\",\"order\":2}],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"dk8376-police-dog-hogan-18th-jun-islington-assembly-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781805600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":8,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:55\",\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-18T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sons of Town Hall\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-09/22e3d4c7-6667-4616-b82a-2218a684bcdf.jpg?rect=0%2C51%2C538%2C538\"},\"artist_id\":\"131197\",\"about\":null,\"is_headliner\":false},{\"name\":\"Police Dog Hogan\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2bd7a5eb58429fa0c7fa8c93\"},\"artist_id\":\"22984\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"Since 2010, Police Dog Hogan have fused country-roots-Americana with a wholly British sensibility. Banjo player Tim Dowling’s Guardian column highlights their comic touring tales, but their music remains emotionally powerful, featuring driving country-rock with guitar, fiddle, banjo, accordion, and trumpet.\\n\\nThe band have spent early 2025 touring to promote their 6th studio album, Lightning Strike, recorded over a single weekend at Middle Farm Studios in Devon. Lightning Strike followed on the heels of 2022’s success with Overground, which spent 4 weeks on the UK Folk album chart.\\n\\nPDH have played dozens of festivals, many of them repeatedly, including Glastonbury, Latitude, Cropredy, Cornbury, Beautiful Days, Kendall Calling and the Sidmouth Folk Festival. The band have played sold out shows at London’s Shepherd’s Bush Empire, Union Chapel, Scala, and Cadogan Hall, and have performed in Nashville, Ireland and France.\\n\\nIn 2018, their song Devon Brigade was nominated for best original song at the AMA-UK Awards. The album it came from, Wild By The Side of the Road, spent several weeks in the Official UK Americana charts.\\n\\nLate 2024 saw Police Dog Hogan release a Christmas single, Pull Away, to celebrate the 200th anniversary of the RNLI. Previously the band released another single, My First Christmas Alone, in winter of 2020 that helped to raise over £50k for Crisis and reached No. 1 in the iTunes country charts.\\n\\nPolice Dog Hogan are: James Studholme (guitar vocals), Eddie Bishop (fiddle, mandolin), Tim Dowling (banjo, steel guitar), Emily Norris (trumpet), Shahen Galichian (accordion, piano), Don Bowen (bass), Alistair Hamer (drums)\\n\\n‘They manage to fuse bluegrass, folk, country and more in a way that few others can match.’\\n\\nRNR MAGAZINE  \\n  \\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-04T12:00:00+00:00\",\"sale_end_date\":\"2026-06-18T21:00:00+01:00\",\"sale_start_date\":\"2025-11-04T12:00:00+00:00\",\"event_start_date\":\"2026-06-18T19:00:00+01:00\",\"event_end_date\":\"2026-06-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6907388b6f852a00015ea30a\",\"name\":\"Police Dog Hogan\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-31/29283d5e-ab3c-4651-82e4-df6ef1e7c2d4.jpg?rect=106%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-31/29283d5e-ab3c-4651-82e4-df6ef1e7c2d4.jpg?rect=0%2C90%2C980%2C588\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-31/29283d5e-ab3c-4651-82e4-df6ef1e7c2d4.jpg?rect=279%2C0%2C422%2C768\"},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2237,\"name\":\"DMP\",\"privacy_policy_link\":\"https://www.dmpuk.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1762257600,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/od2ff8dfb89d?dice_id=od2ff8dfb89d\",\"post_competition_referral\":\"https://link.dice.fm/Rbc2943e1aca?dice_id=Rbc2943e1aca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u4a936ad465d?dice_id=u4a936ad465d\",\"post_purchase_referral\":\"https://link.dice.fm/H65b5f30985e?dice_id=H65b5f30985e\",\"post_reminder_referral\":\"https://link.dice.fm/a9aeb56e47ba?dice_id=a9aeb56e47ba\",\"post_waitinglist_referral\":\"https://link.dice.fm/P93a0fafdfd2?dice_id=P93a0fafdfd2\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Kathleen O'Hare\",\"redirect_url\":\"https://open.spotify.com/track/6x6UQ4lV0Y6F7pTXW5rf2S\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/95fed3e8cc9137e7dc743fe898a557c84989d44f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Kathleen O'Hare\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2348,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"presented_by\":\"Presented by Kings Place.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"seats_io_event_id\":\"ba6c1655-816e-45be-8c6c-c7adaa2d80dd\",\"perm_name\":\"8e8okv-gnoss-18th-jun-kings-place-hall-one-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781807400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:56\",\"venues\":[{\"id\":\"940\",\"name\":\"Kings Place (Hall One)\",\"address\":\"Kings Place, 90 York Way, Kings Cross, London N1 9AG\",\"location\":{\"lat\":51.5349694,\"lng\":-0.121675500000038},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-one-yo6v\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-18T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":4},\"about\":{\"description\":\"***Gnoss’ signature sound is a rich tapestry of acoustic layers; outstanding musicianship, deep traditional roots and contemporary compositional flair combine to create songs and tunes brimming with character.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nTriple Scots Trad Music Awards nominees, **Gnoss** has built an invested following through their forward-thinking take on traditional music and the unique warmth of their live shows. This has been proven through three consecutive sellout appearances at Glasgow’s world-famous Celtic Connections festival.\\n\\nWith the release of their third album, 2023’s *Stretching Skyward*, Gnoss reignite their collaboration with producer and engineer, Scott Wood (Skerryvore), further exploring their acoustic roots whilst incorporating new, electronic elements. Launch dates include performances across the UK and Europe, including standout appearances at the Orkney Folk Festival, Cambridge Folk Festival, Towersey Festival and Denmark’s Tønder Festival.\\n\\n***This event will last approximately 1 hour and 50 minutes, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"ba6c1655-816e-45be-8c6c-c7adaa2d80dd\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"seat_selection\":\"disabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T01:00:00+00:00\",\"sale_end_date\":\"2026-06-18T18:00:00+01:00\",\"sale_start_date\":\"2026-02-02T01:00:00+00:00\",\"event_start_date\":\"2026-06-18T19:30:00+01:00\",\"event_end_date\":\"2026-06-18T21:50:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6980d2c31549580001ae4e20\",\"name\":\"Gnoss\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/6dc85dae-ee38-405e-9276-ffee309279ec.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/6dc85dae-ee38-405e-9276-ffee309279ec.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/6dc85dae-ee38-405e-9276-ffee309279ec.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769994000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/p03888dcb587?dice_id=p03888dcb587\",\"post_competition_referral\":\"https://link.dice.fm/k943c2864e32?dice_i