40%2C640\"},\"artist_id\":\"114264\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1747987200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":5153,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"ea0a855c-d1f3-4b0e-891e-5f5755108980\",\"seats_io_public_key\":\"8653326f-30b8-4a87-9930-ed977273c7b5\",\"seat_selection\":\"disabled\"},\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sat 13 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-23T18:00:00+01:00\",\"sale_end_date\":\"2027-05-07T17:00:00+01:00\",\"sale_start_date\":\"2025-09-23T18:00:00+01:00\",\"event_start_date\":\"2027-05-07T18:00:00+01:00\",\"event_end_date\":\"2027-05-07T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Z79df830e183?dice_id=Z79df830e183\",\"post_competition_referral\":\"https://link.dice.fm/t7009b3e0c8a?dice_id=t7009b3e0c8a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/L05729ae958f?dice_id=L05729ae958f\",\"post_purchase_referral\":\"https://link.dice.fm/Z0c3340b4a53?dice_id=Z0c3340b4a53\",\"post_reminder_referral\":\"https://link.dice.fm/Ebc7b3833764?dice_id=Ebc7b3833764\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ue473cf1bead?dice_id=Ue473cf1bead\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"KrawallBrueder from Germany are back for another show at \\\"The Underworld\\\" in 2027.\\n\\nThose Germans are crazy to play in London again for the 4th time!\\n\\nAfter several shows at the Underworld and in Blackpool at the Rebellion Festivals there is a good crowd from the UK and Germany coming to every show. They play a strong mix of Punk rock, Oi! and some hardrock influence and always get the crowd going\\n\\nHard and aggressive sound with german lyrics and pogo dancing from the very first til the very last song!\\n\\nThe previous show was nearly a sell out, so let's fill the venue this time!\\n\\nCome over to that show and enjoy! Get your tickets now!\\n\\nJoin us for the 💥 AFTER PARTY 💥 from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1809709200,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-05-07T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:77\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"68d28eca1cacee00011d91f5\",\"name\":\"KRAWALLBRÜDER \",\"perm_name\":\"l8nbpx-krawallbrder-7th-may-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-06-22/e0d3c49e-b37b-4f92-a746-f2a1378faee8.jpg?rect=0%2C504%2C3024%2C3024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-06-22/e0d3c49e-b37b-4f92-a746-f2a1378faee8.jpg?rect=0%2C1109%2C3024%2C1814\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-06-22/e0d3c49e-b37b-4f92-a746-f2a1378faee8.jpg?rect=403%2C0%2C2218%2C4032\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"KrawallBrüder\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebcb1534ced42511ff8f0d813e\"},\"artist_id\":\"19161\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1758646800,\"faqs\":[{\"id\":19233,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":19234,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":19235,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Uns're Lieder - Euer Halt\",\"redirect_url\":\"https://open.spotify.com/track/4b2lGUaRjA1YM5OJYUuTtY\",\"artist\":\"Uns're Lieder\",\"preview_url\":\"https://p.scdn.co/mp3-preview/22697c13c4fea71f83a3bed02edc71093959da7e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Euer Halt\"},{\"type\":\"apple_music\",\"title\":\"Krawallbrüder - Uns're Lieder - Euer Halt\",\"redirect_url\":\"https://music.apple.com/gb/album/unsre-lieder-euer-halt/1061035923?i=1061036260&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Krawallbrüder - Uns're Lieder - Euer Halt\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music69/v4/ba/d4/1b/bad41b63-9353-777d-eb5d-28a8c24dbbc5/mzaf_7105843221312684340.plus.aac.p.m4a\",\"track_name\":\"Krawallbrüder - Uns're Lieder - Euer Halt\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 07 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-20T10:00:00+00:00\",\"sale_end_date\":\"2027-11-28T21:00:00+00:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2027-11-28T19:00:00+00:00\",\"event_end_date\":\"2027-11-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/p53b4659d3dc?dice_id=p53b4659d3dc\",\"post_competition_referral\":\"https://link.dice.fm/k93666470ccd?dice_id=k93666470ccd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t8d3349ec005?dice_id=t8d3349ec005\",\"post_purchase_referral\":\"https://link.dice.fm/t92bb11cc49b?dice_id=t92bb11cc49b\",\"post_reminder_referral\":\"https://link.dice.fm/Z3a25f9e8a69?dice_id=Z3a25f9e8a69\",\"post_waitinglist_referral\":\"https://link.dice.fm/E6f11112ef16?dice_id=E6f11112ef16\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Seckou Keita is a renowned Kora virtuoso who stands as a luminary amongst African traditional musicians. Hailing from Southern Senegal, his journey from a gifted child to a globally recognised musician has been nothing short of remarkable.\\n\\n2026 marks Seckou Keita's 30th year making music professionally. This exciting year will showcase Seckou’s immense talent and repertoire, with exclusive shows, guests and new works.\\n\\nSeckou will take us on a journey from past to present. Once again, he bridges musical genres, this time by blending traditional rhythms and modern compositions to create a unique sound, embracing afro-pop, urban and hip-hop. Transitional musical poetry written and delivered by award winning poets and rap artists from the UK and Senegal will be craftily sampled and woven into the music, shaping a one of a kind live experience.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1827428400,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-11-28T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":8,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:78\",\"tty_to_extras\":[],\"secondary_status\":\"rescheduled\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"691df60c96e9410001c3ad61\",\"name\":\"Seckou Keita and The Homeland Band featuring Special Guests: 30th anniversary tour\",\"perm_name\":\"3on9kp-seckou-keita-and-the-homeland-band-featuring-special-guests-30th-anniversary-tour-28th-nov-islington-assembly-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-19/385bc1e5-8b35-49e5-98d0-218b3ef634a6.jpg?rect=0%2C832%2C3264%2C3264\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-19/385bc1e5-8b35-49e5-98d0-218b3ef634a6.jpg?rect=0%2C1485%2C3264%2C1958\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-19/385bc1e5-8b35-49e5-98d0-218b3ef634a6.jpg?rect=277%2C0%2C2710%2C4928\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Seckou Keita\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb002caa81d55bda3998b55fa5\"},\"artist_id\":\"13824\",\"about\":{\"description\":\"South African cellist Abel Selaocoe is redefining the parameters of the cello. He moves seamlessly from collaborations with world musicians and beatboxers to concerto performances and solo classical recitals, combining virtuosic performance with improvisation, singing and body percussion.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1763632800,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3354},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Future Strings in E\",\"redirect_url\":\"https://open.spotify.com/track/25QUiK1zMCLvG6xAr6izut\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a239d6e9ecbc92b5fb2c010bb0bf7cae7077799e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Future Strings in E\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sun 28 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":null}",
