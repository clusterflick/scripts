ed\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Maybe I'm Wrong\",\"redirect_url\":\"https://open.spotify.com/track/7Azu6woSBIL0Gwj3Y79bn5\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/91d894f7be895d3f19f1e6c63f1e8399ec33e240?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Maybe I'm Wrong\"},{\"type\":\"apple_music\",\"title\":\"Deborah de Luca - Anho\",\"redirect_url\":\"https://music.apple.com/gb/album/anho/1440138863?i=1440138864&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Deborah de Luca\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview128/v4/1e/4e/2d/1e4e2d87-6378-2f87-c42b-d0efaeeb510d/mzaf_3252735191762280836.plus.aac.p.m4a\",\"track_name\":\"Anho\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Deborah De Luca\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-07/10fb45d8-c9f6-417e-8dae-9b9af0cb890f.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"14928\",\"about\":{\"description\":\"Regarded as “techno queen of Naples” by none other than Pete Tong, Deborah De Luca has grown from commanding the dancefloors of clubs as a dancer to commanding the decks as an electronic DJ. The founder of Solamente records, her evocative minimal techno tracks have the ability to shift from euphoric in one moment to brooding the next. Live, she’s just as comfortable soundtracking the dancefloors of Printworks and Amnesia as she is blaring warehouse techno from the balcony of the Château de Chambord.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Fri 01 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T16:30:00+00:00\",\"sale_end_date\":\"2026-05-02T12:00:00+01:00\",\"sale_start_date\":\"2026-02-16T16:30:00+00:00\",\"event_start_date\":\"2026-05-02T12:00:00+01:00\",\"event_end_date\":\"2026-05-02T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Ibiza Anthems Brunch\",\"seating\":null,\"announcement_date_unix\":1771259400,\"venues\":[{\"id\":\"15014\",\"name\":\"The Broadcaster, White CIty\",\"address\":\"89 Wood Lane, Hammersmith and Fulham, London, W12 7FX, United Kingdom\",\"location\":{\"lat\":51.50996,\"lng\":-0.22475},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-broadcaster-white-city-2wow7\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-02T12:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"8340\",\"name\":\"Resonate Media\",\"image\":{\"url\":null},\"perm_name\":\"resonate-media-yn7p\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:24\",\"date_unix\":1777719600,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1978},\"social_links\":{\"event_share\":\"https://link.dice.fm/D9fedc4c3557?dice_id=D9fedc4c3557\",\"post_competition_referral\":\"https://link.dice.fm/Jf7ffec54c54?dice_id=Jf7ffec54c54\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ca12ddc85d02?dice_id=ca12ddc85d02\",\"post_purchase_referral\":\"https://link.dice.fm/w618905054e0?dice_id=w618905054e0\",\"post_reminder_referral\":\"https://link.dice.fm/f170e2a7b54a?dice_id=f170e2a7b54a\",\"post_waitinglist_referral\":\"https://link.dice.fm/E642bb11f0d6?dice_id=E642bb11f0d6\"},\"perm_name\":\"6d2r97-ibiza-anthems-brunch-bank-holiday-rooftop-party-2nd-may-the-broadcaster-white-city-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/85c5d162-1b4b-49b6-94f7-318977192479.jpg?rect=0%2C0%2C2362%2C2362\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/85c5d162-1b4b-49b6-94f7-318977192479.jpg?rect=0%2C473%2C2362%2C1417\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/85c5d162-1b4b-49b6-94f7-318977192479.jpg?rect=532%2C0%2C1299%2C2362\"},\"properties\":[],\"about\":{\"description\":\"We party on Saturday 2nd May for the first summer bank holiday weekend! Ibiza Anthems Brunch bring the daytime summer party vibes to The Broadcaster Rooftop & Club Room in White City, London.\\n\\nRewinding back to the White Isle's golden era, expect a carefree vibe and hear a timeless Ibiza classics soundtrack from some of the Islands most celebrated DJs & performers! Previous guest DJs include: Brandon Block, Alex P, Lisa Loud, Danny Clockwork, Jonathan Ulysses, Judge Jules, Mark Knight, Smokin Jo, Bongo Ben & many more.\\n\\nBrunch tickets include free flowing luxury canapés on the rooftop + event entry.\\n\\nThe arrival time for brunch ticket holders is 12pm, the canapé service will run from 12pm - 2pm only, so you must arrive by then if you wish to eat. There is plenty of seating which you can take on a first come first served basis on the day, seating will be until 2pm only.\\n\\nEntry only ticket holders can arrive from 2:30pm\\n\\nBottomless drinks are not available at this venue.\\n\\nThe Top Floor features a covered rooftop + service bar areas. The Club Room can be found on the middle floor.\\n\\nPlease advise your server on the day if you have any allergens or specific dietary requirements.\\n\\nDates / timings subject to change.\\n\\nFor VIP table booking enquiries please email: info@ibizaanthemsbrunch.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"699319ad5d9927000103298d\",\"name\":\"Ibiza Anthems Brunch Bank Holiday Rooftop Party\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Brandon Block, Continuous DJ Mix\",\"redirect_url\":\"https://open.spotify.com/track/29yLLVlQNhIRHbpJIWC3w2\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7b7b50276c646b1bc4ed6c9faf87a789700bebbb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Brandon Block, Continuous DJ Mix\"},{\"type\":\"apple_music\",\"title\":\"Brandon Block - Brandon Block, Continuous DJ Mix\",\"redirect_url\":\"https://music.apple.com/gb/album/brandon-block-continuous-dj-mix/1121746450?i=1121746485&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Brandon Block\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview20/v4/12/5a/a0/125aa0fc-355f-987a-9566-2354a309f9aa/mzaf_4060887490333577533.plus.aac.p.m4a\",\"track_name\":\"Brandon Block, Continuous DJ Mix\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Brandon Block\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2733724db4fe1262ce55ec3d506\"},\"artist_id\":\"9247\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":10,\"event_tag\":null},{\"