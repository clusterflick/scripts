"name\":\"Ray Keith\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273e9eb84a20f9d45bfb6895099\"},\"artist_id\":\"12776\",\"about\":{\"description\":\"Whether he goes by Dark Soldier, Dr Wootang or Renegade, Ray Keith has undeniably earnt his place as a drum and bass icon since debuting over 40 years ago. Initially crafting rare groove and acid house floorfillers, turbocharged classics ‘Terrorist’ and ‘Chopper’ established the producer, engineer and vocalist as a jungle figurehead. Renowned for his menacing basslines, brutal breakbeats and soulful twists, when he’s not heading up his ’90s-born label Dread Recordings, Keith also occasionally produces Chicago-flavoured house.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72270,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-30T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1769515200,\"social_links\":{\"event_share\":\"https://link.dice.fm/bd196cd1e076?dice_id=bd196cd1e076\",\"post_competition_referral\":\"https://link.dice.fm/Bcc6a7c045eb?dice_id=Bcc6a7c045eb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Gb89407d3578?dice_id=Gb89407d3578\",\"post_purchase_referral\":\"https://link.dice.fm/w03d6d837957?dice_id=w03d6d837957\",\"post_reminder_referral\":\"https://link.dice.fm/i42b2650585a?dice_id=i42b2650585a\",\"post_waitinglist_referral\":\"https://link.dice.fm/wcf28380636e?dice_id=wcf28380636e\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"mxl9gv-ray-keith-ft-the-renegade-live-30th-may-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780164000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:44\",\"price\":{\"currency\":\"GBP\",\"amount\":2900,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/f6c43c65-8251-44b8-a28c-f0f1332d0310.jpg?rect=219%2C548%2C532%2C532\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/f6c43c65-8251-44b8-a28c-f0f1332d0310.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/f6c43c65-8251-44b8-a28c-f0f1332d0310.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6977a934d6ac2c000154bfb2\",\"name\":\"Ray Keith ft. The Renegade (Live)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"A rare opportunity to experience a **foundational figure** perform with the level of dynamism that redefines the live dance music experience.\\n\\nWidely hailed as one of the **godfathers of jungle and DnB**, Ray's influence spans over three decades, from his **ground-breaking remix of Orbital’s ‘Chime’** to seminal releases on his Dread Recordings label.\\n\\nThis full live band performance will see him breathe new life into timeless rave anthems like ‘The Chopper’ and ‘Terrorist’, stripping back the samples to reveal the raw, rhythmic power of his unparalleled career.\\n\\nDrum & bass icon Ray Keith presents **The Renegade**, with live drums, bass and vocals.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T12:00:00+00:00\",\"sale_end_date\":\"2026-05-30T21:30:00+01:00\",\"sale_start_date\":\"2026-01-29T10:00:00+00:00\",\"event_start_date\":\"2026-05-30T19:00:00+01:00\",\"event_end_date\":\"2026-05-30T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Chopper - Shy FX Remix\",\"redirect_url\":\"https://open.spotify.com/track/09kjBQ95206cviB2ov2xqm\",\"artist\":\"Chopper\",\"preview_url\":\"https://p.scdn.co/mp3-preview/63771e45781c863c34b4f453d6e504b477baf07b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Shy FX Remix\"},{\"type\":\"apple_music\",\"title\":\"Ray Keith - Reggae Blues\",\"redirect_url\":\"https://music.apple.com/us/album/reggae-blues/1282839585?i=1282843718&uo=4&at=10