ame\":\"La Bouche Manouche\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba3a5edd70226aaa9f0e26c4d\"},\"artist_id\":\"131983\",\"about\":{\"description\":\"With Andy Ruiz-Palma on lead guitar, Nathan Mansfield on violin/trumpet, Amy Baldwin on double bass, La Bouche Manouche is made up of highly experienced, in-demand performers who have played in many prestigious venues such as the Royal Albert Hall, the Barbican Centre, the Southbank Centre, the Royal Festival Hall and Ronnie Scotts.\\n\\nCatch this highly anticipated performance from one of the UK’s top gypsy jazz bands!\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T20:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=381%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=0%2C64%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=608%2C0%2C704%2C1280\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/z2f6857826ce?dice_id=z2f6857826ce\",\"post_competition_referral\":\"https://link.dice.fm/E8b9f670af5c?dice_id=E8b9f670af5c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R93a4d42bc93?dice_id=R93a4d42bc93\",\"post_purchase_referral\":\"https://link.dice.fm/i522e1766dce?dice_id=i522e1766dce\",\"post_reminder_referral\":\"https://link.dice.fm/q03e9da15be0?dice_id=q03e9da15be0\",\"post_waitinglist_referral\":\"https://link.dice.fm/Bf2a9e22aaf2?dice_id=Bf2a9e22aaf2\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:17\",\"properties\":[],\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767571200,\"id\":\"695ce3762d3abd0001f0795d\",\"name\":\"La Bouche Manouche ft. Irene Serra (late show)\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"After two sold-out shows, La Bouche Manouche return with Got A Little Rhythm!, a joyful celebration of gypsy jazz swing inspired by the glamour of the Jazz Age.\\n\\nShowcasing music from their newly released second album, the band also perform highlights from the much-loved repertoire that has earned them over 5 million YouTube views. Expect the infectious swing of Django Reinhardt originals, timeless Billie Holiday classics, French chansons, tangos and crowd-favourite gypsy tunes.\\n\\nFeaturing the critically acclaimed Irene Serra on vocals, La Bouche Manouche is a vintage jazz quintet steeped in the sound of the Parisian Hot Club. Their stylish, genre-spanning set moves effortlessly from Edith Piaf classics and the Great American Songbook to Latin-tinged rhythms and soulful swing.\\n\\nAn unmissable evening of elegance, rhythm and gypsy jazz joie de vivre.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":