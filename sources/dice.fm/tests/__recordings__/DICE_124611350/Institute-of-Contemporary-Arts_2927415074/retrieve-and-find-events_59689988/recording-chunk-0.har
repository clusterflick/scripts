":\"You & I\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dabeull\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7de098e9edd5d1226383ffaa\"},\"artist_id\":\"13118\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-05T19:00:00+00:00\",\"doors_close_date\":\"2026-11-05T23:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-11/a5b977bf-fafd-4687-ad56-d8af4994bc6a.jpg?rect=0%2C0%2C10000%2C10000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-11/a5b977bf-fafd-4687-ad56-d8af4994bc6a.jpg?rect=0%2C2000%2C10000%2C6000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-11/a5b977bf-fafd-4687-ad56-d8af4994bc6a.jpg?rect=2250%2C0%2C5500%2C10000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/J87f07045c9a?dice_id=J87f07045c9a\",\"post_competition_referral\":\"https://link.dice.fm/Ccdd701c887d?dice_id=Ccdd701c887d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/He8a34d10d71?dice_id=He8a34d10d71\",\"post_purchase_referral\":\"https://link.dice.fm/Ab5336ee9a65?dice_id=Ab5336ee9a65\",\"post_reminder_referral\":\"https://link.dice.fm/h4c5623291a3?dice_id=h4c5623291a3\",\"post_waitinglist_referral\":\"https://link.dice.fm/gc60848f6025?dice_id=gc60848f6025\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:88\",\"properties\":[],\"presented_by\":\"Presented by AEG.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765537200,\"id\":\"6936cbfcd6a11c00017859f1\",\"name\":\"Dabeull Live Band\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**VENUE PRESALE: MON 15TH DEC @ 11AM**\\n\\n**GENERAL SALE: WEDS 17TH DEC @ 11AM**\\n\\nDabeull is a visionary French producer and artist, widely regarded as a leading figure in the global funk revival. With his unmistakable blend of punchy basslines, retro synthesizers, and sensual vocals, he has carved out an unique place on the international music scene.\\n\\nKnown for his 70s–80s movie star aesthetic and analog obsession, Dabeull channels the golden era of funk with unmatched authenticity. His sound is deeply influenced by the Pop, Funk and African Music he was exposed to during his youth, infused with the warmth of vintage gear and recorded entirely using classic 70s synthesizers. Whether in the studio or on stage, Dabeull is a master of groove. His live shows—featuring a full analog band, period costumes, and retro instrumentation—transport audiences on a nostalgic, feel-good journey through funk history.With a growing global fanbase and a distinct artistic identity, Dabeull continues to redefine modern funk while honoring its timeless roots.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"date_unix\":1793905200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3966,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-11-05T15:00:00+00:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-11-05T19:00:00+00:00\",\"event_end_date\":\"2026-11-05T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"7dep7p-joan-as-police-woman-5th-nov-union-chapel-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Simplicity (feat. Joan As Police Woman)\",\"redirect_url\":\"https://open.spotify.com/track/5vUmlY6P9ZA3WoosABRUpp\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1833b043b02d4b27f1c30aac17595b0fdce2b9b8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Simplicity (feat. Joan As Police Woman)\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Joan As Police Woman\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-30/84afd61a-8ad0-4200-8293-e0d43b3f2216.jpg?rect=0%2C50%2C541%2C541\"},\"artist_id\":\"2963\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compto