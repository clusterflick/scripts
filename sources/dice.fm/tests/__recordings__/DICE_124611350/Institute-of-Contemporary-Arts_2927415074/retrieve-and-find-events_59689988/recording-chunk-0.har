"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:11\",\"properties\":[],\"presented_by\":\"Presented by KOKO.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766016000,\"id\":\"69442fc0a77b0e0001a83325\",\"name\":\"KOKO Electronic: ANNA, Antdot\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The globally-prolific Brazilian-born, Lisbon-based DJ and producer; ANNA joins us in the theatre for a stellar night of melodic & progressive sounds this March, alongside fellow Brazilian techno star Antdot.\\n\\n**IMPORTANT INFORMATION:**\\n\\nNeed a pres? Head to our official pre-party from 7pm-12am: Don KOKO, for pizzas & cocktails curated by What Willy Cook, SG Lewis, DJ Tennis, Natasha Diggs, Carlita & many more – check your emails for a 20% discount link. Or head to @donkokofc for reservations & offers.\\n\\nFor VIP & areas please email: bookings@KOKO.co.uk (available on selected nights only).\\n\\nPlease arrive according to the time on your ticket for a smooth and guaranteed entry.\\n\\nWe have a zero tolerance policy towards harassment and prejudice. If you are made to feel uncomfortable in any way, please do not hesitate to speak to any member of staff and we will help immediately.\\n\\nAny unattended drinks will be discarded.\\n\\nPlease do not purchase tickets through social media, we are unable to help with anyone who has been scammed\\n\\nWe operate a zero tolerance drug policy.\\n\\nKOKO is 19+. No physical ID, no entry.\\n\\nPlease bring a valid form of photographic ID with you to the event\\n\\nLast entry 3am. No readmission.\\n\\n**TO PREVENT RESELLING AND UNAUTHORISED USE OF TICKETS**\\n\\nTickets cannot be resold or transferred to another person through third party platforms such as Ticketswap.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 19+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8108\",\"name\":\"KOKO\",\"image\":{\"url\":null},\"perm_name\":\"koko-nwv5\",\"profile_active\":false},\"date_unix\":1772834400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1100},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T02:00:00+00:00\",\"sale_start_date\":\"2025-11-26T00:00:00+00:00\",\"event_start_date\":\"2026-03-06T22:00:00+00:00\",\"event_end_date\":\"2026-03-07T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8o2wl-tc-diversion-audio-vs-the-foundation-mothership-music-6th-mar-onyx-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"15928\",\"name\":\"Onyx\",\"address\":\"E1W 2BB, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.508986,\"lng\":-0.061629},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"onyx-k6wa9\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T22:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/321322eb-4df5-41fd-8295-007db37317c5.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/321322eb-4df5-41fd-8295-007db37317c5.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/321322eb-4df5-41fd-8295-007db37317c5.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/rcbb6238165a?dice_id=rcbb6238165a\",\"post_competition_referral\":\"https://link.dice.fm/M62adb5aa757?dice_id=M62adb5aa757\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/tfe4a3c41252?dice_id=tfe4a3c41252\",\"post_purchase_referral\":\"https://link.dice.fm/Xd9049c696c3?dice_id=Xd9049c696c3\",\"post_reminder_referral\":\"https://link.dice.fm/X30ddee04119?dice_id=X30ddee04119\",\"post_waitinglist_referral\":\"https://link.dice.fm/Dd7034a2fcb7?dice_id=Dd7034a2fcb7\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1813,\"name\":\"E1 London\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"865291950713044\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:12\",\"properties\":[],\"presented_by\":\"Presented by E1 London.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764115200,\"id\":\"69271c0db4f8c20001e9f9dc\",\"name\":\"TC, Diversion Audio vs The Foundation, Mothership Music\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Diversion Audio returns to Onyx (E1) on Friday 6th March 2026!\\n\\nThis time we’re taking over the whole of Onyx. Two rooms, three collectives, one massive night of Drum & Bass.\\n\\nWe’ve got TC performing a 90-minute classics set with Trafic MC - plus a leading new-generation headliner who we’ll be announcing closer to the time!\\n\\nAlongside the headliners in Room 1, Diversion Audio and The Foundation go head to head in a showcase of styles - celebrating the past, present and future of Drum & Bass.\\n\\nIn room 2 we’ve got Mothership Music coming down for a takeover - an all-female collective committed to amplifying underrepresented voices and putting equality and diversity at the centre of everything it does.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1843\",\"name\":\"E1 London\",\"image\":{\"url\":null},\"perm_name\":\"e1-london-3p9x\",\"profile_active\":false},\"date_unix\":1772834400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-03-06T02:00:00+00:00\",\"sale_start_date\":\"2026-02-04T11:00:00+00:00\",\"event_start_date\":\"2026-03-06T23:00:00+00:00\",\"event_end_date\":\"2026-03-07T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"v393kl-lnatobl-dub-phizix-christian-eede-6th-mar-the-old-blue-last-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dub Phizix - Raw Food\",\"redirect_url\":\"https://music.apple.com/us/album/raw-food/1805920321?i=1805920322&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dub Phizix\",\"preview_url\":\"https://a