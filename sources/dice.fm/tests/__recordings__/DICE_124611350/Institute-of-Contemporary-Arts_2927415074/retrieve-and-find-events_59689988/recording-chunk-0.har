ertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"14139\",\"name\":\"Balls Brothers Austin Friars\",\"address\":\"10-11 Austin Friars, City of London, London, EC2N 2HG, United Kingdom\",\"location\":{\"lat\":51.51571,\"lng\":-0.08527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"balls-brothers-austin-friars-mxb5v\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T13:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:45\",\"social_links\":{\"event_share\":\"https://link.dice.fm/mbf82ce6a769?dice_id=mbf82ce6a769\",\"post_competition_referral\":\"https://link.dice.fm/P32fc5d92607?dice_id=P32fc5d92607\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ya84286d7f93?dice_id=Ya84286d7f93\",\"post_purchase_referral\":\"https://link.dice.fm/m85302cab720?dice_id=m85302cab720\",\"post_reminder_referral\":\"https://link.dice.fm/nfe4d64a12f9?dice_id=nfe4d64a12f9\",\"post_waitinglist_referral\":\"https://link.dice.fm/d3353d7b1f7e?dice_id=d3353d7b1f7e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-04-04T11:00:00+01:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-04-04T13:00:00+01:00\",\"event_end_date\":\"2026-04-04T16:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"69566859eef80f00013d2e25\",\"seats_io_event_id\":null,\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nvkvgl-gingers-big-drag-bottomless-brunch-4th-apr-balls-brothers-austin-friars-london-tickets\",\"date_unix\":1775304000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T13:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:46\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Dea72a8060bb?dice_id=Dea72a8060bb\",\"post_competition_referral\":\"https://link.dice.fm/r7d89feb4947?dice_id=r7d89feb4947\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Sf16cd56c63d?dice_id=Sf16cd56c63d\",\"post_purchase_referral\":\"https://link.dice.fm/i546fd3d9393?dice_id=i546fd3d9393\",\"post_reminder_referral\":\"https://link.dice.fm/Lffc5827fcc8?dice_id=Lffc5827fcc8\",\"post_waitinglist_referral\":\"https://link.dice.fm/i1e2cb29fa7a?dice_id=i1e2cb29fa7a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-04-04T13:30:00+01:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"event_start_date\":\"2026-04-04T13:00:00+01:00\",\"event_end_date\":\"2026-04-04T15:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2003},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"694e4e37455ad700011bb2b9\",\"seats_io_event_id\":null,\"name\":\"The Big Drag Bingo Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"v3q3v7-the-big-drag-bingo-brunch-4th-apr-phoenix-arts-club-london-tickets\",\"date_unix\":1775304000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"15810\",\"name\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T18:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770310800,\"max_tickets\":100,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by House of Burlesque.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:47\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Q3554b896421?dice_id=Q3554b896421\",\"post_competition_referral\":\"https://link.dice.fm/p1084d0e3c64?dice_id=p1084d0e3c64\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Y0aff000655e?dice_id=Y0aff000655e\",\"post_purchase_referral\":\"https://link.dice.fm/y4254cede00a?dice_id=y4254cede00a\",\"post_reminder_referral\":\"https://link.dice.fm/t5efa464a86a?dice_id=t5efa464a86a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Tf5ca57bd9e3?dice_id=Tf5ca57bd9e3\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T17:00:00+00:00\",\"sale_end_date\":\"2026-04-04T15:00:00+01:00\",\"sale_start_date\":\"2026-02-06T11:00:00+00:00\",\"event_start_date\":\"2026-04-04T18:00:00+01:00\",\"event_end_date\":\"2026-04-04T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2035},\"properties\":[],\"billing_promoter\":{\"id\":\"2924\",\"name\":\"House of Burlesque\",\"image\":{\"url\":null},\"perm_name\":\"house-of-burlesque-6pd8\",\"profile_active\":false},\"id\":\"698482b0e368460001f52fc5\",\"seats_io_event_id\":null,\"name\":\"House of Burlesque Speakeasy \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"7dm6n9-house-of-burlesque-speakeasy-4th-apr-qt-london-tickets\",\"date_unix\":1775322000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 04 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5661\",\"name\":\"The Obie Theatre - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-obie-theatre---the-brit-school-r5kr\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-08T18:45:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":73025,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":73026,\"title\":\"What is a Concession\",\"body\":\"A Student or Child Concession is available for children and students at any school, college or university.\\n\\nAn Adult Concession is available for those in receipt of Universal Credit, Working Tax Credit, Child Tax Credit, Pension Credit, Employment and Support Allowance, Income Support or Jobseeker’s Allowance.\",\"order\":1},{\"id\":73027,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=0%2C0%2C3366%2C3366\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=0%2C673%2C3366%2C2020\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=758%2C0%2C1851%2C3366\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769679900,\"max_tickets\":8,\"marketeers\":[],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Supported by The Alburys Charitable Foundation\\\"\\n\\nHadestown is our second show of our Musical Theatre Season of 2026. We have just finished Come From Away and we will be doing Six (22nd-24th April).\\n\\nThis intriguing and beautiful folk opera delivers a deeply resonant and defiantly hopeful theatrical experience. Following two intertwining love stories — that of young dreamers Orpheus and Eurydice, and that of immortal King Hades and lady Persephone — Hadestown invites audiences on a hell-raising journey to the underworld and back. Inspired by traditions of classic American folk music and vintage New Orleans jazz, Mitchell’s beguiling sung-through musical pits industry against nature, doubt against faith, and fear against love.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a PG event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:48\",\"social_links\":{\"event_share\":\"https://link.dice.fm/n90cf2eee8f3?dice_id=n90cf2eee8f3\",\"post_competition_referral\":\"https://link.dice.fm/dfa75a11f0d2?dice_id=dfa75a11f0d2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f1cdef069d94?dice_id=f1cdef069d94\",\"post_purchase_referral\":\"https://link.dice.fm/qabb0fe8f873?dice_id=qabb0fe8f873\",\"post_reminder_referral\":\"https://link.dice.fm/A46d10219582?dice_id=A46d10219582\",\"post_waitinglist_referral\":\"https://link.dice.fm/H8a28d407c6b?dice_id=H8a28d407c6b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T09:45:00+00:00\",\"sale_end_date\":\"2026-04-08T19:30:00+01:00\",\"sale_start_date\":\"2026-02-02T19:00:00+00:00\",\"event_start_date\":\"2026-04-08T19:00:00+01:00\",\"event_end_date\":\"2026-04-08T21:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"697b7cf2517a4600016d1978\",\"seats_io_event_id\":null,\"name\":\"Hadestown\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb3gom-hadestown-8th-apr-the-obie-theatre-the-brit-school-london-tickets\",\"date_unix\":1775671200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 08 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5661\",\"name\":\"The Obie Theatre - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-obie-theatre---the-brit-school-r5kr\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-09T16:15:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":73028,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":73029,\"title\":\"What is a Concession\",\"body\":\"A Student or Child Concession is available for children and students at any school, college or university.\\n\\nAn Adult Concession is available for those in receipt of Universal Credit, Working Tax Credit, Child Tax Credit, Pension Credit, Employment and Support Allowance, Income Support or Jobseeker’s Allowance.\",\"order\":1},{\"id\":73030,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=0%2C0%2C3366%2C3366\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=0%2C673%2C3366%2C2020\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/e64d6b80-6ddb-4780-adb7-6d0be9276058.jpg?rect=758%2C0%2C1851%2C3366\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769679900,\"max_tickets\":8,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Supported by The Alburys Charitable Foundation\\\"\\n\\nHadestown is our second show of our Musical Theatre Season of 2026. We have just finished Come From Away and we will be doing Six (22nd-24th April).\\n\\nThis intriguing and beautiful folk opera delivers a deeply resonant and defiantly hopeful theatrical experience. Following two intertwining love stories — that of young dreamers Orpheus and Eurydice, and that of immortal King Hades and lady Persephone — Hadestown invites audiences on a hell-raising journey to the underworld and back. Inspired by traditions of classic American folk music and vintage New Orleans jazz, Mitchell’s beguiling sung-through musical pits industry against nature, doubt against faith, and fear against love.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a PG event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:49\",\"social_links\":{\"event_share\":\"https://link.dice.fm/l18219be6636?dice_id=l18219be6636\",\"post_competition_referral\":\"https://link.dice.fm/N3ed2693d47a?dice_id=N3ed2693d47a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wc03da545beb?dice_id=wc03da545beb\",\"post_purchase_referral\":\"https://link.dice.fm/F7b8b6cfa41f?dice_id=F7b8b6cfa41f\",\"post_reminder_referral\":\"https://link.dice.fm/H2c1177b2de3?dice_id=H2c1177b2de3\",\"post_waitinglist_referral\":\"https://link.dice.fm/O596c5eef5e1?dice_id=O596c5eef5e1\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T09:45:00+00:00\",\"sale_end_date\":\"2026-04-09T17:45:00+01:00\",\"sale_start_date\":\"2026-02-02T19:00:00+00:00\",\"event_start_date\":\"2026-04-09T16:30:00+01:00\",\"event_end_date\":\"2026-04-09T19:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"697b7d2476aebd0001d9b877\",\"seats_io_event_id\":null,\"name\":\"Hadestown\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8bmdr-hadestown-9th-apr-the-obie-theatre-the-brit-school-london-tickets\",\"date_unix\":1775748600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}]