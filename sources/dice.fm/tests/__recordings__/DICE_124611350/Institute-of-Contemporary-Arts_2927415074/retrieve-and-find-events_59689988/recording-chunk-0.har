:null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"After years playing in bands across the UK and Europe, Louie Cameron finally takes the feared step to centre stage with the release of debut EP Do You Wanna Go Out? which is released on the 1st May this year on streaming, with a physical 10\\\" vinyl release available at the launch show at Third Man Records in London on the 28th April 2026. Stealing freely from his influences and surroundings, Cameron incorporates late 60’s New York pop melodies into moody Hamburg settings and softly spoken word psych-soundscapes that wouldn’t feel out of place in a David Lynch series or a Wim Wenders scene. Joining him to release his EP in The Blue Basement is Virgil W.X and Gareth Freiheit.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Third Man Records.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:38\",\"social_links\":{\"event_share\":\"https://link.dice.fm/z7a0addcef66?dice_id=z7a0addcef66\",\"post_competition_referral\":\"https://link.dice.fm/g54a5ff3bca5?dice_id=g54a5ff3bca5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e065be6757b2?dice_id=e065be6757b2\",\"post_purchase_referral\":\"https://link.dice.fm/X1662047c2de?dice_id=X1662047c2de\",\"post_reminder_referral\":\"https://link.dice.fm/k59cdd961b3a?dice_id=k59cdd961b3a\",\"post_waitinglist_