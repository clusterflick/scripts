739000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:54\",\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"In 2026, Teena Marie would have been turning 70 years of age. In memory of one of the most iconic soul / R&B musicians of all time, AGMP are presenting a special celebration of Mary Christine Brockert with a live performance from Sulene Fleming & The Square Biz Band under the direction of Ciyo 'Guitar' Brown.\\n\\nSinger/Singwriter/Producer Teena Marie was born in California in 1956. After signing with Motown Records she started working with label-mate Rick James securing her first hit 'I'm A Sucker For Your Love' in 1979 taken from the debut LP 'Wild and Peaceful'. Her follow up LP 'Lady T', was produced by Minnie Ripperton's widower Richard Rudolph and featured the hit single 'Behind The Groove'. Teena Marie continued to have hit singles throughout the 1980's such as 'I Need Your Lovin', 'Fix It', 'It Must Be Magic', 'Portuguese Love', 'Square Biz', 'Here's Looking At You', 'Ooo La La La' (as used by The Fugees for their hit 'Fu-Gee-La') and many more.\\n\\nSulene Fleming & The Square Biz Band will be performing live playing the hits and fan favourites in this big celebration of the life and legacy of Soul/R&B legend Teena Marie.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-21T00:00:00+01:00\",\"sale_end_date\":\"2026-03-05T17:00:00+00:00\",\"sale_start_date\":\"2025-10-21T00:00:00+01:00\",\"event_start_date\":\"2026-03-05T19:30:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68f7e45be0555100018a6934\",\"name\":\"Remembering Teena Marie\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/3e8480d7-1e76-4c17-9bf9-d46db3743be9.jpg?rect=3%2C0%2C794%2C794\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/3e8480d7-1e76-4c17-9bf9-d46db3743be9.jpg?rect=0%2C157%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/3e8480d7-1e76-4c17-9bf9-d46db3743be9.jpg?rect=182%2C0%2C437%2C794\"},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1761001200,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/ua372331399c?dice_id=ua372331399c\",\"post_competition_referral\":\"https://link.dice.fm/E2bfb8ce2cf1?dice_id=E2bfb8ce2cf1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/af681842a47b?dice_id=af681842a47b\",\"post_purchase_referral\":\"https://link.dice.fm/z76d2b3ed668?dice_id=z76d2b3ed668\",\"post_reminder_referral\":\"https://link.dice.fm/j8e6c07cf52d?dice_id=j8e6c07cf52d\",\"post_waitinglist_referral\":\"https://link.dice.fm/e166839a9b4f?dice_id=e166839a9b4f\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":600},\"seats_io_public_key\":null,\"presented_by\":\"Presented by 98 Poly.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"7707\",\"name\":\"Miss Philippa Sarratt\",\"image\":{\"url\":null},\"perm_name\":\"miss-philippa-sarratt-7ea6\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k6aq6q-this-room-contains-the-world-live-5th-mar-the-greyhound-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772740800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":10,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:55\",\"venues\":[{\"id\":\"5676\",\"name\":\"The Greyhound\",\"address\":\"109 Peckham High St, London SE15 5SE, UK\",\"location\":{\"lat\":51.4741705,\"lng\":-0.06862209999999999},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-greyhound-kvlo\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T20:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"98 Poly\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb79b30d6279300b0049a41cc7\"},\"artist_id\":\"40994\",\"about\":{\"description\":\"Growing up in Greater London, equidistant from city raves and expansive landscapes has carved the capricious sound of songwriter, producer & vocalist 98 Poly. The artist was tipped as ‘one to watch’ by Jamz Supernova following the release of her debut single ‘360’, with subsequent EP 'You just have to close your eyes' capturing the attention of radio taste makers across BBC Radio 1 (Next Wave Artist and Dacenfloor Moment), BBC Radio 6, Reprezent Radio and British Council’s Selector Radio.\\n\\nTaking the EP onto stages across London; (Corsica Studios, The Lower Third, Third Man Records, The Glove that Fits) as-well as further afield to Bristol and Berlin, 2025 took 98 Poly back into the bedroom-studio to write and produce second EP 'This room contains the world', a non-sensical and polyphonic exploration of mortality, resilience, disllusionment and love. With early support from BBC Radio 1 on singles Yap and June, the full EP is out in February 2026.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Celebrating the release of her EP 'This room contains the world' written and produced from her room in SE London, songwriter, producer and vocalist 98 Poly debuts the EP in its entirety at The Greyhound's basement in Peckham on Thursday 5th March 2026.\\n\\nExploring mortality, resilience, disillusionment and love through existential lyricism and ethereal production, 'This room contains the world' is a transcendental dive for the curious and capricious. With support from (...) and (...).\\n\\n<3\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T17:00:00+00:00\",\"sale_end_date\":\"2026-03-05T15:00:00+00:00\",\"sale_start_date\":\"2026-01-14T17:00:00+00:00\",\"event_start_date\":\"2026-03-05T20:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6964b53bdb9409000169e718\",\"name\":\"This room contains the world (live)\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/f1fa9576-a830-47fe-aa5b-334ac159507d.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/f1fa9576-a830-47fe-aa5b-334ac159507d.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/f1fa9576-a830-47fe-aa5b-334ac159507d.jpg?rect=225%2C0%2C550%2C1000\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768410000,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/D2ace771cbe8?dice_id=D2ace771cbe8\",\"post_competition_referral\":\"https://link.dice.fm/Lc8895cf71e8?dice_id=Lc8895cf71e8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/pa8f293c0399?dice_id=pa8f293c0399\",\"post_purchase_referral\":\"https://link.dice.fm/Aae24799d41b?dice_id=Aae24799d41b\",\"post_reminder_referral\":\"https://link.dice.fm/f2dc39d622a8?dice_id=f2dc39d622a8\",\"post_waitinglist_referral\":\"https://link.dice.fm/je4af80b008e?dice_id=je4af80b008e\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"98 Poly - Yap\",\"redirect_url\":\"https://open.spotify.com/track/40f3kkq2tiiUY9naopuRNL\",\"artist\":\"98 Poly\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1b10473200b51aefb7269fbcfb04a3c88253faa6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Yap\"},{\"type\":\"apple_music\",\"title\":\"98 Poly - June\",\"redirect_url\":\"https://music.apple.com/us/album/june/1855076179?i=1855076180&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"98 Poly\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/61/02/18/610218b2-7699-06e6-ee8b-65f13d701c27/mzaf_3917456529492330387.plus.aac.p.m4a\",\"track_name\":\"June\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Royal Albert Hall.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2558\",\"name\":\"Royal Albert Hall\",\"image\":{\"url\":null},\"perm_name\":\"royal-albert-hall-8m2r\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"ww5nmp-late-night-jazz-the-forever-presence-5th-mar-elgar-room-at-royal-albert-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772746200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:56\",\"venues\":[{\"id\":\"8368\",\"name\":\"Elgar Room at Royal Albert Hall\",\"address\":\"Elgar Room at Royal Albert Hall\",\"location\":{\"lat\":51.501267,\"lng\":-0.17754},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"elgar-room-at-royal-albert-hall-da6q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T21:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Forever Presence\",\"image\":null,\"artist_id\":\"119165\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Curated by Sarathy Korwar.\\n\\nDrawing from the rich tradition of Spiritual Jazz, The Forever Presence weave in ambient electronic textures and contemporary classical arrangements that evoke both depth and delicacy. Their work is a musical meditation on the present moment and the eternal.\\n\\nThey have received praise from both sides of the Atlantic as KEXP and KCRW’s track of the day and interviews on NPR, Bandcamp, BBC 6 Music, BBC Radio London and Jazz FM.\\n\\nOur intimate Late Night Jazz series presents sensational music in the Elgar Room, celebrating the freshest sounds on the London scene alongside the finest in jazz standards.\\n\\nWe have a laid-back attitude at Late Night Jazz at the Royal Albert Hall. Customers are welcome to dance, move around, sing along, and enjoy themselves in whatever way feels most comfortable!\\n\\nAll customers aged 14 years or below must be accompanied by an adult aged 18 years or over\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T00:00:00+00:00\",\"sale_end_date\":\"2026-03-04T12:00:00+00:00\",\"sale_start_date\":\"2025-12-22T00:00:00+00:00\",\"event_start_date\":\"2026-03-05T21:30:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6949782bc54ede00017112b7\",\"name\":\"Late Night Jazz: The Forever Presence\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/d27523b2-665c-4824-9cc7-c84d9702536a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/d27523b2-665c-4824-9cc7-c84d9702536a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/d27523b2-665c-4824-9cc7-c84d9702536a.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1766361600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/K31791011d6c?dice_id=K31791011d6c\",\"post_competition_referral\":\"https://link.dice.fm/p677d6b29f1e?dice_id=p677d6b29f1e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w19bff6a3c07?dice_id=w19bff6a3c07\",\"post_purchase_referral\":\"https://link.dice.fm/H26ee6829b51?dice_id=H26ee6829b51\",\"post_reminder_referral\":\"https://link.dice.fm/Y1ea8905e3d5?dice_id=Y1ea8905e3d5\",\"post_waitinglist_referral\":\"https://link.dice.fm/A0b61662270a?dice_id=A0b61662270a\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Forever Presence - You Are the Moment\",\"redirect_url\":\"https://open.spotify.com/track/37QClGg4PEwYdGh5TMjMab\",\"artist\":\"The Forever Presence\",\"preview_url\":\"https://p.scdn.co/mp3-preview/73a37c9fd002a72941c3be7d6c4bea03e770ab3d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"You Are the Moment\"},{\"type\":\"apple_music\",\"title\":\"The Forever Presence - You Are the Moment\",\"redirect_url\":\"https://music.apple.com/us/album/you-are-the-moment/1826753873?i=1826753878&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Forever Presence\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/19/d3/1d/19d31d52-fa9d-6f38-794a-195f8f03c233/mzaf_417278334177476728.plus.aac.p.m4a\",\"track_name\":\"You Are the Moment\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Thu 05 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by EYECONIC STUDIOS\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"144631\",\"name\":\"Eyeconic Studio\",\"image\":{\"url\":null},\"perm_name\":\"eyeconic-studio-7r78v\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"nv9qm5-japan-uk-hiphop-event-in-london-the-eyeconic-6th-mar-fire-night-club-vauxhall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772820000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":15,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:57\",\"venues\":[{\"id\":\"8623\",\"name\":\"Fire Night Club Vauxhall\",\"address\":\"Vauxhall, S Lambeth Rd, London SW8 1RT\",\"location\":{\"lat\":51.484199,\"lng\":-0.124483},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fire-night-club-vauxhall-oqm5\",\"accessibility\":{\"url\":\"https://www.firelondon.net/faqs/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"G!FT\",\"image\":null,\"artist_id\":\"76137\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tade Dust\",\"image\":null,\"artist_id\":\"133958\",\"about\":null,\"is_headliner\":false},{\"name\":\"Miyachi\",\"image\":null,\"artist_id\":\"20696\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":3},\"about\":{\"description\":\"We’re bringing Japan × UK nightlife to London by flying in Japan’s most exciting artists —\\n\\nMIYACHI, Tade Dust,, and Ce Ce j, joined by UK artist G!ft — for a one-night-only experience.\\n\\nThis is the only event in London where you can truly feel the energy of Tokyo and Osaka’s nightlife in one space.\\n\\nMIYACHI is a global superstar from Japan with over 180,000 Instagram followers, known for his international presence and high-energy live performances.\\n\\nExperiencing him this close, in this moment, is something you won’t get again.\\n\\nTade Dust is one of the fastest-rising new artists from Japan. He’s already collaborating with London rappers and moving freely across scenes and borders.\\n\\nCe Ce j represent the new wave of Japanese artists, while G!ft brings the UK side of the culture into the room — connecting scenes, sounds, and cities.\\n\\n※Due to unforeseen circumstances, K-WILY has been cancelled. We sincerely apologise for any inconvenience caused.\\n\\nAnd that’s not all —\\n\\nOn the night, a Japanese hair stylist will be at the venue, giving you the chance to experience authentic Japanese hairstyles.\\n\\nThere will also be merchandise from Japanese creators based in the UK, showcasing culture beyond the music.\\n\\nDon’t worry — the artists perform in both Japanese and English, so everyone can connect with the music.\\n\\nIf you want to experience real Japanese nightlife in London, this is the place to be.\\n\\nWe can’t wait to see you there.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T18:30:00+00:00\",\"sale_start_date\":\"2026-02-12T15:00:00+00:00\",\"event_start_date\":\"2026-03-06T18:00:00+00:00\",\"event_end_date\":\"2026-03-06T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698e0cd05f830a0001698936\",\"name\":\"Japan × UK HIPHOP event in London \\\"THE EYECONIC\\\"\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/59790348-ecad-4c30-b56b-320aa0034b9f.jpg?rect=0%2C14%2C1097%2C1097\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/59790348-ecad-4c30-b56b-320aa0034b9f.jpg?rect=0%2C233%2C1097%2C658\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/59790348-ecad-4c30-b56b-320aa0034b9f.jpg?rect=240%2C0%2C618%2C1124\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770854400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/g91bac7a762f?dice_id=g91bac7a762f\",\"post_competition_referral\":\"https://link.dice.fm/g7360c2ca8e4?dice_id=g7360c2ca8e4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ue3eb48a50b3?dice_id=ue3eb48a50b3\",\"post_purchase_referral\":\"https://link.dice.fm/h57da817c6a2?dice_id=h57da817c6a2\",\"post_reminder_referral\":\"https://link.dice.fm/f1fc767cc4a6?dice_id=f1fc767cc4a6\",\"post_waitinglist_referral\":\"https://link.dice.fm/t6b07b45179a?dice_id=t6b07b45179a\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"MIYACHI - OHAYO!\",\"redirect_url\":\"https://open.spotify.com/track/5jxb6T8Gns1H3l88nXczUv\",\"artist\":\"MIYACHI\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9efeb98c4bf817499745af883b1b1f4a87c5f1f9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"OHAYO!\"},{\"type\":\"apple_music\",\"title\":\"Tade Dust - WeChat (feat. SamRecks)\",\"redirect_url\":\"https://music.apple.com/us/album/wechat-feat-samrecks/1847851777?i=1847851782&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Tade Dust\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/7c/bf/44/7cbf444c-d797-98a0-303d-f2851ad849ae/mzaf_12576255470302665624.plus.aac.p.m4a\",\"track_name\":\"WeChat (feat. SamRecks)\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1236,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Signature Brew Haggerston.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"3591\",\"name\":\"Signature Brew Haggerston\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/cf9f0866-c543-4008-8b08-026157cfb350.jpg\"},\"perm_name\":\"signature-brew-haggerston-3m2g\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"g5m5rp-dictator-london-6th-mar-signature-brew-haggerston-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772820000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:58\",\"venues\":[{\"id\":\"2427\",\"name\":\"Signature Brew Haggerston\",\"address\":\"340 Acton Mews, London E8 4EA, UK\",\"location\":{\"lat\":51.5368309,\"lng\":-0.07585579999999936},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/a4d49491-4b57-4ec6-9c10-4055162cd091.jpg?rect=589%2C0%2C2354%2C2354\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-haggerston-l3yw\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dictator\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-03/3a8ecc76-ce90-43c1-94cf-7ee3f3ac180b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"41746\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Dictator | Signature Brew Haggerston, London\\n\\nSignature Brew Presents..\\n\\nDictator – West Lothian’s high-energy indie-pop powerhouse. Blending inventive indie licks with electrifying electronics and hip-hop beats.\\n\\nSupport tbc\\n\\nFriday 6th March 2026 / Doors 6pm\\n\\nSignature Brew Haggerston\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T14:45:00+00:00\",\"sale_end_date\":\"2026-03-06T17:00:00+00:00\",\"sale_start_date\":\"2026-02-03T14:45:00+00:00\",\"event_start_date\":\"2026-03-06T18:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698208364f24900001656cce\",\"name\":\"Dictator | London\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/e9eadb76-f26c-414c-b1d6-16586dddc733.jpg?rect=0%2C1%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/e9eadb76-f26c-414c-b1d6-16586dddc733.jpg?rect=0%2C161%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/e9eadb76-f26c-414c-b1d6-16586dddc733.jpg?rect=180%2C0%2C441%2C802\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770129900,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/P3c984cb583c?dice_id=P3c984cb583c\",\"post_competition_referral\":\"https://link.dice.fm/Le9e45b55413?dice_id=Le9e45b55413\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S298cf1ab597?dice_id=S298cf1ab597\",\"post_purchase_referral\":\"https://link.dice.fm/cea21ef558a1?dice_id=cea21ef558a1\",\"post_reminder_referral\":\"https://link.dice.fm/J626a777dc5e?dice_id=J626a777dc5e\",\"post_waitinglist_referral\":\"https://link.dice.fm/af7a975e4c45?dice_id=af7a975e4c45\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Dictator - El Niño\",\"redirect_url\":\"https://open.spotify.com/track/15k3uwzrukLddDWKU5flDc\",\"artist\":\"Dictator\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bb83eed0da1827735ab7b8d779db41bb475bc0d5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"El Niño\"},{\"type\":\"apple_music\",\"title\":\"Dictator - El Niño\",\"redirect_url\":\"https://music.apple.com/us/album/el-nin-o/1791734561?i=1791734800&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dictator\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/47/f7/8e/47f78eea-c880-0fcb-e197-b69f054f6e28/mzaf_12108795110336852529.plus.aac.p.m4a\",\"track_name\":\"El Niño\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1854,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":71332,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":71333,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":71334,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"av3qyd-4ft-fingers-6th-mar-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772820000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:59\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:00:00+00:00\",\"doors_close_date\":\"2026-03-06T22:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Our Lives In Cinema\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb875b9583321655f1d666b48a\"},\"artist_id\":\"17190\",\"about\":null,\"is_headliner\":false},{\"name\":\"Missing The Scene\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-13/3c48c3c6-bf31-4167-9e3d-0428c20a6d6b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"106474\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kicked In the Teeth\",\"image\":null,\"artist_id\":\"43485\",\"about\":null,\"is_headliner\":false},{\"name\":\"4FT Fingers\",\"image\":null,\"artist_id\":\"130426\",\"about\":null,\"is_headliner\":true}],\"total_artists\":4,\"total_free_texts\":1},\"about\":{\"description\":\"Hailing from Cheltenham, UK, 4ft Fingers is a powerhouse punk rock band that has been making waves in the music scene since their formation in the late 90s. Their signature sound is a blend of fast, melodic, and catchy punk rock, drawing inspiration from iconic bands like The Clash, The Damned, Snuff Nofx among others.\\n\\nThroughout their career, 4ft Fingers has been known for their relentless work ethic and dedication to their craft. They embarked on extensive tours in the 2000s, solidifying their reputation as “the hardest working punk rock band” as hailed by esteemed publications such as Kerrang! magazine, Big Cheese magazine, and numerous DIY punk fanzines.In 2025, 4ft Fingers continues to thrive, captivating audiences with their explosive live performances. Currently, they are working on their highly anticipated new album, which will mark their first full-length release since 2008. The stage is set for an exhilarating year ahead as 4ft Fingers promises to deliver a blistering and unforgettable punk rock experi\\u0002ence.\\n\\nFans of 4ft Fingers can expect an electrifying fusion of punk rock energy, memorable melo\\u0002dies, and a nod to their influences, creating a unforgettable experience that is both nostal\\u0002gic and fresh. Stay tuned for their upcoming album and prepare for a blistering ride with 4ft Fingers in the forefront of the punk rock scene.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Blackout Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T17:00:00+00:00\",\"sale_start_date\":\"2026-01-22T00:00:00+00:00\",\"event_start_date\":\"2026-03-06T18:00:00+00:00\",\"event_end_date\":\"2026-03-06T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6972368cef628e0001b3d126\",\"name\":\"4FT FINGERS\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/1b0eb48e-6939-46c3-a85f-9ff4067ec25b.jpg?rect=0%2C0%2C2200%2C2200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/1b0eb48e-6939-46c3-a85f-9ff4067ec25b.jpg?rect=0%2C440%2C2200%2C1320\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/1b0eb48e-6939-46c3-a85f-9ff4067ec25b.jpg?rect=495%2C0%2C1210%2C2200\"},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769040000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ydd6b68cbed2?dice_id=Ydd6b68cbed2\",\"post_competition_referral\":\"https://link.dice.fm/K24ee21dfd85?dice_id=K24ee21dfd85\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F1694d8780d0?dice_id=F1694d8780d0\",\"post_purchase_referral\":\"https://link.dice.fm/B7f4fb166a8d?dice_id=B7f4fb166a8d\",\"post_reminder_referral\":\"https://link.dice.fm/e98fbdf88dfd?dice_id=e98fbdf88dfd\",\"post_waitinglist_referral\":\"https://link.dice.fm/ne05aeab0286?dice_id=ne05aeab0286\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"4ft Fingers - Unite Or Fall\",\"redirect_url\":\"https://music.apple.com/us/album/unite-or-fall/1867478310?i=1867478321&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"4ft Fingers\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/d4/df/e0/d4dfe0a5-e265-57c3-ce6d-b495e2ca5d8f/mzaf_11085289456119296097.plus.aac.p.m4a\",\"track_name\":\"Unite Or Fall\"},{\"type\":\"spotify\",\"title\":\"4ft Fingers - Unite Or Fall\",\"redirect_url\":\"https://open.spotify.com/track/666moAPPwia82qx7WcOATz\",\"artist\":\"4ft Fingers\",\"preview_url\":\"https://p.scdn.co/mp3-preview/607da74a195ae05cbc84af3cf3abb3ac41019021?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Unite Or Fall\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2925,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":57778,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"rya2rr-mega-6th-mar-koko-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772820000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:60\",\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mega\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/f70b6169eb7605947624373e110d8affa1d6312d\"},\"artist_id\":\"13214\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mega\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/f70b6169eb7605947624373e110d8affa1d6312d\"},\"artist_id\":\"13214\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"MEGA is that rare artist whose voice and songwriting seems to connect with our very souls. The British-Ugandan artist's fourth EP, I Am Enough, is a stunning and assured work that urges us to reclaim our power, and to step into life with a renewed sense of purpose.\\n\\nThe latest MEGA single My Bones currently sits on the BBC Radio 2 Playlist and The Times Best New Songs Of 2025.\\n\\nMEGA's music is a vivid tapestry of influences, drawing from her Ugandan heritage, childhood experiences in choirs, and love of a broad spectrum of genres including soul, pop and indie. Early champions include the likes of The Independent, NME, Wonderland, Clash and support across BBC Radio 1, Radio 2 and Radio 6. Her debut single, Chariot, a radiant anthem of hope and resilience, has now surpassed 50 million streams and led to two acclaimed EPs, Future Me and Colour Your World.\\n\\nRecently, MEGA headlined the Southbank Centre's Meltdown Festival curated by Little Simz, sharing the stage with artists such as Ghetts, Jon Batiste, Lola Young, Sasha Keable, and The Streets. Her live shows are renowned for their communal energy, uniting audiences of all ages in moments of collective empowerment.\\n\\nThe power of her music is evident in its unique ability to connect with a global fanbase and unite people from every walk of life, the communal nature is palpable when MEGA plays live - a special sight indeed.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-14T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T00:30:00+00:00\",\"sale_start_date\":\"2025-11-14T18:00:00+00:00\",\"event_start_date\":\"2026-03-06T18:00:00+00:00\",\"event_end_date\":\"2026-03-06T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69173627b82e4a000119e14d\",\"name\":\"Mega\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/7ebdac52-4c34-4237-83d2-2e82383a07c2.jpg?rect=341%2C0%2C1367%2C1367\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/7ebdac52-4c34-4237-83d2-2e82383a07c2.jpg?rect=0%2C69%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/7ebdac52-4c34-4237-83d2-2e82383a07c2.jpg?rect=648%2C0%2C752%2C1367\"},\"marketeers\":[{\"id\":918,\"name\":\"KOKO\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"421051646826847\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2075,\"name\":\"KOKO 2\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"2512980718968598\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1763078400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/e3f76dcdb1be?dice_id=e3f76dcdb1be\",\"post_competition_referral\":\"https://link.dice.fm/v7ff8150f2fc?dice_id=v7ff8150f2fc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m5328d7df222?dice_id=m5328d7df222\",\"post_purchase_referral\":\"https://link.dice.fm/gcfc6ec1bf0f?dice_id=gcfc6ec1bf0f\",\"post_reminder_referral\":\"https://link.dice.fm/V6167abcb7c7?dice_id=V6167abcb7c7\",\"post_waitinglist_referral\":\"https://link.dice.fm/T49d9955044c?dice_id=T49d9955044c\"},\"unicorn_extras\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Mega - Chariot\",\"redirect_url\":\"https://open.spotify.com/track/7FC9taEfKHkJs3gQdxDvJ0\",\"artist\":\"Mega\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8be48bd8e03b42f7b42a65cdba3aede5511e2c21?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Chariot\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by New Cross Live.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"dknmxo-total-clash-buzzkocks-6th-mar-new-cross-inn-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772820000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:61\",\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"about\":{\"description\":\"New Cross Live presents\\n\\nTotal Clash\\n\\nA tribute to the only band that matters we play The Clash - The Whole Clash - and nothing but The Clash.\\n\\nPrepare to be taken back to the heady days of ‘77-‘79 and experience the raw passion of the punk era!\\n\\n+\\n\\nThe Buzzkocks\\n\\nThe UKs number one Buzzcocks tribute band, we pay homage to the classic lineup of Shelley, Diggle, Maher and Garvey(not forgetting Devoto and Garth). We'll bring you a 'rip roaring' set of fast melodic Punk Rock from the 76 - 79 era. Everybody's Happy!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-19T13:30:00+01:00\",\"sale_end_date\":\"2026-03-06T17:00:00+00:00\",\"sale_start_date\":\"2025-08-19T13:30:00+01:00\",\"event_start_date\":\"2026-03-06T18:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68a340dd1fba8900016af326\",\"name\":\"Total Clash + Buzzkocks\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-18/45263982-7a42-45a0-b237-4013214f9b81.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-18/45263982-7a42-45a0-b237-4013214f9b81.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-18/45263982-7a42-45a0-b237-4013214f9b81.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1755606600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/M0f195c21cae?dice_id=M0f195c21cae\",\"post_competition_referral\":\"https://link.dice.fm/f56f09105d06?dice_id=f56f09105d06\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qb7fce7fa777?dice_id=Qb7fce7fa777\",\"post_purchase_referral\":\"https://link.dice.fm/F233bdca5444?dice_id=F233bdca5444\",\"post_reminder_referral\":\"https://link.dice.fm/Mfb649aedeec?dice_id=Mfb649aedeec\",\"post_waitinglist_referral\":\"https://link.dice.fm/m5f6f0afc38a?dice_id=m5f6f0afc38a\"},\"unicorn_extras\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Clash - Brand New Cadillac\",\"redirect_url\":\"https://music.apple.com/us/album/brand-new-cadillac/684811762?i=684812010&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Clash\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/7f/0c/00/7f0c0049-dd37-89c2-47ed-e28809807868/mzaf_9680746326884396334.plus.aac.p.m4a\",\"track_name\":\"Brand New Cadillac\"},{\"type\":\"spotify\",\"title\":\"The Clash - Brand New Cadillac\",\"redirect_url\":\"https://open.spotify.com/track/7aN5Dd1mTrZei6Tt6ZhzI2\",\"artist\":\"The Clash\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2809b81dc82481afe476ee1bcf17208e0ede5ab0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Brand New Cadillac\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4521},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":17613,\"title\":\"Where I can find more information about accessibility at Alexandra Palace?\",\"body\":\"Head here to find out more https://www.alexandrapalace.com/visitor-information/accessibility/\",\"order\":0},{\"id\":17614,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":1},{\"id\":17622,\"title\":\"What do I do on the day of the event? \",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17623,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\\n\\n  \\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":3},{\"id\":17624,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":4},{\"id\":18950,\"title\":\"Where I can find more information about accessibility at Alexandra Palace?\",\"body\":\"Head here to find out more: https://www.alexandrapalace.com/visitor-information/accessibility/\",\"order\":5},{\"id\":18951,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":6},{\"id\":18952,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":7},{\"id\":18953,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":8},{\"id\":18954,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":9},{\"id\":64398,\"title\":\"Can I bring a bag?\",\"body\":\"BAG POLICY FOR LIVE MUSIC EVENTS AT ALEXANDRA PALACE\\n\\nWe encourage you to attend live music events without bags. Should you need to bring one for your essentials, it needs to be as small as possible.\\n\\nFor security reasons and in line with industry best practice, visitors are only permitted to bring one small bag into the venue, which must be no bigger than:\\n\\nHeight 30cm (11.8 inches)\\n\\nWidth 20cm (7.9 inches)\\n\\nDepth 10cm (3.9 inches)\\n\\nAny bags that do not meet these requirements will be directed to our bag drop (Great Hall concerts only).\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":10}],\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"wwx98n-viagra-boys-6th-mar-alexandra-palace-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1772821800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:62\",\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-03-06T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Getdown Services\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-22/b284e5b3-e27b-4650-87f7-0ef9a012aeaf.jpg?rect=0%2C10%2C620%2C620\"},\"artist_id\":\"48944\",\"about\":null,\"is_headliner\":false},{\"name\":\"Viagra Boys\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-05/3284a71a-c8fe-4336-b551-309d0543355e.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"5288\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-03-31T10:00:00+01:00\",\"sale_end_date\":\"2026-03-06T21:00:00+00:00\",\"sale_start_date\":\"2025-04-02T10:00:00+01:00\",\"event_start_date\":\"2026-03-06T18:30:00+00:00\",\"event_end_date\":\"2026-03-06T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"67e576474dba0f000194adc3\",\"name\":\"Viagra Boys\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-25/0a2dd7f9-3105-4202-a731-b791ed384f58.jpg?rect=0%2C0%2C780%2C780\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-25/0a2dd7f9-3105-4202-a731-b791ed384f58.jpg?rect=0%2C156%2C780%2C468\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-25/0a2dd7f9-3105-4202-a731-b791ed384f58.jpg?rect=176%2C0%2C429%2C780\"},\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":true,\"tty_to_extras\":[{\"ticket_type_id\":922428,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922429,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922430,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922434,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922498,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922499,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922500,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922501,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922502,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922503,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922504,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922505,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922506,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":922507,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":923808,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142910,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142911,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142912,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142913,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142914,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1142915,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1159148,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1189779,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]},{\"ticket_type_id\":1193633,\"extra_ids\":[\"924792\",\"924791\",\"924790\",\"924789\"]}],\"announcement_date_unix\":1743411600,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/e07292f77723?dice_id=e07292f77723\",\"post_competition_referral\":\"https://link.dice.fm/a27ad8e1950a?dice_id=a27ad8e1950a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T6df3ff45b0b?dice_id=T6df3ff45b0b\",\"post_purchase_referral\":\"https://link.dice.fm/leb4849aeca7?dice_id=leb4849aeca7\",\"post_reminder_referral\":\"https://link.dice.fm/vd09d8685612?dice_id=vd09d8685612\",\"post_waitinglist_referral\":\"https://link.dice.fm/F60b94b60d43?dice_id=F60b94b60d43\"},\"unicorn_extras\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Punk Rock Loser\",\"redirect_url\":\"https://open.spotify.com/track/2pqoh1jUQoppztoQRRGyKK\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/322269eda0a61cd1cfa4733049bfc08dc1c7f5a6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Punk Rock Loser\"},{\"type\":\"apple_music\",\"title\":\"Viagra Boys - Punk Rock Loser\",\"redirect_url\":\"https://music.apple.com/us/album/punk-rock-loser/1616538091?i=1616538342&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Viagra Boys\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/11/80/04/118004f6-fea1-f775-701a-2b141de82bfd/mzaf_11163390147537137737.plus.aac.p.m4a\",\"track_name\":\"Punk Rock Loser\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Rough Trade.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":60935,\"title\":\"Can I bring a camera?\",\"body\":\"Please note no professional cameras are allowed. Small cameras are fine but anything too big or with a detachable lense will be turned away as we are a small space.\",\"order\":0},{\"id\":60936,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":1},{\"id\":60937,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":2},{\"id\":60938,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 15-30 minutes, playing songs from the new release or a Q&A. Please note there is only 15min between the door time and the stage time.\",\"order\":3},{\"id\":60939,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":4},{\"id\":60940,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":60941,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":60942,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":7},{\"id\":60943,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":8}],\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"mx8ewl-mf-robots-dj-set-signing-6th-mar-rough-trade-denmark-street-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772821800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:63\",\"venues\":[{\"id\":\"14095\",\"name\":\"Rough Trade Denmark Street\",\"address\":\"24 Denmark Street, Camden, London, WC2H 8NJ, United Kingdom\",\"location\":{\"lat\":51.51547,\"lng\":-0.12933},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-denmark-street-oe2r5\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"MF Robots\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebba27d7d46be998d7ab13147b\"},\"artist_id\":\"4915\",\"about\":{\"description\":\"A project devised by two former Brand New Heavies groovers, MF Robots (Music For Robots) create swaggering soul tracks that embody the euphoria of ’90s dance music. With Jan Kincaid on production and drums, and Dawn Joseph on vocals, the duo’s eponymous debut dropped in 2018 with the aim to free them from the “constraints and perceptions” of modern music. Since then, they’ve continued this musical liberation with jazz-sprinkled albums including Break the Wall (2021) and a series of performances at The Jazz Cafe.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Rough Trade Denmark Street is very excited to present an DJ set and signing from MF Robots. This unique event celebrates the release of their new album 'III (Part One)' released via Good People.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade Denmark Street on the day of the show.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/mf-robots/iii-part-one\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T19:00:00+00:00\",\"sale_start_date\":\"2025-12-03T10:00:00+00:00\",\"event_start_date\":\"2026-03-06T18:30:00+00:00\",\"event_end_date\":\"2026-03-06T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"692eb40f45105400011f0e33\",\"name\":\"MF Robots: DJ Set + Signing\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/a539a427-608a-4f57-96ea-b46fb58ec53e.jpg?rect=0%2C1168%2C4672%2C4672\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/a539a427-608a-4f57-96ea-b46fb58ec53e.jpg?rect=0%2C2103%2C4672%2C2803\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/a539a427-608a-4f57-96ea-b46fb58ec53e.jpg?rect=409%2C0%2C3854%2C7008\"},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":true,\"tty_to_extras\":[{\"ticket_type_id\":1134785,\"extra_ids\":[\"1140582\"]},{\"ticket_type_id\":1134786,\"extra_ids\":[\"1140582\"]},{\"ticket_type_id\":1134792,\"extra_ids\":[\"1140582\"]},{\"ticket_type_id\":1134793,\"extra_ids\":[\"1140582\"]},{\"ticket_type_id\":1194364,\"extra_ids\":[\"1140582\"]}],\"announcement_date_unix\":1764633600,\"donation\":null,\"has_multiple_ticket