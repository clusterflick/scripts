\"tty_to_extras\":[],\"venues\":[{\"id\":\"15928\",\"name\":\"Onyx\",\"address\":\"E1W 2BB, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.508986,\"lng\":-0.061629},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"onyx-k6wa9\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T22:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"1843\",\"name\":\"E1 London\",\"image\":{\"url\":null},\"perm_name\":\"e1-london-3p9x\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/y30856e742bc?dice_id=y30856e742bc\",\"post_competition_referral\":\"https://link.dice.fm/J80828706656?dice_id=J80828706656\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jfb7f2826527?dice_id=jfb7f2826527\",\"post_purchase_referral\":\"https://link.dice.fm/q01e7eec9dd4?dice_id=q01e7eec9dd4\",\"post_reminder_referral\":\"https://link.dice.fm/s59191bc674f?dice_id=s59191bc674f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Bbc409339eeb?dice_id=Bbc409339eeb\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by E1 London.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:0\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-04-12T03:00:00+01:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-04-11T22:00:00+01:00\",\"event_end_date\":\"2026-04-12T06:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770595200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1100},\"id\":\"6989becf8d3c8e000143491a\",\"name\":\"Ozzie Guven\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ozzie Guven\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-05/f04e4abb-7b60-4dc2-9d49-4bd9c0c54443.jpg?rect=0%2C0%2C1632%2C1632\"},\"artist_id\":\"41916\",\"about\":{\"description\":\"A South East London original, Ozzie Guven is tearing up the underground with a sound that’s as raw as it is refined. Raised on a diet of jungle, garage, and grime, his music carries the weight of the old school while pushing house into bold new territory. Slick, swung-out drums, basslines that hit different, and just the right amount of attitude—Ozzie’s tracks don’t just land; they linger.\\n\\nWith releases on Microhertz, Heavy House Society, BeeYou, and neXup, Ozzie’s catalogue is doing numbers—millions of streams, five Beatport No.1s, and a roll call of support from Marco Carola, Enzo Siragusa, Michael Bibi, The Martinez Bros, and Seth Troxler. His sound moves between deep, percussive rollers and high-energy club weapons, always built for the heads but primed for peak time.\\n\\nBut it’s behind the decks where Ozzie really locks in. Whether it’s Fabric London, After Caposile, or Amnesia Ibiza B2B with Sidney Charles, his sets carry a distinct energy—part calculated precision, part pure instinct. He’s a regular for Eastenderz, neXup, PIV, and Locus, flipping dancefloors worldwide with selections that feel effortless but always hit home.\\n\\nThis isn’t an overnight success story—it’s been years in the trenches, refining a sound, building a movement, and putting in the work. 2025 is stacked, with an upcoming Club PIV release, a heavy Ibiza summer for Do Not Sleep and Eastenderz, plus headline shows at Shelter Amsterdam and Pacha Barcelona for PIV.\\n\\nUnfiltered, uncompromising, and always one step ahead—Ozzie Guven isn’t just part of the scene, he’s shaping it.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"mx36mv-ozzie-guven-11th-apr-onyx-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/867c5f50-4f02-45a5-a7e0-3193e6788f18.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/867c5f50-4f02-45a5-a7e0-3193e6788f18.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/867c5f50-4f02-45a5-a7e0-3193e6788f18.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"A selector shaped by the entire arc of UK underground Ozzie Guven moves effortlessly from submerged house to needle-sharp minimal, slipping through garage pressure and its modern offshoots without losing an inch of soul.\\n\\n11 April - ONYX plus a small circle of special guests built for the room, not the algorithm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":177,\"name\":\"Percolate\",\"privacy_policy_link\":\"https://www.iubenda.com/privacy-policy/67589163\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Feedback\",\"redirect_