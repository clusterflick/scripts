p3-preview/c52059c3d592f2b728074991889ca8bceefb5790?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dinosaurs Will Die\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2027-01-09T17:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2027-01-09T19:00:00+00:00\",\"event_end_date\":\"2027-01-09T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/s86c497737af?dice_id=s86c497737af\",\"post_competition_referral\":\"https://link.dice.fm/s34a228c760b?dice_id=s34a228c760b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ke71dc6252fa?dice_id=Ke71dc6252fa\",\"post_purchase_referral\":\"https://link.dice.fm/y9779a0aa6d2?dice_id=y9779a0aa6d2\",\"post_reminder_referral\":\"https://link.dice.fm/V74a3f091bda?dice_id=V74a3f091bda\",\"post_waitinglist_referral\":\"https://link.dice.fm/n0db905ff7e5?dice_id=n0db905ff7e5\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Direct from the USA, Psychedelic Garage Rock legends THE SEEDS fly in for an exclusive London concert in 2027.\\n\\nFormed in 1965, THE SEEDS originally featured Sky Saxon, Jan Savage, Daryl Hooper, and Rick Andridge. Along with contemporaries The Doors, Love, and the Electric Prunes, THE SEEDS pushed a pyschedelic garage rock sound on their releases.\\n\\nNow classic singles 'Can't Seem To Make You Mine', 'Pushin' Too Hard', 'Mr. Farmer' and 'Try To Understand' brought the band success outside of California. THE SEEDS have been named as influences by Iggy Pop, Smashing Pumpkins, R.E.M., Animal Collective, Ramones, Garbage, Frank Zappa, The Bangles and many more.\\n\\nOriginal band member/songwriter Daryl Hooper brings the latest incarnation of THE SEEDS to the UK performing all of the classics and more.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1799521200,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-01-09T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:69\",\"tty_to_extras\":[],\"