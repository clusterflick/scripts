e\":\"Lebanon Hanover\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb37a3d55ead4a8306cb68bfa2\"},\"artist_id\":\"9250\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Lebanon Hanover are an ice cold reply to the alienated world coming from two warm beating hearts. Larissa Iceglass and William Maybelline appear as true romantics of the modern age, admiring William Wordsworth, fascinated by the beauty of art nouveau aesthetics, exploring British seashores and forests at night, whilst being inspired by the urbanism of Berlin.\\n\\nFace value £30, plus venue levy and DICE booking fee.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (Under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-03T12:00:00+01:00\",\"sale_end_date\":\"2026-03-05T17:00:00+00:00\",\"sale_start_date\":\"2025-06-03T12:00:00+01:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"683821ea2c93040001388e9d\",\"name\":\"Lebanon Hanover\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-05-29/d2e214d0-b9e9-4dd1-91d6-c0b5f8e0f278.jpg?rect=1024%2C0%2C4096%2C4096\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-05-29/d2e214d0-b9e9-4dd1-91d6-c0b5f8e0f278.jpg?rect=0%2C205%2C6144%2C3686\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-05-29/d2e214d0-b9e9-4dd1-91d6-c0b5f8e0f278.jpg?rect=1946%2C0%2C2253%2C4096\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1748948400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/r072efa3abe9?dice_id=r072efa3abe9\",\"post_competition_referral\":\"https://link.dice.fm/w3e2a73e0428?dice_id=w3e2a73e0428\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J35d015a3358?dice_id=J35d015a3358\",\"post_purchase_referral\":\"https://link.dice.fm/Mf24743672bf?dice_id=Mf24743672bf\",\"post_reminder_referral\":\"https://link.dice.fm/Kc0e83046130?dice_id=Kc0e83046130\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ufc02b026906?dice_id=Ufc02b026906\"},\"unicorn_extras\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Gallowdance\",\"redirect_url\":\"https://open.spotify.com/track/74SUn8w4lYSwgOGPvVZiEo\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/833ea01ecdcb9f220cd49e64c543c3c8d811e7ee?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Gallowdance\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by London Music Showcase.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"6d29a7-free-entry-ultimate-showcase-5th-mar-strongroom-bar-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"rescheduled\",\"date_unix\":1772738100,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:41\",\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-05T19:00:00+00:00\",\"sale_start_date\":\"2026-01-02T00:00:00+00:00\",\"event_start_date\":\"2026-03-05T19:15:00+00:00\",\"event_end_date\":\"2026-03-05T23:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698382863e638400016d723e\",\"name\":\"Free Entry Ultimate Showcase:\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/3d9fbdbb-032d-425c-94b5-a37ccf7a036c.jpg?rect=0%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/3d9fbdbb-032d-425c-94b5-a37ccf7a036c.jpg?rect=0%2C256%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/3d9fbdbb-032d-425c-94b5-a37ccf7a036c.jpg?rect=288%2C0%2C704%2C1280\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1767312000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/J64245d65d71?dice_id=J64245d65d71\",\"post_competition_referral\":\"https://link.dice.fm/F9dd296eecb9?dice_id=F9dd296eecb9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V84086a60762?dice_id=V84086a60762\",\"post_purchase_referral\":\"https://link.dice.fm/Da4f5baa1ee5?dice_id=Da4f5baa1ee5\",\"post_reminder_referral\":\"https://link.dice.fm/K38db65e6243?dice_id=K38db65e6243\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cc2e7280740