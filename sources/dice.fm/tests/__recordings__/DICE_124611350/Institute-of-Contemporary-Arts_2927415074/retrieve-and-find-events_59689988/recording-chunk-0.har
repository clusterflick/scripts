ps://link.dice.fm/t6818d38b084?dice_id=t6818d38b084\",\"post_purchase_referral\":\"https://link.dice.fm/kf99e8f3c624?dice_id=kf99e8f3c624\",\"post_reminder_referral\":\"https://link.dice.fm/za3963d2099f?dice_id=za3963d2099f\",\"post_waitinglist_referral\":\"https://link.dice.fm/f4fc735745fb?dice_id=f4fc735745fb\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by AGMP.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:17\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-06T00:00:00+00:00\",\"sale_end_date\":\"2026-05-15T17:00:00+01:00\",\"sale_start_date\":\"2026-01-06T00:00:00+00:00\",\"event_start_date\":\"2026-05-15T19:00:00+01:00\",\"event_end_date\":\"2026-05-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1767657600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3523},\"id\":\"695cff5d90bc6c0001e6e861\",\"name\":\"The Blockheads\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Blockheads\",\"image\":null,\"artist_id\":\"6493\",\"about\":{\"description\":\"Initially formed in the late ’70s to provide the backing for eccentric punk hellraiser Ian Dury, The Blockheads are best known for their hits ‘Reasons To Be Cheerful, Pt. 3’, and their UK number one ‘Hit Me With Your Rhythm Stick’. Since Dury’s death in 2000, the band have continued to reunite – memorably for a landmark show at the Electric Ballroom – and have kept their brand of dark humour alive in their heady mix of post-punk, new wave and disco.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"xe2maa-the-blockheads-15th-may-229-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-06/081ead47-66b9-4fe9-9c1d-c9184ddd9131.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-06/081ead47-66b9-4fe9-9c1d-c9184ddd9131.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-06/081ead47-66b9-4fe9-9c1d-c9184ddd9131.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Formed in 1977 to promote Ian Durys' album New Boots and Panties on the first Stiff Records tour of the U.K. - Chaz Jankel, Norman Watt-Roy, Charlie Charles, John Turnbull, and Micky Gallagher - became known as The Blockheads.\\n\\nAs Ian Dury & The Blockheads they went back out on tour, and in 1978 released What a Waste a single that reached #5 in the U.K. charts. They were then joined by saxophonist Davey Payne and toured the U.S.A supporting Lou Reed.\\n\\nIn 1979 Hit Me With Your Rhythm Stick (#1 in the UK charts) and Reasons to be Cheerful, Part 3 (#3 in the UK charts) were released along with the classic Do It Yourself LP.\\n\\nIan Dury & The Blockheads disbanded in 1982 only to reform in the early 1990's to perform at the 'Madstock' Festival in Finsbury Park headlined by Madness.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"faqs\":[],\"marketeers\":[{\"id\":1987,\"name\":\"SJM Concerts\",\"privacy_policy_link\":\"https://privacy.sjmconcerts.com/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_