"impression_id\":\"a3ead428a6c1b92b:45\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1755601200,\"id\":\"68a35b831fba89000127d762\",\"name\":\"Central Line\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**A celebration of Britain’s legendary underground funk scene with one of the era’s original pioneering live acts — Central Line.**\\n\\nFormed by members who would later shape groups such as Light of the World and Imagination, Central Line helped define the sound of Brit Funk.\\n\\nWith their irresistible blend of soulful grooves and funk energy, they delivered club anthems such as **‘Walking Into Sunshine’** and **‘Nature Boy’** — tracks that lit up dance floors on both sides of the Atlantic.\\n\\nHaving toured alongside icons including Roy Ayers, Grover Washington, Fat Larry’s Band and The Real Thing, Central Line remain one of the most vital forces of the era.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-05-27T00:00:00+01:00\",\"sale_end_date\":\"2026-03-07T23:00:00+00:00\",\"sale_start_date\":\"2025-05-27T00:00:00+01:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvbw99-special-friend-7th-mar-the-hope-and-anchor-london-tickets\",\