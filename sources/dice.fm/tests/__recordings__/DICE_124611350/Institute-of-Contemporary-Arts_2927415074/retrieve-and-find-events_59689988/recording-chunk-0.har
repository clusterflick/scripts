\":false,\"impression_id\":\"19a35eea7aa005ca:49\",\"date_unix\":1774980000,\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/G674492bc142?dice_id=G674492bc142\",\"post_competition_referral\":\"https://link.dice.fm/pcdd784ea96f?dice_id=pcdd784ea96f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/qc01099fa8e4?dice_id=qc01099fa8e4\",\"post_purchase_referral\":\"https://link.dice.fm/J30f46d49202?dice_id=J30f46d49202\",\"post_reminder_referral\":\"https://link.dice.fm/N1c5c307e6ae?dice_id=N1c5c307e6ae\",\"post_waitinglist_referral\":\"https://link.dice.fm/N54295e01562?dice_id=N54295e01562\"},\"perm_name\":\"eo33wd--playback-bad-bunny-candlelit-sessions-31st-mar-night-tales-loft-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/2b38bf65-a427-4d90-b328-796140db2b11.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/2b38bf65-a427-4d90-b328-796140db2b11.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/2b38bf65-a427-4d90-b328-796140db2b11.jpg?rect=338%2C0%2C825%2C1500\"},\"properties\":[],\"about\":{\"description\":\"**Presented by Johnnie Walker Black Label × NT’s Loft**\\n\\nOn Tuesday, 31st March, we turn our focus to Bad Bunny, a high-energy yet deeply expressive journey through one of the most influential artists of his generation. From the genre-blurring impact of X 100PRE and YHLQMDLG, to the global dominance of Un Verano Sin Ti and the raw, defiant spirit of Nadie Sabe Lo Que Va a Pasar Mañana, this session explores the sound, emotion and cultural force that have redefined modern Latin music.\\n\\nPlayback returns as a candlelit listening experience where over 200 candles transform NT’s Loft into a glowing sanctuary. Designed to slow the pace, each session invites guests to disconnect from the noise and fully immerse themselves in the music shaping global culture.\\n\\nExperience every rhythm, lyric and bassline through the warmth and precision of Funktion-One sound, in an intimate, candlelit setting.\\n\\nJohnnie Walker Black Label returns to elevate the evening, with signature serves available throughout the night. **Guests arriving before 8pm will receive a complimentary drink to begin the evening in style (Limited to First 50 Customers).**\\n\\n—\\n\\nTickets\\n\\nReserved seating ticket holders must arrive by 8:00 PM. **Seating is first come, first served.**\\n\\n—\\n\\nSchedule\\n\\n7:00 PM – Doors & Playlist\\n\\n8:15 PM – Listening Session Begins (90 mins)\\n\\nLimited capacity. Arrive early, stay late.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event. Bring your ID card with you. ID Scanner in place. \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"696f6cfc6e546f0001933c5a\",\"name\":\" Playback: Bad Bunny [Candlelit Sessions]\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T12:00:00+00:00\",\"sale_end_date\":\"2026-03-31T18:00:00+01:00\",\"sale_start_date\":\"2026-01-28T18:00:00+00:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":68519,\"title\":\"Ticket Terms and Conditions\",\"body\":\"ID to match ticket purchase required on entry \\n\\nNo filming \\n\\nNo photos\\n\\nTickets are Non-transferable \\n\\nIf you are unable to attend please return your tickets to the DICE Waiting List\",\"order\":0}],\"marketeers\":[{\"id\":19,\"name\