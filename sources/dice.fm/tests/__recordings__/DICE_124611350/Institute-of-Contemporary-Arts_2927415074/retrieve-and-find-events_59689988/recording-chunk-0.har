attendance_type\":\"live_only\",\"announcement_date_unix\":1769068800,\"id\":\"696fc92a688ab00001d71104\",\"name\":\"Camden Songwriting Circle\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":true,\"about\":{\"description\":\"An evening of acoustic music focusing on the songwriting of 4 amazing independent acts and their writing process.\\n\\nThe songwriting circle setup was created in Nashville and is a showcase where all artists are on stage at the same time, for the whole duration of the event. It is played in 'rounds' where each artists takes a turn playing a song. In our case, artists will perform a total of 3 original songs/rounds. After each round either the host or audience will have a chance to ask songwriting related questions to the performers.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"127382\",\"name\":\"Camden Songwriting Circle\",\"image\":{\"url\":null},\"perm_name\":\"camden-songwriting-circle-8bpar\",\"profile_active\":false},\"date_unix\":1771959600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T09:00:00+00:00\",\"sale_end_date\":\"2026-02-24T19:00:00+00:00\",\"sale_start_date\":\"2026-01-17T09:00:00+00:00\",\"event_start_date\":\"2026-02-24T19:00:00+00:00\",\"event_end_date\":\"2026-02-24T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvk7w5-the-season-the-roebucks-jonique-softtop-24th-feb-the-ivy-house-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Roebucks - Heavy Eyes\",\"redirect_url\":\"https://open.spotify.com/track/6KKB7NV50gSEq2jOHqMaBQ\",\"art