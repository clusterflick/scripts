ce-media.imgix.net/attachments/2026-01-28/c0359a6c-678e-403e-b4d2-bdcd5e80aed1.jpg?rect=0%2C47%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/c0359a6c-678e-403e-b4d2-bdcd5e80aed1.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/c0359a6c-678e-403e-b4d2-bdcd5e80aed1.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"sold-out\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ja18eded5635?dice_id=Ja18eded5635\",\"post_competition_referral\":\"https://link.dice.fm/yfc85e1a0443?dice_id=yfc85e1a0443\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/A93582eb0d95?dice_id=A93582eb0d95\",\"post_purchase_referral\":\"https://link.dice.fm/e007e50166bb?dice_id=e007e50166bb\",\"post_reminder_referral\":\"https://link.dice.fm/Q6598e3fad7a?dice_id=Q6598e3fad7a\",\"post_waitinglist_referral\":\"https://link.dice.fm/hcbceb904309?dice_id=hcbceb904309\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[{\"id\":2092,\"name\":\"Third Man Records\",\"privacy_policy_link\":\"https://thirdmanrecords.com/pages/privacy-policy#:~:text=Third%20Man%20Records%20may%20disclose,such%20law%2C%20request%20or%20court.\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:88\",\"properties\":[],\"presented_by\":\"Presented by Third Man Records.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769767200,\"id\":\"697722987752d6000159abb9\",\"name\":\"ELLiS·D \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"ELLiS·D spent his formative years flailing his limbs across the tattered kits of Europe's basement scene before launching a solo project in 2022. In three short years he has painted the walls of sweaty dives, concert halls and festivals stages across the continent with his dizzying brand of psychedelic art-punk, moving into 2026 on the artists to watch list of DIY, DORK and Far Out.\\n\\n2025 saw the release of sophomore EP ‘Spill’, marked by the epic seven minute motorik-glam single ‘Drifting’ and leading to festival appearances at The Great Escape, Haldern Pop, Best Kept Secret and many more to cement ELLiS·D as one of the year's breakout acts. Thrown together with his other role as the drummer for Fat Dog, ELLiS·D has built a reputation from his tireless touring schedule and electrifying live performances as one of the hardest working artists on the circuit, notching up no less than 150 shows in 2025 alone.\\n\\n“Imagine if David Byrne and David Bowie merged in a bizarre scene from a 1980s sci-fi bonanza. Then imagine if that new beast wandered into a goth club during that same era. Half glam rock, half neurotic punk but fully stylistic in its musical carnage. The result is ELLiS·D.” - Far Out\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4905\",\"name\":\"Third Man Records\",\"image\":{\"url\":null},\"perm_name\":\"third-man-records-gyl2\",\"profile_active\":true},\"date_unix\":1771959600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2390},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T10:00:00+00:00\",\"sale_end_date\":\"2026-02-24T17:00:00+00:00\",\"sale_start_date\":\"2026-02-04T10:00:00+00:00\",\"event_start_date\":\"2026-02-24T19:00:00+00:00\",\"event_end_date\":\"2026-02-24T23:00:00+00:00\",\"is_mult