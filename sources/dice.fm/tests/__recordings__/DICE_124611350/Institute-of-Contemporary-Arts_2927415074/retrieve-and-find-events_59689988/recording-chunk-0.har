ce_id=c1f8921584f8\",\"post_purchase_referral\":\"https://link.dice.fm/Q680ab26c3ac?dice_id=Q680ab26c3ac\",\"post_reminder_referral\":\"https://link.dice.fm/Yd2447d03bd4?dice_id=Yd2447d03bd4\",\"post_waitinglist_referral\":\"https://link.dice.fm/y4603f7f89a5?dice_id=y4603f7f89a5\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":469,\"name\":\"Number 90 London\",\"privacy_policy_link\":\"https://number90bar.co.uk/privacy-policy/\",\"fb_pixel_id\":\"795025754901092\",\"ga_tracking_id\":\"UA-107908506-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:31\",\"properties\":[],\"presented_by\":\"Presented by The Prog Lab & Gemini Sounds\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767659400,\"id\":\"695d9f65c07dc600019d9941\",\"name\":\"The Prog Lab x Gemini Sounds presents Tim Green\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Prog Lab and Gemini Sounds join forces for the first time in London, marking the beginning of an exciting new series of collaborative events dedicated to progressive, melodic, and organic house. This debut edition takes place at the stunning Number 90 Hideout in Hackney Wick, one of the capital’s most talked-about new venues — an intimate riverside space that perfectly captures the underground energy both brands are known for.\\n\\nHeadlining the night is Tim Green, one of the most forward-thinking and innovative artists in the modern electronic landscape. Known for his genre-defining productions on labels like All Day I Dream, Lost Miracle, and Balance, Tim’s sound bridges emotional depth with intricate rhythm — a seamless journey through texture, melody, and atmosphere. His music has earned him a devoted global following, and for this event, he’ll be delivering an exclusive three-hour set designed to immerse the crowd from start to finish.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2355\",\"name\":\"Number 90 London \",\"image\":{\"url\":null},\"perm_name\":\"number-90-london-7o86\",\"profile_active\":false},\"date_unix\":1771711200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":550},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-07-02T14:00:00+01:00\",\"sale_end_date\":\"2026-02-22T04:00:00+00:00\",\"sale_start_date\":\"2024-07-02T14:00:00+01:00\",\"event_start_date\":\"2026-02-21T22:00:00+00:00\",\"event_end_date\":\"2026-02-22T07:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"k6nx89-subvrs-payback-special-5-tickets-21st-feb-egg-ldn-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T22:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/6bce77f9-7e8e-46e0-a970-cda6b1b48eec.jpg?rect=0%2C180%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/6bce77f9-7e8e-46e0-a970-cda6b1b48eec.jpg?rect=0%2C396%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/6bce77f9-7e8e-46e0-a970-cda6b1b48eec.jpg?rect=144%2C0%2C792%2C1440\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Xf2452dcb3d9?dice_id=Xf2452dcb3d9\",\"post_competition_referral\":\"https://link.dice.fm/b59aab6d2267?dice_id=b59aab6d2267\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Feb11f3bd56f?dice_id=Feb11f3bd56f\",\"post_purchase_referral\":\"https://link.dice.fm/H66cccae8e84?dice_id=H66cccae8e84\",\"post_reminder_referral\":\"https://link.dice.fm/Ga8bb3f89fac?dice_id=Ga8bb3f89fac\",\"post_waitinglist_referral\":\"https://link.dice.fm/L95b53a152c9?dice_id=L95b53a152c9\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"db136d3610fd9326:32\",\"properties\":[],\"presented_by\":\"Presented by EGG.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1719925200,\"id\":\"691b4e28bc542c0001dff9c5\",\"name\":\"Subvrs / Payback Special / £5 Tickets\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Saturday 21st February – Egg LDN Pres: SUBVRS - Tech House, Deep Tech & Deep House\\n\\nSUBVRS lands at Egg London for a night dedicated to the deeper shades of the underground. Taking over the club with a blend of Tech House, Deep Tech, and Deep House, expect rolling grooves, stripped-back rhythms, and hypnotic energy across the dancefloor. Doors open at 10:00pm, with £5 entry before 11pm and selected drinks for £5 until 11pm. Egg will be open late as usual, with last entry at 5am, giving you the full night to experience SUBVRS’ signature sound in King’s Cross.\\n\\nEntry Policy at Egg London\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"date_unix\":1771711200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1257,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T16:00:00+00:00\",\"sale_end_date\":\"2026-02-22T01:00:00+00:00\",\"sale_start_date\":\"2026-02-06T16:00:00+00:00\",\"event_start_date\":\"2026-02-21T23:00:00+00:00\",\"event_end_date\":\"2026-02-22T04:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"92ab67-sigma-dj-q-anas-and-flo-21st-feb-xoyo-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Zip Zap\"