ps://dice-media.imgix.net/attachments/2026-01-26/6a977c7c-854c-4eec-b5a0-8f4dd09a539b.jpg?rect=0%2C0%2C6212%2C6212\"},\"artist_id\":\"75406\",\"about\":null,\"is_headliner\":false},{\"name\":\"GABI\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-12/b3bda567-98b0-4332-b9d8-ca05aa9d4575.jpg?rect=0%2C29%2C582%2C582\"},\"artist_id\":\"52758\",\"about\":null,\"is_headliner\":false}],\"total_artists\":21,\"total_free_texts\":0},\"faqs\":[{\"id\":58193,\"title\":\"Accessiblity\",\"body\":\"We’re on a mission to make RALLY as inclusive as it can be. This includes making the information around accessibility as useful as possible. Here you’ll find everything you need to know about accessibility at RALLY. If you have any questions, please get in touch.\\n\\nAccess information contact: Daniel Lawson\\n\\nEmail: access@rallyrallyrally.co.uk\\n\\nIf you prefer to speak over the phone or by any other means of communication, please email saying so and Daniel can contact you directly to arrange.\\n\\nFor more information, please visit our website here: https://rallyrallyrally.co.uk/page/information\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/08ec6a90-0482-425d-b17f-ec39b3c858e2.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/08ec6a90-0482-425d-b17f-ec39b3c858e2.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/08ec6a90-0482-425d-b17f-ec39b3c858e2.jpg?rect=506%2C0%2C1238%2C2250\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1762855200,\"max_tickets\":6,\"marketeers\":[{\"id\":2263,\"name\":\"Rally Festival \",\"privacy_policy_link\":\"https://rallyrallyrally.co.uk/page/information\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_