\"https://link.dice.fm/s137e1f6cfe4?dice_id=s137e1f6cfe4\",\"post_purchase_referral\":\"https://link.dice.fm/T98dac89f667?dice_id=T98dac89f667\",\"post_reminder_referral\":\"https://link.dice.fm/g9dbada021e0?dice_id=g9dbada021e0\",\"post_waitinglist_referral\":\"https://link.dice.fm/k42c428deafb?dice_id=k42c428deafb\"},\"perm_name\":\"2wkyg6-the-boo-radleys-live-signing-1st-may-rough-trade-east-london-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/1121a1c9-a54c-4979-962e-d84e76f4c773.jpg?rect=1000%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/1121a1c9-a54c-4979-962e-d84e76f4c773.jpg?rect=0%2C200%2C6000%2C3600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/1121a1c9-a54c-4979-962e-d84e76f4c773.jpg?rect=1900%2C0%2C2200%2C4000\"},\"properties\":[],\"about\":{\"description\":\"Rough Trade East is very excited to present a live performance and signing from The Boo Radleys. This unique event celebrates the release of their new album 'In Spite Of Everything' released via label.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com/products/in-spite-of-everything\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697b3c2e3287b700017fc4c3\",\"name\":\"The Boo Radleys: Live + Signing\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Boo Radleys - Solarcide\",\"redirect_url\":\"https://open.spotify.com/track/3o0NbtwdJKvgTbCygPGzCh\",\"artist\":\"The Boo Radleys\",\"preview_url\":\"https://p.scdn.co/mp3-preview/af19825c493888fff78d3982e66c0e3846d56b55?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Solarcide\"},{\"type\":\"apple_music\",\"title\":\"The Boo Radleys - Solarcide\",\"redirect_url\":\"https://music.apple.com/us/album/solarcide/1843479645?i=1843479647&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Boo Radleys\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/16/84/24/168424fe-6e58-be6b-5c67-67187fb2bb51/mzaf_11689138171760114060.plus.aac.p.m4a\",\"track_name\":\"Solarcide\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Boo Radleys\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2c69dbbd8e015639418e44a5\"},\"artist_id\":\"31038\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T10:00:00+00:00\",\"sale_end_date\":\"2026-05-01T21:30:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-05-01T19:00:00+01:00\",\"event_end_date\":\"2026-05-01T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":225,\"name\":\"Bad Vibrations\",\"privacy_policy_link\":\"http://www.badvibrations.co.uk/privacy-policy-mojave\",\"f