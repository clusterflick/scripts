s://link.dice.fm/q4d9918be28e?dice_id=q4d9918be28e\",\"post_purchase_referral\":\"https://link.dice.fm/n3ecc5c98333?dice_id=n3ecc5c98333\",\"post_reminder_referral\":\"https://link.dice.fm/r044348fc455?dice_id=r044348fc455\",\"post_waitinglist_referral\":\"https://link.dice.fm/a91bc54b0390?dice_id=a91bc54b0390\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ryn2p5-el-bho-oceanvs-orientalis-18th-apr-colour-factory-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776546000,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:45\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1494},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-23/b6e88509-03fa-4812-87e4-272123500aeb.jpg?rect=0%2C274%2C1372%2C1372\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-23/b6e88509-03fa-4812-87e4-272123500aeb.jpg?rect=0%2C549%2C1372%2C823\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-23/b6e88509-03fa-4812-87e4-272123500aeb.jpg?rect=158%2C0%2C1056%2C1920\"},\"id\":\"694a799d0de42a0001dbadd5\",\"name\":\"El Búho & Oceanvs Orientalis\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Latin American folk rhythms, earthy sounds, and tropic birdsong will meet downtempo dancefloor electronica, as El Búho returns to London for a spring dancefloor experience.\\n\\nMexico City’s own pioneer will craft a hypnotic soundscape blending global rhythms with electronic dance music influenced drums. Loved for his fully immersive performances that capture bliss & euphoria worldwide, you can get a taste of these sonic tales through the treasure chest that is his release discography…\\n\\nSetting the tone for the night, Oceanvs Orientalis joins as special support, bringing with him a rich blend of hypnotic, cross-cultural electronic rhythms merged with an archaeological serving of Eastern influenced percussive sounds.\\n\\nWe can’t wait to get mesmerised in that signature euphoric El Búho dancefloor sound this April.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-23T15:00:00+00:00\",\"sale_end_date\":\"2026-04-18T22:00:00+01:00\",\"sale_start_date\":\"2025-12-29T13:00:00+00:00\",\"event_start_date\":\"2026-04-18T22:00:00+01:00\",\"event_end_date\":\"2026-04-19T04:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 18 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"