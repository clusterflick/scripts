\"currency\":\"GBP\",\"amount\":4180,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by DMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1768\",\"name\":\"DMP\",\"image\":{\"url\":null},\"perm_name\":\"dmp-d5kq\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"nvwqy8-the-ukulele-orchestra-of-great-britain-20th-jun-union-chapel-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781976600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:64\",\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-20T18:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Ukulele Orchestra of Great Britain\",\"image\":null,\"artist_id\":\"130731\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Last year marked the 40th anniversary of The Ukulele Orchestra of Great Britain, who, from their humble beginnings in small rooms above old pubs, took the world by storm with their off-beat humour and four-stringed virtuosity.\\n\\nFormed in 1985 as an antidote to the ego-driven bluster of the music industry, “The Ukes” soon became the unlikely superheroes of the international touring circuit, spreading their irrepressible magic from Australasia to the North Pole, from Windsor Castle to Carnegie Hall.\\n\\nMillions of plucks later, they are still thrilling audiences with their all-singing, all-strumming, full-throttle, foot-stomping concerts.\\n\\nThere are no drums, pianos, backing tracks, guitars or banjos; no pitch-shifters or electronic trickery—just the astonishing revelation of richly orchestrated, differently tuned ukuleles paired with dynamic vocals.\\n\\nThis is an orchestra like no other. These are the sultans of ping.\\n\\nBuckle up for a helter-skelter ride through every kind of musical genre, with plenty of laughs along the way. There is something for everyone in this unique programme of Classical, Pop, Punk, Funk, Disco, Bluegrass and Metal.\\n\\nNobody does it quite like The Ukes.\\n\\n“The best musical entertainment in the country.” — The Independent\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event - under 14s with an adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T00:00:00+00:00\",\"sale_end_date\":\"2026-06-20T18:00:00+01:00\",\"sale_start_date\":\"2025-11-27T12:00:00+00:00\",\"event_start_date\":\"2026-06-20T18:30:00+01:00\",\"event_end_date\":\"2026-06-20T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"692719287854da0001625a49\",\"name\":\"The Ukulele Orchestra of Great Britain\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/cf23dd1f-4f50-429f-9877-e9ee72d97e6a.jpg?rect=106%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/cf23dd1f-4f50-429f-9877-e9ee72d97e6a.jpg?rect=