x\":1768381200,\"social_links\":{\"event_share\":\"https://link.dice.fm/r98b916d5019?dice_id=r98b916d5019\",\"post_competition_referral\":\"https://link.dice.fm/G4157df0491d?dice_id=G4157df0491d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g9bf07ca1da9?dice_id=g9bf07ca1da9\",\"post_purchase_referral\":\"https://link.dice.fm/P305fa446c06?dice_id=P305fa446c06\",\"post_reminder_referral\":\"https://link.dice.fm/U5fc05ccac4d?dice_id=U5fc05ccac4d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Paa2cf500743?dice_id=Paa2cf500743\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"g5d9dp-hackpen-sid-plimmer-7th-apr-the-ivy-house-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775586600,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:96\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":750},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/48fe731e-2e77-4e49-86a0-03aba3f6d4f3.jpg?rect=0%2C204%2C997%2C997\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/48fe731e-2e77-4e49-86a0-03aba3f6d4f3.jpg?rect=0%2C404%2C997%2C598\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/48fe731e-2e77-4e49-86a0-03aba3f6d4f3.jpg?rect=112%2C0%2C773%2C1405\"},\"id\":\"695bd94ae5759c000195ec7a\",\"name\":\"Hackpen + Sid Plimmer\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"New Lands returns with another banger; Hackpen and Sid Plimmer make it a family affair at The Ivy House on Tuesday 7th April!\\n\\nHackpen is the new audio-visual alias of Moss Plimmer. Areas of interest include hammers, boiled eggs, the British coastal path, fossils cracking, pure wool, train travel, ‘happy friday’ (as a concept), soil, fire, pedestrians, the universal key, land mass, pen knives, pork pies, motorcycles in colour, daylight saving, the light and heat survival can, gargoyles, the meaning behind the mound, rocks, storm certificates, the west country and beer out the glass bottle.\\n\\nSid Plimmer is a 24 year old artist from the Mendip hills in Somerset. His latest album is about a blue horse. It is about moving fast and standing still all at once. It is about diesel, social misfires and children of the gods stealing the sun.\\n\\nFormerly Plimmer released a number of projects under the now-defunct alias of BoyBovis. A trilogy of albums that dealt mainly with rurality, belonging and dark places underground.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T09:00:00+00:00\",\"sale_end_date\":\"2026-04-07T17:00:00+01:00\",\"sale_start_date\":\"2026-01-14T09:00:00+00:00\",\"event_start_date\":\"2026-04-07T19:30:00+01:00\",\"event_end_date\":\"2026-04-07T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Colours.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"839\",\"name\":\"Colours Hoxton\",\"address\":\"2-4 Hoxton Square, London N1 6NU\",\"location\":{\"lat\":51.527453,\"lng\":-0.0816949999999679},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\