k\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"421051646826847\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2075,\"name\":\"KOKO 2\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"2512980718968598\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776459600,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:13\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3226},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/27853f46-5620-4b10-bac8-aecc068d6752.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/27853f46-5620-4b10-bac8-aecc068d6752.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/27853f46-5620-4b10-bac8-aecc068d6752.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6929879750d1160001eaaa65\",\"name\":\"Franky Wah (All Night Long)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Franky Wah, a Yorkshire native, epitomises contemporary club culture with chart-topping releases blending emotion, dance energy, and catchy hooks.\\n\\nHe joins us for an all night long journey in the theatre.\\n\\n**IMPORTANT INFORMATION:**\\n\\nFeeling peckish? Join us every Friday from 7pm-12am at Don KOKO, for pizzas & cocktails curated by What Willy Cook, SG Lewis, DJ Tennis, Natasha Diggs, Carlita & many more – check your emails for a 20% discount link. Or head to @donkokofc for reservations & offers.\\n\\nFor VIP & areas please email: bookings@KOKO.co.uk (available on selected nights only).\\n\\nPlease arrive according to the time on your ticket for a smooth and guaranteed entry.\\n\\nWe have a zero tolerance policy towards harassment and prejudice. If you are made to feel uncomfortable in any way, please do not hesitate to speak to any member of staff and we will help immediately.\\n\\nAny unattended drinks will be discarded.\\n\\nPlease do not purchase tickets through social media, we are unable to help with anyone who has been scammed.\\n\\nWe operate a zero tolerance drug policy.\\n\\nKOKO is 19+. No physical ID, no entry.\\n\\nLast entry 3am. No readmission.\\n\\n**TO PREVENT RESELLING AND UNAUTHORISED USE OF TICKETS**\\n\\nTickets cannot be resold or transferred to another person through third party platforms such as Ticketswap.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 19+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T00:00:00+00:00\",\"sale_end_date\":\"2026-04-18T05:00:00+01:00\",\"sale_start_date\":\"2025-11-28T00:00:00+00:00\",\"event_start_date\":\"2026-04-17T22:00:00+01:00\",\"event_end_date\":\"2026-04-18T05:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"House Gospel Choir\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb874a53ad0ff68bb5a6655796\"},\"artist_id\":\"5521\",\"about\":{\"description\":\"Inspired by the south London Pentecostal churches she sang in and the underground raves she danced in, Natalie Maddix formed the now 150-strong ensemble House Gospel Choir in 2014. They’ve since reimagined dancefloor classics on RE//CHOIRED (2020), collaborated with Oliver Heldens and Rudimental, and performed at KOKO and on Glastonbury’s Acoustic Stage.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":30466,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T22:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1766397600,\"social_links\":{\"event_share\":\"https://link.dice.fm/bfdadbdf6cc6?dice_id=bfdadbdf6cc6\",\"post_competition_referral\":\"https://link.dice.fm/n63dc0530245?dice_id=n63dc0530245\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S8fc68a024d2?dice_id=S8fc68a024d2\",\"post_purchase_referral\":\"https://link.dice.f