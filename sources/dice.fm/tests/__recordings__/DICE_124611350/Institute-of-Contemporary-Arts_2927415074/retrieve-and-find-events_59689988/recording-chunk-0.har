":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":627,\"name\":\"Colours\",\"privacy_policy_link\":\"https://colourshoxton.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779627600,\"venues\":[{\"id\":\"839\",\"name\":\"Colours Hoxton\",\"address\":\"2-4 Hoxton Square, London N1 6NU\",\"location\":{\"lat\":51.527453,\"lng\":-0.0816949999999679},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"colours-hoxton-mxew\",\"accessibility\":{\"url\":\"https://colourshoxton.com/wp-content/uploads/2022/02/Colours-Accessibility-Document.pdf\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-24T14:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:70\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"99\",\"name\":\"Colours Hoxton\",\"image\":{\"url\":null},\"perm_name\":\"colours-hoxton-zl3w\",\"profile_active\":false},\"id\":\"696fe4789edb95000194a029\",\"name\":\"CloseUp Festival 2026 w/ Pale Blue Eyes\",\"perm_name\":\"2wk8r7-closeup-festival-2026-w-pale-blue-eyes-24th-may-colours-hoxton-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/9c117471-a1aa-459c-9722-bba2d639ad03.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/9c117471-a1aa-459c-9722-bba2d639ad03.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/9c117471-a1aa-459c-9722-bba2d639ad03.jpg?rect=173%2C0%2C422%2C768\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1769162400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1925,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T10:00:00+00:00\",\"sale_end_date\":\"2026-05-24T16:30:00+01:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-05-24T18:00:00+01:00\",\"event_end_date\":\"2026-05-24T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/c551f604f2bb?dice_id=c551f604f2bb\",\"post_competition_referral\":\"https://link.dice.fm/E8b6a6539f19?dice_id=E8b6a6539f19\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w6ab91747af2?dice_id=w6ab91747af2\",\"post_purchase_referral\":\"https://link.dice.fm/F1441d3aaaa9?dice_id=F1441d3aaaa9\",\"post_reminder_referral\":\"https://link.dice.fm/u0b42b11ac2c?dice_id=u0b42b11ac2c\",\"post_waitinglist_referral\":\"https://link.dice.fm/I8e55c4560c2?dice_id=I8e55c4560c2\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Chez Kane is a British rock singer and songwriter from Wales, known for her powerful voice and retro-inspired style. She first gained recognition from the band Kane’d, which she formed with her 2 sisters.\\n\\nIn 2020, Chez Kane launched her solo career after being discovered by Danny Rexon, frontman of the Swedish rock band Crazy Lixx. He produced her debut self-titled solo album, which was released in 2021 under Frontiers Music. The album received praise for its infectious hooks, catchy melodies, and strong 80s rock vibe, drawing comparisons to artists like Pat Benatar and Vixen.\\n\\nChez Kane’s success continued with her second album, Powerzone, re-leased in 2022, further establishing her as a leading voice in the modern rock scene. Known for her energetic performances and dynamic stage presence, Chez Kane is celebrated for reviving the spirit of 80s rock with a modern twist.\\n\\nNow, Chez is entering her boldest era yet. Her brand new single “Reckless” was released on September 17, 2025, earning airplay on mainstream BBC Radio Wales and being named one of the Tracks of the Week by Classic Rock Magazine. The track is more than just a single, it’s a statement of in-tent. Chez is determined to bring rock back into the mainstream once and for all, proving that the genre still belongs on big radio platforms and in front of wide audiences.\\n\\nReckless is the first taste of her forthcoming third album of the same name, due in 2026 via Frontiers Music Srl. Produced once again by Danny Rexon, the record promises a bigger, edgier sound, full of the anthemic spirit and fiery, passionate attitude that defines Chez Kane.\\n\\nWith global recognition, critical acclaim, and a rapidly growing fanbase, Chez Kane is proving that rock still has icons in the making... and she’s one of them!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779642000,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-24T18:00:00+01:00\",\"doors_close_date\":\"2026-05-24T22:00:00+01:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:71\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"6926c8c2fec64a000128e595\",\"name\":\"CHEZ KANE\",\"perm_name\":\"2w72mo-chez-kane-24th-may-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/41f72873-0b79-44b2-9b1c-7c42c06ac606.jpg?rect=0%2C325%2C2750%2C2750\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/41f72873-0b79-44b2-9b1c-7c42c06ac606.jpg?rect=0%2C734%2C2750%2C1650\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/41f72873-0b79-44b2-9b1c-7c42c06ac606.jpg?rect=518%2C0%2C1715%2C3118\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Chez Kane\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb61ab7954076665d4635c4eed\"},\"artist_id\":\"111955\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1764583200,\"faqs\":[{\"id\":59229,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":59230,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":59231,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Chez Kane - Too Late for Love\",\"redirect_url\":\"https://open.spotify.com/track/5DOZ3g4QE49ShqiXZq5JHf\",\"artist\":\"Chez Kane\",\"preview_url\":\"https://p.scdn.co/mp3-preview/553981daa9ae38b73dd96ba5204a9e61840551ae?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Too Late for Love\"},{\"type\":\"apple_music\",\"title\":\"Chez Kane - Too Late for Love\",\"redirect_url\":\"https://music.apple.com/us/album/too-late-for-love/1541892032?i=1541893207&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Chez Kane\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/de/6b/58/de6b5837-1b92-9bfc-7a90-e2651f8eed07/mzaf_15978391673987225385.plus.aac.p.m4a\",\"track_name\":\"Too Late for Love\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-09T00:00:00+01:00\",\"sale_end_date\":\"2026-05-22T16:30:00+01:00\",