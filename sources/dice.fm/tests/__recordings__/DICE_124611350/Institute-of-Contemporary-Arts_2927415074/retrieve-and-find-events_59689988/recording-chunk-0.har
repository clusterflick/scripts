n_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1428,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by REAL\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"k69e28-champion-trees-10th-jun-the-old-church-stoke-newington-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781114400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"announced\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:11\",\"venues\":[{\"id\":\"1565\",\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church St, Stoke Newington, London N16 9ES, UK\",\"location\":{\"lat\":51.5613778,\"lng\":-0.0847131000000445},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-church-stoke-newington-x9am\",\"accessibility\":{\"url\":\"https://www.theoldchurch.org.uk/access\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-10T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"about\":{\"description\":\"**Champion Trees -** formed when cousins Francis Christie (vocal, guitar) and Lex Pienaar (bass) got together with drummer Langa Dubazana at the University of Cape Town. Taking notes from 90s luminaries Belle & Sebastian and Pavement, they set out to have fun with music and language, building a following on the back of their well-received 2022 debut album NOW 3000. The lush arrangements of newly released second album A Duck’s Water Off My Back are a marked departure from the lean production of the band’s early material, thanks in part to the addition of new members James Bickford-Smith (violin, synthesizers), Michael Burke (saxophone), and Michelle Hromin (clarinet), whose contributions have brought new textural depth to the music. A Duck’s Water Off My Back has greatly expanded the band's following, particularly after it received critical acclaim from Outside Noise, who maintain that it features \\\"some of the most beautiful poetry we've heard in independent music all year\\\".\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T11:00:00+00:00\",\"sale_end_date\":\"2026-06-10T23:00:00+01:00\",\"sale_start_date\":\"2026-03-03T11:00:00+00:00\",\"event_start_date\":\"2026-06-10T19:00:00+01:00\",\"event_end_date\":\"2026-06-10T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69944eb2858b820001f632c5\",\"name\":\"Champion Trees\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/5b6174a8-9b24-46f7-8136-f7a3f02ba828.jpg?rect=384%2C0%2C2304%2C2304\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/5b6174a8-9b24-46f7-8136-f7a3f02ba828.jpg?rect=0%2C231%2C3072%2C1843\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/5b6174a8-9b24-46f7-8136-f7a3f02ba828.jpg?rect=903%2C0%2C1267%2C2304\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771326000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/j3004007d794?dice_id=j3004007d794\",\"post_competition_referral\":\"https://link.dice.fm/j678562baf6c?dice_id=j678562baf6c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/sc91d5601e41?dice_id=sc91d5601e41\",\"post_purchase_referral\":\"https://link.dice.fm/Pfd18bfb7839?dice_id=Pfd18bfb7839\",\"post_reminder_referral\":\"https://link.dice.fm/D0aea65426fd?dice_id=D0aea65426fd\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ge6bfba8b750?dice_id=Ge6bfba8b750\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Champion Trees - I Wear a Shirt That Says Australia\",\"redirect_url\":\"https://open.spotify.com/track/0iA5kbj14o3IMfjkN0Fgtp\",\"artist\":\"Champion Trees\",\"preview_url\":\"https://p.scdn.co/mp3-preview/250c0f564e04a6b5a71232a160c3f496b937b893?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I Wear a Shirt That Says Australia\"},{\"type\":\"apple_music\",\"title\":\"Champion Trees - I Wear a Shirt That Says Australia\",\"redirect_url\":\"https://music.apple.com/us/album/i-wear-a-shirt-that-says-australia/1850483302?i=1850483303&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Champion Trees\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/f0/fa/09/f0fa0993-eddd-bf16-efd0-619adce8260a/mzaf_2015198361238982080.plus.aac.p.m4a\",\"track_name\":\"I Wear a Shirt That Says Australia\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2344,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":73302,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73303,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73304,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"8e8dxr-holywatr-10th-jun-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1781114400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:12\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-10T19:00:00+01:00\",\"doors_close_date\":\"2026-06-10T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Holywatr\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb703e7ff8a1957fe6281fe173\"},\"artist_id\":\"109907\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Holywatr is a unique, gritty blend of nu metal, emo, and hardcore. Inspired by alt-rock/metal legends like Deftones, Holywatr is forging a new path that transcends genres and leaves audiences begging for more.\\n\\nFresh off the viral success of their singles, Loose Ends, Fade, and Nail Polish - Holywatr has continued to stoke the fire on social media earning them millions of streams and a die-hard fanbase of over half a million monthly listeners. Armed with crushing riffs and soaring melodies, Holywatr is gearing up to drop a new full length project and cement their place as one of heavy music's most promising new acts.\\n\\nAges 14+ (Under 16s MUST be accompanied by an adult 18+). All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T15:00:00+00:00\",\"sale_end_date\":\"2026-06-10T17:30:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-06-10T19:00:00+01:00\",\"event_end_date\":\"2026-06-10T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"697d0d0231e0950001d82cd5\",\"name\":\"HOLYWATR\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/3d6537c6-9271-4992-83ab-9f9cbb684587.jpg?rect=0%2C0%2C4930%2C4930\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/3d6537c6-9271-4992-83ab-9f9cbb684587.jpg?rect=0%2C986%2C4930%2C2958\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/3d6537c6-9271-4992-83ab-9f9cbb684587.jpg?rect=1109%2C0%2C2712%2C4930\"},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_init