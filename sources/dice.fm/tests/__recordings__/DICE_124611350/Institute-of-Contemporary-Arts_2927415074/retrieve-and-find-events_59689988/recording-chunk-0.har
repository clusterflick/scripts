tus\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"11441\",\"name\":\"Dig That Treasure\",\"image\":{\"url\":null},\"perm_name\":\"dig-that-treasure-xoya\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:55\",\"date_unix\":1777833000,\"price\":{\"currency\":\"GBP\",\"amount\":1750,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/i122708bb30c?dice_id=i122708bb30c\",\"post_competition_referral\":\"https://link.dice.fm/N214633af0d5?dice_id=N214633af0d5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ic7cf46fedc1?dice_id=ic7cf46fedc1\",\"post_purchase_referral\":\"https://link.dice.fm/g8810dd52960?dice_id=g8810dd52960\",\"post_reminder_referral\":\"https://link.dice.fm/O403e1d3c4d1?dice_id=O403e1d3c4d1\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hefa03d21b07?dice_id=Hefa03d21b07\"},\"perm_name\":\"nv7xb3-eric-chenaux-harry-gorksi-brown-ensemble-irsahm-3rd-may-cafe-oto-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/41a6a31c-25eb-4c46-af1f-86a3e9be848f.jpg?rect=0%2C270%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/41a6a31c-25eb-4c46-af1f-86a3e9be848f.jpg?rect=0%2C702%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/41a6a31c-25eb-4c46-af1f-86a3e9be848f.jpg?rect=338%2C0%2C1485%2C2700\"},\"properties\":[],\"about\":{\"description\":\"*Dig That Treasure! and Baba Yaga's Hut present*\\n\\n**Dig That Treasure! Festival - Night Three**\\n\\n**Eric Chenaux**\\n\\nEric Chenaux is one of the great contemporary guitarists and experimental songsmiths. His work balances masterful improvisation and classic composition, at once giving nods to avant-garde noiseniks, folk songwriters and the great jazz singers. A former Wire Magazine coverstar and described by The Guardian as having \\\"one of the all-time great singing voices in popular music\\\", Chenaux is a bonafide legend and makes a timely return to Cafe Oto on the back of 2024's extraordinary 'Delights Of My Life'.\\n\\n**Harry Gorski-Brown**\\n\\nIn an age where traditional musics are dug up, polished and sold in increasingly banal forms, Harry Gorski-Brown’s melange of studio and live recordings, text-to-speech voices, deep drones and an oddball sense of humour feels truly radical. This comes as no surprise, given his latest album found a home on Scotland’s GLARC label, home also to Dig That Treasure! alum Max Syedtollan and Able Noise. His recordings are largely of Scottish-Gaelic folk songs, arranged for pipes, voice, bouzouki, fiddle and electronics.\\n\\n**Ensemble Irsahm**\\n\\nEnsemble Irsahm is a Belgian group formed of musicians from Créahmbxl (Création et Handicap Mental) and IRSA (Royal Institute for the Deaf and Blind). Together, the group reinterprets the music of Saint-Saens, Hildegard von Bingen, Bach and more with arrangements built around each of the musicians’ strengths.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69145519967d670001db082f\",\"name\":\"Eric Chenaux + Harry Gorksi-Brown + Ensemble Irsahm\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Eric Chenaux - Bird & Moon\",\"redirect_url\":\"https://open.spotify.com/track/1xwntm4UdMQJI5hOA6caVI\",\"artist\":\"Eric Chenaux\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9e8b90a091f209993b850156a223082ac445ca66?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Bird & Moon\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eric Chenaux\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/aeb0a93b1f33064e311dc8712718288ef32e45bd\"},\"artist_id\":\"6793\",\"about\":null,\"is_headliner\":false},{\"name\":\"Harry Gorski-Brown\",\"image\":null,\"artist_id\":\"119844\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sun 03 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T12:00:00+00:00\",\"sale_end_date\":\"2026-05-04T17:30:00+01:00\",\"sale_start_date\":\"2026-01-28T18:00:00+00:00\",\"event_start_date\":\"2026-05-04T19:00:00+01:00\",\"event_end_date\":\"2026-05-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":68524,\"title\":\"Ticket Terms and Conditions \",\"body\":\"ID to match ticket purchase required on entry\\n\\nNo filming\\n\\nNo photos\\n\\nTickets are Non-transferable\\n\\nIf you are unable to attend please return your tickets to the DICE Waiting List\",\"order\":0}],\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Eat Your Own Ears.\",\"sea