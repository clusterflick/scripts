,\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"xe27dl-loose-ends-12th-jun-the-jazz-cafe-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:28\",\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Loose Ends\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/91f4cd450d258d2965c7c807d32183bf26c4860a\"},\"artist_id\":\"4970\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"**Loose Ends have remained one of the UK's most beloved soul acts.**\\n\\nThe band made their mark with the unforgettable **'Hanging on a String'**, with the track topping the US charts and reaching the UK top 10 in 1985. They continued their winning streak with a string of transatlantic hits including **'Magic Touch'**, **'Slow Down'** and **'Watching You (Watching Me)'**.\\n\\nToday, founding member **Carl McIntosh** leads the current lineup alongside **Linda Carriere** and **Sunay Suleyman**, who joined in 1990. Together, they continue to deliver the **smooth soul** and irresistible rhythms that have kept audiences coming back for over three decades.\\n\\nAn evening of timeless hits and soulful classics, right in the heart of London's favourite live music venue.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T14:00:00+00:00\",\"sale_end_date\":\"2026-06-12T19:00:00+01:00\",\"sale_start_date\":\"2026-01-22T14:00:00+00:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696e565b5f4dec0001b0240c\",\"name\":\"Loose Ends\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=338%2C0%2C825%2C1500\"},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768917600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/rb14040d2033?dice_id=rb14040d2033\",\"post_competition_referral\":\"https://link.dice.fm/Y757ae76e097?dice_id=Y757ae76e097\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d9982d6ce745?dice_id=d9982d6ce745\",\"post_purchase_referral\":\"https://link.dice.fm/Z5a3b615fbb5?dice_id=Z5a3b615fbb5\",\"post_reminder_referral\":\"https://link.dice.fm/l201c25350fb?dice_id=l201c25350fb\",\"post_waitinglist_referral\":\"https://link.dice.fm/A261df4fdc8d?dice_id=A261df4fdc8d\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Loose Ends - Hangin' On a String\",\"redirect_url\":\"https://music.apple.com/gb/album/hangin-on-a-string/806234820?i=806238905&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Loose Ends\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview118/v4/57/92/97/579297e3-120c-b4a6-422b-cb06c4ca5fbd/mzaf_1287383862479936733.plus.aac.p.m4a\",\"track_name\":\"Hangin' On a String\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2450},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"v3ggpd-the-groove-chorus-12th-jun-the-clapham-grand-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":18,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:29\",\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"**FRIDAY 12TH JUNE / DOORS & BARS OPEN 7:00PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS / SHOW END 10:30PM / AFTER PARTY UNTIL 1AM!**\\n\\nNot your average choir - The Groove Chorus will be turning up the volume once again at The Clapham Grand! Featuring a choir of 50 and a mega 8-piece live band, they'll be bringing their iconic dance anthems with a disco twist, inspired by queer culture from the 80s to today (drenched in double denim of course). See you there! x\\n\\nFor any ticketing enquiries please contact DICE's Help Centre first, or contact info@claphamgrand.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T16:00:00+00:00\",\"sale_end_date\":\"2026-06-12T19:00:00+01:00\",\"sale_start_date\":\"2025-12-05T16:00:00+00:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-13T01:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6932d527ec268500019a7fe5\",\"name\":\"The Groove Chorus\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/e6c532a0-bc4c-4e12-936f-998b6a546e27.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/e6c532a0-bc4c-4e12-936f-998b6a546e27.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/e6c532a0-bc4c-4e12-936f-998b6a546e27.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764950400,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/fdb29f339bbc?dice_id=fdb29f339bbc\",\"post_competition_referral\":\"https://link.dice.fm/waf379a157c5?dice_id=waf379a157c5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q50d5c5d21d8?dice_id=Q50d5c5d21d8\",\"post_purchase_referral\":\"https://link.dice.fm/g92babe6e4e1?dice_id=g92babe6e4e1\",\"post_reminder_referral\":\"https://link.dice.fm/waa00e531611?dice_id=waa00e531611\",\"post_waitinglist_referral\":\"https://link.dice.fm/U50c233d329e?dice_id=U50c233d329e\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2750,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"6dwvn8-extc-this-is-pop-12th-jun-metronome-london-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:30\",\"venues\":[{\"id\":\"13429\",\"name\":\"Metronome London\",\"address\":\"41 Commercial Road, Tower Hamlets, London, E1 1LA, United Kingdom\",\"location\":{\"lat\":51.51502,\"lng\":-0.06587},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"metronome-london-gvg6\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"EXTC: XTC's Terry Chambers & friends\",\"image\":null,\"artist_id\":\"95079\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"XTC's legendary drummer, Terry Chambers, is back on the road with his band EXTC (named and approved by XTC frontman, Andy Partridge).\\n\\nEmerging out of the post-punk and new-wave explosion of the late 70s, XTC experienced global success touring with the likes of The Police and Talking Heads. Sadly, their legions of loyal fans would be left in limbo when in 1982 XTC stopped touring, becoming a studio-based entity.\\n\\nEXTC were formed in 2019 by XTC's drummer Terry Chambers, performing classic XTC material such as Making Plans For Nigel, Senses Working Overtime, Mayor of Simpleton, Generals and Majors, Sgt. Rock (Is Going To Help Me), Love on a Farmboy's Wages and many more.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T00:00:00+00:00\",\"sale_end_date\":\"2026-06-12T00:30:00+01:00\",\"sale_start_date\":\"2025-11-25T00:00:00+00:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6926304bbadc12000179e4cb\",\"name\":\"EXTC 'This Is Pop'\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/bca331d9-19ff-4a12-b80e-3eb3a0b8d2ac.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/bca331d9-19ff-4a12-b80e-3eb3a0b8d2ac.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/bca331d9-19ff-4a12-b80e-3eb3a0b8d2ac.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764028800,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/K88f367049c3?dice_id=K88f367049c3\",\"post_competition_referral\":\"https://link.dice.fm/B32721f34eb9?dice_id=B32721f34eb9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r677b2ec9476?dice_id=r677b2ec9476\",\"post_purchase_referral\":\"https://link.dice.fm/Keb6d61acf94?dice_id=Keb6d61acf94\",\"post_reminder_referral\":\"https://link.dice.fm/ja8d34fdd06e?dice_id=ja8d34fdd06e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ld54ecf191aa?dice_id=Ld54ecf191aa\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":3275,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"presented_by\":\"Presented by Kings Place.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"seats_io_event_id\":\"56dff9ed-c8fc-45cb-bd69-1e0eba839939\",\"perm_name\":\"eoarq6-gavin-bryars-ensemble-and-jess-walker-12th-jun-kings-place-hall-one-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":4,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:31\",\"venues\":[{\"id\":\"940\",\"name\":\"Kings Place (Hall One)\",\"address\":\"Kings Place, 90 York Way, Kings Cross, London N1 9AG\",\"location\":{\"lat\":51.5349694,\"lng\":-0.121675500000038},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-one-yo6v\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"about\":{\"description\":\"***Recipient of the 2024 Ivor Novello Innovation award, Gavin Bryars is one of the most influential composers of our age. For After the Rain he reunites with singer Jess Walker and the Gavin Bryars Ensemble for his hypnotic arrangements of iconic songs by Tom Waits, Leonard Cohen, Neil Young and Kurt Weill.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nGavin Bryars, recipient of the 2024 Ivors Innovation Award, is one of the most influential composers of our age. For *After the Rain* he reunites with the remarkable singer Jess Walker to build on their Tom Waits collaboration, *Mercy and Grand*, which Tom Waits himself referred to as giving his songs ‘an elegant night on the town.’ This new programme with the Gavin Bryars Ensemble includes his hypnotic arrangements of iconic numbers by Waits, Leonard Cohen, Kurt Weill and Neil Young. Scored for strings, sax, electric guitar, piano and voice, the arrangements include the world premiere of Neil Young’s *Only Love Can Break Your Heart*.\\n\\n***Duration and interval TBC.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"56dff9ed-c8fc-45cb-bd69-1e0eba839939\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"seat_selection\":\"disabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-01T00:30:00+01:00\",\"sale_end_date\":\"2026-06-12T14:00:00+01:00\",\"sale_start_date\":\"2025-10-02T12:15:00+01:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68de5ca67f58c80001bb9f58\",\"name\":\"Gavin Bryars Ensemble and Jess Walker\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-01/a657a5a9-e6c7-4dc5-84e2-27a236ba12cf.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-01/a657a5a9-e6c7-4dc5-84e2-27a236ba12cf.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-01/a657a5a9-e6c7-4dc5-84e2-27a236ba12cf.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1759275000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Yac2b9723340?dice_id=Yac2b9723340\",\"post_competition_referral\":\"https://link.dice.fm/L29aa78a9e9e?dice_id=L29aa78a9e9e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l952153f5ce2?dice_id=l952153f5ce2\",\"post_purchase_referral\":\"https://link.dice.fm/scc4ea661169?dice_id=scc4ea661169\",\"post_reminder_referral\":\"https://link.dice.fm/q3d15da4d23d?dice_id=q3d15da4d23d\",\"post_waitinglist_referral\":\"https://link.dice.fm/feba58e18a16?dice_id=feba58e18a16\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":5223,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"presented_by\":\"Presented by Gotobeat.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":38961,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":38962,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":38963,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":38964,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3},{\"id\":38965,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":4},{\"id\":38966,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":5},{\"id\":38967,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":6},{\"id\":38968,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":7}],\"billing_promoter\":{\"id\":\"5184\",\"name\":\"Gotobeat\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-03/167fd842-233e-4076-a3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"seats_io_event_id\":\"81477015-d4f0-443d-8e62-9dad834a4b2e\",\"perm_name\":\"eopyvy-ibrahim-maalouf-trumpets-of-michel-ange-12th-jun-roundhouse-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:32\",\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ibrahim Maalouf\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebea8a5e4a0a46f7bab2b96414\"},\"artist_id\":\"46663\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Gotobeat by arrangement with Mister Ibé presents Ibrahim Maalouf 'Trumpets Of Michel-Ange' UK tour live at Roundhouse London on Friday, June 12th 2026.\\n\\nIbrahim Maalouf, a trailblazing figure in French music, achieved global recognition over the past decade. In 2022, his album \\\"Queen of Sheba\\\" earned him a historic Grammy nomination, followed by another nod in 2023 for \\\"Capacity to Love.\\\" His extensive career includes being the first jazz musician to fill France's largest concert hall, receiving multiple Victoires du Jazz and Victoires de la Musique awards, and international honors like the Echo Jazz in Germany. Collaborating with renowned artists and supported by Quincy Jones, Maalouf continues to break musical boundaries, as seen in his sold-out 2023 Accor Arena performance and the announcement of his 2024 world tour in the United States and Canada. With the release of his new album TRUMPETS OF MICHEL ANGE, Ibrahim Maalouf will embark on an exciting Asian tour at the end of 2024, followed by two sold-out shows at La Salle Pleyel in Paris in December.\\n\\nThis is an all-ages event (Under 16s accompanied by an adult, Under 14s accompanied and in seats).\",\"highlights\":[]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"81477015-d4f0-443d-8e62-9dad834a4b2e\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"disabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-18T16:00:00+01:00\",\"sale_end_date\":\"2026-06-11T09:00:00+01:00\",\"sale_start_date\":\"2025-08-18T16:00:00+01:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68a33f0fe2ffd10001f20432\",\"name\":\"Ibrahim Maalouf 'Trumpets of Michel-Ange'\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-18/ff2fda70-04f6-4b8b-a049-97a637c5f457.jpg?rect=0%2C0%2C1286%2C1286\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-18/ff2fda70-04f6-4b8b-a049-97a637c5f457.jpg?rect=0%2C257%2C1286%2C772\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-18/ff2fda70-04f6-4b8b-a049-97a637c5f45