ixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":\"waiting-list\",\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:68\",\"about\":{\"description\":\"AEG Presents:\\n\\nMeltt\\n\\nLife cycles through birth, death, and rebirth. Flames reduce objects to dust only for the wind to sweep them into the ether in another eternal form altogether. Meltt’s music resembles this natural sequence. The hum of distorted guitars dissolves into bright melodies carried by shimmering synths and soaring vocals. The Vancouver band enable rock, alternative, and psychedelia to coexist in one ecosystem with airtight instrumentation and deft songcraft\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765792800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Meltt\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-27/a7b01cc4-60d0-4512-8903-370ff5af9204.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"40795\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/1633888b-ea82-4724-bdae-4ff93599e411.jpg?rect=792%2C0%2C3167%2C3167\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/1633888b-ea82-4724-bdae-4ff93599e411.jpg?rect=0%2C159%2C4750%2C2850\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/1633888b-ea82-4724-bdae-4ff93599e411.jpg?rect=1504%2C0%2C1742%2C3167\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6929a26535bac900012eb94e\