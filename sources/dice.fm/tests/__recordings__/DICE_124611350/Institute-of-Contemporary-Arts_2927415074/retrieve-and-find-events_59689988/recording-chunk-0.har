unt\":2000,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Wa88546e7715?dice_id=Wa88546e7715\",\"post_competition_referral\":\"https://link.dice.fm/Ma178f0f8c61?dice_id=Ma178f0f8c61\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/cf2875887fbc?dice_id=cf2875887fbc\",\"post_purchase_referral\":\"https://link.dice.fm/A89435618cf3?dice_id=A89435618cf3\",\"post_reminder_referral\":\"https://link.dice.fm/dac55387e4d5?dice_id=dac55387e4d5\",\"post_waitinglist_referral\":\"https://link.dice.fm/H8abf2abf7cd?dice_id=H8abf2abf7cd\"},\"perm_name\":\"2w7bva-goblin-band-1st-may-earth-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/213febb6-ede8-4153-80ec-cdee1e47a03c.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/213febb6-ede8-4153-80ec-cdee1e47a03c.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/213febb6-ede8-4153-80ec-cdee1e47a03c.jpg?rect=450%2C0%2C1100%2C2000\"},\"properties\":[],\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nGoblin Band’s debut album A Loaf Of Wax is a live recording, capturing the euphoric energy of their onstage performances. The London-based quartet — Rowan Gatherer (hurdy-gurdy, recorder, reeds, vocals), Sonny Brazil (concertina, accordion, vocals), Gwena Harman (drums, pump organ, recorder, vocals), and Alice Beadle (violin, recorder) — fuse traditional folk with intense dynamism, humor, and political awareness.\\n\\nFormed to create a welcoming space for young and queer folk musicians, Goblin Band has quickly become a cornerstone of London’s progressive folk scene, performing across the city and beyond. Their music blends seasonal songs, radical energy, and audience interaction, delivering a live experience that is both immersive and joyous.\\n\\nCelebrated by folk veterans like Martin Carthy, Goblin Band channels centuries-old traditions through a modern, DIY ethos, creating music that’s as vibrant and rebellious as it is rooted in history.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69319cc83ec79b0001fcc0a0\",\"name\":\"Goblin Band\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Goblin Band - Rosin The Beau\",\"redirect_url\":\"https://music.apple.com/us/album/rosin-the-beau/1848469894?i=1848469902&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Goblin Band\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/84/44/56/84445622-b4a3-e78d-feb0-1ac595800b33/mzaf_17510115684297725241.plus.aac.p.m4a\",\"track_name\":\"Rosin The Beau\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Goblin Band\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-26/3d79a8e1-6d70-42f9-9ab2-c3c477b9dc0f.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"80463\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T00:00:00+00:00\",\"sale_end_date\":\"202