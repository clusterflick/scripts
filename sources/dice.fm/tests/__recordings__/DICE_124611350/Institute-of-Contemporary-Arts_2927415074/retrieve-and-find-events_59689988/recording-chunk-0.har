chase_extras_available_referral\":\"https://link.dice.fm/a4616a0416d8?dice_id=a4616a0416d8\",\"post_purchase_referral\":\"https://link.dice.fm/p0db2ae9397e?dice_id=p0db2ae9397e\",\"post_reminder_referral\":\"https://link.dice.fm/Kb201771dd88?dice_id=Kb201771dd88\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y1134695faea?dice_id=Y1134695faea\"},\"perm_name\":\"g5drop-preyrs-2nd-may-lvls-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/a0a23a22-e3af-41d2-a757-936dd8aa927e.jpg?rect=832%2C0%2C3327%2C3327\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/a0a23a22-e3af-41d2-a757-936dd8aa927e.jpg?rect=0%2C167%2C4990%2C2994\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/a0a23a22-e3af-41d2-a757-936dd8aa927e.jpg?rect=1580%2C0%2C1830%2C3327\"},\"properties\":[],\"about\":{\"description\":\"PREYRS, a visceral new force in alternative rock and metal, is the brainchild of Belfast rock artist Amy Montgomery and drummer/producer Michael Mormecha. Fusing raw alternative rock energy with the weight of metal, their music is an electrifying clash of aggression and euphoria, darkness and uplift, chaos and control.\\n\\nRecently signing to Berlin based Pelagic Records, their forthcoming album is a cathartic journey through pain, growth and transformation, with debut single Wave of Wisdom encapsulating their fierce yet gothic anthemic sound—where healing and rage collide in perfect harmony.\\n\\nKnown for electrifying live performances, PREYRS make their UK festival debut at Bloodstock Open Air this August before supporting New Model Army across Europe this winter then appearing at Planet Rock’s Winter’s End Festival in January 2026.\\n\\nNominated as ‘Best Live Act’ and ‘Best Artist’ at the Northern Ireland Music Prize, Amy’s undeniably fierce and captivating front person energy has been her secret weapon often described as ‘otherworldly’ or ‘a force of nature’\\n\\nFor those seeking the epic, the healing, the aggressive and the unrelenting pulse of alternative rock and metal, PREYRS is it.\\n\\nThe live band consists of long term guitarist Nolan Donnelly and the recent addition of Ciaran McGreevy on bass\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69665b247c7aa500016169bd\",\"name\":\"Preyrs\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-07T12:00:00+00:00\",\"sale_end_date\":\"2026-05-02T18:30:00+01:00\",\"sale_start_date\":\"2026-01-09T10:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:30:00+01:00\",\"event_end_date\":\"2026-05-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Scruff of the Neck.\",\"seating\":null,\"announcement_date_unix\":1767787200,\"venues\":[{\"id\":\"982\",\"name\":\"Dream Bags Jaguar Shoes\",\"address\":\"32-34 Kingsland Rd, London E2 8DA\",\"location\":{\"lat\":51.5280931,\"lng\":-0.0778017000000091},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dream-bags-jaguar-shoes-8e67\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_