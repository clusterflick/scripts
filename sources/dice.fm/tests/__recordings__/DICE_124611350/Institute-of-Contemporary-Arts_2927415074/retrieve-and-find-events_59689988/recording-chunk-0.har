ages\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/d1a62c49-9bac-4bca-93a8-9c61c348a772.jpg?rect=334%2C0%2C1333%2C1333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/d1a62c49-9bac-4bca-93a8-9c61c348a772.jpg?rect=0%2C67%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/d1a62c49-9bac-4bca-93a8-9c61c348a772.jpg?rect=634%2C0%2C733%2C1333\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"K.O.G - Like a Tree\",\"redirect_url\":\"https://music.apple.com/us/album/like-a-tree/1596815830?i=1596815842&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"K.O.G\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/26/63/80/266380d1-b864-0d32-e0d3-153ffed5bd4b/mzaf_6227469192345567247.plus.aac.p.m4a\",\"track_name\":\"Like a Tree\"},{\"type\":\"spotify\",\"title\":\"K.O.G - Like a Tree\",\"redirect_url\":\"https://open.spotify.com/track/4D2Iqk7SGaeLt4k0FSWFJU\",\"artist\":\"K.O.G\",\"preview_url\":\"https://p.scdn.co/mp3-preview/05493529e05c4dee05b93f687fe1168c48ef3ec1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Like a Tree\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1771027200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"*Kweku Sackey* aka ***K.O.G*** (Kweku of Ghana) is a multi-dimensional creative force, combining exquisite writing skills with shamanistic live performance, fierce raps, perfectly on pitch singing across a massive vocal range and some absolutely wicked dance moves. Not to mention his skills as a percussionist, arranger, bandleader and art director. A true poet and storyteller, he uses a mix of English, Pidgin and Ga to paint sonic pictures that reach deep into the souls of everyone ready to listen.\\n\\n“I love to make music that CONNECTS, REVIVES, EDUCATES 