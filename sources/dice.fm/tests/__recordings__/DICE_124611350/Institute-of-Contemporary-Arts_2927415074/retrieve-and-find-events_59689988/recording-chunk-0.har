=0%2C180%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/aa4e9194-e713-4615-84c6-3d34bdadb811.jpg?rect=0%2C468%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/aa4e9194-e713-4615-84c6-3d34bdadb811.jpg?rect=225%2C0%2C990%2C1800\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Metrik\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/a932885b984d861ed0a9459be170a0c73f36b4f4\"},\"artist_id\":\"14418\",\"about\":null,\"is_headliner\":false},{\"name\":\"P Money\",\"image\":null,\"artist_id\":\"3596\",\"about\":null,\"is_headliner\":false},{\"name\":\"Whiney\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/75ab659f6dea19c4d943e481fcee0ed1baf6d131\"},\"artist_id\":\"1496\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lens\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf715611f163c9f9e6a97e6d7\"},\"artist_id\":\"14417\",\"about\":null,\"is_headliner\":false},{\"name\":\"Fred V\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb212c5cd468dd0a0952b5a4ea\"},\"artist_id\":\"6228\",\"about\":null,\"is_headliner\":false}],\"total_artists\":8,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765324800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4585},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Metrik - Dawnbreaker\",\"redirect_url\":\"https://open.spotify.com/track/3ychV6Y7TGNXNQlQFzQWVk\",\"artist\":\"Metrik\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3fa45a161a130ce36fab0fada40d20975c7300c2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dawnbreaker\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T06:00:00+00:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-03-14T14:00:00+00:00\",\"event_end_date\":\"2026-03-14T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Southbank Centre.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"90e51b73-86d2-4a4b-8e5b-196346f06f64\",\"social_links\":{\"event_share\":\"https://link.dice.fm/c42031463ec8?dice_id=c42031463ec8\",\"post_competition_referral\":\"https://link.dice.fm/l03717138e8f?dice_id=l03717138e8f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X089d7661b6e?dice_id=X089d7661b6e\",\"post_purchase_referral\":\"https://link.dice.fm/e5c83f79f1de?dice_id=e5c83f79f1de\",\"post_reminder_referral\":\"https://link.dice.fm/V87329e10218?dice_id=V87329e10218\",\"post_waitinglist_referral\":\"https://link.dice.fm/O6cae395ff25?dice_id=O6cae395ff25\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**Music journalist Emma Warren speaks to Celeste about her musical journey, genre defying sound and the ways jazz continues to influence contemporary music.**\\n\\nFrom the acclaim of her debut, Not Your Muse, to the personal revelations behind her second album, Woman of Faces, Celeste reflects on resilience, self-discovery and the art of translating life’s complexities into song. The conversation also touches on jazz’s reach into contemporary genres and the women shaping its evolution today.\\n\\nEmma Warren brings her decades of experience documenting grassroots music and culture to the conversation, uncovering the stories behind Celeste’s distinctive voice and the inspirations that shape her work.\\n\\nCurated by Women in Jazz. Founded in 2018, Women In Jazz (WiJ) is a pioneering UK organisation dedicated to addressing the gender imbalance in jazz. Through mentoring programmes, live events, workshops and a radio show, WiJ gives voice and platform to female singers, instrumentalists, composers and producers who are often overlooked in the male-dominated scene.\\n\\nIn 2025, WiJ launched The Year of Women in Jazz, a 12-month programme combining music releases, collaborative projects, live performances, mentorship, and industry workshops.\\n\\nThe ticket price includes a £2 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":\"97a3faa5-6221-44a1-af86-3a7773a7248c\",\"marketeers\":[{\"id\":228,\"name\":\"Southbank Centre\",\"privacy_policy_link\":\"https://www.southbankcentre.co.uk/policies/privacy\",\"fb_pixel_id\":\"1145741552151564\",\"ga_tracking_id\":\"UA-86802192-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773496800,\"venues\":[{\"id\":\"2268\",\"name\":\"Purcell Room - Southbank Centre\",\"address\":\"Belvedere Rd, South Bank, London SE1 8XX, UK\",\"location\":{\"lat\":51.5057881,\"lng\":-0.11675209999998515},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"purcell-room---southbank-centre-d576\",\"accessibility\":{\"url\":\"https://www.southbankcentre.co.uk/visit-us/access/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T13:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"na