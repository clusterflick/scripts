":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music6/v4/8c/ea/23/8cea23f6-f7e9-ffe9-333c-7977991a06f1/mzaf_8537832795690501581.plus.aac.p.m4a\",\"track_name\":\"In Case of Darkest Timeline\"}],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"py5528-real-voices-march-26th-26th-mar-the-clapham-grand-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774549800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/e77e59c5-cace-4dce-b815-8d4543ff025a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/e77e59c5-cace-4dce-b815-8d4543ff025a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/e77e59c5-cace-4dce-b815-8d4543ff025a.jpg?rect=243%2C0%2C594%2C1080\"},\"max_tickets\":8,\"social_links\":{\"event_share\":\"https://link.dice.fm/B585d6ee0990?dice_id=B585d6ee0990\",\"post_competition_referral\":\"https://link.dice.fm/w979427d8695?dice_id=w979427d8695\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hfd32b6938e9?dice_id=hfd32b6938e9\",\"post_purchase_referral\":\"https://link.dice.fm/O9732de5da47?dice_id=O9732de5da47\",\"post_waitinglist_referral\":\"https://link.dice.fm/O4cea8889c2b?dice_id=O4cea8889c2b\",\"post_reminder_referral\":\"https://link.dice.fm/F4ca3162e322?dice_id=F4ca3162e322\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**THURSDAY 26TH MARCH / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. ONE HOUR AFTER DOORS / SHOW ENDS APPROX. 10PM**\\n\\n**This is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)**\\n\\n26th March: Balham, Battersea & Crystal Palace choirs\\n\\nJoin us as we celebrate a decade of Real Voices over three nights at the much-loved Clapham Grand!\\n\\nReal Voices is a community of non-auditioned contemporary choirs across South London. Over 400 singers will grace the stage across the three nights, backed by our brilliant house band. Expect unique choral reimaginings of decade-spanning pop/rock favourites, indie gems and recent chart hits: songs by the likes of Prince, Olivia Dean, The Cranberries, Foo Fighters and Sophie Ellis-Bextor.\\n\\nWe’re thrilled to be back at the Clapham Grand to mark this special milestone: 10 years of music, community and joy. We hope you’ll join us for a feel-good night of great music!\\n\\nThese performances are taking place in a gorgeous listed Victorian theatre. Your ticket includes a £1 restoration levy which will go towards the invaluable upkeep of this iconic London landmark.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:95\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"presented_by\":\"Presented by The Clapham Grand.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1768996800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:00:00+00:00\",\"sale_end_date\":\"2026-03-26T18:30:00+00:00\",\"sale_start_date\":\"2026-01-21T12:00:00+00:00\",\"event_start_date\":\"2026-03-26T18:30:00+00:00\",\"event_end_date\":\"2026-03-26T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"696f66327df5ba0001bc2427\",\"name\":\"Real Voices - March 26th\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2150},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"wwewrr-tomora-26th-mar-earth-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774551600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/aefea9e9-ba63-4138-b72b-87efe7259101.jpg?rect=1334%2C0%2C5333%2C5333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/aefea9e9-ba63-4138-b72b-87efe7259101.jpg?rect=0%2C267%2C8000%2C4800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/aefea9e9-ba63-4138-b72b-87efe7259101.jpg?rect=2534%2C0%2C2933%2C5333\"},\"max_tickets\":4,\"social_links\":{\"event_share\":\"https://link.dice.fm/P5966f03ae8c?dice_id=P5966f03ae8c\",\"post_competition_referral\":\"https://link.dice.fm/C0ffcfc211d3?dice_id=C0ffcfc211d3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a0dc4f8b6319?dice_id=a0dc4f8b6319\",\"post_purchase_referral\":\"https://link.dice.fm/Re5960bc6d5f?dice_id=Re5960bc6d5f\",\"post_waitinglist_referral\":\"https://link.dice.fm/L928c4065fb8?dice_id=L928c4065fb8\",\"post_reminder_referral\":\"https://link.dice.fm/k30caff067cd?dice_id=k30caff067cd\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-03-26T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nTOMORA is a new collaboration between The Chemical Brothers’ Tom Rowlands and Norwegian artist AURORA. The project builds on a creative relationship that began during sessions for The Chemical Brothers’ 2019 album No Geography, on which AURORA featured on three tracks, including “Eve of Destruction”. Rowlands later contributed to AURORA’s 2024 UK Top 10 album What Happened to the Heart?.\\n\\nAs one half of The Chemical Brothers, Rowlands has released six hugely acclaimed UK No.1 albums and won six Grammy Awards. AURORA has released four studio albums to date and is recognised as one of Norway’s most influential modern artists, with global touring success and over a billion Spotify streams for “Runaway”.\\n\\nCOME CLOSER is TOMORA’s debut LP, written and produced jointly by Rowlands and AURORA. The album creates its own unique world, pairing AURORA’s distinctive vocals and Tom’s unparalleled studio expertise. TOMORA will debut live in the UK before performing at Coachella 2026, followed by further festival dates in Europe and residency shows throughout the year.\\n\\n‘COME CLOSER’, the debut album by TOMORA will be released 17th April 2026 via Fontana.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5MTc3MywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUzOTExLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo0OS4wNTUyMzlaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzY4MSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5MTc3MywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUzOTExLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo0OS4wNTUyNzJaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzY4MiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5MTc3MywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUzOTExLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo0OS4wNTUyODdaIiwicHJpY2UiOjUwMCwidmFyaWFud