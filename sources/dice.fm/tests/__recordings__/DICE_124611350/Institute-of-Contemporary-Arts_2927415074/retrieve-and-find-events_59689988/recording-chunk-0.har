\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69413e2fdc446c0001c41229\",\"name\":\"Todd Day Wait\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Todd Day Wait\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb4fe236cfd2b6c304a14783e5\"},\"artist_id\":\"23737\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"q26pba-todd-day-wait-15th-apr-hootananny-brixton-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/35fa99c9-9f39-45db-bf0b-f706f460749c.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/35fa99c9-9f39-45db-bf0b-f706f460749c.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/35fa99c9-9f39-45db-bf0b-f706f460749c.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Todd Day Wait is one of the last real American Workhorse, pedal to the metal, Troubadours by way of Missouri, to California, to New Orleans and now Nashville. The original material of Todd Day Wait, is highly influenced by early American folk, country and blues music from the 1920's through the 1960's, embodying the spirit and authenticity of traditional American music.\\n\\nTodd Day Wait, whomst you may have heard of from his millions of spins on GemsOnVHS or WesternAF writes and performs his own style of timeless country music. Harking back to Jimmie Rodgers, Willie Nelson, Wynn Stewart and Kris Kristofferson he keeps the spirit of country music alive. In 2009 he put all his earthly belongings on the curb and hit the road, in his diesel shuttle bus fueled by vegetable oil, for a never ending tour. From busking the streets of New Orleans, to playing in the shadow of European castles, to lighting up the honky-tonk dance floors in Nashville, Todd keeps it 60/50\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1300,\"name\":\"Old Empire \",\"privacy_policy_link\":null,\"fb_pixel_id\":\"252622951855502\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Primitive Man - Seer\",\"redirect_url\":\"https://open.spotify.com/track/1ZrF69LooOCcWCBlU5SSwr\",\"artist\":\"Primitive Man\",\"preview_url\":\"https://p.scdn.co/mp3-preview/37df1c72df2d295e3b9e61245830d13f92d83ea8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Seer\"},{\"type\":\"apple_music\",\"title\":\"Primitive Man - Victim\",\"redirect_url\":\"https://music.apple.com/us/album/victim/1261416247?i=1261416643&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Primitive Man\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview128/v4/a7/9c/3a/a79c3a1c-6088-b9e2-9d0a-d67d12fcb13c/mzaf_5498767346807097233.plus.aac.p.m4a\",\"track_name\":\"Victim\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776276000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-45