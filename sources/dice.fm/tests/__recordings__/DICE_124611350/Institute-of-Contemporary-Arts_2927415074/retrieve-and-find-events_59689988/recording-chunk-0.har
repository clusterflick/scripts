ce\":{\"currency\":\"GBP\",\"amount\":1663,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6936e87918338d00010b3579\",\"name\":\"Dave Lofts\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dave Lofts\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebbe0b969d09aac3526a8f42c9\"},\"artist_id\":\"131160\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"ave3vx-dave-lofts-16th-apr-the-lower-third-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/4b41eb23-2967-4aed-89c1-4d28930b707e.jpg?rect=0%2C382%2C899%2C899\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/4b41eb23-2967-4aed-89c1-4d28930b707e.jpg?rect=0%2C531%2C899%2C539\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/4b41eb23-2967-4aed-89c1-4d28930b707e.jpg?rect=10%2C0%2C880%2C1600\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Dave Lofts Blurb Following an incredible 12 months that saw him sell out headline shows across Ireland, tour with Wolf Alice, and perform to over 50,000 people supporting The Wolfe Tones, Irish singer-songwriter Dave Lofts is now fresh off an Irish tour that boasts an epic crescendo in selling out one of Dublin's finest and most iconic venues, The Ambassador on December 13th.\\n\\nLofts’ journey has been nothing short of remarkable — from serving in the Irish Army to achieving a No.1 Independent Album, and amassing millions of views on TikTok with his emotionally charged performances. His authenticity and connection with fans continue to set him apart as one of Ireland’s most compelling new voices.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":