\":\"https://link.dice.fm/s8b1cca772a2?dice_id=s8b1cca772a2\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**SOME VELVET EVENING ft. JIM JONES & FRIENDS**\\n\\nJim Jones curates a constellation of artists to celebrate the music of The Velvet Underground.\\n\\nEvoking the Spirit of 1966. Playing classic Velvet Underground songs live. Heavy Factory Vibes.\\n\\nJoin them in conjuring the Spirit of art, creativity and participation.\\n\\nFeaturing\\n\\nJim Jones on vocals and guitar.\\n\\nKatharine Blake from Miranda Sex Garden/Medieval Babes on vocals and violin.\\n\\nRita D’Albert (Miss Lucha Vavoom) on vocals.\\n\\nAngie Adams from Fluffy brings the beats.\\n\\nTom Hodges from The Hare and Hoofe /All Stars on bass and vocals\\n\\nOrson from Queen Adreena on guitar\\n\\nLucy Maycroft on glock/piano and vocals\\n\\nRosa Marsh on vocals\\n\\n**Plus special guests to be announced!**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"date_unix\":1773430200,\"venues\":[{\"id\":\"373\",\"name\":\"Paper Dress Vintage\",\"address\":\"352a Mare Street, London, E8 1HR, United Kingdom\",\"location\":{\"lat\":51.54733,\"lng\":-0.05467},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-29/13fc3fd2-f3f2-4ebb-b479-d3d2d7cf5214.jpg?rect=683%2C0%2C2731%2C2731\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"acc