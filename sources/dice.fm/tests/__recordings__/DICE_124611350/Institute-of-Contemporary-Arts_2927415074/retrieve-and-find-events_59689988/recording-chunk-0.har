e\":\"Wed 04 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Malt Haus\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1634\",\"name\":\"InFireworks\",\"image\":{\"url\":null},\"perm_name\":\"infireworks-8vqv\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"dkqx66-jazz-malt-haus-salt-beef-sessions-5th-mar-malt-haus-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772733600,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:18\",\"venues\":[{\"id\":\"16936\",\"name\":\"Malt Haus\",\"address\":\"Ravenswood Industrial Estate, Shernhall St, E17 9HQ\",\"location\":{\"lat\":51.58835016577475,\"lng\":0.007405262463536746},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"malt-haus-q2kg9\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"Salt Beef Reuben and Pillars Brewery present Jazz at Pillars: Salt Beef Sessions, a monthly night of groove-led jazz, improvisation, and reimagined classics. Led by the Salt Beef Reuben trio, each evening combines tight live sets with spontaneous interplay and guest musicians.\\n\\nThe night takes place at Malt Haus, a Pillars’ establishment in Walthamstow, the perfect setting for independent beer and live jazz.\\n\\nJoin us on the first Thursday of each month, with March 5th marking the launch night.\\n\\nDoors 7:00pm | Music from 7:45pm.\\n\\nENTRY - FREE - PAY WHAT YOU CAN ON THE NIGHT\\n\\nThere will be deep grooves, creative takes on classic tunes, and a relaxed, welcoming atmosphere.\\n\\nTickets are pay-what-you-like. Book in advance to receive a free download in March featuring a previously unreleased track from Salt Beef Reuben’s recent Hackney recording sessions at Location 9 Studio.\\n\\nYou can also hear Salt Beef Reuben on Spotify and Apple Music, including their 2025 release Maiden Voyage\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T19:00:00+00:00\",\"sale_end_date\":\"2026-03-05T19:00:00+00:00\",\"sale_start_date\":\"2026-02-16T19:00:00+00:00\",\"event_start_date\":\"2026-03-05T18:00:00+00:00\",\"event_end_date\":\"2026-03-05T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6993697eb47565000133827c\",\"name\":\"Jazz @ Malt Haus: Salt Beef Sessions\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/10dfa757-c4c7-4bb7-8c91-8db9de059a1d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/10dfa757-c4c7-4bb7-8c91-8db9de059a1d.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/10dfa757-c4c7-4bb7-8c91-8db9de059a1d.jpg?rect=169%2C0%2C742%2C1349\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"ann