\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774294200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/c9b46269-d425-4858-ac62-fe739f1435ee.jpg?rect=500%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/c9b46269-d425-4858-ac62-fe739f1435ee.jpg?rect=0%2C100%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/c9b46269-d425-4858-ac62-fe739f1435ee.jpg?rect=950%2C0%2C1100%2C2000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/i3987b1fbfd4?dice_id=i3987b1fbfd4\",\"post_competition_referral\":\"https://link.dice.fm/b208d374ff2a?dice_id=b208d374ff2a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/qd22a9bb0419?dice_id=qd22a9bb0419\",\"post_purchase_referral\":\"https://link.dice.fm/P6b9f8ba5318?dice_id=P6b9f8ba5318\",\"post_waitinglist_referral\":\"https://link.dice.fm/V9a08689acee?dice_id=V9a08689acee\",\"post_reminder_referral\":\"https://link.dice.fm/Yfb6fd003e4c?dice_id=Yfb6fd003e4c\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-23T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Two musical giants, guitarist Lionel Loueke and bassist Dave Holland, unite their individual talents into one harmonious recording, igniting creativity, honoring cultural roots, and showcasing music's powerful role in fostering unity amidst societal division.\\n\\nUnited is an inspiring testament to the power of collaboration, blending Loueke's masterful guitar work with Holland's deep, resonant bass. Both musicians have profoundly impacted the global jazz scene — Loueke, known for his innovative fusion of West African traditions Rider im Archiv!with modern jazz, has played with a who’s who of virtuosic and celebrated artists, most notably serving as Herbie Hancock’s guitarist for over 15 years, and collaborating with legends like Wayne Shorter, Sting, Terence Blanchard, Marcus Miller, and Esperanza Spalding.\\n\\nHolland, one of the most influential bassists and composers in jazz, has shaped contemporary jazz since the late 1960s, performing with icons like Miles Davis, Chick Corea, John McLaughlin, Pat Metheny, Sam Rivers, and Jack DeJohnette. Though Loueke and Holland have worked together many times in various groups, this album marks their first collaboration as a duo. The result is nothing short of extraordinary.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:48\",\"billing_promoter\":{\"id\":\"1432\",\"name\":\"Serious\",\"image\":{\"url\":null},\"perm_name\":\"serious-nyo9\",\"profile_active\":true},\"presented_by\":\"Presented by Serious.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dave Holland\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/85de