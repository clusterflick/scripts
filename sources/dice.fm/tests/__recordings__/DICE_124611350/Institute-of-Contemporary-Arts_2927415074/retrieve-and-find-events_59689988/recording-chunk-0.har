ace_name\":null,\"doors_open_date\":\"2026-05-02T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"6318\",\"name\":\"Louder Entertainment Ltd\",\"image\":{\"url\":null},\"perm_name\":\"louder-entertainment-ltd-9dvo\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:37\",\"date_unix\":1777744800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3873},\"social_links\":{\"event_share\":\"https://link.dice.fm/Jf07ed3f17fe?dice_id=Jf07ed3f17fe\",\"post_competition_referral\":\"https://link.dice.fm/Hc919b862555?dice_id=Hc919b862555\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t5fb49f4b5b3?dice_id=t5fb49f4b5b3\",\"post_purchase_referral\":\"https://link.dice.fm/Ma0a517a69d7?dice_id=Ma0a517a69d7\",\"post_reminder_referral\":\"https://link.dice.fm/P27ed7e1fa92?dice_id=P27ed7e1fa92\",\"post_waitinglist_referral\":\"https://link.dice.fm/l67242943af4?dice_id=l67242943af4\"},\"perm_name\":\"nv7m39-claptone-the-masquerade-solardo-more-london-2nd-may-exhibition-white-city-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-14/eb73a9e0-e6eb-4038-ac41-f8dcd9fc1c23.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-14/eb73a9e0-e6eb-4038-ac41-f8dcd9fc1c23.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-14/eb73a9e0-e6eb-4038-ac41-f8dcd9fc1c23.jpg?rect=506%2C0%2C1238%2C2250\"},\"properties\":[],\"about\":{\"description\":\"Claptone presents The Masquerade London\\n\\nSaturday 2nd May 2026 | Exhibition, White City\\n\\nThe man behind the mask returns to London. This May, Claptone brings his world-famous event series The Masquerade to the iconic Exhibition, White City for a night of pure escapism, magic, and house music hedonism.\\n\\nKnown for its theatrical atmosphere, captivating production, and infectious energy, The Masquerade transforms the dance floor into a realm where the extraordinary becomes reality. Expect an unforgettable evening as Claptone delivers his signature blend of groove, melody, and mystery — joined by Manchester house duo Solardo and a handpicked lineup of special guests soon to be announced.\\n\\nA celebration of rhythm, creativity, and unity behind the mask — this is not just another club night. It’s The Masquerade.\\n\\nTickets are on sale now. Prepare to enter Claptone’s world.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68ee9224189b7500012567c1\",\"name\":\"Claptone - The Masquerade + Solardo & more. London\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Claptone - Heartbeat\",\"redirect_url\":\"https://open.spotify.com/track/68Q6c22JNyLUlZYX4dE2tn\",\"artist\":\"Claptone\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b8d1bfca957ad55fc81c0b353ad083688138c886?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Heartbeat\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-15T14:00:00+01:00\",\"sale_end_date\":\"2026-05-01T16:00:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-05-02T19:00:00+01:00\",\"event_end_date\":\"2026-05-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":50168,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by FORM.\",\"seating\":null,\"announcement_date_unix\":1760533200,\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-02T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"94