25-03-18/405bc883-bd5c-4ebd-b869-e284930efeaa.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-18/405bc883-bd5c-4ebd-b869-e284930efeaa.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-18/405bc883-bd5c-4ebd-b869-e284930efeaa.jpg?rect=180%2C0%2C440%2C800\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/ad496fb249ec?dice_id=ad496fb249ec\",\"post_competition_referral\":\"https://link.dice.fm/W024c68a8d8c?dice_id=W024c68a8d8c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m4fea9b2a295?dice_id=m4fea9b2a295\",\"post_purchase_referral\":\"https://link.dice.fm/Xa07a4290cb6?dice_id=Xa07a4290cb6\",\"post_waitinglist_referral\":\"https://link.dice.fm/vbb6a5633ce7?dice_id=vbb6a5633ce7\",\"post_reminder_referral\":\"https://link.dice.fm/j121e7e218e7?dice_id=j121e7e218e7\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T19:00:00+00:00\",\"doors_close_date\":\"2026-03-26T23:00:00+00:00\"}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"In 2026, Teddy Pendergrass would have been turning 76 years of age. In celebration of one of the most iconic soul musicians of all time, AGMP Concerts are presenting a special one-off night in dedication to Theodore DeReese Pendergrass with a live performance from The Love T.K.O. All-Stars featuring the voice of Ashton Jones.\\n\\nTeddy Pendergrass was the original vocalist with Harold Melvin & The Blue Notes and the The Love T.K.O. All-Stars will be performing live hits and fan favourites from both his solo years and Harold Mevin & the Blue Notes classics such as If You Don't Know Me By Now, Wake Up Everybody, When Somebody Loves You Back, Turn Off The Lights, The Love I Lost, You Can't Hide From Yourself, Don't Leave Me This Way, The More I Get The More I Want, Only You, I Miss You and, of course, Love T.K.O.\\n\\nAn AGMP Concerts presentation.\\n\\nAccess Information: https://229.london/access/\\n\\nThis is a standing event. We operate a No Readmissions policy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:5\",\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"presented_by\":\"Presented by AGMP.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_o