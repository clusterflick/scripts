ps://dice-media.imgix.net/attachments/2022-12-13/c4c3f1cb-bfff-473e-bda4-db82eeb0a520.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"iklectik-5wlk\",\"accessibility\":{\"url\":\"https://www.iklectik.org/about\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-04T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"11441\",\"name\":\"Dig That Treasure\",\"image\":{\"url\":null},\"perm_name\":\"dig-that-treasure-xoya\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:59\",\"date_unix\":1777919400,\"price\":{\"currency\":\"GBP\",\"amount\":2500,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/cd3c4e7634c7?dice_id=cd3c4e7634c7\",\"post_competition_referral\":\"https://link.dice.fm/S8aa96a0ee61?dice_id=S8aa96a0ee61\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v8552bb0b1df?dice_id=v8552bb0b1df\",\"post_purchase_referral\":\"https://link.dice.fm/x191385855f9?dice_id=x191385855f9\",\"post_reminder_referral\":\"https://link.dice.fm/y8886978c1cf?dice_id=y8886978c1cf\",\"post_waitinglist_referral\":\"https://link.dice.fm/A993b27684a7?dice_id=A993b27684a7\"},\"perm_name\":\"8ex7n2-abul-mogard-rafael-anton-irisarri-standard-issue-4th-may-iklectik-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/c7943cb5-ea31-4f34-a473-1775c4c84dc9.jpg?rect=0%2C473%2C3780%2C3780\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/c7943cb5-ea31-4f34-a473-1775c4c84dc9.jpg?rect=0%2C1229%2C3780%2C2268\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/c7943cb5-ea31-4f34-a473-1775c4c84dc9.jpg?rect=591%2C0%2C2599%2C4725\"},\"properties\":[],\"about\":{\"description\":\"*Dig That Treasure! and Baba Yaga's Hut present*\\n\\n**Dig That Treasure! Festival - Night Four**\\n\\n**Abul Mogard & Rafael Anton Irisarri**\\n\\nIt is not often that two heavyweights collaborate in such a way that not merely compliments but elevates their respective strengths. This is the case with the pairing of Italian composer Abul Mogard and Ibero-American composer Rafael Anton Irisarri, two masters of ambient and drone music. Each bringing an extensive back catalogue to the table, the pair are also prolific collaborators with other artists, including Grand River, KMRU, Anna Von Hausswolff (Mogard), and Julianna Barwick, Mabe Fratti, Leandro Fresco (Irisarri). In this current project, captured on recording with the 2024 album 'Impossibly Distant, Impossibly Close', Mogard's modular synths and farfisa organ marry seemlessly with Irisarri's guitar tones; their sensibilities and vision becoming inseparable.\\n\\n**Standard Issue**\\n\\nStandard Issue is a London-based new music ensemble that brings experimental composition to inclusive contexts. Led by artistic director Michelle Hromin and creative director Tilly Coulton, the collective has previously interpreted the works of Catherine Lamb, Mary Kouyoumdjian and Julia Wolfe. For this performance, Standard Issue will be playing works by the likes of Andrew May, Jennifer Walshe and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6914cc759e4ee30001cebe80\",\"name\":\"Abul Mogard & Rafael Anton Irisarri + Standard Issue\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Abul Mogard & Rafael Anton Irisarri - Waking Up Dizzy on a Bastion\",\"redirect_url\":\"https://music.apple.com/us/album/waking-up-dizzy-on-a-bastion/1742134704?i=1742134707&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Abul Mogard & Rafael Anton Irisarri\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/79/d0/bd/79d0bd63-deb8-c6bc-2fe2-ccb355cdab70/mzaf_6680692535837644619.plus.aac.p.m4a\",\"track_name\":\"Waking Up Dizzy on a Bastion\"},{\"type\":\"spotify\",\"title\":\"Abul Mogard - A Secret Postcard from Nowhere - Live at Live at Le Guess Who?\",\"redirect_url\":\"https://open.spotify.com/track/56mfEzeJva7nS4uoyx5UcA\",\"artist\":\"Abul Mogard - A Secret Postcard from Nowhere - Live at Live at Le Guess Who?\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d43695e26977dd4613eb120d70bc411d595d22f3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Abul Mogard - A Secret Postcard from Nowhere - Live at Live at Le Guess Who?\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Standard Issue\",\"image\":null,\"artist_id\":\"123692\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Mon 04 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T16:30:00+00:00\",\"sale_end_date\":\"2026-05-05T19:00:00+01:00\",\"sale_start_date\":\"2026-02-09T16:30:00+00:00\",\"event_start_date\":\"2026-05-05T19:00:00+01:00\",\"event_end_date\":\"2026-05-05T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":75678,\"title\":\"The