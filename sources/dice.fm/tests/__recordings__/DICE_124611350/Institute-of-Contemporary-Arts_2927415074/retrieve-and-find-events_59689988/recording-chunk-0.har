"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:42\",\"social_links\":{\"event_share\":\"https://link.dice.fm/R1264ed6c455?dice_id=R1264ed6c455\",\"post_competition_referral\":\"https://link.dice.fm/ab747110d485?dice_id=ab747110d485\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/if138fcd82a3?dice_id=if138fcd82a3\",\"post_purchase_referral\":\"https://link.dice.fm/wa9cf769bc7e?dice_id=wa9cf769bc7e\",\"post_reminder_referral\":\"https://link.dice.fm/C3c355d37a91?dice_id=C3c355d37a91\",\"post_waitinglist_referral\":\"https://link.dice.fm/q8bb23635f50?dice_id=q8bb23635f50\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-03-28T13:30:00+00:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"ev