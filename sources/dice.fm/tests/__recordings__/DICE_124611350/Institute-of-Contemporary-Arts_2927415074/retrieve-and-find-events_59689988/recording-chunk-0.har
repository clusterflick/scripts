eers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775239200,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:27\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3410},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/24402415-dfb0-4cea-b241-34d20769c8f6.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/24402415-dfb0-4cea-b241-34d20769c8f6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/24402415-dfb0-4cea-b241-34d20769c8f6.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6931f26fdee29600012b3c72\",\"name\":\"Laura Jane Grace\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Punk icon, songwriter, author, and trailblazer Laura Jane Grace is returning to the UK and Ireland in spring 2026 for an explosive run of headline shows, reaffirming her deep connection with the grassroots venues and tight-knit communities that shaped her music from the very beginning. Known for her fierce authenticity, razor-sharp lyricism, and electrifying stage presence, Grace will bring her solo show to intimate stages across the country—offering fans an up-close, powerful experience that only she can deliver.\\n\\nFor over two decades, Laura Jane Grace has been one of punk’s most vital voices. As the founder and frontwoman of Against Me!, her work helped redefine the boundaries of modern punk rock, pairing visceral honesty with unforgettable melodies across a string of acclaimed albums. Her coming-out in 2012 marked a historic and deeply influential moment in music, cementing her position not only as a groundbreaking artist but also as a cultural and LGBTQ+ figure whose impact reaches far beyond the stage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+, U18s must be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T10:00:00+00:00\",\"sale_end_date\":\"2026-04-03T17:00:00+01:00\",\"sale_start_date\":\"2025-12-10T10:00:00+00:00\",\"event_start_date\":\"2026-04-03T19:00:00+01:00\",\"event_end_date\":\"2026-04-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"SuperNatural Possession\",\"redirect_url\":\"https://open.spotify.com/track/5NjfRU0JaR3TjNGU2kOubc\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dab593c1ce9e0c137637736084401cfc44ab7f5d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"SuperNatural Possession\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Dome.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"24\",\"name\":\"Downstairs at the Dome\",\"address\":\"178 Junction Rd, London N19 5QQ\",\"location\":{\"lat\":51.558121,\"lng\":-0.138236099999972},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"downstairs-at-the-dome-z6d3\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-03T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"111\",\"name\":\"The Dome\",\"image\":{\"url\":null},\"perm_name\":\"the-dome-4w2r\",\"profile_active\":false},\"announcement_date_unix\":1761051600,\"social_links\":{\"event_share\":\"https://link.dice.fm/K082c18ad3ca?dice_id=K082c18ad3ca\",\"post_competition_referral\":\"https://link.dice.fm/gc4bbd60e8af?dice_id=gc4bbd60e8af\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lc8070c1fb39?dice_id=lc8070c1fb39\",\"post_purchase_referral\":\"https://link.dice.fm/H0545f4ac7cb?dice_id=H0545f4ac7cb\",\"post_reminder_referral\":\"https://link.dice.fm/ma74d3736841?dice_id=ma74d3736841\",\"post_waitinglist_referral\":\"https://link.dice.fm/q02ef5d483ef?dice_id=q02ef5d483ef\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bbn68g-sabbra-cadabra-black-sabbath-tribute-3rd-apr-downstairs-at-the-dome-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775239200,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:28\",\"price\":{\"currency\":\"GBP\",\"amount\":1770,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-20/1fdeb1ea-7dd4-4058-9477-8c98733bc430.jpg?rect=0%2C0%2C3240%2C3240\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-20/1fdeb1ea-7dd4-4058-9477-8c98733bc430.jpg?rect=0%2C648%2C3240%2C1944\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-20/1fdeb1ea-7dd4-4058-9477-8c98733bc430.jpg?rect=729%2C0%2C1782%2C3240\"},\"id\":\"68fcb39c41efd600019fb7a9\",\"name\":\"Sabbra Cadabra (Black Sabbath Tribute) \",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"Sabbra Cadabra are the UK’s premier Black Sabbath tribute, praised by BBC reviewers and hailed by Sabbath’s first manager, Jim Simpson, as “the finest Sabbath tribute”. Having even performed for Tony Iommi and Geezer Butler in 2019, the band proudly carry the seal of approval from Sabbath themselves.\\n\\nFresh from a standout performance at Belladrum Festival, Sabbra Cadabra channel the raw power of Ozzy-era Sabbath and the fire of Ozzy’s solo classics with unrivalled authenticity. Expect heavy riffs, timeless anthems, and a live show that captures the true spirit of the originators of metal.\\n\\nIncluding an Ozzy lookalike competition judged bythe band!\\n\\nAll aboard the Crazy Train with the Masters of Similarity! 🤘\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event under 18s accompanied by and adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-21T14:00:00+01:00\",\"sale_end_date\":\"2026-04-03T16:00:00+01:00\",\"sale_start_date\":\"2025-10-21T14:00:00+01:00\",\"event_start_date\":\"2026-04-03T19:00:00+01:00\",\"event_end_date\":\"2026-04-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Big Fear\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-16/02826bc2-4b78-4f9c-bf6d-ff1cc3a62d50.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"131548\",\"about\":null,\"is_headliner\":false},{\"name\":\"Dance Lessons\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-01/bf05fd4f-fcee-4