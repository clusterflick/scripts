_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:13\",\"date_unix\":1777658400,\"price\":{\"currency\":\"GBP\",\"amount\":1360,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Q5ee5196d428?dice_id=Q5ee5196d428\",\"post_competition_referral\":\"https://link.dice.fm/k1a8faf896bb?dice_id=k1a8faf896bb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b856012bd69c?dice_id=b856012bd69c\",\"post_purchase_referral\":\"https://link.dice.fm/U33850c250ce?dice_id=U33850c250ce\",\"post_reminder_referral\":\"https://link.dice.fm/l50123c0461d?dice_id=l50123c0461d\",\"post_waitinglist_referral\":\"https://link.dice.fm/S265fb125db5?dice_id=S265fb125db5\"},\"perm_name\":\"wwloap-tez-1st-may-the-grace-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/28f668dc-70ed-4f32-910f-38f3c3994ea6.jpg?rect=0%2C1000%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/28f668dc-70ed-4f32-910f-38f3c3994ea6.jpg?rect=0%2C1800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/28f668dc-70ed-4f32-910f-38f3c3994ea6.jpg?rect=350%2C0%2C3300%2C6000\"},\"properties\":[],\"about\":{\"description\":\"For TEZ, music is therapy – a heartfelt exploration through life's experiences, with each measure coasting its way towards optimism and inclusivity. Hailing from Margate, UK, TEZ is Owen Mellett, Joe Martin and Dan Hughes.\\n\\nTEZ's sound is marked by driving rhythms and cascading, aqueous instrumentation that tips its hat to neo-psychedelia, ambient and indie rock. With inspiration from artists like Palace, Foals and Two Door Cinema Club, their music radiates summer vibes, personal growth and a zest for life.\\n\\nFrom bedroom project to growing sensation, their story has been one to watch. Since finalising their lineup in 2023, the schoolmates landed their debut gig in the Swiss Alps. They went on to premiere on BBC, embark on a UK tour and sell out headline shows across the UK and EU.\\n\\nCrowdfunding and the support of charities like Help Musicians have played a major part in TEZ’s journey. Their second and third EP’s, “The New Era” and “Gloria Runs The Shop”, produced by Ian Flynn (Yussef Dayes, Hozier) were made possible through a target-smashing fundraising effort.\\n\\nTEZ have amassed a strong and growing discography, a fanbase amassing over half a million streams, and racked up widespread media support. Abbie McCarthy of BBC Introducing remarked, \\\"We've loved these guys for a little while now\\\" while Wonderland Magazine expressed that they \\\"Can't wait for more from TEZ”.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s to be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68f7da3ee0555100012d2000\",\"name\":\"TEZ\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"TEZ\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-21/930fdff4-212a-4451-b48d-ec28f37ee1e0.jpg?rect=0%2C51%2C538%2C538\"},\"artist_id\":\"126936\",\"about\":null,\"is_headliner\":true},{\"name\":\"Isla Rico\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-05/bdd13def-25b0-42b0-b818-f91ff6dd5686.jpg?rect=0%2C51%2C538%2C538\"},\"artist_id\":\"131101\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-25T10:00:00+01:00\",\"sale_end_date\":\"2026-05-01T14:00:00+01:00\",\"sale_start_date\":\"2025-04-29T10:00:00+01:00\",\"event_start_date\":\"2026-05-01T19:00:00+01:00\",\"event_end_date\":\"2026-05-01T23:00:00+01:00\",