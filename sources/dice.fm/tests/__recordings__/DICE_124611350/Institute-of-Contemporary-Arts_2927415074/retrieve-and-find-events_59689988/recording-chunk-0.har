al\":\"https://link.dice.fm/O5021f6ed228?dice_id=O5021f6ed228\",\"post_reminder_referral\":\"https://link.dice.fm/Xd5b67b90131?dice_id=Xd5b67b90131\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-24T19:30:00+00:00\",\"doors_close_date\":\"2026-03-24T23:00:00+00:00\"}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"After the summer releases of pop-infused anthems such as ‘U Want Me’ and ‘One Hit Wonder’,Canadian born, Nashville based pop singer-songwriter Cate’s new releases ‘Rocket Science’ and ‘You Don’t Love Me’ go down a path of melancholic reflection; the end result presents effortless country power ballads. After taking to the stage as Maisie Peters’ support act on her recent tour and performing to a packed out crowd at last year’s The Great Escape Festival in Brighton, Cate continues to lure in new listeners with her infectious and confessional pop. Inspired by the likes of Dolly Parton and childhood hero Hannah Montana, Cate combines sugary pop-hues against playful yet vulnerable lyricism, drawing resemblance to noughties-era Taylor Swift. Racking up over 10 million overall listeners on Spotify since her debut single in 2019, with monthly listeners rising to 630K, and a hugely successful UK & Ireland headline tour last year, which included sold out shows at London’s Islington Assembly Hall, as well as Glasgow and Bristol, Cate shows no sign of slowing down. In July 2024, Cate moved to Nashville to continue her career as an artist and to write for others.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:66\",\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"presented_by\":\"Presented by AEG.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Georgia Webster\",\"image\":null,\"artist_id\":\"93689\",\"about\":null,\"is_headliner\":false},{\"name\":\"CATE\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb747ebe68f1e2aaf784aa79cc\"},\"artist_id\":\"42845\",\"about\":{\"description\":\"Canadian-born Cate Canning is known for her pop ballads about heartbreak and self image. Following the release of her EP Love, The Madness and the TikTok sensation ‘Can’t Wait To Be Pretty’, she dropped ‘Groupie’. The minimalist production showed Cate at her songwriting best, painting a picture of a one-sided relationship akin to that of a pop star and their fans – something she is becoming more familiar with as her star rises.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_