\"profile_active\":false},\"date_unix\":1772307000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2781,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T01:15:00+00:00\",\"sale_end_date\":\"2026-02-28T19:30:00+00:00\",\"sale_start_date\":\"2026-01-08T02:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:30:00+00:00\",\"event_end_date\":\"2026-02-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"av3opx-rana-farhan-persian-soul-28th-feb-world-heart-beat-embassy-gardens-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Rana Farhan - All I Have Is You\",\"redirect_url\":\"https://music.apple.com/us/album/all-i-have-is-you/1387134995?i=1387134998&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Rana Farhan\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/a6/06/4d/a6064de4-4cea-5412-8f8c-9e0b0a01c2eb/mzaf_16496366932993338073.plus.aac.p.m4a\",\"track_name\":\"All I Have Is You\"},{\"type\":\"spotify\",\"title\":\"Rana Farhan - All I Have Is You\",\"redirect_url\":\"https://open.spotify.com/track/2N360rh19w5gsgFfwEpa4x\",\"artist\":\"Rana Farhan\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c219818e091fc1e4ce609da935123a5a1441543d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"All I Have Is You\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rana Farhan\",\"image\":null,\"artist_id\":\"117351\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":5,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/dd05b89f-b36d-4528-924c-20a77c499559.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/dd05b89f-b36d-4528-924c-20a77c499559.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/dd05b89f-b36d-4528-924c-20a77c499559.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Zc6b570f17e6?dice_id=Zc6b570f17e6\",\"post_competition_referral\":\"https://link.dice.fm/k4743ec970f2?dice_id=k4743ec970f2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/A423312c130c?dice_id=A423312c130c\",\"post_purchase_referral\":\"https://link.dice.fm/p5c08fe4f189?dice_id=p5c08fe4f189\",\"post_reminder_referral\":\"https://link.dice.fm/y8f06bec3a7f?dice_id=y8f06bec3a7f\",\"post_waitinglist_referral\":\"https://link.dice.fm/n62a3ef61b00?dice_id=n62a3ef61b00\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:5\",\"properties\":[\"selling_fast\"],\"presented_by\":\"Presented by World Heart Beat.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767834900,\"id\":\"695fbb23b48c56000195d201\",\"name\":\"Rana Farhan: Persian Soul\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**THIS IS A STANDING SHOW**\\n\\nUniting two distant cultures through the power of music\\n\\nRana Farhan grew up in Tehran, lives in New York, sings in Persian and English, sounds like Billie Holiday, adores blues and jazz, and is — in almost every other way — a unique cultural product of both her native Iran and her adopted country, the United States. No one else does what Farhan does on albums and in concerts: She combines the rich oral traditions of Persia with the rich oral traditions that originated in black, American culture.\\n\\nRana continues to push boundaries with her latest album, Persian Soul, released on March 28, 2025. This new 10-track collection returns to the poetry of Rumi, weaving his timeless words into original compositions that blend blues, soul, and Persian influences in Rana’s signature style. With Persian Soul, she invites listeners on a fresh journey through love, longing, and transcendence — a testament to her ever-evolving artistry and fearless genre-defying spirit.\\n\\n\\\"Farhan’s sultry, hybridized song book is a revelation to anyone who thinks they already know the full range of blues music Jonathan Curial\\\" – KQED San Francisco\\n\\n\\\"Seductive, exotic, and absolutely gorgeous, this Persian born artist’s voice could melt a blizzard.\\\" Jennifer Layton-Indiemusic.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"139902\",\"name\":\"World Heart Beat\",\"image\":{\"url\":null},\"perm_name\":\"world-heart-beat-bmv9k\",\"profile_active\":false},\"date_unix\":1772307000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3554},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-12T10:00:00+00:00\",\"sale_end_date\":\"2026-02-28T21:00:00+00:00\",\"sale_start_date\":\"2025-11-14T10:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:30:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6dxnd8-wolfgang-voigt-presents-gas-live-28th-feb-earth-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Wolfgang Voigt - Tal 90 - Version\",\"redirect_url\":\"https://open.spotify.com/track/1m4IgAXLiRO58UhdjxTGm2\",\"artist\":\"Wolfgang Voigt - Tal 90 - Version\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c7e98c633d17f90933b20d0efe33b8aaa5fc7dc4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Wolfgang Voigt - Tal 90 - Version\"},{\"type\":\"apple_music\",\"title\":\"Wolfgang Voigt - Tal 90 (Version)\",\"redirect_url\":\"https://music.apple.com/us/album/tal-90-version/291508471?i=291509198&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Wolfgang Voigt\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/9c/ca/f4/9ccaf4d2-1286-2493-2df0-9612091ca2e4/mzaf_8106043318243346308.plus.aac.p.m4a\",\"track_name\":\"Tal 90 (Version)\"}],\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.