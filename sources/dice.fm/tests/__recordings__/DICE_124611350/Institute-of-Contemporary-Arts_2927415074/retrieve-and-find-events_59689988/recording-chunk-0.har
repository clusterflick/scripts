trait\":\"https://dice-media.imgix.net/attachments/2026-02-03/a2c77274-9aba-4646-bb67-aee7a2d3aed5.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/U9c6b52ffbf0?dice_id=U9c6b52ffbf0\",\"post_competition_referral\":\"https://link.dice.fm/e6c04fa3e189?dice_id=e6c04fa3e189\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F139bfe97cfc?dice_id=F139bfe97cfc\",\"post_purchase_referral\":\"https://link.dice.fm/x8fd7e6937f6?dice_id=x8fd7e6937f6\",\"post_reminder_referral\":\"https://link.dice.fm/od2bd8475086?dice_id=od2bd8475086\",\"post_waitinglist_referral\":\"https://link.dice.fm/j9d6c8041d79?dice_id=j9d6c8041d79\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:54\",\"properties\":[],\"presented_by\":\"Presented by VF.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770199200,\"id\":\"698222adbf44f40001566ada\",\"name\":\"Jim Jones All Stars\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Jim Jones All Stars are arguably one of the most exciting acts on the circuit today, All Stars are a bubbling swamp curse of unholy rhythm. Led by Jim Jones and joined by former Jim Jones Revue members Gavin Jay (bass) and Elliot Mortimer (piano and keyboards), The Jim Jones All Stars are augmented by guitarist Carlton Mounsher, drummer Aidan Sinclair, Backing Singer Ali Jones and the double-Sax attack of Stuart Dace, and Tom Hodges.\\n\\nHaving played Sold Out tours and supercharged festival appearances across the UK & Europe, It's no wonder that Jim Jones All Stars were personally selected by The Black Crowes on their 'Happiness Bastards' UK & European dates in 2024.The band also recently joined The Wildhearts on their Spring 25' tour dates.\\n\\nThe brand new album ‘Cat Fight’ (Produced by Chris Robinson (The Black Crowes) Is Out April 3 Via Silver Arrow Records. The band tour the UK & Europe in Spring/Summer 2025 in support of its release and furthermore….\\n\\nThe band are delighted to announce their biggest London headline show to date at THE SCALA.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"date_unix\":1792348200,\"event_tag\":null}],\"title\":\"Sun 18 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T09:00:00+00:00\",\"sale_end_date\":\"2026-10-21T19:00:00+01:00\",\"sale_start_date\":\"2025-12-03T09:00:00+00:00\",\"event_start_date\":\"2026-10-21T19:00:00+01:00\",\"event_end_date\":\"2026-10-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bbxyoo-independance-21st-oct-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The O'Jays - I Love Music (A Tom Moulton Mix)\",\"redirect_url\":\"https://music.