referral\":\"https://link.dice.fm/C9bda115b8d5?dice_id=C9bda115b8d5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e46cd0dc1dbe?dice_id=e46cd0dc1dbe\",\"post_purchase_referral\":\"https://link.dice.fm/u829dd561560?dice_id=u829dd561560\",\"post_reminder_referral\":\"https://link.dice.fm/f458b8159c7b?dice_id=f458b8159c7b\",\"post_waitinglist_referral\":\"https://link.dice.fm/R5111ddb49b1?dice_id=R5111ddb49b1\"},\"perm_name\":\"3owvll-if-youre-being-hard-on-yourself-dont-be-g-6th-may-folklore-hoxton-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/8cc4479c-6583-486d-9c30-86754541ef47.jpg?rect=0%2C0%2C1279%2C1279\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/8cc4479c-6583-486d-9c30-86754541ef47.jpg?rect=0%2C256%2C1279%2C767\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/8cc4479c-6583-486d-9c30-86754541ef47.jpg?rect=288%2C0%2C703%2C1279\"},\"properties\":[],\"about\":{\"description\":\"EP Release party with live music from G., Jem Wax and Bankiyan + an opportunity to get dancy on a Wednesday with a DJ set from COZEN.\\n\\nLooking for a gig that feels like an electrifying warm hug, that will make you dance and cry at the same time, perhaps? Look no further.\\n\\nThis is going to be a celebration of new music with bands so tight that they all walk through the same door at the same time, and artists with bars so cold you'll want to order a hot chocolate. What an opportunity to bathe in a melting pot of genres ranging from live rap, soul and indie to electronic and dance DJ sets, from some of the grooviest emerging artists in the London scene, including G., Jem Wax and Cozen.\\n\\nsomething for everyone to enjoy and warm vibes all round guaranteed. Bring yourself, your friends, your partner, your Mum and your Grandma. We can't wait to see you there.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698c8543b885ac0001e7747f\",\"name\":\"If You're Being Hard On Yourself, Don't Be - G.\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"jem wax\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-15/3ebf9712-370b-4d0a-bea1-9e95d3a0846d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"109435\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T10:00:00+00:00\",\"sale_end_date\":\"2026-05-06T16:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-05-06T19:00:00+01:00\",\"event_end_date\":\"2026-05-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":25,\"name\":\"The Courtyard Theatre\",\"privacy_policy_link\":\"http://www.thecourtyard.org.uk/content/16/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":f