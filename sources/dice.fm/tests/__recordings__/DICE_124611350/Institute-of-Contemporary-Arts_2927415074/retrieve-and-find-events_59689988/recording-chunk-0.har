type\":\"spotify\",\"title\":\"Matt Bianco - Half a Minute\",\"redirect_url\":\"https://open.spotify.com/track/2coJQfr7wSofMq7a04fl3Y\",\"artist\":\"Matt Bianco\",\"preview_url\":\"https://p.scdn.co/mp3-preview/15c81b0994e208f4d2ee9302602b853143517642?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Half a Minute\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1778349600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-09T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:39\",\"about\":{\"description\":\"Matt Bianco is a UK group formed in 1982 by Mark Reilly (vocals), Danny White (keyboards) and Kito Poncioni (bass), from the ashes of Blue Rondo A La Turk.\\n\\nTheir first album Whose Side Are You On?(1984) featured unknown polish vocalist Basia. The LP turned Matt Bianco into one of the biggest acts of the 1980's with hits such as Get Out Of Your Lazy Bed, Half A Minute, & More Than I Can Bear.\\n\\nBasia and Danny White left the group after the first album to pursue a solo-career under the name Basia. Mark Reilly worked with keyboardist Mark Fisher for the next self titled LP Matt Bianco (1986) which included the big hit Yeh Yeh.\\n\\nThe next Matt Bianco LP Indigo (1988) was produced by Gloria Estefan's husband Emilio Estefan and included the singles Don't Blame It On That Girl, Good Times & Wap Bam Boogie.\\n\\nMatt Bianco continue to this day collaborating with the cream of UK Jazz musicians along with two incredible albums with Dutch Latin jazz crew New Cool Collective in recent times.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1764201600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Matt Bianco\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/f0fd6836d5c212fae2fd99c53a3085bf1b401e5b\"},\"artist_id\":\"8118\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/1bfb62a1-b650-4b31-b3ff-a23a3fde899f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/1bfb62a1-b650-4b31-b3ff-a23a3fde899f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/1bfb62a1-b650-4b31-b3ff-a23a3fde899f.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6928408af123790001091d3d\",\"name\":\"Matt Bianco \",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-05-08T00:00:00+01:00\",\"sale