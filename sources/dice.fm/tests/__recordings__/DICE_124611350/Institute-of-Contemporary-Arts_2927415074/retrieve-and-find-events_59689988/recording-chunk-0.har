b642c\",\"post_purchase_referral\":\"https://link.dice.fm/z1c1758b713a?dice_id=z1c1758b713a\",\"post_reminder_referral\":\"https://link.dice.fm/f8415b23f29e?dice_id=f8415b23f29e\",\"post_waitinglist_referral\":\"https://link.dice.fm/j5048ff5f3f0?dice_id=j5048ff5f3f0\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6dnb5b-age-against-the-machine-daytime-party-over-40s-only-18th-apr-the-lower-third-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776520800,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:16\",\"price\":{\"currency\":\"GBP\",\"amount\":1122,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/511f9ef7-a569-4346-b17f-cc1fd960e310.jpg?rect=4%2C0%2C1117%2C1117\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/511f9ef7-a569-4346-b17f-cc1fd960e310.jpg?rect=0%2C221%2C1125%2C675\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/511f9ef7-a569-4346-b17f-cc1fd960e310.jpg?rect=256%2C0%2C614%2C1117\"},\"id\":\"696836e37c7aa5000196683f\",\"name\":\"Age Against The Machine Daytime Party (Over 40s Only)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Now that the winter is behind us and spring is blooming, it's time to lure you oldies out again with another daytime edition of Age Against The Machine from 3pm-7pm for over 40s.\\n\\nDon and Reg will be returning to The Lower Third in Denmark Street for this one, which is right next-door to Tottenham Court Road tube station, if you haven't been to our previous events there.\\n\\nAs always Don and Reg will be dropping the finest: pop, indie, rock, disco, Motown, rock ‘n’ roll, power ballads, soul, punk, ska, northern soul, funk and anything we think will get the floor moving.\\n\\nThe party will finish at 7pm and you'll be so you'll be able to catch a West End show, go for dinner or even head down to catch a movie Leicester Square. Or you could just go home and post all the films you took up to Insta.\\n\\n\\\\*\\\\*Unlike our other Age Against The Machine events this one is strictly for over 40s only, so please be aware if you under that age. Photo ID MUST be produced, even if you have purchased an advance ticket!\\n\\nNo Kids Allowed!\\n\\nYou’ll hear artists like: Wham!, Prince, The Clash, Kate Bush, Chic, Bon Jovi, The Cure, Stevie Wonder, Human League, Blondie, The Killers, Dolly Parton, The Spice Girls, Pet Shop Boys, Tina Turner, Blur, Bonnie Tyler, Rolling Stones, Pulp, The Smiths, Specials, Kylie, The Strokes, Elton John, Joy Division, David Bowie, Bruce Springsteen, KC and the Sunshine Band, Fleetwood Mac, Duran Duran, Gloria Gaynor, Soft Cell, Bee Gees, Belinda Carlisle, Pet shop Boys, Madonna, Beach Boys, Queen, Meat Loaf, Soft Cell, Phil Collins, Temptations, Beatles, Frankie Valli, Whitney Houston, The Kinks, James Brown, Cher, INXS, New Order, ABBA, Erasure, Journey, Madness, Stone Roses, The Jam, Supremes, Depeche Mode, Donna Summer and loads more.\\n\\nAge Against The Machine has appeared at numerous festivals over the years including Isle of Wight, Latitude, Standon Calling, Brighton Fringe and more.\\n\\n\\\"The perfect place to dance off those middle-age blues\\\" Time Out\\n\\n\\\"Look out! The oldies are taking over!\\\" Time Out\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 40+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T00:00:00+00:00\",\"sale_end_date\":\"2026-04-18T15:00:00+01:00\",\"sale_start_date\":\"2026-01-15T00:00:00+00:00\",\"event_start_date\":\"2026-04-18T15:00:00+01:00\",\"event_end_date\":\"2026-04-18T19:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"R.U.B\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebff9436563b552463809fedf4\"},\"artist_id\":\"131687\",\"about\":null,\"is_headliner\":false},{\"name\":\"Śmierć\",\"image\":null,\"artist_id\":\"128710\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Restarts\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb42a44d0e263b2083982141e9\"},\"artist_id\":\"15453\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by South London Scum.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title