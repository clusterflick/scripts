ral\":\"https://link.dice.fm/U41fe19d2628?dice_id=U41fe19d2628\",\"post_reminder_referral\":\"https://link.dice.fm/T7bbd82ba262?dice_id=T7bbd82ba262\",\"post_waitinglist_referral\":\"https://link.dice.fm/O80bbae917b6?dice_id=O80bbae917b6\"},\"perm_name\":\"avpbxd-effy-mall-grab-present-fragrance-31st-jul-boston-manor-park-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/7afcd423-1b21-4c61-abb3-bae0e87b7bf3.jpg?rect=0%2C0%2C859%2C859\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/7afcd423-1b21-4c61-abb3-bae0e87b7bf3.jpg?rect=0%2C172%2C859%2C515\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/7afcd423-1b21-4c61-abb3-bae0e87b7bf3.jpg?rect=194%2C0%2C472%2C859\"},\"properties\":[],\"about\":{\"description\":\"Mall Grab and Effy are taking to the decks this July to present Fragrance. Don't miss out on this massively anticipated set.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698121945d156700016b2dde\",\"name\":\"Effy & Mall Grab Present: Fragrance\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Effy - Vexed\",\"redirect_url\":\"https://music.apple.com/us/album/vexed/1630285335?i=1630285585&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Effy\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/90/d4/c9/90d4c94a-7f76-cced-5631-9e0c624701a3/mzaf_10617648990767685048.plus.aac.p.m4a\",\"track_name\":\"Vexed\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Effy\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-07/aa33a45d-53d4-4bab-abd0-6417c6935a5d.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"33086\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mall Grab\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb8d8c8ab6a9b2b57d12308d63\"},\"artist_id\":\"2889\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T10:00:00+00:00\",\"sale_end_date\":\"2026-07-31T14:00:00+01:00\",\"sale_start_date\":\"2026-02-06T11:30:00+00:00\",\"event_start_date\":\"2026-07-31T16:00:00+01:00\",\"event_end_date\":\"2026-07-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":true,\"faqs\":[{\"id\":73677,\"title\":\"Accessibility Information\",\"body\":\"Accessibility tickets will be available to purchase on DICE for the on-sale.\\n\\nIf you require a Personal Assistant/companion to attend the festival with you, we do offer free carer tickets. Follow the steps below:\\n\\n1\\\\. Purchase an 'Accessibility Ticket' from the standard ticket purchase page on DICE. If you don't require a carer ticket, that is all you need to do. If you are applying for our PA/carer Ticket Scheme, you must purchase 1x Accessible ticket for yourself, but please do not purchase a ticket for the person acting as your PA and follow the below steps.\\n\\n2\\\\. Email a screenshot of your DICE ticket in app and submit your supporting valid evidence via email to – info@labyrinthevents.com.\\n\\nValid Evidence:\\n\\n\\\\- A Nimbus Access Card with the +1 symbol. Visit the Access Card page for more information.\\n\\n\\\\- Confirmation in writing from Social Services that the individual is included on their Deaf Register, or a letter or report from an aural specialist confirming that hearing loss has been recorded at 70 - 95 dBHL or more.\\n\\n\\\\- War Pensions Mobility Allowance.\\n\\n\\\\- Blind or partially sighted registration certificate (BD8 or CVI certificate)\\n\\n\\\\- A personal letter from the GP, community nurse or social worker.\\n\\n\\\\- Benefit award letters.\\n\\n\\\\- Copy of a blue badge (we would need to see both sides)\\n\\n3\\\\. Once the evidence and ticket info has been received and verified, we can send you a link to purchase your free PA/companion ticket.\\n\\n4\\\\. You will have both tickets in the DICE app. They will be available to activate on the day of the event.\\n\\n5\\\\. Closer to the event, we will send you an Access Information Pack with all the information you require about our accessible facilities on site.\",\"order\":0},{\"id\":73678,\"title\":\"Is there a last entry?\",\"body\":\"Last entry is 7 pm\",\"order\":1},{\"id\":73679,\"title\":\"VIP Tickets\",\"body\":\"VIP Tickets Include:\\n\\n\\\\- Access to the beautiful Painted Hall with a premium VIP bar and food offering\\n\\n\\\\- Premium views over the festival from the Painted Hall balcony under the colonnades (please note the balcony has limited capacity)\\n\\n\\\\- Dedicated chillout area with tables and furniture\\n\\n\\\\- VIP Toilets\\n\\n\\\\- Queue jump\",\"order\":2},{\"id\":73680,\"title\":\"FAQs\",\"body\":\"Please check our FAQs here https://www.labyrinthevents.com/onthethames/faqs\",\"order\":3},{\"id\":73768,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":4}],\"marketeers\":[{\"id\":1741,\"name\":\"Labyrinth Festivals Ltd.\",\"privacy_policy_link\":\"https://www.labyrinthevents.com/privacy\",\"fb_pixel_id\":\"1410823875730293\",\"ga_track