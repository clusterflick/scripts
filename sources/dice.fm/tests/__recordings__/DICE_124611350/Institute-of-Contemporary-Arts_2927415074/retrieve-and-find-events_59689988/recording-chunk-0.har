co.imgix.net/image/ab6761610000e5eb84c03641f564d0314602685b\"},\"artist_id\":\"66902\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770656400,\"faqs\":[{\"id\":75650,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":75651,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":75652,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":75653,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":75654,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":75655,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":75656,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":75657,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":75658,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":75659,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Charlie Forrest - For Now I Know\",\"redirect_url\":\"https://open.spotify.com/track/6Izo34XwB566ImyUy00zxn\",\"artist\":\"Charlie Forrest\",\"preview_url\":\"https://p.scdn.co/mp3-preview/068112c23ffbb0f74a719527bc7c4aec18d30b9c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"For Now I Know\"},{\"type\":\"apple_music\",\"title\":\"Charlie Forrest - For Now I Know\",\"redirect_url\":\"https://music.apple.com/us/album/for-now-i-know/1850430248?i=1850430252&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Charlie Forrest\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/1a/e4/de/1ae4def8-34da-46ab-5298-408bd1f8f148/mzaf_13585060070165136925.plus.aac.p.m4a\",\"track_name\":\"For Now I Know\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-25T00:00:00+00:00\",\"sale_end_date\":\"2026-02-21T22:00:00+00:00\",\"sale_start_date\":\"2026-01-25T00:00:00+00:00\",\"event_start_date\":\"2026-02-21T14:00:00+00:00\",\"event_end_date\":\"2026-02-22T02:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by SJQ.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/P79d03683f36?dice_id=P79d03683f36\",\"post_competition_referral\":\"https://link.dice.fm/pe565d937455?dice_id=pe565d937455\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E6117f94c29f?dice_id=E6117f94c29f\",\"post_purchase_referral\":\"https://link.dice.fm/S6d00b8fc016?dice_id=S6d00b8fc016\",\"post_reminder_referral\":\"https://link.dice.fm/n0350db3852e?dice_id=n0350db3852e\",\"post_waitinglist_referral\":\"https://link.dice.fm/m3499377b542?dice_id=m3499377b542\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"We are having a party! Celebrating 15 whole years of existence, music & community. We opened in February in 2011 on a whim and a prayer, with a dymanic organic philosophy ~ 15 years later, SJQ is a fully functional teenager and what a journey it's been. Join us for a day of celebrations featuring an exhibition, live music, and DJs from SJQs history past and present.\\n\\nOn the agenda!\\n\\n**Malphino** are an outer-national, mystical band from an imaginary tropical island that has dreamt up a cinematic score to their idyll. A promised land of hypnotic cumbia rhythms, subtle digital warbling, accordion textures, voodoo vapours and woodblock charm awaits the off piste explorer willing to step through the arch and visit Malphino.\\n\\n**Pink Shabab** is the heartbreak funk-pop solo project of London musician Joseph Carvell.\\n\\n\\\"Groovy and laid-back, danceable and intimate, the minimalist structures of Carvell’s songwriting open up a lot of space and make room for plenty of surprises along the way. ' - Forced Exposure\\n\\n**King Knut**\\n\\nKnut Jonas Sellevold returns to SJQ for a special solo show under his King Knut moniker. Ambient textures and field recordings meet hypnotic polyrhythms in Knut’s cosmic and transcendental sonic universe.\\n\\n**Christos Fanaras**\\n\\nOur friend Christos plays some of his all time favourite tunes on his nyloin stringed guitar.\\n\\nhttps://downisup.bandcamp.com/music\\n\\nPLUS some of our favourite DJS.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771682400,\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T14:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:79\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"124635\",\"name\":\"SJQ\",