e-london-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-24/8885ad05-43c0-4be9-9a62-19995e1bf2e8.jpg?rect=66%2C0%2C994%2C994\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-24/8885ad05-43c0-4be9-9a62-19995e1bf2e8.jpg?rect=0%2C160%2C1125%2C675\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-24/8885ad05-43c0-4be9-9a62-19995e1bf2e8.jpg?rect=289%2C0%2C547%2C994\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wavves\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/479b888bf3ba0133678091a7e45e4b76066209f4\"},\"artist_id\":\"1460\",\"about\":null,\"is_headliner\":true},{\"name\":\"LEMONSUCKR\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-15/3890164f-79ec-4f64-88d6-e7567d270765.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"119377\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1750942800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2680,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Wavves - Nine Is God\",\"redirect_url\":\"https://open.spotify.com/artist/6bUJpbekaIlq2fT5FMV2mQ\",\"artist\":\"Wavves\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8856828788bffbbea2108eb2b9254dcacef5025b\",\"track_name\":\"Nine Is God\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-20T21:00:00+00:00\",\"sale_start_date\":\"2026-01-28T00:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:30:00+00:00\",\"event_end_date\":\"2026-02-20T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Short Waves.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":null,\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q444edabf1e0?dice_id=Q444edabf1e0\",\"post_competition_referral\":\"https://link.dice.fm/efcc24f163ca?dice_id=efcc24f163ca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e70ebbb19f8c?dice_id=e70ebbb19f8c\",\"post_purchase_referral\":\"https://link.dice.fm/e2b1d7fb8ffb?dice_id=e2b1d7fb8ffb\",\"post_reminder_referral\":\"https://link.dice.fm/m164728b9a17?dice_id=m164728b9a17\",\"post_waitinglist_referral\":\"https://link.dice.fm/A7faab7d9c53?dice_id=A7faab7d9c53\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Short Waves Presents:\\n\\n**\\\\- Zoee** is the music project of London-based artist Harriet Zoe Pittard.\\n\\nHer latest album ‘Grandiose Love’ is an amalgamation of Zoee’s various sonic, literary and artistic influences, drawing inspiration from sophisti-pop, jazz and electronic styles as well as the writings of Hilma af Klint and poet Chelsey Minnis.\\n\\nThe 8-track record grew out of improvised jam sessions with bassist Kyrone Oak, keys player Laura Norman and percussionist Hiro Ama as well as additional writing and production contributed by indie musician and composer Jeremy Warmsley.\\n\\nPreviously, Zoee has released singles through Ryan Hemworth's 'Secret Songs' imprint and Vegyn’s label Plz Make It Ruins. In 2021 she released her debut album ‘Flaw Flower’ on Bristol label Illegal Data. She has performed as a vocalist on tracks with PC Music and Hot Chip's Joe Goddard. In 2024 she released her single ‘Moth To A Flame’ featuring Nourished By Time via London label Scenic Route.\\n\\n**\\\\- Cuties** are a four-piece from London who play sugary sadboi music for you to cry and dance to. The band’s influences span 90s pop, emo, shoegaze and indie, with songs about heartbreak, love, friendship and what it is to be a gorgeous young man having a little giggle with all his best friends.\\n\\n**\\\\- Pondlife** are a London four-piece of old friends and family, playing slacker-leaning songs that balance crunching guitars with warm melodies. Formed in 2023, the band have moved from the sofa to the stage, building a loyal following through a steady run of live shows over the past year. 2026 will see the release of the Cello EP, produced by Louis Milburn (Folly Group), with the title track’s wistful bleariness already a crowd favourite.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771615800,\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation