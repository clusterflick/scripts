ic\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:7\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1750287600,\"id\":\"6853dc50bf3a400001d79d21\",\"name\":\"Northern Soul Live\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**A night of Northern Soul classics, performed by a full live band and original DJs from the heart of the scene.**\\n\\nA ten-piece band channels the sound with rich brass, driving rhythms, and an unmistakable groove—capturing the raw energy of the dancefloors that defined a generation.\\n\\nExpect a high-octane celebration of rare soul, sharp style, and the infectious joy of the dance—the kind that made all-nighters legendary.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1771700400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3171},\"unicorn\":false,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"a2fbeb8e-ada6-4f57-bea0-7abc6e3b0c06\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"disabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-20T09:00:00+00:00\",\"sale_start_date\":\"2025-06-20T10:00:00+01:00\",\"event_start_date\":\"2026-02-21T19:00:00+00:00\",\"event_end_date\":\"2026-02-21T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"yom8ap-michael-marcagi-21st-feb-roundhouse-london-tickets\",\"seats_io_event_id\":\"a2fbeb8e-ada6-4f57-bea0-7abc6e3b0c06\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Scared To Start\",\"redirect_url\":\"https://open.spotify.com/track/3Pbp7cUCx4d3OAkZSCoNvn\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4b4a41a2b1de22ce3111f82683fd9eaaad4f8440?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Scared To Start\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":26823,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":26824,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":26825,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":26826,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Evan Honer\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-12/732014b1-1c4c-4adf-9bb5-f3dda6dabfa9.jpg?rect=0%2C51%2C538%2C538\"},\"artist_id\":\"111557\",\"about\":null,\"is_headliner\":false},{\"name\":\"Michael Marcagi\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-01-04/1ed4c632-20f1-479c-b544-7e084b506078.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"92214\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-16/92ca0e30-54e2-4c73-8255-20085d064d73.jpg?rect=0%2C0%2C1024%2C1024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-16/92ca0e30-54e2-4c73-8255-20085d064d73.jpg?rect=0%2C205%2C1024%2C614\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-16/92ca0e30-54e2-4c73-8255-20085d064d73.jpg?rect=231%2C0%2C563%2C1024\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/ubfc5377afd8?dice_id=ubfc5377afd8\",\"post_competition_referral\":\"https://link.dice.fm/l148271369cf?dice_id=l148271369cf\",\"post_purchase_extras_av