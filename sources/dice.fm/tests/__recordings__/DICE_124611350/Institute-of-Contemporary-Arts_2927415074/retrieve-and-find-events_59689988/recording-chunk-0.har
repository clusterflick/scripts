ription\":\"Kernow Beat are back with more obscure sounds from the Cornish underground (and beyond) for a free entry May Day special featuring Kernow's premier South-West-coast garage psych quartet The Heavenly Bodes, Brighton's crooner avant-art rock cowboy Freddie J Watts, and Cornish-born artist, composer and organista Mazy Day.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ only (photo ID required)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697b09ca2f03070001f803cc\",\"name\":\"The Heavenly Bodes + Freddie J Watts + Mazy Day\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mazy Day\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-15/b29e7f49-ac10-49db-9c50-ff57654366aa.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"103816\",\"about\":null,\"is_headliner\":false},{\"name\":\"Freddie J Watts\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-22/e9054f4f-59a5-483a-b648-3f445a9b75ba.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"113615\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T10:00:00+00:00\",\"sale_end_date\":\"2026-05-01T19:00:00+01:00\",\"sale_start_date\":\"2026-03-01T10:00:00+00:00\",\"event_start_date\":\"2026-05-01T19:00:00+01:00\",\"event_end_date\":\"2026-05-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by spit nights.\",\"seating\":null,\"announcement_date_unix\":176916