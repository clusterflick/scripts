C3744%2C3744\"},\"artist_id\":\"24996\",\"about\":null,\"is_headliner\":false},{\"name\":\"Robinson's Village\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf67a5a1a863eecb1996e4909\"},\"artist_id\":\"47078\",\"about\":null,\"is_headliner\":false},{\"name\":\"Margomool\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebfeec8b7af788c5a0ba7caa38\"},\"artist_id\":\"86241\",\"about\":null,\"is_headliner\":false},{\"name\":\"Wave Noir\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-30/a64752ea-7bf1-4ab3-89cd-44a910f3266c.jpg?rect=0%2C0%2C2046%2C2046\"},\"artist_id\":\"125074\",\"about\":null,\"is_headliner\":false}],\"total_artists\":5,\"total_free_texts\":1},\"about\":{\"description\":\"The spaceship is back and has had a software update. The immortal aliens Anti.Net have parked the mothership bang square in the Horniman, bringing some friends along for the ride.\\n\\nEnter the Cyberdance zone: a collision of art, sound, fashion and gaming where we explore Visions of the Future – how we imagine the future, how past generations imagined it, and how these shifting visions shape the world we’re in today. Move between live performances, interactive workshops and hands-on installations as you hack, remix and re-imagine your own realities.\\n\\nMore Info:\\n\\nhttps://www.horniman.ac.uk/event/horniman-museum-lates/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T00:00:00+00:00\",\"sale_end_date\":\"2026-03-05T21:00:00+00:00\",\"sale_start_date\":\"2026-02-04T00:00:00+00:00\",\"event_start_date\":\"2026-03-05T18:00:00+00:00\",\"event_end_date\":\"2026-03-05T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6979d5c4397d2a000126c9d2\",\"name\":\"CYBERDANCE: HORNIMAN LATES TAKEOVER\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/19d0cff0-2253-483b-b29a-35ae57a3c1af.jpg?rect=0%2C0%2C6000%2C6000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/19d0cff0-2253-483b-b29a-35ae57a3c1af.jpg?rect=0%2C1200%2C6000%2C3600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/19d0cff0-2253-483b-b29a-35ae57a3c1af.jpg?rect=1350%2C0%2C3300%2C6000\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770163200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/a649602be5dc?dice_id=a649602be5dc\",\"post_competition_referral\":\"https://link.dice.fm/Oc505821dc36?dice_id=Oc505821dc36\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k5702adb4236?dice_id=k5702adb4236\",\"post_purchase_referral\":\"https://link.dice.fm/v043e88c1083?dice_id=v043e88c1083\",\"post_reminder_referral\":\"https://link.dice.fm/Jcea92ad44d5?dice_id=Jcea92ad44d5\",\"post_waitinglist_referral\":\"https://link.dice.fm/ea8924c36af1?dice_id=ea8924c36af1\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"anti.Net - HITDAFLOOR\",\"redirect_url\":\"https://open.spotify.com/track/202kR2TODVySLY5GWaV9d5\",\"artist\":\"anti.Net\",\"preview_url\":\"https://p.scdn.co/mp3-preview/49215dd13d3f69c78b10eace33b8d6d9fcf7fed7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"HITDAFLOOR\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":600,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by BLONDIES LONDON LTD.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"8302\",\"name\":\"BLONDIES LONDON\",\"image\":{\"url\":null},\"perm_name\":\"blondies-london-ltd-bxdg\",\"prof