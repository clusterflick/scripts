s.apple.com/itunes-assets/AudioPreview115/v4/37/e3/84/37e384f6-ab9a-84df-40e5-69ebe11e0b3a/mzaf_5886728927344581054.plus.aac.p.m4a\",\"track_name\":\"2 Minutes to Midnight (2015 Remastered Version)\"},{\"type\":\"spotify\",\"title\":\"Iron Maiden - The Number of the Beast - 2015 Remaster\",\"redirect_url\":\"https://open.spotify.com/track/3nlGByvetDcS1uomAoiBmy\",\"artist\":\"Iron Maiden - The Number of the Beast - 2015 Remaster\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ef653e44d8258f6bfdf00202cbe611f9116b0806?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Iron Maiden - The Number of the Beast - 2015 Remaster\"}],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":19233,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":19234,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":19235,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Metalworks\",\"image\":null,\"artist_id\":\"30503\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":20,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-22T20:00:00+00:00\",\"doors_close_date\":\"2026-02-23T23:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/eb47f8ea-af86-420a-8f10-f3351c8668ad.jpg?rect=276%2C0%2C802%2C802\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/eb47f8ea-af86-420a-8f10-f3351c8668ad.jpg?rect=9%2C0%2C1337%2C802\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/eb47f8ea-af86-420a-8f10-f3351c8668ad.jpg?rect=457%2C0%2C441%2C802\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Nddcac9b5fe8?dice_id=Nddcac9b5fe8\",\"post_competition_referral\":\"https://link.dice.fm/q20219131a8e?dice_id=q20219131a8e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hf604370a378?dice_id=hf604370a378\",\"post_purchase_referral\":\"https://link.dice.fm/q10c7290380b?dice_id=q10c7290380b\",\"post_reminder_referral\":\"https://link.dice.fm/qf3e21081459?dice_id=qf3e21081459\",\"post_waitinglist_referral\":\"https://link.dice.fm/Sfb648f5b7c6?dice_id=Sfb648f5b7c6\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:64\",\"properties\":[],\"presented_by\":\"Presented by The Underworld.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1721732400,\"id\":\"6979e31418c43e0001772c4f\",\"name\":\"METALWORKS | IRON MAIDEN NIGHT\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"METALWORKS - Is a free entry, legendary rock/metal covers band that have been playing in Camden for over 20 yrs. Featuring world class band members & special guests.\\n\\n\\\\-\\n\\nThe Beasts of Camden Town are back on Sunday 22nd February, with the whole night dedicated to the Mighty Maiden.\\n\\n\\\\---\\n\\nOur opening set stars:\\n\\nTasos Lazaris (One Machine, Rock icons Show, Iron Beast)) - Vocals,\\n\\nGeorge Gt Stergiou (Hi-on Maiden, Paul Di'Anno) - Guitar/Backing Vocals,\\n\\nAdam Breyer (Hi-on Maiden, Paul Di'Anno) - Guitar/Backing Vocals,\\n\\nGus Macricostas - Bass,\\n\\nJames Wise - Drums.\\n\\n\\\\---\\n\\nCome and join the madness from when the doors open at 8pm. And bring your daughters...\\n\\nLive music from around 8.30pm.\\n\\n\\\\---\\n\\nThe second half of the night will see Steff, aka The Colonel take the mic, along with ex-Iron Maiden guitarist from the formative years, Mr Tony Parsons.\\n\\n\\\\---\\n\\nContinuing the theme, they'll be performing songs from the first two Iron Maiden albums, 'Iron Maiden' released in 1980 and 'Killers' from 1981.\\n\\n\\\\---\\n\\nAs always, there might be a few special guests joining the stage during the night.\\n\\n\\\\---\\n\\nFREE ENTRY from 8pm.\\n\\nThe night ends at 11pm.\\n\\n#RunningFree #Prowler #PhantomOfTheOpera #FearOfTheDark #Trooper & so many more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+, 14 and 15 year old's must be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1771790400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"20