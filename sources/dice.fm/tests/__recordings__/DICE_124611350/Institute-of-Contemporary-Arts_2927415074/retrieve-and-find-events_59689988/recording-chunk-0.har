ds_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775154600,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:9\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2750},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-21/41983074-be0c-472b-a19f-0de7eddeec3c.jpg?rect=1376%2C0%2C5504%2C5504\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-21/41983074-be0c-472b-a19f-0de7eddeec3c.jpg?rect=0%2C275%2C8256%2C4954\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-21/41983074-be0c-472b-a19f-0de7eddeec3c.jpg?rect=2615%2C0%2C3027%2C5504\"},\"id\":\"68a8bddee7afdd00014bcbf3\",\"name\":\"Aynur\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"a8ca3129-cf6b-4727-8991-f9683793ca20\",\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Aynur is one of the most prominent Kurdish singers of our times. Her impressive voice and extraordinary musical narration represent the Kurdish music heritage of her cultural roots as a global genre. Her unique voice infuses traditional Kurdish folk music with the contemporary sensibility of Western music. Over the past 25 years, she has created a timeless musical language, combining the treasures of Kurdish traditions with modern arrangements that connect generations and cultures.\\n\\nAynur is set for her first UK tour in Spring 2026, where she and her gifted ensemble shall revisit The Barbican, and also cities outside of London for the first time. Since her last performance at the London Jazz Festival in 2023, Aynur released her acclaimed album Rabe (meaning ‘stand-up’ or ‘rise-up’ in Kurdish), which secured the number one position on the Transglobal World Music Chart last year, and is described by Songlines Magazine as “one of her strongest albums”. Don’t miss your chance to see this multi award winning cultural icon in the UK in 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"5+ (Under 14s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-27T10:00:00+01:00\",\"sale_end_date\":\"2026-04-01T12:00:00+01:00\",\"sale_start_date\":\"2025-08-29T10:00:00+01:00\",\"event_start_date\":\"2026-04-02T19:30:00+01:00\",\"event_end_date\":\"2026-04-02T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Blues Kitchen Shoreditch.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"1780\",\"name\":\"The Blues Kitchen Shoreditch\",\"address\":\"134-146 Curtain Rd, London EC2A 3AR, UK\",\"location\":{\"lat\":51.52664249999999,\"lng\":-0.07999960000006467},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-blues-kitchen-shoreditch-n2y3\",\"accessibility\":{\"url\":\"https://theblueskitchen.com/shoreditch/contact/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-02T20:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_