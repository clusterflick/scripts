          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"sections\":[{\"title\":null,\"tags\":[{\"value\":\"theatre:burlesque\",\"title\":\"Burlesque\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:cabaret\",\"title\":\"Cabaret\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:comedy\",\"title\":\"Comedy\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:dragshow\",\"title\":\"Dragshow\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:fetish\",\"title\":\"Fetish\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:immersive\",\"title\":\"Immersive\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:musical\",\"title\":\"Musical\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:pantomime\",\"title\":\"Pantomime\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:play\",\"title\":\"Play\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:surreal\",\"title\":\"Surreal\",\"subtitle\":\"Theatre\"},{\"value\":\"theatre:theatre\",\"title\":\"Theatre\",\"subtitle\":\"Theatre\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5664\",\"name\":\"The Space - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-space---the-brit-school-ykx2\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T17:45:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The BRIT School\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-05-14/b1c59326-6d8d-41f7-976d-a42aa672d83d.jpg?rect=0%2C0%2C750%2C750\"},\"artist_id\":\"24887\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[{\"id\":70120,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=225%2C0%2C550%2C1000\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768561200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"With their town slowly falling away into the sea, a group of teenagers battle the mystery of their friends’ disappearance, the endless maze of adolescence and the impending doom of climate disaster.\\n\\nWritten by Afsaneh Gray and performed by a brilliant company of BRIT students, this play is as exciting as it is thought-provoking. With intrigue around every corner and difficult questions asked about identity and belonging, Fishville will shock and challenge your very understanding of what it means to grow up.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:0\",\"social_links\":{\"event_share\":\"https://link.dice.fm/m9143f4698a1?dice_id=m9143f4698a1\",\"post_competition_referral\":\"https://link.dice.fm/r12467cf9f27?dice_id=r12467cf9f27\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Sc6598566cd8?dice_id=Sc6598566cd8\",\"post_purchase_referral\":\"https://link.dice.fm/q09c955f27df?dice_id=q09c955f27df\",\"post_reminder_referral\":\"https://link.dice.fm/U130b1e75c49?dice_id=U130b1e75c49\",\"post_waitinglist_referral\":\"https://link.dice.fm/i8d6f033141a?dice_id=i8d6f033141a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T11:00:00+00:00\",\"sale_end_date\":\"2026-02-18T18:30:00+00:00\",\"sale_start_date\":\"2026-01-16T11:00:00+00:00\",\"event_start_date\":\"2026-02-18T18:00:00+00:00\",\"event_end_date\":\"2026-02-18T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":515,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"696a1b1beb5a6000011b610d\",\"seats_io_event_id\":null,\"name\":\"National Theatre Connections: Fishville\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8bgrb-national-theatre-connections-fishville-18th-feb-the-space-the-brit-school-london-tickets\",\"date_unix\":1771437600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/1703dcc6-b98a-465a-a84a-4348de0810fd.jpg?rect=0%2C0%2C1300%2C1300\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/1703dcc6-b98a-465a-a84a-4348de0810fd.jpg?rect=0%2C260%2C1300%2C780\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/1703dcc6-b98a-465a-a84a-4348de0810fd.jpg?rect=293%2C0%2C715%2C1300\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768399200,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**WEDNESDAY 18TH FEBRUARY / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. 1 HOURS AFTER DOORS / SHOW ENDS APPROX. 10:00PM**\\n\\n**This is a 14+ event. Under 18s must be accompanied by an adult over 21 (Max. 2 U18s per adult 21+)**\\n\\nPlayful deception meets its match in Mozart’s sparkling comic opera Così fan tutte, reminding us that love is rarely as simple—or as certain—as we’d like to believe.\\n\\nTwo young officers make a reckless wager. Can their fiancées remain faithful when temptation comes knocking? With a mischievous plot hatched by a worldly friend, disguises, mistaken identities, and romantic entanglements spiral into a deliciously absurd tangle.\\n\\nSet to some of Mozart’s most radiant and intricate music and sung in English to a translation by Amanda Holden, Così fan tutte blends razor-sharp wit with moments of truth and reflection in this vibrant production that proves Mozart knew the human heart all too well.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:1\",\"social_links\":{\"event_share\":\"https://link.dice.fm/S358b9fe5dbf?dice_id=S358b9fe5dbf\",\"post_competition_referral\":\"https://link.dice.fm/j44eb7914613?dice_id=j44eb7914613\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Yce8898da86c?dice_id=Yce8898da86c\",\"post_purchase_referral\":\"https://link.dice.fm/Qcbc63ca5acc?dice_id=Qcbc63ca5acc\",\"post_reminder_referral\":\"https://link.dice.fm/b3fc02efd7b8?dice_id=b3fc02efd7b8\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ec81dcac7de9?dice_id=Ec81dcac7de9\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T14:00:00+00:00\",\"sale_end_date\":\"2026-02-18T18:30:00+00:00\",\"sale_start_date\":\"2026-01-14T14:00:00+00:00\",\"event_start_date\":\"2026-02-18T18:30:00+00:00\",\"event_end_date\":\"2026-02-18T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2540},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"69690026738e8100015baa6e\",\"seats_io_event_id\":null,\"name\":\"Cosi Fan Tutte\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"xe25ga-cosi-fan-tutte-18th-feb-the-clapham-grand-london-tickets\",\"date_unix\":1771439400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1238\",\"name\":\"Folklore Hoxton\",\"address\":\"186 Hackney Rd, London E2 7QL, UK\",\"location\":{\"lat\":51.5306515,\"lng\":-0.07228429999997843},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"folklore-hoxton-2or7\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/99aaeeed-38f4-49d0-ab5e-50396496b1a5.jpg?rect=323%2C0%2C953%2C953\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/99aaeeed-38f4-49d0-ab5e-50396496b1a5.jpg?rect=6%2C0%2C1588%2C953\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/99aaeeed-38f4-49d0-ab5e-50396496b1a5.jpg?rect=538%2C0%2C524%2C953\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1765324800,\"max_tickets\":6,\"marketeers\":[],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**The Crick Crack Club presents**\\n\\n**THE TEMPEST - RETOLD**\\n\\n**Performance storytelling by Debs Newbold**\\n\\nAre all kingdoms founded on acts of violence?\\n\\nWhat are the myths we tell ourselves in order to live?\\n\\nStep into the Tempest…\\n\\nExile and loss, power and magic - Debs Newbold brings the fourth of her internationally acclaimed storytelling performances of Shakespeare’s plays to the stage in her usual warm, joyful, and commanding style. The result is a defiant reclamation of the story behind Shakespeare’s final great Tragedy, fusing Shakespeare’s verse and Debs’ own deep imaginings.\\n\\nJoin us and Debs for a ‘First Look’ at this epic, evolving adaptation. Be not afeared; the isle is full of noises…\\n\\n*“She is sublime. A consummate performer” Sam Lee*\\n\\n*“A shaman for Shakespeare's meaning” Helen Goulden*\\n\\n*“Debs pulls down the spirit of Shakespeare” ★ ★ ★ ★ ★ StageTalk Magazine*\\n\\n*“Quite simply the finest storyteller I have ever seen and heard\\\" Patrick Spottiswoode - Shakespeare's Globe Education*\\n\\n***Running time: Approx 90 minutes, no interval***\\n\\n***Content: This performance contains references to enslavement, threat, violence, and sexual violence, contextualised within a paradigm of mythic narrative, archetype and metaphor.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Folklore Hoxton.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:2\",\"social_links\":{\"event_share\":\"https://link.dice.fm/yf6224f3c89f?dice_id=yf6224f3c89f\",\"post_competition_referral\":\"https://link.dice.fm/y9a99a93ad27?dice_id=y9a99a93ad27\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ued699e87a09?dice_id=Ued699e87a09\",\"post_purchase_referral\":\"https://link.dice.fm/S907e8d21aae?dice_id=S907e8d21aae\",\"post_reminder_referral\":\"https://link.dice.fm/C1d96ec5ad60?dice_id=C1d96ec5ad60\",\"post_waitinglist_referral\":\"https://link.dice.fm/je4f4c185b10?dice_id=je4f4c185b10\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T00:00:00+00:00\",\"sale_end_date\":\"2026-02-18T22:00:00+00:00\",\"sale_start_date\":\"2025-12-10T00:00:00+00:00\",\"event_start_date\":\"2026-02-18T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T00:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":1550,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2755\",\"name\":\"Folklore Hoxton\",\"image\":{\"url\":null},\"perm_name\":\"folklore-hoxton-7ogb\",\"profile_active\":false},\"id\":\"6938c9cba5aab7000106f196\",\"seats_io_event_id\":null,\"name\":\"Fairytales for Grown-ups: THE TEMPEST - RETOLD \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"g5kml6-fairytales-for-grown-ups-the-tempest-retold-18th-feb-folklore-hoxton-london-tickets\",\"date_unix\":1771441200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 18 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5664\",\"name\":\"The Space - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-space---the-brit-school-ykx2\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T17:45:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The BRIT School\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-05-14/b1c59326-6d8d-41f7-976d-a42aa672d83d.jpg?rect=0%2C0%2C750%2C750\"},\"artist_id\":\"24887\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[{\"id\":70121,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/5be4fa8f-2aa5-4daf-8715-991314ecd990.jpg?rect=225%2C0%2C550%2C1000\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768561200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"With their town slowly falling away into the sea, a group of teenagers battle the mystery of their friends’ disappearance, the endless maze of adolescence and the impending doom of climate disaster.\\n\\nWritten by Afsaneh Gray and performed by a brilliant company of BRIT students, this play is as exciting as it is thought-provoking. With intrigue around every corner and difficult questions asked about identity and belonging, Fishville will shock and challenge your very understanding of what it means to grow up.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:3\",\"social_links\":{\"event_share\":\"https://link.dice.fm/x67e8fe3cbf9?dice_id=x67e8fe3cbf9\",\"post_competition_referral\":\"https://link.dice.fm/Rafce5cc14c4?dice_id=Rafce5cc14c4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/baa9ad148329?dice_id=baa9ad148329\",\"post_purchase_referral\":\"https://link.dice.fm/p1bbb96aa797?dice_id=p1bbb96aa797\",\"post_reminder_referral\":\"https://link.dice.fm/o91a2c23672c?dice_id=o91a2c23672c\",\"post_waitinglist_referral\":\"https://link.dice.fm/F0e501cd5bb9?dice_id=F0e501cd5bb9\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T11:00:00+00:00\",\"sale_end_date\":\"2026-02-19T18:30:00+00:00\",\"sale_start_date\":\"2026-01-16T11:00:00+00:00\",\"event_start_date\":\"2026-02-19T18:00:00+00:00\",\"event_end_date\":\"2026-02-19T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":515,\"sales_tax\":0,\"amount_from\":null},\"properties\":[\"selling_fast\"],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"696a1b1deb5a6000015faa44\",\"seats_io_event_id\":null,\"name\":\"National Theatre Connections: Fishville\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"k6akr9-national-theatre-connections-fishville-19th-feb-the-space-the-brit-school-london-tickets\",\"date_unix\":1771524000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-11/6c693755-8bc4-40d5-a3aa-350d6e4991cf.jpg?rect=9%2C0%2C913%2C913\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-11/6c693755-8bc4-40d5-a3aa-350d6e4991cf.jpg?rect=0%2C178%2C930%2C558\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-11/6c693755-8bc4-40d5-a3aa-350d6e4991cf.jpg?rect=214%2C0%2C502%2C913\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1765530000,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**THURSDAY 19TH FEBRUARY / DOORS 6.30PM / SHOW APPROX ONE HOUR AFTER DOORS**\\n\\n**This is an 18+ event**\\n\\nEastBenders is BACK…. and GRANDER than ever!\\n\\nAs everyone’s favourite soap approaches it’s 41st birthday, we’re throwing a big East End bash with the most iconic Albert Square residents as you’ve never seen them before…\\n\\nGet the bubbly out of the fridge, because for ONE NIGHT ONLY we’re taking the East all the way South, and turning the epic Clapham Grand into that other legendary London boozer - The Queen Vic.\\n\\nJoin us as we honour the residents of the unluckiest, most fictional borough of London… Whether you’re a (Pat) Butcher, a (Mitch) Baker, a little bit of a slag or a TOTAL slag, you’re not gonna want to miss this chaotic unofficial tribute to the British institution that is EastEnders.\\n\\nSo, dust off your massive earrings, strap on your spinning bow-tie and get yourself down to Clapham for a dose of drag, drama and maybe a (sausage) surprise or two along the way!\\n\\nKeep an eye on @eastbenderscabaret for lineup announcement, but DO ME A FAVOUR and book a ticket, you ain’t gunna wanna miss this…\\n\\n**COSTUME COMPETITION**\\n\\nDress in a tribute to your favourite East End companions, and our EXTRA SPECIAL guest judge will be picking thier favourite… Are you ready to Slay(ter)???\\n\\n**FUNDRAISING FOR ELOP**\\n\\nELOP (East London Out Project) is a holistic lesbian and gay centre that offers a range of social, emotional and support services to LGBT communities in East London; counselling, support groups, meet-ups and young people’s services.\\n\\nAs well as part of our profits being donated to ELOP, a raffle will be taking place on the night with iconic exclusive Eastenders-themed merch up for grabs. You gotta be in it to win it, so dig deep and get yourself in the raffle!\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:4\",\"social_links\":{\"event_share\":\"https://link.dice.fm/ea2112007767?dice_id=ea2112007767\",\"post_competition_referral\":\"https://link.dice.fm/E4797adee0cc?dice_id=E4797adee0cc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W5a4a54c9140?dice_id=W5a4a54c9140\",\"post_purchase_referral\":\"https://link.dice.fm/Q1b03366ce43?dice_id=Q1b03366ce43\",\"post_reminder_referral\":\"https://link.dice.fm/e13efd05c4fb?dice_id=e13efd05c4fb\",\"post_waitinglist_referral\":\"https://link.dice.fm/s8bc1016aee2?dice_id=s8bc1016aee2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T09:00:00+00:00\",\"sale_end_date\":\"2026-02-19T18:30:00+00:00\",\"sale_start_date\":\"2025-12-12T09:00:00+00:00\",\"event_start_date\":\"2026-02-19T18:30:00+00:00\",\"event_end_date\":\"2026-02-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1464},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"693afd96d97cb2000191a570\",\"seats_io_event_id\":null,\"name\":\"EastBenders\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"926we6-eastbenders-19th-feb-the-clapham-grand-london-tickets\",\"date_unix\":1771525800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5485\",\"name\":\"The Royal Vauxhall Tavern\",\"address\":\"372 Kennington Ln, London SE11 5HY, UK\",\"location\":{\"lat\":51.4863391,\"lng\":-0.1217784},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-royal-vauxhall-tavern-r5bw\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[{\"id\":66523,\"title\":\"Do I have to wear gear?\",\"body\":\"No. You don't need to gear up for the Recon Cabaret, but we love it when people do. You can come in civvies. But there are many attendees that do gear up and socialise for the event. The choice is completely yours.\",\"order\":0},{\"id\":66524,\"title\":\"What time does the show finish?\",\"body\":\"The show starts at 8pm. There's an interval right before 9pm that lasts about 45 minutes to an hour. Act 2 usually finishes before 11pm and many guys will stick around to drink and socialise until the bar closes at midnight.\",\"order\":1},{\"id\":66525,\"title\":\"If I change into gear, is there a cloakroom?\",\"body\":\"Yes. The RVT coat/bag check is at the end of the right-hand-side of the bar.\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-30/289e249a-de0a-4095-bf69-a4deeaa7d791.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-30/289e249a-de0a-4095-bf69-a4deeaa7d791.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-30/289e249a-de0a-4095-bf69-a4deeaa7d791.jpg?rect=173%2C0%2C422%2C768\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1767117600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Join Recon for another social night of fun, fetish and queer cabaret - serving up the filthiest, most unforgettable entertainment at the iconic RVT Vauxhall.\\n\\nThink twisted cabaret entertainment, with filth and thrills, and that outrageous signature kinky side-show entertainment only Recon delivers.\\n\\nBrace yourself for a night of deliciously twisted adult cabaret and a wild night of groundbreaking fetish extravaganza!, featuring charismatic and talented entertainers, seductive dances, and side-splitting comedy, all with a kinky twist.\\n\\nKeep an eye on the Recon home feed for details on the line-up. We'll get them updated here on DICE as well.\\n\\nDress Code: Gear up, or come in civvies. Both are welcome.\\n\\n\\\\*\\\\*\\\\* At Recon Cabaret events, we aim to create a diverse, inclusive, safe and welcoming space where all are welcome.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Recon.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:5\",\"social_links\":{\"event_share\":\"https://link.dice.fm/dbcadc7b5e37?dice_id=dbcadc7b5e37\",\"post_competition_referral\":\"https://link.dice.fm/w76dd573dc34?dice_id=w76dd573dc34\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ec7bcf53f5b3?dice_id=Ec7bcf53f5b3\",\"post_purchase_referral\":\"https://link.dice.fm/y85feacda75b?dice_id=y85feacda75b\",\"post_reminder_referral\":\"https://link.dice.fm/ze7f01fc2101?dice_id=ze7f01fc2101\",\"post_waitinglist_referral\":\"https://link.dice.fm/O6acf621fa57?dice_id=O6acf621fa57\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-30T18:00:00+00:00\",\"sale_end_date\":\"2026-02-19T21:00:00+00:00\",\"sale_start_date\":\"2026-01-02T06:00:00+00:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T23:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1648,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"14017\",\"name\":\"Recon\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-13/18c4a17d-a774-44a4-9cfb-d24baf415c54.jpg\"},\"perm_name\":\"recon-xevre\",\"profile_active\":true},\"id\":\"6953bdbcdef9800001370a40\",\"seats_io_event_id\":null,\"name\":\"Recon Fetish Cabaret\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"mxl2qk-recon-fetish-cabaret-19th-feb-the-royal-vauxhall-tavern-london-tickets\",\"date_unix\":1771527600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Thu 19 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"14139\",\"name\":\"Balls Brothers Austin Friars\",\"address\":\"10-11 Austin Friars, City of London, London, EC2N 2HG, United Kingdom\",\"location\":{\"lat\":51.51571,\"lng\":-0.08527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"balls-brothers-austin-friars-mxb5v\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:6\",\"social_links\":{\"event_share\":\"https://link.dice.fm/x250b3ded65c?dice_id=x250b3ded65c\",\"post_competition_referral\":\"https://link.dice.fm/t3d40247e6aa?dice_id=t3d40247e6aa\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r18f5ea375f2?dice_id=r18f5ea375f2\",\"post_purchase_referral\":\"https://link.dice.fm/Db8ea55053f7?dice_id=Db8ea55053f7\",\"post_reminder_referral\":\"https://link.dice.fm/Q43a815e7199?dice_id=Q43a815e7199\",\"post_waitinglist_referral\":\"https://link.dice.fm/T09f79102869?dice_id=T09f79102869\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-02-21T12:00:00+00:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-02-21T13:00:00+00:00\",\"event_end_date\":\"2026-02-21T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"6956682c4a6bc60001403710\",\"seats_io_event_id\":null,\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb3bko-gingers-big-drag-bottomless-brunch-21st-feb-balls-brothers-austin-friars-london-tickets\",\"date_unix\":1771678800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:7\",\"social_links\":{\"event_share\":\"https://link.dice.fm/We78f95f1ab6?dice_id=We78f95f1ab6\",\"post_competition_referral\":\"https://link.dice.fm/Bd9867a35c0e?dice_id=Bd9867a35c0e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R578f61e5171?dice_id=R578f61e5171\",\"post_purchase_referral\":\"https://link.dice.fm/fd8271a0fba9?dice_id=fd8271a0fba9\",\"post_reminder_referral\":\"https://link.dice.fm/Ecc70e4a5843?dice_id=Ecc70e4a5843\",\"post_waitinglist_referral\":\"https://link.dice.fm/d36aa9d33d61?dice_id=d36aa9d33d61\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-02-21T13:30:00+00:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"event_start_date\":\"2026-02-21T13:00:00+00:00\",\"event_end_date\":\"2026-02-21T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2003},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"694e4e19b191a400016c086a\",\"seats_io_event_id\":null,\"name\":\"The Big Drag Bingo Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"yo6oyv-the-big-drag-bingo-brunch-21st-feb-phoenix-arts-club-london-tickets\",\"date_unix\":1771678800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"15810\",\"name\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768327200,\"max_tickets\":100,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by House of Burlesque.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:8\",\"social_links\":{\"event_share\":\"https://link.dice.fm/S1585e0e0c80?dice_id=S1585e0e0c80\",\"post_competition_referral\":\"https://link.dice.fm/W967993f9f5b?dice_id=W967993f9f5b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bd91c4de23f0?dice_id=bd91c4de23f0\",\"post_purchase_referral\":\"https://link.dice.fm/i18de2bd822c?dice_id=i18de2bd822c\",\"post_reminder_referral\":\"https://link.dice.fm/mde68f1767a0?dice_id=mde68f1767a0\",\"post_waitinglist_referral\":\"https://link.dice.fm/P5a13664ec96?dice_id=P5a13664ec96\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T18:00:00+00:00\",\"sale_end_date\":\"2026-02-21T15:00:00+00:00\",\"sale_start_date\":\"2026-01-14T11:00:00+00:00\",\"event_start_date\":\"2026-02-21T18:00:00+00:00\",\"event_end_date\":\"2026-02-21T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2235},\"properties\":[],\"billing_promoter\":{\"id\":\"2924\",\"name\":\"House of Burlesque\",\"image\":{\"url\":null},\"perm_name\":\"house-of-burlesque-6pd8\",\"profile_active\":false},\"id\":\"696672b8032f5900014cb9eb\",\"seats_io_event_id\":null,\"name\":\"House of Burlesque Speakeasy \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8brql-house-of-burlesque-speakeasy-21st-feb-qt-london-tickets\",\"date_unix\":1771696800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 21 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5664\",\"name\":\"The Space - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-space---the-brit-school-ykx2\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T18:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":76723,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=173%2C0%2C422%2C768\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770969600,\"max_tickets\":10,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Join the 2026 Bridge Company for two nights of excellent work performed and devised by the Bridge students. This fundraiser show is split between two separate sharings, there is a mixture of work both straight from the students’ first three terms on the course.\\n\\nWant to know what the Bridge course is about and what the cohort is capable of? Come along to The BRIT School on 25th and 26th February.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 12a event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:9\",\"social_links\":{\"event_share\":\"https://link.dice.fm/nd8ef01d8e55?dice_id=nd8ef01d8e55\",\"post_competition_referral\":\"https://link.dice.fm/K4d1697f3241?dice_id=K4d1697f3241\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C74fe5d2f372?dice_id=C74fe5d2f372\",\"post_purchase_referral\":\"https://link.dice.fm/fbaf1ed57710?dice_id=fbaf1ed57710\",\"post_reminder_referral\":\"https://link.dice.fm/p7b9a74a46e4?dice_id=p7b9a74a46e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/t0e07576369d?dice_id=t0e07576369d\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T08:00:00+00:00\",\"sale_end_date\":\"2026-02-25T19:00:00+00:00\",\"sale_start_date\":\"2026-02-13T08:30:00+00:00\",\"event_start_date\":\"2026-02-25T18:30:00+00:00\",\"event_end_date\":\"2026-02-25T19:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1030},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"698ee21dd030c400018914c7\",\"seats_io_event_id\":null,\"name\":\"Bridge to Broadway - Fundraiser\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"py9enk-bridge-to-broadway-fundraiser-25th-feb-the-space-the-brit-school-london-tickets\",\"date_unix\":1772044200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-18/880d3d95-315f-4b44-ae1c-a476c4b3e90c.jpg?rect=0%2C0%2C3648%2C3648\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-18/880d3d95-315f-4b44-ae1c-a476c4b3e90c.jpg?rect=0%2C730%2C3648%2C2189\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-18/880d3d95-315f-4b44-ae1c-a476c4b3e90c.jpg?rect=821%2C0%2C2006%2C3648\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763456400,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**WEDNESDAY 25TH FEBRUARY / DOORS & BARS OPEN 6.30PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS OPEN**\\n\\n**This is an 18+ event.**\\n\\nThe Cocoa Butter Club presents… The Black Burlesque School Graduation\\n\\nThe graduation ceremony, where the melanated are celebrated in Burlesque!\\n\\nExpect a celebratory evening of debut performances from the Black Burlesque stars of tomorrow!\\n\\nPlus, special performances by their internationally acclaimed guest tutors of The Black Burlesque School and select superstar alumni\\n\\nFollow announcements: Instagram.com/theblackburlesqueschool\\n\\n\\\\*\\\\*Important information:\\\\*\\\\*\\n\\nFor any ticketing enquiries, please contact DICE via their Help Desk. For any information about the show, accessibility or timings, please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question.\\n\\nCheck out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:10\",\"social_links\":{\"event_share\":\"https://link.dice.fm/d5d9a86ea564?dice_id=d5d9a86ea564\",\"post_competition_referral\":\"https://link.dice.fm/X24cd369abbb?dice_id=X24cd369abbb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Facc596e6710?dice_id=Facc596e6710\",\"post_purchase_referral\":\"https://link.dice.fm/Fdf11d73c0bb?dice_id=Fdf11d73c0bb\",\"post_reminder_referral\":\"https://link.dice.fm/H8ca30b87cbd?dice_id=H8ca30b87cbd\",\"post_waitinglist_referral\":\"https://link.dice.fm/l226f1b43248?dice_id=l226f1b43248\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T09:00:00+00:00\",\"sale_end_date\":\"2026-02-25T18:15:00+00:00\",\"sale_start_date\":\"2025-11-18T09:00:00+00:00\",\"event_start_date\":\"2026-02-25T18:30:00+00:00\",\"event_end_date\":\"2026-02-25T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2369},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"691c5eeedb147a00012128e4\",\"seats_io_event_id\":null,\"name\":\"The Black Burlesque School Graduation Show\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"6dwda7-the-black-burlesque-school-graduation-show-25th-feb-the-clapham-grand-london-tickets\",\"date_unix\":1772044200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 25 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5664\",\"name\":\"The Space - The BRIT School\",\"address\":\"60 The Crescent, Croydon CR0 2HN, UK\",\"location\":{\"lat\":51.3900037,\"lng\":-0.0914101},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-space---the-brit-school-ykx2\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T18:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":76724,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/318015ff-3b56-4e7b-b154-a2e14ef09805.jpg?rect=173%2C0%2C422%2C768\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770969600,\"max_tickets\":10,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Join the 2026 Bridge Company for two nights of excellent work performed and devised by the Bridge students. This fundraiser show is split between two separate sharings, there is a mixture of work both straight from the students’ first three terms on the course.\\n\\nWant to know what the Bridge course is about and what the cohort is capable of? Come along to The BRIT School on 25th and 26th February.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 12a event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:11\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Z81e5da23fee?dice_id=Z81e5da23fee\",\"post_competition_referral\":\"https://link.dice.fm/E83efbc3e7e0?dice_id=E83efbc3e7e0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z525663c3dc7?dice_id=z525663c3dc7\",\"post_purchase_referral\":\"https://link.dice.fm/pfaf0bfcd050?dice_id=pfaf0bfcd050\",\"post_reminder_referral\":\"https://link.dice.fm/h1800c9f4cee?dice_id=h1800c9f4cee\",\"post_waitinglist_referral\":\"https://link.dice.fm/rf57cc086d69?dice_id=rf57cc086d69\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T08:00:00+00:00\",\"sale_end_date\":\"2026-02-26T19:00:00+00:00\",\"sale_start_date\":\"2026-02-13T08:30:00+00:00\",\"event_start_date\":\"2026-02-26T18:30:00+00:00\",\"event_end_date\":\"2026-02-26T19:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1030},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"698ee21fd030c40001bdb7d4\",\"seats_io_event_id\":null,\"name\":\"Bridge to Broadway - Fundraiser\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"8e6oq2-bridge-to-broadway-fundraiser-26th-feb-the-space-the-brit-school-london-tickets\",\"date_unix\":1772130600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-30/f1fd2ab4-4b7b-42d3-81ef-b845d9453eca.jpg?rect=0%2C0%2C4500%2C4500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-30/f1fd2ab4-4b7b-42d3-81ef-b845d9453eca.jpg?rect=0%2C900%2C4500%2C2700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-30/f1fd2ab4-4b7b-42d3-81ef-b845d9453eca.jpg?rect=1013%2C0%2C2475%2C4500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1762164000,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**THURSDAY 26TH FEBRUARY / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\nThis is a 14+ event\\n\\nKyla Cobbler is one of the fastest-rising names in comedy. In her debut show Gone Rogue, Kyla covers everything from the chaos of Barcelona dating life to navigating a friend crush and the power plays of a barbeque. Kyla brings fearless honesty, quickfire wit, and a knack for spinning real-life chaos into killer stories.\\n\\nKyla has built a global following, with over 500k instagram followers and 100M+ video views, and has established herself as a must-see performer. Known for her raw storytelling, razor-sharp crowd work, and unfiltered honesty, Kyla commands the stage with total confidence — every performance is electric, unpredictable, and unforgettable.\\n\\nOn the live circuit, Kyla’s momentum is undeniable. In 2024, she sold out her first headline tour of Ireland, including the Cork Opera House — a milestone she’s now achieved three times. She has sold out Dublin’s 3Olympia Theatre twice, as well as London’s Leicester Square Theatre and her entire Edinburgh Fringe run, and opened for Tommy Tiernan at The Marquee in 2025.\\n\\nWith a loyal fanbase, explosive stage presence, and growing international demand, Kyla Cobbler is not just a rising star — she’s a force to be reckoned with.\\n\\nAs seen on the Tommy Tiernan Show and Ireland AM. As heard on Newstalk FM, 2FM Morning, Mike & Vittorio’s Guide to Parenting, Laura Dowling Experience, Talking Bollox, Have A Word and more\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:12\",\"social_links\":{\"event_share\":\"https://link.dice.fm/c1f4c65fd740?dice_id=c1f4c65fd740\",\"post_competition_referral\":\"https://link.dice.fm/l534a1f75166?dice_id=l534a1f75166\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kc1daa96a744?dice_id=kc1daa96a744\",\"post_purchase_referral\":\"https://link.dice.fm/s2a6a04701b3?dice_id=s2a6a04701b3\",\"post_reminder_referral\":\"https://link.dice.fm/v39953795678?dice_id=v39953795678\",\"post_waitinglist_referral\":\"https://link.dice.fm/uede329584b3?dice_id=uede329584b3\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-03T10:00:00+00:00\",\"sale_end_date\":\"2026-02-26T18:15:00+00:00\",\"sale_start_date\":\"2025-11-03T10:00:00+00:00\",\"event_start_date\":\"2026-02-26T18:30:00+00:00\",\"event_end_date\":\"2026-02-26T21:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2597},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"6903a51f3a2113000111f4f1\",\"seats_io_event_id\":null,\"name\":\"Kyla Cobbler: Gone Rogue\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"v3bqb6-kyla-cobbler-gone-rogue-26th-feb-the-clapham-grand-london-tickets\",\"date_unix\":1772130600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Thu 26 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"14139\",\"name\":\"Balls Brothers Austin Friars\",\"address\":\"10-11 Austin Friars, City of London, London, EC2N 2HG, United Kingdom\",\"location\":{\"lat\":51.51571,\"lng\":-0.08527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"balls-brothers-austin-friars-mxb5v\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:13\",\"social_links\":{\"event_share\":\"https://link.dice.fm/fa3cce526b5c?dice_id=fa3cce526b5c\",\"post_competition_referral\":\"https://link.dice.fm/Y3aa0a2ab0e7?dice_id=Y3aa0a2ab0e7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z2d8b50cf8ad?dice_id=Z2d8b50cf8ad\",\"post_purchase_referral\":\"https://link.dice.fm/Tcdcbfe68eff?dice_id=Tcdcbfe68eff\",\"post_reminder_referral\":\"https://link.dice.fm/Gedfec21aca7?dice_id=Gedfec21aca7\",\"post_waitinglist_referral\":\"https://link.dice.fm/U9cce49de1e3?dice_id=U9cce49de1e3\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-02-28T12:00:00+00:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-02-28T13:00:00+00:00\",\"event_end_date\":\"2026-02-28T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"69566833ec8c810001027b1b\",\"seats_io_event_id\":null,\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8b8vx-gingers-big-drag-bottomless-brunch-28th-feb-balls-brothers-austin-friars-london-tickets\",\"date_unix\":1772283600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:14\",\"social_links\":{\"event_share\":\"https://link.dic