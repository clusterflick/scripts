ms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-20T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Al Cologne\\n\\n\\\\+ support TBA\\n\\nAl Cologne is an artist whose songs balance vulnerability with an understated confidence. Their debut single milk teeth was released on September 26th via Joy of Life International and received praise for introducing the artists’ diaristic, kitchen-sink songwriting voice that feels both intimate, emotionally attuned and unflinching. Al Cologne writes songs about identity, control, and transformation; about trying to inhabit your own body, and then trying again the day following. Join them and their band on March 20th to celebrate the release of their debut EP, ‘milk teeth’\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:56\",\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"presented_by\":\"Presented by Joy of Life International.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Al Cologne\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb139d89e2ff3f4d3c0b2f15e0\"},\"artist_id\":\"123614\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_polic