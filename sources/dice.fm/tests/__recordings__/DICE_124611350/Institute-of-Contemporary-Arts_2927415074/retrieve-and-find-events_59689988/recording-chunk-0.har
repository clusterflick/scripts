d0c6?dice_id=S43faa8ad0c6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G8557246e45d?dice_id=G8557246e45d\",\"post_purchase_referral\":\"https://link.dice.fm/T177f1a9b302?dice_id=T177f1a9b302\",\"post_reminder_referral\":\"https://link.dice.fm/jf410c24e42f?dice_id=jf410c24e42f\",\"post_waitinglist_referral\":\"https://link.dice.fm/d3af916ed8b3?dice_id=d3af916ed8b3\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:53\",\"properties\":[],\"presented_by\":\"Presented by New Cross Live.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768780800,\"id\":\"696a29d0a52e620001c0b823\",\"name\":\"Buggery Act\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"New Cross Live presents \\n\\nBuggery Act \\n\\nhttps://www.instagram.com/buggery_act\\n\\nsexlovefuckyou\\n\\nhttps://www.instagram.com/sexlovefvckyou/\\n\\ndhow\\n\\nlinktr.ee/dhowband\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"date_unix\":1772560800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T17:00:00+00:00\",\"sale_end_date\":\"2026-03-03T21:00:00+00:00\",\"sale_start_date\":\"2026-01-08T17:00:00+00:00\",\"event_start_date\":\"2026-03-03T18:30:00+00:00\",\"event_end_date\":\"2026-03-03T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dpap-run-the-track-presents-the-violence-of-change-3rd-mar-earth-lo