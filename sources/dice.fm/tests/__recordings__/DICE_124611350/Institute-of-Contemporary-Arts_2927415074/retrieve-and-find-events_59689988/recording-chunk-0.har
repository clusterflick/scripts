ts/2025-12-09/70927bf7-e3e8-4eae-9132-d705297958c7.jpg?rect=429%2C0%2C1703%2C1703\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/70927bf7-e3e8-4eae-9132-d705297958c7.jpg?rect=0%2C84%2C2560%2C1536\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/70927bf7-e3e8-4eae-9132-d705297958c7.jpg?rect=812%2C0%2C937%2C1703\"},\"properties\":[],\"about\":{\"description\":\"Osees play live in London!\\n\\n\\\\+ support tbc\\n\\nThis is a 16+ event. Each under 18 must be accompanied by a responsible adult who is over 21 (1:1 ratio). In order to verify your age, ID may be requested. For this reason, we advise that all customers bring valid ID. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"highlights\":[]},\"id\":\"693824b4f4b6a80001651e13\",\"name\":\"Osees\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Thee Oh Sees - COFFIN WAX\",\"redirect_url\":\"https://open.spotify.com/track/3VU1rL4ibDAabhV85agEqx\",\"artist\":\"Thee Oh Sees\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e9a8bdb7305cefa2ebd312dd818c5cbe8fb3045a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"COFFIN WAX\"},{\"type\":\"apple_music\",\"title\":\"Thee Oh Sees - COFFIN WAX\",\"redirect_url\":\"https://music.apple.com/us/album/coffin-wax/1821912379?i=1821912386&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Thee Oh Sees\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/12/90/61/129061c3-d640-b5d6-83b2-fe26667c8d62/mzaf_7853242242397828733.plus.aac.p.m4a\",\"track_name\":\"COFFIN WAX\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Osees\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-30/7b05d339-9429-4ada-8fab-fdb0b578d01f.jpg?rect=214%2C0%2C853%2C853\"},\"artist_id\":\"10031\",\"about\":{\"description\":\"Osees’s eclectic approach to rock music has seen the Los Angeles band create garage, krautrock, psychedelic and punk across 20 albums since the late ’90s. Their live performances are just as fast-paced as their music, featuring a double drummer setup and heavy guitar feedback to intensify their sound.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Fri 17 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:00:00+00:00\",\"sale_end_date\":\"2026-07-18T14:00:00+01:00\",\"sale_start_date\":\"2025-12-01T00:00:00+00:00\",\"event_start_date\":\"2026-07-18T13:00:00+01:00\",\"event_end_date\":\"2026-07-18T17:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Black Frog\",\"seating\":null,\"announcement_date_unix\":1764547200,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-18T13:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:51\",\"date_unix\":1784376000,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/n704bc6b019a?dice_id=n704bc6b019a\",\"post_competition_referral\":\"https://link.dice.fm/Wd9962b1ca12?dice_id=Wd9962b1ca12\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i003ff956a21?dice_id=i003ff956a21\",\"post_purchase_referral\":\"https://link.dice.fm/t13454791d5b?dice_id=t13454791d5b\",\"post_reminder_referral\":\"https://link.dice.fm/Me5323120df2?dice_id=Me5323120df2\",\"post_waitinglist_referral\":\"https://link.dice.fm/I6313e675255?dice_id=I6313e675255\"},\"perm_name\":\"eobemy-jaywalkers-18th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/acdd7a3f-716e-40f0-8cbb-0c4b374dc46a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/acdd7a3f-716e-40f0-8cbb-0c4b374dc46a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/acdd7a3f-716e-40f0-8cbb-0c4b374dc46a.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"“A beautifully performed take on Americana… a multi-layered sound that belies their trio status\\\" - RnR Magazine\\n\\nAs those who have been fortunate enough to catch them in full flight will testify, a Jaywalkers show is an exhilarating experience. UK-based they may be but many from the other side of the Atlantic have complimented them on their particularly stylish delivery of this virtuosic and rich brand of Americana, Bluegrass & Country. These three outstanding musicians have developed a tight bond, demonstrated through their well-crafted, tasteful arrangements and ability to bounce ideas around the stage. The combination of powerhouse bass, flame-fingered mandolin, blistering fiddle and three-part harmony pack a punch as fiery as Jay’s lead vocals and delivers a rich sound that far exceeds what you’d expect from an acoustic trio.\\n\\n***Sponsored by Last Piastre Records.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692e1d114510540001a71c1c\",\"name\":\"Jaywalkers\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Jaywalkers - Homage to the Fromage\",\"redirect_url\":\"https://music.apple.com/us/album/homage-to-the-fromage/1437058090?i=1437058392&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Jaywalkers\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview128/v4/f8/2b/33/f82b3381-6619-736f-2d16-3d0799f9a5f0/mzaf_6531919502501413719.plus.aac.p.m4a\",\"track_name\":\"Homage to the Fromage\"},{\"type\":\"spotify\",\"title\":\"Jaywalkers - Homage to the Fromage\",\"redirect_url\":\"https://open.spotify.com/track/2IyY3T7ZL8FvnWxnlFjyep\",\"artist\":\"Jaywalkers\",\"preview_url\":\"https://p.scdn.co/mp3-preview/011861fbc32a9f14c9bb73ce23108145360c47c0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Homage to the Fromage\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jaywalkers\",\"image\":null,\"artist_id\":\"130880\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-09T16:00:00+01:00\",\"sale_end_date\":\"2026-07-18T21:00:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-07-18T17:00:00+01:00\",\"event_end_date\":\"2026-07-18T22:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":49964,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":49965,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":49966,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":49967,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":49968,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":4},{\"id\":49969,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nYou will be subject to bag checks and searches upon arrival. Chairs and other camping equipment are not allowed at the event. A full list of prohibited items can be found in the prohibited items section below.\",\"order\":5},{\"id\":49970,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":6},{\"id\":49971,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"seating\":null,\"announcement_date_unix\":1760022000,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.