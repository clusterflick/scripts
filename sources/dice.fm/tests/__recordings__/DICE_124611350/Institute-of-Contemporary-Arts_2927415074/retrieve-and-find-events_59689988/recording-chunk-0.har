ame\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T16:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**Abaddon UK**\\n\\nRacket n Rock n Roll. Featuring the original drummer Tony \\\"Abaddon\\\" Bray of Venom, the creators of Black Metal, bringing his band to New Cross Inn for a night of mayhem and chaos\\n\\nOne hour classic Venom set played by the pioneer of insanity.\\n\\nPunks love it.\\n\\nMetalheads love it.\\n\\nLegend.\\n\\nhttps://linktr.ee/abaddonuk\\n\\n**The Fiend**\\n\\n3 piece hardcore punk rock from newcastle est.1982 and still going strong with an uncompromising Brutal live sound playing fast heavy in your face punk rock.\\n\\nhttps://open.spotify.com/artist/1tYaUQXzWrj8bXGqda1VrQ\\n\\n**DOGSFLESH**\\n\\nThrash, Metal, Rock n Roll, punchy riffs, catchy solo's and Raspy Vocals.\\n\\nhttps://www.facebook.com/DogsfleshOfficial\\n\\n**Commoner**\\n\\nDoomCrust Heavy Riffcrafters hailing from Norwich/London, conjuring Sonic Alchemy since 2021!!\\n\\nhttps://commoner666.bandcamp.com/\\n\\n**Perpetual Paradox**\\n\\nLondon based tech metalcore outfit.\\n\\nhttps://open.spotify.com/artist/3vlyYDsqLobvIrmuaQjNWh\\n\\n\\\\+ Special Guest from Scotland:\\n\\n**Subvision**\\n\\nDrums,bass,2 guitars+vocals!\\n\\nThrash punk/metal distorted racket!\\n\\nhttps://www.facebook.com/subvision.ok.1\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14