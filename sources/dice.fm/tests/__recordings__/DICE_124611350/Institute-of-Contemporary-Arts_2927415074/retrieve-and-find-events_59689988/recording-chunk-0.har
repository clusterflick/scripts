uracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-29T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:76\",\"date_unix\":1785348000,\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/P1ea33f83394?dice_id=P1ea33f83394\",\"post_competition_referral\":\"https://link.dice.fm/B787163087a1?dice_id=B787163087a1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Eec79a495b34?dice_id=Eec79a495b34\",\"post_purchase_referral\":\"https://link.dice.fm/c5dfc3e468bb?dice_id=c5dfc3e468bb\",\"post_reminder_referral\":\"https://link.dice.fm/e5646facdae0?dice_id=e5646facdae0\",\"post_waitinglist_referral\":\"https://link.dice.fm/A42d6d3c35f7?dice_id=A42d6d3c35f7\"},\"perm_name\":\"aveywq-independance-29th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=875%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=125%2C0%2C3750%2C2250\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=1381%2C0%2C1238%2C2250\"},\"properties\":[],\"about\":{\"description\":\"Independence project & Clubs provide a multitude of activities so that people can participate in new experiences and in things that they enjoy.\\n\\nFrom our own research we learned that previous live music events in Chelmsford that supported the learning disability community had all ceased, certainly club nights are just not happening. We've sprung into action to make a change.\\n\\nIndepenDANCE was born! We've partnered with Eazee Learning & Hot Box. Both organisations share our ethos and always go the extra mile whilst making a difference in their communities, so it’s the perfect match!\\n\\nWe are excited and hopeful that we will create a real buzz around these nights. Ultimately enabling people with additional needs the opportunity to let their hair down, meet friends & have a DANCE!\\n\\nThis is carried out in a safe environment with staff on hand to support; those attending will enjoy their night with the confidence that there are people around them that are there to help.\\n\\nOur music acts will be showcasing the superb talent within the additional needs community and the DJs providing the entertainment also have additional needs, playing the best in House, UK garage, R&B, Decades, theme nights and Club Classics.\\n\\nWe are hopeful to put on many live music events in the future and they will always be run like any other club night, promoting inclusion and diversity, and enabling people to enjoy real life experiences. Please spread the message and help us to make them a success. Let's Go!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6930b027bd8faa000101c15a\",\"name\":\"Independance\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The O'Jays - I Love Music (A Tom Moulton Mix)\",\"redirect_url\":\"https://music.apple.com/us/album/i-love-music-a-tom-moulton-mix/901402450?i=901402465&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The O'Jays\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/c6/00/ef/c600eff8-0c4a-d9d9-455e-bef5ea0274b4/mzaf_14733497146889174381.plus.aac.p.m4a\",\"track_name\":\"I Love Music (A Tom Moulton Mix)\"},{\"type\":\"spotify\",\"title\":\"The O'Jays - I Love Music - A Tom Moulton Mix\",\"redirect_url\":\"https://open.spotify.com/track/0X3gRDW1QOfcbXAD4AHgYU\",\"artist\":\"The O'Jays - I Love Music - A Tom Moulton Mix\",\"preview_url\":\"https://p.scdn.co/mp3-preview/669d8d36213223cb4f5934b82486383ba84d3219?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The O'Jays - I Love Music - A Tom Moulton Mix\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Wed 29 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T10:00:00+00:00\",\"sale_end_date\":\"2026-07-30T21:00:00+01:00\",\"sale_start_date\":\"2025-11-26T10:00:00+00:00\",\"event_start_date\":\"2026-07-30T19:00:00+01:00\",\"event_end_date\":\"2026-07-30T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"seating\":null,\"announcement_date_unix\":1764151200,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-30T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:77\",\"date_unix\":1785434400,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2897},\"social_links\":{\"event_share\":\"https://link.dice.fm/j121faa6845f?dice_id=j121faa6845f\",\"post_competition_referral\":\"https://link.dice.fm/A9160425d748?dice_id=A9160425d748\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ra2d52237ca9?dice_id=Ra2d52237ca9\",\"post_purchase_referral\":\"https://link.dice.fm/edc5cb99c6cf?dice_id=edc5cb99c6cf\",\"post_reminder_referral\":\"https://link.dice.fm/P0332fd7524d?dice_id=P0332fd7524d\",\"post_waitinglist_referral\":\"https://link.dice.fm/C8ddeaa17184?dice_id=C8ddeaa17184\"},\"perm_name\":\"xe7xpm-the-castellows-30th-jul-islington-assembly-hall-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/7efd958a-1029-47d3-a364-4dcdc9bda3b7.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/7efd958a-1029-47d3-a364-4dcdc9bda3b7.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/7efd958a-1029-47d3-a364-4dcdc9bda3b7.jpg?rect=180%2C0%2C440%2C800\"},\"properties\":[],\"about\":{\"description\":\"The Castellows have announced their debut UK headline show has upgraded from London’s Bush Hall to Islington Assembly Hall due to demand. Taking place on Thursday 30th July, the show precedes the band’s three-night run opening for Luke Combs at Wembley Stadium and tickets are on sale now, available here.\\n\\nRooted in the red clay of Georgetown, Georgia, The Castellows are a sister trio redefining neo-traditional country music with a fresh Southern soul. Composed of Ellie, Lily, and Powell Balkcom, the group blends blood harmony with back-porch honesty, creating a sound that’s as timeless as it is current.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"id\":\"6926c89b638623000161e3a3\",\"name\":\"The Castellows\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Castellows - Cowboy Kind of Love\",\"redirect_url\":\"https://open.spotify.com/track/0ZWDipzWCRrSqaZZ9aUlEF\",\"artist\":\"The Castellows\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9bf4a679aa990c1dd0e4060df579332b6d448902?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cowboy Kind of Love\"},{\"type\":\"apple_music\",\"title\":\"The Castellows - Cowboy Kind of Love\",\"redirect_url\":\"https://music.apple.com/us/album/cowboy-kind-of-love/1721437004?i=1721437565&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Castellows\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/70/c4/4a/70c44a55-2612-0daf-2ec8-57389253468f/mzaf_13570823720030756116.plus.aac.p.m4a\",\"track_name\":\"Cowboy Kind of Love\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Castellows\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb26419c7a8e491a4ac05b21b8\"},\"artist_id\":\"126978\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":8,\"event_tag\":null}],\"title\":\"Thu 30 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T17:00:00+00:00\",\"sale_end_date\":\"2026-07-31T11:00:00+01:00\",\"sale_start_date\":\"2026-02-04T12:00