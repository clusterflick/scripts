:\"eyJpZCI6MTA3ODY5OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDk1Mjc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTowMC4yMTUxOTJaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6MjMzOCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA3ODY5OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDk1Mjc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTowMC4yMTUyMDJaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjIzMzksInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Alexandra Park and Palace Charitable Trust\",\"charity_registration_number\":\"281991\"},\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:89\",\"tty_to_extras\":[{\"ticket_type_id\":1046824,\"extra_ids\":[\"1191888\"]},{\"ticket_type_id\":1046825,\"extra_ids\":[\"1191888\"]},{\"ticket_type_id\":1046826,\"extra_ids\":[\"1191888\"]},{\"ticket_type_id\":1046827,\"extra_ids\":[\"1191888\"]},{\"ticket_type_id\":1046828,\"extra_ids\":[\"1191888\"]}],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"id\":\"68a74c19b6baef000155d198\",\"name\":\"Fatboy Slim\",\"perm_name\":\"53g6p8-fatboy-slim-21st-feb-alexandra-palace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-19/232c5ab0-0b8a-417e-af26-0ddd3fef006a.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-19/232c5ab0-0b8a-417e-af26-0ddd3fef006a.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-19/232c5ab0-0b8a-417e-af26-0ddd3fef006a.jpg?rect=270%2C0%2C660%2C1200\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fatboy Slim\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebbbb4a8ed961af5b1989e2b6a\"},\"artist_id\":\"742\",\"about\":null,\"is_headliner\":true},{\"name\":\"Ewan McVicar\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-05-04/15cf72b9-e4ba-40fe-b9a6-7fd0806243d0.jpg?rect=0%2C53%2C534%2C534\"},\"artist_id\":\"29114\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1755860400,\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":23131,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23132,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5535},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Praise You - Radio Edit\",\"redirect_url