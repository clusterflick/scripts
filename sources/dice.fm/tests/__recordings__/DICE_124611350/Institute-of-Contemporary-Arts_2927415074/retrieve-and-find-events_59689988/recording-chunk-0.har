025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"A rising star in Brazil’s new wave of MPB, Rodrigo Alarcón crafts songs that balance tenderness and intensity in equal measure.\\n\\nMoving between intimate folk textures and sweeping, soulful arrangements, his sound is rooted in tradition yet reaches toward something timeless and universal.\\n\\nWith millions of streams and a devoted following across South America, Rodrigo has become one of the most exciting young voices to emerge from São Paulo’s vibrant scene.\\n\\nAs part of a special 10-year celebration of his debut release O Lado Vazio do Sofá, Rodrigo returns to London, bringing the songs that first captured hearts alongside his most recent work.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:55\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Uaa438c4ec9d?dice_id=Uaa438c4ec9d\",\"post_competition_referral\":\"https://link.dice.fm/S3ef1d03dbc3?dice_id=S3ef1d03dbc3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qcd18cd1c971?dice_id=Qcd18cd1c971\",\"post_purchase_referral\":\"https://link.dice.fm/ya834353aaf0?dice_id=ya834353aaf0\",\"post_reminder_referral\":\"https://link.dice.fm/W9caed006c4c?dice_id=W9caed006c4c\",\"post_waitinglist_referral\":\