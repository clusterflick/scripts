cked\":false,\"impression_id\":\"19a35eea7aa005ca:97\",\"date_unix\":1775152800,\"price\":{\"currency\":\"GBP\",\"amount\":1210,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/U93d46ccfa47?dice_id=U93d46ccfa47\",\"post_competition_referral\":\"https://link.dice.fm/j92b0ada775e?dice_id=j92b0ada775e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S12c3f51a4a8?dice_id=S12c3f51a4a8\",\"post_purchase_referral\":\"https://link.dice.fm/t4f3b780fc74?dice_id=t4f3b780fc74\",\"post_reminder_referral\":\"https://link.dice.fm/k65616ca5703?dice_id=k65616ca5703\",\"post_waitinglist_referral\":\"https://link.dice.fm/E4f4fbac94e3?dice_id=E4f4fbac94e3\"},\"perm_name\":\"2we797-n0trixx-dharma-hounds-sludhe-2nd-apr-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/f57d207e-eed0-49f9-b4a7-4b27d41fbf4f.jpg?rect=0%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/f57d207e-eed0-49f9-b4a7-4b27d41fbf4f.jpg?rect=0%2C416%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/f57d207e-eed0-49f9-b4a7-4b27d41fbf4f.jpg?rect=200%2C0%2C880%2C1600\"},\"properties\":[],\"about\":{\"description\":\"EMJAY SESSIONS RETURN\\n\\n***N0TRIXX***\\n\\nAt the heart of her music is her own darkness and suffering. She uses heavy trap beats, metal vocals and visceral lyrics to exorcise the demons that inhabit her.\\n\\nOriginally a Russian native, in March 2022, n0trixx protested against the war in Ukraine and was arrested. Unable to ignore the brutality and horrors of what was happening, n0trixx fled the country. She expressed all her pain in her lyrics and music.\\n\\nn0trixx is a passionate mental health advocate and encourages her fans to speak out about their problems and seek help for the issues that they face. She has first-hand knowledge of how fragile the human psyche can be, and she uses that knowledge to help others.\\n\\nIn 2024 n0trixx signed with Pharma, a sublabel of Universal Music Group and released the music video for her song ‘sepsis’. Her other accomplishments include The Artists Forum award in the best Hip-Hop/Rap Song category with her song ‘FARSH’. n0trixx’s ‘Sweet Baby’ was repeatedly aired on BBC Introducing and dubbed ‘a horror film in audio form.\\n\\nIn May 2024 n0trixx successfully toured Turkey as a farewell to the country that had been her home for the past two years. She leaves behind a loyal fanbase wherever in the world she plays.\\n\\nSupport from a local favourite ***Dharama Hounds*** & new kids on the block ***SLUDHE***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6900cb6593672600019e5d89\",\"name\":\"N0TRIXX / Dharma Hounds / Sludhe\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Thu 02 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
