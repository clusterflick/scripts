_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:8\",\"properties\":[],\"presented_by\":\"Presented by Human Punk.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767657600,\"id\":\"695d39d4f5816800019c77dd\",\"name\":\"Anti-Nowhere League\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Human Punk proudly presents:\\n\\nANTI-NOWHERE LEAGUE\\n\\nLive in concert at The 229 venue in the heart of London\\n\\nANWL don't play many shows now so each one is a real CELEBRATION. Expect to hear all the classics...Streets Of London, For You, We Are The League, Snowman, So What etc.. catch this band live while you still can!\\n\\nTwo headliners in their own right as supports to make this a proper ALL KILLER, NO FILLER bill\\n\\nSPECIAL DUTIES - classic UK82 band. Playing the big tunes from back in the day plus modern day classics.\\n\\nKID KLUMSY - another HUMAN PUNK fave band. We have to get them on every year!\\n\\nWith DJ sets before and inbetween live music from HUMAN PUNK ON 45 crew DR VINYL and JK HERBERT, Esq\\n\\nAn UNMISSABLE SHOW!!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"date_unix\":1791050400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2875},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T16:00:00+00:00\",\"sale_end_date\":\"2026-10-03T21:00:00+01:00\",\"sale_start_date\":\"2025-11-28T16:00:00+00:00\",\"event_start_date\":\"2026-10-03T19:00:00+01:00\",\"event_end_date\":\"2026-10-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bbxw8g-carbon-based-lifeforms-3rd-oct-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Carbon Based Lifeforms\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb844cc60dcd34bcd8ceb63c59\"},\"artist_id\":\"106801\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-03T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/52d2a3ed-60b6-4ce6-bc6a-0e7ed0ce4f53.jpg?rect=0%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/52d2a3ed-60b6-4ce6-bc6a-0e7ed0ce4f53.jpg?rect=0%2C800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/52d2a3ed-60b6-4ce6-bc6a-0e7ed0ce4f53.jpg?rect=900%2C0%2C2200%2C4000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ca6401a3bb86?dice_id=Ca6401a3bb86\",\"post_competition_referral\":\"https://link.dice.fm/v61632b80814?dice_id=v61632b80814\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bcdfac46d820?dice_id=bcdfac46d820\",\"post_purchase_referral\":\"https://link.dice.fm/P5bd01cec1dc?dice_id=P5bd01cec1dc\",\"post_reminder_referral\":\"https://link.dice.fm/W29b520e3194?dice_id=W29b520e3194\",\"post_waitinglist_referral\":\"https://link.dice.fm/Uae74f608ce5?dice_id=Uae74f608ce5\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:9\",\"properties\":[],\"presented_by\":\"Presented by Beautiful Burnouts.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764345600,\"id\":\"69287d0f8aacf6000185a4f7\",\"name\":\"Carbon Based Lifeforms\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Carbon Based Lifeforms (CBL) are Johannes Hedberg and Daniel Vadestrid based in Goteborg, Sweden.\\n\\nThey have released 7 official full length albums: ‘Hydroponic Garden’ (2003), ‘World of Sleepers’ (2006), ‘Interloper’ (2009) and ‘Twenty Three’ (2012), ‘Derelicts’ (2017), ‘Stochastic’ (2021) and ‘Seeker’ (2023).\\n\\nTheir music has been extraordinarily well received by connoisseurs within the ambient scene and well beyond. In a top 30 chart of the best Psybient albums of all time compiled by Rate Your Music, CBL were rated at # 1, 2, 5, 16 and 26 alongside such great artists as Sphongle, Solar Fields, Ott, AES Dana and many others.\\n\\nCBL aim to combine earth and space in their music, using the combination of nature and technology as the main inspiration for their work.\\n\\nThey have played all over Europe and the US including many festival appearances such as Symbiosis (US), Anthropos (UK) and Ozora (Hungry) and in April 2025 played an incredible sold out show at London EartH Theatre.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1791050400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2514,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-24T00:00:00+01:00\",\"sale_end_date\":\"2026-10-03T18:00:00+01:00\",\"sale_start_date\":\"2025-04-24T00:00:00+01:00\",\"event_start_date\":\"2026-10-03T19:00:00+01:00\",\"event_end_date\":\"2026-10-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_nam