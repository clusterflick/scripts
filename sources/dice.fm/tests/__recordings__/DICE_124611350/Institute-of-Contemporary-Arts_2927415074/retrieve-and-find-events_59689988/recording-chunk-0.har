le_referral\":\"https://link.dice.fm/o9ffcdd80890?dice_id=o9ffcdd80890\",\"post_purchase_referral\":\"https://link.dice.fm/wad7d6e83e40?dice_id=wad7d6e83e40\",\"post_reminder_referral\":\"https://link.dice.fm/H3951837a7a2?dice_id=H3951837a7a2\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ue457ca82503?dice_id=Ue457ca82503\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:62\",\"properties\":[],\"presented_by\":\"Presented by Como No!.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763114400,\"id\":\"6916f120d41d1f000137ed81\",\"name\":\"Paco De Lucia Legacy\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"A tribute celebrating Paco de Lucía's most revolutionary work: the second sextet, with which he redefined flamenco in his final years.\\n\\nThe performance features both a contemporary reinterpretation of his classic repertoire and original compositions that highlight Paco de Lucía’s musical and artistic legacy carried forward by new generations. More than a tribute to the past, the concert projects his legacy into the future – driving the evolution of flamenco and connecting with new audiences and artists around the globe.\\n\\nThe show features David de Jacoba - original member of Paco de Lucía’s septet. Joined by guest artists Josemi Carmona on guitars with Sandra Carrasco's unique vocals integrating influences from jazz and bossa nova. Renowned composer and pianist Chano Domínguez brings his fusion of jazz and flamenco alongside singer Duquende's deep, intuitive, and profoundly authentic sound.\\n\\nPerformers:\\n\\n- Josemi Carmona – guitar\\n- Sandra Carrasco – vocals\\n- Chano Domínguez – piano\\n- Duquende – vocals\\n- Farru – dance, choir, clapping\\n- Diego del Morao – guitar\\n- Alain Pérez – vocals\\n- Israel Suarez \\\"Piraña\\\" – cajón\\n- Antonio Sánchez – guitar\\n- Antonio Serrano – harmonica\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"5970\",\"name\":\"Como No!\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-09/a9850c4f-895d-494f-beec-abcf15aec03e.jpg\"},\"perm_name\":\"como-no-v7rd\",\"profile_active\":true},\"date_unix\":1775845800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1736,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T10:00:00+00:00\",\"sale_end_date\":\"2026-04-10T21:30:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-04-10T19:30:00+01:00\",\"event_end_date\":\"2026-04-10T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"yogq9p-mercy-girl-10th-apr-the-shacklewell-arms-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Mercy Girl - Heaven\",\"redirect_url\":\"https://open.spotify.com/track/4Q73GOQ3BiXQ9A7iKx4dbB\",\"artist\":\"Mercy Girl\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7ff52b29df0a882eb9cc24142fbb6db6c6f8309a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Heaven\"},{\"type\":\"apple_music\",\"title\":\"Mercy Girl - Heaven\",\"redirect_url\":\"https://music.apple.com/us/album/heaven/1776338861?i=1776338862&uo=4&at=1001ld8