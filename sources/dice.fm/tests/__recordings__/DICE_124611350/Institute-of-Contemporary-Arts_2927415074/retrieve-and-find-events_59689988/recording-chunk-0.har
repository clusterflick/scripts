",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T00:00:00+00:00\",\"sale_end_date\":\"2026-03-14T18:00:00+00:00\",\"sale_start_date\":\"2026-02-17T00:00:00+00:00\",\"event_start_date\":\"2026-03-14T19:00:00+00:00\",\"event_end_date\":\"2026-03-14T20:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/f440488c746b?dice_id=f440488c746b\",\"post_competition_referral\":\"https://link.dice.fm/b59606e1554d?dice_id=b59606e1554d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/rcd338f64011?dice_id=rcd338f64011\",\"post_purchase_referral\":\"https://link.dice.fm/l5c2aaa6764e?dice_id=l5c2aaa6764e\",\"post_reminder_referral\":\"https://link.dice.fm/abcb2ebd1f2b?dice_id=abcb2ebd1f2b\",\"post_waitinglist_referral\":\"https://link.dice.fm/B09797fd43fa?dice_id=B09797fd43fa\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"A Soulful Tribute to a Timeless Voice.\\n\\nIneza and her remarkable quintet present a special tribute to the legendary Randy Crawford, celebrating one of the most distinctive voices in soul and jazz history. Known for her warm tone, emotional depth and effortless phrasing, Crawford’s music has touched audiences across generations, from the timeless “One Day I’ll Fly Away” to the iconic “Street Life.”\\n\\nBringing her own expressive artistry to this repertoire, Ineza is uniquely placed to honour Crawford’s legacy. A Rwandan-born, Belgian-raised jazz vocalist based in the UK, she has earned critical acclaim for her powerful and deeply emotive voice, alongside performances with the BBC Concert Orchestra, Tom Odell, and leading jazz ensembles across Europe.\\n\\nHer debut album IBUKA (2025) has been praised for its storytelling, originality and emotional resonance, establishing her as a compelling voice in contemporary jazz.\\n\\nThis performance promises an evening of soulful classics, heartfelt ballads and groove-driven favourites, celebrating Randy Crawford’s music with both authenticity and fresh interpretation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773514800,\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":20,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:58\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"id\":\"69949d9e57beb20001ea5d75\",\"name\":\"The Music of Randy Crawford ft. Ineza\",\"perm_name\":\"k69rr9-the-music-of-randy-crawford-ft-ineza-14th-mar-toulouse-lautrec-london-ticket