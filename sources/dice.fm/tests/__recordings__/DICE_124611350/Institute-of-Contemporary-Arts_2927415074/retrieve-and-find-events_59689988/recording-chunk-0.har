25-09-26/a6503412-ce42-48ee-98b8-cdcd0d095297.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1759222800,\"max_tickets\":6,\"marketeers\":[{\"id\":941,\"name\":\"Bush Hall\",\"privacy_policy_link\":\"https://bushhallmusic.co.uk/pages/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Chesney Hawkes became one of the biggest pop stars of his era with his irresistible mega-hit ‘The One and Only’, becoming one of the most recognisable songs of a generation.\\n\\nHaving spent over a decade in LA, Chesney is finally back and bigger than ever, with his long awaited comeback album ‘Living Arrows’ securing BBC Radio 2’s coveted ‘album of the week’, and spawning the hit radio singles ‘Get A Hold Of Yourself’, ‘Live Forever’ and ‘LOUD!’.\\n\\nWith regular major television appearances including his iconic BBC Radio 2 ‘Piano Room’ and recent advance to the final of ‘Celebrity Big Brother’, Chesney is very much back in our lives, our ears and our hearts - Guilty pleasure to National Treasure!\\n\\nNew album \\\"Living Arrows\\\" Out Now!\\n\\nVIP\\n\\nUpgrade to VIP and enjoy exclusive early access to the venue! Meet Chesney Hawkes in person before the show, and take home a signed limited edition souvenir print and a commemorative tour laminate with lanyard. VIP tickets are strictly limited for each date, book early to avoid missing out. The ticket includes access to the gig.\\n\\n(VIP Customers should arrive at the venue 1hr 15mins before advertised door times)\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Bush Hall.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:54\",\"social_links\":{\"event_share\":\"https://link.dice.fm/xb188c7ca56e?dice_id=xb188c7ca56e\",\"post_competition_referral\":\"https://link.dice.fm/F729e4533c31?dice_id=F729e4533c31\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f902af4f18a6?dice_id=f902af4f18a6\",\"post_purchase_referral\":\"https://link.dice.fm/f5d7d77fe9f4?dice_id=f5d7d77fe9f4\",\"post_reminder_referral\":\"https://link.dice.fm/Ba29b8c71187?dice_id=Ba29b8c71187\",\"post_waitinglist_referral\":\"https://link.dice.fm/C577e398e3cf?dice_id=C577e398e3cf\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T10:00:00+01:00\",\"sale_end_date\":\"2026-03-18T18:00:00+00:00\",\"sale_start_date\":\"2025-09-30T10:00:00+01:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2946},\"properties\":[],\"billing_promoter\":{\"id\":\"1213\",\"name\":\"Bush Hall\",\"image\":{\"url\":null},\"perm_name\":\"bush-hall-r33w\",\"profile_active\":false},\"id\":\"68d6706d92cba40001a75f24\",\"seats_io_event_id\":null,\"name\":\"Chesney Hawkes\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"53alb8-chesney-hawkes-18th-mar-bush-hall-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unico