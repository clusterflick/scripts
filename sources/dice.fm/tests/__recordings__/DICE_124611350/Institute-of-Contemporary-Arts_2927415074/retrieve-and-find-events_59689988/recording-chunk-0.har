e\":\"https://dice-media.imgix.net/attachments/2025-11-27/37c7f6ef-eda1-45e7-a17a-2499a7538477.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/37c7f6ef-eda1-45e7-a17a-2499a7538477.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69284ea0bb422f0001ec2c12\",\"name\":\"Phoebe Katis + KONL\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"UK native Phoebe Katis is an artist blazing her own trail through the music world. Her recently released album A Coming of Age - a self-proclaimed 'identity crisis' - is Phoebe's most raw, radiant and eclectic collection of songs yet. She’s toured the globe with funk extraordinaire Cory Wong, collaborated with industry heavyweights like Scary Pockets, Dave Koz, and members of the Stephen Colbert Late Show house band (Louis Cato, Jon Lampley), and is now stepping out with her own headline tour.\\n\\nWhat to expect: a variety show in terms of genre, crossing funk-pop, disco, broadway and more, and a masterclass in musicianship and storytelling. Authentic, dynamic, and completely unmissable, catch her and her all star band this March 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T12:00:00+00:00\",\"sale_end_date\":\"2026-03-11T21:00:00+00:00\",\"sale_start_date\":\"2025-12-04T12:00:00+00:00\",\"event_start_date\":\"2026-03-11T19:00:00+00:00\",\"event_end_date\":\"2026-03-11T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Touches\",\"redirect_url\":\"https://open.spotify.com/track/6HCX4IvHDHCi94kHXpPz5U\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c8cf94aa47bee307662d7cb3008ffb972b35dfad?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Touches\"},{\"type\":\"apple_music\",\"title\":\"Phoebe Katis - Touches\",\"redirect_url\":\"https://music.apple.com/gb/album/touches/1451925593?i=1451925719&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Phoebe Katis\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/63/38/de/6338de06-f38a-cae3-59be-6ccd61274c86/mzaf_8296616342229388604.plus.aac.p.m4a\",\"track_name\":\"Touches\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ronald Langestraat\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273cc05b92c9f10565a08314321\"},\"artist_id\":\"66877\",\"about\":null,\"is_headliner\":false},{\"name\":\"Big Squeeze Soul\",\"image\":null,\"artist_id\":\"84209\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":57366,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-11T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1763031600,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ba36c16119a3?dice_id=Ba36c16119a3\",\"post_competition_referral\":\"https://link.dice.fm/v9131a6f46ff?dice_id=v9131a6f46ff\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j2fd9692feb8?dice_id=j2fd9692feb8\",\"post_purchase_referral\":\"https://link.dice.fm/j017b9b2421e?dice_id=j017b9b2421e\",\"post_reminder_referral\":\"https://link.dice.fm/gcb21af0d3e4?dice_id=gcb21af0d3e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/K012d8aae7ef?dice_id=K012d8aae7ef\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"v3b556-ronald-langestraat-11th-mar-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773255600,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:32\",\"price\":{\"currency\":\"GBP\",\"amount\":2130,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-13/2df10238-6029-46a5-85f6-35247c11acb1.jpg?rect=0%2C0%2C2027%2C2027\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-13/2df10238-6029-46a5-85f6-35247c11acb1.jpg?rect=0%2C379%2C2116%2C1270\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-13/2df10238-6029-46a5-85f6-35247c11acb1.jpg?rect=501%2C0%2C1115%2C2027\"},\"id\":\"6915b1f3250bf00001f1d405\",\"name\":\"Ronald Langestraat\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**A true underground visionary, this a uniquely rare opportunity to enter the cosmic, synth-like world of Ronald Langestraat.**\\n\\n**A key figure in Amsterdam’s 80s jazz scene, Ronald Langestraat spent years in obscurity, playing hotel lounges and recording alone. Decades later, a forgotten tape of his 1984 album Searching — a hazy blend of jazz, soul, and Moog funk — was unearthed by South of North, inspiring a new wave of leftfield artists.**\\n\\n**What once sounded too strange for its time now feels inspired — the work of an artist who never stopped exploring, even when no one was listening.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T11:00:00+00:00\",\"sale_end_date\":\"2026-03-11T19:00:00+00:00\",\"sale_start_date\":\"2025-11-13T11:00:00+00:00\",\"event_start_date\":\"2026-03-11T19:00:00+00:00\",\"event_end_date\":\"2026-03-11T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Maria Uzor\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-01-04/62360fc3-7df1-4566-bfd3-1dfc4da693d7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"27220\",\"about\":null,\"is_headliner\":false},{\"name\":\"TVAM\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1420a9e5aa02077043b83a1f\"},\"artist_id\":\"2411\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offe