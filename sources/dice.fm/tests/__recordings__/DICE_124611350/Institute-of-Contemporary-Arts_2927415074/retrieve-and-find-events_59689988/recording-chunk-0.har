:false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:30\",\"date_unix\":1777744800,\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Mbe8d7a7c452?dice_id=Mbe8d7a7c452\",\"post_competition_referral\":\"https://link.dice.fm/mc4bd52216cc?dice_id=mc4bd52216cc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/y2274b5c4463?dice_id=y2274b5c4463\",\"post_purchase_referral\":\"https://link.dice.fm/E7f4d4890807?dice_id=E7f4d4890807\",\"post_reminder_referral\":\"https://link.dice.fm/Pc7ce545856f?dice_id=Pc7ce545856f\",\"post_waitinglist_referral\":\"https://link.dice.fm/s7dd16624546?dice_id=s7dd16624546\"},\"perm_name\":\"ry9l2q-my-new-band-believe-2nd-may-earth-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/356ce66b-57a8-4569-a7c1-8a98f40fe5a6.jpg?rect=0%2C0%2C2750%2C2750\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/356ce66b-57a8-4569-a7c1-8a98f40fe5a6.jpg?rect=0%2C550%2C2750%2C1650\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/356ce66b-57a8-4569-a7c1-8a98f40fe5a6.jpg?rect=619%2C0%2C1513%2C2750\"},\"properties\":[\"selling_fast\"],\"about\":{\"description\":\"My New Band Believe, led by Cameron Picton, bassist and sometime frontman of black midi, with whom he practiced an explosive form of musical world-building, weaving complex storytelling through thrilling passages of controlled chaos. The moniker serves as an open invitation, a subtle nod to listeners willing to meet the music on its own terms, to reap the rewards of taking a flying leap into the dark. Picton leads his band so that each track forms, scatters and re-groups, the uplift of one song crashing head-long into the rush of another. Inspired by Bert Jansch’s hypnotic, hard-driving guitar, Judee Sill’s panoramic pop, and the terrifying possibility of dance music, My New Band Believe is both all-encompassing and constantly in flux.\\n\\nThis is a 16+ event. Each under 18 must be accompanied by a responsible adult who is over 21 (1:1 ratio). In order to verify your age, ID may be requested. For this reason, we advise that all customers bring valid ID. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"highlights\":[]},\"id\":\"6994460011d9560001b19abf\",\"name\":\"My New Band Believe\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Lecture 25\",\"redirect_url\":\"https://open.spotify.com/track/5NKOEid35mXxvcPbV11pLb\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/87ab8c5f579ad23df437aa68cbef031edf0b9c47?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Lecture 25\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"My New Band Believe\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-16/65e3a96d-617b-49ab-9d2d-2a475e258ba5.jpg?rect=0%2C0%2C2750%2C2750\"},\"artist_id\":\"134129\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-18T15:00:00+00:00\",\"sale_end_date\":\"2026-05-02T18:00:00+01:00\",\"sale_start_date\":\"2025-12-18T15:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:00:00+01:00\",\"event_end_date\":\"2026-05-02T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers