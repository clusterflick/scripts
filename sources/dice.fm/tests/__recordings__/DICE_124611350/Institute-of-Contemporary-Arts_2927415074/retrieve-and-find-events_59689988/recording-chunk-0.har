accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"*\\\\*For accessibility information please see the accessibility information button/link below*\\n\\nCarrie Baxter’s signature sound is a tapestry of experiences and influences that interweave\\n\\nto tell her unique story. The Waterford singer-songwriter blends neo-soul, R&B and jazz with deeply personal, confessional lyrics, and themes that explore the depths of the human experience.\\n\\nWith over 80 million Spotify streams, Carrie has been featured on RTE’s The Main Stage, BBC Radio 1, Notion, COLORS, Wonderland and BBC 6 Music.\\n\\nCarrie began her career by releasing singles that quickly gained attention for distinctive vocal, unique style and emotional depth. Her debut EP, 'Placebo', released in 2020, showcases her ability to mix genres while maintaining a cohesive and distinctive sound. She followed this with another EP, 'What Now', in 2021, which continued to build her reputation as an artist with the ability to craft songs that resonate deeply with listeners.\\n\\nCarrie’s debut full-length album is set for release in 2026 - her most personal work to date, exploring Carrie’s reflections on her identity, her psyche, her roots, her friendships, relationships, darkest moments, redemption and her spirituality. Baxter's journey is one of passion, perseverance and continuous growth. With her unique voice and artistic vision she is poised to solidify her name as one of the most exciting voices in the contemporary music landscape.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:37\",\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"presented_by\":\"Presented by Global Soul.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Carrie Baxter\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-20/fb625af9-c297-447e-8ee4-7686a8bc894d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"109627\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":910,\"name\":\"Global Soul\",\"privacy_policy_link\":\"https://globalsoulradio.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tra