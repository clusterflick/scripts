xtras_available_referral\":\"https://link.dice.fm/B1d119828989?dice_id=B1d119828989\",\"post_purchase_referral\":\"https://link.dice.fm/Qa8569e4923e?dice_id=Qa8569e4923e\",\"post_reminder_referral\":\"https://link.dice.fm/Kaa1b69982f2?dice_id=Kaa1b69982f2\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q65edf0bbd3f?dice_id=Q65edf0bbd3f\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Overshare\",\"redirect_url\":\"https://open.spotify.com/track/3FcVDLDB8k10OWca9c2CPl\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7e0f0696f55c95385cac9cc4bbc327030b39a17e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Overshare\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2586,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Citizen Live.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"11372\",\"name\":\"Citizen Live\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-04/3986ab94-e1cf-489e-95df-450093b12e1c.jpg\"},\"perm_name\":\"citizen-live-6al8\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"dkam3v-i-patagarri-6th-mar-dingwalls-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772825400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:95\",\"venues\":[{\"id\":\"101\",\"name\":\"Dingwalls\",\"address\":\"Middle Yard, Camden Lock, London NW1 8AB\",\"location\":{\"lat\":51.5414979,\"lng\":-0.145865500000014},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dingwalls-jan2\",\"accessibility\":{\"url\":\"https://dingwalls.com/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"I Patagarri \",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1debc2cf5f6cb913f3f3871c\"},\"artist_id\":\"112878\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"I PATAGARRI are the Milan-based band that has captured the attention of both audiences and critics with their unique style, blending gypsy jazz, swing, and blues. Francesco Parazzoli (trumpet and vocals), Jacopo Protti (guitar), Daniele Corradi (guitar), Giovanni Monaco (clarinet and saxophone) and Arturo Monaco (trombone and percussion) are young talents in their 20s and 30s, trained at the Giuseppe Verdi Conservatory in Milan and the Civic School of Jazz.\\n\\nThe band already boasts significant experience rooted in Milan’s local markets, where they began performing and immediately captured the attention of passersby. In 2024, they participated in the 18th edition of X Factor Italy, winning over both the audience and judge Achille Lauro: their single “Caravan”, included in the album X Factor Mixtape 2024, is a true cry of freedom.\\n\\nI PATAGARRI tripled their dates at both Hacienda and Alcatraz, showcasing a new addition to the band: Nicholas Guandalini on bass and double bass. In 2025, they took part in the Concertone del Primo Maggio in Rome, continuing their live journey on major institutional stages. On May 23, they released their debut album, “L’ultima ruota del caravan” (Warner Music Italy), and to celebrate its release, they made a surprise appearance on stage at the MI AMI Festival, one of Italy’s most important events dedicated to independent music.\\n\\nThrough the end of September, they will tour across Italy with the “L’ULTIMA RUOTA DEL CARAVAN TOUR ESTATE 2025.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T10:00:00+00:00\",\"sale_end_date\":\"2026-03-06T19:30:00+00:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:30:00+00:00\",\"event_end_date\":\"2026-03-06T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"693a9ed49a9528000141b652\",\"name\":\"I Patagarri\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-11/61c195c7-9510-4843-a76a-37f7ad869e05.jpg?rect=0%2C1118%2C5589%2C5589\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-11/61c195c7-9510-4843-a76a-37f7ad869e05.jpg?rect=0%2C2236%2C5589%2C3353\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-11/61c195c7-9510-4843-a76a-37f7ad869e05.jpg?rect=643%2C0%2C4304%2C7825\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1765533600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/s6e3728744d9?dice_id=s6e3728744d9\",\"post_competition_referral\":\"https://link.dice.fm/Wf443cdc0fe9?dice_id=Wf443cdc0fe9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Wdc552127696?dice_id=Wdc552127696\",\"post_purchase_referral\":\"https://link.dice.fm/maf8502fcaaf?dice_id=maf8502fcaaf\",\"post_reminder_referral\":\"https://link.dice.fm/a333021aef69?dice_id=a333021aef69\",\"post_waitinglist_referral\":\"https://link.dice.fm/yf4e54af1bd0?dice_id=yf4e54af1bd0\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"I PATAGARRI - Caravan\",\"redirect_url\":\"https://open.spotify.com/track/6mV89e2QFMpaPTDCsfwEZJ\",\"artist\":\"I PATAGARRI\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d3a4e145ae697ea625a3557743862421e21c59ee?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Caravan\"},{\"type\":\"apple_music\",\"title\":\"I patagarri - Caravan\",\"redirect_url\":\"https://music.apple.com/us/album/caravan/1780046234?i=1780046481&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"I patagarri\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/5e/ef/1a/5eef1af6-0ad4-9271-41de-34bb7f43fa3d/mzaf_5990284895149145080.plus.aac.p.m4a\",\"track_name\":\"Caravan\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 06 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
