r\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-10/bee75377-01c8-42e9-82b3-2978a24cfdda.jpg?rect=0%2C452%2C2183%2C2183\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-10/bee75377-01c8-42e9-82b3-2978a24cfdda.jpg?rect=0%2C889%2C2183%2C1310\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-10/bee75377-01c8-42e9-82b3-2978a24cfdda.jpg?rect=243%2C0%2C1698%2C3087\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1767949200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"How many hours do you spend on your phone?\\n\\nHow long do you allocate to aimlessly scrolling?\\n\\nDo you devote more time engaging with a screen then you do engaging with the people you love?\\n\\nWelcome to the world of FILTERED.\\n\\nComedic and naturalistic dialogue mixed with exciting and fresh choreography blended with powerful and emotive lyrics help transport the audience to a world consumed by likes, shares, retweets, and 'friend' requests.\\n\\nFILTERED takes an in depth look at the world of social media and how it affects the one generation who have never known a world without it...your children.\\n\\nThis event is taking place in #The\\\\_BRIT\\\\_Theatre presented by @british\\\\_airways.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by BRIT Kids Croydon\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:43\",\"social_links\":{\"event_share\":\"https://link.dice.fm/s8bf5c7bab03?dice_id=s8bf5c7bab03\",\"post_competition_referral\":\"https://link.dice.fm/be7192952e8e?dice_id=be7192952e8e\",\"p