d1-aab74add679d.jpg?rect=48%2C8%2C666%2C666\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-19/50894653-4515-47f7-84d1-aab74add679d.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-19/50894653-4515-47f7-84d1-aab74add679d.jpg?rect=173%2C0%2C422%2C768\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Kurtis Blow - The Breaks\",\"redirect_url\":\"https://open.spotify.com/track/4v9f595ZJ5iV4JxYuLKqK0\",\"artist\":\"Kurtis Blow\",\"preview_url\":\"https://p.scdn.co/mp3-preview/cee0220e286edcb0096573423f1df3b28961b270?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Breaks\"},{\"type\":\"apple_music\",\"title\":\"Kurtis Blow - The Breaks\",\"redirect_url\":\"https://music.apple.com/us/album/the-breaks/1442217354?i=1442217538&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kurtis Blow\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/ab/12/80/ab1280b7-5135-1842-4043-25ec81e38910/mzaf_7813998831274010083.plus.aac.p.m4a\",\"track_name\":\"The Breaks\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1763557200,\"max_tickets\":6,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**The founding father of hip-hop returns to London for an intimate show celebrating the roots of old-school rap.**\\n\\nSince 1979, Kurtis Blow has been breaking new ground—he signed raps first ever record deal, first gold-certified rap single with “The Breaks”—igniting a movement that now dominates popular culture.\\n\\nA living legend of 80s hip-hop, Blow has toured globally, performed with icons, and shaped the sound that would define generations.\\n\\nAn evening full of classic tracks, electro vibes, and undeniable nostalgia—an essential night for fans of old-school rap and anyone curious about the origins of hip-hop culture.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:12\",\"social_links\":{\"event_share\":\"https://link.dice.fm/td919d111cce?dice_id=td919d111cce\",\"post_competition_referral\":\"https://link.dice.fm/R9eae7c4dca5?dice_id=R9eae7c4dca5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/gfd6922f780a?dice_id=gfd6922f780a\",\"post_purchase_referral\":\"https://link.dice.fm/t7bdd3cd06bc?dice_id=t7bdd3cd06bc\",\"post_reminder_referral\":\"https://link.dice.fm/ta39ba1c3b0f?dice_id=ta39ba1c3b0f\",\"post_waitinglist_referral\":\"https://link.dice.fm/t3192a48da2c?dice_id=t3192a48da2c\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T13:00:00+00:00\",\"sale_end_date\":\"2026-02-17T19:00:00+00:00\",\"sale_start_date\":\"2025-11-19T13:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:00:00+00:00\",\"event_end_date\":\"2026-02-17T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"691d861adb147a000177debd\",\"seats_io_event_id\":null,\"name\":\"Kurtis Blow\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"ryamnw-kurtis-blow-17th-feb-the-jazz-cafe-london-tickets\",\"date_unix\":1771354800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:00:00+00:00\",\"doors_close_date\":\"2026-02-17T23:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Aerial Salad\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb8636189ec23151672a54e879\"},\"artist_id\":\"57300\",\"about\":null,\"is_headliner\":false},{\"name\":\"Die Spitz\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-06/11f52c37-af49-4c65-818f-a9b41ceee8aa.jpg?rect=0%2C200%2C800%2C800\"},\"artist_id\":\"54774\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"faqs\":[{\"id\":49208,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":49209,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":49210,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-14/a6b2405d-f74f-4e47-a4b8-e78c1e9ecda0.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-14/a6b2405d-f74f-4e47-a4b8-e78c1e9ecda0.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-14/a6b2405d-f74f-4e47-a4b8-e78c1e9ecda0.jpg?rect=563%2C0%2C1375%2C2500\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Die Spitz - Barricade\",\"redirect_url\":\"https://open.spotify.com/track/75WqC31borSgQfYMDqJmIm\",\"artist\":\"Die Spitz\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b5d9b92323fb9635757a62d31b5045ce1a7c7088?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Barricade\"},{\"type\":\"apple_music\",\"title\":\"Die Spitz - Throw Yourself to the Sword\",\"redirect_url\":\"https://music.apple.com/us/album/throw-yourself-to-the-sword/1817541158?i=1817541667&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Die Spitz\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/1d/91/12/1d911234-ecf1-5b7d-9e9c-9a7e001b9ae1/mzaf_1897989635765480913.plus.aac.p.m4a\",\"track_name\":\"Throw Yourself to the Sword\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1760432400,\"max_tickets\":6,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Die Spitz, the Austin, TX four-piece, released their explosive debut album, Something to Consume, and are ready to hit London!\\n\\nOn Something to Consume, Die Spitz combine their passion, friendship, identity, and artistry to fight against the inescapable decay that surrounds modern life. “There’s a political side to it, but addiction and love can also be all-consuming,” Eleanor Livingston says. And as the band trade off instruments, swapping songwriting and vocal duties, and generating powerful songwriting in concussive bursts, Die Spitz have created their own little pocket of the world where we can all stand on the edge together, as showcased by the album’s singles “Throw Yourself to the Sword,” “Pop Punk Anthem (Sorry for the Delay),” “Punishers,” and “RIDING WITH MY GIRLS,” alongside a video by Bita Ghassemi.\\n\\nSomething to Consume moves with rapturous conviction thanks in part to the deft production hand of Studio 4’s Will Yip (Turnstile, Mannequin Pussy). Though only recently in their 20s, Die Spitz’s impressive musicianship ties them clearly to a long lineage of frustrated people hoping to inspire change. “Some people aren’t interested in being political activists via music, but it weighs on me heavily and I feel misaligned with my calling if I don’t,” Chloe De St. Aubin says. “The four of us are free spirits with multiple interests, and there’s no limit or power dynamic that can derail us.”\\n\\nDie Spitz just finished a US tour supporting Viagra Boys, with a headline run in progress. Their infamous riotous live show, which regularly feature dueling cartwheels, climbing of rafters and solos while crowdsurfing, is not to be missed. All dates below.\\n\\nDie Spitz is Ava Schrobilgen, Chloe De St. Aubin, Eleanor Livingston, and Kate Halter.\\n\\nWATCH THE “RIDING WITH MY GIRLS” VIDEO: https://youtu.be/zVPFp4s2L_s\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"attendance