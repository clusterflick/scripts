etween The Buried And Me\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-07/248f6211-6cd6-4dcc-b996-00b325622cf0.jpg?rect=0%2C0%2C800%2C800\"},\"artist_id\":\"1104\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1755248400,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3931},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Between The Buried And Me - The Coma Machine\",\"redirect_url\":\"https://open.spotify.com/artist/2JC4hZm1egeJDEolLsMwZ9\",\"artist\":\"Between The Buried And Me\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d388cb10cfcd87e1bf4f71743efe934781a77320\",\"track_name\":\"The Coma Machine\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T00:00:00+00:00\",\"sale_end_date\":\"2026-02-19T22:30:00+00:00\",\"sale_start_date\":\"2026-01-20T00:00:00+00:00\",\"event_start_date\":\"2026-02-19T19:30:00+00:00\",\"event_end_date\":\"2026-02-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Big Richards Records Ltd.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers