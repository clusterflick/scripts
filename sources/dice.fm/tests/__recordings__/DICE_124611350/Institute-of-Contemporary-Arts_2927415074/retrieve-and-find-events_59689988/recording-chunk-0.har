ile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:29\",\"date_unix\":1783706400,\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/ia0c059fd9cb?dice_id=ia0c059fd9cb\",\"post_competition_referral\":\"https://link.dice.fm/U46ca5acbfb9?dice_id=U46ca5acbfb9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J41f54da76e0?dice_id=J41f54da76e0\",\"post_purchase_referral\":\"https://link.dice.fm/rbd6f6e8ebfc?dice_id=rbd6f6e8ebfc\",\"post_reminder_referral\":\"https://link.dice.fm/Q66ac684a36d?dice_id=Q66ac684a36d\",\"post_waitinglist_referral\":\"https://link.dice.fm/e1a3bfd572da?dice_id=e1a3bfd572da\"},\"perm_name\":\"xe7nq3-carrtoons-10th-jul-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/597037c5-419b-4e41-a9a4-4ea2b3bab73c.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/597037c5-419b-4e41-a9a4-4ea2b3bab73c.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/597037c5-419b-4e41-a9a4-4ea2b3bab73c.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"**New York multi-instrumentalist CARRTOONS (Ben Carr) has fast become one of the most exciting names in contemporary jazz, soul and hip-hop.**\\n\\nFrom viral social media moments to four NPR Tiny Desk appearances, his unmistakable bass lines and retro-inspired grooves have earned him co-signs from legends like DJ Jazzy Jeff and Pete Rock.\\n\\nHaving collaborated with icons across genres—from Usher and Freddie Gibbs to Roy Ayers, Nate Smith, and George Clinton—he never loses sight of the playful, soulful sound that defines him.\\n\\nBringing his acclaimed project Space Cadet—featuring Pale Jay, Rae Khalil, Wiki and Erick the Architect—CARRTOONS steps out for a rare live show of his trademark bass-driven grooves.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"693024782821140001ab2e27\",\"name\":\"CARRTOONS\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Kount, CARRTOONS - On My Way\",\"redirect_url\":\"https://open.spotify.com/track/284dZP2uHiNlX2NitwREww\",\"artist\":\"The Kount, CARRTOONS\",\"preview_url\":\"https://p.scdn.co/mp3-preview/cd89a939acc4163c659efb568f120825ab806af1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"On My Way\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"CARRTOONS\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-26/663dea35-8704-4eab-865a-432b3715a939.jpg?rect=331%2C0%2C1216%2C1216\"},\"artist_id\":\"29364\",\"about\":null,\"is_headliner\":false},{\"name\":\"Haile Supreme\",\"image\":null,\"artist_id\":\"63813\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gareth Donkin\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb67fde5ff68894c8907ebdd72\"},\"artist_id\":\"94283\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T00:00:00+00:00\",\"sale_end_date\":\"2026-07-11T03:30:00+01:00\",\"sale_start_date\":\"2026-02-11T00:00:00+00:00\",\"event_start_date\":\"2026-07-10T22:00:00+01:00\",\"event_end_date\":\"2026-07-11T06:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":1813,\"name\":\"E1 London\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"865291950713044\",\"ga_tr