ost_competition_referral\":\"https://link.dice.fm/x25f9d130892?dice_id=x25f9d130892\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q8a8b146cd71?dice_id=Q8a8b146cd71\",\"post_purchase_referral\":\"https://link.dice.fm/u8a123aff6ae?dice_id=u8a123aff6ae\",\"post_reminder_referral\":\"https://link.dice.fm/A4fc5295bcdf?dice_id=A4fc5295bcdf\",\"post_waitinglist_referral\":\"https://link.dice.fm/p15bb905c3e6?dice_id=p15bb905c3e6\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yoak32-ncalma-collective-17th-anniversary-aleh-ferreira-3rd-apr-grow-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775242800,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:40\",\"price\":{\"currency\":\"GBP\",\"amount\":612,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/1323b9a4-05df-4bad-975a-ccc8ad6f418c.jpg?rect=182%2C0%2C1067%2C1067\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/1323b9a4-05df-4bad-975a-ccc8ad6f418c.jpg?rect=0%2C54%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/1323b9a4-05df-4bad-975a-ccc8ad6f418c.jpg?rect=507%2C0%2C587%2C1067\"},\"id\":\"698f5b11a9ed3b0001aa71bb\",\"name\":\"N'Calma Collective 17th Anniversary: Aleh Ferreira\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"This Good Friday, N’Calma Collective returns to Grow Hackney to celebrate 17 years of championing Afro-Brazilian sound system culture with a landmark anniversary session and the perfect way to start your Easter weekend.\\n\\nHeadlining is Brazilian singer-songwriter Aleh Ferreira, best known as the frontman of legendary samba-funk pioneers Banda Black Rio. With a career spanning three decades, Aleh’s warm, unmistakable voice and deep Afro-Brazilian grooves have earned him recognition across Brazil, Europe and beyond. A key figure in contemporary música popular brasileira in the diaspora, he has shared stages with artists including Seu Jorge, Ed Motta and Daniela Mercury.\\n\\nBringing his full band to Grow, expect a powerful, high-energy live show packed with soul, rhythm and serious dance floor heat.\\n\\nBefore and after the live set, DJ Tigas takes control with Afro-Brazilian beats, Latin grooves and global rhythms all night long.\\n\\nENTRY INFORMATION\\n\\n£5/£7 advance tickets on DICE\\n\\nFree before 9pm\\n\\n£10 on the door\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T00:00:00+00:00\",\"sale_end_date\":\"2026-04-03T19:30:00+01:00\",\"sale_start_date\":\"2026-02-13T14:00:00+00:00\",\"event_start_date\":\"2026-04-03T20:00:00+01:00\",\"event_end_date\":\"2026-04-04T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Blues Kitchen Shoreditch.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"1780\",\"name\":\"The Blues Kitchen Shoreditch\",\"address\":\"134-146 Curtain Rd, London EC2A 3AR, UK\",\"location\":{\"lat\":51.52664249999999,\"lng\":-0.07999960000006467},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\