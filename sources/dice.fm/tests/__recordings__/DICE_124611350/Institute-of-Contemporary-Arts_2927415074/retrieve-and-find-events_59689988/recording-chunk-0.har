0\",\"sale_end_date\":\"2026-02-18T21:00:00+00:00\",\"sale_start_date\":\"2025-06-20T10:00:00+01:00\",\"event_start_date\":\"2026-02-18T19:00:00+00:00\",\"event_end_date\":\"2026-02-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2489,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"684835be4acfd00001d3487f\",\"seats_io_event_id\":null,\"name\":\"Coach Party \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"l8ea8r-coach-party-18th-feb-islington-assembly-hall-london-tickets\",\"date_unix\":1771441200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"12564\",\"name\":\"All Is Joy\",\"address\":\"75 Dean Street, Westminster, London, W1D 3RQ, United Kingdom\",\"location\":{\"lat\":51.513734,\"lng\":-0.132527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"all-is-joy-ydwp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kwerk\",\"image\":null,\"artist_id\":\"133732\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/f5b610a9-aa10-478d-80d4-8b6d06e081c6.jpg?rect=0%2C67%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/f5b610a9-aa10-478d-80d4-8b6d06e081c6.jpg?rect=0%2C283%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/f5b610a9-aa10-478d-80d4-8b6d06e081c6.jpg?rect=206%2C0%2C668%2C1214\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770389100,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"kWeRk + CH20 (AV Set)\\n\\nkWeRk operates in the realm of audio exploration with a focus on process, play &\\n\\nthe dance between the utterances of sound machines and the sensibilities of their human operators.\\n\\nProcessing, modulating, warping & mangling synthesized sounds & field recordings in the search for textural and emotional landscapes amidst the circuitry and 0s & 1s.\\n\\nhttps://artkwerk.bandcamp.com/album/mirai-otoko\\n\\n@kwerksoundpowe\\n\\nCH20\\n\\nCH2O (Chiara Zaccagnini) forges ever-evolving art fragments through digital media, drawing on her background in architecture to treat computational systems as spatial and sculptural material. Her London-based, research-led practice operates at the intersection of generative design, environmental awareness, and latent digital processes, examining how perception, memory, and space are continuously reconfigured.\\n\\nWorking within the threshold between analog and digital, CH2O constructs immersive environments where real imagery is destabilised through noise, sound input, and algorithmic behaviour. These hybrid visual architectures function as speculative visions that breathe, mutate, and reveal fragile entanglements between humans, nature, and evolving technologies.\\n\\n@ch2o\\n\\nhttps://www.chiarazaccagnini.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"OBLIQUE_FUTURES\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:31\",\"social_links\":{\"event_share\":\"https://link.dice.fm/p03e6febad6b?dice_id=p03e6febad6b\",\"post_competition_referral\":\"https://link.dice.fm/ue4753b4c677?dice_id=ue4753b4c677\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N466b2e8d3cf?dice_id=N466b2e8d3cf\",\"post_purchase_referral\":\"https://link.dice.fm/M9b956ff873c?dice_id=M9b956ff873c\",\"post_reminder_referral\":\"https://link.dice.fm/L7a615c78f49?dice_id=L7a615c78f49\",\"post_waitinglist_referral\":\"https://link.dice.fm/b0803b0c528e?dice_id=b0803b0c528e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T14:45:00+00:00\",\"sale_end_date\":\"2026-02-18T22:30:00+00:00\",\"sale_start_date\":\"2026-02-06T14:45:00+00:00\",\"event_start_date\":\"2026-02-18T19:00:00+00:00\",\"event_end_date\":\"2026-02-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"427\",\"name\":\"1-2-3-4\",\"image\":{\"url\":null},\"perm_name\":\"1-2-3-4-zl5x\",\"profile_active\":false},\"id\":\"6985fb3f0e17160001457733\",\"seats_io_event_id\":null,\"name\":\"LIVE AV - kWeRk + CH20 / BAD ABSTRACTION / BJORN HATLESKOG\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"avpn2q-live-av-kwerk-ch20-bad-abstraction-bjorn-hatleskog-18th-feb-all-is-joy-london-tickets\",\"date_unix\":1771441200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5484\",\"name\":\"Next Door Records\",\"address\":\"304 Uxbridge Rd, London W12 7LJ, UK\",\"location\":{\"lat\":51.5063731,\"lng\":-0.2315609},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"next-door-records-qgaa\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/e0ebee51-90bb-4f30-8732-55b1318efedf.jpg?rect=683%2C0%2C2685%2C2685\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/e0ebee51-90bb-4f30-8732-55b1318efedf.jpg?rect=0%2C128%2C4050%2C2430\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/e0ebee51-90bb-4f30-8732-55b1318efedf.jpg?rect=1287%2C0%2C1477%2C2685\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Cora - Quarry\",\"redirect_url\":\"https://open.spotify.com/track/6rRAyzm2c6Mx8ezLtcf5Xk\",\"artist\":\"Cora\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6bea83789d348b8d0ebcc28df651694710cb803b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Quarry\"},{\"type\":\"apple_music\",\"title\":\"Cora - Quarry\",\"redirect_url\":\"https://music.apple.com/us/album/quarry/1829592997?i=1829592998&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Cora\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/18/1b/02/181b02f4-0144-ae83-c49c-f5f84ed03748/mzaf_5846703054525720646.plus.aac.p.m4a\",\"track_name\":\"Quarry\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769644800,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**Cora** is back at Next Door Records with her band to celebrate the release of the first single \\\"Football Field\\\" from her debut EP, \\\"Head Rush\\\". Cora takes a raw and vulnerable approach to writing lyrics, drawing on relatable and often messy life experiences, to create music that offers a space for healing and growth. Having grown up in the Irish trad music scene in Co.Derry, her melodies are heavily influenced by the decorative and emotive style of Irish traditional singing. Since moving to London in 2021, she has developed her authentic and original sound which has led to performing in many established venues across London, including 02 Shepherd’s Bush, Troubadour and sold out Notting Hill Arts Club for the release of her debut single No Easy Road. Cora has also appeared at major UK festivals such as The Great Escape festival in 2025 and 2000 Trees in 2024.\\n\\n**SUPPORT FROM CLOVE**\\n\\n22 year old **CLOVE** was raised on the East Coast of Australia, absorbing the untamed energy of the Aussie live music scene, and drawing influence from the sounds of Wolf Alice, Radiohead and Jeff Buckley.\\n\\nA Clove show radiates an enchanting energy, centred by the emotional and sometimes deliriously raw experience of being a woman and a young person in the modern world. In her music she exudes a femininity that is both gentle and strong, creating a safe space for the audience to be vulnerable in the moment and feel united by a shared love of music in scary times.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Next Door Records.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d