rn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772132400,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:68\",\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/58fb8ce6-29d1-4820-bdbe-7a83d5f78d9f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/58fb8ce6-29d1-4820-bdbe-7a83d5f78d9f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/58fb8ce6-29d1-4820-bdbe-7a83d5f78d9f.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6989dd3987bb3d0001273858\",\"name\":\"Lexi Berg Presents\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Lexi Berg\\n\\nBack from a summer of festivals, including her debut Glastonbury performance, Lexi Berg is a rising Swedish-American singer-songwriter making waves with her cinematic blend of 70s-inspired indie pop, soulful Americana, and raw piano ballads. Her music, described as both nostalgic and fresh, has earned comparisons to Lana Del Rey, Stevie Nicks, and Adele—inviting audiences into a world that’s as intimate as it is epic.\\n\\nSATRE\\n\\nSwedish-born musician who moved from Stockholm to London in late 2018 to further his musical journey. Over the years he has become known for emotional, energetic live performances—often busking on London streets—where he connects deeply with his audience. His voice is distinctive for its wide range, encompassing deep, soft tones, soaring falsetto as well as higher raspy notes that give his music an expressive edge.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"e