e\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Old Blue Last.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:21\",\"social_links\":{\"event_share\":\"https://link.dice.fm/ge73737b79ac?dice_id=ge73737b79ac\",\"post_competition_referral\":\"https://link.dice.fm/Ed7012eacab8?dice_id=Ed7012eacab8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F1afe0ef98d0?dice_id=F1afe0ef98d0\",\"post_purchase_referral\":\"https://link.dice.fm/O79b9933e0bf?dice_id=O79b9933e0bf\",\"post_reminder_referral\":\"https://link.dice.fm/T352e48e5804?dice_id=T352e48e5804\",\"post_waitinglist_referral\":\"https://link.dice.fm/W353563f0f9e?dice_id=W353563f0f9e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T00:00:00+00:00\",\"sale_end_date\":\"2026-02-17T22:30:00+00:00\",\"sale_start_date\":\"2026-01-12T00:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:30:00+00:00\",\"event_end_date\":\"2026-02-17T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"13418\",\"name\":\"The Old Blue Last\",\"image\":{\"url\":null},\"perm_name\":\"the-old-blue-last-9vy9\",\"profile_active\":false},\"id\":\"696517ccf431130001b3df31\",\"seats_io_event_id\":null,\"name\":\"OBL CURATES: M.Woodroe + Wasabi + Two Hands Will Reach Out\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8bewl-obl-curates-mwoodroe-wasabi-two-hands-will-reach-out-17th-feb-the-old-blue-last-london-tickets\",\"date_unix\":1771356600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:30:00+00:00\",\"doors_close_date\":\"2026-02-17T23:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":44856,\"title\":\"What to do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":0},{\"id\":44857,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":1},{\"id\":44858,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":44859,\"title\":\"A show is listed as sold out. How can I get tickets?\",\"body\":\"If a show is listed as sold out on this website then our venue is full to capacity. We recommend you download the DICE app and join the Waiting List for return tickets.\\n\\nYou are welcome to visit the box office when doors open for the event to see if there are any door tickets. We cannot guarantee door tickets will be available in advance. Sorry.\",\"order\":3},{\"id\":44860,\"title\":\"I have mobility issues. How can you help?\",\"body\":\"If you need a seat for medical reasons or need help moving around our venue, or if you’d like to bring a companion along to help you with mobility, you will need to arrange it with us in advance. We suggest you read our accessibility guide and then contact our box office.\",\"order\":4},{\"id\":44861,\"title\":\"Do I need ID? What type of ID is accepted?\",\"body\":\"Bring ID if you look 25 years of age or younger. We accept the following forms of photo ID.\\n\\n\\\\- Passport\\n\\n\\\\- Driving licence card\\n\\n\\\\- PASS card. You can apply for a PASS card at www.pass-scheme.org.uk\",\"order\":5},{\"id\":44862,\"title\":\"Can I bring food?\",\"body\":\"We do not allow you to bring food or drink into the venue. Chewing gum is also not permitted inside the venue.\",\"order\":6},{\"id\":44863,\"title\":\"Is there a cloakroom?\",\"body\":\"Yes, we have a cloakroom in the Foyer Bar space. As you walk up the entrance stairs and straight ahead towards the Foyer Bar the cloakroom is on the left. Each item is charged at £3.\",\"order\":7}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-16/1c043b94-6195-4d95-b77b-42529bc4a365.jpg?rect=327%2C0%2C1395%2C1395\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-16/1c043b94-6195-4d95-b77b-42529bc4a365.jpg?rect=0%2C83%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-16/1c043b94-6195-4d95-b77b-42529bc4a365.jpg?rect=641%2C0%2C767%2C1395\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Normal to Me\",\"redirect_url\":\"https://open.spotify.com/track/1DzGRy6OTsdTuOn7ZU1dCx\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b26c0b8a9e9c5d93dcf9d6fd45b3afba0ce30a5d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Normal to Me\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1758124800,\"max_tickets\":6,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Rocket have had a busy few years. The Los Angeles crew with friendships stretching back to their childhood formed in 2021, convening in an unmarked shed to put their debut EP to tape. Despite it being the first time Alithea Tuttle (vocals, bass), Baron Rinzler (Guitar), Cooper Ladomade (Drums) and Desi Scaglione (Guitar) had ever seriously approached the idea of a ‘band,’ they seemed to arrive fully formed with combustible, airtight songs.\\n\\nR is for Rocket, the quartet’s remarkable debut album, is a joyride through sonic terrain that is gloriously loud, anthemic, bombastic and beautiful, with instantly captivating songs that achieve the rare feat of evoking nostalgia while sounding completely new. Tracks such as “One Million,” “Wide Awake,” “Crossing Fingers” and “The Choice” display Rocket’s dreamy intensity, with their thick blast of guitars and driving rhythms balanced by Tuttle’s sweetly hypnotic vocals and dynamic shifts that leave you weak in the knees.\\n\\nThe band’s jagged, fuzzed-out sound has antecedents in ‘90s guitar bands like Sonic Youth and My Bloody Valentine, but Rocket are doing something uniquely their own with those touchstones. It’s no wonder they are widely considered one of the most promising guitar-forward bands of their generation. While the album builds on the energy of their critically lauded Versions of You EP, R is for Rocket is also hugely evolutionary, elevating the band’s craft in major ways.\\n\\nBy the time they began work on the album in early 2024, they’d been on a near constant touring schedule, spending countless hours on the road opening for their heroes Ride, Sunny Day Real Estate and Silversun Pickups, and writing in their modest studio – a back house in drummer Cooper Ladomade’s parents’ yard – both refining and expanding their sound.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Live Nation.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:22\",\"social_links\":{\"event_share\":\"https://link.dice.fm/hd82f76374d7?dice_id=hd82f76374d7\",\"post_competition_referral\":\"https://link.dice.fm/g16a25505712?dice_id=g16a25505712\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Cc7cd9ea6e83?dice_id=Cc7cd9ea6e83\",\"post_purchase_referral\":\"https://link.dice.fm/F11c084e9145?dice_id=F11c084e9145\",\"post_reminder_referral\":\"https://link.dice.fm/ba7e2fefa0e7?dice_id=ba7e2fefa0e7\",\"post_waitinglist_referral\":\"https://link.dice.fm/e0d9158d2cfe?dice_id=e0d9158d2cfe\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T17:00:00+01:00\",\"sale_end_date\":\"2026-02-17T18:30:00+00:00\",\"sale_start_date\":\"2025-09-19T10:00:00+01:00\",\"event_start_date\":\"2026-02-17T19:30:00+00:00\",\"event_end_date\":\"2026-02-17T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2252,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"id\":\"68c8246d70d503000164b601\",\"seats_io_event_id\":null,\"name\":\"Rocket\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"eoaemw-rocket-17th-feb-scala-london-tickets\",\"date_unix\":1771356600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"4528\",\"name\":\"St Matthias Church\",\"address\":\"Wordsworth Rd, Stoke Newington, London N16 8DD, UK\",\"location\":{\"lat\":51.55245480000001,\"lng\":-0.08014030000000001},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"st-matthias-church-kbl9\",\"accessibility\":{\"url\":\"https://stmchurch.co.uk/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jozef van Wissem.\",\"image\":null,\"artist_id\":\"3703\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-12/9f37802c-3071-433e-821f-4e0244ce4934.jpg?rect=734%2C0%2C2205%2C2205\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-12/9f37802c-3071-433e-821f-4e0244ce4934.jpg?rect=0%2C205%2C2992%2C1795\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-12/9f37802c-3071-433e-821f-4e0244ce4934.jpg?rect=890%2C0%2C1213%2C2205\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Jozef Van Wissem - Apology\",\"redirect_url\":\"https://open.spotify.com/track/2yfkIk74snxxoITu4AGK5c\",\"artist\":\"Jozef Van Wissem\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fcc9f71f3a3dd5825442d6799a1d9ceda9e341ff?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Apology\"},{\"type\":\"apple_music\",\"title\":\"Jozef Van Wissem - Apology\",\"redirect_url\":\"https://music.apple.com/us/album/apology/698405872?i=698405881&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Jozef Van Wissem\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/f4/ef/63/f4ef63ed-112f-d986-4aa5-f7804ca4e151/mzaf_6392825284311886405.plus.aac.p.m4a\",\"track_name\":\"Apology\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1758099600,\"max_tickets\":6,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nJozef Van Wissem - The Cabinet of Dr. Caligari - Live Soundtrack\\n\\nSt Matthias Church - February 17th\\n\\nAccording to The New York Times “Van Wissem is both an avant-garde composer and a baroque lutenist, and thus no stranger to dichotomy”. He has gained recognition for his innovative approach, the “liberation of the lute”, as he describes it. Jozef Van Wissem is an avant-garde composer and lutenist who plays his unique all-black baroque lute all over the world. His timeless music is often described as hypnotic, minimal, and hauntingly atmospheric, merging beauty with a dark, meditative edge. His lyrics have a mythical Christian appeal, incorporating themes of love, faith, and the afterlife, often with a repetitive, mantra-like quality. He studied lute in New York with Patrick O’Brien in the 1990s and has since built a career that bridges classical traditions with modern sounds like drones, electronics, field recordings and voice.\\n\\nHe collaborates with filmmaker and musician Jim Jarmusch, including the award-winning soundtrack for Only Lovers Left Alive, for which Van Wissem won the Cannes Soundtrack Award in 2013. A world tour with Jarmusch and their 5th record “ The Day The Angels Cried” is coming up in 2025.\\n\\nHis solo work spans albums like Stations of The Cross (2008) which Wire Magazine labeled a small masterpiece, New Lute Music For Film (2013) and Behold! I Make All Things New (2022), as well as scores for films like Un Prince (2023).\\n\\nVan Wissem tours extensively, performing in diverse venues from rock festivals to churches, and has worked with artists like Tilda Swinton and Zola Jesus. In 2019 he was commissioned by Cinematheque Francaise to score the silent horror film Nosferatu (1922). He released the soundtrack in 2022 on his own Incunabulum label. The New York Times wrote: Beginning with a solo played on the lute, his performance will incorporate electric guitar and distorted recordings of extinct birds, graduating from subtlety to gothic horror. “My soundtrack goes from silence to noise over the course of 90 minutes,” he said, culminating in “dense, slow death metal.” In 2024 Van Wissem did a sold out nationwide American tour with the film. He has scored numerous feature films and documentaries.\\n\\nIn 2022 four of his compositions including the vocal piece “Love Destroys All Evil” were featured in HBO’s Irma Vep Series (starring Alicia Vikander). In 2023 Van Wissem scored the Cannes Award winning film Un Prince. The New York Times wrote ” A subtly medieval score — distinguished by the thrum of a lute and composed by Jozef van Wissem — draws out a surreal dimension. Eventually, the film shifts into explicitly sexual and mythological terrain with a B.D.S.M. edge, and the score keeps pace, taking on a folk metal vibe.” His latest projects include the 2024 album The Night Dwells in the Day. The Chicago Reader said “ On The Night Dwells in the Day, he bolsters the lute’s delicate progress through the palindromic melodic structures of his compositions using sequenced beats, subliminal electronic drones, and stern intonations”. In 2024 Van Wissem was commissioned to score the silent film The Fall Of The House Of Usher (1928). In 2026 he will premiere his new live score for The Cabinet Of Dr. Caligari (1920).\\n\\nA new solo record and worldwide tour is slated for early 2026. He will be performing all new material consisting amongst others of cinematic hypnotist slide lute pieces evoking contemporary deserted landscapes.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:23\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Ud79b8a8a21e?dice_id=Ud79b8a8a21e\",\"post_competition_referral\":\"https://link.dice.fm/I9505d0adb7b?dice_id=I9505d0adb7b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Nfb39cd5a334?dice_id=Nfb39cd5a334\",\"post_purchase_referral\":\"https://link.dice.fm/Na41d7057e24?dice_id=Na41d7057e24\",\"post_reminder_referral\":\"https://link.dice.fm/k84faeedbe0c?dice_id=k84faeedbe0c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q968989f538f?dice_id=Q968989f538f\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-17T18:00:00+00:00\",\"sale_start_date\":\"2025-09-17T10:00:00+01:00\",\"event_start_date\":\"2026-02-17T19:30:00+00:00\",\"event_end_date\":\"2026-02-17T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2703,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"id\":\"68c4103422766400015b33ae\",\"seats_io_event_id\":null,\"name\":\"Jozef Van Wissem - The Cabinet of Dr. Caligari - Live Soundtrack\",\"offers_extras