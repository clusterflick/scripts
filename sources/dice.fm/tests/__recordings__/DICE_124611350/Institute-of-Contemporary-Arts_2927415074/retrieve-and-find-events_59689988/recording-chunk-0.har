":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"st-matthias-church-kbl9\",\"accessibility\":{\"url\":\"https://stmchurch.co.uk/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Clara Pople\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-09/5f0b5c82-1744-4cc0-bb44-03598c896a5e.jpg?rect=0%2C277%2C2711%2C2711\"},\"artist_id\":\"59120\",\"about\":{\"description\":\"Clara Pople is the electronic folk trip/pop singer whose music fuses worlds — ancient and urban, ethereal and raw. A classically trained vocalist with Scottish roots and Cumbrian beginnings, she blends ghostly Celtic folk melodies with the shadowy pulse of trip-hop. Think stormy coastlines tangled with city sirens.\\n\\nClara channels the spiritual intensity of the natural world into a sound that feels both grounded and otherworldly. Her voice — part choirgirl clarity, part smoky soul — has drawn comparisons to London Grammar, Massive Attack, and Florence & The Machine.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/73a383c6-69a8-4905-8c5e-4ec4b7395985.jpg?rect=0%2C0%2C3278%2C3278\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/73a383c6-69a8-4905-8c5e-4ec4b7395985.jpg?rect=0%2C1065%2C3278%2C1967\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/73a383c6-69a8-4905-8c5e-4ec4b7395985.jpg?rect=513%2C0%2C2253%2C4097\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Clara Pople - Hot Moon\",\"redirect_url\":\"https://open.spotify.com/track/2oxypOOEzyXkbVztZrK4BD\",\"artist\":\"Clara Pople\",\"preview_url\":\"https://p.scdn.co/mp3-preview/51093f507499c134e76a87e6097f59a5c289434f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Hot Moon\"},{\"type\":\"apple_music\",\"title\":\"Clara Pople - Hot Moon\",\"redirect_url\":\"https://music.apple.com/us/album/hot-moon/1858225811?i=1858225983&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Clara Pople\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/fe/84/b6/fe84b6e7-8c80-f0f6-2698-32e1c23d47d8/mzaf_10269536235369372734.plus.aac.p.m4a\",\"track_name\":\"Hot Moon\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1767952800,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Clara Pople takes her 3rd EP PARYS MOUNTAIN on her much anticipated Church Tour in March 2026. Ancient choruses to electronic beats. A pagan at a rave. A warrior woman in trainers. Celtic trip/pop priestess coming to a house of worship near you.\\n\\nOn tour with her full band of drums, guitar and harp. Trip hop electronic drum beats, piercing grunge guitar, an ethereal choir of Clara's vocal harmonies, all topped off with the inevitably gorgeous lullaby harp. Industrial sounds with organic instruments, ancient sonic rituals with futuristic production.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Clara Pople.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:66\",\"social_links\":{\"event_share\":\"https://link.dice.fm/h3b95dab840e?dice_id=h3b95dab840e\",\"post_competition_referral\":\"