cdn.co/mp3-preview/4f5606c2ad56ba12f43084addd2ec42be9b26ae1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Black Bag\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"TV FACE\",\"image\":null,\"artist_id\":\"54354\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T10:00:00+00:00\",\"sale_end_date\":\"2026-03-28T20:00:00+00:00\",\"sale_start_date\":\"2026-02-10T12:00:00+00:00\",\"event_start_date\":\"2026-03-28T20:00:00+00:00\",\"event_end_date\":\"2026-03-29T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Grow Live\",\"seating\":null,\"announcement_date_unix\":1770631200,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T20:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:6\",\"date_unix\":1774728000,\"price\":{\"currency\":\"GBP\",\"amount\":612,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Jfc904591043?dice_id=Jfc904591043\",\"post_competition_referral\":\"https://link.dice.fm/s3f7e1c27f91?dice_id=s3f7e1c27f91\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C4509534cfc4?dice_id=C4509534cfc4\",\"post_purchase_referral\":\"https://link.dice.fm/Nc2273f2b391?dice_id=Nc2273f2b391\",\"post_reminder_referral\":\"https://link.dice.fm/saa7e34ba021?dice_id=saa7e34ba021\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z2d7c47077d3?dice_id=Z2d7c47077d3\"},\"perm_name\":\"oev3e5-arfoud-brothers-sisters-28th-mar-grow-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/cc1f0ff6-a4ae-4ed7-943d-c39b7cf252d0.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/cc1f0ff6-a4ae-4ed7-943d-c39b7cf252d0.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/cc1f0ff6-a4ae-4ed7-943d-c39b7cf252d0.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Grow Live presents a night exploring Moroccan and Saharan musical traditions through contemporary live performance and DJ culture.\\n\\nArfoud Brothers and Sisters deliver a rich, rhythm-driven sound rooted in Moroccan and Saharan music, often described as desert jazz for the dancefloor. Their live sets are built on insistent percussion, cyclical grooves and slowly unfolding melodies, creating a hypnotic and immersive atmosphere.\\n\\nLed by Abdelillah Ouahbi on guembri, guitar and vocals, the project draws directly from the Gnawa tradition, a North African musical form centred on repetition, trance and communal movement. Deep bass lines, call and response vocals and layered percussion ground the music in something physical, collective and deeply connected to dance.\\n\\nNamed after Arfoud, a Saharan city in south eastern Morocco with strong Amazigh heritage, the band blends Arabic and Amazigh roots with Afrobeat, West African rhythms and Brazilian influences. Psychedelic guitar textures and blues-leaning melodies sit alongside earthy grooves, resulting in a sound that feels expansive, borderless and alive.\\n\\nThe night opens with Beatkoznia, whose DJ set draws on Moroccan and North African traditions while weaving in electronic music, Afro-centric rhythms and Middle Eastern motifs. Based between Marrakech and London, Beatkoznia guide the room from live performance into a deeper late-night club space, returning to the decks after the band to carry the energy forward.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698b1d8d19924a0001bad01c\",\"name\":\"Arfoud Brothers & Sisters\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Arfoud Brothers - Al'barad\",\"redirect_url\":\"https://open.spotify.com/track/4qqrhMPTvyQOoFW6sZbGj4\",\"artist\":\"Arfoud Brothers\",\"preview_url\":\"https://p.scdn.co/mp3-preview/19d76dbfc910a743fc068c191c8fe612ec244d03?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Al'barad\"},{\"type\":\"apple_music\",\"title\":\"Arfoud Brothers - Al'barad\",\"redirect_url\":\"https://music.apple.com/us/album/albarad/1488047305?i=1488047312&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Arfoud Brothers\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/e4/f2/7b/e4f27b89-4cef-52c8-5fa7-a9aed01b090f/mzaf_12265581951036222491.plus.aac.p.m4a\",\"track_name\":\"Al'barad\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-18T13:00:00+00:00\",\"sale_end_date\":\"2026-03-29T02:00:00+01:00\",\"sale_start_date\":\"2025-12-18T13:00:00+00:00\",\"event_start_date\":\"2026-03-28T20:00:00+00:00\",\"event_end_date\":\"2026-03-29T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":681,\"name\":\"Blues Kitchen Shoreditch\",\"privacy_policy_link\":\"https://theblueskitchen.com/shoreditch/privacy-policy/\",\"fb_pixel_id\":\"1391369104503145\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Blues Kitchen Shoreditch.\",\"seating\":null,\"announcement_date_unix\":1766062800,\"venues\":[{\"id\":\"1780\",\"name\":\"The Blues Kitchen Shoreditch\",\"address\":