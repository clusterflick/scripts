\",\"amount\":1487,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Gloin - Circus Flea\",\"redirect_url\":\"https://open.spotify.com/track/1PIioVOCMYQAtNWIDl4cyJ\",\"artist\":\"Gloin\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f1ab8864a36a8f592aa4fee72e433d0d8e267dc5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Circus Flea\"},{\"type\":\"apple_music\",\"title\":\"Gloin - Circus Flea\",\"redirect_url\":\"https://music.apple.com/us/album/circus-flea/1465771980?i=1465772073&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Gloin\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/30/8c/77/308c7743-3248-f7c6-ba39-5a4e51e583ab/mzaf_12090514506149347915.plus.aac.p.m4a\",\"track_name\":\"Circus Flea\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T10:00:00+00:00\",\"sale_end_date\":\"2026-05-21T19:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Columbo Music.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/nc048601adbb?dice_id=nc048601adbb\",\"post_competition_referral\":\"https://link.dice.fm/E166d3bf6b6e?dice_id=E166d3bf6b6e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a9b5c3403846?dice_id=a9b5c3403846\",\"post_purchase_referral\":\"https://link.dice.fm/M9c31f81b107?dice_id=M9c31f81b107\",\"post_reminder_referral\":\"https://link.dice.fm/u0945be3635a?dice_id=u0945be3635a\",\"post_waitinglist_referral\":\"https://link.dice.fm/faf94b382b5b?dice_id=faf94b382b5b\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Savara is a Grammy-certified Kenyan music producer and performer, widely recognised as a core member of the award-winning Afro-pop band Sauti Sol.\\n\\nHis artistic evolution has cemented him as one of Kenya’s most influential contemporary artists, blending Afro-fusion, RnB, and experimental sounds in his music.\\n\\nHe co-founded Sauti Sol alongside Bien, Chimano and Fancy Fingers, who redefined African pop music and attracted global recognition. Collaborations with Burna Boy, India Arie, Tiwa Savage, Patoranking and Mi Casa further solidified their international presence.\\n\\nSavara launched his solo career and introduced his signature sound, which he termed as Afro-Confusion—a fusion of diverse African and global influences.\\n\\nHe now continues to shape the future of African music and culture with a very special live performance at The Lower Third.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2089,\"name\":\" The Columbo Group\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"556297964005636\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_pu