n-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772998200,\"has_multiple_ticket_types\":true,\"impression_id\":\"49dcf1c1636e57c2:0\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1200},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/2d23ebe2-aa98-4c4a-995a-76f37d9f38df.jpg?rect=295%2C0%2C1228%2C1228\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/2d23ebe2-aa98-4c4a-995a-76f37d9f38df.jpg?rect=0%2C69%2C1818%2C1091\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/2d23ebe2-aa98-4c4a-995a-76f37d9f38df.jpg?rect=572%2C0%2C675%2C1228\"},\"id\":\"697745866c89120001a4bbb1\",\"name\":\"Joshua Idehen: Q&A/Live + Signing\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Rough Trade is very excited to present an outstore talk and short performance from Joshua Idehen at The Lower Third. Joshua Idehen will be in conversation with Yomi Sode. This unique event celebrates the release of their new album 'I Know You’re Hurting, Everyone is Hurting, Everyone is Trying, You Have Got to Try', released via Heavenly Recordings.\\n\\n18+. Photo ID required.\\n\\nGeneral Admission tickets do NOT come with an album.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/joshua-idehen/i-know-you-re-hurting-everyone-is-hurting-everyone-is-trying-you-have-got-to-try\\n\\n**About Yomi Ṣode**\\n\\nYomi Ṣode is an award-winning Nigerian-British writer. His debut collection Manorism, was shortlisted for the Rathbones Folio Prize 2023 and the T S Eliot Prize 2022. He founded BoxedIn, First Five, The Daddy Diaries, and mentorship programme, 12 in 12.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+. Photo ID required.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T10:00:00+00:00\",\"sale_end_date\":\"2026-03-08T21:00:00+00:00\",\"sale_start_date\":\"2026-01-29T10:00:00+00:00\",\"event_start_date\":\"2026-03-08T19:30:00+00:00\",\"event_end_date\":\"2026-03-08T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Peter Capaldi\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-26/ff65b845-1e98-48f6-9423-68a2392cc0da.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"130737\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by 100 Club.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-08T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"7103\",\"name\":\"100 Club\",\"image\":{\"url\":null},\"perm_name\":\"100-club-lnlp\",\"profile_active\":true},\"announcement_date_unix\":1764244800,\"social_links\":{\"event_share\":\"https://link.dice.fm/l496fdb6a47b?dice_id=l496fdb6a47b\",\"post_competition_referral\":\"https://link.dice.fm/f8cbaec5a44a?dice_id=f8cbaec5a44a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t0673d919a7b?dice_id=t0673d919a7b\",\"post_purchase_referral\":\"https://link.dice.fm/T2e361b8aa81?dice_id=T2e361b8aa81\",\"post_reminder_referral\":\"https://link.dice.fm/c8bea182b359?dice_id=c8bea182b359\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ued3c23bc6de?dice_id=Ued3c23bc6de\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"3ond9p-peter-capaldi-8th-mar-the-100-club-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772998200,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:1\",\"price\":{\"currency\":\"GBP\",\"amount\":3575,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/90c5070b-657e-482e-8850-58e38f9ba6ce.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/90c5070b-657e-482e-8850-58e38f9ba6ce.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/90c5070b-657e-482e-8850-58e38f9ba6ce.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6927214e6e3a5c000104d6f8\",\"name\":\"Peter Capaldi\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Kilimanjaro Live & Regular Music presents...\\n\\nPeter Capaldi Announces First Ever Headline Music Tour – Spring 2026\\n\\nHot-footing the successful release of his second album and live appearance at Belladrum Festival earlier this year, the 12th Dr Who announces his first ever music tour….almost 50 years after setting up his first band.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T12:00:00+00:00\",\"sale_end_date\":\"2026-03-08T18:30:00+00:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-03-08T19:30:00+00:00\",\"event_end_date\":\"2026-03-08T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Paweł Stasiak\",\"image\":null,\"artist_id\":\"125217\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by MP Event.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":35734,\"title\":\"What to do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":0},{\"id\":35735,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":1},{\"id\":35736,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":35737,\"title\":\"A show is listed as sold out. How can I get tickets?\",\"body\":\"If a show is listed as sold out on this website then our venue is full to capacity. We recommend you download the DICE app and join the Waiting List for return tickets.\\n\\nYou are welcome to visit the box office when doors open for the event to see if there are any door tickets. We cannot guarantee door tickets will be available in advance. Sorry.\",\"order\":3},{\"id\":35738,\"title\":\"I have mobility issues. How can you help?\",\"body\":\"If you need a seat for medical reasons or need help moving around our venue, or if you’d like to bring a companion along to help you with mobility, you will need to arrange it with us in advance. We suggest you read our accessibility guide and then contact our box office.\",\"order\":4},{\"id\":35739,\"title\":\"Do I need ID? What type of ID is accepted?\",\"body\":\"Bring ID if you look 25 years of age or younger. We accept the following forms of photo ID.\\n\\n\\\\- Passport\\n\\n\\\\- Driving licence card\\n\\n\\\\- PASS card. You can apply for a PASS card at www.pass-scheme.org.uk\",\"order\":5},{\"id\":35740,\"title\":\"Can I bring food?\",\"body\":\"We do not allow you to bring food or drink into the venue. Chewing gum is also not permitted inside the venue.\",\"order\":6},{\"id\":35741,\"title\":\"Is there a cloakroom?\",\"body\":\"Yes, we have a cloakroom in the Foyer Bar space. As you walk up the entrance stairs and straight ahead towards the Foyer Bar the cloakroom is on the left. Each item is charged at £3.\",\"order\":7}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-08T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"announcement_date_unix\":1754056800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Jffef17424f0?dice_id=Jffef17424f0\",\"post_competition_referral\":\"https://link.dice.fm/Ie7bfa90121e?dice_id=Ie7bfa90121e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lbd3ee3404e5?dice_id=lbd3ee3404e5\",\"post_purchase_referral\":\"https://link.dice.fm/zc08dfb61a92?dice_id=zc08dfb61a92\",\"post_reminder_referral\":\"https://link.dice.fm/Ea50913722e4?dice_id=Ea50913722e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/z1c778780d96?dice_id=z1c778780d96\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"v3kr9g-topky-pawel-stasiak-papa-d-8th-mar-scala-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772998200,\"has_multiple_ticket_types\":true,\"impression_id\":\"49dcf1c1636e57c2:2\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1854},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/aaac34e9-c123-4581-b1f1-5523f7a7839f.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/aaac34e9-c123-4581-b1f1-5523f7a7839f.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/aaac34e9-c123-4581-b1f1-5523f7a7839f.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"688cbe8c897eea000110ec7c\",\"name\":\"TOPKY & PAWEL STASIAK PAPA D\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"MP Event ma zaszczyt zaprosić na wyjątkową trasę koncertową \\\"Ladies First – Trasa z Okazji Dnia Kobiet 2026\\\", która rozgrzeje parkiety w Liverpoolu, Coventry i Londynie! To niepowtarzalna okazja, by celebrować Dzień Kobiet w rytmach największych polskich hitów i wspierać szczytne cele.\\n\\nPrzygotujcie się na trzy niezapomniane wieczory pełne muzycznych emocji. Na jednej scenie wystąpią:\\n\\n• TOPKY- najgorętszy kobiecy duet na polskiej scenie muzyki tanecznej!\\n\\nEnergiczne, charyzatyczne i pełne pasji wokalistki podbijają serca fanów nie tylko urodą, ale przede wszysytkim wokalami nie do zastąpienia i przebojowym repertuarem.\\n\\n• Paweł Stasiak w repertuarze PAPA DANCE – charyzmatyczny wokalista, którego przeboje na zawsze wpisały się w historię polskiej muzyki rozrywkowej.\\n\\n• Sound Bass – gwarancja potężnego brzmienia i dynamicznej atmosfery, która rozgrzeje każdą salę.Twórca remiksów, między innymi utworu Janusza Laskowskiego „Śnił mi się rodzinny dom”, który osiągnął już pięć milionów wyświetleń. Współpraca Janusza Laskowskiego i Sound Bass, przebiega obficie. Może będzie nowy remiks na naszej imprezie z repertuaru Janusza Laskowskiego ?\\n\\n• DJ Szycha – mistrz konsolety, który zadba o to, by parkiet był pełny, a energia sięgała zenitu aż do wczesnych godzin porannych!\\n\\nKoncertowe Emocje i Gorące After Party w Cenie Biletu!\\n\\nPo każdym koncercie emocje nie opadną! Przygotujcie się na gorące after party, które potrwa aż do godziny 1 w nocy!Tak, dobrze czytacie – najlepsza zabawa po koncercie jest już wliczona w cenę biletu!\\n\\n• 7 marca 2026: HMV Empire, Coventry\\n\\n• 22 Hertford Street, Coventry, CV1 1LF\\n\\nBaw Się i Pomagaj – Cel Charytatywny Wydarzenia!\\n\\nUczestnicząc w \\\"Ladies First – Trasie z Okazji Dnia Kobiet 2026\\\", nie tylko zapewniasz sobie fantastyczną rozrywkę, ale także wspierasz szczytny cel. Część dochodu ze sprzedaży biletów zostanie przekazana na pomoc Monice Halickiej i Magdzie Syperek, dając im realne wsparcie w trudnej sytuacji.\\n\\nBilety:\\n\\n• I pula od £15\\n\\n• II pula od £ 20\\n\\n• Normalny od £30\\n\\n• Grupowy od £30 -20%= £24\\n\\nNie przegap tej wyjątkowej okazji! Liczba miejsc jest ograniczona.\\n\\nDo zobaczenia na parkiecie! Szykujcie się na niezapomniane wrażenia!\\n\\nMP Event is honored to invite you to the exceptional concert tour \\\"Ladies First – Women's Day Tour 2026\\\", which will heat up the dancefloors in Liverpool, Coventry, and London! This is a unique opportunity to celebrate Women's Dayto the rhythm of the biggest Polish hits and support noble causes.\\n\\nPrepare for three unforgettable evenings full of musical emotions. Performing on one stage will be:\\n\\nTOPKY – the hottest female duo on the Polish dance music scene! Energetic, charismatic, and full of passion, these vocalists are winning fans' hearts not only with their beauty but, above all, with irreplaceable vocals and hit repertoire.\\n\\nPaweł Stasiak performing PAPA DANCE repertoire – a charismatic vocalist whose hits are forever inscribed in the history of Polish popular music.\\n\\nSound Bass – a guarantee of a powerful sound and a dynamic atmosphere that will heat up every venue. The creator of remixes, including the track \\\"Śnił mi się rodzinny dom\\\" by Janusz Laskowski, which has already reached five million views. The collaboration between Janusz Laskowski and Sound Bass is fruitful. Maybe there will be a new remix of a Janusz Laskowski track at our event?\\n\\nDJ Szycha – a master of the decks who will ensure the dancefloor is full and the energy reaches its peak until the early morning hours!\\n\\nConcert Emotions and a Hot After Party Included in the Ticket Price! The excitement won't fade after each concert! Prepare for a hot after party that will last until 1 AM! Yes, you read that right – the best post-concert fun is already included in the ticket price!\\n\\nMarch 7, 2026: HMV Empire, Coventry 22 Hertford Street, Coventry, CV1 1LF\\n\\nHave Fun and Help – The Event's Charitable Cause! By participating in the \\\"Ladies First – Women's Day Tour 2026\\\", you not only ensure fantastic entertainment but also support a noble cause. Part of the proceeds from ticket sales will be donated to help Monika Halicka and Magda Syperek, giving them real support in a difficult situation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-01T15:00:00+01:00\",\"sale_end_date\":\"2026-03-08T06:30:00+00:00\",\"sale_start_date\":\"2025-08-01T15:00:00+01:00\",\"event_start_date\":\"2026-03-08T19:30:00+00:00\",\"event_end_date\":\"2026-03-08T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Metalworks\",\"image\":null,\"artist_id\":\"30503\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Underworld.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":19233,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":19234,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":19235,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-08T20:00:00+00:00\",\"doors_close_date\":\"2026-03-09T23:00:00+00:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1721732400,\"social_links\":{\"event_share\":\"https://link.dice.fm/T725a101d0ba?dice_id=T725a101d0ba\",\"post_competition_referral\":\"https://link.dice.fm/t58f696752a7?dice_id=t58f696752a7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t41b69bb9f34?dice_id=t41b69bb9f34\",\"post_purchase_referral\":\"https://link.dice.fm/a0c42d689a6e?dice_id=a0c42d689a6e\",\"post_reminder_referral\":\"https://link.dice.fm/P592a5e3bcca?dice_id=P592a5e3bcca\",\"post_waitinglist_referral\":\"https://link.dice.fm/b3e7ffe6c37d?dice_id=b3e7ffe6c37d\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ry9mer-metalworks-8th-mar-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773000000,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:3\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/654e73bb-6eb1-434d-8823-a38a51d27b89.jpg?rect=0%2C0%2C2200%2C2200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/654e73bb-6eb1-434d-8823-a38a51d27b89.jpg?rect=0%2C440%2C2200%2C1320\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/654e73bb-6eb1-434d-8823-a38a51d27b89.jpg?rect=495%2C0%2C1210%2C2200\"},\"id\":\"698586d023d3890001c60de4\",\"name\":\"METALWORKS\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"METALWORKS - Is a free entry, legendary rock/metal covers band that have been playing in Camden for over 20 yrs. Featuring world class band members & special guests.\\n\\n\\\\-\\n\\nMetalworks are stoked to be welcoming 'The Cartoon Cartel' to The Underworld stage on Sunday 8th March.\\n\\nThe Cartoon Cartel is a power trio brought to you by Dan Edwards of Pig Iron/Blind River, Mark Sharpless of Blind River and Tommy Smith of Leogun.\\n\\nThe three have been friends for decades and played many shows together, up to the point when Leogun got signed to Elton John’s management company and Yamaha Music, relocated to America and went on tour with the likes of Lynyrd Skynyrd, KISS, Thin Lizzy and Queens of the Stone Age.\\n\\nTommy, now back on British soil, led to the friends reuniting, meeting in a jam room and creating \\\"The Cartoon Cartel.\\\"\\n\\nThey played their first show in February last year; their second saw them as main support to Black Spiders in Wales.\\n\\nSince then they’ve played several London shows, Leeds and headlined 2 shows at the legendary Leo’s Red Lion.\\n\\nMore shows and festivals are booked for later in the year, but you can see them deliver their energetic, hard rock performance of original music at 8.30pm, opening for Metalworks - FOR FREE.\\n\\nDoors 8pm. Get the beers in and get down the front.\\n\\nOnce these boys have warmed you up, stick around for the main set when Steff & his crew will continue the night with a set of classic rock & heavy metal covers including music by AC/DC, Megadeth, Metallica, Ozzy Osbourne, Judas Priest, & more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+, 14 and 15 year old's must be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-07-23T12:00:00+01:00\",\"sale_end_date\":\"2026-03-08T22:30:00+00:00\",\"sale_start_date\":\"2025-04-23T12:00:00+01:00\",\"event_start_date\":\"2026-03-08T20:00:00+00:00\",\"event_end_date\":\"2026-03-09T00:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sun 08 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":62190,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-09T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1764806400,\"social_links\":{\"event_share\":\"https://link.dice.fm/k870bc73d3ea?dice_id=k870bc73d3ea\",\"post_competition_referral\":\"https://link.dice.fm/E46b4259b11f?dice_id=E46b4259b11f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z5206f5e7b9e?dice_id=Z5206f5e7b9e\",\"post_purchase_referral\":\"https://link.dice.fm/n6602db22704?dice_id=n6602db22704\",\"post_reminder_referral\":\"https://link.dice.fm/E5765e90f03f?dice_id=E5765e90f03f\",\"post_waitinglist_referral\":\"https://link.dice.fm/r77390e8276f?dice_id=r77390e8276f\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ryaao5-anime-film-scores-live-av-9th-mar-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773082800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:4\",\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/a20e68b7-9c7e-439b-b810-a8cc3ffc8e45.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/a20e68b7-9c7e-439b-b810-a8cc3ffc8e45.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/a20e68b7-9c7e-439b-b810-a8cc3ffc8e45.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6936c03fd68c0d00013e1c97\",\"name\":\"Anime Film Scores (Live A/V)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**An intimate, immersive live experience where a piano and string ensemble lovingly recreate the timeless compositions from Studio Ghibli — arguably the greatest collection of animated films of all time.**\\n\\nLush, romantic, packed with visual energy and excitement, you’ll hear the unique and compelling scores from **Grave of the Fireflies, Princess Mononoke, Spirited Away** and more, performed live alongside a bespoke audio-visual display that’ll take you through the magical world of the Japanese animation giants.\\n\\n*This event is not in association with Studio Ghibli.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T00:00:00+00:00\",\"sale_end_date\":\"2026-03-09T19:00:00+00:00\",\"sale_start_date\":\"2025-12-04T00:00:00+00:00\",\"event_start_date\":\"2026-03-09T19:00:00+00:00\",\"event_end_date\":\"2026-03-09T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Luca Firth\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba89a3c3f9f51d77daa480755\"},\"artist_id\":\"70829\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Metropolis\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1252\",\"name\":\"The George Tavern\",\"address\":\"373 Commercial Rd, London E1 0LA, UK\",\"location\":{\"lat\":51.51433609999999,\"lng\":-0.05291299999998955},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\