n_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:75\",\"about\":{\"description\":\"This April, The Jazz Cafe hosts House Gospel Choir for a four-week residency that lifts house music to new heights with soaring vocals and gospel energy.\\n\\nFrom their origins in London to stages at festivals and clubs worldwide, HGC fuse house, garage and gospel into live performances that fill rooms with heat and heart.\\n\\nA true roof-blowing celebration of voice-driven house anthems and spine-tingling singing to kick off the spring with a rush of sensations hot enough to burn themselves into memory.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1766397600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"House Gospel Choir\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb874a53ad0ff68bb5a6655796\"},\"artist_id\":\"5521\",\"about\":{\"description\":\"Inspired by the south London Pentecostal churches she sang in and the underground raves she danced in, Natalie Maddix formed the now 150-strong ensemble House Gospel Choir in 2014. They’ve since reimagined dancefloor classics on RE//CHOIRED (2020), collaborated with Oliver Heldens and Rudimental, and performed at KOKO and on Glastonbury’s Acoustic Stage.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/cff7a75d-e8ef-4d8a-954e-c7b5644b0159.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/cff7a75d-e8ef-4d8a-954e-c7b5644b0159.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dic