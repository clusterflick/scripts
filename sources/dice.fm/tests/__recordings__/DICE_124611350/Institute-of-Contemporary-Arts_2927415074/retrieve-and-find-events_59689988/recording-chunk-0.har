C594%2C1080\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/A39fa345305e?dice_id=A39fa345305e\",\"post_competition_referral\":\"https://link.dice.fm/ubb69d84643c?dice_id=ubb69d84643c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/U7484540f5d9?dice_id=U7484540f5d9\",\"post_purchase_referral\":\"https://link.dice.fm/y0c143bd3999?dice_id=y0c143bd3999\",\"post_waitinglist_referral\":\"https://link.dice.fm/ndf8aa505243?dice_id=ndf8aa505243\",\"post_reminder_referral\":\"https://link.dice.fm/V9d41d760441?dice_id=V9d41d760441\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"6109\",\"name\":\"Hootananny Brixton\",\"address\":\"95 Effra Rd, London SW2 1DF, UK\",\"location\":{\"lat\":51.4553934,\"lng\":-0.1132058},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-01-25/a335e145-034f-424c-811e-d996395babfa.jpg?rect=912%2C0%2C3648%2C3648\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hootananny-brixton-parp\",\"accessibility\":{\"url\":\"https://hootanannybrixton.co.uk/info/#:~:text=Venue%20Access%20Policy,Phone%20number%20020%2077373%207273.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"SLADEK is a soul band consisting of singer and guitarist David Sladek, bassist Alvis Reid, and drummer Raphael Vorraber. With their 2024 EP Loveless, the group redefined their musical vision, drawing inspiration from the soul music of the late 1960s.\\n\\nThe Austria-based trio, in collaboration with producer Mathias Garmusch, now boasts a sound that is honest, personal, and timeless. This partnership introduced a unified new production approach and marked a segue into analogue recording— culminating in their 2025 album Things Gotta Change, featuring songs like Stranger and Here to Stay.\\n\\nThe band has proven to be a captivating live act, transporting the deep emotions of soul music and strong rhythms—engaging listeners to sing along and take a step or two. On stage, the trio is joined by Taineh on keyboards and backing vocals, and Mathias Garmusch on percussion.\\n\\nSupport - TBA\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:88\",\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false},\"presented_by\":\"Presented by Hootananny Brixton.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sladek\",\"image\":null,\"artist_id\":\"130006\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1763031600,\"dates\":{\"timezone\":\"Europe/London\",\"ann