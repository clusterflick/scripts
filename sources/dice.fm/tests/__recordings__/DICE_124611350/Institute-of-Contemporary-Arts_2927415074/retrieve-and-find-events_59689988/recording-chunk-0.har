ighlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-31T14:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":\"0a58574c-d7ab-4480-ae88-00907ab15834\",\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"announcement_date_unix\":1750850100,\"social_links\":{\"event_share\":\"https://link.dice.fm/Vc50510f5657?dice_id=Vc50510f5657\",\"post_competition_referral\":\"https://link.dice.fm/s79aca6a5260?dice_id=s79aca6a5260\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/sc316e8ede1f?dice_id=sc316e8ede1f\",\"post_purchase_referral\":\"https://link.dice.fm/y7d38c246440?dice_id=y7d38c246440\",\"post_reminder_referral\":\"https://link.dice.fm/p9bdafca2373?dice_id=p9bdafca2373\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q71fddf1996a?dice_id=Q71fddf1996a\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"oe6y6r-purcell-dido-aeneas-with-i-fagiolini-31st-may-kings-place-hall-one-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780234200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:51\",\"price\":{\"currency\":\"GBP\",\"amount\":5130,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-18/32b45720-015c-4851-b9b0-d7e2e9cc96f9.jpg?rect=0%2C0%2C875%2C875\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-18/32b45720-015c-4851-b9b0-d7e2e9cc96f9.jpg?rect=0%2C175%2C875%2C525\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-18/32b45720-015c-4851-b9b0-d7e2e9cc96f9.jpg?rect=197%2C0%2C481%2C875\"},\"id\":\"685bd7ab6715a50001fbc801\",\"name\":\"Purcell, Dido & Aeneas with I Fagiolini\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"0a58574c-d7ab-4480-ae88-00907ab15834\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"***I Fagiolini at Kings Place***\\n\\n***Purcell***\\n\\nDido and Aeneas\\n\\nThe sparrow and the gentle dove (From hardy climes)\\n\\nMark how readily (Raise, raise the voice)\\n\\nPavan in 4 parts / Hornpipe (King Arthur)\\n\\nRobert Hollingworth | Director\\n\\nJulia Doyle | Dido\\n\\nFrederick Long | Aeneas\\n\\nRowan Pierce | Belinda\\n\\nMartha McLorinan | Sorceress\\n\\n***I Fagiolini’s semi-staged take on Purcell’s masterpiece – written when he was just 29. So much variety in a single hour: great tunes, sparkling instrumental interludes, hysterical witches, dance music and of course the great lament, ‘When I am laid in earth’. Purcell’s varied genius is also celebrated in I Fagiolini’s amuse-bouche, perfect miniatures from ‘Britain’s Orpheus’.***\\n\\n***This event will last approximately 75 minutes, with no interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-25T12:15:00+01:00\",\"sale_end_date\":\"2026-05-31T11:30:00+01:00\",\"sale_start_date\":\"2025-06-25T12:15:00+01:00\",\"event_start_date\":\"2026-05-31T14:30:00+01:00\",\"e