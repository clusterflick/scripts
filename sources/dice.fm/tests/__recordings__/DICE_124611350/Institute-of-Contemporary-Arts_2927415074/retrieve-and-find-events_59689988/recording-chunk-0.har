rworld.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:85\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-22T00:00:00+01:00\",\"sale_end_date\":\"2026-04-17T17:00:00+01:00\",\"sale_start_date\":\"2025-07-22T00:00:00+01:00\",\"event_start_date\":\"2026-04-17T18:00:00+01:00\",\"event_end_date\":\"2026-04-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1753138800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"id\":\"687f75f442f0fc0001179187\",\"name\":\"MR.PUNCH \",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mr.Punch\",\"image\":null,\"artist_id\":\"17270\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"bb5vbm-mrpunch-17th-apr-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-22/9c24cb46-e33a-4634-955f-06d7aee65ec8.jpg?rect=236%2C0%2C3037%2C3037\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-22/9c24cb46-e33a-4634-955f-06d7aee65ec8.jpg?rect=0%2C466%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-22/9c24cb46-e33a-4634-955f-06d7aee65ec8.jpg?rect=919%2C0%2C1670%2C3037\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Mr.Punch pay tribute to Fish Era of Marillion, complete with make up and theatrics in classic Fish style, genuine 80s rock. Active mainly in Europe and the UK since 2016, Mr.Punch pay homage to the rock/prog rock of the 80s. The show is an exciting journey back in time, to the Jester era, complete with makeup and theatricality in the classic Fish style.\\n\\nMoreover the collaboration with Mr.Punch and “The Company” (Fish official fanclub) and theWeb Italy, Germany, Portugal, Holland and France) let you relieve on the stage (over and under) the excitement of the concerts of one of the most interesting bands of prog rock music scene. Mr. Punch was born from a combination of musicians from different prog/rock/folk bands active in the Italian scene.\\n\\nMarco Vincini - vocals\\n\\nLicia Missori - keyboards/piano\\n\\nMarcella Arganese - guitar\\n\\nLuca Cristofaro - bass and backing vocals\\n\\nMarco Fabbri – drums\\n\\nAs part of 2 hours Fish Era set list, All the Best Freaks are Here, a broad selection of tracks from the first four Marillion albums, from the big hit singles such as Cinderella Search, Script for a Jester's Tear and b-sides...and who stalks the night! Mr.Punch honour a much-heralded era of music, which is still today so warmly welcomed by prog-rock fans young and old, and will take you on a journey, back to a time of the Jester.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Bronx\",\"redirect_url\":\"https://open.spotify.com/track/1ENGe5j5pdmz1YKiW6NhK9\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e6b0b00ae25143e539a3388c3fbe3753d927b92c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Bronx\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776445200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48a