about\":{\"description\":\"Since her start in ’90s Britpop band Kill Laura, Chesire-born singer and songwriter Jane Weaver has constantly reinvented her sound. From folktronica to psychedelia to “Day-Glo Pop”, her albums have featured collaborations with Susan Christie, P.J. Philipson and Emma Tricca. She started her record label, Bird Records, to promote female artists such as Cate Le Bon and Maxine Peake.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"xe7r3a-jane-weaver-13th-apr-moth-club-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-17/9240e1f7-5cf7-4278-9265-7a3c23c90cc7.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-17/9240e1f7-5cf7-4278-9265-7a3c23c90cc7.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-17/9240e1f7-5cf7-4278-9265-7a3c23c90cc7.jpg?rect=173%2C0%2C422%2C768\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Eat Your Own Ears presents\\n\\nJane Weaver\\n\\nThe evening will consist of two sets and an interval. Jane Weaver will be on stage at 8pm. There is no support. The venue will be mostly seated with some additional standing. Seats allocated on first come first served basis. Doors 7pm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"faqs\":[],\"marketeers\":[{\"id\":811,\"name\":\"Seoul Therapy Europe\",\"privacy_policy_link\":\"https://www.seoultherapy.co.uk/terms-conditions\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id