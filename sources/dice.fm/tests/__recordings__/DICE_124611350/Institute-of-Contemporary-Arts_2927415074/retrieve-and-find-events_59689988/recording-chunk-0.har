\":\"https://link.dice.fm/k97887cfab19?dice_id=k97887cfab19\",\"post_purchase_referral\":\"https://link.dice.fm/Rb56f1b1cff0?dice_id=Rb56f1b1cff0\",\"post_reminder_referral\":\"https://link.dice.fm/l9f099299d90?dice_id=l9f099299d90\",\"post_waitinglist_referral\":\"https://link.dice.fm/g3d6ec1ec466?dice_id=g3d6ec1ec466\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:77\",\"properties\":[],\"presented_by\":\"Presented by Success Express.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770336000,\"id\":\"6985ff197176a90001236309\",\"name\":\"Ronniee + Lightlines, Daisy Peacock \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"*Join us for a gorgeously intimate acoustic evening with **RONNIEE** plus special guests **LIGHTINES** (acoustic band set).*\\n\\n**RONNIEE** is an English artist crafting soulful cinematic pop with a fearless emotional core. Known for her honest lyricism, endearing presence, and powerhouse vocals, she brings a sense of fun, freedom, and raw connection. Ronniee has sharpened her craft gigging across the UK, with intimate live shows that feel both conversational and deeply human. Ronniee has appeared on Jimmy Kimmel (Los Angeles) and The Donna Drake Show (New York), as well as creative collaborations with Sony, BMG, Universal, and publishing under Downtown.\\n\\nWith over 1 million new streams, 70,000+ video views, syncs on ITV2’s Love Island. support from BBC Radio 1, BBC Radio 6 (‘One to Watch’), and BBC Introducing she has had an incredible year.\\n\\n**LIGHTLINES** are a UK alt-pop/rock trio: George Shelley (vocals), Alex Pothecary (guitar) and Will Jackson (drums). With loud guitars, driving drums, and honest lyrics, their music hits hard live. Since debut single Wasted, they’ve crafted catchy, punchy songs designed for stage energy, emotional impact, and unforgettable nights.\\n\\n**DAISY PEACOCK** is a rising indie pop artist bringing a fresh burst of fun, wit, and heartfelt honesty to the UK music scene. Her music blends catchy melodies with clever, emotionally charged lyrics, turning a generation’s frustrations into music you can’t help but dance- and laugh- along to.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"5755\",\"name\":\"Success Express\",\"image\":{\"url\":null},\"perm_name\":\"success-express-7a9b\",\"profile_active\":true},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T12:00:00+00:00\",\"sale_end_date\":\"2026-03-04T16:00:00+00:00\",\"sale_start_date\":\"2026-02-06T12:00:00+00:00\",\"event_start_date\":\"2026-03-04T19:00:00+00:00\",\"event_end_date\":\"2026-03-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"oevyog-a-new-music-showcase-4th-mar-the-lower-third-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Little Dog Star\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-13/286f96fa-b94b-4f2b-ae16-e241531d7479.jpg?rect=0%2C51%2C539%2C539\"},\"artist_id\":\"125744\",\"about\":null,\"is_headliner\":false},{\"name\":\"Reece Bibby \",\"image\":null,\"artist_id\":\"120977\",\"about\":null,\"is_headliner\":false},{\"name\":\"Biba\",\"image\":null,\"artist_id\":\"120308\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\"