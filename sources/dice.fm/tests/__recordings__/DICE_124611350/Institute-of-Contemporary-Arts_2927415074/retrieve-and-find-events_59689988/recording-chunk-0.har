rral\":\"https://link.dice.fm/e09697d202e3?dice_id=e09697d202e3\",\"post_purchase_referral\":\"https://link.dice.fm/ue26c238b9fa?dice_id=ue26c238b9fa\",\"post_waitinglist_referral\":\"https://link.dice.fm/Nf3872e8786e?dice_id=Nf3872e8786e\",\"post_reminder_referral\":\"https://link.dice.fm/g9fa81c7901e?dice_id=g9fa81c7901e\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"98\",\"name\":\"The Black Heart\",\"address\":\"2-3 Greenland Pl, London NW1 0AP\",\"location\":{\"lat\":51.5387812,\"lng\":-0.141761200000019},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-28/687dc696-b005-45e0-a194-c89d23ee7bed.jpg?rect=1%2C0%2C2716%2C2716\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-black-heart-4bev\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T15:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Beyond The Grave are proud to present the return of Londons sickest event Snuff Fest on Saturday 28th March 2026.\\n\\nWe have pulled together a veritable who’s who of the extreme metal scene to satisfy the most depraved of tastes, so without further ado please welcome the class of 2026!\\n\\nBrutal Sphincter - Poolitical Gore Grind from Belgium that really needs no introduction\\n\\nBasement Torture Killings - Its Snuff Fest so of course our curators are playing, be warned there will be deeds most foul\\n\\nAmputated - UK Slam legends once again descend on the Black Heart with a promise to slam pigs\\n\\nMystery Meat - Gore soaked grind from the USA\\n\\nFupa Goddess - Another edition from the USA bring their party grind to this years Sunff Fest\\n\\nDisgracing - Hailing from Slamchester Disgracing are a new and exciting brutal slam project you need to check out\\n\\nHacked Up - Duos never slammed so hard, pure brutal UK based slamming insanity\\n\\nThuq - New Kids on the Block that hopefully hang in tough, spawned from Deep Throat Trauma this is one debut you don’t want to miss\\n\\nNecrophilic Autopsy - Rounding off our line up we welcome the UKs premier one man gore grind act Necrophilic Autopsy\\n\\nSo there you have it, 9 killer bands soaked in gore for your listening pleasure, so grab your tickets and dancing shoes and lets party like Snuff Fest never went away.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:69\",\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"presented_by\":\"Presented by Beyond The Grave\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1763856000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-23T00:00:00+00:00\",\"sale_end_date\":\"2026-03-28T12:00:00+00:00\",\"sale_start_date\":\"2025-11-23T15:00:00+00:00\",\"event_start_date\":\"2026-03-28T15:00:00+00:00\",\"event_end_date\":\"2026-03-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6923826f0ba792000152e1b8\",\"name\":\"Snuff Fest 2026\",\"price\":{\"currency\":\"GBP\",\"amount\":2500,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\