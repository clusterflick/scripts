g along the way.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765983600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hyphen\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd571158587404e09bd281aa7\"},\"artist_id\":\"94477\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/3c1626c0-f3c3-4def-8614-c1d148c65209.jpg?rect=214%2C0%2C853%2C853\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/3c1626c0-f3c3-4def-8614-c1d148c65209.jpg?rect=0%2C43%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/3c1626c0-f3c3-4def-8614-c1d148c65209.jpg?rect=406%2C0%2C469%2C853\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6942b789bf88ce00017d75cb\",\"name\":\"Hyphen\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T15:00:00+00:00\",\"sale_end_date\":\"2026-05-07T18:30:00+01:00\",\"sale_start_date\":\"2025-12-18T10:00:00+00:00\",\"event_start_date\":\"2026-05-07T19:30:00+01:00\",\"event_end_date\":\"2026-05-07T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"dkadxo-hyphen-7th-may-scala-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2380,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Yfde13429b0e?dice_id=Yfde13429b0e\",\"post_competition_referral\":\"https://link.dice.fm/N9ea7c6fb86e?dice_id=N9ea7c6fb86e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w59be94