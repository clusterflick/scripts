opia - Intentions\",\"redirect_url\":\"https://music.apple.com/us/album/intentions/1713832742?i=1713832749&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Acopia\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/50/82/85/50828588-8b0e-216c-a472-42cd46bd4a62/mzaf_7796304850420147656.plus.aac.p.m4a\",\"track_name\":\"Intentions\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776364200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/x3a9b5bdf07d?dice_id=x3a9b5bdf07d\",\"post_competition_referral\":\"https://link.dice.fm/g03a3a57063e?dice_id=g03a3a57063e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ree89e5fb82d?dice_id=Ree89e5fb82d\",\"post_purchase_referral\":\"https://link.dice.fm/i7f2242f4839?dice_id=