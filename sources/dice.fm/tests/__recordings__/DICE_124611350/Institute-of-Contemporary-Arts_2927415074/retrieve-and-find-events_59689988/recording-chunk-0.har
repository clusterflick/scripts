ect=0%2C4%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/b34a3573-f03c-40f2-a485-88306d85247d.jpg?rect=427%2C0%2C427%2C776\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Rfc3ba11da52?dice_id=Rfc3ba11da52\",\"post_competition_referral\":\"https://link.dice.fm/Sc74b9c5ad6b?dice_id=Sc74b9c5ad6b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X30eabc1f2c2?dice_id=X30eabc1f2c2\",\"post_purchase_referral\":\"https://link.dice.fm/Ie76410d5b25?dice_id=Ie76410d5b25\",\"post_reminder_referral\":\"https://link.dice.fm/d28e003aaf2c?dice_id=d28e003aaf2c\",\"post_waitinglist_referral\":\"https://link.dice.fm/la694d60ad75?dice_id=la694d60ad75\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:62\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1761237900,\"id\":\"68fa5f4457cfb700011d04ac\",\"name\":\"History of Hip-Hop: Remembering Artifacts\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"***“Criminally underappreciated”***\\n\\n**El Da Sensei, original member and keeper of the Artifacts legacy, takes to the stage honouring one of hip-hop’s most influential groups.**\\n\\nPioneers of East Coast rap in the 90s, Artifacts are celebrated for their crunching beats, iconic horn loops, and tracks like **‘Wrong Side of Da Tracks’** and **‘C’mon Wit Da Git Down’** — songs that continue to resonate across generations.\\n\\nFrom the streets of New Jersey to collaborations with legends such as **Mos Def** and **KRS-One**, this night traces the sound, culture, and stories that helped define hip-hop’s golden era.\\n\\n**Come down to relive the era, honour the legacy, and witness hip-hop’s past and present collide in one unforgettable night.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1772564400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1600,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-31T00:00:00+00:00\",\"sale_end_date\":\"2026-03-03T22:30:00+00:00\",\"sale_start_date\":\"2025-10-31T00:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:00:00+00:00\",\"event_end_date\":\"2026-03-03T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"53xvyl-damien-mcfly-3rd-mar-hootananny-brixton-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Lovers On the Sun\",\"redirect_url\":\"https://open.spotify.com/track/4HKmkvJEWsxhge8rwswNG7\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/105493bf07687d1a5678e3f4a5a7423faabcce8e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Lovers On the Sun\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"