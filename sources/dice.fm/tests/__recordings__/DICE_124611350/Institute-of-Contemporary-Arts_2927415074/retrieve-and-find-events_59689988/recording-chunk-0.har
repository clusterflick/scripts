etition_referral\":\"https://link.dice.fm/bc94b9b82c68?dice_id=bc94b9b82c68\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j7635055a58c?dice_id=j7635055a58c\",\"post_purchase_referral\":\"https://link.dice.fm/I16b0e06d7e4?dice_id=I16b0e06d7e4\",\"post_reminder_referral\":\"https://link.dice.fm/R404b81fe9bc?dice_id=R404b81fe9bc\",\"post_waitinglist_referral\":\"https://link.dice.fm/sf6deb317057?dice_id=sf6deb317057\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"v3bwe6-folk-bitch-trio-11th-mar-scala-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773255600,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:35\",\"price\":{\"currency\":\"GBP\",\"amount\":2194,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-13/6f43b76c-c55a-4c8b-b665-cd4cf23f3c45.jpg?rect=0%2C0%2C2350%2C2350\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-13/6f43b76c-c55a-4c8b-b665-cd4cf23f3c45.jpg?rect=0%2C470%2C2350%2C1410\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-13/6f43b76c-c55a-4c8b-b665-cd4cf23f3c45.jpg?rect=529%2C0%2C1293%2C2350\"},\"id\":\"68ed2b9489f7970001ac6b6f\",\"name\":\"Folk Bitch Trio \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Folk Bitch Trio—the Australian band of Gracie Sinclair (she/her), Jeanie Pilkington (she/her) and Heide Peverelle (they/them)— have just released their debut album, Now Would Be A Good Time, in which they “effortlessly meld their individual perspectives into a stunningly cohesive style” (FLOOD). The album has rapidly garnered glowing praise from the likes of the MOJO, Paste, Uncut, and Dork, and featured on the cover of NME with a 5-star review that hailed the album as “a masterful debut that lingers long after the final notes ring out.”\\n\\nAfter selling out headline shows and wowing audiences at Green Man and All Points East on their August tour, Folk Bitch Trio have announced a return in March 2026, bringing their \\\"otherworldly\\\" (Line of Best Fit) live show to 11 cities across UK/Europe.\\n\\nNow Would Be A Good Time tells vivid, visceral stories. Folk Bitch Trio’s music sounds familiar, built on a foundation of the music they’ve loved throughout their lives–gnarled Americana, classic rock, piquant, and clear-eyed balladry. Yet the songs are modern and youthful, with the trio singing acutely through dissociative daydreams, galling breakups, sexual fantasies and media overload— all the petty resentments and minor humiliations of being in your early twenties in the 2020s.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-14T10:00:00+01:00\",\"sale_end_date\":\"2026-03-11T18:00:00+00:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-03-11T19:00:00+00:00\",\"event_end_date\":\"2026-03-11T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Shivers\",\"redirect_url\":\"https://open.spotify.com/track/5fpUXYQutrpetRePIXmHU4\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dbc7042457fef596bdbac426010bf258b4bbfa95?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Shivers\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Maro\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-08/fba5529b-6793-47f4-8466-4ef46502d16b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"48662\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Communion ONE.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":50387,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":50388,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":50389,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":50390,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\