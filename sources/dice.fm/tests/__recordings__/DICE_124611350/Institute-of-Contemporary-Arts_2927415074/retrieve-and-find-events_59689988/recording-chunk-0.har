on\":{\"lat\":51.53636,\"lng\":-0.12205},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-star-of-kings-8dy5\",\"accessibility\":{\"url\":\"https://starofkings.co.uk/wp-content/uploads/2024/09/SOK-Venue-Brochure-2024-compressed.pdf\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T18:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Concierge\",\"image\":null,\"artist_id\":\"133766\",\"about\":null,\"is_headliner\":false},{\"name\":\"Stickler\",\"image\":null,\"artist_id\":\"133774\",\"about\":null,\"is_headliner\":false},{\"name\":\"Initial Destruction\",\"image\":null,\"artist_id\":\"133775\",\"about\":null,\"is_headliner\":false},{\"name\":\"Fletcher Dunn\",\"image\":null,\"artist_id\":\"133776\",\"about\":null,\"is_headliner\":false}],\"total_artists\":4,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/f48082f7-f9e3-42a6-b960-c1fc8a17890a.jpg?rect=0%2C420%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/f48082f7-f9e3-42a6-b960-c1fc8a17890a.jpg?rect=0%2C636%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/f48082f7-f9e3-42a6-b960-c1fc8a17890a.jpg?rect=12%2C0%2C1056%2C1920\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"The Concierge - Movie\",\"redirect_url\":\"https://open.spotify.com/track/0awi5fkajQazuLcLDnjzJ0\",\"artist\":\"The Concierge\",\"preview_url\":\"https://p.scdn.co/mp3-preview/185cc68fe0b26089232874097dc7a7a3e654355a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Movie\"},{\"type\":\"apple_music\",\"title\":\"The Concierge - Movie\",\"redirect_url\":\"https://music.apple.com/us/album/movie/1800440186?i=1800440187&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Concierge\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/c0/f1/52/c0f152c1-3656-963a-61a0-fafa5d49f70f/mzaf_15791776590904451644.plus.aac.p.m4a\",\"track_name\":\"Movie\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770575400,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"🔥 **SO LIVE SESSIONS PROUDLY PRESENTS** 🔥\\n\\n**OUR FIRST SHOW OF 2026 — AND WE’RE BACK WITH A BANG**\\n\\nThursday 19th February we return to The Star of Kings with a stacked lineup spanning alternative, indie, grunge and heavy — five powerful acts, one room, and an uncompromising night of live music.\\n\\n📍 The Star of Kings, London\\n\\n🎤 HEADLINER\\n\\n**The Concierge**\\n\\nLondon three-piece blending synth-pop, alt-rock and indie, drawing influence from Tears for Fears, Radiohead, Garbage, Djo and Parcels. Fresh from their 2025 EP “Check In” and currently working on new material.\\n\\n👉 @theconciergemusic\\n\\n⚡ MAIN SUPPORT\\n\\n**Stickler**\\n\\nForged in the Forest of Dean — a visceral mix of grunge and metal with an Eastern edge. Raw, heavy, and emotionally charged.\\n\\n👉 @sticklergrungeband\\n\\n🎸 SUPPORT\\n\\n**Fletcher Dunn**\\n\\nAustralian alt pop-rock artist now UK-based. Infectious hooks meet raw rock energy. Recently released self-produced LP “GYESU”.\\n\\n👉 @fletch\\\\_dog\\\\_\\n\\n🔊 SUPPORT\\n\\n**Initial Destruction**\\n\\nA new generation of heavy metal — crushing riffs, technical solos, melody and serious presence.\\n\\n👉 @initialdestruction\\n\\n🌙 OPENER\\n\\n**Bo Bardot**\\n\\nSetting the tone from the first note.\\n\\n👉 @bobardot\\n\\n🎟 Limited tickets available now via DICE\\n\\nMore on the door\\n\\n**£1 from every ticket goes towards Pro Arty Charity**\\n\\n#SoLiveSessions #BackWithABang #LiveMusicLondon #TheStarOfKings #AltRock #IndieLive #Grunge #HeavyMusic #SupportLiveMusic\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by So Live Sessions.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:71\",\"social_links\":{\"event_share\":\"https://link.dice.fm/x7bcb06bf7e5?dice_id=x7bcb06bf7e5\",\"post_competition_referral\":\"https://link.dice.fm/L73ec353cd5e?dice_id=L73ec353cd5e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j10adfa2d240?dice_id=j10adfa2d240\",\"post_purchase_referral\":\"https://link.dice.fm/Xe506c943863?dice_id=Xe506c943863\",\"post_reminder_referral\":\"https://link.dice.fm/s7287c6e77a3?dice_id=s7287c6e77a3\",\"post_waitinglist_referral\":\"https://link.dice.fm/W7075feb9aa8?dice_id=W7075feb9aa8\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-08T18:30:00+00:00\",\"sale_end_date\":\"2026-02-19T22:15:00+00:00\",\"sale_start_date\":\"2026-02-08T18:30:00+00:00\",\"event_start_date\":\"2026-02-19T18:15:00+00:00\",\"event_end_date\":\"2026-02-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"8379\",\"name\":\"So Live Sessions\",\"image\":{\"url\":null},\"perm_name\":\"so-live-sessions-7qe6\",\"profile_active\":false},\"id\":\"6989a0049599ae00016fd519\",\"seats_io_event_id\":null,\"name\":\"The Conceirge + The Stickler + Fletcher Dunn + Initial Destruction + Bo Bardot\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"6d2pdq-the-