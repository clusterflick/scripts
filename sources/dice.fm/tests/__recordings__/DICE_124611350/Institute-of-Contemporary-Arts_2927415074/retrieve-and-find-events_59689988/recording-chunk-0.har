[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"Join us for a special Lovers Rock Reggae showcase, inspired by the Kings and Queens of Lovers Rock such as Dennis Brown, Carrol Thompson and Janet Kay. Taking you back to the sounds of the 70s and 80s for a night of Romantic Reggae.\\n\\n💚Lineup TBC 💚\\n\\n8PM - 1AM\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-26T23:30:00+00:00\",\"sale_start_date\":\"2026-01-28T00:00:00+00:00\",\"event_start_date\":\"2026-02-26T20:00:00+00:00\",\"event_end_date\":\"2026-02-27T01:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6979d9433c5fef00019007a0\",\"name\":\"Lovers Rock Special\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-12/c416a758-cc84-46e4-a203-59e311e10868.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-12/c416a758-cc84-46e4-a203-59e311e10868.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-12/c416a758-cc84-46e4-a203-59e311e10868.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769558400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/t870ad07b7c0?dice_id=t870ad07b7c0\",\"post_competition_referral\":\"https://link.dice.fm/F43fe1ea9423?dice_id=F43fe1ea9423\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C98e951f1bd9?dice_id=C98e951f1bd9\",\"post_purchase_referral\":\"https://link.dice.fm/Ea1f8d91c62a?dice_id=Ea1f8d91c62a\",\"post_reminder_referral\":\"https://link.dice.fm/Ef90bb236d68?dice_id=Ef90bb236d68\",\"post_waitinglist_referral\":\"https://link.dice.fm/X515825abed4?dice_id=X515825abed4\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1300,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Resonance.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"122252\",\"name\":\"Resonance\",\"image\":{\"url\":null},\"perm_name\":\"resonance-kql3l\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k6na5l-synaptic-island-presents-bunny-hoova-uh-rubie-26th-feb-venue-mot-unit-18-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772136000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:15\",\"venues\":[{\"id\":\"2285\",\"name\":\"Venue MOT Unit 18\",\"address\":\"Venue MOT Unit 18, Orion Business Centre, Surrey Canal Rd, London SE14 5RT, UK\",\"location\":{\"lat\":51.4849853,\"lng\":-0.04840460000002622},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"venue-mot-unit-18-rmev\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T20:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"bunny hoova\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebb225c5f0b4ca972b5e47f4f4\"},\"artist_id\":\"14653\",\"about\":null,\"is_headliner\":false},{\"name\":\"uh \",\"image\":null,\"artist_id\":\"59522\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rubie\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-30/0481ec44-37e1-4305-a1cc-6d5c07a2ba5a.jpg?rect=0%2C0%2C480%2C480\"},\"artist_id\":\"18403\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":1},\"about\":{\"description\":\"Two weeks to help keep Resonance independent. Resonance is an ad-free, volunteer-driven radio station. It exists to make space for art, music, ideas and voices you don’t hear anywhere else.\\n\\nFrom 14–28 February, we’re asking listeners, broadcasters and friends of the station to help us raise £30,000 in new funding - money that keeps the station running day to day, year to year.\\n\\nThis is about stability, independence, and keeping the conditions in place for ad-free radio that takes risks. If you value radio that isn’t driven by playlists, algorithms or advertisers - this is the moment to support it.\\n\\nSYNAPTIC ISLAND presents...\\n\\nBUNNY HOOVA\\n\\nUH\\n\\nRUBIE\\n\\nlive at MOT — 26.02.26\\n\\nSynaptic Island curates a night of live music at MOT — raising funds for Resonance FM and helping to keep the station live and kicking into the foreseeable\\n\\nWe are so blessed to have BUNNY HOOVA joining us for a live set (bit of a dream come true!) alongside luminary RUBIE and the sibling duo UH presenting a whole different set up, a whole different sound\\n\\nDJs and special guests (TBA) will take over to close the night\\n\\nVenue MOT, Unit 18\\n\\nThursday 26.02\\n\\n8pm–1am\\n\\nPlease email synapticisland@gmail.com if funds are low, we can offer support.\\n\\nWheelchair Accessible\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-02T20:00:00+00:00\",\"sale_end_date\":\"2026-02-26T17:00:00+00:00\",\"sale_start_date\":\"2026-01-09T08:00:00+00:00\",\"event_start_date\":\"2026-02-26T20:00:00+00:00\",\"event_end_date\":\"2026-02-27T02:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696f643d6e546f0001722ab5\",\"name\":\"Synaptic Island Presents Bunny Hoova, UH, Rubie\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/92944b54-e3a4-4233-a893-8a93606c4795.jpg?rect=0%2C496%2C3969%2C3969\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/92944b54-e3a4-4233-a893-8a93606c4795.jpg?rect=0%2C1290%2C3969%2C2381\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/92944b54-e3a4-4233-a893-8a93606c4795.jpg?rect=620%2C0%2C2729%2C4961\"},\"marketeers\":[{\"id\":1776,\"name\":\"London Musicians' Collective Limited\",\"privacy_policy_link\":\"https://fundraiser.resonance.fm/resonance-privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1767384000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_link