nk.dice.fm/L2156af6f78c?dice_id=L2156af6f78c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p87fc31d2782?dice_id=p87fc31d2782\",\"post_purchase_referral\":\"https://link.dice.fm/g616f034bfb2?dice_id=g616f034bfb2\",\"post_reminder_referral\":\"https://link.dice.fm/acd0cee2a8a4?dice_id=acd0cee2a8a4\",\"post_waitinglist_referral\":\"https://link.dice.fm/K2b1b30a524c?dice_id=K2b1b30a524c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ry95av-midweek-mayhem-25th-feb-the-engine-rooms-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772046000,\"has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:18\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":700},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/451408e8-6c2a-445a-b6f3-7952fffdf8de.jpg?rect=6%2C0%2C1278%2C1278\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/451408e8-6c2a-445a-b6f3-7952fffdf8de.jpg?rect=0%2C252%2C1290%2C774\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/451408e8-6c2a-445a-b6f3-7952fffdf8de.jpg?rect=294%2C0%2C703%2C1278\"},\"id\":\"6990b6bd7b796100018f2df1\",\"name\":\"Midweek Mayhem\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"***Midweek Mayhem at Engine Rooms, Bow – Queer Rap & Indie Rock Night***\\n\\n**Midweek Mayhem** lands at *Engine Rooms* in Bow, bringing a high-energy night of queer rap, hyperpop and indie rock to East London. If your Wednesdays need volume, distortion and a bit of glittered rebellion, this is it.\\n\\nHeadlining is **HTML Jones**, the hyperpop MC from Tottenham building a cult following online. Co-signed by Tinashe, PinkPantheress, Kelela and Anthony Fantano, htmljones blends razor-sharp bars with glitchy production and chaotic club energy. Rapping in English, Tamil and Japanese, she represents the new wave of London alternative rap: internet-born, genre-fluid and unapologetically loud.\\n\\nSupport comes from **The Clavertons**, a newly formed pop rock band self-described as a “One Direction tribute band” with a wink. Expect high-energy performance, Britrock attitude, infectious hooks and a few nostalgic covers thrown in for good measure. It’s indie sleaze meets boyband delusion in the best possible way.\\n\\n**Midweek Mayhem** is a space for queer expression, alt sounds and artists who don’t fit the industry mould.\\n\\n***Get your tickets now to keep music alive.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T19:00:00+00:00\",\"sale_end_date\":\"2026-02-25T19:00:00+00:00\",\"sale_start_date\":\"2026-02-14T20:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Rise.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"11998\",\"name\":\"Rise\",\"address\":\"Goldsmiths Students' Union, Dixon Rd, London SE14 6NW\",\"location\":{\"lat\":51.47471,\"lng\":-0.03668},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\