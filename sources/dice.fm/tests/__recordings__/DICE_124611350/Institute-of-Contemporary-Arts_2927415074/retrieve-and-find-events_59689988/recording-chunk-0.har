s\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-22T16:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/1889c26c-be34-41e8-bf3a-9e982dc456e2.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/1889c26c-be34-41e8-bf3a-9e982dc456e2.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/1889c26c-be34-41e8-bf3a-9e982dc456e2.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/W6efeddd2641?dice_id=W6efeddd2641\",\"post_competition_referral\":\"https://link.dice.fm/vc17b7d39c15?dice_id=vc17b7d39c15\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r52772cc8990?dice_id=r52772cc8990\",\"post_purchase_referral\":\"https://link.dice.fm/L60f8589a874?dice_id=L60f8589a874\",\"post_reminder_referral\":\"https://link.dice.fm/J8e65e9fb44c?dice_id=J8e65e9fb44c\",\"post_waitinglist_referral\":\"https://link.dice.fm/V335315cd52d?dice_id=V335315cd52d\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"db136d3610fd9326:41\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763324100,\"id\":\"691a2e7bef017f0001b34c8c\",\"name\":\"Rats for a Reason: The Rodents for the Mayor’s Charity\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Rodents are making noise to raise money for **Chelmsford CVS**\\n\\nGnawing through the greatest indie rock hits\\n\\nInfectious rock with songs by The Jam, Killers, The Cure, Muse and many more.\\n\\nBig tunes small mammals, come and get ratted (for a great local cause) with ***The Rodents***!\\n\\n**Chelmsford CVS** is an independent charity that supports, develops, trains, strengthens, and champions over 350 voluntary and community organisations across our district.\\n\\nWe also operate the Chelmsford Volunteer Centre, deliver community projects such as the Men’s Shed and Community Gardens, and host NHS Social Prescribers.\\n\\nWorking locally and in partnership with organisations across Essex, Southend, and Thurrock, we aim to maximise voluntary and community action, build strong and resilient communities, and enhance local wellbeing.\\n\\nwww.chelmsfordcvs.org.uk\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1771776000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1350},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-22T17:00:00+00:00\",\"sale_start_date\":\"2026-01-28T00:00:00+00:00\",\"event_start_date\":\"2026-02-22T17:00:00+00:00\",\"event_end_date\":\"2026-02-22T21:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"v3qxx7-alvorada-ies-loubet-carnival-special-22nd-feb-fox-and-firkin-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Alvorada - Doce Do Lobo\",\"redirect_url\":\"https://music.apple.com/us/album/doce-do-lobo/1771462250?i=1771462256&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alvorada\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/9d/59/57/9d5957f1-ec9c-5966-0006-9bd7a7d4abb8/mzaf_15890355505802750680.plus.aac.p.m4a\",\"track_name\":\"Doce Do Lobo\"},{\"type\":\"sp