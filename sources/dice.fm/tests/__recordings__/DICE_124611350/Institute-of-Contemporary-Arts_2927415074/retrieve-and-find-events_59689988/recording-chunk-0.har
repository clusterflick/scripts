_id=f99ebe3460de\",\"post_waitinglist_referral\":\"https://link.dice.fm/weabbe30b8c8?dice_id=weabbe30b8c8\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eorvpw-laurel-halo-presents-midnight-zone-a-film-by-julian-charrire-4th-apr-ica-institute-of-contemporary-arts-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":861,\"name\":\"Institute of Contemporary Arts\",\"privacy_policy_link\":\"https://ica.art/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775327400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:60\",\"price\":{\"currency\":\"GBP\",\"amount\":2650,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/92c488a3-e121-4697-9537-869a36c9cdba.jpg?rect=846%2C99%2C3152%2C3158\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/92c488a3-e121-4697-9537-869a36c9cdba.jpg?rect=0%2C1507%2C4815%2C2889\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/92c488a3-e121-4697-9537-869a36c9cdba.jpg?rect=785%2C0%2C3246%2C5902\"},\"id\":\"698b3ca2d51e1900015dc91e\",\"name\":\"Laurel Halo presents Midnight Zone (a film by Julian Charriére)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Laurel Halo presents a live soundtrack to the film Midnight Zone by visual artist Julian Charrière, which follows the path of a drifting Fresnel lighthouse lens as it descends through the Clarion-Clipperton Fracture Zone — a remote abyssal plain in the Pacific Ocean, rich in raremetals and increasingly targeted for deep-sea mining — the film traces a descent into one of Earth’s last untouched ecosystems.\\n\\nLaurel Halo is an artist who uses minimalism, ambient, musique concrète, and jazz approaches to meld the materiality and spirituality of sound. Following Atlas (2023), an album of swelling strings, convectional texture, and classical flourishes, she turns to Charrière's film as the next site for her otherworldly musical summonings. Midnight Zone is an underwater meditation upon the Clarion-Clipperton Zone – a remote spot in the Pacific that is threatened by deep-sea mining for its rare metals.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T10:00:00+00:00\",\"sale_end_date\":\"2026-04-04T19:30:00+01:00\",\"sale_start_date\":\"2026-02-12T10:00:00+00:00\",\"event_start_date\":\"2026-04-04T19:30:00+01:00\",\"event_end_date\":\"2026-04-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dews Pegahorn\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-27/f671915b-497e-468c-aba9-f277310d9e12.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"115834\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Gotobeat.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"5184\",\"name\":\"Gotobeat\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-03/167fd842-233e-4076-a3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"announcement_date_unix\":1762650000,\"social_links\":{\"event_share\":\"https://link.dice.fm/z5f9b587de1c?dice_id=z5f9b587de1c\",\"post_competition_referral\":\"https://link.dice.fm/Ae720767d2c9?dice_id=Ae720767d2c9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j8e9d6522f9a?dice_id=j8e9d6522f9a\",\"post_purchase_referral\":\"https://link.dice.fm/Fb19f3a49e68?dice_id=Fb19f3a49e68\",\"post_reminder_referral\":\"https://link.dice.fm/h1a1f266d934?dice_id=h1a1f266d934\",\"post_waitinglist_referral\":\"https://link.dice.fm/h0720742db80?dice_id=h0720742db80\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"92x32d-dews-pegahorn-4th-apr-strongroom-bar-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775327400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:61\",\"price\":{\"currency\":\"GBP\",\"amount\":1693,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-09/e0d02dac-953e-444c-a02e-3bf9b215c6d6.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-09/e0d02dac-953e-444c-a02e-3bf9b215c6d6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-09/e0d02dac-953e-444c-a02e-3bf9b215c6d6.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6910e87f5572650001e185b9\",\"name\":\"Dews Pegahorn\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Dews Pegahorn heads to Strongroom, London on Saturday 4th April as part of his up coming 'The Madness' European tour in spring 2026.\\n\\nDews Pegahorn describes his authentic artistic voice and expression in three words: “danceable manic depression.“ Dews, born in Stuttgart, is a German-African rock musician with roots in Madagascar and Angola, whose musical journey began early in life, inspired by legends like Michael Jackson and shaped by the music of 2Pac. After receiving classical vocal training at a music boarding school and gaining initial experience as the frontman of a rock band, he developed his unique style - marked by melancholic guitars, wild drums, and atmospheric vocals. Dews Pegahorn embodies raw energy, radical authenticity, and the courage to push boundaries. With a mix of deep emotion and explosive stage presence, he creates a one-of-a-kind connection with his audience.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-09T01:00:00+00:00\",\"sale_end_date\":\"2026-04-04T17:00:00+01:00\",\"sale_start_date\":\"2025-11-09T01:00:00+00:00\",\"event_start_date\":\"2026-04-04T19:30:00+01:00\",\"event_end_date\":\"2026-04-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Dews Pegahorn - Runnin'\",\"redirect_url\":\"https://open.spotify.com/track/0gRi9sge1aomdsqMdWGtXx\",\"artist\":\"Dews Pegahorn\",\"preview_url\":\"https://p.scdn.co/mp3-preview/75655db568c95d121a51b7ba867f0e98765ed44a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Runnin'\"},{\"type\":\"apple_music\",\"title\":\"Dews Pegahorn - Runnin'\",\"redirect_url\":\"https://music.apple.com/us/album/runnin/1724150638?i=1724150643&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dews Pegahorn\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/1f/2c/cd/1f2ccd07-f003-cf76-6343-f5b16285a3b9/mzaf_10299686734891607706.plus.aac.p.m4a\",\"track_name\":\"Runnin'\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Black Doldrums\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-17/8346267e-bc65-4c43-b88e-7a77f422778d.jpg?rect=0%2C128%2C1024%2C1024\"},\"artist_id\":\"9046\",\"about\":{\"description\":\"Kevin Gibbard and Sophie Landers produce a contemporary form of gothic post-punk, with songs that contain hook and lead tribal drums and euphoric guitar textures that frame introspective lyrics. They are known for their intense live performances, creating their own style of dark post-punk driven by vicious drums, distinctive atmospheric guitar and melodic bass.\\n\\nAfter the success of their debut album ‘Dead Awake’ on Fuzz Club Records in 2022 and gaining critical acclaim across mainstream media outlets, such as Uncut, Rolling Stone and Sonic Seducer, the band released their follow up second album ‘In Limerence’ in October 2024. Described by Louder Than War as ‘ lush yet glacial soundscapes, ramping up with bursts of energy before dispersing and cascading into an ethereal depth” ‘In Limerence’ is proving to be the album that pushes Black Doldrums further into the depths of their atmospheric post-punk.\\n\\n“A mix of gothic-rock and shoegaze sounds to die for” - Rolling Stone\\n\\n“A fierce combination of post-punk, reverb, drone and melody” - Uncut\\n\\n“Awe -inspiring…Black Doldrums create transient and euphoric dark post-punk” - Louder Than War\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bad Vibrations\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":35299,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"12\",\"name\":\"Bad Vibrations\",\"image\":{\"url\":\"https://