5-10-13/6cbef328-a6fa-479d-b1e5-a22d88e7dfb8.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/E1dce79fc0d4?dice_id=E1dce79fc0d4\",\"post_competition_referral\":\"https://link.dice.fm/h9f077d5095e?dice_id=h9f077d5095e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H2febb4451e7?dice_id=H2febb4451e7\",\"post_purchase_referral\":\"https://link.dice.fm/z4333b1f8085?dice_id=z4333b1f8085\",\"post_reminder_referral\":\"https://link.dice.fm/sb67d29746c3?dice_id=sb67d29746c3\",\"post_waitinglist_referral\":\"https://link.dice.fm/H951b3d3ba81?dice_id=H951b3d3ba81\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:92\",\"properties\":[],\"presented_by\":\"Presented by Communion ONE.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760428800,\"id\":\"68ea717519d3b900017335df\",\"name\":\"Mariae Cassandra\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Communion ONE presents:\\n\\nMariae Cassandra\\n\\n\\\\+ Ziggy 2000\\n\\n\\\\+ Krystyn\\n\\nMariae Cassandra is an upcoming artist from Perth, Western Australia. Known from her YouTube videos, to Instagram posts, to millions of views on her TikTok, to now a emerging Singer-Songwriter. Taking out the annual triple j Unearthed High competition in September 2024 with her song ‘MillIon Billion Trillion’ – a love song dedicated to her bestie – Mariae creates timeless and catchy songs with the sonic magic and whimsy of her inspirations beabadoobee and Clairo.\\n\\nIn 2024, Mariae quickly became one to watch after touring nationally supporting WAFIA, signing to Select Music and releasing her single 'Seventeen' through AWAL, landing on internationally recognised playlists including becoming the cover of Fresh Finds Global.\\n\\nFast forward to 2025 and Mariae has begun her year warming up main stage for Charli XCX and beabadoobee at Laneway Festival, supporting boywithuke, Spacey Jane and South Summit and was just listed as one of Live Nation’s ‘Ones To Watch’.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"date_unix\":1771959600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1952,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-24T16:00:00+00:00\",\"sale_start_date\":\"2025-09-19T10:00:00+01:00\",\"event_start_date\":\"2026-02-24T19:00:00+00:00\",\"event_end_date\":\"2026-02-24T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"92ggqn-alex-spencer-24th-feb-the-lower-third-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Alex Spencer - Nightmares\",\"redirect_url\":\"https://music.apple.com/us/album/nightmares/1752973514?i=1752973518&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alex Spencer\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/a9/78/9a/a9789a6a-f98b-b96a-62e