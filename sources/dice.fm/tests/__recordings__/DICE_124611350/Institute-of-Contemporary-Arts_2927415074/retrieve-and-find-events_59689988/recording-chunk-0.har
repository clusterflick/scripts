3871,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Tue 08 Dec\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-06T00:00:00+01:00\",\"sale_end_date\":\"2026-12-11T19:00:00+00:00\",\"sale_start_date\":\"2025-08-06T00:15:00+01:00\",\"event_start_date\":\"2026-12-11T19:00:00+00:00\",\"event_end_date\":\"2026-12-11T23:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/W7aa398ba223?dice_id=W7aa398ba223\",\"post_competition_referral\":\"https://link.dice.fm/g70259775a8a?dice_id=g70259775a8a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j5281936398b?dice_id=j5281936398b\",\"post_purchase_referral\":\"https://link.dice.fm/U1ebbb2b3788?dice_id=U1ebbb2b3788\",\"post_reminder_referral\":\"https://link.dice.fm/w84c74c56d51?dice_id=w84c74c56d51\",\"post_waitinglist_referral\":\"https://link.dice.fm/i1f9e20cfb12?dice_id=i1f9e20cfb12\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"“These guys are not (yet) signed, but they should be, and are definitely ones to watch” – ***Rock News***\\n\\nFrom Mersea Island in Essex this young, new, and exciting duo, **Wilswood Buoys**, are currently cutting their name into the UK underground scene.\\n\\nMixing trad folk, with modern alternative acoustic pop, the band have a sound that’s raw, fresh, familiar, and accessible.\\n\\n**Josh** and **Joe** are, like a lot of bands, a couple of mates who from simply getting together for a jam saw things quickly escalate into writing music and playing local gigs. Both had a completely different upbringing in terms of musical styles leading them down a path of intertwined genres worked into one, with a thread of catchy riffs, natural chemistry, and big, bold choruses.\\n\\n2023 saw them complete their first UK tour with Frank Turner, followed by a support for The Levellers on their acoustic tour. Additionally, they played many festivals including Boomtown Fair and Northern Kin Festival.\\n\\n*Frank Turner* also produced their acclaimed debut album ‘A New Beginning‘ which was released in January 2023, an album crammed full of barnstorming sing-a-longs ready to unleash on audiences across the UK and beyond!\\n\\n“… melodic, foot-stamping folk” – ***Americana UK***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1797015600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-12-11T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\