,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:81\",\"about\":{\"description\":\"In 2026, Stevie Wonder will be turning 76 years of age. In celebration of one of the most iconic musicians of all time, AGMP are presenting a night dedicated to Stevland Hardaway Morris with rare archive films, DJ's and a live performance from The Wonderband with special guests to be announced.\\n\\nThe Wonderband will be performing live playing hits and fan favourites such as Isn't She Lovely, Higher Ground, Masterblaster (Jammin'), Superstition, For Once In My Life, Sir Duke, Do I Do, Lately, Uptight (Everything's Alright), I Was Made To Love Her, Boogie On Reggae Woman, I Wish, Living For The City, As, My Cherie Amour, Pastime Paradise, and, of course, Happy Birthday.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1763510400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-19/eecc5463-7437-448f-aba6-cf4b9992eee0.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-19/eecc5463-7437-448f-aba6-cf4b9992eee0.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-19/eecc5463-7437-448f-aba6-cf4b9992eee0.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"691df3b3463f010001e4d39a\",\"name\":\"Stevie Wonder's Birthday Party\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T00:00:00+00:00\",\"sale_end_date\":\"2026-05-13T00:00:00+01:00\",\"sale_start_date\":\"2025-11-19T00:00:00+00:00\",\"event_start_date\":