is_hidden_event\":false,\"perm_name\":\"g5lqm6-the-velvet-hands-london-28th-mar-the-dome-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774724400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-29/d81ef799-ead4-4631-8df5-9852485eb9ca.jpg?rect=0%2C512%2C3072%2C3072\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-29/d81ef799-ead4-4631-8df5-9852485eb9ca.jpg?rect=0%2C1126%2C3072%2C1843\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-29/d81ef799-ead4-4631-8df5-9852485eb9ca.jpg?rect=410%2C0%2C2252%2C4095\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/t87b385d005f?dice_id=t87b385d005f\",\"post_competition_referral\":\"https://link.dice.fm/t291983493ab?dice_id=t291983493ab\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F773f24a905d?dice_id=F773f24a905d\",\"post_purchase_referral\":\"https://link.dice.fm/v4e7cd0fce4c?dice_id=v4e7cd0fce4c\",\"post_waitinglist_referral\":\"https://link.dice.fm/L75ad98e5ec9?dice_id=L75ad98e5ec9\",\"post_reminder_referral\":\"https://link.dice.fm/K49a3449e908?dice_id=K49a3449e908\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"84\",\"name\":\"The Dome\",\"address\":\"2A Dartmouth Park Hill, London NW5 1HL\",\"location\":{\"lat\":51.5579086,\"lng\":-0.139039799999978},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-dome-jq5a\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"This Feeling Present\\n\\nThe Velvet Hands + Special Guests\\n\\nThe Velvet Hands have always thrived on chaos, hooks and the kind of\\n\\nlive shows that spill over with energy. On Friday 28th March 2026, the\\n\\nband take the next leap with their biggest headline yet at The Dome,\\n\\nTufnell Park, London.\\n\\nIt’s been a wild ride to this point. From sold-out London shows at The\\n\\nLexington, Omeara and Dingwalls to supporting legends like Liam\\n\\nGallagher, Paul Weller and Hard-Fi, the Cornish-born, London-based\\n\\nfour-piece have built a reputation as one of the UK’s most exciting live\\n\\nbands. They’ve crashed festival stages at Boardmasters, Truck and Isle\\n\\nof Wight, been picked personally by Michael Eavis to support Elbow at\\n\\nthe Pilton Party, and even played live from the roof of a yellow school\\n\\nbus.\\n\\nThe press have had their say too: “Full of Bolshy Spirit” (NME), “bolshy,\\n\\nbrash garage punk rabble-rousers” (GodsInTheTV), and “jaw droppingly\\n\\ngood” (Gigslutz). On radio, they’ve been championed by BBC\\n\\nIntroducing, Steve Lamacq and John Kennedy, who’s playlisted every\\n\\nsingle they’ve dropped.\\n\\nNow it’s time for The Dome. A night of big riffs, big choruses, and a band\\n\\nhitting their stride.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14 + Under 18's accompanied with an adult (ID Maybe Required)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:91\",\"billing_promoter\":{\"id\":\"531\",\"name\":\"This Feeling\",\"image\":{\"url\":null},\"perm_name\":\"this-feeling-j756\",\"profile_active\":false},\"presented_by\":\"Presented by This Feeling.\",\"properties\":[],\"unicorn_extras\":fals