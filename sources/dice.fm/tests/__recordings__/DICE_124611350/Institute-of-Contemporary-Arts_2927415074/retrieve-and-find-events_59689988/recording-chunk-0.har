b2898654053\",\"post_purchase_referral\":\"https://link.dice.fm/F59f224a4720?dice_id=F59f224a4720\",\"post_reminder_referral\":\"https://link.dice.fm/ibbfc761252d?dice_id=ibbfc761252d\",\"post_waitinglist_referral\":\"https://link.dice.fm/x3fbb936b72e?dice_id=x3fbb936b72e\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yomvmv-athomkraft-pink-floyds-live-at-pompeii-2050-24th-feb-colours-hoxton-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1771961400,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:13\",\"price\":{\"currency\":\"GBP\",\"amount\":1808,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-17/49b9acde-007a-4dc1-9c85-8b91a4714881.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-17/49b9acde-007a-4dc1-9c85-8b91a4714881.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-17/49b9acde-007a-4dc1-9c85-8b91a4714881.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"68512a3f212ac800015a0002\",\"name\":\"Athomkraft - Pink Floyd's Live at Pompeii 2050\",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"Live at Pompeii 2050 – A Futuristic Pink Floyd Experience.\\n\\nStep into a mind-bending audiovisual journey with ATHOMKRAFT as they reimagine Pink Floyd’s legendary 1972 concert in Pompeii—this time, through an electronic lens. Performed without an audience, just like the original, this 90-minute show features stunning synchronised video projections and a 432Hz-tuned soundscape designed to heighten emotional and spiritual resonance.\\n\\nFeaturing iconic tracks like Echoes, One of These Days, and Set the Controls for the Heart of the Sun, this immersive experience invites you to reconnect with nature, music, and the cosmos.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-24T21:00:00+00:00\",\"sale_start_date\":\"2025-06-17T10:00:00+01:00\",\"event_start_date\":\"2026-02-24T19:30:00+00:00\",\"event_end_date\":\"2026-02-24T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pollyfromthedirt \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-14/9fdf3dc8-350e-4aaf-becb-62e665a8654f.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"124248\",\"about\":null,\"is_headliner\":false},{\"name\":\"Truthpaste\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe5c5a9eef3e0c46634bf1563\"},\"artist_id\":\"94288\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bird On The Wire\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":2,\"properties\":[],\"venues\":[{\"id\":\"5847\",\"name\":\"below Stone Nest\",\"address\":\"136 Shaftesbury Ave, London W1D 5EZ, UK\",\"location\":{\"lat\":51.5129552,\"lng\":-0.1293207},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"below-stone-nest-o6yg\",\"accessibi