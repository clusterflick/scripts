l\":\"https://link.dice.fm/Pa56d39870be?dice_id=Pa56d39870be\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"rynl6y-london-music-ultimate-showcase-benjamin-cook-24th-feb-piano-smithfield-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1771960500,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:2\",\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-18/5ff0688a-8832-4a72-8c64-5815aac2b382.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-18/5ff0688a-8832-4a72-8c64-5815aac2b382.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-18/5ff0688a-8832-4a72-8c64-5815aac2b382.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"69655b9e097f7e000195bbc3\",\"name\":\"London Music Ultimate Showcase: Benjamin Cook\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\--\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-02T10:45:00+00:00\",\"sale_end_date\":\"2026-02-24T18:45:00+00:00\",\"sale_start_date\":\"2026-01-02T11:00:00+00:00\",\"event_start_date\":\"2026-02-24T19:15:00+00:00\",\"event_end_date\":\"2026-02-24T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Benjamin Cook - All Too Easy\",\"redirect_url\":\"https://music.apple.com/us/album/all-too-easy/1219688255?i=1219688505&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Benjamin Cook\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/be/82/6f/be826fb3-f833-51fa-a9b8-3a68ba1699ce/mzaf_1334279431323452582.plus.aac.p.m4a\",\"track_name\":\"All Too Easy\"},{\"type\":\"spotify\",\"title\":\"Benjamin Cook - All Too Easy\",\"redirect_url\":\"https://open.spotify.com/track/1sKGlKpMfAj2kEGbA2Cl2e\",\"artist\":\"Benjamin Cook\",\"preview_url\":\"https://p.scdn.co/mp3-preview/434f1847e0f109ba0