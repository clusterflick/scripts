amount\":900,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4NTU0NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUxMTc0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OTozNi4zMzg2OTBaIiwicHJpY2UiOjkwMCwidmFyaWFudF9pZCI6MzU4MywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTIwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4NTU0NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUxMTc0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OTozNi4zMzg2OThaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjM1ODQsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":72443,\"title\":\"Can I bring a camera?\",\"body\":\"Please note no professional cameras are allowed. Small cameras are fine but anything too big or with a detachable lense will be turned away as we are a small space.\",\"order\":0},{\"id\":72444,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":1},{\"id\":72445,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":2},{\"id\":72446,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 15-30 minutes, playing songs from the new release or a Q&A. Please note there is only 15min between the door time and the stage time.\",\"order\":3},{\"id\":72447,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":4},{\"id\":72448,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":72449,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":72450,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":7},{\"id\":72451,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":8}],\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"i