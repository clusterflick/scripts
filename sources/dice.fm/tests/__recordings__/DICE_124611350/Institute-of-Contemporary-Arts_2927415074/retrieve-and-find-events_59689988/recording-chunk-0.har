he West Midlands. They are passionate about recreating the live experience in a way that always puts the music first. The band’s sets comprise the whole of the Chili Peppers’ output, focusing on great live versions of the hits and sought-after rarities. Utilising much of the same gear and outfits as the band, you’d be hard-pressed to find a tone or feel closer to the originals!\\n\\nhttps://linktr.ee/ChiliPeppersUK\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:78\",\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"presented_by\":\"New Cross Live presents\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Red Hot Chili Peppers UK\",\"image\":null,\"artist_id\":\"32525\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1765879200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T10:00:00+00:00\",\"sale_end_date\":\"2026-03-20T17:00:00+00:00\",\"sale_start_date\":\"2025-12-16T10:00:00+00:00\",\"event_start_date\":\"2026-03-21T18:00:00+00:00\",\"event_end_date\":\"2026-03-21T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69401edef3f3520001a3203c\",\"name\":\"Red Hot Chili Peppers UK\",\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available