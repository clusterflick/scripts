e,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Colin Stetson - The Righteous Wrath of an Honorable Man\",\"redirect_url\":\"https://open.spotify.com/track/2xQdhapJIm0jS5ZNC3zhee\",\"artist\":\"Colin Stetson\",\"preview_url\":\"https://p.scdn.co/mp3-preview/380cc4c637ad745ead67d41f3ab6cb876a48b6e2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Righteous Wrath of an Honorable Man\"},{\"type\":\"apple_music\",\"title\":\"Colin Stetson - The Righteous Wrath of an Honorable Man\",\"redirect_url\":\"https://music.apple.com/us/album/the-righteous-wrath-of-an-honorable-man/482631565?i=482631698&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Colin Stetson\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/da/56/a8/da56a89c-a1e3-c4bb-5c3d-65d36068bc5a/mzaf_13935536020360035485.plus.aac.p.m4a\",\"track_name\":\"The Righteous Wrath of an Honorable Man\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776364200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/I12dbc0c0cf6?dice_id=I12dbc0c0cf6\",\"post_competition_referral\":\"https://link.dice.fm/s86b970fd5f6?dice_id=s86b970fd5f6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N7cc2a16cd28?dice_id=N7cc2a16cd28\",\"post_purchase_referral\":\"https://link.dice.fm/e881bb6ce0c0?dice_id=e881bb6ce0c0\",\"post_reminder_referral\":\"https://link.dice.fm/n4fe6ca6e188?dice_id=n4fe6ca6e188\",\"post_waitinglist_referral\":\"https://link.dice.fm/M8dc486b830d?dice_id=M8dc486b830d\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":8,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:80\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-15T10:00:00+01:00\",\"sale_end_date\":\"2026-04-16T19:30:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-04-16T19:30:00+01:00\",\"event_end_date\":\"2026-04-16T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1760518800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2900},\"id\":\"68ee75fe1597040001e3d9ca\",\"name\":\"Colin Stetson + dal:um\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Colin Stetson\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-04-11/b450c5b9-2daa-46dc-865c-b56ba5a102fa.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"2228\",\"about\":null,\"is_headliner\":false},{\"name\":\"Dal:um\",\"image\":null,\"artist_id\":\"31384\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"xekmoa-colin-stetson-dalum-16th-apr-the-clapham-grand-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-14/2b1b6bbf-6055-4285-afdd-551bf6653f6b.jpg?rect=174%2C0%2C3475%2C3475\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-14/2b1b6bbf-6055-4285-afdd-551bf6653f6b.jpg?rect=0%2C591%2C3822%2C2293\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-14/2b1b6bbf-6055-4285-afdd-551bf6653f6b.jpg?rect=956%2C0%2C1911%2C3475\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"**THURSDAY APRIL 16TH 2026 / DOORS & BARS OPEN 7:30PM / SHOW STARTS APPROX. 50 MINS AFTER DOORS**\\n\\nBaba Yaga's Hut Presents:\\n\\nColin Stetson + dal:um at The Clapham Grand\\n\\nColin Stetson is a renowned saxophonist and composer celebrated for his innovative approach to the instrument and his ability to push the boundaries of contemporary music. Born in Ann Arbor, Michigan, Stetson grew up surrounded by a rich musical landscape, studying the saxophone from an early age and honing his craft through rigorous classical and jazz training. He attended the University of Michigan, where he studied under esteemed saxophonists Donald Sinta and Christopher Creviston. Stetson’s music is characterized by his pioneering use of extended techniques, including circular breathing, multiphonics, and percussive key sounds, which transform the saxophone into an orchestra of its own. His solo works, such as his newest album 'The love it took to leave you' showcase his ability to create dense, emotive soundscapes without overdubs or loops. In addition to his solo career, Stetson has collaborated with an array of artists, including Bon Iver, Arcade Fire, and Laurie Anderson. He has also composed for film and television, with notable scores for 2018’s Hereditary, The Menu, and Uzumaki. With a fearless dedication to exploration, Colin Stetson continues to redefine what is possible in modern music, earning his place as a singular voice in the world of contemporary composition and performance.\\n\\n\\\\--\\n\\nDal:um is a musical duo based in Seoul, who challenges the sonic possibilities of Korea’s most well-known traditional string instruments: the gayageum and geomungo. Ethereal and otherworldly, Dal:um creates a compelling soundworld that treasures subtle dynamics and the space between the notes.\\n\\nTwo musicians. Two weighty acoustic stringed instruments. A dialogue between traditional and experimental practices. A melding of both new possibilities and deeply traveled resonances.\\n\\nSilence and expression.\\n\\nContemporary and traditional.\\n\\nFullness and emptiness.\\n\\nSimilar and different.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\n14+. All U18s must be accompanied by someone 21+. No more than two U18s per over 21.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776373200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"12441\",\"name\":\"Sui Generis\",\"address\":\"558 Kingsland Road, Hackney, London, E8 4AH, United Kingdom\",\"location\":{\"lat\":51.54503,\"lng\":-0.07563},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sui-generis-x37l\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T22:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"