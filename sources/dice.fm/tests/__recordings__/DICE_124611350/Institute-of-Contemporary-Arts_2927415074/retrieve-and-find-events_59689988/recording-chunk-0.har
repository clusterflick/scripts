23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"pypl3p-kataklysm-23rd-feb-o2-academy-islington-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Underneath the Scars\",\"redirect_url\":\"https://open.spotify.com/track/08YwIGFDmY2FjeY05kgUmX\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/99b72aca4aa51cc0c9859a564d7976da23289bd1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Underneath the Scars\"},{\"type\":\"apple_music\",\"title\":\"Kataklysm - Elevate\",\"redirect_url\":\"https://music.apple.com/gb/album/elevate/718285702?i=718285785&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kataklysm\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview71/v4/19/fb/f0/19fbf035-9b3f-b534-3378-20f559a9ea3b/mzaf_3767604212229991210.plus.aac.p.m4a\",\"track_name\":\"Elevate\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":50705,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vader\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c9d4cd3b704d5fdea23b0ea76\"},\"artist_id\":\"3292\",\"about\":null,\"is_headliner\":false},{\"name\":\"Blood Red Throne\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2a1b2ee7bfd96bc2e5e269