ll,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:91\",\"properties\":[],\"presented_by\":\"Baba Yaga's Hut \",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763047800,\"id\":\"690b198864e1a60001d51f3e\",\"name\":\"Heavenphetamine\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nHeavenphetamine at The Shacklewell Arms\\n\\nHeavenphetamine is a duo of Hiroki and Sara, blending KrautRock, Experimental, Post Punk, Progressive Rock, Trip Hop, and Acid House into a sound that’s uniquely theirs. Intricate synth loops, live drumming, and melodic Japanese vocals shape their sonic identity.\\n\\nAfter releasing two Post Punk EPs and relocating to Tbilisi, they formed a deep connection with Ukraine, playing a defining show in Kyiv just before the war. Following the invasion, they embarked on a charity tour across Europe and later recorded an album in Kyiv amidst air raids and blackouts. In 2024, they released The Sun On A Winter Day under the Ukrainian label Kontrabass Promo.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"date_unix\":1775932200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3348},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-14T15:00:00+01:00\",\"sale_end_date\":\"2026-04-11T21:00:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-04-11T19:30:00+01:00\",\"event_end_date\":\"2026-04-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8gw6x-julianna-barwick-mary-lattimor-11th-apr-earth-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. Every donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\\n\\nA percentage of your donation goes towards a payment processing fee (DICE keeps none of this fee). For a £10 donation, the charity gets £9.75.\\n\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA5NTU5NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTEzNDUxLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NDc4NzJaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MjYwMCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA5NTU5NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTEzNDUxLCJjcmVhdGVkX2F0I