,\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-24T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/69cbb1ff-e8d6-4f08-8b7a-bc6596ef2aa8.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/69cbb1ff-e8d6-4f08-8b7a-bc6596ef2aa8.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/69cbb1ff-e8d6-4f08-8b7a-bc6596ef2aa8.jpg?rect=506%2C0%2C1238%2C2250\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/P767f0eae606?dice_id=P767f0eae606\",\"post_competition_referral\":\"https://link.dice.fm/Bca86b8df506?dice_id=Bca86b8df506\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/oa4388744384?dice_id=oa4388744384\",\"post_purchase_referral\":\"https://link.dice.fm/H246006cf129?dice_id=H246006cf129\",\"post_reminder_referral\":\"https://link.dice.fm/iebb81bc2423?dice_id=iebb81bc2423\",\"post_waitinglist_referral\":\"https://link.dice.fm/J264ec439894?dice_id=J264ec439894\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"db136d3610fd9326:91\",\"properties\":[],\"presented_by\":\"Sounds Sick x The Season\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768640400,\"id\":\"696a47242971ef00018b5886\",\"name\":\"The Season: The Roebucks, Jonique, SoftTop\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Season proudly presents a collaborative show with the wonderful Sounds Sick; visiting the Ivy House in Nunhead. A community venue that holds some of the best shows in London. A true hidden gem of the city's music scene, we're absolutely delighted to be hosting this show.\\n\\nSounds Sick is back with another seasonal offering - and this time we’re crossing south of the river!\\n\\nBrighton quartet The Roebucks top the bill, bringing their indie americana to the gorgeous Ivy House on 24th Feb\\n\\nFellow Brightonians SoftTop join - come watch us squeeze in this cinematic seven piece on stage! Their set is not to be missed!\\n\\nThen we have our fav 2026 newbie - Jonique! Former Fräulein frontwoman Joni Samuels is back with her new project - and she’s bringing her band!\\n\\nIt’s a night of great people playing lovely tunes in one of London’s most beautiful venues.\\n\\nSee you there?\\n\\nSeasons Change; welcome to Season Two, February 2026\\n\\nPick up your Season Ticket now at https://link.dice.fm/theseason\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1634\",\"name\":\"InFireworks\",\"image\":{\"url\":null},\"perm_name\":\"infireworks-8vqv\",\"profile_active\":false},\"date_unix\":1771959600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1462,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-14T09:00:00+01:00\",\"sale_end_date\":\"2026-02-24T16:00:00+00:00\",\"sale_start_date\":\"2025-10-14T09:00:00+01:00\",\"event_start_date\":\"2026-02-24T19:00:00+00:00\",\"event_end_date\":\"2026-02-24T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"k6k8wo-mariae-cassandra-24th-feb-the-grace-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Love Vomit\",\"redirect_url\":\"https://open.spotify.com/track/1qWdaFIPrEiAtBvK3FGy5L\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/942574e94128e8167498c46251875e8cc6a87621?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Love Vomit\"}],\"donation\":null,\"public_refund_policy\":{\"type\":