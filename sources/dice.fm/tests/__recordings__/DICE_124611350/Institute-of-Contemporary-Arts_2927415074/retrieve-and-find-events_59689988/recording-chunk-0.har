ndscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/e35e66c3-bf7e-44e8-8269-0253f0a68cf2.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/e35e66c3-bf7e-44e8-8269-0253f0a68cf2.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Kaleidoscope Festival returns to Alexandra Palace on Saturday 11 July for a one-day celebration of music, comedy, culture and family fun, set against some of London’s best panoramic views.\\n\\nHeadlined by Rudimental, the genre-spanning line-up also features Groove Armada (DJ set), MJ Cole (live), Black Grape, Roni Size and The Amy Winehouse Band, alongside top comedy talent led by Russell Kane. With multiple stages, immersive experiences underneath the Palace, a dedicated family area and an anything-goes spirit, Kaleidoscope is a festival that truly lives up to its name.\\n\\nAll ages welcome. Under 16s to be accompanied by an adult over the age of 21.\\n\\n*If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally*\\n\\n*Venue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#*\\n\\n*Price includes a £2 venue restoration levy.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 16s to be accompanied by an adult over the age of 21.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68765e2fffb72c000116a4ad\",\"name\":\"Kaleidoscope Festival\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/ld4v3o01pnLsy0049601FW1ggPlpy00023Oo7pW1oFZ00p7q4.m3u8\",\"track_name\":\"\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Amy Winehouse Band\",\"image\":null,\"ar