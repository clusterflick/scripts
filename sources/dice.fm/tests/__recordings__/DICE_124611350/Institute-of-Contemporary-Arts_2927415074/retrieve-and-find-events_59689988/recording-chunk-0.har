B\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sebright-arms-4mm9\",\"accessibility\":{\"url\":\"https://www.sebrightarms.com/about\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-22T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/cccc0adf-509a-41f2-8d6b-c137be8d659e.jpg?rect=534%2C0%2C2216%2C2216\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/cccc0adf-509a-41f2-8d6b-c137be8d659e.jpg?rect=0%2C222%2C2955%2C1773\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/cccc0adf-509a-41f2-8d6b-c137be8d659e.jpg?rect=868%2C0%2C1219%2C2216\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Lef5f3751d04?dice_id=Lef5f3751d04\",\"post_competition_referral\":\"https://link.dice.fm/u24713a53010?dice_id=u24713a53010\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c87e16b018d9?dice_id=c87e16b018d9\",\"post_purchase_referral\":\"https://link.dice.fm/x1faec4d1baa?dice_id=x1faec4d1baa\",\"post_reminder_referral\":\"https://link.dice.fm/Ub10bd65aabe?dice_id=Ub10bd65aabe\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ac497750b822?dice_id=Ac497750b822\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1737,\"name\":\"Sebright Arms\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/630f3de7c213c45e2e1a26eb/t/6788e53103ae512a44d3fc44/1737024817425/Privacy+Policy+-+Sebright+Arms.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:59\",\"properties\":[],\"presented_by\":\"Presented by PULSE.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766059200,\"id\":\"694117d1ea2d7600018dc3dd\",\"name\":\"Atalhos / Special Guests \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"THE FORCE OF THINGS: ATALHOS MAKES A CONSISTENT AND DREAMY AUTOBIOGRAPHY IN A NEW ALBUM, INSPIRED BY THE WORK OF SIMONE DE BEAUVOIR\\n\\nI AM THIS EMPTY CUP/I AM A STORM/THAT PAINTS THE WHOLE SKY GRAY - \\\"ASSIM FALOU ZARATUSTRA\\\", THE FIRST TRACK ON ATALHOS' NEW ALBUM, POINTS TO THEIR PATHS THAT CROSS MUSIC AND LITERATURE. INSPIRED BY THE THIRD MEMOIR OF FRENCH WRITER AND PHILOSOPHER SIMONE DE BEAUVOIR, \\\"A FORÇA DAS COISAS\\\" IS A CONSISTENT ALBUM, FURTHER EXPANDING THE BAND'S CHARACTERISTIC DREAMLIKE SOUND. \\\"A FORÇA DAS COISAS\\\" (COSTA FUTURO - ESP) WILL BE AVAILABLE ON MUSIC PLATFORMS ON JUNE 24, 2025, TUESDAY - LISTEN TO IT.\\n\\n\\\"IT'S THE FIRST ALBUM IN WHICH I'M 100% RESPONSIBLE FOR THE PRODUCTION, AND I THINK THAT'S WHY IT ENDED UP BEING THE MOST METICULOUS WORK WE'VE RECORDED SO FAR,\\\" SAYS VOCALIST, COMPOSER AND GUITARIST GABRIEL SOARES, WHO FOUNDED ATALHOS ALONGSIDE CONRADO PASSARELLI IN BIRIGUI, IN THE INTERIOR OF SÃO PAULO, DRIVEN BY HIS PASSION FOR RECORDS AND MUSIC.\\n\\nTHROUGHOUT ITS EIGHT TRACKS, THE ALBUM NOT ONLY UNITES ARTISTIC LANGUAGES BUT ALSO MIXES LANGUAGES, FEATURING SONGS IN PORTUGUESE AND SPANISH AND FEATURING GUEST APPEARANCES BY LATIN AMERICAN ARTISTS, SUCH AS FRANCO OCAMPO, FROM THE PARAGUAYAN PROJECT EL CULTO CASERO, AND IVES SEPÚLVEDA, FROM THE CHINELO DUO THE HOLYDRUG COUPLE, FEATURED ON THE ALREADY RELEASED DELIRIOS EN PARAGUAY, AND CHILEAN SINGER ANTONIA NAVARRO, WHO PARTICIPATES IN THE UNRELEASED \\\"ANJO MAU\\\".\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":