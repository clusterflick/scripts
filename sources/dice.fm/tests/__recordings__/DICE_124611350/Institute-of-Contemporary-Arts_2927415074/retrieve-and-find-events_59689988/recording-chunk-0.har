tal_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-03-22/7cc3d93b-40fe-417a-976f-3cef063202a7.jpg?rect=26%2C0%2C909%2C909\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-03-22/7cc3d93b-40fe-417a-976f-3cef063202a7.jpg?rect=0%2C167%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-03-22/7cc3d93b-40fe-417a-976f-3cef063202a7.jpg?rect=230%2C0%2C500%2C909\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1711112400,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Foxymop are the UK's most authentic tribute to Rock & Roll Hall of Famers Pearl Jam.\\n\\n30 years on from Pearl Jam putting Seattle on the map, Foxymop bring the nostalgia of old favourites alive, as well as playing live rarities from across the years for an arena setlist in an intimate setting. Led by vocals so on point, you could close your eyes and think it's Eddie Vedder himself. With overdriven guitars, facemelting solos and huge drums to match...you can't find a better band.\\n\\n\\\"Get some Foxymop!!!! Yes, yes!!\\\" - Dave Abbruzzese, Pearl Jam 1991-1994\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:59\",\"social_links\":{\"event_share\":\"https://link.dice.fm/q0a284cb6e22?dice_id=q0a284cb6e22\",\"post_competition_referral\":\"https://link.dice.fm/Y5c2910c020b?dice_id=Y5c2910c020b\",\"post_purchase_extras_available_re