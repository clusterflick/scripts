_end_date\":\"2026-02-21T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Theatreship.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/G3b772808aa9?dice_id=G3b772808aa9\",\"post_competition_referral\":\"https://link.dice.fm/J98e70df4593?dice_id=J98e70df4593\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G8ae88b3f612?dice_id=G8ae88b3f612\",\"post_purchase_referral\":\"https://link.dice.fm/mabc91a5208a?dice_id=mabc91a5208a\",\"post_reminder_referral\":\"https://link.dice.fm/e9ab106739e6?dice_id=e9ab106739e6\",\"post_waitinglist_referral\":\"https://link.dice.fm/J03fee6c6b28?dice_id=J03fee6c6b28\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Louis Gardner is a singer-songwriter and artist based in London, UK. His music sits somewhere between Modern Classical, experimental Folk and lo-fi songwriting, drawing influence from key musical figures such as Morton Feldman, Arthur Russell and Elliott Smith.\\n\\nAugust Cooke’s debut ep Like Rivers was played across the BBC, with Gilles Peterson describing him as a ‘great new talent’. Coming from classical and hindustani music, the songs touch on intimacy and isolation. Live, the voice submerges within a sea of cello.\\n\\nSkyladder  \\nArt with gunpowder  \\nSamuel Hollis - Double Bass  \\nDylan Humphreys - Saxophone  \\nTom Wilson Kellet - Electronics\\n\\nDoors open at 7PM. The bar is open from 4PM\\n\\nTheatreship is committed to broadening access to the arts - we know that ticket price is a barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will do everything we can to help, no questions asked.\\n\\nWe offer arts supporter tickets, for those that can, to pay a higher price to support the venue, the artists who perform here and subsidised tickets for others.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771700400,\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:94\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"id\":\"698886c27176a90001fe310a\",\"name\":\"Louis Gardner with August Cooke and Skyladder\",\"perm_name\":\"k69889-louis-gardner-with-august-cooke-and-skyladder-21st-feb-theatreship-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/1ca433e8-cd02-4009-9bd5-59f14f002745.jpg?rect=102%2C0%2C631%2C631\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/1ca433e8-cd02-4009-9bd5-59f14f002745.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/1ca433e8-cd02-4009-9bd5-59f14f002745.jpg?rect=173%2C0%2C422%2C768\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Louis Gardner\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-15/d4309ac6-cfca-4053-90b4-38827637f50c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"131463\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1770422400,\"faqs\":[{\"id\":74989,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":618},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T00:00:00+00:00\",\"sale_end_date\":\"2026-02-21T18:00:00+00:00\",\"sale_start_date\":\"2026-02-03T01:00:00+00:00\",\"event_start_date\":\"2026-02-21T19:00:00+00:00\",\"event_end_date\":\"2026-02-21T20:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/x3172a7e0538?dice_id=x3172a7e0538\",\"post_competition_referral\":\"https://link.dice.fm/cea08eadda9e?dice_id=cea08eadda9e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zb755551fc4d?dice_id=Zb755551fc4d\",\"post_purchase_referral\":\"https://link.dice.fm/Wdfc7fcee867?dice_id=Wdfc7fcee867\",\"post_reminder_referral\":\"https://link.dice.fm/m6d180a5c9c0?dice_id=m6d180a5c9c0\",\"post_waitinglist_referral\":\"https://link.dice.fm/u8e9ede5b4f5?dice_id=u8e9ede5b4f5\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"A swinging Saturday night of classic 1920s and 1930s tunes\\n\\nBiscuit Town are an early-era swing band with a hard-driving acoustic rhythm section, soulful vocals and mesmerising solos. They return with special guest Immy Churchill to Toulouse Lautrec Jazz Club. Immy is a fast-rising star of the London jazz scene. A graduate of the Royal Academy of Music, she has already performed at venues including Ronnie Scott’s, The Royal Albert Hall, The Jazz Café and the Royal Festival Hall. With Biscuit Town, she brings her warmth, swing and irresistible charm to the timeless songs of the 1920s and 30s.\\n\\nBiscuit Town have built a reputation for bringing vintage swing to life, playing to packed houses at jazz clubs, swing dance events and festivals across the UK. Their shows are always full of energy, joy and a deep love of early jazz.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771700400,\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-21T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":20,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:95\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"id\":\"69821c1ed312890001b83f13\",\"name\":\"Biscuit Town ft. Immy Churchill\",\"perm_name\":\"6d2d53-biscuit-town-ft-immy-churchill-21st-feb-toulouse-lautrec-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/c5c0c11d-ec60-4a3b-87e3-3a9bde238c2b.jpg?rect=2056%2C0%2C3086%2C3086\",\"landscape\":\"https://dice-media.imgix.net/attachm