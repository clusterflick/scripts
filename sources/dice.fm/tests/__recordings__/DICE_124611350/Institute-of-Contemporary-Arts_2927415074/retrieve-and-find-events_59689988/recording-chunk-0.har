x\":1774807200,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2833},\"social_links\":{\"event_share\":\"https://link.dice.fm/jdb814480acf?dice_id=jdb814480acf\",\"post_competition_referral\":\"https://link.dice.fm/n90613e5e7a3?dice_id=n90613e5e7a3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ya6e201a1b30?dice_id=Ya6e201a1b30\",\"post_purchase_referral\":\"https://link.dice.fm/x63f3312f2fe?dice_id=x63f3312f2fe\",\"post_reminder_referral\":\"https://link.dice.fm/ff175f956ae1?dice_id=ff175f956ae1\",\"post_waitinglist_referral\":\"https://link.dice.fm/n6e31d031d62?dice_id=n6e31d031d62\"},\"perm_name\":\"wwxdbx-the-watch-plays-genesis-29th-mar-229-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-20/f1cfef0a-2a2f-4da3-ad12-84214e468756.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-20/f1cfef0a-2a2f-4da3-ad12-84214e468756.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-20/f1cfef0a-2a2f-4da3-ad12-84214e468756.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"The Watch is an Italian progressive rock band from Milan, led by vocalist, principal songwriter and teacher Simone Rossetti, originally formed in 1997. The 5-piece are backfor shows in 2026 premiering an intense 2-hour trip into the world of early Genesis presenting a show featuring the music of TRESPASS, NURSERY CRYME, FOXTROT, SELLING ENGLAND BY THE POUND, THE LAMB LIES DOWN ON BROADWAY, A TRICK OF THE TAIL and WIND AND WUTHERING.\\n\\nWith their deliciously intense performances of early Genesis classics, The Watch have aroused enormous interest from Genesis fans, bringing the band, from year to year, on more and more articulated tours throughout Europe and UK. No other group manages to capture the adventurousness and electricity of Genesis in their pioneering days with quite such raw emotion. Not just a cold reproduction or imitation but the real vibe of a live gig, performed with the same energy the British quintet had back then. The dramatic Gabriel-esque vocals of The Watch singer Simone Rossetti, closest ever to Peter Gabriel, and the all-round instrumental excellence ensure every night is a travel back in time to the early days.\\n\\n\\\"The Watch is a band of very talented people and I recommend them.\\\" - Steve Hackett (Genesis lead guitarist)\\n\\nAccess Information: https://229.london/access/\\n\\nThis is a standing event. We operate a No Readmissions policy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"67dc3fe89a81d200013b3dce\",\"name\":\"'The Watch' Plays Genesis\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Watch\",\"image\":null,\"artist_id\":\"27822\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-29T19:30:00+01:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-29T19:30:00+01:00\",\"event_end_date\":\"2026-03-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.com/privacy-policy/\",\"fb_pixel_id\":\"570786809997969\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web