r\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"id\":\"6973a67828347c0001d10e38\",\"name\":\"Enter Shikari\",\"perm_name\":\"oegdly-enter-shikari-21st-nov-alexandra-palace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/8f2ece9d-5c96-4d24-95ff-e090ddeab3cd.jpg?rect=0%2C292%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/8f2ece9d-5c96-4d24-95ff-e090ddeab3cd.jpg?rect=0%2C864%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/8f2ece9d-5c96-4d24-95ff-e090ddeab3cd.jpg?rect=168%2C0%2C1584%2C2880\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Callous Daoboys\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-31/e03183b8-e55e-4c2f-8265-25c90173e65a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"48572\",\"about\":null,\"is_headliner\":false},{\"name\":\"Holding Absence\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-05-24/d219dc4f-a060-4858-8524-2cf5325f17d5.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"4348\",\"about\":null,\"is_headliner\":false},{\"name\":\"Enter Shikari\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-07-26/215fa2ac-c71c-4eae-b88b-17c22f2a2a5c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"20388\",\"about\":{\"description\":\"Although primarily considered a rock band, since their 2003 debut, Enter Shikari have proven their reputation as musical chameleons. Initially sharing their music to MySpace, the four-piece have explored noisy post-hardcore (2007’s Take to the Skies), dubstep and drum and bass (A Flash Flood of Colour, 2012) and electro-pop and grime (2017’s The Spark), with a host of frenetic live performances in-between, including sold-out shows at Alexandra Palace and headline slots at Reading and Leeds.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1769508000,\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":23131,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23132,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6673},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Sorry You're Not a Winner\",\"redirect_url\":\"https://open.spotify.com/track/6PwxotrB99xgatKVzibmkz\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8567ca5b7fb5bebfd00d811ae2a26f2a79518a5a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sorry You're Not a Winner\"},{\"type\":\"apple_music\",\"title\":\"Enter Shikari - satellites* *\",\"redirect_url\":\"https://music.apple.com/gb/album/satellites/1496648817?i=1496649756&