a89782?dice_id=Oa17fca89782\",\"post_reminder_referral\":\"https://link.dice.fm/I2e43436d031?dice_id=I2e43436d031\",\"post_waitinglist_referral\":\"https://link.dice.fm/X51b1af4df85?dice_id=X51b1af4df85\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"dk6kqo-le-mystre-des-voix-bulgares-live-in-london-22nd-apr-union-chapel-london-tickets\",\"unicorn\":false,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776879000,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:77\",\"price\":{\"currency\":\"GBP\",\"amount\":4134,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-01/0bb1c17e-ab2c-4da1-89f4-c41f7b4e1313.jpg?rect=0%2C436%2C5504%2C5504\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-01/0bb1c17e-ab2c-4da1-89f4-c41f7b4e1313.jpg?rect=0%2C2477%2C5504%2C3302\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-01/0bb1c17e-ab2c-4da1-89f4-c41f7b4e1313.jpg?rect=482%2C0%2C4541%2C8256\"},\"id\":\"68b5a6fd3b524100019f5ab2\",\"name\":\"Le Mystère des Voix Bulgares live in London!\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"**Gotobeat is excited to team up with Union Chapel in London to welcome Le Mystère des Voix Bulgares with their a cappella show live on Wednesday, April 22nd!**\\n\\n—> Le Mystère des Voix Bulgares\\n\\nThe Mystery of the Bulgarian Voices (Le Mystere des Voix Bulgares) Female Vocal Choir known in the past as The Bulgarian State Television Female Vocal Choir is an ensemble of rare artistic gift and enormous popular appeal. Created in the early 1950’s the choir’s first mission was to record authentic and arranged for multiple voices choral folk songs to be recorded and broadcast first on the radio and later on TV.\\n\\nThe Swiss music producer Marcel Cellier discovered the beauty of the Bulgarian folk songs, folk singers, their unique voices and choral skills and in 1975 released his first album with songs performed by the choir – Volume I, which he called “Le Mystere des Voix Bulgares” (The Mystery of the Bulgarian Voices). The album soon became a best seller. In 1987 he released Volume II which in 1990 was awarded a Grammy Award for Best Traditional Folk Recording. It was at that time that the choir adopted the name \\\"Le Mystere des Voix Bulgares\\\". Since then, the choir has performed more than 1,500 concerts outside Bulgaria in some of the most prestigious venues in the world. Choir members have also worked with artists as diverse as Kate Bush and U2, the songs of the choir have been sampled and remixed by Drake, DJ Tiesto, FKA Twigs, Bring Me The Horizon and many others.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-01T17:00:00+01:00\",\"sale_end_date\":\"2026-04-22T17:30:00+01:00\",\"sale_start_date\":\"2025-09-01T17:00:00+01:00\",\"event_start_date\":\"2026-04-22T18:30:00+01:00\",\"event_end_date\":\"2026-04-22T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dry Cleaning\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-05/f3ad1fe0-4afa-4a56-b5b6-47adf88ddd19.jpg?rect=0%2C0%2C854%2C854\"},\"artist_id\":\"10163\",\"about\":{\"description\":\"Secret Love is the finest expression yet of the profound friendships that created Dry Cleaning. Here, frontperson Florence Shaw, guitarist Tom Dowse, drummer Nick Buxton and bassist Lewis Maynard take their place in rock’s avant garde, catalysing the Reaganite paranoia of early 80s US punk and hardcore with the dry strut of Keith Richards, stoner rock, dystopian degradation, playful no wave and pastoral fingerpicking, while Florence’s delivery, meticulously calibrated to her bandmates’ soundscapes, asserts her in a lineage of spoken-word artists stretching from Laurie Anderson to Life Without Buildings’ Sue Tompkins. Producer Cate Le Bon likens the impression of listening to walking through a city; these 11 songs might also arrive like distinct images in a gallery.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bad Vibrations.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":23938,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth: 15cm\",\"order\":0},{\"id\":74605,\"title\":\"How do tickets work for O2 Academy Brixton? \",\"body\":\"Tickets will be in the O2 Academy Venues app as they’re handling ticket scanning for this event. We will email you when your tickets are available in the app.\\n\\nHow to use your tickets:\\n\\n1\\\\. Get the O2 Academy Venues app: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\\n\\n2\\\\. Sign up using the email you used to purchase your tickets on DICE\\n\\n3\\\\. At the door, show your tickets on the O2 Academy Venues app (not DICE)\",\"order\":1},{\"id\":74606,\"title\":\"How do I download the O2 Academy Venues app?\",\"body\":\"The O2 Academy Venues app is available to download for iOS and Android: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\",\"order\":2},{\"id\":74607,\"title\":\"How do I find my ticket?\",\"body\":\"Your ticket is stored on the “Tickets” section of the O2 Academy Venues app. Simply select where you booked your tickets and log in using the email address you purchased your tickets with.\",\"order\":3},{\"id\":74608,\"title\":\"Can I change my seat?\",\"body\":\"Seats can’t be changed after booking, so please review your selection carefully before checkout.\",\"order\":4},{\"id\":74609,\"title\":\"Do I need to transfer tickets to the rest of my group?\",\"body\":\"Yes, access to the venue requires all members of your group to have their own ticket, so make sure you transfer these in the O2 Academy Venues app before arriving at the venue. Ticket transfer will not be available for this event on DICE.\",\"order\":5},{\"id\":74610,\"title\":\"I can’t make it anymore, can I sell my ticket? \",\"body\":\"DICE Wait list returns are not available for this venue. You must use the O2 Academy Venues app to securely resell your tickets to another fan.\",\"order\":6},{\"id\":74611,\"title\":\"How to book accessible tickets for O2 Academy Brixton\",\"body\":\"More info on accessibility here: https://www.academymusicgroup.com/o2academybrixton/accessibility\",\"order\":7},{\"id\":74612,\"title\":\"How do I travel to the venue?\",\"body\":\"The venue is easily accessible by public transport. There are no parking facilities. Check all local transport routes for the latest information, services and timetables.\\n\\nLocation information and all accessible travel options can be found here: https://www.academymusicgroup.com/o2academybrixton/getting-here\\n\\nPlan ahead and always know how you're going to get home.\",\"order\":8}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"650\",\"name\":\"O2 Academy Brixton\",\"address\":\"211 Stockwell Road, London SW9 9SL\",\"location\":{\"lat\":51.4653454,\"lng\":-0.115164400000026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\