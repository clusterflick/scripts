e_type\":\"live_only\",\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"ryap8w-sam-gellaitry-5th-mar-islington-assembly-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":8,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:25\",\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"KTmelodies\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-16/363bd633-8de8-4e45-9ae7-728afc6ac2e2.jpg?rect=0%2C55%2C531%2C531\"},\"artist_id\":\"134130\",\"about\":null,\"is_headliner\":false},{\"name\":\"Sam Gellaitry\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd2f8772a9e15c792f29dd701\"},\"artist_id\":\"1074\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"Scottish producer, DJ, singer, and songwriter Sam Gellaitry creates vivid, genre-blurring music shaped by synesthesia—translating sound into color and emotion. Born and raised in Stirling, Scotland, far from traditional electronic hubs, he first gained a cult following on SoundCloud through early EPs like Escapism and IV. After a string of celebrated releases, Sam stepped into new creative territory by incorporating his own vocals and visuals into his work. His 2021 single “Assumptions” exploded across social media this year, soundtracking over half a million short-form videos and earning organic support from brands like LOEWE and celebrities like Megan Thee Stallion, Kate Hudson, and Alix Earle. Hailed as a contender for “2025 Song of the Summer,” the track topped global charts across Spotify and Apple Music and peaked at #2 on both Shazam and TikTok’s Viral Top 50 lists. Now, after years of sonic experimentation and cult collaborations with artists like PinkPantheress and Kaytranada, Sam has just released his highly anticipated debut album 'ANYWHERE HERE IS PERFECT' — a technicolour culmination of his evolution as an artist that shot into the Top 10 on Spotify’s U.S. Debut Albums chart, underscoring the momentum behind his most ambitious work yet.\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T16:00:00+00:00\",\"sale_end_date\":\"2026-03-05T21:00:00+00:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69288d60fe67da0001e06918\",\"name\":\"Sam Gellaitry\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/635320a9-08ba-4a6a-ba22-824d83f31eac.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/635320a9-08ba-4a6a-ba22-824d83f31eac.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/635320a9-08ba-4a6a-ba22-824d83f31eac.jpg?rect=180%2C0%2C440%2C800\"},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764604800,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/u11ddc664b8e?dice_id=u11ddc664b8e\",\"post_competition_referral\":\"https://link.dice.fm/N8f0c3d8f822?dice_id=N8f0c3d8f822\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R987136c883f?dice_id=R987136c883f\",\"post_purchase_referral\":\"https://link.dice.fm/r540706ef3f9?dice_id=r540706ef3f9\",\"post_reminder_referral\":\"https://link.dice.fm/X8153d5ea623?dice_id=X8153d5ea623\",\"post_waitinglist_referral\":\"https://link.dice.fm/Rb222b5d9ec2?dice_id=Rb222b5d9ec2\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Duo\",\"redirect_url\":\"https://open.spotify.com/track/0KbMjhlUH1xUGDgeIQzLsn\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3298fc5f4529a3048f3d960b9a1926297d0c8858?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Duo\"},{\"type\":\"apple_music\",\"title\":\"Sam Gellaitry - Assumptions\",\"redirect_url\":\"https://music.apple.com/us/album/assumptions/1564477370?i=1564477677&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sam Gellaitry\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/b6/15/66/b6156632-e5dd-b23f-a287-e068502ef71f/mzaf_5447079403069676960.plus.aac.p.m4a\",\"track_name\":\"Assumptions\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/mheUS1kAqEm8e9aZlD01FhEXQgBzZsKBIgsnwPiJKfMk.m3u8\",\"track_name\":\"\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3030},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Metropolis Music.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"v3bk2d-plk-5th-mar-here-at-outernet-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:26\",\"venues\":[{\"id\":\"6559\",\"name\":\"HERE at Outernet\",\"address\":\"Denmark St, Charing Cross Rd, London WC2H 8LH, UK\",\"location\":{\"lat\":51.5152089,\"lng\":-0.1295818},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-23/44412f0d-34b8-41b5-8483-6f9558894d40.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"here-at-outernet-wgbx\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/24679933108753-HERE-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":\"2026-03-05T23:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"PLK\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb824921673ea4e4abd68f5850\"},\"artist_id\":\"12905\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"about\":{\"description\":\"*\\\\*For accessibility information please see the accessibility information button/link below*\\n\\nPLK, which stands for ‘POLAK’ (referring to his Polish origins), is a rapper in his twenties, born to a Polish father and a Corsican mother, who grew up in the Cité de l'Heure housing project in Paris's 14th arrondissement.\\n\\nAt just 12 years old, he posted his first freestyles online. Two years later, he made his first. appearance on Skyrock's Planète Rap programme, and at 17 he was already performing at the Bataclan with his group Paname Bende.\\n\\nAt the same time, PLK threw away his schoolbag and started working at a Mercedes garage at a very young age to finance his projects.\\n\\nIn 2017, he launched his solo career and quickly established himself as one of the leading rappers on the French scene. From gold to diamond, PLK has certified all his projects and accumulated more than 480,000 sales with his latest album ‘ENNA’ (2020) and his EP ‘2069’ (April 2023), which recently went platinum.\\n\\nTo date, PLK has sold over 1.4 million albums, racked up 4 billion streams and enjoyed a continuous presence in the singles charts and on the radio for eight years.\\n\\nIn early 2024, the rapper returned with his mixtape ‘Chambre 140’, released in three parts and featuring highly anticipated collaborations (JUL, Tif, Hamza, Gazo, etc.). Reaching number one in the album charts and going gold upon release (now platinum), PLK instantly became the most listened-to French artist on streaming platforms (all music genres combined).\\n\\nAfter a sold-out European and French tour in 2024 (over 200k tickets sold), PLK made his comeback in September 2025, announcing two Stade de France shows for 2026 (sold out in less than two hours).\\n\\nFollowing this major announcement, he will be touring France and Europe in autumn 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ (14 – 16s with an adult) event - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T12:00:00+00:00\",\"sale_end_date\":\"2026-03-05T21:00:00+00:00\",\"sale_start_date\":\"2025-10-30T11:00:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6900b31c9367260001e0e96f\",\"name\":\"PLK\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/c93c5e4e-a57d-4663-b241-86506344d9a5.jpg?rect=1278%2C0%2C5120%2C5120\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/c93c5e4e-a57d-4663-b241-86506344d9a5.jpg?rect=0%2C257%2C7676%2C4606\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/c93c5e4e-a57d-4663-b241-86506344d9a5.jpg?rect=2430%2C0%2C2816%2C5120\"},\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1761566400,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/tf58265cfcbd?dice_id=tf58265cfcbd\",\"post_competition_referral\":\"https://link.dice.fm/S64262858da9?dice_id=S64262858da9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F9af3cea2ba9?dice_id=F9af3cea2ba9\",\"post_purchase_referral\":\"https://link.dice.fm/A79bd9344be9?dice_id=A79bd9344be9\",\"post_reminder_referral\":\"https://link.dice.fm/R9957bc218a7?dice_id=R9957bc218a7\",\"post_waitinglist_referral\":\"https://link.dice.fm/K88c0c461fb1?dice_id=K88c0c461fb1\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Petrouchka (feat. PLK)\",\"redirect_url\":\"https://open.spotify.com/track/03y045SZqaC94yfXl1cU4E\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/10cee549e2d96c62d526d849118355adc8bbc067?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Petrouchka (feat. PLK)\"},{\"type\":\"apple_music\",\"title\":\"PLK - Monégasque\",\"redirect_url\":\"https://itunes.apple.com/gb/album/mon%C3%A9gasque/1450493727?i=1450494134&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"PLK\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview124/v4/b5/df/f7/b5dff7e5-1430-d30c-a938-9ffd04b70ea0/mzaf_7195368694071625595.plus.aac.p.m4a\",\"track_name\":\"Monégasque\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":800},\"seats_io_public_key\":null,\"presented_by\":\"Presented by LVLS London & The Engine Rooms.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"14743\",\"name\":\"LVLS London & The Engine Rooms\",\"image\":{\"url\":null},\"perm_name\":\"lvls-london--the-engine-rooms-3oonv\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"avpd7q-folky-thursdays-5th-mar-lvls-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:27\",\"venues\":[{\"id\":\"14077\",\"name\":\"LVLS\",\"address\":\"3 Succession Walk, Tower Hamlets, London, E3 2RX, United Kingdom\",\"location\":{\"lat\":51.54048,\"lng\":-0.02084},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-21/ad72e6a5-12a2-4237-a9ca-943cef71211f.jpg?rect=0%2C0%2C192%2C192\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"lvls-g5oe6\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":\"2026-03-05T22:30:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":5},\"about\":{\"description\":\"Join us at LVLS in Hackney Wick for Folky Thursdays, a curated night of live indie, folk, alt-pop and pop rock featuring some of the most exciting emerging female artists in London.\\n\\nOpening the night is **Amberleef**, an independent R&B artist inspired by The Weeknd, Mahalia, Jhené Aiko and H.E.R. The Northamptonshire-born singer brings smooth vocals, emotional honesty and modern R&B energy to the stage.\\n\\nMain support **Felicity Henry** is a singer-songwriter, producer and multi-instrumentalist whose sound draws comparisons to Clairo, Billie Marten and Faye Webster. Writing on queer love and heartbreak, she pairs intricate musicianship with vulnerable storytelling. A Guildhall-trained clarinettist and Oxford music graduate, Felicity also runs the female-led Bluebell Studios.\\n\\nHeadlining is **Luna J**, the Scottish pop rock force now based in London. With gritty rock energy and anthemic hooks inspired by Paramore, Avril Lavigne and Dominic Fike, Luna J is fast becoming one to watch. Her BBC Introducing-featured track “Addiction” and growing industry attention signal a bold new era of female empowerment.\\n\\n***Get your tickets now to support the local scene!***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T18:00:00+00:00\",\"sale_end_date\":\"2026-03-05T19:00:00+00:00\",\"sale_start_date\":\"2026-02-14T18:30:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6990a7183a8ebd0001082023\",\"name\":\"Folky Thursdays\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/a49ce83e-6dbf-4018-b412-55fc59f3fa0b.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/a49ce83e-6dbf-4018-b412-55fc59f3fa0b.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/a49ce83e-6dbf-4018-b412-55fc59f3fa0b.jpg?rect=270%2C0%2C660%2C1200\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771092000,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/i09991f34c7a?dice_id=i09991f34c7a\",\"post_competition_referral\":\"https://link.dice.fm/p7dd5107db3e?dice_id=p7dd5107db3e\",\"post_purchase_extras_a