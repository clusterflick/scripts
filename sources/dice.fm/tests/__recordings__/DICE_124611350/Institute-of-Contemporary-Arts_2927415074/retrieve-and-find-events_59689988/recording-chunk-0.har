],\"impression_id\":\"e044e34315b96a4b:72\",\"properties\":[],\"presented_by\":\"Kili Presents x Merched Yn Gwnued\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769162400,\"id\":\"69723f1eb1b168000108668f\",\"name\":\"Aura Sessions / Sesiynau Aura\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Kilimanjaro Live and Women Make Music are proud to present Aura Sessions — an evening of networking, empowerment, and live music that will celebrate the contribution of women and non-binary people in the music industry. Between International Women's Day and St David's Day, join us for a networking session that will bring together industry professionals and new talent, followed by performances showcasing 3 exciting artists who are making their mark on the Welsh music scene and beyond. Proceeds from ticket sales will go to assist with fair payment of performers and to support future MYGM projects.\\n\\nDoors and a networking session from 6pm with a DJ set by special guests and live music from 7pm.\\n\\nLineup:\\n\\nMartha Elen – https://www.instagram.com/martha.elen/\\n\\nGreta Isaac – https://www.instagram.com/gretaisaac/\\n\\nHMS Morris – https://www.instagram.com/hmsmorris/\\n\\nEstablished in 2018, Merched yn Gwneud Miwsig is an innovative partnership project between Maes B and Clwb Ifor Bach, with the aim of providing opportunities for women and non-binary individuals to gain experience in the Welsh music scene. Having started as a simple series of workshops across Wales, the project has evolved and developed, to become one of Wales' leading music schemes. The aim of the project is to promote visibility and opportunities for women in music in Wales through education, support, empowerment and recognition\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"date_unix\":1772647200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":770,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T00:00:00+00:00\",\"sale_end_date\":\"2026-03-04T17:00:00+00:00\",\"sale_start_date\":\"2026-01-19T00:00:00+00:00\",\"event_start_date\":\"2026-03-04T18:00:00+00:00\",\"event_end_date\":\"2026-03-04T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6dnxnb-thursday-night-shift-4th-mar-new-cross-inn-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ride Ride Ride\",\"redirect_url\":\"https://open.spotify.com/track/0xPPJHheLuwUkquvNuaKG0\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/39cead7e514d61883c9dfcb657882c5e36e6e1b4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ride Ride Ride\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Disco Lizards\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-15/35a90543-7f31-4a3d-8226-f2aed5417679.jpg?rect=980%2C0%2C2520%2C2520\"},\"artist_id\":\"18394\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"l