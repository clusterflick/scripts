//p.scdn.co/mp3-preview/29a0dd6febfac9310051074de46eefbb7a6f5cbd?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Self Esteem\"},{\"type\":\"apple_music\",\"title\":\"The Offspring - Self Esteem\",\"redirect_url\":\"https://music.apple.com/us/album/self-esteem/1485043082?i=1485043450&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Offspring\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/bf/a6/bc/bfa6bc10-e984-ce3f-a3ab-14e51de04ec3/mzaf_9912363009195692327.plus.aac.p.m4a\",\"track_name\":\"Self Esteem\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-20T11:00:00+00:00\",\"sale_end_date\":\"2026-05-24T18:30:00+01:00\",\"sale_start_date\":\"2025-11-20T11:00:00+00:00\",\"event_start_date\":\"2026-05-24T18:45:00+01:00\",\"event_end_date\":\"2026-05-24T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Portals.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/O641912b98a4?dice_id=O641912b98a4\",\"post_competition_referral\":\"https://link.dice.fm/R7cc0ee04af6?dice_id=R7cc0ee04af6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l5b86f5fa973?dice_id=l5b86f5fa973\",\"post_purchase_referral\":\"https://link.dice.fm/R4e6148fbbfb?dice_id=R4e6148fbbfb\",\"post_reminder_referral\":\"https://link.dice.fm/Af9b0e5f3f3d?dice_id=Af9b0e5f3f3d\",\"post_waitinglist_referral\":\"https://link.dice.fm/v71e9d6b0dfc?dice_id=v71e9d6b0dfc\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Portals Presents: BRUIT ≤ at Olso, Hackney. In just a few years, the French experimental / post-rock band has established itself as a key figure on the French post-rock scene, a style the band has absorbed and reshaped through its relentless innovation.\\n\\nAfter a standout session at Seattle’s KEXP studios, the French quartet unveiled The Age of Ephemerality in 2025, released via Pelagic Records — an album they will defend on stage in London this May.\\n\\nFor fans of Godspeed You! Black Emperor, Hans Zimmer, MONO.\\n\\n\\\"The Age of Ephemerality is a transportative experience throughout and although it may be discomforting, the journey is one worth taking multiple times.\\\" (Noizze)\\n\\n\\\"BRUIT ≤ remain as steadfast and pragmatic when it comes to their socio-politically informed post-rock. The Age Of Ephemerality is horror conveyed through great beauty. (Everything is Noise)\\n\\n\\\"The Age of Ephemerality is crystal clear, produced and performed beautifully, yet its an extremely raw album at its heart, an outpouring of emotion and rage.\\\" (The Progressive Subway)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":762,\"name\":\"Portals\",\"privacy_policy_link\":\"http://portalsrock.com/terms.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779644700,\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"count