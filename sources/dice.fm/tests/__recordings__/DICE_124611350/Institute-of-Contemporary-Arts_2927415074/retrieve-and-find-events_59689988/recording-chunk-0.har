le\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:7\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"id\":\"696f7f24dcc71700014730ab\",\"name\":\"Blossom Caldarone\",\"perm_name\":\"6dnwwb-blossom-caldarone-21st-may-theatreship-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/51c68ce2-ec8c-41ce-ba5c-eb4a617de4e6.jpg?rect=0%2C1295%2C3508%2C3508\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/51c68ce2-ec8c-41ce-ba5c-eb4a617de4e6.jpg?rect=0%2C1428%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/51c68ce2-ec8c-41ce-ba5c-eb4a617de4e6.jpg?rect=390%2C0%2C2729%2C4961\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Blossom Caldarone\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/2519e764a250e18a136975e9b9d1d679728a6162\"},\"artist_id\":\"4495\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1768996800,\"faqs\":[{\"id\":70357,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":1700,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Blossom Caldarone - 1964\",\"redirect_url\":\"https://open.spotify.com/track/6NfKaTgPrh4zi24lRyWdbw\",\"artist\":\"Blossom Caldarone\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5c88afbb1f12887f47ae0361232a6ddcf782b29c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"1964\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:00:00+00:00\",\"sale_end_date\":\"2026-05-21T15:00:00+01:00\",\"sale_start_date\":\"2026-01-21T12:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP FAMILY & FOOTSTEPS FESTIVAL.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/T8841846c004?dice_id=T8841846c004\",\"post_competition_referral\":\"https://link.dice.fm/lc2d462dee58?dice_id=lc2d462dee58\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W44d889cd32c?dice_id=W44d889cd32c\",\"post_purchase_referral\":\"https://link.dice.fm/Lc086dc891e5?dice_id=Lc086dc891e5\",\"post_reminder_referral\":\"https://link.dice.fm/Ldc113036740?dice_id=Ldc113036740\",\"post_waitinglist_referral\":\"https://link.dice.fm/G09f4a0e0381?dice_id=G09f4a0e0381\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"DHP & FOOTSTEPS FESTIVAL Presents:\\n\\nRATBOYS\",\"highlights\":[{\"type\":\"