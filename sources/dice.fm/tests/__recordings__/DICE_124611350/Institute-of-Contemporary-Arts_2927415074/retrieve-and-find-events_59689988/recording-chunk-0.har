rral\":\"https://link.dice.fm/q8be2824cedd?dice_id=q8be2824cedd\",\"post_reminder_referral\":\"https://link.dice.fm/m529be3aa018?dice_id=m529be3aa018\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y3c15ff4a85c?dice_id=Y3c15ff4a85c\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Lone Assembly are a Swiss quartet blending new wave, romantic synthpop and dark, melancholic post-punk. Formed by Raphaël Bressler (vocals, keyboards), Glenn Le Meur (guitar), Jim Bodeman (bass) and Romain Segu (drums), the band broke through in 2024 with their debut EP That Never Happened — a release rooted in themes of grief, emotional distance and vulnerability, pairing ’80s cold-wave textures with sharp modern production.\\n\\nRo Nova is a London-based electropop artist and producer blending ’80s synth textures with ethereal vocals to create a sound that feels both nostalgic and forward-looking. Since the release of her debut single “do you think it’s fine?”, she has received support from BBC Radio 1, BBC London and Reprezent Radio, alongside tastemakers including Harriet Rose (KISS FM) and James Threlfall (BBC Introducing).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twi