multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/520b3f7b-098a-45ea-a15b-5effb2664bfe.jpg?rect=56%2C0%2C864%2C864\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/520b3f7b-098a-45ea-a15b-5effb2664bfe.jpg?rect=0%2C139%2C976%2C586\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/520b3f7b-098a-45ea-a15b-5effb2664bfe.jpg?rect=251%2C0%2C475%2C864\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Silvana Estrada - Más O Menos Antes\",\"redirect_url\":\"https://music.apple.com/us/album/m%C3%A1s-o-menos-antes/1640345256?i=1640345257&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Silvana Estrada\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/d7/20/56/d7205632-b389-6bdc-3630-abb9bd8a4d90/mzaf_17440220330161537709.plus.aac.p.m4a\",\"track_name\":\"Más O Menos Antes\"},{\"type\":\"spotify\",\"title\":\"Silvana Estrada - Mas O Menos Antes\",\"redirect_url\":\"https://open.spotify.com/track/1NttZF0RMI3NnWRVIcM81u\",\"artist\":\"Silvana Estrada\",\"preview_url\":\"https://p.scdn.co/mp3-preview/04c16c9144dc4b1cfee6bf05a127e3e35a8aa9b6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Mas O Menos Antes\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1763467200,\"max_tickets\":6,\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"This year’s La Linea Festival proudly presents Mexican singer-songwriter Silvana Estrada, winner of the 2022 Latin Grammy for Best New Artist. She returns to London for a special performance at Union Chapel on Wednesday 29 April.\\n\\nOne of the most compelling new voices in Latin music, Estrada has captivated audiences worldwide with her emotionally charged songwriting and the distinctive sound of the cuatro venezolano. Her music blends the folk traditions of her native Veracruz with contemporary influences, creating songs that feel both timeless and fiercely personal.\\n\\nFollowing her sold-out show at EartH Theatre in 2023, she comes back to London with her widely acclaimed new album Vendrán Suaves Lluvias – hailed by Rolling Stone as “her most powerful album yet.” With her spellbinding vocals and poetic lyricism, this promises to be one of the standout performances of this year’s festival.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by La Linea Festival and Bird On The Wire\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:55\",\"social_links\":{\"event_share\":\"https://link.dice.fm/c7a9d90bf0b1?dice_id=c7a9d90bf0b1\",\"post_competition_referral\":\"https://link.dice.fm/Dcef898c15ac?dice_id=Dcef898c15ac\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/xe5bd6784ded?dice_id=xe5bd6784ded\",\"post_purchase_referral\":\"https://link.dice.fm/yfb31a52c943?dice_id=yfb31a52c943\",\"post_reminder_referral\":\"https://link.dice.fm/G3eb700966ea?dice_id=G3eb700966ea\",\"post_waitinglist_referral\":\"https://link.dice.fm/fb55a43fd97e?dice_id=fb55a43fd97e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-1