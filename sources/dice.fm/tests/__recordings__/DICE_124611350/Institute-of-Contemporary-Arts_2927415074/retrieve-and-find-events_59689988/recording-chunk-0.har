us\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773689400,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:19\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/1a2dddb9-bd15-4515-b6fd-4fcf7973289e.jpg?rect=473%2C244%2C833%2C833\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/1a2dddb9-bd15-4515-b6fd-4fcf7973289e.jpg?rect=0%2C224%2C1720%2C1032\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/1a2dddb9-bd15-4515-b6fd-4fcf7973289e.jpg?rect=453%2C0%2C814%2C1480\"},\"id\":\"698d8dd2a88dfa0001ecf2cf\",\"name\":\"I KNOW CATHERINE, THE LOG LADY \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Step into the world of Twin Peaks through the eyes of its most enigmatic and beloved character as we presented the new documentary I Know Catherine, The Log Lady. Directed by Richard Green (who you will recognize from his mesmerizing role in Mulholland Drive), this intimate documentary paints a vivid portrait of Catherine E. Coulson, the actress who brought Margaret Lanterman—the Log Lady—to life. More than a behind-the-scenes look, the film delves into Coulson’s rich theatrical career, her deep friendships, and her unwavering dedication to her craft, even in her final days.\\n\\nFeaturing interviews with David Lynch, Kyle MacLachlan, Mark Frost, Jack Nance, Ray Wise, Frederick Elmes and Jenny Sullivan, the documentary offers a rare glimpse into Coulson’s personal and professional journey. It showcases her enduring legacy in the world of television and theater, highlighting her warmth, generosity, and the profound impact she had on those around her.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T00:00:00+00:00\",\"sale_end_date\":\"2026-03-16T19:15:00+00:00\",\"sale_start_date\":\"2026-02-11T00:00:00+00:00\",\"event_start_date\":\"2026-03-16T19:30:00+00:00\",\"event_end_date\":\"2026-03-16T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Mon 16 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Deeper Into Movies.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T14:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"anno