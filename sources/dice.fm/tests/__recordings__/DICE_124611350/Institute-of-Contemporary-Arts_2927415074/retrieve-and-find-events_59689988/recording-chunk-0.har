15a92689c?dice_id=V7c15a92689c\",\"post_reminder_referral\":\"https://link.dice.fm/E89c2242a7fa?dice_id=E89c2242a7fa\",\"post_waitinglist_referral\":\"https://link.dice.fm/N95fd1f00a62?dice_id=N95fd1f00a62\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:88\",\"properties\":[],\"presented_by\":\"Presented by LVLS London & The Engine Rooms.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771243200,\"id\":\"69934f31c152b20001074b70\",\"name\":\"F*** The Patriarchy \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"This International Women’s Day, Engine Rooms hosts a loud, unapologetic alternative rock showcase celebrating women and femme voices in the underground scene. Expect raw energy, sharp guitars and zero tolerance for mediocrity.\\n\\n**Eliza Pix** brings her signature “dramatic rock ambient music” – cinematic textures, brooding atmosphere and emotionally charged vocals that cut straight through.\\n\\n**The Here And Now** channel 90s alt-rock and post-punk grit with head-bopping guitar grooves, powerful vocal melodies and thoughtful lyricism. Praised by Right Chord Music for delivering a distinctly British post-punk punch, the London four-piece thrive on stage with high-impact live energy.\\n\\n**Fallen Friday**, a South East London rock trio, round out the bill with driving riffs, tight rhythm sections and no-nonsense rock attitude.\\n\\n*This is not a headliner show*. It’s a curated showcase spotlighting emerging artists pushing against the system and carving space in London’s alternative music scene.\\n\\n*If you’re into alternative rock, post-punk, 90s revival sounds and discovering new independent artists in intimate underground venues, this one’s for you.*\\n\\nCelebrate International Women’s Day the loud way.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14743\",\"name\":\"LVLS London & The Engine Rooms\",\"image\":{\"url\":null},\"perm_name\":\"lvls-london--the-engine-rooms-3oonv\",\"profile_active\":true},\"date_unix\":1772996400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-08T21:30:00+00:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-03-08T19:00:00+00:00\",\"event_end_date\":\"2026-03-08T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"k69pmp-ilhan-ersahins-istanbul-sessions-8th-mar-hootananny-brixton-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Nayino\",\"redirect_url\":\"https://open.spotify.com/track/7zHByb8LiWNOR6bcV4FGgm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d4107c8ff2765ec553ce8d6a1a73f70e11300144?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Nayino\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ilhan Ersahin\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0f30bc04b7bc869022810742\"},\"artist_id\":\"4547\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"6109\",\"name\":\"Hootananny Brixton\",\"address\":\"95 Effra Rd, London SW2 1DF, UK\",\"location\":{\"lat\":51.4553934,\"lng\":-0.113205