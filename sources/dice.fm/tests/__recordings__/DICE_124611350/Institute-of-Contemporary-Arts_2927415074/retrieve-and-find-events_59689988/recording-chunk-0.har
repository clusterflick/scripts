/X7d29d822305?dice_id=X7d29d822305\",\"post_purchase_referral\":\"https://link.dice.fm/M0e0fd06ed53?dice_id=M0e0fd06ed53\",\"post_reminder_referral\":\"https://link.dice.fm/cb3a439608ea?dice_id=cb3a439608ea\",\"post_waitinglist_referral\":\"https://link.dice.fm/h5a363fb2ef5?dice_id=h5a363fb2ef5\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1184,\"name\":\"Crosstown Concerts\",\"privacy_policy_link\":\"https://www.crosstownconcerts.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:46\",\"properties\":[],\"presented_by\":\"Presented by Crosstown Concerts.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769594400,\"id\":\"6973403a20b93700011b8bf6\",\"name\":\"The Blow Monkeys\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Crosstown Concerts Presents...\\n\\nThe Blow Monkeys\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (U16s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"29\",\"name\":\"Crosstown Concerts\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-01/f0198251-f9b4-4348-9ac3-5dbcf7739d2b.jpg\"},\"perm_name\":\"crosstown-concerts-zg5p\",\"profile_active\":true},\"date_unix\":1792173600,\"event_tag\":null}],\"title\":\"Fri 16 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T00:00:00+00:00\",\"sale_end_date\":\"2026-10-17T14:00:00+01:00\",\"sale_start_date\":\"2026-01-12T00:00:00+00:00\",\"event_start_date\":\"2026-10-17T13:00:00+01:00\",\"event_end_date\":\"2026-10-17T17:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8benb-stray-ft-del-bromham-17th-oct-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"STRAY\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-30/ad9e4a47-47e9-45b0-b4fa-237fed142cf6.jpg?rect=0%2C0%2C1080%2C1080\"},\"artist_id\":\"107008\",\"about\":{\"description\":\"Stray are an English hard rock band formed in West London, in 1966. Stray released their self-titled debut album in 1970. The band mix scintillating guitar playing in a twin guitar format with original member Del Bromham and Pete Dyer firmly back in the fold. Powerhouse drummer Karl Randall has occupied the position longer than any other. The addition of Pearl Handled Revolver's Simon Rinaldo on keys and Colin Kempster on bass drives the melodic anthemic songs such as All in Your Mind, covered by the multi-million selling Iron Maiden with whom Stray have toured Europe. Indeed, their tours with Rush and Kiss earned them a truly international reputation.\\n\\nTheir career retrospective on six CDs with Esoteric Records, was voted into the top 25 of the Best Album re-releases of 2021. Another compilation of their singles released worldwide was re-issued later in the year. Del Bromham also has his autobiography published titled Rock and Roll Survivor (Wymer Publishing) which has received great critical acclaim.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-17T13:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-08-29/612cc940-f6eb-4220-a2a7-63cc8005f741.jpg?rect=73%2C0%2C935%2C935\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-08-29/612cc940-f6eb-4220-a2a7-63cc8005f741.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-08-29/612cc940-f6eb-4220-a2a7-63cc8005f741.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/n67be905f1d1?dice_id=n67be905f1d1\",\"post_competition_referral\":\"https://link.dice.fm/k5b1f708f343?dice_id=k5b1f708f343\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d06caab48d74?dice_id=d06caab48d74\",\"post_purchase_referral\":\"https://link.dice.fm/Bde1cceba9fc?dice_id=Bde1cceba9fc\",\"post_reminder_referral\":\"https://link.dice.fm/q211