le_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-23/6fe799fc-3e24-4376-b456-9b667c3dc5f4.jpg?rect=0%2C35%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-23/6fe799fc-3e24-4376-b456-9b667c3dc5f4.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-23/6fe799fc-3e24-4376-b456-9b667c3dc5f4.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"sold-out\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/H229f55c8e57?dice_id=H229f55c8e57\",\"post_competition_referral\":\"https://link.dice.fm/j3fdc736e733?dice_id=j3fdc736e733\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W9c95eaf8ada?dice_id=W9c95eaf8ada\",\"post_purchase_referral\":\"https://link.dice.fm/c6f743ac65e4?dice_id=c6f743ac65e4\",\"post_reminder_referral\":\"https://link.dice.fm/z003a81ca82a?dice_id=z003a81ca82a\",\"post_waitinglist_referral\":\"https://link.dice.fm/J11520dba9f5?dice_id=J11520dba9f5\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:38\",\"properties\":[],\"presented_by\":\"Presented by spit nights.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763903700,\"id\":\"6923085b278cfa0001c52f08\",\"name\":\"Harry Baker Book Launch Party\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Show starts 7.45pm**\\n\\nTo celebrate the release of his new book *'Tender'* we're teaming up for a SpitNights x Harry Baker celebration\\n\\nft heartwarming poems & sweet treats\\n\\n**Harry Baker**\\n\\nWorld Poetry Slam Champion Harry Baker brings his characteristic warmth, wit and wonder to new parenthood. *Tender* contains poems from the first hundred days of new life and celebrates all of the euphoria, panic and vulnerability that come with it. Expect more laughter and tears than ever.\\n\\n“Harry Baker’s intricate, quick-fire rhymes have always been on the impressive side of mind-blowing” - The Scotsman\\n\\n“Simply put... The greatest performer on earth” \\\\*\\\\*\\\\*\\\\*\\\\* (BBC Radio 1)\\n\\n\\\\---------------------------\\n\\nno tickets on the door\\n\\nseated\\n\\ninsta / tiktok: @spitnights\\n\\n- DJs from 7pm and 10:30-late\\n- Bar open all day - pizza from 7pm\\n- Step free access\\n- bring a book for the book swap <3\\n- 18+\\n\\n\\\\---------------\\n\\n**LOW INCOME TICKETS**\\n\\n**we don't want anyone to be priced out of coming to our night so if money is too tight use code COMMUNITY to unlock £5 tickets (DICE adds a fee for waitlist tickets)**\\n\\n**thank you to everyone who buys a PAY IT FORWARD ticket to help us offer cheaper tickets to those who need <3**\\n\\n\\\\-----------\\n\\nHere at spit nights, we are committed to creating a safe and celebratory environment for all of our supporters. By attending spit nights, you agree to adhere to our safety policy.\\n\\nhttps://linktr.ee/spitnights\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14652\",\"name\":\"spitnights\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-31/05d5de5e-b331-45df-b407-2eecf2c7ef4c.jpg\"},\"perm_name\":\"spitnights-k66eo\",\"profile_active\":true},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2600,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-23T11:00:00+00:00\",\"sale_end_date\":\"2026-03-07T19:00:00+00:00\",\"sale_start_date\":\"2025-11-23T11:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\"