t=832%2C0%2C1643%2C1643\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ica-institute-of-contemporary-arts-jvrv\",\"accessibility\":{\"url\":\"https://www.ica.art/visit/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-17T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"灰野敬二\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c3c4462cecebae721fe0ada6b\"},\"artist_id\":\"131520\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/5a7cd416-e9ee-4955-a8a8-e4358421e16b.jpg?rect=0%2C354%2C2667%2C2667\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/5a7cd416-e9ee-4955-a8a8-e4358421e16b.jpg?rect=0%2C1200%2C2667%2C1600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/5a7cd416-e9ee-4955-a8a8-e4358421e16b.jpg?rect=234%2C0%2C2200%2C4000\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1765969200,\"max_tickets\":6,\"marketeers\":[{\"id\":861,\"name\":\"Institute of Contemporary Arts\",\"privacy_policy_link\":\"https://ica.art/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Upset the Rhythm presents KEIJI HAINO at ICA.\\n\\nKEIJI HAINO was born in Chiba, Japan on May 3, 1952. Inspired by Antonin Artaud, he aimed for the theater, but an encounter with The Doors stimulated him into music, where he has examined and absorbed a wide range of expressions from the early blues, especially Blind Lemon Jefferson, or European medieval music to popular songs across the world. In 1970, he joined a group Lost Aaraaf named after Edgar Allan Poe’s poem as a vocalist. Meanwhile, he started to work on home recordings and learned the guitar and percussion autodidactically. In 1978, Haino formed a rock band Fushitsusha, and since 1988, after a recuperation period from 1983 to 1987, he has been internationally active in various forms including solo, groups such as Fushitsusha, Nijiumu, Aihiyo, Vajra, Sanhedrin, Seijaku, Nazoranai or The Hardy Rocks and DJ as “experimental mixture,” as well as in collaboration with artists from different backgrounds, drawing the performance of the guitar, percussion, hurdy gurdy, string instruments, wind instruments, local instruments from across the world and DJ gears to the extreme through idiosyncratic techniques. Haino has released more than 200 recordings and performed live at least 2,000 times.\\n\\nIn March 2026 Japan, Haino will present two exclusive performances in Europe on polygonola, a metal-flat polygonal instrument, based on the 2nd dimensional vibration theory, built by Naoki Sakurai. One fo these performances will take place at the ICA on March 17th.\\n\\nhttps://keijihaino.bandcamp.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Institute of Contemporary Arts.\",\"streaming_options\":null,\"impr