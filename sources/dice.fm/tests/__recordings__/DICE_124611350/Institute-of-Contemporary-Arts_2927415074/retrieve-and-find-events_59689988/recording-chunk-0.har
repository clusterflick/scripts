\":\"https://dice-media.imgix.net/attachments/2026-02-03/146f9cfb-2faa-4d87-aa4c-098e80bcb689.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/146f9cfb-2faa-4d87-aa4c-098e80bcb689.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/146f9cfb-2faa-4d87-aa4c-098e80bcb689.jpg?rect=675%2C0%2C1650%2C3000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/fb33924a604d?dice_id=fb33924a604d\",\"post_competition_referral\":\"https://link.dice.fm/of18e8542652?dice_id=of18e8542652\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ue8f1e3d1963?dice_id=ue8f1e3d1963\",\"post_purchase_referral\":\"https://link.dice.fm/ked5b19f92e5?dice_id=ked5b19f92e5\",\"post_waitinglist_referral\":\"https://link.dice.fm/B9ee741ccf98?dice_id=B9ee741ccf98\",\"post_reminder_referral\":\"https://link.dice.fm/i8e5539304ca?dice_id=i8e5539304ca\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1565\",\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church St, Stoke Newington, London N16 9ES, UK\",\"location\":{\"lat\":51.5613778,\"lng\":-0.0847131000000445},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-church-stoke-newington-x9am\",\"accessibility\":{\"url\":\"https://www.theoldchurch.org.uk/access\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Anna Lowenstein presents her much-anticipated debut album Through the Walls live in London this Spring.\\n\\nOne of the UK’s leading exponents of the klezmer fiddle tradition, Lowenstein draws inspiration from Eastern European Jewish folk melodies while reimagining them through the rich possibilities of the string quartet. Through the Walls is a collection of original compositions that is inventive, deeply joyful, and full of emotional warmth.\\n\\nPerformed with her quartet - Flora Curzon (violin), Meg Hamilton (viola) and Francesca Ter-Berg (cello) - the music recreates what Lowenstein calls the ‘sound world’ of her childhood, where Beethoven, Bartók and Shostakovich sat alongside Yiddish song. The result is a vibrant, expressive performance played with verve and generosity.\\n\\nInterweaving storytelling, ethnographic interviews and field recordings from Stamford Hill, Through the Walls builds an immersive portrait of place and community, alive with voices, memories and character. At once rooted in tradition and boldly forward-looking, the work offers a powerful reminder of music’s ability to carry us across time, memory and imagination.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:29\",\"billing_promoter\":{\"id\":\"3437\",\"name\":\"Earth Cruises\",\"image\":{\"url\":null},\"perm_name\":\"earth-cruises-rvev\",\"profile_active\":true},\"presented_by\":\"Presented by Earth Cruises.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"marketeers\":[{\"id\":512,\"name\":\"Earth Cruises\",\"privacy_policy_link\":\"https://earth-cruises.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\"