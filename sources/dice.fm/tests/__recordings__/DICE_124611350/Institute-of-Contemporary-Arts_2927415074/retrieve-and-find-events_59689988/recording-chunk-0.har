:\"https://link.dice.fm/u72af14bb88c?dice_id=u72af14bb88c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r903a985948f?dice_id=r903a985948f\",\"post_purchase_referral\":\"https://link.dice.fm/p4e3d45b0c81?dice_id=p4e3d45b0c81\",\"post_reminder_referral\":\"https://link.dice.fm/L73bbb99b4f2?dice_id=L73bbb99b4f2\",\"post_waitinglist_referral\":\"https://link.dice.fm/P269aa8a1cec?dice_id=P269aa8a1cec\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Oasis Forever\\n\\nOasis Forever are the ultimate tribute to one of Britain’s most iconic bands. Capturing the swagger, attitude, look and unmistakable sound of Oasis. The band delivers a high-energy performance packed with the anthems that defined a generation from “Wonderwall” to “Live Forever” and “Champagne Supernova”. They are no stranger to the stage having played sold out shows at some iconic venues across the UK. Whether you’re a die-hard fan or discovering the Britpop legends for the first time, this tribute is a must-see celebration of the Gallagher brothers’ legacy.\\n\\nhttps://www.oasisforevertribute.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1797616800,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibili