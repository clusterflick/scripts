,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1446,\"name\":\"Serious\",\"privacy_policy_link\":\"https://serious.org.uk/serious-ticketing-t-cs\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780770600,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:96\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4950},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/545ab90e-4dbf-4af5-859b-0ec4e149e9af.jpg?rect=0%2C228%2C5504%2C5504\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/545ab90e-4dbf-4af5-859b-0ec4e149e9af.jpg?rect=0%2C2477%2C5504%2C3302\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/545ab90e-4dbf-4af5-859b-0ec4e149e9af.jpg?rect=482%2C0%2C4541%2C8256\"},\"id\":\"6929cf16bbd68d00017c76a2\",\"name\":\"Emeli Sandé\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"e2d51573-cc30-4510-b998-f054b5275850\",\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Introduced to the world more than ten years ago, Emeli Sandé MBE has become an icon of British singer-songwriting; emotional, honest and prolific in the kind of manner that cements you as a go-to artist for heartfelt pop sensibility.\\n\\nHer debut album Our Version of Events, which has sold over 5.4 million copies to date, was the biggest selling album in the UK of 2012 and 2013, and is certified platinum eight times in the UK and Ireland. Emeli followed with critically acclaimed Long Live The Angels in 2016, Kingdom Coming EP in 2017 and Real Life in 2019.\\n\\nIn 2022 Emeli Sandé released Let's Say For Instance, her long-awaited 4th album and her first release on an independent label, marking a new era of Emeli's expansive artistry after a decade on stage and on the airwaves. This was followed a year after by, Let’s Say For Instance, which see’s Sandé is using that voice to its full, astonishing potential.\\n\\nWith 19 million singles sold including 3 UK no.1 singles, 6 million albums and four BRIT awards (including Best Female twice), Emeli received an MBE for Services to Music in 2018 and in July 2019, she became the University of Sunderland's Chancellor.\\n\\nEmeli Sandé is an internationally acclaimed artist and highly sought-after writer with strong values. She uses her profile with moral purpose to support important campaigns. Her powerful stance on social justice is evident through her song-writing and is the driving force in her career.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 14s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T16:35:00+00:00\",\"sale_end_date\":\"2026-06-06T16:00:00+01:00\",\"sale_start_date\":\"2025-11-28T16:35:00+00:00\",\"event_start_date\":\"2026-06-06T19:30:00+01:00\",\"event_end_date\":\"2026-06-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Shadowlands\",\"image\":null,\"artist_id\":\"110323\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Kings Place.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-06T20:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"announcement_date_unix\":1731672000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Xfb8af43a0ca?dice_id=Xfb8af43a0ca\",\"post_competition_referral\":\"https://link.dice.fm/ebdd5a500721?dice_id=ebdd5a500721\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F07bf2d23273?dice_id=F07bf2d23273\",\"post_purchase_referral\":\"https://link.dice.fm/q2063aed3395?dice_id=q2063aed3395\",\"post_reminder_referral\":\"https://link.dice.fm/G4dd216fe95d?dice_id=G4dd216fe95d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pe0d260cd8cb?dice_id=Pe0d260cd8cb\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bbep8x-shadowlands-6th-jun-kings-place-hall-two-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780772400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:97\",\"price\":{\"currency\":\"GBP\",\"amount\":2402,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-11-15/0efc1f9d-43eb-4d11-8036-a0a2dded4d64.jpg?rect=352%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-11-15/0efc1f9d-43eb-4d11-8036-a0a2dded4d64.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-11-15/0efc1f9d-43eb-4d11-8036-a0a2dded4d64.jpg?rect=663%2C0%2C594%2C1080\"},\"id\":\"6737362471e20b000118acab\",\"name\":\"Shadowlands\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join vibrant group Kit Downes, Lauren Kinsella and Robin Fincker, for an evening of modern and folk music with a repertoire of improvisation and original compositions.\\n\\n\\\\-------------------------Inspired by a blend of early music, folk and plainchant Shadowlands weaves a form of contemporary chamber music rich in sonic textures. The three vibrant voices well known to European creative music scenes and adept of the crossing of genres, agree to jump together into the unknown, with a repertoire where improvisation rubs shoulders with centuries-old melodies and original compositions. Thus the language of Kit Downes, an essential pianist of the new British scene, mixes with that of the Anglophile saxophonist and clarinetist Robin Fincker and the Irish singer Lauren Kinsella in a common desire to question slowness and good gestures.  The weaving and singing melodies are surrounded by a halo of shimmering and moving sound material and little by little, the shadows stretch and come alive…\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-11-15T12:00:00+00:00\",\"sale_end_date\":\"2026-06-06T12:00:00+01:00\",\"sale_start_date\":\"2024-11-15T12:00:00+00:00\",\"event_start_date\":\"2026-06-06T20:00:00+01:00\",\"event_end_date\":\"2026-06-06T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kühle Matrosen\",\"image\":null,\"artist_id\":\"128717\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by REFORMATION.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":4,\"properties\":[],\"venues\":[{\"id\":\"41\",\"name\":\"The Waiting Room\",\"address\":\"175 Stoke Newington High Street, London N16 0LH\",\"location\":{\"lat\":51.5620818,\"lng\":-0.0738883999999871},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-waiting-room-jxea\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-06T21:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"141271\",\"name\":\"REFORMATION\",\"image\":{\"url\":null},\"perm_name\":\"reformation-o6bo5\",\"profile_active\":false},\"announcement_date_unix\":1770112800,\"social_links\":{\"event_share\":\"https://link.dice.fm/t9c6dd74d1b0?dice_id=t9c6dd74d1b0\",\"post_competition_referral\":\"https://link.dice.fm/pfe13bd4201e?dice_id=pfe13bd4201e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j1871ab9cc24?dice_id=j1871ab9cc24\",\"post_purchase_referral\":\"https://link.dice.fm/N838cc095b7d?dice_id=N838cc095b7d\",\"post_reminder_referral\":\"https://link.dice.fm/ob83ad3a9bea?dice_id=ob83ad3a9bea\",\"post_waitinglist_referral\":\"https://link.dice.fm/B017c6df51c9?dice_id=B017c6df51c9\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ry92kr-kuhle-matrosen-nothing-new-6th-jun-the-waiting-room-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780776000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:98\",\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/e2797e8d-b9c0-47a0-8bb7-6dc2a14aa979.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/e2797e8d-b9c0-47a0-8bb7-6dc2a14aa979.jpg?rect=0%2C282%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/e2797e8d-b9c0-47a0-8bb7-6dc2a14aa979.jpg?rect=103%2C0%2C563%2C1024\"},\"id\":\"6981b46d6f94d60001d6d369\",\"name\":\"KUHLE MATROSEN + Nothing New\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"We are excited to announce that our next REFORMATION event will feature KÜHLE MATROSEN making their UK debut, with support from London's NOTHING NEW  \\n  \\nKÜHLE MATROSEN  \\nDIY – Minimal – Synth Wave – Neue Deutsche Welle – Post-punk\\n\\nBased in Hamburg 🇩🇪, Kühle Matrosen (KM) features Hubert Kühl (vocals), aka Lars Trombose, and Marc Trose (machines).  \\n  \\nTheir name pays tribute to “Blaue Matrosen” by Der Moderne Man (1982).  \\n  \\nAfter years exploring rap, electro, and techno, Lars Kühl took a new direction in 2018, inspired by Andreas Dorau’s performance at Hamburg’s “Hanseplatte.” He shelved his techno records to create a raw DIY sound inspired by early ‘80s acts like DAF.  \\n  \\nThe result: their first tracks “Bräutigam”, “Gold”, and “Theoretisch Magnetisch”, followed by releases on Kernkrach / Hertz-Schrittmacher, Ölband, and Young & Cold Records.  \\n  \\nWith support from NOTHING NEW.  \\n  \\nNathan Nothing started a new project in 2019, with the aim of producing synth music that wasn't trying to be anything new. As it has taken over three years to finish any music, this is also not such a new project. There are also several other bands with this name, which fits the theme, but luckily they don't play electronic music. Expect minimal wave and synthpop, with some elements of EBM.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T10:00:00+00:00\",\"sale_end_date\":\"2026-06-06T17:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-06-06T21:00:00+01:00\",\"event_end_date\":\"2026-06-07T03:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Kühle Matrosen - La Nuit Arrive\",\"redirect_url\":\"https://open.spotify.com/track/2PLU6Rc32bdbWPg8jjk0eZ\",\"artist\":\"Kühle Matrosen\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5c8781087bafedea66e0e1fccd4102e6015ba1c1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"La Nuit Arrive\"},{\"type\":\"apple_music\",\"title\":\"Kühle Matrosen - La Nuit Arrive\",\"redirect_url\":\"https://music.apple.com/us/album/la-nuit-arrive/1849707522?i=1849707528&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kühle Matrosen\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/f0/a1/92/f0a1923e-ea6d-41ae-89d7-fbc6190f6038/mzaf_2871266024472673779.plus.aac.p.m4a\",\"track_name\":\"La Nuit Arrive\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 06 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
