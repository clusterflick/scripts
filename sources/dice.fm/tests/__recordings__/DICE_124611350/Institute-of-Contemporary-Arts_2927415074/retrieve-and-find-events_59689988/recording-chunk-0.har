free_texts\":1},\"faqs\":[{\"id\":72982,\"title\":\"How to get here?\",\"body\":\"If travelling by car, please use SE25 5PL for Sat Nav, as our shared car parking entrance is in Dagnall Park. You will need to enter your registration plate at Reception to avoid a parking charge.\\n\\nThe Crescent is part of Croydon's Healthy Schools Scheme. This means that you can no longer drive a vehicle into The Crescent from 08.00am – 9.30am and 2.00pm – 4.00pm.\",\"order\":0},{\"id\":72983,\"title\":\"What is a Concession\",\"body\":\"A Student or Child Concession is available for children and students at any school, college or university.\\n\\nAn Adult Concession is available for those in receipt of Universal Credit, Working Tax Credit, Child Tax Credit, Pension Credit, Employment and Support Allowance, Income Support or Jobseeker’s Allowance.\",\"order\":1},{\"id\":72984,\"title\":\"How do I book an access ticket?\",\"body\":\"Please contact tickets@brit.school before making your booking\",\"order\":2}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/6ef78339-bb0c-4bf1-8fb7-875847964514.jpg?rect=0%2C0%2C3508%2C3508\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/6ef78339-bb0c-4bf1-8fb7-875847964514.jpg?rect=0%2C702%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/6ef78339-bb0c-4bf1-8fb7-875847964514.jpg?rect=790%2C0%2C1929%2C3508\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769677200,\"max_tickets\":5,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"“The role of the artist is that of the soldier of the revolution.” - Diego Rivera. In their debut Obie show, Year 12 students present a night of protest music. Featuring eight original compositions alongside existing songs of protest, expect music that aims to send a message and make a change. Give a damn.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 12A event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The BRIT School Limited.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:6\",\"social_links\":{\"event_share\":\"https://link.dice.fm/E67f13b671fd?dice_id=E67f13b671fd\",\"post_competition_referral\":\"https://link.dice.fm/F0389e70d965?dice_id=F0389e70d965\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j860348b3f91?dice_id=j860348b3f91\",\"post_purchase_referral\":\"https://link.dice.fm/Fdff3742933d?dice_id=Fdff3742933d\",\"post_reminder_referral\":\"https://link.dice.fm/Cb7468491f75?dice_id=Cb7468491f75\",\"post_waitinglist_referral\":\"https://link.dice.fm/xa926dfe2dd2?dice_id=xa926dfe2dd2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T09:00:00+00:00\",\"sale_end_date\":\"2026-02-17T19:30:00+00:00\",\"sale_start_date\":\"2026-01-30T09:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:00:00+00:00\",\"event_end_date\":\"2026-02-17T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"properties\":[\"selling_fast\"],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"697b4cb6c144840001862032\",\"seats_io_event_id\":null,\"name\":\"Give A Damn\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb3gnk-give-a-damn-17th-feb-the-obie-theatre-the-brit-school-london-tickets\",\"date_unix\":1771354800,\"score\":0,\"tty_to_extras\"