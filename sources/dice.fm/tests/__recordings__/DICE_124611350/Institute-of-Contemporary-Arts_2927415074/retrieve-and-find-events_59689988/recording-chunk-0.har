\"doors_open_date\":\"2026-03-03T18:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/a5fa5d8c-de80-4592-bec6-47346c1c2207.jpg?rect=0%2C0%2C4501%2C4501\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/a5fa5d8c-de80-4592-bec6-47346c1c2207.jpg?rect=0%2C900%2C4501%2C2701\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/a5fa5d8c-de80-4592-bec6-47346c1c2207.jpg?rect=1013%2C0%2C2476%2C4501\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/p1517937251e?dice_id=p1517937251e\",\"post_competition_referral\":\"https://link.dice.fm/c2e75fef9a3f?dice_id=c2e75fef9a3f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wdbedfbb53e1?dice_id=wdbedfbb53e1\",\"post_purchase_referral\":\"https://link.dice.fm/y19512d67edd?dice_id=y19512d67edd\",\"post_reminder_referral\":\"https://link.dice.fm/Sc00ca85203f?dice_id=Sc00ca85203f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y163e22743ac?dice_id=Y163e22743ac\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:54\",\"properties\":[],\"presented_by\":\"Presented by Studio36.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767891600,\"id\":\"695fa5f3f0f0a200016ea00e\",\"name\":\"Run The Track Presents “The Violence Of Change”\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"This event will take place in EartH Kitchen.\\n\\nAt Studio 36 we are hosting a FREE launch event at EartH Kitchen to showcase and celebrate our 2026 Run The Track album: “The Violence of Change”. The Violence of Change is a collaborative album created by this year’s roster exploring identity, transformation and the experiences of young people. Join us for an unmissable evening with performances from the Run The Track cohort, DJs and opportunities to meet other creatives! More exciting things to be announced closer to the time.\\n\\nRun The Track is Studio 36’s free artist development program for emerging talent aged 18-25. This event supports and platforms a new generation of independent artists who have undergone five months of mentorship, studio sessions and masterclasses to make their collaborative album. Expect good vibes and wholesome energy!\\n\\nFollow us @studio\\\\_36 to stay up to date with our journey.\\n\\nIf you require access assistance, please contact us at access@earthackney.co.uk for this to be arranged. For more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"date_unix\":1772562600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:30:00+00:0