ion from mandolins and tubas.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"4259\",\"name\":\"Signature Brew Blackhorse Road\",\"address\":\"Unit 15, Uplands Business Park, Blackhorse Ln, Walthamstow, London E17 5QJ, UK\",\"location\":{\"lat\":51.5915931,\"lng\":-0.0428547},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/22392fd6-55c8-436f-b7c7-be53bd36eea2.jpg?rect=420%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-blackhorse-road-wxbg\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-24/17f33322-4ebe-4d10-93e4-d1f66718d544.jpg?rect=0%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-24/17f33322-4ebe-4d10-93e4-d1f66718d544.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-24/17f33322-4ebe-4d10-93e4-d1f66718d544.jpg?rect=324%2C0%2C792%2C1440\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/t649766e2805?dice_id=t649766e2805\",\"post_competition_referral\":\"https://link.dice.fm/m57eabe10c41?dice_id=m57eabe10c41\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I1af3139f604?dice_id=I1af3139f604\",\"post_purchase_referral\":\"https://link.dice.fm/D378798c5040?dice_id=D378798c5040\",\"post_reminde