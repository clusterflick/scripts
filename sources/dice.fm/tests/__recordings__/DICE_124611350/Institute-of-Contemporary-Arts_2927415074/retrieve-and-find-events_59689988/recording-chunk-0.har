"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-25T23:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/6c669121-2f79-4271-b682-d094de8a4ec1.jpg?rect=0%2C614%2C4908%2C4908\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/6c669121-2f79-4271-b682-d094de8a4ec1.jpg?rect=0%2C1595%2C4908%2C2945\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/6c669121-2f79-4271-b682-d094de8a4ec1.jpg?rect=767%2C0%2C3374%2C6135\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1734523200,\"max_tickets\":6,\"marketeers\":[{\"id\":748,\"name\":\"Brick Lane Jazz Fest\",\"privacy_policy_link\":\"https://www.bricklanejazzfestival.com/privacy-policy\",\"fb_pixel_id\":\"580346810496200\",\"ga_tracking_id\":\"G-JQ828M4E07\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"11016698064\",\"google_ads_purchase_conversion_label\":\"Pd33CK7Q-e4bENDxlYUp\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**TICKET PRICE INCLUDES A £1.50 VENUE LEVY FROM VILLAGE UNDERGROUND + DICE FEES**\\n\\n**MORE TICKETS AVAILABLE AT WWW.BRICKLANEJAZZFESTIVAL.COM**\\n\\nBrick Lane Jazz Festival takes over **Village Underground on Saturday 25th April**, for our legendary **Official Afterparty**! Get ready for a night of high-energy sets from a carefully curated lineup of trailblazing selectors & producers featuring Kamma & Masalo, Make A Dance, Honey Bun B2B Lovie, Heléna Star + more TBA.\\n\\nNote: this party always sells out, don't sleep on it!\\n\\n**About Kamma & Masalo**\\n\\nRarely do you see DJs complement each other as seamlessly as Kamma & Masalo. The Amsterdam duo trust each other implicitly behind the decks, sometimes selecting the same track without exchanging a single word, other times boldly pushing each other into deep and unexpected waters. Their sound is shaped by Amsterdam’s school of eclecticism, as well as a deep reverence for the pioneers of dance music. Their fresh perspective bridges the gap between old school and new with euphoric energy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 18+  event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Brick Lane Jazz Fest\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:17\",\"social_links\":{\"event_share\":\"https://link.dice.fm/b471661d2e34?dice_id=b471661d2e34\",\"post_competition_referral\":\"https://link.dice.fm/ufc0b50bce07?dice_id=ufc0b50bce07\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F063980f482a?dice_id=F063980f482a\",\"post_purchase_referral\":\"https://link.dice.fm/Pfacff5efcd7?dice_id=Pfacff5efcd7\",\"post_reminder_r