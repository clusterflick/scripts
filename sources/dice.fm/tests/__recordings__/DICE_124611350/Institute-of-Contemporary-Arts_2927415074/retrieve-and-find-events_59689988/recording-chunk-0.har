d\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"announcement_date_unix\":1765990800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Hf12e2eb9cf2?dice_id=Hf12e2eb9cf2\",\"post_competition_referral\":\"https://link.dice.fm/M01d26f94e4f?dice_id=M01d26f94e4f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j22844f020e4?dice_id=j22844f020e4\",\"post_purchase_referral\":\"https://link.dice.fm/n4ae618fd8a1?dice_id=n4ae618fd8a1\",\"post_reminder_referral\":\"https://link.dice.fm/l4f23180c4a1?dice_id=l4f23180c4a1\",\"post_waitinglist_referral\":\"https://link.dice.fm/Bf1789f4b54d?dice_id=Bf1789f4b54d\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"oeqpmg-vexed-25th-feb-the-black-heart-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772046000,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:29\",\"price\":{\"currency\":\"GBP\",\"amount\":1550,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/a2cb1529-10ef-45da-87ef-acd240c2f975.jpg?rect=0%2C239%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/a2cb1529-10ef-45da-87ef-acd240c2f975.jpg?rect=0%2C1018%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/a2cb1529-10ef-45da-87ef-acd240c2f975.jpg?rect=278%2C0%2C1945%2C3536\"},\"id\":\"693b019871e0540001afa444\",\"name\":\"Vexed\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"*The Black Heart presents...*\\n\\nVEXED  \\nhttps://www.instagram.com/vexedvexedvexed/\\n\\nPlus guests tba...\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T17:00:00+00:00\",\"sale_end_date\":\"2026-02-25T18:00:00+00:00\",\"sale_start_date\":\"2025-12-17T17:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bleary Eyed\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-01-28/e633f285-3181-434d-9f09-c610d11e68b0.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"41722\",\"about\":null,\"is_headliner\":false},{\"name\":\"Wednesday\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-01-18/00e12ab5-1966-41c8-bf7a-cb31e3062a0d.jpg?rect=0%2C118%2C696%2C696\"},\"artist_id\":\"52327\",\"about\":{\"description\":\"“Wednesday might end up as the greatest indie band of their generation.” - Stereogum\\n\\n\\\"What makes Wednesday one of the best bands in the world is Hartzman’s songwriting. It’s paradisiacal in a scuzzy way, adaptable to any underbelly in North America and wickedly unafraid of being too truthful or unabashed.\\\" - Paste\\n\\n“Karly Hartzman’s storytelling remains a beautifully magpie-like collection of little details drawn from memory and observation, woven together into a transcendent indie rock tapestry.” - The AV Club\\n\\n“Wednesday falls somewhere between the country rumbling of the Drive-By Truckers and the melodic squeal of early Dinosaur Jr.” - The New Yorker\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bird On The Wire.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":59028,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":59029,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":59030,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":59031,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"max_tickets\":4,\"properties\":[],\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":\"82355bdc-c9c2-4351-962f-0de20dc86d96\",\"billing_promoter\":{\"id\":\"112\",\"name\":\"Bird On The Wire\",\"image\":{\"url\":null},\"perm_name\":\"bird-on-the-wire-jqo9\",\"profile_active\":true},\"announcement_date_unix\