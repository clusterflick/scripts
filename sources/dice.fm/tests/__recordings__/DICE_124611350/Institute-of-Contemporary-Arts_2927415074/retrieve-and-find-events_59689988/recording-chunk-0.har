tps://link.dice.fm/db1736452d60?dice_id=db1736452d60\",\"post_competition_referral\":\"https://link.dice.fm/r453ef1a65b0?dice_id=r453ef1a65b0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Cbca6f4d9b30?dice_id=Cbca6f4d9b30\",\"post_purchase_referral\":\"https://link.dice.fm/p463c40c8d22?dice_id=p463c40c8d22\",\"post_waitinglist_referral\":\"https://link.dice.fm/R31692e3c7de?dice_id=R31692e3c7de\",\"post_reminder_referral\":\"https://link.dice.fm/A00968313ef4?dice_id=A00968313ef4\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"***Hannah Sanders & Ben Savage release their fifth studio album ‘The Strangers’ Share’; a record centred on dreams and the supernatural.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nFollowing 2024’s *In The Dark We Grow* band tour, and their 2023 collaborations with folk-rock legends Fairport Convention, the album sees Hannah Sanders & Ben Savage return home to the intimate, pin-drop intimacy of the single microphone live shows that made their name five albums earlier. Every creak from their 80 year old vintage guitars is honestly captured; an intake of nervous breath before a heartbreaking ballad; the magic of live-in-the-studio duetting – this record takes you through the veil, deep into Hannah & Ben’s dreamy, soundscaped world – for 40 minutes, you’re in the room with them – sharing the magic.\\n\\nSince emerging in 2016, Hannah & Ben have been defying all conventions of style, genre and compartmentalisation. A touch of ‘Americana’, yet quintessentially English. Traditional, yet contemporary, with their individual writing style. Playful and instinctive, they make music with such panache and natural chemistry it makes perfect sense.\\n\\nHannah Sanders has an alluring mystique and a voice of disarming purity that massages your senses. Ben Savage is a singular guitarist with a sound as distinctive as it is innovative. Together their harmonies and unique stage presence shimmer with an infectious enthusiasm and joy.\\n\\n***This event will last approximately 2 hours, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:18\",\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"presented_by\":\"Presented by Kings Place.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hannah Sanders & Ben Savage\",\"image\":null,\"artist_id\":\"107013\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pix