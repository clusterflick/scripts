ice_id=j8626048665f\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Believe - Triple J Like A Version\",\"redirect_url\":\"https://open.spotify.com/track/4inJjInWq5Y0YYvLCWUIrg\",\"artist\":\"Believe\",\"preview_url\":\"https://p.scdn.co/mp3-preview/718ce4ad1fa3a5a740626e3382d3944200676879?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Triple J Like A Version\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/DMxUzCb00F5f8d1D629YCekVG602ENuYr00horwDYi8HSA.m3u8\",\"track_name\":\"\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3642},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Como No!\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1}],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"rylo7v-diogo-piarra-27th-feb-islington-assembly-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772218800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":8,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:27\",\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Diogo Piçarra\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb175a973d143aefed63257b25\"},\"artist_id\":\"49079\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Portugal’s Leading Pop Voice Comes to Islington Assembly Hall.\\n\\nWith millions of streams, sold-out arena shows, and collaborations with some of the biggest names in Portuguese and international music, Diogo Piçarra has become a defining voice in modern Lusophone pop.\\n\\nMarking over a decade of success since winning Ídolos in 2012, Diogo has captivated fans with his emotionally driven songwriting, dynamic live performances, and genre-blending sound that fuses pop with electronic, acoustic, and urban influences.\\n\\nNow, following the release of his bold and intimate fourth studio album SNTMNTL, Diogo brings his acclaimed SNTMNTL Tour to Islington Assembly Hall for a rare and powerful night in London.\\n\\nHaving headlined festivals like Rock in Rio Lisboa and MEO Sudoeste and sold out arenas across Portugal and Europe, including shows in Paris (30,000+ audience), Lausanne, and Lisbon’s Altice Arena, Diogo’s live show is a deeply personal journey through heartbreak, hope, and the human experience.\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-27T21:00:00+00:00\",\"sale_start_date\":\"2025-07-17T10:00:00+01:00\",\"event_start_date\":\"2026-02-27T19:00:00+00:00\",\"event_end_date\":\"2026-02-27T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68777d7f5857670001e49617\",\"name\":\"Diogo Piçarra\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-15/3d9da59a-ce50-4632-97fd-1319570e792b.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-15/3d9da59a-ce50-4632-97fd-1319570e792b.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-15/3d9da59a-ce50-4632-97fd-1319570e792b.jpg?rect=225%2C0%2C550%2C1000\"},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"pri