\"https://dice-media.imgix.net/attachments/2025-12-23/fa06192e-0d93-4c77-bfb2-7929c7ebad04.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Downstater\\n\\nDownstater is a pop-punk/indie rock band hailing straight from Quebec City. Melding the essence of rock music with punk rawness, this melodic achievement exhibits the trail of a spirited and raging youth with words expressed without compromise. Downstater is an illustrative collection of melancholy-fueled indie rock songs pouring with emotion and honesty.\\n\\nhttps://downstater.bandcamp.com/\\n\\n\\\\+ supports\\n\\nOne Fall\\n\\nSalem Skate Punx\\n\\nhttps://www.instagram.com/onefallma/\\n\\nVampire Slumber Party\\n\\nPop punk with bite!\\n\\nhttps://www.instagram.com/vampire_slumber_party/\\n\\nDiagnostics\\n\\nNew London Punk Rock\\n\\nhttps://www.instagram.com/diagnostics.punk/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s require an adult)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"694aa1732f57c300012ff345\",\"name\":\"Downstater\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Downstater - Call Me When You're Dead\",\"redirect_url\":\"https://music.apple.com/us/album/call-me-when-youre-dead/1634324181?i=1634324186&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Downstater\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/05/13/21/051321ca-ca8a-f749-d8a7-990d8f2f62b6/mzaf_13575786675239105243.plus.aac.p.m4a\",\"track_name\":\"Call Me When You're Dead\"},{\"type\":\"spotify\",\"title\":\"Downstater - Call me When You're Dead\",\"redirect_url\":\"https://open.spotify.com/track/5xUWtUuypwhsDFpGvEPmLp\",\"artist\":\"Downstater\",\"preview_url\":\"https://p.scdn.co/mp3-preview/00ba18293b356c7ede3ff8446f3a03e9480d2e0a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Call me When You're Dead\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"valu