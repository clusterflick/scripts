"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by BROADWICK LIVE.\",\"seating\":null,\"announcement_date_unix\":1769472000,\"venues\":[{\"id\":\"9324\",\"name\":\"Silverworks Island \",\"address\":\"Silvertown Square, Royal Victoria Dock E16 1UR, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.504635,\"lng\":0.027626},\"image\":null,\"city\":{\"id\":\"6321addb17081dcc2dd6adc1\",\"name\":\"Barking\",\"location\":{\"lat\":51.538717,\"lng\":0.08061,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"silverworks-island-627b\",\"accessibility\":{\"url\":\"https://silverworksisland.com/accessibility/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-11T14:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1383\",\"name\":\"BROADWICK LIVE\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-08/20f08a51-5b45-468f-80cc-f81e1de9fb66.jpg\"},\"perm_name\":\"broadwick-live-w8br\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:32\",\"date_unix\":1783774800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6595},\"social_links\":{\"event_share\":\"https://link.dice.fm/R81a946f7741?dice_id=R81a946f7741\",\"post_competition_referral\":\"https://link.dice.fm/a2ae3b47f3f9?dice_id=a2ae3b47f3f9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P79586029fb1?dice_id=P79586029fb1\",\"post_purchase_referral\":\"https://link.dice.fm/i312dbef87e1?dice_id=i312dbef87e1\",\"post_reminder_referral\":\"https://link.dice.fm/Q6b8e9c49254?dice_id=Q6b8e9c49254\",\"post_waitinglist_referral\":\"https://link.dice.fm/U0fb77e92fda?dice_id=U0fb77e92fda\"},\"perm_name\":\"7dpwav-fisher-11th-jul-silverworks-island-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/2a7c498a-7a64-43dd-aacb-0b6b2aa00a23.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/2a7c498a-7a64-43dd-aacb-0b6b2aa00a23.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/2a7c498a-7a64-43dd-aacb-0b6b2aa00a23.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"One of the scene’s most in-demand talents, FISHER returns to London on Saturday 11th July, bringing his inimitable energy to Silverworks Island.\\n\\nWith a fast rise through the ranks to global headline status, the Aussie DJ has become a mainstay in the party circuit with appearances at the world's main festivals as well as sought-after residencies in Ibiza and Las Vegas. With a string of anthemic, floor-filling records and a stage presence that’s impossible to ignore, FISHER has earned his place among the scene’s most exciting names.\\n\\nTaking to East London this summer, he'll deliver a full day-to-night experience with more acts TBA.\\n\\nWho’s coming fishing?\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697890979afb5800015860fa\",\"name\":\"FISHER\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"FISHER - Ya Kidding\",\"redirect_url\":\"https://open.spotify.com/track/3fDgxdcf0jeJgGiZJGUmyK\",\"artist\":\"FISHER\",\"preview_url\":\"https://p.scdn.co/mp3-preview/77c41819e6c7d3433180910ac2aefb1792bf6452?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ya Kidding\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"FISHER\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-02/e7ec62b3-ea1f-464b-88bb-03f88c7d840d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"8249\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-19T13:00:00+00:00\",\"sale_end_date\":\"2026-07-11T17:00:00+01:00\",\"sale_start_date\":\"2025-12-19T13:00:00+00:00\",\"event_start_date\":\"2026-07-11T18:00:00+01:00\",\"event_end_date\":\"2026-07-11T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":65689,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":65690,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":65691,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hammer Punk Production\",\"seating\":null,\"announcement_date_unix\":1766149200,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-11T18:00:00+01:00\",\"doors_close_date\":\"2026-07-11T22:00:00+01:00\"}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:33\",\"date_unix\":1783789200,\"price\":{\"currency\":\"GBP\",\"amount\":4120,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/F0a1f721f1ff?dice_id=F0a1f721f1ff\",\"post_competition_referral\":\"https://link.dice.fm/Ade34370a356?dice_id=Ade34370a356\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H69c71d6fd73?dice_id=H69c71d6fd73\",\"post_purchase_referral\":\"https://link.dice.fm/y0574e0d4032?dice_id=y0574e0d4032\",\"post_reminder_referral\":\"https://link.dice.fm/a4c2562b86a6?dice_id=a4c2562b86a6\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q1d6f1b1a4a7?dice_id=Q1d6f1b1a4a7\"},\"perm_name\":\"avekx7-armia-11th-jul-the-underworld-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-19/291a98eb-8d37-4055-b281-da711727fa00.jpg?rect=837%2C0%2C3344%2C3344\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-19/291a98eb-8d37-4055-b281-da711727fa00.jpg?rect=0%2C167%2C5017%2C3010\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-19/291a98eb-8d37-4055-b281-da711727fa00.jpg?rect=1589%2C0%2C1839%2C3344\"},\"properties\":[],\"about\":{\"description\":\"Armia – a Polish band performing broadly defined punk rock music, founded in 1984. It is considered one of the leading groups of the Polish independent scene in the 1980s. With poetic (often inspired by philosophy and literature) lyrics, written by Budzyński, and evolving, creative music Armia has gained popularity and respect over the years, and its concerts now attract numerous fans of rock music.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"id\":\"6945525cee0701000160a66b\",\"name\":\"ARMIA\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Armia - Niewidzialna armia\",\"redirect_url\":\"https://open.spotify.com/track/1MvvjTg3dLPBQg3gk8dWzD\",\"artist\":\"Armia\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5a1de4e0dc8d4899208388acdd6d74502e293d09?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Niewidzialna armia\"},{\"type\":\"apple_music\",\"title\":\"Armia - Niewidzialna Armia\",\"redirect_url\":\"https://music.apple.com/us/album/niewidzialna-armia/1506078043?i=1506078059&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Armia\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/34/14/eb/3414eb14-4979-51ab-e70b-bf56ad4b1763/mzaf_13162912288077628941.plus.aac.p.m4a\",\"track_name\":\"Niewidzialna Armia\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"