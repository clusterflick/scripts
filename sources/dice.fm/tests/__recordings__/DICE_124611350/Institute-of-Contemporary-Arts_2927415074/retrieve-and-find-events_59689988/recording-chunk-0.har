et_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=256%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=0%2C154%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=602%2C0%2C845%2C1536\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1764201600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"On the 3rd Sunday of every month Jamie Williams & Laura Tuckey host the HOT BOX blues jam, featuring The Roots Collective as house band.\\n\\nThe full backline is already on stage so just rock up with your instrument, plug in and have a great time playing alongside some of the best in the business.\\n\\nThere's a place for all levels of musician, and if you don't know a plectrum from a g-String, just grab a drink and enjoy the show!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:84\",\"social_links\":{\"event_share\":\"https://link.dice.fm/r4b3cf565634?dice_id=r4b3cf565634\",\"post_competition_referral\":\"https://link.dice.fm/s5bc3aee9572?dice_id=s5bc3aee9572\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/oc2c1f0b8bd2?dice_id=oc2c1f0b8bd2\",\"post_purchase_referral\":\"https://link.dice.fm/bb0369f363c3?dice_id=bb0369f363c3\",\"post_reminder_referral\":\"https://link.dice.fm/Y780138add96?dice_id=Y780138add96\",\"post_waitinglist_referral\":\"https://link.dice.fm/m40fd1009690?dice_id=m40fd1009690\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-09-27T16:00:00+01:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-09-27T15:30:00+01:00\",\"event_end_date\":\"2026-09-27T19:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":500},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6940905cba87be0001b177f5\",\"seats_io_event_id\":null,\"name\":\"Hot Box Blues Jam\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"q26poy-hot-box-blues-jam-27th-sep-hot-box-chelmsford-tickets\",\"date_unix\":1790519400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-27T18:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/41a425db-f255-43dd-9b6f-760e1da12906.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/41a425db-f255-43dd-9b6f-760e1da12906.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/41a425db-f255-43dd-9b6f-760e1da12906.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770721200,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**SUNDAY 27TH SEPTEMEBER / DOORS & BARS OPEN 6PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS / SHOW ENDS APPROX. 9:30PM**\\n\\n**This is a 10+ event. Under 18s must be accompanied by an adult over 21 (max. 2 U18s per adult 21+)**\\n\\nFor the first time ever in London, experience the powerful, mystical sound of the Peruvian Andes brought to life by ALBORADA — one of Peru’s most iconic musical groups.\\n\\nWith over 42 years on stage Alborada has captivated audiences across Latin America and Europe, launching countless hits, earning multiple national and international awards, and appearing regularly on TV and radio. Now, they bring their legendary energy and greatest songs to London.\\n\\nTheir music is a breathtaking fusion of ancestral Andean traditions and contemporary sound. Ancient instruments echo the spirit of the Inca Empire, while rich harmonies, vibrant rhythms, and ceremonial dances create an unforgettable live experience. Songs performed in the native Quechua language connect you directly to centuries of culture and history.\\n\\nThis is more than a concert — it’s a journey.\\n\\nA celebration of heritage, rhythm, and soul\\n\\nAn immersion into the authentic sound of the majestic Andes, filled with positive energy and Inca spirit.\\n\\nLet the mountains sing.\\n\\nLet the spirit move you.\\n\\nAlborada live — an unmissable night of Andean magic!\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:85\",\"social_links\":{\"event_share\":\"https://link.dice.fm/D969533aa11d?dice_id=D969533aa11d\",\"post_competition_referral\":\"https://link.dice.fm/Y5526ff94f77?dice_id=Y5526ff94f77\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zca8741f5c96?dice_id=Zca8741f5c96\",\"post_purchase_referral\":\"https://link.dice.fm/Hed5293a6f12?dice_id=Hed5293a6f12\",\"post_reminder_referral\":\"https://link.dice.fm/y93e07f208ce?dice_id=y93e07f208ce\",\"post_waitinglist_referral\":\"https://link.dice.fm/o2c2e1529598?dice_id=o2c2e1529598\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T11:00:00+00:00\",\"sale_end_date\":\"2026-09-27T18:00:00+01:00\",\"sale_start_date\":\"2026-02-10T11:00:00+00:00\",\"event_start_date\":\"2026-09-27T18:00:00+01:00\",\"event_end_date\":\"2026-09-27T21:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":4500,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"698b07729e8cdc00015690c2\",\"seats_io_event_id\":null,\"name\":\"Alborada: the Sound of Peruvian Andes London 2026\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"2w8m2o-alborada-the-sound-of-peruvian-andes-london-2026-27th-sep-the-clapham-grand-london-tickets\",\"date_unix\":1790528400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-27T18:00:00+01:00\",\"doors_close_date\":\"2026-09-27T22:30:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Healthy Junkies\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-13/b10ba4c6-7ba0-409e-9421-858fca6ec3cb.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"19189\",\"about\":null,\"is_headliner\":false},{\"name\":\"Wonk Unit\",\"image\":null,\"artist_id\":\"6289\",\"about\":null,\"is_headliner\":true},{\"name\":\"Yur Mum\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-19/9490b0cd-0707-4f41-ab1b-637283a3e9f1.jpg?rect=0%2C1024%2C4096%2C4096\"},\"artist_id\":\"8176\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"faqs\":[{\"id\":62922,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":62923,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":62924,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/85984ebf-36ca-4cce-ad54-ba5d526d69c6.jpg?rect=458%2C0%2C2546%2C2546\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/85984ebf-36ca-4cce-ad54-ba5d526d69c6.jpg?rect=0%2C121%2C3840%2C2304\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/85984ebf-36ca-4cce-ad54-ba5d526d69c6.jpg?rect=1220%2C0%2C1400%2C2546\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Say Say\",\"redirect_url\":\"https://open.spotify.com/track/7DgCz491jAIlvfNKZGNWWG\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/af3c7d79157301085a76e02237dfe16c48af629a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Say Say\"},{\"type\":\"apple_music\",\"title\":\"Yur Mum - Doors\",\"redirect_url\":\"https://music.apple.com/us/album/doors/1452693372?i=1452693380&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Yur Mum\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/8f/e4/b2/8fe4b26f-e8c9-1d5c-64e7-69712c3c594a/mzaf_839239780463015205.plus.aac.p.m4a\",\"track_name\":\"Doors\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768989600,\"max_tickets\":6,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"YUR MUM's celebrating 10 years of back breaking performances, DIY records and merch, and love for the underground.\\n\\nJoined by super special co headliners WONK UNIT and special guests HEALTHY JUNKIES.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Tropical Fuzz\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:86\",\"social_links\":{\"event_share\":\"https://link.dice.fm/m0b8e42848c3?dice_id=m0b8e42848c3\",\"post_competition_referral\":\"https://link.dice.fm/C4e03cbf663b?dice_id=C4e03cbf663b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Vf8e3d54c76d?dice_id=Vf8e3d54c76d\",\"post_purchase_referral\":\"https://link.dice.fm/A8c581c6ae19?dice_id=A8c581c6ae19\",\"post_reminder_referral\":\"https://link.dice.fm/g2244dfbfc63?dice_id=g2244dfbfc63\",\"post_waitinglist_referral\":\"https://link.dice.fm/Va905e1dd6c4?dice_id=Va905e1dd6c4\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T10:00:00+00:00\",\"sale_end_date\":\"2026-09-27T17:00:00+01:00\",\"sale_start_date\":\"2026-01-21T10:00:00+00:00\",\"event_start_date\":\"2026-09-27T18:00:00+01:00\",\"event_end_date\":\"2026-09-27T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2000,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"69381871c5aa5b00016be350\",\"seats_io_event_id\":null,\"name\":\"YUR MUM x WONK UNIT\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bbx32o-yur-mum-x-wonk-unit-27th-sep-the-underworld-london-tickets\",\"date_unix\":1790528400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE2ODkxNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQzNTk4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OTozOS43NTA3NDFaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzI4OS