i-scdn-co.imgix.net/image/ab67616d0000b2730923287451686e6c3bc752a8\"},\"artist_id\":\"13462\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-28/b83ebdb7-ea2e-420d-8945-3015f3a430a6.jpg?rect=0%2C0%2C1130%2C1130\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-28/b83ebdb7-ea2e-420d-8945-3015f3a430a6.jpg?rect=0%2C226%2C1130%2C678\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-28/b83ebdb7-ea2e-420d-8945-3015f3a430a6.jpg?rect=254%2C0%2C622%2C1130\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Seagulls on Speed\",\"redirect_url\":\"https://open.spotify.com/track/6hxOrwbQu3aJVSgEy8iZwc\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/de22d16ca0bfdde6c0944adf8084426f7b859cb2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Seagulls on Speed\"},{\"type\":\"apple_music\",\"title\":\"John Otway - Ok Father Christmas\",\"redirect_url\":\"https://itunes.apple.com/gb/album/ok-father-christmas-radio-edit/951660084?i=951660086&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"John Otway\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/Music3/v4/b1/ce/f6/b1cef6a8-795c-7059-f488-cfa7079c91a1/mzaf_6617529653050975579.plus.aac.p.m4a\",\"track_name\":\"Ok Father Christmas\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1745856000,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**Safe As Milk Promotions and New Cross Live present**\\n\\n**The John Otway Band**\\n\\nRock veteran John Otway dubbed himself “rock’n’roll’s greatest failure” after many unsuccessful attempts to produce a second hit single to follow his 1977 classic '(Cor Baby, That’s) Really Free' with Wild Willy Barrett.\\n\\nHowever, a mere quarter century later, he was back on Top of The Pops with the wonderful disco pastiche, ‘Bunsen Burner’ and back in the charts as a birthday present from his adoring and patient fans.\\n\\nAnd, more recently, his 'Beware Of The Flowers Cause I’m Sure They’re Going To Get You Yeah' voted the seventh greatest lyric of all time in a BBC poll.\\n\\nExpect madcap mayhem and some scintillating stunts from a man old enough to know better…..and also to be surprised at just what a showman and musician really lies underneath the tomfoolery.\\n\\nhttp://www.johnotway.com/\\n\\n\\\\+ support\\n\\nThe Outbursts\\n\\nAnarchic knockabout nonsense singing short snappy songs with absurd topics and surprisingly good harmonies.\\n\\nhttps://www.theoutbursts.com/\\n\\nSunday 15th March 2026\\n\\nNew Cross Inn\\n\\nDoors 6pm\\n\\nTickets £16 ADV STBF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by New Cross Live.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:1\",\"social_links\":{\"event_share\":\"https://link.dice.fm/h4b17fc664b3?dice_id=h4b17fc664b3\",\"post_competition_referral\":\"https://link.dice.fm/y2e20ef1877a?dice_id=y2e20ef1877a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/mc705d5f0934?dice_id=mc705d5f0934\",\"post_purchase_referral\":\"https://link.dice.fm/bddba4ec4584?dice_id=bddba4ec4584\",\"post_reminder_referral\":\"https://link.dice.fm/g609a3eb98ef?dice_id=g609a3eb98ef\",\"post_waitinglist_referral\":\"https://link.dice.fm/jea0f33bf909?dice_id=jea0f33bf909\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-28T17:00:00+01:00\",\"sale_end_date\":\"2026-03-13T17:00:00+00:00\",\"sale_start_date\":\"2025-04-28T17:00:00+01:00\",\"event_start_date\":\"2026-03-15T18:00:00+00:00\",\"event_end_date\":\"2026-03-15T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1760,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"id\":\"67e692ed6ae610000176bc1f\",\"seats_io_event_id\":null,\"name\":\"The John Otway Band\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"pyeoop-the-john-otway-band-15th-mar-new-cross-inn-london-tickets\",\"date_unix\":1773597600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3223\",\"name\":\"Conway Hall\",\"address\":\"25 Red Lion Square Holborn, London WC1R 4RL UK\",\"location\":{\"lat\":51.51948760000001,\"lng\":-0.1168424},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"conway-hall-obq5\",\"accessibility\":{\"url\":\"https://www.conwayhall.org.uk/about-us/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-15T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-22/bd965059-0475-4ddb-a200-0b6405ce1139.jpg?rect=214%2C0%2C853%2C853\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-22/bd965059-0475-4ddb-a200-0b6405ce1139.jpg?rect=0%2C43%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-22/bd965059-0475-4ddb-a200-0b6405ce1139.jpg?rect=406%2C0%2C469%2C853\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1765497600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Winners of multiple international awards, the **Fibonacci Quartet** are rapidly establishing themselves among the finest young ensembles in Europe. Their programme contrasts Haydn’s radiant “*Lark*” Quartet with the bold rhythmic invention of Bartók’s *Fifth*, before concluding with Schumann’s passionate *A major Quartet* — a work of lyrical intensity and Romantic warmth that showcases the ensemble’s expressive range and technical brilliance.\\n\\n**Haydn** | Quartet in D 'Lark' Op.64/5\\n\\n**Bartók** | Quartet No.5 Sz.102\\n\\n**Schumann** | Quartet in A Op.41/3\\n\\nLuna de Mol • *violin*\\n\\nKryštof Kohout • *violin*\\n\\nElliot Kempton • *viola*\\n\\nFindlay Spence • *cello*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. Under 16's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Conway Hall.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:2\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Rd1e79e64401?dice_id=Rd1e79e64401\",\"post_competition_referral\":\"https://link.dice.fm/Q0a5f7b7de88?dice_id=Q0a5f7b7de88\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r57a714479b5?dice_id=r57a714479b5\",\"post_purchase_referral\":\"https://link.dice.fm/T72730ea71a6?dice_id=T72730ea71a6\",\"post_reminder_referral\":\"https: