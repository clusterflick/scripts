subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765364700,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Dead Collective\",\"image\":null,\"artist_id\":\"131230\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/d866c929-fb34-47ae-878a-79df27313e1d.jpg?rect=0%2C0%2C3648%2C3648\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/d866c929-fb34-47ae-878a-79df27313e1d.jpg?rect=0%2C730%2C3648%2C2189\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/d866c929-fb34-47ae-878a-79df27313e1d.jpg?rect=821%2C0%2C2006%2C3648\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6939539214d87c00017ddf53\",\"name\":\"THE DEAD COLLECTIVE\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T11:05:00+00:00\",\"sale_end_date\":\"2026-04-23T17:00:00+01:00\",\"sale_start_date\":\"2025-12-10T11:05:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"eobr3d-the-dead-collective-23rd-apr-o2-academy2-islington-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1372,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Vd50104bfc40?dice_id=Vd50104bfc40\",\"post_competition_referral\":\"https://link.dice.fm/V9d0a94089db?dice_id=V9d0a94089db\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C5e8916d069a?dice_id=C5e8916d069a\",\"post_purchase_referral\":\"https://link.dice.fm/A13cb47e6c40?dice_id=A13cb47e6c40\",\"post_reminder_referral\":\"https://link.dice.fm/da73853958bd?dice_id=da73853958bd\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ndfc11f01327?dice_id=Ndfc11f01327\"},\"previews\":[],\"faqs\":[{\"id\":56191,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by CLUB.THE.MAMMOTH.\",\"billing_promoter\":{\"id\":\"1280\",\"name\":\"CLUB.THE.MAMMOTH\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-26/b7c6d4f5-e734-437e-aea8-bf1dbd513d1a.jpg\"},\"perm_name\":\"clubthemammoth-nyaq\",\"profile_active\":true},\"date_unix\":1776967200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":134,\"name\":\"CLUB.THE.MAMMOTH.\",\"privacy_policy_link\":\"http://bit.ly/ctmprivacystatement\",\"fb_pixel_id\":\"284003435619398\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:26\",\"about\":{\"description\":\"After 15 years away, An Experiment On A Bird In The Air Pump return to the stage with renewed power and urgency, and the same uncompromising spirit that made them one of London’s most fearless underground bands.\\n\\nFormed in 2008 and named after the Joseph Wright of Derby painting, the band broke boundaries from the start — with no designated front person, drummer or bassist, and an instinctive approach to switching roles mid-performance. Each member’s voice and instrument carries equal weight, creating a sound that is communal, raw and rhythmically hypnotic.\\n\\nComposed of British-Filipino twin sisters C-Bird and X-Bird, and D-Bird, who is of British Nepalese–Indian descent, the band channel no wave, punk, soul and grunge into a stripped-back fusion of bass, drums and voice that evokes both ritual and rebellion.\\n\\nAn Experiment On A Bird In The Air Pump have previously collaborated with Steve Albini on an unreleased album, and recorded EPs with Steve Mackey (Pulp) and Tim Burgess (The Charlatans). Their performances have been described as magnetic, confrontational, and impossible to categorise.\\n\\nThe band will play a headline show on Thursday 23 April 2026 at The Lexington, with a new single set for release in April 2026. The event is promoted by CLUB.THE.MAMMOTH.\\n\\n'In times when everything seems sewn up, we need someone to tear it apart. In an age of smoothly sellable corporate indie, we need someone to take a knife to the facade... the band stepping up to that challenge are An Experiment On A Bird In The Air Pump.' Simon Price, The Independent\\n\\n'Bad Seeds meet The Shangri-Las nightmare. A No-Wave Ronettes....Bewitching.' NME\\n\\n'Their sound retains something of this primal, basic immediacy, thick, low and urgent. A thousand amateur musical Freudians will tell you that if the guitar is the male instrument then bass, drums, earthbound and heavy rhythm is the female principle.' The Quietus\\n\\n'With a tendency to switch places and take turns behind the mic, they create a sparse, monochrome voodoo rumble, all thick, low, booming bass and primitive tribal rhythms over which they bellow indecipherable lyrics-cum-war-cries, mysterious mantras of female empowerment, like Spice Girls had they teamed up with Southern Death Cult. The Jesus and Mary Chain meet Kim Gordon in a post-apocalyptic world. Watch them through your fingers.\\\"\\n\\nThe Guardian\\n\\nNo front person. No hierarchy. Just bass, drums, and defiance.\\n\\nAn Experiment On A Bird In The Air Pump return in 2025.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762851600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"An Experiment on a Bird in the Air Pump\",\"image\":null,\"artist_id\":\"130054\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-10/5a9c568c-c068-45b5-8302-04498bf081ce.jpg?rect=28%2C0%2C1327%2C1327\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-10/5a9c568c-c068-45b5-8302-04498bf081ce.jpg?rect=0%2C232%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-10/5a9c568c-c068-45b5-8302-04498bf081ce.jpg?rect=355%2C0%2C730%2C1327\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6911da0f841a870001594861\",\"name\":\"An Experiment On A Bird In The Air Pump\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T09:00:00+00:00\",\"sale_end_date\":\"2026-04-23T18:00:00+01:00\",\"sale_start_date\":\"2025-11-11T09:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"xek3mk-an-experiment-on-a-bird-in-the-air-pump-23rd-apr-the-lexington-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2076,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/K6beab8e83b5?dice_id=K6beab8e83b5\",\"post_competition_referral\":\"https://link.dice.fm/Bc2aebf28c2e?dice_id=Bc2aebf28c2e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tce783ae0e5a?dice_id=Tce783ae0e5a\",\"post_purchase_referral\":\"https://link.dice.fm/ec9503e901dc?dice_id=ec9503e901dc\",\"post_reminder_referral\":\"https://link.dice.fm/Vdacc982a10e?dice_id=Vdacc982a10e\",\"post_waitinglist_referral\":\"https://link.dice.fm/g5eea34f3e51?dice_id=g5eea34f3e51\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Your Story\",\"redirect_url\":\"https://open.spotify.com/track/54FZmoGQYhO1D54HxLlh5l\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fc5bd3692bb82ae1b75c9b959829d3d47a061e86?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Your Story\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Action!\",\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"date_unix\":1776967200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lower-third-pply\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"highlights\":[],\"profile_active\":true,\"space_name\":\"The Lower Third (Down)\",\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:27\",\"about\":{\"description\":\"In troubled times, we need artists who will shine a light in the dark, and Millie Manders is emerging as a voice of her generation. Her excellent second album, Wake Up, Shut Up, Work, released on 2 August, is exactly the kind of tonic we need right now. It’s chock-full of ideas, opinions and huge hooks, marinated in teeth-rattling riffs and ska-tinged punk, led by Millie’s huge, emotive, clarion vocal.\\n\\n“When I’m writing, it has to come from my gut,” she says. “Things that trigger me one way or another emotively is how I write. All of it is geared towards something that has angered me, upset me, or made me feel like I need to speak.”\\n\\nOutspoken, potty-mouthed, funny and refreshingly frank, it’s an album that tackles mental health and women’s rights, and nails how hard it is just to exist as a citizen of planet earth in 2024. “There are songs about feeling like you’re absolutely insane, literally sitting inside your brain and looking outside of your skull going, I don’t know if I can escape this. There’s some about mental health and there’s a song about me being so shit poor that I can barely afford to eat.”\\n\\nWith support from All Ears Avow.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762164000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"All Ears Avow\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb26fa22006d590ff0b6e56afd\"},\"artist_id\":\"11101\",\"about\":null,\"is_headliner\":false},{\"name\":\"Millie Manders & The Shutup\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1e97f041956063badfea59f6\"},\"artist_id\":\"66856\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-03/390ba4ec-f65d-443b-aba4-d700633bd605.jpg?rect=0%2C33%2C1166%2C1166\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-03/390ba4ec-f65d-443b-aba4-d700633bd605.jpg?rect=0%2C325%2C1166%2C700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-03/390ba4ec-f65d-443b-aba4-d700633bd605.jpg?rect=212%2C0%2C743%2C1350\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"690887d73e49ac000132c88b\",\"name\":\"Millie Manders and the Shutup\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-03T10:00:00+00:00\",\"sale_end_date\":\"2026-04-23T19:00:00+01:00\",\"sale_start_date\":\"2025-11-07T10:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"nv79k9-millie-manders-and-the-shutup-23rd-apr-the-lower-third-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1650},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/nee6bbacb35d?dice_id=nee6bbacb35d\",\"post_competition_referral\":\"https://link.dice.fm/R5d783e649b1?dice_id=R5d783e649b1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fe8419f02f21?dice_id=Fe8419f02f21\",\"post_purchase_referral\":\"https://link.dice.fm/Hd83286e3414?dice_id=Hd83286e3414\",\"post_reminder_referral\":\"https://link.dice.fm/jf07e310f862?dice_id=jf07e310f862\",\"post_waitinglist_referral\":\"https://link.dice.fm/y9b68059abca?dice_id=y9b68059abca\"},\"previews\":[],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1776967200,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:28\",\"about\":{\"description\":\"Showcasing the best in Country and Americana songwriting talent from across the UK and beyond, the Radio City Sessions are limited-audience events which take you behind the scenes of the songwriting process. Discover the stories behind the songs, get insights into the songwriting craft, and then hear the songs in the most ‘country’ way possible – a guitar and a vocal.\\n\\nThe songwriters' round is a staple of the Nashville music scene, and the Radio City Sessions capture the intimacy of those events, enabling you, the listener, to discover the stories behind the songs. Each artist performs their own music (whether this has been released under their own name or written for another performer) as well as a cover song that has a particular meaning for them.\\n\\nBetween each song, the artists will tell their stories, exploring their songwriting process and chatting with the other artists on the stage. There will be laughter, there will be fun and there may also be some tears!\\n\\nThe night is hosted by The Jackson Line. Over the last few years, the band have been playing and releasing songs from their sophomore EP, California, recorded in Winnipeg, Canada with Juno Award-winning producer Murray Pulver (The Bros. Landreth, Katy Hurt). The first single, Shade of the Pines, featured on Apple Music’s 'Today's Country' editorial playlist, while the second, Gonna Get To You, was showcased on Baylen Leonard's Front Porch on Absolute Country as well as on Countryline Radio.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1742947200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-26/b10bda69-7bcf-42a1-9621-0b8f7ca5d782.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-26/b10bda69-7bcf-42a1-9621-0b8f7ca5d782.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-26/b10bda69-7bcf-42a1-9621-0b8f7ca5d782.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"68f2389c196b1b0001dfc48f\",\"name\":\"Radio City Sessions w/ The Jackson Line\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-03-26T00:00:00+00:00\",\"sale_end_date\":\"2026-04-23T19:00:00+01:00\",\"sale_start_date\":\"2025-03-26T00:15:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\