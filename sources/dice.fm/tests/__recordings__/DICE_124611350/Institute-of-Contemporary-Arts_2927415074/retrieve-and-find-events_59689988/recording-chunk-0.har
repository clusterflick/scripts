ages\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/41a6368f-2cf9-4198-88df-88bc0e4690a5.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/41a6368f-2cf9-4198-88df-88bc0e4690a5.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/41a6368f-2cf9-4198-88df-88bc0e4690a5.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/c5cdd41de6a3?dice_id=c5cdd41de6a3\",\"post_competition_referral\":\"https://link.dice.fm/tce89330bcae?dice_id=tce89330bcae\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qbc45ede0705?dice_id=Qbc45ede0705\",\"post_purchase_referral\":\"https://link.dice.fm/Dfa8ab73e390?dice_id=Dfa8ab73e390\",\"post_reminder_referral\":\"https://link.dice.fm/lc20b5ffbad1?dice_id=lc20b5ffbad1\",\"post_waitinglist_referral\":\"https://link.dice.fm/L0e6643dfa0a?dice_id=L0e6643dfa0a\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:2\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764201600,\"id\":\"692880487a757300013aa94d\",\"name\":\"Mary Coughlan\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"AGMP Concerts presents\\n\\nMARY COUGHLAN\\n\\nin concert\\n\\n\\\\+ special guests: TBC\\n\\n“Honey-voiced Irish National Treasure” MOJO Magazine\\n\\nMary Coughlan is often described as the greatest female vocalist that Ireland has ever produced, standing alongside some of the world’s most iconic jazz singers.\\n\\nShe is unique in blending whisky-blurred, smoke-seared, husky notes with the laconic wit of Billie Holiday and Peggy Lee. She draws the line of deep, down and dirty blues singers back to Bessie Smith with the sardonic, bitter-sweet defiance and despair of Edith Piaf.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1790964000,\"event_tag\":null}],\"title\":\"Fri 02 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3200},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T18:00:00+00:00\",\"sale_end_date\":\"2026-10-04T23:00:00+01:00\",\"sale_start_date\":\"2026-01-15T18:00:00+00:00\",\"event_start_date\":\"2026-10-03T13:00:00+01:00\",\"event_end_date\":\"2026-10-04T23:00:00+01:00\",\"is_multi_days_event\":true,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"py5aaw-decolonise-fest-2026-3rd-oct-signature-brew-blackhorse-road-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":5,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"4259\",\"name\":\"Signature Brew Blackhorse Road\",\"address\":\"Unit 15, Uplands Business Park, Blackhorse Ln, Walthamstow, London E17 5QJ, UK\",\"location\":{\"lat\":51.5915931,\"lng\":-0.0428547},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/22392fd6-55c8-436f-b7c7-be53bd36eea2.jpg?rect=420%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-blackhorse-road-wxbg\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-03T13:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/3b9c5939-e6ad-4065-a9e5-d0caedba66eb.jpg?rect=0%2C0%2C913%2C913\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/3b9c5939-e6ad-4065-a9e5-d0caedba66eb.jpg?rect=0%2C183%2C913%2C548\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/3b9c5939-e6ad-4065-a9e5-d0caedba66eb.jpg?rect=206%2C0%2C502%2C913\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/e2c06e0faa3c?dice_id=e2c06e0faa3c\",\"post_competition_referral\":\"https://link.dice.fm/Df9f3a800199?dice_id=Df9f3a800199\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d55f03233e92?dice_id=d55f03233e92\",\"post_purchase_referral\":\"https://link.dice.fm/t962b4951df8?dice_id=t962b4951df8\",\"post_reminder_referral\":\"https://link.dice.fm/xa5464f69c4b?dice_id=xa5464f69c4b\",\"post_waitinglist_referral\":\"https://link.dice.fm/R8c943033f89?dice_id=R8c943033f89\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:3\",\"properties\":[],\"presented_by\":\"Presented by Decolonise Fest.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768500000,\"id\":\"69667907032f5900013739ff\",\"name\":\"Decolonise Fest 2026\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Decolonise Fest is a London-based music festival created by and for people of colour in the punk scene. Over the weekend we will host music, panels, and workshops that celebrate the contributions of punx of colour.\\n\\n**Ticket pricing explained**\\n\\nLow waged: This ticket is for individuals who struggle to make ends meet, who are unemployed or under employed and struggle to afford basic needs\\n\\nStandard: This ticket is for individuals who are employed, can afford their basic needs, and have access to savings but do not have a lot of money left over at the end of the month\\n\\nSolidarity: This ticket is for individuals who are employed, can afford basic needs, have expendable income, access to savings and still have enough money left at the end of the month.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4412\",\"name\":\"Decolonise Fest\",\"image\":{\"url\":null},\"perm_name\":\"decolonise-fest-qe7p\",\"profile_active\":false},\"date_unix\":1791028800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2194,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T15:00:00+00:00\",\"sale_end_date\":\"2026-10-03T17:00:00+01:00\",\"sale_start_date\":\"2026-01-28T15:00:00+00:00\",\"event_start_date\":\"2026-10-03T18:00:00+01:00\",\"event_end_date\":\"2026-10-03T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"q27vy9-slope-3rd-oct-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Slope - Same Blues\",\"redirect_url\":\"https://open.spotify.com/track/2h6ra8tIJRlDLQIQAo3lRG\",\"artist\":\"Slope\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a2a116b7a12c8440bda5410663e62186adfe7529?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Same Blues\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":71685,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":71686,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":71687,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Slope\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-09/6b9297a6-3f93-4e23-9e9a-815715dcf09b.jpg?rect=245%2C0%2C1228%2C1228\"},\"artist_id\":\"60824\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-03T18:00:00+01:00\",\"doors_close_date\":\"2026-10-03T22:00:00+01:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/4a19136f-9f2b-42fc-aafb-f89b72578cd6.jpg?rect=259%2C0%2C1228%2C1228\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/4a19136f-9f2b-42fc-aafb-f89b72578cd6.jpg?rect=0%2C69%2C1818%2C1091\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/4a19136f-9f2b-42fc-aafb-f89b72578cd6.jpg?rect=572%2C0%2C675%2C1228\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/f7a03fd9994c?dice_id=f7a03fd9994c\",\"post_competition_referral\":\"https://link.dice.fm/l7faf46038b0?dice_id=l7faf46038b0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d70e15d75d10?dice_id=d70e15d75d10\",\"post_purchase_referral\":\"https://link.dice.fm/Vca783388f0f?dice_id=Vca783388f0f\",\"post_reminder_referral\":\"https://link.dice.fm/Sb5b3f39bf80?dice_id=Sb5b3f39bf80\",\"post_waitinglist_referral\":\"https://link.dice.fm/W0c59e73839d?dice_id=W0c59e73839d\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:4\",\"properties\":[],\"presented_by\":\"Presented by DHP FAMILY.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769612400,\"id\":\"697397a6637cfd0001ce356c\",\"name\":\"SLOPE\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Coming up through the underground hardcore scene of Duisburg (Germany) SLOPE channel heavy grooves, raw aggression and the spirit of late 80s and early 90s crossover — drawing from the same DNA that shaped bands like Red Hot Chili Peppers, Rage Against the Machine and Beastie Boys.\\n\\nTheir relationship with live music was formed early on in spaces where shows were brutal, chaotic and magnetic at the same time — teaching the band that intensity and honesty matter more than perfection.\\n\\nOn their upcoming record The Same Kids Just Louder (LP, 2026), SLOPE refine the chaos that has always defined them. Where Street Heat and Freak Dreams felt open and impulsive, the new album gives that energy clearer shape. Built on relentless energy and unabashed fun, the songs are packed with raps and riffs, funk and flow, hooks and heaviness, grooves and grime — but this time with more space to breathe. Repetition is embraced, grooves are allowed to settle, and tracks feel more direct and physical, not because less is happening, but because the essential elements carry more weight. The sound is more focused without losing curiosity: it’s the same drive, sharpened and amplified.\\n\\nThe Same Kids Just Louder isn’t a slogan.\\n\\nIt’s a summary.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1791046800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3902,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T11:00:00+00:00\",\"sale_end_date\":\"2026-10-03T16:00:00+01:00\",\"sale_start_date\":\"2026-01-25T12:00:00+00:00\",\"event_start_date\":\"2026-10-03T18:00:00+01:00\",\"event_end_date\":\"2026-10-03T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sal