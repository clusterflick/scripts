ments/2026-02-13/5fc20141-5d95-48fb-ba14-a0b36a035ef8.jpg?rect=1353%2C0%2C1566%2C2848\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Nd5ce540702d?dice_id=Nd5ce540702d\",\"post_competition_referral\":\"https://link.dice.fm/af5f159cec61?dice_id=af5f159cec61\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Vad6dda38a03?dice_id=Vad6dda38a03\",\"post_purchase_referral\":\"https://link.dice.fm/N3cc03f8c14b?dice_id=N3cc03f8c14b\",\"post_waitinglist_referral\":\"https://link.dice.fm/R7bd3010db13?dice_id=R7bd3010db13\",\"post_reminder_referral\":\"https://link.dice.fm/m1925c10ada5?dice_id=m1925c10ada5\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"*Short Waves Presents:*\\n\\n**BEACH BØNES** are a raucous 4 piece west-coast inspired punk band born out of a need to get back on stage post covid. After the breakdown of their previous bands, longtime friends Jack Purbrick (Drums) and Beau McCarthy (Vocals, Guitar) started jamming with the main aim of getting back on stage and playing some sweat filled, rowdy shows around London. After adding Connecticut cowboy Paul Fiscella (Bass) and Sam Brown (Lead Guitar) to the mix the band has been gigging regularly since february 2023 releasing their first single and music video ‘Self Esteem’ later that year in september.\\n\\nIt was with their 3rd single ‘Bliss’ where the band started to hit their stride, with the release being added to two Spotify editorial playlists ‘All New Punk’ and ‘Today’s Punk’ bringing the band to a wider audience. In 2026 fresh off the back of playing their first european tour and supporting Teen Mortgage, BEACH BØNES are only just getting started. With more songs than they know what to do with and a chip on their shoulder from wasted potential, BEACH BØNES is the soundtrack to your future mistakes.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:14\",\"billing_promoter\":{\"id\":\"2399\",\"name\":\"The Victoria Dalston\",\"image\":{\"url\":null},\"perm_name\":\"the-victoria-dalston-l3wp\",\"profile_active\":false},\"presented_by\":\"Presented by Short Waves.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Beach Bønes\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd9b5713fc80e3002640ab78a\"},\"artist_id\":\"86968\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1771236000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-03-19T18:30:00+00:00\",\"sale_start_date\":\"2026-02-16T10:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:30:00+00:00\",\"event_end_date\":\"2026-03-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"698f6630a426db0001c0ff02\",\"name\":\"Beach Bones + guests \",\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"3owkyx-antslive-19th-mar-colours-hoxton-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773948600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/f0c3a63d-3161-4fcc-9eb5-653314b5574f.jpg?rect=0%2C81%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/f0c3a63d-3161-4fcc-9eb5-653314b5574f.jpg?rect=0%2C241%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/f0c3a63d-3161-4fcc-9eb5-653314b5574f.jpg?rect=136%2C0%2C529%2C962\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/n35dd873e8d2?dice_id=n35dd873e8d2\",\"post_competition_referral\":\"https://link.dice.fm/Zab1e87a720a?dice_id=Zab1e87a720a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X16249067d74?dice_id=X16249067d74\",\"post_purchase_referral\":\"https://link.dice.fm/vb5aa99e3009?dice_id=vb5aa99e3009\",\"post_waitinglist_referral\":\"https://link.dice.fm/n1c72d9ac7d4?dice_id=n1c72d9ac7d4\",\"post_reminder_referral\":\"https://link.dice.fm/c888559476c4?dice_id=c888559476c4\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"839\",\"name\":\"Colours Hoxton\",\"address\":\"2-4 Hoxton Square, London N1 6NU\",\"location\":{\"lat\":51.527453,\"lng\":-0.0816949999999679},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"colours-hoxton-mxew\",\"accessibility\":{\"url\":\"https://colourshoxton.com/wp-content/uploads/2022/02/Colours-Accessibility-Document.pdf\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"AEG Presents\\n\\nAntslive\\n\\nAntsLive has always marched to the beat of his own drum. Defined by a refusal to be boxed in — creatively, culturally, or sonically — he first earned recognition during underground rap’s golden SoundCloud era in 2020. While wider audiences were introduced to him through the viral success of his cinematic single ‘Number 1 Candidate’ in 2023, Ants has been steadily building his artistic foundation for over a decade, emerging as a key figure at the forefront of London’s rap renaissance.\\n\\nBorn in North London to a Sierra Leonean father and a Romanian mother — who met at a salsa class — Ants grew up surrounded by music. Latin American records played at his father’s home, while 70s Motown soundtracked his time with his mother. He credits her academic influence for his sharp articulation and clarity of tone, a defining strength in his music, while his grandmother encouraged him to write poetry from a young age. Early exposure to hip-hop via his older brother’s Limewire downloads — including artists like 50 Cent — helped root Ants firmly in his environment.\\n\\nBefore music, Ants navigated the ruthless academy football system, an experience that shaped his discipline and work ethic. That same professionalism now underpins his approach to music. “Showing up and getting the job done became second nature,” he explains, though he has since learned to balance structure with creative freedom. A true man of the soil, ‘Number 1 Candidate’ was later used to unveil Arsenal’s 23/24 Away Kit — a club he supports passionately — with Ants appearing in the campaign video, cementing his presence at the intersection of football and music.\\n\\nAnts began recording at seventeen, booking studio time with friends already active in London’s rap scene. Early SoundCloud releases quickly gained traction, leading him to form a group with childhood friend Tejy and producer Jay Blu. During the pandemic — while studying philosophy at university — Ants independently wrote, recorded and directed his own visuals, releasing ‘Brown Liquor’ in 2020 to strong online momentum and industry interest.\\n\\nHe continued releasing singles independently, including ‘Tokyo Freestyle’ and ‘Tweakin’, steadily refining a sound that pairs luxurious production with grounded authenticity. While his music often depicts travel, confidence and indulgence, Ants remains committed to reflecting only what he has ived. His breakthrough moment came with ‘Number 1 Candidate’, whose Dolomites-set visual — featuring Ants galloping through mountain landscapes — broke the mould for UK rap videos, bold and brimming with exaggerated bravado.\\n\\nNow firmly established, Ants has embraced collaboration, working with artists such as Sainte, Len and Kairo Keyz, secure in an identity that stands on its own. Following a consistent run of releases including ‘Just A Matter of Time’ (2023) and ‘Real Life’ (2024), Ants entered his next phase with intent.\\n\\nReleased on February 13th, 2026, Ants’ latest EP We Live. marks a clear statement of direction. The project signals his ambitions unapologetically — branching into new territories and global sounds, including Baile Funk, while welcoming exciting features into the fold. We Live. is not just a project,but a declaration. With constant releases planned throughout 2026, alongside bold collaborationsand creative moments, AntsLive is moving forward with clarity, confidence and momentum, ready to claim his place.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:15\",\"billing_promoter\":{\"id\":\"99\",\"name\":\"Colours Hoxton\",\"image\":{\"url\":null},\"perm_name\":\"colours-hoxton-zl3w\",\"profile_active\":false},\"presented_by\":\"Presented by AEG.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"AntsLive\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb4b80d4a863597df628dc94ec\"},\"artist_id\":\"133552\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":35,\"name\":\"the Event Organiser, AEG Presents\",\"privacy_policy_link\":\"https://www.aegpresents.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":627,\"name\":\"Colours\",\"privacy_policy_link\":\"https://colourshoxton.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_