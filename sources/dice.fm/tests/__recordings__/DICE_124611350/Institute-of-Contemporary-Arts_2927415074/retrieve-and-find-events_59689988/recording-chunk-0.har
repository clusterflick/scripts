45056,\"extra_ids\":[\"1151018\"]},{\"ticket_type_id\":1145078,\"extra_ids\":[\"1151018\"]},{\"ticket_type_id\":1194358,\"extra_ids\":[\"1151018\"]}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1250},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-18T10:00:00+00:00\",\"sale_end_date\":\"2026-02-23T19:00:00+00:00\",\"sale_start_date\":\"2025-12-18T10:00:00+00:00\",\"event_start_date\":\"2026-02-23T19:00:00+00:00\",\"event_end_date\":\"2026-02-23T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eobmbd-twat-union-live-signing-23rd-feb-rough-trade-east-london-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Twat Union - Tiny Shorts\",\"redirect_url\":\"https://open.spotify.com/track/3BYzcsgr2otMTqb4Uk6Vnj\",\"artist\":\"Twat Union\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9561eec0edab1151451a96c384496b94a118ea9c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Tiny Shorts\"},{\"type\":\"apple_music\",\"title\":\"Twat Union - Tiny Shorts\",\"redirect_url\":\"https://music.apple.com/us/album/tiny-shorts/1846886034?i=1846886036&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Twat Union\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/d0/38/71/d038710d-1b4e-332d-5300-3bf1f433ed56/mzaf_4586602933853413302.plus.aac.p.m4a\",\"track_name\":\"Tiny Shorts\"}],\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-