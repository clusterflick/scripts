ferral\":\"https://link.dice.fm/e5be5579803b?dice_id=e5be5579803b\",\"post_waitinglist_referral\":\"https://link.dice.fm/W240a8bb90d8?dice_id=W240a8bb90d8\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"dkay3g-the-beatnuts-6th-apr-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775498400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:87\",\"price\":{\"currency\":\"GBP\",\"amount\":2708,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/08c70adf-e87b-4211-9b37-022e97bb82e1.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/08c70adf-e87b-4211-9b37-022e97bb82e1.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/08c70adf-e87b-4211-9b37-022e97bb82e1.jpg?rect=225%2C0%2C550%2C1000\"},\"id\":\"69495d0f74bdc400016b51ec\",\"name\":\"The Beatnuts\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The Doctor’s Orders presents\\n\\nThe Beatnuts\\n\\nSupport from Spin Doctor\\n\\nIt is very rare for group to lay claim to helping to build the foundational blocks of a genre, let alone a genre as popular and successful as Hip-Hop, but The Beatnuts are one of them.\\n\\nConsisting of duo JuJu and Pyscho Les, they're the only Latino-descended duo in the legendary \\\"Native Tongues Collective\\\" which boasts members such as De La Soul, A Tribe Called Quest and Mos Def; therefore-The Beatnuts are certainly in good company. Like the aforementioned groups, they have enjoyed significant commercial success, perhaps most notably with their single \\\"Off the Books\\\" which featured Big Pun and charted in the Billboard top 100.\\n\\nFiercely funky, their distinct style of Jazz tinged, floor filling bangers have always have an indie feel and a crate diggers feel. From the school of rapper / producers they are 100% Hip-Hop and create an unmatched energy on stage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T07:00:00+00:00\",\"sale_end_date\":\"2026-04-06T17:30:00+01:00\",\"sale_start_date\":\"2025-12-22T08:00:00+00:00\",\"event_start_date\":\"2026-04-06T19:00:00+01:00\",\"event_end_date\":\"2026-04-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Off the Books (feat. Big Pun & Cuban Linx)\",\"redirect_url\":\"https://open.spotify.com/track/5qqBsCBwzv0g0xb1kB1TGJ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5a01e1d89a0b05f40a360d2366bef5b902784ee9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Off the Books (feat. Big Pun & Cuban Linx)\"},{\"type\":\"apple_music\",\"title\":\"The Beatnuts - Hot\",\"redirect_url\":\"https://music.apple.com/gb/album/hot/162735227?i=162735281&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Beatnuts\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music/95/36/59/mzm.ntgqdngm.aac.p.m4a\",\"track_name\":\"Hot\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Mon 06 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Arlo Parks\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-10/57fc6b52-a401-4f67-8ade-e28a1684dc4d.jpg?rect=0%2C0%2C4000%2C4000\"},\"artist_id\":\"13958\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":true,\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4MTUyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ5MzAyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo1MC41MDU4MzlaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzUwMSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4MTUyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ5MzAyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo1MC41MDU4NjhaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzUwMiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6OTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":900,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4MTUyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ5MzAyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo1MC41MDU4ODFaIiwicHJpY2UiOjkwMCwidmFyaWFudF9pZCI6MzUwMywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTIwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4MTUyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ5MzAyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo1MC41MDU4OTNaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjM1MDQsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"presented_by\":\"Presented by Rough Trade.\",\"tty_to_extras\":[{\"ticket_type_id\":1175076,\"extra_ids\":[\"1181525\"]},{\"ticket_type_id\":1175077,\"extra_ids\":[\"1181525\"]},{\"ticket_type_id\":1175078,\"extra_ids\":[\"1181525\"]},{\"ticket_type_id\":1175079,\"extra_ids\":[\"1181525\"]},{\"ticket_type_id\":1175080,\"extra_ids\":[\"1181525\"]}],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":17764,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":36018,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":36019,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":17763,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":36015,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":36020,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":36021,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":17765,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":36033,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":36017,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d50000