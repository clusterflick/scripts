re\":\"https://link.dice.fm/R69fb401cb10?dice_id=R69fb401cb10\",\"post_competition_referral\":\"https://link.dice.fm/I834da5805f0?dice_id=I834da5805f0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Cc495d0f1f43?dice_id=Cc495d0f1f43\",\"post_purchase_referral\":\"https://link.dice.fm/sbe90ab2e482?dice_id=sbe90ab2e482\",\"post_reminder_referral\":\"https://link.dice.fm/Ob7fbb5d90bc?dice_id=Ob7fbb5d90bc\",\"post_waitinglist_referral\":\"https://link.dice.fm/r150bc549e7c?dice_id=r150bc549e7c\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T12:00:00+00:00\",\"sale_end_date\":\"2026-02-17T23:00:00+00:00\",\"sale_start_date\":\"2026-02-11T12:00:00+00:00\",\"event_start_date\":\"2026-02-17T20:00:00+00:00\",\"event_end_date\":\"2026-02-17T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":604},\"properties\":[],\"billing_promoter\":{\"id\":\"10177\",\"name\":\"Orii Community\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-04-24/9534f37e-6abf-4a8e-8def-3aeea8ed5b93.jpg\"},\"perm_name\":\"orii-community-gam5\",\"profile_active\":true},\"id\":\"698b7050bc8626000195ef89\",\"seats_io_event_id\":null,\"name\":\"ORII JAM #oriisouth\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"yoalxx-orii-jam-oriisouth-17th-feb-jumbi-london-tickets\",\"date_unix\":1771358400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"5847\",\"name\":\"below Stone Nest\",\"address\":\"136 Shaftesbury Ave, London W1D 5EZ, UK\",\"location\":{\"lat\":51.5129552,\"lng\":-0.1293207},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"below-stone-nest-o6yg\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T20:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"othrwld \",\"image\":null,\"artist_id\":\"35548\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[{\"id\":73912,\"title\":\"Accessibility\",\"body\":\"Stone Nest is an old building and unfortunately 'below' is currently unable to accommodate wheelchair users.\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/196501b7-b4ba-403d-88ad-44deef2ef88e.jpg?rect=103%2C184%2C896%2C896\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/196501b7-b4ba-403d-88ad-44deef2ef88e.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/196501b7-b4ba-403d-88ad-44deef2ef88e.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Othrwld - Thought Trains\",\"redirect_url\":\"https://open.spotify.com/track/6MxeJRT4YQsMR7gGSVR9Ds\",\"artist\":\"Othrwld\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9fc3830d4a30ef8204ad80c22d52686bc09dfb0d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Thought Trains\"},{\"type\":\"apple_music\",\"title\":\"Othrwld - Thought Trains\",\"redirect_url\":\"https://music.apple.com/us/album/thought-trains/1464720992?i=1464720996&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Othrwld\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/7b/32/35/7b3235ce-aeb2-77be-d4bd-b4cb2c5313ab/mzaf_7188365583428809136.plus.aac.p.m4a\",\"track_name\":\"Thought Trains\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770732000,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Othrwld is a producer with a live band that transforms his compositions into a living, breathing experience. Rooted in alternative soul and R&B, with elements of electronic music and jazz, the project exists somewhere between the digital and the human.\\n\\nIMISSMYMOM is the sound of raw emotion slamming into a wall of heavy distortion. This London-based independent five-piece crafts a sonic world to get lost in - where genre boundaries blur, and vulnerability takes the lead. Haunted by deeply personal themes, their music hits hard, making every track feel both cathartic and unrelenting.\\n\\nFree tickets, entry not guaranteed - first-come-first-served so arrive early!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"below Stone Nest\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:26\",\"social_links\":{\"event_share\":\"https://link.dice.fm/w40add2a64a8?dice_id=w40add2a64a8\",\"post_competition_referral\":\"https://link.dice.fm/Rda4495f2d0f?dice_id=Rda4495f2d0f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E4868043eeeb?dice_id=E4868043eeeb\",\"post_purchase_referral\":\"https://link.dice.fm/K75cdd4ea032?dice_id=K75cdd4ea032\",\"post_reminder_referral\":\"https://link.dice.fm/lbb1d40364eb?dice_id=lbb1d40364eb\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z3420782aa23?dice_id=Z3420782aa23\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T14:00:00+00:00\",\"sale_end_date\":\"2026-02-17T19:00:00+00:00\",\"sale_start_date\":\"2026-02-10T17:00:00+00:00\",\"event_start_date\":\"2026-02-17T2