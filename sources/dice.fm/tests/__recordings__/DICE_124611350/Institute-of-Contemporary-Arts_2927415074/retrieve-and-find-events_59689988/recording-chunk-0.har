:null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2229,\"name\":\"Broadside Hacks\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1476463663168370\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"MOTH Club\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"2195325970769692\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780425000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:60\",\"price\":{\"currency\":\"GBP\",\"amount\":1984,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/14eca56d-564d-4f38-ae89-5cb5dab3c641.jpg?rect=0%2C546%2C2433%2C2433\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/14eca56d-564d-4f38-ae89-5cb5dab3c641.jpg?rect=0%2C1033%2C2433%2C1460\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/14eca56d-564d-4f38-ae89-5cb5dab3c641.jpg?rect=247%2C0%2C1939%2C3525\"},\"id\":\"694295c7bf88ce0001c32821\",\"name\":\"Kassi Valazza\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Kassi Valazza crafts songs that glow softly, like streetlights in the fog – lush, lyrical Americana steeped in solitude and self-discovery. Her most recent album, From Newman Street (May 2025, Fluff & Gravy / Loose Music), unfolds like a millennial companion to Joni Mitchell’s Hejira, tracing internal and external landscapes with sharp wit and quiet grace. Written between Portland and her home in New Orleans, and recorded with Matt Thomson at Echo Echo Studios, the album marks both a homecoming and a departure, a reflection on change, restlessness, and growth. Rooted in the rustic romance of the Southwest and the restless realism of the Pacific Northwest, Valazza’s music hums with movement and reflection. These meditative, soul-stirring songs invite listeners into a world where uncertainty becomes its own kind of peace\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T11:00:00+00:00\",\"sale_end_date\":\"2026-06-02T18:00:00+01:00\",\"sale_start_date\":\"2025-12-19T11:00:00+00:00\",\"event_start_date\":\"2026-06-02T19:30:00+01:00\",\"event_end_date\":\"2026-06-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Johnny Dear\",\"redirect_url\":\"https://open.spotify.com/track/0kMl927vwcsAwlnrZdMHGZ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b9e2bcd3dfe1a9150f3468187a3ff80959c00f99?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Johnny Dear\"}],\"score\":0,\"