01c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Night Porter\",\"image\":null,\"artist_id\":\"133489\",\"about\":null,\"is_headliner\":false},{\"name\":\"En Creux\",\"image\":null,\"artist_id\":\"63309\",\"about\":null,\"is_headliner\":false},{\"name\":\"John Macedo\",\"image\":null,\"artist_id\":\"133490\",\"about\":null,\"is_headliner\":false},{\"name\":\"Marshall Stacks\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273d1a927e1a3f2a84e3716cce4\"},\"artist_id\":\"46789\",\"about\":null,\"is_headliner\":false}],\"total_artists\":4,\"total_free_texts\":3},\"about\":{\"description\":\"Marshall Stacks\\n\\nNew York-based, Chicago-born guitarist Marshall Stacks is known for his fusion of mind-bending synthscapes and soaring hard rock riffs.\\n\\nhttps://primordialvoid.bandcamp.com/album/greatest-hits\\n\\nhttps://www.instagram.com/continental_spice/\\n\\nMammal Panic\\n\\nMammal Panic was spawned when sound artist Lydia Morgan had her mind set on fire reading Laurent 'La Peste' Mialon's Flashcore Manifesto, and set out to sculpt her own take on Flashcore as seen through a cracked lens of noise.\\n\\nhttps://soundcloud.com/mammalpanic\\n\\nhttps://www.facebook.com/mammalpanic\\n\\nZheng Hao\\n\\nBorn in Wuhan; based in London. Mostly uses electronics or electro-acoustic instruments for solo and group improvisation, while other times also makes unpleasant computer dance music. Enjoys gritty and gnarly textures as well as delicate, amorphous qualities in different sound and space.\\n\\nhttps://krimkram.bandcamp.com/album/breaks\\n\\nhttps://www.instagram.com/room2n0g/\\n\\nJohn Macedo\\n\\nhttps://www.instagram.com/johnmacedo_/\\n\\nen creux\\n\\nLucia H Chung is a Taiwanese experimental noise artist based in London, United Kingdom.\\n\\nwww.luciahchung.com\\n\\nhttps://www.instagram.com/encreuxmusic/\\n\\nNight Porter\\n\\nTom Wilson is one half of the free noise duo, HIKIKOMORI and founder of the label Death To Dynamics.\\n\\nnightportermusic.bandcamp.com\\n\\nhttps://www.instagram.com/nightportersound/\\n\\nDJ Evan Kerr\\n\\nhttps://www.instagram.com/etherized_delhaize/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T00:00:00+00:00\",\"sale_end_date\":\"2026-03-05T17:00:00+00:00\",\"sale_start_date\":\"2026-02-03T00:00:00+00:00\",\"event_start_date\":\"2026-03-05T18:00:00+00:00\",\"event_end_date\":\"2026-03-05T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69821635d3128900014ceb3c\",\"name\":\"Marshall Stacks\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/085a701d-be99-4e27-8a16-d643b7657b11.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/085a701d-be99-4e27-8a16-d643b7657b11.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/085a701d-be99-4e27-8a16-d643b7657b11.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770076800,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/f30353998771?dice_id=f30353998771\",\"post_competition_referral\":\"https://link.dice.fm/G404f29ecb85?dice_id