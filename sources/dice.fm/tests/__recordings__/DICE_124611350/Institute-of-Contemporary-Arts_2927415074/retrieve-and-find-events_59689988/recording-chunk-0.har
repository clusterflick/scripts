BP\",\"amount\":5820,\"sales_tax\":0,\"amount_from\":null},\"id\":\"681b7c4674a1bd0001d21709\",\"name\":\"Booker T. Jones\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Booker T. Jones\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/bb06f6add922f3a0d22b1f64f4e862b7837dfe7b\"},\"artist_id\":\"40374\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"l86qop-booker-t-jones-17th-apr-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-05-07/afaa5b06-2187-4647-ab64-88b946bba055.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-05-07/afaa5b06-2187-4647-ab64-88b946bba055.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-05-07/afaa5b06-2187-4647-ab64-88b946bba055.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Ace Records 50th Anniversary Concert Series presents\\n\\nBOOKER T. JONES\\n\\n(of Booker T & The MG's)\\n\\n\\\\+ special guests\\n\\nAs leader of the legendary Booker T. & The MG's, Rock and Roll Hall of Fame inductee, GRAMMY lifetime achievement award recipient Booker T. Jones is arguably the most famous Hammond B3 player in History.\\n\\nWorking alongside Otis Redding, Albert King and more at Stax Records, Booker T. Jones has also worked with Willie Nelson, Wilson Pickett, Sam & Dave, Bill Withers and countless others.\\n\\nDo not miss this chance to catch one of the finest musicians of all time as part of the Ace Records 50th Anniversary Concerts Series.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabl