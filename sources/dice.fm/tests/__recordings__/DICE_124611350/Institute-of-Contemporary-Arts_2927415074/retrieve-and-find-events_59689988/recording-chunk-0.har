38000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-03/ffe63253-9afa-4ad6-b624-18a6490a4f06.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-03/ffe63253-9afa-4ad6-b624-18a6490a4f06.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-03/ffe63253-9afa-4ad6-b624-18a6490a4f06.jpg?rect=243%2C0%2C594%2C1080\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Z3ad2d589c05?dice_id=Z3ad2d589c05\",\"post_competition_referral\":\"https://link.dice.fm/R3f2f24fefe5?dice_id=R3f2f24fefe5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Wc9e34db489e?dice_id=Wc9e34db489e\",\"post_purchase_referral\":\"https://link.dice.fm/S55b391b1722?dice_id=S55b391b1722\",\"post_waitinglist_referral\":\"https://link.dice.fm/u9b8d97458e9?dice_id=u9b8d97458e9\",\"post_reminder_referral\":\"https://link.dice.fm/yf3ab4cb1f57?dice_id=yf3ab4cb1f57\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"5029\",\"name\":\"GlassBox Theatre\",\"address\":\"MidKent College, Medway rd, Gillingham, England ME7 1FN, United Kingdom\",\"location\":{\"lat\":51.393589,\"lng\":0.541839},\"image\":null,\"city\":{\"id\":\"61c214222421318625d0248d\",\"name\":\"Gillingham\",\"location\":{\"lat\":51.370419,\"lng\":0.534572,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"glassbox-theatre-gya6\",\"accessibility\":{\"url\":\"https://www.glassboxtheatre.com/facilties\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"AGMP presents\\n\\nTHE STYLE COUNCILLORS\\n\\n'Our Favourite Shop' 40th Anniversary Tour\\n\\nThe Style Councillors are the world’s one and only tribute to The Style Council.\\n\\n'Our Favourite Shop' is the second studio album by The Style Council released in 1985. The Style Councillors will be celebrating this classic LP by performing selections from the album aswell as the hits and fan favourites of The Style Council.\\n\\nFormed in 2013 by Darren Fletcher (Paul Weller) and Steve Hayes (Mick Talbot), The Style Councillors have quickly built a loyal fanbase for the group which was Paul Weller’s home for the majority of the 1980’s and where he wrote some of his finest songs. Dani Clay (Dee C. Lee) and Craig Read (Steve White) are joined by the Bad Manners Horn Section and a stellar line up of musicians hell-bent on recreating the sound of The Style Council.\\n\\nAfter the dissolution of The Jam in 1982, Paul Weller joined forces with Mick Talbot, formerly of The Merton Parkas, Dexys Midnight Runners and The Bureau, to form The Style Council. The band released a string of succesful singles between 1983-1989 such as Speak Like a Child, Money-Go-Round, Long Hot Summer, My Ever Changing Moods, You’re The Best Thing, Shout To The Top, Walls Come Tumbling Down, A Solid Bond In Your Heart, Come To Milton Keynes, The Lodgers, Why I Went Missing, and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:50\",\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"presented_by\":\"Presented by AGMP.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Style Councillors\",\"image\":null,\"artist_i