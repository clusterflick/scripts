eview_url\":\"https://p.scdn.co/mp3-preview/dd4f78dcb7895a7c3d3b14f54b6a27c6ea8fe298\",\"track_name\":\"Waves\"},{\"type\":\"apple_music\",\"title\":\"The Dear Hunter - Waves\",\"redirect_url\":\"https://music.apple.com/us/album/waves/1000682691?i=1000683486&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Dear Hunter\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/4d/2a/a0/4d2aa088-2fbd-a754-0255-30639b5284a2/mzaf_666147797678970146.plus.aac.p.m4a\",\"track_name\":\"Waves\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1746021600,\"max_tickets\":6,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nThe Dear Hunter, known musically for their intricate storytelling through the band’s music, recently celebrated twenty years as a band. Over the course of their career, The Dear Hunter has released eight studio albums, five label albums, fifteen EPs, as well as instrumental, orchestral and reimagined recordings. Most recently, the band worked with cinematographer Justin DeLuna, and author/actor Dustin Reade to create “North American Tour 2023”, a film that starts as a typical tour documentary that evolves into a surreal and abstract work of fiction, directed by the band’s Casey Crescenzo.\\n\\nThe Dear Hunter has spent the last two decades building a passionate fanbase, touring globally, honing their craft as musicians, challenging themselves in the studio, and pushing the creative boundaries of what it means to be a band.\\n\\nThe Dear Hunter is Casey Crescenzo, Rob Parr, Nick Sollecito, Nick Crescenzo, Max Tousseau, and Aiden Earley.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by FORM.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:71\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Jf75e6e1cfa9?dice_id=Jf75e6e1cfa9\",\"post_competition_referral\":\"https://link.dice.fm/xe1b5a0f28c8?dice_id=xe1b5a0f28c8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z906243da3d8?dice_id=z906243da3d8\",\"post_purchase_referral\":\"https://link.dice.fm/Y8bb82527f1b?dice_id=Y8bb82527f1b\",\"post_reminder_referral\":\"https://link.dice.fm/I91983075c8a?dice_id=I91983075c8a\",\"post_waitinglist_referral\":\"https://link.dice.fm/xfd4e18a170b?dice_id=xfd4e18a170b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-30T15:00:00+01:00\",\"sale_end_date\":\"2026-09-22T19:30:00+01:00\",\"sale_start_date\":\"2025-05-02T10:00:00+01:00\",\"event_start_date\":\"2026-09-22T19:30:00+01:00\",\"event_end_date\":\"2026-09-22T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"rescheduled\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2704},\"properties\":[],\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"id\":\"6810fce237f5440001c494ae\",\"seats_io_event_id\":null,\"name\":\"The Dear Hunter\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"oex77y-the-dear-hunter-22nd-sep-earth-london-tickets\",\"date_unix\":1790101800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Tue 22 Sep\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-24T19:00:00+01:00\",\"doors_close_date\":\"2026-09-24T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Holy Fuck\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-10-25/44d8b972-73fa-4445-bb52-6dcd97a5e2cd.jpg?rect=912%2C0%2C3648%2C3648\"},\"artist_id\":\"3123\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/577d0dba-3d35-4ec0-ad3e-85a8c4d2361e.jpg?rect=0%2C0%2C3300%2C3300\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/577d0dba-3d35-4ec0-ad3e-85a8c4d2361e.jpg?rect=0%2C660%2C3300%2C1980\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/577d0dba-3d35-4ec0-ad3e-85a8c4d2361e.jpg?rect=743%2C0%2C1815%2C3300\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Tom Tom\",\"redirect_url\":\"https://open.spotify.com/track/0A4h2TlchiHN2OkC0yXe3Y\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9043f5c4e7004677aeda873428b236430d9b9bdb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Tom Tom\"},{\"type\":\"apple_music\",\"title\":\"Holy Fuck - Casio Bossa Nova\",\"redirect_url\":\"https://music.apple.com/gb/album/casio-bossa-nova/92516489?i=92516069&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Holy Fuck\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music5/v4/1e/5e/8a/1e5e8a9d-ccda-6ad9-1535-311564d8ba74/mzaf_52301007303798745.plus.aac.p.m4a\",\"track_name\":\"Casio Bossa Nova\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768467600,\"max_tickets\":6,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"At a time when even entire classic rock bands are being AI generated, Holy Fuck are now more relevant than ever. The Canadian quartet have forged their reputation for making electronic music with a human touch. While many artists create that core electronic sound via laptops, loops and drum machines, Holy Fuck keep every element as live as possible. The intoxication they inspire comes not from cold, staid perfection, but from the ragged energy that comes from four musicians relishing sharing a moment. Factor in the chaos born from improvisation and skipping a click track in favour of loose, raw, real percussion, and it’s easy to see why Holy Fuck are renowned for their pulsating, unorthodox thrills.\\n\\nAs the passage of time marches to its own relentless beat, it’s almost frightening to note that it has been six years since their previous set, 2020’s Deleter. Given the well-documented events that followed that year, the normally road-weary band — Brian Borcherdt, Graham Walsh, Matt ‘Punchy’ McQuaid and Matt Schulz — spent two years entirely apart from each other.\\n\\nIn March 2022, they finally reconvened in an old village hall in rural Nova Scotia. The main purpose was simply to reunite and rehearse, but new song ideas soon flowed out of them. That became the starting point for their upcoming album Event Beat.\\n\\n“The catalyst for this record and the beginning of the recordings that we did was us just getting back together again,” states Graham. “It was something unique to us. It was all of us living together in one space with no distractions, just working on music in the middle of nowhere. It’s a way I really like to work. For at least half of the songs on the record, it was just us holed up together, which was great!”\\n\\nIntuition, muscle memory, an almost telepathic link — call it what you will, but the shared synapses between the quartet were soon firing again. “Having our own language that we can speak so easily together is really important to us,” asserts Brian. “We all have our own piece to bring to the conversation, and it’s idiosyncratic to us because we’ve been dedicated to it for so long. Hopefully that’s encouraging to other bands who feel like they’re on a similar path.”\\n\\nNonetheless, there were challenges. At one point a storm knocked out the power, forcing them to start up a generator. More importantly was the presence of a local who objected to the volume of their sessions. You can talk long into the night about musical influences, but nothing shapes the direction of a record quite like the practical obstacle of having to placate a neighbour.\\n\\n“That became a production challenge,” notes Graham. “We still wanted to jam, but while being as quiet as possible. Matt couldn’t hit the drums really loud, so we made these more low-key ambient things. It was like, how quiet can we be and still do what we do?”\\n\\nBrian concurs. “We were making these quite pastoral, vibey soundscapes, and I thought we were going to have an ambient record on our hands. I thought this was going to be almost like new age music or something.”\\n\\nHitting play on Event Beat reveals that Holy Fuck totally circumvented that idea, as opening track ‘Evie’ swirls between pulsating bass, punk-funk grooves and luminous synth flourishes to offer a hypnotic calling card for the rest of the album. It was an idea that dated back to 2016’s Congrats and was salvaged after Brian spent six years listening to its initial form on headphones until they could unlock what made it work. It also provides what he calls an “infinity loop” or a “streaming hack” for fans who play the album on repeat, as the end of the final song, the title track, loops straight into the ‘Evie’ intro.\\n\\nAt the other extreme, ‘Gold Flakes’ is a typical “Holy Fuck studio jam” driven by Matt McQuaid’s rolling bass. Its dreamy Krautrock march is given additional flair with a flurry of musique concrète-style sound collage elements that unveil more details with each repeated listen. Instigating movement more than provoking the mind is the swaggering ‘Czar’, full of popping J Dilla–ish bass, happy accidents and random chaos that is already proving a challenge as they plan future live shows. As Brian sighs, “I’ll have to get really tight with my imperfections.”\\n\\n‘Elevate’ leans most heavily into those new age preconceptions, but with Holy Fuck being Holy Fuck it soon detours into the unexpected, layering fresh sonic elements at every turn. “I really like those epic techno songs like Orbital and Underworld,” smiles Graham. “This was my attempt at something like that — just dancefloor euphoria.”\\n\\nThroughout the record, the vocals drift through the ether like a conversation with an imaginary friend. There’s no overarching concept, but Brian highlights a recurring motif of momentum “towards something that is beyond personal control, either at the mercy of some bigger system or some unspoken will.” While Deleter leaned on guest vocals more than ever, this time they’re conspicuous only by their absence. There was no grand strategy — just the realisation that the record excelled without them. Brian did, however, call on two members of his spacious semi-classical ambient project Quilting: Mairi Chaimbeul, who contributed harp to the title track ‘Event Beat’, and Sahara Jane Nasr, who plays the South Asian violin-like instrument, the sārangī.\\n\\nThe album also emerged in the wake of an unexpected Holy Fuck rediscovery after ‘Tom Tom’ featured in a key scene in Amazon Prime Video hit animated series Invincible. It’s now their most streamed track, with twelve times the number of plays of its nearest competitor. Brian and Graham recall a discussion with their then-label, who were somewhere between curious and indifferent about their choice of ‘Tom Tom’ as a lead single for Congrats. “There’s something validating when something happens years later for such a random reason that you wouldn’t have predicted,” Brian reflects.\\n\\nThe unpredictable struck again when ‘Lost Cool’ resurfaced in the Academy Award–winning body horror The Substance. Graham took the opportunity to see it on the big screen. “I was in the big theatre watching it, remembering back to listening to the demo I made of just the drum beat and synth bassline in my car, cranked up while driving through Toronto — just thinking, this is fun. It’s kind of cool to put it all into perspective and have that cycle happen.”\\n\\nBetween those spotlight moments and the vibrancy of Event Beat, it’s clear that Holy Fuck are as relevant as ever. It can’t be attributed to any single factor. Perhaps it’s their conviction to keep going and stick to their guns regardless of music’s latest trends. Maybe it’s the pure compulsion to continue even after many early peers have drifted away. Or it could be their example to younger musicians that playing live, off the floor, can still be a creative thrill — as demonstrated by their incoming At Work video performance series.\\n\\n“What I hope people take away from it is an appreciation of the togetherness and humanity in the music,” concludes Graham. “Music should be played and enjoyed together. When that raw punk sound comes off the stage, you should just enjoy it and relish that experience. It’s wonderful and awesome.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Dollop.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:72\",\"social_links\":{\"event_share\":\"https://link.dice.fm/ieff3abdaaee?dice_id=ieff3abdaaee\",\"post_competition_referral\":\"https://link.dice.fm/sda4ad868d23?dice_id=sda4ad868d23\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/je01d1a834bc?dice_id=je01d1a834bc\",\"post_purchase_referral\":\"https://link.dice.fm/yd2ad552b168?dice_id=yd2ad552b168\",\"post_reminder_referral\":\"https://link.dice.fm/i5a28c28e4aa?dice_id=i5a28c28e4aa\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y3595d35fc49?dice_id=Y3595d35fc49\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T09:00:00+00:00\",\"sale_end_date\":\"2026-09-24T18:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-09-24T19:00:00+01:00\",\"event_end_date\":\"2026-09-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2310,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"id\":\"6967bb5caeaf9700019ca026\",\"seats_io_event_id\":null,\"name\":\"HOLY FUCK\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"6dnbd3-holy-fuck-24th-sep-scala-london-tickets\",\"date_unix\":1790272800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-24T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Peter Bruntnell\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb83280e193e4322e8dbda7998\"},\"artist_id\":\"18992\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/831ce91f-854e-4185-909f-d87217aba61f.jpg?rect=10%2C0%2C881%2C881\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/831ce91f-854e-4185-909f-d87217aba61f.jpg?rect=0%2C171%2C900%2C540\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/831ce91f-854e-4185-909f-d87217aba61f.jpg?rect=208%2C0%2C485%2C881\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Dandelion\",\"redirect_url\":\"https://open.spotify.com/track/6ZeNG0qKD8xm0CJOX0MKW6\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c02f01f90ccde1dc241efc67d9b3e714a7fbbfd4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dandelion\"},{\"type\":\"apple_music\",\"title\":\"Peter Bruntnell - Broken Wing\",\"redirect_url\":\"https://music.apple.com/gb/album/broken-wing/1455512769?i=1455512770&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Peter Bruntnell\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/e9/f1/ad/e9f1add9-57fa-2c52-a3a0-eb0710098e00/mzaf_8022813019765378763.plus.aac.p.m4a\",\"track_name\":\"Broken Wing\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769990400,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"In an uncertain number of years time, it will be acceptably cool to say that you first got into non-Grammy-winning artist Peter Bruntnell through his classic 2024 album Houdini And The Sucker Punch, before then going back and discovering his back catalogue of yet more “classics”. And you were there! You saw him live. You were one of those “10” people who saw him play in that modestly-sized room, almost 30 years into his career.\\n\\nThree years on, another album into Peter’s 13 or 14 album catalogue and shouldering the burden of even more sublime reviews. Every possible positive adjective has been called into play, although it must be noted that the word “sublime” can never be used enough. Not even 2021’s primarily solo, slightly synthy lockdown album succeeded in putting an end to his non-success, despite Mojo echoing the plea that, “Somehow, some way, this cult and infinitely class songwriter must get his due wider recognition”. The Scottish Daily Express with its 5 star review, slightly frustrated, said, or perhaps yelled, “I’m getting tired of saying this: He’s brilliant”. The Irish Times thoughtfully combined two quotes into one, saving us the trouble of going back and getting crushed under the sheer weight of Peter’s archive of press quotes: “With Journey To The Sun, the man whose songs NME once noted should be placed on school curriculums has done it again.” And he continues to do so.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Black Frog\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:73\",\"social_links\":{\"event_share\":\"https://link.dice.fm/N23aae094222?dice_id=N23aae094222\",\"post_competition_referral\":\"https://link.dice.fm/z26f3140c24c?dice_id=z26f3140c24c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a5016fa3bc21?dice_id=a5016fa3bc21\",\"post_purchase_referral\":\"https://link.dice.fm/d49ef46705d6?dice_id=d49ef46705d6\",\"post_reminder_referral\":\"https://link.dice.fm/P418a433aa10?dice_id=P418a433aa10\",\"post_waitinglist_referral\":\"https://link.dice.fm/pff6bdc88993?dice_id=pff6bdc88993\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-09-24T19:30:00+01:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-09-24T19:00:00+01:00\",\"event_end_date\":\"2026-09-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6980f7910263440001bd7414\",\"seats_io_event_id\":null,\"name\":\"Pete Bruntnell Band\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"wwe36r-pete-bruntnell-band-24th-sep-hot-box-chelmsford-tickets\",\"date_unix\":1790272800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-24T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Exploring Birdsong\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-14/9ae7bc07-b3b7-4275-82cb-443b0b459946.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"26387\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-02/7c124d1a-9fbf-4e67-b2fa-f5974e388d6b.jpg?rect=613%2C0%2C2451%2C2451\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-02/7c124d1a-9fbf-4e67-b2fa-f5974e388d6b.jpg?rect=0%2C123%2C3677%2C2206\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-02/7c124d1a-9fbf-4e67-b2fa-f5974e388d6b.jpg?rect=1165%2C0%2C1348%2C2451\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1762336800,\"max_tickets\":8,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Exploring Birdsong are stepping into a new era with their stunning new single ‘Romanticise’.\\n\\nThe alt-pop trio, centred on Lynsey Ward’s stunning vocals, showcase a richer and more expansive element with their newest eﬀort – a mature evolution from the organic rawness of their piano-led roots.\\n\\nDespite the shift in sound first signalled with the acclaimed 2024 singles The Collapse, Weight in Gold, All I Lack, and Stitch, the three-piece haven’t sacrificed any of the emotional intimacy or genre-blending beauty that sets them apart.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Born Again Concerts.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:74\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Red8521d79b3?dice_id=Red8521d79b3\",\"post_competition_referral\":\"https://link.dice.fm/s46a8b70ff02?dice_id=s46a8b70ff02\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jc7ff855f3ba?dice_id=jc7ff855f3ba\",\"post_purchase_referral\":\"https://link.dice.fm/N1b9da400693?dice_id=N1b9da400693\",\"post_reminder_referral\":\"https://link.dice.fm/G31d4b2533d4?dice_id=G31d4b2533d4\",\"post_waitinglist_referral\":\"https://link.dice.fm/la6496b78080?dice_id=la6496b78080\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T10:00:00+00:00\",\"sale_end_date\":\"2026-09-24T21:00:00+01:00\",\"sale_start_date\":\"2025-11-07T10:00:00+00:00\",\"event_start_date\":\"2026-09-24T19:00:00+01:00\",\"event_end_date\":\"20