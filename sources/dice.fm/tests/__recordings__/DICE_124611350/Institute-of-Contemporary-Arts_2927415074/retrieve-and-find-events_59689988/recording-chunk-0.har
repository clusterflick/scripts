//link.dice.fm/Me245ae01e81?dice_id=Me245ae01e81\",\"post_purchase_referral\":\"https://link.dice.fm/A5eee5f6d800?dice_id=A5eee5f6d800\",\"post_reminder_referral\":\"https://link.dice.fm/h2ae0c7bb6e2?dice_id=h2ae0c7bb6e2\",\"post_waitinglist_referral\":\"https://link.dice.fm/zcf23c3f0f76?dice_id=zcf23c3f0f76\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yopbb2-yn-yn-18th-apr-earth-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2089,\"name\":\" The Columbo Group\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"556297964005636\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1776535200,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:22\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2704},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-25/169e5ae4-dfcd-438e-8167-ac57b3500159.jpg?rect=247%2C0%2C1006%2C1006\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-25/169e5ae4-dfcd-438e-8167-ac57b3500159.jpg?rect=0%2C53%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-25/169e5ae4-dfcd-438e-8167-ac57b3500159.jpg?rect=474%2C0%2C553%2C1006\"},\"id\":\"68d5090486aa7e00014af8d8\",\"name\":\"Yīn Yīn \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nGlobal psych rockers YĪN YĪN are on top of the world with their upcoming London show and the release of their fourth album Yatta!\\n\\nExtending their unique mix of disco, funk, psychedelia and Southeast Asian music, the Dutch quartets grooves just keeps getting deeper.\\n\\nOver the last six years, the quartet hailing from Holland, has built a powerful reputation for balancing an eclectic range of disparate influences and using them to forge something that is both affectionately retro and, at the same time, fresh and forward-facing.\\n\\nFrom the beginning, YĪN YĪN have been devoted to exploring obscure global sounds with an emphasis on getting the dance floor moving. Four musicians finding their own, exploratory, globe-trotting groove, and having the time of their lives exploring it. Lucky for you, you’re invited too, as we take them to London’s EartH Hall.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-25T10:00:00+01:00\",\"sale_end_date\":\"2026-04-18T19:00:00+01:00\",\"sale_start_date\":\"2025-09-26T10:00:00+01:00\",\"event_start_date\":\"2026-04-18T19:00:00+01:00\",\"event_end_date\":\"2026-04-18T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"One Inch Punch\",\"redirect_url\":\"https://open.spotify.com/track/6BdpQ5lDOUNbaER31ajumE\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9762210a366b4a4d32d70fb3497193f044846aa6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"One Inch Punch\"},{\"type\":\"apple_music\",\"title\":\"Yin Yin - Lotus\",\"redirect_url\":\"https://music.apple.com/us/album/lotus/1487604128?i=1487604135&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Yin Yin\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/4e/48/7c/4e487c84-bd1d-8bc9-eab9-26c76df53c0c/mzaf_15341577402920106834.plus.aac.p.m4a\",\"track_name\":\"Lotus\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-18T18:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"announcement_date_unix\":1769731200,\"social_links\":{\"event_share\":\"https://link.dice.fm/x2cca6e73297?dice_id=x2cca6e73297\",\"post_competition_referral\":\"https://link.dice.fm/G330f4e5edad?dice_id=G330f4e5edad\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q69f2028934c?dice_id=Q69f2028934c\",\"post_purchase_referral\":\"https://link.dice.fm/Veb740a674c1?dice_id=Veb740a674c1\",\"post_reminder_referral\":\"https://link.dice.fm/X29cb9148451?dice_id=X29cb9148451\",\"post_waitinglist_referral\":\"https://link.dice.fm/H10188b08a99?dice_id=H10188b08a99\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"av387v-daniel-john-martin-trio-gypsy-jazz-legends-18th-apr-toulouse-lautrec-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776535200,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:23\",\"price\":{\"currency\":\"GBP\",\"amount\":3894,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=420%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/131f99f1-24fe-4668-90ec-80b1dec315c0.jpg?rect=663%2C0%2C594%2C1080\"},\"id\":\"697cf4aecf6295000125d73d\",\"name\":\"Daniel John Martin Trio | Gypsy Jazz Legends\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"World-Class Gypsy Jazz – Direct from Paris\\n\\nExperience a spectacular evening of world-class gypsy jazz as Paris-based violin virtuoso Daniel John Martin joins forces with guitar masters Adrien Moignard and Julien Cattiaux. This one-night-only collaboration delivers incredible technique, irresistible swing and the distinctive spirit of Parisian jazz.\\n\\nDaniel John Martin, Paris-based jazz violinist originally from England, is a leading figure of the international gypsy jazz violin world. Deeply inspired by the lineage of Stéphane Grappelli and Didier Lockwood, his playing combines lyrical elegance, strong swing, and a highly personal improvisational voice.\\n\\nOn guitar, Adrien Moignard stands among the most influential gypsy jazz players of his generation. Rooted in the tradition of Django Reinhardt and renowned for his exceptional technique and advanced harmonic language, he brings a modern, inventive edge to the tradition while maintaining a powerful sense of swing and melodic depth.\\n\\nCompleting the trio, Julien Cattiaux provides the essential rhythmic heartbeat with his impeccable la pompe. A master of gypsy jazz rhythm guitar, his precision, drive, and musical sensitivity create the perfect framework for interaction, groove, and spontaneity.\\n\\nTogether, the trio delivers an intense, elegant, and deeply swinging performance, where virtuosity serves musical conversation and tradition meets contemporary expression.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T00:00:00+00:00\",\"sale_end_date\":\"2026-04-18T18:00:00+01:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-04-18T19:00:00+01:00\",\"event_end_date\":\"2026-04-18T20:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Daniel John Martin, Mayo Hubert, Julien Cattiaux & Claudius Dupont - Levallois Swing\",\"redirect_url\":\"https://music.apple.com/us/album/levallois-swing/1564359146?i=1564359148&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Daniel John Martin, Mayo Hubert, Julien Cattiaux & Claudius Dupont\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/c7/28/54/c728544f-de83-69bc-a75c-8cf3fd388a0e/mzaf_5044543060629089812.plus.aac.p.m4a\",\"track_name\":\"Levallois Swing\"},{\"type\":\"spotify\",\"title\":\"Adrien Moignard - La valse d'Augustine\",\"redirect_url\":\"https://open.spotify.com/track/5mTOIpBYeiFxmMzffumR9S\",\"artist\":\"Adrien Moignard\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fd5caee706141ffdf035f186ce2aa3c96547ddd6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"La valse d'Augustine\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rules\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9b678b0a34b2b9fb23404f8f\"},\"artist_id\":\"132979\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Broadwick Live. \",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72373,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 18+ event. Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"ven