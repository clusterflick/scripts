date\":\"2026-01-29T00:00:00+00:00\",\"event_start_date\":\"2027-01-18T19:00:00+00:00\",\"event_end_date\":\"2027-01-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by 229.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Te7955f10869?dice_id=Te7955f10869\",\"post_competition_referral\":\"https://link.dice.fm/Mb93dcdc2306?dice_id=Mb93dcdc2306\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/bdfe107c7454?dice_id=bdfe107c7454\",\"post_purchase_referral\":\"https://link.dice.fm/i1c79306453d?dice_id=i1c79306453d\",\"post_reminder_referral\":\"https://link.dice.fm/kfc75e595428?dice_id=kfc75e595428\",\"post_waitinglist_referral\":\"https://link.dice.fm/W6bd8f4fa9e8?dice_id=W6bd8f4fa9e8\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**JANUARY BLUES FESTIVAL 2027 presents**\\n\\n**BAND OF FRIENDS feat. Gerry McAvoy celebrate the music of Rory Gallagher**\\n\\n**\\\\+ SPECIAL GUESTS**\\n\\n**DJ SNOWBOY**\\n\\nThe January Blues Festival celebrates it's 10th anniversary year with the welcome return of Band of Friends with original Rory Gallagher bassist Gerry McAvoy and friends performing the music of Rory Gallagher.\\n\\nIrish Blues-Rock guitarist, songwriter Rory Gallagher started out in R&B power trio Taste in 1966. Taste supported Cream and Blind Faith before splitting in 1970 after their appearance at the Isle of Wight Festival. Rory Gallagher starting touring under his own name alongside bassist Gerry McAvoy to huge success before Rory's untimely passing in 1995.\\n\\nHost and DJ for the January Blues Festival is Snowboy playing Chicago Blues, Rhythm & Blues, Blues Rock and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1800298800,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-01-18T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:73\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"id\":\"697b76ad1b04b6000138b16f\",\"name\":\"January Blues Festival: BAND OF FRIENDS\",\"perm_name\":\"3ogb6p-january-blues-festival-band-of-friends-18th-jan-229-london-tickets\",\"