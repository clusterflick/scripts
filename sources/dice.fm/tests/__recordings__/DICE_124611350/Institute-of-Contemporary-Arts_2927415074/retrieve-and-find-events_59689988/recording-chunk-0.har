,\"donation\":null,\"billing_promoter\":{\"id\":\"1503\",\"name\":\"Southbank Centre\",\"image\":{\"url\":null},\"perm_name\":\"southbank-centre-lqob\",\"profile_active\":true},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:36\",\"date_unix\":1783881000,\"price\":{\"currency\":\"GBP\",\"amount\":5900,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Ve5ee55e269e?dice_id=Ve5ee55e269e\",\"post_competition_referral\":\"https://link.dice.fm/K18d8d739e3e?dice_id=K18d8d739e3e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kae80dd0bbc9?dice_id=kae80dd0bbc9\",\"post_purchase_referral\":\"https://link.dice.fm/N623267e3746?dice_id=N623267e3746\",\"post_reminder_referral\":\"https://link.dice.fm/Kbb1b7dd5298?dice_id=Kbb1b7dd5298\",\"post_waitinglist_referral\":\"https://link.dice.fm/V641831ca111?dice_id=V641831ca111\"},\"perm_name\":\"l8or2r-the-divine-comedy-12th-jul-royal-festival-hall-southbank-centre-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/dba45216-8370-4953-8eed-102d394bbb10.jpg?rect=0%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/dba45216-8370-4953-8eed-102d394bbb10.jpg?rect=0%2C200%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/dba45216-8370-4953-8eed-102d394bbb10.jpg?rect=225%2C0%2C550%2C1000\"},\"properties\":[],\"about\":{\"description\":\"Hear wide-ranging, irresistible music from the band fronted by songwriter and driving force Neil Hannon.\\n\\nTickets also available through the Southbank Centre website: https://www.southbankcentre.co.uk/whats-on/the-divine-comedy/\\n\\nWith 13 albums, and songs including ‘Our Mutual Friend’, ‘A Lady of a Certain Age’ and ‘To the Rescue’, under his belt, Hannon’s trademark orchestral pop, intelligent lyrics and legendary live shows have turned him into something of a national treasure.\\n\\n2025 saw the release of the 13th Divine Comedy album, Rainy Sunday Afternoon. Recorded at Abbey Road, it exquisitely covers Hannon’s usual range of emotions: sad, funny, angry and everything in between.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69315e79f6e27a00015091e7\",\"name\":\"The Divine Comedy\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Divine Comedy - Achilles\",\"redirect_url\":\"https://open.spotify.com/track/5SGdcaDIj4uwzfLaIIxANV\",\"artist\":\"The Divine Comedy\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5893342753ab330499241c12b583022dc33aa02b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Achilles\"},{\"type\":\"apple_music\",\"title\":\"The Divine Comedy - Achilles\",\"redirect_url\":\"https://music.apple.com/us/album/achilles/1803200610?i=1803200614&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Divine Comedy\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/e8/48/29/e848294c-66d6-8d5d-e8df-a61d1dbe1b25/mzaf_16176301466356895806.plus.aac.p.m4a\",\"track_name\":\"Achilles\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Divine Comedy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebcfe1e15a5966f1541f8e91d5\"},\"artist_id\":\"4825\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sun 12 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"tim