mages\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-02/43723f91-11b5-45d6-9f65-454a64ca5ca3.jpg?rect=1173%2C0%2C4819%2C4819\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-02/43723f91-11b5-45d6-9f65-454a64ca5ca3.jpg?rect=0%2C241%2C7228%2C4337\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-02/43723f91-11b5-45d6-9f65-454a64ca5ca3.jpg?rect=2289%2C0%2C2650%2C4819\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Eliane Correa & Plumm - Cold Blooded\",\"redirect_url\":\"https://music.apple.com/us/album/cold-blooded/1852348997?i=1852349183&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Eliane Correa & Plumm\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/bc/92/d0/bc92d091-336a-f3ec-aab6-13ac52adb0e6/mzaf_3532261443867812036.plus.aac.p.m4a\",\"track_name\":\"Cold Blooded\"},{\"type\":\"spotify\",\"title\":\"Hans Zimmer - Inception: Time - Orchestra Version - Live\",\"redirect_url\":\"https://open.spotify.com/track/5TXY9UWJMiMopFTpW0uUBb\",\"artist\":\"Hans Zimmer - Inception: Time - Orchestra Version - Live\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8866dc38b6efc5e435998a4ae6c4ca7d13b6d240?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Hans Zimmer - Inception: Time - Orchestra Version - Live\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1766059200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Powerhouse pianist and composer Eliane Correa relaunches her Afrocuba-centric cinematic jazz project En El Aire, with which her first album, Rumba con Flores (Movimientos Records 2016, Songlines 4\\\\*, Jazzwise 4\\\\*), earned the critical acclaim of Cubaphiles and jazzheads alike. Known for her energetic leadership, masterful playing and arranging, and her unwavering centricity in the Latin scene of the UK over the last decade, her original compositions span from classic Cuban son and salsa to the most abstract, spiritual jazz inspired compositions. Her 7 years touring as Hans Zimmer’s piano soloist and experience in composing for the screen have added layers of cinematic richness to her sound. En El Aire project falls on the experimental end of Eliane’s creative range, where jazz meets afrocuban spirituality and synths – but danceable.\\n\\nMaster drummer Hammadi Valdés (Chucho Valdés, Carlos Acosta), backed by heavy grooves by Alley Lloyd (Fleur East, Nectar Woode) and Richie Sweet (Jorja Smith, Oscar Jerome). The frontline consists of three of the best horns of London (Sam Warner on trumpet, Rosie Turton on trombone and Allexa Nava on sax) and guest vocals by voice wizard Plumm, frontwoman of Levitation Orchestra. En El Aire had its test drive back after a 10 year hiatus last summer in front of a sold out Ninety One Living Room with an entire new repertoire, including Eliane’s recently released singles Float and Everywhere, and Cold Blooded as a collaboration with Plumm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Fox & Firkin.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:38\",\"social_links\":{\"event_share\":\"https://link.dice.fm/a0658fed9465?dice_id=a0658fed9465\",\"post_competition_referral\":\"https://link.dice.fm/Cd4bdc2ee0ec?dice_id=Cd4bdc2ee0ec\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q8220698e3d6?dice_id=Q8220698e3d6\",\"post_purchase_referral\":\"https://link.dice.fm/ifbab72f266e?dice_id=ifbab72f266e\",\"post_reminder_referral\":\"https://link.dice.fm/g0466a3bb622?dice_id=g0466a3bb622\",\"post_waitinglist_referral\":\"https://link.dice.fm/w7e69abf3d26?dice_id=w7e69abf3d26\"},\"d