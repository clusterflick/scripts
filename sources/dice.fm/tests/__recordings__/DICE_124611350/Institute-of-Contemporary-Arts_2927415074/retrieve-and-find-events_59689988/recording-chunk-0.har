ull},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Channel Alt, CassKidd, Kruz Leone & DeeRiginal - Clean\",\"redirect_url\":\"https://music.apple.com/us/album/clean/1846931612?i=1846931615&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Channel Alt, CassKidd, Kruz Leone & DeeRiginal\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/07/57/64/0757647a-00be-c1eb-bdf5-745f2b0d8fa1/mzaf_3626764793961928417.plus.aac.p.m4a\",\"track_name\":\"Clean\"},{\"type\":\"spotify\",\"title\":\"Channel Alt - WHATIMINTO\",\"redirect_url\":\"https://open.spotify.com/track/7e47Ufb4NMHm60LiOQFgXa\",\"artist\":\"Channel Alt\",\"preview_url\":\"https://p.scdn.co/mp3-preview/93ec0f313517b934b759d3713ee6ecd486fe7f21?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"WHATIMINTO\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-15T10:00:00+01:00\",\"sale_end_date\":\"2026-02-19T21:00:00+00:00\",\"sale_start_date\":\"2025-08-20T10:00:00+01:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Kilimanjaro.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/d245e116b3d0?dice_id=d245e116b3d0\",\"post_competition_referral\":\"https://link.dice.fm/s1f5b086449a?dice_id=s1f5b086449a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X7bada10fee2?dice_id=X7bada10fee2\",\"post_purchase_referral\":\"https://link.dice.fm/Fb807efff8bb?dice_id=Fb807efff8bb\",\"post_reminder_referral\":\"https://link.dice.fm/f4a3e66082e9?dice_id=f4a3e66082e9\",\"post_waitinglist_referral\":\"https://link.dice.fm/yc632921f9df?dice_id=yc632921f9df\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"*Progressive metal visionaries Between the Buried and Me return with their most immersive and eclectic record yet—The Blue Nowhere, their first on InsideOutMusic. Mixing uncharted musical detours with their distinctive aggressive identity, the band create a conceptual world unlike anything in their incredible catalog, inviting the listener to experience the journey on their own terms. Though the story takes place in a hotel—The Blue Nowhere—don’t expect haunted corridors or shadowy figures behind every door.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"d