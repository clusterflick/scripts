ice_id=Ad49a944058a\",\"post_waitinglist_referral\":\"https://link.dice.fm/a191f9f7a46d?dice_id=a191f9f7a46d\"},\"perm_name\":\"ww5qqn-makaya-mccraven-6th-may-union-chapel-london-tickets\",\"secondary_status\":\"rescheduled\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-21/dbd2c8db-f9d6-4725-905a-8b77cd0a798e.jpg?rect=0%2C355%2C3400%2C3400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-21/dbd2c8db-f9d6-4725-905a-8b77cd0a798e.jpg?rect=0%2C1035%2C3400%2C2040\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-21/dbd2c8db-f9d6-4725-905a-8b77cd0a798e.jpg?rect=570%2C0%2C2261%2C4110\"},\"properties\":[],\"about\":{\"description\":\"Innovatively fusing jazz, folk and more, Chicago drummer and bandleader Makaya McCraven has proven himself a vital piece of the city's storied jazz puzzle for nearly 20 years. Now, building on the success of his acclaimed 2022 LP 'In These Times', and the 10th anniversary of his groundbreaking record 'In the Moment', Makaya McCraven is returning with a new album. With a live performance rooted in virtuosic playing and thrilling improv, Makaya McCraven is a true musician's musician - one who, in the words of The Guardian, \\\"balances jazz's precious tradition and its present and future.\\\"\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69206bfe6a0f59000104723e\",\"name\":\"Makaya McCraven\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Twelve Donkeys\",\"redirect_url\":\"https://open.spotify.com/track/7KT0wjvsa5TOoU5TGiTwfs\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/abe72c156e7bfd7d1c83f1f3eb40e549e12616c3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Twelve Donkeys\"},{\"type\":\"apple_music\",\"title\":\"Gil Scott-Heron & Makaya McCrav