erties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/G6d59282237d?dice_id=G6d59282237d\",\"post_competition_referral\":\"https://link.dice.fm/hb96faa2f832?dice_id=hb96faa2f832\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/o2cb598c5c78?dice_id=o2cb598c5c78\",\"post_purchase_referral\":\"https://link.dice.fm/a360424551d0?dice_id=a360424551d0\",\"post_reminder_referral\":\"https://link.dice.fm/pecfc9c9251a?dice_id=pecfc9c9251a\",\"post_waitinglist_referral\":\"https://link.dice.fm/mf2b7aeb1575?dice_id=mf2b7aeb1575\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"***Nottingham-based British-Ugandan singer-songwriter Daudi Matsiko returns to Kings Place to present his new EP, ‘Dead Bird Dream’ – a collection of deeply felt modern folk songs, telling a story of heartache, diaspora, and self-acceptance at a time when belonging and British identity feels as though in constant jeopardy. With live performances described as deeply moving and life affirming in equal measure, Matsiko is not to be missed.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nFollowing on from beautiful collaborations with GoGo Penguin and Werkha, **Daudi Matsiko** continues to find hope in vulnerability. His debut album, *The King Of Misery*, was a hauntingly beautiful exploration of depression, bipolar disorder, and finding hope in that experience.\\n\\nAfter a standing ovation at The Great Escape Festival, and with support from POWER UP, PRS Foundation, and Albert’s Favourites, Matsiko set up his own label, Really Good, to release his debut. Since its release, *The King Of Misery* has received 4 stars in *Mojo Magazine* and *Far Out Magazine*, has been featured on several Spotify editorial playlists, been a headline feature on Bandcamp Weekly, and continues to captivate audiences worldwide.\\n\\nMatsiko also delivered an unforgettable performance and insightful interview on episode 215 of The Adam Buxton Podcast and gave a mesmerising live session at BBC Maida Vale for Gilles Peterson on BBC 6 Music.\\n\\n***This event will last approximately 2 hours, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773430200,\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:30\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"id\":\"691d8a4de6cc2100018a68ce\",\"name\":\"Daudi Matsiko\",\"perm_name\":\"pypr8w-daudi-matsiko-13th-mar-kings-place-hall-two-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-18/b6515318-2476-446c-9ce9-b22571ea3048.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-18/b6515318-2476-446c-9ce9-b22571ea3048.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-18/b6515318-2476-446c-9ce9-b22571ea3048.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1763427600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2402,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-07T23:15:00+00:00\",\"sale_end_date\":\"2026-03-13T18:30:00+00:00\",\"sale_start_date\":\"2025-12-07T23:15:00+00:00\",\"event_start_date\":\"2026-03-13T19:45:00+00:00\",\"event_end_date\":\"2026-03-13T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Other Side Promotions.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/z552853c8f20?dice_id=z552853c8f20\",\"post_competition_referral\":\"https://link.dice.fm/x221698d2325?dice_id=x221698d2325\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ud1a31685a8d?dice_id=Ud1a31685a8d\",\"post_purchase_referral\":\"https://link.dice.fm/P6dad70700f7?dice_id=P6dad70700f7\",\"post_reminder_referral\":\"https://link.dice.fm/r855f846e83e?dice_id=r855f846e83e\",\"post_waitinglist_referral\":\"https://link.dice.fm/P3676214418c?dice_id=P3676214418c\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Other Side Promotions are extremely excited to welcome two very special krautrock bands to London!\\n\\n𝐕𝐞𝐫𝐬𝐭𝐚̈𝐫𝐤𝐞𝐫 (𝐔𝐒) (𝐅𝐮𝐳𝐳 𝐂𝐥𝐮𝐛):\\n\\nVerstärker are a sound and a vision united in the quest for motorik space exploration. Comprised of sonic cosmonauts J. Gibson (bass/synth/recording), J. Norfleet (drums), & J. Vitatoe (guitar/effects/visuals), the band coalesced in 2012 as a way of exploring their mutual love of music. Honed on the sounds of krautrock, post-punk, no wave, & drone, Verstärker stand ready for lift-off into the ether.\\n\\nTheir debut record - Aktivität was recorded in 2015 and released on their own imprint, SpaceLab Records and promptly sold out.\\n\\nKnown for their kinetic live performances, Verstärker has shared the stage with such artists as The Telescopes, Camera, Majeure, Parlour, among others.\\n\\nNow signed to Fuzz Club Records, Verstärker released their latest record on Fuzz Club - 'Jenseits' to critical acclaim, in the Fall of 2023 and also a brilliant 'Live at Fuzz Club Festival ’24' record.\\n\\nhttps://linktr.ee/vrstkr\\n\\n𝐏𝐍𝐄𝐌 (𝐍𝐋):\\n\\nInspired by the monotonous howl of industrial machinery, driven by a carefully computed pulse. PNEM is a four-piece band from Holland.\\n\\nThe perfect soundtrack for those seemingly never-ending highway (over)drives, taking you all the way in until the repetition of flashing lights & the rumbling sounds of the motorway starts to feel like the never-ending trip you were always dreaming of.\\n\\nhttps://linktr.ee/PNEM\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773431100,\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T19:45:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:31\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"5285\",\"name\":\"Other Side Promotions\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-09/c8464497-8f12-4558-84bb-ede11bc2ddb5.jpg\"},\"perm_name\":\"other-side-promotions-r5gv\",\"profile_active\":true},\"id\":\"69360879e76f66000103c84a\",\"name\":\"OSP Presents: Verstärker (US) (Fuzz Club) + Pnem (NL)\",\"perm_name\":\"g5lew2-osp-presents-verstrker-us-fuzz-club-pnem-nl-13th-mar-strongroom-bar-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-07/ca5abd8f-d479-417e-a06e-bcd37aaf9388.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-07/ca5abd8f-d479-417e-a06e-bcd37aaf9388.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-07/ca5abd8f-d479-417e-a06e-bcd37aaf9388.jpg?rect=486%2C0%2C1188%2C2160\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"PNEM\",\"image\":null,\"artist_id\":\"74262\",\"about\":null,\"is_headliner\":false},{\"name\":\"Verstärker\",\"image\":null,\"artist_id\":\"103844\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765149300,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Verstärker - Ankunft\",\"redirect_url\":\"https://music.apple.com/us/album/ankunft/1737000316?i=1737000606&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Verstärker\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/e8/67/d2/e867d22a-bee6-79ed-9c8d-7d0d1e20ef59/mzaf_8060204167010849339.plus.aac.p.m4a\",\"track_name\":\"Ankunft\"},{\"type\":\"spotify\",\"title\":\"Verstärker - Ankunft\",\"redirect_url\":\"https://open.spotify.com/track/5cKeOuCboXg8weqbUQfKG9\",\"artist\":\"Verstärker\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7a2bfc3e6ccea7b7eb61ff4d0e185906ce1a249e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ankunft\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-13T19:30:00+00:00\",\"sale_start_date\":\"2026-02-12T14:00:00+00:00\",\"event_start_date\":\"2026-03-13T20:00:00+00:00\",\"event_end_date\":\"2026-03-14T02:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Volta45\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/D89736cf72e5?dice_id=D89736cf72e5\",\"post_competition_referral\":\"https://link.dice.fm/db3a615a380f?dice_id=db3a615a380f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K2b56daecc80?dice_id=K2b56daecc80\",\"post_purchase_referral\":\"https://link.dice.fm/U681756285d6?dice_id=U681756285d6\",\"post_reminder_referral\":\"https://link.dice.fm/e01acc348ab8?dice_id=e01acc348ab8\",\"post_waitinglist_referral\":\"https://link.dice.fm/Naa5ff7d8186?dice_id=Naa5ff7d8186\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Volta45 returns to Grow for another special night curated from start to finish, inviting the electrifying Fofoulah for a live performance before taking control of the dance floor himself.\\n\\nRenowned for his unique style, the London based DJ blends jazzy and percussive sounds from Africa, South America and the French Caribbean into a heady, high energy mix. A regular across the UK and European festival circuit, he has moved dance floors from Turin to the fields of Shambala Festival. As co compiler of Kalita Records’ best selling Borga Revolution, his deep knowledge of crossover West African music shaped by synthesizers, disco and boogie runs through every set.\\n\\nHeadlining the live show are Fofoulah, the London and Bristol based future jazz outfit signed to Glitterbeat Records. Inspired by a cosmopolitan mélange of influences, they fuse jazz improvisation and electronic music with traditional Senegalese rhythms, dub basslines, sci fi synths and sabar drumming. The result is a cauldron of intense, hypnotic grooves.\\n\\nFeaturing members from Senegal, the UK and The Gambia, Fofoulah have headlined the West Holts stage at Glastonbury and performed at Roskilde Festival, carving out a sound that feels both deeply rooted and radically forward looking.\\n\\nExpect an immersive night that journeys from live future jazz into deep, percussive global club sounds, curated entirely by Volta45 at Grow.\\n\\n**ENTRY INFORMATION**\\n\\nLimited £5/£7 advance tickets on DICE. Free before 9pm, £10 after.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773432000,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T20:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:32\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"id\":\"698ddbdfbb9e2300011a4ed4\",\"name\":\"Volta45 invites: Fofoulah\",\"perm_name\":\"g5mypa-volta45-invites-fofoulah-13th-mar-grow-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/dc041f91-5a49-4097-a018-1e228b97add1.jpg?rect=0%2C109%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/dc041f91-5a49-4097-a018-1e228b97add1.jpg?rect=0%2C351%2C1080%2C648\",