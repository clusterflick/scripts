ce\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/4343684d-fc3d-4b73-9a0b-05e8fba5a222.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/4343684d-fc3d-4b73-9a0b-05e8fba5a222.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/4343684d-fc3d-4b73-9a0b-05e8fba5a222.jpg?rect=486%2C0%2C1188%2C2160\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/m7898abe95b5?dice_id=m7898abe95b5\",\"post_competition_referral\":\"https://link.dice.fm/Fc943ec45f70?dice_id=Fc943ec45f70\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k960e0273393?dice_id=k960e0273393\",\"post_purchase_referral\":\"https://link.dice.fm/M961a5a7a814?dice_id=M961a5a7a814\",\"post_reminder_referral\":\"https://link.dice.fm/B3d3857f53a3?dice_id=B3d3857f53a3\",\"post_waitinglist_referral\":\"https://link.dice.fm/p8fce6237180?dice_id=p8fce6237180\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:1\",\"properties\":[],\"presented_by\":\"Presented by Paper Dress Live & SON Estrella Galicia.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770125400,\"id\":\"6981faff40912a0001ce651f\",\"name\":\"Y + special guests\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Paper Dress Live** in association with **SON Estrella Galicia** are delighted to present a very special intimate show with rising stars of the South London music scene **Y**\\n\\nPlus special guests **Omerta** & **One Man Destruction Show - Adam J. Harmer**! 💥\\n\\n**Y**\\n\\nEmerging from the creative crucible of London, Y is a genre-defying band founded in 2023 by Adam Brennan and Sophie Coppin during a period of isolation. The duo discovered an uncanny synergy in their music-making, blending shared tastes with contrasting stylistic approaches. This paradox birthed the eclectic, unpredictable sound that defines Y - playfully described as *“wonkrock,”* *“Gameboy thrash,”* and even *“Egyptian wedding music.”*\\n\\nTickets are very limited. For those who know, this one’s not to be missed.\\n\\n**OMERTÀ**\\n\\nOmertà are a very singular musical anomally hailing from south London.\\n\\nTheir music is an unapologetic clash of genres blending post-punk, electronica, noise, hyper pop and everything in between that gives them a wonderful excuse to put on an incredible live show focused on free-flowing improvisation and musical freakouts.\\n\\n**One Man Destruction Show - Adam J. Harmer**\\n\\nBest known as the guitarist in the acclaimed post-punk outfit **Fat White Family** and a member of the London scene’s adventurous rock collective **Warmduscher**. Under the moniker One Man Destruction Show, he strips things back to raw, raucous solo performance, wielding guitar and drums simultaneously while delivering a visceral blend of rock, garage and blues-infused chaos\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2624\",\"name\":\"Paper Dress Vintage\",\"image\":{\"url\":null},\"perm_name\":\"paper-dress-vintage-67xq\",\"profile_active\":false},\"date_unix\":1772307000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":861,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T00:00:00+00:00\",\"sale_end_date\":\"2026-02-28T18:30:00+00:00\",\"sale_start_date\":\"2026-01-28T00:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:30:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"py5wnw-duck-wax-sweetheart-ball-games-28th-feb-the-victoria-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Duck Wax\",\"image\":null,\"artist_id\":\"34876\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/8191ca31-4417-43e9-afcf-8a47f72aa330.jpg?rect=0%2C172%2C871%2C871\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/8191ca31-4417-43e9-afcf-8a47f72aa330.jpg?rect=0%2C379%2C871%2C523\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/8191ca31-4417-43e9-afcf-8a47f72aa330.jpg?rect=84%2C0%2C704%2C1280\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/F4dbe71f530c?dice_id=F4dbe71f530c\",\"post_competition_referral\":\"https://link.dice.fm/S5abf9648253?dice_id=S5abf9648253\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d9595ab7ab76?dice_id=d9595ab7ab76\",\"post_purchase_referral\":\"https://link.dice.fm/y6c02461e2b6?dice_id=y6c02461e2b6\",\"post_reminder_referral\":\"https://link.dice.fm/Wdc1a0332d25?dice_id=Wdc1a0332d25\",\"post_waitinglist_referral\":\"https://link.dice.fm/u36ebefab536?dice_id=u36ebefab536\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:2\",\"properties\":[],\"presented_by\":\"Presented by Short Waves.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769558400,\"id\":\"697a2ee93e15250001a031e8\",\"name\":\"Duck Wax / Sweetheart / Ball Games \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Short Waves Presents:\\n\\n**DUCK WAX**\\n\\nDuck Wax are a 5-piece out of South London playing a funk-country blend. Back on the scene after a long hiatus of writing they are primed with an exciting new EP releasing in July. This gig will be a great opportunity to see what the future holds for this avian band.\\n\\n**SWEETHEART**\\n\\nFormed in 2013, Sweetheart have been performing a distinctive mix of alternative rock, no wave and guitar pop for over a decade. Taking on subjects such as romance, anger, and the animal kingdom, they filter classic songwriting through an often loose and chaotic performance style.\\n\\n\\\\+ Ball Games\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2399\",\"name\":\"The Victoria Dalston\",\"image\":{\"url\":null},\"perm_name\":\"the-victoria-dalston-l3wp\",\"profile_active\":false},\"date_unix\":1772307000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":650,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T11:00:00+00:00\",\"sale_end_date\":\"2026-02-28T01:30:00+00:00\",\"sale_start_date\":\"2026-01-28T11:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:30:00+00:00\",\"event_end_date\":\"2026-03-01T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dbw5-2b2c-tommy-barlow-tv-maiden-otta-doberman-28th-feb-the-george-tavern-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"TV\",\"image\"