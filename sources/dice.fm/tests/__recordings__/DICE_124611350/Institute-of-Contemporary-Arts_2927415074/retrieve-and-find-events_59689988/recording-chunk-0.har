ro-43px\",\"profile_active\":false},\"date_unix\":1772902800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T17:30:00+00:00\",\"sale_start_date\":\"2026-01-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T18:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nv9ed3-london-music-ultimate-showcase-all-dayer-7th-mar-the-camden-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":6},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"8300\",\"name\":\"The Camden Club\",\"address\":\"NW1 8AN, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.543335,\"lng\":-0.150016},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-camden-club-6w68\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T18:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/9eb68b56-a935-492d-96df-9a3aba3a8bd8.jpg?rect=0%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/9eb68b56-a935-492d-96df-9a3aba3a8bd8.jpg?rect=0%2C256%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/9eb68b56-a935-492d-96df-9a3aba3a8bd8.jpg?rect=288%2C0%2C704%2C1280\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/F25cdfa12eff?dice_id=F25cdfa12eff\",\"post_competition_referral\":\"https://link.dice.fm/Yeb207ebc495?dice_id=Yeb207ebc495\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/fc61c15083da?dice_id=fc61c15083da\",\"post_purchase_referral\":\"https://link.dice.fm/P92dff1dfad9?dice_id=P92dff1dfad9\",\"post_reminder_referral\":\"https://link.dice.fm/I1bab1d9ae1a?dice_id=I1bab1d9ae1a\",\"post_waitinglist_referral\":\"https://link.dice.fm/b38fe7f3d403?dice_id=b38fe7f3d403\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:22\",\"properties\":[],\"presented_by\":\"Presented by London Music Showcase.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767916800,\"id\":\"6993b610d5ca2d00017d7637\",\"name\":\"London Music Ultimate Showcase: All Dayer\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"date_unix\":1772906400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1430,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T17:00:00+00:00\",\"sale_start_date\":\"2025-12-03T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T18:00:00+00:00\",\"event_end_date\":\"2026-03-07T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"8erkv2-steal-this-band-tonedefs-7th-mar-new-cross-inn-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\"