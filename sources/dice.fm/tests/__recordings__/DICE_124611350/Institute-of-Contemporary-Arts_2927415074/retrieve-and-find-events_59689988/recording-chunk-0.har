lse,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"92w5ln-international-piano-in-the-elms-festival-nefeli-mousoura-21st-mar-world-heart-beat-embassy-gardens-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774119600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-22/9651ab82-32f1-4e06-bf1b-23d850151997.jpg?rect=0%2C480%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-22/9651ab82-32f1-4e06-bf1b-23d850151997.jpg?rect=0%2C864%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-22/9651ab82-32f1-4e06-bf1b-23d850151997.jpg?rect=168%2C0%2C1584%2C2880\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/D640e7ace6e2?dice_id=D640e7ace6e2\",\"post_competition_referral\":\"https://link.dice.fm/p6ece2597e03?dice_id=p6ece2597e03\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ec0ae88e1d07?dice_id=ec0ae88e1d07\",\"post_purchase_referral\":\"https://link.dice.fm/b246752c6af5?dice_id=b246752c6af5\",\"post_waitinglist_referral\":\"https://link.dice.fm/k3d1231f16da?dice_id=k3d1231f16da\",\"post_reminder_referral\":\"https://link.dice.fm/P3510292ad7f?dice_id=P3510292ad7f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Steinway Artist Nefeli Mousoura's first part of her recital is devoted to Wolfgang Amadeus Mozart, exploring different facets of his musical world through variations, minuets, and a sonata.\\n\\nThe second part moves into the deeply expressive universe of Franz Liszt, featuring pieces such as the Consolations, a Hungarian Rhapsody, and Venezia e Napoli, tracing a journey from introspection to virtuosity and color.\\n\\n**Nefeli Mousoura**\\n\\nSteinway Artist Nefeli Mousoura was born in Athens, Greece. She studied under Anastasios Pappas at the Kodály Conservatory and with Rolf Plagge and Imre Rohmann at the University of Mozarteum in Austria, where she earned her Bachelor of Arts and Master of Arts degrees, graduating with unanimous distinction.\\n\\nShe has been awarded prestigious scholarships, including from the Alexander S. Onassis Foundation, the Friends of the Athens Concert Hall, the Foundation for Education and European Culture, and the Gina Bachauer Society, and has received honors in national and international competitions as well as recognition from the Academy of Athens.\\n\\nAs a soloist, she has collaborated with all major Greek symphony orchestras and internationally acclaimed ensembles such as the Orchestre National de l’Île-de-France, Roma Tre Orchestra, Salzburg Soloists Orchestra, Philharmonic Orchestra Bacau, National Symphony Orchestra of South Korea Radio, Raanana Symphonette, and Ton der Jugend Symphonie Orchester Wien, among others.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\