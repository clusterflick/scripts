ighlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1775930400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T00:00:00+00:00\",\"sale_end_date\":\"2026-04-10T12:00:00+01:00\",\"sale_start_date\":\"2026-02-04T00:00:00+00:00\",\"event_start_date\":\"2026-04-11T19:00:00+01:00\",\"event_end_date\":\"2026-04-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"3owkvl-flore-laurentienne-11th-apr-elgar-room-at-royal-albert-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Flore Laurentienne - Régate\",\"redirect_url\":\"https://music.apple.com/us/album/re-gate/1844634680?i=1844634689&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Flore Laurentienne\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/b5/95/ac/b595aca7-c27b-ce33-867b-ee9e3e8c9953/mzaf_6541513863327668429.plus.aac.p.m4a\",\"track_name\":\"Régate\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"8368\",\"name\":\"Elgar Room at Royal Albert Hall\",\"address\":\"Elgar Room at Royal Albert Hall\",\"location\":{\"lat\":51.501267,\"lng\":-0.17754},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"elgar-room-at-royal-albert-hall-da6q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/be21ece0-d259-4398-be73-cd7814559e2e.jpg?rect=0%2C175%2C1400%2C1400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/be21ece0-d259-4398-be73-cd7814559e2e.jpg?rect=0%2C455%2C1400%2C840\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/be21ece0-d259-4398-be73-cd7814559e2e.jpg?rect=219%2C0%2C963%2C1750\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/F554fc1e37de?dice_id=F554fc1e37de\",\"post_competition_referral\":\"https://link.dice.fm/z88d6682ec2c?dice_id=z88d6682ec2c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C457cbe0f016?dice_id=C457cbe0f016\",\"post_purchase_referral\":\"https://link.dice.fm/R25c73008ff9?dice_id=R25c73008ff9\",\"post_reminder_referral\":\"https://link.dice.fm/Nd5c82345557?dice_id=Nd5c82345557\",\"post_waitinglist_referral\":\"https://link.dice.fm/M301b6470fea?dice_id=M301b6470fea\"},\"is_hidden_event\":false,\"secondary_status\":\"rescheduled\",\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:80\",\"properties\":[],\"presented_by\":\"Presented by Royal Albert Hall.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770163200,\"id\":\"6984a1f5538fde0001d80e7a\",\"name\":\"Flore Laurentienne\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Rooted in the Québec landscape and inspired by the vastness of the St. Lawrence River, Canadian composer, producer and multi-instrumentalist Flore Laurentienne’s music — a harmonious blend of strings and analog synthesizers — takes us on a journey to the edge of the sublime.\\n\\nFlore Laurentienne draws inspiration from contrasting worlds: the melodic clarity and counterpoint of Johann Sebastian Bach; the narrative intensity and progressive audacity of King Crimson; and the electronic minimalism of Hans-Joachim Roedelius. From this unexpected encounter at the crossroads of classical, progressive, and experimental music, a dense and generous sound emerges, with unapologetic lyricism and dynamic textures.\\n\\nOn stage, Laurentienne comes to life through a core ensemble of seven musicians. At the centre stands composer and keyboardist Mathieu David Gagnon, surrounded by a string quartet and two keyboardists-percussionists.\\n\\nOur intimate Late Night Jazz series presents sensational music in the Elgar Room, celebrating the freshest sounds on the London scene alongside the finest in jazz standards.\\n\\nWe have a laid-back attitude at Late Night Jazz at the Royal Albert Hall. Customers are welcome to dance, move around, sing along, and enjoy themselves in whatever way feels most comfortable!\\n\\nAll customers aged 14 years or below must be accompanied by an adult aged 18 years or over\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"2558\",\"name\":\"Royal Albert Hall\",\"image\":{\"url\":null},\"perm_name\":\"royal-albert-hall-8m2r\",\"profile_active\":false},\"date_unix\":1775930400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-04-11T18:00:00+01:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-04-11T19:00:00+01:00\",\"event_end_date\":\"2026-04-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l89avp-uk-death-dealers-presents-veil-of-revelations-11th-apr-the-fighting-cocks-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"5327\",\"name\":\"The Fighting Cocks\",\"address\":\"56 Old London Rd, Kingston upon Thames KT2 6QA, UK\",\"location\":{\"lat\":51.41069110000001,\"lng\":-0.2982407},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-fighting-cocks-l6yp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/ddf27b6e-4c06-4efd-a4ad-27e19eebdaca.jpg?rect=0%2C900%2C5400%2C5400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/ddf27b6e-4c06-4efd-a4ad-27e19eebdaca.jpg?rect=0%2C1980%2C5400%2C3240\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/ddf27b6e-4c06-4efd-a4ad-27e19eebdaca.jpg?rect=720%2C0%2C3960%2C7200\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Kf16b232aa07?dice_id=Kf16b232aa07\",\"post_competition_referral\":\"https://link.dice.fm/Wb4763e9bb5d?dice_id=Wb4763e9bb5d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E4c26ab8a1a7?dice_id=E4c26ab8a1a7\",\"post_purchase_referral\":\"https://link.dice.fm/Xd64db7fe8fb?dice_id=Xd64db7fe8fb\",\"post_reminder_referral\":\"https://link.dice.fm/qefb0580b9d0?dice_id=qefb0580b9d0\",\"post_waitinglist_referral\":\"https://link.dice.fm/r1cf285436e6?dice_id=r1cf285436e6\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:81\",\"properties\":[],\"presented_by\":\"Presented by The Fighting Cocks Bar and Venue.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769990400,\"id\":\"6980a14140e40300018498d0\",\"name\":\"UK DEATH DEALERS PRESENTS: VEIL OF REVELATIONS\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"UK Death Dealers returns to The Fighting Cocks, Kingston for the official EP launch of VEIL OF REVELATIONS, the new release from London melo-chaotic death metal force Worship The Sacrifice.\\n\\nThis show marks the first full live outing of the EP, a release that sharpens the band’s melodic edge without sacrificing their signature chaos, weight, and intensity. Expect a focused, high-impact set built around the new material, backed by the ferocity they’ve become known for on stages across the UK.\\n\\nHeadlining the night are LIES! (Netherlands), bringing their uncompromising metallic hardcore sound to London as special guest headliners. Known for raw energy, crushing riffs, and a no-nonsense live presence, this is a rare chance to catch them on UK soil.\\n\\nSupport comes from Scaphist, delivering Diamond Isle deathcore filth, and Deathscripted, opening the night with sharp, modern death metal from the London underground.\\n\\nA stacked lineup, international guests, and a full EP launch set in one of London’s most respected grassroots venues. Pure extreme metal at it’s finest!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"123141\",\"name\":\"The Fighting Cocks Bar and Venue\",\"image\":{\"url\":null},\"perm_name\":\"the-fighting-cocks-bar-and-venue-xr3d3\",\"profile_active\":false},\"date_unix\":1775930400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T18:00:00+00:00\",\"sale_end_date\":\"2026-04-11T17:30:00+01:00\",\"sale_start_date\":\"2026-02-02T18:00:00+00:00\",\"event_start_date\":\"2026-04-11T19:00:00+01:00\",\"event_end_date\":\"2026-04-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"537kgd-bighead-11th-apr-sebright-arms-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"BIGHEAD - The Land Is Hers\",\"redirect_url\":\"https://open.spotify.com/track/5WAoQuzOErEV9sEmPAMFBu\",\"artist\":\"BIGHEAD\",\"preview_url\":\"https://p.scdn.co/mp3-preview/63c8d4aaf2c2ae056be18544cc0b20e26ac8f47f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Land Is Hers\"},{\"type\":\"apple_music\",\"title\":\"BIGHEAD - The Land Is Hers\",\"redirect_url\":\"https://music.apple.com/us/album/the-land-is-hers/1768634700?i=1768634701&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"BIGHEAD\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/38/08/63/38086338-1c6f-85db-1ee0-07a71047b3f8/mzaf_10589896635945072053.plus.aac.p.m4a\",\"track_name\":\"The Land Is Hers\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"