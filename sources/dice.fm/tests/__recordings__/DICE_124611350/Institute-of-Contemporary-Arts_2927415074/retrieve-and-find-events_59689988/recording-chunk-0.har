//dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=320%2C0%2C440%2C800\"},\"max_tickets\":20,\"social_links\":{\"event_share\":\"https://link.dice.fm/G7577dc10a27?dice_id=G7577dc10a27\",\"post_competition_referral\":\"https://link.dice.fm/se3bf37da6e7?dice_id=se3bf37da6e7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n46e6168b148?dice_id=n46e6168b148\",\"post_purchase_referral\":\"https://link.dice.fm/Gf5d8121b6c9?dice_id=Gf5d8121b6c9\",\"post_waitinglist_referral\":\"https://link.dice.fm/W47f63010433?dice_id=W47f63010433\",\"post_reminder_referral\":\"https://link.dice.fm/D2aae293c5a1?dice_id=D2aae293c5a1\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T20:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"A Journey Through the Golden Age of Cuban Music.\\n\\nStep into the vibrant world of Havana with the Buena Vista Social Club Live Revue, a dazzling celebration of Cuba’s most iconic musical heritage. This unforgettable tribute brings the timeless sounds of son, bolero, danzón, and cha-cha-cha to life, performed by some of the UK’s finest Cuban musicians.\\n\\nInspired by the legendary 1997 Grammy-winning album produced by Ry Cooder and Juan de Marcos González, this live revue pays homage to the spirit and soul of the original Buena Vista ensemble, a project that united the greatest living masters of pre-revolutionary Cuban music.\\n\\nExpect infectious rhythms, soulful trumpet solos, intricate guitar work, and vocals steeped in love, nostalgia, and joy. It’s a night that will transport you straight to Havana’s smoky clubs and sun-drenched plazas, and you may just find yourself dancing before the night is through.\\n\\nBand Line-Up\\n\\nLuke Rattenbury – tres, guitar, vocals\\n\\nEddie Myer – bass, vocals\\n\\nAdriana Lord – lead vocals\\n\\nMickey Ball – trumpet\\n\\nSatin Singh – congas\\n\\nVancho Manoilovich – timbales, drums\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:61\",\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Buena Vista Social Club\",\"image\":null,\"artist_id\":\"73269\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1770595200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-27T20:30:00+00:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-27T21:30:00+00:00\",\"event_end_date\":\"2026-03-27T22:45:00+00:00\",\"is_multi_days_event\":false,