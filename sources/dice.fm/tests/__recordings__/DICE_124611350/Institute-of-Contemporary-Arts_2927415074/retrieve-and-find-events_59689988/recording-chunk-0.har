4},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lower-third-pply\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"highlights\":[],\"profile_active\":true,\"space_name\":\"The Lower Third (Up)\",\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":910,\"name\":\"Global Soul\",\"privacy_policy_link\":\"https://globalsoulradio.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:23\",\"about\":{\"description\":\"Rose White is a Polish born, London based singer songwriter that playfully mixes soul-jazz grooves with infectious hooks and empowering energy. \\n\\nWrapping her husky voice that has drawn comparisons to Duffy, Paloma Faith and Olivia Dean, around the full range of emotions, Rose wants to speak openly about the topics we all think about, but are afraid to say out loud. \\n\\nRose, an ex pro ballroom dancer, arrived in London aged 20 with £300, 2 suitcases and 0 connections. Working her way up the ladder on the open mic circuit, eventually headlining clubs with her band, she released her debut EP ‘One Fourth Mark’ in 2022 to glowing reviews and placements on editorial playlists.\\n\\nIn 2024, Rose became a recipient of a Next Level Award sponsored by Help Musicians organisation that helped her fund her upcoming project with ‘Next Of Kin’ being the perfect introduction to this new chapter.\\n\\n“Rose’s ability to portray different themes and emotions through her intimate and evocative storytelling is truly impressive” - Wonderland Magazine\\n\\n*\\\\*For accessibility information please see the accessibility information button/link below*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1766240100,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rose White\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-20/91b1b59c-ef6d-4cf3-ad9a-b1135ee01739.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"102716\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/b00ecfe1-b301-48be-bd89-09b75c2f482b.jpg?rect=0%2C0%2C3566%2C3566\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/b00ecfe1-b301-48be-bd89-09b75c2f482b.jpg?rect=0%2C713%2C3566%2C2140\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/b00ecfe1-b301-48be-bd89-09b75c2f482b.jpg?rect=803%2C0%2C1961%2C3566\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6946bbca2215d80001a3a570\",\"name\":\"Rose White + more TBA\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-20T14:15:00+00:00\",\"sale_end_date\":\"2026-04-23T22:00:00+01:00\",\"sale_start_date\":\"2025-12-20T14:15:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"xe78rk-rose-white-more-tba-23rd-apr-the-lower-third-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1301},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/s420c972c9e8?dice_id=s420c972c9e8\",\"post_competition_referral\":\"https://link.dice.fm/G7fb0090faaa?dice_id=G7fb0090faaa\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zff4a7deec38?dice_id=Zff4a7deec38\",\"post_purchase_referral\":\"https://link.dice.fm/qa2abb964ac5?dice_id=qa2abb964ac5\",\"post_reminder_referral\":\"https://link.dice.fm/z4f2034e8416?dice_id=z4f2034e8416\",\"post_waitinglist_referral\":\"https://link.dice.fm/P1cc25758a8b?dice_id=P1cc25758a8b\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Mikey Kenney - Up Hardman Street\",\"redirect_url\":\"https://music.apple.com/us/album/up-hardman-street/1722428093?i=1722429354&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mikey Kenney\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/89/be/d4/89bed4ab-aab5-3b6c-73ea-a35306aacb64/mzaf_15627365450954002885.plus.aac.p.m4a\",\"track_name\":\"Up Hardman Street\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Hackney Folk Club\",\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"date_unix\":1776967200,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"171\",\"name\":\"Chats Palace\",\"address\":\"42-44 Brooksby's Walk, London E9 6DF\",\"location\":{\"lat\":51.5502294,\"lng\":-0.0429139000000305},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:24\",\"about\":{\"description\":\"**Mikey Kenney**\\n\\nMikey Kenney is primarily a respected fiddle player, singer, songwriter and composer from Liverpool, but he is also a multi-instrumentalist, often performing many of the parts on his recordings (on banjo, mandolin, guitar, melodeon etc).\\n\\nEmbracing duality, Kenney is very much the musical outsider artist; he is hailed by many as an important conduit of learning, conserving and handing down both English and Irish traditional fiddle music in England's Northwest (previously the musical director for the Lancashire Youth Folk Ensemble and currently the Vice-Chair at Comhaltas Liverpool) and yet he is constantly composing alternative and progressive music of his own with his last two releases Counsel of Owls and The Reverie Road receiving widespread acclaim (both 5/5 fRoots magazine).  \\n  \\nFor Kenney both of these releases serve as stepping stones in his artistic disciplines, as he seeks a way to use his knowledge of traditional fiddle music in his own compositions without compromising the integrity of either. Through direct experience, Kenney allows other musical forms such as psychedelia, bluegrass, jazz and Italian tarantella to seep into his music but never so far as to allow any one influence to dominate his deep love for traditional fiddle playing. The result of crossing these stones is his forthcoming work Tiny Little Light, set to be released in September 2025.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765497600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mikey Kenney\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2212fb8d78607447488fed07\"},\"artist_id\":\"87339\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-12/4fdc7539-0e89-4430-9335-9e675f9e0b44.jpg?rect=534%2C0%2C2133%2C2133\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-12/4fdc7539-0e89-4430-9335-9e675f9e0b44.jpg?rect=0%2C107%2C3200%2C1920\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-12/4fdc7539-0e89-4430-9335-9e675f9e0b44.jpg?rect=1014%2C0%2C1173%2C2133\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"693c43eb4ecba0000106725b\",\"name\":\"Hackney Folk Club - Mikey Kenney\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-04-23T21:15:00+01:00\",\"sale_start_date\":\"2025-12-12T19:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"l8odbr-hackney-folk-club-mikey-kenney-23rd-apr-chats-palace-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1989,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ya79496f501d?dice_id=Ya79496f501d\",\"post_competition_referral\":\"https://link.dice.fm/H0cbbbcee4a6?dice_id=H0cbbbcee4a6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Wea19b1ddb48?dice_id=Wea19b1ddb48\",\"post_purchase_referral\":\"https://link.dice.fm/W1d48e89aa00?dice_id=W1d48e89aa00\",\"post_reminder_referral\":\"https://link.dice.fm/l8b534bde1df?dice_id=l8b534bde1df\",\"post_waitinglist_referral\":\"https://link.dice.fm/jff27b263d43?dice_id=jff27b263d43\"},\"previews\":[],\"faqs\":[{\"id\":63467,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Born Again Concerts.\",\"billing_promoter\":{\"id\":\"2609\",\"name\":\"Born Again Concerts