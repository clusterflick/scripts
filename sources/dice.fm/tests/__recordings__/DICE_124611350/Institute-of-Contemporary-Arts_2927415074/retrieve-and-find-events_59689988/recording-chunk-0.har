t_end_date\":\"2026-05-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1771236000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2489},\"id\":\"698b1a2a1cf507000180d693\",\"name\":\"Clinton Kane\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Clinton Kane\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-29/174d41f1-9f6a-4333-a7d2-1e684b6e55ee.jpg?rect=0%2C43%2C554%2C554\"},\"artist_id\":\"38782\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"k69mm9-clinton-kane-15th-may-islington-assembly-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/9c66c861-b09e-41b8-a136-e2a70cca5ddc.jpg?rect=261%2C0%2C1024%2C1024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/9c66c861-b09e-41b8-a136-e2a70cca5ddc.jpg?rect=0%2C49%2C1545%2C927\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/9c66c861-b09e-41b8-a136-e2a70cca5ddc.jpg?rect=491%2C0%2C563%2C1024\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"*Clinton Kane creates out of necessity. The act of creation itself unpacks his unfiltered feelings and innermost thoughts, leaving truth threaded into the DNA of his ever-evolving sound. Such unapologetic honesty has not only humanized his artistry, but it’s also elevated him as a Platinum-certified phenomenon on his own terms. He’s captivated a rapt audience by unapologetically speaking his mind and heart, while constantly tinkering with his sound. You can practically hear him changing out loud and in real-time via his music.  \\nOn a series of 2025 singles and his independent 2026 mixtape, “4530 S Hualapai Way”, the singer, producer, and multi-instrumentalist still writes songs and performs like his life depends on it, because it does.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"faqs\":[{\"id\":23935,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0},{\"id\":75041,\"title\":\"How do I download the O2 Academy Venues app?\",\"body\":\"The O2 Academy Venues app is available to download for iOS and Android: https://www.academymusicgroup.com/o2forumkentishtown/o2-academy-venues-app\",\"order\":1},{\"id\":75042,\"title\":\"How do I find my ticket?\",\"body\":\"Your ticket is stored on the “Tickets” section of the O2 Academy Venues app. Simply select where you booked your tickets and log in using the email address you purchased your tickets with.\",\"order\":2},{\"id\":75043,\"title\":\"Do I need to transfer tickets to the rest of my group?\",\"body\":\"Yes, access to the venue requires all members of your group to have their own ticket, so make sure you transfer these in the O2 Academy Venues app before arriving at the venue. Ticket transfer will not be available for this event on DICE.\",\"order\":3},{\"id\":75044,\"title\":\"I can’t make it anymore, can I sell my ticket? \",\"body\":\"DICE Wait list returns are not available for this venue. You must use the O2 Academy Venues app to securely resell your tickets to another fan.\",\"order\":4},{\"id\":75045,\"title\":\"How to book accessible tickets for O2 Academy Kentish Town\",\"body\":\"More info on accessibility here: https://www.academymusicgroup.com/o2forumkentishtown/accessibility\",\"order\":5}],\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Devils Cut\",\"redirect_url\":\"https://open.spotify.com/track/2dfAHDMuNOpocaioVTFRAF\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a441f85b74ef7afffc3f11a0c3caf752fb8ea42b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Devils Cut\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778868000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"934\",\"name\":\"O2 Forum Kentish Town\",\"address\":\"9-17 Highgate Rd, London NW5 1JY\",\"location\":{\"lat\":51.5521427,\"lng\":-0.142224499999998},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"