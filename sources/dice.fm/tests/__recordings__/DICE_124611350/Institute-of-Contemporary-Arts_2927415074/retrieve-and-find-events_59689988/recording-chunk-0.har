e,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778783400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/W7c650074ab8?dice_id=W7c650074ab8\",\"post_competition_referral\":\"https://link.dice.fm/ccad67ea642c?dice_id=ccad67ea642c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l874d6825b08?dice_id=l874d6825b08\",\"post_purchase_referral\":\"https://link.dice.fm/F9d5150805fe?dice_id=F9d5150805fe\",\"post_reminder_referral\":\"https://link.dice.fm/J99f23c4f693?dice_id=J99f23c4f693\",\"post_waitinglist_referral\":\"https://link.dice.fm/I8292bbfb46f?dice_id=I8292bbfb46f\"},\"shopping_cart_enabled\":true,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Village Underground.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:4\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T10:00:00+00:00\",\"sale_end_date\":\"2026-05-14T21:00:00+01:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:30:00+01:00\",\"event_end_date\":\"2026-05-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1764928800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1854},\"id\":\"69304baa4d47cb00016f1cd3\",\"name\":\"Michael Sebastian & Friends\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Michael Sebastian\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-18/3bea8340-ed5f-4ec5-8197-ca9af8265f3d.jpg?rect=0%2C2176%2C5156%2C5156\"},\"artist_id\":\"15279\",\"about\":{\"description\":\"Michael Sebastian creates Live Dance Music.\\n\\nIt has the structure of electronic; the freedom of jazz, and the depth of world.\\n\\n“an improvisatory joy, a muscular blast of indie-electronics worth filing alongside Bonobo or Bicep”- **Clash**\\n\\nA South African in London, Sebastian has a strong presence in the city with recent headline shows at EartH Hackney & Colour Factory, support slots for James Blake and Four Tet at Alexandra Palace, as well as being named a top 5 global Sofar artist.\\n\\nFuelled by the relationship between music and dance, he finds himself at the intersection between club, contemporary and conscious dance spaces.\\n\\nIn his live shows he merges contemporary discipline with transcendental spirituality through jazz\\n\\nimprovisation and play, often involving talented collaborators. His objective is to create spaces of collective ecstasy, inspired by his own time on the dancefloor.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"xe755m-michael-sebastian-friends-14th-may-village-underground-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/4c0b1c1d-c24d-45d6-98c7-821c7de10c1d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/4c0b1c1d-c24d-45d6-98c7-821c7de10c1d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/4c0b1c1d-c24d-45d6-98c7-821c7de10c1d.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Michael Sebastian & Friends Live\\n\\nOn the 14th May Michael Sebastian celebrates the release of his album ‘Suggestions for The Dancefloor’ with an immersive live show and movement experience.\\n\\nSuggestions for the Dancefloor is a campaign to liberate people in movement & life. A high energy selection of live and uplifting party anthems inspired by all kinds of dance music, from Afrobeat, to House, to Breakbeat, to Jungle.\\n\\nMichael combines electronic, world and jazz music to create an engaging and uplifting experience. Four Tet meets Fela Kuti with a dance crew.With recent headlines at Earth & Colour Factory Village Underground is sure to be a really special night.\\n\\nThe show will feature a selection of live collaborators, both dancers & musicians. Expect a unifying and activating experience, and a sensation of collective ecstasy.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778783400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/qba2aa69f9f6?dice_id=qba2aa69f9f6\",\"post_competition_referral\":\"https://link.dice.fm/J5d08f1fcf49?dice_id=J5d08f1fcf49\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R17494192a77?dice_id=R17494192a77\",\"post_purchase_referral\":\"https://link.dice.fm/w4a52972092c?dice_id=w4a52972092c\",\"post_reminder_referral\":\"https://link.dice.fm/e52f57bf148a?dice_id=e52f57bf148a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jb630c26b65d?dice_id=Jb630c26b65d\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":4,\"presented_by\":\"Presented by Kings Place.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:5\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-21T01:00:00+01:00\",\"sale_end_date\":\"2026-05-14T17:00:00+01:00\",\"sale_start_date\":\"2025-10-21T01:00:00+01:00\",\"event_start_date\":\"2026-05-14T19:30:00+01:00\",\"event_end_date\":\"2026-05-14T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1761004800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2620,\"sales_tax\":0,\"amount_from\":null},\"id\":\"68f7da5932b5d80001b928b3\",\"name\":\"Northern Resonance\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"new\":false,\"seating\":null,\"perm_name\":\"53x9w8-northern-resonance-14th-may-kings-place-hall-two-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/2a709cbe-ae19-4f93-a163-e10c898005ce.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/2a709cbe-ae19-4f93-a163-e10c898005ce.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/2a709cbe-ae19-4f93-a163-e10c898005ce.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"***Northern Resonance is the Scandinavian string trio that takes newly composed folk music into enormous soundscapes. With their previously untested combination of instruments; Anna Ekborg, Hans-Ers (Viola D’amore) Petrus Dillner (Nyckelharpa) Jerker “JJ” Hans-Ers (Hardanger Fiddle) they let Scandinavian music meet explosive rhythms and grand chamber-like arrangements that takes folk music in a new direction.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nAll members of **Northern Resonance** are highly skilled and accomplished musicians, rooted in traditional music. With an intense musical connection that is rare to come across, they invite you into their world of compositions. There is great life in their tunes, and the trio knows how to bring it out.\\n\\nWith their debut album which was released in the autumn of 2020, Northern Resonance have already established themselves with a glorious sound. The album was nominated for a Swedish Grammy and they recently released their second album *Vision of Three*. During 2024 the trio are performing in Australia, Chile, Colombia, Germany, USA, Canada, England and Scotland, all under the name Vision Tour 2024.\\n\\n***This event will last approximately 90 minutes, with an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Thu 14 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":12},\"faqs\":[{\"id\":64553,\"title\":\"Wristband Collection\",\"body\":\"All attendees must show their tickets on arrival & have these swapped for a wristband. You can swap your ticket for a wristband from outside the Black Heart on Greenland Place on Friday from 12.30pm-9pm.\",\"order\":0},{\"id\":64554,\"title\":\"Is re-entry allowed?\",\"body\":\"Yes, your day ticket allows you into every venue associated with Desertfest for that day. Please note, however, that if a venue is at max capacity it will operate on a one-in-one-out system.\",\"order\":1},{\"id\":64555,\"title\":\"When is last entry?\",\"body\":\"Las