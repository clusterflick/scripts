ull,\"doors_open_date\":\"2026-03-04T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/fea8610d-08df-4d2f-8304-7ba7bb64d958.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/fea8610d-08df-4d2f-8304-7ba7bb64d958.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/fea8610d-08df-4d2f-8304-7ba7bb64d958.jpg?rect=270%2C0%2C660%2C1200\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/A9bf4d0d42ce?dice_id=A9bf4d0d42ce\",\"post_competition_referral\":\"https://link.dice.fm/n2a9cc79e893?dice_id=n2a9cc79e893\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E3ccff6d51bf?dice_id=E3ccff6d51bf\",\"post_purchase_referral\":\"https://link.dice.fm/G29642946e99?dice_id=G29642946e99\",\"post_reminder_referral\":\"https://link.dice.fm/r11946676546?dice_id=r11946676546\",\"post_waitinglist_referral\":\"https://link.dice.fm/j516221984a7?dice_id=j516221984a7\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:84\",\"properties\":[],\"presented_by\":\"Presented by Communion ONE.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763640000,\"id\":\"691cb35fb3a32f00011376be\",\"name\":\"Emmy Meli\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Communion ONE presents**\\n\\n**Emmy Meli**\\n\\nEmmy Meli is a young R&B artist from Long Beach, CA who first gained attention with her breakout single, “I Am Woman,” a powerful anthem of female empowerment that resonated with millions. With a strong voice—both literally and artistically—Emmy has always leaned into themes of self-love and feminism, blending her favorite genres like R&B, jazz, funk, hip hop, and pop into a sound that’s uniquely her own.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2252,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-10T10:00:00+00:00\",\"sale_end_date\":\"2026-03-04T18:00:00+00:00\",\"sale_start_date\":\"2025-11-14T10:00:00+00:00\",\"event_start_date\":\"2026-03-04T19:00:00+00:00\",\"event_end_date\":\"2026-03-04T22:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"av7re2-chinchilla-4th-mar-scala-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"How to Be Me\",\"redirect_url\":\"https://open.spotify.com/track/1Ec6reYdkNaqRWPDsbErxl\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bb5a5f45dc1515218ae5ae6401e1a40adfc8307c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"How to Be Me\"},{\"type\":\"apple_music\",\"title\":\"CHINCHILLA - Bitches\",\"redirect_url\":\"https://music.apple.com/gb/album/bitches/1503319811?i=1503319819&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"CHINCHILLA\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview123/v4/10/f3/33/10f333ce-ee44-3640-cb64-9fbda22ed97b/mzaf_2914485017205104282.plus.aac.p.m4a\",\"track_name\":\"Bitches\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Chinchilla\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb57f5eed98b1b0bac82b99021\"},\"artist_id\":\"20054\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-04T19:00:00+00:00\",\"doors_close_date\":\"2026-03-04T22:15:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-07/1c0594ee-ca5e-41f9-9197-db2664f7df26.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-07/1c0594ee-ca5e-41f9-9197-db2664f7df26.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-07/1c0594ee-ca5e-41f9-9197-db2664f7df26.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/L7fe76caa4df?dice_id=L7fe76caa4df\",\"post_competition_referral\":\"https://link.dice.fm/Uaa9be059a84?dice_id=Uaa9be059a84\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/dd44c0437cae?dice_id=dd44c0437cae\",\"post_purchase_referral\":\"https://link.dice.fm/Oc829117fc58?dice_id=Oc829117fc58\",\"post_reminder_referral\":\"https://link.dice.fm/I0b144c489f3?dice_id=I0b144c489f3\",\"post_waitinglist_referral\":\"https://link.dice.fm/q08dfa35fe1e?dice_id=q08dfa35fe1e\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:85\",\"properties\":[],\"presented_by\":\"Presented by Live Nation\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1762768800,\"id\":\"690e3d89da0714000121330d\",\"name\":\"Chinchilla\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Following the success of her trilogy EP ‘Ok As I Am’, London artist CHINCHILLA is ready for 2026. The bold, take-no-shit persona behind the songwriter and producer’s breakout hits ‘Little Girl Gone’ and ‘Cut You Off’ made way in 2025 for a rawer, more confessional side to CHINCHILLA as a person and artist. Multidimensional, undeniably a force to be reckoned with, both in the studio and on stage.\\n\\n2025 entailed a run of three sold-out UK headline shows to stadium dates in June opening for Justin Timberlake across Europe, continuing CHINCHILLA’s soaring momentum. CHINCHILLA then supported G Flip on the US leg of their 2025 tour, before rolling straight into a sold out run of headline dates in Europe this autumn.\\n\\nWell known for her electrifying anthems against naysayers and the challenges she has faced in the music industry, CHINCHILLA has also shown that sensitivity is her superpower. Even in the quiet moments, the strength of her voice is undeniable. Abundantly creative, fiercely independent and always honest, CHINCHILLA represents someone who is unafraid to face herself.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3657,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-20T10:00:00+01:00\",\"sale_end_date\":\"2026-03-04T16:00:00+00:00\",\"sale_start_date\":\"2025-10-24T10:00:00+01:00\",\"event_start_date\":\"2026-03-04T19:00:00+00:00\",\"event_end_date\":\"2026-03-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g56grb-boy-bear-4th-mar-koko-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Breach\",\"redirect_url\":\"https://open.spotify.com/track/1WXVfFRD89EtVURD4Tbixo\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/888e17c72e7717c5bb29d42e3a02fdee5f992667?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Breach\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":51171,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dustin Tebbutt\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1027c8f03165b9d077e9465b\"},\"artist_id\":\"4106\",\"about\":null,\"is_headliner\":false},{\"name\":\"Boy & Bear\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0fe99c60e94cf0fa9e140f88\"},\"artist_id\":\"45837\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-04T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-16/9da92dd7-d70f-47a0-bc05-37a5fbde104f.jpg?rect=1000%2C0%2C6000%2C6000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-16/9da92dd7-d70f-47a0-bc05-37a5fbde104f.jpg?rect=0%2C600%2C8000%2C4800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-16/9da92dd7-d70f-47a0-bc05-37a5fbde104f.jpg?rect=2350%2C0%2C3300%2C6000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/ta6e212763fd?dice_id=ta6e212763fd\",\"post_competition_referral\":\"https://link.dice.fm/B4bd1a96a99a?dice_id=B4bd1a96a99a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N7a35bfc007b?dice_id=N7a35bfc007b\",\"post_purchase_referral\":\"https://link.dice.fm/w6f3c79b3d01?dice_id=w6f3c79b3d01\",\"post_reminder_referral\":\"https://link.dice.fm/h94b85df0fe5?dice_id=h94b85df0fe5\",\"post_waitinglist_referral\":\"https://link.dice.fm/v1375b988d61?dice_id=v1375b988d61\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:86\",\"properties\":[],\"presented_by\":\"Presented by FORM.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760950800,\"id\":\"68f1f5972291e700019652ad\",\"name\":\"Boy & Bear\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"FORM Presents\\n\\nBOY & BEAR\\n\\n\\\\+ Dustin Tebbutt\\n\\nBoy & Bear swiftly catapulted onto the world stage releasing their double-platinum debut album Moonfire which went on to receive five coveted ARIA awards. Their Harlequin Dream and Limit of Love albums both charted at #1 with Harlequin Dream also reaching Platinum sales. With five consecutive top 10 albums and over half-a-‘billion’ streams, Boy & Bear have just announced their 6th studio album ‘Tripping Over Time’ will be released this December. With a new album on the way and a uniquely compelling live show that has earned the band the glowing reputation as one of Australia’s most outstanding live acts and captivating musical exports, Boy & Bear continue to evolve and impress.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (U16s accompanied by an adult 18+).\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3284,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-29T10:00:00+01:00\",\"sale_end_date\":\"2026-03-04T16:00:00+00:00\",\"sale_start_date\":\"2025-10-03T10:00:00+01:00\",\"event_start_date\":\"2026-03-04T19:00:00+00:00\",\"event_end_date\":\"2026-03-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"92g5ed-madison-cunningham-4th-mar-o2-shepherds-bush-empire-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Strong Enough\",\"redirect_url\":\"https://open.spotify.com/track/69qLjFRZbz7V7uM13DtmOW\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7bf687dcb824ee667aa05c80e8