out\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"101\",\"name\":\"Dingwalls\",\"address\":\"Middle Yard, Camden Lock, London NW1 8AB\",\"location\":{\"lat\":51.5414979,\"lng\":-0.145865500000014},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dingwalls-jan2\",\"accessibility\":{\"url\":\"https://dingwalls.com/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-09T19:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/9c9876b7-d8a1-4b3c-8315-4dabb210eb7a.jpg?rect=648%2C0%2C3221%2C3221\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/9c9876b7-d8a1-4b3c-8315-4dabb210eb7a.jpg?rect=0%2C161%2C4832%2C2899\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/9c9876b7-d8a1-4b3c-8315-4dabb210eb7a.jpg?rect=1530%2C0%2C1772%2C3221\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/T97c99a3786a?dice_id=T97c99a3786a\",\"post_competition_referral\":\"https://link.dice.fm/pc3ecd3e7c34?dice_id=pc3ecd3e7c34\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D55a418316e3?dice_id=D55a418316e3\",\"post_purchase_referral\":\"https://link.dice.fm/id67ca29c572?dice_id=id67ca29c572\",\"post_reminder_referral\":\"https://link.dice.fm/G75e0b5bbf0c?dice_id=G75e0b5bbf0c\",\"post_waitinglist_referral\":\"https://link.dice.fm/gaac79d89ab1?dice_id=gaac79d89ab1\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:27\",\"properties\":[],\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770199200,\"id\":\"698186dd6f94d60001036780\",\"name\":\"A Certain Ratio - Sextet and Force Anniversary Show\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nA Certain Ratio\\n\\nDingwalls - October 9th\\n\\nIn October ACR will be hitting the road to celebrate the Anniversary of their classic and beloved albums, Sextet and Force. Both albums will be played in full with an interval in between and some surprises thrown in.\\n\\nIt’s 45 years since ACR went into Revolution Studios in Cheadle Hulme, Stockport to record the 1982 album Sextet and it’s 40 years since the release of the 1986 album Force which was also recorded in Stockport but at Yellow 2.\\n\\nSextet is ACR’s most critically acclaimed album and it was the first album they produced as ACR, it includes the majestic Lucinda and the live favourite Knife Slits Water.\\n\\nForce is one of their most commercial albums, produced by ACR and the late Stuart (Jammer) James and is their last album on Factory Records, it includes funky masterpiece Mickey Way and live party favourite Si Firmo O Grido.\\n\\nEach album is starkly different to each other yet very clearly ACR.\\n\\n“We’re celebrating these two milestones with this tour to say we are very excited is an understatement. It will be a real challenge, which we’ve already started preparing for, with nine months to go! We will be playing two sets with no support”\\n\\nSextet 11 weeks on the UK independent chart and reached No 1\\n\\nForce spent 9 weeks on the UK independent charts peaking at No. 2.\\n\\nSounds 5 star review “SEXTET is an album of the present, killing the past and agreeably ignoring the future. It is an after-Rock Record. This is one of the most strategically tired albums you’ll hear all year. It is also one of the best.”\\n\\nNME praised Sextet for its \\\"taut, abrasive swagger\\\" and its unique blend of Afro-Brazilian rhythms, dance-funk, and avant-jazz, with tracks like Knife Slits Wate\\\" and Lucinda recognized as masterful, rhythmic post-punk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"date_unix\":1791570600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1175,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-23T15:30:00+00:00\",\"sale_end_date\":\"2026-10-09T18:30:00+01:00\",\"sale_start_date\":\"2025-12-23T15:30:00+00:00\",\"event_start_date\":\"2026-10-09T19:30:00+01:00\",\"event_end_date\":\"2026-10-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dolp-grl-9th-oct-the-100-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"ANTIPOP\",\"redirect_url\":\"https://open.spotify.com/track/6s094lk8VLJrziv2gbKRLe\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/393156be7a527a385f13f1db70f12241b4fa5699?cid=921526