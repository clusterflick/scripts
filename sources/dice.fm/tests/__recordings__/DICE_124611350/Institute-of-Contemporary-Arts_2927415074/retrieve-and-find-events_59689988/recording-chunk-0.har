,\"order\":0}],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"8e82p5-lakeview-13th-jun-229-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781373600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:41\",\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-13T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lakeview\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd007a30f76edfd419bef511a\"},\"artist_id\":\"111456\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Lakeview come to 229 on the 13th June 2026.\\n\\n14+, U18's accompanied by an adult. Physical photographic ID required for entry.\\n\\nTattooed, rural, and blue-collar country duo Lakeview — Jesse Denaro and Luke Healy — are among Nashville’s fastest-rising new acts. With over 140 million streams and a devoted audience of nearly 700,000 fans across social media, the duo has carved out a lane entirely their own. Dubbed “weekend warriors–turned–Music Row favorites” by The Tennessean, Lakeview’s hard-charging sound bridges the raw intensity of metalcore with the grit and storytelling of modern country.\\n\\nIn 2025, Lakeview toured their debut album worldwide, delivering 115 shows to more than 400,000 fans and sharing stages with artists like Nickelback, Breaking Benjamin, Staind, Dustin Lynch, Chase Matthew, and more. Kicking off 2026, the duo returns with new music, including their latest single “Can’t Live Without,” and will tour extensively across the U.S. throughout February, March, and April with headline dates, festival appearances, and a lengthy run as direct support for Warren Zeiders.\\n\\nMajor festival appearances across the U.S., Canada, and Europe follow in summer 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+. U18's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T15:00:00+00:00\",\"sale_end_date\":\"2026-06-13T17:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-06-13T19:00:00+01:00\",\"event_end_date\":\"2026-06-13T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69653d644a22f30001f26d04\",\"name\":\"Lakeview\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/5cbdd570-abba-4a01-b72a-4807a7d909ff.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/5cbdd570-abba-4a01-b72a-4807a7d909ff.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/5cbdd570-abba-4a01-b72a-4807a7d909ff.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"priva