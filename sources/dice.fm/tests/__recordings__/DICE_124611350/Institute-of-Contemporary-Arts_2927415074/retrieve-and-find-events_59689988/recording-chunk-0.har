\",\"post_reminder_referral\":\"https://link.dice.fm/O73f1b69fce9?dice_id=O73f1b69fce9\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"*Elles Bailey, the inspirational, award winning, smokey voiced chanteuse who has powered her way to the forefront of the British Americana and Roots scenes in recent years, has released her 4th studio album ‘Beneath the Neon Glow’ and has just completed her largest UK tour to date. ‘Beneath The Neon Glow’ has had glowing reviews across the board and hit number #12 in the Official Album Charts, #1 in the UK Official Blues Charts, #2 in the UK Official Americana Charts, & #3 in the UK Official Independent Charts. The album was nominated for Album of the Year at the UK Americana Awards 2025 and has just picked up Album of the Year at the UK Blue Awards 2025.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:9\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"presented_by\":\"Presented by Kilimanjaro Live.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Elles Bailey\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebace85b0bfb61e2972d71fe28\"},\"artist_id\":\"41980\",\"about\":null,\"is_headliner\":true},{\"name\":\"Caitlin Krisko & The Broadcast\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-24/745ccb64-26b7-40ab-bff7-d5bc21bfa089.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"127779\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purcha