l\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772044200,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:17\",\"price\":{\"currency\":\"GBP\",\"amount\":1693,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/4e280ecf-edb7-4e45-9ce0-9e95c0c02007.jpg?rect=0%2C68%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/4e280ecf-edb7-4e45-9ce0-9e95c0c02007.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/4e280ecf-edb7-4e45-9ce0-9e95c0c02007.jpg?rect=169%2C0%2C743%2C1350\"},\"id\":\"6971ffd9ef187e0001534d47\",\"name\":\"Soho Calling: Ellur + Panam + Becky Sikasa\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"This ticket will grant entry to the show at The Blue Basement only - no readmission.\\n\\nDoors open: 6:30\\n\\nEllur + Panam + Becky Sikasa\\n\\nThe fourth edition of Soho Calling will take place on the 25th February 2026 in Soho, the beating heart of London’s music culture, and a district which has nurtured legendary artists and hosted groundbreaking performances that have shaped the global music landscape.\\n\\nHonouring this legendary district by bringing over 25 exciting emerging artists to Soho's iconic stages, Soho Calling will take place across multiple venues: The 100 Club, 21Soho, Phoenix Arts Club, The Social, B.R.A.T, Anotherland and The Blue Basement at Third Man Records.\\n\\nSoho Calling is supported by a wealth of great partners including Music Venue Trust, BBC Introducing, The Spanish Wave, Clash and Notion.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Eu