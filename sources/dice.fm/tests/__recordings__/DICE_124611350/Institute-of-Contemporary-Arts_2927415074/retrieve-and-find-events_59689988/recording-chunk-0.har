allis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"We're inviting you to experience the magic of our weekly Thursday Jazz Jam. Since 2016, Stratos, our resident jazz band led by the talented and Mercury Prize-nominated Rio Kai, has held down this popular night, bringing together fans and musicians for an electrifying exploration of jazz.\\n\\nEvery week, Stratos dives into both the classic roots and boundary-pushing edges of jazz, creating a unique space where improvisation and connection take center stage. With Rio Kai on bass, Dom Pusey on saxophone, Mike De Souza on guitar, and Zoe Pascal on drums, each set offers something new—a true celebration of live, evolving music.\\n\\nAfter the first set, they open up the jam to jazz musicians who want to get involved! Contact @stratostheband on Instagram if you’re interested in jamming. It’s free entry for jammers.\\n\\nSet against the backdrop of our Hackney Wick canalside venue, this long-standing jazz night embodies both the charm of our community and the sophistication of jazz itself. Join us for Join in January and see what makes this night such a beloved fixture at Grow!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:0\",\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"presented_by\":\"Presented by Grow, Hackney.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Stratos\",\"image\":null,\"artist_id\":\"90229\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1755644400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-20T00:00:00+01:00\",\"sale_end_date\":\"2026-02-19T18:30:00+00:00\",\"sale_start_date\":\"2025-12-10T13:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69398b1db42ee30001ceab6a\",\"name\":\"LIVE JAZZ JAM W/ STRATOS \",\"price\":{\"currency\":\"GBP\",\"amount\":612,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":true,\"is_hidden_event\":false,\"perm_name\":\"ryay8q-the-orielles-live-signing-19th-mar-rough-trade-east-london-london-tickets\",\"seating\":null,\"tty_to_extras\":[{\"ticket_type_id\":1122072,\"extra_ids\":[\"1127623\"]},{\"ticket_type_id\":1122073,\"extra_ids\":[\"1127623\"]},{\"ticket_type_id\":1122074,\"extra_ids\":[\"1127623\"]}],\"streaming_options\":null,\"date_unix\":1773946800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/9ea1346f-ff88-4683-85d0-86495b5ff7ea.jpg?rect=0%2C320%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/9ea1346f-ff88-4683-85d0-86495b5ff7ea.jpg?rect=0%2C576%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/9ea1346f-ff88-4683-85d0-86495b5ff7ea.jpg?rect=112%2C0%2C1056%2C1920\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/wca44d104969?dice_id=wca44d104969\",\"post_competition_referral\":\"https://link.dice.fm/lcfb233239e9?dice_id=lcfb233239e9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S7cc1560f3d3?dice_id=S7cc1560f3d3\",\"post_purchase_referral\":\"https://link.dice.fm/pea211aea6bb?dice_id=pea211aea6bb\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jb2caada0072?dice_id=Jb2caada0072\",\"post_reminder_referral\":\"https://link.dice.fm/X0861c728a2f?dice_id=X0861c728a2f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Rough Trade East is very excited to present a live performance and signing from The Orielles. This unique event celebrates the release of their new album 'Only You Left' released via Heavenly Recordings.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/the-orielles/only-you-left\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:1\",\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"presented_by\":\"Presented by Rough Trade.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Orielles\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-17/d885a48c-c49a-4f94-8a37-211fe2f48e18.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"2118\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1764248400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T13:00:00+00:00\",\"sale_end_date\":\"2026-03-19T19:00:00+00:00\",\"sale_start_date\":\"2025-11-27T13:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"691b1629547a440001568af8\",\"name\":\"The Orielles: Live + Signing\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1250},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Orielles - Three Halves\",\"redirect_url\":\"https://open.spotify.com/track/2d1phWQyfC2aTXEpu7MBNK\",\"artist\":\"The Orielles\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7911ab04baa2a49f19f988f8de289a0dc82db133?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Three Halves\"},{\"type\":\"apple_music\",\"title\":\"The Orielles - Three Halves\",\"redirect_url\":\"https://music.apple.com/us/album/three-halves/1843114208?i=1843114213&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Orielles\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/27/ae/a1/27aea124-d122-e512-d59d-156a669edf6e/mzaf_16508942723827855152.plus.aac.p.m4a\",\"track_name\":\"Three Halves\"}],\"faqs\":[{\"id\":35994,\"title\":\"Is Rough Trade Bristol wheelchair accessible?\",\"body\":\"Our venue is fully wheelchair accessible with step free access, although some assistance would be required to enter and exit the venue which is through 2 sets of double fire doors in the bar area. You can add an accessibility ticket onto your original ticket by going to dice.fm/contact.\\n\\nWe will always strive to ensure our venue is accessible as possible, so if you have further questions or requests please do not hesitate to contact us.\",\"order\":0},{\"id\":35995,\"title\":\"Is accessible seating available?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":1},{\"id\":35996,\"title\":\"How do I get a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":2},{\"id\":35997,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release. There is an hour between the door time and the stage time.\",\"order\":3},{\"id\":36000,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":4},{\"id\":36001,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":5},{\"id\":36002,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":6},{\"id\":35998,\"title\":\"I can’t attend the show! Can I still get my record signed?\",\"body\":\"Yes! We will always aim to get all event orders signed. Although this sometimes depends on the artist's schedule. We keep event stock for 1 week before returning it to our warehouse. If you can’t pick it up within a week please contact the store of your event.\",\"order\":7},{\"id\":36003,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":8},{\"id\":36038,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":9},{\"id\":35999,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":10},{\"id\":58108,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":11},{\"id\":58109,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":12},{\"id\":58110,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":13},{\"id\":58111,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":14},{\"id\":58112,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":15},{\"id\":58113,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":16},{\"id\":58114,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":17},{\"id\":58115,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":18},{\"id\":58116,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":19},{\"id\":58117,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":20}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"dkakle-kossoff-the-band-plays-on-19th-mar-hot-box-chelmsford-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773946800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/95f019fa-6b97-4717-9dc3-600e366df901.jpg?rect=0%2C0%2C1448%2C1448\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/95f019fa-6b97-4717-9dc3-600e366df901.jpg?rect=0%2C590%2C1448%2C869\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/95f019fa-6b97-4717-9dc3-600e366df901.jpg?rect=161%2C0%2C1126%2C2048\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q5fcf3e0bd4e?dice_id=Q5fcf3e0bd4e\",\"post_competition_referral\":\"https://link.dice.fm/rcd252e563df?dice_id=rcd252e563df\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w9c42a7e5fe1?dice_id=w9c42a7e5fe1\",\"post_purchase_referral\":\"https://link.dice.fm/U7ba2169fdcc?dice_id=U7ba2169fdcc\",\"post_waitinglist_referral\":\"https://link.dice.fm/sa4e2765b2d3?dice_id=sa4e2765b2d3\",\"post_reminder_referral\":\"https://link.dice.fm/D6e95ad48a1f?dice_id=D6e95ad48a1f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"50th ANNIVERSARY GIG - REMEMBERING KOSS\\n\\nOn the 19th March 2026…. it will be fifty years since the tragic death of Paul Kossoff.\\n\\nKossoff…The Band Plays On intend to commemorate Paul’s life and music in a series of very special shows. The show we have is on the actual date we lost Paul.\\n\\nPaul Kossoff, the guitar prodigy, aged just 25, tragically died in March 1976 - but his music lives on. Kossoff was (and still is) revered by music fans and fellow musicians worldwide.\\n\\nJoe Bonamassa, Brian May (Queen), Gary Rossington (Lynyrd Skynyrd), and Warren Haynes (Allman Brothers / Government Mule) are just a few of the guitarists influenced by Kossoff.\\n\\nThe band is fronted by Terry Slesser, the former lead vocalist of Back Street Crawler, with Paul, and the line-up includes some well-known musicians, making this show way beyond a mere ‘tribute’ act.\\n\\nGuitarist John Buckton embodies the sound, soul and rawness of Koss' playing, and it’s no surprise that Free drummer Simon Kirke has said: \\\"If Free were to reform, John would be my first choice as guitarist.\\\"\\n\\nAlso included in the line-up is powerhouse drummer Clive Edwards, formerly of UFO, Wild Horses and Lionheart.\\n\\nThe lineup is completed with the revered and inimitable John ‘Rhino’ Edwards (Status Quo) on bass guitar.\\n\\nHighlights will include Free’s “All Right Now”, “Fire and Water”, “Wishing Well”, crowd-pleaser “The Hunter” and “Molten Gold”; one of the first tracks Slesser and Kossoff played together with Back Street Crawler.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:2\",\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"presented_by\":\"Presented by Black Frog\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1763078400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-14T00:00:00+00:00\",\"sale_end_date\":\"2026-03-19T19:00:00+00:00\",\"sale_start_date\":\"2025-11-14T00:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69176cce547a440001c1a46f\",\"name\":\"KOSSOFF... The Band Plays On\",\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"eobg8o-freak-slug-19th-mar-the-garage-london-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773946800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/cc03adb7-7260-4f57-b810-fde090cc631d.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/cc03adb7-7260-4f57-b810-fde090cc631d.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/cc03adb7-7260-4f57-b810-fde090cc631d.jpg?rect=180%2C0%2C440%2C800\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/r78473fe8c4a?dice_id=r78473fe8c4a\",\"post_competition_referral\":\"https://link.dice.fm/eda68479ace4?dice_id=eda68479ace4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v52cf91bb7a0?dice_id=v52cf91bb7a0\",\"post_purchase_referral\":\"https://link.dice.fm/n7e08595b42e?dice_id=n7e08595b42e\",\"post_