":false,\"secondary_status\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:58\",\"properties\":[],\"presented_by\":\"Presented by Short Waves \",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769644800,\"id\":\"697b7ba0795ca40001dabaf2\",\"name\":\"The Place It's There - EP Release Party\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Short Waves presents... The Place It's There EP Release Party**\\n\\nThe Place It's There are an indie rock band from London. Their first EP is a short, concise effort, that takes inspiration from the classic british indie rock music of the 90s/early 2000s, and meets that with a more grunge inspired alternative rock sound of the same era. Their live set takes on these songs as well as more unreleased material, with the band also set to premiere their first ever music video on the night.\\n\\n(*https://www.instagram.com/theplaceitsthere/*)\\n\\nwith support from\\n\\n**Running Standard**\\n\\n(*https://www.instagram.com/runningstandard/*)\\n\\n**Tortured Devices**\\n\\n(*https://www.instagram.com/tortured_devices/*)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"197\",\"name\":\"DreamBagsJaguarShoes\",\"image\":{\"url\":null},\"perm_name\":\"dreambagsjaguarshoes-ja92\",\"profile_active\":false},\"date_unix\":1771788600,\"event_tag\":null},{\"tty_to_extr