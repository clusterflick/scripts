a9bde238c2b.jpg?rect=2056%2C0%2C3086%2C3086\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/c5c0c11d-ec60-4a3b-87e3-3a9bde238c2b.jpg?rect=663%2C0%2C5143%2C3086\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/c5c0c11d-ec60-4a3b-87e3-3a9bde238c2b.jpg?rect=2386%2C0%2C1697%2C3086\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/ba59add2b464?dice_id=ba59add2b464\",\"post_competition_referral\":\"https://link.dice.fm/ce80cd49c772?dice_id=ce80cd49c772\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jfdb67574dd5?dice_id=jfdb67574dd5\",\"post_purchase_referral\":\"https://link.dice.fm/K9d6bfd2eff6?dice_id=K9d6bfd2eff6\",\"post_reminder_referral\":\"https://link.dice.fm/Z6cd4b86935f?dice_id=Z6cd4b86935f\",\"post_waitinglist_referral\":\"https://link.dice.fm/h1bdc18ea075?dice_id=h1bdc18ea075\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"db136d3610fd9326:30\",\"properties\":[],\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770076800,\"id\":\"69821c616b8e75000164282f\",\"name\":\"Biscuit Town ft. Immy Churchill\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"A swinging Saturday night of classic 1920s and 1930s tunes\\n\\nBiscuit Town are an early-era swing band with a hard-driving acoustic rhythm section, soulful vocals and mesmerising solos. They return with special guest Immy Churchill to Toulouse Lautrec Jazz Club. Immy is a fast-rising star of the London jazz scene. A graduate of the Royal Academy of Music, she has already performed at venues including Ronnie Scott’s, The Royal Albert Hall, The Jazz Café and the Royal Festival Hall. With Biscuit Town, she brings her warmth, swing and irresistible charm to the timeless songs of the 1920s and 30s.\\n\\nBiscuit Town have built a reputation for bringing vintage swing to life, playing to packed houses at jazz clubs, swing dance events and festivals across the UK. Their shows are always full of energy, joy and a deep love of early jazz.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"date_unix\":1771709400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1700,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-06T00:30:00+00:00\",\"sale_end_date\":\"2026-02-22T03:00:00+00:00\",\"sale_start_date\":\"2026-01-06T00:30:00+00:00\",\"event_start_date\":\"2026-02-21T22:00:00+00:00\",\"event_end_date\":\"2026-02-22T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"3ogmll-the-prog-lab-x-gemini-sounds-presents-tim-green-21st-feb-no90-hackney-wick-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Eyes Closed - Tim Green Remix\",\"redirect_url\":\"https://open.spotify.com/track/1QB3726ZcCld350MB5PDGi\",\"artist\":\"Eyes Closed\",\"preview_url\":\"https://p.scdn.co/mp3-preview/11b250f1d2f12fe6c8a5ea5a9c8e02f6b373b891?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Tim Green Remix\"},{\"type\":\"apple_music\",\"title\":\"Tim Green - For A Memory\",\"redirect_url\":\"https://music.apple.com/us/album/for-a-memory/1720111617?i=1720111623&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Tim Green\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/40/2b/72/402b72cc-9e14-ead4-7e3c-7c5dd7752eca/mzaf_2840953002857592648.