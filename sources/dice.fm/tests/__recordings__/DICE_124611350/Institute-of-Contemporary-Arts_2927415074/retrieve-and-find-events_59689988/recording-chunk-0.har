rue,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1771286400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":969,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sat 21 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-11-22T15:00:00+00:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-11-22T15:00:00+00:00\",\"event_end_date\":\"2026-11-22T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Black Frog\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/p10a46e93e91?dice_id=p10a46e93e91\",\"post_competition_referral\":\"https://link.dice.fm/h0d349fb37ab?dice_id=h0d349fb37ab\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jf7f8cc1c69c?dice_id=jf7f8cc1c69c\",\"post_purchase_referral\":\"https://link.dice.fm/Kd07373cc9e1?dice_id=Kd07373cc9e1\",\"post_reminder_referral\":\"https://link.dice.fm/t1322e20a18a?dice_id=t1322e20a18a\",\"post_waitinglist_referral\":\"https://link.dice.fm/B84c34dfb571?dice_id=B84c34dfb571\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Katie will released her third album What Love Is in October 2025; an intimate collection of ten brand-new songs produced by Matt Ingram (Laura Marling, The Staves). Recorded in London’s Urchin Studios and featuring prominent players Giacomo Smith (clarinet), Max Clilverd (pedal steel), Tom Mason (double bass) and Matt Ingram (drums, synth). What Love Is evokes the spirit of Joni Mitchell’s finest later works, always honouring without emulating. Lyrically mature and at times pastoral; the album is melodically sophisticated and unflinchingly honest. She moves effortlessly from wide-open jazz-tinged soundscapes, influenced by Pharoah Sanders and John Abercrombie, through to the folk-baroque fingerpicking style that her fans admire her for. Her singing is powerful yet warm, true and pristine in delivery. The musicianship throughout the record feels liberated by Katie’s innovation and confidence, and the result is a master-class of inspired and beautiful-sounding craftmanship.\\n\\n‘... a world-class folk guitarist’ – fRoots\\n\\n'Katie’s guitar playing has echoes of my dear friend the late great Bert Jansch. Like a musical weaver she threads her poetic lyrics through the guitar’s strings and produces tapestries of song.' – Ralph McTell\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1795359600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-22T15:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:35\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"692f537296fff800011f4072\",\"name\":\"Katie Spencer\",\"perm_name\":\"g5krq5-katie-spencer-22nd-nov-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/b78619f0-29ab-4ff8-83c1-2b8359ac99c6.jpg?rect=0%2C8%2C915%2C915\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/b78619f0-29ab-4ff8-83c1-2b8359ac99c6.jpg?rect=0%2C191%2C915%2C549\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/b78619f0-29ab-4ff8-83c1-2b8359ac99c6.jpg?rect=202%2C0%2C512%2C930\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Katie Spencer\",\"image\":null,\"artist_id\":\"79335\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764633600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Katie Spencer - Come Back and Find Me\",\"redirect_url\":\"https://open.spotify.com/track/5IrIbBpf3SwQjP38sw91xU\",\"artist\":\"Katie Spencer\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a6839934c571f0a415e638accf6d7833ce1130ab?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Come Back and Find Me\"},{\"type\":\"apple_music\",\"title\":\"Katie Spencer - Come Back and Find Me\",\"redirect_url\":\"https://music.apple.com/us/album/come-back-and-find-me/1818897477?i=1818897479&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Katie Spencer\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/76/e3/b8/76e3b834-2bf8-f2ad-11f1-17950e01b3f3/mzaf_10941913023823354311.plus.aac.p.m4a\",\"track_name\":\"Come Back and Find Me\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sun 22 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T09:00:00+00:00\",\"sale_end_date\":\"2026-11-22T23:45:00+00:00\",\"sale_start_date\":\"2026-02-16T09:00:00+00:00\",\"event_start_date\":\"2026-11-23T19:00:00+00:00\",\"event_end_date\":\"2026-11-23T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Soulgigs.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/w710f8a1263e?dice_id=w710f8a1263e\",\"post_competition_referral\":\"https://link.dice.fm/z9cf3a11ef4d?dice_id=z9cf3a11ef4d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Cff6b8f079f5?dice_id=Cff6b8f079f5\",\"post_purchase_referral\":\"https://link.dice.fm/Kaf8af3e8d2e?dice_id=Kaf8af3e8d2e\",\"post_reminder_referral\":\"https://link.dice.fm/R6f8bf5f2f6b?dice_id=R6f8bf5f2f6b\",\"post_waitinglist_referral\":\"https://link.dice.fm/J17687a526c1?dice_id=J17687a526c1\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Grammy-nominated recording artist and producer Glenn Jones continues to captivate audiences with his soulful voice and timeless sound. His single “Love By Design” featuring Grammy Award winner Regina Belle debuted as the #1 Most Added Smooth Jazz Vocal Record in the nation, followed by the upbeat “You & Me.”\\n\\nWritten by James Day and produced by Chris “Big Dog” Davis, Love By Design marks the first release from Jones’ highly anticipated album of the same name. The project blends smooth ballads and danceable grooves, featuring collaborations with jazz greats Nick Colionne and Kim Waters, gospel legend Genobia Jeter-Jones, and producer Chuckii Booker.\\n\\nWith over three decades in music, Jones remains one of the most sought-after live performers. His chart-topping hits—“Here I Go Again,” “We’ve Only Just Begun (The Romance Is Not Over),” and “Baby Come Home”—are celebrated classics. His inspirational family anthem “Everyday” features his wife Genobia Jeter-Jones and niece Y’anna Crawley, along with Dave Hollister\\n\\nA native of Jacksonville, Florida, Jones began his career in gospel under Reverend James Cleveland before moving into R&B under the guidance of Norman Connors. His powerful tenor and heartfelt lyrics have earned him accolades across genres\\n\\nJones gives back through The Love Jones Foundation, dedicated to youth education and music therapy. As he continues touring and creating, Jones remains true to his message: faith, authenticity, and the enduring power of soulful music\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":941,\"name\":\"Bush Hall\",\"privacy_policy_link\":\"https://bushhallmusic.co.uk/pages/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"