t_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by High Focus Records and Raise The Bar Present\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Meee1f0653e8?dice_id=Meee1f0653e8\",\"post_competition_referral\":\"https://link.dice.fm/Wb28af7995b5?dice_id=Wb28af7995b5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/pf54510479bb?dice_id=pf54510479bb\",\"post_purchase_referral\":\"https://link.dice.fm/h417087bf6f9?dice_id=h417087bf6f9\",\"post_reminder_referral\":\"https://link.dice.fm/Te369f1c30d3?dice_id=Te369f1c30d3\",\"post_waitinglist_referral\":\"https://link.dice.fm/o6de6370c14e?dice_id=o6de6370c14e\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"High Focus Records and Raise The Bar Present\\n\\n🎉 Fliptrix 'Elevation' Album Tour 2026 🎟️🎟️ ON SALE NOW!\\n\\nFliptrix returns to London on Thursday 21st May with DJ Jazz T for a show at Brixton Jamm to celebrate the release of his eleventh solo LP 'Elevation’.\\n\\nIf you’ve ever seen Fliptrix live you will know that his shows are electrifying. Expect brand new music from ‘Elevation’ and classics from Fliptrix’ extensive catalogue as both a solo artist and 1/4 of The Four Owls on his only UK Tour of 2026.\\n\\nHaving worked with Forest DLG in some capacity across all of his records over the past fifteen years, from mixing and mastering, but also collaborating on multiple tracks as rapper / producer, it is surprising that it took so long for the pair to come together on a full-length collaborative project. ‘Elevation’ is that record.\\n\\nLIMITED 🎟️🎟️ + SUPPORT TBA + MERCH\\n\\nEarlybirds: £10 / First Release: £15 / Advance Tickets: £20\\n\\nMore on the door\\n\\n261 Brixton Rd, London SW9 6LH\\n\\nDoors: 7:00pm - 11pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1779386400,\"venues\":[{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"address\":\"261 Brixton Rd, London SW9 6LH\",\"location\":{\"lat\":51.4709902,\"lng\":-0.112441100000069},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/f7441ba7-e272-4e0e-b7da-04a2804f9273.jpg?rect=0%2C0%2C300%2C300\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"brixton-jamm-zk8z\",\"accessibility\":{\"url\":\"https://brixtonjamm.org/faq/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-21T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:12\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"image\":{\"url\":null},\"perm_name\":\"brixton-jamm-zk8z\",\"profile_active\":false},\"id\":\"6931c24e840cd00001600ba6\",\"name\":\"Fliptrix & DJ Jazz T\",\"perm_name\":\"nvw7e9-fliptrix-dj-jazz-t-21st-may-brixton-jamm-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-04/1ca026a5-be27-4945-b44f-afdbdf42c7d7.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-04/1ca026a5-be27-4945-b44f-afdbdf42c7d7.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-04/1ca026a5-be27-4945-b44f-afdbdf42c7d7.jpg?rect=169%2C0%2C743%2C1350\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fliptrix\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1fc10a5be929bd07990f9b85\"},\"artist_id\":\"44848\",\"about\":null,\"is_headliner\":false},{\"name\":\"DJ Jazz T\",\"image\":null,\"artist_id\":\"48879\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764867600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1300},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"See the Sun\",\"redirect_url\":\"https://open.spotify.com/track/1m7NSANDofMtXcl8u6olyn\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d7c55b77fbe13b139aa737eac4fd54784363880d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"See the Sun\"},{\"type\":\"apple_music\",\"title\":\"Fliptrix - Star Beings\",\"redirect_url\":\"https://music.apple.com/us/album/star-beings/581977385?i=581977936&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Fliptrix\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/d7/f0/54/d7f05458-0770-7fbd-2b1b-f7f2622a9192/mzaf_15610527468631170951.plus.aac.p.m4a\",\"track_name\":\"Star Beings\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-24T10:00:00+00:00\",\"sale_end_date\":\"2026-05-21T21:00:00+01:00\",\"sale_start_date\":\"2025-11-26T10:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/W3dbd7158ee3?dice_id=W3dbd7158ee3\",\"post_competition_referral\":\"https://link.dice.fm/z80e3a99913f?dice_id=z80e3a99913f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/yf6372153883?dice_id=yf6372153883\",\"post_purchase_referral\":\"https://link.dice.fm/q71bdf0a8add?dice_id=q71bdf0a8add\",\"post_reminder_referral\":\"https://link.dice.fm/Be5eabc4fdc0?dice_id=Be5eabc4fdc0\",\"post_waitinglist_referral\":\"https://link.dice.fm/qb8ce29386c2?dice_id=qb8ce29386c2\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"*Lucia is entering an exciting new chapter, with momentum firmly behind her and a bold future taking shape. As the frontwoman of Lucia & The Best Boys, she has built a reputation for delivering emotionally charged, high-impact live performances. Looking ahead, Lucia & The Best Boys are preparing for a run of significant headline shows in May, reflecting the growing demand for their live show.*\\n\\n*A new album via Communion is set for release this summer, ushering in a fresh era and expanding Lucia’s sonic and visual world. The record has been produced by Yves Rothman, known for his work with Yves Tumor, Kim Gordon and Blondshell, bringing a bold edge to the band’s sound.*\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779386400,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-21T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":5,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:13\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"69202b5cd3d72d000167b9c8\",\"name\":\"Lucia & The Best Boys\",\"perm_name\":\"8ermqr-lucia-the-best-boys-21st-may-islington-assembly-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/347188a1-a3ca-49fc-816a-fb07223d91cb.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/347188a1-a3ca-49fc-816a-fb07223d91cb.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/347188a1-a3ca-49fc-816a-fb07223d91cb.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lucia & The Best Boys\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-09/baa2281a-6054-4244-a3c6-875356e05c9c.jpg?rect=0%2C268%2C1920%2C1920\"},\"artist_id\":\"24529\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1763978400,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2778},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Lucia & The Best Boys - Perfectly Untrue\",\"redirect_url\":\"https://open.spotify.com/track/40dMjzTKuy7W45XHwkiPgT\",\"artist\":\"Lucia & The Best Boys\",\"preview_url\":\"https://p.scdn.co/mp3-preview/486c2f6d014bcb1689fdb0a94b4ba2bb205b688f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Perfectly Untrue\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T17:15:00+00:00\",\"sale_end_date\":\"2026-05-21T16:00:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by SJM Concerts.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only