:true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780770600,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:94\",\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/9b89f5f3-e05c-43e0-a2ba-ce4d8adccb66.jpg?rect=973%2C0%2C3828%2C3828\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/9b89f5f3-e05c-43e0-a2ba-ce4d8adccb66.jpg?rect=0%2C182%2C5773%2C3464\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/9b89f5f3-e05c-43e0-a2ba-ce4d8adccb66.jpg?rect=1834%2C0%2C2105%2C3828\"},\"id\":\"698226369178fb000111360d\",\"name\":\"Whitney Johnson, Lia Kohl, and Macie Stewart\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nWhitney Johnson, Lia Kohl, and Macie Stewart at Cafe Oto, June 6th\\n\\nFinding equilibrium in an ever evolving practice of improvisation and collective composition, the trio of Whitney Johnson, Lia Kohl, and Macie Stewart traverse a new sonic space in the spirit of play and intuitive experimentation. Three voices and three string instruments – viola, cello, and violin, respectively – create an organic, intertwined sound that can be both singular and astonishingly multitudinous. The trio work in a unique combination of completely free improvisation and careful production, using multiple tape machines and effects to re-imagine improvised material into meticulously crafted compositions.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T09:00:00+00:00\",\"sale_end_date\":\"2026-06-06T18:00:00+01:00\",\"sale_start_date\":\"2026-02-04T09:00:00+00:00\",\"event_start_date\":\"2026-06-06T19:30:00+01:00\",\"event_end_date\":\"2026-06-06T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Macie Stewart & Lia Kohl - Perfect (Every Time)\",\"redirect_url\":\"https://music.apple.com/us/album/perfect-every-time/1537389046?i=1537389048&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Macie Stewart & Lia Kohl\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview124/v4/c5/7e/77/c57e77fa-954d-63c0-1cb5-4377266b2fde/mzaf_8159059072960746758.plus.aac.p.m4a\",\"track_name\":\"Perfect (Every Time)\"},{\"type\":\"spotify\",\"title\":\"Macie Stewart - I Forget How To Remember My Dreams (ft. Lia Kohl)\",\"redirect_url\":\"https://open.spotify.com/track/6nD3PR4C7MwktelphQI8AD\",\"artist\":\"Macie Stewart\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bf6e0bb73ca0f6e95248e5a3c12d4bac2819c76a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I Forget How To Remember My Dreams (ft. Lia Kohl)\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Stamps\",\"image\":null,\"artist_id\":\"133468\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Rock By Numbers.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\