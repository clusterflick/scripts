title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"address\":\"261 Brixton Rd, London SW9 6LH\",\"location\":{\"lat\":51.4709902,\"lng\":-0.112441100000069},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/f7441ba7-e272-4e0e-b7da-04a2804f9273.jpg?rect=0%2C0%2C300%2C300\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"brixton-jamm-zk8z\",\"accessibility\":{\"url\":\"https://brixtonjamm.org/faq/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"image\":{\"url\":null},\"perm_name\":\"brixton-jamm-zk8z\",\"profile_active\":false},\"announcement_date_unix\":1765299600,\"social_links\":{\"event_share\":\"https://link.dice.fm/z3da6a5c47b1?dice_id=z3da6a5c47b1\",\"post_competition_referral\":\"https://link.dice.fm/B69bdc1b8c35?dice_id=B69bdc1b8c35\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/rc51e75a2932?dice_id=rc51e75a2932\",\"post_purchase_referral\":\"https://link.dice.fm/mce38bab4443?dice_id=mce38bab4443\",\"post_reminder_referral\":\"https://link.dice.fm/S64f705bb90a?dice_id=S64f705bb90a\",\"post_waitinglist_referral\":\"https://link.dice.fm/J904b33d13cb?dice_id=J904b33d13cb\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"926wkd-dj-babu-rakaa-dilated-peoples-skinnyman-26th-feb-brixton-jamm-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772132400,\"has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:77\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1300},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/279c375f-ed9c-4c3d-879b-b1a74781318f.jpg?rect=0%2C0%2C1638%2C1638\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/279c375f-ed9c-4c3d-879b-b1a74781318f.jpg?rect=0%2C532%2C1638%2C983\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/279c375f-ed9c-4c3d-879b-b1a74781318f.jpg?rect=256%2C0%2C1126%2C2047\"},\"id\":\"69380755050894000188f1be\",\"name\":\"DJ Babu & Rakaa (Dilated Peoples) + Skinnyman\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"DJ Babu & Rakaa of Dilated Peoples: Expansion Soundsystem / Skinnyman Live at Brixton Jamm London, Thursday 26th February 2026\\n\\nAFT Raps X Raise The Bar Present\\n\\nA One Off.. Co-Headliner Show\\n\\nDJ Babu & Rakaa of Dilated Peoples are Expansion Soundsystem\\n\\nSkinnyman \\\\[Performing the classic ‘Council Estate of Mind’\\\\]\\n\\nDJ Babu & Rakaa of Dilated Peoples are Expansion Soundsystem\\n\\nDJ Babu (of the World Famous Beat Junkies/Dilated Peoples) and Rakaa (aka Iriscience of Dilated Peoples/C2D) are Expansion Team Soundsystem, a classic-meets-progressive Hip Hop experience born in Southern California and rooted in turntablism, lyricism, and party-rocking crowd control. \\\"ETS is something that developed naturally with Rakaa on the mic, me on the turntables, and us just rocking and having fun,” says Babu. The duo has built a reputation for blazing venues across the U.S., Europe, Asia, Oceania, and Latin America, celebrating the timeless DJ/MC dynamic with a style often described as cutting-edge traditionalism.\\n\\n\\\"Whether we’re live on stage or in the studio cooking up new magic, we’re having a great time and doing good business outside of the lines,” says Rakaa. You’re now rocking with the best, worldwide from the wild, wild West—it’s ETS, Expansion Team Soundsystem!\\n\\nSkinnyman\\n\\nSkinnyman is one of the few British emcees that needs almost no introduction. After the period of incarceration, released his masterful solo debut album, “Council Estate of Mind”, with a deal via Low Life Records in 2004. Well received by fans and critics as the highest new entry in the UK”s charts on the week of its release, heavily autobiographical and socially analytical, the album makes much use of samples from “Made in Britain”, a British film from the early 80s.\\n\\n”Council Estate of Mind” should be celebrated as being so much more than just good hip-hop. It should be afforded the same status as the work of groups such as the Sex Pistols and Oasis as an album that speaks to, and for, a whole generation of working class British youth. – Blues and Soul\\n\\nPulse More TBA\\n\\nLive at Brixton Jamm London\\n\\nThursday 26th February 2026\\n\\nDoors: 7pm-11pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T17:00:00+00:00\",\"sale_end_date\":\"2026-02-26T19:00:00+00:00\",\"sale_start_date\":\"2025-12-09T17:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dilated Peoples - Worst Comes to Worst\",\"redirect_url\":\"https://music.apple.com/us/album/worst-comes-to-worst/715477135?i=715477163&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dilated Peoples\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/67/d9/37/67d9373b-70c2-d4e6-c203-0616cc1967e2/mzaf_5603379255129483551.plus.aac.p.m4a\",\"track_name\":\"Worst Comes to Worst\"},{\"type\":\"spotify\",\"title\":\"Dilated Peoples - Worst Comes To Worst\",\"redirect_url\":\"https://open.spotify.com/track/62XuCm9iqnomAZ8891Ev9e\",\"artist\":\"Dilated Peoples\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ce2a594bb6e7c52a8cd300eeb97613771f1794dc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Worst Comes To Worst\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\" Katie Grace\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-17/f87c69bf-dd68-4daa-8cd0-cbf1168bcf56.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"130322\",\"about\":null,\"is_headliner\":false},{\"name\":\"ERNIE\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-21/dddd4608-e72e-4bb6-877a-6251bed7cf6e.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"95466\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Communion ONE.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"41\",\"name\":\"The Waiting Room\",\"address\":\"175 Stoke Newington High Street, London N16 0LH\",\"location\":{\"lat\":51.5620818,\"lng\":-0.0738883999999871},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-waiting-room-jxea\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion