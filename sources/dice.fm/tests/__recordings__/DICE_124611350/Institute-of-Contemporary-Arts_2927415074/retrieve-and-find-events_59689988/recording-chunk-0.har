fy.com/track/0Of5lCNEqh62twRkQIOLuK\",\"artist\":\"Evelyn \\\"Champagne\\\" King\",\"preview_url\":\"https://p.scdn.co/mp3-preview/de784d3c0693493addb0607cdeec559c4212e9fd?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Love Come Down\"},{\"type\":\"apple_music\",\"title\":\"Evelyn \\\"Champagne\\\" King - Love Come Down\",\"redirect_url\":\"https://music.apple.com/us/album/love-come-down/303079201?i=303079209&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Evelyn \\\"Champagne\\\" King\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/93/f0/ba/93f0ba86-9f14-dfb2-e7ad-fa6121057063/mzaf_13339168126433117164.plus.aac.p.m4a\",\"track_name\":\"Love Come Down\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T06:00:00+00:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-03-14T21:00:00+00:00\",\"event_end_date\":\"2026-03-14T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Southbank Centre.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"58626683-726f-4698-807e-9ca14b6b96b1\",\"social_links\":{\"event_share\":\"https://link.dice.fm/U98af2484bbb?dice_id=U98af2484bbb\",\"post_competition_referral\":\"https://link.dice.fm/H7be1ac15cb9?dice_id=H7be1ac15cb9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tdb60b57071e?dice_id=Tdb60b57071e\",\"post_purchase_referral\":\"https://link.dice.fm/v89ba3e65ff1?dice_id=v89ba3e65ff1\",\"post_reminder_referral\":\"https://link.dice.fm/J6b13a1733df?dice_id=J6b13a1733df\",\"post_waitinglist_referral\":\"https://link.dice.fm/e202517dd7ca?dice_id=e202517dd7ca\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Children of Zeus are a soul/hip-hop group from two of Manchester’s most respected artists, Konny Kon and Tyler Daley.\\n\\nBoth are recognised MCs and beatmakers in their own right, and the music they make is a nod to the music of their childhood influences and their taste for timeless sounds.\\n\\nTyler Daley, previously known as Hoodman, is a producer, soul singer and rapper, while Konny Kon’s skills as a DJ, producer and rapper allow them to provide honest, self-deprecating views of life and love.\\n\\nWorking with the likes of Beat Butcha (known for his work with Jay-Z, Westside Gunn, Beyoncé and SZA) on their latest project, Balance, Children of Zeus have built up a solid fanbase and reputation for a serious live show.\\n\\nSupport comes from Tomorrow’s Warriors, a Southbank Centre Resident Organisation.\\n\\nThe ticket price includes a £2 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":\"1c381828-86dd-4f2b-9d28-ed6f89c79409\",\"marketeers\":[{\"id\":228,\"name\":\"Southbank Centre\",\"privacy_policy_link\":\"https://www.southbankcentre.co.uk/policies/privacy\",\"fb_pixel_id\":\"1145741552151564\",\"ga_tracking_id\":\"UA-86802192-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773522000,\"venues\":[{\"id\":\"5798\",\"name\":\"Queen Elizabeth Hall - Southbank Centre\",\"address\":\"Belvedere Rd, London SE1, UK\",\"location\":{\"lat\":51.5034147,\"lng\":-0.1174003},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722