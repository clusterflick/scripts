":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-space---the-brit-school-ykx2\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T13:45:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"BRIT Kids\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-10/caa46154-8148-4ddd-a951-07d8674219c5.jpg?rect=125%2C0%2C110%2C110\"},\"artist_id\":\"89397\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/058aaf62-1aba-4967-b4d7-fd962a51520c.jpg?rect=0%2C329%2C1587%2C1587\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/058aaf62-1aba-4967-b4d7-fd962a51520c.jpg?rect=0%2C647%2C1587%2C952\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/058aaf62-1aba-4967-b4d7-fd962a51520c.jpg?rect=176%2C0%2C1235%2C2245\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769158800,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"In a world where time has no name and every movement is monitored, a group of citizens wake, work, wait, and smile — endlessly. They’ve forgotten the before, and no one questions the now. But when one of them begins to remember a word, a name, a moment that doesn’t belong, the cracks start to show. Maybe it’s nothing. Maybe it’s everything. And maybe — just maybe — it’s not the system that’s broken.\\n\\nSet in a future that feels eerily close, Opt Out is a bold theatrical experience about routine, control, and the price of comfort. Absurd, unsettling, and darkly funny — it asks how much of yourself you’re willing to give away before you notice what’s missing.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by BRIT Kids\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:31\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Xb9667f44398?dice_id=Xb9667f44398\",\"post_competition_referral\":\"https://link.dice.fm/E0db8273064b?dice_id=E0db8273064b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Pd0937c5de13?dice_id=Pd0937c5de13\",\"post_purchase_referral\":\"https://link.dice.fm/e587b1951efa?dice_id=e587b1951efa\",\"post_reminder_referral\":\"https://link.dice.fm/Eb2b32f1270e?dice_id=Eb2b32f1270e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pfdc2e48f04d?dice_id=Pfdc2e48f04d\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T09:00:00+00:00\",\"sale_end_date\":\"2026-03-21T14:15:00+00:00\",\"sale_start_date\":\"2026-01-23T09:00:00+00:00\",\"event_start_date\":\"2026-03-21T14:00:00+00:00\",\"event_end_date\":\"2026-03-21T15:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":309},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"6966143c8dca490001492c03\",\"seats_io_event_id\":null,\"name\":\"Opt Out\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"av3mpx-opt-out-21st-mar-the-space-the-brit-school-london-tickets\",\"date_unix\":1774101600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation