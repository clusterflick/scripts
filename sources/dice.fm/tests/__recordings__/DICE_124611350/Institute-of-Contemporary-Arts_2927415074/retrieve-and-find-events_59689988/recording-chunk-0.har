type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-02T19:00:00+01:00\",\"doors_close_date\":\"2026-10-02T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Lemonheads\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-12/ba79163c-136d-44c4-a6fa-c0bfff67dc8d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"1153\",\"about\":null,\"is_headliner\":true},{\"name\":\"Willy Mason\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-10/7eb20b92-4ee1-44eb-afdf-5ce73042c4fd.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"6300\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":2},\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-30/ffd4cd97-4acf-4241-b86e-020c27971ae9.jpg?rect=1030%2C0%2C4032%2C4032\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-30/ffd4cd97-4acf-4241-b86e-020c27971ae9.jpg?rect=0%2C202%2C6048%2C3629\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-30/ffd4cd97-4acf-4241-b86e-020c27971ae9.jpg?rect=1915%2C0%2C2218%2C4032\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Mrs. Robinson - Remastered\",\"redirect_url\":\"https://open.spotify.com/track/5EugXICXL06waHgP4iTI58\",\"artist\":\"Mrs. Robinson\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9ef03fae53ac1026ab5989245a2fd70965039789?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Remastered\"}],\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"announcement_date_unix\":1761904800,\"max_tickets\":8,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"ae9363fb-6155-4906-8a26-2d9d1b28c186\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"about\":{\"description\":\"**VENUE PRESALE: WEDS 5TH NOV @ 10AM**\\n\\n**GENERAL SALE: FRI 7TH NOV @ 10AM**\\n\\nSince they were formed in Boston, Mass, in 1986 by Evan Dando, the family tree of The Lemonheads has had many twisted tentacles and tangential branches, and a host of one-liners etched into its bark. Anyone could be a Lemonhead but for how long who knows? Leastways they’ll be shoulder-to-shoulder with Evan throwing discordant chords against alt-country-tinged melodies, playing that light and dark card.\\n\\nThe Lemonheads’ arcane adventure continues with ‘Love Chant’ set for release later this year. Sparring with guest guitarists J Mascis from Dinosaur Jr and The Bevis Frond’s Nick Saloman, Evan the songwriter remains gloriously astute. The voice is lower and more brooding but the mood is pinprick sharp and the social commentary as barbed as ever.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Crosstown Concerts.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:93\",\"social_links\":{\"event_share\":\"https://link.dice.fm/yaa5f4a2b008?dice_id=yaa5f4a2b008\",\"post_competition_referral\":\"https://link.dice.fm/j18f25d884b3?dice_id=j18f25d884b3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n1241a41e440?dice_id=n1241a41e440\",\"post_purchase_referral\":\"https://link.dice.fm/efd5ba12160d?dice_id=efd5ba12160d\",\"post_reminder_referral\":\"https://link.dice.fm/X5b8667b24a9?dice_id=X5b8667b24a9\",\"post_waitinglist_referral\":\"https://link.dice.fm/x11d4280a960?dice_id=x11d4280a960\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-31T10:00:00+00:00\",\"sale_end_date\":\"2026-10-02T22:00:00+01:00\",\"sale_start_date\":\"2025-11-05T10:00:00+00:00\",\"event_start_date\":\"2026-10-02T19:00:00+01:00\",\"event_end_date\":\"2026-10-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4515},\"properties\":[],\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"id\":\"6903459952701a000128841b\",\"seats_io_event_id\":\"ae9363fb-6155-4906-8a26-2d9d1b28c186\",\"name\":\"The Lemonheads\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"mx5v6v-the-lemonheads-2nd-oct-troxy-london-tickets\",\"date_unix\":1790964000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 02 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
