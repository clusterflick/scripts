me\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"announcement_date_unix\":1767830400,\"social_links\":{\"event_share\":\"https://link.dice.fm/ydd242b4ca88?dice_id=ydd242b4ca88\",\"post_competition_referral\":\"https://link.dice.fm/ccc5d5e4d5be?dice_id=ccc5d5e4d5be\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J6d2b0abc485?dice_id=J6d2b0abc485\",\"post_purchase_referral\":\"https://link.dice.fm/i47471903316?dice_id=i47471903316\",\"post_reminder_referral\":\"https://link.dice.fm/q19df68e8ba1?dice_id=q19df68e8ba1\",\"post_waitinglist_referral\":\"https://link.dice.fm/q481406660a6?dice_id=q481406660a6\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"xe2rv3-ivan-moult-30th-may-hot-box-chelmsford-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780142400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:41\",\"price\":{\"currency\":\"GBP\",\"amount\":1430,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/1f03053d-a05d-4f63-b47c-2e3269bb4187.jpg?rect=0%2C107%2C1286%2C1286\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/1f03053d-a05d-4f63-b47c-2e3269bb4187.jpg?rect=0%2C364%2C1286%2C772\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/1f03053d-a05d-4f63-b47c-2e3269bb4187.jpg?rect=231%2C0%2C825%2C1500\"},\"id\":\"695fec5ce95da400012bcbaa\",\"name\":\"Ivan Moult\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Ivan Moult**\\n\\n**Ivan Moult** is set to perform his new album Stood Out In The Storm - his most personal work yet. Audiences can expect the intimate, carefully crafted sound Ivan is known for – a seamless blend of 60s/70s folk and blues shaped by influences such as John Martyn, Terry Reid and Ry Cooder. Now performed with a band featuring musicians from Gruff Rhys (Super Furry Animals) and Melin Melyn – bringing the new record to life with soul toned guitars, shuffling drums and electric bass with atmospheric pedal steel bringing depth and support to Ivan’s captivating and ethereal vocals.\\n\\nThe new album, released in November 2025, follows the acclaimed Songs From Severn Grove (2023), which earned praise for its warmth, intricacy and timeless songwriting. While that record captured renewal and early fatherhood, this new collection of songs takes a braver and more vulnerable step, written in the aftermath of a personal crisis and tracing a gradual journey toward healing.\\n\\nHaving earned support from Guy Garvey and Huw Stephens on BBC 6 Music , BBC Radio Wales and KLOF , and having shared stages with This Is The Kit, Becca Mancari and Willy Mason, Ivan brings a seasoned presence to the stage. We can’t wait for you to join us for this special, intimate performance.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"UND 18s to be accompanied by an Adult in the ratio 1:1\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T00:00:00+00:00\",\"sale_end_date\":\"2026-05-30T13:00:00+01:00\",\"sale_start_date\":\"2026-01-08T00:15:00+00:00\",\"event_start_date\":\"2026-05-30T13:00:00+01:00\",\"event_end_date\":\"2026-05-30T17:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"What More Could I Say?\",\"redirect_url\":\"https://open.spotify.com/track/3O0WeCgevxtaNsVdzYn37x\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/01f1fafbd3e23ac56d0e5348483df114e1177122?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"What More Could I Say?\"}],\"score\":0,\"is_hidden_event\":fa