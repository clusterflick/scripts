-e1d6-48a3-aba0-289a92bbeb33.jpg?rect=0%2C61%2C1173%2C1173\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/4839c71e-e1d6-48a3-aba0-289a92bbeb33.jpg?rect=0%2C404%2C1173%2C704\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/4839c71e-e1d6-48a3-aba0-289a92bbeb33.jpg?rect=171%2C0%2C832%2C1512\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nAcclaimed blues singer-songwriter and multi-instrumentalist Jerron Paxton brings his deeply personal sound to the stage, blending blues, ragtime, folk, and old-time Black music traditions. Rooted in the styles of the 1920s and ’30s but unmistakably his own, Paxton’s storytelling reflects lived experience, cultural history, and sharp-witted observations on modern life. His latest album Things Done Changed honours the past while bringing these timeless sounds vividly into the present.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":6},\"faqs\":[{\"id\":57821,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"marketeers\":[{\"id\":756,\"name\":\"Metropolis Music\",\"privacy_policy_link\":\"https://www.metropolismusic.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778956200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"538\",\"name\":\"O2 Shepherds Bush Empire\",\"address\":\"Shepherd's Bush Green, London W12 8TT\",\"location\":{\"lat\":51.5032636,\"lng\":-0.22311579999996},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-shepherds-bush-empire-42ap\",\"accessibility\":{\"url\":\"https://www.academymusicgroup.com/o2shepherdsbushempire/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-16T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"16\",\"name\":\"Metropolis Music\",\"image\":{\"url\":null},\"perm_name\":\"metropolis-music-jyaj\",\"profile_active\":true},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music