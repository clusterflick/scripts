cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776610800,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:47\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1525},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/58978d48-31f8-414e-be51-aa5da2464fd2.jpg?rect=0%2C0%2C1005%2C1005\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/58978d48-31f8-414e-be51-aa5da2464fd2.jpg?rect=0%2C201%2C1005%2C603\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/58978d48-31f8-414e-be51-aa5da2464fd2.jpg?rect=226%2C0%2C553%2C1005\"},\"id\":\"697221f8f2b59c0001b81cfa\",\"name\":\"50 Years of Greg Wilson [Extended Day Set]\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Marking 50 years as a DJ, **Greg Wilson** will grace our booth with a special daytime set of rare gems and euphoric disco that has distinguished his legendary career.\\n\\nA resident at seminal UK venues such as **Wigan Pier** and Manchester’s **Haçienda** nightclub in the early 80s, Greg has very much always marched to the beat of his own drum. He was also the first DJ to mix live on UK television.\\n\\nVoted as the top remixer of all time and Industry Icon Of The Year by DJ Magazine, BBC Radio 1 also included Greg’s Essential Mix in their top 10.\\n\\nA genuine legend of the UK disco scene in our walls.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-04-19T22:00:00+01:00\",\"sale_start_date\":\"2026-01-27T10:00:00+00:00\",\"event_start_date\":\"2026-04-19T16:00:00+01:00\",\"event_end_date\":\"2026-04-19T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Greg Wilson - Summer Came My Way - Luxxury Club Mix\",\"redirect_url\":\"https://open.spotify.com/artist/5b8TksKkFbG2NoVG8d8YDN\",\"artist\":\"Greg Wilson - Summer Came My Way - Luxxury Club Mix\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dc26c1138d1f4303f936750419b47952f265ebca\",\"track_name\":\"Greg Wilson - Summer Came My Way - Luxxury Club Mix\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by R Davies & K Naidoo.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72803,\"title\":\"Additional Accessibility Information\",\"body\":\"Main Accessibility Information - https://dicefm.zendesk.com/hc/en-gb/articles/24679933108753-HERE-at-Outernet-Accessibility-FAQ\\n\\nGA - you can add a companion ticket or viewing area add-on onto your ticket (info to do this in link above)\\n\\nEarly Entry - you can add a companion ticket onto your ticket (info to do this in link above)\\n\\nTHE VIP SILVER DIVA PACKAGE - you can add a companion ticket onto your ticket (info to do this in link above)\\n\\nGold + Platinum Package - no accessibility offerings, if you require a companion ticket please purchase 2 tickets.\",\"order\":0}],\"max_tickets\":6,\"prop