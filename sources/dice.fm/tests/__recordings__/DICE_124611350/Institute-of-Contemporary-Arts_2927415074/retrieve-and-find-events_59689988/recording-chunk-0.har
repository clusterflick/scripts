, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.508986,\"lng\":-0.061629},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"onyx-k6wa9\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T22:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:70\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1843\",\"name\":\"E1 London\",\"image\":{\"url\":null},\"perm_name\":\"e1-london-3p9x\",\"profile_active\":false},\"id\":\"69370c9ad80123000101fcdd\",\"name\":\"Lee Foss\",\"perm_name\":\"5387qy-lee-foss-20th-feb-onyx-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/d97c5522-aedf-4cdc-8fdd-4a9af56b94ec.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/d97c5522-aedf-4cdc-8fdd-4a9af56b94ec.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/d97c5522-aedf-4cdc-8fdd-4a9af56b94ec.jpg?rect=180%2C0%2C440%2C800\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lee Foss\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-05-29/759565ec-a663-4d2f-8eac-97edb8ef4fd3.jpg?rect=0%2C0%2C1367%2C1367\"},\"artist_id\":\"2237\",\"about\":{\"description\":\"Foss channels his reprobate energy into the turntables, bringing a hedonistic atmosphere to his sets. His rise to prominence as a DJ has been driven by his diversity, spanning nu-school house and synth-heavy techno.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765152000,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1100},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Only The Gods (feat. Anabel Englund)\",\"redirect_url\":\"https://open.spotify.com/track/6oSWam6C5d0HyUS4bVNVqN\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7eef7655a2e508e92330f04df70ad0cc657e9bbc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Only The Gods (feat. Anabel Englund)\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-21T00:00:00+00:00\",\"sale_end_date\":\"2026-02-21T05:00:00+00:00\",\"sale_start_date\":\"2025-11-21T17:00:00+00:00\",\"event_start_date\":\"2026-02-20T22:00:00+00:00\",\"event_end_date\":\"2026-02-21T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by KOKO.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/C6a38fd28936?dice_id=C6a38fd28936\",\"post_competition_referral\":\"https://link.dice.fm/Had5178ff77f?dice_id=Had5178ff77f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d6426c284adf?dice_id=d6426c284adf\",\"post_purchase_referral\":\"https://link.dice.fm/R729b0ab52ab?dice_id=R729b0ab52ab\",\"post_reminder_referral\":\"https://link.dice.fm/Ub95d86f16c4?dice_id=Ub95d86f16c4\",\"post_waitinglist_referral\":\"https://link.dice.fm/m640edbcb9ef?dice_id=m640edbcb9ef\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Giolì & Assia are the young Italian duo of producers, multi-instrumentalists, singers, songwriters, record label owners, and DJs, creating music that blends the styles of techno, house, indie, and pop that is uniquely their own.\\n\\n**IMPORTANT INFO**\\n\\nFeeling peckish? Join us every Friday from 7pm-12am at Don KOKO, check your emails for a 20% discount link.\\n\\nFor VIP & areas please email: bookings@KOKO.co.uk (available on selected nights only).\\n\\nPlease arrive according to the time on your ticket for a smooth and guaranteed entry.\\n\\nIf you are made to feel uncomfortable in any way, please do not hesitate to speak to any member of staff and we will help immediately.\\n\\nAny unattended drinks will be discarded.\\n\\nPlease do not purchase tickets through social media, we are unable to help with anyone who has been scammed.\\n\\nWe operate a zero tolerance drug policy.\\n\\nKOKO is 19+.\\n\\nPlease bring a valid form of photographic ID with you to the event (please note, we only accept valid passports, foreign national ID cards, driving licenses, or Home Office approved PASS cards as identification and/or proof of age.\\n\\nLast entry 3am. No readmission.\\n\\nIf you have any questions regarding accessibility contact ACCESS@koko.uk.com\\n\\n\\\\-----------------------------------------------------\\n\\n**TO PREVENT RESELLING AND UNAUTHORISED USE OF TICKETS**\\n\\nOnly official resale tickets from SEE / RA / Dice will be accepted.\\n\\nHouse of KOKO member tickets cannot be resold to non-members.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 19+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":918,\"name\":\"KOKO\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"421051646826847\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2075,\"name\":\"KOKO 2\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"2512980718968598\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771624800,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T22:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:71\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"8108\",\"name\":\"KOKO\",\"image\":{\"url\":null},\"perm_name\":\"koko-nwv5\",\"profile_active\":false},\"id\":\"69248b545e5aeb000106caf5\",\"name\":\"KOKO Electronic: Giolì & Assia\",\"perm_name\":\"6dwm62-koko-electronic-giol-assia-20th-feb-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-05/2eee3dbf-599c-41f7-9762-8be935078d50.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-05/2eee3dbf-599c-41f7-9762-8be935078d50.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-05/2eee3dbf-599c-41f7-9762-8be935078d50.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Giolì & Assia\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb63754c06e8172747c0d1a160\"},\"artist_id\":\"22929\",\"about\":null,\"is_headliner\":false},{\"name\":\"Fiona Kraft\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb4c38f02b99d6571571b25257\"},\"artist_id\":\"116674\",\"about\":null,\"is_headliner\":false},{\"name\":\"Queen Rami\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-09/0adb3cac-ae19-43ae-8a0c-c3125b9e28be.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"71456\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1763683200,\"faqs\":[{\"id\":59742,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2105},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Inside Your Head\",\"redirect_url\":\"https://open.spotify.com/track/6iRSsdRMHkkJfAqT4Zg5oM\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ce6ea204cc8523875c3bee40b364f803398ee288?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Inside Your Head\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-07-02T14:00:00+01:00\",\"sale_end_date\":\"2026-02-21T04:00:00+00:00\",\"sale_start_date\":\"2024-07-02T14:00:00+01:00\",\"event_start_date\":\"2026-02-20T22:00:00+00:00\",\"event_end_date\":\"2026-02-21T06:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by EGG.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/sd6507e6f942?dice_id=sd6507e6f942\",\"post_competition_referral\":\"https://link.dice.fm/z10d5fa2fc9f?dice_id=z10d5fa2fc9f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s5a6a2dc38ac?dice_id=s5a6a2dc38ac\",\"post_purchase_referral\":\"https://link.dice.fm/Za2fc01e4b04?dice_id=Za2fc01e4b04\",\"post_reminder_referral\":\"https://link.dice.fm/We0676ad93ea?dice_id=We0676ad93ea\",\"post_waitinglist_referral\":\"https://link.dice.fm/jb700bf20630?dice_id=jb700bf20630\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Friday 20th February – All About House\\n\\nAll About House returns in 2026 with a new format and an even sharper focus on pure House energy. We’re opening earlier, with doors at 10:00pm, setting the tone for a full night of grooves and deeper sounds from the moment you walk in.\\n\\nEnjoy £5 entry before 11pm and selected drinks for £5 until 11pm. Egg will be open late as usual, with last entry at 5am.\\n\\nEntry Policy at Egg London\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771624800,\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T22:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:72\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":n