d=Hd40746fec34\",\"post_waitinglist_referral\":\"https://link.dice.fm/fa3aa7f1f9ce?dice_id=fa3aa7f1f9ce\"},\"perm_name\":\"av3red-fucked-up-1st-apr-the-dome-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/51930324-87fc-4a0c-bf73-968574062988.jpg?rect=477%2C0%2C1907%2C1907\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/51930324-87fc-4a0c-bf73-968574062988.jpg?rect=0%2C95%2C2861%2C1717\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/51930324-87fc-4a0c-bf73-968574062988.jpg?rect=906%2C0%2C1049%2C1907\"},\"properties\":[],\"about\":{\"description\":\"Born Again Concerts *proudly presents*\\n\\n**FUCKED UP**\\n\\n*\\\\+ Hitmen*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (Under 18s must be accompanied by an adult 18+)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6978b93376fab500011dc766\",\"name\":\"FUCKED UP\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Fucked Up - Turn The Season\",\"redirect_url\":\"https://open.spotify.com/artist/05C3EDw4Rf0qMhrdjFKncL\",\"artist\":\"Fucked Up\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8215a30dfd3ad5dfd2124f95118eba5511bd0dae\",\"track_name\":\"Turn The Season\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fucked Up\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-25/8d3dcb2e-1db5-4741-a103-ad8561ed0ec2.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"755\",\"about\":{\"description\":\"Fucked Up formed in Toronto in 2002, high-school friends influenced by first- and second-wave hardcore bands like Minor Threat and NOFX. Though Fucked Up remain punks at heart—if quixotically diverse ones—they have created a great, weird, heavy catalog of music that stubbornly sticks in your brain and your heart.\\n\\nOn this tour, Fucked Up will be playing many never-before performed passages chosen from the entirety of their highly ambitious Zodiac catalogue. This will also include new music from freshly released instalments of the \\\"Grass Can Move Stones\\\" Trilogy of releases - Year of the Goat, Year of the Monkey, Year of the Rooster - which is their grande finale to 20 years of charting experimentation alongside the Zodiac Calendar.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Hitmen\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-26/fc6eed4f-abeb-4dde-b0eb-d65a195fbdec.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"93872\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T16:00:00+00:00\",\"sale_end_date\":\"2026-04-01T19:00:00+01:00\",\"sale_start_date\":\"2025-12-15T16:00:00+00:00\",\"event_start_date\":\"2026-04-01T19:00:00+01:00\",\"event_end_date\":\"2026-04-01T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":64436,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by