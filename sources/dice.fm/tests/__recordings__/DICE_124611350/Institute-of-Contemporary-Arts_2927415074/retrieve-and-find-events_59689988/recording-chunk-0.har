\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T19:30:00+00:00\",\"doors_close_date\":\"2026-03-26T23:00:00+00:00\"}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"“When love feels broken, sometimes pretending is another word for believing”- Callum Beattie\\n\\nINDI is Callum Beattie’s first fully independent album, a bold step outside the major label system that captures his rawest and most personal songwriting to date. Built on themes of inner struggle, self-discovery, and the pursuit of genuine love, the record channels the freedom of true creative expression. Produced by Joe Cross (Courteeners, The LaFontaines, Louis Tomlinson), the album pairs heartfelt lyrics with unfiltered honesty, offering a deeply intimate portrait of Callum’s journey- being lost in thought, searching for clarity, and ultimately finding strength through vulnerability.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:20\",\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"presented_by\":\"Presented by Kilimanjaro.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tom Speight\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5