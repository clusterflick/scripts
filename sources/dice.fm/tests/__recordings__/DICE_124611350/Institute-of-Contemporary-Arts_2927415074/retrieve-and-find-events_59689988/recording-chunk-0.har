//link.dice.fm/z3070ed7befa?dice_id=z3070ed7befa\",\"post_competition_referral\":\"https://link.dice.fm/oecfd3d636be?dice_id=oecfd3d636be\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B38b5a70052d?dice_id=B38b5a70052d\",\"post_purchase_referral\":\"https://link.dice.fm/Ib847016a26e?dice_id=Ib847016a26e\",\"post_reminder_referral\":\"https://link.dice.fm/Zf4d6c6a7805?dice_id=Zf4d6c6a7805\",\"post_waitinglist_referral\":\"https://link.dice.fm/X8f775619341?dice_id=X8f775619341\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"wwld5p-nothing-in-rambling-sister-suzie-andy-twyman-5th-apr-hot-box-chelmsford-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775397600,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:71\",\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-05/fc980ff9-6dd1-431b-8aee-4c20582dc352.jpg?rect=0%2C0%2C1014%2C1014\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-05/fc980ff9-6dd1-431b-8aee-4c20582dc352.jpg?rect=0%2C368%2C1014%2C608\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-05/fc980ff9-6dd1-431b-8aee-4c20582dc352.jpg?rect=138%2C0%2C739%2C1344\"},\"id\":\"690b3de0ba209c0001967fe6\",\"name\":\"Nothing in Rambling (Sister Suzie & Andy Twyman)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Sister Suzie and Andy Twyman take you on a musical journey through Mississippi and Louisiana performing music by artists such as Memphis Minnie, Blind Boy Fuller and Elmore James. Guided by a mutual passion for early blues, they evoke the playfulness, power and soul of the music.\\n\\nBefore collaborating, Suzie and Andy enjoyed success as separate artists. They have both toured the UK and Europe, and become Glastonbury Festival favourites; Suzie singing the blues in her band, and Andy performing his one man band show. After years of admiring each other’s work from afar, their love of early blues music brought them together. Andy’s nimble and authentic guitar work provides the perfect backdrop for Suzie’s powerful blues vocals and on-stage charm to shine. Whether you’re the rambling type or one for settling down, join Suzie and Andy for a journey through the blues and the people who lived them.\\n\\n“I adore this album, it has touched my soul” Stephen Harrison, Blues Matters Magazine review of ‘Live at Bush Hall’\\n\\n“\\\\[Suzie’s\\\\] vocals wash over the listener raw, naked and soulful, like the voice of a body in anguish, looking for the answers to the questions of the soul…Twyman’s virtuosity on guitar shines…his fingers dancing along the fretboard, creating a wild bluesy atmosphere” - Jack Austin, Blues Blast Magazine (USA)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T00:00:00+00:00\",\"sale_end_date\":\"2026-04-05T15:30:00+01:00\",\"sale_start_date\":\"2025-11-05T00:00:00+00:00\",\"event_start_date\":\"2026-04-05T15:00:00+01:00\",\"event_end_date\":\"2026-04-05T20:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Nothing In Rambling - Nothing in Rambling (Live)\",\"redirect_url\":\"https://music.apple.com/us/album/nothing-in-rambling-live/1760335609?i=1760335610&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nothing In Rambling\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/4c/2e/1c/4c2e1c55-665b-317a-0d67-425a08fd250e/mzaf_6961427129890953898.p