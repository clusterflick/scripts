iple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:88\",\"date_unix\":1775152800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1301},\"social_links\":{\"event_share\":\"https://link.dice.fm/O49bcb106c7f?dice_id=O49bcb106c7f\",\"post_competition_referral\":\"https://link.dice.fm/Ke63d2e544fd?dice_id=Ke63d2e544fd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K02757c97dd0?dice_id=K02757c97dd0\",\"post_purchase_referral\":\"https://link.dice.fm/g75e86043514?dice_id=g75e86043514\",\"post_reminder_referral\":\"https://link.dice.fm/p12b0e3db548?dice_id=p12b0e3db548\",\"post_waitinglist_referral\":\"https://link.dice.fm/zaa92f80a37c?dice_id=zaa92f80a37c\"},\"perm_name\":\"l8bpdr-hackney-folk-club-sarah-jane-scouten-2nd-apr-chats-palace-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/1485d7e5-d209-46ac-8111-3eb30ca67132.jpg?rect=968%2C0%2C3887%2C3887\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/1485d7e5-d209-46ac-8111-3eb30ca67132.jpg?rect=0%2C197%2C5823%2C3494\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/1485d7e5-d209-46ac-8111-3eb30ca67132.jpg?rect=1843%2C0%2C2138%2C3887\"},\"properties\":[],\"about\":{\"description\":\"Hackney Folk Club - Sarah Jane Scouten  \\n  \\nSarah Jane Scouten is a BC-born folk and Americana songwriter, paying respects to 60s and 70s country songwriters Willie Nelson, John Prine, Bobby Gentry. She weaves in British folk revival elements with a continuous thread leading back to her roots in bluegrass and old time music. After a transformative four years, training as a herbalist in southwest Scotland, Sarah Jane released her fifth album Turned to Gold. Sarah Jane offers a new depth and solidity as a songwriter. This is destined to be your next favourite road trip album.  \\n\\nTIMINGS  \\nDoors 7pm  \\nOld Timey Session: 7pm  \\nFloorspots: 8pm  \\nSarah Jane Scouten: 9pm  \\nBluegrass Session: 10-11pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697d408f5b8a5a0001433fa5\",\"name\":\"Hackney Folk Club - Sarah Jane Scouten\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sarah Jane Scouten - Ballad of a Southern Midwife\",\"redirect_url\":\"https://music.apple.com/us/album/ballad-of-a-southern-midwife/1482992324?i=1482992334&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sarah Jane Scouten\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview113/v4/71/57/82/715782db-fe84-bd69-e999-1228754394b6/mzaf_5802304970987710449.plus.aac.p.m4a\",\"track_name\":\"Ballad of a Southern Midwife\"},{\"type\":\"spotify\",\"title\":\"Sarah Jane Scouten - Ballad of a Southern Midwife\",\"redirect_url\":\"https://open.spotify.com/track/5s9XyEy7YDN29bMXsslZJz\",\"artist\":\"Sarah Jane Scouten\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fb030cc101ec8d4daffe043ee866cfe3ca31d96a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ballad of a Southern Midwife\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sarah Jane Scouten\",\"image\":null,\"artist_id\":\"24448\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T12:00:00+00:00\",\"sale_end_date\":\"2026-04-02T16:00:00+01:00\",\"sale_start_date\":\"2026-02-02T12:00:00+00:00\",\"event_start_date\":\"2026-04-02T19:00:00+01:00\",\"event_end_date\":\"2026-04-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[]