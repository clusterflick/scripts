_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773344700,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:87\",\"price\":{\"currency\":\"GBP\",\"amount\":2183,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/f4336b4a-2c30-4f76-b8af-fdde534e705e.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/f4336b4a-2c30-4f76-b8af-fdde534e705e.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/f4336b4a-2c30-4f76-b8af-fdde534e705e.jpg?rect=169%2C0%2C743%2C1350\"},\"id\":\"698e4aa3ced2390001ad86db\",\"name\":\"Pulled Apart By Horses\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"PULLED APART BY HORSES - https://linktr.ee/pulled_apart_by_horses\\n\\nPulled Apart By Horses have earned a reputation as one of the UK’s most electrifying live bands, an adrenaline fuelled cult built on trust, intensity and shared scars.\\n\\nTheir shows teeter between precision and total mayhem.\\n\\nThey blur the line between band and audience, valuing that connection from day one. Frontman Tom Hudson rarely stays onstage; face to face and unpredictable, he turns every corner of the venue into part of the performance. From sweat soaked clubs to festival stages, Pulled Apart By Horses create something raw and communal.\\n\\nWith five albums behind them and fresh noise brewing, they’re as lean, loud and unhinged as ever.\\n\\n\\\\+ supports\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T21:00:00+00:00\",\"sale_start_date\":\"2