:1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1779991200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:8\",\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/5ec29c59-3c03-4b2d-a441-97054f6f42e5.jpg?rect=2%2C0%2C1772%2C1772\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/5ec29c59-3c03-4b2d-a441-97054f6f42e5.jpg?rect=0%2C353%2C1776%2C1066\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/5ec29c59-3c03-4b2d-a441-97054f6f42e5.jpg?rect=401%2C0%2C975%2C1772\"},\"id\":\"697793270f9ecb00014a0982\",\"name\":\"Ella Clayton Album Launch\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Ella Clayton is a singer-songwriter from London, known for her storytelling and spell binding voice. Influenced by the likes of Jeff Buckley, Joan Armatrading and Adrianne Lenker, she began writing songs at 13, shaping a soulful, alt-folk sound that has captivated audiences across the UK and Europe. Her debut album Murmurations (2022) and acoustic follow-up Stairwell (2023) led to sold out headline shows at The Waiting Room, St Pancras Old Church, The Lower Third and Dalston Curve Garden, and festival appearances at Latitude Festival, Truck, Black Deer and Meadows in the Mountains.\\n\\nJoin Ella and her band for the official launch celebration of her second LP 'Could it be you?' (released 24th April) at the 100 Club.\\n\\nProduced by Lester Duval (Pip Millet, Odd910) and recorded at George Ezra's studio Hotel Quebec in just 3 days, this album is Ella's strongest and most authentic body of work yet.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-05-28T21:00:00+01:00\",\"sale_start_date\":\"2026-01-27T10:00:00+00:00\",\"event_start_date\":\"2026-05-28T19:00:00+01:00\",\"event_end_date\":\"2026-05-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Ella Clayton - Please Me\",\"redirect_url\":\"https://open.spotify.com/track/3liqUprn2KVqxGfJ3RyvTP\",\"artist\":\"Ella Clayton\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ee2742b2302e379b0f0cc7f22f7f346058261477?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Please Me\"},{\"type\":\"apple_music\",\"title\":\"Ella Clayton - Please Me\",\"redirect_url\":\"https://music.apple.com/us/album/please-me/1838731388?i=1838731389&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ella Clayton\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/3b/de/e7/3bdee7b3-06f6-a3e3-7643-78e607e799a7/mzaf_17448977273360662270.plus.aac.p.m4a\",\"track_name\":\"Please Me\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 