-toulouse-lautrec-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773343800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:72\",\"price\":{\"currency\":\"GBP\",\"amount\":2503,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/02dacee8-dfb1-45ea-94d0-7761fe92e4c6.jpg?rect=186%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/02dacee8-dfb1-45ea-94d0-7761fe92e4c6.jpg?rect=240%2C0%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/02dacee8-dfb1-45ea-94d0-7761fe92e4c6.jpg?rect=1044%2C0%2C792%2C1440\"},\"id\":\"698f3cb3de45d9000173fc8d\",\"name\":\"Liane Carroll\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join award-winning jazz vocalist and pianist for an unforgettable night of live music.\\n\\nWith a career spanning collaborations with icons like Paul McCartney, Gerry Rafferty, and Ladysmith Black Mambazo, and performances at legendary venues such as Ronnie Scott’s Jazz Club, Carroll brings a world of emotion and unmatched artistry to our stage.\\n\\nCarroll’s stunning vocals, described by The Guardian as “powerful” and “soul-inflected,” blend effortlessly with her virtuosic piano skills. A two-time BBC Jazz Award winner and recipient of the Parliamentary Jazz Awards’ Jazz Musician of the Year, she’s a true master of her craft. From her soulful jazz to R&B-infused singer-songwriter pieces, Carroll’s music transcends boundaries. Don’t miss the chance to experience Liane in this intimate setting.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\