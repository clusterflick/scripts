[UK Debut]\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"After a sold-out show, Natives returns with what they do best bringing together a deeply connected community, a carefully curated lineup, and a dancefloor rooted in Afrohouse and its many powerful derivatives.\\n\\nLeading the night is award-winning producer and platinum hitmaker Heavy-K, making his long-awaited London debut, bringing his unmistakable drum-heavy power and the rich South African soul that has moved communities worldwide.\\n\\nWe’re also proud to host the UK debut of Johannesburg duo Drumetic Boyz, whose gritty AfroTech sound has been turning heads from South Africa to Europe, now finally touching down in London, all powered by the Natives community that continues to grow, connect, and dance together.\\n\\n🚨 Lock in while you can. This one’s for the family. 🖤\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1843\",\"name\":\"E1 London\",\"image\":{\"url\":null},\"perm_name\":\"e1-london-3p9x\",\"profile_active\":false},\"date_unix\":1772920800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T22:00:00+00:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T23:00:00+00:00\",\"event_end_date\":\"2026-03-08T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"q29kva-viva-baile-7th-mar-lightbox-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_i