ns\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-22/cbb80eb7-e2d1-4c25-b8ac-419545b9d9fb.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-22/cbb80eb7-e2d1-4c25-b8ac-419545b9d9fb.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-22/cbb80eb7-e2d1-4c25-b8ac-419545b9d9fb.jpg?rect=486%2C0%2C1188%2C2160\"},\"id\":\"697265ca41a66400019fc32b\",\"name\":\"Soundcamp presents: POLARIS [Hosted By Jamz Supernova]\",\"seating\":null,\"secondary_status\":\"rescheduled\",\"new\":false,\"about\":{\"description\":\"Eight of Manchester's most compelling independent artists are set to take the stage this February. This Official Brits Fringe 2026 showcase offers an intimate, cross-genre live experience where soulful vocalists, experimental producers, rappers, and storytellers each present their own world and sonic identity.\\n\\nHosted by Jamz Supernova, the POLARIS live tour consists of BITEZ, LouFella, Ula, GoodBoyAngie, OLUCHI, Misan Veli, Foxi and Edriff - artists whose backgrounds span alt-pop, club culture, rap, jazz, shoegaze, grunge, and ambient music.\\n\\n\\\\---\\n\\nSoundcamp is a Reform Radio project funded by Youth Music.\\n\\nBRITs Fringe is produced by Brighter Sound in partnership with Manchester Music City, and supported by Manchester City Council, GMCA and Manchester Accommodation BID\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T17:00:00+00:00\",\"sale_end_date\":\"2026-02-25T19:30:00+00:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"eve