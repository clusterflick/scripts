:\"2026-04-21T19:30:00+01:00\",\"event_end_date\":\"2026-04-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ailbhe Reddy\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-26/85576492-00a0-4eee-b244-38e0440f9e3c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"6050\",\"about\":{\"description\":\"Dublin-based alt-folk star Ailbhe Reddy grew up with the guitars of Don McLean and Queen blaring from her mother’s car radio. But the riffs on her own cinematic debut, 2020’s Personal History, are far more understated, making room for the singer to reflect on her life: from social media toxicity to coming out as a queer woman; with Clash commenting that the release “feels more like a work of art than an album”.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by FORM.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":40565,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\"