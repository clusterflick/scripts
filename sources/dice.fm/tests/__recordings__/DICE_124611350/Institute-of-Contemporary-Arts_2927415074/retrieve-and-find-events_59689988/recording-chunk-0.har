\",\"title\":\"Triphop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:ukg\",\"title\":\"Ukg\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban\",\"title\":\"Urban\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_pop\",\"title\":\"Urban pop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_underground\",\"title\":\"Urban underground\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:vikingfolk\",\"title\":\"Viking folk\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:western_swing\",\"title\":\"Western swing\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:world\",\"title\":\"World\",\"subtitle\":\"Gigs\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T10:00:00+00:00\",\"sale_end_date\":\"2026-02-19T18:00:00+00:00\",\"sale_start_date\":\"2025-12-02T10:00:00+00:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Columbo Music.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/n6f5925984d4?dice_id=n6f5925984d4\",\"post_competition_referral\":\"https://link.dice.fm/G35b0995ab6c?dice_id=G35b0995ab6c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a19f3976850c?dice_id=a19f3976850c\",\"post_purchase_referral\":\"https://link.dice.fm/za931193d262?dice_id=za931193d262\",\"post_reminder_referral\":\"https://link.dice.fm/c43790974d29?dice_id=c43790974d29\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y24fc0e6c113?dice_id=Y24fc0e6c113\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Mysie's genre-bending sound is blurring the lines between electronic, dance music and alt pop. Classically trained as a pianist, her creative journey began as a dancer in a krump collective, where she discovered experimental hip hop and artists like J Dilla, Flying Lotus, and Thundercat, fueling her passion for boundary-pushing music.\\n\\nHer latest release SALTY deepens her love for experimentation with breakbeats and textured rhythms inspired by Peshay, Nookie, and Machinedrum, paired with the atmospheric chords of Yaeji and Lone.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2089,\"name\":\" The Columbo Group\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"556297964005636\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"date_unix\":1771527600,\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lower-third-pply\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:0\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"14\",\"name\":\"Columbo Music\",\"image\":{\"url\":null},\"perm_name\":\"columbo-music-427z\",\"profile_active\":true},\"id\":\"69244a2ae5ae220001923c03\",\"name\":\"Mysie\",\"perm_name\":\"avel6d-mysie-19th-feb-the-lower-third-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/b98d71bf-949f-4b2e-ae2d-df04b9a29cbc.jpg?rect=0%2C258%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/b98d71bf-949f-4b2e-ae2d-df04b9a29cbc.jpg?rect=0%2C458%2C1000%2C600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/b98d71bf-949f-4b2e-ae2d-df04b9a29cbc.jpg?rect=83%2C0%2C834%2C1516\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mysie \",\"image\":null,\"artist_id\":\"43476\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764064800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1965,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-02-19T17:00:00+00:00\",\"sale_start_date\":\"2025-12-12T00:00:00+00:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T20:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Conway Hall.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ob13e8178062?dice_id=Ob13e8178062\",\"post_competition_referral\":\"https://link.dice.fm/u029c14e8713?dice_id=u029c14e8713\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x65a3303062e?dice_id=x65a3303062e\",\"post_purchase_referral\":\"https://link.dice.fm/h68cab2748c4?dice_id=h68cab2748c4\",\"post_reminder_referral\":\"https://link.dice.fm/S49e50ef2c77?dice_id=S49e50ef2c77\",\"post_waitinglist_referral\":\"https://link.dice.fm/N31f6b1fc3bb?dice_id=N31f6b1fc3bb\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Palestinian Nay master, percussionist, and composer **Faris Ishaq** charts unexplored territories with the Nay, an ancient Middle Eastern flute dating back to 5000 B.C. Rooted in his Palestinian heritage, Faris celebrates its cultural legacy in today’s modern musical landscape.\\n\\n*Jasad*—Arabic for Body— draws from the breath-centered essence of the Nay, one of the oldest flutes still in use. Faris fuses Palestinian Tashbib—a percussive, improvisational Nay style—with the rhythmic footwork of Palestinian Dabke dance, playing simultaneously the Nay alongside a leg-mounted frame drum and foot percussion. With exceptional dexterity and expressive nuance, he weaves intricate melodies, dynamic beats and live sound effects, evoking textures reminiscent of looped or electronic music while remaining entirely acoustic.\\n\\nBorn in Bethlehem, Faris has established an international career, performing at major stages including Kings Place, the EFG London Jazz Festival, and the Monterey Jazz Festival. He has collaborated with multi-Grammy Award-winning artist John Patitucci on their single Supplication, and is a recording artist on the BAFTA-nominated soundtrack *Assassin’s Creed: Mirage*.\\n\\nMostly self-taught, Faris quickly gained recognition for his inventive, cross-cultural artistry. In 2018, he earned a full scholarship to study Global Jazz Performance at Berklee College of Music, where he received the Best Student Award for his innovative work blending Arabic music with jazz.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. Under 16's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771527600,\"venues\":[{\"id\":\"3223\",\"name\":\"Conway Hall\",\"address\":\"25 Red Lion Square Holborn, London WC1R 4RL UK\",\"location\":{\"lat\":51.51948760000001,\"lng\":-0.1168424},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"conway-hall-obq5\",\"accessibility\":{\"url\":\"https://www.conwayhall.org.uk/about-us/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T18:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:1\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"5578\",\"name\":\"Conway Hall\",\"image\":{\"url\":null},\"perm_name\":\"conway-hall-5nry\",\"profile_active\":false},\"id\":\"6925bb41b3e1e3000155cedb\",\"name\":\"Jasad by Faris Ishaq\",\"perm_name\":\"ryavdw-jasad-by-faris-ishaq-19th-feb-conway-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-22/fdb7ed48-60fc-4bce-a6bf-a6164ce96d66.jpg?rect=213%2C0%2C855%2C855\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-22/fdb7ed48-60fc-4bce-a6bf-a6164ce96d66.jpg?rect=0%2C44%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-22/fdb7ed48-60fc-4bce-a6bf-a6164ce96d66.jpg?rect=405%2C0%2C470%2C855\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1765497600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1130},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-29T10:00:00+01:00\",\"sale_end_date\":\"2026-02-19T18:00:00+00:00\",\"sale_start_date\":\"2025-10-03T10:00:00+01:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by SJM.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/o5aa6340ff05?dice_id=o5aa6340ff05\",\"post_competition_referral\":\"https://link.dice.fm/H246973e7012?dice_id=H246973e7012\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I0bd1b52c0e1?dice_id=I0bd1b52c0e1\",\"post_purchase_referral\":\"https://link.dice.fm/A4c912302d2f?dice_id=A4c912302d2f\",\"post_reminder_referral\":\"https://link.dice.fm/M70c598304b9?dice_id=M70c598304b9\",\"post_waitinglist_referral\":\"https://link.dice.fm/S03fe86c61b8?dice_id=S03fe86c61b8\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Covasettes.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771527600,\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-19T19:00:00+00:00\",\"doors_close_date\":\"2026-02-19T22:30:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:2\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"id\":\"68d6cd1185d6ba0001a81b1c\",\"name\":\"The Covasettes \",\"perm_name\":\"2wxywm-the-covasettes-19th-feb-scala-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-29/f715acce-b5e8-40b4-be8e-ee2454881f29.jpg?rect=0%2C0%2C2798%2C2798\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-29/f715acce-b5e8-40b4-be8e-ee2454881f29.jpg?rect=0%2C909%2C2798%2C1679\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-29/f715acce-b5e8-40b4-be8e-ee2454881f29.jpg?rect=438%2C0%2C1923%2C3497\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Covasettes\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba2f2d06ce9f740a0c284e0f4\"},\"artist_id\":\"10619\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1759136400,\"faqs\":[{\"id\":47471,\"title\":\"What to do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":0},{\"id\":47472,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":1},{\"id\":47473,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":47474,\"title\":\"A show is listed as sold out. How can I get tickets?\",\"body\":\"If a show is listed as sold out on this website then our venue is full to capacity. We recommend you download the DICE app and join the Waiting List for return tickets.\\n\\nYou are welcome to visit the box office when doors open for the event to see if there are any door tickets. We cannot guarantee door tickets will be available in advance. Sorry.\",\"order\":3},{\"id\":47475,\"title\":\"I have mobility issues. How can you help?\",\"body\":\"If you need a seat for medical reasons or need help moving around our venue, or if you’d like to bring a companion along to help you with mobility, you will need to arrange it with us in advance. We suggest you read our accessibility guide and then contact our box office.\",\"order\":4},{\"id\":47476,\"title\":\"Do I need ID? What type of ID is accepted?\",\"body\":\"Bring ID if you look 25 years of age or younger. We accept the following forms of photo ID.\\n\\n\\\\- Passport\\n\\n\\\\- Driving licence card\\n\\n\\\\- PASS card. You can apply for a PASS card at www.pass-scheme.org.uk\",\"order\":5},{\"id\":47477,\"title\":\"Can I bring food?\",\"body\":\"We do not allow you to bring food or drink into the venue. Chewing gum is also not permitted inside the venue.\",\"order\":6},{\"id\":47478,\"title\":\"Is there a cloakroom?\",\"body\":\"Yes, we have a cloakroom in the Foyer Bar space. As you walk up the entrance stairs and straight ahead towards the Foyer Bar the cloakroom is on the left. Each item is charged at £3.\",\"order\":7}],\"price\":{\"currency\":\"GBP\",\"amount\":1854,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Top Drawer\",\"redirect_url\":\"https://open.spotify.com/track/1W3hR3mrTYaar0rtm0m14j\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b9a6e36d50d63094b63fe5b356e0dc6ee95bdbf8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Top Drawer\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-10T12:45:00+01:00\",\"sale_end_date\":\"2026-02-19T17:30:00+00:00\",\"sale_start_date\":\"2025-09-10T13:00:00+01:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Hosted by CassKidd \",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":null,\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/p6b9b59fb379?dice_id=p6b9b59fb379\",\"post_competition_referral\":\"https://link.dice.fm/T8d0c1de798a?dice_id=T8d0c1de798a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/zdc73756f234?dice_id=zdc73756f234\",\"post_purchase_referral\":\"https://link.dice.fm/K93531c40e67?dice_id=K93531c40e67\",\"post_reminder_referral\":\"https://link.dice.fm/W095d5067db5?dice_id=W095d5067db5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Xdbd76fae101?dice_id=Xdbd76fae101\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Join us for the official album launch of Unearthed Vol.1 - a night dedicated to discovery, community, and the next wave of alternative talent.\\n\\nExperience live performances from select artists featured on the debut CassKidd curated Channel Alt compilation, alongside Alternative Openers - spotlighting new names and setting the tone for a full year of Channel Alt events in 2026.\\n\\nThis is a space to discover someone new, connect with like-minded creatives, and be part of the growing Channel Alt ecosystem.\\n\\n📍 The Ministry\\n\\n📅 19 February 2026\\n\\n🎟 FREE ENTRY\\n\\nPlus:\\n\\nLimited edition Channel Alt Unearthed ‘Sight Test 50’ T-Shirt available on the night - very limited quantities.\\n\\nCome early. Stay curious. Unearth something new.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":