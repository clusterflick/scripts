ilable_referral\":\"https://link.dice.fm/sba3860148a9?dice_id=sba3860148a9\",\"post_purchase_referral\":\"https://link.dice.fm/z2910e504498?dice_id=z2910e504498\",\"post_reminder_referral\":\"https://link.dice.fm/f35ecbbf0e68?dice_id=f35ecbbf0e68\",\"post_waitinglist_referral\":\"https://link.dice.fm/M8eb2cb2272d?dice_id=M8eb2cb2272d\"},\"perm_name\":\"xe5erl-gbh-2nd-may-new-cross-inn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-21/d1ab1d26-d70f-41dc-a0ef-dc48e8703e2d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-21/d1ab1d26-d70f-41dc-a0ef-dc48e8703e2d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-21/d1ab1d26-d70f-41dc-a0ef-dc48e8703e2d.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Punk T Ska and My Baby present\\n\\nGBH\\n\\nUK punk legends, back at the New Cross Inn! Always a massive show, grab your tickets now to avoid disappointment.\\n\\nhttps://www.facebook.com/GBH.official\\n\\n\\\\+ supports\\n\\nCommoner\\n\\nDoomCrust Heavy Riffcrafters hailing from Norwich/London, conjuring Sonic Alchemy since 2021!!\\n\\nhttps://linktr.ee/commonerdoom666\\n\\n\\\\+ more TBA\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"687e5bfd79b3f200012adc39\",\"name\":\"GBH\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Crush 'Em\",\"redirect_url\":\"https://open.spotify.com/track/15ZyRDq7eSWD45b9ML5LsD\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d8fc50ca9fdcb993a67f99edb351234c973b2c4a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Crush 'Em\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"GBH\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-23/a52623cf-0236-4640-948c-a99111596330.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"15093\",\"about\":null,\"is_headliner\":false},{\"name\":\"Commoner\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-13/abb5ef44-3901-4924-a6a7-3ceba981b8a8.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"78771\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-27T17:30:00+01:00\",\"sale_end_date\":\"2026-05-01T18:30:00+01:00\",\"sale_start_date\":\"2025-08-29T10:00:00+01:00\",\"event_start_date\":\"2026-05-02T18:30:00+01:00\",\"event_end_date\":\"2026-05-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":40555,\"title\":\"FAQs for The O2\",\"body\":\"Further information about visiting The O2 can be found at https://help.theo2.co.uk/hc/en-gb\",\"order\":0},{\"id\":40556,\"title\":\"How to book accessible tickets for The O2\",\"body\":\"Accessible Seating Accessible bookings can be purchased online when selecting the event via www.theo2.co.uk and visiting the https://www.theo2.co.uk/visit-us/accessibility, DICE do not process any Accessible tickets for any event at The O2.\",\"order\":1},{\"id\":40557,\"title\":\"How tickets work for The O2\",\"body\":\"Tickets will be in The O2 venue app as they’re handling ticket scanning for this event. We will email you when your tickets are available in the app.\\n\\nHow to use your tickets:\\n\\n1\\\\. Get The O2 venue app - https://www.theo2.co.uk/visit-us/the-o2-app\\n\\n2\\\\. Sign up using the email you used to purchase your tickets on DICE\\n\\n3\\\\. At the door, show your tickets on the venue app (not DICE)\",\"order\":2},{\"id\":40816,\"title\":\"Can I change my seat?\",\"body\":\"Seats can’t be changed after booking, so please review your selection carefully before checkout.\",\"order\":3}],\"marketeers\":[{\"id\":191,\"name\":\"Olivia Dean (via Universal Music)\",\"privacy_policy_link\":\"https://www.umusic.co.uk/privacy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2127,\"name\":\"The O2, London\",\"privacy_policy_link\":\"https://www.theo2.co.uk/legal/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"unicorn_extras\":false,\"seats_io_event_id\":\"e1b1b4e7-b5be-4ebf-a264-406dea1d17a3\",\"presented_by\":\"Presented by Communion ONE.\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"e1b1b4e7-b5be-4ebf-a264-406dea1d17a3\",\"seats_io_public_key\":\"91b87c00-af06-457c-b5e8-4d8f0af2ae7f\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1756312200,\"venues\":[{\"id\":\"584\",\"name\":\"The O2, London\",\"address\":\"O2 Arena\",\"location\":{\"lat\":51.5025248,\"lng\":0.00366410000003725},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-o2-london-q2xy\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-02T18:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":\"91b87c00-af06-457c-b5e8-4d8f0af2ae7f\",\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:29\",\"date_unix\":1777743000,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6889},\"social_links\":{\"event_share\":\"https://link.dice.fm/fd4b575e8387?dice_id=fd4b575e8387\",\"post_competition_referral\":\"https://link.dice.fm/U5089e16886c?dice_id=U5089e16886c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/o09d4c3a5360?dice_id=o09d4c3a5360\",\"post_purchase_referral\":\"https://link.dice.fm/i997996abc12?dice_id=i997996abc12\",\"post_reminder_referral\":\"https://link.dice.fm/ccdec76d5d0a?dice_id=ccdec76d5d0a\",\"post_waitinglist_referral\":\"https://link.dice.fm/pe89d20bf28d?dice_id=pe89d20bf28d\"},\"perm_name\":\"dkn7v6-olivia-dean-2nd-may-the-o2-london-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=270%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"Standing: Over 16s only. Seated: Under 15s must be accompanied by an adult over 18.\\n\\nOlivia Dean has partnered with PLUS1 so that £1 (+ VAT) per ticket goes to supporting the LIVE Trust (Charity Number: 1211251) and their work supporting those who are keeping venues open, festivals trading, artists touring and all those involved in the promoting and staging of live music performances.\\n\\nThere is a £3.25 Venue Facility Fee included in the ticket price.\\n\\nAccessible Seating Accessible bookings can be purchased online when selecting the event via www.theo2.co.uk and visiting the https://www.theo2.co.uk/visit-us/accessibility, DICE do not process any Accessible tickets for any event at The O2.\\n\\nOlivia Dean’s highly anticipated sophomore album The Art of Loving went straight in at #1 on the UK album charts, alongside hit single ‘Man I Need’ which also peaked at #1 in the UK singles chart - becoming the first solo British Female artist to claim the #1 single & #1 album simultaneously since Adele in 2021. Olivia also announced two more dates for her residency at The O2 in London on the 11th & 12th of June, adding to her biggest ever UK and EU tour, which kicks off in April 2026. Tickets for the new dates are available here: https://link.dice.fm/x2e53627ec0d\\n\\nThe tour will commence at Glasgow’s OVO Hydro on April 23rd, before embarking cross-country and culminating in six huge shows at The O2 in London - including four in April / May and two new additional nights in June as part of her O2 residency. Olivia also takes her exceptional live show across Europe performing tracks from The Art of Loving as well as live favourites off her Mercury Prize nominated debut, Messy.\\n\\nSpeaking on her chart success, Olivia said: “I feel very grateful and overwhelmed! I love the album I made and I’m so proud of myself for making it. But ultimately it is so joyful seeing how much it means to people and how it’s helping people understand love and loving.”\\n\\nOlivia currently also holds three of the top 10 biggest British singles released in 2025 so far, as well as The Art of Loving garnering the biggest opening week for a British female artist since Adele in 2021, according to Official Charts. The record, which includes fan favourites ‘Nice To Each Other’ and lead single ‘So Easy (To Fall In Love)’, quickly rose to Number 1 on the Official Albums Chart, and hit single ‘Man I Need’ became the highest charting song from a UK act on Spotify’s Global Charts this year, as well as charting at #25 (to date) on the Billboard Hot 100. The Art of Loving has since become the fastest selling album for a British female artist in 2025.\\n\\nStanding: Over 16s only. Seated: Under 15s must be accompanied by an adult over 18.\",\"highlights\":[]},\"id\":\"68af2f14a9c4710001a35b0a\",\"name\":\"Olivia Dean\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Danger\",\"redirect_url\":\"https://open.spotify.com/track/1zAITH7C5UFYNE8DOFlE7h\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/54a534c34e5c124540cc1463d2cb36e3674e9833?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Danger\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Olivia Dean\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-22/0f34a8d2-2acd-4aa9-a2bd-6c2993f875db.jpg?rect=0%2C0%2C1200%2C1200\"},\"artist_id\":\"13260\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T14:00:00+00:00\",\"sale_end_date\":\"2026-05-02T19:00:00+01:00\",\"sale_start_date\":\"2026-02-17T14:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:00:00+01:00\",\"event_end_date\":\"2026-05-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\