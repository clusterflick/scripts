condary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2663,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"1141\",\"name\":\"SJM Concerts\",\"image\":{\"url\":null},\"perm_name\":\"sjm-concerts-xe8k\",\"profile_active\":true},\"id\":\"6985c49c72bf990001315ee3\",\"seats_io_event_id\":null,\"name\":\"Izzy Escobar\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nv9ykq-izzy-escobar-29th-apr-hoxton-hall-london-tickets\",\"date_unix\":1777485600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-29T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Black Bordello\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-03/c4d6196f-4bf3-4284-bee4-f6315401379d.jpg?rect=0%2C0%2C500%2C500\"},\"artist_id\":\"16840\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/8680c3bd-6cb0-4029-81eb-1e5314c52f62.jpg?rect=606%2C0%2C2080%2C2080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/8680c3bd-6cb0-4029-81eb-1e5314c52f62.jpg?rect=0%2C104%2C3120%2C1872\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/8680c3bd-6cb0-4029-81eb-1e5314c52f62.jpg?rect=988%2C0%2C1144%2C2080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Prufrock\",\"redirect_url\":\"https://open.spotify.com/track/7qIy4mPwRYZORgULywRwdx\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/529eb2a3b741d41d91f0af5edfe66336888e393d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Prufrock\"},{\"type\":\"apple_music\",\"title\":\"Black Bordello - Spectre Man\",\"redirect_url\":\"https://music.apple.com/gb/album/spectre-man/1464815141?i=1464815339&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Black Bordello\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview123/v4/d1/6d/88/d16d887d-b8e1-ea05-343a-862c41802eca/mzaf_1162064905235077530.plus.aac.p.m4a\",\"track_name\":\"Spectre Man\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765929600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Black Bordello are an art-rock band from London, fronted by Sienna Bordello, whose emotive soprano and macabre vocals and lyricism have been likened to Kate Bush/ Siousxie, with their theatrical and genre-defying live proposition akin to The Last Dinner Party meets PJ Harvey.\\n\\nTheir metamorphic brand of alternative rock is also enchanted with vaudeville, post-punk, psychedelia and gothic rock.\\n\\nSince forming after the pandemic, they released two albums, receiving glowing reviews from CLASH, Wonderland, and Loud & Quiet, and airplay on BBC Radio 6. Subsequently, 'Nunhead' was remixed by the bassist of legendary goth group Bauhaus. They also supported the Libertines, Goat Girl and Fat Dog. After its release, their second record 'White Bardo' amassed 70k in organic streams as well as 18k+ views on ‘The Garden of Earthly Delights’ music video.\\n\\nThe band showcased at Rotterdam's Left of the Dial last autumn. So far in 2025 they have supported Pete Doherty, performed at New York City's New Colossus Festival & completed 3 UK tours all over the country and multiple festivals including Bestival in August.\\n\\nThey just recorded their third album with Balazs Altsach (Ugly, The Orchestra For Now) at KONK Studios & The Church. The upcoming album is already generating industry interest, leading their zealous genre-hopping into the territories of trip-hop & industrial pop.\\n\\nThe group have a UK and EU tour this autumn/winter, and will be starting 2026 with a bang with their single launch headline at London’s infamous 100 Club and have already gained confirmations for leading UK festivals in 2026 soon to be announced.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:54\",\"social_links\":{\"event_share\":\"https://link.dice.fm/a4464f36cd10?dice_id=a4464f36cd10\",\"post_competition_referral\":\"https://link.dice.fm/Y84a51cf882e?dice_id=Y84a51cf882e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q3be636a3a5c?dice_id=Q3be636a3a5c\",\"post_purchase_referral\":\"https://link.dice.fm/i5d77063bcb4?dice_id=i5d77063bcb4\",\"post_reminder_referral\":\"https://link.dice.fm/y1bd39339756?dice_id=y1bd39339756\",\"post_waitinglist_referral\":\"https://link.dice.fm/Qafdb7cc9917?dice_id=Qafdb7cc9917\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T00:00:0