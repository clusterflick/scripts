dice_id=G2da1ec4af7f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Xfb107ca3ea3?dice_id=Xfb107ca3ea3\",\"post_reminder_referral\":\"https://link.dice.fm/kcbd7c3556cc?dice_id=kcbd7c3556cc\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Jenevieve is an artist who effortlessly blends old-school charm with contemporary flair. The recording artist burst onto the scene in 2020 with her breakout single “Baby Powder,” which has surpassed 175M+ in global consumption and set the stage for her genre-defying sound.\\n\\nRaised in South Florida, her music blends influence from her Cuban and African American roots, creating a style that's both soulful and experimental. Made alongside executive producer and songwriter Elijah Gabor, Jenevieve’s critically acclaimed debut project Division and the follow-up EP Rendezvous quickly established her reputation for pairing silky melodies with raw, reflective storytelling.\\n\\nWith a sound that’s not quite neo-soul, not quite RnB, but always, undeniably, Jenevieve, she sets off on the worldwide The CRYSALIS Tour, continuing to solidify her as one of the most exciting voices of her generation.\",\"highlights\