_referral\":\"https://link.dice.fm/r46f82936f68?dice_id=r46f82936f68\"},\"perm_name\":\"l8oadl-brixton-got-soul-28th-mar-the-blues-kitchen-brixton-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-04/6d655610-568b-4842-b2ea-294217522a94.jpg?rect=0%2C1141%2C4492%2C4492\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-04/6d655610-568b-4842-b2ea-294217522a94.jpg?rect=0%2C2040%2C4492%2C2695\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-04/6d655610-568b-4842-b2ea-294217522a94.jpg?rect=383%2C0%2C3726%2C6774\"},\"properties\":[],\"about\":{\"description\":\"The best musicians in London hit the stage for two sets of soulful bangers every Saturday.\\n\\nThe only club night in town with incredible live performances and DJs from 9pm until 3am.\\n\\n£6 tickets are limited and come off sale 24 hours before the event. £10 tickets will be available all night, or you can pay the same amount on the door. We advise purchasing your tickets in advance to avoid queues.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo I.D required).\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"691711e34cde1100014df6bc\",\"name\":\"Brixton Got Soul\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Ray Charles - A Fool for You\",\"redirect_url\":\"https://music.apple.com/us/album/a-fool-for-you/46592114?i=46592134&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ray Charles\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/de/f0/a8/def0a816-faeb-f21e-4bc7-461ab9452ba3/mzaf_15243127491328637072.plus.aac.p.m4a\",\"track_name\":\"A Fool for You\"},{\"type\":\"spotify\",\"title\":\"Ray Charles - A Fool for You\",\"redirect_url\":\"https://open.spotify.com/track/7uMb8RUN7S0bXdWXpI2euL\",\"artist\":\"Ray Charles\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1b6a5f70c9e91cdc6