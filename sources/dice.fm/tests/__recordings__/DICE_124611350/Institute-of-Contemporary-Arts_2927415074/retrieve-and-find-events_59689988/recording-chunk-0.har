ours-hoxton-zl3w\",\"profile_active\":false},\"announcement_date_unix\":1770321600,\"social_links\":{\"event_share\":\"https://link.dice.fm/N100258264b3?dice_id=N100258264b3\",\"post_competition_referral\":\"https://link.dice.fm/od34e8ba172c?dice_id=od34e8ba172c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a7d590047174?dice_id=a7d590047174\",\"post_purchase_referral\":\"https://link.dice.fm/Wfc7501db51b?dice_id=Wfc7501db51b\",\"post_reminder_referral\":\"https://link.dice.fm/K11bc154ff18?dice_id=K11bc154ff18\",\"post_waitinglist_referral\":\"https://link.dice.fm/xd226b946fc9?dice_id=xd226b946fc9\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"53r5ek-the-nest-sessions-2nd-apr-colours-hoxton-london-tickets\",\"unicorn\":true,\"status\":\"announced\",\"is_fully_locked\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":627,\"name\":\"Colours\",\"privacy_policy_link\":\"https://colourshoxton.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1775154600,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:2\",\"price\":null,\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/4cdcc773-0279-45d4-afd4-c63e1544e7f3.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/4cdcc773-0279-45d4-afd4-c63e1544e7f3.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/4cdcc773-0279-45d4-afd4-c63e1544e7f3.jpg?rect=450%2C0%2C1100%2C2000\"},\"id\":\"69847abe511c9a00019f5dff\",\"name\":\"The Nest Sessions\",\"seating\":null,\"secondary_status\":\"pre-sale\",\"new\":false,\"about\":{\"description\":\"The Nest Sessions is all about high-energy performances that bring artists and audiences together in a way that feels electric and spontaneous. Founded by bassist and musical director Gili Goldberg, it’s a space where carefully crafted sets meet impromptu jams, creating a vibe of pure connection and audience connection.\\n\\nSince launching in 2022, The Nest has hosted incredible talent like Durand Bernarr, Vula Malinga, Nectar Woode, and Kojo Johnson (MRCY). Four years on, it’s become a go-to for both music lovers and musicians from London and beyond.. In 2026, The Nest Sessions embarks on a new chapter, promising even more unforgettable nights that celebrate both established artists and world-class session musicians.\\n\\nMore than just a show, The Nest Sessions is a family, where music, friendship, and collaboration are always front and center.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T20:00:00+00:00\",\"sale_end_date\":\"2026-04-02T18:00:00+01:00\",\"sale_start_date\":\"2026-02-05T20:00:00+00:00\",\"event_start_date\":\"2026-04-02T19:30:00+01:00\",\"event_end_date\":\"2026-04-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Eat Your Own Ears.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"2285\",\