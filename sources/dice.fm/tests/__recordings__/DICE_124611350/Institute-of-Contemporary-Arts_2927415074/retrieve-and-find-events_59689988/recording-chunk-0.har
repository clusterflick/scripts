0,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"605\",\"name\":\"Cadogan Hall\",\"address\":\"5 Sloane Terrace, London SW1X 9DQ\",\"location\":{\"lat\":51.4936625,\"lng\":-0.157574299999965},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-03/51395a8d-8b02-4ea1-9bcc-d92897eb2cd7.jpg?rect=48%2C0%2C470%2C470\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"cadogan-hall-g55p\",\"accessibility\":{\"url\":\"https://cadoganhall.com/your-visit/access-information/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"streaming_options\":null,\"marketeers\":[{\"id\":1446,\"name\":\"Serious\",\"privacy_policy_link\":\"https://serious.org.uk/serious-ticketing-t-cs\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":\"waiting-list\",\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:41\",\"about\":{\"description\":\"Eyvind Kang has Asian-Icelandic roots and was born in Oregon in 1971. He began playing the violin at the age of six, but quickly became interested in other instruments such as the guitar, bass, drums, etc. At Cornish College, Kang not only met his mentor, violinist Michael White (John Handy Quintet), but also established a musical connection with Wayne Horwitz, who introduced him to the young John Zorn. Soon after, John Zorn invited Kang to play with his group Cobra. He began recording his music for Zorn's label, Tzadik, also playing in other Zorn projects. In 1995, he met Bill Frisell for the first time, who approached him to collaborate on a soundtrack.\\n\\nBill Frisell’s career as a guitarist and composer has spanned more than 40 years and many celebrated recordings, whose catalog has been cited by Downbeat as “the best recorded output of the decade”. Grammy nominated, his latest recording is entitled Orchestras released April 2024 on Blue Note. In the trio format he’s favored throughout his career, the guitarist and composer has always projected an orchestral scope - through his remarkably complete sense of harmony, a unique gift for melodies that remain with you long after a performance, and a keen feel for how dynamic range can be used to convey emotion.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 14s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"83f19cfd-eea2-454d-8c2c-8029af4eeddc\",\"seats_io_public_key\":\"c36ada6d-6a62-4ea4-b2e3-d77a8688f68b\",\"seat_selection\":\"disabled\"},\"announcement_date_unix\":1749027600,\"seats_io_public_key\":\"c36ada6d-6a62-4ea4-b2e3-d77a8688f68b\",\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eyvind Kang\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/a29605dbbb532c24a68e0189811d40a4a53d62b8\"},\"artist_id\":\"58330\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/1dd94a43-86ba-4c85-a1fd-878ae7f9c172.jpg?rect=271%2C0%2C3780%2C3780\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/1dd94a43-86ba-4c85-a1fd-878ae7f9c172.