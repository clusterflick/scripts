"sales_tax\":0,\"amount_from\":null},\"id\":\"6988ed0d1cf0ce0001487110\",\"name\":\"The Rolling People\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Rolling People\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-04/2e85fa0d-bf6e-4ed5-9ce7-c2a13e6aca64.jpg?rect=0%2C49%2C501%2C501\"},\"artist_id\":\"104981\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"eordod-the-rolling-people-16th-apr-the-lower-third-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-08/b700f9b6-35bf-40e7-a2bd-edc4e0c1467f.jpg?rect=0%2C1116%2C2624%2C2624\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-08/b700f9b6-35bf-40e7-a2bd-edc4e0c1467f.jpg?rect=0%2C1181%2C2624%2C1574\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-08/b700f9b6-35bf-40e7-a2bd-edc4e0c1467f.jpg?rect=230%2C0%2C2165%2C3936\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"The Rolling People, recently coined as ‘Manchester’s next greatest success’ by Northern Exposure Magazine, The Rolling People already have an unmatched reputation for delivering stunning live performances.\\n\\n2024 saw the band capitalise on their hometown hero status, headlining the O2 Ritz Manchester (pictured below) in December, just 3 years into the band’s career, off the back of their debut EP ‘Before It’s Gone’. Now working on their sophomore EP, with producer Richard McNamara of Embrace, The Rolling People are now stacking up the shows once again.\\n\\nAfter touring with Andrew Cushin, and several shows supporting The K’s earlier this year, the young Stockport band look to capitalise on what is self-described as a transitional period in sound, style, and aesthetic. Spring 2026 brings the promise of a new lease of life into a red-hot indie scene.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Wunai\",\"redirect_url\":\"https://open.spotify.com/track/6PTzCtXWlskIGHBOEy2J7s\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c36541ebe2762ebd941e391872f111f6843d3374?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Wunai\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776362400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"829\",\"name\":\"New River Studios\",\"address\":\"199 Eade Rd, London N4 1DN, United Kingdom\",\"location\":{\"lat\":51.5749501,\"lng\":-0.0881636000000299},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-river-studios-g5e6\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:00:00+01:00\",\"doors_close_date\":