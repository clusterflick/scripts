es-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774119600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-18/6e7b8be6-3d22-44d4-9a48-5d32375b791e.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-18/6e7b8be6-3d22-44d4-9a48-5d32375b791e.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-18/6e7b8be6-3d22-44d4-9a48-5d32375b791e.jpg?rect=173%2C0%2C422%2C768\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/W3324bd23806?dice_id=W3324bd23806\",\"post_competition_referral\":\"https://link.dice.fm/Tb36fe310f7d?dice_id=Tb36fe310f7d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/q0ae8cfdac51?dice_id=q0ae8cfdac51\",\"post_purchase_referral\":\"https://link.dice.fm/md44acfccc66?dice_id=md44acfccc66\",\"post_waitinglist_referral\":\"https://link.dice.fm/E025bb10b2eb?dice_id=E025bb10b2eb\",\"post_reminder_referral\":\"https://link.dice.fm/w03148582756?dice_id=w03148582756\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"16432\",\"name\":\"Acres\",\"address\":\"12 Acklam Road, Kensington and Chelsea, London, W10 5QZ, United Kingdom\",\"location\":{\"lat\":51.51992,\"lng\":-0.20547},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"acres-nv389\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Tweet\\n\\nR&B Block Party continues the Live Sessions series with the stunning Tweet, performing live and up close at the ACRES Live Room on Saturday 21st March 2026!\\n\\nMulti-award-winning R&B songstress, Tweet, has returned to the music scene, releasing her the visual for her new smash single, “Toot Toot.” This track begins the musical journey for her forthcoming album, “Memoirs of A Southern Hummingbird”, which will be released in early 2026.\\n\\nThis is going to be a night of smooth grooves, soulful vocals, and all those feel-good R&B moments you’ve been waiting for. Expect a mix of classic favourites and new heat, all in one intimate space filled with good energy, It's is not to be missed! this will be a night of true indulgent R&B/Soul so come and join her exclusively at the ACRES Live Room.\\n\\nA night for true R&B lovers — don’t miss the vibe. 💫\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:91\",\"billing_promoter\":{\"id\":\"132296\",\"name\":\"Fresh vibes \",\"image\":{\"url\":null},\"perm_name\":\"fresh-vibes-66x2q\",\"profile_active\":false},\"presented_by\":\"Presented by R&B Block Party presents Live Sessions.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tweet\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/9cf78b831ef3a4c193148c73cafaf847010467ab\"},\"artist_id\":\"86520\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1763481600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T16:00:00+00:00\",\"sale_end_date\":\"2026-03-21T23:00:00+00:00\",\"sale_start_date\":\"2025-11-21T04:00:00+00:00