\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779386400,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-21T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:14\",\"tty_to_extras\":[],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"1141\",\"name\":\"SJM Concerts\",\"image\":{\"url\":null},\"perm_name\":\"sjm-concerts-xe8k\",\"profile_active\":true},\"id\":\"691ca8d6055b170001e192c7\",\"name\":\"Florence Road\",\"perm_name\":\"926b8o-florence-road-21st-may-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-12/09437224-f711-4bfe-8e59-6cea9382cb99.jpg?rect=0%2C79%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-12/09437224-f711-4bfe-8e59-6cea9382cb99.jpg?rect=0%2C239%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-12/09437224-f711-4bfe-8e59-6cea9382cb99.jpg?rect=137%2C0%2C526%2C957\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Florence Road\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-08/bbbfe47d-5fa8-4e13-9fb3-79c5db69cfb9.jpg?rect=480%2C0%2C2540%2C2540\"},\"artist_id\":\"111602\",\"about\":{\"description\":\"​​Made up of childhood friends Lily Aron (Vocals), Emma Brandon (Guitar), Ailbhe Barry (Bass) and Hannah Kelly (Drums), Florence Road spent their teens perfecting their craft in Aron’s garden shed in Wicklow, Ireland, refining a sound that is as influenced by icons like The Cranberries as it is contemporary peers such as Wolf Alice and Phoebe Bridgers. First capturing audience attention by posting covers online in their distinct style, the band built up an ardent fanbase without any official releases, receiving early co-signs from Olivia Rodrigo and beabadoobee in the process. As the band prepares to release more music this year, debut single ‘Heavy’ should serve as ample warning that Florence Road are set to establish themselves as one of the defining bands of their generation.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1763486100,\"faqs\":[{\"id\":58379,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":2220,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Heavy\",\"redirect_url\":\"https://open.spotify.com/track/7bOi2P9koS8GKmGBc8wjzU\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f19ae6e74911714ac2345c1f9cc38a8da5d8bc4f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Heavy\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T11:00:00+00:00\",\"sale_end_date\":\"2026-05-21T15:00:00+01:00\",\"sale_start_date\":\"2026-02-12T11:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:30:00+01:00\",\"event_end_date\":\"2026-05-21T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP FAMILY.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/u4ad124e5af3?dice_id=u4ad124e5af3\",\"post_competition_referral\":\"https://link.dice.fm/K750fb9e7525?dice_id=K750fb9e7525\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/y0b8e54db2b9?dice_id=y0b8e54db2b9\",\"post_purchase_referral\":\"https://link.dice.fm/c1e49f9bd25f?dice_id=c1e49f9bd25f\",\"post_reminder_referral\":\"https://link.dice.fm/bf8351202e67?dice_id=bf8351202e67\",\"post_waitinglist_referral\":\"https://link.dice.fm/x028c2ea68cc?dice_id=x028c2ea68cc\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"DHP & FOOTSTEPS FESTIVAL Presents :\\n\\nMilo Korbenski\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\