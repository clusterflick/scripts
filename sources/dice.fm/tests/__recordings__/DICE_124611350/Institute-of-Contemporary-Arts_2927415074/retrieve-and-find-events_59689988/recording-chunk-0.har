\",\"title\":\"Triphop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:ukg\",\"title\":\"Ukg\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban\",\"title\":\"Urban\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_pop\",\"title\":\"Urban pop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_underground\",\"title\":\"Urban underground\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:vikingfolk\",\"title\":\"Viking folk\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:western_swing\",\"title\":\"Western swing\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:world\",\"title\":\"World\",\"subtitle\":\"Gigs\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Joshua Idehen\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-28/7350a583-6b29-4653-a9e9-c78a8ecb4d6e.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"59405\",\"about\":{\"description\":\"“This is a plea for a bit more patience with each other, and for me to be a bit more patient with myself,” Joshua Idehen says of his poetic solo debut track, ‘Don’t You Give Up On Me’. Accompanied by a choreographed music video, it seems there’s little that the spoken word poet, magazine editor and nu-jazz artist can’t do. Born in the UK to Nigerian parents before settling in Sweden, Idehan has lent his soulful verses to Mercury Prize-nominated albums by Sons of Kermet and The Comet Is Coming, and crafted genre-blurring soundscapes with producers Daedelus and LV.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":true,\"donation\":null,\"presented_by\":\"Presented by Rough Trade.\",\"tty_to_extras\":[{\"ticket_type_id\":1176164,\"extra_ids\":[\"1182636\"]},{\"ticket_type_id\":1176165,\"extra_ids\":[\"1182636\"]},{\"ticket_type_id\":1177163,\"extra_ids\":[\"1182636\"]},{\"ticket_type_id\":1177164,\"extra_ids\":[\"1182636\"]}],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",