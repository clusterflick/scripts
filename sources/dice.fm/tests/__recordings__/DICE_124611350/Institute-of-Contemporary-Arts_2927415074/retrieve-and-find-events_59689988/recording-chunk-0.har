\",\"title\":\"Triphop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:ukg\",\"title\":\"Ukg\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban\",\"title\":\"Urban\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_pop\",\"title\":\"Urban pop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_underground\",\"title\":\"Urban underground\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:vikingfolk\",\"title\":\"Viking folk\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:western_swing\",\"title\":\"Western swing\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:world\",\"title\":\"World\",\"subtitle\":\"Gigs\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dardust\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9943068b0b92dd9872f5c2a7\"},\"artist_id\":\"20039\",\"about\":{\"description\":\"Pianist and music producer, among the most awarded and influential of his generation, Dario Faini, aka Dardust, has created a piece that reflects the Italian and contemporary Spirit of Milano Cortina 2026, combining tradition and contemporaneity.\\n\\nDardust has already brought his music to international stages, from the Super Bowl to the NBA All-Star Game, up to collaborations and live performances alongside Stromae, Lana Del Rey, and Dua Lipa.\\n\\nEven in the collaboration with Milano Cortina 2026, he remained faithful to his style, creating unconventional atmospheres, in a balance that plays between piano melodies and those typical of electronic music.\\n\\n\\\"Fantasia Italiana\\\" is inspired by the iconic territories that will host the Winter Olympic Games, from Milan to Cortina. The sound environments of the city and the mountains are translated into a contemporary rhapsody. The result is a piece in which tributes to the Italian musical tradition emerge: from Morricone to Moroder, from the energy of Salento's pizzica to alpine choirs, even evoking the legacy of Rossini and Verdi.\\n\\n\\\"Working on the Anthem was an enormous responsibility: touching such a powerful symbol means entering a sacred place of collective memory. I wanted to respect its strength, but update the sound with a contemporary light. My goal was to leave a lasting emotion, a note that, in ten years, brings to mind a start, a victory, an applause,\\\" declared Dardust\\n\\nThe announcement of the official soundtrack is part of the journey towards Milano Cortina 2026, a unique and unmissable event that unites sport, culture, and creativity in a project with an international reach.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DMP.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"27\",\"name\":\"The Courtyard Theatre\",\"address\":\"Bowling Green Walk, 40 Pitfield St, London N1 6EU\",\"location\":{\"lat\":51.5279204,\"lng\":-0.0833459000000403},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-courtyard-theatre-zl8w\",\"accessibility\":{\"url\":\"https://thecourtyard.org.uk/location-and-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-27T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1768\",\"name\":\"DMP\",\"image\":{\"url\":null},\"perm_name\":\"dmp-d5kq\",\"profile_active\":false},\"announcement_date_unix\":1768820400,\"social_links\":{\"event_share\":\"https://link.dice.fm/w4c401bfc439?dice_id=w4c401bfc439\",\"post_competition_referral\":\"https://link.dice.fm/U3372309995a?dice_id=U3372309995a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hb6203caec2f?dice_id=hb6203caec2f\",\"post_purchase_referral\":\"https://link.dice.fm/pb647f780b92?dice_id=pb647f780b92\",\"post_reminder_referral\":\"https://link.dice.fm/P464622ca1b9?dice_id=P464622ca1b9\",\"post_waitinglist_referral\":\"https://link.dice.fm/h658b03d2a1c?dice_id=h658b03d2a1c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"3og3nv-dardust-27th-may-the-courtyard-theatre-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":25,\"name\":\"The Courtyard Theatre\",\"privacy_policy_link\":\"http://www.thecourtyard.org.uk/content/16/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2237,\"name\":\"DMP\",\"privacy_policy_link\":\"https://www.dmpuk.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1779906600,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:0\",\"price\":{\"currency\":\"GBP\",\"amount\":3740,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/e4afd4ba-ce7b-4673-ba0a-5729d8f6a4e1.jpg?rect=342%2C0%2C1365%2C1365\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/e4afd4ba-ce7b-4673-ba0a-5729d8f6a4e1.jpg?rect=0%2C68%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/e4afd4ba-ce7b-4673-ba0a-5729d8f6a4e1.jpg?rect=649%2C0%2C751%2C1365\"},\"id\":\"696a3e162971ef0001f96805\",\"name\":\"Dardust\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Pianist and music producer, among the most awarded and influential of his generation, Dario Faini, aka Dardust, has created a piece that reflects the Italian and contemporary Spirit of Milano Cortina 2026, combining tradition and contemporaneity.\\n\\nDardust has already brought his music to international stages, from the Super Bowl to the NBA All-Star Game, up to collaborations and live performances alongside Stromae, Lana Del Rey, and Dua Lipa.\\n\\nEven in the collaboration with Milano Cortina 2026, he remained faithful to his style, creating unconventional atmospheres, in a balance that plays between piano melodies and those typical of electronic music.\\n\\n\\\"Fantasia Italiana\\\" is inspired by the iconic territories that will host the Winter Olympic Games, from Milan to Cortina. The sound environments of the city and the mountains are translated into a contemporary rhapsody. The result is a piece in which tributes to the Italian musical tradition emerge: from Morricone to Moroder, from the energy of Salento's pizzica to alpine choirs, even evoking the legacy of Rossini and Verdi.\\n\\n\\\"Working on the Anthem was an enormous responsibility: touching such a powerful symbol means entering a sacred place of collective memory. I wanted to respect its strength, but update the sound with a contemporary light. My goal was to leave a lasting emotion, a note that, in ten years, brings to mind a start, a victory, an applause,\\\" declared Dardust\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T11:00:00+00:00\",\"sale_end_date\":\"2026-05-27T18:00:00+01:00\",\"sale_start_date\":\"2026-01-20T11:00:00+00:00\",\"event_start_date\":\"2026-05-27T19:30:00+01:00\",\"event_end_date\":\"2026-05-27T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dardust - Beautiful Solitude\",\"redirect_url\":\"https://music.apple.com/us/album/beautiful-solitude/1488536341?i=1488536474&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dardust\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/96/7c/de/967cdeec-3564-f30d-a30a-74b8a22e606b/mzaf_8872446654075262695.plus.aac.p.m4a\",\"track_name\":\"Beautiful Solitude\"},{\"type\":\"spotify\",\"title\":\"Dardust - Beautiful Solitude\",\"redirect_url\":\"https://open.spotify.com/track/5MRnaQy9MCXQHiTlqVRHWM\",\"artist\":\"Dardust\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4441e0e20f31976853515a8808e68bc9f00e6642?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Beautiful Solitude\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lily Moore\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb6b7d4b8cb3332b8b980615e3\"},\"artist_id\":\"7951\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Live Nation.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":68678,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-27T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"announcement_date_unix\":1768903200,\"social_links\":{\"event_share\":\"https://link.dice.fm/Tc0f3ff3b2d8?dice_id=Tc0f3ff3b2d8\",\"post_competition_referral\":\"https://link.dice.fm/Bc1b73b10230?dice_id=Bc1b73b10230\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C3879bfd2a4f?dice_id=C3879bfd2a4f\",\"post_purchase_referral\":\"https://link.dice.fm/bd8c3d493741?dice_id=bd8c3d493741\",\"post_reminder_referral\":\"https://link.dice.fm/l93f2311f7cc?dice_id=l93f2311f7cc\",\"post_waitinglist_referral\":\"https://link.dice.fm/j198c161f57d?dice_id=j198c161f57d\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purc