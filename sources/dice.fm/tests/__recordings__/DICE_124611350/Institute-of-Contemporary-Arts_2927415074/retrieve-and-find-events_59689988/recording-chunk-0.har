uncement_date\":\"2026-01-30T10:00:00+00:00\",\"sale_end_date\":\"2027-01-15T17:00:00+00:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2027-01-15T19:00:00+00:00\",\"event_end_date\":\"2027-01-15T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/x85888382fc2?dice_id=x85888382fc2\",\"post_competition_referral\":\"https://link.dice.fm/S0b4c2ab19d8?dice_id=S0b4c2ab19d8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Gccb556d94f9?dice_id=Gccb556d94f9\",\"post_purchase_referral\":\"https://link.dice.fm/T68fe66085e5?dice_id=T68fe66085e5\",\"post_reminder_referral\":\"https://link.dice.fm/h9d86aa8d9d6?dice_id=h9d86aa8d9d6\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jc632c406380?dice_id=Jc632c406380\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"JANUARY BLUES FESTIVAL 2027 presents\\n\\nTHE ANIMALS feat. John Steel and Friends\\n\\nGENO WASHINGTON & THE RAM JAM BAND\\n\\nDJ: SNOWBOY\\n\\nThe January Blues Festival kicks off it's 10th anniversary year with the welcome return of The Animals and Geno Washington to perform on the opening night.\\n\\nHouse of the Rising Sun, Don't Le Me Be Misunderstood, We've Gotta Get Out of This Place, Baby Let Me Take You Home, Bring It On Home To Me, It's My Life and many more helped make The Animals one of the biggest groups in the world during the 1960's. Founding member and drummer with the group John Steel now leads his own version of the legendary band.\\n\\nGeno Washington is an American Rhythm 'n' Blues singer who shot to fame in the late 1960's with his group The Ram Jam Band. Celebrated by Dexys Midnight Runners with their #1 1980 single Geno, Geno Washington and the Ram Jam Band released five albums between 1966-1969 before splitting.\\n\\nHost and DJ for the January Blues Festival is Snowboy playing Chicago Blues, Rhythm & Blues, Blues Rock and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1800039600,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-01-15T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:70\",\"tty_to_extras\":[],\"secondary_status\":null,\"bi