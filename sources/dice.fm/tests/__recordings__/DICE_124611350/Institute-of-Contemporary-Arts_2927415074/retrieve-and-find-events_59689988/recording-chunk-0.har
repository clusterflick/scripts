.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-31T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:51\",\"date_unix\":1774980000,\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Pcda8e9708f2?dice_id=Pcda8e9708f2\",\"post_competition_referral\":\"https://link.dice.fm/s4ea2d8e6f83?dice_id=s4ea2d8e6f83\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C543b4db398e?dice_id=C543b4db398e\",\"post_purchase_referral\":\"https://link.dice.fm/P98e35227191?dice_id=P98e35227191\",\"post_reminder_referral\":\"https://link.dice.fm/Rc8a34191d02?dice_id=Rc8a34191d02\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ld5a93f42466?dice_id=Ld5a93f42466\"},\"perm_name\":\"mx8w39-aqualung-31st-mar-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-23/cb7a617f-18c0-4724-97d9-488013b4da67.jpg?rect=277%2C1471%2C2545%2C2543\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-23/cb7a617f-18c0-4724-97d9-488013b4da67.jpg?rect=0%2C637%2C5902%2C3541\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-23/cb7a617f-18c0-4724-97d9-488013b4da67.jpg?rect=1627%2C0%2C2648%2C4815\"},\"properties\":[],\"about\":{\"description\":\"**Aqualung, the project of Matt Hales, brings the piano-led sound of early 2000s alternative pop to life.**\\n\\nFrom hits like ‘Strange and Beautiful’ to ‘Brighter Than Sunshine’, his catalogue fuses emotion-driven melodies, considered vocals and emotional depth.\\n\\nBeyond his own recordings, Hales has collaborated with Lianne La Havas, Paloma Faith, and Jason Mraz, bringing his signature touch to some of the decade’s most memorable songs.\\n\\nA live experience subtle emotion, dynamic piano, and compelling connection — a chance to hear these modern classics in their purest form.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6949289b6a4c4d000191e38b\",\"name\":\"Aqualung\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Brighter Than Sunshine\",\"redirect_url\":\"https://open.spotify.com/track/2LC523tbEPFpc1pnikbt5b\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/49217d8bc695ae7b9d51cfdda968047d184f1964?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Brighter Than Sunshine\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Aqualung\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb617878f7549f30a34c55ac51\"},\"artist_id\":\"56146\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":20,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T11:00:00+00:00\",\"sale_end_date\":\"2026-03-31T21:00:00+01:00\",\"sale_start_date\":\"2025-12-19T11:00:00+00:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tikt