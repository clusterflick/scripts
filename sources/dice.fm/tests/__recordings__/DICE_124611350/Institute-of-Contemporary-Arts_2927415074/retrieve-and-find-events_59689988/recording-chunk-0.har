w_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music69/v4/fb/ed/64/fbed640d-909d-b540-13ed-f08d9c9f4a8a/mzaf_8144432170140327506.plus.aac.p.m4a\",\"track_name\":\"3 Klavier-Soli, Op. 74: No. 1, Ballade. Andantino, quasi larghetto\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by World Heart Beat.\",\"billing_promoter\":{\"id\":\"139902\",\"name\":\"World Heart Beat\",\"image\":{\"url\":null},\"perm_name\":\"world-heart-beat-bmv9k\",\"profile_active\":false},\"date_unix\":1778697000,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-13T18:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:86\",\"about\":{\"description\":\"Experience the creative power of Alexander Scriabin, the most original voice of the Russian Silver Age, performed by pianist Tra Nguyen\\n\\nTra Nguyen, the acclaimed British-Vietnamese pianist, captivates audiences with performances hailed as “coruscating” (The Independent), “sophisticated” (Rheinpfalz-Zeitung), and possessing “surpassing keyboard artistry and passion” (American Record Guide).\\n\\nNguyen’s distinguished discography, receiving worldwide airplay on major classical networks, features notable world premiere recordings of overlooked works. Her critically lauded series of Joachim Raff’s piano music for Grand Piano was named ‘Album of the Week’ by The Independent. Her recent release, dedicated to Borenstein’s 12 Etudes & Piano Works, has also garnered significant critical praise.\\n\\n**Programme**\\n\\nAlexander Scriabin (1872-1915)\\n\\nThese sonatas trace a radical evolution: from the passionate, late-Romantic dramas of his early years to a revolutionary, mystical language all his own.\\n\\nSonata No. 1 in F minor Op. 6\\n\\nSonata No. 2 in G-sharp minor Op. 19\\n\\nSonata No. 3 in F-sharp minor Op. 23\\n\\nSonata No. 4 in F-sharp major Op. 30\\n\\nSonata No. 5, Op. 53\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1770213600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tra Nguyen\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2a34cf105765b4304e788a32\"},\"artist_id\":\"133551\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/461f0576-bf20-4724-8b68-58def2cc3136.jpg?rect=320%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/461f0576-bf20-4724-8b68-58def2cc3136.jpg?rect=0%2C64%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/461f0576-bf20-4724-8b68-58def2cc3136.jpg?rect=608%2C0%2C704%2C1280\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69838cb456860e0001a57721\",\"name\":\"Tra Nguyen: Scriabin's Complete Piano Sonatas (Recital 1)\",\"new\":false,\"dates\":{\"timezone\