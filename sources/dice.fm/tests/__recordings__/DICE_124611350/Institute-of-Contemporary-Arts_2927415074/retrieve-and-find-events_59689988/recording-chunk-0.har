_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/f30ce05a-4131-48e5-92b0-ac615788734f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/f30ce05a-4131-48e5-92b0-ac615788734f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/f30ce05a-4131-48e5-92b0-ac615788734f.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1753527600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"The name says it all, Electronic Music Open Mic or EMOM for short is an open stage night for local electronic musicians.\\n\\nThis free night will showcase up to 7 local electronic artists performing an array of different types of music ranging from house, techno, ambient, industrial, chiptune, looping, field recording, experimental electronica and more.\\n\\nEMOM has become a movement over the last 2 years with regular independent nights hosted in many cities and counties across the UK. This night is aimed at giving local electronic music artists a supportive space to play live and experiment.\\n\\nThese nights are great fun for both artists and fans of electronic music, you never know what genre you might hear next!\\n\\nThe format is simple; each artist will get a 20-minute window (including set up time) to do their thing before handing over to the next artist. The only rule is no guitars unless they are being used to generate soundscapes or some other style of music in keeping with these nights.\\n\\nIf you’d like to play, please email controlvoltageemom@gmail.com to register. If you’d just like to come along and watch, just click the ‘buy now’ link to secure your place. The night is completely free whether you are playing or watching.\\n\\nAll ages welcome – under 16 to be accompanied by a responsible adult.\\n\\nThis event is hosted by Control Voltage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 to be accompanied by a responsible adult\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Control Voltage\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:56\",\"social_links\":{\"event_share\":\"https://link.dice.fm/j78da01d041c?dice_id=j78da01d041c\",\"post_competition_referral\":\"https://link.dice.fm/Va1bdff6fd88?dice_id=Va1bdff6fd88\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f6de607a16f4?dice_id=f6de607a16f4\",\"post_purchase_referral\":\"https://link.dice.fm/L587ccb5726d?dice_id=L587ccb5726d\",\"post_reminder_referral\":\"https://link.dice.fm/e05e26de4c4d?dice_id=e05e26de4c4d\",\"post_waitinglist_referral\":\"https://link.dice.fm/h2291ed877b0?dice_id=h2291ed877b0\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-26T12:00:00+01:00\",\"sale_end_date\":\"2026-03-18T19:00:00+00:00\",\"sale_start_date\":\"2025-07-26T12:00:00+01:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6883a590b0583900013984fe\",\"seats_io_event_id\":null,\"name\":\"Control Voltage: Electronic Music Open Mic\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"nvo3n3-control-voltage-electronic-mus