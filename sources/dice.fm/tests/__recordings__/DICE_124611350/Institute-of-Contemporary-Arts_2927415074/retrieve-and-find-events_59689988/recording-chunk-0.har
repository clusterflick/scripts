%20court.\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772132400,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:76\",\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/125c447f-6951-4798-b836-687ca6695826.jpg?rect=0%2C117%2C1070%2C1070\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/125c447f-6951-4798-b836-687ca6695826.jpg?rect=0%2C479%2C1070%2C642\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/125c447f-6951-4798-b836-687ca6695826.jpg?rect=95%2C0%2C880%2C1600\"},\"id\":\"693937180d3d540001b2126f\",\"name\":\"Zach Thompson\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Zach Thompson has been making his mark in the burgeoning South-East London folk scene, playing across the city alongside his fortnightly residency at Skehans. With a distinctive blend of literary and music influences from intimate folk to freewheeling jazz, Thompson's new EP is full of deftly rendered metaphors and almost painterly imagery, calling back to the vibrant poetry at the heart of New York’s Greenwich Village scene in the 1960s. New EP ‘On Platt’s Eyott’ is available with the debut EP ‘Algebra Parable’ on a limited edition 12” vinyl via Breakfast Records.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T10:00:00+00: