date_unix\":1780074000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:24\",\"price\":{\"currency\":\"GBP\",\"amount\":2984,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-23/e8d0d746-8d11-406b-b3eb-4ac2f7d3db1e.jpg?rect=375%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-23/e8d0d746-8d11-406b-b3eb-4ac2f7d3db1e.jpg?rect=0%2C225%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-23/e8d0d746-8d11-406b-b3eb-4ac2f7d3db1e.jpg?rect=881%2C0%2C1238%2C2250\"},\"id\":\"694aae0b1d72490001563d41\",\"name\":\"Seedhe Maut\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Having mastered the art of delivering razor sharp rhymes, Seedhe Maut have pushed forward the boundaries of hip-hop in India.\\n\\nComprising of Encore ABJ and Calm, the Delhi-based duo are taking the industry by storm and are unanimously regarded as the next big thing to break in the rapid growing subculture landscape.\\n\\nPresenting Hindi Rap in a revolutionary new format, Seedhe Maut have surpassed 500 million streams, earned a double platinum single, and are rapidly becoming one of the fastest growing acts.\\n\\nRecognised as one of the best live performers in the country, Seedhe Maut return to London following a huge sell-out show, this time heading to KOKO.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-28T05:00:00+00:00\",\"sale_end_date\":\"2026-05-29T17:00:00+01:00\",\"sale_start_date\":\"2025-12-28T05:00:00+00:00\",\"event_start_date\":\"2026-05-29T18:00:00+01:00\",\"event_end_date\":\"2026-05-29T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sasha Velour\",\"image\":null,\"artist_id\":\"66770\",\"about\":{\"description\":\"Sasha Velour is a performer, artist, actor and producer known for her artistically intelligent brand of drag. Winning the ninth season of RuPaul’s Drag Race in 2009 with a now-historic Whitney Houston lip sync, the gender-fluid Brooklyn-based performer was named by New York Magazine as one of the most powerful drag queens in America. Her career since winning the series is testament to this: in 2018, she worked with Opening Ceremony to host New York Fashion Week’s first all-queer show, while her one-woman theatre evening Smoke & Mirrors united drag, visual art and magic in the US and Europe.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":3},\"offers_extras\":true,\"donation\":null,\"presented_by\":\"Presented by Kilimanjaro.\",\"tty_to_extras\":[{\"ticket_type_id\":1177377,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177378,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177379,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177380,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177381,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177382,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177383,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177384,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177385,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1177386,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1183677,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1183678,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1189981,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1189982,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1190790,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1190791,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1190792,\"extra_ids\":[\"1184230\"]},{\"ticket_type_id\":1190793,\"extra_ids\":[\"1184230\"]}],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T19:00:00+01:00\",\"doors_close_date\":\"2026-05-29T23:00:00+01:00\"}],\"seats_io_event_id\":\"cbdf5903-5add-4a3d-a3da-b0d460156e8f\",\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"announcement_date_unix\":1769508000,\"social_links\":{\"event_share\":\"https://link.dice.fm/y6f07f598630?dice_id=y6f07f598630\",\"post_competition_referral\":\"https://link.dice.fm/q7a118e7557f?dice_id=q7a118e7557f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ma7a08bd0fec?dice_id=ma7a08bd0fec\",\"post_purchase_referral\":\"https://link.dice.fm/ba59ee285472?dice_id=ba59ee285472\",\"post_reminder_referral\":\"https://link.dice.fm/mfbadf3ed505?dice_id=mfbadf3ed505\",\"post_waitinglist_referral\":\"https://link.dice.fm/re63a859efb5?dice_id=re63a859efb5\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"l8bxel-sasha-velour-29th-may-troxy-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780077600,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:25\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4800},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/d025849e-b0cd-4bab-9047-de99d6932bde.jpg?rect=667%2C0%2C2667%2C2667\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/d025849e-b0cd-4bab-9047-de99d6932bde.jpg?rect=0%2C134%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/d025849e-b0cd-4bab-9047-de99d6932bde.jpg?rect=1267%2C0%2C1467%2C2667\"},\"id\":\"697788f8d6ac2c000109ac3f\",\"name\":\"Sasha Velour\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"cbdf5903-5add-4a3d-a3da-b0d460156e8f\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Pre sale 10am Thurs 29th Jan. General Sale 10am Fri 30th Jan.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-05-29T22:00:00+01:00\",\"sale_start_date\":\"2026-01-29T10:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:00:00+01:00\",\"event_end_date\":\"2026-05-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by SJQ.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"124635\",\"name\":\"SJQ\",\"image\":{\"url\":null},\"perm_name\":\"sjq-wb3bv\",\"profile_active\":false},\"announcement_date_unix\":1771200000,\"social_links\":{\"event_share\":\"https://link.dice.fm/s71c5293b827?dice_id=s71c5293b827\",\"post_competition_referral\":\"https://link.dice.fm/Tffa46afec07?dice_id=Tffa46afec07\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Bd9bf7b75ca9?dice_id=Bd9bf7b75ca9\",\"post_purchase_referral\":\"https://link.dice.fm/H3cc7b43456d?dice_id=H3cc7b43456d\",\"post_reminder_referral\":\"https://link.dice.fm/x87e97cfe7f0?dice_id=x87e97cfe7f0\",\"post_waitinglist_referral\":\"https://link.dice.fm/s504b36001a1?dice_id=s504b36001a1\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ry9l5y-trio-explorations-29th-may-sjq-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780077600,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:26\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=0%2C0%2C2400%2C2400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=0%2C880%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=320%2C0%2C1760%2C3200\"},\"id\":\"699352e2863db300015eb575\",\"name\":\"Trio Explorations\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"TRIO EXPLORATIONS\\n\\nThree leading voices from London’s forward-looking jazz community—Sheldon Agwu (Electric Guitar), Max Luthert (Upright Bass & Modular Synth), and Yusuf Ahmed (Drums & Percussion)—come together to form a trio that thrives on curiosity, groove, and sonic adventure.\\n\\nTheir music moves fluidly between lush harmony, textural experimentation, and rhythmic intensity, creating a sound that feels both expansive and immediate.\\n\\nGuitarist Sheldon Agwu blends Jazz Guitar with ambient layers and electronic colours, shaping a distinctive musical identity reflected in his projects Kintsugi, Vtet Live at Mu, and Seeds of Sanctum.\\n\\nBassist and modular architect Max Luthert, known for collaborations with Nubya Garcia, Zara McFarlane, and Moses Boyd, brings a deeply grounded yet exploratory presence that anchors—and often propels—the trio’s improvisational pathways.\\n\\nDrummer & Percussionist Yusuf Ahmed (Qwalia, Unknown to Known) channels Jazz, Afro-funk, and global rhythmic traditions into a dynamic voice that balances drive, nuance, and invention.\\n\\nTogether, the trio offers a night of immersive interplay, atmospheric soundscapes, and bold improvisation—music that lives at the crossroads of Jazz, Electronics, and boundary-pushing rhythm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-05-29T18:30:00+01:00\",\"sale_start_date\":\"2026-02-16T00:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:00:00+01:00\",\"event_end_date\":\"2026-05-30T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Julie’s Haircut\",\"image\":null,\"artist_id\":\"26690\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DHP FAMILY.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72773,\"title\":\"Accessibility\",\"body\":\"The Grace has 12 steps into the venue, with no disabled toilet. There is no accessible area inside the venue. Companion ticket for someone to assist them up the stairs and to the toilet & early access available.\\n\\nDirect contact: accessibility@thegarage.london\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name