e_id=d79ba0eb0a69\",\"post_competition_referral\":\"https://link.dice.fm/fe2be6556ece?dice_id=fe2be6556ece\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p5149cac527a?dice_id=p5149cac527a\",\"post_purchase_referral\":\"https://link.dice.fm/hf7c7b3a54be?dice_id=hf7c7b3a54be\",\"post_reminder_referral\":\"https://link.dice.fm/G3daa1da5894?dice_id=G3daa1da5894\",\"post_waitinglist_referral\":\"https://link.dice.fm/xfb06117b8b3?dice_id=xfb06117b8b3\"},\"perm_name\":\"averk7-dusky-extended-set-28th-mar-colour-factory-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/01bac0a8-fa28-41db-903d-77ed83ccd3a0.jpg?rect=0%2C234%2C938%2C938\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/01bac0a8-fa28-41db-903d-77ed83ccd3a0.jpg?rect=0%2C422%2C938%2C563\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/01bac0a8-fa28-41db-903d-77ed83ccd3a0.jpg?rect=83%2C0%2C773%2C1406\"},\"properties\":[],\"about\":{\"description\":\"London duo Dusky return to London this March, at Colour Factory for an extended set. Active since 2011 and known for releases on labels including Aus Music, Anjunadeep and their own 17 Steps imprint, the pair have become a mainstay of UK club and festival lineups.\\n\\nThe night takes place in Colour Factory’s main room, a warehouse-style space known for its high-quality sound system and forward-thinking electronic programming.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6941b13c079592000156a969\",\"name\":\"Dusky (Extended Set)\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Careless\",\"redirect_url\":\"https://open.spotify.com/track/7iHIbOhn3N0AZF5Tky6DhM\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/962a8d20db1e84d371f971a88a1e131796bd974f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Careless\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dusky\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb402812dd69e787f5fc7b8129\"},\"artist_id\":\"622\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sat 28 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-03-29T14:00:00+01:00\",\"sale_start_date\":\"2025-12-10T13:00:00+00:00\",\"event_start_date\":\"2026-03-29T13:00:00+01:00\",\"event_end_date\":\"2026-03-29T16:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":null,\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Grow, Hackney.\",\"seating\":null,\"announcement_date_unix\":1732665600,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-29T13:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:14\",\"date_unix\":1774785600,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/te08bcde555c?dice_id=te08bcde555c\",\"post_competition_referral\":\"https://link.dice.fm/Ya292a3d540d?dice_id=Ya292a3d540d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S18c74b40a2d?dice_id=S18c74b40a2d\",\"post_purchase_referral\":\"https://link.dice.fm/d5538c8e5c75?dice_id=d5538c8e5c75\",\"post_reminder_referral\":\"https://link.dice.fm/j73dc305b208?dice_id=j73dc305b208\",\"post_waitinglist_referral\":\"https://link.dice.fm/r6f0d9ffd0f3?dice_id=r6f0d9ffd0f3\"},\"perm_name\":\"2w73wp-canalside-sessions-free-every-sunday-29th-mar-grow-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-07-03/9bdead43-edcb-4c96-94ed-acf3481c6ed9.jpg?rect=0%2C432%2C1728%2C1728\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-07-03/9bdead43-edcb-4c96-94ed-acf3481c6ed9.jpg?rect=0%2C778%2C1728%2C1037\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-07-03/9bdead43-edcb-4c96-94ed-acf3481c6ed9.jpg?rect=151%2C0%2C1426%2C2592\"},\"properties\":[],\"about\":{\"description\":\"Experience live global music with master conga player Williams Cumberbache and special guests on Grow’s canalside terrace in Hackney Wick. Set against the River Lea, enjoy world-class performances from the pontoon stage as boats drift by.\\n\\nRelax in our hidden garden, surrounded by greenery, and enjoy homemade dishes from the Brunch or All Day menu. Ease into the weekend with a spritz in hand and sun on your face. Our new Spritz Happy Hour is the perfect way to toast your brunch plans – two for £15, or go alcohol-free with two Crodinos for £10.\\n\\nWith over 30 years in the UK music scene, including collaborations with Goldie and Björk, Williams curates each session with a vibrant mix of jazz fusion, Latin, Brazilian, and African rhythms. Expect solo sets or surprise guest artists.\\n\\nWhether you're a jazz head, a brunch lover, or just after feel-good energy, these sessions offer high-quality music, warm vibes, and a family-friendly space that welcomes dancing.\\n\\nPractical Info\\n\\n- Venue: Grow is a converted warehouse with canalside and indoor seating.\\n- Booking: Tables for up to 8 via OpenTable. Larger groups via enquiry form. Walk-ins welcome.\\n- Weather: Performances are outdoors but may move inside during extreme conditions.\\n- Time: Performances run between 1–4 PM; artists and set times may vary.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69398b7dc323900001999d1c\",\"name\":\"Canalside Sessions // Free // Every Sunday\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T00:00:00+00:00\",\"sale_end_date\":\"2026-03-29T13:00:00+01:00\",\"sale_start_date\":\"2026-02-13T00:00:00+00:00\",\"event_start_date\":\"2026-03-29T14:00:00+01:00\",\"event_end_date\":\"2026-03-29T15:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"seating\":null,\"announcement_date_unix\":1770940800,\"venues\":[{\"id\":\"3612\",\"name\":\"Toulouse Lautrec\",\"address\":\"140 Newington Butts, Prince's, London SE11 4RN, UK\",\"location\":{\"lat\":51.4911278,\"lng\":-0.1033709},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"toulouse-lautrec-qmma\",\"accessibility\":{\"url\":\"https://www.toulouselautrec.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-29T13:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:15\",\"date_unix\":1774789200,\"price\":{\"currency\":\"GBP\",\"amount\":3550,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Z7c2abdaff4a?dice_id=Z7c2abdaff4a\",\"post_competition_referral\":\"https://link.dice.fm/tae244de9824?dice_id=tae244de9824\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J43ffa3b0cc5?dice_id=J43ffa3b0cc5\",\"post_purchase_referral\":\"https://link.dice.fm/uc8e03df3c89?dice_id=uc8e03df3c89\",\"post_reminder_referral\":\"https://link.dice.fm/ve845bcfe607?dice_id=ve845bcfe607\",\"post_waitinglist_referral\":\"https://link.dice.fm/v9fdf7997b45?dice_id=v9fdf7997b45\"},\"perm_name\":\"g5my82-buena-vista-social-club-live-revue-29th-mar-toulouse-lautrec-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=140%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=0%2C76%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=320%2C0%2C440%2C800\"},\"properties\":[],\"about\":{\"description\":\"A Journey Through the Golden Age of Cuban Music.\\n\\nStep into the vibrant world of Havana with the Buena Vista Social Club Live Revue, a dazzling celebration of Cuba’s most iconic musical heritage. This unforgettable tribute brings the timeless sounds of son, bolero, danzón, and cha-cha-cha to life, performed by some of the UK’s finest Cuban musicians.\\n\\nInspired by the legendary 1997 Grammy-winning album produced by Ry Cooder and Juan de Marcos González, this live revue pays homage to the spirit and soul of the original Buena Vista ensemble, a project that united the greatest living masters of pre-revolutionary Cuban music.\\n\\nExpect infectious rhythms, soulful trumpet solos, intricate guitar work, and vocals steeped in love, nostalgia, and joy. It’s a night that will transport you straight to Havana’s smoky clubs and sun-drenched plazas, and you may just find yourself dancing before the night is through.\\n\\nBand Line-Up\\n\\nLuke Rattenbury – tres, guitar, vocals\\n\\nEddie Myer – bass, vocals\\n\\nAdriana Lord – lead vocals\\n\\nMickey Ball – trumpet\\n\\nSatin Singh – congas\\n\\nVancho Manoilovich – timbales, drums\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698f0e155f830a0001104520\",\"name\":\"Buena Vista Social Club Live Revue\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Buena Vista Social Club - Chan Chan\",\"redirect_url\":\"https://open.spotify.com/track/3bxZhauuIU4ubctdRZwPYW\",\"artist\":\"Buena Vista Social Club\",\"preview_url\":\"https://p.scdn.co/mp3-preview/74dc6eb8f978e16ef80b0c17df14d13c353a733d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Chan Chan\"},{\"type\":\"apple_music\",\"title\":\"Buena Vista Social Club - Chan Chan\",\"redirect_url\":\"https://music.apple.com/us/album/chan-chan/1716598034?i=1716598344&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Buena Vista Social Club\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/9f/b3/bb/9fb3bb95-dce9-bd65-7d91-4e9c4322dbc0/mzaf_17702336458070202791.plus.aac.p.m4a\",\"track_name\":\"Chan Chan\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Buena Vista Social Club\",\"image\":null,\"artist_id\":\"73269\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":20,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T16:00:00+00:00\",\"sale_end_date\":\"2026-03-29T16:30:00+01:00\",\"sale_start_date\":\"2025-11-13T16:00:00+00:00\",\"event_start_date\":\"2026-03-29T16:30:00+01:00\",\"event_end_date\":\"2026-03-29T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"seating\":null,\"announcement_date_unix\":1763049600,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-29T16:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:16\",\"date_unix\":1774798200,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":7469},\"social_links\":{\"event_share\":\"https://link.dice.fm/T89832b3ecb3?dice_id=T89832b3ecb3\",\"post_competition_referral\":\"https://link.dice.fm/M898c92bbcfb?dice_id=M898c92bbcfb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e4dc3e97990f?dice_id=e4dc3e97990f\",\"post_purchase_referral\":\"https://link.dice.fm/y867aa72b3f4?dice_id=y867aa72b3f4\",\"post_reminder_referral\":\"https://link.dice.fm/Zaa1ca226107?dice_id=Zaa1ca226107\",\"post_waitinglist_referral\":\"https://link.dice.fm/X65cf714f02b?dice_id=X65cf714f02b\"},\"perm_name\":\"2wenx7-december-avenue-29th-mar-the-clapham-grand-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-13/abc9d0bc-3255-4613-a9ca-601b13ac5e3d.jpg?rect=0%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-13/abc9d0bc-3255-4613-a9ca-601b13ac5e3d.jpg?rect=0%2C675%2C3375%2C2025\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-13/abc9d0bc-3255-4613-a9ca-601b13ac5e3d.jpg?rect=760%2C0%2C1856%2C3375\"},\"properties\":[],\"about\":{\"description\":\"**SUNDAY 29TH MARCH / VIP M&G DOORS OPEN 4:30PM / GENERAL ADMISSION DOORS OPEN 6:00PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\n**This is a 16+ event. Under 18s must be accompanied by an adult (max. 2 under 18s per adult 21+)**\\n\\nDecember Avenue Live in London\\n\\nExperience the Philippines' beloved OPM band as they return to the UK for one unforgettable night at The Clapham Grand!\\n\\nFresh off their sold-out 2024 tour, December Avenue is back with their signature heartfelt anthems and electrifying stage presence.\\n\\nPresented by KMF Events Ltd\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 16+ event. Under 18s must be accompanied by an adult over 21+ (max. 2 under per adult 21+)\",\"highlights\":[]},\"id