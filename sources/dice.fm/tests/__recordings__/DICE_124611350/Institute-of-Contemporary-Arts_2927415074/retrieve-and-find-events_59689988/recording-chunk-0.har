n\\n**XASTHUR**  \\n*https://www.instagram.com/xasthur_official1/*\\n\\n*plus guests...*\\n\\nLUKAS HÄGER\\n\\nFIELDS OF AGONY\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"date_unix\":1772564400,\"event_tag\":null},{\"tty_to_extras\":[{\"ticket_type_id\":1148164,\"extra_ids\":[\"1154174\"]},{\"ticket_type_id\":1148165,\"extra_ids\":[\"1154174\"]},{\"ticket_type_id\":1148166,\"extra_ids\":[\"1154174\"]},{\"ticket_type_id\":1148167,\"extra_ids\":[\"1154174\"]},{\"ticket_type_id\":1168932,\"extra_ids\":[\"1154174\"]},{\"ticket_type_id\":1194361,\"extra_ids\":[\"1154174\"]}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2106},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T10:00:00+00:00\",\"sale_end_date\":\"2026-02-20T06:00:00+00:00\",\"sale_start_date\":\"2026-01-15T10:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:00:00+00:00\",\"event_end_date\":\"2026-03-03T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6dw8nq-leigh-anne-liveqa-signing-3rd-mar-rough-trade-east-london-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Nai Barghouti, Leigh-Anne, Neneh Cherry & Together For Palestine - Lullaby (feat. Amena, Bastille, Brian Eno, Celeste, Kieran Brunt, Lana Lubany, London Community Gospel Choir, Mabel, Nadine Shah, Sura Abdo, TYSON, Yasmeen Ayyashi & Ysee)\",\"redirect_url\":\"https://music.apple.com/us/album/lullaby-feat-amena-bastille-brian-eno-celeste-kieran/1854941328?i=1854941336&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nai Barghouti, Leigh-Anne, Neneh Cherry & Together For Palestine\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/87/c4/5f/87c45ff5-43e7-71b0-c90b-ed18353234a4/mzaf_5356182313978724855.plus.aac.p.m4a\",\"track_name\":\"Lullaby (feat. Amena, Bastille, Brian Eno, Celeste, Kieran Brunt, Lana Lubany, London Community Gospel Choir, Mabel, Nadine Shah, Sura Abdo, TYSON, Yasmeen Ayyashi & Ysee)\"}],\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1NDE3NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM3MjAwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODoxMC41NjExMjhaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzE0MCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1NDE3NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM3MjAwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODoxMC41NjExNjFaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzE0MSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6OTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":900,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1NDE3NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM3MjAwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODoxMC41NjExNzZaIiwicHJpY2UiOjkwMCwidmFyaWFudF9pZCI6MzE0MiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTIwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1NDE3NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM3MjAwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODoxMC41NjExODlaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjMxNDMsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":36022,\"title\":\"Is Rough Trade Nottingham wheelchair accessible?\",\"body\":\"Rough Trade Nottingham's venue is on the first floor. We are lift accessible if you want an alternative. Just speak to a member of Rough Trade staff or security upon arrival, we will show and help you access the space.\",\"order\":0},{\"id\":36023,\"title\":\"Can I arrange accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seatsn available for sold out events.\",\"order\":1},{\"id\":36032,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":2},{\"id\":36024,\"title\":\"How do I get a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":3},{\"id\":36025,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release. There is an hour between the door time and the stage time.\",\"order\":4},{\"id\":36026,\"title\":\"I can’t attend the show! Can I still get my record signed?\",\"body\":\"Yes! We will always aim to get all event orders signed. Although this sometimes depends on the artist's schedule. We keep event stock for 1 week before returning it to our warehouse. If you can’t pick it up within a week please contact the store of your event.\",\"order\":5},{\"id\":36027,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":6},{\"id\":36028,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":7},{\"id\":36029,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":8},{\"id\":36030,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":9},{\"id\":36031,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":10},{\"id\":64727,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":11},{\"id\":64728,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":12},{\"id\":64729,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":13},{\"id\":64730,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":14},{\"id\":64731,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":15},{\"id\":64732,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":16},{\"id\":64733,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":17},{\"id\":64734,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":18},{\"id\":64735,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":19},{\"id\":64736,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":20}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Leigh-Anne Pinnock\",\"image\":null,\"artist_id\":\"103649\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":true,\"max_tickets\":6,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-03T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attac