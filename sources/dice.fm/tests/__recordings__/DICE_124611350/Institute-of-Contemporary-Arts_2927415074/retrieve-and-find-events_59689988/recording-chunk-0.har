pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773424800,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:2\",\"tty_to_extras\":[],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"id\":\"68d674a97deda200014c440f\",\"name\":\"Altin Gün\",\"perm_name\":\"q2avwp-altin-gn-13th-mar-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/059c365b-9253-431f-b9f6-945185b9f85e.jpg?rect=0%2C328%2C4128%2C4128\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/059c365b-9253-431f-b9f6-945185b9f85e.jpg?rect=0%2C1858%2C4128%2C2477\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/059c365b-9253-431f-b9f6-945185b9f85e.jpg?rect=361%2C0%2C3406%2C6192\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Altin Gün\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-05-14/fd41125f-cf38-4711-996e-67d8dce3d0da.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"11893\",\"about\":{\"description\":\"A unique combination of Turkish folk and psychedelia underpinned by cheery pop hooks, Dutch band Altın Gün bring something different to the table. Recruiting members via Facebook, bassist Jasper Verhulst set out to reinvigorate the ’70s Antolian rock he first heard while performing in Istanbul, with themes of love, death and traditional folktales at the forefront. A Grammy nomination for 2018’s Gece hasn’t ripped the band from their humble roots, as you can still find them mingling with their fans at shows before jumping on stage.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1759312800,\"faqs\":[{\"id\":47389,\"title\":\"Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":4054,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Goca Dünya\",\"redirect_url\":\"https://open.spotify.com/track/5QO3UJc1gF1ummP75n2b3R\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f7ef4521b03d5052f4783e7a07cb91e0c151096d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Goca Dünya\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-22T10:00:00+01:00\",\"sale_end_date\":\"2026-03-13T21:00:00+00:00\",\"sale_start_date\":\"2025-08-28T10:00:00+01:00\",\"event_start_date\":\"2026-03-13T18:30:00+00:00\",\"event_end_date\":\"2026-03-13T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":true,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Y9d888eefb79?dice_id=Y9d888eefb79\",\"post_competition_referral\":\"https://link.dice.fm/vbe442fd975d?dice_id=vbe442fd975d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D22de717a2ce?dice_id=D22de717a2ce\",\"post_purchase_referral\":\"https://link.dice.fm/H270be95e50d?dice_id=H270be95e50d\",\"post_reminder_referral\":\"https://link.dice.fm/u3c6bba3d8cf?dice_id=u3c6bba3d8cf\",\"post_waitinglist_referral\":\"https://link.dice.fm/yd744f4c15b6?dice_id=yd744f4c15b6\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773426600,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-03-13T18:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":true,\"max_tickets\":6,\"donation\":{\"description\":\"Love Ally Pally? Add a donation to care for the Palace and Park. Your gift helps to protect and restore this special place — for everyone, forever.\\n\\nA percentage of your donation goes towards a payment processing fee (neither DICE or the charity keep any of this fee). For a £10 donation, the charity gets £9.75\",\"image\":{\