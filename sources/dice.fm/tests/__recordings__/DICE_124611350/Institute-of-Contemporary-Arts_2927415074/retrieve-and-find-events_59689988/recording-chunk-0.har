fund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"properties\":[],\"date_unix\":1778954400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-16T19:00:00+01:00\",\"doors_close_date\":\"2026-05-16T23:00:00+01:00\"}],\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/Jfdee98a8cf9?dice_id=Jfdee98a8cf9\",\"post_competition_referral\":\"https://link.dice.fm/sadac7dbfc04?dice_id=sadac7dbfc04\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/qf95d7d04127?dice_id=qf95d7d04127\",\"post_purchase_referral\":\"https://link.dice.fm/fce0d777f659?dice_id=fce0d777f659\",\"post_reminder_referral\":\"https://link.dice.fm/S369c9c9f05b?dice_id=S369c9c9f05b\",\"post_waitinglist_referral\":\"https://link.dice.fm/d2829e74e889?dice_id=d2829e74e889\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":\"122b922c-4eb8-444d-8425-15eab96b116c\",\"max_tickets\":8,\"presented_by\":\"Presented by Communion ONE.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:37\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T10:00:00+01:00\",\"sale_end_date\":\"2026-05-16T22:00:00+01:00\",\"sale_start_date\":\"2025-10-29T10:00:00+00:00\",\"event_start_date\":\"2026-05-16T19:00:00+01:00\",\"event_end_date\":\"2026-05-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1761296400,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4228},\"id\":\"68f777a12e22b00001acf47a\",\"name\":\"Nick Mulvey\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nick Mulvey\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-09-12/9ced3f6e-73fd-45be-8113-a2253c4196cc.jpg?rect=0%2C559%2C3160%2C3160\"},\"artist_id\":\"5171\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"new\":false,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"122b922c-4eb8-444d-8425-15eab96b116c\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"perm_name\":\"bbnpov-nick-mulvey-16th-may-troxy-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-23/1a79d760-ed07-4951-9ff5-6c5ba9e520e4.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-23/1a79d760-ed07-4951-9ff5-6c5ba9e520e4.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-23/1a79d760-ed07-4951-9ff5-6c5ba9e520e4.jpg?rect=270%2C0%2C660%2C1200\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"**VENUE PRESALE: WEDS 29TH OCTOBER @ 10AM**\\n\\n**GENERAL SALE: FRI 31ST OCTOBER @ 10AM**\\n\\nMusician, composer and producer, Nick Mulvey’s work pushes boundaries in songwriting and sound, in music both traditional and experimental, acoustic and electronic. With a unique path to success, Nick spent his early days studying Ethnomusicology in London, before becoming a founding member of the award-winning collective Portico Quartet. He left in 2011 to concentrate on his own material, and once solo, released the Mercury Prize shortlisted debut album First Mind in 2014. 2017’s celebrated Wake Up Now came next, along with a number of EPs. Mulvey’s latest offering was 2022’s New Mythology, recorded during the Covid 19 pandemic whilst in Paris. He now returns, refreshed and rejuvenated by the challenges and successes of his life over the last three years, with Dark Harvest (Pt. 1) and Dark Harvest (Pt.2).\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_