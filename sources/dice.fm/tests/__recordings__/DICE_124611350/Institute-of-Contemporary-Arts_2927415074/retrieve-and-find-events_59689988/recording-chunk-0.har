_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"announcement_date_unix\":1757592000,\"social_links\":{\"event_share\":\"https://link.dice.fm/G9d36fe33195?dice_id=G9d36fe33195\",\"post_competition_referral\":\"https://link.dice.fm/G82c9a12770e?dice_id=G82c9a12770e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/gbc5ef682ade?dice_id=gbc5ef682ade\",\"post_purchase_referral\":\"https://link.dice.fm/k731967f1b2e?dice_id=k731967f1b2e\",\"post_reminder_referral\":\"https://link.dice.fm/c8bbd978de1f?dice_id=c8bbd978de1f\",\"post_waitinglist_referral\":\"https://link.dice.fm/g3a0d8ef24fc?dice_id=g3a0d8ef24fc\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"py5edl-the-nujabes-experience-20th-apr-the-jazz-cafe-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776708000,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:60\",\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-11/9df7eaf8-5e33-4609-a523-58ee33e7e4d6.jpg?rect=256%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-11/9df7eaf8-5e33-4609-a523-58ee33e7e4d6.jpg?rect=0%2C0%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-11/9df7eaf8-5e33-4609-a523-58ee33e7e4d6.jpg?rect=429%2C0%2C422%2C768\"},\"id\":\"696123ccee008300016869f3\",\"name\":\"The Nujabes Experience\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Nujabes remains one of the most beloved and influential beatmakers of all time, known for his lush, atmospheric soundscapes that transcend hip-hop, nu-jazz, breakbeat, and trip-hop.**\\n\\nThis special evening, held the day after his birthday, brings his most iconic tracks to life, including favourites from Modal Soul, Metaphorical Music, and the legendary Samurai Champloo soundtrack.\\n\\nPerforming live, London’s Stompy’s Playground recreates these timeless compositions with precision, soul, and reverence, delivering a night that celebrates Nujabes’ enduring legacy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-11T13:00:00+01:00\",\"sale_end_date\":\"2026-04-20T19:00:00+01:00\",\"sale_start_date\":\"2025-09-11T13:00:00+01:00\",\"event_start_date\":\"2026-04-20T19:00:00+01:00\",\"event_end_date\":\"2026-04-20T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cole Pulice\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-04-17/b4d02a8a-3ca2-49ca-86e6-cdc04fc32bbb.jpg?rect=0%2C48%2C457%2C457\"},\"artist_id\":\"66854\",\"about\":{\"description\":\"Oakland-based artist Cole Pulice’s 2022 record, Scry, is named after the act of a fortune teller predicting the future. Crystal balls are an apt visual for the album, which they describe as exploring “worlds hidden within worlds, and dreams within dreams.” Their organic-sounding synth patterns and saxophone melodies give off the warmth of sunbeams, inspired by the influential electroacoustic works of Pauline Oliveros, Harold Budd and Marion Brown.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"The Last Whole Earth Catalog\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-14/6f18301f-eb33-4118-b658-7ffd45a8eed1.jpg?rect=0%2C10%2C621%2C621\"},\"artist_id\":\"29127\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by REAL\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1565\",\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church St, Stoke Newington, London N16 9ES, UK\",\"location\":{\"lat\":51.5613778,\"lng\":-0.0847131000000445},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-church-stoke-newington-x9am\",\"accessibility\":{\"url\":\"https://www.theoldchurch.org.uk/access\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-20T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"announcement_date_unix\":1765101600,\"social_links\":{\"event_share\":\"https://link.dice.fm/kba359d76f6c?dice_id=kba359d76f6c\",\"post_competition_referral\":\"https://link.dice.fm/Gdc4fc175cf7?dice_id=Gdc4fc175cf7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Sa6e2c99d99f?dice_id=Sa6e2c99d99f\",\"post_purchase_referral\":\"https://link.dice.fm/T3830bedc52f?dice_id=T3830bedc52f\",\"post_reminder_referral\":\"https://link.dice.fm/K2aae97c7c42?dice_id=K2aae97c7c42\",\"post_waitinglist_referral\":\"https://link.dice.fm/me5868c2d480?dice_id=me5868c2d480\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ww5xmg-cole-pulice-20th-apr-the-old-church-stoke-newington-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776708000,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:61\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1800},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/412a88d0-026c-47fd-bc27-e00d2511c43b.jpg?rect=0%2C2828%2C6203%2C6203\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/412a88d0-026c-47fd-bc27-e00d2511c43b.jpg?rect=0%2C2655%2C6203%2C3722\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/412a88d0-026c-47fd-bc27-e00d2511c43b.jpg?rect=618%2C0%2C4967%2C9031\"},\"id\":\"6926e51afc8e7a0001ec5244\",\"name\":\"Cole Pulice\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"***Cole Pulice -*** Saxophonist, composer and improviser Cole Pulice traffics in shimmering, otherworldly beauty. On Land’s End Eternal, their first album for Leaving Records (releasing May 9th), the Oakland-based artist expands their compositional palette beyond signal-processed saxophone to include layers of electric guitar and lush choral arrangements.\\n\\n**The Last Whole Earth Catalog** - Daniel HCW Parr of The Last Whole Earth Catalog is an award winning experimental chef and all round maverick. After being awarded his first Michelin star aged 7 he took a break from cheffing and obtained his Airline Transport Pilot License allowing him to fly commercial aircraft, which he did for British Airways for several years. During this time he also won the FAI Aerobatics Championship 5 years in a row before hanging his captain's hat on his Edwardian style mahogany coat stand. Greg Macintosh said “He left as big a legacy as anyone since Crick & Watson” when asked to clarify he confirmed he meant the Wright Brothers & not the scientists who discovered DNA.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18s must be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-07T10:00:00+00:00\",\"sale_end_date\":\"2026-04-20T23:00:00+01:00\",\"sale_start_date\":\"2025-12-08T11:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:00:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Cole Pulice - Arc of Shadows\",\"redirect_url\":\"https://music.apple.com/us/album/arc-of-shadows/1500843415?i=1500843424&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Cole Pulice\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/31/03/c4/3103c402-f79c-c5f8-60fb-d36d449aeda6/mzaf_821902084459833740.plus.aac.p.m4a\",\"track_name\":\"Arc of Shadows\"},{\"type\":\"spotify\",\"title\":\"Cole Pulice - Arc of Shadows\",\"redirect_url\":\"https://open.spotify.com/track/6it2RjbdjdIde5oltxUpcB\",\"artist\":\"Cole Pulice\",\"preview_url\":\"https://p.scdn.co/mp3-preview/63e48b742425c033e07f26635fb246abe70c035e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Arc of Shadows\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sekou\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-14/0504a6fd-2a89-4014-8a07-8b74a515d4fa.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"48617\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzNjI5MCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTI5ODA0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTQ4OTBaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzAzMCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzNjI5MCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTI5ODA0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Njo