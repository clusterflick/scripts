3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"l8bxor-d3lta-28th-feb-strongroom-bar-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772305200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:78\",\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"D3LTA\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf58c3da2f74bc2dd9af6bfe4\"},\"artist_id\":\"50238\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"D3LTA is an Anglo-Greek artist who first broke onto the scene with his hit single Strange, a chart-topping success in Greece. Now based in the UK, he’s forging a bold artistic identity through electrifying rock-pop anthems powered by unique sonic energy and deeply relatable lyrics. Often compared to artists such as David Bowie, Declan McKenna, and Sam Fender, D3LTA’s sound blends introspective emotion with arena-ready impact.\\n\\nA steadily rising presence in the modern alt-pop landscape, D3LTA has collaborated with acclaimed producers including Jim Abbiss (Arctic Monkeys, Adele), Max Wolfgang (Ashnikko, BLACKPINK), and Neil Ormandy (James Arthur). His growing reputation has been cemented through major live moments, including a UK tour with Scouting for Girls, a standout performance at SXSW, and a recent nationwide UK tour supporting Lucy Spraggan.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T17:00:00+00:00\",\"sale_end_date\":\"2026-02-28T17:00:00+00:00\",\"sale_start_date\":\"2026-01-27T17:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6977889df4fd360001cad094\",\"name\":\"D3LTA\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/03acd21a-93f8-4d06-b2d5-62c682acda7c.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/03acd21a-93f8-4d06-b2d5-62c682acda7c.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/03acd21a-93f8-4d06-b2d5-62c682acda7c.jpg?rect=169%2C0%2C743%2C1350\"},\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.com/privacy-policy/\",\"fb_pixel_id\":\"570786809997969\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_op