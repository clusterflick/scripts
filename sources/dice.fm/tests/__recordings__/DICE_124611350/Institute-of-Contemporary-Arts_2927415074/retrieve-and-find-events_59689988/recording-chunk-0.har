l,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772042400,\"has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:16\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/42dfd8a5-2aaf-44bf-89d1-81e1a04f3846.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/42dfd8a5-2aaf-44bf-89d1-81e1a04f3846.jpg?rect=0%2C550%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/42dfd8a5-2aaf-44bf-89d1-81e1a04f3846.jpg?rect=200%2C0%2C1100%2C2000\"},\"id\":\"6942871bcbeb8d0001e56f6e\",\"name\":\"PATTERNS Weekly Live Jazz\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Every Wednesday, Patterns brings together some of London's finest musicians for an evening of improvised music. From Jazz to Soul, Broken-Beat to Hip Hop and beyond, our weekly jazz sessions offer a space for collaboration between musicians of all styles and flavours.\\n\\nStriving to always be inclusive and showcase the best of emerging talent; egos are always left at the door to create an intimate experience for the listeners and performers alike.\\n\\nLive music starts at 8pm. Playlist before.\\n\\nP A T T E R N S\\n\\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**ONLINE TICKETS**\\n\\n- Different ticket types are available.\\n- Please check the information on your ticket before making a purchase.\\n\\n**TABLE BOOKINGS**\\n\\n- Guarantee yourself a table by booking a table via our website ➡ www.ntloft.co.uk\\n- There are 2 sessions available:\\n\\n\\\\- Early Session = 6pm - 9pm\\n\\n\\\\- Late Session = 9:15pm - 11pm\\n\\n- If you have a table for the early session, you may be asked to leave your table for the start of the late session. You are welcome to stay and stand in the venue. Other seating will be arranged if available.\\n\\n**WALK-INS**\\n\\n- Entry is FREE before 7:30pm.\\n- Entry after 7:30pm is £5.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2023-03-15T17:00:00+00:00\",\"sale_end_date\":\"2026-02-25T22:30:00+00:00\",\"sale_start_date\":\"2023-03-15T17:00:00+00:00\",\"event_start_date\":\"2026-02-25T18:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Panam\",\"image\":null,\"artist_id\":\"132660\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ellur\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-15/4c6ec67c-ccf1-4873-a317-739b17c6560f.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"85517\",\"about\":null,\"is_headliner\":true},{\"name\":\"Becky Sikasa\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-08/774e7f20-61dd-42db-a51e-2e5052c6e354.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"83920\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by ILMC  + Kilimanjaro.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"5523\",\"name\":\"The Blue Basement\",\"address\":\"1 Marshall St, Carnaby, London W1F 9BA, UK\",