y\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yona3a-lande-hekt-19th-apr-moth-club-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"MOTH Club\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"2195325970769692\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776621600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:53\",\"price\":{\"currency\":\"GBP\",\"amount\":1531,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-09/55eeef68-c106-4537-8296-ed413f0ee88c.jpg?rect=468%2C0%2C3744%2C3744\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-09/55eeef68-c106-4537-8296-ed413f0ee88c.jpg?rect=0%2C468%2C4680%2C2808\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-09/55eeef68-c106-4537-8296-ed413f0ee88c.jpg?rect=1311%2C0%2C2059%2C3744\"},\"id\":\"6939c955c323900001432850\",\"name\":\"Lande Hekt\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Lande Hekt\\n\\n\\\\+ support from The Popguns and Mumble Tide\\n\\nLANDE HEKT has quietly become one of the UK’s best underground songwriters. On her 2021 debut full-length Going To Hell and 2022’s House Without a View, she explored her queer identity, sobriety, and childhood trauma through the lens of heartfelt, conversational indie-pop, which led to spots opening for the likes of Alvvays, Throwing Muses and The Beths. Her new album Lucky Now, written and recorded with producer Matthew Simms (Wire, It Hugs Back), reflects the most mature and confident version of Lande Hekt yet. “I’m not as concerned about how I’m presenting myself,” Hekt says. “I’ve tried to think less about how things are coming across, and just write songs that make me feel connected to myself and what I value.”\\n\\nHekt’s musical touchstones — The Wedding Present, The Sundays, The Replacements — remain the same, but at the same time she’s delved deeper into other influences. Lucky Now is indebted to 1980s twee-pop and jangle-pop like The Pastels, Tallulah Gosh and The Bats, plus more modern iterations of the sound such as Autocamper and Jeanines, in its ecstatic, soaring melodies and gorgeous, tactile guitars. The sound is fitting for Hekt’s new lyrical outlook, where, though despair and anxiety rear their heads, she digs deep to find the gratitude. During the process of making the album, Hekt also moved from Bristol back to her hometown of Exeter. In a lot of ways, Lucky Now is about return — return to joy, return to places and parts of the self once left behind. Who you once were can seem unreachable, but sometimes you can build a bridge.\\n\\nhttps://landehekt.bandcamp.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T10:00:00+00:00\",\"sale_end_date\":\"2026-04-19T18:00:00+01:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-04-19T19:00:00+01:00\",\"event_end_date\":\"2026-04-19T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"80 Days of Rain\",\"redirect_url\":\"https://open.spotify.com/track/2H5yBXvTDA6EpQ7OTOun1m\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bd4ffa3fab67a40fc4c5a4bc1a5d760639d70d0c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"80 Days of Rain\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"DJ Nate\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-13/ed444ac5-2827-4a56-837c-d83cf2122dc3.jpg?rect=0%2C65%2C510%2C510\"},\"artist_id\":\"24988\",\"about\":null,\"is_headliner\":false},{\"name\":\"DJ MAC\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-12/a91e1c03-6160-44e2-9147-88de2b36f122.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"133963\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Metropolis Music & Outdeh.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":75849,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide val