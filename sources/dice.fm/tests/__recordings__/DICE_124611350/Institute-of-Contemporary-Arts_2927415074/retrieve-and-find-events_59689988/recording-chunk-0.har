tunes.apple.com/itunes-assets/AudioPreview221/v4/06/82/a3/0682a321-a5ce-45fa-bfaa-bcb9ea028e17/mzaf_780385019884545010.plus.aac.p.m4a\",\"track_name\":\"My Endeavour\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1762851600,\"max_tickets\":6,\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1987,\"name\":\"SJM Concerts\",\"privacy_policy_link\":\"https://privacy.sjmconcerts.com/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Hailing from just outside Glastonbury and now based in Brighton, Ruby Roberts was always destined for a life in music. Her music expertly blends UK influences from David Bowie, to Kate Bush, to Lily Allen with the ambitious pop sounds of Lana Del Rey and Chappell Roan. Despite only just releasing her debut single ‘Trampoline’ in April, Ruby has already garnered significant attention both in the UK and US and has built an impressive fanbase already, only compounded by the early success of ‘Trampoline’.\\n\\nShe has been working on her debut EP which is due to be released later this year, and already Ruby is looking like cementing her place as the name on everyone’s lips for 2025. \\n  \\nWith support from Dear Lily.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Communion ONE & SJM\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:42\",\"social_links\":{\"event_share\":\"https://link.dice.fm/ie8f0ff41c4f?dice_id=ie8f0ff41c4f\",\"post_competition_referral\":\"https://link.dice.fm/W4e297f82b1a?dice_id=W4e297f82b1a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g41e87063935?dice_id=g41e87063935\",\"post_purchase_referral\":\"https://link.dice.fm/T646b5fab828?dice_id=T646b5fab828\",\"post_reminder_referral\":\"https://link.dice.fm/ydd5a1530c66?dice_id=ydd5a1530c66\",\"post_waitinglist_referral\":\"https://link.dice.fm/b47272515067?dice_id=b47272515067\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T09:00:00+00:00\",\"sale_end_date\":\"2026-02-18T19:00:00+00:00\",\"sale_start_date\":\"2025-11-14T09:00:00+00:00\",\"event_start_date\":\"2026-02-18T19:00:00+00:00\",\"event_end_date\":\"2026-02-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":1887,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"id\":\"6911bafcf7ec27000186198c\",\"seats_io_event_id\":null,\"name\":\"Ruby Roberts\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"92x38d-ruby-roberts-18th-feb-the-lower-third-london-tickets\",\"date_unix\":1771441200,