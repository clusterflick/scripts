attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q26m6y-luke-wallace-11th-mar-paper-dress-vintage-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773257400,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:42\",\"price\":{\"currency\":\"GBP\",\"amount\":1347,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/dc8c05a5-890f-4c7d-9a90-db71c68023e3.jpg?rect=0%2C1000%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/dc8c05a5-890f-4c7d-9a90-db71c68023e3.jpg?rect=0%2C1800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/dc8c05a5-890f-4c7d-9a90-db71c68023e3.jpg?rect=350%2C0%2C3300%2C6000\"},\"id\":\"6924be19d2a46400013a4a13\",\"name\":\"Luke Wallace\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Luke Wallace is a dynamic force in the world of folk music, using his talent as a songwriter, speaker, and choral arranger to champion environmental causes and inspire positive change. Hailing from the Coast Salish Territory known as Vancouver, Canada, Luke has been on a decade-long journey of touring, recording and organizing for the betterment of people and the planet.Luke's unique brand of politically charged folk has earned him a loyal following and a reputation as a modern-day Pete Seeger.\\n\\nFrom festivals to rallies to venues, Luke's music is a rallying cry for a movement of people rising up to meet the social and environmental challenges of our time. With his latest album, ‘The Dandelion Resistance’, Luke continues to push the boundaries of folk music and prove that art can be a powerful tool for change.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T17:00:00+00:00\",\"sale_end_date\":\"2026-03-11T19:00:00+00:00\",\"sale_start_date\":\"2025-12-04T17:00:00+00:00\",\"event_start_date\":\"2026-03-11T19:30:00+00:00\",\"event_end_date\":\"2026-03-11T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Waldo's Gift\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-25/2e9225e8-ee60-4f98-b3de-72e989cb77c1.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"13485\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rudi Creswick\",\"image\":null,\"artist_id\":\"64121\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by 100 Club.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"