777658400,\"price\":{\"currency\":\"GBP\",\"amount\":2188,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Pa988c3d1bc0?dice_id=Pa988c3d1bc0\",\"post_competition_referral\":\"https://link.dice.fm/S61fb4daa98b?dice_id=S61fb4daa98b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tce698b67c7d?dice_id=Tce698b67c7d\",\"post_purchase_referral\":\"https://link.dice.fm/y646d31b17c9?dice_id=y646d31b17c9\",\"post_reminder_referral\":\"https://link.dice.fm/Q5b34285d5c8?dice_id=Q5b34285d5c8\",\"post_waitinglist_referral\":\"https://link.dice.fm/Padf82fca10d?dice_id=Padf82fca10d\"},\"perm_name\":\"7dplrb--ni-maxine-mothers-arms-ep-live-1st-may-the-lower-third-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/3568d499-0c52-49a0-b48a-e26252931f73.jpg?rect=308%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/3568d499-0c52-49a0-b48a-e26252931f73.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/3568d499-0c52-49a0-b48a-e26252931f73.jpg?rect=663%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Award-winning Liverpool based ‘Neo-jazz star, Ni Maxine’ (NME) is one to watch. Her music moves between past and future, blending conscious lyricism, rich storytelling, and an unshakable sense of self as she detangles her transatlantic roots.\\n\\n'For Ni Maxine, the stage isn’t just about performance, it’s communion.' (Wordplay Magazine). Themes of home, identity, self-worth, and belonging weave through her work, creating something that feels both deeply personal and universally resonant.\\n\\nTaking home ‘Breakthrough Act of The Year' at The Jazz FM Awards 2025 marks the beginning of a significant chapter for Ni Maxine. She consistently pushes the boundaries of jazz, locking in support from tastemakers Jamz Supernova and Gilles Peterson across the BBC, Worldwide FM, Selector Radio and more.\\n\\nFrom We Out Here to The Jazz Cafe - wherever she plays, she pulls people in. With a string of sold-out shows and a nomination in the NOTION New Music Awards behind her, Ni Maxine isn’t just rising; she’s redefining what it means to belong in this moment of UK music.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6968232f7edcb500017e7542\",\"name\":\" Ni Maxine - 'Mother's Arms' EP Live\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ni Maxine - Time\",\"redirect_url\":\"https://open.spotify.com/track/0yjjvSxMMXQFy91K3pyCiu\",\"artist\":\"Ni Maxine\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8c0c698ea4c9d52ade70b17cbff78415f018ff04?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Time\"},{\"type\":\"apple_music\",\"title\":\"Ni Maxine - Time\",\"redirect_url\":\"https://music.apple.com/us/album/time/1834003741?i=1834003743&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ni Maxine\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/20/af/32/20af326b-30db-d443-b97c-90e9ab71c51a/mzaf_11308097058433510318.plus.aac.p.m4a\",\"track_name\":\"Time\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ni Maxine\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0d713b009287c4c186f4483d\"},\"artist_id\":\"65372\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T17:00:00+00:00\",\"sale_end_date\":\"2026-05-01T18:00:00+01:00\",\"sale_start_date\":\"2026-01-21T17:00:00+00:00\",\"event