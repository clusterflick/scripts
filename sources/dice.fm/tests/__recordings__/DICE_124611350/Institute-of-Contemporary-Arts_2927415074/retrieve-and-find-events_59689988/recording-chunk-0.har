4d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"iklectik-5wlk\",\"accessibility\":{\"url\":\"https://www.iklectik.org/about\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/822e993e-6fc7-4a97-848a-bdcfaa1f3c56.jpg?rect=779%2C0%2C3057%2C3057\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/822e993e-6fc7-4a97-848a-bdcfaa1f3c56.jpg?rect=0%2C144%2C4615%2C2769\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/822e993e-6fc7-4a97-848a-bdcfaa1f3c56.jpg?rect=1467%2C0%2C1681%2C3057\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770917400,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**IKLECTIK presents, an evening of expanded listening:**\\n\\n**PanOrama**\\n\\nBristol-based experimental artists and Oram laureates, Dali de Saint Paul, Lia Mazzari and Kathy Hinde present PanOrama, an improvised work blending voice, cello, electronics, field recordings, with materials from Daphne Oram’s archive.\\n\\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**Tomoko Hojo, Wan-Chien Cheng, Myriam Van Imschoot, Cara Tolmie, Anna Holveck**\\n\\nThis is not a concert of loud sounds, but of tuning in. Through fragile, slow, and unstable  \\nworks by women composers—text scores, graphic notation, voice, and quiet, tender  \\nlistening practices—it creates a space to notice what usually passes unheard, between  \\nsound, voice, and silence.\",\"highlights\":[{\"type\