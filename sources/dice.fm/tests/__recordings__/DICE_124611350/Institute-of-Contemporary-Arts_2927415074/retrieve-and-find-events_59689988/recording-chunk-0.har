ce_id=Ef41ce885ab4\",\"post_waitinglist_referral\":\"https://link.dice.fm/Je34eab29a09?dice_id=Je34eab29a09\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"2wky6o-algae-bloom-29th-may-new-cross-inn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780074000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:23\",\"price\":{\"currency\":\"GBP\",\"amount\":1430,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/04586a69-7dbb-4415-ac7b-dd72bb29f382.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/04586a69-7dbb-4415-ac7b-dd72bb29f382.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/04586a69-7dbb-4415-ac7b-dd72bb29f382.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69779a460f9ecb0001ecd02b\",\"name\":\"Algae Bloom\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Algae Bloom\\n\\nCelebrating 10 years of 'I am everyone I've ever met' with their last shows for the foreseeable future, we're very lucky to bring you a rare London appearance from some UK Screamo legends\\n\\nhttps://linktr.ee/algaebloom\\n\\nPlus a stellar supporting cast of...\\n\\nCold Holding\\n\\nSouthampton duo, reunited for the occasion\\n\\nhttps://coldholding.bandcamp.com/\\n\\nincaseyouleave\\n\\nTwinkling Screamo Stars, Suis La Lewisham\\n\\nhttps://linktr.ee/incaseyouleave\\n\\nI'm Sorry Emil\\n\\nLondon Screamo future classics\\n\\nhttps://imsorryemil.bandcamp.com/\\n\\nClosed Hands\\n\\nGet screamoshional. Members of Grey Market, Affray and Sewer Trench\\n\\nhttps://linktr.ee/closedhandsskramz\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T18:00:00+00:00\",\"sale_end_date\":\"2026-05-29T17:00:00+01:00\",\"sale_start_date\":\"2026-02-09T18:00:00+00:00\",\"event_start_date\":\"2026-05-29T18:00:00+01:00\",\"event_end_date\":\"2026-05-29T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Algae Bloom - \\\"Existential Crisis\\\" as a Wave Machine Setting\",\"redirect_url\":\"https://music.apple.com/us/album/existential-crisis-as-a-wave-machine-setting/1268345494?i=1268345681&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Algae Bloom\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/be/a8/fb/bea8fb22-1a94-f170-3ea6-6c4b50ca4b80/mzaf_6889241005646886811.plus.aac.p.m4a\",\"track_name\":\"\\\"Existential Crisis\\\" as a Wave Machine Setting\"},{\"type\":\"spotify\",\"title\":\"Algae Bloom - \\\"Existential Crisis\\\" as a Wave Machine Setting\",\"redirect_url\":\"https://open.spotify.com/track/4XHj8Ex7pluMigXIxYF9x1\",\"artist\":\"Algae Bloom\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1f33a58d93169e64d4f25e84e244bb114c9045f2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"\\\"Existential Crisis\\\" as a Wave Machine Setting\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Seedhe Maut\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebdbfd70ecee8d42dfd5fbb29d\"},\"artist_id\":\"119791\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Columbo Music.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":23929,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0},{\"id\":66150,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":1}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T18:00:00+01:00\",\"doors_close_d