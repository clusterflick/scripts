://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/a9/04/8d/a9048d13-c515-a8de-312f-3ed29220facf/mzaf_7211329860824740366.plus.aac.p.m4a\",\"track_name\":\"Change\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 11 Dec\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T10:00:00+00:00\",\"sale_end_date\":\"2026-12-12T17:00:00+00:00\",\"sale_start_date\":\"2025-12-04T10:00:00+00:00\",\"event_start_date\":\"2026-12-12T18:00:00+00:00\",\"event_end_date\":\"2026-12-12T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/yb9168c9985c?dice_id=yb9168c9985c\",\"post_competition_referral\":\"https://link.dice.fm/s0b8b531d27c?dice_id=s0b8b531d27c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r5487be1869b?dice_id=r5487be1869b\",\"post_purchase_referral\":\"https://link.dice.fm/G9c355e73512?dice_id=G9c355e73512\",\"post_reminder_referral\":\"https://link.dice.fm/af9f77540a85?dice_id=af9f77540a85\",\"post_waitinglist_referral\":\"https://link.dice.fm/e96e9cfee00a?dice_id=e96e9cfee00a\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"IRON MAIDEN ANNIVERSARY | BLAZE BAYLEY performing songs from THE X FACTOR, VIRTUAL XI and BEST OF THE BEAST\\n\\nBREAKING NEWS….. BLAZE IS BACK…..\\n\\nFor the very first time in 2026 BLAZE BAYLEY will be performing a massive UK Tour celebrating his time in IRON MAIDEN. Performing songs from Blaze’s era ‘The X Factor’, ‘Virtual XI’ & ‘Best of the Beast’ with some surprises in there too.\\n\\nBLAZE BAYLEY was the lead singer for IRON MAIDEN 1994-1999 and has maintained a good relationship with his previous Maiden band mates. This is a chance to see BLAZE BAYLEY perform all your favourite Maiden tracks ‘Man on the Edge’, ‘Futureal’, ‘Sign of the Cross’, ‘The Clansman’ & more including deep cuts, best of’s and b-sides. Blaze will be touring the length and breadth of the United Kingdom performing this amazing IRON MAIDEN setlist at a club near you.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1797098400,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-12-12T18:00:00+00:00\",\"doors_close_date\":\"2026-12-12T22:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:58\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"692f63d6d7ee02000173696d\",\"name\":\"BLAZE BAYLEY\",\"perm_name\":\"3onl7g-blaze-bayley-12th-dec-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/edc7c729-0d01-404d-b9b4-c86ef03f63fc.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/edc7c729-0d01-404d-b9b4-c86ef03f63fc.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/edc7c729-0d01-404d-b9b4-c86ef03f63fc.jpg?rect=563%2C0%2C1375%2C2500\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Blaze Bayley\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2731fb495d8daecc6c131ea2503\"},\"artist_id\":\"9088\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1764842400,\"faqs\":[{\"id\":61171,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":61172,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":61173,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Blaze Bayley - The Brave\",\"redirect_url\":\"https://open.spotify.com/track/5TxQvZetqcQ9alLMpx2K1P\",\"artist\":\"Blaze Bayley\",\"preview_url\":\"https://p.scdn.co/mp3-preview/16cb16233e9b2ad66fab43f6e24a226a2f125f47?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Brave\"},{\"type\":\"apple_music\",\"title\":\"Blaze Bayley - The Brave\",\"redirect_url\":\"https://music.apple.com/us/album/the-brave/600603125?i=600603260&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Blaze Bayley\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/98/bc/95/98bc958b-4619-4d46-5958-767ad80526ab/mzaf_18314551215277073749.plus.aac.p.m4a\",\"track_name\":\"The Brave\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T10:00:00+00:00\",\"sale_end_date\":\"2026-12-12T16:00:00+00:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-12-12T18:00:00+00:00\",\"event_end_date\":\"2026-12-12T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by JOY.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/T0a3466d942a?dice_id=T0a3466d942a\",\"post_competition_referral\":\"https://link.dice.fm/w03dd0a78160?dice_id=w03dd0a78160\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K67ef3078f29?dice_id=K67ef3078f29\",\"post_purchase_referral\":\"https://link.dice.fm/Jdfa05127964?dice_id=Jdfa05127964\",\"post_reminder_referral\":\"https://link.dice.fm/R4267f6be299?dice_id=R4267f6be299\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hf185400c01f?dice_id=Hf185400c01f\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Sheepdogs are Canada’s leaders in rock ’n’ roll entertainment. Four-time JUNO Award winners from Saskatoon, with multiple Gold and Platinum records to their name, they blend killer harmonies, dual-guitar wizardry, and a stage presence that turns audiences into true believers.\\n\\nThe Sheepdogs deliver the real goods: rock music that’s loud, loose, and full of soul. They’ve taken their unmistakable sound from bars and roadhouses to festival fields and arenas around the world, earning a well-deserved reputation as one of the most electrifying live bands today.\\n\\nWith 13 releases — including the recent companion EPs Paradise Alone and Hell Together — the band continues to prove that the spirit of classic rock will never die. Now, thanks to their own label, Right On Records, they are masters of their own destiny. Their new single, “Nobody But You,” is the first taste of new music to come and proof that The Sheepdogs are charging full steam ahead into 2026 and beyond\\n\\nThis event is 14 and over. 14s to 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1595,\"name\":\"JOY.\",\"privacy_policy_link\":\"https://www.joyconcerts.com/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1797098400,\"venues\":[{\"id\":\"55\",\"name\":\"Electric Ballroom\",\"address\":\"184 Camden High St, London NW1 8QP\",\"location\":{\"lat\":51.5396558,\"lng\":-0.143191399999978},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/fab0b36d-a5a4-4e37-a541-2c5af15a3bc1.jpg?rect=0%2C0%2C400%2C400\"},\"city\