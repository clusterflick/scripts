housenunhead.com/about\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-26T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"announcement_date_unix\":1771028100,\"social_links\":{\"event_share\":\"https://link.dice.fm/n413d4158691?dice_id=n413d4158691\",\"post_competition_referral\":\"https://link.dice.fm/R02a458bff1d?dice_id=R02a458bff1d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/M4e55229f91d?dice_id=M4e55229f91d\",\"post_purchase_referral\":\"https://link.dice.fm/f24c93d3cd34?dice_id=f24c93d3cd34\",\"post_reminder_referral\":\"https://link.dice.fm/H45797fa739c?dice_id=H45797fa739c\",\"post_waitinglist_referral\":\"https://link.dice.fm/N71b9ace000c?dice_id=N71b9ace000c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"nv9b7l-elliott-smith-live-in-1999-26th-apr-the-ivy-house-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1777228200,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:28\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2022-09-14/7d47bab0-7cec-4a4a-83d0-0daac606d87a.jpg?rect=375%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-09-14/7d47bab0-7cec-4a4a-83d0-0daac606d87a.jpg?rect=0%2C75%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-09-14/7d47bab0-7cec-4a4a-83d0-0daac606d87a.jpg?rect=713%2C0%2C825%2C1500\"},\"id\":\"69919d1e68765d00012cefc8\",\"name\":\"ELLIOTT SMITH - LIVE IN  1999 \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Deeper Into Movies presents a rare concert screening of the late great Elliott Smith from 1999 Olympia, Washington.\\n\\nThe concert has been upscaled to 1080p HD and the audio has been re-mixed and mastered.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo ID Required).\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T00:15:00+00:00\",\"sale_end_date\":\"2026-04-26T19:15:00+01:00\",\"sale_start_date\":\"2026-02-14T12:15:00+00:00\",\"event_start_date\":\"2026-04-26T19:30:00+01:00\",\"event_end_date\":\"2026-04-26T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Elliott Smith - Between the Bars\",\"redirect_url\":\"https://open.spotify.com/track/1JbUMtVkQuaAPdHOvncVTm\",\"artist\":\"Elliott Smith\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3a998de91763a9e1d78e112772ad48af68e3369d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Between the Bars\"},{\"type\":\"apple_music\",\"title\":\"Elliott Smith - Between the Bars\",\"redirect_url\":\"https://music.apple.com/us/album/between-the-bars/3195595?i=3195577&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Elliott Smith\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/f2/44/c3/f244c385-51b8-9e95-2153-e15025504bfd/mzaf_17059719357754978090.plus.aac.p.m4a\",\"track_name\":\"Between the Bars\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sun 26 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":null}",
