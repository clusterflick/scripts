e\":false},\"seats_io_event_id\":null,\"perm_name\":\"xe5oql-rockaoke-27th-feb-the-star-of-kings-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772222400,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:59\",\"venues\":[{\"id\":\"13434\",\"name\":\"The Star of Kings\",\"address\":\"126 York Way, Islington, London, N1 0AX, United Kingdom\",\"location\":{\"lat\":51.53636,\"lng\":-0.12205},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-star-of-kings-8dy5\",\"accessibility\":{\"url\":\"https://starofkings.co.uk/wp-content/uploads/2024/09/SOK-Venue-Brochure-2024-compressed.pdf\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T20:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rockaoke\",\"image\":null,\"artist_id\":\"126109\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Join us for singalong fun twice a month, every second and last Friday!\\n\\nBringing you the ultimate live band Karaoke experience that will set the tone for an unforgettable year. Be part of the action as you step into the spotlight and belt out your favourite tunes in front of a lively crowd. Channel your inner Debbie Harry, Ed Sheeran, or Justin Bieber and make this year's Rockaoke a night to remember!\\n\\nA unique Karaoke singing experience.\\n\\nA perfect experience for anyone!\\n\\n“Most fun ever? We reckon so!” – Time Out London\\n\\n“Karaoke’s much cooler older brother, ROCKAOKE” – Sunday Times\\n\\n“The best rockaoke band on the planet\\\" – Virgin Radio\\n\\n“So wrong, it’s right!” – Ibiza Rocks\\n\\n\\\"The band make you feel like a proper ROCKSTAR, they don’t make you sound like one, but they make you feel like one - \\\"Chris Moyles, Radio DJ\\n\\n“Paulo Nutini, The Fratellis and McFly were among the acts who performed exclusive live sessions for the intimate audience in the Virgin Radio VIP Sessions, setting the stage for ROCKAOKE” – OK Magazine\\n\\n“Thank you SO much. We all had a great great time and I think the warmth, enthusiasm and kindness of the band added so much.” – Kate Harwood (BBC Head of Drama & Serials)\\n\\n“I recently attended a Rockaoke night in Cardiff and was absolutely blown away by your performance and the whole atmosphere of the event. I have never witnessed anything quite like it and the talent the band demonstrated with their wide repertoire was incredible.” – Beth (Cancer Research Wales)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-20T15:30:00+01:00\",\"sale_end_date\":\"2026-02-27T23:30:00+00:00\",\"sale_start_date\":\"2025-08-20T15:30:00+01:00\",\"event_start_date\":\"2026-02-27T20:00:00+00:00\",\"event_end_date\":\"2026-02-28T00:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68a6ce2d464ebd0001ae09c4\",\"name\":\"Rockaoke\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=506%2C0%2C1238%2C2250\"},\"m