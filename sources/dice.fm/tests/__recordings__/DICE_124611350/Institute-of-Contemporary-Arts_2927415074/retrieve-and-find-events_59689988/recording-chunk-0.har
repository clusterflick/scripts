798f7fd3?dice_id=ef4b798f7fd3\",\"post_reminder_referral\":\"https://link.dice.fm/K71b95cc8608?dice_id=K71b95cc8608\",\"post_waitinglist_referral\":\"https://link.dice.fm/z660e883812a?dice_id=z660e883812a\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k69bb9-bossa-nova-a-tribute-to-joo-gilberto-by-mario-bakuna-3rd-apr-morocco-bound-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775239200,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:21\",\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=834%2C0%2C3333%2C3333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=0%2C167%2C5000%2C3000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=1584%2C0%2C1833%2C3333\"},\"id\":\"698c70f445c1b9000158ab9f\",\"name\":\"Bossa Nova: A Tribute to João Gilberto by Mario Bakuna\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Line-up: Mario Bakuna – acoustic guitar and vocals**\\n\\nAfter selling out his first show at Morocco Bound we are pleased to announce a second date in the new year!\\n\\nJoin him in celebrating the legacy of João Gilberto, the legendary Brazilian musician and pioneering father of Bossa Nova in the late 1950s. In this heartfelt tribute, Mario Bakuna presents reinterpretations of Gilberto’s work alongside his own original compositions. Audiences can expect a rich blend of traditional samba elements, syncopated rhythms of plucked chords, and the breezy sophistication that defines Bossa Nova.\\n\\nMario Bakuna is a Brazilian composer, arranger, vocalist, and guitarist with over 20 years of professional experience, currently based in London, UK. Well known for his deep exploration of traditional Brazilian rhythms, samba, jazz, and bossa nova, Mario focuses on both original compositions and fresh arrangements of works by iconic artists like Tom Jobim, Dorival Caymmi, Paulo Moura, and João Donato. In recent years, he has also dedicated his research and performance to reinterpreting Samba Jazz, a genre that emerged in 1950s Rio de Janeiro through the work of artists like Luiz Eça, Tamba Trio, and Edson Machado. This style blends Brazilian standards with sophisticated harmonies influenced by the post–bossa nova movement.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-29T00:00:00+01:00\",\"sale_end_date\":\"2026-04-03T18:00:00+01:00\",\"sale_start_date\":\"2026-01-21T14:00:00+00:00\",\"event_start_date\":\"2026-04-03T19:00:00+01:00\",\"event_end_date\":\"2026-04-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Beiral\",\"redirect_url\":\"https://open.spotify.com/track/5ON5zhF1Nfrs0H4PjuVoMb\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/667854aaefe9a82b5612eaad9caff180c2dc16e3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Beiral\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Demonic Death Judge\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0de3da8ed152387cfc7403c2\"},\"artist_id\":\"133685\",\"about\":null,\"is_headliner\":false},{\"name\":\"Old Horn Tooth\",\"image\":null,\"artist_id\":\"89846\",\"about\":null,\"is_headliner\":false}],\"total_art