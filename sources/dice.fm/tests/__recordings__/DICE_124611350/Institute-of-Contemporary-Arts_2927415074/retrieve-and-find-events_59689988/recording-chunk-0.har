e_id=U6509b6fbea1\",\"post_purchase_referral\":\"https://link.dice.fm/U5d7961bf2c1?dice_id=U5d7961bf2c1\",\"post_reminder_referral\":\"https://link.dice.fm/e80a77e09ee4?dice_id=e80a77e09ee4\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z915eb4187fe?dice_id=Z915eb4187fe\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"We are thrilled to announce that Altın Gün will release their brandnew album 'Garip' this coming spring, marking the next chapter in their sonic journey.\\n\\nTo celebrate, the band brings the new music to stages across Europe with a full tour through Spring 2026. 'Garip' marks a pivot back toward 70s Anatolian folk-rock sensibilities and is a tribute to the late legendary composer Neşet Ertaş.\\n\\nAltın Gün is dailing back on heavy synth production in favor of live instrumentation, vintage hardware, and real-time interplay. Every track on 'Garip' is a reimagined version of traditional Turkish folk songs, composed by Neşet Ertaş, presented through a lens of psychedelic rock, funk, and spaced out groovy pop.\\n\\nCritics highlight the hypnotic, swirling textures, spacerock tendencies, prog-folk interplay, and danceable grooves as signature traits.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773514800,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":10,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:63\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\