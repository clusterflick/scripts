3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-12-04T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/3e1f3479-6bfb-4c34-a075-bd313786d090.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/3e1f3479-6bfb-4c34-a075-bd313786d090.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/3e1f3479-6bfb-4c34-a075-bd313786d090.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763337600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**HotHaus Drag Presents: The Ho Ho Ho's Christmas Show**\\n\\nHO HO HO – IT’S CHRISTMAS AND THE BEST TIME OF THE YEAR!!! Where else would you want to celebrate the festive season that with all of us at HotHaus Drag, your friends and family?\\n\\nWe’ve spent the past year together so let’s finish it in style. A night of pure Christmas joy is guaranteed along with everything that makes our shows SO special.\\n\\nNever been to one of our shows before? Well come along and experience the magic of HotHaus Drag for yourself.\\n\\nDoors open 7pm – show starts 8pm\\n\\nHotHaus is a safe space for EVERYONE and EVERYONE is welcome.\\n\\nHosted by Kenzie Blackheart\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:79\",\"social_links\":{\"event_share\":\"https://link.dice.fm/qed9092990ec?dice_id=qed9092990ec\",\"post_competition_referral\":\"https://link.dice.fm/E314896eb856?dice_id=E314896eb856\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s886dc4a6474?dice_id=s886dc4a6474\",\"post_purchase_referral\":\"https://link.dice.fm/n7208082a843?dice_id=n7208082a843\",\"post_reminder_referral\":\"https://link.dice.fm/y0819eff5500?dice_id=y0819eff5500\",\"post_waitinglist_referral\":\"https://link.dice.fm/T1a8cc355236?dice_id=T1a8cc355236\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T00:00:00+00:00\",\"sale_end_date\":\"2026-12-04T19:00:00+00:00\",\"sale_start_date\":\"2025-11-17T00:00:00+00:00\",\"event_start_date\":\"2026-12-04T19:00:00+00:00\",\"event_end_date\":\"2026-12-04T23:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"691b04ff547a440001b0eb8d\",\"seats_io_event_id\":null,\"name\":\"HotHaus Drag Presents: The Ho Ho Ho's Christmas Show\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"mx8xd9-hothaus-drag-presents-the-ho-ho-hos-christmas-show-4th-dec-hot-box-chelmsford-tickets\",\"date_unix\":1796410800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 04 Dec\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-02-24T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-16/c949b563-e343-4d0e-9268-06908b552033.jpg?rect=0%2C0%2C3322%2C3322\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-16/c949b563-e343-4d0e-9268-06908b552033.jpg?rect=0%2C665%2C3322%2C1993\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-16/c949b563-e343-4d0e-9268-06908b552033.jpg?rect=748%2C0%2C1827%2C3322\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1760972400,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**WEDNESDAY 24TH FEBRUARY 2027 / DOORS & BARS OPEN 7PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\n**This is an 18+ event**\\n\\nExperience a World where the bizarre becomes beautiful, and the impossible becomes reality.\\n\\nFrom the creative visionaries behind the world’s most iconic circuses comes CABARET EXTREME—a beautifully bizarre blend of burlesque, daring drag, extreme stunts, and contemporary circus. Whether you crave near impossible stunts, captivating storytelling, or laugh-out-loud moments, CABARET EXTREME delivers something for everyone.\\n\\nPrepare to be thrilled, moved, and inspired as this unconventional masterpiece brings the extraordinary into existence.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:80\",\"social_links\":{\"event_share\":\"https://link.dice.fm/T20a75ae5841?dice_id=T20a75ae5841\",\"post_competition_referral\":\"https://link.dice.fm/a0925853eb5b?dice_id=a0925853eb5b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k5c09fa24e1b?dice_id=k5c09fa24e1b\",\"post_purchase_referral\":\"https://link.dice.fm/pcd0e82b334c?dice_id=pcd0e82b334c\",\"post_reminder_referral\":\"https://link.dice.fm/l05826778eb0?dice_id=l05826778eb0\",\"post_waitinglist_referral\":\"https://link.dice.fm/O9210296af07?dice_id=O9210296af07\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-20T16:00:00+01:00\",\"sale_end_date\":\"2027-02-24T19:00:00+00:00\",\"sale_start_date\":\"2025-10-20T16:00:00+01:00\",\"event_start_date\":\"2027-02-24T19:00:00+00:00\",\"event_end_date\":\"2027-02-24T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"rescheduled\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2710},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"68f1059396f2430001e0686f\",\"seats_io_event_id\":null,\"name\":\"Cabaret Extreme\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"53xd2y-cabaret-extreme-24th-feb-the-clapham-grand-london-tickets\",\"date_unix\":1803495600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 24 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_h