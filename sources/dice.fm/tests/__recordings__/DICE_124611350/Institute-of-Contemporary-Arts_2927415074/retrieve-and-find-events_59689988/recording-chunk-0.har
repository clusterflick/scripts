ges\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/017ebbc4-9ad5-4fb3-86fe-9fae322175a3.jpg?rect=0%2C403%2C1548%2C1548\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/017ebbc4-9ad5-4fb3-86fe-9fae322175a3.jpg?rect=0%2C568%2C1548%2C929\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/017ebbc4-9ad5-4fb3-86fe-9fae322175a3.jpg?rect=207%2C0%2C1135%2C2064\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Wfd96c6b52cb?dice_id=Wfd96c6b52cb\",\"post_competition_referral\":\"https://link.dice.fm/Ab4b9ab17df3?dice_id=Ab4b9ab17df3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B332296445f8?dice_id=B332296445f8\",\"post_purchase_referral\":\"https://link.dice.fm/Nac7f9a0f68f?dice_id=Nac7f9a0f68f\",\"post_waitinglist_referral\":\"https://link.dice.fm/L6953cd6cc6f?dice_id=L6953cd6cc6f\",\"post_reminder_referral\":\"https://link.dice.fm/c03c3a1b5085?dice_id=c03c3a1b5085\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"60\",\"name\":\"Corsica Studios\",\"address\":\"4/5 Elephant Rd, London SE17 1LB\",\"location\":{\"lat\":51.4935523,\"lng\":-0.0987442000000556},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"corsica-studios-jqna\",\"accessibility\":{\"url\":\"https://www.corsicastudios.com/information/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-23T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nPharaoh Overlord + The Holy Family at Corsica Studios - March 23rd\\n\\nPharaoh Overlord is a Finnish duo by Jussi Lehtisalo and Tomi Leppänen, who are also members of the legendary experimental rock band Circle. Celebrating their 25th anniversary in 2025, Pharaoh Overlord has slowly been evolving from the hypnotic slow stoner rock of the early years to the electronic avant-garde synth experiments the group is known today.\\n\\nFresh from their critically acclaimed minimal meditative masterpiece \\\"Louhi\\\" (2025), Pharaoh Overlord is currently working with vocalist Aaron Turner on the follow-up for \\\"6\\\", their unexpected Italo Disco meets Metal hit album.\\n\\nInstagram: https://www.instagram.com/pharaohoverlord\\n\\nLabel: https://rocketrecordings.com\\n\\n\\\"The tide turns from catharsis to cure with the borderline-absurd disco death metal of Pharaoh Overlord\\\" - The Guardian\\n\\n\\\"I feel like there’s probably gonna be a bunch of bands aping this sound soon because it’s really organically cool\\\" - Echoes And Dust\\n\\n\\\"The juxtaposition of clean disco-fresh electronics against the abrasive and guttural vocals is exhilarating\\\" - The Wire\\n\\n\\\"Pharoah Overlord occupy a singular space: it doesn’t much matter who’s involved or what kind of music they’re making – stoner rock, scratchy jazz, endless Italo-disco – somehow it is, and will always be, them\\\" - The Quietus\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:49\",\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"presented_by\":\"Prese