post_purchase_referral\":\"https://link.dice.fm/Bf4f7d6d63d6?dice_id=Bf4f7d6d63d6\",\"post_waitinglist_referral\":\"https://link.dice.fm/ld9ab5c6a9ec?dice_id=ld9ab5c6a9ec\",\"post_reminder_referral\":\"https://link.dice.fm/f61ff7c63d3c?dice_id=f61ff7c63d3c\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"940\",\"name\":\"Kings Place (Hall One)\",\"address\":\"Kings Place, 90 York Way, Kings Cross, London N1 9AG\",\"location\":{\"lat\":51.5349694,\"lng\":-0.121675500000038},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-one-yo6v\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"*What is it about the music of Spanish Renaissance master Tomás Luis de Victoria that lifts it above other composers? He seems - inexplicably – just to weave from better quality cloth. In the first few bars of ‘Alma Redemptoris mater’, you palbably feel the difference. Writers talk of the spirituality of his music but what does actually mean? As a sort of musical El Greco, there seems to be something in the aural brushwork that adds depth and spice, alongside an extraordinary joy and reverence in the text.*\\n\\nHear his utterly sublime eight-voice motets alongside the highly intimate and small-scale Tenebrae for Maundy Thursday – but also rarely heard jewels such ‘Nigra sum’ (why does it begin in ‘joyful’ triple time?) and ecstasy of Vidi speciosam. Robert Hollingworth guides you through the symbolism with performers steeped in this music.\\n\\n***This event will last approximateyl 75 minutes, without an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":\"2ad14f4d-0e68-47ec-b212-b7c079037ea2\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"impression_id\":\"14e26421af20bb85:3\",\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"presented_by\":\"Presented by Kings Place.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"I Fagiolini\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebecfaae553d263c041a563541\"},\"artist_id\":\"122849\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1750850100,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-25T12:15:00+01:00\",\"sale_end_date\":\"2026-03-26T15:00:00+00:00\",\"sale_start_date\":\"2025-06-25T14:00:00+01:00\",\"event_start_date\":\"2026-03-26T19:00:00+00:00\",\"event_end_date\":\"2026-03-26T20:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"686003388c916b000126174c\