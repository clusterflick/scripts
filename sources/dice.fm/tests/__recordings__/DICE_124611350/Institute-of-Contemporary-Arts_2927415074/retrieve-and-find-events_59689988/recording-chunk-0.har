 \",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/X4ea22fd1122?dice_id=X4ea22fd1122\",\"post_competition_referral\":\"https://link.dice.fm/Cf8cbc78f1d7?dice_id=Cf8cbc78f1d7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a7688436c3b4?dice_id=a7688436c3b4\",\"post_purchase_referral\":\"https://link.dice.fm/K31aea3cf874?dice_id=K31aea3cf874\",\"post_reminder_referral\":\"https://link.dice.fm/n935006af3ff?dice_id=n935006af3ff\",\"post_waitinglist_referral\":\"https://link.dice.fm/U0dbe7ccb567?dice_id=U0dbe7ccb567\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The seeds of British modern soul band Stone Foundation were sown in the early ’90s when Neil Sheasby and Neil Jones met.\\n\\nOver the years, the band have collaborated with an incredible range of artists including Paul Weller, Peter Capaldi, Bettye Lavette, William Bell, Nolan Porter, Graham Parker, Carleen Anderson, Mick Talbot, Kathryn Williams, Laville, Melba Moore, Hamish Stuart, and Dr Robert of The Blow Monkeys, among many others.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795287600,\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-21T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":true,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:32\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"id\":\"6979fd5467516d00018cd1a0\",\"name\":\" Stone Foundation\",\"perm_name\":\"q27q69--stone-foundation-21st-nov-village-underground-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/8b77b7ec-488b-4083-ba70-2bb1a58cc747.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/8b77b7ec-488b-4083-ba70-2bb1a58cc747.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/8b77b7ec-488b-4083-ba70-2bb1a58cc747.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Stone Foundation\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-26/157d4f47-4b48-4f29-af5b-0fe816a18203.jpg?rect=151%2C0%2C584%2C584\"},\"artist_id\":\"8079\",\"about\":{\"description\":\"Working closely with Paul Weller since their 2017 album Street Rituals, Stone Foundation have accumulated a hall of fame of collaborations both in the studio and on stage – including tracks with Durand Jones & The Indications and Bettye LaVette.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1769767200,\"faqs\":[{\"id\":72774,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3554},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Hold on to Love\",\"redirect_url\":\"https://open.spotify.com/track/5F6n5qmts7GGGtl1gVgUpy\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0e8fc4c08b19dc9b27ad560b928de82b88e644f9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Hold on to Love\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T15:00:00+00:00\",\"sale_end_date\":\"2026-11-21T19:00:00+00:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-11-21T19:00:00+00:00\",\"event_end_date\":\"2026-11-22T01:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Edcf2c94f4a8?dice_id=Edcf2c94f4a8\",\"post_competition_referral\":\"https://link.dice.fm/T90468fb52e1?dice_id=T90468fb52e1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F06868835ed8?dice_id=F06868835ed8\",\"post_purchase_referral\":\"https://link.dice.fm/Dfa77affee1a?dice_id=Dfa77affee1a\",\"post_reminder_referral\":\"https://link.dice.fm/h7c3bd821edb?dice_id=h7c3bd821edb\",\"post_waitinglist_referral\":\"https://link.dice.fm/w3ef4819a949?dice_id=w3ef4819a949\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Ska Legends ***The Kubricks*** are back in Chelmsford after their BACK TO BACK sold out shows in November!\\n\\nBased in London, ***The Kubricks*** are a seven-piece band that seamlessly blends ska, reggae, and irresistibly catchy melodic pop.\\n\\nProduced by Toby Davies of Gentleman’s Dub Club, the band’s debut album, ‘The Heist’, dropped in 2017. The UK’s longest-running skazine, Do The Dog, dubbed it, “A very strong contender for album of the year,” while Bucketlist in Canada described it as, “A gem of an album that makes ska and reggae seem like a perfect fit with 21st-century musical trends.” Tom Robinson (6Music) immediately shared the track ‘Down With the Dogs’ with his listeners, and BBC Introducing in Essex invited the band for a live session.\\n\\nAfter completing two autumn UK tours and securing a publishing deal with Wipe Out Music, The Kubricks unveiled their latest album, ‘Between Antipodes’, in December 2022. Representing their most ska-pop record to date, the album was produced by Tom Donovan, a producer and musician from the hip-hop act Monster Florence.\\n\\nThey’ve played to tens of thousands at notable events such as the Isle of Wight Festival, Kendal Calling, Green Man, Shambala, Boomtown Fair, Bearded Theory’s Spring Gathering, Godiva, Weinturm Open Air (Germany), Lott Festival (Germany), Zik ‘n’ Roll (France), Dance Ska La (France), and The London International Ska Festival, among many others.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1795287600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-21T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:33\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_na