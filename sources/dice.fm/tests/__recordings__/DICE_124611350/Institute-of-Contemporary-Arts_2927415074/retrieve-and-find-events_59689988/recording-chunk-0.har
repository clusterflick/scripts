e_start_date\":null},\"announcement_date_unix\":1768316400,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":4290,\"sales_tax\":0,\"amount_from\":null},\"id\":\"695f8717a000ad000162ab4d\",\"name\":\"Eiko Ishibashi & Jim O'Rourke\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eiko Ishibashi\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c05124974cb9f972bf8a92cc5\"},\"artist_id\":\"57791\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"oeg5ga-eiko-ishibashi-jim-orourke-13th-apr-union-chapel-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/56a87bb1-dca1-4817-8cf9-92823f0051c2.jpg?rect=0%2C0%2C957%2C957\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/56a87bb1-dca1-4817-8cf9-92823f0051c2.jpg?rect=0%2C192%2C957%2C574\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/56a87bb1-dca1-4817-8cf9-92823f0051c2.jpg?rect=216%2C0%2C526%2C957\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"**Eiko Ishibashi & Jim O’Rourke** toured Europe for two weeks in 2023, a wonderful passage through France, Switzerland, Italy and Ireland; Pareidolia, the duo's fifth collaborative release, is a remix made up of resonances from those shows. The movement of sound in each performance and the relationships of sound between them; a dynamic medley of color and shape to pulse through earbuds, speaker cones and the air immediately surrounding you.\\n\\nThis show is part of the **Rough Trade 50** celebrations.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages (under 16s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enable