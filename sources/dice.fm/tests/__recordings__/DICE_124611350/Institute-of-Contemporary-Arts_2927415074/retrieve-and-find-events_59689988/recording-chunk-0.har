/mzaf_10773372944954067241.plus.aac.p.m4a\",\"track_name\":\"Pink + White\"}],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":true,\"is_hidden_event\":false,\"perm_name\":\"av3dxv-ego-ella-may-acoustic-signing-20th-mar-rough-trade-east-london-london-tickets\",\"seating\":null,\"tty_to_extras\":[{\"ticket_type_id\":1165144,\"extra_ids\":[\"1171375\"]},{\"ticket_type_id\":1165145,\"extra_ids\":[\"1171375\"]},{\"ticket_type_id\":1165166,\"extra_ids\":[\"1171375\"]}],\"streaming_options\":null,\"date_unix\":1774033200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/fae7348c-257e-4042-9062-481f18f983d3.jpg?rect=0%2C305%2C2412%2C2412\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/fae7348c-257e-4042-9062-481f18f983d3.jpg?rect=0%2C787%2C2412%2C1447\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/fae7348c-257e-4042-9062-481f18f983d3.jpg?rect=375%2C0%2C1662%2C3021\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Oa2a40366da6?dice_id=Oa2a40366da6\",\"post_competition_referral\":\"https://link.dice.fm/Q239afec5239?dice_id=Q239afec5239\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Rf7da7b7d922?dice_id=Rf7da7b7d922\",\"post_purchase_referral\":\"https://link.dice.fm/d2f1fb8a71ab?dice_id=d2f1fb8a71ab\",\"post_waitinglist_referral\":\"https://link.dice.fm/A493415dd7ba?dice_id=A493415dd7ba\",\"post_reminder_referral\":\"https://link.dice.fm/Bb87c1d10fdc?dice_id=Bb87c1d10fdc\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-20T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Rough Trade East is very excited to present an acoustic performance and signing from Ego Ella May. This unique event celebrates the release of her new album 'Good Intentions' released via Believe Recordings.\\n\\nTickets for this event include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com/products/good-intentions\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attac