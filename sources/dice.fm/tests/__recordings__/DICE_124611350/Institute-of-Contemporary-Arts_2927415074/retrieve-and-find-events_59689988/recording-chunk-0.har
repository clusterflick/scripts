id\":\"6583\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T18:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-20/abd9de94-e2c2-4a44-b2c4-ee9f148c9b0f.jpg?rect=339%2C0%2C1334%2C1334\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-20/abd9de94-e2c2-4a44-b2c4-ee9f148c9b0f.jpg?rect=0%2C64%2C2012%2C1207\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-20/abd9de94-e2c2-4a44-b2c4-ee9f148c9b0f.jpg?rect=639%2C0%2C734%2C1334\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/s62bc87ef849?dice_id=s62bc87ef849\",\"post_competition_referral\":\"https://link.dice.fm/F98d204a8cc3?dice_id=F98d204a8cc3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p4378a1219c6?dice_id=p4378a1219c6\",\"post_purchase_referral\":\"https://link.dice.fm/j6c97bddbb60?dice_id=j6c97bddbb60\",\"post_reminder_referral\":\"https://link.dice.fm/u953ee951b05?dice_id=u953ee951b05\",\"post_waitinglist_referral\":\"https://link.dice.fm/a5c43a1fc3cf?dice_id=a5c43a1fc3cf\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:36\",\"properties\":[],\"presented_by\":\"Presented by Other Side Promotions.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760977800,\"id\":\"68f662b87a08800001d965a5\",\"name\":\"OSP Presents: Co-Headline: Mint Field (MEX) + Avishag Cohen Rodrigues (Cumgirl8) (USA)\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Exactly 8 year since their last London appearance, OSP present the return of Mexican shoegaze & dream pop band Mint Field, plus a co-headline set from Avishag Cohen Rodrigues (Cumgirl8).\\n\\nMint Field (MX):\\n\\nMint Field is one of these bands that make it shine. Guided by Estrella del Sol and Sebastian Neyra. Mint Field creates a unique blend of avant dream pop and shoegaze with some touches of trip hop that explores the nostalgia and melancholy of daily life with strong guitars and voices that are like sighs. Instrumentation and atmospheres are accompanied by delicate, harmonious and ethereal voices that are a fundamental part of the sound.\\n\\nAvishag Cohen Rodrigues (Cumgirl8):\\n\\nUS-based multi-instrumentalist & artist Avishag Cohen Rodrigues, guitarist of New York’s all-female punk collective cumgirl8 (4AD). Her music is intricate yet raw; aloof, detached, yet vulnerable. Drawing upon rock, low fi, dark electronic, noise, & experimental, Rodrigues tells sonic stories of raw electronic landscapes intercut with bold, cutting guitars and dark minimal vocals.\\n\\nWith a full-length LP ‘Islands’ & several EPs on the shelf, Rodrigues is known for bending the boundaries of genres while remaining unattached to any singular form. Live sets blend electronic beats with her signature guitar sound & vocals. Taking the listener on a journey through different cities, seasons, & smokey rooms.Beyond her work with cumgirl8, Rodrigues has collaborated, performed, & recorded with many esteemed artists.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"5285\",\"name\":\"Other Side Promotions\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-09/c8464497-8f12-4558-84bb-ede11bc2ddb5.jpg\"},\"perm_name\":\"other-side-promotions-r5gv\",\"profile_active\":true},\"date_unix\":1772389800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":918,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T00:00:00+00:00\",\"sale_end_date\":\"2026-03-01T18:45:00+00:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T19:00:00+00:00\",\"event_end_date\":\"2026-03-01T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dv62-smithereens-1st-mar-next-door-records-two-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Smithereens - I'll Be Fine\",\"redirect_url\":\"https://open.spotify.com/track/6BWWsZ5dLHguoKbu6xHLto\",\"artist\":\"Smithereens\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2d039eb692d2d563ebfeb5744289be9276a9106c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I'll Be Fine\"},{\"type\":\"apple_music\",\"title\":\"Smithereens - I'll Be Fine\",\"redirect_url\":\"https://music.apple.com/us/album/ill-be-fine/1756956188?i=1756956189&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Smithereens\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/ea/82/6d/ea826d1b-c526-4bbb-243e-89b2189cf97e/mzaf_12693856348642624429.plus.aac.p.m4a\",\"track_name\":\"I'll Be Fine\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_