sic:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:59\",\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-19T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"HUMBE\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-04/d967735f-8c26-4a6b-9d48-009c0f59dac6.jpg?rect=0%2C0%2C458%2C458\"},\"artist_id\":\"133064\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Even if you’re having one of the worst days of your life, you can end it in a better place by watching a beautiful sunset - the sky is always there for you,” says Mexican singer/songwriter HUMBE as he discusses the concept behind DUEÑO DEL CIELO (“Master of the Sky”), his remarkable new album. “This record invites listeners to reinvent themselves. When everything you knew has burnt to the ground, it’s time to change the way you contemplate life.”\\n\\nThese are heady concepts for a 24-year-old artist from Monterrey who began playing the piano at his grandmother’s house when he was only nine. Then again, there is nothing ordinary about HUMBE, an alternative pop genius and one of the most poetic voices of his generation.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T15:15:00+00:00\",\"sale_end_date\":\"2026-06-19T21:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-06-19T19:00:00+01:00\",\"event_end_date\":\"2026-06-19T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"6980becfc1f4bc00011d42ba\",\"name\":\"HUMBE: Dueño del Cielo Tour\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/07f90b54-e7f9-474b-a2d6-bd56419cc261.jpg?rect=0%2C520%2C3120%2C3120\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/07f90b54-e7f9-474b-a2d6-bd56419cc261.jpg?rect=0%2C1144%2C3120%2C1872\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/07f90b54-e7f9-474b-a2d6-bd56419cc261.jpg?rect=416%2C0%2C2288%2C4160\"},\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770650100,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/D35fbc2f4659?dice_id=D35f