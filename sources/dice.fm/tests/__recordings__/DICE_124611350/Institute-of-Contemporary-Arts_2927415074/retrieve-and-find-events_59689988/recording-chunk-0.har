ife To Live\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Martin Harley\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb65eadab4881074531d333faa\"},\"artist_id\":\"22962\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-12T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-02-26/1320dcb1-9cdc-4254-8e35-0e99e462f239.jpg?rect=944%2C0%2C3584%2C3584\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-02-26/1320dcb1-9cdc-4254-8e35-0e99e462f239.jpg?rect=0%2C151%2C5472%2C3283\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-02-26/1320dcb1-9cdc-4254-8e35-0e99e462f239.jpg?rect=1751%2C0%2C1971%2C3584\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/k1ebf46dd9f7?dice_id=k1ebf46dd9f7\",\"post_competition_referral\":\"https://link.dice.fm/h28c0c265ca8?dice_id=h28c0c265ca8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wbed44fa20e9?dice_id=wbed44fa20e9\",\"post_purchase_referral\":\"https://link.dice.fm/f00f5a2a5bad?dice_id=f00f5a2a5bad\",\"post_reminder_referral\":\"https://link.dice.fm/N42bf18a2de5?dice_id=N42bf18a2de5\",\"post_waitinglist_referral\":\"https://link.dice.fm/i4f214590495?dice_id=i4f214590495\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:34\",\"properties\":[],\"presented_by\":\"Presented by Black Frog\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764633600,\"id\":\"692f39c696fff80001e50d0c\",\"name\":\"Martin Harley\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Martin Harley has been making music and touring the world for over two decades. His sound has never been more down to earth. Exploring roots, blues and slide guitar in a style The Guardian referred to as ‘Spellbinding’, Harley has released nine albums to date, four recorded on home soil and four across the Atlantic in Texas and Nashville.\\n\\nMartin's solo shows are known for mixing excellent musicianship and songwriting with a down-to-earth sense of humour and tales of 3 decades of world travel. His recent nominations include AMA Instrumentalist of the Year, Best Acoustic Guitarist, Best Acoustic Blues Artist. Notable appearances include Glastonbury Acoustic and Avalon stages, Beautiful Days, Royal Albert Hall, Union Chapel, Bluebird Nashville, Tønder Festival, The Troubadour LA and at home around the fire pit with his two daughters. In 2022 Martin released and toured the Harley Kimbro Lewis album with Grammy-nominated Daniel Kimbro and Sam Lewis which received excellent reviews.\\n\\n“Harley offers the listener a masterclass in taste, style and roots blues” Guitarist Magazine\\n\\n\\\"No doubt that he is a slide guitar master. He is the business\\\" Roots Magazine\\n\\n\\\"Spellbinding” The Guardian\\n\\n“Quite simply a great live act” Time Out London\\n\\nPraise for ‘Roll With The Punches’ - \\\"impossible to ignore the quality leeching out of every pore....a beautiful album\\\" Blues In Britain\\n\\n\\\"Sublime....if I could give it 6 stars I would\\\" Music News (5 stars)\\n\\n\\\"Excellent!\\\" David Freeman, Jazz FM\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1791828000,\"event_tag\":null}],\"title\":\"Mon 12 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2970,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T12:00:00+00:00\",\"sale_end_date\":\"2026-10-13T18:00:00+01:00\",\"sale_start_date\":\"2026-01-28T12:00:00+00:00\",\"event_start_date\":\"2026-10-13T19:15:00+01:00\",\"event_end_date\":\"2026-10-13T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bb37dk-james-mccurtry-13th-oct-union-chapel-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Choctaw Bingo\",\"redirect_url\":\"https://open.spotify.com/track/6OLpueAJ583fExPtN4kV8g\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a16098931c7dda14b88c5e8d40f25974c9b6dfda?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Choctaw Bingo\"},{\"type\