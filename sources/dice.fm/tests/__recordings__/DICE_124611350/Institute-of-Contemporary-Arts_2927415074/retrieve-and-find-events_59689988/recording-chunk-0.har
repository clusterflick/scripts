is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[{\"id\":52756,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/42ac831b-f504-4b56-a82a-d13c7b2041b4.jpg?rect=1118%2C0%2C4472%2C4472\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/42ac831b-f504-4b56-a82a-d13c7b2041b4.jpg?rect=0%2C224%2C6708%2C4025\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/42ac831b-f504-4b56-a82a-d13c7b2041b4.jpg?rect=2124%2C0%2C2460%2C4472\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Nubiyan Twist, Soweto Kinch - Buckle Up\",\"redirect_url\":\"https://open.spotify.com/track/6B1TQPyyswTiskhWurN1Rs\",\"artist\":\"Nubiyan Twist, Soweto Kinch\",\"preview_url\":\"https://p.scdn.co/mp3-preview/840482d8c8842fe0b80b4bcd48479d99733ccbf0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Buckle Up\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1761732000,\"max_tickets\":6,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiate