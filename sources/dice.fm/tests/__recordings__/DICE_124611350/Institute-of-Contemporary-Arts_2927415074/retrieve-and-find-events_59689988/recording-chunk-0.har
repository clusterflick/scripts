ngton-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-06T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"announcement_date_unix\":1760518800,\"social_links\":{\"event_share\":\"https://link.dice.fm/H0ff4801e636?dice_id=H0ff4801e636\",\"post_competition_referral\":\"https://link.dice.fm/U055180b3a02?dice_id=U055180b3a02\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w6d3fa142cf4?dice_id=w6d3fa142cf4\",\"post_purchase_referral\":\"https://link.dice.fm/Qc1b8f7c2f1e?dice_id=Qc1b8f7c2f1e\",\"post_reminder_referral\":\"https://link.dice.fm/z4d3022f43af?dice_id=z4d3022f43af\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z54727e53de4?dice_id=Z54727e53de4\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"pypywp-from-the-jam-6th-jun-islington-assembly-hall-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780768800,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:93\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3931},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-14/dfc2b477-eb4f-47b5-a196-94a72a1ad536.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-14/dfc2b477-eb4f-47b5-a196-94a72a1ad536.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-14/dfc2b477-eb4f-47b5-a196-94a72a1ad536.jpg?rect=180%2C0%2C440%2C800\"},\"id\":\"68e61b382ebd3b0001176969\",\"name\":\"From The Jam\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"From The Jam have announced a major UK tour for Spring 2026, marking 20 years since their formation. The tour kicks off in Edinburgh on 22 May, and wraps up in Birmingham on 13 June.\\n\\nThe band originally began in 2006 under the name ‘The Gift’, formed by The Jam’s drummer Rick Buckler and at one time featuring original bassist Bruce Foxton. While neither Buckler nor Foxton are part of the current line-up, their role in the band’s early years helped establish From The Jam as the definitive live celebration of The Jam’s music and legacy.\\n\\nFrom The Jam continue to be fronted by Russell Hastings as they were from their inception.\\n\\nThe only frontman to have performed and recorded with both Buckler and Foxton since The Jam’s split in 1982, Hastings’ passion and deep knowledge for the band have earned From The Jam a devoted following of fans, packing out venues across the world.\\n\\nAudiences can expect to hear enduring classics such as ‘Going Underground’, ‘Start!’, ‘Town Called Malice’, and ‘That’s Entertainment’, delivered with the same precision and energy that made The Jam one of the UK’s most influential bands.\\n\\nKnown for their mod image, melodic songs, and distinctly English style, The Jam achieved significant success with 18 consecutive Top 40 UK singles and 4 No.1 hits. Alongside this commercial success, they had an ineffable impact on generations to come, leaving a marked effect on music, politics and fashion.\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-15T10:00:00+01:00\",\"sale_end_date\":\"2026-06-06T21:00:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-06-06T19:00:00+01:00\",\"event_end_date\":\"2026-06-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"A Town Called Malice (Live)\",\"redirect_url\":\"https://open.spotify.com/track/1F0eRzYx5bwmIaT37uVs8m\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f5db9b423af758dc46fe3409c586ab391c871e37?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"A Town Called Malice (Live)\"},{\"type\":\"apple_music\",\"title\":\"The Jam - Town Called Malice\",\"redirect_url\":\"https://music.apple.com/gb/album/town-called-malice/1440911369?i=1440911603&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Jam\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview118/v4/7c/a9/3a/7ca93a05-061c-f559-4620-e9dcc2ba2a07/mzaf_429513666057124393.plus.aac.p.m4a\",\"track_name\":\"Town Called Malice\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Whitney Johnson\",\"image\":null,\"artist_id\":\"88432\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lia Kohl\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb4819a1c68a1558e8498f203b\"},\"artist_id\":\"66032\",\"about\":null,\"is_headliner\":false},{\"name\":\"Macie Stewart\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebfea5b423156a52e20fff7226\"},\"artist_id\":\"39999\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_text