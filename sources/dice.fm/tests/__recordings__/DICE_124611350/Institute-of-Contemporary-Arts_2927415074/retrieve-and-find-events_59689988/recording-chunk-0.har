:{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-01T15:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/bf19e717-744a-433e-937b-49d65964989c.jpg?rect=0%2C264%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/bf19e717-744a-433e-937b-49d65964989c.jpg?rect=0%2C664%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/bf19e717-744a-433e-937b-49d65964989c.jpg?rect=305%2C0%2C1390%2C2528\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/k8ed569b4006?dice_id=k8ed569b4006\",\"post_competition_referral\":\"https://link.dice.fm/L032e9e1d123?dice_id=L032e9e1d123\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X0758eef628d?dice_id=X0758eef628d\",\"post_purchase_referral\":\"https://link.dice.fm/ff965c9f772e?dice_id=ff965c9f772e\",\"post_reminder_referral\":\"https://link.dice.fm/Udcbb82bacf1?dice_id=Udcbb82bacf1\",\"post_waitinglist_referral\":\"https://link.dice.fm/g71441b7a4b2?dice_id=g71441b7a4b2\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:81\",\"properties\":[],\"presented_by\":\"Presented by Black Frog\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764633600,\"id\":\"692f3ea46ca7e10001e8e9a3\",\"name\":\"The Dirt Road Band\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Dirt Road Band are Steve Walwyn, guitar and vocals, Horace Panter, bass, and Ted Duggan, drums. They play hard, punchy blues-rock music that makes your heart beat faster.\\n\\nLet’s dig deeper…\\n\\nWalwyn has played guitar for a living for the past 45 years, 32 of those as a member of Dr Feelgood. Panter was a founding member of The Specials. He’s been doing this a while too, as has Duggan who has enjoyed spells with Banco de Gaia and more recently, Badfinger. Three highly proficient and time-served players doing what they do best.\\n\\nDRB started as a side project some 5 years ago and has now taken centre stage. Their critically acclaimed debut album ‘Righteous’ was released in July 2024.\\n\\nThe creative process coming naturally with these players feeding off one another. You can see it in their live performance too. “Seasoned professionals with the energy of teenagers” as one contemporary musician observed.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1793545200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T00:00:00+00:00\",\"sale_end_date\":\"2