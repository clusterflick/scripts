purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:35\",\"date_unix\":1777744800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3976},\"social_links\":{\"event_share\":\"https://link.dice.fm/A1294d3ed272?dice_id=A1294d3ed272\",\"post_competition_referral\":\"https://link.dice.fm/d4e88179b88b?dice_id=d4e88179b88b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/id74af8e169d?dice_id=id74af8e169d\",\"post_purchase_referral\":\"https://link.dice.fm/C6cb2e4fc203?dice_id=C6cb2e4fc203\",\"post_reminder_referral\":\"https://link.dice.fm/Df54bc5302ba?dice_id=Df54bc5302ba\",\"post_waitinglist_referral\":\"https://link.dice.fm/T561083bd7aa?dice_id=T561083bd7aa\"},\"perm_name\":\"av7kaq-mesh-special-guests-2nd-may-229-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/21e02b07-ab30-42bd-8e1f-775d1f93b47f.jpg?rect=0%2C0%2C900%2C900\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/21e02b07-ab30-42bd-8e1f-775d1f93b47f.jpg?rect=0%2C180%2C900%2C540\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/21e02b07-ab30-42bd-8e1f-775d1f93b47f.jpg?rect=203%2C0%2C495%2C900\"},\"properties\":[],\"about\":{\"description\":\"Due to popular demand, those masters of emotional electronics MESH are playing their homeland again, it’s no secret their songs pull at your very heartstrings while more often then not, have you dancing the blues away too, this time they play these 3 very exclusive ‘The Truth Doesn’t Matter’ shows in the UK! In their hometown Bristol and also in Sheffield for the first time in several years!\\n\\nThese special shows will see them play tracks from their new album plus an extended set of classic tracks from their vast back catalogue, past and present, fan favourites and singles and album tracks, some not played in many years, the shows promise to be a celebration of their long and outstanding career!\\n\\nBring your dancing shoes and maybe the odd handkerchief, you’ll almost definitely need both!\\n\\nFFO: Depeche Mode, Nine Inch Nails, Front 242, VNV Nation etc\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69131f9b11b2b00001b1b579\",\"name\":\"MESH + Special guests\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"MESH\",\"image\":null,\"artist_id\":\"77481\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T09:00:00+00:00\",\"sale_end_date\":\"2026-05-02T19:00:00+01:00\",\"sale_start_date\":\"2025-10-27T09:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:00:00+01:00\",\"event_end_date\":\"2026-05-02T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Akira Records\",\"seating\":null,\"announcement_date_unix\":1761555600,\"venues\":[{\"id\":\"7609\",\"nam