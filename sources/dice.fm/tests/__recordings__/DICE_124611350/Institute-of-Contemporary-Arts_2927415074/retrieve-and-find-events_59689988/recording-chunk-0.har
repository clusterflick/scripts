GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-09-27T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"She Past Away\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb5b482b4b535031fab1eb9b94\"},\"artist_id\":\"9625\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/d0670c81-5f90-44bd-8c97-75b1acfe8395.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-08/d0670c81-5f90-44bd-8c97-75b1acfe8395.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-08/d0670c81-5f90-44bd-8c97-75b1acfe8395.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Rituel\",\"redirect_url\":\"https://open.spotify.com/track/2Nac4pGLIiXjLyo7lLDK4R\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2aaa11a24bb0319ec257f2c21b0bc2b21bff01a3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Rituel\"},{\"type\":\"apple_music\",\"title\":\"She Past Away - Monoton\",\"redirect_url\":\"https://itunes.apple.com/gb/album/monoton/504373603?i=504373606&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"She Past Away\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview111/v4/68/56/fe/6856fed7-320a-00c8-5a4c-cf2bd6265f28/mzaf_4320727908238788523.plus.aac.p.m4a\",\"track_name\":\"Monoton\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768136400,\"max_tickets\":6,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nNight Terrors will be hosting a double-bill of She Past Away + ACTORS at Dalston's EartH Hall this September.\\n\\nSHE PAST AWAY is a dark wave/post-punk duo, consisting of Volkan Caner (vocal, guitars and songwriting) and Doruk Ozturkcan (drums, synths and production). Experimenting old/new aesthetic of synth music into their core guitar stuff, She Past Away forged a sound, an attitude, and a sensibility, conveyed through a minimalist poetry sung in Turkish, which sweeps the audience through a dense, continual epic trip in both their recordings and live performances.\\n\\nACTORS is a Canadian post-punk/darkwave band from Vancouver, formed in 2012 by Jason Corbett (vocals, guitar), known for their cinematic, synth-driven sound that blends classic 80s new wave with modern flair, alongside Shannon Hemmett (keyboards, vocals), Kendall Wooding (bass, vocals), and Adam Fink (drums). They gained prominence with albums like It Will Come To You (2018) and Acts of Worship (2021), blending moody atmospheres, driving rhythms, and anthemic hooks, establishing themselves as key figures in the contemporary darkwave scene.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":true,\"is_hidden_event\":false,\"presented_by\":\"Presented by Night Terrors. \",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:87\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Wdb22f3f1d19?dice_id=Wdb22f3f1d19\",\"post_competition_referral\":\"https://link.dice.fm/Q2313860d0fa?dice_id=Q2313860d0fa\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ndf35c097d74?dice_id=ndf35c097d74\",\"post_purchase_referral\":\"https://link.dice.fm/G0e4a5a336e0?dice_id=G0e4a5a336e0\",\"post_reminder_referral\":\"https://link.dice.fm/F021e8dce05a?dice_id=F021e8dce05a\",\"post_waitinglist_referral\":\"https://link.dice.fm/F3170924067a?dice_id=F3170924067a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-11T13:00:00+00:00\",\"sale_end_date\":\"2026-09-27T21:00:00+01:00\",\"sale_start_date\":\"2026-01-11T13:00:00+00:00\",\"event_start_date\":\"2026-09-27T19:00:00+01:00\",\"event_end_date\":\"2026-09-27T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3996},\"properties\":[],\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"id\":\"695fc364f0f0a20001a5b511\",\"seats_io_event_id\":null,\"name\":\"SHE PAST AWAY + ACTORS\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb36rg-she-past-away-actors-27th-sep-earth-london-tickets\",\"date_unix\":1790532000,\"score\":0,\"tty_to_e