\",\"announcement_date\":\"2026-01-22T00:00:00+00:00\",\"sale_end_date\":\"2026-06-26T17:00:00+01:00\",\"sale_start_date\":\"2026-01-22T00:00:00+00:00\",\"event_start_date\":\"2026-06-27T18:00:00+01:00\",\"event_end_date\":\"2026-06-27T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by New Cross Live.\",\"seating\":null,\"announcement_date_unix\":1769040000,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-27T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:1\",\"date_unix\":1782579600,\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/V3362e86d5bd?dice_id=V3362e86d5bd\",\"post_competition_referral\":\"https://link.dice.fm/r3d7bc5ec19c?dice_id=r3d7bc5ec19c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X168ebf546b2?dice_id=X168ebf546b2\",\"post_purchase_referral\":\"https://link.dice.fm/b14923af3d83?dice_id=b14923af3d83\",\"post_reminder_referral\":\"https://link.dice.fm/wc4ea643d95a?dice_id=wc4ea643d95a\",\"post_waitinglist_referral\":\"https://link.dice.fm/lf4ea1989492?dice_id=lf4ea1989492\"},\"perm_name\":\"92wa7o-the-landline-27th-jun-new-cross-inn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/291d35e4-a772-4b8f-a495-1881f869f91a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/291d35e4-a772-4b8f-a495-1881f869f91a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/291d35e4-a772-4b8f-a495-1881f869f91a.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"The Landline\\n\\nClassic 90’s era Indie and Britpop tribute band based in London…Stone Roses, Charlatans, Blur, Pulp, Oasis, Pixies, Happy Mondays, Suede etc!\\n\\nhttps://linktr.ee/thelandline\\n\\n9.30pm finish, followed by England v Panama on the big screen at 10pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6970f9949edb950001fbbb98\",\"name\":\"The Landline\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Landline\",\"image\":null,\"artist_id\":\"132687\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T15:59:00+00:00\",\"sale_end_date\":\"2026-06-27T21:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-06-27T18:30:00+01:00\",\"event_end_date\":\"2026-06-27T22:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":71038,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":0},{\"id\":71039,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":1},{\"id\":71040,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":71041,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":71042,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":4},{\"id\":71043,\"title\":\"Can I bring a bag?\",\"body\":\"BAG POLICY FOR LIVE MUSIC EVENTS AT ALEXANDRA PALACE\\n\\nWe encourage you to attend live music events without bags. Should you need to bring one for your essentials, it needs to be as small as possible.\\n\\nFor security reasons and in line with industry best practice, visitors are only permitted to bring one small bag into the venue, which must be no bigger than:\\n\\nHeight 30cm (11.8 inches)\\n\\nWidth 20cm (7.9 inches)\\n\\nDepth 10cm (3.9 inches)\\n\\nAny bags that do not meet these requirements will be directed to our bag drop (Great Hall concerts only).\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":5},{\"id\":71044,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":6},{\"id\":71045,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"marketeers\":[{\"id\":471,\"name\":\"Labyrinth Events\",\"privacy_policy_link\":\"https://www.labyrinthevents.com/terms\",\"fb_pixel_id\":\"1410823875730293\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CQU8ARJC77UCRPC5TAV0\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Labyrinth.\",\"seating\":null,\"announcement_date_unix\":1769443140,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"