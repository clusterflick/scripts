ble_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"oegmgy-declan-j-donovan-12th-jun-scala-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:26\",\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":\"2026-06-12T21:45:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Declan J Donovan\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3e16001375e0acd57f2b8894\"},\"artist_id\":\"7284\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Declan J Donovan’s music today glows with a hard won sense of light. After years of feeling creatively and personally lost, an intense period of therapy and focused self care became a turning point. One that reshaped both his life and his songwriting. The result is a renewed, uplifting pop folk sound defined by emotional honesty, melodic warmth and a quiet confidence that reflects an artist finally at peace with himself.\\n\\nSince January this year, Donovan’s resurgence has translated into major momentum. His UK tour sold out in full, including two sold out nights in London, underlining a rapidly growing live following. In March, the release of “More Than A Feeling” marked a breakthrough moment, debuting with 1.6 million Spotify streams in its first week and exploding across social media with over 150 million views on TikTok, 30 million of which came from Donovan’s own videos alone.\\n\\nThe track went on to reach number one on the UK Singer-Songwriter Chart, a feat he would repeat with “Life Or Death,” confirming his place at the forefront of the genre. With his sold out headline shows and viral global reach, 2025 has firmly established Declan J Donovan’s return, not just as a success story, but as an artist in full creative bloom.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T10:00:00+00:00\",\"sale_end_date\":\"2026-06-12T18:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T21:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"697cef9ca809c500019c77f2\",\"name\":\"Declan J Donovan\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/69770c56-85d4-49fb-985c-e9e72033caa0.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/69770c56-85d4-49fb-985c-e9e72033caa0.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/69770c56-85d4-49fb-985c-e9e72033caa0.jpg?rect=270%2C0%2C660%2C1200\"},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770026400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Wdf38c5cddb0?dice_id=Wdf38c5cddb0\",\"post_competition_referral\":\"https://link.dice.fm/a9a1746760f4?dice_id=a9a1746760f4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q862538ba93c?dice_id=Q862538ba93c\",\"post_purchase_referral\":\"https://link.dice.fm/Wa29f8bf39f4?dice_id=Wa29f8bf39f4\",\"post_reminder_referral\":\"https://link.dice.fm/jd9891c09515?dice_id=jd9891c09515\",\"post_waitinglist_referral\":\"https://link.dice.fm/z49af9976700?dice_id=z49af9976700\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Fallen so Young\",\"redirect_url\":\"https://open.spotify.com/track/3y4uSQwxHckyRcvafEilkN\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/49feddf3bd39e3c2994237f3f58d1ba6a431a942?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Fallen so Young\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2800,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Hootananny Brixton.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"8e86g7-the-real-thing-12th-jun-hootananny-brixton-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781287200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:27\",\"venues\":[{\"id\":\"6109\",\"name\":\"Hootananny Brixton\",\"address\":\"95 Effra Rd, London SW2 1DF, UK\",\"location\":{\"lat\":51.4553934,\"lng\":-0.1132058},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-01-25/a335e145-034f-424c-811e-d996395babfa.jpg?rect=912%2C0%2C3648%2C3648\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hootananny-brixton-parp\",\"accessibility\":{\"url\":\"https://hootanannybrixton.co.uk/info/#:~:text=Venue%20Access%20Policy,Phone%20number%20020%2077373%207273.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-12T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Real Thing\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/6e8d8352f5357564c7ae5be10557982fccba6cd4\"},\"artist_id\":\"15673\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"**THE REAL THING** with original vocalists Chris Amoo & Dave Smith head to Hootananny 🎙️\\n\\nThe Real Thing enjoyed success in both the 70’s & 80’s with 3 Top 10 singles. The No 1 Hit ‘You To Me Are Everything’ ‘Can't Get By Without You’ & ‘Can You Feel The Force' and all these tracks are still featured daily on all the major UK Radio stations. They also have around two million plays or more on Spotify each month.\\n\\nFormed in 1972, The Real Thing are Britain’s longest-established - and best-loved - black group in UK entertainment history. The Real Thing remain pioneers in soul, funk and dance music.\\n\\n2026 is the 50th Anniversary of ‘You To Me Are Everything’ hitting the No 1 slot in the charts so this year is a big celebration.\\n\\n\\\"You'll Never Know What You're Missing \\\" until you come out and have a great night's entertainment. Come out to celebrate the 50th anniversary of one of the most loved No 1 records of all time 'YOU TO ME ARE EVERYTHING\\\"\\n\\nThe Real Thing are undoubtedly still a force to be reckoned with...\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T00:00:00+00:00\",\"sale_end_date\":\"2026-06-12T21:30:00+01:00\",\"sale_start_date\":\"2026-01-21T00:00:00+00:00\",\"event_start_date\":\"2026-06-12T19:00:00+01:00\",\"event_end_date\":\"2026-06-12T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6970f85beb8bbb00019c6a3d\",\"name\":\"The Real Thing\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/e788ce9f-78cc-44fe-93ff-16dde4da23be.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/e788ce9f-78cc-44fe-93ff-16dde4da23be.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/e788ce9f-78cc-44fe-93ff-16dde4da23be.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_i