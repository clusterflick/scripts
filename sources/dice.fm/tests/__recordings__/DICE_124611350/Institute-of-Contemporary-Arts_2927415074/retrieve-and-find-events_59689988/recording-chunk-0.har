ferral\":\"https://link.dice.fm/db8318b69243?dice_id=db8318b69243\",\"post_waitinglist_referral\":\"https://link.dice.fm/p5db3a8704fa?dice_id=p5db3a8704fa\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":600,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Windmill Brixton.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"487\",\"name\":\"Windmill Brixton\",\"image\":{\"url\":null},\"perm_name\":\"windmill-brixton-4mgk\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k6abl8-kiosk-cosign-jellyskin-assa-26th-feb-windmill-brixton-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772135100,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:13\",\"venues\":[{\"id\":\"441\",\"name\":\"Windmill Brixton\",\"address\":\"22 Blenheim Gardens, London SW2 5BZ\",\"location\":{\"lat\":51.454073,\"lng\":-0.122336300000029},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"windmill-brixton-jxdl\",\"accessibility\":{\"url\":\"https://www.windmillbrixton.co.uk/visitor-info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:45:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jellyskin\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe47f4685b669663547f39f78\"},\"artist_id\":\"6278\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kiosk\",\"image\":null,\"artist_id\":\"101161\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":2},\"about\":{\"description\":\"Private Regcords and Windmill Brixton present:\\n\\nKIOSK - https://linktr.ee/kioskbanduk\\n\\nLeeds based electronic duo KiosK make dance-punk influenced by the city's diverse DIY scene. Their sound shifts between postpunk inflected dance beats, dreamy soundscapes and pounding techno noise, combining drum machines and analogue synthesis with raw lyrics and heavily processed bass.\\n\\nCOSIGN - https://www.instagram.com/cosign333\\n\\nDebut London Show!\\n\\ncosign is an artist and producer based in Belfast, crafting immersive indie-electronic music that sits at the intersection of emotion and innovation. Drawn to experimental production and lyrical depth, their sound fuses pulsing energy with introspective melancholy, layered with arps, vocoders, and rich harmonies.\\n\\nJELLYSKIN - https://www.instagram.com/jellyskinband/\\n\\nJellyskin is formed of Zia and Will, plus their bank of bastardised drum samples and found sound. Their music combines abrasive techno, sinewy electronica, sparkling percussion and cut-glass vocals, drawing on influences from sixties girl groups and the chansonnier tradition to pummeling electronics, PC Music and kosmische.\\n\\nASSA - guitar led pop backed by atmospheric stuff and synth work - heavy on nostalgia\\n\\n\\\\- https://www.instagram.com/assamyfavourite\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T00:00:00+00:00\",\"sale_end_date\":\"2026-02-26T21:00:00+00:00\",\"sale_start_date\":\"2026-01-08T00:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:45:00+00:00\",\"event_end_dat