\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:58\",\"properties\":[],\"presented_by\":\"Presented by Action!\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1756803600,\"id\":\"68b6bc905d4c3f0001387ee1\",\"name\":\"Dan Byrne\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Fresh from completing his recent, hugely successful headline tour of the UK, plus summer festival appearances, and, most recently, a very successful tour of the UK as Special Guest to The Dead Daisies, Liverpool rock singing sensation, Dan Byrne is set to undertake his most extensive tour of the UK so far.\\n\\nHaving been dubbed by Planet Rock Radio as a ‘Voice of a Generation\\\" and Classic Rock Magazine's \\\"One to Watch\\\", Dan will be following on from the release of huis most recent track, ‘Sentimental’ with some additional new music in the run up to the tour starting.\\n\\nHaving recently announced the signing of a worldwide publishing deal with Notting Hill Music, and with more exciting announcements to come, 2026 is shaping up to be another stellar year in the life of Dan Byrne\\n\\nWith support from Kit Trigg and Fireheart.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event,\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"date_unix\":1775844000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":800},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone