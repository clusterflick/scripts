ut\":null,\"is_headliner\":false},{\"name\":\"EsDeeKid \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-02/37e9beeb-0e26-4ffb-9fec-c3139f499b8d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"107089\",\"about\":null,\"is_headliner\":false},{\"name\":\"JPEGMAFIA\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7662a813d9637310fe9ad721\"},\"artist_id\":\"7777\",\"about\":null,\"is_headliner\":false}],\"total_artists\":10,\"total_free_texts\":0},\"faqs\":[{\"id\":54021,\"title\":\"Accessibility\",\"body\":\"For customers with disabilities wishing to book the accessible viewing areas, please visit the festival website or AXS.com\",\"order\":0},{\"id\":54022,\"title\":\"What are the gate times?\",\"body\":\"Gates Open: 13:30 – please note the gates will be open approx. 30 minutes early for the customers who select Primary Entry or VIP tickets.\",\"order\":1},{\"id\":57368,\"title\":\"What is the sustainability levy?\",\"body\":\"The Sustainability Levy is used on innovative event-power technologies, resource-intensive recycling schemes and other groundbreaking initiatives which will help move the industry towards a sustainable future.\",\"order\":2},{\"id\":57522,\"title\":\"Age restriction\",\"body\":\"16+ only. Anyone aged 16-17 must be accompanied by a parent or guardian (18 or over)\",\"order\":3}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/1ab18c18-7879-4f12-980d-5f9cad88d2a8.jpg?rect=0%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/1ab18c18-7879-4f12-980d-5f9cad88d2a8.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/1ab18c18-7879-4f12-980d-5f9cad88d2a8.jpg?rect=324%2C0%2C792%2C1440\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"My Own Summer (Shove It)\",\"redirect_url\":\"https://open.spoti