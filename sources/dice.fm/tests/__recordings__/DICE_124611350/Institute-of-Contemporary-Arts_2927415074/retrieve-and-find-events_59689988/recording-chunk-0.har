nie Scott's atmosphere, just in a new postcode.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T15:15:00+00:00\",\"sale_end_date\":\"2026-03-05T20:30:00+00:00\",\"sale_start_date\":\"2026-01-30T15:15:00+00:00\",\"event_start_date\":\"2026-03-05T19:30:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"697cd6baa33ec7000196ecfc\",\"name\":\"Ronnie's Lates: East with Don Glori\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/fee7e0f3-7215-45fb-aa8c-c22deeaa10b4.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/fee7e0f3-7215-45fb-aa8c-c22deeaa10b4.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/fee7e0f3-7215-45fb-aa8c-c22deeaa10b4.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"