g?rect=0%2C488%2C828%2C497\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/bd09a3b9-30d0-4bde-a10b-ca40976ce586.jpg?rect=9%2C0%2C810%2C1472\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/R2f430a2c796?dice_id=R2f430a2c796\",\"post_competition_referral\":\"https://link.dice.fm/t426aafab685?dice_id=t426aafab685\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D6407b5e17f0?dice_id=D6407b5e17f0\",\"post_purchase_referral\":\"https://link.dice.fm/Mf45d115933f?dice_id=Mf45d115933f\",\"post_waitinglist_referral\":\"https://link.dice.fm/X45098b57937?dice_id=X45098b57937\",\"post_reminder_referral\":\"https://link.dice.fm/Z17855c9df6a?dice_id=Z17855c9df6a\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"205\",\"name\":\"The Finsbury\",\"address\":\"336 Green Lanes, London N4 1BY\",\"location\":{\"lat\":51.5719307,\"lng\":-0.0963550999999825},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-finsbury-zgy6\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"🧚🏼‍♀️ MAREZINE is back for 2026 with an all-stars classic lineup of both bad fairies (and good) to kick us off for the year of the horse 🐴 a year that bodes well for change and transformation! Are you ready? 🧚🏼‍♀️\\n\\nHeadlining once again is the divine and sensational Wednesday's Child with support from powerhouse witches Sisters of Hysteria and English art pop princess VERONICA.\\n\\nWe also have a whole host of local London poets who will join us to open the night with some whimsical + magical readings, to celebrate the arrival of Ostara 🌸 Rejoice! Spring is almost upon us…\\n\\nPoetry from Kathleen Maeve, Ellana Blacher, Lucy Harbron, Alex Dominica + more! 🪷\\n\\nArtwork by @alexandra\\\\_dominica ⭐️🧚🏼‍♀️⭐️\\n\\nJoin the festivities. RSVP via DICE. This time it’s FREE ENTRY 🤩\\n\\nSo so excited to be back. May 2026 be kind to us all 🧜🏼‍♀️\\n\\nMAREZINE x\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":null,\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:22\",\"billing_promoter\":{\"id\":\"5352\",\"name\":\"MARE Magazine\",\"image\":{\"url\":null},\"perm_name\":\"mare-magazine-kvbp\",\"profile_active\":false},\"presented_by\":\"Presented by MARE Magazine.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wednesday’s Child\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-06/3f0689d6-e5f4-4e3d-9ece-af2e68b2280d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"41650\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"marketeers\":[],\"announcement_date_unix\":1769616900,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T16:15:00+00:00\",\"sale_end_date\":\"2026-03-27T22:00:00+00:00\",\"sale_start_date\":\"2026-01-28T16:15:00+00:00\",\"event_start_date\":\"2026-03-27T18:30:00+00:00\",\"event_end_date\":\"2026-03-27T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"697a3400da77570001df94f6\",\"name\":\"MAREZINE: WEDNESDAY’S CHILD, VERONICA + MORE\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"preview