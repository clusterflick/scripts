\"https://dice-media.imgix.net/attachments/2024-07-03/9bdead43-edcb-4c96-94ed-acf3481c6ed9.jpg?rect=151%2C0%2C1426%2C2592\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/nd6bf94e5d6b?dice_id=nd6bf94e5d6b\",\"post_competition_referral\":\"https://link.dice.fm/n2e3d2a4b13c?dice_id=n2e3d2a4b13c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V6a28f9f41e4?dice_id=V6a28f9f41e4\",\"post_purchase_referral\":\"https://link.dice.fm/q92950fb1d7e?dice_id=q92950fb1d7e\",\"post_waitinglist_referral\":\"https://link.dice.fm/J3148ab8a6b6?dice_id=J3148ab8a6b6\",\"post_reminder_referral\":\"https://link.dice.fm/Sdf34411a36e?dice_id=Sdf34411a36e\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T13:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Experience live global music with master conga player Williams Cumberbache and special guests on Grow’s canalside terrace in Hackney Wick. Set against the River Lea, enjoy world-class performances from the pontoon stage as boats drift by.\\n\\nRelax in our hidden garden, surrounded by greenery, and enjoy homemade dishes from the Brunch or All Day menu. Ease into the weekend with a spritz in hand and sun on your face. Our new Spritz Happy Hour is the perfect way to toast your brunch plans – two for £15, or go alcohol-free with two Crodinos for £10.\\n\\nWith over 30 years in the UK music scene, including collaborations with Goldie and Björk, Williams curates each session with a vibrant mix of jazz fusion, Latin, Brazilian, and African rhythms. Expect solo sets or surprise guest artists.\\n\\nWhether you're a jazz head, a brunch lover, or just after feel-good energy, these sessions offer high-quality music, warm vibes, and a family-friendly space that welcomes dancing.\\n\\nPractical Info\\n\\n- Venue: Grow is a converted warehouse with canalside and indoor seating.\\n- Booking: Tables for up to 8 via OpenTable. Larger groups via enquiry form. Walk-ins welcome.\\n- Weather: Performances are outdoors but may move inside during extreme conditions.\\n- Time: Performances run between 1–4 PM; artists and set times may vary.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":null,\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:18\",\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"presented_by\":\"Presented by Grow, Hackney.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1732665600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-03-22T14:00:00+00:00\",\"sale_start_date\":\"2025-12-10T13:00:00+00:00\",\"event_start_date\":\"2026-03-22T13:00:00+00:00\",\"event_end_date\":\"2026-03-22T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_da