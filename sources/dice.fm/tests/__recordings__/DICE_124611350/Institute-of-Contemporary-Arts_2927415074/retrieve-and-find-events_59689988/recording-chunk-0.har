\",\"title\":\"Triphop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:ukg\",\"title\":\"Ukg\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban\",\"title\":\"Urban\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_pop\",\"title\":\"Urban pop\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:urban_underground\",\"title\":\"Urban underground\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:vikingfolk\",\"title\":\"Viking folk\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:western_swing\",\"title\":\"Western swing\",\"subtitle\":\"Gigs\"},{\"value\":\"gig:world\",\"title\":\"World\",\"subtitle\":\"Gigs\"}],\"subtitle\":null,\"section_type\":\"tags_horizontal\"},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1695,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Citizen Live.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"11372\",\"name\":\"Citizen Live\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-04/3986ab94-e1cf-489e-95df-450093b12e1c.jpg\"},\"perm_name\":\"citizen-live-6al8\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"oeg3lg-nik-sheva-26th-feb-piano-smithfield-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772134200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:0\",\"venues\":[{\"id\":\"5071\",\"name\":\"Piano Smithfield\",\"address\":\"14 Long Ln, Barbican, London EC1A 9PN, UK\",\"location\":{\"lat\":51.5197837,\"lng\":-0.0989723},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"piano-smithfield-oxa5\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nik Sheva\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/54938693-6d1a-48e6-a7f5-d1662d0eb904.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"102715\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Nik Sheva is an internationally recognized neo-classical pianist, composer, and drummer, with roots in Ukraine and a creative presence in London. Born in 1994, his musical education began at 14 when he was accepted into the Conservatory of Vicenza in Italy.\\n\\nNik's music is where tradition meets modernity, blending the two into something both timeless and fresh. His most recent album, Calm in a Storm, is his most significant milestone to date. Released in February 2024, this album comprises seven original tracks and delves into themes of identity, the overwhelming flood of information in modern times, and the longing for home in a world rife with conflict.\\n\\nFurther showcasing his artistic journey, Nik recently performed at a concert in Poland and earned acclaim as a festival player by securing a spot at the esteemed Piano City Milano and Palermo festivals.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-05T00:00:00+00:00\",\"sale_end_date\":\"2026-02-26T19:30:00+00:00\",\"sale_start_date\":\"2026-01-05T12:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:30:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\