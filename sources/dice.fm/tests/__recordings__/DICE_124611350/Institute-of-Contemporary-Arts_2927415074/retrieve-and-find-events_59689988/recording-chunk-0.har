C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-04/2585322e-b636-4c68-b978-9cf17731433e.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6908d17c6f034100019e154f\",\"name\":\"Malibu\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T10:00:00+00:00\",\"sale_end_date\":\"2026-04-24T21:00:00+01:00\",\"sale_start_date\":\"2025-11-07T10:00:00+00:00\",\"event_start_date\":\"2026-04-24T19:30:00+01:00\",\"event_end_date\":\"2026-04-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"bbnmak-malibu-24th-apr-earth-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2750,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ja9f0fb91be1?dice_id=Ja9f0fb91be1\",\"post_competition_referral\":\"https://link.dice.fm/s7effae6502a?dice_id=s7effae6502a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Jaf0cd1ebb81?dice_id=Jaf0cd1ebb81\",\"post_purchase_referral\":\"https://link.dice.fm/x116b0c5fd18?dice_id=x116b0c5fd18\",\"post_reminder_referral\":\"https://link.dice.fm/X6e4fe3e5c34?dice_id=X6e4fe3e5c34\",\"post_waitinglist_referral\":\"https://link.dice.fm/O18646566460?dice_id=O18646566460\"},\"previews\":[],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1777055400,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:69\",\"about\":{\"description\":\"AGMP presents\\n\\nTHE STYLE COUNCILLORS\\n\\n'Our Favourite Shop' 40th Anniversary Tour\\n\\nThe Style Councillors are the world’s one and only tribute to The Style Council.\\n\\n'Our Favourite Shop' is the second studio album by The Style Council released in 1985. The Style Councillors will be celebrating this classic LP by performing selections from the album aswell as the hits and fan favourites of The Style Council.\\n\\nFormed in 2013 by Darren Fletcher (Paul Weller) and Steve Hayes (Mick Talbot), The Style Councillors have quickly built a loyal fanbase for the group which was Paul Weller’s home for the majority of the 1980’s and where he wrote some of his finest songs. Dani Clay (Dee C. Lee) and Craig Read (Steve White) are joined by the Bad Manners Horn Section and a stellar line up of musicians hell-bent on recreating the sound of The Style Council.\\n\\nAfter the dissolution of The Jam in 1982, Paul Weller joined forces with Mick Talbot, formerly of The Merton Parkas, Dexys Midnight Runners and The Bureau, to form The Style Council. The band released a string of succesful singles between 1983-1989 such as Speak Like a Child, Money-Go-Round, Long Hot Summer, My Ever Changing Moods, You’re The Best Thing, Shout To The Top, Walls Come Tumbling Down, A Solid Bond In Your Heart, Come To Milton Keynes, The Lodgers, Why I Went Missing, and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1758704400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Style Councillors\",\"image\":null,\"artist_id\":\"9163\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-24/739fc799-6920-4f14-81c2-244bb6734172.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-24/739fc799-6920-4f14-81c2-244bb6734172.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-24/739fc799-6920-4f14-81c2-244bb6734172.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"68d3f8ac767f9e0001c78aeb\",\"name\":\"The Style Councillors\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-24T10:00:00+01:00\",\"sale_end_date\":\"2026-04-24T13:00:00+01:00\",\"sale_start_date\":\"2025-09-24T10:00:00+01:00\",\"event_start_date\":\"2026-04-24T19:30:00+01:00\",\"event_end_date\":\"2026-04-24T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"2wx3op-the-style-councillors-24th-apr-the-100-club-london-tickets\",\"score\":0,\"tags