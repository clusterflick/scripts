rom\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/019bb064-a1de-47c5-b5ea-d50922129339.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/019bb064-a1de-47c5-b5ea-d50922129339.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/019bb064-a1de-47c5-b5ea-d50922129339.jpg?rect=338%2C0%2C825%2C1500\"},\"id\":\"6973495f8627e1000144e692\",\"name\":\"Stow Film Lounge Popcorn Nights - Spinal Tap II\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"We continue our new “Popcorn Nights” programme at Signature Brew with a music reunion to end all reunions!\\n\\nDocumentarian Marty DiBergi follows estranged Spinal Tap bandmates David St. Hubbins, Nigel Tufnel and Derek Smalls as they search for a drummer and prepare for a reunion concert in New Orleans. Joined by music royalty Paul McCartney and Elton John, Spinal Tap wrestles with their checkered past to put on a show that they hope will solidify their place in the pantheon of rock 'n' roll.\\n\\nVenue: Signature Brew, Unit 15 Blackhorse Lane, London E17 5QJ\\n\\nDoors: Open 7pm, Film 7.45pm, Close 11.00pm\\n\\nRefreshments: Alcoholic, non-alcoholic drinks and food will be available. We will also be serving freshly made popcorn.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T08:00:00+00:00\",\"sale_end_date\":\"2026-02-26T19:00:00+00:00\",\"sale_start_date\":\"2026-01-23T09:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Thu 26 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[{\"id\":71955,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T16:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/L7c1af0635bc?dice_id=L7c1af0635bc\",\"post_competition_referral\":\"https://link.dice.fm/i2c7fd564546?dice_id=i2c7fd564546\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Lcbe854a0f67?dice_id=Lcbe854a0f67\",\"post_purchase_referral\":\"https://link.dice.fm/tcb29a09b662?dice_id=tcb29a09b662\",\"post_reminder_referral\":\"https://link.dice.fm/Jd037b0db58b?dice_id=Jd037b0db58b\",\"post_waitinglist_referral\":\"https://link.dice.fm/qbf3c99c012b?dice_id=qbf3c99c012b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"l8bdkx-battleship-potemkin-ft-live-original-score-27th-feb-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772218800,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:7\",\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-24/ea8ffa1e-6b3b-4517-b76f-e1c73d0ce483.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"697ceba8d0a0b20001cb3396\",\"name\":\"'Battleship Potemkin' ft. live original score \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Screening of Soviet silent film classic accompanied by Body Orchestra's live score onboard a historic ship. (Supported by BFI FAN)\\n\\nBack by popular demand, Body Orchestra are performing their original score, live, to Sergei Eisenstein's seminal movie, Battleship Potemkin (1925). Featuring field recordings of Bolshevik funeral marches, and manipulating the audio using reel to reel tape machines (inspired by Eisensteins signature collage techniques), Body Orchestra will accompany the film's dramatisation of the real life Russian Battleship mutiny in 1905 performing onboard an historic cargo ship.\\n\\nReturning from sell-out performance in 2024 at Theatreship, the music ranged from extended drone pieces, inspired by Morton Feldman's Rothko Chapel, to decomposing Shostakovich's 11th symphony (an interperetation of a Bolshevik funeral march about the Russian Revolution of 1905, which the film is based on).\\n\\n**This event is part of Silent Film with New Sound season at Theatreship.**\\n\\n**Programme supported by Film Hub London, managed by Film London. Proud to be a partner of the BFI Film Audience Network, funded by the National Lottery.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-02-27T22:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2026-02-27T19:00:00+00:00\",\"event_end_date\":\"2026-02-27T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Body Orchestra - Lights Out\",