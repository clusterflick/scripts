":null,\"new\":false,\"about\":{\"description\":\"Globetrotting, Australian-born soft-rock artist Joel Sarakula returns to his second home of London to present a show at The Social having previously performed at international festivals SXSW, Primavera and Glasto and having previously headlined The Hootananny and Paper Dress Vintage. Expect 70s-tinged soft-rock, disco and funk delivered with a wry, knowing smile.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T10:00:00+00:00\",\"sale_end_date\":\"2026-06-04T15:00:00+01:00\",\"sale_start_date\":\"2026-01-12T10:00:00+00:00\",\"event_start_date\":\"2026-06-04T19:30:00+01:00\",\"event_end_date\":\"2026-06-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Understanding\",\"redirect_url\":\"https://open.spotify.com/track/3Ki3vWUL6KlYB16Umfr8oM\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c1e07d26b56ac5b6a6be68376b764162027302c0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Understanding\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"RIOPY\",\"image\":null,\"artist_id\":\"27063\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Serious.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"605\",\"name\":\"Cadogan Hall\",\"address\":\"5 Sloane Terrace, London SW1X 9DQ\",\"location\":{\"lat\":51.4936625,\"lng\":-0.157574299999965},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-03/51395a8d-8b02-4ea1-9bcc-d92897eb2cd7.jp