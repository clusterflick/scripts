ce.fm/l96f1cb62dca?dice_id=l96f1cb62dca\",\"post_reminder_referral\":\"https://link.dice.fm/G0cfe0827006?dice_id=G0cfe0827006\",\"post_waitinglist_referral\":\"https://link.dice.fm/pda094bb680a?dice_id=pda094bb680a\"},\"perm_name\":\"ryaop5-hackney-folk-club-adam-beattie-home-fires-burning-album-launch-2nd-may-the-old-church-stoke-newington-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/bb2ef3f1-9c6b-4be8-b798-142af17d7242.jpg?rect=0%2C417%2C1667%2C1667\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/bb2ef3f1-9c6b-4be8-b798-142af17d7242.jpg?rect=0%2C750%2C1667%2C1000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/bb2ef3f1-9c6b-4be8-b798-142af17d7242.jpg?rect=146%2C0%2C1375%2C2500\"},\"properties\":[],\"about\":{\"description\":\"Acclaimed Scottish singer-songwriter Adam Beattie ‘Uplifting Reveries’ (Mojo Magazine) will be launching his new album 'Home Fires Burning'; a homespun epic which explores family, legacy and belonging. Adam writes melodies inspired by the traditional fiddle tunes of his childhood, played on finger-picked acoustic guitar.\\n\\nHis band will feature some of the finest traditional musicians who will put on night following the Hackney Folk Club's format:\\n\\n7pm - traditional session\\n\\n8pm - Floor spots\\n\\n9pm - Adam and his band\\n\\n10pm - traditional session\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6944180b1c856e0001064a50\",\"name\":\"Hackney Folk Club - Adam Beattie - Home Fires Burning Album Launch\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Adam Beattie - A Song of One Hundred Years\",\"redirect_url\":\"https://open.spotify.com/track/7AZ6BLqoXyCmzw6Ypa8LwX\",\"artist\":\"Adam Beattie\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c556683b0e61829e33064b368287b99f9816a0a6?