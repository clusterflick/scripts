\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2620,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Old Empire.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"80\",\"name\":\"Old Empire\",\"image\":{\"url\":null},\"perm_name\":\"old-empire-4n2q\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"bb8eax-agriculture-23rd-jun-bush-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"pre-sale\",\"date_unix\":1782237600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"announced\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:79\",\"venues\":[{\"id\":\"150\",\"name\":\"Bush Hall\",\"address\":\"310 Uxbridge Rd, London W12 7LJ\",\"location\":{\"lat\":51.5065655,\"lng\":-0.231633699999975},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-10-27/5f32c34f-a15a-457c-9953-ae3fe3a46464.jpg?rect=0%2C47%2C226%2C226\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"bush-hall-4bkk\",\"accessibility\":{\"url\":\"https://bushhallmusic.co.uk\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-23T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Agriculture \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-05/a878795e-6bc3-4ed0-9eb8-fbfe77894dc1.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"38463\",\"about\":null,\"is_headliner\":false},{\"name\":\"Healing Wound\",\"image\":null,\"artist_id\":\"121773\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"Old Empire and Odyssey Booking present AGRICULTURE\\n\\nplus special guests HEALING WOUND\\n\\nAgriculture is an ecstatic black metal band from Los Angeles. Their formation mirrors their duality. What began as a loose collaboration between Kern Haug and Dan Meyer in the Los Angeles noise scene evolved into a shared pursuit of the sublime through heavy music. With the additions of Richard Chowenhill and Leah Levinson, the project solidified into the band’s current form. The ecstatic black metal foundation that was laid on 2022’s The Circle Chant expanded into something more precise and far-reaching on their 2023 self-titled full-length, and deepened further with 2024’s Living Is Easy: a record that embraced devotional intensity and radiant heaviness in equal measure.\\n\\nThere’s a kind of quiet violence in how music is consumed today—flattened into background noise, sonic perfume fed into algorithms, sold as lifestyle. It’s entertainment as anesthesia. Sound without the weight. The Spiritual Sound, the new full-length from Los Angeles–based band Agriculture, stands as a pointed refusal of this condition. This is not a playlist. This is not a vibe. It is a demand.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ (Under 18’s accompanied)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-06-23T17:30:00+01:00\",\"sale_start_date\":\"2026-02-18T10:00:00+00:00\",\"event_start_date\":\"2026-06-23T19:00:00+01:00\",\"event_end_date\":\"2026-06-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6985d49a86d4e50001fa78c3\",\"name\":\"Agriculture\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/b5f58b34-1dfc-483b-a462-6d78f4eece7d.jpg?rect=167%2C0%2C1228%2C1228\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/b5f58b34-1dfc-483b-a462-6d78f4eece7d.jpg?rect=0%2C146%2C1562%2C937\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/b5f58b34-1dfc-483b-a462-6d78f4eece7d.jpg?rect=444%2C0%2C675%2C1228\"},\"marketeers\":[{\"id\":941,\"name\":\"Bush Hall\",\"privacy_policy_link\":\"https://bushhallmusic.co.uk/pages/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1300,\"name\":\"Old Empire \",\"privacy_policy_link\":null,\"fb_pixel_id\":\"252622951855502\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771236000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/c16500b09a65?dice_id=c16500b09a65\",\"post_competition_referral\":\"https://link.dice.fm/Vf70761fbf92?dice_id=Vf70761fbf92\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E3c16d60c2df?dice_id=E3c16d60c2df\",\"post_purchase_referral\":\"https://link.dice.fm/K056dd34b52b?dice_id=K056dd34b52b\",\"post_reminder_referral\":\"https://link.dice.fm/e3c5baf69dfb?dice_id=e3c5baf69dfb\",\"post_waitinglist_referral\":\"https://link.dice.fm/oba8fee5c024?dice_id=oba8fee5c024\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Living Is Easy\",\"redirect_url\":\"https://open.spotify.com/track/0kEGZei9rQQYttjDyEQ4rj\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/44f72f018396be3878ccd1d0660e4d7e4baf9023?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Living Is Easy\"},{\"type\":\"apple_music\",\"title\":\"Agriculture - Living Is Easy\",\"redirect_url\":\"https://music.apple.com/us/album/living-is-easy/1728307951?i=1728307952&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Agriculture\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/7e/84/3b/7e843b95-82a8-e6c2-ac79-634a3077c053/mzaf_16246749763598248308.plus.aac.p.m4a\",\"track_name\":\"Living Is Easy\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4218},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Born Again Concerts.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k6ank9-queensrche-europe-summer-2026-23rd-jun-islington-assembly-hall-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782237600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":8,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:80\",\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-23T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Queensrÿche\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf765584aca5c90004d25c1e6\"},\"artist_id\":\"11456\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"QUEENSRŸCHE are an American Progressive Metal band. They formed in 1980 in Bellevue, Washington, and first went by CROSS+FIRE and then by THE MOB before settling on their current name in 1982. The band have released 16 studio albums, one EP, and several DVDs, and continues to tour and record. The original lineup consisted of guitarists Michael Wilton and Chris DeGarmo, drummer Scott Rockenfield and bassist Eddie Jackson; lead vocalist Geoff Tate was recruited in 1982 to round out the band.\\n\\nGuitarist Michael Wilton has stated that the band has been demoing new material while on the road, and is hoping to enter the studio to record the follow-up to Digital Noise Alliance sometime in 2026.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T10:00:00+00:00\",\"sale_end_date\":\"2026-06-23T21:00:00+01:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-06-23T19:00:00+01:00\",\"event_end_date\":\"2026-06-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696f7fda4abf7c0001d62d90\",\"name\":\"Queensrÿche: Europe Summer 2026\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/153c3006-7e8b-4373-bddf-7250e217c884.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/153c3006-7e8b-4373-bddf-7250e217c884.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/153c3006-7e8b-4373-bddf-7250e217c884.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768989600,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/ja08715b6779?dice_id=ja08715b6779\",\"post_competition_referral\":\"https://link.dice.fm/F8190d2b3d71?dice_id=F8190d2b3d71\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ga7453fd19ad?dice_id=ga7453fd19ad\",\"post_purchase_referral\":\"https://link.dice.fm/j711753ad15f?dice_id=j711753ad15f\",\"post_reminder_referral\":\"https://link.dice.fm/o85519b10f00?dice_id=o85519b10f00\",\"post_waitinglist_referral\":\"https://link.dice.fm/a906d98a1214?dice_id=a906d98a1214\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Queensrÿche - Silent Lucidity\",\"redirect_url\":\"https://itunes.apple.com/gb/album/silent-lucidity/723424865?i=723425523&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Queensrÿche\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview128/v4/d1/c0/14/d1c0147a-d187-8d28-806c-a97916d09156/mzaf_5556166625503318533.plus.aac.p.m4a\",\"track_name\":\"Silent Lucidity\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Tue 23 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5894},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Labyrinth.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":23131,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23132,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"92wkq7-empire-of-the-sun-24th-jun-alexandra-palace-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782322200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:81\",\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-06-24T18:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Empire of the Sun\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-16/bc70c483-bd51-4b09-b789-fea5b56afd71.jpg?rect=262%2C0%2C4125%2C4125\"},\"artist_id\":\"12765\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"June 26th & 27th sold out, June 24th added due to incredible demand. A third & final date and a historic moment for Empire of the Sun.\\n\\nThe visionary Empire of the Sun are set to make a magical Alexandra Palace debut this June with their Ask That God tour.\\n\\nExpect a journey through Empire Of The Sun’s multi-platinum catalogue, which has amassed over 7.6 billion streams worldwide, interwoven with new material from their latest album. With 34.5 million monthly Spotify listeners, fans can look forward to era-defining anthems including Walking on a Dream, We Are The People, Alive and High & Low, alongside expansive new works that reflect the band’s ever-evolving creative spirit, all brought to life through their trademark cinematic visuals and immersive stage production.\\n\\nThe indie-electronic pioneers will illuminate the Grade II-listed hilltop palace, a site synonymous with iconic performances. For this special London date, the band will unveil an immersive stage production crafted specifically for the venue, transforming the space into an otherworldly realm of light, sound and spectacle.\\n\\nFresh off the immediate sell-out of their show at Labyrinth on the Thames, which marked the band’s return to the UK for the first time in six years, signing up is essential.\\n\\nPre-sale tickets go live Feb 5th at 11am, exclusively to those who sign up. Sign up is essential.\\n\\n*If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally*\\n\\n*Venue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#*\\n\\n*Price includes a £2.50 venue restoration levy.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T17:00:00+00:00\",\"sale_end_date\":\"2026-06-24T21:00:00+01:00\",\"sale_start_date\":\"2026-02-06T11:00:00+00:00\",\"event_start_date\":\"2026-06-24T18:30:00+01:00\",\"event_end_date\":\"2026-06-24T22:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"698087a1af2c730001930506\",\"name\":\"Empire of the Sun\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/098d9d22-228a-43c8-939b-7b00f5732e70.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/098d9d22-228a-43c8-939b-7b00f5732e70.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/098d9d22-228a-43c8-939b-7b00f5732e70.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":471,\"name\":\"Labyrinth Events\",\"privacy_policy_link\":\"https://www.labyrinthevents.com/terms\",\"fb_pixel_id\":\"1410823875730293\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CQU8ARJC77UCRPC5TAV0\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770051600,\"donation\":{\"description\":\"Love Ally Pally? Add a donation to care for the Palace and Park. Your gift helps to protect and restore this special place — for everyone, forever.\\n\\nA percentage of your donation goes towards a payment processing fee (neither DICE or the charity keep any of this fee). For a £10 donation, the charity gets £9.75\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4Mzc3MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUwMjkwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjowMy43MTgzMzJaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzU0OSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4Mzc3MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUwMjkwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjowMy43MTgzNzNaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzU1MCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4Mzc3MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUwMjkwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjowMy43MTgzOTVaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6MzU1MSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4Mzc3MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUwMjkwLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjowMy43MTg0MTVaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjM1NTIsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Alexandra Park and Palace Charitable Trust\",\"charity_registration_number\":\"281991\"},\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/J16294b667e6?dice_id=J16294b667e6\",\"post_competition_referral\":\"https://link.dice.fm/ec188e3451a4?dice_id=ec188e3451a4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kf9b194d1a28?dice_id=kf9b194d1a28\",\"post_purchase_referral\":\"https://link.dice.fm/b8304c73a3cd?dice_id=b8304c73a3cd\",\"post_reminder_referral\":\"https://link.dice.fm/Cb81b5f91ea3?dice_id=Cb81b5f91ea3\",\"post_waitinglist_referral\":\"https://link.dice.fm/t817137a7594?dice_id=t817137a7594\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Empire of the Sun - Walking On a Dream\",\"redirect_url\":\"https://itunes.apple.com/gb/album/walking-on-a-dream/712862605?i=712862708&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Empire of the Sun\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview128/v4/91/85/96/918596a1-2869-1705-806e-8c256db576af/mzaf_5291754557625606715.plus.aac.p.m4a\",\"track_name\":\"Walking On a Dream\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1575},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Rough Trade.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":76950,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":76951,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":76952,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":76953,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":76954,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":76955,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":76956,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":76957,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":76958,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":76959,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"v39all-life-live-signing-24th-jun-rough-trade-east-london-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782324000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:82\",\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-24T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"LIFE\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-07-09/277cfc28-89d7-4d23-b6a7-90b0106d5c21.jpg?rect=350%2C0%2C1400%2C1400\"},\"artist_id\":\"2247\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Rough Trade East is very excited to present an live performance and signing from LIFE. This unique event celebrates the release of their new album 'Abstract / Natural' released via Launchpad+.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> LINK\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T14:00:00+00:00\",\"sale_end_date\":\"2026-06-24T22:00:00+01:00\",\"sale_start_date\":\"2026-02-16T17:00:00+00:00\",\"event_start_date\":\"2026-06-24T19:00:00+01:00\",\"event_end_date\":\"2026-06-24T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"69933ed4d573390001a54689\",\"name\":\"LIFE: Live + Signing\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/596ec273-1b9a-440c-9cf2-6ebd6d644f83.jpg?rect=1000%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/202