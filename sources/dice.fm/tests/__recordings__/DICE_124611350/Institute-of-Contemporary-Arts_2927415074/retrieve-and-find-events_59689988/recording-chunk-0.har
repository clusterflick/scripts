don/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-10T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/6ebcf62f-457b-4422-8882-2b734324ea88.jpg?rect=342%2C0%2C1365%2C1365\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/6ebcf62f-457b-4422-8882-2b734324ea88.jpg?rect=0%2C68%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/6ebcf62f-457b-4422-8882-2b734324ea88.jpg?rect=649%2C0%2C751%2C1365\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/k5a22c7d9df2?dice_id=k5a22c7d9df2\",\"post_competition_referral\":\"https://link.dice.fm/ade4cec263e8?dice_id=ade4cec263e8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S3266900b058?dice_id=S3266900b058\",\"post_purchase_referral\":\"https://link.dice.fm/Jc1ad69f65dc?dice_id=Jc1ad69f65dc\",\"post_reminder_referral\":\"https://link.dice.fm/P96a4ad6f187?dice_id=P96a4ad6f187\",\"post_waitinglist_referral\":\"https://link.dice.fm/e1f5d448ddfe?dice_id=e1f5d448ddfe\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:54\",\"properties\":[],\"presented_by\":\"Presented by 229.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764158400,\"id\":\"691f3745b246f40001fb927c\",\"name\":\"Two Trains Left\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Two Trains Left are redefining modern pop-punk. Since their formation in Paris, the band has been crafting heartfelt songs that blend nostalgic energy with a fresh perspective.\\n\\nWith emotionally driven lyrics, catchy melodies, and explosive live performances, They've made a name for themselves across France and beyond, touring with Chunk! No, Captain Chunk!, performing at Mvrksfest, and opening for international acts like Neck Deep or Four Year Strong.\\n\\nFollowing the release of their debut album 'Probably For Nothing'  in 2024, Two Trains Left are ready to take their sound to the next level, louder, bolder, and more honest than ever.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"date_unix\":1775844000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2842,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T16:00:00+00:00\",\"sale_end_date\":\"2026-04-10T16:00:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-04-10T19:00:00+01:00\",\"event_end_date\":\"2026-04-10T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"xe7e9m-searows-10th-apr-koko-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":57822,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Searows\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-23/098d478e-a870-43cd-b165-01856a0744fe.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"90908\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-10T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/8b0064f8-d651-42f6-b094-38eec08d17e2.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/8b0064f8-d651-42f