post_purchase_extras_available_referral\":\"https://link.dice.fm/O21a3837e29a?dice_id=O21a3837e29a\",\"post_purchase_referral\":\"https://link.dice.fm/y42b94b65303?dice_id=y42b94b65303\",\"post_waitinglist_referral\":\"https://link.dice.fm/nbb2eff7eff8?dice_id=nbb2eff7eff8\",\"post_reminder_referral\":\"https://link.dice.fm/E53431ec45d9?dice_id=E53431ec45d9\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"457\",\"name\":\"The Jago\",\"address\":\"440 Kingsland Road, Hackney, London, E8 4AA, United Kingdom\",\"location\":{\"lat\":51.541884,\"lng\":-0.076346},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jago-4pby\",\"accessibility\":{\"url\":\"https://www.thejagodalston.com/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T22:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Following the last roadblock session Colombian vinyl selector Moralito reunites with Movimientos’ Cal Jader for another special night of tropical vinyl treats celebrating the best in Salsa, Cumbia, Merengue, Tropical Disco and other Afro-Latin sounds & beyond. Plus special guests and live percussion!\\n\\n**Moralito Moralito** is a Colombian record collector and DJ known for his danceable and psychedelic sounds. He is one of the founders of Latin underground party Clandestina and hosts the show Alma on Portobello Radio. Rooted in Latin and Afro rhythms, his sets range from salsa, cumbia, and soukous to funk, disco, and jazz. He's a regular performer in London, including appearances at venues like Space Talk, Jazu, The Jago, Fox & Firkin, Bar Doña, and The Coral Room.\\n\\n**Cal Jader** blends a distinctive mix of Latin, Tropical and global sounds from delicious Salsa, Cumbia and Merengue to exquisite Afro-Caribbean, Brazilian grooves and dancehall. Over his two vinyl sets for My Analog Journal he has almost half a million plays and currently holds down a monthly show on Soho Radio.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:62\",\"billing_promoter\":{\"id\":\"2296\",\"name\":\"Movimientos\",\"image\":{\"url\":null},\"perm_name\":\"movimientos-6ey2\",\"profile_active\":false},\"presented_by\":\"Presented by Movimientos.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1771200000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-03-27T19:00:00+00:00\",\"sale_start_date\":\"2026-02-16T19:00:00+00:00\",\"event_start_date\":\"2026-03-27T22:00:00+00:00\",\"event_end_date\":\"2026-03-28T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6993593fd5ca2d0001105498\",\"name\":\"Tropical Sounds on Vinyl\",\"price\":{\"currency\":\"GBP\",\"amount\":660,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"eorgg2-madmoizel-27th-mar-the-waiting-room-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\