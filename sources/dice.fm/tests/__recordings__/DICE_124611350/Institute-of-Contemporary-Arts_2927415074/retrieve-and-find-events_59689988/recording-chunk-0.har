ks\":{\"event_share\":\"https://link.dice.fm/F36405b378f1?dice_id=F36405b378f1\",\"post_competition_referral\":\"https://link.dice.fm/n3668509e772?dice_id=n3668509e772\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Y3b44e09dbe5?dice_id=Y3b44e09dbe5\",\"post_purchase_referral\":\"https://link.dice.fm/h09539f1cce3?dice_id=h09539f1cce3\",\"post_reminder_referral\":\"https://link.dice.fm/Y5edf2d7207e?dice_id=Y5edf2d7207e\",\"post_waitinglist_referral\":\"https://link.dice.fm/j24b9af6a463?dice_id=j24b9af6a463\"},\"perm_name\":\"l8ov7w-professor-elemental-mr-b-the-gentleman-rhymer-thomas-benjamin-wild-esq-1st-may-new-cross-inn-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/b9198b5b-031b-404a-a29e-8653aa680853.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/b9198b5b-031b-404a-a29e-8653aa680853.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/b9198b5b-031b-404a-a29e-8653aa680853.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"The 'BRING THE JOYS' Tour\\n\\nFeaturing the magnificent musical talents of Professor Elemental, Mr. B The Gentleman Rhymer and Thomas Benjamin Wild Esq. as they embark on their maiden voyage together. Prepare to be dazzled by feats of unequalled lyrical wizardry and razor-sharp wit as the crown princes of Chap Hop bring smiles to all those fortunate enough to obtain a ticket for this spectacular event. Get those knees up and the kettle on; things are about to get a little bit splendid.\\n\\nhttps://mrbthegentlemanrhymer.bandzoogle.com/\\n\\nhttps://www.professorelemental.com/\\n\\nhttps://tombwild.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69258cb8a534590001d847a6\",\"name\":\"Professor Elemental + Mr B The Gentleman Rhymer + Thomas Benjamin Wild Esq.\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Fighting Trousers\",\"redirect_url\":\"https://open.spotify.com/track/5d26M7OhCTM7TLeHJOFkg0\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7ec7af33ac2f2d7a6783e9c9677cedb353bfa5aa?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Fighting Trousers\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Thomas Benjamin Wild Esq.\",\"image\":null,\"artist_id\":\"92689\",\"about\":null,\"is_headliner\":false},{\"name\":\"Professor Elemental \",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273dfcf9aae015473883c1fda92\"},\"artist_id\":\"13860\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mr. B The Gentleman Rhymer\",\"image\":null,\"artist_id\":\"110047\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-27T17:30:00+01:00\",\"sale_end_date\":\"2026-04-30T18:30:00+01:00\",\"sale_start_date\":\"2025-08-29T10:00:00+01:00\",\"event_start_date\":\"2026-05-01T18:30:00+01:00\",\"event_end_date\":\"2026-05-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":40552,\"title\":\"FAQs for The O2\",\"body\":\"Further information about visiting The O2 can be found at https://help.theo2.co.uk/hc/en-gb\",\"order\":0},{\"id\":40553,\"title\":\"How to book accessible tickets for The O2\",\"body\":\"Accessible Seating Accessible bookings can be purchased online when selecting the event via www.theo2.co.uk and visiting the https://www.theo2.co.uk/visit-us/accessibility (copy to browser), DICE do not process any Accessible tickets for any event at The O2.\",\"order\":1},{\"id\":40554,\"title\":\"How tickets work for The O2\",\"body\":\"Tickets will be in The O2 venue app as they’re handling ticket scanning for this event. We will email you when your tickets are available in the app.\\n\\nHow to use your tickets:\\n\\n1\\\\. Get The O2 venue app - https://www.theo2.co.uk/visit-us/the-o2-app\\n\\n2\\\\. Sign up using the email you used to purchase your tickets on DICE\\n\\n3\\\\. At the door, show your tickets on the venue app (not DICE)\",\"order\":2},{\"id\":40812,\"title\":\"Can I change my seat?\",\"body\":\"Seats can’t be changed after booking, so please review your selection carefully before checkout.\",\"order\":3}],\"marketeers\":[{\"id\":191,\"name\":\"Olivia Dean (via Universal Music)\",\"privacy_policy_link\":\"https://www.umusic.co.uk/privacy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2127,\"name\":\"The O2, London\",\"privacy_policy_link\":\"https://www.theo2.co.uk/legal/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"unicorn_extras\":false,\"seats_io_event_id\":\"b4ca88da-a525-4253-b195-7eee1e278ba3\",\"presented_by\":\"Presented by Communion ONE.\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"b4ca88da-a525-4253-b195-7eee1e278ba3\",\"seats_io_public_key\":\"91b87c00-af06-457c-b5e8-4d8f0af2ae7f\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1756312200,\"venues\":[{\"id\":\"584\",\"name\":\"The O2, London\",\"address\":\"O2 Arena\",\"location\":{\"lat\":51.5025248,\"lng\":0.00366410000003725},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-o2-london-q2xy\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-01T18:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":\"91b87c00-af06-457c-b5e8-4d8f0af2ae7f\",\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"14302\",\"name\":\"Communion ONE\",\"image\":{\"url\":null},\"perm_name\":\"communion-one-bbl7g\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:2\",\"date_unix\":1777656600,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6889},\"social_links\":{\"event_share\":\"https://link.dice.fm/U07b90b07c79?dice_id=U07b90b07c79\",\"post_competition_referral\":\"https://link.dice.fm/M67ec8a61669?dice_id=M67ec8a61669\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/oab6f07dd14e?dice_id=oab6f07dd14e\",\"post_purchase_referral\":\"https://link.dice.fm/g688809c3fba?dice_id=g688809c3fba\",\"post_reminder_referral\":\"https://link.dice.fm/i79d657caacc?dice_id=i79d657caacc\",\"post_waitinglist_referral\":\"https://link.dice.fm/Rb9299bc77c2?dice_id=Rb9299bc77c2\"},\"perm_name\":\"wwgk2v-olivia-dean-1st-may-the-o2-london-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-21/4b0085a1-4147-460d-83eb-7b26310de973.jpg?rect=270%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"Standing: Over 16s only. Seated: Under 15s must be accompanied by an adult over 18.\\n\\nOlivia Dean has partnered with PLUS1 so that £1 (+ VAT) per ticket goes to supporting the LIVE Trust (Charity Number: 1211251) and their work supporting those who are keeping venues open, festivals trading, artists touring and all those involved in the promoting and staging of live music performances.\\n\\nThere is a £3.25 Venue Facility Fee included in the ticket price.\\n\\nAccessible Seating Accessible bookings can be purchased online when selecting the event via www.theo2.co.uk and visiting the https://www.theo2.co.uk/visit-us/accessibility (copy to browser), DICE do not process any Accessible tickets for any event at The O2.\\n\\nOlivia Dean’s highly anticipated sophomore album The Art of Loving went straight in at #1 on the UK album charts, alongside hit single ‘Man I Need’ which also peaked at #1 in the UK singles chart - becoming the first solo British Female artist to claim the #1 single & #1 album simultaneously since Adele in 2021. Olivia also announced two more dates for her residency at The O2 in London on the 11th & 12th of June, adding to her biggest ever UK and EU tour, which kicks off in April 2026. Tickets for the new dates are available here: https://link.dice.fm/x2e53627ec0d\\n\\nThe tour will commence at Glasgow’s OVO Hydro on April 23rd, before embarking cross-country and culminating in six huge shows at The O2 in London - including four in April / May and two new additional nights in June as part of her O2 residency. Olivia also takes her exceptional live show across Europe performing tracks from The Art of Loving as well as live favourites off her Mercury Prize nominated debut, Messy.\\n\\nSpeaking on her chart success, Olivia said: “I feel very grateful and overwhelmed! I love the album I made and I’m so proud of myself for making it. But ultimately it is so joyful seeing how much it means to people and how it’s helping people understand love and loving.”\\n\\nOlivia currently also holds three of the top 10 biggest British singles released in 2025 so far, as well as The Art of Loving garnering the biggest opening week for a British female artist since Adele in 2021, according to Official Charts. The record, which includes fan favourites ‘Nice To Each Other’ and lead single ‘So Easy (To Fall In Love)’, quickly rose to Number 1 on the Official Albums Chart, and hit single ‘Man I Need’ became the highest charting song from a UK act on Spotify’s Global Charts this year, as well as charting at #25 (to date) on the Billboard Hot 100. The Art of Loving has since become the fastest selling album for a British female artist in 2025.\\n\\nStanding: Over 16s only. Seated: Under 15s must be accompanied by an adult over 18.\",\"highlights\":[]},\"id\":\"68af2cb2c6893400012a923f\",\"name\":\"Olivia Dean\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Danger\",\"redirect_url\":\"https://open.spotify.com/track/1zAITH7C5UFYNE8DOFlE7h\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/54a534c34e5c124540cc1463d2cb36e3674e9833?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Danger\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Olivia Dean\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-22/0f34a8d2-2acd-4aa9-a2bd-6c2993f875db.jpg?rect=0%2C0%2C1200%2C1200\"},\"artist_id\":\"13260\",\"about\":null,\"is_headliner\":false}