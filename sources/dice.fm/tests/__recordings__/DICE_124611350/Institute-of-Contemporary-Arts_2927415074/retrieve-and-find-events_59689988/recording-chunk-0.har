g_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"presented_by\":\"Presented by Rough Trade.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ego Ella May\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-19/2149c4a6-5a31-4f2c-ab0c-2431ac5f5875.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"6951\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1768217400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T11:30:00+00:00\",\"sale_end_date\":\"2026-03-20T19:00:00+00:00\",\"sale_start_date\":\"2026-01-14T10:00:00+00:00\",\"event_start_date\":\"2026-03-20T19:00:00+00:00\",\"event_end_date\":\"2026-03-20T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6964e08f947711000157acc6\",\"name\":\"Ego Ella May: Acoustic + Signing\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Ego Ella May - We're Not Free\",\"redirect_url\":\"https://open.spotify.com/track/715GdTHoLH2FOLfZ3GCvi9\",\"artist\":\"Ego Ella May\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ce4de440a89e622e81e8ac4c4df5f028181c94fb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"We're Not Free\"},{\"type\":\"apple_music\",\"title\":\"Ego Ella May - We're Not Free\",\"redirect_url\":\"https://music.apple.com/us/album/were-not-free/1840168998?i=1840169473&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ego Ella May\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/7a/a3/00/7aa300d5-be5e-96e0-81b6-b960755e393d/mzaf_17834892127593381311.plus.aac.p.m4a\",\"track_name\":\"We're Not Free\"}],\"faqs\":[{\"id\":68680,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":68681,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":68682,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":68683,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":68684,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":68685,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":68686,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":68687,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":68688,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":68689,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"score\":0,\"shopping_cart_enabled\":true,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"av3lqv-the-phonics-20th-mar-hootananny-brixton-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774033200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/3655757c-fd70-4765-98a1-313d2ddc2869.jpg?rect=0%2C249%2C2805%2C2805\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/3655757c-fd70-4765-98a1-313d2ddc2869.jpg?rect=0%2C913%2C2805%2C1683\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/3655757c-fd70-4765-98a1-313d2ddc2869.jpg?rect=438%2C0%2C1929%2C3508\"},\"max_tickets\":6,\"social_links\":{\"e