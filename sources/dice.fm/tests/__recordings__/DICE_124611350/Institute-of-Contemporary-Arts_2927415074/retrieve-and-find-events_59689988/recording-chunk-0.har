"date_unix\":1780941600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:7\",\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-08T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"about\":{\"description\":\"Marking the 60th anniversary of \\\\*John Mayall’s Blues Breakers with Eric Clapton\\\\*, Sonny Flint’s Beano Bluesbreakers faithfully recreates the sound and spirit of this seminal British blues recording. With the Beano LP performed in full, plus additional songs from the original live set, the project focuses on authenticity and musical detail.\\n\\nThe band features unique heritage connections, with drummer Sonny Flint, the son of original Bluesbreakers drummer Hughie Flint, and vocalist Laine Hines, the son of Denny Laine of The Moody Blues and Wings. The result is a respectful, authoritative tribute to one of the albums that defined British blues.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-18T00:00:00+00:00\",\"sale_end_date\":\"2026-06-08T19:00:00+01:00\",\"sale_start_date\":\"2026-01-18T00:00:00+00:00\",\"event_start_date\":\"2026-06-08T19:00:00+01:00\",\"event_end_date\":\"2026-06-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696d28376d7024000175282d\",\"name\":\"Sonny Flint’s Beano Bluesbreakers\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-18/5e931de3-cdc7-4ae1-9a58-440a5c873168.jpg?rect=0%2C0%2C1800%2C1800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-18/5e931de3-cdc7-4ae1-9a58-440a5c873168.jpg?rect=0%2C360%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-18/5e931de3-cdc7-4ae1-9a58-440a5c873168.jpg?rect=405%2C0%2C990%2C1800\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768694400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/qefd3216aead?dice_id=qefd3216aead\",\"post_competition_referral\":\"https://link.dice.fm/kee34ba71afa?dice_id=kee34ba71afa\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u01403ca96d3?dice_id=u01403ca96d3\",\"post_purchase_referral\":\"https://link.dice.fm/i283d439c7a1?dice_id=i283d439c7a1\",\"post_reminder_referral\":\"https://link.dice.fm/w1c8e81862d8?dice_id=w1c8e81862d8\",\"post_waitinglist_referral\":\"https://link.dice.fm/g1516b704053?dice_id=g1516b704053\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3605},\"seats_io_public_key\":null,\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"rylw7w-leo-kottke-sold-out-8th-jun-229-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1780941600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:8\",\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-08T19:00:00+01:00\",\"doors_close_date\":\"2026-06-08T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Leo Kottke\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-19/3cbae2a4-901d-43e4-b30f-6711d6e2251d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"113421\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Acoustic guitarist Leo Kottke was born in Athens, Georgia, but left town after a year and a half. Raised in 12 different states, he absorbed a variety of musical influences as a child, flirting with both violin and trombone, before abandoning Stravinsky for the guitar at age 11.\\n\\nAfter adding a love for the country-blues of Mississippi John Hurt to the music of John Phillip Sousa and Preston Epps, he issued his 1968 recording debut LP Twelve String Blues, for the Oblivion label.\\n\\nLeo Kottke released his major-label debut, 'Mudlark', in 1971. Kottke flourished during his tenure on Capitol Records, as records like 'Greenhouse' (1972) and 'My Feet Are Smiling' (1973) found him branching out with guest musicians and honing his guitar technique.\\n\\nHis recent collaboration with Phish bassist Mike Gordon, 'Clone', caught audiences’ attention in 2002. Kottke and Gordon followed with a recording in the Bahamas called 'Sixty Six Steps', produced by Leo’s old friend and Prince producer David Z.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-01T00:00:00+01:00\",\"sale_end_date\":\"2026-06-08T17:00:00+01:00\",\"sale_start_date\":\"2025-07-01T00:00:00+01:00\",\"event_start_date\":\"2026-06-08T19:00:00+01:00\",\"event_end_date\":\"2026-06-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6863cde703ded80001f799d8\",\"name\":\"Leo Kottke - SOLD OUT\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-07/e5a9871c-dc17-4c4c-85a9-b5067bf8807b.jpg?rect=274%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-07/e5a9871c-dc17-4c4c-85a9-b5067bf8807b.jpg?rect=18%2C0%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-07/e5a9871c-dc17-4c4c-85a9-b5067bf8807b.jpg?rect=447%2C0%2C422%2C768\"},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1751324400,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Cc1510d22da3?dice_id=Cc1510d22da3\",\"post_competition_referral\":\"https://link.dice.fm/Fad916fd26a7?dice_id=Fad916fd26a7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p4a02919535a?dice_id=p4a02919535a\",\"post_purchase_referral\":\"https://link.dice.fm/v408627813a9?dice_id=v408627813a9\",\"post_reminder_referral\":\"https://link.dice.fm/Y466274c3868?dice_id=Y466274c3868\",\"post_waitinglist_referral\":\"https://link.dice.fm/pc15d561d31d?dice_id=pc15d561d31d\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Mon 08 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":75413,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":75414,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":75415,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"l893kl-spitting-glass-9th-jun-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781028000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:9\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-09T19:00:00+01:00\",\"doors_close_date\":\"2026-06-09T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Spitting Glass\",\"image\":null,\"artist_id\":\"133753\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"The grass is never greener.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T10:00:00+00:00\",\"sale_end_date\":\"2026-06-09T17:30:00+01:00\",\"sale_start_date\":\"2026-02-11T10:00:00+00:00\",\"event_start_date\":\"2026-06-09T19:00:00+01:00\",\"event_end_date\":\"2026-06-09T23:00:00+01:00\",\"is_multi_days_event\":