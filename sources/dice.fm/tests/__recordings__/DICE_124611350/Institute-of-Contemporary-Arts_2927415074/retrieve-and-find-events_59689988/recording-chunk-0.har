s_available_referral\":\"https://link.dice.fm/Q09a24debc39?dice_id=Q09a24debc39\",\"post_purchase_referral\":\"https://link.dice.fm/Ra1f5573ce25?dice_id=Ra1f5573ce25\",\"post_waitinglist_referral\":\"https://link.dice.fm/t4e870ee5e54?dice_id=t4e870ee5e54\",\"post_reminder_referral\":\"https://link.dice.fm/B50f336c5ab8?dice_id=B50f336c5ab8\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-23T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":\"rescheduled\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"***Crymwav*** (pronounced “Crimewave”) formed in 2022 from the ashes of Los Angeles rock & rollers Smash Fashion. Drawing inspiration from punk, post-punk, gothic rock, & NWOBHM, the band weaves their collective influences into a sound that’s fresh yet familiar, with nods to iconic acts like Hawkwind, The Clash, Killing Joke, Thin Lizzy & UFO.\\n\\nCrymwav’s self-released 2023 EP, 24/7, garnered rave reviews and international airplay. Guitar World Magazine described it as “Channeling the furious fire of Motörhead and UFO, cut through with the melodic sensibilities of Cheap Trick.\\n\\nIn 2025, continued to prove there is a Crymwav coming with release of two new songs with accompanying videos garnishing rave reviews and worldwide airplay along with their videos racking up over 266 thousand views combined.\\n\\nPower Punk trio ***The Viral Breakdowns*** offer a glimpse of life from here there & everywhere. Holding up a mirror to the world they see around them, through their own brand of original DIY punk rock, with stripped down, riff driven tunes, driving rhythms & lyrical wit, The Viral’s spread an underlying yet unmistakable message of defiance through melody.\\n\\nIn March 2021, 42 years after their debut single, ***The Stereotypes*** released their debut album, ‘ForWard'. With new songs & revamped versions of the originals. Radio play in the UK, Austria, Belgium, France & July 2021's edition of Record Collector namechecks the band on the front cover with a 2 page feature on their story.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:45\",\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"marketeers\":[],\"announcement_date_unix\":1767916800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-23T19:00:00+00:00\",\"sale_start_date\":\"2026-01-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-23T19:00:00+00:00\",\"event_end_date\":\"2026-03-23T23:00:00+00:00\",\"