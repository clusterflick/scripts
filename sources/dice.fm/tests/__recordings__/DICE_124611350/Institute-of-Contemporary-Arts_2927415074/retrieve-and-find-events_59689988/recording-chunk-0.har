ndscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/dbd35dd5-c2a3-440b-aa10-23cb805729ff.jpg?rect=0%2C576%2C1414%2C848\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/dbd35dd5-c2a3-440b-aa10-23cb805729ff.jpg?rect=157%2C0%2C1100%2C2000\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769882400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/A94c46e3a350?dice_id=A94c46e3a350\",\"post_competition_referral\":\"https://link.dice.fm/bdf0de808f0a?dice_id=bdf0de808f0a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u73260f251e0?dice_id=u73260f251e0\",\"post_purchase_referral\":\"https://link.dice.fm/m98dc073cbe1?dice_id=m98dc073cbe1\",\"post_reminder_referral\":\"https://link.dice.fm/L07d429f02cd?dice_id=L07d429f02cd\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pf80839d7dd0?dice_id=Pf80839d7dd0\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Tümba - Beyond the Thunder\",\"redirect_url\":\"https://open.spotify.com/track/11k8O3Cpe9huGNl29eObtT\",\"artist\":\"Tümba\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0e3904de9abec9c2896d8fec4873fd6be7ab4836?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Beyond the Thunder\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Portals\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"v3qn96-st-barbe-6th-mar-the-black-heart-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772823600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:68\",\"venues\":[{\"id\":\"98\",\"name\":\"The Black Heart\",\"address\":\"2-3 Greenland Pl, London NW1 0AP\",\"location\":{\"lat\":51.5387812,\"lng\":-0.141761200000019},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-28/687dc696-b005-45e0-a194-c89d23ee7bed.jpg?rect=1%2C0%2C2716%2C2716\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-black-heart-4bev\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"St. Barbe\",\"image\":null,\"artist_id\":\"34363\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Portals are excited to present rising stars St. Barbe for the launch of their new EP Shoal.\\n\\nKnown for their progressive, genre-bending brand of jazz, St. Barbe are set to release their second EP Shoal in 2026, featuring a collaboration with Mercury-shortlisted artist corto.alto.\\n\\nFormed in 2021, the band debuted with Shapeless, earning support from Spotify editorial playlists and a feature in Guitar Magazine. They have twice sold out Ronnie Scott’s Jazz Club, opened for Mike Stern at the Jazz Café, and supported math-rock outfit Cobota. In 2025, singles Tierra and Pinch received national radio support from Jazz FM, BBC Radio 3 and BBC Radio 6 Music, alongside editorial playlisting on Spotify and Apple Music.\\n\\nWith over half a million streams to date, St. Barbe have built a cult following around an impossible-to-pin-down sound drawing equally from jazz, post-rock and metal.\\n\\nSupport tba.\\n\\nwww.portalsrock.com/gigs\\n\\nhttps://www.stbarbeband.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T18:00:00+00:00\",\"sale_end_date\":\"2026-03-06T18:00:00+00:00\",\"sale_start_date\":\"2026-01-26T18:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"697791c4020ddf0001c925b8\",\"name\":\"St. Barbe\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/1d3b2124-738d-49b2-849b-06e3742d582b.jpg?rect=0%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/1d3b2124-738d-49b2-849b-06e3742d582b.jpg?rect=0%2C800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/1d3b2124-738d-49b2-849b-06e3742d582b.jpg?rect=900%2C0%2C2200%2C4000\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769450400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Hb06b04f0f04?dice_id=Hb06b04f0f04\",\"post_competition_referral\":\"https://link.dice.fm/S87071cc2499?dice_id=S87071cc2499\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J6da5fafac90?dice_id=J6da5fafac90\",\"post_purchase_referral\":\"https://link.dice.fm/Cb158ff739ca?dice_id=Cb158ff739ca\",\"post_reminder_referral\":\"https://link.dice.fm/E4e4539d8e99?dice_id=E4e4539d8e99\",\"post_waitinglist_referral\":\"https://link.dice.fm/d909e16b73ea?di