secondary_status\":null,\"new\":false,\"about\":{\"description\":\"DHP Presents :\\n\\nVENT 414\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T10:00:00+00:00\",\"sale_end_date\":\"2026-06-04T15:00:00+01:00\",\"sale_start_date\":\"2026-02-20T10:00:00+00:00\",\"event_start_date\":\"2026-06-04T19:00:00+01:00\",\"event_end_date\":\"2026-06-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dead Pony\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-28/64f2deb3-4cdb-4a8f-acb9-7ae42b14c777.jpg?rect=0%2C53%2C534%2C534\"},\"artist_id\":\"56310\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by AEG\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":76462,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":76463,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":76464,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-04T19:00:00+01:00\",\"doors_close_date\":\"2026-06-04T23:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1771236000,\"social_links\":{\"event_share\":\"https://link.dice.fm/F1938177bbd6?dice_id=F1938177bbd6\",\"post_competition_referral\":\"https://link.dice.fm/uf831ee4200e?dice_id=uf831ee4200e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P102db6508f6?dice_id=P102db6508f6\",\"post_purchase_referral\":\"https://link.dice.fm/I8ceab041ff9?dice_id=I8ceab041ff9\",\"post_reminder_referral\":\"https://link.dice.fm/ib109713a4d3?dice_id=ib109713a4d3\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ydf986b42ae9?dice_id=Ydf986b42ae9\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k69q8o-dead-pony-4th-jun-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"announced\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780596000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:71\",\"price\":{\"currency\":\"GBP\",\"amount\":1968,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/7eaf5dab-8be6-4087-9dc6-3584e74b2995.jpg?rect=256%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/7eaf5dab-8be6-4087-9dc6-3584e74b2995.jpg?rect=0%2C154%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/7eaf5dab-8be6-4087-9dc6-3584e74b2995.jpg?rect=602%2C0%2C845%2C1536\"},\"id\":\"698dc990e7000000014c5fd1\",\"name\":\"DEAD PONY\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Dead Pony are an electrifying rock band from Glasgow, Scotland, known for their high-energy sound and genre-blending style. Fronted by the powerhouse vocals of Anna Shields, alongside Blair Crichton (guitar), Liam Adams (bass), and Euan Lyons (drums), they fuse elements of alt-rock, punk, and nu-metal into a sound that is both raw and infectious.\\n\\nBursting onto the scene in 2020, Dead Pony quickly gained attention for their ferocious riffs, punchy rhythms, and anthemic choruses. Singles like \\\"Sharp Tongues\\\" and \\\"23, Never Me\\\" cemented their place as one of the most exciting new bands in UK rock. Their debut EP, War Boys (2022), showcased their ability to blend driving guitar hooks with gritty, attitude-packed vocals, drawing comparisons to Paramore, The Prodigy, and N.E.R.D.\\n\\nIn 2024, Dead Pony took things to the next level with the release of their debut album Ignore This, a hard-hitting collection of tracks packed with energy, attitude, and undeniable hooks. The album’s success fueled their 'Ignore This' headline tour, which saw several dates sell out, including their biggest Scottish headline show to date at the 1,000-capacity Queen Margaret Union in Glasgow.\\n\\nRenowned for their explosive live performances, Dead Pony have played Reading and Leeds, Glastonbury, TRNSMT and are set to make their Download Festival debut in 2025. They have shared stages with Black Honey, Against the Current, The Mysterines, Kid Kapichi, The Warning, Mother Mother, The Blackout, and are currently joining You Me At Six on select dates of their final UK tour.\\n\\nWith relentless energy both on stage and in the studio, Dead Pony are proving to be one of the UK’s most thrilling rising rock bands.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-06-04T18:00:00+01:00\",\"sale_start_date\":\"2026-02-20T10:00:00+00:00\",\"event_start_date\":\"2026-06-04T19:00:00+01:00\",\"event_end_date\":\"2026-06-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"23, Never Me\",\"redirect_url\":\"https://open.spotify.com/track/6X1qkAaZoCIgcrqyeRJP8L\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6d7cca1ce1533b6235d6c83506e6c10138413df9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"23, Never Me\"},{\"type\":\"apple_music\",\"title\":\"Dead Pony - Everything Burns\",\"redirect_url\":\"https://music.apple.com/us/album/everything-burns/1774926706?i=1774926707&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dead Pony\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/ad/1b/cc/ad1bccc5-88a7-55c7-0f5f-3fcfeb1d0c79/mzaf_1174942783867805671.plus.aac.p.m4a\",\"track_name\":\"Everything Burns\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Melanie Baker\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0ea0b2a97ba3db10970130e1\"},\"artist_id\":\"55410\",\"about\":null,\"is_headliner\":false}],\"total_artist