e World Again\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":3065,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":70407,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"yo6ner-loose-ends-13th-jun-the-jazz-cafe-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781373600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:40\",\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-13T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Loose Ends\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/91f4cd450d258d2965c7c807d32183bf26c4860a\"},\"artist_id\":\"4970\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"**Loose Ends have remained one of the UK's most beloved soul acts.**\\n\\nThe band made their mark with the unforgettable **'Hanging on a String'**, with the track topping the US charts and reaching the UK top 10 in 1985. They continued their winning streak with a string of transatlantic hits including **'Magic Touch'**, **'Slow Down'** and **'Watching You (Watching Me)'**.\\n\\nToday, founding member **Carl McIntosh** leads the current lineup alongside **Linda Carriere** and **Sunay Suleyman**, who joined in 1990. Together, they continue to deliver the **smooth soul** and irresistible rhythms that have kept audiences coming back for over three decades.\\n\\nAn evening of timeless hits and soulful classics, right in the heart of London's favourite live music venue.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T14:00:00+00:00\",\"sale_end_date\":\"2026-06-13T19:00:00+01:00\",\"sale_start_date\":\"2026-01-22T14:00:00+00:00\",\"event_start_date\":\"2026-06-13T19:00:00+01:00\",\"event_end_date\":\"2026-06-13T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696e54d75f4dec0001a08f29\",\"name\":\"Loose Ends\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/387308af-f3c5-4a12-b6f5-c77bab2e76ad.jpg?rect=338%2C0%2C825%2C1500\"},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thec