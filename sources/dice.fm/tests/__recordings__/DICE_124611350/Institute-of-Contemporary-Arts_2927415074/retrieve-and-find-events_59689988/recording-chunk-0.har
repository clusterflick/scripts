,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-01T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"11441\",\"name\":\"Dig That Treasure\",\"image\":{\"url\":null},\"perm_name\":\"dig-that-treasure-xoya\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:20\",\"date_unix\":1777660200,\"price\":{\"currency\":\"GBP\",\"amount\":1750,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/X68068b90b7e?dice_id=X68068b90b7e\",\"post_competition_referral\":\"https://link.dice.fm/vd5ab2025d13?dice_id=vd5ab2025d13\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I1a56284a7e4?dice_id=I1a56284a7e4\",\"post_purchase_referral\":\"https://link.dice.fm/I1e624583a51?dice_id=I1e624583a51\",\"post_reminder_referral\":\"https://link.dice.fm/K556b5605a2d?dice_id=K556b5605a2d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Lcf401b2ae2a?dice_id=Lcf401b2ae2a\"},\"perm_name\":\"dk87wq-mohammad-syfkhan-canab-marwo-1st-may-cafe-oto-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/b5c26655-9aae-4b5d-a4da-880c8ad212d0.jpg?rect=0%2C270%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/b5c26655-9aae-4b5d-a4da-880c8ad212d0.jpg?rect=0%2C702%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/b5c26655-9aae-4b5d-a4da-880c8ad212d0.jpg?rect=338%2C0%2C1485%2C2700\"},\"properties\":[],\"about\":{\"description\":\"*Dig That Treasure! and Baba Yaga's Hut present*\\n\\n**Dig That Treasure! Festival - Night One**\\n\\n**Mohammad Syfkhan**\\n\\nBorn in North-East Syria, Mohammad Syfkhan is a Kurdish musician who picked up the bouzouki while studying nursing in the early 1980s. Syfkhan formed the popular group The Al-Rabie Band who performed festivals and weddings across Syria, while continuing to work as a surgical nurse. Following the outbreak of war in 2011, one of Syfkhan's sons was tragically killed by ISIS, prompting Syfkhan and his family to resettle in Ireland. Since then, Syfkhan has become a beloved staple of the Irish music scene with his ecstatic, life-affirming live performances. He has shared bills with the likes of Lankum, Sacred Paws and Sly & The Family Drone, as well as making appearances at Venice Biennale, Mosely Folk Festival, and End Of The Road.\\n\\n**Canab Marwo**\\n\\nCanab Marwo is a Somali pop singer. There is not a huge amount of information about her online: nearly every result produced by a Google search is a YouTube video, of which there are dozens, featuring Canab singing at parties in London and Somalia or against greenscreens adorning the hilltops of the Horn of Africa and the flags of Somalia, Somaliland and Djibouti. Following decades of performing and recent viral success on TikTok, this is a rare opportunity for those outside London’s rich Somali community to catch Canab Marwo live.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"691454fc4bc7020001a94928\",\"name\":\"Mohammad Syfkhan + Canab Marwo\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mohammad Syfkhan\",\"image\":null,\"artist_id\":\"114117\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-14T10:00:00+00:00\",\"sale_end_date\":\"2026-05-01T10:00:00+01:00\",\"sale_start_d