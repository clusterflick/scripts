_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1760535900,\"faqs\":[{\"id\":23935,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6412},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T14:00:00+00:00\",\"sale_end_date\":\"2026-05-24T19:30:00+01:00\",\"sale_start_date\":\"2026-02-09T14:00:00+00:00\",\"event_start_date\":\"2026-05-24T19:30:00+01:00\",\"event_end_date\":\"2026-05-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Gotobeat.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/L8e933c9b374?dice_id=L8e933c9b374\",\"post_competition_referral\":\"https://link.dice.fm/t2447d16736f?dice_id=t2447d16736f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Id9e703c8ef7?dice_id=Id9e703c8ef7\",\"post_purchase_referral\":\"https://link.dice.fm/X82eda4f9f96?dice_id=X82eda4f9f96\",\"post_reminder_referral\":\"https://link.dice.fm/Md465d55db8a?dice_id=Md465d55db8a\",\"post_waitinglist_referral\":\"https://link.dice.fm/pb1192da98bb?dice_id=pb1192da98bb\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Italian rap icon Emis Killa lands in London for a special live show at The Garage on 24th May.\\n\\nA cornerstone of the Italian rap scene for over a decade, this marks his long-awaited London debut and forms part of his Club Tour, following the release of his latest album “Musica Triste” and two incredible 2024 & 2025 editions of his own festival, EM24 & EM25, held at Fiera di Milano — a true celebration of his enduring impact and legacy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.com/privacy-policy/\",\"fb_pixel_id\":\"570786809997969\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779647400,\"venues\":[{\"id\":\"3\",\"name\":\"The Garage (London)\",\"address\":\"20-22 Highbury Cres, London N5 1RD\",\"location\":{\"lat\":51.5467588,\"lng\":-0.103935800000045},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-garage-london-zlwj\",\"accessibility\":{\"url\":\"https://www.thegarage.london/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tick