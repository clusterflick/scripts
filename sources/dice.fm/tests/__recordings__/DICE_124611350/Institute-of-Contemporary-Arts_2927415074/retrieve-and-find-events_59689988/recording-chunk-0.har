lity\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-15/d461b76c-65a1-48b9-bea9-04774483da2c.jpg?rect=0%2C568%2C3006%2C3006\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-15/d461b76c-65a1-48b9-bea9-04774483da2c.jpg?rect=0%2C1288%2C3006%2C1804\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-15/d461b76c-65a1-48b9-bea9-04774483da2c.jpg?rect=299%2C0%2C2409%2C4380\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Xcdfedcb1b18?dice_id=Xcdfedcb1b18\",\"post_competition_referral\":\"https://link.dice.fm/ide2afde0db8?dice_id=ide2afde0db8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/q3c16fa5f157?dice_id=q3c16fa5f157\",\"post_purchase_referral\":\"https://link.dice.fm/Z356c97424f3?dice_id=Z356c97424f3\",\"post_reminder_referral\":\"https://link.dice.fm/Y01d198799aa?dice_id=Y01d198799aa\",\"post_waitinglist_referral\":\"https://link.dice.fm/g8f4249c43cf?dice_id=g8f4249c43cf\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:51\",\"properties\":[],\"presented_by\":\"Presented by Short Waves.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771113600,\"id\":\"6991c058de45d9000140aa54\",\"name\":\"12 Apostles / goo / Lots Of\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"*Short Waves Presents:*\\n\\n**\\\\- 12 Apostles**\\n\\nGuitar, synth, serenading duo, backed by a drum machine. With enough of the attributes of a conventional rock band between the two of them, their sound fills more space than the sum of its two-band-member parts. 12 Apostles move between pared down love songs that sound like children’s choir hymns and discordant oddball rock and roll with unsettled lyrics. The duo write songs about characters in cold bedrooms drinking poison at the wrong time of day and drunk cupids that lose their arrows, layering sunshine-pop melodies over noisy guitar and eerie synth.\\n\\n(*https://www.instagram.com/121212apostles/)*\\n\\n**\\\\- goo**\\n\\n(*https://www.instagram.com/goo__band/*)\\n\\n**\\\\- Lots Of**\\n\\nLots Of are a 3 piece rock band based in London. Equally influenced by Unwound as they are MJ Lenderman. Expect angular noisy riffs atop dream like lyricism\\n\\n(*https://www.instagram.com/lotsofband/*)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"197\",\"name\":\"DreamBagsJaguarShoes\",\"image\":{\"url\":null},\"perm_name\":\"dreambagsjaguarshoes-ja92\",\"profile_active\":false},\"date_unix\":1772911800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1130,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T17:00:00+00:00\",\"sale_start_date\":\"2026-02-13T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:30:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"avp9rv-ruena-spring-major-wilting-flower-7th-mar-the-fighting-cocks-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ruena - Leech\",\"redirect_url\":\"https://open.spotify.com/track/7cQgxLNgyLeicYEAGvcWsB\",\"artist\":\"Ruena\",\"preview_url\":\"https://p.scdn.co/mp3-preview/190a6e9b9abdb1aea8ffef47520f5cb16df6e879?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Leech\"},{\"type\":\"apple_music\",\"title\":\"Ruena - The Tide\",\"redirect_url\":\"https://music.apple.com/us/album/the-tide/1846271748?i=1846271752&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ruena\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/73/05/c0/7305c071-07bd-d343-502c-fc765568e91c/mzaf_5790436153633748151.plus.aac.p.m4a\",\"track_name\":\"The Tide\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Reuna\",\"image\":null,\"artist_id\":\"134007\",\"about\":null,\"is_headliner\":false},{\"name\":\"Spring Major\",\"image\":null,\"artist_id\":\"92584\",\"about\":null,\"is_headliner\":false},{\"name\":\"LOUD WOMEN\",\"image\":null,\"artist_id\":\"120298\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"5327\",\"name\":\"The Fighting Cocks\",\"address\":\"56 Old London Rd, Kingston upon Thames KT2 6QA, UK\",\"location\":{\"lat\":51.41069110000001,\"lng\":-0.2982407},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-fighting-cocks-l6yp\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/549e6a04-f7ea-4d30-a6ff-66b1b3953e89.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/549e6a04-f7ea-4d30-a6ff-66b1b3953e89.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/549e6a04-f7ea-4d30-a6ff-66b1b3953e89.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Va9327b19521?dice_id=Va9327b19521\",\"post_competition_referral\":\"https://link.dice.fm/Acce156a44ef?dice_id=Acce156a44ef\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qb88176c8113?dice_id=Qb88176c8113\",\"post_purchase_referral\":\"https://link.dice.fm/q2cdaa4afc41?dice_id=q2cdaa4afc41\",\"post_reminder_referral\":\"https://link.dice.fm/g5c3db3b4a31?dice_id=g5c3db3b4a31\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jd6a2a856887?dice_id=Jd6a2a856887\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:52\",\"properties\":[],\"presented_by\":\"Presented by LOUD WOMEN.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770940800,\"id\":\"698e9bb106070b00017a642d\",\"name\":\"Ruena + Spring Major + Wilting Flower\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"LOUD WOMEN is heading to Kingston-upon-Thames, the home of heavy music, for a ferocious International Women’s Day celebration at The Fighting Cocks on Friday 7 March.\\n\\nRUENA (Nottingham)  \\nMetalcore dark-pop Queen with teeth. RUENA is a fully DIY powerhouse – producing her own tracks, directing her own videos, and building a visual world that’s intense, cinematic and unsettling in all the right ways. Expect crushing heaviness, pop hooks that worm their way into your brain, and a live show that hits hard.\\n\\nSPRING MAJOR (Oxfordshire)  \\nEmo pop kids and DIY darlings serving big feelings, sticky melodies and emotional release. Spring Major write songs for overthinkers, underdogs and anyone who still believes in loud guitars and sincerity. Cathartic, heartfelt and built for shouting along without irony.\\n\\nWILTING FLOWER (Brighton)  \\nNu-metal heartbreakers blending heaviness, vulnerability and big emotional swings. Wilting Flower bring crushing riffs, tender moments and that messy, glorious purple energy – putting the ‘o’ in emo.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"12337\",\"name\":\"LOUD WOMEN\",\"image\":{\"url\":null},\"perm_name\":\"loud-women-rrly\",\"profile_active\":false},\"date_unix\":1772911800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T22:30:00+00:00\",\"sale_start_date\":\"2026-02-11T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:30:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6d2vw8-bang-mary-hot-wife-mukbang-ray-7th-mar-sebright-arms-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mukbang Ray\",\"image\