l_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1779989400,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:4\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5453},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-27/3787e581-e653-4832-9269-c3756bc572a9.jpg?rect=587%2C0%2C4330%2C4330\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-27/3787e581-e653-4832-9269-c3756bc572a9.jpg?rect=0%2C514%2C5504%2C3302\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-27/3787e581-e653-4832-9269-c3756bc572a9.jpg?rect=1561%2C0%2C2382%2C4330\"},\"id\":\"68fb78cfb8aac0000158e595\",\"name\":\"MARINA\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T10:00:00+00:00\",\"sale_end_date\":\"2026-05-28T21:00:00+01:00\",\"sale_start_date\":\"2025-10-29T10:00:00+00:00\",\"event_start_date\":\"2026-05-28T18:30:00+01:00\",\"event_end_date\":\"2026-05-28T22:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Marina And The Diamonds - How To Be A Heartbreaker\",\"redirect_url\":\"https://open.spotify.com/artist/6CwfuxIqcltXDGjfZsMd9A\",\"artist\":\"Marina And The Diamonds\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3f4e3f70e4eaa15ec8397dee9b509bcd702a5805\",\"track_name\":\"How To Be A Heartbreaker\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-28T18:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"announcement_date_unix\":1764781200,\"social_links\":{\"event_share\":\"https://link.dice.fm/Qdfb8e39e3b1?dice_id=Qdfb8e39e3b1\",\"post_competition_referral\":\"https://link.dice.fm/J972dabb119c?dice_id=J972dabb119c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/cea42459f931?dice_id=cea42459f931\",\"post_purchase_referral\":\"https://link.dice.fm/q153749a2b5f?dice_id=q153749a2b5f\",\"post_reminder_referral\":\"https://link.dice.fm/R441b1642577?dice_id=R441b1642577\",\"post_waitinglist_referral\":\"https://link.dice.fm/Wd4af59c6397?dice_id=Wd4af59c6397\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"pyr6vp-the-music-of-george-michael-the-candlelight-concert-28th-may-the-clapham-grand-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1779989400,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:5\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4635},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/b13da8c7-a5bb-4ef6-acc2-30075c3c3402.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/b13da8c7-a5bb-4ef6-acc2-30075c3c3402.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/b13da8c7-a5bb-4ef6-acc2-30075c3c3402.jpg?rect=675%2C0%2C1650%2C3000\"},\"id\":\"6930509fb7f615000169cb50\",\"name\":\"The Music of George Michael - The Candlelight Concert\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**THURSDAY 28TH MAY / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\n**This is a 10+ event. Under 18s must be accompanied by an adult over 21 (max. 2 under 18s per adult 21+)**\\n\\n**The Music of George Michael – The Candlelight Concert**\\n\\n**An Unforgettable Tribute in Glowing Candlelight Performed by 4 World Class Singers & an incredible live band!**\\n\\nPrepare to be swept away by an extraordinary evening of music, atmosphere and pure emotion. George Michael – The Candlelight Concert is more than just a tribute — it’s a stunning live experience that honours the legacy of one of the greatest voices in pop history, performed in a setting that will leave you breathless.\\n\\nAs you step into the magic, you'll be greeted by the soft, romantic glow of hundreds of flickering candles, casting a golden haze over the stage and creating an amazing, intimate ambiance unlike anything you've experienced before. The stage is set for something truly special.\\n\\nAt the heart of this unforgettable night is a live band of exceptional musicians, joined by four sensational vocalists who will deliver pitch-perfect renditions of George Michael’s most beloved hits. From the soaring emotion of Careless Whisper and Everything She Wants, to the infectious energy of Faith, Freedom! '90 and Jesus to a Child, every song is performed with heart, soul and incredible attention to detail.\\n\\nThis is a night for fans old and new to celebrate the music, style and spirit of George Michael — a man whose voice defined a generation and whose songs continue to inspire. Whether you're looking for the perfect date night, a special evening out with friends or a unique way to reconnect with your favourite songs, this candlelit concert is the ultimate tribute.\\n\\nLose yourself in the music, the memories and the atmosphere. George Michael – The Candlelight Concert is a one-of-a-kind live experience you’ll never forget.\\n\\nHis music. Your memories. One magical night.\\n\\nDisclaimer: This is a tribute concert celebrating the music of George Michael. It is not affiliated with, endorsed by, or sponsored by George Michael's estate. Please note that this performance does not feature a look-alike impersonating Goerge Michael; instead, it showcases a full live band and four talented vocalists performing the music of George Michael with authenticity and respect for his artistry.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 10+ event. Under 18s must be accompanied by an adult over 21 (max. 2 under 18s per adult 21+)\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T17:00:00+00:00\",\"sale_end_date\":\"2026-05-28T18:30:00+01:00\",\"sale_start_date\":\"2025-12-03T17:00:00+00:00\",\"event_start_date\":\"2026-05-28T18:30:00+01:00\",\"event_end_date\":\"2026-05-28T21:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Boileroom.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"307\",\"name\":\"The Boileroom\",\"address\":\"13 Stoke Fields, Guildford GU1 4LS, UK\",\"location\":{\"lat\":51.2399206,\"lng\":-0.5729911999999999},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-11/4dc19111-fbc2-49b4-bdcd-e35ec6ad71aa.jpg?rect=0%2C0%2C2000%2C2000\"},\"city\":{\"id\":\"60af7d20b0bf8e0a2a26f614\",\"name\":\"Guildford\",\"location\":{\"lat\":51.236453,\"lng\":-0.570246,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-boileroom-j7lb\",\"accessibility\":{\"url\":\"https://theboileroom.net/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-28T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"320\",\"name\":\"The Boileroom\",\"image\":{\"url\":null},\"perm_name\":\"the-boileroom-zd8e\",\"profile_active\":false},\"announcement_date_unix\":1770897600,\"social_links\":{\"event_share\":\"https://link.dice.fm/jd8895338112?dice_id=jd8895338112\",\"post_competition_referral\":\"https://link.dice.fm/H83b1d17ff52?dice_id=H83b1d17ff52\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u0c0837559ec?dice_id=u0c0837559ec\",\"post_purchase_referral\":\"https://link.dice.fm/p0c9a21273be?dice_id=p0c9a21273be\",\"post_reminder_referral\":\"https://link.dice.fm/kaaa55171f5a?dice_id=kaaa55171f5a\",\"post_waitinglist_referral\":\"https://link.dice.fm/z8d1dd61894d?dice_id=z8d1dd61894d\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"3owd9p-cq-wrestling-28th-may-the-boileroom-guildford-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1779991200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:6\",\"price\":{\"currency\":\"GBP\",\"amount\":1590,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/cd753431-d4c4-40db-a510-1fb2a5bcae23.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/cd753431-d4c4-40db-a510-1fb2a5bcae23.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/cd753431-d4c4-40db-a510-1fb2a5bcae23.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"698dc5269de06b00018c140b\",\"name\":\"CQ Wrestling\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"CQ Wrestling are a British grunge band led by best friends and songwriters Charlie Woods and Jake Mac, delivering a fierce, melodic sound rooted in ’90s alternative rock. Their music explores themes of social and political unrest while reaching for moments of euphoric escape, and their chaotic, high-energy live shows have built a devoted following - including three sold-out UK tours and appearances at festivals across Europe.\\n\\nTheir debut album Plus Ultra was released in 2023 to critical acclaim, earning support from BBC Radio 1, BBC Radio 6 Music and Radio X. Now fully independent, CQ Wrestling are entering a new era with their most recent single “Smoke Screen”, a sharp and urgent track that cuts through distortion and grit to confront misinformation, disillusionment and modern unrest. It marks a confident step forward for the band, both sonically and thematically, as they continue to refine their sound and expand their reach.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezon