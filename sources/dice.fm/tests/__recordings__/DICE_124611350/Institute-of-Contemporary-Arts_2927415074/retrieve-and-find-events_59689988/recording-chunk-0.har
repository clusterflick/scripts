ilable_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:88\",\"date_unix\":1778176800,\"price\":{\"currency\":\"GBP\",\"amount\":1558,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Z14f944e7cd0?dice_id=Z14f944e7cd0\",\"post_competition_referral\":\"https://link.dice.fm/d0febdce6b61?dice_id=d0febdce6b61\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/md520ed23e0b?dice_id=md520ed23e0b\",\"post_purchase_referral\":\"https://link.dice.fm/hc061359f71d?dice_id=hc061359f71d\",\"post_reminder_referral\":\"https://link.dice.fm/Rd2b7327d099?dice_id=Rd2b7327d099\",\"post_waitinglist_referral\":\"https://link.dice.fm/i05483190696?dice_id=i05483190696\"},\"perm_name\":\"92wqa6-greazy-alice-7th-may-dingwalls-2-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/b2adba29-0c5e-4c63-8eef-c03accf6c84f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/b2adba29-0c5e-4c63-8eef-c03accf6c84f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/b2adba29-0c5e-4c63-8eef-c03accf6c84f.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Greazy Alice pour out sleazy hard-riffing rock n roll, smoky dive bar blues, and telecaster-driven honky tonk twang. Drunk and dirty, down and out, spend it all tonight tomorrow may never come.\\n\\nLatest album As Time Goes By documents a moment in time, a moment of reflection, loss, growth and hope. A melancholic sweetness runs through those eleven songs and, in contrast with previous work from Greazy Alice, the focus of this album lies squarely on Pianovich's songwriting. It is personal, earnest, and introspective while still evoking elements of the band's earlier bar room aesthetic. It is an honest snapshot of how the band sounds right now and will remain an enjoyable album to revisit regardless of who/what/where Greazy Alice will be in the future.\\n\\n\\\"stunning debut from New Orleans-based quartet - a sublime mix of radiant country and heart-worn honkytonk\\\" 9/10 Uncut\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69611882d7660700011aab87\",\"name\":\"Greazy Alice\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T17:00:00+00:00\",\"sale_end_date\":\"2026-05-07T19:00:00+01:00\",\"sale_start_date\":\"2025-12-08T17:00:00+00:00\",\"event_start_date\":\"2026-05-07T19:00:00+01:00\",\"event_end_date\":\"2026-05-07T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by HotBox Live.\",\"seating\":null,\"announcement_date_unix\":1765213200,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-07T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:89\",\"date_unix\":1778176800,\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/f47ab8d2d635?dice_id=f47ab8d2d635\",\"post_competition_referral\":\"https://link.dice.fm/ad9f98c5051d?dice_id=ad9f98c5051d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R02a800f908a?dice_id=R02a800f908a\",\"post_purchase_referral\":\"https://link.dice.fm/l0865b196aa1?dice_id=l0865b196aa1\",\"post_reminder_referral\":\"https://link.dice.fm/Vbfb62270111?dice_id=Vbfb62270111\",\"post_waitinglist_referral\":\"https://link.dice.fm/n9df611c37ff?dice_id=n9df611c37ff\"},\"perm_name\":\"dka3av-flying-moon-in-space-7th-may-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/1756f249-2b66-46e3-8ee5-2c62b123a4fd.jpg?rect=0%2C0%2C1365%2C1365\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/1756f249-2b66-46e3-8ee5-2c62b123a4fd.jpg?rect=0%2C273%2C1365%2C819\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/1756f249-2b66-46e3-8ee5-2c62b123a4fd.jpg?rect=307%2C0%2C751%2C1365\"},\"properties\":[],\"about\":{\"description\":\"Tonight a very special Fuzz Club band Flying Moon In Space are a seven-piece band from Leipzig, Germany borne out of live improvisations. Having clocked-up nearly fifty shows in their home-city alone and headline tours around Europe, the group have now signed to London-based label Fuzz Club for their self-titled debut LP. A shape-shifting blend of driving Krautrock aesthetics, vivid psychedelic pop and techno-indebted electronics.\\n\\nAlthough they cite influences that span the likes of Can, Neu! and Brian Eno, ‘Flying Moon In Space’ is an album indebted to the band’s own experimental live approach more than anything else. Their improvised live shows typically see them perform with four guitars, bass, drums and vocals, resulting in huge walls of sound that are awash with hypnotic motorik beats and orchestral walls of reverb.\\nTalking about the album, they say: “We gain our main influences during experimenting live with different rhythms, layers of sounds and other textures. The energy that comes up playing live with that amount of people takes our perception of music to another dimension. \\n\\n‘The Observer’ is described as an anthem for the “post-industrial burnouts” of the world, a call to break from the humdrum drudgery of modern life in the form of an upbeat psych-pop earworm. “All work and no play is a recipe for disaster,” they say: “We grow old eight hours a day at a desk and then death comes with a bitter kiss. When all is said and done, time will tell that fun has no age.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69375209e8138f0001f0d838\",\"name\":\"Flying Moon In Space\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Flying Moon in Space - Faces\",\"redirect_url\":\"https://music.apple.com/gb/album/faces/1532866769?i=1532866772&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Flying Moon in Space\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/15/be/61/15be611f-c9d7-e19e-0056-78a9df1e991b/mzaf_1832337754569505256.plus.aac.p.m4a\",\"track_name\":\"Faces\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Flying Moon in Space\",\"image\":null,\"artist_id\":\"38396\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-21T00:00:00+00:00\",\"sale_end_date\":\"2026-05-07T00:00:00+01:00\",\"sale_start_date\":\"2025-11-21T00:00:00+00:00\",\"event_start_date\":\"2026-05-07T19:00:00+01:00\",\"event_end_date\":\"2026-05-07T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by AGMP.\",\"seating\":null,\"announcement_date_unix\":1763683200,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-07T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:90\",\"date_unix\":1778176800,\"price\":{\"currency\":\"GBP\",\"amount\":4125,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/y23045e9bf08?dice_id=y23045e9bf08\",\"post_competition_referral\":\"https://link.dice.fm/m01e668b90c8?dice_id=m01e668b90c8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q996117dc5f2?dice_id=Q996117dc5f2\",\"post_purchase_referral\":\"https://link.dice.fm/L4023215f389?dice_id=L4023215f389\",\"post_reminder_referral\":\"https://link.dice.fm/sb9b786d8b4b?dice_id=sb9b786d8b4b\",\"post_waitinglist_referral\":\"https://link.dice.fm/Sf9846555db9?dice_id=Sf9846555db9\"},\"perm_name\":\"dkaree-albert-lee-7th-may-union-chapel-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-21/789e5a57-d8a9-496e-ad35-8a6d2ff5679d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-21/789e5a57-d8a9-496e-ad35-8a6d2ff5679d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-21/789e5a57-d8a9-496e-ad35-8a6d2ff5679d.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"AGMP Concerts proudly presents\\n\\nALBERT LEE\\n\\n\\\"A musical genius.\\\" Ralph McTell\\n\\n\\\"A brilliant guitar player. His sound is unmistakable - often emulated, never equalled.\\\" Emmylou Harris\\n\\n\\\"Great musicians make you want to dance, make you cry and make you fall in love, and Albert does that with his playing.\\\" Jools Holland\\n\\nOne of the most respected and renowned guitarists in music history, Albert Lee has worked with The Everly Brothers, Eric Clapton, Emmylou Harris and The Crickets over his long and illustrious career.\\n\\nThe British-born country-rock artist started his career during the emerging rock 'n' roll scene of sixties London, when he swapped bands with the likes of Jimmy Page and Chris Farlowe. After moving to the U.S. and assimilating himself into the country music scene, Albert quickly garnered a reputation as one of the fastest guitar players in the business. He recorded a number of solo albums, and won a Grammy in 2002 for his contribution on 'Foggy Mountain Breakdown'.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69208c484f44a40001721ba4\",\"name\":\"Albert Lee\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Albert Lee - Born to Run\",\"redirect_url\":\"https://open.spotify.com/track/1WcCPObIHWhZQFrQuSblos\",\"artist\":\"Albert Lee\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b7caf1784f69237e6fef023ec5175fa65285a5ee?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Born to Run\"},{\"type\":\"apple_music\",\"title\":\"Albert Lee - Born to Run\",\"redirect_url\":\"https://music.apple.com/us/album/born-to-run/712218649?i=712218715&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Albert Lee\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/2e/c8/07/2ec807be-c8e2-6abb-3cfc-1385d10ea8ff/mzaf_4950626885272083266.plus.aac.p.m4a\",\"track_name\":\"Born to Run\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Albert Lee\",\"image\":null,\"artist_id\":\"92474\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-09T16:00:00+01:00\",\"sale_end_date\":\"2026-05-07T15:00:00+01:00\",\"sale_star