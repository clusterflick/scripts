6f7406e33fc.jpg?rect=0%2C0%2C4611%2C4611\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/905cf2ae-22a6-47f6-aaab-e6f7406e33fc.jpg?rect=0%2C922%2C4611%2C2767\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/905cf2ae-22a6-47f6-aaab-e6f7406e33fc.jpg?rect=1038%2C0%2C2536%2C4611\"},\"id\":\"6980925c18b1e600019e429c\",\"name\":\"Big Boy Bloater\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Big Boy Bloater is a guitarist, singer, songwriter, presenter and entertainer of the highest order. His take on roots and R&B has impressed many people within the genre, from the original greats of Blues & roots to modern aficionados, and beyond. He is regularly asked to play guitar for legends of R&B, roots and blues and he takes his own band – the LiMiTs – on tours around the globe as well as working his own One Man Show and stepping in as a special guest or session player.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T12:00:00+00:00\",\"sale_end_date\":\"2026-05-29T15:00:00+01:00\",\"sale_start_date\":\"2026-02-02T12:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:30:00+01:00\",\"event_end_date\":\"2026-05-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Big Boy Bloater - Alligator Wine\",\"redirect_url\":\"https://music.apple.com/us/album/alligator-wine/1617857233?i=1617857239&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Big Boy Bloater\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/40/9f/1a/409f1a3d-2fd5-b55b-88c7-7d9db5e579f1/mzaf_3573541860537544977.plus.aac.p.m4a\",\"track_name\":\"Alligator Wine\"},{\"type\":\"spotify\",\"title\":\"Big Boy Bloater - Alligator Wine\",\"redirect_url\":\"https://open.spotify.com/track/3oo0Z9zmqzoJM8huTCmXnt\",\"artist\":\"Big Boy Bloater\",\"preview_url\":\"https://p.scdn.co/mp3-preview/339f2076df3400f877ea6bf0fffa2adf282b122a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Alligator Wine\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Skinner\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-15/c81cb47b-9be6-4009-807a-734b46835f0e.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"42670\",\"about\":{\"description\":\"Skinner is Aaron Corcoran, based in Dublin, who writes, records and produces songs about growing up and overcoming a dirt-flecked 21st century existence.\\n\\nThe DNA of no wave and post-punk acts like The B52s, James Chance and the Contortions and ESG through to alt-rock touchstones Pixies and Morphine combined with an talent for grunge-nodding self-production and pockets of elevated instrumentation is oozing from Skinner’s music.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bad Vibrations\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"10\",\"name\":\"The Shacklewell Arms\",\"address\":\"71 Shacklewell Lane, London E8 2EB\",\"location\":{\"lat\":51.5531551,\"lng\":-0.0699228999999377},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T19: