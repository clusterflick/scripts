l_links\":{\"event_share\":\"https://link.dice.fm/Ae9ac739e731?dice_id=Ae9ac739e731\",\"post_competition_referral\":\"https://link.dice.fm/K9bb643bd653?dice_id=K9bb643bd653\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/dd892d29a5fa?dice_id=dd892d29a5fa\",\"post_purchase_referral\":\"https://link.dice.fm/Sc7b89d0f2fb?dice_id=Sc7b89d0f2fb\",\"post_reminder_referral\":\"https://link.dice.fm/F4948b105ce5?dice_id=F4948b105ce5\",\"post_waitinglist_referral\":\"https://link.dice.fm/q463526c51fa?dice_id=q463526c51fa\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Deeply connected to the traditions of the past and eager to shape the future of classical music, Andrei Gologan is earning an international reputation as a thought-provoking concert pianist. His poetic interpretations have garnered the support of legendary pianists such as Sir András Schiff and Richard Goode, leading to invitations from some of Europe’s most prestigious festivals and concert halls, including the Herkulessaal in Munich, Wigmore Hall in London, the Schleswig-Holstein Festival, and Heidelberger Frühling.\\n\\nUpcoming highlights include the third edition of the Buzz Chamber Music Festival, co-founded by Andrei in Obertrum am See, Austria, a reinvitation to the Enescu Festival in Bucharest, as well as Andrei's debut with KALA Chamber Orchestra and the Enescu Philharmonic, and the release of his debut studio album featuring works by Brahms. Recorded on a C. Bechstein in the studios of Deutschlandfunk in Cologne, this project will be accompanied by a release tour, with recitals scheduled at the Konzerthaus Berlin and the Ehrbar Saal in Vienna.\\n\\nBeyond his concert activities, Andrei was appointed in 2024 as a faculty member for chamber music at the Musikhochschule in Freiburg. Outside the stage, he draws inspiration from the artistry of Ignaz Friedman, Bill Evans, and Sergiu Celibidache.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773430200,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T18:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:28\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"139902\",\"name\":\"World Heart Beat\",\"image\":{\"url\":null},\"perm_name\":\"world-heart-beat-bmv9k\",\"profile_active\":false},\"id\":\"6939ca6cb42ee30001616bd6\",\"name\":\"International Piano in the Elms Festival: Andrei Gologan\",\"perm_name\":\"mx83gk-international-piano-in-the-elms-festival-andrei-gologan-13th-mar-world-heart-beat-embassy-gardens-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/3b9b16c9-3ac3-49ba-830e-84c279b12b71.jpg?rect=1032%2C0%2C6192%2C6192\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/3b9b16c9-3ac3-49ba-830e-84c279b12b71.jpg?rect=0%2C619%2C8256%2C4954\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/3b9b16c9-3ac3-49ba-830e-84c279b12b71.jpg?rect=2425%2C0%2C3406%2C6192\"},\"unicorn\":true,\"summary_lineup\":{\