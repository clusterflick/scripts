96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2234,\"name\":\"Omen magazine\",\"privacy_policy_link\":\"https://www.omenmagazine.com/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Too Bright to See presents:\\n\\na residency with Long Distance Runner\\n\\n3rd of the Series with Dog Saints & TV\\n\\nNoise meets ambience, post-rock colliding with film-scores, Long Distance Runner are an instrumental four-piece from London. Melodic distortion, chiming guitar riffs, spiralling drum patterns, and moments of gentle calm build up emotional tension, before releasing in cathartic moments of calm and chaos. (https://www.instagram.com/longdistancerunner___/)\\n\\nUnderpinned by midwest emo sensibilities and an admiration of modern shoegaze, Dog Saints rip at every show they play. Their fuzz infused songwriting draws fans to move, and to cry. (https://www.instagram.com/dogsaintsdogsaints/)\\n\\nTV is a 3 piece band from London. The songs are intimate and heavy, with samples and synths infused with guitars. (https://www.instagram.com/tv__2021/)\",\"highlights\":[{\"type\":\"age_r