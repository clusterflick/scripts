ford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-04T15:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/344c6b1a-2045-459e-84e0-9b702bffe691.jpg?rect=0%2C10%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/344c6b1a-2045-459e-84e0-9b702bffe691.jpg?rect=0%2C170%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/344c6b1a-2045-459e-84e0-9b702bffe691.jpg?rect=175%2C0%2C450%2C819\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/R49bc4fbbe8b?dice_id=R49bc4fbbe8b\",\"post_competition_referral\":\"https://link.dice.fm/D5bc0fadf541?dice_id=D5bc0fadf541\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ld9c4340720f?dice_id=Ld9c4340720f\",\"post_purchase_referral\":\"https://link.dice.fm/Ub884f3028f1?dice_id=Ub884f3028f1\",\"post_reminder_referral\":\"https://link.dice.fm/N900ebefdf98?dice_id=N900ebefdf98\",\"post_waitinglist_referral\":\"https://link.dice.fm/Oa7158b3ad01?dice_id=Oa7158b3ad01\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:11\",\"properties\":[],\"presented_by\":\"Presented by Black Frog.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764633600,\"id\":\"692f29724c69ef0001cfa9b6\",\"name\":\"The Equators\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Charlie Hart’s Equators are a group of London based R’n’B/jazz musicians who love to explore the roots of the music they’ve spent a lifetime playing.\\n\\nThe music – African-leaning R‘n’B – is full blooded, uplifting and unprocessed. Founded by multi-instrumentalist Charlie Hart, who immersed himself in R&B and African music after many years with Ronnie Lane’s Slim Chance, the band is fronted by him along with the astonishingly dynamic sax and harp man, Frank Mead, known for his work with Bill Wyman’s Rhythm Kings, Gary Moore and many others.\\n\\nThe line-up is completed by the acclaimed guitarist Jimmy Roche (East of Eden/Major Surgery), with a dream rhythm section comprising Roy Dodds (Fairground Attraction/Eddi Reader) on drums, and virtuoso bassist Phil Scragg (Dudu Pukwana/Robert Plant). Charlie Hart’s Equators’ album ‘Masansani Club’ is available on Equator Records, distributed by Cadiz.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1791122400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T00:00:00+00:00\",\"sale_end_date\":\"2026-10-04T18:00:00+01:00\",\"sale_start_date\":\"2026-01-17T00:00:00+00:00\",\"event_start_date\":\"2026-10-04T18:00:00+01:00\",\"event_end_date\":\"2026-10-04T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvkql8-merry-mccloud-bruce-welch-4th-oct-the-bread-and-roses-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\"