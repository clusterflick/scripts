ut_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772046000,\"has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:35\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-16/6f0b2d7b-b2ba-4268-b416-234bd8bc4764.jpg?rect=0%2C1440%2C5760%2C5760\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-16/6f0b2d7b-b2ba-4268-b416-234bd8bc4764.jpg?rect=0%2C2592%2C5760%2C3456\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-16/6f0b2d7b-b2ba-4268-b416-234bd8bc4764.jpg?rect=504%2C0%2C4752%2C8640\"},\"id\":\"684d6f495633830001216eb0\",\"name\":\"Kezia Gill\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Fresh from signing with Universal’s Snakefarm label and with brand new music on the horizon, Kezia Gill is set to take things up a gear. Her highly anticipated new album 'All On Red', recorded in the heart of Nashville, is on the way!\\n\\nKezia will be hitting the road with her full band for a ten-date UK tour in February 2026, giving fans the chance to hear the new music live for the very first time. Recently crowned AMA-UK Live Act of the Year, she continues to prove why she’s one of the most exciting live performers in the UK Country and Americana scene.\\n\\nWe’re also thrilled to welcome very special guest Alyssa Bonagura (USA) as support across the entire tour.\\n\\nDon’t miss your chance to see Kezia and Alyssa live!\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*Stage times are posted at 11am on the day of the show on our website.*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\n*Accessible and carer ticketing information: http://islingtonassemblyhall.co.uk/about/accessibility/*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-17T10:00:00+01:00\",\"sale_end_date\":\"2026-02-25T21:00:00+00:00\",\"sale_start_date\":\"2025-06-20T10:00:00+01:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Kezia Gill - I'm Here\",\"redirect_url\":\"https://open.spotify.com/track/7Gj9uY2bWQOSl6ubnM7WZk\",\"artist\":\"Kezia Gill\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d338d2139d168118da67ee602f72bc988c8025cc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I'm Here\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/Tc0142Qaifl5qR3ZPoGjcMPrXheo9lysY9ZAJLO9ZBTs.m3u8\",\"track_name\":\"\"},{\"type\":\"apple_music\",\"title\":\"Kezia Gill - Whiskey Over Ice\",\"redirect_url\":\"https://music.apple.com/us/album/whiskey-over-ice/1693724456?i=1693724458&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kezia Gill\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/c0/d4/31/c0d4313a-9790-126d-bb0f-ddbd9d7879ec/mzaf_3380620566854544008.plus.aac.p.m4a\",\"track_name\":\"Whiskey Over Ice\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Keystone\",\"image\":null,\"artist_id\":\"65168\",\"about\":null,\"is_headliner\":false},{\"name\":\"The outers\",\"image\":null,\"artist_id\":\"19420\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by London Music Showcase.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"5670\",\"name\":\"O'Neill's Wardour Street\",\"address\":\"33-37 Wardour St, London W1D 6PU, UK\",\"location\":{\"lat\":51.5113281,\"lng\":-0.1322603},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oneills-wardour-street-va26\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:15:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"announcement_date_unix\":1758582000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Kba544f12c8d?dice_id=Kba544f12c8d\",\"post_competition_referral\":\"https://link.dice.fm/T07d2931fad4?dice_id=T07d2931fad4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J608af17a7c5?dice_id=J608af17a7c5\",\"post_purchase_referral\":\"https://link.dice.fm/i717f9b0672b?dice_id=i717f9b0672b\",\"post_reminder_referral\":\"https://link.dice.fm/K8f6ad3f0a7c?dice_id=K8f6ad3f0a7c\",\"post_waitinglist_referral\":\"https://link.dice.fm/M679e1a38204?dice_id=M679e1a38204\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"l8b7vp-london-music-ultimate-showcase-keystone-25th-feb-oneills-wardour-street-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772046900,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:36\",\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-01/0f498631-2968-4f9c-83ff-ea058c4b4db9.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-01/0f498631-2968-4f9c-83ff-ea058c4b4db9.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-01/0f498631-2968-4f9c-83ff-ea058c4b4db9.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"6979403e0232ad00014f7f3b\",\"name\":\"London Music Ultimate Showcase: Keystone\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-23T00:00:00+01:00\",\"sale_end_date\":\"2026-02-25T19:00:00+00:00\",\"sale_start_date\":\"2025-09-23T00:00:00+01:00\",\"event_start_date\":\"2026-02-25T19:15:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jonique\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-26/eff68ac7-e941-42ed-abf3-d0b420dc284b.jpg?rect=0%2C0%2C966%2C966\"},\"artist_id\":\"25320\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ignoring Izzy\",\"image\":null,\"artist_id\":\"128673\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The George Tavern\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1252\",\"