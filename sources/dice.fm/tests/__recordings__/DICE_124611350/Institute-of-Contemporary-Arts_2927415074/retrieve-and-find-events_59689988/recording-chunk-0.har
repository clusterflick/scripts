_referral\":\"https://link.dice.fm/e376cd9896ee?dice_id=e376cd9896ee\",\"post_waitinglist_referral\":\"https://link.dice.fm/ub84e927328e?dice_id=ub84e927328e\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yo66g2-skaphos-antania-17th-apr-229-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776452400,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:9\",\"price\":{\"currency\":\"GBP\",\"amount\":1597,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/5f466970-b20b-48cb-aa06-d6e94253905f.jpg?rect=513%2C0%2C1022%2C1022\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/5f466970-b20b-48cb-aa06-d6e94253905f.jpg?rect=173%2C0%2C1703%2C1022\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/5f466970-b20b-48cb-aa06-d6e94253905f.jpg?rect=743%2C0%2C562%2C1022\"},\"id\":\"696f6b0137cbb70001683bc0\",\"name\":\"Skaphos + Antania\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Skaphos is a French Abyssal Death Metal band formed in 2018 - Merging the eerie dissonances of Black Metal with the sheer heaviness of Death Metal in a very violent way.\\n\\nRenowned for their harrowing, ritualistic live shows, Skaphos has performed in over 20 countries, touring across Europe and Asia with legendary acts such as I Am Morbid, Vader Marduk, Suffocation, Belphegor, Batushka and Vomitory.\\n\\nTheir abyssal universe extends beyond the stage, with evocative music videos and the short film La Litanie des Flots (2022). They are currently working on a full-length film, Aurores Noires, scheduled for 2026.\\n\\n\\\\+ Support from Antania\\n\\nThe Californian project is a fusion of bass and death metal, creating a unique sound that's been described as \\\"AGGROTECH Death Metal\\\" or “Doom Bass”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T18:00:00+00:00\",\"sale_end_date\":\"2026-04-17T17:00:00+01:00\",\"sale_start_date\":\"2026-01-20T18:00:00+00:00\",\"event_start_date\":\"2026-04-17T20:00:00+01:00\",\"event_end_date\":\"2026-04-17T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Skaphos - Bathyscaphe\",\"redirect_url\":\"https://music.apple.com/us/album/bathyscaphe/1630759769?i=1630759770&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Skaphos\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/f6/aa/ff/f6aaff93-000e-47b7-cc39-5e80610fc5d1/mzaf_16453590379807507645.plus.aac.p.m4a\",\"track_name\":\"Bathyscaphe\"},{\"type\":\"spotify\",\"title\":\"Skaphos - Bathyscaphe\",\"redirect_url\":\"https://open.spotify.com/track/6tM7WZi3y1twyGcpiTONP7\",\"artist\":\"Skaphos\",\"preview_url\":\"https://p.scdn.co/mp3-preview/00c086f8c6370672e20f0ce6ba836573963fbc2e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Bathyscaphe\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Arca\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-07-15/909f045b-196f-4a54-b43d-92e58202289e.jpg?rect=0%2C10%2C621%2C621\"},\"artist_id\":\"818\",\"about\":{\"description\":\"Since debuting in 2012, Arca has become an in-demand producer, composer and visual artist with a catalogue of work encompassing glitchy IDM, industrial hip-hop and experimental reggaeton. Their musical output is influenced by their non-binary trans identity, while their live shows closely resemble performance art – featuring pole dancing, interactive art installations and traditional Venezuelan instruments.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":3},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by NTS & FORM.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"6559\",\"name\":\"HERE at Outernet\",\"address\":\"Denmark St, Charing Cross Rd, London WC2H 8LH, UK\",\"location\":{\"lat\":51.5152089,\"lng\":-0.1295818},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-23/44412f0d-34b8-41b5-8483-6f9558894d40.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"here-at-outernet-wgbx\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/24679933108753-HERE-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T21:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"announcement_date_unix\":17