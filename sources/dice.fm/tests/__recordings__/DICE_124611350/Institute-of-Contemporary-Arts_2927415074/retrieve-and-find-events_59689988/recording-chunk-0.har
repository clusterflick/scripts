_type\":\"purchase\",\"perm_name\":\"dkadrq-patterns-weekly-live-jazz-11th-mar-night-tales-loft-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":99,\"name\":\"Night Tales\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/5e2aabd2b0d5c87010fb3d64/t/5e3f17972c3202581310afa8/1581193111803/BACKGROUND+CLUBS+LIMITED+PRIVACY+AND+COOKIES+STATEMENT.pdf\",\"fb_pixel_id\":\"219310887034475\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BCLUBS%2BLIMITED%2BPRIVACY%2BAND%2BCOOKIES%2BSTATEMENT.pdf\",\"fb_pixel_id\":\"1020185540161660\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773252000,\"has_multiple_ticket_types\":true,\"impression_id\":\"49dcf1c1636e57c2:24\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-17/5662bc93-6599-4f73-8486-d755b4a88606.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-17/5662bc93-6599-4f73-8486-d755b4a88606.jpg?rect=0%2C550%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-17/5662bc93-6599-4f73-8486-d755b4a88606.jpg?rect=200%2C0%2C1100%2C2000\"},\"id\":\"6942871b276a1b000116ca85\",\"name\":\"PATTERNS Weekly Live Jazz\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Every Wednesday, Patterns brings together some of London's finest musicians for an evening of improvised music. From Jazz to Soul, Broken-Beat to Hip Hop and beyond, our weekly jazz sessions offer a space for collaboration between musicians of all styles and flavours.\\n\\nStriving to always be inclusive and showcase the best of emerging talent; egos are always left at the door to create an intimate experience for the listeners and performers alike.\\n\\nLive music starts at 8pm. Playlist before.\\n\\nP A T T E R N S\\n\\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**ONLINE TICKETS**\\n\\n- Different ticket types are available.\\n- Please check the information on your ticket before making a purchase.\\n\\n**TABLE BOOKINGS**\\n\\n- Guarantee yourself a table by booking a table via our website ➡ www.ntloft.co.uk\\n- There are 2 sessions available:\\n\\n\\\\- Early Session = 6pm - 9pm\\n\\n\\\\- Late Session = 9:15pm - 11pm\\n\\n- If you have a table for the early session, you may be asked to leave your table for the start of the late session. You are welcome to stay and stand in the venue. Other seating will be arranged if available.\\n\\n**WALK-INS**\\n\\n- Entry is FREE before 7:30pm.\\n- Entry after 7:30pm is £5.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2023-03-15T17:00:00+00:00\",\"sale_end_date\":\"2026-03-11T22:30:00+00:00\",\"sale_start_date\":\"2023-03-15T17:00:00+00:00\",\"event_start_d