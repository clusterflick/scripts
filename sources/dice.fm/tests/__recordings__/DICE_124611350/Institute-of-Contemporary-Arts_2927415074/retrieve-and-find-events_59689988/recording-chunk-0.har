pes\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Liqueur\",\"image\":null,\"artist_id\":\"98566\",\"about\":null,\"is_headliner\":false},{\"name\":\"Reptile House\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27303605727847e09d62f63a8fc\"},\"artist_id\":\"129561\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-03T18:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-29/6f07bbec-3066-4694-930d-a799ab7362ca.jpg?rect=167%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-29/6f07bbec-3066-4694-930d-a799ab7362ca.jpg?rect=0%2C116%2C1413%2C848\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-29/6f07bbec-3066-4694-930d-a799ab7362ca.jpg?rect=410%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Lbc20e15a2e5?dice_id=Lbc20e15a2e5\",\"post_competition_referral\":\"https://link.dice.fm/oee698950a42?dice_id=oee698950a42\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ka0606d23deb?dice_id=Ka0606d23deb\",\"post_purchase_referral\":\"https://link.dice.fm/V744750ec233?dice_id=V744750ec233\",\"post_reminder_referral\":\"https://link.dice.fm/Uab3a5d06ba4?dice_id=Uab3a5d06ba4\",\"post_waitinglist_referral\":\"https://link.dice.fm/M5bb6d99e864?dice_id=M5bb6d99e864\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:6\",\"properties\":[],\"presented_by\":\"Presented by New Cross Live.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1761696000,\"id\":\"690204c1b7b34100010d5337\",\"name\":\"Liqueur\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Liqueur - a tribute to The Cure\\n\\nThe idea of forming a Cure tribute band was first ‘jokingly’ discussed over more than a few beers in the summer of 2006. The original idea was to be a food and drink-based tribute band, given The Cure’s reputation as enthusiastic drinkers and lovers of a good curry!\\n\\nHours of fun ensued ‘fooding up’ Cure songs and albums, including such gems as Piemary, A Forest Gateaux, Quiche me Quiche Me Quiche Me and Seventeen Seconds (can you see what we did there?). However once sober, it was decided that a more traditional’ tribute route should be taken if we ever wanted to play to an audience without getting food thrown at us! However, the throwaway name, Liqueur, seemed to stick.\\n\\n​\\n\\nWhat makes Liqueur special is the fact that we all like The Cure; we’ve been fans since we were kids (I would calculate the accumulative fan years we hold but I don’t have enough fingers, and hailing from Norfolk, that’s really saying something!). Reproducing the songs is the easy part, we want to look, sound, eat and drink The Cure, therefore we try to use the same equipment as the band wherever we can (thank you eBay and Barclaycard!) and the look and feel of our gigs is very important to us. When we play a gig….we are The Cure and we want you to feel like you are watching The Cure.\\n\\nplus special guests\\n\\nReptile House - a tribute to Sisters Of Mercy\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s require an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"date_unix\":1791046800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2380,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T10:00:00+00:00\",\"sale_end_date\":\"2026-10-02T15:00:00+01:00\",\"sale_start_date\":\"2026-02-11T10:00:00+00:00\",\"event_start_date\":\"2026-10-03T19:00:00+01:00\",\"event_end_date\":\"2026-10-03T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"yoa2ga-swim-deep-3rd-oct-moth-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Honey\",\"redirect_url\":\"https://open.spotify.com/track/0XN5vm980boRCELIwD2CIe\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/97303c9224cc5b7eb8f7724c4205241427e3788a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Honey\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Swim Deep\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-17/5cd92cb6-a980-4b5c-ac3d-14c5320fc62c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\