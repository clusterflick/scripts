e\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":700},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T10:00:00+00:00\",\"sale_end_date\":\"2026-03-07T19:00:00+00:00\",\"sale_start_date\":\"2026-02-17T10:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:30:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eore96-daffodils-kansas-city-playboys-golden-toad-7th-mar-paper-dress-vintage-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Golden Toad\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2732515b36a746d685fbfc1e1e7\"},\"artist_id\":\"130488\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kansas City Playboys\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273f688503a5569024096727b47\"},\"artist_id\":\"124017\",\"about\":null,\"is_headliner\":false},{\"name\":\"Daffodils\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-06/c5331338-1ed4-4abc-8510-c67fa0f4206e.jpg?rect=0%2C0%2C300%2C300\"},\"artist_id\":\"77677\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"373\",\"name\":\"Paper Dress Vintage\",\"address\":\"352a Mare Street, London, E8 1HR, United Kingdom\",\"location\":{\"lat\":51.54733,\"lng\":-0.05467},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-29/13fc3fd2-f3f2-4ebb-b479-d3d2d7cf5214.jpg?rect=683%2C0%2C2731%2C2731\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/88da58f4-99cf-48f1-98a2-b7c845650a61.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/88da58f4-99cf-48f1-98a2-b7c845650a61.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/88da58f4-99cf-48f1-98a2-b7c845650a61.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/k686c5fa4295?dice_id=k686c5fa4295\",\"post_competition_referral\":\"https://link.dice.fm/ab220601c70a?dice_id=ab220601c70a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/yefb52159ba9?dice_id=yefb52159ba9\",\"post_purchase_referral\":\"https://link.dice.fm/d1add2d61e54?dice_id=d1add2d61e54\",\"post_reminder_referral\":\"https://link.dice.fm/xe946f6a90d8?dice_id=xe946f6a90d8\",\"post_waitinglist_referral\":\"https://link.dice.fm/f8f5c9b91b92?dice_id=f8f5c9b91b92\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:49\",\"properties\":[],\"presented_by\":\"Presented by Flash Delirium & Paper Dress Live.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771322400,\"id\":\"699452420a67650001aac824\",\"name\":\"Daffodils + Kansas City Playboys + Golden Toad\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Flash Delirium & Paper Dress Live** are proud to bring you this fantastic bill of garage surf rock, alternative country rock, and psych goodness that will cause a beautiful and chaotic ruckus ! 🔥🔥🔥\\n\\n**DAFFODILS**\\n\\nLondon's own Daffodils are a high-energy force, blending skiffle, surf rock, and garage rock into a chaotic display of energy. The sextet group now performs with the world's first on-stage musical clay sculptor, who reacts to the noise as it unfolds.\\n\\n**KANSAS CITY PLAYBOYS**\\n\\nFormed under the fiery sun of Kansas City Missouri in 1954 the Playboys first met during a violent brawl in Manny’s Fried Chicken bar over a dispute involving the wealthy wife of a senator.\\n\\nFounder members Ivan Self and Teddy Hindsight were press-ganged into playing an improvised set to pay for damages incurred. Lap Steel player Francis Wolfe was added after being saved from a life as a rent boy in downtown Philadelphia. Bass player Ben Fox was later found hiding in their touring van.\\n\\nAfter many decades of great success and miserable failure the Playboys are back in 21st century London Town based out of Camberwell.\\n\\n**GOLDEN TOAD**\\n\\nA mind melting exploration. Electronica meets krautrock meets psych meets ambient.\\n\\nGolden Toad is the brand new musical project of Al Brown (formerly of Japanese Television)\\n\\nIt sees him team up with Four Tet championed producer Callum ASA and Chris Smith (Hot Chip, Kikakagu Moyo, Billy Childish) - make sure you get down early to catch this set!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2624\",\"name\":\"Paper Dress Vintage\",\"image\":{\"url\":null},\"perm_name\":\"paper-dress-vintage-67xq\",\"profile_active\":false},\"date_unix\":1772911800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-15T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T22:30:00+00:00\",\"sale_start_date\":\"2026-02-15T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:30:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5mgqp-what-happens-next-tegal-cat-pushkick-7th-mar-the-finsbury-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"What Happens Next\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebb1a3753cfb616c5b608f7427\"},\"artist_id\":\"123984\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":2,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"205\",\"name\":\"The Finsbury\",\"address\":\"336 Green Lanes, London N4 1BY\",\"location\":{\"lat\":51.5719307,\"lng\":-0.0963550999999825},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"co