nscious.\\n\\nThe screening will be accompanied by a curated selection of Cunningham’s music videos.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T00:00:00+00:00\",\"sale_end_date\":\"2026-03-28T14:00:00+00:00\",\"sale_start_date\":\"2026-01-23T00:00:00+00:00\",\"event_start_date\":\"2026-03-28T14:00:00+00:00\",\"event_end_date\":\"2026-03-28T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Squarepusher - Come On My Selector\",\"redirect_url\":\"https://open.spotify.com/track/59gAXwLxVtS8ebM81GnpXp\",\"artist\":\"Squarepusher\",\"preview_url\":\"https://p.scdn.co/mp3-preview/02a1fe74b3f7335a88117447e42cbd529e47979e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Come On My Selector\"},{\"type\":\"apple_music\",\"title\":\"Squarepusher - Come On My Selector\",\"redirect_url\":\"https://music.apple.com/us/album/come-on-my-selector/200940766?i=200942406&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Squarepusher\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/88/3b/cd/883bcd1b-f087-c6d0-190b-ccc72aada026/mzaf_16715282628378590385.plus.aac.p.m4a\",\"track_name\":\"Come On My Selector\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Film Screening\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-09-15/0b8ef9ab-63ad-41fd-bec4-98e25f9bca16.jpg?rect=67%2C0%2C798%2C798\"},\"artist_id\":\"11393\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Deeper Into Movies.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\