92190?dice_id=j381ca392190\",\"post_reminder_referral\":\"https://link.dice.fm/O6db991fb585?dice_id=O6db991fb585\",\"post_waitinglist_referral\":\"https://link.dice.fm/J92debe7bb57?dice_id=J92debe7bb57\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6dnlnb-suep-friends-2nd-apr-the-george-tavern-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775154600,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:5\",\"price\":{\"currency\":\"GBP\",\"amount\":850,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/6d0c41b1-6c38-4f39-b5e0-57bb8eec4e6c.jpg?rect=0%2C185%2C2078%2C2078\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/6d0c41b1-6c38-4f39-b5e0-57bb8eec4e6c.jpg?rect=0%2C778%2C2078%2C1247\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/6d0c41b1-6c38-4f39-b5e0-57bb8eec4e6c.jpg?rect=268%2C0%2C1542%2C2803\"},\"id\":\"6972528b07d2ba0001c60304\",\"name\":\"SUEP + friends\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"South London underground favourites SUEP announce their debut album 'Forever', out 27th of March, via Memorials of Distinction, with the incredible new single 'Highway II'.\\n\\nReceiving acclaim across BBC 6 Music and the indie press for their ‘car boot sale’ pop music, SUEP rummage through the jumble bin of music history, selecting and reassembling its best parts into something playful, strange and deeply artful.\\n\\n'Forever' is a confident debut, a masterpiece of modern indie songcraft. Across the album SUEP dip into country, synthpop, garage rock, post punk, and pub rock, but always retain their signature penchant for melodic hooks, snappy structures and straight-to-the-heart lyrics.\\n\\nLed by Georgie Stott and Joshua Harvey, SUEP have become fixtures of south-east London’s underground through a series of shared living spaces, improvised studios and DIY venues. Now with George Nicholls (The Tubs, Joanna Gruesome, GN Band), William Deacon (PC World), and Louis Forster (The Goon Sax, Expiry) completing the line up, their debut is finally on its way.\\n\\n'Forever' is a glimpse into one of the best bands on the scene, not fitting into any trend, but also never fading into obscurantism - SUEP are a band that wear a joie de vivre loosely but fashionably. Now is their time to shine.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T12:00:00+00:00\",\"sale_end_date\":\"2026-04-02T21:00:00+01:00\",\"sale_start_date\":\"2026-01-29T12:00:00+00:00\",\"event_start_date\":\"2026-04-02T19:30:00+01:00\",\"event_end_date\":\"2026-04-02T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"SUEP - Highway II\",\"redirect_url\":\"https://open.spotify.com/track/2AQpWeWAmBP1beRVMH0JrG\",\"artist\":\"SUEP\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2416a8cb7e7669d4561f31de6a0aa5301232074d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Highway II\"},{\"type\":\"apple_music\",\"title\":\"SUEP - Highway II\",\"redirect_url\":\"https://music.apple.com/us/album/highway-ii/1858219769?i=1858219925&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"SUEP\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/a4/cd/79/a4cd797f-9657-4574-08e2-f5dfa1675cf8/mzaf_10734163410753155063.plus.aac.p.m4a\",\"track_name\":\"Highway II\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_ar