_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1674\",\"name\":\"JOY.\",\"image\":{\"url\":null},\"perm_name\":\"joy-bv9o\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:89\",\"date_unix\":1775152800,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/l77c8d2d00a1?dice_id=l77c8d2d00a1\",\"post_competition_referral\":\"https://link.dice.fm/n49624018e93?dice_id=n49624018e93\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s1cd0a0d8b78?dice_id=s1cd0a0d8b78\",\"post_purchase_referral\":\"https://link.dice.fm/B76fbf3163da?dice_id=B76fbf3163da\",\"post_reminder_referral\":\"https://link.dice.fm/o7dfcd73042f?dice_id=o7dfcd73042f\",\"post_waitinglist_referral\":\"https://link.dice.fm/d3d6b83539f5?dice_id=d3d6b83539f5\"},\"perm_name\":\"bb399x-nick-and-june-2nd-apr-sebright-arms-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/c0b7a56e-f6ee-43da-98da-134af3de0a9b.jpg?rect=0%2C231%2C1365%2C1365\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/c0b7a56e-f6ee-43da-98da-134af3de0a9b.jpg?rect=0%2C615%2C1365%2C819\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/c0b7a56e-f6ee-43da-98da-134af3de0a9b.jpg?rect=120%2C0%2C1126%2C2048\"},\"properties\":[],\"about\":{\"description\":\"Nick & June drift through a shimmering haze of reverb-soaked guitars, vibrating synths, and gently pulsing beats and drums. Their voices merge into a hypnotic mélange, guiding listeners through a delicate balance of euphorically staged restraint and intricate, winding thoughts. Their sound is an eclectic fusion of melancholic indie folk – evoking Bon Iver, Velvet Underground, and Big Thief – blended with the dream-pop textures of Beach House and Lana Del Rey, and the alternative rock tones reminiscent of The National, St. Vincent, and Mazzy Star.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697a327726427c00013345b7\",\"name\":\"Nick and June\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Nick & June - Anthem\",\"redirect_url\":\"https://music.apple.com/us/album/anthem/1842205440?i=1842205441&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Nick & June\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/f8/55/9a/f8559ab7-b9b9-5bbb-25d9-dbe0367142c5/mzaf_9025243042095408646.plus.aac.p.m4a\",\"track_name\":\"Anthem\"},{\"type\":\"spotify\",\"title\":\"Nick & June - Anthem\",\"redirect_url\":\"https://open.spotify.com/track/4V4jCd1lExqCiV14dz5HhW\",\"artist\":\"Nick & June\",\"preview_url\":\"https://p.scdn.co/mp3-preview/86f9d20d66dd015ebd62a7f6d64e9c88738f95b8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Anthem\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nick & June\",\"image\":null,\"artist_id\":\"133065\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T01:00:00+00:00\",\"sale_end_date\":\"2026-04-02T18:00:00+01:00\",\"sale_start_date\":\"2026-01-21T01:00:00+00:00\",\"event_start_date\":\"2026-04-02T19:00:00+01:00\",\"event_end_date\":\"2026-04-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":true,\"faqs\":[{\"id\":71032,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":71033,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":71034,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[{\"ticket_type_id\":1173393,\"extra_ids\":[\"1180285\"]}],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Underworld.\",\"seating\":null,\"announcement_date_unix\":1768957200,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-02T19:00:00+01:00\",\"doors_close_date\":\"2026-04-02T22:00:00+01:00\"}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:90\",\"date_unix\":1775152800,\"price\":{\"currency\":\"GBP\",\"amount\":2704,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Ef8fa1e42c03?dice_id=Ef8fa1e42c03\",\"post_competition_referral\":\"https://link.dice.fm/Bf789981e630?dice_id=Bf789981e630\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t0bd670be1ac?dice_id=t0bd670be1ac\",\"post_purchase_referral\":\"https://link.dice.fm/rb4110f3401d?dice_id=rb4110f3401d\",\"post_reminder_referral\":\"https://link.dice.fm/E15335538ca9?dice_id=E15335538ca9\",\"post_waitinglist_referral\":\"https://link.dice.fm/h0b13d38d58a?dice_id=h0b13d38d58a\"},\"perm_name\":\"eo3r2o-ignite-2nd-apr-the-underworld-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/c67974b8-7036-42fe-bf9d-94fbaad54e87.jpg?rect=560%2C0%2C2240%2C2240\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/c67974b8-7036-42fe-bf9d-94fbaad54e87.jpg?rect=0%2C112%2C3360%2C2016\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/c67974b8-7036-42fe-bf9d-94fbaad54e87.jpg?rect=1064%2C0%2C1232%2C2240\"},\"properties\":[],\"about\":{\"description\":\"Formed in Orange County, California, IGNITE have spent over 25 years forging a sound rooted in hardcore punk yet impossible to categorise. With five albums behind them — including Our Darkest Days (2006) and A War Against You (2016), which entered the German album charts at #6 — the band built a global reputation through relentless touring across Europe, North America, Australia, South America and the Far East.\\n\\nIn 2019, founding members Brett Rasmussen, Nik Hill, Kevin Kilkenny and Craig Anderson found themselves at a crossroads, determined not only to continue but to evolve. Against the backdrop of a turbulent, Covid-shuttered world, they wrote their most expansive material to date and welcomed new vocalist Eli Santana — an unexpected but inspired choice whose passion and power reinvigorated the band.\\n\\nReuniting with long-time producer Cameron Webb, IGNITE’s self-titled album captures a band fully aligned with its past and future: melodic, political, and driven. Known for thriving before diverse audiences — from hardcore clubs to major festivals alongside bands like Bad Religion, Hatebreed and Rise Against — IGNITE now enter a new chapter, fuelled by the same conviction that defined them in 1993: honest music, played with purpose.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"id\":\"697096e5b76d3f000154a074\",\"name\":\"IGNITE\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Incite - Built to Destroy\",\"redirect_url\":\"https://music.apple.com/us/album/built-to-destroy/1796019008?i=1796019009&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Incite\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/99/63/a3/9963a34e-430b-dd7a-5691-f94fc11fb1ff/mzaf_5484336536001448404.plus.aac.p.m4a\",\"track_name\":\"Built to Destroy\"},{\"type\":\"spotify\",\"title\":\"Incite - Built to Destroy\",\"redirect_url\":\"https://open.spotify.com/track/49Yrtz9obsEIZwjrDbzFVo\",\"artist\":\"Incite\",\"preview_url\":\"https://p.scdn.co/mp3-preview/853e61c949fd4b6a4008731032eec39251a3706c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Built to Destroy\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jawless\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2730d0083a18ee97fa107a07c6f\"},\"artist_id\":\"36551\",\"about\":null,\"