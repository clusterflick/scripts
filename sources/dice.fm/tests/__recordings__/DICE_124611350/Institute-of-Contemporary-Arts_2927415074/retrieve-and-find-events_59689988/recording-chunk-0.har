urchase_extras_available_referral\":\"https://link.dice.fm/gd374d54f585?dice_id=gd374d54f585\",\"post_purchase_referral\":\"https://link.dice.fm/Nb59a6ce4cca?dice_id=Nb59a6ce4cca\",\"post_reminder_referral\":\"https://link.dice.fm/H9fa8150c8a9?dice_id=H9fa8150c8a9\",\"post_waitinglist_referral\":\"https://link.dice.fm/x5ad00b245f4?dice_id=x5ad00b245f4\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**Nena stands as one of the most exciting, emotionally resonant voices in contemporary Portuguese pop, enthralling audiences with her candid storytelling and irresistible melodies.**\\n\\nFrom her early start writing songs at 12 to her professional leap in 2019, Nena has quickly charmed audiences with her genuine, heartfelt compositions on the universal theme of love.\\n\\nFollowing the success of tracks like ‘Portas do Sol’ and ‘Do Meu Ao Teu Correio’ from her 2022 debut album, *Ao fundo da rua*, Nena has gone from sold-out shows at Casino Estoril to filling the iconic Coliseu dos Recreios.\\n\\nFresh from releasing her highly anticipated second album, *Um Brinde ao Agora (A Toast to Now)*, she brings her acclaimed presence and magnetism to our stage for an unmissable night of modern Portuguese pop music.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1797188400,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway