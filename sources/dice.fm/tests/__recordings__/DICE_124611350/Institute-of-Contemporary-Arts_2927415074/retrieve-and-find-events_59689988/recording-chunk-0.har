\":[{\"id\":\"373\",\"name\":\"Paper Dress Vintage\",\"address\":\"352a Mare Street, London, E8 1HR, United Kingdom\",\"location\":{\"lat\":51.54733,\"lng\":-0.05467},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-29/13fc3fd2-f3f2-4ebb-b479-d3d2d7cf5214.jpg?rect=683%2C0%2C2731%2C2731\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-03T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/0ba85711-68f0-4ef9-91d1-19632fc0260a.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/0ba85711-68f0-4ef9-91d1-19632fc0260a.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/0ba85711-68f0-4ef9-91d1-19632fc0260a.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/qda0432caaae?dice_id=qda0432caaae\",\"post_competition_referral\":\"https://link.dice.fm/be9257d8b03c?dice_id=be9257d8b03c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Pdc8776f3c53?dice_id=Pdc8776f3c53\",\"post_purchase_referral\":\"https://link.dice.fm/Vd1950fe6f38?dice_id=Vd1950fe6f38\",\"post_reminder_referral\":\"https://link.dice.fm/Uffafa40b52d?dice_id=Uffafa40b52d\",\"post_waitinglist_referral\":\"https://link.dice.fm/Nb01916a70b2?dice_id=Nb01916a70b2\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:67\",\"properties\":[],\"presented_by\":\"Presented by Paper Dress Live.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770295500,\"id\":\"6984936febda19000115ee6c\",\"name\":\"PDV Unplugged ft. Caleb Kanule & Friends + Madeline Thorp \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**An Unplugged Celebration of Music & Connection**\\n\\nJoin us for a special live music event honoring Hearing Wellness Week (2nd - 8th March). This audio-inclusive performance in collaboration with **Sownd Affects**, has been thoughtfully curated for all with noise sensitivity, offering the joy and energy of live music in a comfortable, welcoming environment. An enhanced experience for everyone that allows the audience to truly connect with the music.\\n\\n**Artist Line-Up:**\\n\\n**CALEB KUNLE**\\n\\nCaleb Kunle returns for his third Hearing Wellness Week performance as a dedicated ambassador for audio-inclusive music. Drawing from the rich storytelling traditions of Ireland and Nigeria, Caleb delivers a soulful sound designed to make you FEEL. For this special event, he'll perform completely unplugged with two backing vocalists, percussion, guitar and bass for an uplifting, thought-provoking set.\\n\\n**MADELINE THORP**\\n\\nAn indie/folk musician whose work weaves soul-baring lyrics with fearless, dry wit. Currently collaborating with National Youth Music Theatre on inclusive live performance practices, Maddie brings deep personal commitment to accessible music - inspired by her grandfather who was hard of hearing and her grandmother with Alzheimer's, who found peace through music delivered with auditory calm\\n\\n**More info about Sownd Affects & Hearing Wellness Week**\\n\\nDid you know, a staggering 1 in 3 is noise sensitive? This includes individuals who are hard of hearing, neurodivergent (e.g. ADHD, autism) over 55, or living with conditions such as misophonia. Now, those of you in our community who are sensitive to noise can comfortably enjoy our space and our live music events. We’re marking this milestone with a very special Unplugged gig, as part of Hearing Wellness Week (2-8 March) that’s bringing music to life for all those who enjoy live music without the fear of noise overwhelm.\\n\\nIf you’re noise sensitive, know someone who is or are just curious to experience the changes that have been made, join us on 3rd March for this very special audio inclusive gig!\\n\\nThis gig forms a series of live, unplugged acoustic gigs that we’ll be hosting throughout the year. Check their website for more information on the gig line up and if you’re noise sensitive and want to learn more about the movement, check out sowndaffects.com.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2624\",\"name\":\"Paper Dress Vintage\",\"image\":{\"url\":null},\"perm_name\":\"paper-dress-vintage-67xq\",\"profile_active\":false},\"date_unix\":1772566200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":850,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-21T00:00:00+00:00\",\"sale_end_date\":\"2026-03-03T21:00:00+00:00\",\"sale_start_date\":\"2025-12-21T00:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:30:00+00:00\",\"event_end_date\":\"2026-03-03T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"5382ad-anastasia-coope-presents-bonzo-3rd-mar-windmill-brixton-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Anastasia Coope - Oregon\",\"redirect_url\":\"https://open.spotify.com/track/3SC3E8glB6aENUk5rANSvK\",\"artist\":\"Anastasia Coope\",\"preview_url\":\"https://p.scdn.co/mp3-preview/760944af0ebaa19fbd7cf74a4486dc72c2883dae?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Oregon\"},{\"type\":\"apple_music\",\"title\":\"Anastasia Coope - Oregon\",\"redirect_url\":\"https://music.apple.com/us/album/oregon/1832546406?i=1832546415&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Anastasia Coope\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/14/3e/ca/143eca89-c461-227a-b371-6b7e7908cd5a/mzaf_17126447670380678947.plus.aac.p.m4a\",\"track_name\":\"Oregon\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Anastasia Coope\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb756495b5fada51fcf9a50737\"},\"artist_id\":\"53001\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"441\",\"name\":\"Windmill Brixton\",\"address\":\"22 Blenheim Gardens, London SW2 5BZ\",\"location\":{\"lat\":51.454073,\"lng\":-0.122336300000029},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"windmill-brixton-jxdl\",\"accessibility\":{\"url\":\"https://www.windmillbrixton.co.uk/visitor-info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-03T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-21/6b93811f-4e2f-4bb5-a2c2-03b3e0b532b5.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-21/6b93811f-4e2f-4bb5-a2c2-03b3e0b532b5.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-21/6b93811f-4e2f-4bb5-a2c2-03b3e0b532b5.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/G23cac507c9c?dice_id=G23cac507c9c\",\"post_competition_referral\":\"https://link.dice.fm/D4709b338243?dice_id=D4709b338243\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k1235a2803f5?dice_id=k1235a2803f5\",\"post_purchase_referral\":\"https://link.dice.fm/rd17da942c50?dice_id=rd17da942c50\",\"post_reminder_referral\":\"https://link.dice.fm/i0a62b918bf5?dice_id=i0a62b918bf5\",\"post_waitinglist_referral\":\"https://link.dice.fm/g9541fc1d6c5?dice_id=g9541fc1d6c5\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:68\",\"properties\":[],\"presented_by\":\"Presented by Windmill Brixton.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766275200,\"id\":\"69482abe739dc200012b564c\",\"name\":\"Anastasia Coope presents Bonzo\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"ANASTASIA COOPE https://www.instagram.com/anastasiacoope/\\n\\nIn upstate New Yorker Anastasia Coope's world, there is little difference between a confrontation and a welcoming gesture. Listening to her music, one is struck by her gift for vocal harmony and rich personal vision that borrows as much from the light and color of painting as it does from experimental music.\\n\\nThe release of the Darning Woman album in 2024 on Jagjaguwar Records saw critical acclaim and international success as she pushed the idiom of folk music to its limits.\\n\\nAfter the album's tour, she founded Bonzo Records, - an independent label, curatorial project, and creative collective where she intensified the exploration of her musical and artistic practice.\\n\\nHer Bonzo nights bring together a range of experimental, avant-folk, electronic, or underground artists - more news on that soon.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"487\",\"name\":\"Windmill Brixton\",\"image\":{\"url\":null},\"perm_name\":\"windmill-brixton-4mgk\",\"profile_active\":false},\"date_unix\":1772566200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T10:00:00+00:00\",\"sale_end_date\":\"2026-03-03T22:00:00+00:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:30:00+00:00\",\"event_end_date\":\"2026-03-03T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"dka3lo-le-lamb-brain-leak-hanna-the-big-bad-wolf-3rd-mar-the-shacklewell-arms-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hanna, The Big Bad Wolf\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-30/49af5ca2-4be7-4b63-9d69-0f2a274ad5ee.jpg?rect=0%2C54%2