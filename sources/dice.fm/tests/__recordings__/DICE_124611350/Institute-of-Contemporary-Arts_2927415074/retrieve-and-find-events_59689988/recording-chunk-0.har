tal_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-04/9815a612-cf6d-4558-b055-a5e4e6e8a0ea.jpg?rect=0%2C329%2C1587%2C1587\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-04/9815a612-cf6d-4558-b055-a5e4e6e8a0ea.jpg?rect=0%2C647%2C1587%2C952\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-04/9815a612-cf6d-4558-b055-a5e4e6e8a0ea.jpg?rect=176%2C0%2C1235%2C2245\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1764925200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"For over 50 years, Rundene Youth Club has stood at the heart of a forgotten estate, a place where young people come to feel seen, heard, and free. It’s more than just a building. It’s football matches that last until sunset, music made in dusty studios, dance battles in the hall, and the comfort of being somewhere you belong.\\n\\nBut now, the one place that never judged them that welcomed anyone who walked through its doors is under threat. As news spreads that Rundene is being shut down, the young people who call it home must decide whether to let it go quietly… or fight for the future they deserve.\\n\\nTold through the voices of the youth who live it, Rundene is a powerful, raw, and moving portrait of community, identity, and resilience in the face of erasure. This isn’t just about saving a club, it's about saving a way of life.\\n\\nThis event is taking place in #The\\\\_BRIT\\\\_Theatre presented by @british\\\\_airways.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled