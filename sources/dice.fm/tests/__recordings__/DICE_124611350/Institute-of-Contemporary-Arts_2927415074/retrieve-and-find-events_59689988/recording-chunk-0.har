\":[{\"name\":\"The Mighty Bosscats\",\"image\":null,\"artist_id\":\"133702\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/8d6c1edf-a3db-4739-8f88-3126233482a7.jpg?rect=0%2C261%2C2792%2C2792\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/8d6c1edf-a3db-4739-8f88-3126233482a7.jpg?rect=0%2C819%2C2792%2C1675\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/8d6c1edf-a3db-4739-8f88-3126233482a7.jpg?rect=485%2C0%2C1822%2C3313\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Richard Townend & The Mighty BossCats - House Of Blues\",\"redirect_url\":\"https://open.spotify.com/track/5dXW5gbuO5snApiXevjA5W\",\"artist\":\"Richard Townend & The Mighty BossCats\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1e801773e517f023b22064473025131d2fccbf37?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"House Of Blues\"},{\"type\":\"apple_music\",\"title\":\"Richard Townend & The Mighty BossCats - House of Blues\",\"redirect_url\":\"https://music.apple.com/us/album/house-of-blues/1589108115?i=1589108290&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Richard Townend & The Mighty BossCats\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/4d/fc/c8/4dfcc851-27ae-2001-07c4-e8936698a694/mzaf_14030747304646520452.plus.aac.p.m4a\",\"track_name\":\"House of Blues\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770336000,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"***The Mighty Bosscats*** are a British roots‑blues and Americana band led by acclaimed singer‑songwriter Richard Townend. Known for their atmospheric grooves, soulful musicianship, and cinematic storytelling, the band has carved out a distinctive place in the UK blues landscape. Their sound blends laid‑back blues, modern Americana, and subtle jazz influences, creating music that feels both timeless and contemporary.\\n\\n​At the heart of the band’s signature feel is the tight, intuitive rhythm section of Matt Gillam on bass and Mark Hall on drums. Gillam’s warm, melodic bass lines and Hall’s tasteful, understated drumming provide the perfect foundation for Townend’s evocative songwriting and smoky baritone vocals. Together, they create a groove that is relaxed yet compelling — a hallmark of The Mighty Bosscats’ sound.\\n\\nThe band’s catalogue — including standout albums such as Photoshoot, The Boiling Pot, and 4000 Weeks — has earned international radio play, award nominations, and praise for its originality and emotional depth. Each release showcases Townend’s cinematic writing style, supported by the band’s cohesive, expressive musicianship.\\n\\nOn stage, The Mighty Bosscats deliver performances that draw audiences into a world of reflective lyrics, atmospheric blues, and finely crafted arrangements. Their chemistry, subtlety, and commitment to storytelling make every show feel intimate, whether in a club, theatre, or festival setting.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Black Frog\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:61\",\"social_links\":{\"event_share\":\"https://link.dice.fm/A945c479a772?dice_id=A945c479a772\",\"post_competition_referral\":\"https://link.dice.fm/y6eef7c93834?dice_id=y6eef7c93834\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O29c480606c3?dice_id=O29c480606c3\",\"post_purchase_referral\":\"https://link.dice.fm/Xb7f0e616bd6?dice_id=Xb7f0e616bd6\",\"post_reminder_referral\":\"https://link.dice.fm/o5b25f00f412?dice_id=o5b25f00f412\",\"post_waitinglist_referral\":\"https://link.dice.fm/w3d0076cab54?dice_id=w3d0076cab54\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T00:00:00+00:00\",\"sale_end_date\":\"2026-09-14T19:30:00+01:00\",\"sale_start_date\":\"2026-02-06T00:00:00+00:00\",\"event_start_date\":\"2026-09-14T19:00:00+01:00\",\"event_end_date\":\"2026-09-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6985391523d3890001b6a112\",\"seats_io_event_id\":null,\"name\":\"The Mighty Bosscats\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"yoa852-the-mighty-bosscats-14th-sep-hot-box-chelmsford-tickets\",\"date_unix\":1789408800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Mon 14 Sep\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-17T19:00:00+01:00\",\"doors_close_date\":\"2026-09-17T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Coprocephalic Mutation\",\"image\":null,\"artist_id\":\"29316\",\"about\":null,\"is_headliner\":false},{\"name\":\"Basement Torture Killings\",\"image\":null,\"artist_id\":\"74890\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gutalax\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf418853eb9edebb34db1d7e4\"},\"artist_id\":\"62637\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"faqs\":[{\"id\":64137,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":64138,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":64139,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/8fac2d11-b0fc-49bd-81e2-3577fd462b8e.jpg?rect=0%2C0%2C2200%2C2200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/8fac2d11-b0fc-49bd-81e2-3577fd462b8e.jpg?rect=0%2C440%2C2200%2C1320\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/8fac2d11-b0fc-49bd-81e2-3577fd462b8e.jpg?rect=495%2C0%2C1210%2C2200\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sex Drugs and Fecal Gore\",\"redirect_url\":\"https://open.spotify.com/track/056AsUgRTvY68ClpinUtzf\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c770827ffce9e3185b2cc51858fa9ce2d4192ab0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sex Drugs and Fecal Gore\"},{\"type\":\"apple_music\",\"title\":\"Gutalax - Diarrhero\",\"redirect_url\":\"https://music.apple.com/us/album/diarrhero/1654887455?i=1654887456&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Gutalax\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/67/8a/79/678a79fc-dbc9-fff3-ee90-663ca745b2bc/mzaf_14953138710766757259.plus.aac.p.m4a\",\"track_name\":\"Diarrhero\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765814400,\"max_tickets\":6,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Beyond the Grave and Rancid Offal Booking are pleased to present Czech gore grind legends Gutalax live at the Underworld on Thursday 17th September.\\n\\nJoining them will be the UK’s very own snuff grind merchants Basement Torture killings as well as Slamchesters Coprocephalic Mutation.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Beyond the Grave and Rancid Offal Booking .\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:62\",\"social_links\":{\"event_share\":\"https://link.dice.fm/za0870cacf4c?dice_id=za0870cacf4c\",\"post_competition_referral\":\"https://link.dice.fm/edc8509b727c?dice_id=edc8509b727c\",\"post_purchase_extra