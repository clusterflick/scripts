le\":\"Charlie Forrest - As The Waves Crash In\",\"redirect_url\":\"https://open.spotify.com/track/2U7OVvfpeWIo4hSHDjwjcD\",\"artist\":\"Charlie Forrest\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4ae89bdd1a2233f3987376a2b4be048b88a96179?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"As The Waves Crash In\"},{\"type\":\"apple_music\",\"title\":\"Charlie Forrest - As The Waves Crash In\",\"redirect_url\":\"https://music.apple.com/us/album/as-the-waves-crash-in/1849983428?i=1849983430&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Charlie Forrest\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/fd/b9/68/fdb96806-9eec-97f9-415c-6e847144aa55/mzaf_10141760774205296583.plus.aac.p.m4a\",\"track_name\":\"As The Waves Crash In\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\" Charlie Forrest\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb84c03641f564d0314602685b\"},\"artist_id\":\"66902\",\"about\":{\"description\":\"Charlie Forrest introduces his forthcoming EP Golden Wisdom, out on the 15th May via Lewis Recordings.\\n\\nBlending traditional folk with early ’90s Americana, Forrest has forged a distinctive sound rooted in the English countryside, which strongly influences his storytelling and artistic sensibility. Drawn to the imaginative nature of folk and country music, his songs are sonically warm and soothing for the listener. His tracks maintain a lo-fi aesthetic, placing an emphasis on atmosphere and texture.\\n\\nHis debut EP Moon Is Bright sold out SJQ last year and received widespread radio support.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enab