tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/aca43f43-23ec-4396-ac56-74b0093a9256.jpg?rect=768%2C0%2C3072%2C3072\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/aca43f43-23ec-4396-ac56-74b0093a9256.jpg?rect=0%2C154%2C4608%2C2765\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/aca43f43-23ec-4396-ac56-74b0093a9256.jpg?rect=1459%2C0%2C1690%2C3072\"},\"properties\":[],\"about\":{\"description\":\"Mansur Brown is an Artist, Producer and Multi-Instrumentalist, from Brixton, London. Mansur released his debut Album 'Shiroi' in 2018, followed by 'Heiwa' in 2021, the first release on Mansur’s own record label, Amai Records. \\\"Hewia\\\" was followed by EP 'NAQI', also released on Amai Records in 2022.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"691f63d44f44a40001966d34\",\"name\":\"Mansur Brown\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Mansur Brown - Heiwa\",\"redirect_url\":\"https://music.apple.com/gb/album/heiwa/1562145323?i=1562145888&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mansur Brown\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/86/81/d3/8681d3ac-e1d3-cb31-4f53-2990dc107408/mzaf_1386972925805596558.plus.aac.p.m4a\",\"track_name\":\"Heiwa\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mansur Brown\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb358a50c74133c05d4dffdfe3\"},\"artist_id\":\"32380\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T15:00:00+00:00\",\"sale_end_date\":\"2026-03-31T19:00:00+01:00\",\"sale_start_date\":\"2026-02-17T15:30:00+00:00\",\"event_start_date\":\"2026-03-31T19:30:00+01:00\",\"event_end_date\":\"2026-03-31T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":76537,\"title\":\"Accessibility\",\"body\":\"The Grace has 12 steps into the venue, with no disabled toilet. There is no accessible area inside the venue. Companion ticket for someone to assist them up the stairs and to the toilet & early access available.\\n\\nDirect contact: accessibility@thegarage.london\",\"order\":0},{\"id\":77060,\"title\":\"Can I come alone?\",\"body\":\"Yes! Discover Live prides itself on a welcoming and wholesome community where we all connect and make friends. You are more than welcome to come alone and make friends or just take yourself on a solo gig date (!)\",\"order\":1}],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Jodie Bryant\",\"seating\":null,\"announcement_date_unix\":1771340400,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-31T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"12764\",\"name\":\"Discover Monthly\",\"image\":{\"url\":null},\"perm_name\":\"discover-monthly-y58x\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:57\",\"date_unix\":1774981800,\"price\":{\"currency\":\"GBP\",\"amount\":1429,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/va98a512d5b1?dice_id=va98a512d5b1\",\"post_competition_referral\":\"https://link.dice.fm/W5397c31a1c7?dice_id=W5397c31a1c7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x873d8ef991c?dice_id=x873d8ef991c\",\"post_purchase_referral\":\"https://link.dice.fm/Zf16fcf3aedb?dice_id=Zf16fcf3aedb\",\"post_reminder_referral\":\"https://link.dice.fm/a321b9189e7a?dice_id=a321b9189e7a\",\"post_waitinglist_referral\":\"https://link.dice.fm/u149c5f85cda?dice_id=u149c5f85cda\"},\"perm_name\":\"7dm22b-jodie-bryants-discover-live-31st-mar-the-grace-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/3b44cea3-260f-41ec-8517-298a99879b86.jpg?rect=0%2C107%2C1080%2C1078\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/3b44cea3-260f-41ec-8517-298a99879b86.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/3b44cea3-260f-41ec-8517-298a99879b86.jpg?rect=169%2C0%2C743%2C1350\"},\"properties\":[],\"about\":{\"description\":\"Jodie Bryant presents Discover Live - the best new music night in London to find your new favourite artist whilst networking with the music industry.\\n\\n\\\\*\\\\*LINEUP: LUCKY IRIS, ASHAINE WHITE, ISLA RICO, GOOSTAVO\\\\*\\n\\nDiscover Live returns to it's fave home - The Grace and we couldn't be more excited to bring you this night of the best new music from some of the most exciting up and coming artists. NME recommended artists included mind you (!) DO NOT MISS!\\n\\nJodie Bryant has established herself as one of the most exciting presenters championing up and coming music and previous lineups have helped fans discover their new favourite artists. She presents on BBC Radio 1, Voices radio as well as on YouTube, Instagram and TikTok.\\n\\nMarch 31st brings a variety of genres with an incredible lineup featuring GOOSTAVO, lucky iris, Ashaine White and Isla Rico - who are all huge names to look out for with a lot of buzz + they put on a SHOW + create absolute bangers you'll be adding straight to your playlist after the gig.\\n\\n\\\\*\\\\*\\\\* NETWORKING OPPORTUNITIES \\\\*\\\\*\\\\*\\\\* Plus - this is a great event to network with like minded creatives and artists. INDUSTRY WILL ATTEND. If you are wanting to make it in the music industry - you could come away with a new manager, team member, writing session, bass player or social media connection - who knows where Discover Live will take you!?\\n\\nGrab a ticket before they're gone & see you on March 31st.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6993505393c72200015cfa14\",\"name\":\"Jodie Bryant's Discover Live \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"RUNAWAY\",\"redirect_url\":\"https://open.spotify.com/track/0LMfP3nRp7TS1T3vKH0h5e\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c9c173f69a289db89a2b9f7e1019357da3d0578a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"RUNAWAY\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"GOOSTAVO\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-07-27/b83c395e-486a-4c10-8f72-71ba1b640db8.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"82077\",\"about\":null,\"is_headliner\":false},{\"name\":\"Isla Rico\",\"i