on_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:21\",\"date_unix\":1777660200,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4950},\"social_links\":{\"event_share\":\"https://link.dice.fm/T51366b44498?dice_id=T51366b44498\",\"post_competition_referral\":\"https://link.dice.fm/v477ccbcddee?dice_id=v477ccbcddee\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e2622f0d06b1?dice_id=e2622f0d06b1\",\"post_purchase_referral\":\"https://link.dice.fm/e4139d8c637e?dice_id=e4139d8c637e\",\"post_reminder_referral\":\"https://link.dice.fm/ebf2620bf126?dice_id=ebf2620bf126\",\"post_waitinglist_referral\":\"https://link.dice.fm/eadff3f3fcb0?dice_id=eadff3f3fcb0\"},\"perm_name\":\"7de5n6-limited-4-day-pass-dig-that-treasure-festival-1st-may-multiple-venues-london-londres-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/6ded9a9e-4bb4-4a49-a1ce-9dfd86805e4a.jpg?rect=0%2C270%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/6ded9a9e-4bb4-4a49-a1ce-9dfd86805e4a.jpg?rect=0%2C702%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/6ded9a9e-4bb4-4a49-a1ce-9dfd86805e4a.jpg?rect=338%2C0%2C1485%2C2700\"},\"properties\":[],\"about\":{\"description\":\"*Dig That Treasure! and Baba Yaga's Hut present*\\n\\nDig That Treasure! Festival returns to venues across London following triumphant editions in 2023 and 2024. Dig That Treasure! is proud to present an international line-up of boundary-pushing artists. The first program announcement includes Kurdish musician Mohammad Syfkhan, Dutch-Greek post-rock duo Able Noise, Canadian experimental jazz legend Eric Chenaux, and the collaboration of two masters of ambient/drone music, Abul Mogard & Rafael Anton Irisarri. The full line-up will be announced shortly.\\n\\nChoose from 3 price bands, Standard, Cheap or Solidarity. This 4-day pass gets you entry to all of the following:\\n\\n**Cafe Oto - 1st May 2026**\\n\\nMohammad Syfkhan\\n\\nCanab Marwo\\n\\n**Cafe Oto - 2nd May 2026**\\n\\nAble Noise\\n\\nDNA? AND?\\n\\nJemima\\n\\n**Cafe Oto - 3rd May 2026**\\n\\nEric Chenaux\\n\\nHarry Gorski-Brown\\n\\nEnsemble Irsahm\\n\\n**Iklectik - 4th May 2026**\\n\\nAbul Mogard & Rafael Anton Irisarri\\n\\nStandard Issue\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"691454f1a9f8c30001e8a53d\",\"name\":\"Limited 4-day pass: Dig That Treasure! Festival\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Able Noise - Ceaseless Sun\",\"redirect_url\":\"https://music.apple.com/us/album/ceaseless-sun/1757668767?i=1757669711&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Able Noise\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/c8/11/c1/c811c1d1-aa5e-a5be-38f9-07c211aeaf33/mzaf_92361904586807880.plus.aac.p.m4a\",\"track_name\":\"Ceaseless Sun\"},{\"type\":\"spotify\",\"title\":\"Able Noise - Ceaseless Sun\",\"redirect_url\":\"https://open.spotify.com/track/2yKolGWAEmarbX4DVxri5e\",\"artist\":\"Able Noise\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2a6d6d15aca17b0f5a99addfba56610d62518dbd?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ceaseless Sun\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Harry Gorski-Brown\",\"image\":null,\"artist_id\":\"119844\",\"about\":null,\"is_headliner\":false},{\"name\":\"Standard Issue\",\"image\":null,\"artist_id\":\"123692\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T10:15:00+00:00\",\"sale_end_date\":\"2026-05-01T18:00:00+01:00\",\"sale_start_date\":\"2026-01-08T10:15:00+00:00\",\"event_start_date\":\"2026-05-01T20:00:00+01:00\",\"event_end_date\":\"2026-05-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Castle Live + Castlefest UK.\",\"seating\":null,\"announcement_date_unix\":1767867300,\"venues\":[{\"id\":\"15346\",\"name\":\"The Castle\",\"address\":\"1 Castle Street, Luton, LU1 3AA, United Kingdom\",\"location\":{\"lat\":51.87773,\"lng\":-0.41441},\"image\":null,\"city\":{\"id\":\"61e9810a0ee924eb5436541c\",\"name\":\"Luton\",\"location\":{\"lat\":51.879768,\"lng\":-0.415161,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-castle-v3vq7\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-01T20:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"128716\",\"name\":\"The Castle\",\"image\":{\"url\":null},\"perm_name\":\"the-castle-yk97v\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:22\",\"date_unix\":1777662000,\"price\":{\"currency\":\"GBP\",\"amount\":1339,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Eca7a9c515d2?dice_id=Eca7a9c515d2\",\"post_competition_referral\":\"https://link.dice.fm/l23ffddeb1a4?dice_id=l23ffddeb1a4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b6115bfb26c0?dice_id=b6115bfb26c0\",\"post_purchase_referral\":\"https://link.dice.fm/D96557852a77?dice_id=D96557852a77\",\"post_reminder_referral\":\"https://link.dice.fm/A403aec2a9f1?dice_id=A403aec2a9f1\",\"post_waitinglist_referral\":\"https://link.dice.fm/k7e3c17fdf4f?dice_id=k7e3c17fdf4f\"},\"perm_name\":\"bb36mo-the-900-1st-may-the-castle-luton-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/f695e4f3-89d2-4494-8bec-c05e26293445.jpg?rect=0%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/f695e4f3-89d2-4494-8bec-c05e26293445.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/f695e4f3-89d2-4494-8bec-c05e26293445.jpg?rect=324%2C0%2C792%2C1440\"},\"properties\":[],\"about\":{\"description\":\"After tearing the roof off last time, The 900 are heading back to The Castle, Luton — and this one’s shaping up to be even bigger.\\n\\nIf you grew up on Tony Hawk’s Pro Skater soundtracks, late-night sessions, and volume turned all the way up, this show is for you. Expect wall-to-wall THPS anthems played loud, fast, and with zero filler. It’s pure nostalgia fuel, delivered with the energy of a packed skate park and the chaos of a proper Castle crowd.\\n\\nFriday 1st May is all about big riffs, big singalongs, and that moment when the intro hits and the whole room loses it. Whether you caught us last time or this will be your first 900 show, trust us - you don’t want to miss this one.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"695f82353dd347000191ea88\",\"name\":\"The 900\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[