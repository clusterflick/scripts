type\":\"apple_music\",\"title\":\"Demae - Deep Dive\",\"redirect_url\":\"https://music.apple.com/us/album/deep-dive/1844328528?i=1844328534&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Demae\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/8f/dd/62/8fdd6295-6ee2-3471-8243-da260cd29c12/mzaf_6372312455714164556.plus.aac.p.m4a\",\"track_name\":\"Deep Dive\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":550},\"seats_io_public_key\":null,\"presented_by\":\"Presented by EGG.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"nvwy35-all-about-house-5-tickets-27th-feb-egg-ldn-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772229600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:62\",\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T22:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"Friday 27th February – All About House\\n\\nAll About House returns in 2026 with a new format and an even sharper focus on pure House energy. We’re opening earlier, with doors at 10:00pm, setting the tone for a full night of grooves and deeper sounds from the moment you walk in.\\n\\nEnjoy £5 entry before 11pm and selected drinks for £5 until 11pm. Egg will be open late as usual, with last entry at 5am.\\n\\nEntry Policy at Egg London\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-07-02T14:00:00+01:00\",\"sale_end_date\":\"2026-02-28T04:00:00+00:00\",\"sale_start_date\":\"2024-07-02T14:00:00+01:00\",\"event_start_date\":\"2026-02-27T22:00:00+00:00\",\"event_end_date\":\"2026-02-28T06:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"691b4e503c2034000179d884\",\"name\":\"All About House / £5 Tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/c770c78d-4dd6-4da9-a68c-d3855c3dc020.jpg?rect=0%2C180%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-0