d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:62\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"12\",\"name\":\"Bad Vibrations\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/dfc81b8e-e212-4b13-a954-3348aa9a856e.jpg\"},\"perm_name\":\"bad-vibrations-jqa4\",\"profile_active\":true},\"id\":\"68c08803e8f37c000103dff0\",\"name\":\"School Disco + Heavenly Bodes + Batmilk\",\"perm_name\":\"dk6bq6-school-disco-heavenly-bodes-batmilk-20th-feb-the-shacklewell-arms-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-09/8c566fc1-971e-4b5f-b2a5-5b0bef9baef3.jpg?rect=1000%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-09/8c566fc1-971e-4b5f-b2a5-5b0bef9baef3.jpg?rect=0%2C200%2C6000%2C3600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-09/8c566fc1-971e-4b5f-b2a5-5b0bef9baef3.jpg?rect=1900%2C0%2C2200%2C4000\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"School Disco\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2f421e127745791444697e61\"},\"artist_id\":\"8458\",\"about\":{\"description\":\"Brighton quartet School Disco return with the striking new single ‘Happen’ (September 10th via Krautpop!). A brooding, hypnotic example of the band’s blend of prog, psychedelic rock and krautrock, the single showcases some of the band's most complete work to date.\\n\\nBuilding their reputation for their live high-octane live shows which have seen the band open for Wolf Alice, Lime Garden and Froth, the band's textural, experimental and musically rich sound shines bright on ‘Happen’. Drawing inspiration from the likes of Black Sabbath, CAN, and sci-fi and horror l the single finds the band in darker, more meditative territory while also drawing from a more tender personal place.\\n\\nLyrically sparse but emotionally weighty, the track moves with a sprawling fluidity - drifting through its floating verse, interwoven with splashes of fuzz heavy guitar and shifting time signatures before eventually reaching a relentless, angular instrumental break. Hypnotic guitar work, a palpable sense of creativity and a driving intensity allow the band’s musicality to shine.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1757494800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"School Disco - Through Dimensions\",\"redirect_url\":\"https://open.spotify.com/track/3cJx9rMh0ImxRTkxo6HoxP\",\"artist\":\"School Disco\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3d433cc5ae5d069fb3b7c1d88c1a2fc42adfe2f6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Through Dimensions\"},{\"type\":\"apple_music\",\"title\":\"School Disco - Through Dimensions\",\"redirect_url\":\"https://music.apple.com/us/album/through-dimensions/1706113905?i=1706114365&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"School Disco\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/78/f5/f3/78f5f34a-a8b9-30c8-f1ae-f2266ea978d3/mzaf_128916059189949853.plus.aac.p.