84e6-f232e0cbacee.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"11447\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Sword\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-06/2373d256-3abe-417f-9a35-eed6920f31b9.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"111499\",\"about\":null,\"is_headliner\":false},{\"name\":\"Earthless\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-17/d934af3a-2608-4f72-9941-65767d980468.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"6451\",\"about\":null,\"is_headliner\":false},{\"name\":\"Truckfighters\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-27/a1a6103a-f423-49dc-b6cf-9a7d6f0e7a9c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"3509\",\"about\":null,\"is_headliner\":false},{\"name\":\"Capricorns\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2737438664271d0e3f7c2eeb4d0\"},\"artist_id\":\"126626\",\"about\":null,\"is_headliner\":false}],\"total_artists\":33,\"total_free_texts\":0},\"new\":false,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"1a6d2e18-bfea-479b-a596-731c30d2c18d\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"disabled\"},\"perm_name\":\"g527lb-desertfest-2026-weekend-tickets-15th-may-roundhouse-london-various-venues-camden-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-01/c9a91925-8844-43a1-97fe-1307a82dfd95.jpg?rect=0%2C0%2C1072%2C1072\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-01/c9a91925-8844-43a1-97fe-1307a82dfd95.jpg?rect=0%2C215%2C1072%2C643\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-01/c9a91925-8844-43a1-97fe-1307a82dfd95.jpg?rect=241%2C0%2C590%2C1072\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"We are extremely proud to announce the first 5 artists for Desertfest London 2026:\\n\\n↠ GREEN LUNG - headlining their biggest show to date at the legendary Roundhouse.  \\n↠ The Sword - a legendary reunion, playing a UK exclusive show - their first in eleven years!  \\n↠ Earthless - bringing their acid-drenched riffs for a special one off appearance.  \\n↠ Truckfighters - a homecoming for our Swedish cousins!  \\n↠ Capricorns (yes, you read that correctly!) - reuniting to play their first show in eighteen years.\\n\\nWe couldn’t be more proud to have Green Lung announced as our first headliner. Having formed amidst the electric atmosphere of Desertfest 2016, their story is almost inseparable from our own. What began as a cult phenomenon has since flourished into one of the UK’s most celebrated heavy bands and now, a decade later, their ascension reaches a fitting peak as Green Lung return to Desertfest London to take their rightful place at the top of the bill.\\n\\nWith so much more still to announce, Desertfest London 2026 is already shaping up to be a historic edition, it’s a pilgrimage no disciple of the riff can afford to miss...\\n\\nGET TICKETS NOW // www.desertfest.co.uk\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event (Photo ID Required).\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Jinx\",\"redirect_url\":\"https://open.spotify.com/track/2WeixBKjRllVnO4xCLd24d\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dc8e88caf3e2b5bafbb5eb4d691a82806e74df29?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Jinx\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778864400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"2427\",\"name\":\"Signature Br