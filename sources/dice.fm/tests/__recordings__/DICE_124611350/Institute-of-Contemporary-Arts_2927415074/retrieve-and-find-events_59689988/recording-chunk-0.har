ours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Global Soul.\",\"seating\":null,\"announcement_date_unix\":1764158400,\"venues\":[{\"id\":\"14889\",\"name\":\"Soul Mama\",\"address\":\"Ground Floor, 40 Celebration Ave, East Village, London E20 1DB\",\"location\":{\"lat\":51.54641,\"lng\":-0.00784},\"image\":null,\"city\":{\"id\":\"68348e77ff502a30257b8e25\",\"name\":\"Stratford\",\"location\":{\"lat\":51.545532,\"lng\":-0.007741,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"soul-mama-xeeyl\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-02T18:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"934\",\"name\":\"Global Soul\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-20/2ae7b816-a68d-419a-94d1-4a861ca1cfdb.jpg\"},\"perm_name\":\"global-soul-8er7\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:82\",\"date_unix\":1775151000,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"social_links\":{\"event_share\":\"https://link.dice.fm/H9b5991829ec?dice_id=H9b5991829ec\",\"post_competition_referral\":\"https://link.dice.fm/pa52b52d6c7d?dice_id=pa52b52d6c7d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q6b530be3170?dice_id=Q6b530be3170\",\"post_purchase_referral\":\"https://link.dice.fm/lb2f5d919301?dice_id=lb2f5d919301\",\"post_reminder_referral\":\"https://link.dice.fm/k4dbb95ce270?dice_id=k4dbb95ce270\",\"post_waitinglist_referral\":\"https://link.dice.fm/E93504e1c014?dice_id=E93504e1c014\"},\"perm_name\":\"2wkkm6-amalia-jaixia-deanna-chase-red-bird-tba-2nd-apr-soul-mama-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/5d20b8d0-ecf1-4cc4-b449-db16c5e02087.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/5d20b8d0-ecf1-4cc4-b449-db16c5e02087.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/5d20b8d0-ecf1-4cc4-b449-db16c5e02087.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"AMALIA\\n\\nWith a timeless soul and jazz flair, Amalia is a rising Neo Soul artist-songwriter from Birmingham, now based in London. Blending soul, jazz, and pop with raw & emotive vocals.\\n\\nAs former member of Flames Collective, she performing at the BRIT Awards, BBC’s Big Weekend, Reading & Leeds Festival, & the MTV EMAs alongside Raye.\\n\\nThis will be her third performance for Global Soul.\\n\\nJaixia\\n\\nA multidisciplinary storyteller across music, poetry & textile art. The songstress' ethereal compositions have been known to pull at the heartstrings; balanced with an unwavering penchant for positive affirmation and healing frequency, which she weaves effortlessly into her storytelling. Since penning her first song 'No Quitter' at age 12, she has continued to take her mother's advice in flipping the narrative, turning negatives into positives. Her mission: to ensure herself and others can feel seen and heard through her art and music.\\n\\nDeanna Chase\\n\\nShe blends her noughties inspired, R&B centred sound with edge, attitude and honesty. Drizzled with dark tones and juxtaposing harmonies, her approach to music is playful, raw, bittersweet and unapologetically provoking.\\n\\nRed Bird\\n\\nLithuanian-born singer, songwriter, producer fusing soul, jazz & disco.\\n\\nAs a rising newcomer, she has performed at London Brick Lane Jazz Festival, Ritzy, Dingwalls, Prince of Peckham, Spit Nights, and one of her recent collaboration songs was played on BBC Introducing.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"696ed5bbc498a00001874641\",\"name\":\"AMALIA, Jaixia, Deanna Chase, Red Bird + TBA\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Amalia - Silhouette\",\"redirect_url\":\"https://open.spotify.com/track/6G9YFcCpAZTDwurPvJdVvk\",\"artist\":\"Amalia\",\"preview_url\":\"https://p.scdn.co/mp3-preview/08c2f76bc11824b00ee43ff1edc2b5135f61fca7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Silhouette\"},{\"type\":\"apple_music\",\"title\":\"Amalia - Silhouette\",\"redirect_url\":\"https://music.apple.com/us/album/silhouette/1840030355?i=1840030362&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Amalia\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/42/79/bc/4279bcef-06ef-74ee-796f-715757607c8d/mzaf_15661983022980210776.plus.aac.p.m4a\",\"track_name\":\"Silhouette\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Red Bird\",\"image\":null,\"artist_id\":\"132599\",\"about\":null,\"is_headliner\":false},{\"name\":\"Jaixia\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc080bcb84e720a9c489177d8\"},\"artist_id\":\"98277\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":2},\"score\":0,\"max_tickets\":2,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T17:00:00+00:00\",\"sale_end_date\":\"2026-04-02T21:00:00+01:00\",\"sale_start_date\":\"2026-01-15T10:00:00+00:00\",\"event_start_date\":\"2026-04-02T19:00:00+01:00\",\"event_end_date\":\"2026-04-02T21:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offe