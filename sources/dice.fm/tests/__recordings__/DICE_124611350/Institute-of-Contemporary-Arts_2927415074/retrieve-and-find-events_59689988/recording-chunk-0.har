[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"14889\",\"name\":\"Soul Mama\",\"address\":\"Ground Floor, 40 Celebration Ave, East Village, London E20 1DB\",\"location\":{\"lat\":51.54641,\"lng\":-0.00784},\"image\":null,\"city\":{\"id\":\"68348e77ff502a30257b8e25\",\"name\":\"Stratford\",\"location\":{\"lat\":51.545532,\"lng\":-0.007741,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"soul-mama-xeeyl\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"BeMyFiasco\",\"image\":null,\"artist_id\":\"119838\",\"about\":null,\"is_headliner\":true},{\"name\":\"Misha\",\"image\":null,\"artist_id\":\"88941\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/a9b75f7a-b9bd-413f-8439-da0f72249900.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/a9b75f7a-b9bd-413f-8439-da0f72249900.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/a9b75f7a-b9bd-413f-8439-da0f72249900.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Evil Needle, Misha & BeMyFiasco - Go\",\"redirect_url\":\"https://music.apple.com/us/album/go/1818415986?i=1818416083&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Evil Needle, Misha & BeMyFiasco\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/6d/0d/e7/6d0de7fb-bf36-0fa3-7402-005f8ba57142/mzaf_942714041337066071.plus.aac.p.m4a\",\"track_name\":\"Go\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1755853200,\"max_tickets\":6,\"marketeers\":[{\"id\":910,\"name\":\"Global Soul\",\"privacy_policy_link\":\"https://globalsoulradio.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Misha:\\n\\nMisha is a Finnish music producer-artist known for his numerous collaborations with GRAMMY-winning artists like Lalah Hathaway, Moonchild’s Amber Navran, and Nate Smith. Misha moves effortlessly between beat music, alternative r&b, hip-hop and nu-funk.\\n\\nAlong with over 100 million streams on Spotify, the prolific artist has received\\n\\nsupport from Okayplayer, Soulection Radio, BBC and CBC. Misha's songs have also appeared on series like HBO Max's South Side. Misha was nominated in two categories at the Finnish Music Awards Emma in 2024. In 2024 he was selected as a new Recording Academy Voting Member.\\n\\nBeMyFiasco:\\n\\nBeMyFiasco is a Grammy-nominated singer, songwriter, and vocal arranger known for her buttery vocals and emotionally rich songwriting that bridges R&B, soul, and hip-hop. With over 10 million global streams, she’s become a rising force in contemporary music, effortlessly blending classic soul influences with a modern edge.\\n\\nHer debut album, Where I Left You, released under Phonte’s +FE Music imprint, garnered critical acclaim and solidified her as an artist to watch. She has collaborated with industry icons and forward-thinking musicians alike, including SZA, Robert Glasper, Lalah Hathaway, The Foreign Exchange, and Little Brother.\\n\\nPraised for her vocal precision, lyrical honesty, and genre-fluid artistry, BeMyFiasco continues to captivate audiences worldwide—crafting music that resonates deeply and stands the test of time.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Global Soul.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:81\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Ycc64f4da9e5?dice_id=Ycc64f4da9e5\",\"post_competition_referral\":\"https://link.dice.fm/C130c9591fc8?dice_id=C130c9591fc8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s195293d6c4a?dice_id=s195293d6c4a\",\"post_purchase_referral\":\"https://link.dice.fm/b616d9ca77c4?dice_id=b616d9ca77c4\",\"post_reminder_referral\":\"https://link.dice.fm/C895a5a61302?dice_id=C895a5a61302\",\"post_waitinglist_referral\":\"https://link.dice.fm/hc1886c125d2?dice_id=hc1886c125d2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-22T10:00:00+01:00\",\"sale_end_date\":\"2026-03-19T18:00:00+00:00\",\"sale_start_date\":\"2025-11-26T10:00:00+00:00\",\"event_start_date\":\"2026-03-19T18:30:00+00:00\",\"event_end_date\":\"2026-03-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1150},\"properties\":[],\"billing_promoter\":{\"id\":\"934\",\"name\":\"Global Soul\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-20/2ae7b816-a68d-419a-94d1-4a861ca1cfdb.jpg\"},\"perm_name\":\"global-soul-8er7\",\"profile_active\":true},\"id\":\"692792a3c327d80001fddd17\",\"seats_io_event_id\":null,\"name\":\"Misha x BeMyFiasco Live