dance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10115\",\"name\":\"Ninety One\",\"image\":{\"url\":null},\"perm_name\":\"ninety-one-m75r\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"yo6n6v-friday-night-jazz-ft-tjoe-man-cheung-friends-27th-feb-ninety-one-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772215200,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:19\",\"venues\":[{\"id\":\"3396\",\"name\":\"Ninety One \",\"address\":\"91 Brick Ln, Spitalfields, London E1 6QL, UK\",\"location\":{\"lat\":51.5214425,\"lng\":-0.07235059999999999},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ninety-one-6pob\",\"accessibility\":{\"url\":\"https://91livingroom.com/access-faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"\\\\*This is an 18+ event, physical & scannable ID required on entry.\\n\\nOn Friday 27th February, Hong Kong-born guitarist, composer, and arranger Tjoe Man Cheung takes over the Ninety One stage for a soulful night of live jazz ft. Isobella Burnham on bass, Jerome Johnson on drums and some very special guests.\\n\\nFREE entry + we'll be pouring £5 pints & £6 Guinness all day & night!\\n\\nABOUT TJOE MAN CHEUNG\\n\\nTjoe Man Cheung (often referred to simply as Tjoe) is known for his work in the jazz and pop scenes in both Hong Kong and the United Kingdom. Also the founder of the jazz collective NTBM (Not-To-Be-Missed).\\n\\nWhile his jazz work is avant-garde, his UK \\\"sideman\\\" career evolved into something far more sophisticated than his pop days in Hong Kong. Joining the band for soul sensation Elmiene, Tjoe became a key architect of a sound that defined a new era of British R&B. This partnership took him from intimate London clubs to a global stage, most notably performing for NPR’s Tiny Desk in late 2024.\\n\\nHe is one of the few artists successfully navigating the London Jazz scene(NTBM, Queenstown collective, PYJAEN, Brown Penny) while simultaneously performing at the highest levels of the international soul circuit.\\n\\nBook your table here: https://www.opentable.co.uk/r/ninety-one-living-room-london\\n\\nDoors 6pm with live music from 7pm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T00:00:00+00:00\",\"sale_end_date\":\"2026-02-27T21:00:00+00:00\",\"sale_start_date\":\"2025-10-27T01:00:00+00:00\",\"event_start_date\":\"2026-02-27T18:00:00+00:00\",\"event_end_date\":\"2026-02-27T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696e41395f4dec0001232cc0\",\"name\":\"Friday Night Jazz ft. Tjoe Man Cheung + Friends\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/131c7083-cbd2-4942-9ea5-cc60edd851e9.jpg?rect=384%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/131c7083-cbd2-4942-9ea5-cc60edd851e9.jpg?rect=0%2C77%2C2304%2C1382\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/131c7083-cbd2-4942-9ea5-cc60edd851e9.jpg?rect=730%2C0%2C845%2C1536\"},\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room