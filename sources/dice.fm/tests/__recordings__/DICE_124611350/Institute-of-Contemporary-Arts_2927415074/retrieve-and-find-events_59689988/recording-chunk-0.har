link.dice.fm/v21b5efb5511?dice_id=v21b5efb5511\",\"post_waitinglist_referral\":\"https://link.dice.fm/P829237c3c6c?dice_id=P829237c3c6c\"},\"perm_name\":\"3ow2op-amplify-her-open-mic-networking-event-31st-mar-the-lower-third-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-08/8d118619-2d44-4cfc-918b-78755f94b3a9.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-08/8d118619-2d44-4cfc-918b-78755f94b3a9.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-08/8d118619-2d44-4cfc-918b-78755f94b3a9.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Welcome to our Amplify Her Open Mic! Get ready for an unforgettable evening brimming with extraordinary female talent and exhilarating performances. This event is open to all\\n\\n*Please note that ticket purchases do not guarantee a performance slot on our stage.*\\n\\nAmplify Her is not just an event; it's a celebration of women in the music industry. Join us for a night of discovery, where new music and emerging artists take center stage. Connect with like-minded individuals, forge new friendships, and contribute to the empowerment of women in music.\\n\\nThis live music and networking experience is open to all. Our mission is to cultivate a community of female industry professionals who uplift each other in advancing their careers and championing gender equality.\\n\\nJoin us for an evening filled with live music, networking opportunities, and pure enjoyment!\\n\\nAmplify Her is more than an event; it's a movement open to everyone who believes in the power of female voices in the music industry.\\n\\nHere is what you should know if you would like to perform:\\n\\n1. Join our membership! Members get priority to perform at our Open Mic visit https://www.amplifyher.co.uk/membership\\n2. Follow our Instagram Page, we will announce how to join our open Mic with a secret word to be emailed.\\n3. Join us on the night! We will pick one artist from our draw.\\n\\nhttps://www.instagram.com/amplify_herLive/\\n\\nPlease note that having a ticket to the open mic doesn't guarantee the opportunity to perform; however, it does give you the chance to enter our draw.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6988e8c292898c00015e41e8\",\"name\":\"Amplify Her Open Mic & Networking Event \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T11:00:00+01:00\",\"sale_end_date\":\"2026-03-31T19:00:00+01:00\",\"sale_start_date\":\"2025-09-30T11:30:00+01:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":99,\"name\":\"Night Tales\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/5e2aabd2b0d5c87010fb3d64/t/5e3f17972c3202581310afa8/1581193111803/BACKGROUND+CLUBS+LIMITED+PRIVACY+AND+COOKIES+STATEMENT.pdf\",\"fb_pixel_id\":\"219310887034475\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BC