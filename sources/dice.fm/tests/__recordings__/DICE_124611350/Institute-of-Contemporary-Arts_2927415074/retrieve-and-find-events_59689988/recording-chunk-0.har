s\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770890400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T00:00:00+00:00\",\"sale_end_date\":\"2027-01-16T17:00:00+00:00\",\"sale_start_date\":\"2026-01-29T00:00:00+00:00\",\"event_start_date\":\"2027-01-16T19:00:00+00:00\",\"event_end_date\":\"2027-01-16T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by 229.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Sbcf32425a9c?dice_id=Sbcf32425a9c\",\"post_competition_referral\":\"https://link.dice.fm/jb7e9522498d?dice_id=jb7e9522498d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F27d6e7d9801?dice_id=F27d6e7d9801\",\"post_purchase_referral\":\"https://link.dice.fm/E814a16ddafd?dice_id=E814a16ddafd\",\"post_reminder_referral\":\"https://link.dice.fm/s49fc052c41c?dice_id=s49fc052c41c\",\"post_waitinglist_referral\":\"https://link.dice.fm/h0b0c40a884e?dice_id=h0b0c40a884e\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**JANUARY BLUES FESTIVAL 2027 presents**\\n\\n**KING KING + SPECIAL GUESTS: TBC**\\n\\n**DJ: SNOWBOY**\\n\\nThe January Blues Festival celebrates it's 10th anniversary year with the welcome return of Scottish Blues-Rock group King King.Scottish Blues-Rock group King King formed in 2008. It may well have been high profile support slots with the likes of John Mayall's Bluesbreakers, Thunder and Europe which opened King King's music up to a much wider audience. But it was pure talent and hard work which got them there in the first place.\\n\\nKing King have released five studio and two live albums since 2011. At the 2014 British Blues Awards, King King won five awards including the 'Best Band' and 'Best Album' Awards. They swiftly followed this up by winning several awards at the British Blues Awards in 2016 including 'Best Album' for their studio LP Reaching For The Light.\\n\\nHost and DJ for the January Blues Festival is Snowboy playing Chicago Blues, Rhythm & Blues, Blues Rock and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1800126000,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-01-16T19:00:00+00:00\",\"doors_close_date\":n