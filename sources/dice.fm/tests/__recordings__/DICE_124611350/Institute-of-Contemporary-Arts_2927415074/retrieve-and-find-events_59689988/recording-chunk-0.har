\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"2wpdko-blackbeards-tea-party-27th-mar-the-grace-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774638000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-06-24/cd3763ac-1ea8-46e7-9f79-33007e6fd604.jpg?rect=710%2C0%2C3701%2C3701\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-06-24/cd3763ac-1ea8-46e7-9f79-33007e6fd604.jpg?rect=0%2C315%2C5120%2C3072\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-06-24/cd3763ac-1ea8-46e7-9f79-33007e6fd604.jpg?rect=1542%2C0%2C2036%2C3701\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q256904d8d2c?dice_id=Q256904d8d2c\",\"post_competition_referral\":\"https://link.dice.fm/s08c2eac7713?dice_id=s08c2eac7713\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J5d29e45f206?dice_id=J5d29e45f206\",\"post_purchase_referral\":\"https://link.dice.fm/c9508d106e35?dice_id=c9508d106e35\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jdf27823bb4c?dice_id=Jdf27823bb4c\",\"post_reminder_referral\":\"https://link.dice.fm/z44df08c4eeb?dice_id=z44df08c4eeb\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Folk-rock rebels Blackbeard’s Tea Party celebrate 10 years of their seminal album ‘Reprobates’, a collection of stories about wrong’uns from history. They debuted material from the album during their now legendary appearance at Fairport’s Cropredy Convention, and it was the album that earned them thousands of new fans.\\n\\nMixing sounds of traditional folk and classic rock, Blackbeard’s Tea Party look back to the album that reviewers called “a hell of a lot of fun” (R2 Magazine), “convincing and essential” (fRoots) and “unforgettable and exceedingly invigorating” (Living Tradition).\\n\\nIn this exhilarating live show, the band revisit tracks from ‘Reprobates’, along with other songs of nefarious individuals – past and present - that pack their back catalogue. You’re guaranteed a loud and energetic performance that will bring out the devil inside you.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:49\",\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"presented_by\":\"Presented by DHP FAMILY.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Blackbeard's Tea Party\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-25/4182c692-d238-4dc3-ae36-