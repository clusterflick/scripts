ose_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/063f2fd4-e13b-48fb-ae6d-f332eecbf031.jpg?rect=928%2C0%2C3712%2C3712\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/063f2fd4-e13b-48fb-ae6d-f332eecbf031.jpg?rect=0%2C186%2C5568%2C3341\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/063f2fd4-e13b-48fb-ae6d-f332eecbf031.jpg?rect=1763%2C0%2C2042%2C3712\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/r72f2dcbb263?dice_id=r72f2dcbb263\",\"post_competition_referral\":\"https://link.dice.fm/C7530c67980f?dice_id=C7530c67980f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K54dab352c8a?dice_id=K54dab352c8a\",\"post_purchase_referral\":\"https://link.dice.fm/u27a68ba4a01?dice_id=u27a68ba4a01\",\"post_reminder_referral\":\"https://link.dice.fm/O7ccf77b4b44?dice_id=O7ccf77b4b44\",\"post_waitinglist_referral\":\"https://link.dice.fm/X2b6b5330266?dice_id=X2b6b5330266\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:30\",\"properties\":[],\"presented_by\":\"Presented by Morocco Bound.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768996800,\"id\":\"6970cc399edb95000163474d\",\"name\":\"Heidi Vogel & Abigail Millar Todd\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Heidi Vogel**\\n\\nVocalist with The Cinematic Orchestra since 2006, Heidi appears on their albums ” To Believe “ , “Live at the Royal Albert Hall “, “ Late Night Tales “ and has opened for Erykah Badu in Dubai, performed at Montreux Jazz festival for Quincy Jones and appeared live on The Jimmy Kimmel Show on ABC , as well as performing at The Sydney Opera House and with The Krakow Symphony Orchestra , The Heritage Orchestra, The London Metropolitan Orchestra .\\n\\nHeidi performed with The Cinematic Orchestra concluding a 2019 USA tour at the prestigous Los Angeles Walt Disney Hall where she performed with Patrick Watson, Moses Sumney, and Miguel Atwood Ferguson.\\n\\nHeidi was invited to perform material from this album as Thundercat’s guest for his 2024 London shows - four nights live at Koko.\\n\\n**Abigail Millar Todd**  \\n  \\nAbigail Millar Todd is a harpist from the north of Scotland. Abigail studied under Gabriella Dall’Olio at Trinity Laban. She and Zoë Rasmussen have a flute and harp duo, playing not just classical music but exploring contemporary improvisation and meditation.\\n\\nShe has gained a reputation as an engaging soloist, transcribing core piano repertoire for the harp, recently having given recitals at the Reform Club, St Mary-le-Strand and Gallery Marquess Mayfair, and performing the Glière Harp Concerto later this season with the Highland Chamber Orchestra.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14196\",\"name\":\"Morocco Bound\",\"image\":{\"url\":null},\"perm_name\":\"morocco-bound-6d3nb\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T19:00:00+00:00\",\"sale_start_date\":\"2026-01-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-08T01:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"k6avyp-sundown-artist-showcase-2026-7th-mar-notting-hill-arts-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"80\",\"name\":\"Notting Hill Arts Club\",\"address\":\"21 Notting Hill Gate, London W11 3JQ\",\"location\":{\"lat\":51.509239,\"lng\":-0.194435099999964},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"notting-hill-arts-club-4n2q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/7277806a-8a17-4d49-a7ed-46edbbe12364.jpg?rect=21%2C0%2C990%2C990\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/7277806a-8a17-4d49-a7ed-46edbbe12364.jpg?rect=0%2C186%2C1032%2C619\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/7277806a-8a17-4d49-a7ed-46edbbe12364.jpg?rect=244%2C0%2C545%2C990\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/P065f9392a31?dice_id=P065f9392a31\",\"post_competition_referral\":\"https://link.dice.fm/i32aa03c08a4?dice_id=i32aa03c08a4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ca6a7a28536a?dice_id=Ca6a7a28536a\",\"post_purchase_referral\":\"https://link.dice.fm/Mc3cdf94672f?dice_id=Mc3cdf94672f\",\"post_reminder_referral\":\"https://link.dice.fm/m79864a3ca46?dice_id=m79864a3ca46\",\"post_waitinglist_referral\":\"https://link.dice.fm/R1206d3c4a5f?dice_id=R1206d3c4a5f\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:31\",\"properties\":[],\"presented_by\":\"Presented by Notting Hill Arts Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768176000,\"id\":\"69652e8c097f7e000136facc\",\"name\":\"Sundown Artist Showcase 2026\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Following the success of last year's sold out event, Sundown Studios proudly presents...\\n\\nOur 2nd Annual Artist Showcase. An exclusive evening of live performances celebrating the exceptional artists who have brought our studio to life.\\n\\nThis year, four hand-picked artists, each on the cusp of something truly special will take the stage.\\n\\nIt also marks our second lap around the sun as a studio, and we want you there to celebrate with us.\\n\\nExpect only the best upcoming musical talent, the most supportive community, and a proper knees up.\\n\\nPlus a few surprises 👀\\n\\nLineup:\\n\\nFLO WILKES\\n\\nJADE MORGAN KELLY\\n\\nJIDÉ KUTI\\n\\nRAFA & MEELO\\n\\nLocation: Notting Hill Arts Club\\n\\nDate: Saturday 7th March\\n\\nTickets: £10 on Dice\\n\\nDoors: 7pm - 1am\\n\\nBe there. Or wish you had been.\\n\\n——————————————\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1523\",\"name\":\"Notting Hill Arts Club\",\"image\":{\"url\":null},\"perm_name\":\"notting-hill-arts-club-okgr\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1780,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-01T00:30:00+00:00\",\"sale_end_date\":\"2026-03-07T17:00:00+00:00\",\"sale_star