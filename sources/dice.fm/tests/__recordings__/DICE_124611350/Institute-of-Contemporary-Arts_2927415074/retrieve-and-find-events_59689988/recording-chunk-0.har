3cbd7bff\",\"post_waitinglist_referral\":\"https://link.dice.fm/U362eafa352f?dice_id=U362eafa352f\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by The Bear Club.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:60\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-01T17:30:00+00:00\",\"sale_end_date\":\"2026-04-16T17:00:00+01:00\",\"sale_start_date\":\"2026-01-01T17:30:00+00:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1767288600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1558,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6957beae673c060001fc9b3e\",\"name\":\"Brown Horse\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Brown Horse\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-06/91e58937-538c-43ba-b7f9-123671bc6cf7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"69080\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"2wkrmm-brown-horse-16th-apr-the-bear-club-luton-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/a26efb49-d1b0-4c42-9f5e-96896b5f2cf4.jpg?rect=0%2C295%2C1228%2C1228\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/a26efb49-d1b0-4c42-9f5e-96896b5f2cf4.jpg?rect=0%2C541%2C1228%2C737\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/a26efb49-d1b0-4c42-9f5e-96896b5f2cf4.jpg?rect=114%2C0%2C1000%2C1818\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Brown Horse return to The Bear Club to celebrate the release of their third album, Total Dive. Their strongest and most grounded work to date, the record showcases a new level of skill and assurance in the Norwich-based band’s thoughtful lyricism and musicality.\\n\\nLeaning away from the playfulness and eclecticism of their previous works, Total Dive sees Brown Horse step forward into the darkness with a cautious optimism. With songs from each of the four members, the writing charts a world of small revelations and painful changes.\\n\\nAs they move confidently between searing noise and delicate reflection, they take time to note the beauty and agony of the mundane - the death rattle of a vending machine, headlights flashing in the eyes of a road-killed fox, the heather-pink of a winter sky.\\n\\nThe new album is the clearest expression yet of Brown Horse’s unique sound - somewhere between the stark country rock of Uncle Tupelo, the raw intimacy of early Cat Power, and the haunted landscapes of Magnolia Electric Co., while embracing the self-possessed noisiness of alt-rock trailblazers like Built to Spill and The Breeders.\\n\\nThese are songs inhabited by wide Norfolk skies, thousands of shared miles on the road, the noise of heartbreak and humour, and the echoing silence of long hours spent in strange in-between places.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Static King\",\"redirect_url\":\"https://open.spotify.com/track/30c7yitaxCPDer72DuJMpw\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/94e4ace3c864ddcec0c5f5dae54337df3b923190?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Static King\"},{\"type\":\"apple_music\",\"title\":\"Dead Horse One - Static King\",\"redirect_url\":\"https://music.apple.com/us/album/static-king/1566008036?i=1566008039&uo=4&at=1