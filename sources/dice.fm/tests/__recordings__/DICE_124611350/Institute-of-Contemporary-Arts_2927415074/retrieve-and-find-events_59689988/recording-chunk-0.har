d=d1870c65251c\",\"post_reminder_referral\":\"https://link.dice.fm/Q23dc4cdec0f?dice_id=Q23dc4cdec0f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"982\",\"name\":\"Dream Bags Jaguar Shoes\",\"address\":\"32-34 Kingsland Rd, London E2 8DA\",\"location\":{\"lat\":51.5280931,\"lng\":-0.0778017000000091},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dream-bags-jaguar-shoes-8e67\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**KICKBOY AND ALL THEIR FRIENDS TAKEOVER JAGUAR SHOES**\\n\\nJoin us in the basement for a night of indie, punk, rave-core, emo and noise rock.\\n\\n**KickBoy**\\n\\n*An unhinged blend of punk, electohardcore, party rock, funk and whatever 'milk-punk\\\" is, KickBoy in their own words play \\\"music that goes beep-boop skrrt doof doof doof\\\".*\\n\\n**Homebread**\\n\\n*Angsty, pathetic, and swollen, Homebread throws out conventionality with a sound that sits uncomfortably on both sides of the Atlantic. It's drenched in references to Midwest Emo, Windmill-era Post Punk, and 90s grit, but refuses to be defined by the trappings of any one genre, period, or place.*\\n\\n**Man Removal**\\n\\n*Man Removal play tinfoil teeth music in all corners of London. Residing somewhere between McLusky, Jesus Lizard, and Tropical Fuck Storm, it's No-wave Funk straight to your ear-poles.*\\n\\n**Peach Free**\\n\\n*Oxford-based indie rock with charged grooves and a resolute, if somewhat vigilant, respect for each other. These stoned fruits were grown from post-punk and dream pop.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:23\",\"billing_promoter\":{\"id\":\"13200\",\"name\":\"KickBoy\",\"image\":{\"url\":null},\"perm_name\":\"kickboy-6gg3\",\"profile_active\":false},\"presented_by\":\"Presented by KickBoy.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kickboy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc86b9019996d4c783bb165a9\"},\"artist_id\":\"57732\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1769169600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T12:00:00+00:00\",\"sale_end_date\":\"2026-03-27T23:00:00+00:00\",\"sale_start_date\":\"2026-01-23T12:00:00+00:00\",\"event_start_date\":\"2026-03-27T18:30:00+00:00\",\"event_end_date\":\"2026-03-27T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69726c175fc51b00019ceb15\",\"name\":\"KickBoy, Homebread, Man Removal and Peach Free\",\"price\":{\"currency\":\"GBP\",\"amount\":714,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Portland from Streetview\",\"redirect_url\":\"https://open.spotify.com/track/48ul666UIQoupVv6Gg0WLo\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6ce52f4424df12eb680f02808bab8df7c67f81a4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Portland from Streetview\"},{\"type\":\"apple_music\",\"title\":\"KickBoy - Vision Shakes\",\"redirect_url\":\"https://music.apple.com/us/album/vision-shakes/1711337690?i=1711337694&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"KickBoy\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/8b/b5/93/8bb5936b-0b0b-7991-534e-065556f408af/mzaf_10330330317178337600.plus.aac.p.m4a\",\"track_name\":\"Vision Shakes\"}],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"eo33ad-real-voices-march-27th-27th-mar-the-clapham-grand-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774636200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/2e99e8e9-b017-44d2-9587-06121d7ace34.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/2e99e8e9-b017-44d2-9587-06121d7ace34.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/2e99e8e9-b017-44d2-9587-06121d7ace34.jpg?rect=243%2C0%2C594%2C1080\"},\"max_tickets\":8,\"social_links\":{\"event_share\":\"https://link.dice.fm/f05e14944ec6?dice_id=f05e14944ec6\",\"post_competition_referral\":\"https://link.dice.fm/n14226d84cba?dice_id=n14226d84cba\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W4c3b2ad194d?dice_id=W4c3b2ad194d\",\"post_purchase_referral\":\"https://link.dice.fm/A895be4ae7b1?dice_id=A895be4ae7b1\",\"post_waitinglist_referral\":\"https://link.dice.fm/P6c25c9ad8f0?dice_id=P6c25c9ad8f0\",\"post_reminder_referral\":\"https://link.dice.fm/F13641610c2b?dice_id=F13641610c2b\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**FRIDAY 27TH MARCH / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. ONE HOUR AFTER DOORS / SHOW ENDS APPROX. 10PM**\\n\\n**This is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)**\\n\\n27th March: Brixton & Vauxhall choirs\\n\\nJoin us as we celebrate a decade of Real Voices over three nights at the much-loved Clapham Grand!\\n\\nReal Voices is a community of non-auditioned contemporary choirs across South London. Over 400 singers will grace the stage across the three nights, backed by our brilliant house band. Expect unique choral reimaginings of decade-spanning pop/rock favourites, indie gems and recent chart hits: songs by the likes of Prince, Olivia Dean, The Cranberries, Foo Fighters and Sophie Ellis-Bextor.\\n\\nWe’re thrilled to be back at the Clapham Grand to mark this special milestone: 10 years of music, community and joy. We hope you’ll join us for a feel-good night of great music!\\n\\nThese performances are taking place in a gorgeous listed Victorian theatre. Your ticket includes a £1 restoration levy which will go towards the invaluable upkeep of this iconic London landmark.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:24\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"presented_by\":\"Presented by The Clapham Grand.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1768996800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:00:00+00:00\",\"sale_end_date\":\"2026-03-27T18:30:00+00:00\",\"sale_start_date\":\"2026-01-21T12:00:00+00:00\",\"event_start_date\":\"2026-03-27T18:30:00+00:00\",\"event_end_date\":\"2026-03-27T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"696f67806e546f0001ed2b22\",\"name\":\"Real Voices - March 27th\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2150},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":true,\"is_hidden_event\":false,\"perm_name\":\"v3qwgd-the-twilight-sad-live-signing-27th-mar-rough-trade-east-london-london-tickets\",\"seating\":null,\"tty_to_extras\":[{\"ticket_type_id\":1159986,\"extra_ids\":[\"1166125\"]},{\"ticket_type_id\":1159987,\"extra_ids\":[\"1166125\"]},{\"ticket_type_id\":1160032,\"extra_ids\":[\"1166125\"]},{\"ticket_type_id\":1160033,\"extra_ids\":[\"1166125\"]}],\"streaming_options\":null,\"date_unix\":1774638000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-06/12f76d80-3b32-4488-87f2-8189ee0648a2.jpg?rect=1277%2C0%2C5098%2C5098\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-06/12f76d80-3b32-4488-87f2-8189ee0648a2.jpg?rect=0%2C254%2C7652%2C4591\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-06/12f76d80-3b32-4488-87f2-8189ee0648a2.jpg?rect=2424%2C0%2C2804%2C5098\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/lbccdff974b3?dice_id=lbccdff974b3\",\"post_competition_referral\":\"https://link.dice.fm/rc0038ec210e?dice_id=rc0038ec210e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O6596dd8ffd7?dice_id=O6596dd8ffd7\",\"post_purchase_referral\":\"https://link.dice.fm/k8ba1878ca62?dice_id=k8ba1878ca62\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y830ba1d7f1f?dice_id=Y830ba1d7f1f\",\"post_reminder_referral\":\"https://link.dice.fm/b2d07b1cc0f5?dice_id=b2d07b1cc0f5\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Rough Trade East is very excited to present a live performance and signing from The Twilight Sad. This unique event celebrates the release of their new album 'It's The Long Goodbye' released via Rock Action.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com/products/its-the-long-goodbye\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type