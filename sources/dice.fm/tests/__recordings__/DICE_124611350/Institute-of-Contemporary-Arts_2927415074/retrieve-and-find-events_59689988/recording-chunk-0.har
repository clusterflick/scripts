p3-preview/47294f8ce04b164403bebea0ef7e28c189d3b28f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Pressure Drop\"}],\"faqs\":[{\"id\":43089,\"title\":\"Venue Accessibility Information\",\"body\":\"https://electricballroom.co.uk/disabled-access/\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1778695200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"55\",\"name\":\"Electric Ballroom\",\"address\":\"184 Camden High St, London NW1 8QP\",\"location\":{\"lat\":51.5396558,\"lng\":-0.143191399999978},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/fab0b36d-a5a4-4e37-a541-2c5af15a3bc1.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"electric-ballroom-j78v\",\"accessibility\":{\"url\":\"http://electricballroom.co.uk/disabled-access/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-13T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:83\",\"about\":{\"description\":\"AGMP Concerts presents\\n\\nDirect from Jamaica\\n\\nTOOTS AND THE MAYTALS\\n\\nfeaturing Leba Hibbert\\n\\n'Reggae Got Soul' 50th Anniversary Tour 1976-2026\\n\\n\\\\+ special guests\\n\\nThe Maytals formed in the 1960’s and updated their name to Toots and the Maytals for their debut album ’Sweet And Dandy’ in 1969.\\n\\nOne of the best known ska and rocksteady groups, they also are known for the first use of the word ‘reggae’ in a song on their 1968 single ‘Do The Reggay’.\\n\\nFrederick ‘Toots' Hibbert was considered a reggae pioneer who was named by Rolling Stone magazine as one of the 100 greatest singers of all time.\\n\\nKnown for classic reggae songs such as ’54-46 Was My Number’, ‘Monkey Man’, ‘Pressure Drop’, ‘Funky Kingston’, ‘Broadway Jungle’, ‘Bam Bam’, ’Time Tough’ and 'Reggae Got Soul’, Toots and the Maytals are now fronted by Toots’ daughter Leba Hibbert, who has released her own recordings and worked with Sly & Robbie, Jimmy Cliff and more.\\n\\nThis event is 14 and over. 14s to 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"seating\":null,\"announcement_date_unix\":1756940400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Toots & The Maytals\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb346451ca43eb84f810f13b96\"},\"artist_id\":\"7075\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-05/f092c84a-1819-40db-829f-6b3589993307.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-05/f092c84a-1819-40db-829f-6b3589993307.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-05/f092c84a-1819-40db-829f-6b3589993307.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"68bac08640a1eb0001779491\",\"name\":\"Toots And The Maytals Feat. Leba Hibbert\",\"new\":false,\"d