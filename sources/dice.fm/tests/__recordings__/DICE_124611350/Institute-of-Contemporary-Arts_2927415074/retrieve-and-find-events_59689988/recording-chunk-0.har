ue,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"b53079f2-457e-425f-b969-f44d99a04199\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-18T18:00:00+00:00\",\"sale_end_date\":\"2026-03-01T18:00:00+00:00\",\"sale_start_date\":\"2025-12-18T18:00:00+00:00\",\"event_start_date\":\"2026-03-01T15:00:00+00:00\",\"event_end_date\":\"2026-03-01T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ryaov5-bruno-e-marrone-1st-mar-troxy-london-tickets\",\"seats_io_event_id\":\"b53079f2-457e-425f-b969-f44d99a04199\",\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":65401,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":65402,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bruno & Marrone\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebafae170b6ddc09d155ace3af\"},\"artist_id\":\"131626\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T15:00:00+00:00\",\"doors_close_date\":\"2026-03-01T19:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/c0dfb7df-6718-4a7d-a0a6-41e41a8a13ec.jpg?rect=0%2C352%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/c0dfb7df-6718-4a7d-a0a6-41e41a8a13ec.jpg?rect=0%2C636%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/c0dfb7df-6718-4a7d-a0a6-41e41a8a13ec.jpg?rect=12%2C0%2C1056%2C1920\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/t2992a76f62c?dice_id=t2992a76f62c\",\"post_competition_referral\":\"https://link.dice.fm/wc95c47a2f99?dice_id=wc95c47a2f99\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zba9eb84d90a?dice_id=Zba9eb84d90a\",\"post_purchase_referral\":\"https://link.dice.fm/Y4049e065f15?dice_id=Y4049e065f15\",\"post_reminder_referral\":\"https://link.dice.fm/ke5a62a5bb09?dice_id=ke5a62a5bb09\",\"post_waitinglist_referral\":\"https://link.dice.fm/O3ccb73fe7bd?dice_id=O3ccb73fe7bd\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:26\",\"properties\":[],\"presented_by\":\"Presented by Bibs Pizzas and Esfihas.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766080800,\"id\":\"694429080ad6bd00015c605b\",\"name\":\"Bruno e Marrone\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Bruno and Marrone, one of Brazil's most iconic sertanejo duos, have a career marked by success and a strong connection with their audience. The duo formed in the early 1990s when Bruno, born in 1985, and Marrone, born in 1984, met in Goiás. Since then, they have won over fans with their romantic and upbeat songs, which reflect everyday experiences and emotions.\\n\\nOver the years, Bruno and Marrone have released several albums, many of which have become true classics of sertanejo music. With hits like \\\"Dormi na Praça,\\\" \\\"Por Um Minuto,\\\" and \\\"Chorando se Foi,\\\" they have consolidated their presence on the charts and in the hearts of millions of admirers.\\n\\nNow, the duo is preparing for their fourth performance in London, a milestone that demonstrates their international growth and the popularity they have gained outside of Brazil. Each show is an opportunity to share their music and their story with a new audience, showing that sertanejo music has an appeal that transcends borders. Bruno and Marrone's career is an example of dedication and passion for music, and their performances in London are a celebration of that journey.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"date_unix\":1772377200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-10-22T00:00:00+01:00\",\"sale_end_date\":\"2026-03-01T15:00:00+00:00\",\"sale_start_date\":\"2024-10-22T01:15:00+01:00\",\"event_start_date\":\"2026-03-01T15:00:00+00:00\",\"event_end_date\":\"2026-03-01T20:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"v373nl-iago-banet-1st-mar-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Iago Banet - Iago Banet\",\"redirect_url\":\"https://open.spotify.com/track/58mrV2xhdJ2ju71TguWvv1\",\"artist\":\"Iago Banet\",\"preview_url\":\"https://p.scdn.co/mp3-preview/10d307e71ba9