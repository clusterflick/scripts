,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Garageland Promotions.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"q27k7y-garageland-london-snatch-quick-romance-skl-59-28th-feb-the-shacklewell-arms-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772305200,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:84\",\"venues\":[{\"id\":\"10\",\"name\":\"The Shacklewell Arms\",\"address\":\"71 Shacklewell Lane, London E8 2EB\",\"location\":{\"lat\":51.5531551,\"lng\":-0.0699228999999377},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Snatch\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-14/e1a52e03-de43-47fd-a2a3-4cfebb28a60b.jpg?rect=0%2C43%2C554%2C554\"},\"artist_id\":\"124230\",\"about\":null,\"is_headliner\":false},{\"name\":\"Quick Romance\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-09/5c665c8c-ac10-4279-bf09-c4873006f1d2.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"126991\",\"about\":null,\"is_headliner\":false},{\"name\":\"Skäl 59\",\"image\":null,\"artist_id\":\"132020\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"about\":{\"description\":\"GARAGELAND ~ 70's PUNK ROCK + GARAGEPUNK + ROCK'N'ROLL CLUB ~ FREE ENTRY !!\\n\\nSaturday 28 February 2026\\n\\nThe Shacklewell Arms\\n\\n71 Shacklewell Ln, Hackney Downs, London E8 2EB\\n\\nPlease come early. Bands from 7:30-10:30pm\\n\\nFREE ENTRY but please reserve via DICE\\n\\nSnatch\\n\\nhttps://www.instagram.com/snatchsnatchsnatchsnatch\\n\\nrising from the remnants of the legendary Slobheads…\\n\\nthe filthy threesome. SNATCH\\n\\nQuick Romance\\n\\nhttps://www.instagram.com/quickromanceband/\\n\\nKnee knocking cheap thrills, quick and giggly kisses behind the glitter bins, with nothing but love bites the next morning.\\n\\nSkäl 59\\n\\nhttps://www.instagram.com/skaal_59/\\n\\nSkål 59 are four musicians inspired by DIY ethics and love of live music. They got together recently to form their first band and write original compositions. Influences range from black metal to ‘79 punk to 60’s garage. IG @skaal\\\\_59 (no å's on insta).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-06T10:45:00+00:00\",\"sale_end_date\":\"2026-02-28T20:00:00+00:00\",\"sale_start_date\":\"2026-01-06T10:45:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"695ce8a87a32600001b7d0ff\",\"name\":\"Garageland London - Snatch, Quick Romance, Skäl 59\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-08/8fa587c8-65d4-40fe-bf07-595daacb9520.jpg?rect=0%2C3%2C2480%2C24