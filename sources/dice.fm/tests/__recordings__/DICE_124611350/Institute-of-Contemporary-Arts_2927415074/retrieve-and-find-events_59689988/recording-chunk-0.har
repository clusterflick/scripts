ncert je dlhý približne 2 hodiny bez prestávky.\\n\\nPo koncerte CS PARTY\\n\\nZákaz vstupu deťom do 18 rokov !!!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Pishter.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:7\",\"social_links\":{\"event_share\":\"https://link.dice.fm/E40c24b72a7c?dice_id=E40c24b72a7c\",\"post_competition_referral\":\"https://link.dice.fm/Eb52d81cc02a?dice_id=Eb52d81cc02a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ybb21a520811?dice_id=ybb21a520811\",\"post_purchase_referral\":\"https://link.dice.fm/Bfe88559c9da?dice_id=Bfe88559c9da\",\"post_reminder_referral\":\"https://link.dice.fm/zc1963ea1614?dice_id=zc1963ea1614\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ld2c148906d1?dice_id=Ld2c148906d1\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-29T00:00:00+00:00\",\"sale_end_date\":\"2026-04-25T17:00:00+01:00\",\"sale_start_date\":\"2025-10-29T00:00:00+00:00\",\"event_start_date\":\"2026-04-25T19:30:00+01:00\",\"event_end_date\":\"2026-04-26T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":4862,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"id\":\"6901e0332cddca000151c30e\",\"seats_io_event_id\":null,\"name\":\"Jarek Nohavica\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"av7ep7-jarek-nohavica-25th-apr-229-london-tickets\",\"date_unix\":1777141800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_o