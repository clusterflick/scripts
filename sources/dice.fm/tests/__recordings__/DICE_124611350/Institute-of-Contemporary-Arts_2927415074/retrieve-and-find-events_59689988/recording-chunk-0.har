,\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:46\",\"about\":{\"description\":\"The Captain's Beard\\n\\nThe Captain’s Beard are one of the most seasoned Folk Rock and Sea Shanty groups in the U.K.\\n\\nPlaying over a hundred gigs a year. Whether they're playing festivals like Tartan Heart in Scotland, Zomerfolk in The Netherlands or venues as grand as Alexandra Palace in London they captivate their audiences with tales of the sea.\\n\\nThey see every performance as an honest opportunity to create a unique experience for their audience that they will never forget ... and they'll probably teach you about inappropriate mermaids too. Their version of \\\"John Kanakanaka\\\" has over three million streams on Spotify and is on the soundtrack of the American feature movie \\\"Operation Taco Garys.\\\"\\n\\nTheir last two albums \\\"Same Ship Different Day\\\" and \\\"Completely Tankard\\\" garner tens of thousands of listens every month on streaming platforms. They have also won the \\\"Best Album of 2024\\\" award at the Celtcast awards in the Netherlands for their third album \\\"Cannonballs Deep.\\\"\\n\\nBEARD!\\n\\nhttps://www.thecaptainsbeard.co.uk/\\n\\n+ \\n\\nTowRag\\n\\nPlunderin yer Earholes with Grog-fuelled Shanty-punk.\\n\\nhttps://linktr.ee/towrag\\n\\nCaptain Daisy Pegbeard\\n\\nDebut solo outing from the most notorious landlubber in all of Camberwell. Expect shanties, smiles and silliness.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769731200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Captain’s Beard\",\"image\":null,\"artist_id\":\"100514\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/757c0b0a-9fca-4850-bcc7-4d8953eb95e8.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/757c0b0a-9fca-4850-bcc7-4d8953eb95e8.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/757c0b0a-9fca-4850-bcc7-4d8953eb95e8.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"697ca17b1951b80001561c30\",\"name\":\"The Captain's Beard \",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T00:00:00+00:00\",\"sale_end_date\":\"2026-04-24T17:00:00+01:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-04-24T18:00:00+01:00\",\"event_end_date\":\"2026-04-24T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"3og8dg-the-captains-beard-24th-apr-new-cross-inn-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2837,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/T87da97a8793?dice_id=T87da97a8793\",\"post_competition_referral\":\"https://link.dice.fm/Qb223a6fdb84?dice_id=Qb223a6fdb84\",\"post_purchase_extras_available_referral\":\"https://link.dice