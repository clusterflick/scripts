essibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":\"80a95d6b-916b-4da3-847d-795b6e368a98\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"impression_id\":\"14e26421af20bb85:79\",\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"presented_by\":\"Presented by Live Nation.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Skeng\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-21/cca63b66-3d67-4bb1-8490-4c6346d931b6.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"67540\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":2},\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1771347600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T17:00:00+00:00\",\"sale_end_date\":\"2026-03-28T22:00:00+00:00\",\"sale_start_date\":\"2026-02-19T10:00:00+00:00\",\"event_start_date\":\"2026-03-28T19:00:00+00:00\",\"event_end_date\":\"2026-03-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"698f52aa68765d0001adfdfd\",\"name\":\"Skeng\",\"price\":null,\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"