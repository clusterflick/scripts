_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:6\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"461\",\"name\":\"AEG\",\"image\":{\"url\":null},\"perm_name\":\"aeg-4rkv\",\"profile_active\":false},\"id\":\"697876b80f9ecb00017458fd\",\"name\":\"Sir Chloe\",\"perm_name\":\"q27pxo-sir-chloe-21st-may-electric-ballroom-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/490d3777-f14e-4da0-9fbb-099e1497e631.jpg?rect=874%2C0%2C3649%2C3649\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/490d3777-f14e-4da0-9fbb-099e1497e631.jpg?rect=0%2C206%2C5397%2C3238\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/490d3777-f14e-4da0-9fbb-099e1497e631.jpg?rect=1695%2C0%2C2007%2C3649\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sir Chloe\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-27/d69b2a98-53e3-4e89-9afa-7e447c06f319.jpg?rect=874%2C0%2C3649%2C3649\"},\"artist_id\":\"36800\",\"about\":{\"description\":\"Sir Chloe is the moniker of the musician and artist Dana Foote. She has been known to blend grungy guitar hooks, sharp pop instincts, and a distinctive, emotionally raw vocal style. Sir Chloe draws influence primarily from funeral dirges and early Gregorian chants, channelling artists like PJ Harvey, David Byrne, and Radiohead. Foote shirked her government name and adopted the moniker Sir Chloe in 2017. Her stage presence has been compared to the likes of a “dishevelled businessman after a long day,” and a “drunk uncle.” Her debut EP Party Favours (2020) has garnered nearly a billion streams and multiple gold records. The music is taut and emotionally charged, sitting between mainstream ambition and experimental edge.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770026400,\"faqs\":[{\"id\":72331,\"title\":\"Venue Accessibility Information\",\"body\":\"monopolyaccessibility@ticketquarter.co.uk\",\"order\":0},{\"id\":72332,\"title\":\"Age Restricition\",\"body\":\"This event is 14 and over. 14s to 16s must be accompanied by an adult.\\n\\nAny ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"order\":1}],\"price\":{\"currency\":\"GBP\",\"amount\":2928,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Michelle\",\"redirect_url\":\"https://open.spotify.com/track/48rZVgAGm0OlbbxjikCpqm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dec744a37d80b3e8c31b9b1c0b6d9276f2b5e1b5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Michelle\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:00:00+00:00\",\"sale_end_date\":\"2026-05-21T15:00:00+01:00\",\"sale_start_date\":\"2026-01-21T12:00:00+00:00\",\"event_start_date\":\"2026-05-21T19:00:00+01:00\",\"event_end_date\":\"2026-05-21T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP FAMILY  & FOOTSTEPS FESTIVAL.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/ae4a0621501a?dice_id=ae4a0621501a\",\"post_competition_referral\":\"https://link.dice.fm/qc362474c800?dice_id=qc362474c800\",\"post_purchase_extras_available_referral\