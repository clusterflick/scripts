d\":\"695ce7f47a3260000121439b\",\"name\":\"The Twilight Sad: Live + Signing\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1556},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Twilight Sad - WAITING FOR THE PHONE CALL\",\"redirect_url\":\"https://open.spotify.com/track/75j9x8JHig55lksFcdGAhp\",\"artist\":\"The Twilight Sad\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c509ad4a3c3505f50ce42cea2a4dd25d328f4e08?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"WAITING FOR THE PHONE CALL\"},{\"type\":\"apple_music\",\"title\":\"The Twilight Sad - WAITING FOR THE PHONE CALL\",\"redirect_url\":\"https://music.apple.com/us/album/waiting-for-the-phone-call/1844207735?i=1844207739&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Twilight Sad\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/34/e5/9e/34e59e99-2723-5e89-2b2c-a426f3f329f6/mzaf_10344259288270141135.plus.aac.p.m4a\",\"track_name\":\"WAITING FOR THE PHONE CALL\"}],\"faqs\":[{\"id\":67123,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":67124,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":67125,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":67126,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":67127,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":67128,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":67129,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":67130,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":67131,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":67132,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"score\":0,\"shopping_cart_enabled\":true,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"wweovp-trio-explorations-27th-mar-sjq-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774638000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/db08e6a3-7185-4169-9bac-61427fc630a9.jpg?rect=20%2C88%2C2342%2C2345\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/db08e6a3-7185-4169-9bac-61427fc630a9.jpg?rect=0%2C880%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/db08e6a3-7185-4169-9bac-61427fc630a9.jpg?rect=320%2C0%2C1760%2C3200\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/k352fb2aff06?dice_id=k352fb2aff06\",\"post_competition_referral\":\"https://link.dice.fm/k992a37a3ff9?dice_id=k992a37a3ff9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/q45fb691ce89?dice_id=q45fb691ce89\",\"post_purchase_referral\":\"https://link.dice.fm/jceb8eaf84dc?dice_id=jceb8eaf84dc\",\"post_waitinglist_referral\":\"https://link.dice.fm/x65e187dd74d?dice_id=x65e187dd74d\",\"post_reminder_referral\":\"https://link.dice.fm/Ra2f2557973d?dice_id=Ra2f2557973d\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-27T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"TRIO EXPLORATIONS\\n\\nThree leading voices from London’s forward-looking jazz community—Sheldon Agwu (Electric Guitar), Max Luthert (Upright Bass & Modular Synth), and Yusuf Ahmed (Drums & Percussion)—come together to form a trio that thrives on curiosity, groove, and sonic adventure.\\n\\nTheir music moves fluidly between lush harmony, textural experimentation, and rhythmic intensity, creating a sound that feels both expansive and immediate.\\n\\nGuitarist Sheldon Agwu blends Jazz Guitar with ambient layers and electronic colours, shaping a distinctive musical identity reflected in his projects Kintsugi, Vtet Live at Mu, and Seeds of Sanctum.\\n\\nBassist and modular architect Max Luthert, known for collaborations with Nubya Garcia, Zara McFarlane, and Moses Boyd, brings a deeply grounded yet exploratory presence that anchors—and often propels—the trio’s improvisational pathways.\\n\\nDrummer & Percussionist Yusuf Ahmed (Qwalia, Unknown to Known) channels Jazz, Afro-funk, and global rhythmic traditions into a dynamic voice that balances drive, nuance, and invention.\\n\\nTogether, the trio offers a night of immersive interplay, atmospheric soundscapes, and bold improvisation—music that lives at the crossroads of Jazz, Electronics, and boundary-pushing rhythm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":null,\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:26\",\"billing_promoter\":{\"id\":\"124635\",\"name\":\"SJQ\",\"image\":{\"url\":null},\"perm_name\":\"sjq-wb3bv\",\"profile_active\":false},\"presented_by\":\"Presented by SJQ.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sheldon Agwu\",\"imag