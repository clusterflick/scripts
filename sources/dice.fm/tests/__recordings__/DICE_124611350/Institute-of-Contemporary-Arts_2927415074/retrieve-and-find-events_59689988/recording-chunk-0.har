"purchase\",\"perm_name\":\"rybw5q-malena-zavala-25th-feb-the-grace-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772047800,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:52\",\"price\":{\"currency\":\"GBP\",\"amount\":2040,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-25/6d294c96-0e77-4f82-b846-86ef39cc0feb.jpg?rect=0%2C857%2C3649%2C3649\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-25/6d294c96-0e77-4f82-b846-86ef39cc0feb.jpg?rect=0%2C1587%2C3649%2C2189\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-25/6d294c96-0e77-4f82-b846-86ef39cc0feb.jpg?rect=350%2C0%2C2949%2C5362\"},\"id\":\"68cd16e3104d5a00019ff8c5\",\"name\":\"Malena Zavala\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"DHP Presents:\\n\\nMalena Zavala\\n\\n\\\\+ support\\n\\nMalena Zavala is an Argentinian-born, London-based artist and producer known for her ethereal, genre-blending sound. Her critically acclaimed DIY debut, ‘Aliso,’ led to tours supporting acts like Lord Huron and Men I Trust, major festival slots (Green Man, Latitude), and consistent support from BBC Radio 6 Music and BBC Radio 1.\\n\\nHer forthcoming album, ‘If This Life Could Start Again’ (Jan 2026, Paraná Records), is her most mature work yet. A transformative journey of healing structured like a mountain ascent, moving from folk and synth-pop to funk and rock. For her extensive UK/EU tour in Feb-Mar 2026, Zavala will translate this powerful narrative into a captivating live experience, using immersive visuals to guide the audience on the album's emotional journey.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-29T10:00:00+01:00\",\"sale_end_date\":\"2026-02-25T15:00:00+00:00\",\"sale_start_date\":\"2025-10-01T10:00:00+01:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"If It Goes\",\"redirect_url\":\"https://open.spotify.com/track/1u0qpHAwzNshb1XU2EUclz\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e05f8d8562dccb049b5686fe3b7d89efaa3f8240?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"If It Goes\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Black Honey\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-21/ff2c1534-92c4-45b2-a009-2377ad85b66f.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"1409\",\"about\":{\"description\":\"Led by their ferocious frontwoman Izzy B Phillips, the glam rock of Brighton’s Black Honey is as gutsy as it is glittery. Formed in 2014, the quartet forged from cinematic indie on their 2018 self-titled debut to heavier desert rock on 2021’s Written & Directed. They’ve opened for The Vaccines and Liam Gallagher, and Phillips always makes it clear that Black Honey’s shows are a safe space for female rockers.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Girl Group\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-02/c5a3546e-0eae-4b83-a0d2-54ab83a341a7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"119536\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Crosstown Concerts.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":38927,\"title\":\"What are the age restrictions?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\