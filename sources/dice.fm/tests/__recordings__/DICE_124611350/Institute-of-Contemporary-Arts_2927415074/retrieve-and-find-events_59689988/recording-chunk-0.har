26/ea79f6c5-441f-4e93-933d-f1aa8ec9f186.jpg?rect=157%2C0%2C1100%2C2000\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"THE BABES - Back to the UK for the first time in 6 years, the band will be celebrating the life of their late bassist and founding member Matt 'Ren Ex' on the day of his birthday. Hardcore Punk band with bagpipes, formed in London in 2015 and currently based between Paris and Texas and active internationally. The band is known for its explosive blend of hardcore, crust, and punk, all driven by the unmistakable sound of bagpipes.\\n\\nP.I.G - A mix of every thing loud and heavy with punk rock roots from London.\\n\\nTHE UGLY SCENES - Observational punk with a hard edge from London.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776362400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"171\",\"name\":\"Chats Palace\",\"address\":\"42-44 Brooksby's Walk, London E9 6DF\",\"location\":{\"lat\":51.5502294,\"lng\":-0.0429139000000305},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/Mf2d06b2cd49?dice_id=Mf2d06b2cd49\",\"post_competition_referral\":\"https://link.dice.fm/Md7837f794d4?dice_id=Md7837f794d4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p2ac74cf5229?dice_id=p2ac74cf5229\",\"post_purchase_referral\":\"https://link.dice.fm/laed812c2b40?dice_id=laed812c2b40\",\"post_reminder_referral\":\"https://link.dice.fm/B7169909144e?dice_id=B7169909144e\",\"post_waitinglist_referral\":\"https://link.dice.fm/vaaff4e88a11?dice_id=vaaff4e88a11\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Fire in the Mountain Festival LTD.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:59\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-04T00:00:00+00:00\",\"sale_end_date\":\"2026-04-16T21:30:00+01:00\",\"sale_start_date\":\"2026-01-04T00:00:00+00:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1767484800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1300},\"id\":\"695a3504268f630001581adf\",\"name\":\"Hackney Folk Club: Agile Rabbi's Klezmer Keilidh!\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":4},\"new\":false,\"seating\":null,\"perm_name\":\"v3q836-hackney-folk-club-agile-rabbis-klezmer-keilidh-16th-apr-chats-palace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/8f0bcf4b-ead7-45bb-8985-543d5bad1af6.jpg?rect=0%2C188%2C901%2C901\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/8f0bcf4b-ead7-45bb-8985-543d5bad1af6.jpg?rect=0%2C368%2C901%2C541\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/8f0bcf4b-ead7-45bb-8985-543d5bad1af6.jpg?rect=100%2C0%2C702%2C1277\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"**Hackney Folk Club Presents:**  \\nThe Agile Rabbi’s Klezmer Keilidh Experience, ft. special international guests\\n\\nDance leader **Avia Moore (Canada**) with an international all-star lineup of some of the world's most treasured Klezmorim\\n\\nBand members:  \\nAvia Moore - dance caller (Canada)  \\nFrank London - trumpet (USA)  \\nAnna Lowenstein - fiddle (UK)  \\nMerlin Shepherd - clarinet (UK)  \\nJosh Middleton - accordion  \\nFrancesca Ter-Berg - cello (UK)\\n\\n**We are grateful for the support of KlezMargate and PRSF in producing this dance.**\\n\\nSome of you may have heard the Agile Rabbi’s first featured performance headlining the Courtyard Stage on Sunday night at Fire In The Mountain 2025. Well, they are back; this time led by internationally renowned Yiddish dance caller Avia Moore (Canada) and accompanied by an all-star band comprising of some of the world's most treasured and celebrated Klezmer musicians. Come and be whisked up into a circle dance frenzy by a killer band of international musicians including Grammy Award winning trumpeter Frank London (US), Accordionist Sanne Möricke (NL/DE) plus Anna Lowenstein, Merlin Shepherd and Francesca Ter-Berg (UK). This will be Yiddish music and dance at its best. Not to be missed!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"p