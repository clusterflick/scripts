t_competition_referral\":\"https://link.dice.fm/s3c070f8a0b5?dice_id=s3c070f8a0b5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hf6ad70b937b?dice_id=hf6ad70b937b\",\"post_purchase_referral\":\"https://link.dice.fm/I5ee7e4c0f76?dice_id=I5ee7e4c0f76\",\"post_reminder_referral\":\"https://link.dice.fm/dab02807d3cb?dice_id=dab02807d3cb\",\"post_waitinglist_referral\":\"https://link.dice.fm/g4fce71a6893?dice_id=g4fce71a6893\"},\"perm_name\":\"v3g7nd-l-r-phoenix-25th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/d1599798-e47b-4f3d-bd72-e08d75a47c2b.jpg?rect=628%2C220%2C1079%2C1078\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/d1599798-e47b-4f3d-bd72-e08d75a47c2b.jpg?rect=0%2C68%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/d1599798-e47b-4f3d-bd72-e08d75a47c2b.jpg?rect=649%2C0%2C751%2C1365\"},\"properties\":[],\"about\":{\"description\":\"Preacher Blues from the Mississippi Delta and Hill Country Blues tradition.\\n\\nL.R. Phoenix is an English blues guitarist/singer/songwriter who happens to live in Finland. He plays in the style of Mississippi bluesmen like Fred McDowell, Junior Kimbrough and R.L. Burnside. He is a very fine guitar player, but it’s the voice, the voice is everything. It’s like Howlin’ Wolf crossed with Captain Beefheart with hints of Son House and Bukka White, then all liberally doused in malt whisky and honey. Phil Wight – Blues & Rhythm Magazine\\n\\nThe CD’s ‘The Hollow Log of Capt. Richard Wolfe’ and ‘Live at Blues Rules’ were voted best European Blues cd of 2011 and 2012 respectively by Blues Underground, also ‘The Hollow Log….’ was voted one of the top albums for 2012 by the Collection of French Radio DJ’s. Both CD’s been featured on numerous radio stations throughout Europe and have gotten rave reviews from Blues Matters! in England to Blues News in Finland.\\n\\n***Sponsored by Last Piastre Records.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692e232a4510540001391bdb\",\"name\":\"L. R. Phoenix\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"L.R. Phoenix - The Cypress Grove\",\"redirect_url\":\"https://music.apple.com/us/album/the-cypress-grove/1281964367?i=1281964373&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"L.R. Phoenix\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview128/v4/7a/61/54/7a6154a7-19c1-8491-72dc-9dbf13af5136/mzaf_584316253241486864.plus.aac.p.m4a\",\"track_name\":\"The Cypress Grove\"},{\"type\":\"spotify\",\"title\":\"L.R. Phoenix - The Cypress Grove\",\"redirect_url\":\"https://open.spotify.com/track/5nCWx4WfyGOf8V4lWnGjJ1\",\"artist\":\"L.R. Phoenix\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5758f4dbe242a9f3550c026a40a94435d9a668d1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Cypress Grove\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"L. R. Phoenix\",\"image\":null,\"artist_id\":\"130885\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-28T13:00:00+01:00\",\"sale_end_date\":\"2026-07-26T01:00:00+01:00\",\"sale_start_date\":\"2025-07-28T13:00:00+01:00\",\"event_start_date\":\"2026-07-25T13:00:00+01:00\",\"event_end_date\":\"2026-07-26T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+L