on_id\":\"55e67ca3ba9827ff:30\",\"price\":{\"currency\":\"GBP\",\"amount\":2622,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/59dab159-c823-4dd2-80c0-5b4c5c00b4f0.jpg?rect=947%2C0%2C3789%2C3789\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/59dab159-c823-4dd2-80c0-5b4c5c00b4f0.jpg?rect=0%2C190%2C5683%2C3410\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/59dab159-c823-4dd2-80c0-5b4c5c00b4f0.jpg?rect=1800%2C0%2C2084%2C3789\"},\"id\":\"691f0745b0fc2b0001fe3600\",\"name\":\"Islandman\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"As a sonic collective with no fixed borders, the Turkish trio reimagine the deep-rooted expressive forms of Anatolian music.\\n\\nTheir approach gives rise to what they describe as Neo-Turkish Psychedelia—not a reinvention, but a continuation: a way of letting Turkish psychedelic music live on.\\n\\nBorn from the imagination of Tolga Böyük, Islandman gradually transformed into a trio— completed by the psychedelic guitar work of Erdem Başer and the meditative percussion of Eralp Güven.\\n\\nTheir live performances unfold at the intersection of acoustic and electronic: part ceremony, part dancefloor.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-20T12:00:00+00:00\",\"sale_end_date\":\"2026-05-29T18:00:00+01:00\",\"sale_start_date\":\"2025-11-20T12:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:00:00+01:00\",\"event_end_date\":\"2026-05-29T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sumeru\",\"redirect_url\":\"https://open.spotify.com/track/2gL3yeSrVcdgYUgebT6TKN\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f35d758ccc182d7fbacabafa9cfc0ded3683e4b2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sumeru\"},{\"type\":\"apple_music\",\"title\":\"islandman - Dimitro\",\"redirect_url\":\"https://music.apple.com/gb/album/dimitro/1458543663?i=1458543666&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"islandman\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview123/v4/4a/0c/38/4a0c388d-f28e-1389-dcc8-5fd949eee9ba/mzaf_4860616037186386378.plus.aac.p.m4a\",\"track_name\":\"Dimitro\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Canaan Cox\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7bcca5ed564af35322856615\"},\"artist_id\":\"59268\",\"about\":{\"description\":\"Growing up in North Carolina with seven sisters, Canaan Cox couldn’t escape pop music. Inspired by Whitney Houston, Hanson and his parents’ country bands, the singer-songwriter studied musical theatre before relocating to Nashville to pursue contemporary country pop. Aided by his acoustic guitar, an appearance on The Bobby Bones Show in 2021 introduced Cox’s heart-warming ballads to millions across the country. The following year, he released his debut self-titled album, brimming with all-American radio-friendly tunes.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DHP FAMILY.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.j