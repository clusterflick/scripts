active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:73\",\"date_unix\":1778090400,\"price\":{\"currency\":\"GBP\",\"amount\":2819,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/U259b0d4f3f1?dice_id=U259b0d4f3f1\",\"post_competition_referral\":\"https://link.dice.fm/q0175c5772de?dice_id=q0175c5772de\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R3a38835eae9?dice_id=R3a38835eae9\",\"post_purchase_referral\":\"https://link.dice.fm/Q56904464a3f?dice_id=Q56904464a3f\",\"post_reminder_referral\":\"https://link.dice.fm/We9fd09ea487?dice_id=We9fd09ea487\",\"post_waitinglist_referral\":\"https://link.dice.fm/qf960cf0e3bb?dice_id=qf960cf0e3bb\"},\"perm_name\":\"8erpnv-yellow-days-6th-may-scala-london-tickets\",\"secondary_status\":\"rescheduled\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/a0354cfb-d478-4143-8c6f-033a80497eac.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/a0354cfb-d478-4143-8c6f-033a80497eac.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/a0354cfb-d478-4143-8c6f-033a80497eac.jpg?rect=270%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"George van den Broek’s mercurial talent has long been the talk of contemporary music. An overnight sensation when 2016 debut E.P Harmless Melodies touched a nerve with a global audience of millennials, he signed a worldwide deal with Sony while most teenagers’ biggest challenge would be surviving Freshers’ Week.\\n\\nSubsequent sonic excursions have seen him explore everything from sprawling pop fusion (Sony debut A Day In A Yellow Beat) to sci-fi conceptualism (2024’s Hotel Heaven) -complete with themed global tour.\\n\\nHis latest release as Yellow Days, ‘Rock And A Hard Place’, however, sees George — newly married and drug-free — returning to the influences which inspired him to start making music in his parents’ garden shed in Haslemere, Surrey, as a wide-eyed 16-year-old.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6920b1a4f701580001e7e413\",\"name\":\"Yellow Days\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"A Little While\",\"redirect_url\":\"https://open.spotify.com/track/1ahzHj4rfljE8w4ZwpEjOM\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/99324fb2036fbce7671c73eeef24a69d8d5057c5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"A Little While\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Brian Nasty\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-05-20/37d53b8a-42bf-497e-838b-eb07e8f2d32d.jpg?rect=0%2C2362%2C9449%2C9449\"},\"artist_id\":\"30525\",\"about\":null,\"is_headliner\":false},{\"name\":\"Yellow Days\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-30/e4487378-ad10-45f1-9bb8-ab10d896edd7.jpg?rect=0%2C0%2C160%2C160\"},\"artist_id\":\"3720\",\"about\":{\"description\":\"Known for throaty vocals that accompany his indie soul-pop, Yellow Days is the solo project of London singer-songwriter and musician George van den Broek.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-21T00:00:00+00:00\",\"sale_end_date\":\"2026-05-06T00:00:00+01:00\",\"sale_start_date\":\"2025-11-21T00:00:00+00:00\",\"event_start_date\":\"2026-05-06T19:00:00+01:00\",\"event_end_date\":\"2026-05-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offer