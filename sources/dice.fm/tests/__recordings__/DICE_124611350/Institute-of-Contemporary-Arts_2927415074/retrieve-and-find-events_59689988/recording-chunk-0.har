me\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-14T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tamikrest\",\"image\":null,\"artist_id\":\"18467\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"**Iconic Saharan blues legends Tamikrest, bring the powerful voice of the Kel Tamasheq people to our stage.**\\n\\nFormed on the border of Algeria and Mali in 2006, Tamikrest quickly developed a reputation for their **sharp melodies** and **deeply political songwriting**.\\n\\nThe award winning *Chatma*—dedicated to the struggles of women in the Sahara—was hailed as a major work of the Ishumar genre. Since then, Tamikrest has further asserted their deep Tamasheq roots, fusing traditional music with the raw energy of rock.\\n\\nCatch their unfiltered passion at the beating heart of London's music scene.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T10:00:00+00:00\",\"sale_end_date\":\"2026-06-14T19:00:00+01:00\",\"sale_start_date\":\"2025-12-11T10:00:00+00:00\",\"event_start_date\":\"2026-06-14T19:00:00+01:00\",\"event_end_date\":\"2026-06-14T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6936c17271afd00001af0acb\",\"name\":\"Tamikrest\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/63f3c761-1aa4-4978-b199-663a198546b6.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/63f3c761-1aa4-4978-b199-663a198546b6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/63f3c761-1aa4-4978-b199-663a198546b6.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1765274400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Sc475bebedd0?dice_id=Sc475bebedd0\",\"post_competition_referral\":\"https://link.dice.fm/y176ff141270?dice_id=y176ff141270\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C20e56bd45cf?dice_id=C20e56bd45cf\",\"post_purchase_referral\":\"https://link.dice.fm/C614b5bad57b?dice_id=C614b5bad57b\",\"post_reminder_referral\":\"https://link.dice.fm/Gffe7af3344e?dice_id=Gffe7af3344e\",\"post_waitinglist_referral\":\"https://link.dice.fm/z9031b72e49a?dice_id=z9031b72e49a\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sun 14 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2571,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":17867,\"title\":\"What to do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":0},{\"id\":17868,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":1},{\"id\":17869,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":17870,\"title\":\"A show is listed as sold out. How can I get tickets?\",\"body\":\"If a show is listed as sold out on this website then our venue is full to capacity. We recommend you download the DICE app and join the Waiting List for return tickets.\\n\\nYou are welcome to visit the box office when doors open for the event to see if there are any door tickets. We cannot guarantee door tickets will be available in advance. Sorry.\",\"order\":3},{\"id\":17871,\"title\":\"I have mobility issues. How can you help?\",\"body\":\"If you need a seat for medical reasons or need help moving around our venue, or if you’d like to bring a companion along to help you with mobility, you will need to arrange it with us in advance. We suggest you read our accessibility guide and then contact our box office.\",\"order\":4},{\"id\":17872,\"title\":\"Do I need ID? What type of ID is accepted?\",\"body\":\"Bring ID if you look 25 years of age or younger. We accept the following forms of photo ID.\\n\\n\\\\- Passport\\n\\n\\\\- Driving licence card\\n\\n\\\\- PASS card. You can apply for a PASS card at www.pass-scheme.org.uk\",\"order\":5},{\"id\":17873,\"title\":\"Can I bring food?\",\"body\":\"We do not allow you to bring food or drink into the venue. Chewing gum is also not permitted inside the venue.\",\"order\":6},{\"id\":17874,\"title\":\"Is there a cloakroom?\",\"body\":\"Yes, we have a cloakroom in the Foyer Bar space. As you walk up the entrance stairs and straight ahead towards the Foyer Bar the cloakroom is on the left. Each item is charged at £3.\",\"order\":7},{\"id\":76539,\"title\":\"Age Restricition\",\"body\":\"This event is 14 and over. 14s to 16s must be accompanied by an adult.\\n\\nAny ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"order\":8}],\"billing_promoter\":{\"id\":\"24\",\"name\":\"Live Nation\",\"image\":{\"url\":null},\"perm_name\":\"live-nation-z6d3\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"g5my2b-die-spitz-15th-jun-electric-ballroom-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1781546400,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:44\",\"venues\":[{\"id\":\"55\",\"name\":\"Electric Ballroom\",\"address\":\"184 Camden High St, London NW1 8QP\",\"location\":{\"lat\":51.5396558,\"lng\":-0.143191399999978},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/fab0b36d-a5a4-4e37-a541-2c5af15a3bc1.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"electric-ballroom-j78v\",\"accessibility\":{\"url\":\"http://electricballroom.co.uk/disabled-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-15T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Die Spitz\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-06/11f52c37-af49-4c65-818f-a9b41ceee8aa.jpg?rect=0%2C200%2C800%2C800\"},\"artist_id\":\"54774\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"On Something to Consume, Die Spitz combine their passion, friendship, identity, and artistry to fight against the inescapable decay that surrounds modern life. “There’s a political side to it, but addiction and love can also be all-consuming,” Eleanor Livingston says. And as the band trade off instruments, swapping songwriting and vocal duties, and generating powerful songwriting in concussive bursts, Die Spitz have created their own little pocket of the world where we can all stand on the edge together, as showcased by the album’s singles “Throw Yourself to the Sword,” “Pop Punk Anthem (Sorry for the Delay),” “Punishers,” and “RIDING WITH MY GIRLS,” alongside a video by Bita Ghassemi.\\n\\nSomething to Consume moves with rapturous conviction thanks in part to the deft production hand of Studio 4’s Will Yip (Turnstile, Mannequin Pussy). Though only recently in their 20s, Die Spitz’s impressive musicianship ties them clearly to a long lineage of frustrated people hoping to inspire change. “Some people aren’t interested in being political activists via music, but it weighs on me heavily and I feel misaligned with my calling if I don’t,” Chloe De St. Aubin says. “The four of us are free spirits with multiple interests, and there’s no limit or power dynamic that can derail us.”\\n\\nDie Spitz just finished a US tour supporting Viagra Boys, with a headline run in progress. Their infamous riotous live show, which regularly feature dueling cartwheels, climbing of rafters and solos while crowdsurfing, is not to be missed.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (Under 16s to be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T10:00:00+00:00\",\"sale_end_date\":\"2026-06-15T10:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-06-15T19:00:00+01:00\",\"event_end_date\":\"2026-06-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698e0bef5f830a0001869327\",\"name\":\"Die Spitz\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/f6947c8b-689d-48a6-82d4-c809c2694b90.jpg?rect=154%2C1125%2C1877%2C1875\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/f6947c8b-689d-48a6-82d4-c809c2694b90.jpg?rect=0%2C780%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/f6947c8b-689d-48a6-82d4-c809c2694b90.jpg?rect=375%2C0%2C1650%2C3000\"},\"marketeers\":[{\"id\":1707,\"name\":\"Live Nation UK\",\"privacy_policy_link\":\"https://www.livenation.co.uk/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770976800,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/l438b3ff8006?dice_id=l438b3ff8006\",\"post_competition_referral\":\"https://link.dice.fm/Ob47a0ddea14?dice_id=Ob47a0ddea14\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/be64f631aa70?dice_id=be64f631aa70\",\"post_purchase_referral\":\"https://link.dice.fm/g09a8a5afec8?dice_id=g09a8a5afec8\",\"post_reminder_referral\":\"https://link.dice.fm/b14880d6d6e1?dice_id=b14880d6d6e1\",\"post_waitinglist_referral\":\"https://link.dice.fm/v9a5382aa1f4?dice_id=v9a5382aa1f4\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Die Spitz - Barricade\",\"redirect_url\":\"https://open.spotify.com/track/75WqC31borSgQfYMDqJmIm\",\"artist\":\"Die Spitz\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b5d9b92323fb9635757a62d31b5045ce1a7c7088?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Barricade\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Mon 15 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":3837,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":76453,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":76454,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":76455,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"q29ynp-letlive-16th-jun-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781632800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"announced\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:45\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-16T19:00:00+01:00\",\"doors_close_date\":\"2026-06-16T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"letlive.\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/07016d102e5afc026b494731afce19df38a545fc\"},\"artist_id\":\"2335\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"letlive. is\\n\\nJason Aalon Butler - Vocals\\n\\nJean Nascimento - Guitar\\n\\nJeff Sahyoun - Guitar\\n\\nletlive. is returning. The trailblazing progressive soul punk outfit from Los Angeles, California, known for their genre-defying sound and raw intensity, is again stepping onto the stage.\\n\\nFormed in 2002, letlive. quickly established themselves as one of the most energetic and emotionally charged acts in the alternative music scene. Fronted by the dynamic and impassioned Jason Aalon Butler, the band blended elements of hardcore, punk, R&B, and soul to create a unique sonic identity that resonated with fans worldwide.\\n\\nTheir breakout album, Fake History (2010), gained critical acclaim for its raw emotion and innovative sound, earning them a dedicated following. This success led to their signing with Epitaph Records, where they released two more groundbreaking albums: The Blackest Beautiful (2013) and If I’m the Devil... (2016). Both records showcased the band’s evolution, tackling social justice, personal struggle, and self-discovery themes with unrelenting honesty and creativity.\\n\\nKnown for their legendary live performances, letlive. became a force of nature on stage, with shows described as chaotic yet cathartic experiences. Their unfiltered energy and Butler’s explosive stage presence connected deeply with audiences, making every performance unforgettable.\\n\\nThe band announced its breakup shortly after releasing If I’m the Devil…, and it went on hiatus. Now, letlive. is ready to return, reignited by founding members Jean Nascimento (guitar) and Jeff Sahyoun (guitar). The band is embarking on its first shows since 2016, with a highly anticipated tour spanning Australia, Europe, and the United States.\\n\\nHighlights include headline dates and appearances at major festivals like 2000 Trees, Vans Warped Tour, and When We Were Young. Jason, Jeff, and Jean will be joined by Sage Webber (Point North) on drums and Skyler Accord (Issues) on bass.\\n\\nletlive.'s return is more than a farewell — it’s a rebirth. This reunion celebrates their groundbreaking past and continues their mission to challenge, inspire, and connect with fans through their unapologetically honest and emotionally charged music.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-06-16T18:00:00+01:00\",\"sale_start_date\":\"2026-02-18T10:00:00+00:00\",\"event_start_date\":\"2026-06-16T19:00:00+01:00\",\"event_end_date\":\"2026-06-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698db78e05ec8c000194d8af\",\"name\":\"letlive.\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/8a172378-1b78-44f1-a0b7-7799a592241b.jpg?rect=2878%2C0%2C5746%2C5746\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/8a172378-1b78-44f1-a0b7-7799a592241b.jpg?rect=963%2C0%2C9577%2C5746\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/8a172378-1b78-44f1-a0b7-7799a592241b.jpg?rect=4171%2C0%2C3160%2C5746\"},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771236000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/f73e198ea727?dice_id=f73e198ea727\",\"post_competition_referral\":\"https://link.dice.fm/t4132023a910?dice_id=t4132023a910\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Uf4b395739c7?dice_id=Uf4b395739c7\",\"post_purchase_referral\":\"https://link.dice.fm/vfec7407bd32?dice_id=vfec7407bd32\",\"post_reminder_referral\":\"https://link.dice.fm/n85cd80eb2f8?dice_id=n85cd80eb2f8\",\"post_waitinglist_referral\":\"https://link.dice.fm/l4cefe3880e6?dice_id=l4cefe3880e6\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"A Weak Ago\",\"redirect_url\":\"https://open.spotify.com/track/3rY98pNrVY2OOacnbxbI0E\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f2a615a5b5ec812880e24e0e1e9bc057844e653f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"A Weak Ago\"},{\"type\":\"apple_music\",\"title\":\"letlive. - Younger\",\"redirect_url\":\"https://music.apple.com/us/album/younger/1485058066?i=1485058076&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"letlive.\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/c9/ae/c3/c9aec35c-fa48-9c4c-1dd2-ecae3088b83a/mzaf_15285239984523530799.plus.aac.p.m4a\",\"track_name\":\"Younger\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2987},\"seats_io_public_key\":null,\"presented_by\":\"Presented by BOTW. \",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":73975,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. All attendees 16-17s must be accompanied by a responsible adult who is 18 or older (1:1 ratio). To verify age, ID may be requested. We advise all customers to bring valid ID. For further information, see Age and ID in FAQs. Right of admission reserved.\",\"order\":0}],\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"q292w9-skullcrusher-16th-jun-earth-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781634600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:46\",\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-06-16T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Skullcrusher\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/8586338187ded34a1fdc690d0f1a846897f8ec30\"},\"artist_id\":\"20866\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nAnd Your Song is Like a Circle, the second album from New York-based artist Skullcrusher, a.k.a. Helen Ballentine, winds its way into an everchanging, unstable core. Recorded piecemeal over a period of years following the release of her celebrated 2022 debut, Quiet the Room, And Your Song is Like a Circle does not capture experience – it gestures toward the imprint of an experience that is uncapturable. Swaying between vaporous folk and crystalline electronics, landing somewhere in the snowfields shared by Grouper and Julia Holter, Circle probes the ways that grief turns itself inside out. Loss itself becomes as real and substantial as what's been lost.\\n\\nBallentine began writing Circle after leaving Los Angeles, a city she’d called home for nearly a decade. She ended up returning upstate to New York’s Hudson Valley, where she was bornand raised. Several years of intense isolation followed, and Ballentine immersed herself in films, books, and art that reflected the rupture of relocating cross-country and its dissociative aftershocks.\\n\\nThroughout the record, the line between human and machine blurs. On \\\"Maelstrom,\\\" voices crash between echoing drumbeats like water through a cavern. The vocal filigrees on \\\"Exhale\\\" fan out into a haze of synthesizers and strings. \\\"Dragon\\\" lets piano echo over tight, gritted percussion.\\n\\nIf Skullcrusher’s first album rendered the detailed intimacies of domestic space, Circle finds itself vaporized across the landscape: swirling, drifting, searching. It skirts an event horizon in long, slow strokes. These are songs that vibrate with the fervency of an attempt to capture a moment, to draw a circle around it. \\\"I like thinking about my work as a collection,\\\" Ballentine says. \\\"Eventually it might form a circle. Each time I make something, I’m putting another line around the body of work. It feels like I’ll be trying to trace it for my whole life.\\\"\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T16:00:00+00:00\",\"sale_end_date\":\"2026-06-16T21:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-06-16T19:30:00+01:00\",\"event_end_date\":\"2026-06-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"698231904a60520001f42f0a\",\"name\":\"Skullcrusher\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/091f1fcf-f120-4dd2-ac1a-f17cae5a5a75.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/091f1fcf-f120-4dd2-ac1a-f17cae5a5a75.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/091f1fcf-f120-4dd2-ac1a-f17cae5a5a75.jpg?rect=675%2C0%2C1650%2C3000\"},\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770220800,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_t