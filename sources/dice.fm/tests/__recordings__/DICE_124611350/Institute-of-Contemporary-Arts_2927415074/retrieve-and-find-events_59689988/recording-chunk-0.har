ts-us-std-000001/AudioPreview128/v4/91/85/96/918596a1-2869-1705-806e-8c256db576af/mzaf_5291754557625606715.plus.aac.p.m4a\",\"track_name\":\"Walking On a Dream\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by SJQ.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"124635\",\"name\":\"SJQ\",\"image\":{\"url\":null},\"perm_name\":\"sjq-wb3bv\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"yoamkv-trio-explorations-26th-jun-sjq-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782496800,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:91\",\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-26T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"about\":{\"description\":\"TRIO EXPLORATIONS\\n\\nThree leading voices from London’s forward-looking jazz community—Sheldon Agwu (Electric Guitar), Max Luthert (Upright Bass & Modular Synth), and Yusuf Ahmed (Drums & Percussion)—come together to form a trio that thrives on curiosity, groove, and sonic adventure.\\n\\nTheir music moves fluidly between lush harmony, textural experimentation, and rhythmic intensity, creating a sound that feels both expansive and immediate.\\n\\nGuitarist Sheldon Agwu blends Jazz Guitar with ambient layers and electronic colours, shaping a distinctive musical identity reflected in his projects Kintsugi, Vtet Live at Mu, and Seeds of Sanctum.\\n\\nBassist and modular architect Max Luthert, known for collaborations with Nubya Garcia, Zara McFarlane, and Moses Boyd, brings a deeply grounded yet exploratory presence that anchors—and often propels—the trio’s improvisational pathways.\\n\\nDrummer & Percussionist Yusuf Ahmed (Qwalia, Unknown to Known) channels Jazz, Afro-funk, and global rhythmic traditions into a dynamic voice that balances drive, nuance, and invention.\\n\\nTogether, the trio offers a night of immersive interplay, atmospheric soundscapes, and bold improvisation—music that lives at the crossroads of Jazz, Electronics, and boundary-pushing rhythm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-05-29T18:30:00+01:00\",\"sale_start_date\":\"2026-02-16T00:00:00+00:00\",\"event_start_date\":\"2026-06-26T19:00:00+01:00\",\"event_end_date\":\"2026-06-27T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69935384b4756500013a74b6\",\"name\":\"Trio Explorations\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=0%2C0%2C2400%2C2400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=0%2C880%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/f0519294-ac2e-4997-9682-7ef7cf5b570f.jpg?rect=320%2C0%2C1760%2C3200\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771200000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/L37ba4263f36?dice_id=L37ba4263f36\",\"post_competition_referral\":\"https://link.dice.fm/b2adc46a9519?dice_id=b2adc46a9519\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z08781b62056?dice_id=Z08781b62056\",\"post_purchase_referral\":\"https://link.dice.fm/i72e86231bc4?dice_id=i72e86231bc4\",\"post_reminder_referral\":\"https://link.dice.fm/P54411744671?dice_id=P54411744671\",\"post_waitinglist_referral\":\"https://link.dice.fm/j99409a9d2ba?dice_id=j99409a9d2ba\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3523},\"seats_io_public_key\":null,\"presented_by\":\"Presented by AGMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":50215,\"title\":\"Venue Restoration Levy\",\"body\":\"The restoration levy is £1.20 for 229.\",\"order\":0}],\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"yogv82-omarbrighter-the-days-uk-26th-jun-229-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782496800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:92\",\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-26T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Omar\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-02-14/b2114648-e76e-4aeb-9f71-859a9dd51e78.jpg?rect=0%2C27%2C876%2C876\"},\"artist_id\":\"65944\",\"about\":{\"description\":\"Broadly known as an R&B singer, Omar covers hip-hop, soul, jazz, funk, ragga and both Latin and Caribbean dance music. Truthfully, he makes Omar music; far more than the sum of its myriad parts. His refusal to rest or compromise his many artistic directions is key to his credibility, with artists including India.Arie, Erykah Badu, Angie Stone and Stevie Wonder all fans of his music, with Wonder even writing a song for the two of them to duet.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"AGMP Concerts and Music Venue Trust Liveline Presents:\\n\\nOMAR – 'BRIGHTER THE DAYS’ UK TOUR\\n\\nCelebrating 40 years in music, Omar Lyefook MBE—one of the UK’s most celebrated soul artists—returns with his new album Brighter The Days. Since his timeless breakthrough hit There’s Nothing Like This, Omar has defined British soul, blending jazz, funk, R&B, and Caribbean influences into a sound entirely his own.\\n\\nWith collaborations spanning Stevie Wonder, Erykah Badu, Angie Stone, Leon Ware, Robert Glasper, Paul Weller, and India Arie, Omar’s legacy as a true innovator is unmatched. Brighter The Days showcases his trademark vocals, lush string arrangements, and collaborations with Giggs, Raheem DeVaughn, Eric Roberson, Ledisi, and more — an album he describes as his “magnum opus.”\\n\\nA performer of effortless class and deep musicality, Omar’s live shows are a masterclass in groove, soul, and sincerity. Don’t miss this rare opportunity to experience a genuine British icon performing new material and timeless classics live.\\n\\n“I am healed all over when he sings” - Erykah Badu\\n\\n“When I grow up I wanna be like Omar.” Stevie Wonder\\n\\nhttps://omarmusic.co.uk\\n\\nhttps://www.instagram.com/omar_lyefook\\n\\nhttps://www.facebook.com/omarofficialuk\\n\\nhttps://twitter.com/omarlyefookMBE\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-13T10:00:00+01:00\",\"sale_end_date\":\"2026-06-26T17:00:00+01:00\",\"sale_start_date\":\"2025-10-17T10:00:00+01:00\",\"event_start_date\":\"2026-06-26T19:00:00+01:00\",\"event_end_date\":\"2026-06-26T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68e92c41fb456c00011a6d00\",\"name\":\"Omar ‘Brighter The Days’ UK\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-10/d507119a-ab1f-45b9-aa17-dac9788abea5.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-10/d507119a-ab1f-45b9-aa17-dac9788abea5.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-10/d507119a-ab1f-45b9-aa17-dac9788abe