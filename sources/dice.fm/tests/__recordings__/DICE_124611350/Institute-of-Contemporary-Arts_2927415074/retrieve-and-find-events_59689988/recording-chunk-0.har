_waitinglist_referral\":\"https://link.dice.fm/wd3fe8b94d81?dice_id=wd3fe8b94d81\",\"post_reminder_referral\":\"https://link.dice.fm/Q22fd241ed13?dice_id=Q22fd241ed13\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"8870\",\"name\":\"Club Cheek\",\"address\":\"302-304 Barrington Road, SW9 7JJ\",\"location\":{\"lat\":51.463624,\"lng\":-0.107648},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"club-cheek-vqag\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**Conjuring** #1 features a live improvisation by **Lucinda Chua, Ben Vince, Xiaoqiao and Saied Silbak.**\\n\\n**Conjuring** is a monthly live music event series curated by Studio Njoku - the label and creative hub founded by Tony Njoku - a vital voice in contemporary experimental music.\\n\\nConjuring brings together leading experimental musicians for live, collaborative, improvised performances. The project foregrounds musical dialogue, community building and spiritual expression.\\n\\nEach edition features a unique lineup of guest musicians performing a one-time live improvisation around a central motif developed by Tony Njoku.\\n\\n**Lucinda Chua** is a composer, producer and artist with British, Malaysian and ancestral Chinese roots. Her elemental soundscapes embrace the hybridity of traditional instruments and electronic production, often combining voice, cello and effects to create music that is both intimate and expansive.\\n\\n**Ben Vince** is a composer and performer, known for his improvised saxophone explorations and inventive techniques in creating new rhythms, textures and moods.\\n\\n**Xiaoqiao** is a London-based harpist and singer-songwriter who fuses harp with a blend of electronic effects and ghostly vocals, crafting a hypnotic soundscape into the under river.\\n\\n**Saied Silbak** is a London-based Palestinian composer and oud virtuoso renowned for his evocative fusion of Arabic maqam, jazz, and Western classical traditions.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:16\",\"billing_promoter\":{\"id\":\"132194\",\"name\":\"Club Cheek\",\"image\":{\"url\":null},\"perm_name\":\"club-cheek-vabov\",\"profile_active\":false},\"presented_by\":\"Studio Njoku\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1769769000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T10:30:00+00:00\",\"sale_end_date\":\"2026-03-19T19:30:00+00:00\",\"sale_start_date\":\"2026-01-30T10:30:00+00:00\",\"event_start_date\":\"2026-03-19T19:30:00+00:00\",\"event_end_date\":\"2026-03-19T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"697bd91837943f0001f90c58\",\"name\":\"Lucinda Chua, Ben Vince, Xiaoqiao, Saied Silbak\",\"price\":{\"currency\":\"GBP\",\"amount\":1550,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Lucinda Chua - Semitones\",\"redirect_url\":\"https://open.spotify.com/track/462GXyXYeAfLTjVzyylfL4\",\"artist\":\"Lucinda Chua\",\"previe