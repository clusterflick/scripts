Width: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":4350,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Heart's Not In It\",\"redirect_url\":\"https://open.spotify.com/track/0rdwnhUXrxevC63E1EyizS\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/16be3a9cf05b87904afa71d921e2ecb80277976e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Heart's Not In It\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T10:00:00+00:00\",\"sale_end_date\":\"2026-11-19T21:00:00+00:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-11-19T19:30:00+00:00\",\"event_end_date\":\"2026-11-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Academy Events \",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/k798b5b5ceab?dice_id=k798b5b5ceab\",\"post_competition_referral\":\"https://link.dice.fm/D6fff4ee6ecd?dice_id=D6fff4ee6ecd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Rbcfac34a6a6?dice_id=Rbcfac34a6a6\",\"post_purchase_referral\":\"https://link.dice.fm/m05a20821387?dice_id=m05a20821387\",\"post_reminder_referral\":\"https://link.dice.fm/v223bb3f3214?dice_id=v223bb3f3214\",\"post_waitinglist_referral\":\"https://link.dice.fm/Jd16af710c35?dice_id=Jd16af710c35\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"To coincide with the release of Their long awaited third album “lll” (Three) Part one, out on 13th March 2026, the band announce their biggest London show so far at Village Underground in Shoreditch, with special guest DJ on the night Abi Clarke. Since releasing their first self-titled album in 2017 with the follow up “Break The Wall” in 2021, MF Robots have been winning fans and audiences alike with their critically acclaimed authentic, characterful and positively uplifting brand of funky future- soul music, winning over established fans of the genre and making lots of new fans on the way. Their energetic live show, with super-stylish vocal powerhouse Dawnn Joseph owning the stage out front while the super tight Robots live band lay down the heavy groove to back it up, is a seriously exciting ,irresistible wild ride, and make this show, as anyone who has seen them will tell you, NOT TO BE MISSED. So, if you want to be moved, want to MOVE and have an unforgettable night out in front of a super exciting live band who LOVE what they do, then YOU need to be there. The band will be performing songs from all three albums with some new surprises along the way. DO NOT MISS THIS.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795116600,\"venues\":[{\"id\":\"83