_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"6dweo7-eliades-ochoa-25th-oct-roundhouse-london-tickets\",\"seats_io_event_id\":\"c0d6691c-7895-46cb-826c-2bfc379f3aee\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Muriendo De Envidia\",\"redirect_url\":\"https://open.spotify.com/track/740uwCK09xVPNPr4hFpcWW\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/736c6101d1aee5f55baf6144e873c832cb11dc0b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Muriendo De Envidia\"},{\"type\":\"apple_music\",\"title\":\"Eliades Ochoa & El Cuarteto Patria - Píntate los Labios María (Son)\",\"redirect_url\":\"https://music.apple.com/us/album/p%C3%ADntate-los-labios-mar%C3%ADa-son/697665873?i=697665883&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Eliades Ochoa & El Cuarteto Patria\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/69/fd/37/69fd37a0-2392-e125-a7bb-af7ca84908b8/mzaf_11779487081713412022.plus.aac.p.m4a\",\"track_name\":\"Píntate los Labios María (Son)\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":58642,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":58643,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":58644,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":58645,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eliades Ochoa\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1fa29f154252bc7eb94132b7\"},\"artist_id\":\"50785\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-25T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/a0b5a31a-a6c4-4f6f-8d6e-e0c0fb4ad627.jpg?rect=0%2C0%2C4814%2C4814\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/a0b5a31a-a6c4-4f6f-8d6e-e0c0fb4ad627.jpg?rect=0%2C1383%2C4814%2C2888\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/a0b5a31a-a6c4-4f6f-8d6e-e0c0fb4ad627.jpg?rect=853%2C0%2C3109%2C5653\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/ne338c80e75f?dice_id=ne338c80e75f\",\"post_competition_referral\":\"https://link.dice.fm/y15faf4cdc0a?dice_id=y15faf4cdc0a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Oebe7ca319d7?dice_id=Oebe7ca319d7\",\"post_purchase_referral\":\"https://link.dice.fm/R464af566ce2?dice_id=R464af566ce2\",\"post_reminder_referral\":\"https://link.dice.fm/tfaabd966cca?dice_id=tfaabd966cca\",\"post_waitinglist_referral\":\"https://link.dice.fm/E9286d35c216?dice_id=E9286d35c216\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:71\",\"properties\":[],\"presented_by\":\"Presented by Como No!\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763558100,\"id\":\"691deec4463f010001d14774\",\"name\":\"Eliades Ochoa\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Eliades Ochoa\\n\\nRoundhouse\\n\\nSunday 25th October 2026\\n\\nAfter his previous Barbican performance sold out within days, the legendary Eliades Ochoa — star of the Grammy-winning Buena Vista Social Club and the unmistakable voice behind the timeless classic Chan Chan — returns to London for a special evening at the Roundhouse.\\n\\nWith his rugged charm, trademark hat and cowboy boots, Ochoa has long been hailed as Cuba’s Johnny Cash: a master guitarist, storyteller and one of the most distinctive voices in Cuban “son” music.\\n\\nThe Latin GRAMMY Award-winner is a celebrated ambassador of traditional Cuban music and one of the finest guitarists of his generation. We’re proud to present this legendary Cuban star and storyteller live at the Roundhouse.\\n\\nThis is an all-ages event (Under 16s accompanied by an adult, Under 14s accompanied and in seats).\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"5970\",\"name\":\"Como No!\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-09/a9850c4f-895d-494f-beec-abcf15aec03e.jpg\"},\"perm_name\":\"como-no-v7rd\",\"profile_active\":true},\"date_unix\":1792954800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3032,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T18:30:00+00:00\",\"sale_end_date\":\"2026-10-25T18:30:00+00:00\",\"sale_start_date\":\"2026-01-12T18:30:00+00:00\",\"event_start_date\":\"2026-10-25T19:30:00+00:00\",\"event_end_date\":\"2026-10-25T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"wwroyn-mike-masse-25th-oct-the-100-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Leader of the Band\",\"redirect_url\":\"https://open.spotify.com/track/1OI1p0Ea4dNsJ2QUvMortE\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/310eff0086453220b48c48b4554b71d5b146eae4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Leader of the Band\"},{\"type\":\"apple_music\",\"title\":\"Mike Massé - Africa (feat. Jeff Hall)\",\"redirect_url\":\"https://music.apple.com/gb/album/africa-feat-jeff-hall/538715861?i=538715865&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mike Massé\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music/b0/06/f4/mzi.ffecmhfv.aac.p.m4a\",\"track_name\":\"Africa (feat. Jeff Hall)\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mike Massé\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9c292c2c161be656bb0e06a8\"},\"artist_id\":\"17718\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-25T19:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/0aec7f74-623f-49a4-8f93-255a03b03ead.jpg?rect=0%2C911%2C3645%2C3645\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/0aec7f74-623f-49a4-8f93-255a03b03ead.jpg?rect=0%2C1640%2C3645%2C2187\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/0aec7f74-623f-49a4-8f93-255a03b03ead.jpg?rect=319%2C0%2C3007%2C5467\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/cdd6dbeae49a?dice_id=cdd6dbeae49a\",\"post_competition_referral\":\"https://link.dice.fm/Q31a066b3222?dice_id=Q31a066b3222\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t5d7fd21d49d?dice_id=t5d7fd21d49d\",\"post_purchase_referral\":\"https://link.dice.fm/ua5ef7d629b5?dice_id=ua5ef7d629b5\",\"post_reminder_referral\":\"https://link.dice.fm/C40ed63016ee?dice_id=C40ed63016ee\",\"post_waitinglist_referral\":\"https://link.dice.fm/G559d2b902d3?dice_id=G559d2b902d3\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:72\",\"properties\":[],\"presented_by\":\"Presented by 100 Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768242600,\"id\":\"69653e6b875e55000183b5f4\",\"name\":\"Mike Masse\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"An Evening with Mike Massé: Epic Acoustic Classic Rock\\n\\n“Toto’s favorite cover of ‘Africa’” – Yahoo! Music\\n\\n“One of the best Africa cover versions ever recorded.” – BBC Radio\\n\\n“Terrific!” – Dennis DeYoung (Styx)\\n\\n“Love this cover!” – Sarah McLachlan\\n\\n“Thank you very much! Beautiful. Great job!” – Geddy Lee (Rush)\\n\\n\\\"Fabulous version...excellent singing.\\\" - Nick Van Eede (Cutting Crew)\\n\\nMike Massé (USA) returns to the historic 100 Club on Sunday 25 October for an intimate evening of Epic Acoustic Classic Rock. A globally recognized artist with nearly 200 million YouTube views, Mike is known for his powerful interpretations of timeless songs by the Beatles, Simon & Garfunkel, Elton John, U2, Pink Floyd, and more.\\n\\nBlending exceptional musicianship with humor and storytelling, his performances create a uniquely engaging live experience—perfectly suited to one of London’s most iconic music rooms. This return appearance offers audiences another chance to experience classic rock up close, delivered with emotion, originality, and warmth. Cover the music, cover the world.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"7103\",\"name\":\"100 Club\",\"image\":{\"url\":null},\"perm_name\":\"100-club-lnlp\",\"profile_active\":true},\"date_unix\":1792956600,\"event_tag\":null}],\"title\":\"Sun 25 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":5468,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"2af7fe8c-2bd4-432f-b3d4-0d5cb147b639\",\"seats_io_public_key\":\"8e5f7a89-fb24-4265-aa05-4baee349555c\",\"seat_selection\":\"disabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-03-24T17:30:00+00:00\",\"sale_end_date\":\"2026-10-28T14:00:00+00:00\",\"sale_start_date\":\"2025-03-24T17:30:00+00:00\",\"event_start_date\":\"2026-10-28T18:00:00+00:00\",\"event_end_date\":\"2026-10-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8lk6p-tokio-hotel-28th-oct-ovo-arena-wembley-london-london-tickets\",\"seats_io_event_id\":\"2af7fe8c-2bd4-432f-b3d4-0d5cb147b639\",\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"8e5f7a89-fb24-4265-aa05-4baee349555c\",\"tags_types\":[{\"name\":\"gig\",\"