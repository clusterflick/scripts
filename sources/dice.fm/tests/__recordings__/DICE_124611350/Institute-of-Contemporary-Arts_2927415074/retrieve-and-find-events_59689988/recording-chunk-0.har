_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780509600,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:64\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3642},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-03/c3032a89-8e68-4b77-9cc8-8189b26677e1.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-03/c3032a89-8e68-4b77-9cc8-8189b26677e1.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-03/c3032a89-8e68-4b77-9cc8-8189b26677e1.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"68b888b6ebc0d200012f67c4\",\"name\":\"Philip Sayce + special guest Tom Moriarty\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Planet Rock Radio presents Philip Sayce ‘the soulful master of the stratocaster’.\\n\\nFollowing his electrifying and critically acclaimed 2024 UK tour, guitar marvel and powerhouse vocalist Philip Sayce returns in May / June 2026 for a nationwide UK tour fueled with a brand-new live release and a forthcoming studio album that promises to raise the bar yet again.\\n\\nVIP meet & greets will be available for direct purchase for select performances at philipsayce.com\\n\\nSayce’s special guest on the tour is critically acclaimed British guitarist and singer songwriter Tom Moriarty. “Tom’s music appeals to fans of Ben Harper, Ray Lamontagne and Van Morrison,” says Guitarist magazine.*  \\n  \\n  \\nBy purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-22T10:00:00+01:00\",\"sale_end_date\":\"2026-06-03T21:00:00+01:00\",\"sale_start_date\":\"2025-09-24T10:00:00+01:00\",\"event_start_date\":\"2026-06-03T19:00:00+01:00\",\"event_end_date\":\"2026-06-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/901z5kmngvJPPHcYLazEL59Qjn6RMTin01F4Z55wgn1no.m3u8\",\"track_name\":\"\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Movimientos.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"8689\",\"name\":\"Jamboree\",\"address\":\"6 St. Chad's Place, Camden, London, WC1X 9HH, United Kingdom\",\"location\":{\"lat\":51.530445,\"lng\":-0.119635},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"jamboree-x29e\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-03T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2296\",\"name\":\"Movimientos\",\"image\":{\"url\":null},\"perm_name\":\"movimientos-6ey2\",\"profile_active\":false},\"announcement_date_unix\":1769990400,\"social_links\":{\"event_share\":\"https://link.dice.fm/Aefbf6cb5a26?dice_id=Aefbf6cb5a26\",\"post_competition_referral\":\"https://link.dice.fm/ga5c59a20d85?dice_id=ga5c59a20d85\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S4a84c38a4bc?dice_id=S4a84c38a4bc\",\"post_purchase_referral\":\"https://link.dice.fm/D19d3a49ca19?dice_id=D19d3a49ca19\",\"post_reminder_referral\":\"https://link.dice.fm/De80bd92d443?dice_id=De80bd92d443\",\"post_waitinglist_referral\":\"https://link.dice.fm/a630fac86f0a?dice_id=a630fac86f0a\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"wwe3er-coco-dos-pretos-3rd-jun-jamboree-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780511400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:65\",\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/3726c95d-2202-4da8-ab6a-ec454fbbd97c.jpg?rect=118%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/3726c95d-2202-4da8-ab6a-ec454fbbd97c.jpg?rect=0%2C83%2C1004%2C602\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/3726c95d-2202-4da8-ab6a-ec454fbbd97c.jpg?rect=291%2C0%2C422%2C768\"},\"id\":\"6980ea1f5d1567000193a19a\",\"name\":\"Coco Dos Pretos \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Hailing from Recife, Brazil, Coco dos Pretos bring the earthy, communal and explosive coco rhythm. The group has pioneered an innovative approach to this traditional rhythm, expanding and refining its sound while staying rooted in ancestral heritage.\\n\\nFrom live concerts to itinerant community gatherings, Coco dos Pretos are dedicated to preserving and promoting Afro-descendant culture.\\n\\nThrough their work, they challenge the stigmas often attached to popular traditions such as coco, and above all, they celebrate and strengthen Afro-Brazilian identity and expression.\\n\\nAn earth-stomping night rooted in Afro-Brazilian traditions, Coco dos Pretos is built for movement and community.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-06-03T18:00:00+01:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-06-03T19:30:00+01:00\",\"event_end_date\":\"2026-06-03T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Merzbow\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c965a62ae75b9bad89d9913f7\"},\"artist_id\":\"4475\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_