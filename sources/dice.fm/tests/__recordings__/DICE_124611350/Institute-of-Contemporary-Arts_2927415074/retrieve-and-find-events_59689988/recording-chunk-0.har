imezone\":\"Europe/London\",\"announcement_date\":\"2025-07-30T00:00:00+01:00\",\"sale_end_date\":\"2026-05-15T19:00:00+01:00\",\"sale_start_date\":\"2025-07-30T00:00:00+01:00\",\"event_start_date\":\"2026-05-15T19:00:00+01:00\",\"event_end_date\":\"2026-05-15T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1753830000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"id\":\"688a26c2454d7a0001343edc\",\"name\":\"Febre90s \",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"new\":false,\"seating\":null,\"perm_name\":\"k6rbe9-febre90s-15th-may-the-jazz-cafe-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-30/d37f60be-4718-4917-a15b-c3d87e8f8f70.jpg?rect=834%2C0%2C3333%2C3333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-30/d37f60be-4718-4917-a15b-c3d87e8f8f70.jpg?rect=0%2C167%2C5000%2C3000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-30/d37f60be-4718-4917-a15b-c3d87e8f8f70.jpg?rect=1584%2C0%2C1833%2C3333\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"**Brazil’s Febre90s are breathing new life into golden era hip-hop with raw finesse and youthful urgency.**\\n\\nHailing from opposite corners of Brazil, Febre90s are a duo reimagining classic rap with eyes locked firmly on the future.\\n\\nMC Pumapjl and beatmaker SonoTWS conjure the dusty swing of ’90s boom bap with the grit of underground Brazil and the sharp detail of seasoned crate diggers. Think Gang Starr with Carioca attitude, wrapped in Supreme tees and MPC grit.\\n\\nFrom underground tape releases to festival main stages like Primavera Sounds, Coala, and Batuque, Febre90s aren’t just reviving the sound – they’re reshaping it.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4NzAxOCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUxNzc1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjozNS4wOTQ3MzhaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzU5NywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4NzAxOCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUxNzc1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjozNS4wOTQ3NjNaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzU5OCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4NzAxOCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUxNzc1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjozNS4wOTQ3NzNaIiwicHJ