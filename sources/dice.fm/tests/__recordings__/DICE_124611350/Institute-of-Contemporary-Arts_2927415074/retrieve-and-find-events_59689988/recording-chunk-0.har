17th-feb-the-joiner-on-worship-london-tickets\",\"date_unix\":1771353000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"venues\":[{\"id\":\"13583\",\"name\":\"Morocco Bound\",\"address\":\"1a Morocco Street, Southwark, London, SE1 3HB, United Kingdom\",\"location\":{\"lat\":51.50033,\"lng\":-0.082},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"morocco-bound-wnln\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-15/8f17862c-5f99-4090-8c50-77cd117f6e02.jpg?rect=63%2C0%2C1609%2C1609\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-15/8f17862c-5f99-4090-8c50-77cd117f6e02.jpg?rect=0%2C210%2C1984%2C1190\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-15/8f17862c-5f99-4090-8c50-77cd117f6e02.jpg?rect=550%2C0%2C885%2C1609\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1771113600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Rap & Poetry Open Mic w/ special guest The Urban Cellist!\\n\\nCalling all lyrical musicians, poets, wordsmiths & curious listeners to our new event which combines rap, music & poetry. All are welcome from first timers to seasoned vets, this is a supportive and open space.\\n\\nWe're joined by Gary Washington aka \\\"The Urban Cellist\\\" a New Orleans born Cellist, Composer & Songwriter who simultaneously creates vocal percussion (beatboxing) while playing. Gary will perform some of his own work and also provide backing (Cello/Vocals) to anyone who'd like.\\n\\nAlternatively please send your backing tracks ahead of time to booksandbeershop@icloud.com you're also welcome to perform acapella. If you're unsure of what to choose here are a few suggestions:\\n\\nBand of Gold by DJ Grumble\\n\\nPiñata (Intrumental) by Freddie Gibbs & Madlib\\n\\nYou Are More (Bonus Track) by IAMNOBODI\\n\\nH by Keinemusik Crust by Flying Lotus\\n\\n\\\\*Tickets cost £5 to ensure those who sign up do attend, if you can't attend please let us know so that tickets can be reallocated. If this is out of your price range please let us know via email (booksandbeershop@icloud.com) & we'll make adjustments accordingly.\\\\*\\n\\nPerformers please arrive 15 mins before (18:45) so that we can determine the running order.\\n\\nMorocco Bound is a safe, inclusive space for all. Please take accountability for your own words and issue any neccessary trigger warnings/disclaimers before your performance.\\n\\nEach performer has a 5 min slot.\\n\\nDoors 7pm - see you there!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Morocco Bound.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:5\",\"social_links\":{\"event_share\":\"https://link.dice.fm/yb1f26a3f19a?dice_id=yb1f26a3f19a\",\"post_competition_referral\":\"https://link.dice.fm/f2b0bb5eeec9?dice_id=f2b0bb5eeec9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Zd76be595405?dice_id=Zd76be595405\",\"post_purchase_referral\":\"https://link.dice.fm/