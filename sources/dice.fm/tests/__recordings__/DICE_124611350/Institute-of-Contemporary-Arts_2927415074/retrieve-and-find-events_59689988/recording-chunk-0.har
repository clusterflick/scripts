.\\n\\nAZNSZN has been covered by ESEA Network and BBC Radio London, with our shows having been filmed by The British Museum archive team, citing its “cultural posterity”.\\n\\nWe are proud to fundraise for the Palestine Children’s Relief Fund at our shows.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:33\",\"billing_promoter\":{\"id\":\"136175\",\"name\":\"aznszn\",\"image\":{\"url\":null},\"perm_name\":\"aznszn-l6k6p\",\"profile_active\":false},\"presented_by\":\"AZNSZN\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":5},\"marketeers\":[{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+Last+.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1766966400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-29T00:00:00+00:00\",\"sale_end_date\":\"2026-03-22T22:45:00+00:00\",\"sale_start_date\":\"2025-12-29T00:00:00+00:00\",\"event_start_date\":\"2026-03-22T19:00:00+00:00\",\"event_end_date\":\"2026-03-22T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6954009d3e60ad0001d74242\",\"name\":\"floralis + velvet caveat + htmljones + tba + tba