?\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-30/6bd2a6b4-6fbf-4beb-9602-b6740af9c2e4.jpg?rect=260%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-30/6bd2a6b4-6fbf-4beb-9602-b6740af9c2e4.jpg?rect=4%2C0%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-30/6bd2a6b4-6fbf-4beb-9602-b6740af9c2e4.jpg?rect=433%2C0%2C422%2C768\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1753959600,\"max_tickets\":6,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**“They came to listen because they love Joni Mitchell, but they went away loving Hejira.” - Jazzwise**\\n\\nCelebrating Joni Mitchell: the 7-piece band Hejira performs the greatest works of the genius singer-songwriter.\\n\\nIn 1979, Joni toured briefly with a band of top-drawer contemporaneous musicians producing the much-lauded live recording, Shadows And Light; it is from this album that the band Hejira is drawing the body of its repertoire.\\n\\nHejira is fronted by the brilliant Hattie Whitehead who has – in her own way – assimilated the poise, power and beauty of Joni’s vocals, and also plays guitar with Joni’s stylistic mannerisms.\\n\\nExpect an evening of the great songs from Mitchell’s back catalogue.\\n\\n*This event does not feature a performance by Joni Mitchell. This event is not in association with Joni Mitchell.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:17\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Qd361e9503ba?dice_id=Qd361e9503ba\",\"post_competition_referral\":\"https://link.dice.fm/Zbd53803718c?dice_id=Zbd53803718c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k5a011061d96?dice_id=k5a011061d96\",\"post_purchase_referral\":\"https://link.dice.fm/e62ddd3e68ca?dice_id=e62ddd3e68ca\",\"post_reminder_referral\":\"https://link.dice.fm/p69ae293cc1a?dice_id=p69ae293cc1a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Rbe8389c997a?dice_id=Rbe8389c997a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-31T12:00:00+01:00\",\"sale_end_date\":\"2026-03-16T19:00:00+00:00\",\"sale_start_date\":\"2025-07-31T12:00:00+01:00\",\"event_start_date\":\"2026-03-16T19:00:00+00:00\",\"event_end_date\":\"2026-03-16T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2350,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"688a208b617d1d0001ab4975\",\"seats_io_event_id\":null,\"name\":\"Hejira play Joni Mitchell\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"2wbvpo-hejira-play-joni-mitchell-16th-mar-the-jazz-cafe-london-tickets\",\"date_unix\":1773687600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unic