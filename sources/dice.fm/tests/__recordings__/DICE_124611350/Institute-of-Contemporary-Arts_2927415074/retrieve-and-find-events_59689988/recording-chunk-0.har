ments/2025-10-20/e57a09a6-3d99-478c-a5e9-bd82d0a54b43.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-20/e57a09a6-3d99-478c-a5e9-bd82d0a54b43.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-20/e57a09a6-3d99-478c-a5e9-bd82d0a54b43.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/O552df55d3a8?dice_id=O552df55d3a8\",\"post_competition_referral\":\"https://link.dice.fm/n5f2bdaaab2a?dice_id=n5f2bdaaab2a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d759186224bc?dice_id=d759186224bc\",\"post_purchase_referral\":\"https://link.dice.fm/J6e46383d2a3?dice_id=J6e46383d2a3\",\"post_reminder_referral\":\"https://link.dice.fm/Xd27e713d8b6?dice_id=Xd27e713d8b6\",\"post_waitinglist_referral\":\"https://link.dice.fm/X5b6d8e351a6?dice_id=X5b6d8e351a6\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:37\",\"properties\":[],\"presented_by\":\"Presented by Kings Place.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760918400,\"id\":\"68f73ac012094a000183fcca\",\"name\":\"Cole Stacey presents Postcards From Live Places\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"***After a decade touring with Midge Ure and India Electric Company and following his top 10 single, a reimagining of Fade To Grey, Cole Stacey shares his acclaimed solo album Postcards From Lost Places. Expect captivating stories, lyrical songwriting rooted in tradition, haunting melodies and a night of connection in a remarkable setting.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**Cole Stacey** is a visceral and lyrical songwriter, singer and musician who has roamed the highest diverse echelons of British folk, 80s pop, spoken word and ambient electronics. From The Royal Albert Hall to The Westfalenhalle Arena, from 700-year-old castles in Gdansk to Glastonbury Festival. His unique debut album has at its heart a symbiosis of ‘lost’ places and forgotten words, stretching as far back as the 13th century, paired with Cole’s distinctive lyrical songwriting and remarkable field recordings. Bringing together his years of experience on stage, Cole’s deeply personal solo shows are rooted in storytelling, directed by a love of popular song, folk traditions and have connection with people and places are their heart.\\n\\n***This performance will last approximately 1 hour and 45 minutes, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"date_unix\":1775759400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1927,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-26T10:00:00+01:00\",\"sale_end_date\":\"2026-04-09T15:00:00+01:00\",\"sale_start_date\":\"2025-09-26T10:00:00+01:00\",\"event_start_date\":\"2026-04-09T19:30:00+01:00\",\"event_end_date\":\"2026-04-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":fa