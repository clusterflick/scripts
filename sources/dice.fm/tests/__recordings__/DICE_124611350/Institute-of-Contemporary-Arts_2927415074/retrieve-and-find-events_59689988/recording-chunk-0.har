67e9.jpg?rect=0%2C0%2C5192%2C5192\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/86468c08-853d-4c2b-87a9-daf2438867e9.jpg?rect=0%2C1039%2C5192%2C3115\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/86468c08-853d-4c2b-87a9-daf2438867e9.jpg?rect=1168%2C0%2C2856%2C5192\"},\"id\":\"68f77b1f0818d90001491851\",\"name\":\"Tsar B\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Eat Your Own Ears presents Tsar B at The Lexington.\\n\\nBelgian artist, composer and multi-instrumentalist Tsar B (Justine Bourgeus) rearranges the DNA of pop, classical-baroque, and club beats into a rush of life at a breakneck velocity, teeming with astonishment, devotion and curiosity. Throughout her career, Bourgeus has bridged her work into visual mediums such as film, dance and fashion.\\n\\n“A unique blend of self-described “dark-as-the-night R&B,” anchored on pitched-down and glitchy electronics” - Billboard\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-22T10:00:00+01:00\",\"sale_end_date\":\"2026-03-11T17:45:00+00:00\",\"sale_start_date\":\"2025-10-24T10:00:00+01:00\",\"event_start_date\":\"2026-03-11T20:00:00+00:00\",\"event_end_date\":\"2026-03-11T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Tsar B - Amor\",\"redirect_url\":\"https://open.spotify.com/track/5PeQQwj8nCFR37kv0n7yEN\",\"artist\":\"Tsar B\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a326018966a047e3c62d34ba77457502ac098036?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Amor\"},{\"type\":\"apple_music\",\"title\":\"Tsar B - Amor\",\"redirect_url\":\"https://music.apple.com/us/album/amor/1831507251?i=1831507263&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Tsar B\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/df/47/2f/df472f49-7502-3291-8f32-7b58a5875ee9/mzaf_1732697056722789394.plus.aac.p.m4a\",\"track_name\":\"Amor\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by EGG.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-11T22:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"announcement_date_unix\":1717246800,\"social_links\":{\"event_share\":\"https://link.dice.fm/C4b92e308212?dice_id=C4b92e308212\",\"post_competition_referral\":\"https://link.dice.fm/nd1fbb314661?dice_id=nd1fbb314661\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ed573e5103e6?dice_id=Ed573e5103e6\",\"post_purchase_referral\":\"https://link.dice.fm/be5d72f27cd7?dice_id=be5d72f27cd7\",\"post_reminder_referral\":\"https://link.dice.fm/g592d68e7bbd?dice_id=g592d68e7bbd\",\"post_waitinglist_referral\":\"https://link.dice.fm/z1d0bf3ed6f6?dice_id=z1d0bf3ed6f6\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"mxlg6r-wednesday-club-house-electro-and-hip-hop-11th-mar-egg-ldn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773268200,\"has_multiple_ticket_types\":true,\"impression_id\":\"49dcf1c1636e57c2:53\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C166%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C326%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=89%2C0%2C622%2C1131\"},\"id\":\"69780934d6ac2c000171698e\",\"name\":\"Wednesday Club: House, Electro and Hip Hop\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Wednesday Club at Egg London\\n\\nMidweek, done properly.\\n\\nEvery Wednesday, Wednesday Club brings house, tech house, electro and hip hop to Egg London — built for students and anyone looking to switch off and reset before the weekend.\\n\\nDoors open from 22:30 – 04:00, with free entry before midnight plus a free shot when claimed online.\\n\\nExpect solid music all night, a mixed crowd, and selected drinks at £5 across the event.\\n\\nWhether you’re coming straight from uni, work, or just need a midweek release — Wednesday Club keeps things moving without the weekend\\n\\nchaos.\\n\\nEgg London\\n\\n 22:30 – 04:00\\n\\n Free entry before 00:00 + free shot (online claim required) \\n\\nHouse · Tech House · Electro · Hip Hop \\n\\n£5 selected drinks all night\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-06-01T14:00:00+01:00\",\"sale_end_date\":\"2026-03-12T02:30:00+00:00\",\"sale_start_date\":\"2024-06-01T14:00:00+01:00\",\"event_start_date\":\"2026-03-11T22:30:00+00:00\",\"event_end_date\":\"2026-03-12T04:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Wed 11 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Netil360\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":2,\"properties\":[],\"venues\":[{\"id\":\"16754\",\"name\":\"Netil360\",\"address\":\"1 Westgate Street, Hackney, London, E8 3RL, United Kingdom\",\"location\":{\"lat\":51.537645,\"lng\":-0.058792},\"image\":null,\"city\":{\"id\":\"6778fdabe81e04c767ac592f\",\"name\":\"Stoke Newington\",\"lo