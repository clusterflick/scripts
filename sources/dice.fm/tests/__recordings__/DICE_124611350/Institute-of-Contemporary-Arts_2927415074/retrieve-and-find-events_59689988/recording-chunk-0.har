653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11708\",\"name\":\"Kino Short Film\",\"image\":{\"url\":null},\"perm_name\":\"kino-short-film-n5g5\",\"profile_active\":false},\"announcement_date_unix\":1765195200,\"social_links\":{\"event_share\":\"https://link.dice.fm/r03568a7d8cd?dice_id=r03568a7d8cd\",\"post_competition_referral\":\"https://link.dice.fm/n1f9b057d356?dice_id=n1f9b057d356\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b04e53b094c5?dice_id=b04e53b094c5\",\"post_purchase_referral\":\"https://link.dice.fm/G48e161985b8?dice_id=G48e161985b8\",\"post_reminder_referral\":\"https://link.dice.fm/c85f00f56ded?dice_id=c85f00f56ded\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q0fa6f3e54b5?dice_id=Q0fa6f3e54b5\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"3ogyxg-short-film-open-screen-17th-feb-strongroom-bar-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1771354800,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:0\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=588%2C0%2C1511%2C1511\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=84%2C0%2C2518%2C1511\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=928%2C0%2C831%2C1511\"},\"id\":\"69690465eb5a600001c6d12b\",\"name\":\"Short Film Open Screen\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\n\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Screen is a genuine reflection of the current output of London based filmmakers.\\n\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\n\\n- One film per filmmaker\\n- Register in advance\\n- Filmmakers must be present to introduce film\\n- Films are accepted on a first-come, first-screened basis\\n- Film running time should be under 10 mins\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T12:00:00+00:00\",\"sale_end_date\":\"2026-02-17T20:00:00+00:00\",\"sale_start_date\":\"2026-01-15T12:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:00:00+00:00\",\"event_end_date\":\"2026-02-17T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Tue 17 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_has