at\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"next-door-records-two-mylk\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"461\",\"name\":\"AEG\",\"image\":{\"url\":null},\"perm_name\":\"aeg-4rkv\",\"profile_active\":false},\"announcement_date_unix\":1770285600,\"social_links\":{\"event_share\":\"https://link.dice.fm/O5bdb405067e?dice_id=O5bdb405067e\",\"post_competition_referral\":\"https://link.dice.fm/Ld27d71e7bb4?dice_id=Ld27d71e7bb4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S8630d6ee374?dice_id=S8630d6ee374\",\"post_purchase_referral\":\"https://link.dice.fm/Jb6f2e3d2544?dice_id=Jb6f2e3d2544\",\"post_reminder_referral\":\"https://link.dice.fm/Zed02d44faf9?dice_id=Zed02d44faf9\",\"post_waitinglist_referral\":\"https://link.dice.fm/S4b9b1a78848?dice_id=S4b9b1a78848\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bb8b6g-plastic-factory-presents-lttl-mort-lemonsuckr-cosign-25th-feb-next-door-records-two-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[{\"id\":35,\"name\":\"the Event Organiser, AEG Presents\",\"privacy_policy_link\":\"https://www.aegpresents.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772047800,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:39\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/b3cdf851-00ba-4122-bd46-3de007c319de.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/b3cdf851-00ba-4122-bd46-3de007c319de.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/b3cdf851-00ba-4122-bd46-3de007c319de.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"698206ef40912a00015e0f93\",\"name\":\"Plastic Factory presents: lttl mort, Lemonsuckr + cosign\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Plastic Factory presents sub:terra, a monthly new music series focused on bolstering emerging talent in the very best of London’s grassroots spaces. This Feb we bring lttl mort, Lemonsuckr + cosign to Next Door Records 2.\\n\\n**lttl mort**\\n\\nEmerging from the underbelly of the UK’s rising electronic scene, lttl mort melds sleaze-soaked synth-pop with industrial death-techno disquiet. With dirty basslines, jagged breakbeats and sardonic vocals, Jazz Pope's brand-new solo project blurs the line between hedonism and self-awareness. Equal parts sweat and satire, the world of lttl mort is where dance music’s escapism meets the existential dread of the morning after.\\n\\n**Lemonsuckr**\\n\\nLemonsuckr’s live performances are nothing short of chaos with a hot-bloodedness and confidence afforded only to a group of people who have spent so long understanding what they want an audience to feel, from the immediate pounding and unrelenting beat to the last screech of feedback.\\n\\n**cosign**\\n\\ncosign is an artist and producer based in Belfast, crafting immersive indie-electronic music that sits at the intersection of emotion and innovation. Drawn to experimental production and lyrical depth, their sound fuses pulsing energy with introspective melancholy, layered with arps, vocoders, and rich harmonies.\\n\\n**FREE ENTRY**\\n\\n\\\\*Please keep in mind that a free ticket does not guarantee entry to the show and we will be operating on a first come, first served basis\\\\*\\n\\nAll ages. Anyone under 18 must be accompanied by a parent or guardian (18 or over)\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T10:00:00+00:00\",\"sale_end_date\":\"2026-02-25T12:00:00+00:00\",\"sale_start_date\":\"2026-02-05T10:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mukbang Ray\",\"image\":null,\"artist_id\":\"130525\",\"about\":null,\"is_headliner\":false},{\"name\":\"Scared Little Toaster\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebdd3fa93c8e3b849e1520b00f\"},\"artist_id\":\"117996\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Short Waves.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2399\",\"name\":\"The Victoria Dalston\",\"image\":{\"url\":null},\"perm_name\":\"the-victoria-dalston-l3wp\",\"profile_active\":false},\"announcement_date_unix\":1769817600,\"social_links\":{\"event_share\":\"https://link.dice.fm/tef1ffc8df52?dice_id=tef1ffc8df52\",\"post_competition_referral\":\"https://link.dice.fm/n8edddbc7820?dice_id=n8edddbc7820\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h352282292b7?dice_id=h352282292b7\",\"post_purchase_referral\":\"https://link.dice.fm/lfe2fc6b6ad7?dice_id=lfe2fc6b6ad7\",\"post_reminder_referral\":\"https://link.dice.fm/V46b5fb0aacb?dice_id=V46b5fb0aacb\",\"post_waitinglist_referral\":\"https://link.dice.fm/ee7d2a1e659c?dice_id=ee7d2a1e659c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eo39xd-scared-little-toaster-kanukai-mukbang-ray-25th-feb-the-victoria-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772047800,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:40\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-07/3b23b137-4ee5-4fc7-a69e-51e19bdbf400.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-07/3b23b137-4ee5-4fc7-a69e-51e19bdbf400.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-07/3b23b137-4ee5-4fc7-a69e-51e19bdbf400.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"697e53af31e09500010b86f1\",\"name\":\"Scared Little Toaster / Kanukai / Mukbang Ray \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Short Waves Presents:\\n\\n**\\\\- Scared Little Toaster:** an experimental rock bass and drums duo, from London/Norfolk with the addition of sporadic moments of jazz and the occasional use of a domestic appliance.\\n\\n(https://www.instagram.com/_scaredlittletoaster/)\\n\\n**\\\\- Kanukai:** Featured in The Sunday Times Culture Magazine for his journey from council estate to sold out shows across Brighton & London, Kanukai’s Grungy Psych Soul is “making waves on the south coast” (Joe Strummer Fund).\\n\\n(https://www.instagram.com/kanukai888/)\\n\\n**\\\\- Mukbang Ray:** Mukbang Ray is a 5 piece band from London. Consisting of Olivia Hughes (Vocals), Barney Anderson (Guitar), Seb Bloom (Drums), Sonny Caplan-Higgs (Saxophone and Electronics) and Antoine Ray (bass). Their mission is to “make music that sounds like how the Simpson’s makes you feel”. Mukbang Ray is a 5 piece band from London. Consisting of Olivia Hughes (Vocals), Barney Anderson (Guitar), Seb Bloom (Drums), Sonny Caplan-Higgs (Saxophone and Electronics) and Antoine Ray (bass). Their mission is to “make music that sounds like how the Simpson’s makes you feel”.\\n\\n(https://www.instagram.com/mukbangray_/)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-31T00:00:00+00:00\",\"sale_end_date\":\"2026-02-25T21:00:00+00:00\",\"sale_start_date\":\"2026-01-31T00:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"LYLO\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb13910183f38ea44c9feac03d\"},\"artist_id\":\"6175\",\"about\":null,\"is_headliner\":false},{\"name\":\"Alliyah Enyo\",\"image\":null,\"artist_id\":\"59860\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by LYLO.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"13170\",\"name\":\"LYLO\",\"image\":{\"url\":null},\"perm_name\":\"lylo-vl2d\",\"profile_active\":false},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/h646193e86fa?dice_id=h646193e86fa\",\"post_competition_referral\":\"https://link.dice.fm/Vf25a8aa63cb?dice_id=Vf25a8aa63cb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E9a538b39953?dice_id=E9a538b39953\",\"post_purchase_referral\":\"https://link.dice.fm/gc3d4825d5fa?dice_id=gc3d4825d5fa\",\"post_reminder_referral\":\"https://link.dice.fm/q159c53e817f?dice_id=q159c53e817f\",\"post_waitinglist_referral\":\"https://link.dice.fm/B037df1466d7?dice_id=B037df1466d7\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yo6w8p-lylo-alliyah-enyo-gaby-dannunzio-25th-feb-sjq-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772047800,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:41\",\"price\":{\"currency\":\"GBP\",\"amount\":1339,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/48791332-3886-4ec1-a6d5-bce95305759b.jpg?rect=576%2C0%2C3456%2C3456\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/48791332-3886-4ec1-a6d5-bce95305759b.jpg?rect=0%2C346%2C4608%2C2765\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/48791332-3886-4ec1-a6d5-bce95305759b.jpg?rect=1354%2C0%2C1901%2C3456\"},\"id\":\"69766ecd7752d6000134fff8\",\"name\":\"LYLO, Alliyah Enyo + Gaby D'Annunzio\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"LYLO return to SJQ for part 2 /4 of their monthly residency after their sold out opening night. Returning from touring their last offering 'Thoughts Of Never' and extensive session work, the Glasgow trio have stayed in London, writing new material and experimenting with new live dyanmics. Upbeat, ambient, warpy soul. Make sure to grab a ticket early to avoid disappointment.\\n\\nAcross her multidisciplinary practice, Alliyah Enyo harnesses song, somatics and sculpture, queering ancient mythology and folklore in widespread outcomes from recorded sound to installation and performance. She is a current resident at EXIT club in Glasgow,and is currently working on an upcoming solo album merging styles of medieval choral music such as Gregorian chanting while also reflecting on her modern influences including leftfield r&b and industrial music.\\n\\nGaby D'Annunzio is a London-based curator, DJ and broadcaster. Previously based in Berlin, she co-founded the Open Music Lab, a free music production school for marginalised communities, and served as Head of Community Development at Refuge Worldwide, a community radio station and fundraising platform. This community-centred work, alongside her practice as a broadcaster and lifelong record collector, has shaped a perspective rooted in exploring music scenes and the cultural narratives behind them. Her work celebrates themes of migration, identity, and belonging - and the many ways these stories are expressed and shared through sound.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-02-25T20:00:00+00:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"LYLO - Hush\",\"redirect_url\":\"https://open.spotify.com/track/05d2ijddJZZNd4OflJrgW2\",\"artist\":\"LYLO\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9cba8c7581f8ca1c03d50e073242397a4397d07c?cid=921526