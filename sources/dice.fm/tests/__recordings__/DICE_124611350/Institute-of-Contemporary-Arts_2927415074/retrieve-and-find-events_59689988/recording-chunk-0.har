unt\":1133,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69664267ba3b420001bb97ba\",\"name\":\"Capitol K\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"nvkepq-capitol-k-15th-apr-sjq-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/1c41b3b8-3f23-45f0-8332-f978c25fa665.jpg?rect=1%2C0%2C10924%2C10924\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/1c41b3b8-3f23-45f0-8332-f978c25fa665.jpg?rect=0%2C2185%2C10925%2C6555\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/1c41b3b8-3f23-45f0-8332-f978c25fa665.jpg?rect=2459%2C0%2C6008%2C10924\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Capitol K is the alias of Kristian Craig Robinson, known for his eclectic and exploratory approach to sound. Since the late 1990s, Capitol K has continually reinvented his music, moving fluidly across various sonic landscapes. A recurring theme throughout his work is psycho-geographic audio wandering, where environments, both real and imagined, influence his compositions.\\n\\nCapitol K’s early releases on Planet Mu and XL Recordings positioned him as a key figure in the pre-internet underground electronica scene, blending tape loops and sampling with more traditional instrumentation. As his sound evolved, so did his creative pursuits, which include starting his own label, Faith & Industry. Over the years, he’s become a key mentor in the independent music community, founding recording spaces in squats and temporary venues in East London. This culminated in the celebrated Total Refreshment Centre, where he spent the last decade nurturing emerging artists and engineering seminal albums.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"uni