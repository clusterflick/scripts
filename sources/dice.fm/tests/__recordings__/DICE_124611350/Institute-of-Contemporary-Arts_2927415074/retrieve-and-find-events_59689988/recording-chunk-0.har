36541c\",\"name\":\"Luton\",\"location\":{\"lat\":51.879768,\"lng\":-0.415161,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-bear-club-xeqgl\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-01/58be7d72-a09f-4bd7-8a68-3eec9c93b558.jpg?rect=1040%2C0%2C4160%2C4160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-01/58be7d72-a09f-4bd7-8a68-3eec9c93b558.jpg?rect=0%2C208%2C6240%2C3744\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-01/58be7d72-a09f-4bd7-8a68-3eec9c93b558.jpg?rect=1976%2C0%2C2288%2C4160\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ufc5c83753a1?dice_id=Ufc5c83753a1\",\"post_competition_referral\":\"https://link.dice.fm/k2a894a67556?dice_id=k2a894a67556\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P3f8127a073b?dice_id=P3f8127a073b\",\"post_purchase_referral\":\"https://link.dice.fm/lebc55819e96?dice_id=lebc55819e96\",\"post_reminder_referral\":\"https://link.dice.fm/i3f5b231b2c2?dice_id=i3f5b231b2c2\",\"post_waitinglist_referral\":\"https://link.dice.fm/lc33b93e8e9c?dice_id=lc33b93e8e9c\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:32\",\"properties\":[],\"presented_by\":\"Presented by The Bear Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767227400,\"id\":\"6957c3ce224fbb0001e10628\",\"name\":\"Hanging Stars\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Hanging Stars are guitarist/vocalist Richard Olson, drummer Paulie Cobra, guitarist/keyboardist Patrick Ralla and bassist Paul Milne. They have been making total waves in the cosmic country world ever since they burst on to the London scene with their unique blend of sun-dappled west coast Americana and distinctly British folksy psychedelia - all shimmering twelve string guitars, twangy telecasters and four part vocal harmonies. They played an awesome set at The Bear Club in November 2023 and we’re thrilled to have them back.\\n\\nThey picked up the coveted Bob Harris Emerging Artist Award at the AMAUK awards, crossed the Atlantic to play to a packed room at Third Man’s Blue Room, with owner Jack White approvingly looking on, in Nashville and in 2025 they produced a widely-acclaimed collaboration with Canadian folk maven Bonnie Dobson (famed in the 1960s as the writer of folk antin-nuclear anthem Morning Dew).\\n\\nThe future is looking bright for The Hanging Stars.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"134966\",\"name\":\"The Bear Club\",\"image\":{\"url\":null},\"perm_name\":\"the-bear-club-9l7y6\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4900},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-24T17:00:00+00:00\",\"sale_end_date\":\"2026-03-07T21:00:00+00:00\",\"sale_start_date\":\"2025-12-24T17:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvklb3-agir-jiyan-7th-mar-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Agire Jiyan - Helin\",\"redirect_url\":\"https://open.spotify.com/track/1KdBjQlC9nVsQd4hrXEWTP\",\"artist\":\"Agire Jiyan\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f189a0c82de2cf4449fbd61cd5ee495f0083c358?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Helin\"},{\"type\":\"apple_music\",\"title\":\"Agire Jiyan - Helin\",\"redirect_url\":\"https://music.apple.com/us/album/helin/652482358?i=652482663&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Agire Jiyan\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/50/12/7e/50127eaf-d4fa-0bbe-6535-fa7c27a84c30/mzaf_3528854817967359321.plus.aac.p.m4a\",\"track_name\":\"Helin\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Agirê Jiyan\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9a1382920d51dac6ec9fdb52\"},\"artist_id\":\"131770\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/ef771c70-6003-452c-a337-f1afdc10c404.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/ef771c70-6003-452c-a337-f1afdc10c404.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/ef771c70-6003-452c-a337-f1afdc10c404.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/B8e0f4a46283?dice_id=B8e0f4a46283\",\"post_competition_referral\":\"https://link.dice.fm/z02f09d680ff?dice_id=z02f09d680ff\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/tbf40fe1b6c6?dice_id=tbf40fe1b6c6\",\"post_purchase_referral\":\"https://link.dice.fm/Xdea1fabff21?dice_id=Xdea1fabff21\",\"post_reminder_referral\":\"https://link.dice.fm/H1d875afd24e?dice_id=H1d875afd24e\",\"post_waitinglist_referral\":\"https://link.dice.fm/hc8de63c2231?dice_id=hc8de63c2231\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:33\",\"properties\":[],\"presented_by\":\"Presented by CEFTUS (Centre For Turkey Studies).\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766595600,\"id\":\"694a9a54739dc20001e0278a\",\"name\":\"Agirê Jiyan\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Agirê Jiyan are one of the most respected and influential Kurdish bands of their generation, known for their powerful fusion of traditional Kurdish music with contemporary arrangements and deeply resonant lyrics rooted in identity, resistance, and hope.\\n\\nTheir upcoming concert in London represents a historic milestone: Agirê Jiyan’s first-ever performance in the UK since reuniting. This special night will not only celebrate their reunion but also reaffirm their enduring place in Kurdish music and culture, offering audiences an unforgettable evening of passion, nostalgia, and renewed creative energy.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event. Customers thought to be under 16 might be asked to prove their age and if they are not able to show valid ID, they may be refused entry. Valid ID includes passports, driving licences, 16+ Zip Oyster Photocard and citizen cards.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6150},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-23T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T17:00:00+00:00\",\"sale_start_date\":\"2025-12-23T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"dk3geq-chico-qatoshi-7th-mar-229-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":66139,\"title\":\"Venue Restoration Levy\",\"body\":\"The restoration levy is £1.20 for 229.\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-23/d500ffcc-f139-439e-a12e-366e3cbbd106.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-23/d500ffcc-f139-439e-a12e-366e3cbbd106.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-23/d500ffcc-f139-439e-a12e-366e3cbbd106.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/j82b9baff2b3?dice_id=j