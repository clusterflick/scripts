links\":{\"event_share\":\"https://link.dice.fm/Pe94b6f348d3?dice_id=Pe94b6f348d3\",\"post_competition_referral\":\"https://link.dice.fm/Y7a1033b35ca?dice_id=Y7a1033b35ca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f5e050df440e?dice_id=f5e050df440e\",\"post_purchase_referral\":\"https://link.dice.fm/Z50650252c84?dice_id=Z50650252c84\",\"post_reminder_referral\":\"https://link.dice.fm/C46b327deb80?dice_id=C46b327deb80\",\"post_waitinglist_referral\":\"https://link.dice.fm/E6589adee374?dice_id=E6589adee374\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Transatlantic Ensemble return to Islington for January 2027, after back-to-back astounding shows here in 2026 & multiple sell outs at the Edinburgh Fringe Festival and across the UK. They'll be performing Fleetwood Mac's iconic Rumours album in its entirety, plus loads of other well-known F Mac classics.\\n\\nExperience one of the greatest albums of all time, lovingly and accurately recreated live, by this stunning ensemble of gifted young musicians and classically trained vocalists. Respectful, electrifying & refreshingly gimmick free, the Transatlantic Ensemble are as close to seeing a young Fleetwood Mac in their absolute prime as it’s possible to get.\\n\\nThere is just something so evocative about the Rumours album – something that strikes a chord with every true music fan. It has soundtracked the lives of multiple generations.\\n\\nAsk anyone and believe what you hear... if you're a fan of this iconic album, this stunning performance by this incredible ensemble is quite simply something you cannot afford to miss.\\n\\nBe sure to bring your singing voice and prepare to be amazed, as this band are quite simply phenomenal!\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1801162800,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2027-01-28T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":12,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f388