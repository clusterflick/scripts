ost_competition_referral\":\"https://link.dice.fm/Bd83f6e45003?dice_id=Bd83f6e45003\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/sce799f43a55?dice_id=sce799f43a55\",\"post_purchase_referral\":\"https://link.dice.fm/N7efc00b26cd?dice_id=N7efc00b26cd\",\"post_reminder_referral\":\"https://link.dice.fm/wa41fabe4f92?dice_id=wa41fabe4f92\",\"post_waitinglist_referral\":\"https://link.dice.fm/G9780a91a7e1?dice_id=G9780a91a7e1\"},\"previews\":[],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[\"selling_fast\"],\"presented_by\":\"Presented by BLACK FROG\",\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1778781600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:97\",\"about\":{\"description\":\"That’s right; the legend who is John B Sparks, bass player and founding member of Dr Feelgood, is coming out to play! Sparko is taking a trip down memory lane and his new band Going Back Home will be playing Rhythm & Blues just like the old days.\\n\\nBass guitar - John B Sparks. Sparko played bass on all the classic Dr Feelgood recordings. What more is there to say other than there’s nowhere else on the planet to see an original member of Dr Feelgood doing it right.\\n\\nDrums and backing vocals - Matt Hector. Matt has become widely known for his hard-hitting groove and stylistic adaptability. He has worked with Iggy Pop, Razorlight, Thomas Dolby, Thom Yorke, Marc Almond, KT Tunstell, Glen Matlock, Sharon Corr, Mike Garson, Henry Rollins, Gutterdammerung, and Grace Jones.\\n\\nGuitar and vocals - John Simpson. John has been a gigging musician since 1975. In 2013 he formed The Feelgood Band, playing regularly until 2022. During that period he appeared on stage with Wilko Johnson, Sparko, Big Figure, Lew Lewis and Dennis Greaves (Nine Below Zero).\\n\\nDon’t miss an evening of tight, old school R&B - Live in The Long Room. Doors 7.30pm. 8.00pm start.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762300800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-05/149fd2a4-a16d-4f52-be88-78d6fc618adf.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-05/149fd2a4-a16d-4f52-be88-78d6fc618adf.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-05/149fd2a4-a16d-4f52-be88-78d6fc618adf.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"690b58f0ff2bad000165c2e0\",\"name\":\"Sparko's Going Back Home\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T00:00:00+00:00\",\"sale_end_date\":\"2026-05-14T19:30:00+01:00\",\"sale_start_date\":\"2025-11-05T00:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:00:00+01:00\",\"event_end_date\":\"2026-05-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"pypd88-sparkos-going-back-home-14th-may-hot-box-chelmsford-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3354},\"max_tickets\":8,\"social_links\":{\"event_share\":\"https://link.dice.fm/Gaddaf3619aa?dice_id=Gaddaf3619aa\",\"post_competition_referral\":\"https://link.dice.fm/ndb54011134e?dice_id=ndb54011134e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qadd329003a2?dice_id=Qadd329003a2\",\"post_purchase_referral\":\"https://link.dice.fm/y3119960c1b1?dice_id=y3119960c1b1\",\"post_reminder_referral\":\"https://link.dice.fm/sb8427407f0e?dice_id=sb8427407f0e\",\"post_waitinglist_referral\":\"https://link.dice.fm/S526bb330d53?dice_id=S526bb330d53\"},\"previews\":[],\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by DHP Family.\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1778781600,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:98\",\"about\":{\"description\":\"Matteo Mancuso approached the world of music at an early age, thanks to his father Vincenzo. He enrolled in a musical high school where he deepened his studies in classical guitar and founded the trio “SNIPS.”\\n\\nIn 2019, he began a collaboration with Yamaha Guitars, participating in the NAMM Show in Los Angeles, the “Young Guitar Festival” in Bangkok, and several masterclasses in Russia.\\n\\nIn 2020, Matteo formed his new trio with Stefano India on bass and Giuseppe Bruno on drums, and began dedicating space to his compositional vein by presenting his first original tracks. This marked the beginning of his first intense live activity in Italy and Europe.\\n\\nIn 2023, his first solo album, titled “The Journey,” was released. This work outlines his authentic, polyhedric musical nature and kicks off a new cycle of concerts. In 2025, he will embark on his first major international tour, which will continue into 2026.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"seating\":null,\"announcement_date_unix\":1762336800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Matteo Mancuso\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb65a73f0fd71fdade66d46808\"},\"artist_id\":\"63472\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-04/1dd983f0-5db1-4958-8a70-7618464bf8ef.jpg?rect=309%2C0%2C1285%2C1285\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-04/1dd983f0-5db1-4958-8a70-7618464bf8ef.jpg?rect=0%2C72%2C1902%2C1141\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-04/1dd983f0-5db1-4958-8a70-7618464bf8ef.jpg?rect=598%2C0%2C707%2C1285\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"690a0cba1c9e6900018a7a49\",\"name\":\"Matteo Mancuso - ROUTE 96\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T10:00:00+00:00\",\"sale_end_date\":\"2026-05-14T21:00:00+01:00\",\"sale_start_date\":\"2025-11-07T10:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:00:00+01:00\",\"event_end_date\":\"2026-05-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"av7p57-matteo-mancuso-route-96-14th-may-islington-assembly-hall-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null}],\"title\":\"Thu 14 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
