Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"date_unix\":1777053600,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:51\",\"about\":{\"description\":\"Atlanta rapper Hunxho returns to the UK following the success of his debut sold out show in London last year.\\n\\nRaised in East Atlanta, Hunxho has built a reputation as a modern street poet, blending raw emotion with melodic flows. From his 2017 self release HUNXHOSEASON to Billboard charting records like ‘Your Friends’, Hunxho delivers authenticity through his storytelling. Along the way, he’s collaborated with the likes of Lil Yachty, 21 Savage and Lil Durk and has become one of the most exciting artists in the scene, gaining him a worldwide following.\\n\\nHunxho ended 2025 with a bang, dropping the highly anticipated album ‘For Her 2' - with standout tracks like ‘Intimate Relationships’, ‘DAMN’ and ‘If Only (ft. 21 Savage)’.\\n\\nHe’s made his mark in the industry and is here to stay - an artist like this is not to be missed!\\n\\nSee you there.\\n\\nSeating is reserved for this event and you will be automatically assigned the best available seats within your chosen area. Seat details are available immediately after purchase. Please follow the link in your confirmation email if you wish to change your seats. For any queries please contact help@dice.fm. Please note we cannot guarantee that seated tickets offered via the Waiting List will be located together.\\n\\nTickets include a £2.25 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"4bbfad3b-a4b9-4e75-9b76-b2ec3de72de5\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1769158800,\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hunxho\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebba200b8017c47812f045e85d\"},\"artist_id\":\"132669\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/4effe022-55fa-47c2-ae32-20cde4705504.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dic