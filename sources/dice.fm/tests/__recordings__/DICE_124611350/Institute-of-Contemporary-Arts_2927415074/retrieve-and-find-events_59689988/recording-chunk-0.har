"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/869150b7-718a-4c18-8095-396420c26741.jpg?rect=0%2C11%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/869150b7-718a-4c18-8095-396420c26741.jpg?rect=0%2C164%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/869150b7-718a-4c18-8095-396420c26741.jpg?rect=167%2C0%2C434%2C789\"},\"id\":\"695bddc5da28950001026d54\",\"name\":\"Resonance Fundraiser - London Ear & Hard Drive \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The London Ear and Hard Drive present a benefit for Resonance at The Horse Hospital.\\n\\nFeaturing: Borough Council, Anthony Moore’s Exquisite Corps, Shirley Crowe, Al Strachan + Otti Albietz.\\n\\nBorough Council convene a meeting that’s more like a happening, Slapp Happy founding father turned Drag City solo star Anthony Moore unveils his Exquisite Corps, Shirley Crowe makes her London debut with Jo Ackerley running interference, and improvising human machines Al Strachan and Otti Albietz push back the boundaries of how far inside the moment it’s possible to be.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-02T15:00:00+00:00\",\"sale_end_date\":\"2026-02-25T18:00:00+00:00\",\"sale_start_date\":\"2026-01-05T15:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Borough Council - Casino\",\"redirect_url\":\"https://open.spotify.com/track/6ClLZM12itEFkx1J5x8Cy3\",\"artist\":\"Borough Council\",\"preview_ur