l\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2440,\"name\":\"The Shacklewell Arms\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"551066515482061\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:19\",\"about\":{\"description\":\"Speed of Sound are delighted to welcome Lefty Parker to the Shacklewell Arms for a very special London headline show on Thursday, 23rd of April as part of his UK/EU tour.\\n\\nLefty Parker is a folk singer known for tender grit and lyrical honesty. Starting in Texas, honed his craft in dive bars, small venues, and the storied rooms of Austin’s music scene. As a teenager, Lefty discovered an old Yamaha guitar that belonged to his father. What began with Beatles covers quickly turned into songwriting. His world changed at nineteen when Devendra Banhart invited him onstage mid-show to perform one of his first songs. He worked as a sound engineer at Austin’s famed Cactus Cafe, where he met local artists and began performing. In 2025, Lefty released Ark which was produced by Buck Meek. Ark features contributions from all current members of Big Thief, plus Mat Davidson of Twain. Lefty’s music is inspired by artists like Townes Van Zandt, Leonard Cohen, and Karen Dalton, and his songs often arrive uninvited, like lightning or prayer. His performances are intimate, raw, and grounding. Now back in New York, Lefty continues to record, write, and tour, with a new album in the works.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769940000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lefty Parker\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-09/aadf362c-d1f3-482f-9d81-98a19892cfad.jpg?rect=1%2C0%2C638%2C638\"},\"artist_id\":\"83074\",\"about\":null,\"is_headliner\":false},{\"name\":\"Perfect Binding\",\"image\":null,\"artist_id\":\"123615\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/0ef31971-190e-4871-b441-30fa146a99b0.jpg?rect=0%2C216%2C848%2C848\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/0ef31971-190e-4871-b441-30fa146a99b0.jpg?rect=0%2C386%2C848%2C509\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/0ef31971-190e-4871-b441-30fa146a99b0.jpg?rect=72%2C0%2C704%2C1280\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"696fc5f66b08a40001be3ddf\",\"name\":\"Lefty Parker + The Horse + Perfect Binding \",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-01T10:00:00+00:00\",\"sale_end_date\":\"2026-04-23T18:00:00+01:00\",\"sale_start_date\":\"2026-02-01T10:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"53778l-lefty-parker-the-horse-perfect-binding-23rd-ap