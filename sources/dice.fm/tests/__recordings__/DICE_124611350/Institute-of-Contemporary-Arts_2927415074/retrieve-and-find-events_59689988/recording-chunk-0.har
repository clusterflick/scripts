:\"dk8mav-grimm-grimm-19th-mar-rich-mix-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773948600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/f01bc823-4fc6-4dc3-87c3-cc16a6335774.jpg?rect=326%2C0%2C1397%2C1397\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/f01bc823-4fc6-4dc3-87c3-cc16a6335774.jpg?rect=0%2C84%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/f01bc823-4fc6-4dc3-87c3-cc16a6335774.jpg?rect=640%2C0%2C768%2C1397\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/ncc2f5d164d9?dice_id=ncc2f5d164d9\",\"post_competition_referral\":\"https://link.dice.fm/acec10be5606?dice_id=acec10be5606\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b216fcec3cc8?dice_id=b216fcec3cc8\",\"post_purchase_referral\":\"https://link.dice.fm/q508f031c869?dice_id=q508f031c869\",\"post_waitinglist_referral\":\"https://link.dice.fm/k862fb30c3e6?dice_id=k862fb30c3e6\",\"post_reminder_referral\":\"https://link.dice.fm/c2e89b093180?dice_id=c2e89b093180\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"111\",\"name\":\"Rich Mix\",\"address\":\"35-47 Bethnal Green Rd, London E1 6LA\",\"location\":{\"lat\":51.5243489,\"lng\":-0.0732477000000245},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rich-mix-4w2r\",\"accessibility\":{\"url\":\"https://www.richmix.org.uk/plan-your-visit/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nGrimm Grimm at Rich Mix\\n\\nGrimm Grimm is the musical project of London-based composer, recording artist, and producer Koichi Yamanoha, originally from West Tokyo, Japan. His music blends experimental pop elements with futuristic lyricism, weaving music box-like, timeless melodies with ethereal soundscapes and electric textures.\\n\\nThroughout his releases, Yamanoha has explored subtle shifts in style. He incorporates contemporary production while drawing inspiration from baroque folk and 18th-century English \\\"infinite canons\\\"—compositional forms built on repetition and cyclical structures. His melodies, often left hanging at the ends of songs, echo like nursery rhymes—prayer-like motifs that invite listeners into a meditative, trance-like state.\\n\\nGrimm Grimm’s music was recently featured in Death Stranding 2: On the Beach for PlayStation 5 —the sequel to the critically acclaimed cult science fiction gam. Yamanoha also makes a cameo appearance in the game.\\n\\nHe has collaborated with a diverse range of artists, producers, and labels—including ATP Recordings, Café Oto, Josephine Foster, Laetitia Sadier, Marta Salogni, Kevin Shields, Klein and Hideo Kojima—through which his work has become firmly rooted in the experimental and avant garde music scenes, as well as in the worlds of film and video game soundtracks.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:23\",\"billing_promoter\":{\"id\":\"12032\",\"name\":\"Rich Mix\",\"image\":{\"url\":null},\"perm_name\":\"rich-mix-n5pq\",\"profile_active\":false},\"presented_by\":\"Baba Yaga's Hut\",\"properties\"