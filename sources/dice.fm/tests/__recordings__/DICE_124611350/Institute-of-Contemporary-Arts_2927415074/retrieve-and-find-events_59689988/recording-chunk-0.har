0%2C2000\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770163200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T00:00:00+00:00\",\"sale_end_date\":\"2026-02-20T19:00:00+00:00\",\"sale_start_date\":\"2026-02-06T00:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by LVLS London & The Engine Rooms.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/u38f0f611292?dice_id=u38f0f611292\",\"post_competition_referral\":\"https://link.dice.fm/h56f8aaa2b21?dice_id=h56f8aaa2b21\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W97d0ffe29f5?dice_id=W97d0ffe29f5\",\"post_purchase_referral\":\"https://link.dice.fm/tcbb7ffa527d?dice_id=tcbb7ffa527d\",\"post_reminder_referral\":\"https://link.dice.fm/gb94b5c605ee?dice_id=gb94b5c605ee\",\"post_waitinglist_referral\":\"https://link.dice.fm/r56d45d9a208?dice_id=r56d45d9a208\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"LVLS hosts a night of pure intensity on Friday 20th February, featuring four acts spanning melodic post-hardcore, nu-metal, emo, and experimental electronic in East London.\\n\\nOpening the night, **Psychiceyeclix** brings a heavy, circuit-bent electronic set. Known for performing all over the world, this London-based artist fuses glitch, distortion, and beat-driven chaos into something both visceral and mechanical, immediately grabbing attention.\\n\\n**In Her Eyes** follow with an emotionally charged emo set from South London, blending raw energy with heartfelt hooks. Their performance balances melody and grit, giving the room a moment of tension and release before the heavier acts hit.\\n\\nNext, **ACORAH** unleash a hybrid of nu-metal, post-hardcore, and experimental aggression from Essex. Thick riffs, heavy grooves, and unexpected shifts make their set unpredictable and crushing, priming the crowd for the headline.\\n\\nHeadlining, **Keep This Up** deliver high-energy, melodic post-hardcore that moves fast and hits hard. Tight riffs, driving rhythms, and explosive vocals dominate the stage, ensuring the night closes on a peak of intensity and adrenaline.\\n\\nGet your tickets now!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"14077\",\"name\":\"LVLS\",\"address\":\"3 Succession Walk, Tower Hamlets, London, E3 2RX, United Kingdom\",\"location\":{\"lat\":51.54048,\"lng\":-0.02084},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-21/ad72e6a5-12a2-4237-a9ca-943cef71211f.jpg?rect=0%2C0%2C192%2C192\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"lvls-g5oe6\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":\"2026-02-20T23:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"