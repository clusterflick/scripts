g Reggae classics, Lovers Rock gems, and Dancehall vibes. This event is crafted for the grown and stylish crowd who appreciate authentic music, good energy, and unforgettable moments. Expect an atmosphere filled with rhythm, culture, and pure Lovers Rock magic.\\n\\n🎧 Music Policy\\n\\nOur DJs will be spinning the very best of Lovers Rock, Reggae classics, and Dancehall blending timeless tracks from the golden era with fresh new school selections to keep the dance floor alive all night long.\\n\\n💌 Table Reservations: loversrockuk1@gmail.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-01-20T10:00:00+00:00\",\"sale_end_date\":\"2026-04-04T23:00:00+01:00\",\"sale_start_date\":\"2025-09-17T12:30:00+01:00\",\"event_start_date\":\"2026-04-04T22:30:00+01:00\",\"event_end_date\":\"2026-04-05T04:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://music.apple.com/us/album/here-i-come/309122317?i=309122381&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/9b/df/c2/9bdfc21c-1bc2-08eb-7aa2-913bbedbaffc/mzaf_11117592686509478017.plus.aac.p.m4a\",\"track_name\":\"Here I Come\"},{\"type\":\"spotify\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://open.spotify.com/track/0LSHXCQswjJre98L53YrOH\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a6eab2cfaedb80e809496819dff1928332c442b2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Here I Come\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 04 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\