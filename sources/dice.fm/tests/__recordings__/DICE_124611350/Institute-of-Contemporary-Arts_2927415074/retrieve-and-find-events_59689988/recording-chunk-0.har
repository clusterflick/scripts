c6a726\"},\"artist_id\":\"18682\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ego Ella May\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-19/2149c4a6-5a31-4f2c-ab0c-2431ac5f5875.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"6951\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764927000,\"faqs\":[{\"id\":61948,\"title\":\"Accessibility Information\",\"body\":\"To purchase accessible tickets, contact Southbank Centre on 020 3879 9555\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3720},\"has_multiple_ticket_types\":true,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"b2ff0708-7a37-4d87-89d6-c508152561e2\",\"seats_io_public_key\":\"987893cf-bc40-4a74-8eee-5de2ce676631\",\"seat_selection\":\"enabled\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Tara Lily & Theo Croker - 6 Feet Down\",\"redirect_url\":\"https://music.apple.com/us/album/6-feet-down/1719843036?i=1719843040&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Tara Lily & Theo Croker\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/fb/26/5f/fb265fcb-3d98-ba81-3f6b-b443e30a38fc/mzaf_3107200908900922970.plus.aac.p.m4a\",\"track_name\":\"6 Feet Down\"},{\"type\":\"spotify\",\"title\":\"Tara Lily - 6 Feet Down\",\"redirect_url\":\"https://open.spotify.com/track/4SPSgPUa4PphdcbE7TFaei\",\"artist\":\"Tara Lily\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a17fa223788775c3cc676caa62a2e18ce32426c8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"6 Feet Down\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T10:30:00+00:00\",\"sale_end_date\":\"2026-03-13T16:00:00+00:00\",\"sale_start_date\":\"2025-12-08T10:30:00+00:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by JOY.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/R9ff8e6b3504?dice_id=R9ff8e6b3504\",\"post_competition_referral\":\"https://link.dice.fm/L86069139313?dice_id=L86069139313\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/xe79df3a3763?dice_id=xe79df3a3763\",\"post_purchase_referral\":\"https://link.dice.fm/m9b95a31aee7?dice_id=m9b95a31aee7\",\"post_reminder_referral\":\"https://link.dice.fm/keaae7a9a16b?dice_id=keaae7a9a16b\",\"post_waitinglist_referral\":\"https://link.dice.fm/H74e3ed41c43?dice_id=H74e3ed41c43\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Passion Mango is Connor Wilkinson. Hailing from the rainy city of Vancouver, BC, Passion Mango’s sensitive, distinctly West Coast style reflects their Pacific Northwest hometown. Passion Mango’s sound finds influence from many genres (including grunge, shoegaze, punk, folk, hip-hop, etc.) but is mainly rooted in indie and alternative rock. Touching on themes of grief, addiction, mental health, disillusionment, and the optimistic hope of love, Connor's songwriting is not afraid to make you cry with one song and then get up and dance on the next track.\\n\\nAfter viral tiktok success on their single 'boy', Passion Mango has since amassed a dedicated global fanbase, with over 30 million streams on Spotify alone. The band is set to tour Europe in March 2026 in support of their album 'Clean Slate'\\n\\nFFO: Peach Pit, Current Joys, Title Fight, King Krule\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 18s to be accompanied by a responsible adult)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1595,\"name\":\"JOY.\",\"privacy_policy_link\":\"https://www.joyconcerts.com/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773428400,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:15\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1674\",\"name\":\"JOY.\",\"image\":{\"url\":null},\"perm_name\":\"joy-bv9o\",\"profile_active\":false},\"id\":\"693050190ac85a0001223925\",\"name\":\"Passion Mango\",\"perm_name\":\"nvw8m8-passion-mango-13th-mar-the-grace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/630798ca-165d-4a82-8c55-86deedbdd573.jpg?rect=0%2C911%2C2736%2C2736\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/630798ca-165d-4a82-8c55-86deedbdd573.jpg?rect=0%2C1035%2C2736%2C1642\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/630798ca-165d-4a82-8c55-86deedbdd573.jpg?rect=348%2C0%2C2041%2C3711\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Passion Mango\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3e16fd7d41b1e6e6d8a23fe6\"},\"artist_id\":\"106754\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765189800,\"faqs\":[{\"id\":61260,\"title\":\"Is Rough Trade Bristol wheelchair accessible?\",\"body\":\"Our venue is fully wheelchair accessible with step free access, although some assistance would be required to enter and exit the venue which is through 2 sets of double fire doors in the bar area. You can add an accessibility ticket onto your original ticket by going to dice.fm/contact.\\n\\nWe will always strive to ensure our venue is accessible as possible, so if you have further questions or requests please do not hesitate to contact us.\",\"order\":0},{\"id\":61261,\"title\":\"Is accessible seating available?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":1},{\"id\":61262,\"title\":\"How do I get a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":2},{\"id\":61263,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release. There is an hour between the door time and the stage time.\",\"order\":3},{\"id\":61264,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":4},{\"id\":61265,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":5},{\"id\":61266,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":6},{\"id\":61267,\"title\":\"I can’t attend the show! Can I still get my record signed?\",\"body\":\"Yes! We will always aim to get all event orders signed. Although this sometimes depends on the artist's schedule. We keep event stock for 1 week before returning it to our warehouse. If you can’t pick it up within a week please contact the store of your event.\",\"order\":7},{\"id\":61268,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":8},{\"id\":61269,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":9},{\"id\":61270,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":10}],\"price\":{\"currency\":\"GBP\",\"amount\":1540,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Passion Mango - Again\",\"redirect_url\":\"https://music.apple.com/us/album/again/1804726727?i=1804726729&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Passion Mango\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/f2/df/0a/f2df0a59-c077-8548-058c-b2202559b904/mzaf_13444522082805196893.plus.aac.p.m4a\",\"track_name\":\"Again\"},{\"type\":\"spotify\",\"title\":\"Passion Mango - Again\",\"redirect_url\":\"https://open.spotify.com/track/33335V1yPusjYZ4uU4DpuO\",\"artist\":\"Passion Mango\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9c8da4d09f1dfb4c70e5d43e852b24776529fb8f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Again\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T17:00:00+00:00\",\"sale_end_date\":\"2026-03-13T19:00:00+00:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Live Nation\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/b20789ff157b?dice_id=b20789ff157b\",\"post_competition_referral\":\"https://link.dice.fm/Vc67b5c6d52d?dice_id=Vc67b5c6d52d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qa0e3b10f26e?dice_id=Qa0e3b10f26e\",\"post_purchase_referral\":\"https://link.dice.fm/s9df626f4119?dice_id=s9df626f4119\",\"post_reminder_referral\":\"https://link.dice.fm/te3b6b600e06?dice_id=te3b6b600e06\",\"post_waitinglist_referral\":