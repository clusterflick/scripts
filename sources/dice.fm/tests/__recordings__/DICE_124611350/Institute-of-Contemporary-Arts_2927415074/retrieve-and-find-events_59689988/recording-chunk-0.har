otify.com/track/6noajkkuZkla4d8E6sYUiY\",\"artist\":\"The Egyptian Lover\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e4aaaf3d8d6cad43b4853cab188385662aff64be?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Egypt Egypt\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T09:30:00+00:00\",\"sale_end_date\":\"2026-03-12T06:00:00+00:00\",\"sale_start_date\":\"2025-12-05T09:30:00+00:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Southbank Centre.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"b2ff0708-7a37-4d87-89d6-c508152561e2\",\"social_links\":{\"event_share\":\"https://link.dice.fm/eb6bc5e4d80d?dice_id=eb6bc5e4d80d\",\"post_competition_referral\":\"https://link.dice.fm/hd6d56eff2dc?dice_id=hd6d56eff2dc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Hdd537f97b49?dice_id=Hdd537f97b49\",\"post_purchase_referral\":\"https://link.dice.fm/L53de2db1674?dice_id=L53de2db1674\",\"post_reminder_referral\":\"https://link.dice.fm/U6a7720b5cf8?dice_id=U6a7720b5cf8\",\"post_waitinglist_referral\":\"https://link.dice.fm/b1c132eea59f?dice_id=b1c132eea59f\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The trumpeter, composer, producer and bandleader marks the 100th anniversary and legacy of Miles Davis with a selection of tunes and special guests.\\n\\nAward-winning singer-songwriter Ego Ella May and two-time Grammy Award-winning saxophonist Gary Bartz join Croker.\\n\\nIf you were to create a mixtape of Miles Davis tunes, what would you put on there? Be moved and surprised by old favourites and deep cuts played in new, unexpected ways, as Croker reinterprets some of the key pieces that have influenced him over the years.\\n\\nTheo Croker is known for pushing the boundaries of jazz, neo-soul and hip-hop, crafting a sound that defies traditional genre classifications. At live performances, his trumpet acts as both a melodic voice and a textural force, seamlessly woven into a production landscape rich with samples, synths and sound design.\\n\\nElla May’s genre-defying sound and intimate lyricism draws from an expansive palette of literature, introspection and R&B, neo soul, contemporary jazz and poetic song writing. She won Best Jazz Act at the 2020 MOBO Awards and Best Vocalist at the 2021 Jazz FM Awards.\\n\\nBartz, named a 2024 Jazz Master by the National Endowment for the Arts, is a prolific recording artist with more than 45 solo albums to his name – and over 200 as a guest artist. Bartz performed with Davis’ band at the legendary 1970 Isle of Wight Festival.\\n\\n*The ticket price includes a £2 venue restoration levy.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":\"987893cf-bc40-4a74-8eee-5de2ce676631\",\"marketeers\":[{\"id\":228,\"name\":\"Southbank Centre\",\"privacy_policy_link\":\"https://www.southbankcentre.co.uk/policies/privacy\",\"fb_pixel_id\":\"1145741552151564\",\"ga_tracking_id\":\"UA-86802192-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773428400,\"venues\":[{\"id\":\"1847\",\"name\":\"Royal Festival Hall - Southbank Centre\",\"address\":\"Southbank Centre, Belvedere Rd, Lambeth, London SE1 8XX, UK\",\"location\":{\"lat\":51.506921,\"lng\":-0.1161019999999