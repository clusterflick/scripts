"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-25T21:00:00+01:00\",\"doors_close_date\":\"2026-04-26T02:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mozey\",\"image\":null,\"artist_id\":\"32482\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"faqs\":[{\"id\":58733,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":58734,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/c5c79252-6cdf-48f7-be92-f7255957dea7.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/c5c79252-6cdf-48f7-be92-f7255957dea7.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/c5c79252-6cdf-48f7-be92-f7255957dea7.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763575200,\"max_tickets\":6,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**VENUE PRESALE - THURS 27TH NOV @ 10AM**\\n\\n**GEN SALE - FRI 28TH NOV @ 10AM**\\n\\nOn Saturday April 25th 2026, Mozey breaks orbit and launches his boldest project so far. Cowboys In Space touches down at Troxy, London, marking his largest and most creatively charged headline show to date.\\n\\nKnown for his high-energy performances and off-the-wall concepts, Mozey now takes things into a different dimension. A giant cowboy-hat spaceship will hover above the crowd, lasers firing, as he delivers an extended headline set packed with the sound and personality that have made him one of drum and bass’s most exciting names.\\n\\nA new world. A new concept. A new era for Mozey.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Louder.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:15\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Nbd758f31700?dice_id=Nbd758f31700\",\"post_competition_referral\":\"https://link.dice.fm/f9c672cef81a?dice_id=f9c672cef81a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Bd078a3f70d0?dice_id=Bd078a3f70d0\",\"post_purchase_referral\":\"https://link.dice.fm/o9ccabe15747?dice_id=o9ccabe15747\",\"post_reminder_referral\":\"https://link.dice.fm/L8808428f635?dice_id=L8808428f635\",\"post_waitinglist_refe