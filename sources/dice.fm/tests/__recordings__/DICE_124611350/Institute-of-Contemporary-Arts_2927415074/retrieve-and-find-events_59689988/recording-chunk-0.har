n for everything jazz, funk, soul and hip-hop. Immerse yourself in a diverse lineup of heritage legends, current icons, and new artists we know you’ll love. Grab your one-way ticket to London’s best day festival.\\n\\nThis is an all ages event - please refer to the Terms and Conditions for additional information.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1779620400,\"venues\":[{\"id\":\"541\",\"name\":\"Brockwell Park\",\"address\":\"Dulwich Rd, London SE24 0PA\",\"location\":{\"lat\":51.4543375,\"lng\":-0.108968000000004},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"brockwell-park-jxgk\",\"accessibility\":{\"url\":\"https://www.brockwell-live.com/access\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-24T12:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:69\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"11045\",\"name\":\"Cross The Tracks\",\"image\":{\"url\":null},\"perm_name\":\"cross-the-tracks-e87d\",\"profile_active\":false},\"id\":\"69131e5f11b2b0000138c4d4\",\"name\":\"Cross The Tracks 2026\",\"perm_name\":\"53xlkk-cross-the-tracks-2026-24th-may-brockwell-park-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/acec0097-7a8d-46e7-a62c-71aaead4fb89.jpg?rect=0%2C0%2C1600%2C1600\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/acec0097-7a8d-46e7-a62c-71aaead4fb89.jpg?rect=0%2C320%2C1600%2C960\",\"portrait\":\"h