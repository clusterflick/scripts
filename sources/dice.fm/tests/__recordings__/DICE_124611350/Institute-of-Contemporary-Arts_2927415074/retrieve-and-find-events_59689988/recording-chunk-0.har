pe/London\",\"announcement_date\":\"2025-12-17T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T06:00:00+00:00\",\"sale_start_date\":\"2025-12-17T00:00:00+00:00\",\"event_start_date\":\"2026-03-13T19:30:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Southbank Centre.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"e79ae24b-e27d-4f36-b3e6-db502fb91453\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Af6ea6f27fa0?dice_id=Af6ea6f27fa0\",\"post_competition_referral\":\"https://link.dice.fm/vdcaa1b10447?dice_id=vdcaa1b10447\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e234e95bdb16?dice_id=e234e95bdb16\",\"post_purchase_referral\":\"https://link.dice.fm/c872c5a56c77?dice_id=c872c5a56c77\",\"post_reminder_referral\":\"https://link.dice.fm/C656fe03a23e?dice_id=C656fe03a23e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Kda90c4f41b1?dice_id=Kda90c4f41b1\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Young jazz vocalist Lucy-Anne Daniels takes the spotlight at this showcase of up-and-coming talent, with pianist Kezia Abuoma supporting.\\n\\nDaniels’ performances are full of emotion and vivid storytelling, as she blends her jazz- and gospel-infused vocals with pedal effects and live looping to create a sound that’s truly her own.\\n\\nAged just 23, she’s already appeared at the Proms and leading jazz clubs in Paris, New York and London. She was the winner of the 2025 Tina May Young Jazz Musician Award, with judges praising her “rhythmic freedom and inventiveness… and irresistible sense of sheer enjoyment”.\\n\\nSupporting Daniels is Kezia Abuoma, the pianist and composer, who is joined tonight by her trio to play her own music, along with fresh interpretations of jazz classics.\\n\\nAbuoma is an alumna of Tomorrow’s Warriors and although she’s still completing her studies at Trinity Laban, she has already performed her original music at venues including the Jazz Cafe and Ronnie Scott’s.\\n\\nThe organisation Women in Jazz elevates women performers by hosting events and workshops. Its community is made up of 10,500 people, including singer-songwriters, producers, instrumentalists and composers. The Women in Jazz team of creatives direct, produce and execute projects focusing on music, storytelling and real-life experiences.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":\"97a3faa5-6221-44a1-af86-3a7773a7248c\",\"marketeers\":[{\"id\":228,\"name\":\"Southbank Centre\",\"privacy_policy_link\":\"https://www.southbankcentre.co.uk/policies/privacy\",\"fb_pixel_id\":\"1145741552151564\",\"ga_tracking_id\":\"UA-86802192-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773430200,\"venues\":[{\"id\":\"2268\",\"name\":\"Purcell Room - Southbank Centre\",\"address\":\"Belvedere Rd, South Bank, London SE1 8XX, UK\",\"location\":{\"lat\":51.5057881,\"lng\":-0.11675209999998515},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"purcell-room---southbank-centre-d576\",\"accessibility\":{\"url\":\"https://www.southbankcentre.co.uk/visit-us/access/\"},\"profile_active\":false,\"highli