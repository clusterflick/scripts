art_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"wwrpvx-tungz-21st-mar-signature-brew-haggerston-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774119600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-25/09107986-8337-4c25-951a-cd2ab52af8b7.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-25/09107986-8337-4c25-951a-cd2ab52af8b7.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-25/09107986-8337-4c25-951a-cd2ab52af8b7.jpg?rect=450%2C0%2C1100%2C2000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/T99b007fbd5f?dice_id=T99b007fbd5f\",\"post_competition_referral\":\"https://link.dice.fm/i4d521e8f7d4?dice_id=i4d521e8f7d4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lbe3147e41f2?dice_id=lbe3147e41f2\",\"post_purchase_referral\":\"https://link.dice.fm/vce0bb622c54?dice_id=vce0bb622c54\",\"post_waitinglist_referral\":\"https://link.dice.fm/P149c802158e?dice_id=P149c802158e\",\"post_reminder_referral\":\"https://link.dice.fm/g089b7bd1e2f?dice_id=g089b7bd1e2f\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"2427\",\"name\":\"Signature Brew Haggerston\",\"address\":\"340 Acton Mews, London E8 4EA, UK\",\"location\":{\"lat\":51.5368309,\"lng\":-0.07585579999999936},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/a4d49491-4b57-4ec6-9c10-4055162cd091.jpg?rect=589%2C0%2C2354%2C2354\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-haggerston-l3yw\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**Tungz headline performance at Signature Brew Haggerston.**\\n\\nSupport TBA.\\n\\n**Sign up to the Tungz mailing list to unlock early bird tickets while stocks last:** https://bit.ly/tungzmailinglist\\n\\n**Tungz:**\\n\\nBorn out of a basement home studio in Bristol, Tungz are a self-produced synth pop four piece delivering shimmering grooves, funk beats and friendship. Nicky Green, Jamie Maier, Rick Holland and Ollie Horne first came together playing in the melting pot of funk, electronic and genre-hyphenated bands that surrounded them in the Bristol scene. Tungz began their career under the wing of Jamz Supernova and later voyaged M5-wards after their electric live show drew the attention of Manchester’s Heist or Hit who signed them for their debut album.\\n\\nA shift in time and location inspired Tungz to begin work on their second album with Nicky moving from London to Paris at the start of 2024. Tungz have been operating on an aller-retour basis recording in studio sessions in the famous two cities. The songwriting of Green and Maier hits a new energy in this album drawing inspiration from DJ sets, dusty synth plugins, over consumption, near misses, marketing teams, old technologies and books.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:81\",\"billing_