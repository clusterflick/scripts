\":\"https://link.dice.fm/O50601303e54?dice_id=O50601303e54\",\"post_competition_referral\":\"https://link.dice.fm/n5c599f25bdc?dice_id=n5c599f25bdc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W44b0b7de7ed?dice_id=W44b0b7de7ed\",\"post_purchase_referral\":\"https://link.dice.fm/jae675ef7cd9?dice_id=jae675ef7cd9\",\"post_reminder_referral\":\"https://link.dice.fm/M0e9ad7828c0?dice_id=M0e9ad7828c0\",\"post_waitinglist_referral\":\"https://link.dice.fm/za069f517bc8?dice_id=za069f517bc8\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:12\",\"properties\":[],\"presented_by\":\"Presented by Eat Your Own Ears.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1762869600,\"id\":\"6913578311b2b00001157062\",\"name\":\"Andrew Bird and Britten Sinfonia\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Balancing jazz, folk and pop melodies in a display of unique virtuosity, Bird celebrates the 20th anniversary of The Mysterious Production of Eggs alongside a full orchestra conducted by Jacomo Bairos.\\n\\nThe GRAMMY-nominated violinist, songwriter, and multi-instrumentalist returns to Barbican for the first time since 2019 for a complete album performance with lush orchestral textures provided by Britten Sinfonia, closing with a set of fan favorites from his expansive, nearly 30-year catalog.\\n\\nSince 1997, Bird has released 18 albums and performed around the world, headlining legendary venues like Carnegie Hall, the Sydney Opera House, Walt Disney Concert Hall, and Red Rocks Amphitheatre.\\n\\nRenowned for his wide-ranging artistry, from TED Talks to scoring film and television, Andrew Bird’s creative reach extends beyond the stage. In 2025, he celebrates the 20th anniversary of his acclaimed album The Mysterious Production of Eggs with a limited run of concerts, performing the record in its entirety for the first time alongside a full orchestra.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10\",\"name\":\"Eat Your Own Ears\",\"image\":{\"url\":null},\"perm_name\":\"eat-your-own-ears-z82z\",\"profile_active\":true},\"date_unix\":1772308800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1916},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T02:00:00+00:00\",\"sale_end_date\":\"2026-02-28T19:30:00+00:00\",\"sale_start_date\":\"2025-11-11T02:00:00+00:00\",\"event_start_date\":\"2026-02-28T20:30:00+00:00\",\"event_end_date\":\"2026-03-01T00:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"v3bldv-the-stompin-riffraffs-28th-feb-the-100-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Stompin' Riffraffs\",\"image\":null,\"artist_id\":\"130132\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets