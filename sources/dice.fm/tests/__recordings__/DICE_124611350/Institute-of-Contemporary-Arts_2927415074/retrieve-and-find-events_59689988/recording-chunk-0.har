ndon\",\"announcement_date\":\"2026-02-02T10:00:00+00:00\",\"sale_end_date\":\"2026-07-25T21:00:00+01:00\",\"sale_start_date\":\"2026-02-04T10:00:00+00:00\",\"event_start_date\":\"2026-07-25T19:00:00+01:00\",\"event_end_date\":\"2026-07-25T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Gig Cartel.\",\"seating\":null,\"announcement_date_unix\":1770026400,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-25T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:70\",\"date_unix\":1785002400,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4507},\"social_links\":{\"event_share\":\"https://link.dice.fm/N0098c79feb6?dice_id=N0098c79feb6\",\"post_competition_referral\":\"https://link.dice.fm/l420e07119a7?dice_id=l420e07119a7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/yce4298c1df5?dice_id=yce4298c1df5\",\"post_purchase_referral\":\"https://link.dice.fm/L9957e836d65?dice_id=L9957e836d65\",\"post_reminder_referral\":\"https://link.dice.fm/B5049583b9ef?dice_id=B5049583b9ef\",\"post_waitinglist_referral\":\"https://link.dice.fm/c0c81b5ef9b0?dice_id=c0c81b5ef9b0\"},\"perm_name\":\"q27l7p-eric-johnson-25th-jul-islington-assembly-hall-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/7f3a8f1e-2660-4f00-8d5e-793c41d70e87.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/7f3a8f1e-2660-4f00-8d5e-793c41d70e87.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/7f3a8f1e-2660-4f00-8d5e-793c41d70e87.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"One of the most outstanding instrumentalists in rock over the past 40 years, Texas guitarist Eric Johnson was already a legend before he recorded his first album. By the early 1980s, many celebrated guitarists were singing the praises of this skinny kid from Austin with the mind-melting chops.\\n\\nSince 1986 Eric has released seventeen albums, in addition to albums with other artists such as Eclectic with jazz guitarist Mike Stern, and the platinum-selling G3 Live with Joe Satriani and Steve Vai. Eric has received eight Grammy nominations along with numerous other recognitions, awards and wins in various polls and magazines.\\n\\nOver the course of more than four decades, Eric Johnson has been traveling on a prolific odyssey. Along the way, his creations have cross-pollinated the various musical genres which include rock, blues, jazz, fusion, soul, folk, new-age, classical, and even country.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event. You may be asked to prove your age and if you’re unable to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, 16+ Zip Oyster photocards and CitizenCards. Photocopies will not be accepted.'\",\"highlights\":[]},\"id\":\"69779f6e62df100001e60da3\",\"name\":\"Eric Johnson\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Cliffs Of Dover\",\"redirect_url\":\"https://open.spotify.com/track/2adbXTF9XpDUm8Fn8aARgR\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/10aefc2f3bc4cc502dbfad8287d14784cf52ecc9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cliffs Of Dover\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eric Johnson\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb44183631563d499f0137cc35\"},\"artist_id\":\"38250\",\"about\":null,\"is_headliner\"