ommunity-interest-7v77\",\"profile_active\":false},\"date_unix\":1778263200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-08T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:12\",\"about\":{\"description\":\"**The Hempolics**, fronted by Grippa (the band’s producer and engineer), are a close-knit, family-like group that includes vocalist Nubiya Brandon and vocalist/melodica player Dandelion, along with other key members like Ed West on drums, Leon on guitar, and best friends who have come together to form a unique reggae, dub, soul, and hip hop fusion.\\n\\nKnown for a genre-jumping yet cohesive sound, **The Hempolics** celebrate love, connection, and social themes through infectious rhythms, rich harmonies, and emotive lyrics.\\n\\n“And through the haze there shone a white light, and from that light played sweet sweet music... and to that music... We got high. Much love to the Hemps” – ***Paolo Nutini***\\n\\n“The Hempolics are the best band in the UK – but nobody knows it yet...” - ***Maxi Jazz (Faithless)***\\n\\n“Real vintage lo fi reggae inspired soul music for the 21st century city scape people” – ***DJ Vadim***\\n\\n“Great summer vibes. Puts a smile on my face. And amazing live too!”- ***Eliza Doolittle***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765843200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Hempolics\",\"image\":null,\"artist_id\":\"5571\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/c627f15f-ee5b-4c58-bc0b-970f190b0cae.jpg?rect=448%2C0%2C2688%2C2688\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/c627f15f-ee5b-4c58-bc0b-970f190b0cae.jpg?rect=0%2C269%2C3584%2C2150\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/c627f15f-ee5b-4c58-bc0b-970f190b0cae.jpg?rect=1053%2C0%2C1478%2C2688\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69413dbdb0500a00014c3ce1\",\"name\":\"The Hempolics\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T00:00:00+00:00\",\"sale_end_date\":\"2026-05-08T19:00:00+01:00\",\"sale_start_date\":\"2025-12-16T00:15:00+00:00\",\"event_start_date\":\"2026-05-08T19:00:00+01:00\",\"event_end_date\":\"2026-05-08T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"8erq22-the-hempolics-8th-may-hot-box-chelmsford-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":\"543378ce-c5d2-4781-a2c2-b605f4ce0ab1\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sa