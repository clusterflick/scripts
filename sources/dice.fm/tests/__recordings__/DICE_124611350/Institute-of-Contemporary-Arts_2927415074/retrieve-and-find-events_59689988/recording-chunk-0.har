chments/2025-11-17/be8ee8d6-f0d1-463b-8f06-9293564e4153.jpg?rect=1193%2C0%2C8620%2C8620\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/be8ee8d6-f0d1-463b-8f06-9293564e4153.jpg?rect=0%2C434%2C12920%2C7752\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/be8ee8d6-f0d1-463b-8f06-9293564e4153.jpg?rect=4090%2C0%2C4741%2C8620\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"SHOLTO\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb8063b166f8b4f4f2e8425b7d\"},\"artist_id\":\"93412\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1763715600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1515,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"SHOLTO - Persephone's Perception\",\"redirect_url\":\"https://open.spotify.com/track/0mT6XUgnPE9ZpX7sQY79ZG\",\"artist\":\"SHOLTO\",\"preview_url\":\"https://p.scdn.co/mp3-preview/599c6bd9ac4635f4dae42306ec123e146d973d81?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Persephone's Perception\"},{\"type\":\"apple_music\",\"title\":\"SHOLTO - Persephone's Perception\",\"redirect_url\":\"https://music.apple.com/us/album/persephones-perception/1827110115?i=1827110125&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"SHOLTO\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/64/a3/24/64a32468-4cab-cb10-c2a5-37f051fd75b0/mzaf_18352708648525485193.plus.aac.p.m4a\",\"track_name\":\"Persephone's Perception\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-26T00:00:00+01:00\",\"sale_end_date\":\"2026-02-20T18:30:00+00:00\",\"sale_start_date\":\"2025-10-27T10:30:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T20:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Organizado por ItaliaES.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/c10c70168eb1?dice_id=c10c70168eb1\",\"post_competition_referral\":\"https://link.dice.fm/Za303666fb48?dice_id=Za303666fb48\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H328e339dd68?dice_id=H328e339dd68\",\"post_purchase_referral\":\"https://link.dice.fm/X76543a0fef6?dice_id=X76543a0fef6\",\"post_reminder_referral\":\"https://link.dice.fm/tb902f0ffa81?dice_id=tb902f0ffa81\",\"post_waitinglist_referral\":\"https://link.dice.fm/v995c1ee684a?dice_id=v995c1ee684a\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**Tribute to Franco Battiato — Anthus & Néstor Giménez Duo**\\n\\nJoin us for a captivating evening dedicated to the visionary Italian artist **Franco Battiato**, whose music continues to inspire and transcend generations. On February 20, 2026, London hosts an exclusive **Tribute to Franco Battiato** — an intimate concert in duo format for voice and piano, featuring the acclaimed jazz singer **Anthus** and pianist-composer **Néstor Giménez**.\\n\\nTogether, Anthus and Giménez reinterpret Battiato’s timeless songs — from La cura and Centro di gravità permanente to E ti vengo a cercare and La stagione dell’amore — revealing their emotional and philosophical depth through elegant new arrangements. The performance blends Mediterranean warmth, jazz sensitivity, and poetic reflection in a minimalist yet deeply expressive soundscape.\\n\\nAnthus, celebrated for his unique voice and Mediterranean lyricism, brings profound emotion and artistry to each phrase. Néstor Giménez, one of Spain’s most respected pianists, complements him with refined musicality and a subtle, exploratory approach to harmony.\\n\\nThis concert is more than a tribute — it’s a spiritual dialogue between two artists and one of music’s greatest seekers. Through the purity of piano and voice, they honor Battiato’s legacy of beauty, consciousness, and transformation.\\n\\n📅 Date: Friday, February 20, 2026\\n\\n📍 Venue: London - Piano Smithfield\\n\\n“The only true revolution is the one that begins within.” — Franco Battiato\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Para mayores de 18 años (necesario traer DNI).\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"5071\",\"name\":\"Piano Smithfield\",\"address\":\"14 Long Ln, Barbican, London EC1A 9PN, UK\",\"location\":{\"lat\":51.5197837,\"lng\":-0.0989723},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"piano-smithfield-oxa5\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:48\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"8257\",\"name\":\"ItaliaES\",\"image\":{\"url\":null},\"perm_name\":\"italiaes-prey\",\"profile_active\":false},\"id\":\"68ff778d685939000173b659\",\"name\":\"Ciao Franco - Franco Battiato Tribute\",\"perm_name\":\"l8ggww-ciao-franco-franco-battiato-tribute-20th-feb-piano-smithfield-london-tickets