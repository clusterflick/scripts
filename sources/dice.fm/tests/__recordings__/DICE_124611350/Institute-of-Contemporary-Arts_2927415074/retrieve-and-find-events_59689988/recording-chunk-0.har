ice.fm/fd881dcb6de5?dice_id=fd881dcb6de5\",\"post_reminder_referral\":\"https://link.dice.fm/x97fde84a5cd?dice_id=x97fde84a5cd\",\"post_waitinglist_referral\":\"https://link.dice.fm/X3b4e2b5ab8a?dice_id=X3b4e2b5ab8a\"},\"perm_name\":\"8erv5r-the-maccabees-9th-jul-alexandra-palace-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/fde50d77-42fd-4e11-915c-ee6438ec97dc.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/fde50d77-42fd-4e11-915c-ee6438ec97dc.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/fde50d77-42fd-4e11-915c-ee6438ec97dc.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"691c6fe885484c0001da2e1f\",\"name\":\"The Maccabees\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Maccabees - Toothpaste Kisses\",\"redirect_url\":\"https://open.spotify.com/artist/0vW8z9pZMGCcRtGPGtyqiB\",\"artist\":\"The Maccabees\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d651dafc910965bbe81915c08eec661eaa27dd19\",\"track_name\":\"Toothpaste Kisses\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/iNFuunNiRCzrfejbq5egvpQmhl01jETwIVevRO6fo00NU.m3u8\",\"track_name\":\"\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Westside Cowboy\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-09/57f31552-5add-4ebd-ab4f-d11692a7bead.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"97925\",\"about\":null,\"is_headliner\":false},{\"name\":\"White Lies\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf31fffaa47cecee5ab2b3ab6\"},\"artist_id\":\"3511\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Maccabees\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/7446b5ed44788a95db015fda010a94a824d61d35\"},\"artist_id\":\"687\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T00:00:00+00:00\",\"sale_end_date\":\"2026-07-09T19:30:00+01:00\",\"sale_start_date\":\"2026-01-17T00:00:00+00:00\",\"event_start_date\":\"2026-07-09T19:00:00+01:00\",\"event_end_date\":\"2026-07-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"seating\":null,\"announcement_date_unix\":1768608000,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-09T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:26\",\"date_unix\":1783620000,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/L56c2ea0ea0a?dice_id=L56c2ea0ea0a\",\"post_competition_referral\":\"https://link.dice.fm/b3c35518a72c?dice_id=b3c35518a72c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/vaf4c83422c0?dice_id=vaf4c83422c0\",\"post_purchase_referral\":\"https://link.dice.fm/u69fef7b4d0d?dice_id=u69fef7b4d0d\",\"post_reminder_referral\":\"https://link.dice.fm/H18813ec4266?dice_id=H18813ec4266\",\"post_waitinglist_referral\":\"https://link.dice.fm/y76a68b8fa98?dice_id=y76a68b8fa98\"},\"perm_name\":\"eo3bo6-all-star-blues-9th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-17/670927b7-0f11-4ef7-9fd9-8740e3372a00.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-17/670927b7-0f11-4ef7-9fd9-8740e3372a00.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-17/670927b7-0f11-4ef7-9fd9-8740e3372a00.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"All Star Blues - Martin McNeill (guitar, vocals), West Weston (harmonica, vocals) and Francesca Shaw (upright bass).\\n\\n***Martin McNeill*** is an old-school blues singer and guitarist. An acclaimed slide guitarist, he performs as a solo act and in duo, trio and full band format. He was a finalist in the 2024 UK Blues Awards and a double nominee in the 2025 awards.\\n\\nHe has received high praise for his live performances, recordings and online livestreams. Radio presenter and music promoter Stephen Foster calls him “one of the country’s finest bottleneck blues guitarists.”\\n\\n***West Weston*** is one of Europe's top blues harmonica players, who for many years has been at the forefront of the European Blues scene.\\n\\n***Francesca Shaw*** \\\\- An accomplished double bass player and artist,\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"696af07d77cea600011f03a9\",\"name\":\"All Star Blues\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Thu 09 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-25T16:00:00+01:00\",\"sale_end_date\":\"2026-07-10T12:00:00+01:00\",\"sale_start_date\":\"2025-09-27T10:00:00+01:00\",\"event_start_date\":\"2026-07-10T12:00:00+01:00\",\"event_end_date\":\"2026-07-12T16:00:00+01:00\",\"is_multi_days_event\":true,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":47218,\"title\":\"Purchase Terms & Conditions\",\"body\":\"The following information is to be provided to all ticket purchasers at the point of sale and should appear on all event and sales pages on your websites:\\n\\n1\\\\. Your ticket purchase constitutes a personal, revocable license and, at all times, remains the property of the promoters. This ticket must be surrendered to the promoters upon request.\\n\\n2\\\\. Your ticket/s are sold by the promoters directly to you the consumer. Any tickets purchased by business or traders in breach of the terms and conditions of ticket sale will be cancelled. By accepting these terms and conditions you confirm that you are a consumer.\\n\\n3\\\\. Your ticket/s will IMMEDIATELY BECOME INVALID if resold OR OFFERED FOR SALE unless the sale is through the Artist’s official re-sale channels as advertised, or ticket agent fan to fan exchange (where applicable). Tickets sold via third parties and other unauthorised outlets, including online auction sites, are not valid for admission. The resale of a ticket renders it invalid and may lead to refusal of entry.\\n\\n4\\\\. Ticket sales are limited to a maximum of 8 per person.\\n\\n5\\\\. Only tickets purchased through approved ticket agents are valid for admission. The venue reserves the right to refuse admission.\",\"order\":0},{\"id\":47219,\"title\":\"Accessibility Information\",\"body\":\"https://www.ironmaiden.knebworth.com/faqs\",\"order\":1},{\"id\":47220,\"title\":\"Camping Information\",\"body\":\"A limited amount of camping space is available for those wishing to extend their time on site. The campsites open at 12 noon Friday 10th July and close at 12 noon Sunday 12th July. Please note there is no entry into any campsite after 10pm daily.\\n\\nYou can camp both nights but you should select the correct ticket for your anticipated arrival day.\\n\\nCampsites have toilets and water points as standard. Don’t forget to bring your collapsible/crushable refillable water bottle!\\n\\nCamping ticket holders will have access to Eddie's Dive Bar on Friday 10th, open 3pm - 11pm on a first come first served basis.\",\"order\":2},{\"id\":47221,\"title\":\"Gate Times\",\"body\":\"Campsites will open from 10am on Friday 10th July 2026. There will be no entry to the campsites after 10pm.\\n\\nAccess to Eddie’s Dive Bar will be available on Friday 10th July 2026 from 3pm till 11pm.\\n\\nCampsites will open from 8am on Saturday 11th July 2026.\\n\\nOn Saturday 11th July 2026 the arena will open at 1pm (subject to change) and close at 11pm.\\n\\nAll campsites, including glamping, campervans & caravans and accessibility must be clear by 12 noon on Sunday 12th July 2026.\\n\\nBox Offices will be located at each campsite gate and the campervan field if you have any ticketing queries.\",\"order\":3}],\"marketeers\":[{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Kilimanjaro.\",\"seating\":null,\"announcement_date_unix\":1758812400,\"venues\":[{\"id\":\"16675\",\"name\":\"Knebworth Park\",\"address\":\"Knebworth Park, Stevenage SG3 6PY\",\"location\":{\"lat\":51.872794,\"lng\":-0.214723},\"image\":null,\"city\":{\"id\":\"68d7be55410e6754e8c8ae2c\",\"name\":\"Knebworth\",\"location\":{\"lat\":51.866566,\"lng\":-0.184568,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"knebworth-park-l83mx\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-10T12:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:27\",\"date_unix\":1783681200,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4069},\"social_links\":{\"event_share\":\"https://link.dice.fm/a380d3ed8083?dice_id=a380d3ed8083\",\"post_competition_referral\":\"https://link.dice.fm/t5de3fc20771?dice_id=t5de3fc20771\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x292923eb6ca?dice_id=x292923eb6ca\",\"post_purchase_referral\":\"https://link.dice.fm/P3f868e7c71d?dice_id=P3f868e7c71d\",\"post_reminder_referral\":\"https://link.dice.fm/Rbde9c1fd51a?dice_id=Rbde9c1fd51a\",\"post_waitinglist_referral\":\"https://link.dice.fm/E00800542323?dice_id=E00800542323\"},\"perm_name\":\"eoayn2-iron-maiden-eddfest-10th-jul-knebworth-park-knebworth-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/8356174b-9157-4448-9967-345b18091e9b.jpg?rect=0%2C3%2C2836%2C2836\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/8356174b-9157-4448-9967-345b18091e9b.jpg?rect=0%2C570%2C2836%2C1702\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/8356174b-9157-4448-9967-345b18091e9b.jpg?rect=637%2C0%2C1563%2C2842\"},\"properties\":[],\"about\":{\"description\":\"**Action! Presents**\\n\\nIron Maiden - Run For Your Lives\\n\\nKnebworth 2026\\n\\n*£1 from every ticket sold on the tour will be donated to the newly launched LIVE Trust, a new funding initiative from LIVE that will offer much needed financial support to those working across live music. The Live Trust will initially support the grassroots music sector that is such a vital part of the music ecosystem – from venues and artists to festivals and promoters. https://livemusic.biz/live-trust*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 16’s must be accompanied by an adult aged 18+.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68d5754a7068f800017d6f00\",\"name\":\"Iron Maiden - EDDFEST\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Almighty\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-17/56c598df-76ab-4c6f-b339-cfea6e6cd5e6.jpg?rect=173%2C0%2C654%2C654\"},\"artist_id\":\"69777\",\"about\":null,\"is_headliner\":false},{\"name\":\"Airbourne\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-25/0af748dc-a54d-4451-9511-7d91975b3875.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"102539\",\"about\":null,\"is_headliner\":false},{\"name\":\"The HU\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2ccdc24acf91ba14b1b2273a\"},\"artist_id\":\"53421\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Darkness\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-25/e6c2a3eb-a24a-4f3d-b877-3569d075047b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"66998\",\"about\":null,\"is_headliner\":false},{\"name\":\"Iron Maiden\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-25/5b1a6930-c914-4c53-96b7-d301fd70d7e2.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"112374\",\"about\":null,\"is_headliner\":true}],\"total_artists\":5,\"total_free_texts\":0},\"score\":0,\"max_tickets\":8,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T15:00:00+00:00\",\"sale_end_date\":\"2026-07-10T21:00:00+01:00\",\"sale_start_date\":\"2025-10-31T09:30:00+00:00\",\"event_start_date\":\"2026-07-10T17:00:00+01:00\",\"event_end_date\":\"2026-07-10T22:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":52745,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":52746,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":52747,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":52748,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":52749,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":4},{\"id\":52750,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nYou will be subject to bag checks and searches upon arrival. Chairs and other camping equipment are not allowed at the event. A full list of prohibited items can be found in the prohibited items section below.\",\"order\":5},{\"id\":52751,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":6},{\"id\":52752,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7}],\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"seating\":null,\"announcement_date_unix\":1761577200,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Park\",\"doors_open_date\":\"2026-07-10T17:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidd