\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-04-20T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"announcement_date_unix\":1764604800,\"social_links\":{\"event_share\":\"https://link.dice.fm/oa9e1f695a0e?dice_id=oa9e1f695a0e\",\"post_competition_referral\":\"https://link.dice.fm/n4a735bc391b?dice_id=n4a735bc391b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J83d7df5bc22?dice_id=J83d7df5bc22\",\"post_purchase_referral\":\"https://link.dice.fm/o2ffa0b9f4d3?dice_id=o2ffa0b9f4d3\",\"post_reminder_referral\":\"https://link.dice.fm/T6242bde9be8?dice_id=T6242bde9be8\",\"post_waitinglist_referral\":\"https://link.dice.fm/k223cb77ff45?dice_id=k223cb77ff45\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k6nby8--sekou-20th-apr-earth-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1776709800,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:62\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2555},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/b9a23faa-dc40-46ff-99fa-3d22eee7b877.jpg?rect=323%2C0%2C2855%2C2855\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/b9a23faa-dc40-46ff-99fa-3d22eee7b877.jpg?rect=0%2C378%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/b9a23faa-dc40-46ff-99fa-3d22eee7b877.jpg?rect=965%2C0%2C1570%2C2855\"},\"id\":\"69272bab7fc7f20001bc0531\",\"name\":\"  SEKOU\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nHailing from Leicester, rising superstar Sekou burst onto the music scene in 2023. He soon landed a deal with Island Records and NWS, and within months of his debut release, momentum skyrocketed. Sekou became the youngest BRIT nominee with a ‘Rising Star’ nomination, was shortlisted for BBC’s Sound Of 2024 poll, made his TV debut on Jools Holland, performed at Glastonbury, and was invited to sit front row and attend major Fashion Houses shows and events including Valentino and Louboutin. Sekou has since continued to make a name for himself amongst some of the biggest players in the industry, having appeared on Central Cee’s ‘Limitless’, Kevin Abstract’s ‘Text Me’, and Justin Bieber’s ‘Too Long’. Sekou now steps into a new chapter. His new single ‘Catching Bodies’ demonstrating a playful, feel-good take on modern dating culture, and offers a taste of what is to come. He has found his musical identity and a sound that authentically represents him, highlighted in his forthcoming mixtape ‘In A World We Don’t Belong’, a collection of music which firms his stamp to the world on who he is as an artist and more importantly who he’s always been as a person.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T16:00:00+00:00\",\"sale_end_date\":\"2026-04-20T21:00:00+01:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:30:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sekou - Be With You\",\"redirect_url\":\"https://music.apple.com/us/album/be-with-you/1692658802?i=1692659092&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sekou\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/32/28/be/3228be24-a008-9a28-f563-708e98080e53/mzaf_10223355837019039448.plus.aac.p.m4a\",\"track_name\":\"Be With You\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Earth Ball\",\"image\":null,\"artist_id\":\"97864\",\"about\":null,\"is_headliner\":false},{\"name\":\"Bill Orcutt\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/255b292e9e51364e23d1fb4cf71f7ce52f77cbfb\"},\"artist_id\":\"42526\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ethan Miller\",\"image\":null,\"artist_id\":\"95490\",\"about\":null,\"is_headliner\":false},{\"name\":\"Steve Shelley\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2732caec6363b0b9eaf1574618a\"},\"artist_id\":\"95489\",\"about\":null,\"is_headliner\":false}],\"total_artists\":4,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Upset The Rhythm.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"590\",\"name\":\"Cafe OTO\",\"address\":\"18-22 Ashwin St, London E8 3DL\",\"location\":{\"lat\":51.5469452,\"lng\":-0.0744654999999739},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"cafe-oto-92e6\",\"accessibility\":{\"url\":\"https://www.cafeoto.co.uk/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-20T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"34\",\"name\":\"Upset The Rhythm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/42ef555c-26cf-421b-b66e-2030c1977b0c.jpg\"},\"perm_name\":\"upset-the-rhythm-z8e2\",\"profile_active\":true},\"announcement_date_unix\":1763546400,\"social_links\":{\"event_share\":\"https://link.dice.fm/C20c0a4481c9?dice_id=C20c0a4481c9\",\"post_competition_referral\":\"https://link.dice.fm/t282f9f1fe57?dice_id=t282f9f1fe57\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V298d502e13b?dice_id=V298d502e13b\",\"post_purchase_referral\":\"https://link.dice.fm/s2e126c9a2f7?dice_id=s2e126c9a2f7\",\"post_reminder_referral\":\"https://link.dice.fm/Scd1637aba95?dice_id=Scd1637aba95\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cc3af094cbbd?dice_id=Cc3af094cbbd\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"v3g3ql-orcutt-shelley-miller-earthball-20th-apr-cafe-oto-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":20,\"name\":\"Upset The Rhythm\",\"privacy_policy_link\":\"http://www.upsettherhythm.co.uk/privacypolicy.html http://www.upsettherhythm.co.uk/privacypolicy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776709800,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:63\",\"price\":{\"currency\":\"GBP\",\"amount\":2699,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/096dc4d2-8db2-41d8-a138-1a114c1c8139.jpg?rect=563%2C0%2C2178%2C2178\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/096dc4d2-8db2-41d8-a138-1a114c1c8139.jpg?rect=0%2C98%2C3304%2C1982\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/096dc4d2-8db2-41d8-a138-1a114c1c8139.jpg?rect=1053%2C0%2C1198%2C2178\"},\"id\":\"691acf16ef017f00012957ca\",\"name\":\"Orcutt Shelley Miller + EarthBall\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"ORCUTT SHELLEY MILLER are a guitar, bass, drums power trio. Featuring incendiary guitarist Bill Orcutt, psych-seer Ethan Miller (Comets on Fire, Howlin’ Rain), and dynamic powerhouse Steve Shelley (Sonic Youth). Despite rhythmic nods to the SoCal '60s, the overall vibe of Orcutt Shelley Miller is angular, atonal slash piled on a mid-'80s SST punk-fusionoid substrate, with Orcutt's bristling chords anchored by Miller's ebbing/ flowing bass. In the engine room, Shelley, the most beat-anchored of the trio, never quite abandons the two-and-four pocket but scrabbles around it, skitters over it, burrows under it, ultimately tapping a sort of Michael Hurley-gone-motorik vibe on the longer tracks. \\\"Four-Door Charger,\\\" easily the most tranced-out of their tracks, passes through kraut-funk on the way to a solid Klaus Dinger-meets-Lothar Meid churn.\\n\\nOrcutt Shelley Miller’s self-titled debut album is out now on Silver Current, and sounds like a fully formed beast, rather than a mere sum of its distinctive parts. For the improv shy listener, I can gladly inform you that it sounds like Orcutt sketched out a few of the heads beforehand, so there's plenty to clutch onto amidst the slashing Ginn-esque tritones, and plenty of the right-angle bursting-clockwork solos that define Orcutt's hypnotic phrasing. ‘Orcutt Shelley Miller’ reads like a \\\"big rock statement\\\" by its constituents that treads the line between good times and blown minds, and as such, it's a top-shelf repeat spinner.              \\n\\nhttps://orcuttshelleymiller.bandcamp.com/album/orcutt-shelley-miller\\n\\nEARTHBALL are a wild ensemble from Canada, mainly based on Vancouver Island. EarthBall's live shows epitomise their commitment to spontaneous composition, offering audiences a unique experience with each performance. The last two years have seen EarthBall release their debut LP 'It's Yours' and a live album entitled 'Actual Earth Music - Volume 1 & 2' featuring Chris Corsano and Steve Beresford on Upset The Rhythm. This winter they returned with their best effort to date 'Outside Over There’ - a gathering of sound at the forest's edge; where feedback, saxophone screams, and ecstatic vocals dissolve the boundary between chaos and clarity.\\n\\nhttps://upsettherhythm.bandcamp.com/album/outside-over-there\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T10:00:00+00:00\",\"sale_end_date\":\"2026-04-20T18:00:00+01:00\",\"sale_start_date\":\"2025-11-19T10:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:30:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Orcutt Shelley Miller - A Star Is Born\",\"redirect_url\":\"https://music.apple.com/us/album/a-star-is-born/1818996994?i=1818996996&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Orcutt Shelley Miller\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/15/37/a5/1537a50d-c50d-b898-a24f-de4c46f6da3c/mzaf_10486298915900964054.plus.aac.p.m4a\",\"track_name\":\"A Star Is Born\"},{\"type\":\"spotify\",\"title\":\"Orcutt Shelley Miller - Four-door Charger\",\"redirect_url\":\"https://open.spotify.com/track/5vvTCFLcovEdmVNv4ZF43I\",\"artist\":\"Orcutt Shelley Miller\",\"preview_url\":\"https://p.scdn.co/mp3-preview/072ae379ffbe4238a501a15ead3e4b585077bdc9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Four-door Charger\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sara Correia\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/ae5843fc-0624-4e8f-ad82-1014b50f26be.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"54653\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by La Linea Festival.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"201\",\"name\":\"Barbican Hall\",\"address\":\"Barbican Centre, Silk Street, London EC2Y 8DS\",\"location\":{\"lat\":51.519853,\"lng\":-0.0916614000000209},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"barbican-hall-ja9d\",\"accessibility\":{\"url\":\"https://www.barbican.org.uk/your-visit/accessibility/access-scheme\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-20T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":\"21dc113e-c917-4430-9a6b-7500c4106d54\",\"billing_promoter\":{\"id\":\"5970\",\"name\":\"Como No!\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-09/a9850c4f-895d-494f-beec-abcf15aec03e.jpg\"},\"perm_name\":\"como-no-v7rd\",\"profile_active\":true},\"announcement_date_unix\":1763467200,\"social_links\":{\"event_share\":\"https://link.dice.fm/O1b4ef819c12?dice_id=O1b4ef819c12\",\"post_competition_referral\":\"https://link.dice.fm/K43e00403a7c?dice_id=K43e00403a7c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/pef3014e648f?dice_id=pef3014e648f\",\"post_purchase_referral\":\"https://link.dice.fm/P0ca1b7f0441?dice_id=P0ca1b7f0441\",\"post_reminder_referral\":\"https://link.dice.fm/q9cc8a6db9ad?dice_id=q9cc8a6db9ad\",\"post_waitinglist_referral\":\"https://link.dice.fm/r3bb7cc228f0?dice_id=r3bb7cc228f0\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6dw327-sara-correia-20th-apr-barbican-hall-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776709800,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:64\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2266},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/d856eec6-6c2c-4b53-9408-55e2d954ab03.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/d856eec6-6c2c-4b53-9408-55e2d954ab03.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/d856eec6-6c2c-4b53-9408-55e2d954ab03.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"691a33b8804efa0001e6ee1c\",\"name\":\"Sara Correia\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"21dc113e-c917-4430-9a6b-7500c4106d54\",\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Sara Correia begins a new chapter in 2026, bringing a new album and a new show.\\n\\nWidely regarded around the world as one of Fado music’s fastest rising stars, Portuguese singer Sara Correia continues to affirm her place as one of the genre’s most powerful and expressive voices. Her acclaimed third studio album Liberdade and her appearances as a judge on The Voice Portugal have cemented her reputation as a leading figure in contemporary Fado.\\n\\nSara Correia’s smoky and passionate voice captures love and power, sadness and joy, the city of Lisbon and the Portuguese soul. Inhabiting the space between traditional, dark Fado and its modern, lighter incarnation, her mellifluous toplines are touched by the sensibility of French chanson.\\n\\nHaving made her UK debut at La Linea 2022, she now returns to London as one of the headliners of La Linea 2026, performing her biggest UK show to date.\\n\\n“Occasionally, a new voice reminds us that traditional Fado is still very much alive…Sara Correia is such a voice.” Songlines\\n\\n“Her husky alto-contralto voice still projects the intensity of the roots of the music she grew up listening to” All About Jazz\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-04-20T16:00:00+01:00\",\"sale_start_date\":\"2025-11-21T12:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:30:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sara Correia - Chelas\",\"redirect_url\":\"https://music.apple.com/us/album/chelas/1695809534?i=1695809732&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sara Correia\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/db/93/49/db934947-8d54-fa2d-a761-a335ddf29700/mzaf_5652376276074602334.plus.aac.p.m4a\",\"track_name\":\"Chelas\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dave Hause\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/8bb375f5050fab4a12f9dfc35fe43138c3f3bbd0\"},\"artist_id\":\"11610\",\"about\":null,\"is_headliner\":false},{\"name\":\"Katacombs\",\"image\":null,\"artist_id\":\"115778\",\"about\":null,\"is_headliner\":false},{\"name\":\"Frank Turner\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/90afd686eb954335b443f7cca5165634f4aa6b0e\"},\"artist_id\":\"7594\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Live Nation.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-20T19:30:00+01:00\",\"doors_close_date\":\"2026-04-20T23:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"announcement_date_unix\":1761732000,\"social_links\":{\"event_share\":\"https://link.dice.fm/J0c5c978f6ac?dice_id=J0c5c978f6ac\",\"post_competition_referral\":\"https://link.dice.fm/ab584faadb7b?dice_id=ab584faadb7b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wc99338d2c41?dice_id=wc99338d2c41\",\"post_purchase_referral\":\"https://link.dice.fm/E8dd5be1a4d9?dice_id=E8dd5be1a4d9\",\"post_reminder_referral\":\"https://link.dice.fm/L053825162d2?dice_id=L053825162d2\",\"post_waitinglist_referral\":\"https://link.dice.fm/L2f129808538?dice_id=L2f129808538\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"2we7pa-frank-turner-20th-apr-scala-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776709800,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:65\",\"price\":{\"currency\":\"GBP\",\"amount\":4611,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/ffe802b7-3187-41c8-b21b-b809f40a59d7.jpg?rect=0%2C454%2C4480%2C4480\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/ffe802b7-3187-41c8-b21b-b809f40a59d7.jpg?rect=0%2C2016%2C4480%2C2688\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/ffe802b7-3187-41c8-b21b-b809f40a59d7.jpg?rect=392%2C0%2C3696%2C6720\"},\"id\":\"6901077e9367260001134e99\",\"name\":\"Frank Turner\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Frank Turner is one of the UK’s most successful artists. He released his tenth studio album ‘Undefeated’ in May 2024 which debuted at Number 3 in the Oicial Album Chart and Number 1 in the Independent Album Chart. His album ‘FTHC’ (Feb 2022) became his first #1 hit with the previous four albums all peaking in the Top 3. With over a million albums sold worldwide, he has three gold-certified albums and one silver status.\\n\\nSince his first solo gig in 2004, Frank has played his 3000th show in Feb 2025 at Alexandra Palace, London, which sold out within 24 hours of being on general sale. His biggest UK headline shows include aforementioned Alexandra Palace, O2 Arena and Wembley Arena. He has performed at almost every UK venue imaginable, from tiny clubs to stadiums as well as the opening ceremony of 2012 London Olympics.\\n\\nInternationally, Frank has played headline shows in all continents with big followings across Europe and North America. He completed the ambitious 50 States in 50 Days tour in 2022 – the first non-US citizen to do so. His award-winning 4-day festival, Lost Evenings takes place in a dierent city each year - this year in Edinburgh, Scotland, and next year in Dallas, TX.\\n\\nDuring the pandemic, Frank raised almost £300K for grassroot music venues with a weekly series of livestreams resulting in the Music Venue Trust awarding him the Outstanding Achievement for Grassroots Music Venues. Building on this, Frank completed a Music Venue Trust World Record of playing 15 shows in 24 hours – all in grassroot venues and in conjunction with independent record shops.\\n\\nA max of 6 tickets per person and per household applies.\\n\\nTickets in excess of this may be cancelled.\\n\\nTickets must not be purchased with the intention of reselling them.\\n\\nIf you can no longer use your tickets, you may only resell them through the DICE Wait List\\n\\nYou may not resell or offer to resell tickets for this event through any unauthorised resale site\\n\\nAny tickets purchased, resold or offered for resale in breach of these special conditions may be cancelled.\\n\\nFull T&Cs: https://dice.fm/help/article?id=40430412359185\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-29T10:00:00+00:00\",\"sale_end_date\":\"2026-04-20T18:30:00+01:00\",\"sale_start_date\":\"2025-10-31T10:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:30:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sandy Sheets\",\"redirect_url\":\"https://open.spotify.com/track/3c5LfLYsfeJcfXkuW9JDxE\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5a01ed5e933f9b1d82da15e261f665153750faf2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sandy Sheets\"},{\"type\":\"apple_music\",\"title\":\"Dave Hause - Melanin\",\"redirect_url\":\"https://itunes.apple.com/gb/album/melanin/1414322348?i=1414322453&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dave Hause\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview118/v4/b2/a5/c0/b2a5c084-4d5f-ea57-7fb3-08a0b3fac37e/mzaf_7846195957090458797.plus.aac.p.m4a\",\"track_name\":\"Melanin\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Mon 20 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sophie Jamieson\",\"image\":{\"url