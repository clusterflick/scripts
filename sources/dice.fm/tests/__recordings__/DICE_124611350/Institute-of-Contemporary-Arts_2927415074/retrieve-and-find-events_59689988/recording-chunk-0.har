tical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-05T00:00:00+01:00\",\"sale_end_date\":\"2026-03-14T14:00:00+00:00\",\"sale_start_date\":\"2025-09-05T00:00:00+01:00\",\"event_start_date\":\"2026-03-14T13:00:00+00:00\",\"event_end_date\":\"2026-03-14T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Fire in the Mountain Festival LTD.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/r6cde5af0e63?dice_id=r6cde5af0e63\",\"post_competition_referral\":\"https://link.dice.fm/Z97d1aa5a69d?dice_id=Z97d1aa5a69d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G3f12de39954?dice_id=G3f12de39954\",\"post_purchase_referral\":\"https://link.dice.fm/L719e2edde2e?dice_id=L719e2edde2e\",\"post_reminder_referral\":\"https://link.dice.fm/Df4e696add2a?dice_id=Df4e696add2a\",\"post_waitinglist_referral\":\"https://link.dice.fm/M0900acf1fdf?dice_id=M0900acf1fdf\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Celebrating Irish Culture, Music and DanceIrish Stew and Champ (Meat and Vegan) will be served. We’ll have Guinness, Stouts, and fine Whisky.We will focus on some marvellous Irish Ceili Dances.  \\n  \\nAll ages and abilities welcome... we're teach you the moves.. from really simple dances for the smallest kids to a couple of proper ones for the grown ups, come and get your folk on with Cut A Shine!\\n\\n**Facilities:**  \\nFully Stocked Bar  \\nFilter Coffee and Tea  \\nIrish Stew and Champ for Lunch (Meat and Vegan Options)  \\nCakes, Soft Drinks and Healthy Snacks  \\nBuggy Parking in the foyer please, there's plenty of room.  \\nBaby Change Room.  \\nSoft play area for crawlers  \\nIrish Stouts!\\n\\n**Diversity and Inclusivity Policy**  \\nWhilst the music and dances come from predominantly Anglo-saxon and Celtic culture, everyone is welcome to come enjoy the dancing and experience these aspects of the folk culture of the British Isles. We welcome family units of any type and configuration. We want to bring everyone together to dance together, which is how it should be.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an Family Event - all ages\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773493200,\"venues\":[{\"id\":\"2453\",\"name\":\"The Round Chapel\",\"address\":\"1D Glenarm Rd, Clapton, London E5 0NP, UK\",\"location\":{\"lat\":51.55224260000001,\"lng\":-0.052109599999994316},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-round-chapel-g9np\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T13:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:42\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"id\":\"68bb0484c36c530001ec3e16\",\"name\":\"Family Barn Dance: St Patrick's Day\",\"perm_name\":\"8ekpy7-family-barn-dance-st-patricks-day-14th-mar-the-round-chapel-london-tickets\",