null,\"sales_tax\":null,\"amount_from\":880},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Divine Schism.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"3200\",\"name\":\"Divine Schism\",\"image\":{\"url\":null},\"perm_name\":\"divine-schism-6pxq\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"l8boll-dog-chocolate-the-plan-rattle-27th-feb-paper-dress-vintage-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772220600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":120,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:49\",\"venues\":[{\"id\":\"373\",\"name\":\"Paper Dress Vintage\",\"address\":\"352a Mare Street, London, E8 1HR, United Kingdom\",\"location\":{\"lat\":51.54733,\"lng\":-0.05467},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-29/13fc3fd2-f3f2-4ebb-b479-d3d2d7cf5214.jpg?rect=683%2C0%2C2731%2C2731\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dog Chocolate\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/434a26bedad1c54d6ee5613911cff8470f01e896\"},\"artist_id\":\"9790\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Plan\",\"image\":null,\"artist_id\":\"122833\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rattle\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/d7cc884083dccb8db147e7f392e0756f9c59704e\"},\"artist_id\":\"9809\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"about\":{\"description\":\"Divine Schism are stoked to be working with Dog Chocolate to celebrate the release of their newest album 'So Inspired, So Done in! 'The record’s out on February 27th on the always brilliant Upset The Rhythm, and we’re celebrating with a launch show at the excellent Paper Dress Vintage in Hackney!\\n\\nAnd joining them will be The Plan, whose excellent album Mountain View came out on our own label last year and is an absolute cracker! And the utterly captivating drum duo Rattle will open the show!\\n\\nFor the uninitiated, Dog Chocolate sound like a crowded room but are actually four individuals from London. Abandoning notions of elegance, cred and professionalism they embrace the ramshackle, instant and fun, capturing a vivid spontaneity with their music.\\n\\nAfter 7 strange years of relative silence, and 13 years of being a band, Dog Chocolate return in 2026 with ‘So Inspired, So Done In’. Their fourth record is their most focused, cohesive and song-y yet.\\n\\n‘So Inspired, So Done In’ charts a long and confusing period in the band’s collective life, marked by major life changes, losses and shifts, colouring the band’s trademark frantic, daft and anxious energy with a contemplative glaze. Dog Chocolate continue to investigate their internal and external landscapes with playful curiosity, frustration, silliness and empathy.’\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-18T12:45:00+00:00\",\"sale_end_date\":\"2026-02-27T19:00:00+00:00\",\"sale_start_date\":\"2026-01-18T12:45:00+00:00\",\"event_start_date\":\"2026-02-27T19:30:00+00:00\",\"event_end_date\":\"2026-02-27T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696cd5a513fd140001e9d0d6\",\"name\":\"Dog Chocolate + The Plan + Rattle\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-18/ada2e5d5-5e41-442b-b0e0-8146b69ec3b6.jpg?rect=0%2C70%2C867%2C867\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-18/ada2e5d5-5e41-442b-b0e0-8146b69ec3b6.jpg?rect=0%2C380%2C867%2C520\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-18/ada2e5d5-5e41-442b-b0e0-8146b69ec3b6.jpg?rect=82%2C0%2C704%2C1280\"},\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768740300,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q58f67345c49?dice_id=Q58f67345c49\",\"post_competition_referral\":\"https://link.dice.fm/b5ce52942f75?dice_id=b5ce52942f75\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qf2434f80488?dice_id=Qf2434f80488\",\"post_purchase_referral\":\"https://link.dice.fm/M7691cab65c6?dice_id=M7691cab65c6\",\"post_reminder_referral\":\"https://link.dice.fm/Xf7eb314e6f6?dice_id=Xf7eb314e6f6\",\"post_waitinglist_referral\":\"https://link.dice.fm/S9195506f5c6?dice_id=S9195506f5c6\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dog Chocolate - Employee\",\"redirect_url\":\"https://music.apple.com/us/album/employee/1866542060?i=1866542441&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dog Chocolate\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/9d/e1/65/9de16528-4552-e67c-e052-4ff6a11dd462/mzaf_16884838365087937107.plus.aac.p.m4a\",\"track_name\":\"Employee\"},{\"type\":\"spotify\",\"title\":\"Dog Chocolate - Employee\",\"redirect_url\":\"https://open.spotify.com/track/4ke0UwidFhwFfJXOj2MbQs\",\"artist\":\"Dog Chocolate\",\"preview_url\":\"https://p.scdn.co/mp3-preview/19fb48d6332284adee08e25e606a39204d2f8f06?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Employee\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Friends Serene.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1483\",\"name\":\"Friends Serene\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-06-29/dc40875b-db38-47e0-981d-fc7925fe53f2.jpg\"},\"perm_name\":\"friends-serene-w8lp\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"l8og2l-siblings-ep-launch-flypaper-bumper-27th-feb-the-shacklewell-arms-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772220600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:50\",\"venues\":[{\"id\":\"10\",\"name\":\"The Shacklewell Arms\",\"address\":\"71 Shacklewell Lane, London E8 2EB\",\"location\":{\"lat\":51.5531551,\"lng\":-0.0699228999999377},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Siblings\",\"image\":null,\"artist_id\":\"67511\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Friends Serene are delighted to welcome Siblings to The Shacklewell Arms for a special London headline show on Friday 27th February 2026 to celebrate the release of their latest EP.\\n\\nSiblings are an alternative indie folk band based in south London. Formed in the heatwaves of 2022, Siblings’ sound draws on ethereal folk, classic ‘70s storytelling, and the atmospheric flair of spirit jazz. Self-producing their music at Strange Melody Recording—a creative hub co-owned by drummer/producer Ben Andrewes and guitarist/keys player Rob Fenner—the band showcases their ability to merge timeless songwriting with rich production and immersive textures.\\n\\nSupport from Flypaper and Bumper.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T08:00:00+00:00\",\"sale_end_date\":\"2026-02-27T21:30:00+00:00\",\"sale_start_date\":\"2025-12-05T08:00:00+00:00\",\"event_start_date\":\"2026-02-27T19:30:00+00:00\",\"event_end_date\":\"2026-02-27T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6931b183e0ffd9000135ade7\",\"name\":\"Siblings (EP launch) / Flypaper / Bumper\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-