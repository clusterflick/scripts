29ff292-a393-49fc-b420-7cd662e7259f.jpg?rect=1040%2C0%2C4160%2C4160\"},\"artist_id\":\"111979\",\"about\":{\"description\":\"Formed in 2020 in Dearborn, Michigan, Prostitute is an experimental post-punk and Arab rock band. Born out of the isolation of the COVID-19 lockdown, the band’s debut album, Attempted Martyr, was written in the midst of global and personal turmoil, capturing the zeitgeist of a world unraveling. A loose concept record, it chronicles the rise and fall of a doomed zealot whose pursuit of holy vengeance spirals into a psychotic orgy of violence, greed, and lust.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/9fa39772-2daa-4c30-9ca6-c195a85f7b5d.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/9fa39772-2daa-4c30-9ca6-c195a85f7b5d.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/9fa39772-2daa-4c30-9ca6-c195a85f7b5d.jpg?rect=675%2C0%2C1650%2C3000\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Prostitute - All Hail\",\"redirect_url\":\"https://open.spotify.com/track/1KC9WZ3PBUUZxSZruaiHam\",\"artist\":\"Prostitute\",\"preview_url\":\"https://p.scdn.co/mp3-preview/60f05e5ec0182c22a47f239051a2c8d00d80f5d9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"All Hail\"},{\"type\":\"apple_music\",\"title\":\"Prostitute - All Hail\",\"redirect_url\":\"https://music.apple.com/us/album/all-hail/1849438373?i=1849438374&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Prostitute\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/d0/67/21/d067214d-2e13-3a04-2418-b7cc2bdc4778/mzaf_18187216150521525172.plus.aac.p.m4a\",\"track_name\":\"All Hail\"}],\"seats_io_public_key\":null,\"announcement_date_u