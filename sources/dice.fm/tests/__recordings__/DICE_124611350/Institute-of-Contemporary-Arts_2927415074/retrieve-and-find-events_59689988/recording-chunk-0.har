d\",\"hours\":24},\"venues\":[{\"id\":\"207\",\"name\":\"Heaven\",\"address\":\"11, The Arches, Villiers St, London WC2N 6NG\",\"location\":{\"lat\":51.5080932,\"lng\":-0.124121400000035},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"heaven-j72p\",\"accessibility\":{\"url\":\"https://g-a-yandheaven.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-03T18:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Frost Children\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-02-16/b2be09ab-e456-4442-89ae-1d3a67fbb622.jpg?rect=0%2C1%2C639%2C639\"},\"artist_id\":\"43316\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/1b564aac-7e0c-40ec-9b7d-a705eac59db4.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/1b564aac-7e0c-40ec-9b7d-a705eac59db4.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/1b564aac-7e0c-40ec-9b7d-a705eac59db4.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Frost Children - BL!NK\",\"redirect_url\":\"https://open.spotify.com/track/0WV0m1VrDz1LQuMGvySShO\",\"artist\":\"Frost Children\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4eabe350894ca266b383bf6aa72283d7d1936dc3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"BL!NK\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770822000,\"max_tickets\":6,\"marketeers\":[{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"dollop presents:\\n\\nFrost Children\\n\\nFor Angel and Lulu Prost, the sibling duo behind Frost Children, home has always sounded like dance music. The St. Louis-born musicians grew up steeped in the sleek catharsis of golden-age EDM. The duo’s third album SISTER, out September 12th via True Panther/Dirty Hit, is an exhilarating return to those first sounds that moved them, echoing with the reverence and refinement of two formidable artists crafting exactly what they want to hear. But it’s also a striking portrait of Frost Children’s singular creative partnership: as bandmates, as roommates, as symbiotic savants practicing the art of what Angel calls “twin telepathy.” Boldly revitalizing and revolutionizing a too- often-devalued subgenre, Frost Children have delivered their most forthright and full-bodied identity statement yet. As Lulu puts it: “This is so confidently what we love, and what we breathe.” Melding the sensitivity and songcraft of Hearth Room with the propulsive power of SPEED RUN, SISTER puts forward an arrestingly personal vision for modern dance music that transcends nostalgia and trend-chasing. Delicately weaving strains of emo, electro, and pure pop, Frost Children explore close-to-home themes of co-dependence, consistency, and change, exemplified by the roaring refrain on “Falling”: “Tell me the way to live / I’m falling apart.” For all the uncertainty of thrilling anthems like “Position Famous,” “WHAT IS FOREVER FOR” and rapturous album closer “2 LØVE,” SISTER pulses with the electric energy of two artists confidently reveling in their element. From the cheeky character study “Ralph Lauren” (both Angel and Lulu worked at the all-American outlet in high school, an early hint to the “dubstep academia” aesthetic they’d foster as adults) to the sample of Hearth Room’s “Bernadette” coursing through “Bound2U,” the duo’s shared history animates every corner of SISTER’s expansive yet intimate world. “It’s a way to explore what really makes us a unique band,” Angel says of their collaboration across SISTER. “We are siblings that are extremely close that live together… and we can read each other’s minds\\n\\n14+ (under 16s to be accompanied by an adult of 18+, all required to have physical ID)\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by dollop.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:35\",\"social_links\":{\"event_share\":\"https://link.dice.fm/mbbb39bd3780?dice_id=mbbb39bd3780\",\"post_competition_referral\":\"https://link.dice.fm/t007b04c27a9?dice_id=t007b04c27a9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t3521ce26a4f?dice_id=t3521ce26a4f\",\"post_purchase_referral\":\"https://link.dice.fm/ud54e80b8126?dice_id=ud54e80b8126\",\"post_reminder_referral\":\"https://link.dice.fm/W710202cd3fb?dice_id=W710202cd3fb\",\"post_waitinglist_referral\":\"https://link.dice.fm/g0171d42342c?dice_id=g0171d42342c\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T15:00:00+00:00\",\"sale_end_date\":\"2026-09-03T16:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-09-03T18:00:00+01:00\",\"event_end_date\":\"2026-09-03T21:30:00+01:00\",\"is_multi_days_event\":false,