025-11-12/1a2445b4-3919-4b07-a00d-0a78ec34ad9a.jpg?rect=570%2C0%2C908%2C1651\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6914b6ed0b30ea0001c206e5\",\"name\":\"SWORD II\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-12T17:00:00+00:00\",\"sale_end_date\":\"2026-05-12T16:00:00+01:00\",\"sale_start_date\":\"2025-11-14T10:00:00+00:00\",\"event_start_date\":\"2026-05-12T19:30:00+01:00\",\"event_end_date\":\"2026-05-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"k6k7qp-sword-ii-12th-may-club-cheek-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2800,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/tf6343daac11?dice_id=tf6343daac11\",\"post_competition_referral\":\"https://link.dice.fm/Zaf84521ebaf?dice_id=Zaf84521ebaf\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j08f542832c4?dice_id=j08f542832c4\",\"post_purchase_referral\":\"https://link.dice.fm/U61287138fca?dice_id=U61287138fca\",\"post_reminder_referral\":\"https://link.dice.fm/U5fb3a04817b?dice_id=U5fb3a04817b\",\"post_waitinglist_referral\":\"https://link.dice.fm/cd68595968d7?dice_id=cd68595968d7\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sirály\",\"redirect_url\":\"https://open.spotify.com/track/4gwuy8dyF1WQYJlUoItxug\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/47cdedae3df4c16d3346dfbad2fe23228347b584?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sirály\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Gotobeat.\",\"billing_promoter\":{\"id\":\"5184\",\"name\":\"Gotobeat\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-03/167fd842-233e-4076-a3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"date_unix\":1778610600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oslo-hackney-je6z\",\"accessibility\":{\"url\":\"https://www.oslohackney.com/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-12T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:70\",\"about\":{\"description\":\"**Gotobeat is excited to team up with Oslo Hackney to welcome Thy Catafalque with special guests Æl-Fierlen on Tuesday, May 12th!**\\n\\n—> Æl-Fierlen\\n\\n—> Thy Catafalque\\n\\n**Thy Catafalque -** Tamás Kátai has a vision that extends beyond borders and boundaries. Even during its infancy, Thy Catafalque had already outgrown the rather rigid guidelines of black metal. Though only intended for the studio, over the past 20 years, his recording project has evolved into a lively collaboration. With each album, Thy Catafalque has pushed the envelope of extreme metal a step further, bringing the world’s most vile art form into conversation with the avant-garde.\\n\\n**Æl-Fierlen -** Æl-Fierlen are a four-piece band from the south of England with elements of black metal, shoegaze and folk twisted together like the branches of the oldest tree in the forest. We are what the woods sounds like.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762164000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Thy Catafalque\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0fb7008f84318a4a34656f37\"},\"artist_id\":\"53035\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-31/26395085-dc36-4edd-a9d3-cbc6f8018c04.jpg?rect=175%2C0%2C3204%2C3204\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-31/26395085-dc36-4edd-a9d3-cbc6f8018c04.jpg?rect=0%2C536%2C3554%2C2132\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-31/26395085-dc36-4edd-a9d3-cbc6f8018c04.jpg?rect=896%2C0%2C1762%2C3204\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6904d051d6a085000106330d\",\"name\":\"Thy Catafalque live in London!\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-03T10:00:00+00:00\",\"sale_end_date\":\"2026-05-12T18:00:00+01:00\",\"sale_start_date\":\"2025-11-03T10:00:00+00:00\",\"event_start_date\":\"2026-05-12T19:30:00+01:00\",\"event_end_date\":\"2026-05-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"7dem86-thy-catafalque-live-in-london-12th-may-oslo-hackney-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null}],\"title\":\"Tue 12 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\"