\":5,\"social_links\":{\"event_share\":\"https://link.dice.fm/F00c617e97a0?dice_id=F00c617e97a0\",\"post_competition_referral\":\"https://link.dice.fm/i6986c576f21?dice_id=i6986c576f21\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Rcbca07a447a?dice_id=Rcbca07a447a\",\"post_purchase_referral\":\"https://link.dice.fm/xb2b6a5c50fe?dice_id=xb2b6a5c50fe\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ze50014d0f45?dice_id=Ze50014d0f45\",\"post_reminder_referral\":\"https://link.dice.fm/oe50876efa18?dice_id=oe50876efa18\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"2691\",\"name\":\"Night Tales Loft\",\"address\":\"207, 1 Westgate St, London E8 3RL, UK\",\"location\":{\"lat\":51.53753889999999,\"lng\":-0.05786670000000001},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/9ded5223-ee50-49da-9cc8-dfb16fb11e4e.jpg?rect=0%2C0%2C1317%2C1317\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"night-tales-loft-39wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-25T18:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Every Wednesday, Patterns brings together some of London's finest musicians for an evening of improvised music. From Jazz to Soul, Broken-Beat to Hip Hop and beyond, our weekly jazz sessions offer a space for collaboration between musicians of all styles and flavours.\\n\\nStriving to always be inclusive and showcase the best of emerging talent; egos are always left at the door to create an intimate experience for the listeners and performers alike.\\n\\nLive music starts at 8pm. Playlist before.\\n\\nP A T T E R N S\\n\\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**ONLINE TICKETS**\\n\\n- Different ticket types are available.\\n- Please check the information on your ticket before making a purchase.\\n\\n**TABLE BOOKINGS**\\n\\n- Guarantee yourself a table by booking a table via our website ➡ www.ntloft.co.uk\\n- There are 2 sessions available:\\n\\n\\\\- Early Session = 6pm - 9pm\\n\\n\\\\- Late Session = 9:15pm - 11pm\\n\\n- If you have a table for the early session, you may be asked to leave your table for the start of the late session. You are welcome to stay and stand in the venue. Other seating will be arranged if available.\\n\\n**WALK-INS**\\n\\n- Entry is FREE before 7:30pm.\\n- Entry after 7:30pm is £5.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:69\",\"billing_promoter\":{\"id\":\"2368\",\"name\":\"Night Tales Loft\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/6e6ef849-1334-49eb-a7bd-a888e14902a0.jpg\"},\"perm_name\":\"night-tales-loft-dvlq\",\"profile_active\":false},\"presented_by\":\"Presented by Night Tales Loft.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[{\"id\":99,\"name\":\"Night Tales\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/5e2aabd2b0d5c87010fb3d64/t/5e3f17972c3202581310afa8/1581193111803/BACKGROUND+CLUBS+LIMITED+PRIVACY+AND+COOKIES+STATEMENT.pdf\",\"fb_pixel_id\":\"219310887034475\",\"ga_tracking_id\":null,\