622ff30\"},\"perm_name\":\"bbxdek-hot-box-blues-jam-19th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=256%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=0%2C154%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=602%2C0%2C845%2C1536\"},\"properties\":[],\"about\":{\"description\":\"On the 3rd Sunday of every month Jamie Williams & Laura Tuckey host the HOT BOX blues jam, featuring The Roots Collective as house band.\\n\\nThe full backline is already on stage so just rock up with your instrument, plug in and have a great time playing alongside some of the best in the business.\\n\\nThere's a place for all levels of musician, and if you don't know a plectrum from a g-String, just grab a drink and enjoy the show!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6928debd399c860001edef36\",\"name\":\"Hot Box Blues Jam\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sun 19 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T10:00:00+00:00\",\"sale_end_date\":\"2026-07-20T16:00:00+01:00\",\"sale_start_date\":\"2026-01-26T10:00:00+00:00\",\"event_start_date\":\"2026-07-20T19:00:00+01:00\",\"event_end_date\":\"2026-07-20T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":65398,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by FORM.\",\"seating\":null,\"announcement_date_unix\":1769162400,\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-20T19:00:00+01:00\",\"doors_close_