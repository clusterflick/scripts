/1836656361?i=1836656363&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ross Harding\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/25/42/9f/25429f2d-9578-fc63-2314-435e808f8ca9/mzaf_7059334940849819035.plus.aac.p.m4a\",\"track_name\":\"Revelator Blues\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3060\",\"name\":\"The Bread and Roses\",\"address\":\"The Bread and Roses, 68 Clapham Manor St, Clapham Common SW4 6DZ\",\"location\":{\"lat\":51.4664058,\"lng\":-0.13696010000001024},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-bread-and-roses-qkea\",\"accessibility\":{\"url\":\"https://www.breadandrosestheatre.co.uk/find-us.html#:~:text=The%20theatre%20is%20on%20the,up%20a%20slightly%20steep%20staircase.\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/6281d45e-e1a3-44e4-b62b-af9a47279277.jpg?rect=267%2C0%2C1066%2C1066\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/6281d45e-e1a3-44e4-b62b-af9a47279277.jpg?rect=0%2C53%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/6281d45e-e1a3-44e4-b62b-af9a47279277.jpg?rect=507%2C0%2C586%2C1066\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/scc6a027ae49?dice_id=scc6a027ae49\",\"post_competition_referral\":\"https://link.dice.fm/He24ba5b9dc0?dice_id=He24ba5b9dc0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J6795e9fd8bd?dice_id=J6795e9fd8bd\",\"post_purchase_referral\":\"https://link.dice.fm/xf8f1740849f?dice_id=xf8f1740849f\",\"post_reminder_referral\":\"https://link.dice.fm/V42e53bdaf69?dice_id=V42e53bdaf69\",\"post_waitinglist_referral\":\"https://link.dice.fm/w1fef9221ff1?dice_id=w1fef9221ff1\"},\"is_hidden_event\":false,\"secondary_status\":\"rescheduled\",\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:83\",\"properties\":[],\"presented_by\":\"Presented by The Bread and Roses.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767916800,\"id\":\"695fd1ea7d3c8900011b3f49\",\"name\":\"Ross Harding Dark Blues Night\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Ross Harding is a South African-born, UK-based Dark Blues artist, known for his powerful voice, raw emotion, and masterful guitar work.\\n\\nBlending the grit of rock with the soul of the blues, Ross channels the ghosts of the Delta through a modern, darkly cinematic sound.\\n\\nDescribed as possessing “a remarkable dark and moving depth — cracked, soulful and incredibly emotive”, Ross has been featured in Blues Rock Review, Kerrang!, and other international publications.\\n\\nHaving performed at major festivals such as The Great British Rhythm & Blues Festival, and collaborated with global brands like Coca-Cola and The Reach For A Dream Foundation, he has carved out a reputation as one of the most authentic new voices in modern blues.\\n\\nFrom intimate acoustic performances to high-voltage full-band shows, Ross creates a live experience that’s both haunting and unforgettable — a sound he calls his Dark Blues Revival.\\n\\n“My music explores the darker edges of the blues – where soul meets the shadow, depth & catharsis.”\\n\\n— Ross Harding\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"141989\",\"name\":\"The Bread and Roses\",\"image\":{\"url\":null},\"perm_name\":\"the-bread-and-roses-xpbnm\",\"profile_active\":false},\"date_unix\":1775930400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2900,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-04-11T19:00:00+01:00\",\"sale_start_date\":\"2025-11-18T12:00:00+00:00\",\"event_start_date\":\"2026-04-11T19:00:00+01:00\",\"event_end_date\":\"2026-04-11T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"2w7rmo-smoove-turrell-11th-apr-the-jazz-cafe-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":58432,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Smoove & Turrell\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb6fddf6f2a2e5d3946cdaf8f6\"},\"artist_id\":\"8016\",\"about\":null,\"is_headliner\":false},{\"name\":\"Smith & Liddle\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc53caaaca4bf9c5e4ccda50c\"},\"artist_id\":\"127783\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shoppi