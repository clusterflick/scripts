4%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=602%2C0%2C845%2C1536\"},\"id\":\"6928debc399c860001bd2cc2\",\"name\":\"Hot Box Blues Jam\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"On the 3rd Sunday of every month Jamie Williams & Laura Tuckey host the HOT BOX blues jam, featuring The Roots Collective as house band.\\n\\nThe full backline is already on stage so just rock up with your instrument, plug in and have a great time playing alongside some of the best in the business.\\n\\nThere's a place for all levels of musician, and if you don't know a plectrum from a g-String, just grab a drink and enjoy the show!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-04-19T16:00:00+01:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-04-19T15:30:00+01:00\",\"event_end_date\":\"2026-04-19T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Greg Wilson\",\"image\":null,\"artist_id\":\"992\",\"about\":{\"description\":\"Manchester DJ and producer Greg Wilson is an innovator in dance music. A pioneer of ’70s and ’80s electro-funk, he was the first DJ to mix live on UK television, and one of the first DJs at The Hacienda. He founded multimedia label Super Weird Substance in 2014, and continues to play his soulful electronic sets internationally.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"