e_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1761588000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Lfe637dbaf5b?dice_id=Lfe637dbaf5b\",\"post_competition_referral\":\"https://link.dice.fm/w8fcc8a448eb?dice_id=w8fcc8a448eb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Cb348dd42e5e?dice_id=Cb348dd42e5e\",\"post_purchase_referral\":\"https://link.dice.fm/j932b6c28c7d?dice_id=j932b6c28c7d\",\"post_reminder_referral\":\"https://link.dice.fm/gea1da2a7e1a?dice_id=gea1da2a7e1a\",\"post_waitinglist_referral\":\"https://link.dice.fm/z5b2ce25bd3e?dice_id=z5b2ce25bd3e\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":5253,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Sonido Clandestino.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"8ekwo7-antonio-orozco-5th-mar-scala-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:38\",\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Antonio Orozco\",\"image\":null,\"artist_id\":\"68128\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Antonio Orozco is one of the brightest and most talented artists on the Spanish music scene. His hard work and artistic sensitivity have made him an artist whose influence has transcended borders and made him an international benchmark for Spanish-language music.\\n\\nWith more than 1,500,000 albums sold, 1 diamond record, 9 platinum records, and numerous gold records, Antonio Orozco is one of the most successful and beloved artists in Spanish music. Winner of the 2003 Ondas Award for Best Live Artist, he has been nominated for a Latin GRAMMY® award among the world's best composers for his song \\\"Estoy hizo de pedacitos de ti.\\\"\\n\\nSince his beginnings, success and accolades have marked an unstoppable career with 12 albums, more than 2,500 concerts in Spain, Europe, and Latin America. Antonio Orozco has been number 1 in Spain, Venezuela, Colombia, Puerto Rico, and Ecuador, and reached the top ten in Argentina, the United States, and Mexico, among other countries.\\n\\nAntonio Orozco returns to the stage in 2025 with La Gira de Mi Vida, a project that will feature songs from his upcoming album and commemorate his 25-year musical career. This tour will tour the most prestigious venues with a show that will combine songs from his upcoming album with his greatest hits.\\n\\n(ESP)\\n\\nAntonio Orozco es uno de los artistas más brillantes y con más talento del panorama musical en nuestro país. Su capacidad de trabajo y sensibilidad artística, le convierten en un artista cuya proyección ha traspasado fronteras y le convierten en un referente internacional de la música en español.\\n\\nCon más de 1.500.000 discos vendidos, 1 disco de diamante, 9 discos de platino y numerosos de oro, Antonio Orozco es uno de los artistas más laureados y queridos de nuestra música. Ganador del Premio Ondas 2003 al Mejor Artista en Directo, ha sido nominado a los Latin GRAMMY® entre los mejores compositores del mundo por su canción “Estoy hecho de pedacitos de ti”.\\n\\nDesde sus inicios, los éxitos y reconocimientos han marcado una carrera imparable con más de 2.500 conciertos en España, Europa y Latinoamérica. Antonio Orozco ha sido número #1 en España, Venezuela, Colombia, Puerto Rico, Ecuador y alcanzado los primeros puestos del Top #10 en Argentina, Estados Unidos y México, entre otros países.\\n\\nAntonio Orozco regresa a los escenarios en 2025 con La Gira de Mi Vida, un proyecto que presentará las canciones de su próximo álbum y conmemora sus 25 años de trayectoria musical. Este tour recorrerá los escenarios más prestigiosos con un espectáculo que combinará las canciones de su próximo álbum con sus grandes éxitos.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-08T12:00:00+01:00\",\"sale_end_date\":\"2026-03-05T18:00:00+00:00\",\"sale_start_date\":\"2025-09-08T12:00:00+01:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68bf038f92533300015e4158\",\"name\":\"Antonio Orozco\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-08/9f9b904d-3906-41d3-870c-b64de5632b57.jpg?rect=0%2C37%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-08/9f9b904d-3906-41d3-870c-b64de5632b57.jpg?rect=0%2C488%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-08/9f9b904d-3906-41d3-870c-b64de5632b57.jpg?rect=235%2C0%2C1031%2C1875\"},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1757329200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/x32fa67ea81d?dice_id=x32fa67ea81d\",\"post_competition_referral\":\"https://link.dice.fm/d3f04f64250d?dice_id=d3f04f64250d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W9cc26215836?dice_id=W9cc26215836\",\"post_purchase_referral\":\"https://link.dice.fm/A2027ecb4ad6?dice_id=A2027ecb4ad6\",\"post_reminder_referral\":\"https://link.dice.fm/cc1bc6c89709?dice_id=cc1bc6c89709\",\"post_waitinglist_referral\":\"https://link.dice.fm/vae17ca124c9?dice_id=vae17ca124c9\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":1824,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Crosstown Concerts.\",\"is_ticket_available_at_door\":false,\"attend