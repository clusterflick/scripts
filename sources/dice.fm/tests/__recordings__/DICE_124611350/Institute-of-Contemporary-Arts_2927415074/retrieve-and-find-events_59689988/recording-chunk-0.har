urchase_referral\":\"https://link.dice.fm/bdc1d70299f3?dice_id=bdc1d70299f3\",\"post_reminder_referral\":\"https://link.dice.fm/ab66ce6cc7e7?dice_id=ab66ce6cc7e7\",\"post_waitinglist_referral\":\"https://link.dice.fm/T3727e894522?dice_id=T3727e894522\"},\"perm_name\":\"92ao8o-is-this-it-a-25th-birthday-party-a-strokes-clubnight-31st-jul-moth-club-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/a3aa54c8-eca6-45a7-8dcd-4c0da994d529.jpg?rect=0%2C19%2C768%2C767\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/a3aa54c8-eca6-45a7-8dcd-4c0da994d529.jpg?rect=0%2C250%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/a3aa54c8-eca6-45a7-8dcd-4c0da994d529.jpg?rect=120%2C0%2C528%2C960\"},\"properties\":[],\"about\":{\"description\":\"Get your Converse and skinny jeans on, it's this century's greatest records' 25th birthday party!\\n\\nExpect to also hear:\\n\\nArctic Monkeys Beastie Boys Bloc Party The Bravery The Cribs Dirty Projectors Editors Franz Ferdinand The Fratellis The Hives Interpol Jet Jonathan Fire\\\\*Eater Kasabian The Killers Kings of Leon LCD Soundsystem Liars The Libertines MGMT The Modern Lovers The Moldy Peaches Mooney Suzuki The National Parquet Courts The Ramones The Rapture Regina Spektor Ryan Adams The Strokes TV on the Radio The Vaccines Vampire Weekend The Velvet Underground T\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698aff75a14a3b000194f359\",\"name\":\"Is This It - A 25th Birthday Party -  A Strokes Clubnight \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Fri 31 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T10:00:00+00:00\",\"sale_end_date\":\"2026-08-01T17:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-08-01T18:00:00+01:00\",\"event_end_date\":\"2026-08-01T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":true,\"faqs\":[{\"id\":73274,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73275,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73276,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[{\"ticket_type_id\":1182350,\"extra_ids\":[\"1188933\"]}],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Underworld.\",\"seating\":null,\"announcement_date_unix\":1770199200,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-01T18:00:00+01:00\",\"doors_close_date\":\"2026-08-01T22:00:00+01:00\"}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:85\",\"date_unix\":1785603600,\"price\":{\"currency\":\"GBP\",\"amount\":2987,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/ibe1970a76c7?dice_id=ibe1970a76c7\",\"post_competition_referral\":\"https://link.dice.fm/G6832ac082c2?dice_id=G6832ac082c2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Pbd791307476?dice_id=Pbd791307476\",\"post_purchase_referral\":\"https://link.dice.fm/ub8eaabfde60?dice_id=ub8eaabfde60\",\"post_reminder_referral\":\"https://link.dice.fm/k94a17d6961f?dice_id=k94a17d6961f\",\"post_waitinglist_referral\":\"https://link.dice.fm/ve056b301aa8?dice_id=ve056b301aa8\"},\"perm_name\":\"rynelw-life-of-agony-1st-aug-the-underworld-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/b1cc98dd-fdec-427f-b98d-e5b3ad09c893.jpg?rect=413%2C0%2C1800%2C1800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/b1cc98dd-fdec-427f-b98d-e5b3ad09c893.jpg?rect=0%2C113%2C2625%2C1575\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/b1cc98dd-fdec-427f-b98d-e5b3ad09c893.jpg?rect=818%2C0%2C990%2C1800\"},\"properties\":[],\"about\":{\"description\":\"New York, NY — This August, Life of Agony returns to the United Kingdom for four special nights celebrating the dynamic contrast that defined their early career — performing songs from their landmark albums River Runs Red and Ugly in a set crafted to showcase the band’s full emotional and sonic range.\\n\\nOn one side stands River Runs Red: heavy, energetic, and groove-driven — a groundbreaking debut powered by urgency and raw emotional release. On the other is Ugly: darker, brooding, and sludgier, capturing a band boldly expanding its sound while leaning into atmosphere and emotional weight. Together, these records form a creative yin and yang that helped redefine the bands career.\\n\\nAlthough Life of Agony brought their celebrated “30 Years of Ugly” anniversary performances across Europe last year, the run did not include the UK. These newly announced dates mark the first opportunity for UK fans to experience many of Ugly’s fan favorites performed live.\\n\\n“These records represent two very different sides of Life of Agony,” the band says. “River Runs Red came from a place of fire and intensity, while Ugly explored a darker, more introspective direction for us. Pulling songs from both albums allows us to build a set that reflects the full range of who we were in the early 90s — and still are. UK crowds have always been incredible to us, and we’re really looking forward to finally bringing these special shows your way.”\\n\\n.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"id\":\"697cb6104e08670001867ba8\",\"name\":\"LIFE OF AGONY\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"River Runs Red\",\"redirect_url\":\"https://open.spotify.com/track/5WmSYclkYNnon45HYYgdqH\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9e5905729ac307089ba8b2f415082809d8d54310?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"River Runs Red\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Life of Agony\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-04-18/992f2298-0216-4d39-850b-3cd96288791b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"28926\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sat 01 Aug\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-12T17:00:00+01:00\",\"sale_end_date\":\"2026-08-02T12:00:00+01:00\",\"sale_start_date\":\"2025-08-12T17:00:00+01:00\",\"event_start_date\":\"2026-08-02T12:00:00+01:00\",\"event_end_date\":\"2026-08-02T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Jazz Cafe Festival\",\"seating\":null,\"announcement_date_unix\":1755014400,\"venues\":[{\"id\":\"7723\",\"name\":\"Burgess Park\",\"address\":\"Albany Rd, London SE5 0AL, UK\",\"location\":{\"lat\":51.4853951,\"lng\":-0.0816664},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"burgess-park-onla\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-02T12:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"2615\",\"name\":\"Columbo Star\",\"image\":{\"url\":null},\"perm_name\":\"columbo-star-mopw\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:86\",\"date_unix\":1785668400,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3850},\"social_links\":{\"event_share\":\"https://link.dice.fm/v0ea19deb055?dice_id=v0ea19deb055\",\"post_competition_referral\":\"https://link.dice.fm/D697a4950eb9?dice_id=D697a4950eb9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P2e580e51802?dice_id=P2e580e51802\",\"post_purchase_referral\":\"https://link.dice.fm/Qb92a9e3edcf?dice_id=Qb92a9e3edcf\",\"post_reminder_referral\":\"https://link.dice.fm/gc81c6a4ea3c?dice_id=gc81c6a4ea3c\",\"post_waitinglist_referral\":\"https://link.dice.fm/W95afc1e0326?dice_id=W95afc1e0326\"},\"perm_name\":\"v3kgg6-jazz-cafe-festival-2026-ari-lennox-2nd-aug-burgess-park-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/129d254b-e1d1-4b3f-9167-25712dc7976d.jpg?rect=0%2C300%2C2400%2C2400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/129d254b-e1d1-4b3f-9167-25712dc7976d.jpg?rect=0%2C780%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/129d254b-e1d1-4b3f-9167-25712dc7976d.jpg?rect=375%2C0%2C1650%2C3000\"},\"properties\":[],\"about\":{\"description\":\"After a sellout 2025 show, Jazz Cafe Festival returns Sunday 2nd August 2026.\\n\\nOnce again, we bring the spirit of the Jazz Cafe back to an outdoor celebration of music in London.\\n\\n\\\\--------------------------------------------------------------\\n\\n𝗩𝗜𝗣 𝗧𝗶𝗰𝗸𝗲𝘁𝘀\\n\\nFor those seeking an elevated experience, VIP tickets are available offering exclusive queue jump and VIP lounge where you can access a premium bar with bespoke drink selections, a designated chill out space, private viewing area of the stage close to the artists and VIP toilet access.\\n\\n\\\\--------------------------------------------------------------\\n\\n𝗔𝗰𝗰𝗲𝘀𝘀𝗶𝗯𝗶𝗹𝗶𝘁𝘆 𝗤𝘂𝗲𝗿𝗶𝗲𝘀 & 𝗣𝗲𝗿𝘀𝗼𝗻𝗮𝗹 𝗔𝘀𝘀𝗶𝘀𝘁𝗮𝗻𝘁 𝗧𝗶𝗰𝗸𝗲𝘁𝘀\\n\\nWe strive to make Jazz Cafe Festival accessible to everyone who would like to attend. If you have any specific queries about accessibility or would like to apply for a Personal Assistant ticket, please email us at burgessparkevents@columbostar.com.\\n\\n\\\\---------------------------------------------------------------\\n\\n𝗧𝗶𝗰𝗸𝗲𝘁𝘀 𝗙𝗼𝗿 𝗚𝗼𝗼𝗱\\n\\nWe also work with Tickets For Good to provide tickets to NHS & Charity workers at a discount. You can check if you qualify & grab these via their website.\\n\\n\\\\---------------------------------------------------------------\\n\\n𝗦𝘁𝗼𝗿𝗮𝗴𝗲\\n\\nWe have on-site storage for your valuables or things that you'd just rather not carry around all day.\\n\\n𝗦𝗺𝗮𝗹𝗹 𝗜𝘁𝗲𝗺 𝗕𝗼𝘅𝗲𝘀 (15cm x 20cm x 10cm)\\n\\nIdeal for storing your car keys, wallets and phones etc so that you don't have to carry them on you all day.\\n\\nYou will be given a wrist band to allow you to collect items from staff.\\n\\n𝗦𝘁𝗼𝗿𝗮𝗴𝗲 𝗟𝗼𝗰𝗸𝗲𝗿 (45cm x 24.5cm x 28cm)\\n\\nIdeal for storing one back pack, coats, jumper etc that you don't want to carry around all day.\\n\\nThese lockers are not undercover and are not watertight. You get your own locker with a built in combination lock and a wrist band to gain access to the locker area and can come and go as you please.\\n\\n𝗕𝗶𝗴 𝗕𝗮𝗴 𝗗𝗿𝗼𝗽\\n\\nIdeal for storing larger bags/multiple bags that you don't need to access until home time. The big bag drop is under cover and we store your items away for the duration of the event.\\n\\nYou will be given a wrist band to allow you to collect items from our staff.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"689b68f6b2121a000191e5f5\",\"name\":\"Jazz Cafe Festival 2026: Ari Lennox\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":8,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-01T00:00:00+00:00\",\"sale_end_date\":\"2026-08-02T10:00:00+01:00\",\"sale_start_date\":\"2026-02-04T12:00:00+00:00\",\"event_start_date\":\"2026-08-02T14:00:00+01:00\",\"event_end_date\":\"2026-08-02T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Junction 2.\",\"seating\":null,\"announcement_date_unix\":1769904000,\"venues\":[{\"id\":\"423\",\"name\":\"Boston Manor Park\",\"address\":\"TW8 9JX\",\"location\":{\"lat\":51.492341,\"lng\":-0.318606400000021},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"boston-manor-park-jopg\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-02T14:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"o