d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"shame\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-03/174768f1-0937-4cff-8910-49335e97e79d.jpg?rect=1585%2C0%2C4000%2C4000\"},\"artist_id\":\"1623\",\"about\":null,\"is_headliner\":false},{\"name\":\"Jessica Winter\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-03/bf194102-6c5e-41bc-af9d-f81513408c42.jpg?rect=0%2C4%2C851%2C851\"},\"artist_id\":\"11409\",\"about\":null,\"is_headliner\":false},{\"name\":\"casual smart\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba9915326db5c529177838b4a\"},\"artist_id\":\"110083\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"about\":{\"description\":\"Tuck into your first slice of GM26 with our line-up launch party at The Lexington.\\n\\nBefore they reach the mountains of Green Man 2026, there’ll be blistering sets from the incendiary **Shame** whose critically acclaimed fourth album has cemented them as stalwarts of their raw and uncompromising craft. Plus **Jessica Winter** will entrance with her very own brand of gothic, synth pop musicality. And Cardiff 5 piece, **Casual Smart** promise to turn expectation on its head with their quietly confounding post-rock songs.\\n\\nOn the night we’ll have a raffle to win x2 GM26 tickets, as well as a host of DJ folks to keep the good time flowing long into the night. Enjoy your first flavour of GM26, we’ll be back soon with the full line-up!\\n\\nBig love, GM x\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T15:00:00+00:00\",\"sale_end_date\":\"2026-03-05T17:00:00+00:00\",\"sale_start_date\":\"2026-02-12T15:00:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698d8b8350ddaa0001db8842\",\"name\":\"Green Man Line-Up Launch Party\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/dde2421c-1c6e-44fe-9a11-b4693ae54b5d.jpg?rect=0%2C0%2C4500%2C4500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/dde2421c-1c6e-44fe-9a11-b4693ae54b5d.jpg?rect=0%2C1463%2C4500%2C2700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/dde2421c-1c6e-44fe-9a11-b4693ae54b5d.jpg?rect=703%2C0%2C3094%2C5625\"},\"marketeers\":[{\"id\":1752,\"name\":\"Green Man\",\"privacy_policy_link\":\"https://www.greenman.net/information/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770908400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/i955a3ebefc0?dice_id=i955a3ebefc0\",\"post_competition_referral\":\"https://link.dice.fm/h5e709c473d1?dice_id=h5e709c473d1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wa8d292cedec?dice_id=wa8d292cedec\",\"post_purchase_referra