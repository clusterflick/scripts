bour  \\n  \\nMelodic Alt Rock from Kent  \\n  \\n  \\n  \\nwith support from  \\n  \\n  \\n  \\nMy Only Escape  \\n  \\nPost-Hardcore/Emo band from London  \\n  \\nhttps://hypeddit.com/myonlyescape/nuclearwinter  \\n  \\n  \\n  \\n& Special guest TBA\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:24\",\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"presented_by\":\"Presented by New Cross Live.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Seek Harbour\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb19faa0cacf08525160825159\"},\"artist_id\":\"134137\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1770742800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T17:00:00+00:00\",\"sale_end_date\":\"2026-03-20T17:00:00+00:00\",\"sale_start_date\":\"2026-02-10T17:00:00+00:00\",\"event_start_date\":\"2026-03-22T18:00:00+00:00\",\"event_end_date\":\"2026-03-22T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6993260f93c7220001effabd\",\"name\":\"Seek Harbour\",\"price\":{\"currency\":\"GBP\",\"amount\":770,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Seek Harbour - Far From Home\",\"redirect_url\":\"https://music.apple.com/us/album/far-from-home/1614312448?i=1614312451&uo=4&at=1001ld8Z&ct=app_event\",\"arti