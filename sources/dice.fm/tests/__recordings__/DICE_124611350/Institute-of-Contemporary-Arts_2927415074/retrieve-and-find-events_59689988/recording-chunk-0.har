et/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:83\",\"date_unix\":1775152800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2856},\"social_links\":{\"event_share\":\"https://link.dice.fm/H50c920eedf4?dice_id=H50c920eedf4\",\"post_competition_referral\":\"https://link.dice.fm/p5cd1c5c1f54?dice_id=p5cd1c5c1f54\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c600733017ee?dice_id=c600733017ee\",\"post_purchase_referral\":\"https://link.dice.fm/n47718ce4ef7?dice_id=n47718ce4ef7\",\"post_reminder_referral\":\"https://link.dice.fm/bb23904aafb3?dice_id=bb23904aafb3\",\"post_waitinglist_referral\":\"https://link.dice.fm/Xfa21d25ffd0?dice_id=Xfa21d25ffd0\"},\"perm_name\":\"bb3d3g-arlo-parks-special-album-launch-show-2nd-apr-fabric-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/1d570d94-663d-4608-8779-332b63eb2f61.jpg?rect=749%2C0%2C3070%2C3070\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/1d570d94-663d-4608-8779-332b63eb2f61.jpg?rect=0%2C165%2C4568%2C2741\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/1d570d94-663d-4608-8779-332b63eb2f61.jpg?rect=1440%2C0%2C1689%2C3070\"},\"properties\":[],\"about\":{\"description\":\"Rough Trade is very excited to present a live outstore performance from Arlo Parks at fabric, London. This unique event celebrates the release of their new album 'Ambiguous Desire' released via Transgressive.\\n\\nThis is an 18+ event.\\n\\nGeneral Admission tickets do NOT come with an album.\\n\\nPlease note this is an album release show so performances are usually around 45min.\\n\\nAll CD/LP purchases will be shipped at release from 3rd April via Second Class Mail. Please note we can only ship to the UK so sales for this event are strictly restricted to this territory.\\n\\nTicket transfer will be off for this event to avoid any shipping issues. Please purchase separate tickets if you're not planning to attend together.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com › products › ambiguous-desire\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6967b0e0aeaf9700019b1c07\",\"name\":\"Arlo Parks: Special Album Launch Show\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Eugene\",\"redirect_url\":\"https://open.spotify.com/track/0sT4slW2xWai3EwVSiuL9Y\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/743be888e9496cb2e933e22ee941a11464b719c6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Eugene\"},{\"type\":\"apple_music\",\"title\":\"Arlo Parks - Eugene\",\"redirect_url\":\"https://music.apple.com/gb/album/eugene/1535799044?i=1535799573&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Arlo Parks\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview124/v4/89/1e/a5/891ea535-d89e-b066-d4de-24958f13cd64/mzaf_8822171644641865825.plus.aac.p.m4a\",\"track_name\":\"Eugene\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Arlo Parks\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-10/57fc6b52-a401-4f67-8ade-e28a1684dc4d.jpg?rect=0%2C0%2C4000%2C4000\"},\"artist_id\":\"13958\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T15:00:00+00:00\",\"sale_end_date\":\"2026-04-02T21:00:00+01:00\",\"sale_start_date\":\"2