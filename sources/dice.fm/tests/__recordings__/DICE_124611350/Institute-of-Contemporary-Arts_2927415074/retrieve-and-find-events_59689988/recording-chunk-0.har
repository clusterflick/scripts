"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-10T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"announced\",\"streaming_options\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:52\",\"about\":{\"description\":\"*Since Skipinnish hit the Scottish music scene in 1999, their rise has been an epic tale of a tiny acorn becoming a mighty oak! From pub gigs and ceilidhs in the beginning, their mix of anthemic songs and powering melody has seen them fill the biggest and best venues in the country. In 2024 they celebrated their 25th birthday with over 8000 fans by having a televised concert at Edinburgh Castle and in September 2025 they headlined Scotland’s biggest arena with a show at the OVO Hydro in Glasgow.*\\n\\n*In 2024 the band won “Event of the Year” at the Scottish Trad music Awards for their Edinburgh Castle concert and in 2025 they received the prestigious Sound of Scotland Award at the Nordoff and Robin Scottish Music Awards.*\\n\\n*Skipinnish has constantly evolved and grown over the years and 2026 will see some exciting additions and changes as they continue to give audiences the euphoric joy that their music brings to a huge and ever-growing fanbase.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1771236000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/99f15208-8f2b-4ce6-ae32-eee01be51fe3.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/99f15208-8f2b-4ce6-ae32-eee01be51fe3.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/99f15208-8f2b-4ce6-ae32-eee01be51fe3.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"698ee05fd030c40001c0154d\",\"name\":\"Skipinnish\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-05-10T21:00:00+01:00\",\"sale_start_date\":\"2026-02-20T10:00:00+00:00\",\"event_start_date\":\"2026-05-10T19:00:00+01:00\",\"event_end_date\":\"2026-05-10T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"wweyvp-skipinnish-10th-may-islington-assembly-hall-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_tick