ttps://dice-media.imgix.net/attachments/2025-10-13/0a2180b3-5cb9-44be-8a76-7aea9d47d4e8.jpg?rect=491%2C0%2C2645%2C2645\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-13/0a2180b3-5cb9-44be-8a76-7aea9d47d4e8.jpg?rect=0%2C171%2C3840%2C2304\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-13/0a2180b3-5cb9-44be-8a76-7aea9d47d4e8.jpg?rect=1193%2C0%2C1455%2C2645\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Ex-Easter Island Head - Norther\",\"redirect_url\":\"https://open.spotify.com/track/15VdpgtRriMTOFkmXmbyTr\",\"artist\":\"Ex-Easter Island Head\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b4ca5e2e8b9ee863e2e8abbf1cfed56eadb64d7d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Norther\"},{\"type\":\"apple_music\",\"title\":\"Ex-Easter Island Head - Norther\",\"redirect_url\":\"https://music.apple.com/us/album/norther/1725986720?i=1725986723&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ex-Easter Island Head\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/a3/fb/29/a3fb29ac-db71-3939-a6c6-ba6d469b4b29/mzaf_13458946283737321363.plus.aac.p.m4a\",\"track_name\":\"Norther\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1763035200,\"max_tickets\":6,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nEx-Easter Island Head + Rún\\n\\nIklkektic - April 27th\\n\\nEx-Easter Island Head are a UK-based experimental musical collective composing and performing music for solid body electric guitar, percussion and other instruments. The group plays multiple electric guitars augmented through mechanical preparations and extended techniques, creating hypnotic performances rich in repetition, shimmering drones and melodic invention through purposefully limited means.\\n\\nTheir records and live performances have received significant critical acclaim from the likes of The Wire, the Quietus and the New York Times. Favourably compared to the likes of Steve Reich, Glenn Branca and John Cage, the groups' music has been praised for its mixture of percussive drive, emotional warmth and playful experimentation.\\n\\nThey have performed worldwide in venues ranging from the tiny Scottish island of Iona to a 150-year-old brewery in Berlin, with major festival appearances including ATP, Supersonic and Le Guess Who? Collaborators have included the BBC Philharmonic, composer Arnold Dreyblatt and musicians Laura Cannell, Charles Hayward and Andre Bosman in the group Whistling Arrow.\\n\\nTheir library music releases Mechanical Landscapes 1 & 2 released by EMI/KPM have seen the group’s work used internationally for television and radio productions, whilst the groups’ own Large Electric Ensemble projects have seen the core quartet joining forces with forward-thinking musicians to make ambitious large scale performances across the UK and EU.\\n\\nThe group’s latest album Norther (2024) was named album of the year by Europe’s leading independent culture website, The Quietus. An interview in the same year for The Guardian described their music as “amongst the boldest experiments in British music”. In early 2025\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:37\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Bcebe13745fa?dice_id=Bcebe13745fa\",\"post_competition_referral\":\"https://link.dice.fm/B3f12d025d8b?dice_id=B3f12d025d8b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e6d28d9a0c81?dice_id=e6d28d9a0c81\",\"post_purchase_referral\":\"https://link.dice.fm/J29ac15ce96c?dice_id=J29ac15ce96c\",\"post_reminder_referral\":\"https://link.dice.fm/c36708023760?dice_id=c36708023760\",\"post_waitinglist_referral\":\"https://link.dice.fm/pe6ec411540b?dice_id=pe6ec411540b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T12:00:00+00:00\",\"sale_end_date\":\"2026-04-27T18:00:00+01:00\",\"sale_start_date\":\"2025-11-13T12:00:00+00:00\",\"event_start_date\":\"2026-04-27T19:30:00+01:00\",\"event_end_date\":\"2026-04-27T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"id\":\"68e3ed4ce3870c0001cd4c6e\",\"seats_io_event_id\":null,\"name\":\"Ex-Easter Island Head + Rún\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"eowg9d-ex-easter-island-head-rn-27th-apr-iklectik-london-tickets\",\"date_unix\":1777314600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Mon 27 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_