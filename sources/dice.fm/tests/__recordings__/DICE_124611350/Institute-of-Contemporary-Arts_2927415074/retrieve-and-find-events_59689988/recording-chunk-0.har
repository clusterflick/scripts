":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-01T19:00:00+01:00\",\"doors_close_date\":\"2026-09-01T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Geese\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe9adf71fd990a4df78ed1b3d\"},\"artist_id\":\"119010\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-26/466166a5-3122-44db-9472-a4ae1259672e.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-26/466166a5-3122-44db-9472-a4ae1259672e.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-26/466166a5-3122-44db-9472-a4ae1259672e.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Geese - Taxes\",\"redirect_url\":\"https://open.spotify.com/track/7r9BUOSnekEjrkMhmxD6Ae\",\"artist\":\"Geese\",\"preview_url\":\"https://p.scdn.co/mp3-preview/80cd97f81f7406b0d144eb60ba62bc14e1340652?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Taxes\"},{\"type\":\"apple_music\",\"title\":\"Geese - Taxes\",\"redirect_url\":\"https://music.apple.com/us/album/taxes/1818548779?i=1818549167&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Geese\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/81/cc/5c/81cc5c5f-64f8-9133-c1cc-bd4fb4eb0872/mzaf_17767330612644012866.plus.aac.p.m4a\",\"track_name\":\"Taxes\"}],\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"announcement_date_unix\":1759136400,\"max_tickets\":6,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"7807377e-6cd1-4aa9-97c8-04d1b0746eb7\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"about\":{\"description\":\"New York City’s Geese return with their highly anticipated 3rd studio album, ‘Getting Killed’. After being approached by Kenneth ‘Kenny Beats’ Blume at a music festival, Geese tracked the album in his LA studio over the course of ten fast-paced days. With scant time for overdubbing, the finished project emerges as something of a chaotic comedy, shambolic in structure but passionately performed, informed by an exacting vision. Garage riffs are layered upon Ukrainian choir samples; hissing drum machines pulse softly behind screeching guitars; strange, lullaby-esque songs are interspersed with furious, repetitive experiments. With ‘Getting Killed,’ Geese balances a disarming new tenderness with an intensified anger, seemingly trading their love of classic rock for a disdain for music itself.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Metropolis.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:31\",\"social_links\":{\"event_share\":\"https://link.dice.fm/be7407cc2e0f?dice_id=be7407cc2e0f\",\"post_com