by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:41\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T10:00:00+00:00\",\"sale_end_date\":\"2026-05-16T21:00:00+01:00\",\"sale_start_date\":\"2026-02-05T10:00:00+00:00\",\"event_start_date\":\"2026-05-16T19:00:00+01:00\",\"event_end_date\":\"2026-05-16T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770285600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2350,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6981e25f79917b00012f7c8f\",\"name\":\"Test Pressing: Wally Badarou + ddwy Live\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wally Badarou\",\"image\":null,\"artist_id\":\"133471\",\"about\":null,\"is_headliner\":false},{\"name\":\"ddwy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb365775746578dc843f4ffd2c\"},\"artist_id\":\"104905\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"3owoml-test-pressing-wally-badarou-ddwy-live-16th-may-the-jazz-cafe-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/5ed3c0b5-4049-4b17-b541-08e0eeed09ba.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/5ed3c0b5-4049-4b17-b541-08e0eeed09ba.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/5ed3c0b5-4049-4b17-b541-08e0eeed09ba.jpg?rect=270%2C0%2C660%2C1200\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"A special Test Pressing takeover brings together legendary composer and synth architect Wally Badarou with London duo ddwy.\\n\\nLive performances from French-Beninese jazz-funk master Badarou, who's command of keys has shaped classics with Talking Heads, Compass Point All Stars and Grace Jones.\\n\\nDubbed-out psychedelia from ddwy, whose live sets blur dancefloor rhythm with hazy melody, earning support across NTS, BBC 6 Music and beyond.\\n\\nLabel head Apiento completes the bill guiding the journey from cosmic electronica to full-blown club pressure.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":59928,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":59929,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":59930,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":59931,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":59932,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":59933,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":59934,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":59935,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":59936,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":59937,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Hoosiers - Sleeping With The Light On\",\"redirect_url\":\"https://open.spotify.com/track/71yXCXtf6RJgKF7N4LSmH3\",