:\"049f414030f6e5e4:22\",\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oslo-hackney-je6z\",\"accessibility\":{\"url\":\"https://www.oslohackney.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"MASTERS OF THE RIFF V\\n\\n27 FEB – 1 MAR 2026\\n\\nOSLO, HACKNEY — LONDON\\n\\nLondon Doom Collective returns to Oslo Hackney for three days of riffs, fuzz, doom, sludge, heavy psych and everything in between.\\n\\nMasters of the Riff V brings together 20 bands across three days, spanning crushing sludge, cosmic doom, occult heavy rock, post-metal atmospheres and blackened intensity — underground heavy music in its purest form.\\n\\nFEATURING:\\n\\nDomkraft (SE)\\n\\nhttps://domkraft.bandcamp.com/\\n\\nElectric Citizen (US)\\n\\nhttps://electriccitizenband.bandcamp.com/\\n\\nWitchsorrow\\n\\nhttps://witchsorrow.bandcamp.com/\\n\\nViking Skull\\n\\nhttps://vikingskull.bandcamp.com/\\n\\nTons (IT)\\n\\nhttps://tonsband.bandcamp.com/\\n\\nThe Lunar Effect\\n\\nhttps://thelunareffect.bandcamp.com/\\n\\nGrin (DE)\\n\\nhttps://grincult.bandcamp.com/\\n\\nThe Grey\\n\\nhttps://thegrey2.bandcamp.com/\\n\\nK L P S (SE)\\n\\nhttps://kollapsemusic.bandcamp.com/\\n\\nDruidess\\n\\nhttps://druidessuk.bandcamp.com/\\n\\nLongheads\\n\\nhttps://longheads.bandcamp.com/\\n\\nCommoner\\n\\nhttps://commoner666.bandcamp.com/\\n\\nCalligram\\n\\nhttps://calligram.bandcamp.com/\\n\\nBear Bones\\n\\nhttps://bearbonesgang.bandcamp.com/\\n\\nSigiriya\\n\\nhttps://sigiriya.bandcamp.com/\\n\\nBelieve In Nothing\\n\\nhttps://believeinnothing.bandcamp.com/\\n\\nKing Witch\\n\\nhttps://kingwitchband.bandcamp.com/\\n\\nA Horse Called War\\n\\nhttps://ahorsecalledwar.bandcamp.com/\\n\\nSaint Karloff (SE)\\n\\nhttps://saintkarloff.bandcamp.com/\\n\\nMorag Tong\\n\\nhttps://moragtong.bandcamp.com/\\n\\nThree days. One stage. Endless riffs.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-09T12:00:00+01:00\",\"sale_end_date\":\"2026-03-01T12:00:00+00:00\",\"sale_start_date\":\"2025-06-09T12:00:00+01:00\",\"event_start_date\":\"2026-02-27T18:00:00+00:00\",\"event_end_date\":\"2026-03-01T22:30:00+00:00\",\"is_multi_days_event\":true,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68460ece098f840001b77f8a\",\"name\":\"Masters of the Riff V\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-03/5e07a51f-6af5-442d-a61f-b0e771a6b945.jpg?rect=0%2C727%2C3508%2C3508\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-03/5e07a51f-6af5-442d-a61f-b0e771a6b945.jpg?rect=0%2C1428%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-03/5e07a51f-6af5-442d-a61f-b0e771a6b945.jpg?rect=390%2C0%2C2729%2C4961\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1749466800,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/I1cc6a74cf58?dice_id=I1cc6a74cf58\",\"post_competition_referral\":\"https://link.dice.fm/jee0bba15a15?dice_id=jee0bba15a15\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ufc34b3b0afd?dice_id=Ufc34b3b0afd\",\"p