t/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-05-29T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"announcement_date_unix\":1762941600,\"social_links\":{\"event_share\":\"https://link.dice.fm/f91c01de0b74?dice_id=f91c01de0b74\",\"post_competition_referral\":\"https://link.dice.fm/U28f784e41a3?dice_id=U28f784e41a3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ebee5c118e7c?dice_id=ebee5c118e7c\",\"post_purchase_referral\":\"https://link.dice.fm/K6b9a88d5423?dice_id=K6b9a88d5423\",\"post_reminder_referral\":\"https://link.dice.fm/Yfbcae7fa8bf?dice_id=Yfbcae7fa8bf\",\"post_waitinglist_referral\":\"https://link.dice.fm/H1a9d075b281?dice_id=H1a9d075b281\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"8exlev-biird-29th-may-earth-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1780079400,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:36\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3631},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-11/17666ebe-e1dc-4cf4-87c7-51e8c459e131.jpg?rect=79%2C278%2C1997%2C1995\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-11/17666ebe-e1dc-4cf4-87c7-51e8c459e131.jpg?rect=0%2C702%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-11/17666ebe-e1dc-4cf4-87c7-51e8c459e131.jpg?rect=338%2C0%2C1485%2C2700\"},\"id\":\"690dc4e59bc812000126baa5\",\"name\":\"BIIRD\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nBIIRD are an all-female trad supergroup that have been mystifying the masses with their lively, zealous set and uncompromising dedication to Irish design since their inception last year. Bringing the trad session vibe from the corner of a pub to a global audience, their energy is unmatched. This is a sisterhood born out of a shared passion for keeping the tradition of Irish music alive, giving it a new look and keeping it on its toes. When they’re performing together, a magic flows between them, and that mix of skill and sorcery make them incomparable.\\n\\nAfter appearing on the Late Late Show in February 2025 BIIRD went on to sell out every show on their debut Irish & UK tour, including their upgraded show at Vicar St... all before even releasing any music. BIIRD then went on to play Mainstage at ATN to 15,000 adoring fans. Having recently signed up with Primary Talent as booking agents 2026 promises to be an incredible year of touring for the supergroup with an extensive Irish, UK and US tour soon to be announced, among other hugely exciting ventures.\\n\\nThe flock of BIIRDs is made up of Lisa on harp, banjo, vocals; Laura Doherty on fiddle and guitar; Zoran Donohoe on concertina; Sal Heneghan on fiddle and harp; Miadhachlughain O’Donnell on flute and vocals; Nicole Lonergan on fiddle; Niamh Hinchy on vocals and synth; Aoife Kelly on cello; Ciara Ní Mhurchú on fiddle; Hannah Hiemstra on drums; and Claire Loughran on fiddle and harp.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-12T10:00:00+00:00\",\"sale_end_date\":\"2026-05-29T21:00:00+01:00\",\"sale_start_date\":\"2025-11-17T10:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:30:00+01:00\",\"event_end_date\":\"2026-05-29T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Beth Rowley\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-14/9ab83fe2-ce8d-49a7-8f82-38baccffc52a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"5398\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"d