ountry_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sebright-arms-4mm9\",\"accessibility\":{\"url\":\"https://www.sebrightarms.com/about\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"746\",\"name\":\"Sebright Arms\",\"image\":{\"url\":null},\"perm_name\":\"sebright-arms-v3mv\",\"profile_active\":false},\"announcement_date_unix\":1770120000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ofd9f3d83929?dice_id=Ofd9f3d83929\",\"post_competition_referral\":\"https://link.dice.fm/Ted3f2163c22?dice_id=Ted3f2163c22\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/zeb372df89f5?dice_id=zeb372df89f5\",\"post_purchase_referral\":\"https://link.dice.fm/l8da14addd5b?dice_id=l8da14addd5b\",\"post_reminder_referral\":\"https://link.dice.fm/c08045bfe467?dice_id=c08045bfe467\",\"post_waitinglist_referral\":\"https://link.dice.fm/Fa411b2b915e?dice_id=Fa411b2b915e\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"2w8w9m-borokov-borokov-be-cracked-lime-22nd-apr-sebright-arms-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[{\"id\":1737,\"name\":\"Sebright Arms\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/630f3de7c213c45e2e1a26eb/t/6788e53103ae512a44d3fc44/1737024817425/Privacy+Policy+-+Sebright+Arms.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776882600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:87\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/6c533305-f044-4811-a3ac-e6d366eb2198.jpg?rect=0%2C0%2C1600%2C1600\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/6c533305-f044-4811-a3ac-e6d366eb2198.jpg?rect=0%2C320%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/6c533305-f044-4811-a3ac-e6d366eb2198.jpg?rect=360%2C0%2C880%2C1600\"},\"id\":\"6981d4f85d1567000176fc6e\",\"name\":\"Borokov Borokov (BE) + Cracked Lime\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join us for a fun night at the Sebright Arms with Belgian duo Borokov Borokov. Their music can be described as a volatile mix of angular synth pop, work-incapacitated hi-NRG, krautrock with a double “t,” birthday-acid house, supra-Freudian elektrapunk, and multilingual lamentations. On stage, Borokov Borokov’s manic intensity has lit up festivals and clubs across Europe and beyond—CTM, Fusion, MOTH Club, Eurosonic, Pukkelpop, Best Kept Secret, Paradiso, Down The Rabbit Hole, AB, Le Petit Bain, Le Sucre, boilerroom.tv and more.\\n\\nSupport from Cracked Lime + others. Cracked Lime blends post-punk sharp guitars, with electronic beats and a lingering trip-hop feel. Expect some hypnotic existentialist spoken words, melodic interventions, noisy texture and a sharp dance-y weird rhythm section.\\n\\n***\\\\*free ticket doesn't guarantee entry if we're at capacity, so get down early!\\\\****\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T12:00:00+00:00\",\"sale_end_date\":\"2026-04-22T22:30:00+01:00\",\"sale_start_date\":\"2026-02-03T12:00:00+00:00\",\"event_start_date\":\"2026-04-22T19:30:00+01:00\",\"event_end_date\":\"2026-04-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Borokov Borokov - Alles (feat. Lara Chedraoui)\",\"redirect_url\":\"https://music.apple.com/us/album/alles-feat-lara-chedraoui/1783125497?i=1783125498&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Borokov Borokov\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/f9/16/a6/f916a6d1-999b-ada4-5867-e34084b6ff41/mzaf_13113703183200540378.plus.aac.p.m4a\",\"track_name\":\"Alles (feat. Lara Chedraoui)\"},{\"type\":\"spotify\",\"title\":\"Borokov Borokov - Alice\",\"redirect_url\":\"https://open.spotify.com/track/5Vl2ZUPLWCUriB7aQqwyZy\",\"artist\":\"Borokov Borokov\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2934d1f31af6fefa3c1004e24dc9ff167c42f41b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Alice\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Midori Jaeger\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb6078d807d38d0882bb1432a0\"},\"artist_id\":\"75137\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Serious.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"644\",\"name\":\"St Pancras Old Church\",\"address\":\"Pancras Road, London NW1 1UL\",\"location\":{\"lat\":51.5351939,\"lng\":-0.131893999999988},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"st-pancras-old-church-dklo\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1432\",\"name\":\"Serious\",\"image\":{\"url\":null},\"perm_name\":\"serious-nyo9\",\"profile_active\":true},\"announcement_date_unix\":1770120000,\"social_links\":{\"event_share\":\"https://link.dice.fm/y491aa770122?dice_id=y491aa770122\",\"post_competition_referral\":\"https://link.dice.fm/ec1b7783e479?dice_id=ec1b7783e479\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hec6e68902a8?dice_id=hec6e68902a8\",\"post_purchase_referral\":\"https://link.dice.fm/g19e7d44af44?dice_id=g19e7d44af44\",\"post_reminder_referral\":\"https://link.dice.fm/q0761f930d93?dice_id=q0761f930d93\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ba5176ec6875?dice_id=Ba5176ec6875\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yo6qgx-midori-jaeger-22nd-apr-st-pancras-old-church-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1446,\"name\":\"Serious\",\"privacy_policy_link\":\"https://serious.org.uk/serious-ticketing-t-cs\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776882600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:88\",\"price\":{\"currency\":\"GBP\",\"amount\":1888,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/cca6ca51-e952-4d24-9251-3d666ddde256.jpg?rect=0%2C1261%2C4096%2C4096\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/cca6ca51-e952-4d24-9251-3d666ddde256.jpg?rect=0%2C1843%2C4096%2C2458\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/cca6ca51-e952-4d24-9251-3d666ddde256.jpg?rect=359%2C0%2C3379%2C6144\"},\"id\":\"697cf513a809c50001ce140e\",\"name\":\"midori jaeger\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Cellist, composer and vocalist midori jaeger launches her upcoming EP (Un)planted with a full-band performance in the intimate surroundings of St Pancras Old Church.\\n\\nmidori jaeger has toured the UK and Europe as a solo artist, with performances at Union Chapel, Queen Elizabeth Hall and EartH Hackney, and has travelled the world as a collaborative musician, appearing at Berliner Philharmonie, Royal Albert Hall, Barbican Hall and Royal Festival Hall. This show marks a special moment: an intimate unveiling of new music that brings her story, sound and band together in one space.\\n\\nBorn in Japan and raised partly in the UK, midori returned to Tokyo at sixteen before moving alone to London two years later. Each relocation was a replanting - a search for new soil. With family in Tokyo and New York and no fixed roots in the UK, she found her sense of home through music.\\n\\n(Un)planted is a musical painting of midori’s uprooting. Like the cello that was once a tree unplanted from its soil, the music depicts her own journey of uprooting through the multiplicities of mixed heritage, sexuality, growing up across different continents, partneredness, aloneness, to an eventual replanting and rootedness in the earth. (Un)planted is the first part of a two-part EP. The counterpart (Re)planted is due summer 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T12:00:00+00:00\",\"sale_end_date\":\"2026-04-22T19:30:00+01:00\",\"sale_start_date\":\"2026-02-03T12:00:00+00:00\",\"event_start_date\":\"2026-04-22T19:30:00+01:00\",\"event_end_date\":\"2026-04-22T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dear Nora\",\"image\":null,\"artist_id\":\"58051\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Upset The Rhythm.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72814,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"34\",\"name\":\"Upset The Rhythm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/42ef555c-26cf-421b-b66e-2030c1977b0c.jpg\"},\"perm_name\":\"upset-the-rhythm-z8e2\",\"profile_active\":true},\"announcement_date_unix\":1769615100,\"social_links\":{\"event_share\":\"https://link.dice.fm/Uc54180ae8de?dice_id=Uc54180ae8de\",\"post_competition_referral\":\"https://link.dice.fm/Se8ad481c352?dice_id=Se8ad481c352\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g5f71c91181f?dice_id=g5f71c91181f\",\"post_purchase_referral\":\"https://link.dice.fm/j822a97ffa70?dice_id=j822a97ffa70\",\"post_reminder_referral\":\"https://link.dice.fm/h5e55e285b37?dice_id=h5e55e285b37\",\"post_waitinglist_referral\":\"https://link.dice.fm/Yd7bc0f2b86b?dice_id=Yd7bc0f2b86b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k6a5l9-dear-nora-tai-haf-heb-drigolyn-22nd-apr-the-lexington-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":20,\"name\":\"Upset The Rhythm\",\"privacy_policy_link\":\"http://www.upsettherhythm.co.uk/privacypolicy.html http://www.upsettherhythm.co.uk/privacypolicy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776882600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:89\",\"price\":{\"currency\":\"GBP\",\"amount\":1377,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/c80633d4-bfa0-493c-98e9-f4c970619c22.jpg?rect=504%2C0%2C3024%2C3024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/c80633d4-bfa0-493c-98e9-f4c970619c22.jpg?rect=0%2C303%2C4032%2C2419\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/c80633d4-bfa0-493c-98e9-f4c970619c22.jpg?rect=1185%2C0%2C1663%2C3024\"},\"id\":\"697a2e7135a66500013aa620\",\"name\":\"Dear Nora + Tai Haf Heb Drigolyn\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"DEAR NORA is an ever-evolving indie-pop band fronted by songwriter/producer Katy Davidson, and features a rotating cast of collaborators. Davidson was born in Arizona and has also lived in Oregon and California. The energy, intensity, and vastness of the western United States landscape imbue the songwriting and recordings.\\n\\nDear Nora has existed in two distinct eras – 1999-2008 and 2017-present – with roughly a decade break in the middle (the “Lost Years”) in which Davidson fronted various side projects, and played session guitar/keyboards in the bands YACHT and Gossip. Dear Nora’s early music leans more pop-punk, DIY, confessional, youthful. The contemporary music leans more poetic, expansive, genre-bending, wise. The through-lines between Dear Nora’s two eras are: melodic hooks, vocal harmonies, and lyrics about time, space, capitalism, the internet, daily life vérité, ancient things, real vs. unreal or surreal, and all kinds of relationships.\\n\\nPartially because Dear Nora’s early years happened before the rise of smartphones and social media (prior to hyper digital documentation), and because very little content survives this era aside from the analog recordings, the group is often described as “legendary\\\" (as in, \\\"legend/myth\\\"). Rediscovered via streaming platforms and word of mouth, Dear Nora’s music has influenced many young songwriters.\\n\\nhttps://dearnora.bandcamp.com/\\n\\nTAI HAF HEB DRIGOLYN are a band from Wales. Built atop of a DIY Ethos, THHD have a fantastic ability to merge their musical brain with real life surroundings, perfectly represented by “Ein Albwm Cyntaf Ni” recorded straight onto tape directly sampling the sounds that they recorded over. It’s rare that music so genuine and human arrives with this quality and quantity; this is a special act that has to be seen to be believed. THHD are obsessed with the elephant 6 collective, and as such has members spread across the country, they also stumble after the footsteps of R. Pollard and D. R. Edwards.\\n\\nhttps://taihafhebdrigolyn.bandcamp.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T15:45:00+00:00\",\"sale_end_date\":\"2026-04-22T18:00:00+01:00\",\"sale_start_date\":\"2026-01-28T15:45:00+00:00\",\"event_start_date\":\"2026-04-22T19:30:00+01:00\",\"event_end_date\":\"2026-04-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dear Nora - 'Round and 'Round\",\"redirect_url\":\"https://music.apple.com/us/album/round-and-round/1469594796?i=1469594798&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dear Nora\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/b4/04/5c/b4045c95-3744-1b5d-5e5e-7cd3c0c1fd54/mzaf_14898285950448811441.plus.aac.p.m4a\",\"track_name\":\"'Round and 'Round\"},{\"type\":\"spotify\",\"title\":\"Dear Nora - 'Round and 'Round\",\"redirect_url\":\"https://open.spotify.com/track/0sVgWAiL6EszHW3mEWKOVf\",\"artist\":\"Dear Nora\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8b5de3c77c2388fd94a111668dc95746ced2ce9f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"'Round and 'Round\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by FIGURA and Stone Nest.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":72403,\"title\":\"Accessibility\",\"body\":\"Stone Nest is an old building and unfortunately can only accommodate manually operated wheelchairs via a temporary ramp; please contact info@stonenest.org if you require this.\\n\\nThere is no step-free access to the balcony.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"8447\",\"name\":\"Stone Nest\",\"address\":\"136 Shaftesbury Avenue, Westminster, London, W1D 5EZ, United Kingdom\",\"location\":{\"lat\":51.512639,\"lng\":-0.130313},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-06/89702479-c64c-403b-9130-a67d97e6979d.jpg?rect=3%2C0%2C768%2C768\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"stone-nest-oqgm\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"10793\",\"name\":\"Stone Nest\",\"image\":{\"url\":null},\"perm_name\":\"stone-nest-emyy\",\"profile_active\":false},\"announcement_date_unix\":1769527800,\"social_links\":{\"event_share\":\"https://link.dice.fm/r8168f15ef87?dice_id=r8168f15ef87\",\"post_competition_referral\":\"https://link.dice.fm/Pa4936a46604?dice_id=Pa4936a46604\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P6ffe4301bad?dice_id=P6ffe4301bad\",\"post_purchase_referral\":\"https://link.dice.fm/l78fc502a226?dice_id=l78fc502a226\",\"post_reminder_referral\":\"https://link.dice.fm/q6d56cf3a2cb?dice_id=q6d56cf3a2cb\",\"post_waitinglist_referral\":\"https://link.dice.fm/V795d36d02a0?dice_id=V795d36d02a0\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"oeg7lm-figura-presents-fujita-22nd-apr-stone-nest-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776882600,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:90\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1900},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/0e2e183e-e91d-4eeb-b6fd-b9aaae4787fb.jpg?rect=376%2C0%2C2208%2C2208\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/0e2e183e-e91d-4eeb-b6fd-b9aaae4787fb.jpg?rect=0%2C217%2C2959%2C1775\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/0e2e183e-e91d-4eeb-b6fd-b9aaae4787fb.jpg?rect=873%2C0%2C1214%2C2208\"},\"id\":\"6978a1a1a303e80001d9e67f\",\"name\":\"FIGURA presents: FUJI|||||||||||TA\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"FIGURA is an independent cultural producer creating live events and performances that bring together music, sound and contemporary art, working closely with artists and venues to deliver carefully produced shows.\\n\\nFor this event, they present FUJI|||||||||||TA (Yosuke Fujita), a Japan-based sound artist and composer who hand-built his own pipe organ and works with air as a physical, acoustic material rather than a 'traditional' instrument. His performance is quiet in presence and intensely focused - a calm, immersive set built from organ pipes, breath/air pressure and subtle rhythmic shifts, designed to make the room feel like the resonating body.\\n\\nStone Nest is an arts organisation and performance venue in the heart of London's West End, bringing exceptional and experimental art to a wide audience.\\n\\nGround floor tickets are standing. Balcony tickets are seated. Unfortunately, there is no step-free access to the balcony. If you have access requirements, please email info@stonenest.org when booking.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 16s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T15:30:00+00:00\",\"sale_end_date\":\"2026-04-22T17:00:00+01:00\",\"sale_start_date\":\"2026-01-27T15:30:00+00:00\",\"event_start_date\":\"2026-04-22T19:30:00+01:00\",\"event_end_date\":\"2026-04-22T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"FUJI||||||||||TA - sukima\",\"redirect_url\":\"https://open.spotify.com/track/7agDSza100n3BIqMjYiHOZ\",\"artist\":\"FUJI||||||||||TA\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8c587052acec38ba5cceccb4577ce82f48e15af7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"sukima\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"CHROMA\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-15/800a22a8-8270-4fc5-8d59-69c8a7d455c8.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"7304\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Action!.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"37\",\"name\":\"The Old Blue Last\",\"address\":\"38 Great Eastern Street, London EC2A 3ES\",\"location\":{\"lat\":51.5245266,\"lng\":-0.0806281999999783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-blue-last-4ryw\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-22T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"announcement_date_unix\":1769108400,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ic54c1a43597?dice_id=Ic54c1a43597\",\"post_competition_referral\":\"https://link.dice.fm/h555659e279e?dice_id=h555659e279e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c93b212c6346?dice_id=c93b212c6346\",\"post_purchase_referral\":\"https://link.dice.fm/Ecf55b4d61e4?dice_id=Ecf55b4d61e4\",\"post_reminder_referral\":\"https://link.dice.fm/G39701736a0f?dice_id=G39701736a0f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Mcb41354615b?dice_id=Mcb41354615b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"q279wx-chroma-22nd-apr-the-old-blue-last-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+Last+.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776882600,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:91\",\"price\":{\"currency\":\"GBP\",\"amount\":1430,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/7504b00a-e6db-4234-b905-3ea2724b5ad9.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/7504b00a-e6db-4234-b905-3ea2724b5ad9.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/7504b00a-e6db-4234-b905-3ea2724b5ad9.jpg?rect=180%2C0%2C440%2C800\"},\"id\":\"6972724f7752d60001020006\",\"name\":\"CHROMA\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Action! presents\\n\\nCHROMA\\n\\n\\\\+ Support\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T19:00:00+00:00\",\"sale_end_date\":\"2026-04-22T14:00:00+01:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-04-22T19:30:00+01:00\",\"event_end_date\":\"2026-04-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fast Money Music\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-05-08/8abf7ec5-b1f9-481b-a922-58b39206ab27.jpg?rect=0%2C0%2C2185%2C2185\"},\"artist_id\":\"68199\",\"about\":{\"description\":\"What is Fast Money Music? Could be fast. Could be money. Could even be music. Maybe it’s none of the above and everything at the same time.\\n\\nIt could be a Suicide song, or something from under the floorboards. A naïve melody in the spirit of Melody Nelson. Or maybe it’s the absence of all of those things.\\n\\nFast Money Music is the solo project of American-born, East London-based songwriter and producer Nick Hinman. The sound he’s carved out is what he calls tough nostalgia - bittersweet pop threaded with jagged post-punk edges, new-wave immediacy, and art-pop curiosity.\\n\\nLauded by Jack Saunders (BBC Radio 1), Steve Lamacq (BBC 6Music), Matt Wilkinson (Apple Music) and John Kennedy (Radio X) and earning coverage from SPIN, Clash, DIY HERO, Spotify Fresh Finds and Apple Music New In Alternative amongst others, FMM has built a loyal following since 2022, with sold-out headline performances across East London venues, a showcase at Supersonic Paris, a coveted slot at The Great Escape 2025, and a UK tour supporting Tempesst.\\n\\n‘Fast Money Music’, the debut album, is scheduled for release on 17th April 2026.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Bad Vibrations\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venue