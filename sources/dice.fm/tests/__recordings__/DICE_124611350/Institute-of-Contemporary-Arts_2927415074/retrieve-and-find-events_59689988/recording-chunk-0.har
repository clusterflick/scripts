ition_type\":\"purchase\",\"perm_name\":\"rywdky-tvam-11th-mar-the-lower-third-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773255600,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:33\",\"price\":{\"currency\":\"GBP\",\"amount\":1796,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-05/f3b9ef11-b4fd-44ac-ab78-6becc573bd9f.jpg?rect=0%2C214%2C853%2C853\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-05/f3b9ef11-b4fd-44ac-ab78-6becc573bd9f.jpg?rect=0%2C384%2C853%2C512\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-05/f3b9ef11-b4fd-44ac-ab78-6becc573bd9f.jpg?rect=75%2C0%2C704%2C1280\"},\"id\":\"690b6525d45e6e0001c14b0d\",\"name\":\"TVAM\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Since his debut album, Psychic Data, first burst onto the scene (direct from a small bedroom studio in Wigan, UK), TVAM has defined the sound and spectacle of nostalgia’s grip on our lives; from the sloganeering of Porsche Majeure, to the electioneering of Semantics.\\n\\nTVAM’s debut Psychic Data spawned an ‘Album Of The Day’ and two daytime playlists at BBC 6Music whilst signature tune ‘Porsche Majeure’ was KEXP Track Of The Day and featured in HBO’s smash-hit ‘Succession’. Follow-up High Art Lite was released on Geoff Barrow’s Invada Records and received daytime playlist for ‘Double Lucifer’ on BBC 6Music and “Album of the Week’ at Louder Than War.\\n\\n“An industrialised pop record that throbs and pulses with an infectious, entrancing haze that’s instantly addictive ... roaring great fun” - Loud & Quiet\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-07T10:00:00+00:00\",\"sale_end_date\":\"2026-03-11T19:30:00+00:00\",\"sale_start_date\":\"2025-11-07T10:00:00+00:00\",\"event_start_date\":\"2026-03-11T19:00:00+00:00\",\"event_end_date\":\"2026-03-11T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Porsche Majeure\",\"redirect_url\":\"https://open.spotify.com/track/3TIfrYMg4chTuQWCdDq9pm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7687bd3b95ed3bdaaeff1a54b88527b588c37fd7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Porsche Majeure\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Elias Rønnenfelt\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-21/ba7b6e91-851f-49fd-b6b4-39ca65537999.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"35212\",\"about\":{\"description\":\"Elias Rønnenfelt is a highly regarded Danish musician and poet who has made a significant impact on the international art scene. Best known as the lead singer and lyricist for the acclaimed post-punk band, Iceage, Rønnenfelt has established himself as a powerful creative force, known for his introspective lyrics, emotive vocal delivery, and compelling live performances.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by FORM.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"84\",\"name\":\"The Dome\",\"address\":\"2A Dartmouth Park Hill, London NW5 1HL\",\"location\":{\"lat\":51.5579086,\"lng\":-0.139039799999978},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-dome-jq5a\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-11T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"announcement_date_unix\":1761123600,\"social_links\":{\"event_share\":\"https://link.dice.fm/ub7e3dbd66f4?dice_id=ub7e3dbd66f4\",\"post_competition_referral\":\"https://link.dice.fm/Mad43ebce394?dice_id=Mad43ebce394\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v57df169f05a?dice_id=v57df169f05a\",\"post_purchase_referral\":\"https://link.dice.fm/Ia29435423f6?dice_id=Ia29435423f6\",\"post_reminder_referral\":\"https://link.dice.fm/k01f06d3c0f3?dice_id=k01f06d3c0f3\",\"post_waitinglist_referral\":\"https://link.dice.fm/d433d105e49b?dice_id=d433d105e49b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"7deaw6-elias-rnnenfelt-11th-mar-the-dome-london-tickets\",\"unicorn\":false,\"status\":\"on-sale\",\"is_fully_locked\":false,\"publ