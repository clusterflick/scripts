n E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-18T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Josiah Queen\",\"image\":null,\"artist_id\":\"132655\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":71035,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":71036,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/bd95718f-063f-4e4b-b2d6-76ff9e80b493.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/bd95718f-063f-4e4b-b2d6-76ff9e80b493.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/bd95718f-063f-4e4b-b2d6-76ff9e80b493.jpg?rect=450%2C0%2C1100%2C2000\"},\"previews\":[],\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"announcement_date_unix\":1769022000,\"max_tickets\":8,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"7f97a598-f791-47c1-904e-6ac86d86f85b\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"disabled\"},\"about\":{\"description\":\"Josiah Queen has quickly become one of the most impactful new voices in Christian music, blending raw authenticity with deeply resonant melodies. With 744 million global streams (570M in the U.S. alone, per Luminate), his music continues to inspire a wide-reaching and rapidly growing audience. Following the breakout success of “The Prodigal” (82M+ streams), Josiah’s latest single “Dusty Bibles” is setting new records — averaging over 5 million streams per week, with 31 million global streams in its first 6 weeks, and 200 million views on social content using the track. The song hit the Spotify Viral 50 in over 15 countries, landed in the Top 3 Christian/Gospel Streaming Songs in the U.S., and cracked the Shazam Top 200 in multiple territories.\\n\\nHis debut album debuted at #1 on the Billboard Christian Albums Chart, marking the biggest debut in Christian music history, and his follow-up singles — including “Can’t Steal My Joy”, a Top 10 Christian radio hit — continue to build on that momentum. Josiah’s highly anticipated sophomore album, Mt. Zion, is set to release August 22, 2025, promising a powerful next chapter in his sound and message. Named Billboard’s #1 New Christian Artist of 2024, Josiah has sold over 80,000 tickets across headline tours and now reaches over 1.5 million followers across Instagram, TikTok, and Facebook — 2.2 million including YouTube and Spotify. With a heart to serve both the Church and the world through music, Josiah crafts songs filled with faith, honesty, and hope. He and his wife, Trinity, travel and minister together, and are based in Tampa, FL.\\n\\nSeating is reserved for this event and you will be automatically assigned the best available seats within your chosen area. Seat details are available immediately after purchase. Please follow the link in your confirmation email if you wish to change your seats. For any queries please contact help@dice.fm. Please note we cannot guarantee that seated tickets offered via the Waiting List will be located together.\\n\\nTickets include a £2.25 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Good Ticket.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:67\",\"social_links\":{\"event_share\":\"https://link.dice.fm/k171b849b5cf?dice_id=k171b849b5cf\",\"post_competition_referral\":\"https://link.dice.fm/Ud652a53af4d?dice_id=Ud652a53af4d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fb4d6477e907?dice_id=Fb4d6477e907\",\"post_purchase_referral\":\"https://link.dice.fm/Z85d6bb6b220?dice_id=Z85d6bb6b220\",\"post_reminder_referral\":\"https://link.dice.fm/O58520bf94c7?dice_id=O58520bf94c7\",\"post_waitinglist_referral\":\"https://link.dice.f