3d660f7a3\",\"post_purchase_referral\":\"https://link.dice.fm/B36b6e57939a?dice_id=B36b6e57939a\",\"post_reminder_referral\":\"https://link.dice.fm/u44fa0dacdf7?dice_id=u44fa0dacdf7\",\"post_waitinglist_referral\":\"https://link.dice.fm/t7ff39d541a4?dice_id=t7ff39d541a4\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:94\",\"properties\":[],\"presented_by\":\"Presented by Toulouse Lautrec Jazz Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765395000,\"id\":\"6939c9f5c3239000015235a3\",\"name\":\"Manon Mullener Trio: Modern jazz / Latin flair\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Swiss pianist Manon Mullener, described as “the future of Swiss jazz” (Le Temps) and a “rising star of European jazz” (France Musique), brings her electrifying trio to Toulouse Lautrec for an evening of modern jazz infused with Cuban and Latin colours.\\n\\nHer new album Stories, recorded in New York, is built around real-life encounters from her travels around the world. Each piece paints a vivid portrait: Zoila, a 95-year-old Cuban grandmother recalling her 1950s Havana perfumery; Noh, a Mexican cab driver devoted to Mayan traditions; and Willard, an opera lover from uptown New York. Performed live, these musical tales take on fresh energy and emotional depth, “immediate energy and effectiveness,” says Jazz Magazine.\\n\\nPart of a 100-date world tour, this concert promises expressive storytelling, lyrical virtuosity and a rich fusion of jazz and Latin rhythm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14685\",\"name\":\"Toulouse Lautrec Jazz Club\",\"image\":{\"url\":null},\"perm_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"date_unix\":1775935800,\"event_tag\":null},{\"tty_to_