l_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2016,\"name\":\"b00st\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1250047009207529\",\"ga_tracking_id\":\"G-XG422GFGEM\",\"tiktok_pixel_id\":\"CUVOG7RC77U0KANSJ1SG\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Velvet Grip + Fools Gamble @ Blondies\\n\\n“Velvet Grip's sound is a raw, untamed force—an enigmatic blend of rock's finest influences with an unpredictable edge. With the timeless power of Led Zeppelin, Aerosmith, and Lynyrd Skynyrd at their core, they weave in the darker, unexpected threads of The Dead Daisies, Slash's Snakepit, and Megadeth. Their music draws from the depths of blues, jazz, southern rock, country, and metal, all tied together by the pulse of classic rock. Velvet Grip doesn’t just play music—they conjure a sound that is familiar yet hauntingly uncharted, pulling listeners into a world where rock’s legacy meets an uncertain future…”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by BLONDIES LONDON LTD.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:68\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Gf3b85e55916?dice_id=Gf3b85e55916\",\"post_competition_referral\":\"https://link.dice.fm/J