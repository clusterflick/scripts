idden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:71\",\"properties\":[],\"presented_by\":\"Presented by VIVA\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770595200,\"id\":\"698a1db3bddd09000123dd0c\",\"name\":\"VIVA Baile\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"VIVA, The Weekend Party You Can't Miss! 🔥\\n\\nHey party people! Get ready for the ULTIMATE Saturday night vibes EVERY WEEK from 11PM - 5AM at Lightbox London, Vauxhall!\\n\\nLet's be real - weekends are precious, and we're here to make yours EPIC! VIVA is where memories are made, friendships are formed, and dance floors are destroyed (in the best way possible).\\n\\nThe Music? ABSOLUTELY MASSIVE!\\n\\nRoom 1: Baile Funk Explosion 🇧🇷\\n\\nBrazilian beats that bring the heat! For when regular dancing just isn't enough.\\n\\nRoom 2: Reggaeton Paradise 🇵🇷\\n\\nAll the reggaeton bangers that make your hips do the talking! Trust us, you won't stop moving.\\n\\nRoom 3: Pop & R&B Heaven ✨\\n\\nSinging along to your fave chart-toppers and throwbacks? Yes please! This is where anthems live.\\n\\nNeed-to-Know Stuff ⚠️\\n\\nWhen: 11PM - 5AM (last entry 3AM)\\n\\nWho: 18+ with ID (no ID = no fun, sorry!)\\n\\nWear: Look good, feel good! No sportswear/caps/hoodies\\n\\nFree Entry: Limited tickets online - but only before 11:30PM!\\n\\nGet the FREE VIVA MEMBERSHIP! 🎟️\\n\\nWant to level up your VIVA experience? Our completely FREE membership includes:\\n\\nQueue Jump + Priority Entry (bye-bye waiting!)\\n\\nDiscounted Online tickets\\n\\nDiscounted VIVA members door price\\n\\nFree Entry to selected events\\n\\nFree entry for you + 4 friends on your BIRTHDAY!\\n\\nIt takes 2 minutes to join at: https://pub1.pskt.io/t/fetevm (Works with Apple Pay, Google Pay or Samsung Pay Wallets)\\n\\nSee you on the dance floor! 💃🕺\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"185\",\"name\":\"HVYWGHT LDN\",\"image\":{\"url\":null},\"perm_name\":\"hvywght-ldn-4rxq\",\"profile_active\":false},\"date_unix\":1772924400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-07T22:00:00+00:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-07T23:00:00+00:00\",\"event_end_date\":\"2026-03-08T05:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"py9ldk-viva-reggaeton-7th-mar-lightbox-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"389\",\"name\":\"Lightbox\",\"address\":\"6A S Lambeth Pl, London SW8 1SP\",\"location\":{\"lat\":51.485903,\"lng\":-0.123745999999983},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"lightbox-jx6m\",\"accessibility\":{\"url\":\"https://www.lightboxlondon.net/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T23:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/fd01016d-46de-4bdf-8cf7-9478dbe95f3c.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/fd01016d-46de-4bdf-8cf7-9478dbe95f3c.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/fd01016d-46de-4bdf-8cf7-9478dbe95f3c.jpg?rect=450%2C0%2C1100%2C2000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/s3f6a086f2ba?dice_id=s3f6a086f2ba\",\"post_competition_referral\":\"https://link.dice.fm/ke4e7773bd4a?dice_id=ke4e7773bd4a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s87836f73f5a?dice_id=s87836f73f5a\",\"post_purchase_referral\":\"https://link.dice.fm/p3bb7b855142?dice_id=p3bb7b855142\",\"post_reminder_referral\":\"https://link.dice.fm/bdb0ece2794c?dice_id=bdb0ece2794c\",\"post_waitinglist_referral\":\"https://link.dice.fm/I8f35cf096de?dice_id=I8f35cf096de\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:72\",\"properties\":[],\"presented_by\":\"Presented by VIVA\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770595200,\"id\":\"698a1d80bddd0900015eacb9\",\"name\":\"VIVA Reggaeton\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"VIVA, The Weekend Party You Can't Miss! 🔥\\n\\nHey party people! Get ready for the ULTIMATE Saturday night vibes EVERY WEEK from 11PM - 5AM at Lightbox London, Vauxhall!\\n\\nLet's be real - weekends are precious, and we're here to make yours EPIC! VIVA is where memories are made, friendships are formed, and dance floors are destroyed (in the best way possible).\\n\\n🎶 Main Room: Reggaeton Paradise 🇵🇷 Lose yourself in the hottest reggaeton beats. We're talking non-stop bangers that will keep you moving and grooving all night long! Karol G, Bad Bunny, Myke Towers, Rauw Alejandro, Ryan Castro & more!\\n\\n✨ Room 2: Pop & R&B Heaven ✨ Sing your heart out to all your favourite chart-toppers and classic R&B hits. This room is pure feel-good energy!\\n\\n🇧🇷 Room 3: Baile Funk Explosion 🇧🇷 Experience the vibrant, high-energy sounds of Brazilian Baile Funk. It's an electrifying beat that's perfect for a summer night.\\n\\nsential Info 🚨\\n\\nTime: 11PM - 5AM (last entry at 3AM)\\n\\nAge: 18+ with valid ID (no ID, no entry – sorry!)\\n\\nDress Code: Smart casual, ready to party! No sportswear, caps, or hoodies.\\n\\nFree Entry: Limited free tickets available online until 11:30PM! If you arrive after 11:30PM, a concession price will be charged on the door.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"185\",\"name\":\"HVYWGHT LDN\",\"image\":{\"url\":null},\"perm_name\":\"hvywght-ldn-4rxq\",\"profile_active\":false},\"date_unix\":1772924400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-03-07T02:00:00+00:00\",\"sale_start_date\":\"2026-02-04T11:00:00+00:00\",\"event_start_date\":\"2026-03-07T23:00:00+00:00\",\"event_end_date\":\"2026-03-08T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"q292aa-netil-radio-x-lnatobl-jaye-ward-all-night-long-7th-mar-the-old-blue-last-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Sum Types\",\"redirect_url\":\"https://open.spotify.com/track/5KH79HpS7Higt8Gl7Zoo9q\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dadf63e2956c0fe4e2f3d9d1f9816056ab1c3d6e?cid=921526b9c2da4b7b96e197790a0