x_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-08T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/05a57b5a-4bfc-4d5e-8988-0217b6315511.jpg?rect=0%2C196%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/05a57b5a-4bfc-4d5e-8988-0217b6315511.jpg?rect=0%2C396%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/05a57b5a-4bfc-4d5e-8988-0217b6315511.jpg?rect=144%2C0%2C792%2C1440\"},\"status\":\"sold-out\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/D2f69a970734?dice_id=D2f69a970734\",\"post_competition_referral\":\"https://link.dice.fm/d1e1f0eca137?dice_id=d1e1f0eca137\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N7d98619759f?dice_id=N7d98619759f\",\"post_purchase_referral\":\"https://link.dice.fm/S27d386af3a1?dice_id=S27d386af3a1\",\"post_reminder_referral\":\"https://link.dice.fm/Q9b21db235e2?dice_id=Q9b21db235e2\",\"post_waitinglist_referral\":\"https://link.dice.fm/n3eceb6cb6f8?dice_id=n3eceb6cb6f8\"},\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:3\",\"properties\":[],\"presented_by\":\"\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770631200,\"id\":\"6984a311f35d530001e2f614\",\"name\":\"Bby - Home Town Tour\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"London-based alternative band bby (Benjy Gibson, Deon Graham, Tom Parkin, Jessy Jacquet-Cretides, and Tommaso Medica) burst onto the scene with their 2024 debut album 1 and follow-up EP i just want next year to be better. Building a cult following through DIY shows at their East London HQ, the band became known for raw, high-energy performances that channel the chaos of classic house-party punk.\\n\\nNow, bby take that energy on the road for a true hometown tour, playing the cities each member calls home. From Bologna and Paris to Southampton and Northampton, the tour celebrates the places that shaped the band, before returning to where it all began.\\n\\nThe final leg lands in London at Grow, the band’s current home and studio base. Expect a special hometown show charged with everything that made bby’s early gigs legendary.\\n\\nTheir electrifying live presence has already led to sold-out shows, festival slots at Leeds and All Points East, and U.S. dates opening for The Smashing Pumpkins. Praised by Rolling Stone UK, NME, and Zane Lowe, bby have racked up nearly 30 million streams, landed on the BBC Radio 1 playlist, and broken into the U.S. ALT charts. With their second album now in the works, this tour marks another step in a rise that’s only just getting started.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"date_unix\":1775671200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":nu