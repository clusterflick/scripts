al\":\"https://link.dice.fm/a599968c868c?dice_id=a599968c868c\",\"post_waitinglist_referral\":\"https://link.dice.fm/K1bd7542e6e8?dice_id=K1bd7542e6e8\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:23\",\"properties\":[],\"presented_by\":\"Presented by Grow, Hackney.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1732665600,\"id\":\"69398b7c3bf9990001bc9a96\",\"name\":\"Canalside Sessions // Free // Every Sunday\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Experience live global music with master conga player Williams Cumberbache and special guests on Grow’s canalside terrace in Hackney Wick. Set against the River Lea, enjoy world-class performances from the pontoon stage as boats drift by.\\n\\nRelax in our hidden garden, surrounded by greenery, and enjoy homemade dishes from the Brunch or All Day menu. Ease into the weekend with a spritz in hand and sun on your face. Our new Spritz Happy Hour is the perfect way to toast your brunch plans – two for £15, or go alcohol-free with two Crodinos for £10.\\n\\nWith over 30 years in the UK music scene, including collaborations with Goldie and Björk, Williams curates each session with a vibrant mix of jazz fusion, Latin, Brazilian, and African rhythms. Expect solo sets or surprise guest artists.\\n\\nWhether you're a jazz head, a brunch lover, or just after feel-good energy, these sessions offer high-quality music, warm vibes, and a family-friendly space that welcomes dancing.\\n\\nPractical Info\\n\\n- Venue: Grow is a converted warehouse with canalside and indoor seating.\\n- Booking: Tables for up to 8 via OpenTable. Larger groups via enquiry form. Walk-ins welcome.\\n- Weather: Performances are outdoors but may move inside during extreme conditions.\\n- Time: Performances run between 1–4 PM; artists and set times may vary.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"date_unix\":1772370000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":700},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T14:45:00+00:00\",\"sale_end_date\":\"2026-03-01T14:30:00+00:00\",\"sale_start_date\":\"2025-12-10T12:00:00+00:00\",\"event_start_date\":\"2026-03-01T14:30:00+00:00\",\"event_end_date\":\"2026-03-01T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"926w5o-basement-orchestra-enigma-for-everyone-1st-mar-big-penny-social-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":12,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"7425\",\"name\":\"Big Penny Social\",\"address\":\"1 Priestley Way, London E17 6AL, UK\",\"location\":{\"lat\":51.59085509999999,\"lng\":-0.04131809999999999},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-09-15/018322b6-65c3-40f9-851e-9d09dfa35252.jpg?rect=0%2C0%2C1000%2C1000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"big-penny-social-ayxd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T13:30:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/c3a1e0a0-07a0-4f54-abce-a6552eeeee4b.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/c3a1e0a0-07a0-4f54-abce-a6552eeeee4b.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/c3a1e0a0-07a0-4f54-abce-a6552eeeee4b.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Z5826db064d9?dice_id=Z5826db064d9\",\"post_competition_referral\":\"https://link.dice.fm/D00b9717f6a6?dice_id=D00b9717f6a6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lfb747467334?dice_id=lfb747467334\",\"post_purchase_referral\":\"https://link.dice.fm/Qecd74e28a0b?dice_id=Qecd74e28a0b\",\"post_reminder_referral\":\"https://link.dice.fm/M796796433be?dice_id=M796796433be\",\"post_waitinglist_referral\":\"https://link.dice.fm/U450df533460?dice_id=U450df533460\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":676,\"name\":\"Big Penny Social\",\"privacy_policy_link\":\"https://bigpenny.co.uk/privacy-policy\",\"fb_pixel_id\":\"5746367065411442\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:24\",\"properties\":[],\"presented_by\":\"Presented by Big Penny Social\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765205100,\"id\":\"69382e8787188f0001ec4ea9\",\"name\":\"Basement Orchestra : Enigma for Everyone\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Basement Orchestra returns to Big Penny Social to perform Elgar’s Enigma Variations.\\n\\nEach movement of the Enigma Variations is a musical sketch of someone close to Elgar, from his devoted wife to boisterous friends, including the moving and noble ‘Nimrod’. This beloved piece is both a love letter to friends and a musical puzzle, which invites you to discover characters and stories in every note.\\n\\nBasement Orchestra are known for presenting classical music in a friendly, relaxed and accessible way. In this family-friendly concert they will guide you through the music to bring it to life, with a heavy sprinkling of fun and audience involvement throughout.\\n\\n**About Basement Orchestra**\\n\\nBasement Orchestra makes beautiful music in unexpected places. Classical music breaks free of the concert hall and has a bit of a riot. Founded in 2012, Basement Orchestra is now a 50-piece musical behemoth. In that time, they have brought their come-as-you-are vibe and blissful noises to a variety of unusual spaces, including the iconic Rough Trade Record Stores, the even more iconic Bethnal Green Working Men's Club and several windy car parks. They have provided live scores to up-and-coming filmmakers, and have entertained tripped-out revellers in the way they least expected on the main stage of Secret Garden Party and at Mighty Hoopla.\\n\\n**Performance schedule:**\\n\\nDoors: 1:30pm\\n\\nPerformance starts: 2:30pm\\n\\n**Running times:**\\n\\nApproximately 1 hour 10 minutes without an interval\\n\\nRecommended age of 6+\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 6+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"9555\",\"name\":\"Big Penny Ltd\",\"image\":{\"url\":null},\"perm_name\":\"big-penny-ltd-7mq6\",\"profile_active\":false},\"date_unix\":1772375400,\"event_tag\":null},{\"tt