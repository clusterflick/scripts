from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-05T00:00:00+01:00\",\"sale_end_date\":\"2026-02-20T17:00:00+00:00\",\"sale_start_date\":\"2025-08-05T00:00:00+01:00\",\"event_start_date\":\"2026-02-20T18:00:00+00:00\",\"event_end_date\":\"2026-02-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by New Cross Live.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/w0508755eabd?dice_id=w0508755eabd\",\"post_competition_referral\":\"https://link.dice.fm/Jbd616d4d117?dice_id=Jbd616d4d117\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K70640940eca?dice_id=K70640940eca\",\"post_purchase_referral\":\"https://link.dice.fm/l0f3015ab037?dice_id=l0f3015ab037\",\"post_reminder_referral\":\"https://link.dice.fm/P836c642cc4c?dice_id=P836c642cc4c\",\"post_waitinglist_referral\":\"https://link.dice.fm/o13f1bfa1d97?dice_id=o13f1bfa1d97\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Country Goes Emo LIVE AT NEW CROSS INN\\n\\nSaddle up, cowboys it’s time for a boot-stompin’ emo hoe-down like no other.\\n\\nJoin us on Feb 20th as Homecoming take the stage, blending your favourite country anthems with a raw, emotional twist.\\n\\nExpect Emo & Pop Punk-infused renditions of iconic hits like:\\n\\nDolly Parton – 9 to 5\\n\\nJohnny Cash – Ring of Fire\\n\\nJohn Denver – Take Me Home, Country Roads\\n\\nRascal Flatts – Life Is A Highway\\n\\nThis is country music with eyeliner and heartbreak a night of cowboy hats, big feelings, and even bigger singalongs. Don’t miss the ultimate crossover of twang and power chords.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771610400,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:25\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"id\":\"68920a69e877ed0001ccf8c5\",\"name\":\"Country Goes Emo\",\"perm_name\":\"eopeed-country-goes-emo-20th-feb-new-cross-inn-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-05/d87898e2-bc29-4c88-9a4c-f1860b865656.jpg?rect=0%2C0%2C4501%2C4501\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-05/d87898e2-bc29-4c88-9a4c-f1860b865656.jpg?rect=0%2C900%2C4501%2C2701\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-05/d87898e2-bc29-4c88-9a4c-f1860b865656.jpg?rect=1013%2C0%2C2476%2C4501\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1754348400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1980,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Dolly Parton - 9 to 5\",\"redirect_url\":\"https://open.spotify.com/track/4w3tQBXhn5345eUXDGBWZG\",\"artist\":\"Dolly Parton\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6384764199bf3d44f69085d62e10a076855ac8c8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"9 to 5\"},{\"type\":\"apple_music\",\"title\":\"Dolly Parton - 9 To 5\",\"redirect_url\":\"https://music.apple.com/us/album/9-to-5/411939194?i=411941745&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dolly Parton\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/2e/db/b1/2edbb1d3-ee3c-b484-f1e1-0e5ef9d018fe/mzaf_5306924934831390884.plus.aac.p.m4a\",\"track_name\":\"9 To 5\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-30T17:00:00+01:00\",\"sale_end_date\":\"2026-02-20T17:00:00+00:00\",\"sale_start_date\":\"2025-08-01T10:00:00+01:00\",\"event_start_date\":\"2026-02-20T18:00:00+00:00\",\"event_end_date\":\"2026-02-20T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/cb3f193b2ec8?dice_id=cb3f193b2ec8\",\"post_competition_referral\":\"https://link.dice.fm/Z57772474c27?dice_id=Z57772474c27\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f645c4c1bf07?dice_id=f645c4c1bf07\",\"post_purchase_referral\":\"https://link.dice.fm/gd4fe7c52eea?dice_id=gd4fe7c52eea\",\"post_reminder_referral\":\"https://link.dice.fm/e6559acec002?dice_id=e6559acec002\",\"post_waitinglist_referral\":\"https://link.dice.fm/d8928bba8e04?dice_id=d8928bba8e04\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"THE DOPPLER AFFECTION TOUR\\n\\nTHE COST was formed in Valencia, Spain in 2023 when drummer El Estepario Siberiano, bassist Chris Attwell and guitarist & vocalist Peter Connolly met at their producer’s acclaimed recording studio. Chris and Peter performed in a jazz band that recorded at the studio and as El Estepario Siberiano explains he could hear them through the thin walls and was very impressed with their music and ability. He thought to himself “they have a jazzy style, but if they just added some gain to what they were doing, it could be metal”. So he asked them if they would want to give it a try and do what they do, but just add distortion. The result is the incredible Doppler Affection album.\\n\\nBringing together three distinct musical backgrounds & cultures, this culmination promises to be one of the biggest sounds in music today. With Peter and Chris being graduates of the Berklee Music program in Valencia and El Estepario Siberiano’s infamous drumming skills, the band seamlessly blend their technical prowess with great songwriting ability. Power and virtuosity meet soaring vocals, haunting melodies, anthemic rock choruses, and brutal breakdowns.\\n\\nTHE COST’s debut single “Not For Me” has over 6 million streams and views across all platforms and even garnered some airplay on Sirius Octane. Subsequent singles “Into The Drone” and “Her Eyes (featuring Serj Tankian of System of a Down) have also accumulated several millions of streams and views on DSPs. Debut album Doppler Affection was unleashed on 29 March, 2025 and reached #1 on the albums iTunes Charts in its week of release.\\n\\nThe band performed their first ever show at the Comendatio Festival in Portugal and will also be featured at Spain’s Leyendas Del Rock Festival in summer 2025. A proper headline tour to support Doppler Affection is to be announced in the near future. THE COST are an undeniable force poised to carve their place in the rock and metal music scene through incredible live performances, relentless touring, and a continual stream of blistering new music.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771610400,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T18:00:00+00:00\",\"doors_close_date\":\"2026-02-20T22:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:26\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"688108afa3482c000141f033\",\"name\":\"THE COST\",\"perm_name\":\"53g5dl-the-cost-20th-feb-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-23/07e73776-8698-48b6-b1f5-f8d013ea1b60.jpg?rect=267%2C0%2C1066%2C1066\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-23/07e73776-8698-48b6-b1f5-f8d013ea1b60.jpg?rect=0%2C53%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-23/07e73776-8698-48b6-b1f5-f8d013ea1b60.jpg?rect=507%2C0%2C586%2C1066\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Cost\",\"image\":null,\"artist_id\":\"124707\",\"about\":null,\"is_headliner\":true},{\"name\":\"Ashen Reach\",\"image\":null,\"artist_id\":\"43293\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1753891200,\"faqs\":[{\"id\":33835,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":33836,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":33837,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":2421,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Cost - Not For Me\",\"redirect_url\":\"https://open.spotify.com/track/4WsaUnfQC95vHjvRCd7hda\",\"artist\":\"The Cost\",\"preview_url\":\"https://p.scdn.co/mp3-preview/43b25fb20a8d5d8a41c6f84302a6819d70e1be3d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Not For Me\"},{\"type\":\"apple_music\",\"title\":\"The Cost - Not For Me\",\"redirect_url\":\"https://music.apple.com/us/album/not-for-me/1802287726?i=1802287729&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Cost\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/74/ab/4a/74ab4a58-0cf0-5b96-b13d-410197291300/mzaf_4494056993980049644.plus.aac.p.m4a\",\"track_name\":\"Not For Me\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-02T09:00:00+00:00\",\"sale_end_date\":\"2026-02-20T13:00:00+00:00\",\"sale_start_date\":\"2024-12-06T09:00:00+00:00\",\"event_start_date\":\"2026-02-20T18:00:00+00:00\",\"event_end_date\":\"2026-02-20T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Kilimanjaro.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/ac09376bec07?dice_id=ac09376bec07\",\"post_competition_referral\":\"https://link.dice.fm/C470f3dcd7d4?dice_id=C470f3dcd7d4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R052f2dcd853?dice_id=R052f2dcd853\",\"post_purchase_referral\":\"https://link.dice.fm/ebfd3f0861f2?dice_id=ebfd3f0861f2\",\"post_reminder_referral\":\"https://link.dice.fm/b5f896f3d5ac?dice_id=b5f896f3d5ac\",\"post_waitinglist_referral\":\"https://link.dice.fm/C8d12cfd68c6?dice_id=C8d12cfd68c6\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Kilimanjaro presents\\n\\nTHE ACADEMIC\\n\\n\\\\+ Keyside\\n\\n\\\\+ AmiiFy\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event - 14s to 15s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771610400,\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T18:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:27\",\"tty_to_extras\":[],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"id\":\"674782345aaea400017375bd\",\"name\":\"The Academic\",\"perm_name\":\"q2opex-the-academic-20th-feb-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-04/25f4de07-9a5f-428d-9de9-5ce9fbe43869.jpg?rect=0%2C517%2C3648%2C3648\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-12-04/25f4de07-9a5f-428d-9de9-5ce9fbe43869.jpg?rect=0%2C1247%2C3648%2C2189\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-12-04/25f4de07-9a5f-428d-9de9-5ce9fbe43869.jpg?rect=537%2C0%2C2575%2C4682\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Academic\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-27/ad122576-33f3-49f5-84ed-3a89dd69cebf.jpg?rect=0%2C0%2C504%2C504\"},\"artist_id\":\"1201\",\"about\":null,\"is_headliner\":false},{\"name\":\"Keyside\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-02-04/0e38d5f3-f6fa-4fac-bf1f-a35d90f21289.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"114172\",\"about\":null,\"is_headliner\":false},{\"name\":\"AmiiFy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7f7d777ff16f6d5c050ab72a\"},\"artist_id\":\"133829\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1733130000,\"faqs\":[{\"id\":8688,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":3245,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Academic - Bear Claws\",\"redirect_url\":\"https://itunes.apple.com/gb/album/bear-claws/1312908179?i=1312908187&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Academic\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview118/v4/bb/3c/58/bb3c5872-02c6-1b2a-b9b3-fdf0d4f0e800/mzaf_2942856144266327182.plus.aac.p.m4a\",\"track_name\":\"Bear Claws\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-22T12:00:00+01:00\",\"sale_end_date\":\"2026-02-20T21:00:00+00:00\",\"sale_start_date\":\"2025-08-27T09:30:00+01:00\",\"event_start_date\":\"2026-02-20T18:30:00+00:00\",\"event_end_date\":\"2026-02-20T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by SJM Concerts.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":true,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/B680fec5002f?dice_id=B680fec5002f\",\"post_competition_referral\":\"https://link.dice.fm/Df31f21cf3ff?dice_id=Df31f21cf3ff\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z44350f310b5?dice_id=z44350f310b5\",\"post_purchase_referral\":\"https://link.dice.fm/w2f4304dbc06?dice_id=w2f4304dbc06\",\"post_reminder_referral\":\"https://link.dice.fm/R4ed3e39d94a?dice_id=R4ed3e39d94a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hc67068e6162?dice_id=Hc67068e6162\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771612200,\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-02-20T18:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":true,\"max_tickets\":6,\"donation\":{\"description\":\"Love Ally Pally? Add a donation to care for the Palace and Park. Your gift helps to protect and restore this special place — for everyone, forever.\\n\\nA percentage of your donation goes towards a payment processing fee (neither DICE or the charity keep any of this fee). For a £10 donation, the charity gets £9.75\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA3ODY5NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDkzMDY1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1NC4zNDM2ODhaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MjMzMiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA3ODY5NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDkzMDY1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1NC4zNDM3MzZaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MjMzMywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA3ODY5NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDkzMDY1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1NC4zNDM3NTJaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6MjMzNCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA3ODY5NywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NDkzMDY1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1NC4zNDM3NjdaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjIzMzUsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Alexandra Park and Palace Charitable Trust\",\"charity_registration_number\":\"281991\"},\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:28\",\"tty_to_extras\":[{\"ticket_type_id\":1041782,\"extra_ids\":[\"1191889\"]},{\"ticket_type_id\":1041783,\"extra_ids\":[\"1191889\"]},{\"ticket_type_id\":1041784,\"extra_ids\":[\"1191889\"]},{\"ticket_type_id\":1041785,\"extra_ids\":[\"1191889\"]},{\"ticket_type_id\":1041786,\"extra_ids\":[\"1191889\"]}],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"id\":\"68a74ad899a7f7000174c665\",\"name\":\"Fatboy Slim\",\"perm_name\":\"xe56vl-fatboy-slim-20th-feb-alexandra-palace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-19/d981d0f3-0998-4c56-8332-48c1741e3fcb.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-19/d981d0f3-0998-4c56-8332-48c1741e3fcb.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-19/d981d0f3-0998-4c56-8332-48c1741e3fcb.jpg?rect=270%2C0%2C660%2C1200\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fatboy Slim\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebbbb4a8ed961af5b1989e2b6a\"},\"artist_id\":\"742\",\"about\":null,\"is_headliner\":true},{\"name\":\"Jodie Harsh\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-15/4634ffba-0eae-4881-ad6f-9dc3aa5a7681.jpg?rect=342%2C0%2C1365%2C1365\"},\"artist_id\":\"14394\",\"about\":null,\"is_headliner\":false},{\"name\":\"Joshua James\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273974564c9f94226bd4dbe484c\"},\"artist_id\":\"43517\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1755860400,\"faqs\":[{\"id\":38458,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":38459,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":1},{\"id\":38460,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\\n\\n**Transfer your ticket to a friend**\\n\\nIf a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":38461,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":3},{\"id\":38462,\"title\":\"Can I bring a bag?\",\"body\":\"BAG POLICY FOR LIVE MUSIC EVENTS AT ALEXANDRA PALACE\\n\\nWe encourage you to attend live music events without bags. Should you need to bring one for your essentials, it needs to be as small as possible.\\n\\nFor security reasons and in line with industry best practice, visitors are only permitted to bring one small bag into the venue, which must be no bigger than:\\n\\nHeight 30cm (11.8 inches)\\n\\nWidth 20cm (7.9 inches)\\n\\nDepth 10cm (3.9 inches)\\n\\nAny bags that do not meet these requirements will be directed to our bag drop (Great Hall concerts only).\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":4},{\"id\":38463,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":5},{\"id\":38464,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":6},{\"id\":38465,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am.\",\"order\":7}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5535},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Praise You - Radio Edit\",\"redirect_url\":\"https://open.spotify.com/track/2tn9zXqIZJbgL1swqwOktz\",\"artist\":\"Praise You\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6e55f72354df31ab105986e1c36ff571149f6219?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Radio Edit\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T11:30:00+00:00\",\"sale_end_date\":\"2026-02-20T15:00:00+00:00\",\"sale_start_date\":\"2026-02-17T11:30:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP FAMILY.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/he13a00cfd03?dice_id=he13a00cfd03\",\"post_competition_referral\":\"https://link.dice.fm/hdbd85a724fd?dice_id=hdbd85a724fd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/cd5341378fcb?dice_id=cd5341378fcb\",\"post_purchase_referral\":\"https://link.dice.fm/Z5d0e5baacd5?dice_id=Z5d0e5baacd5\",\"post_reminder_referral\":\"https://link.dice.fm/Xdd1d99b3f61?dice_id=Xdd1d99b3f61\",\"post_waitinglist_referral\":\"https://link.dice.fm/p6c92a4f84d9?dice_id=p6c92a4f84d9\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"DHP Presents :\\n\\nJohn Blek\\n\\n\\\\+ Tootawl\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771614000,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:29\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"id\":\"699452ca0a676500015e95ee\",\"name\":\"John Blek\",\"perm_name\":\"py9axk-john-blek-20th-feb-the-grace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/3c0adda5-0f81-4835-8e37-bbaeef3691ca.jpg?rect=329%2C0%2C2851%2C2849\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/3c0adda5-0f81-4835-8e37-bbaeef3691ca.jpg?rect=0%2C1428%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/3c0adda5-0f81-4835-8e37-bbaeef3691ca.jpg?rect=390%2C0%2C2729%2C4961\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"John Blek\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-21/93479091-fe07-47b3-ae4e-eddd73e51f95.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"7058\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tootawl\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb125ece6eb8b36ea4cec23e28\"},\"artist_id\":\"42440\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1771327800,\"faqs\":[{\"id\":77193,\"title\":\"Accessibility\",\"body\":\"The Grace has 12 steps into the venue, with no disabled toilet. There is no accessible area inside the venue. Companion ticket for someone to assist them up the stairs and to the toilet & early access available.\\n\\nDirect contact: accessibility@thegarage.london\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":1700,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Body\",\"redirect_url\":\"https://open.spotify.com/track/5pVzgoVzrM07rWm0Ui7HBg\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/140a1824eff0e05f2bc71cc6f6eb58198e51aac7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Body\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T21:00:00+00:00\",\"sale_end_date\":\"2026-02-19T23:45:00+00:00\",\"sale_start_date\":\"2026-02-11T21:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Helm.\",\"is_ticket_available_at_door\":false,\"properties\":[\"selling_fast\"],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Vfa55466b14b?dice_id=Vfa55466b14b\",\"post_competition_referral\":\"https://link.dice.fm/n88eb77e9f86?dice_id=n88eb77e9f86\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Fe7fe6239aca?dice_id=Fe7fe6239aca\",\"post_purchase_referral\":\"https://link.dice.fm/K2b0e349dd4d?dice_id=K2b0e349dd4d\",\"post_reminder_referral\":\"https://link.dice.fm/F81ead484adb?dice_id=F81ead484adb\",\"post_waitinglist_referral\":\"https://link.dice.fm/h3ebbfdfa998?dice_id=h3ebbfdfa998\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**SUM Projects presents VOYAGE**\\n\\nFebruary 20th, 7-11pm. Deptford Helm\\n\\nA sonic exploration in Deptford Helm’s riverside space. Embark on a site-specific musical journey through live electronics, jazz, experimental works and global dance sounds.\\n\\nAll profits support Deptford Reach, providing housing, mental health support and employment advice to those facing homelessness in Deptford.\\n\\n—---\\n\\n**Live performances from:**\\n\\n**GAN GEMI** – Fresh from releasing his 3rd EP Quadro, Gan Gemi centres electronic music while drawing on jazz, classical and folk. Supported by Rhisto to open our voyage.\\n\\n**mnb** - A pioneering vocalist recognised across London and Cambridge, and founding member of SUM. Joined by Kyle Osborne (keys), Sophie Warner (drums) and Anna-Maria Woodrow (cello).\\n\\n**Y'sohnt** – Pianist and composer who has performed at Cafe OTO, offering a virtuosic intermezzo.\\n\\n**Allexa Nava** – Peruvian saxophonist, flautist and composer. Performing from Glastonbury to Ronnie Scott’s, she's recently released her debut EP No Language. Supported by Emile Hinton (keys).\\n\\n**DJs**: Talulah and Chase B2B, spinning global, percussive dance sounds from Latin America, the Caribbean and West Africa.\\n\\n—------\\n\\n**SUM PROJECTS** produces collaborative concerts across London to fundraise for the local community. We champion independent artists by programming live music, showcasing visual artists and supporting community-oriented venues.\\n\\n——\\n\\nTickets: £8/£10. Donations welcome on the door.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"17560\",\"name\":\"Helm\",\"address\":\"3 Borthwick Street, Greenwich, London, SE8 3GH, United Kingdom\",\"location\":{\"lat\":51.48497,\"lng\":-0.02478},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"helm-q2mr9\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:30\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"143100\",\"name\":\"Helm\",\"image\":{\"url\":null},\"perm_name\":\"helm-6rqrb\",\"profile_active\":false},\"id\":\"698d8ee7aee50c00013e0849\",\"name\":\"VOYAGE\",\"perm_name\":\"bb867v-voyage-20th-feb-helm-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/6cff9ca0-b632-403d-92c7-fcf6f38bbcb0.jpg?rect=0%2C47%2C1131%2C1131\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/6cff9ca0-b632-403d-92c7-fcf6f38bbcb0.jpg?rect=0%2C460%2C1131%2C679\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/6cff9ca0-b632-403d-92c7-fcf6f38bbcb0.jpg?rect=126%2C0%2C879%2C1599\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770843600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":800},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T12:00:00+00:00\",\"sale_end_date\":\"2026-02-20T21:00:00+00:00\",\"sale_start_date\":\"2026-02-13T12:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T21:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Rough Trade.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":true,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/z4eea40c4d58?dice_id=z4eea40c4d58\",\"post_competition_referral\":\"https://link.dice.fm/i107ad8a8709?dice_id=i107ad8a8709\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k2634f361edc?dice_id=k2634f361edc\",\"post_purchase_referral\":\"https://link.dice.fm/u47d248f7e40?dice_id=u47d248f7e40\",\"post_reminder_referral\":\"https://link.dice.fm/L0026209c0f8?dice_id=L0026209c0f8\",\"post_waitinglist_referral\":\"https://link.dice.fm/zba8fbc94041?dice_id=zba8fbc94041\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Rough Trade East is very excited to present a Q&A as well as an early listen of 4 songs from the new MUNA album. This unique event celebrates the release of their new album 'Dancing On The Wall' released via Saddest Factory Records.\\n\\nYou will recieve an exclusive signed print at the event.\\n\\nPlease note only a 4 song preview of the album will be played, the album will not be played in it's entirety.\\n\\nStrictly no filming or phones at this event.\\n\\nCD/LP purchases will be shipped at release from 8th May via Second Class Mail.\\n\\nTicket transfers will be off to avoid shipping issues, please make sure you either purchase your own ticket or attend the event together.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/muna/dancing-on-the-wall\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771614000,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":true,\"max_tickets\":6,\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5ODc3OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTU3MTIzLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjowNi41MDI0NDlaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzgxOSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\