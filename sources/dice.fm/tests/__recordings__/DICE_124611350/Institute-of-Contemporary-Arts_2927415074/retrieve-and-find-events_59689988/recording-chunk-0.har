er_referral\":\"https://link.dice.fm/N9554556eea2?dice_id=N9554556eea2\",\"post_waitinglist_referral\":\"https://link.dice.fm/U0fcbae5efa4?dice_id=U0fcbae5efa4\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"92w2bo-spitnights-pure-poetry-3rd-apr-the-ministry-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775239200,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:26\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1450},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-26/32ac68ca-b5f9-44d4-bed8-1844a2daa008.jpg?rect=0%2C576%2C4330%2C4330\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-26/32ac68ca-b5f9-44d4-bed8-1844a2daa008.jpg?rect=0%2C1966%2C4330%2C2598\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-26/32ac68ca-b5f9-44d4-bed8-1844a2daa008.jpg?rect=369%2C0%2C3592%2C6530\"},\"id\":\"694eab0eb191a40001fbe010\",\"name\":\"SpitNights | pure poetry\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"*poetry for non-poetry fans*\\n\\nA memorable night with the UK's best poets, showing just how entertaining, moving and hilarious they can be using nothing but words.\\n\\n\\\\-------------------\\n\\n**lineup - tba**\\n\\n***\\\\+ open mic section***\\n\\n***\\\\--------------------***\\n\\nno tickets on the door\\n\\nseated\\n\\ninsta / tiktok: @spitnights\\n\\n- Show starts 7.45pm\\n- DJs from 7pm and 10:30-late\\n- Bar open all day - pizza from 7pm\\n- Step free access\\n- bring a book for the book swap <3\\n- 18+\\n\\n\\\\--------------------\\n\\n**LOW INCOME TICKETS**\\n\\n**we don't want anyone to be priced out of coming to our night so if money is too tight use code COMMUNITY to unlock £5 tickets (DICE adds a fee for waitlist tickets)**\\n\\n**thank you to everyone who buys a PAY IT FORWARD ticket to help us offer cheaper tickets to those who need <3**\\n\\n\\\\---------------------\\n\\nopen mic details:\\n\\n\\\\- sign up on the door 7-7:45pm\\n\\n\\\\- names will be picked out of a hat\\n\\n\\\\- 4 minutes maximum\\n\\n\\\\----------------------\\n\\n1st thursdays of the month = pure poetry night\\n\\n3rd saturdays of the month (usually) = poets vs singers\\n\\nlast thursday of the month = poetry x improv jazz show\\n\\n\\\\----------------------\\n\\nHere at spit nights, we are committed to creating a safe and celebratory environment for all of our supporters. By attending spit nights, you agree to adhere to our safety policy.\\n\\nYou can find more info regarding our safety policy here: https://linktr.ee/spitnights\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-26T18:30:00+00:00\",\"sale_end_date\":\"2026-04-03T19:00:00+01:00\",\"sale_start_date\":\"2026-02-01T10:00:00+00:00\",\"event_start_date\":\"2026-04-03T19:00:00+01:00\",\"event_end_date\":\"2026-04-03T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Laura Jane Grace\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-20/289cc26f-6634-4dd8-a3ae-183e019bac1e.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"44234\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Born Again Concerts.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\