},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-07/1c7e67a1-2ddc-436d-b413-7c3004604041.jpg?rect=0%2C54%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-07/1c7e67a1-2ddc-436d-b413-7c3004604041.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-07/1c7e67a1-2ddc-436d-b413-7c3004604041.jpg?rect=169%2C0%2C743%2C1350\"},\"id\":\"69863f467176a900016be119\",\"name\":\"'It's All Good' Charity Gig \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"arrowe and SANE present ‘it’s all good!’, a gig raising money for an extremely important independent mental health charity. SANE’s vision is of a time where no individual or family has to face the distress or isolation that results from coping with mental illness alone. This is a cause that arrowe are committed to supporting and they are honoured to be raising awareness for such an incredible charity.\\n\\nJoining arrowe on this lineup are the pedals and a headliner that is yet to be announced. 50% of all ticket sales will be donated directly to SANE and there will also be other opportunities to donate throughout the night!\\n\\nCome along and enjoy a night of high energy live music and help support an incredibly important charity at the same time!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-07T18:00:00+00:00\",\"sale_end_date\":\"2026-02-26T17:00:00+00:00\",\"sale_start_date\":\"2026-02-07T18:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\