xel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1760961600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/vf3de6e215a1?dice_id=vf3de6e215a1\",\"post_competition_referral\":\"https://link.dice.fm/Xa722a4ead6d?dice_id=Xa722a4ead6d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Icde8cd8c7f3?dice_id=Icde8cd8c7f3\",\"post_purchase_referral\":\"https://link.dice.fm/Ae3e48b70b2d?dice_id=Ae3e48b70b2d\",\"post_reminder_referral\":\"https://link.dice.fm/p73a8a155ea3?dice_id=p73a8a155ea3\",\"post_waitinglist_referral\":\"https://link.dice.fm/Qa56cfcbd932?dice_id=Qa56cfcbd932\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Late Night People\",\"redirect_url\":\"https://open.spotify.com/track/0ChZqycePk8nspWcIfHuGy\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/427ba6edd4ac9e28be48fc77c3730d93cf7455bc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Late Night People\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Morocco Bound.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"14196\",\"name\":\"Morocco Bound\",\"image\":{\"url\":null},\"perm_name\":\"morocco-bound-6d3nb\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"k69vol-plumm-yuis-6th-mar-morocco-bound-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772823600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:65\",\"venues\":[{\"id\":\"13583\",\"name\":\"Morocco Bound\",\"address\":\"1a Morocco Street, Southwark, London, SE1 3HB, United Kingdom\",\"location\":{\"lat\":51.50033,\"lng\":-0.082},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"morocco-bound-wnln\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Plumm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-11/f394476d-7a58-4398-b110-8cfdcd7fff57.jpg?rect=0%2C53%2C534%2C534\"},\"artist_id\":\"16025\",\"about\":null,\"is_headliner\":false},{\"name\":\"YUIS\",\"image\":null,\"artist_id\":\"134084\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"**Plumm**\\n\\nPlumm’s sound is dark, ethereal, alternative, triphop, electronic, improvisational and vocal heavy. She is being claimed as one of the most creative and exciting singers coming out of London.\\n\\nCatch her as Jamz Supernova’s ‘After Dark Discovery’ and Clash Magazines “one-to-watch”\\n\\nPlumm is championed by BBC Introducing London, has written and recorded various commissions from The Vault Festival to Love Island to Spitfire Audio to Amazon Prime adverts and so forth. You can catch her interweaving her voice through multiple bands such as Levitation Orchestra, Marla Kether, Intervention, Marysia Osu, Black Sabbath Mode, trance house duo: Plumm x Hen.D and Plumm presents Led Zeppelin.\\n\\nHer solo set pays homage to the voice as an instrument. Meditative, layers of Plumm’s voice looped and woven together in an intimate, transcending set.\\n\\n**YUIS**\\n\\nYUIS is a London-based Catalan flautist and producer. Coming from a classical music background, he is involved in a range of musical projects, including the jazz collective Levitation Orchestra. He has played for and collaborated with artists such as Eddie Chacon, John Carroll Kirby, Marysia Osu, and Joe Armon-Jones.\\n\\nHe will be opening the night with a solo set featuring atmospheric textures in an exploration of several Western and ethnic flutes, ranging from South America to India.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T12:30:00+00:00\",\"sale_end_date\":\"2026-03-06T18:30:00+00:00\",\"sale_start_date\":\"2026-02-14T13:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"699084cd3a8ebd0001f7ea6d\",\"name\":\"Plumm & YUIS\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/c0e38500-5f26-4cf9-86a0-696cd90a2c78.jpg?rect=0%2C230%2C2048%2C2048\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/c0e38500-5f26-4cf9-86a0-696cd90a2c78.jpg?rect=0%2C931%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/c0e38500-5f26-4cf9-86a0-696cd90a2c78.jpg?rect=174%2C0%2C1700%2C3091\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771072200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Df3445944e96?dice_id=Df3445944e96\",\"post_competition_referral\":\"https:/