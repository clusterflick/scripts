apple_music\",\"title\":\"D'Angelo - Cruisin'\",\"redirect_url\":\"https://music.apple.com/us/album/cruisin/1440842296?i=1440842311&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"D'Angelo\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/ff/7e/17/ff7e1777-6b89-fb76-fc92-f055f4e66bf1/mzaf_13133077178399752881.plus.aac.p.m4a\",\"track_name\":\"Cruisin'\"},{\"type\":\"spotify\",\"title\":\"D'Angelo - Unshaken\",\"redirect_url\":\"https://open.spotify.com/track/3okk47CKOqAm1TXmVPzNYf\",\"artist\":\"D'Angelo\",\"preview_url\":\"https://p.scdn.co/mp3-preview/28d99b0060e537e2062738aba5fe959fa399bab7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Unshaken\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by EGG.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-25T22:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"304\",\"name\":\"EGG\",\"image\":{\"url\":null},\"perm_name\":\"egg-zko9\",\"profile_active\":false},\"announcement_date_unix\":1717246800,\"social_links\":{\"event_share\":\"https://link.dice.fm/W500ad841ed6?dice_id=W500ad841ed6\",\"post_competition_referral\":\"https://link.dice.fm/p21cf67e36f1?dice_id=p21cf67e36f1\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tec4559952b0?dice_id=Tec4559952b0\",\"post_purchase_referral\":\"https://link.dice.fm/xcfeae9eb038?dice_id=xcfeae9eb038\",\"post_reminder_referral\":\"https://link.dice.fm/e2b3f5c2bc3a?dice_id=e2b3f5c2bc3a\",\"post_waitinglist_referral\":\"https://link.dice.fm/ja1949b87be6?dice_id=ja1949b87be6\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"bbxvpx-wednesday-club-house-electro-and-hip-hop-25th-feb-egg-ldn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772058600,\"has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:61\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C166%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=0%2C326%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/af4b7d20-761e-42e1-bf6a-0fdb32ec854b.jpg?rect=89%2C0%2C622%2C1131\"},\"id\":\"691b51b00239be00013b5b8e\",\"name\":\"Wednesday Club: House, Electro and Hip Hop\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Wednesday Club at Egg London\\n\\nMidweek, done properly.\\n\\nEvery Wednesday, Wednesday Club brings house, tech house, electro and hip hop to Egg London — built for students and anyone looking to switch off and reset before the weekend.\\n\\nDoors open from 22:30 – 04:00, with free entry before midnight plus a free shot when claimed online.\\n\\nExpect solid music all night, a mixed crowd, and selected drinks at £5 across the event.\\n\\nWhether you’re coming straight from uni, work, or just need a midweek release — Wednesday Club keeps things moving without the weekend\\n\\nchaos.\\n\\nEgg London\\n\\n 22:30 – 04:00\\n\\n Free entry before 00:00 + free shot (online claim required) \\n\\nHouse · Tech House · Electro · Hip Hop \\n\\n£5 selected drinks all night\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-06-01T14:00:00+01:00\",\"sale_end_date\":\"2026-02-26T02:30:00+00:00\",\"sale_start_date\":\"2024-06-01T14:00:00+01:00\",\"event_start_date\":\"2026-02-25T22:30:00+00:00\",\"event_end_date\":\"2026-02-26T04:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Wed 25 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fred again..\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-17/da72ae2d-ba45-4dfb-a1d7-df7e996f9a56.jpg?rect=0%2C585%2C3980%2C3980\"},\"artist_id\":\"14147\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":{\"description\":\"Love Ally Pally? Add a donation to care for the Palace and Park. Your gift helps to protect and restore this special place — for everyone, forever.\\n\\nA percentage of your donation goes towards a payment processing fee (neither DICE or the charity keep any of this fee). For a £10 donation, the charity gets £9.75.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1MTI5OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM2MTM0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OToyMC4xNDg1OTZaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzA5NiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1MTI5OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM2MTM0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OToyMC4xNDg2MThaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzA5NywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1MTI5OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM2MTM0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OToyMC4xNDg2MjdaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6MzA5OCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE1MTI5OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTM2MTM0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OToyMC4xNDg2MzZaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjMwOTksInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Alexandra Park and Palace Charitable Trust\",\"charity_registration_number\":\"281991\"},\"presented_by\":\"Presented by AEG.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":23131,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23132,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":64323,\"title\":\"How do I add my code?\",\"body\":\"In your email from co:brand, you will have received a unique code. You must apply this code to the event page before you can purchase tickets.\\n\\nTo apply your code on DICE:\\n\\n1\\\\. Follow the link in the email to the event page.\\n\\n2\\\\. Select the event date you wish to purchase tickets for.\\n\\n3\\\\. In the app: Scroll down to the section that says \\\"Got a code?\\\"\\n\\n4\\\\. On the web: Look for \\\"Got a code?\\\" on the left-hand side of the page, under the event image.\\n\\n5\\\\. Enter your unique code and tap Apply. This will unlock the ability to purchase tickets when they go on sale.\\n\\nOnce you’ve applied the code, the code unlocks the ability to purchase tickets for that specific show (up to the ticket limit). If you close the app or exit the window for some reason, the code to purchase tickets will remain linked to your account. You can simply head back to the event page/checkout, and the access will still be applied.\",\"order\":6},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7},{\"id\":64318,\"title\":\"How many tickets can I buy?\",\"body\":\"You can buy up to 4 tickets per person / code. If you buy multiple, you must arrive at the venue together.\",\"order\":9},{\"id\":64315,\"title\":\"Can I transfer my ticket? \",\"body\":\"Ticket transfers are not available for this event. If you have multiple tickets you must arrive together. If you cannot attend and the option is visible, please return your ticket to the wait list.\",\"order\":10},{\"id\":64395,\"title\":\"I don't have a code\",\"body\":\"The codes come from co:brand directly and we're not able to give these out.\",\"order\":11}],\"max_tickets\":4,\"properties\":[],\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-02-26T17:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"announcement_date_unix\":1765653480,\"social_links\":{\"event_share\":\"https://link.dice.fm/J4971389189a?dice_id=J4971389189a\",\"post_competition_referral\":\"https://link.dice.fm/Pe960c5a5ccd?dice_id=Pe960c5a5ccd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u8a90365f286?dice_id=u8a90365f286\",\"post_purchase_referral\":\"https://link.dice.fm/E7af42593dd5?dice_id=E7af42593dd5\",\"post_reminder_referral\":\"https://link.dice.fm/S96bd97c2208?dice_id=S96bd97c2208\",\"post_waitinglist_referral\":\"https://link.dice.fm/y2f2d1d66509?dice_id=y2f2d1d66509\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"8er557-fred-again-26th-feb-alexandra-palace-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2333,\"name\":\"Fred again..\",\"privacy_policy_link\":\"https://sites.google.com/goodlife-management.com/fredagainprivacy/home?authuser=2)\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1772125200,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:62\",\"price\":null,\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-13/ab20ccd5-b1b3-45db-b0e1-29055bf73839.jpg?rect=0%2C462%2C3695%2C3695\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-13/ab20ccd5-b1b3-45db-b0e1-29055bf73839.jpg?rect=0%2C1201%2C3695%2C2217\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-13/ab20ccd5-b1b3-45db-b0e1-29055bf73839.jpg?rect=578%2C0%2C2540%2C4619\"},\"id\":\"693d7b7c0d349b00014a3833\",\"name\":\"Fred again..\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Website opens at 9:30am. On sale at 10:00am\\n\\n**Fred again.. USB002 at Alexandra Palace**\\n\\n**\\\\+ guests TBA**\\n\\nTo be able to purchase tickets when they go on sale, you will need to have registered before 10pm on Sunday 14 December 2025.\\n\\nPlease note that transfer will not be available on DICE for this event. Please ensure to arrive with your full party.\\n\\nPhones: We’ll provide a sticker at entry to cover your phone cameras so everyone can stay in the moment. No cameras / video cameras allowed.\\n\\n*If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally*\\n\\n*Venue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#*\\n\\nPrice includes a £2.50 venue restoration levy.\\n\\n18+ only. Valid, government-issued photo ID is required for entry. Photos or photocopies of your ID are not an acceptable form of identification.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-13T19:18:00+00:00\",\"sale_end_date\":\"2026-02-26T21:00:00+00:00\",\"sale_start_date\":\"2025-12-18T09:30:00+00:00\",\"event_start_date\":\"2026-02-26T17:00:00+00:00\",\"event_end_date\":\"2026-02-26T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Fred again.. & Wallfacer - I Luv U\",\"redirect_url\":\"https://music.apple.com/us/album/i-luv-u/1859959566?i=1859959567&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Fred again.. & Wallfacer\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/0a/43/a0/0a43a0da-29a4-e2c6-c3f8-2901006f4e78/mzaf_16776804283097736739.plus.aac.p.m4a\",\"track_name\":\"I Luv U\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Parking Lot Lovers\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-08/3c471706-00fe-4cb4-8658-c3e3e5a9f709.jpg?rect=216%2C0%2C800%2C800\"},\"artist_id\":\"126794\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"New Cross Live presents\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\"