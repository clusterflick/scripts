,\"doors_open_date\":\"2026-02-21T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-08/6c4524d7-db73-419c-a040-b47c95480f40.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-08/6c4524d7-db73-419c-a040-b47c95480f40.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-08/6c4524d7-db73-419c-a040-b47c95480f40.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/bd293b8079d2?dice_id=bd293b8079d2\",\"post_competition_referral\":\"https://link.dice.fm/v23b76c9ca1c?dice_id=v23b76c9ca1c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b11bb7eaa511?dice_id=b11bb7eaa511\",\"post_purchase_referral\":\"https://link.dice.fm/M33bfa73a289?dice_id=M33bfa73a289\",\"post_reminder_referral\":\"https://link.dice.fm/Ce000bb7df9b?dice_id=Ce000bb7df9b\",\"post_waitinglist_referral\":\"https://link.dice.fm/P98cdd8b6c3d?dice_id=P98cdd8b6c3d\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:6\",\"properties\":[],\"presented_by\":\"Presented by Hootananny Brixton.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1752051600,\"id\":\"686d50dbedac8d0001555933\",\"name\":\"Lee Scratch Perry + Black Ark Memorial Show \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**For one night only, we bring you the iconic sounds of the GENIUS that was Lee \\\"Scratch\\\" Perry**\\n\\nTo celebrate one of reggae's brightest and unique star, we invite Omar Perry - the son of dub legend.\\n\\nOmar has forged his own path in reggae with seven studio albums and global tours. A powerful voice rooted in deep heritage, Omar now joins forces with ERM, led by Olivier Gangloff—a close friend and collaborator of Lee Perry.\\n\\nTheir project, \\\"Channeling Lee 'Scratch' Perry,\\\" blends Omar’s unique style with the spirit and sonic legacy of his father. More than a tribute, it’s a bold, living continuation of reggae’s mystical roots.\\n\\n\\\\+ support from Rickette Genesis\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false},\"date_unix\":1771700400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3100,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-19T00:00:00+01:00\",\"sale_end_date\":\"2026-02-21T19:00:00+00:00\",\"sale_start_date\":\"2025-06-19T00:00:00+01:00\",\"event_start_date\":\"2026-02-21T19:00:00+00:00\",\"event_end_date\":\"2026-02-21T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"v376wv-northern-soul-live-21st-feb-the-jazz-cafe-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras