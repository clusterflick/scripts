e_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6d23e2-artificial-monkeys-6th-jun-new-cross-inn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780765200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:87\",\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/1cfa93b8-6991-48bb-ba34-a7a715b449d4.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/1cfa93b8-6991-48bb-ba34-a7a715b449d4.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/1cfa93b8-6991-48bb-ba34-a7a715b449d4.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69807cd11a3dbe000159b5d5\",\"name\":\"Artificial Monkeys\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Artificial Monkeys\\n\\nCelebrating 20 years of the debut album plus all the hits up to AM\\n\\nhttps://www.facebook.com/artificialmonkeys\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-06-05T17:00:00+01:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-06-06T18:00:00+01:00\",\"event_end_date\":\"2026-06-06T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Haymaker\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273fed2b0417096272bbdef3144\"},\"artist_id\":\"7639\",\"about\":null,\"is_headliner\":true},{\"name\":\"A.C.A.B.\",\"image\":null,\"artist_id\":\"128104\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by A.C.A.B. Productions and Black Label\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":47958,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":47959,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":47960,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-06T18:00:00+01:00\",\"doors_close_date\":\"2026-06-06T22:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1759186800,\"social_links\":{\"event_share\":\"https://link.dice.fm/z36a968346f3?dice_id=z36a968346f3\",\"post_competition_referral\":\"https://link.dice.fm/T3024dfcf226?dice_id=T3024dfcf226\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Q77f00442e2c?dice_id=Q77f00442e2c\",\"post_purchase_referral\":\"https://link.dice.fm/Cc9d048dbf2b?dice_id=Cc9d048dbf2b\",\"post_reminder_referral\":\"https://link.dice.fm/B6a4aa22cbf1?dice_id=B6a4aa22cbf1\",\"post_waitinglist_referral\":\"https://link.dice.fm/Tf9ea22cb37c?dice_id=Tf9ea22cb37c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"ryb8oy-acab-x-haymaker-6th-jun-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780765200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:88\",\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-30/b9be6115-6892-40a4-84db-75df04b0326a.jpg?rect=0%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-30/b9be6115-6892-40a4-84db-75df04b0326a.jpg?rect=0%2C256%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-30/b9be6115-6892-40a4-84db-75df04b0326a.jpg?rect=288%2C0%2C704%2C1280\"},\"id\":\"68dbccfc70774c000119005f\",\"name\":\"A.C.A.B. X HAYMAKER\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"A.C.A.B., t