null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:96\",\"about\":{\"description\":\"***The Sam Sweeney Trio brings together three of the UK’s most compelling folk musicians to play music from across Sam’s discography: Sam Sweeney (violin), Ben Nicholls (double bass), and Louis Campbell (guitar).***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nKnown for his expressive playing and bold musical vision, Sam Sweeney leads the trio through richly textured arrangements of traditional and original material. With Ben Nicholls’ deep, resonant bass and Louis Campbell’s innovative guitar work, the trio crafts a sound that is both grounded in English folk tradition and alive with contemporary energy.\\n\\nSam will delve into his back catalogue of solo and band albums, as well as air some brand new material.\\n\\n**In partnership with Alan Bearman Music**\\n\\n***This event will last approximately 110 minutes, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"ca24a0fb-3a8e-4977-9f9a-32ea30a9c7d2\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"seat_selection\":\"disabled\"},\"announcement_date_unix\":1759276800,\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sam Sweeney\",\"image\":null,\"artist_id\":\"23975\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-01/87570db7-4268-4091-9fe1-208d0c3faf29.jpg?rect=0%