ments/2025-02-27/be72b6e7-49c2-42c7-ac59-7ae3554bd42c.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-02-27/be72b6e7-49c2-42c7-ac59-7ae3554bd42c.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-02-27/be72b6e7-49c2-42c7-ac59-7ae3554bd42c.jpg?rect=173%2C0%2C422%2C768\"},\"properties\":[],\"about\":{\"description\":\"FORM Presents\\n\\nIchiko Aoba\\n\\nwith 12 Ensemble\\n\\n\\\\+ Special Guests: Liana Flores\\n\\nAoba will once again be joined by members of Europe's leading string orchestras, 12 Ensemble, alongside long time collaborator Taro Umebayashi for what will be her most ambitious production outside of Japan to date. Aoba & Umebayashi will be joined by nine musicians on stage, performing orchestrated versions of many of their now iconic compositions.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event (U14s with an adult over 18).\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"67c1ba40edf9530001c0195b\",\"name\":\"Ichiko Aoba\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"太陽さん\",\"redirect_url\":\"https://open.spotify.com/track/1yycinn2WICj4UKGQ9xPjD\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2c718b00743321a43ee9db973ccf619bb0fb101a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"太陽さん\"},{\"type\":\"apple_music\",\"title\":\"Ichiko Aoba - Ikinokori●Bokura\",\"redirect_url\":\"https://music.apple.com/gb/album/ikinokori-bokura/720743229?i=720743504&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ichiko Aoba\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview71/v4/7f/15/b8/7f15b896-20c1-dd27-66a9-9f9565eb0441/mzaf_1610908018140846340.plus.aac.p.m4a\",\"track_name\":\"Ikinokori●Bokura\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Liana Flores\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-26/5863f163-e77d-4026-87ab-b03baf6dc802.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"85167\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ichiko Aoba\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-02-27/70723f1e-ed22-4cf5-b81c-a1170ae6aa48.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"16411\",\"about\":{\"description\":\"Indie folk artist Ichiko Aoba is proof that a message doesn’t have to be loud to resonate: she creates an ethereal world with gentle instrumentation (she plays guitar, as well as piano, clarinet and accordion), delicate vocals, and scenes inspired by dreams and fantasies. Though her lyrics are in Japanese, she projects a serenity that transcends language. Aoba has been growing a loyal following in Japan since 2010, but international interest surged in 2020 after the release of her seventh LP, Windswept Adan, which Uncut described as “exquisitely crafted, lightly experimental chamber-folk”.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T14:00:00+01:00\",\"sale_end_date\":\"2026-03-31T19:00:00+01:00\",\"sale_start_date\":\"2025-10-03T10:00:00+01:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":\"2025-10-02T10:00:00+01:00\"},\"offers_extras\":false,\"faqs\":[{\"id\":45746,\"title\":\"What are the ages restrictions for this event?\",\"body\":\"This is a 16+ event. All attendees 16-17s must be accompanied by a responsible adult who is 18 or older (1:1 ratio). To verify age, ID may be requested. We advise all customers to bring valid ID. For further information, see Age and ID in FAQs. Right of admission reserved.\",\"order\":0}],\"marketeers\":[{\"id\":338,\"name\":\"FORM Pre