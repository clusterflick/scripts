s://link.dice.fm/Gbcd86fb6246?dice_id=Gbcd86fb6246\",\"post_purchase_referral\":\"https://link.dice.fm/hd80a0b93a84?dice_id=hd80a0b93a84\",\"post_reminder_referral\":\"https://link.dice.fm/Z11c292dc12c?dice_id=Z11c292dc12c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pb994d63c543?dice_id=Pb994d63c543\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":300,\"name\":\"Ronnie Scott's\",\"privacy_policy_link\":\"https://www.ronniescotts.co.uk/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:12\",\"properties\":[\"selling_fast\"],\"presented_by\":\"Presented by Ronnie Scott's.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769790600,\"id\":\"697cf586a33ec700016898c5\",\"name\":\"Ronnie's Lates: North at The Post Bar with TUCAN\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Ronnie’s Lates returns. After the success of the first series, we’re taking the legendary energy of the Ronnie Scott’s Late Late Show back out of Soho and into London’s grassroots venues – this time expanding across the city. The second series kicks off in North London with Ronnie’s Lates: North at The Post Bar in Tottenham featuring TUCAN.**\\n\\nA regular fixture of the Late Late Show, TUCAN are one of the most exciting and innovative collectives in the UK jazz scene. Their sound is a melting pot of contemporary influences, fusing hard-hitting grooves, experimental harmony and captivating melodies, with soul, funk and R&B influences inspired by Snarky Puppy, Robert Glasper and Cory Henry.\\n\\nFormed in 2017 at the Liverpool Institute for Performing Arts and now based in London, TUCAN are rooted in community and togetherness, with members from across the UK and around the world. Their high-energy live shows are built to move bodies and bring people together, earning them sold-out Late Late Shows at Ronnie Scott’s, festival appearances at the EFG London Jazz Festival and LIMF, and a monthly residency at 91 Living Room.\\n\\nTheir latest release The Nest. Volume 1, captures their creative evolution within the London jazz scene. Expect close-up, no-filter sets and the unmistakable Ronnie’s spirit, just in a new postcode.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1321\",\"name\":\"Ronnie Scott's\",\"image\":{\"url\":null},\"perm_name\":\"ronnie-scotts-eklo\",\"profile_active\":false},\"date_unix\":1771702200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":900,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T00:00:00+00:00\",\"sale_end_date\":\"2026-02-21T22:00:00+00:00\",\"sale_start_date\":\"2026-01-22T00:00:00+00:00\",\"event_start_date\":\"2026-02-21T19:30:00+00:00\",\"event_end_date\":\"2026-02-21T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"2wk3v6-hoy-chorale-lanny-camberwell-group-21st-feb-the-horse-hospital-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Hoy Chorale - Rose-Tinted Glasses\",\"redirect_url\":\"https://open.spotify.com/track/31jhldU5fl9Ke2GS9o2HHR\",\"artist\":\"Hoy Chorale\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9cc9ff75ce40e61eece23c60fe6f584725131dd7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Rose-Tinted Glasses\"},{\"type\":\"apple_music\",\"title\":\"Hoy Ch