tras_available_referral\":\"https://link.dice.fm/Ffca45e4a0df?dice_id=Ffca45e4a0df\",\"post_purchase_referral\":\"https://link.dice.fm/T6e1b2be1be6?dice_id=T6e1b2be1be6\",\"post_reminder_referral\":\"https://link.dice.fm/Z13e9b81ec76?dice_id=Z13e9b81ec76\",\"post_waitinglist_referral\":\"https://link.dice.fm/Dde446805bbc?dice_id=Dde446805bbc\"},\"perm_name\":\"ww5por-hyunhye-angela-seo-of-xiu-xiu-7th-may-sjq-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/aa79c47b-d46a-4838-b7c1-29edf7ef700b.jpg?rect=0%2C129%2C1047%2C1047\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/aa79c47b-d46a-4838-b7c1-29edf7ef700b.jpg?rect=0%2C286%2C1047%2C628\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/aa79c47b-d46a-4838-b7c1-29edf7ef700b.jpg?rect=194%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"***Hyunhye -*** Hyunhye (Angela) Seo is an artist exploring experimental composition and sound, creating deep turbulent soundscapes through ecstatic piano improvisations, dynamic percussion, and cavernous acoustic treatments. Her live performances are uncompromising in its open and immediate exploration of sounds, pulling from experimental noise, modern classical, avant-garde jazz, and ambient territories. She is a longtime member of the acclaimed avant-garde band Xiu Xiu, contributing to writing, recording, production, and international performances.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69806feab47e1200019908b2\",\"name\":\"Hyunhye (Angela) Seo of Xiu Xiu\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Hyunhye Seo - Eel I\",\"redirect_url\":\"https://op