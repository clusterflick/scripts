e,\"impression_id\":\"19a35eea7aa005ca:22\",\"date_unix\":1774807200,\"price\":{\"currency\":\"GBP\",\"amount\":1683,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/t3a92fbe3d42?dice_id=t3a92fbe3d42\",\"post_competition_referral\":\"https://link.dice.fm/fa474b34a640?dice_id=fa474b34a640\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/L07be52be343?dice_id=L07be52be343\",\"post_purchase_referral\":\"https://link.dice.fm/u5c2fdcfdf0a?dice_id=u5c2fdcfdf0a\",\"post_reminder_referral\":\"https://link.dice.fm/q557ee0c2123?dice_id=q557ee0c2123\",\"post_waitinglist_referral\":\"https://link.dice.fm/Rf76f1162d32?dice_id=Rf76f1162d32\"},\"perm_name\":\"l8bmbl-buybritish-live-29th-mar-the-lower-third-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/6a6161da-bcee-4db9-8788-ab54e9cdf244.jpg?rect=341%2C0%2C1367%2C1367\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/6a6161da-bcee-4db9-8788-ab54e9cdf244.jpg?rect=0%2C69%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/6a6161da-bcee-4db9-8788-ab54e9cdf244.jpg?rect=648%2C0%2C752%2C1367\"},\"properties\":[],\"about\":{\"description\":\"Step into a sonic world where emotion meets rhythm and boundaries blur. afrosurrealist & friends is the headline show by one of the UK’s most intriguing young producers, afrosurrealist. Bursting out of the underground with a sound that defies genre, afro has carved his own lane between grime, alternative UK rap and Afro-fusion, blending soulful textures, ambient layers and hard-hitting UK energy into a truly unique live experience.\\n\\nHailing from Milton Keynes via South London, afrosurrealist has quickly become a faceless phantom of the UK scene, forging beats that feel more like feelings than formulas. With acclaimed releases like his Reworks EP and debut album BUYBRITISH, his production nods to heritage while pushing forward with fresh UK narratives and inviting collaborators into a shared creative universe.\\n\\nAt afrosurrealist & friends, expect an immersive night of boundary-breaking production, live performances from afro’s closest musical allies, and a celebration of the community and culture that fuels his artistry. With influences ranging from grime and jazz to gospel and soul, afro’s music is a tribute to the Black British experience, both reflective and forward-thinking, and this show brings that journey to life.\\n\\nCome witness an artist stepping fully into his own light, surrounded by friends, collaborators and the next wave of UK music.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"697b67830c6b570001691e78\",\"name\":\"#buybritish: live\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T12:00:00+00:00\",\"sale_end_date\":\"2026-03-29T18:00:00+01:00\",\"sale_start_date\":\"2026-01-28T18:00:00+00:00\",\"event_start_date\":\"2026-03-29T19:00:00+01:00\",\"event_end_date\":\"2026-03-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":68517,\"title\":\"Ticket Terms and Conditions\",\"body\":\"ID to match ticket purchase required on entry \\n\\nNo filming \\n\\nNo photos\\n\\nTickets are Non-transferable \\n\\nIf you are unable to attend please return your tickets to the DICE Waiting List\",\"order\":0}],\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzarotework