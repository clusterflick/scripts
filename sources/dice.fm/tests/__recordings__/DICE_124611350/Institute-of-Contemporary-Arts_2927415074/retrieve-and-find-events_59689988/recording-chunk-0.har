ats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/c57bac09-2e13-4411-83fa-138cda7a9aaa.jpg?rect=0%2C0%2C778%2C778\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/c57bac09-2e13-4411-83fa-138cda7a9aaa.jpg?rect=0%2C156%2C778%2C467\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/c57bac09-2e13-4411-83fa-138cda7a9aaa.jpg?rect=175%2C0%2C428%2C778\"},\"id\":\"69778d9591a2d50001f68806\",\"name\":\"Super Shorts Sci-Fi Film Festival\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"A one-night journey into bold narratives & mind-bending ideas, told through exceptional sci-fi short films.\\n\\nSuper Shorts Sci-Fi is a live cinematic screening event showcasing some of the most exciting and thought-provoking science fiction short films being made today. Carefully curated for impact, originality and imagination, this is a shared big screen experience to entertain and surprise you.\\n\\nWhether you’re a sci-fi fan or just looking for a fun night out, these smart visually striking short films exploring the future of technology, identity and humanity will spark conversations at the bar in the gigantic screening space of this amazing venue.\\n\\nAnd all for less than the price of a standard cinema ticket!\\n\\nEvent schedule:\\n\\n- Doors: 7:00pm Event starts: 8:00pm\\n- Running times: Approximately 2 hours including interval\\n\\nThis is an 18+ event\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-03-13T20:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2026-03-13T20:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_