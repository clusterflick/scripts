ation\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"helgis-berx\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:64\",\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nBong II + Molch at Helgi's\\n\\nBong II marks an entirely new phase of existence born from the smouldering cosmic residue of Bong. Reuniting drummer Mike Smith with vocalist/bassist Dawn Terry, the duo now steps boldly into uncharted sonic territory with the addition of Daniel Foggin of Newcastle's Smote.\\n\\nBong II are both a continuation and a transformation. The ritualistic heaviness and repetition continue as ever but the familiar drone monolith exudes strange new frequencies\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769763600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/51dd007d-a860-47ed-af95-1cd704daf228.jpg?rect=0%2C0%2C2048%2C2048\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/51dd007d-a860-47ed-af95-1cd704daf228.jpg?rect=0%2C410%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/51dd007d-a860-47ed-af95-1cd704daf228.jpg?rect=461%2C0%2C1126%2C2048\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6932c3599f9ef00001b2d399\",\"name\":\"Bong II + Molch\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T09:00:00+00:00\",\"sale_end_date\":\"2026-04-24T18:00:00+01:00\",\"sale_start_date\":\"2026-02-02T10:00:00+00:00\",\"event_start_date\":\"2026-04-24T19:30:00+01:00\",\"event_end_date\":\"2026-04-24T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"538x2w-bong-ii-molch-24th-apr-helgis-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1965,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":2,\"social_links\":{\"event_share\":\"https://link.dice.fm/f943fe354526?dice_id=f943fe354526\",\"post_competition_referral\":\"https://link.dice.fm/W1cf219abb1c?dice_id=W1cf219abb1c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K01dfa41db22?dice_id=K01dfa41db22\",\"post_purchase_referral\":\"https://link.dice.fm/Uf57f4ac1812?dice_id=Uf57f4ac1812\",\"post_reminder_referral\":\"https://link.dice.fm/me3065e3eb68?dice_id=me3065e3eb68\",\"post_waitinglist_referral\":\"https://link.dice.fm/O105bdd6471d?dice_id=O105bdd6471d\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sleepy Town\",\"redirect_url\":\"https://open.spotify.com/track/1SoryFeJSYoDkPqqAQF5dY\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/936ce14ab18018eb424092525ba34198c1ec62b5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sleepy Town\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Kings Place.\",\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"date_unix\":1777055400,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:65\",\"about\":{\"description\":\"***Amelia Coburn opens Kings Place Folk Weekend 2026, sharing her knack for making the unusual sound timeless. Her honest, occasionally hilarious and quintessentially north-eastern persona disarms and beguiles in equal measure.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nDrawing inspiration from gothic literature and the shadowy allure of film noir, there is a darkness at the heart of many of Amelia Coburn’s songs, populated by vivid characters and nocturnal creatures that inhabit the liminal space “between the moon and the milkman”.\\n\\n2024’s Bill Ryder-Jones produced debut album gained a cult following, including praise from British music legends Paul Weller and Paul Heaton – as well as national radio play across BBC Radios 2, 3, 4, 5 and 6. Hailed as ‘one to watch in 2025’ by *Louder Than War* and *Drowned In Sound*, Amelia hit the ground running with spellbinding sets at SXSW in Texas and a feature on Paul Weller’s latest album *Find El Dorado*.\\n\\nSupported by PRS Foundation’s Open Fund and inspired by the feminist works of writers like Angela Carter and Clarissa Pinkola Estés, Coburn’s latest single *Something Wild* continues to solidify Coburn’s burgeoning reputation.\\n\\n***This event will last approximately 75 minutes, with no interval.***\\n\\n**Please note that this is a standing event.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1763600400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/3660c90f-ca51-4d0b-94c0-1f947bef0e0b.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/3660c90f-ca51-4d0b-94c0-1f947bef0e0b.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/3660c90f-ca51-4d0b-94c0-1f947bef0e0b.jpg?rect=2