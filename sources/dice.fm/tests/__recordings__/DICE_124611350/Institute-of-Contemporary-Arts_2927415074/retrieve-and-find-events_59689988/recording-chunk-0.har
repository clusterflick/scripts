"seats_io_public_key\":null,\"presented_by\":\"Presented by Black Frog\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"dkaxm6-tom-waters-band-ft-geoff-achison-11th-jun-hot-box-chelmsford-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781200800,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:20\",\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-11T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tom Waters\",\"image\":null,\"artist_id\":\"130877\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Tom Waters, rising star in the world of rhythm & blues, jazz, funk, blues, Latin and roots music and his band, featuring Aussie guitar legend Geoff Achison bring their “Brush with the Blues” to HOT BOX following a highly successful 2025 Australian tour. Known for their fiery musicianship, the show promises an unforgettable, action-packed set stacked with hard-hitting originals and timeless roots classics.\\n\\nWaters’ rollicking, honky sax and Achison’s sizzling guitar and vocals offer their unique take across Blues, Rock, Country, Rock, Funky Jazz & Folk, with blistering solos and deep pulsating rhythms.\\n\\nTo quote Queen’s Brian May, “You’re pure evil on that horn, Tom!” whilst Geoff has been compared with the likes of Eric Clapton, Jeff Beck & JJ Cale.\\n\\nThis is live music at its best!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:00:00+00:00\",\"sale_end_date\":\"2026-06-11T19:00:00+01:00\",\"sale_start_date\":\"2025-12-01T00:00:00+00:00\",\"event_start_date\":\"2026-06-11T19:00:00+01:00\",\"event_end_date\":\"2026-06-11T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"692e072d2533e1000193d4f8\",\"name\":\"Tom Waters Band ft. Geoff Achison\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/6be88967-5955-4d10-95a8-3a5c69973fdd.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/6be88967-5955-4d10-95a8-3a5c69973fdd.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/6be88967-5955-4d10-95a8-3a5c69973fdd.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764547200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/s5b73fcfb186?dice_id=s5b73fcfb186\",\"post_competition_referral\":\"https://link.dice.fm/fbf0e92c5f86?dice_id=fbf0e92c5f86\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b27ea0fcc242?dice_id=b27ea0fcc242\",\"post_purchase_referral\":\"https://link.dice.fm/ucd83cd7817b?dice_id=ucd83cd7817b\",\"post_reminder_referral\":\"https://link.dice.fm/Eb0dd146cf08?dice_id=Eb0dd146cf08\",\"post_waitinglist_referral\":\"https://link.dice.fm/q5a7d6d7eed7?dice_id=q5a7d6d7eed7\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"3onmmv-ruins-residency-night-2-11th-jun-cafe-oto-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781202600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:21\",\"venues\":[{\"id\":\"590\",\"name\":\"Cafe OTO\",\"address\":\"18-22 Ashwin St, London E8 3DL\",\"location\":{\"lat\":51.5469452,\"lng\":-0.0744654999999739},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"cafe-oto-92e6\",\"accessibility\":{\"url\":\"https://www.cafeoto.co.uk/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-11T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ruins\",\"image\":null,\"artist_id\":\"88801\",\"about\":null,\"is_headliner\":false},{\"name\":\"吉田達也\",\"image\":null,\"artist_id\":\"130640\",\"about\":null,\"is_headliner\":false},{\"name\":\"RUINS alone\",\"image\":null,\"artist_id\":\"130642\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nRuins Residency - Night 2\\n\\nTatsuya Yoshida x Risa Takeda\\n\\nThis is Tokyo's most notable improv duo at the moment. The duo consisting of Tatsuya Yoshida, the strongest drummer in the avant-prog scene, and Risa Takeda, the keyboardist who is currently attracting the most attention in Tokyo's improv scene, will be touring Europe for the first time. An unparalleled worldview brought about by thrilling antagonism and harmony unfolding at high speed. The highly structured and highly improvised performance, which freely moves between classical, contemporary music, progressive rock, and jazz rock, overwhelms the audience with the number and sound pressure of a band, even though it is performed by two people.\\n\\nRisa Takeda\\n\\nRisa Takeda Born in Hokkaido. Started classical piano at age 3. Active as drummer while at University. Moved to Tokyo in April 2011 and while with various bands, began solo performances in 2016. Improvisations, compositions with visuals and piano arrangements of Frank Zappa’s material have brought worldwide recognition. Released 3 albums, in which composed, arranged, performed, and recorded all by oneself. The result is a massive work of music, full of complex melodies, harmonies, rhythms, and sequences of sounds, which are freely realized by the ensemble, but with great precision.\\n\\nIn live performances, performed with Akira Sakata, Tatsuya Yoshida, Seiichi Yamamoto, Tadahiko Yokogawa, Keiichi Suzuki, and Mani Neumeier (titles omitted), further expanding the scope of his activities.\\n\\nTatsuya Yoshida\\n\\nThe most important drummer/composer/improviser in the modern Japanese avant-garde music scene. Started performing at live houses in Tokyo in the early 1980s. He has a powerful, polyrhythmic, and fast-paced playing style that often uses odd time signatures, and he has participated in many groups. Formed in 1985, RUINS has been highly acclaimed overseas for its innovative sound, which combines the explosion of energy of its solid rhythm section with vocals in his original language, and has frequently toured overseas. Since the 1990s, he has started bands based on different concepts one after another, such as Koenji Hyakkei, Korekyojin, Zubizuba, and Akaten, and has composed most of the repertoire. He has been playing with musicians such as John Zorn, Bill Lazwell, Derek Bailey, Keiji Haino, Otomo Yoshihide, etc. also played with the bands like a Samla Mammas Manna, Acid Mothers Gong, John Zorn’s Painkiller as member. In recent years, In recent years, he has focused on improvisation and has collaborated with jazz musicians too. He has released over 100 works on various labels in Japan and abroad, including participation in sessions.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T15:00:00+00:00\",\"sale_end_date\":\"2026-06-11T18:00:00+01:00\",\"sale_start_date\":\"2026-02-10T15:00:00+00:00\",\"event_start_date\":\"2026-06-11T19:30:00+01:00\",\"event_end_date\":\"2026-06-11T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69246bbc5428890001740567\",\"name\":\"Ruins Residency - Night 2\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/19425fc2-ac1a-4667-9fae-559e4c1297de.jpg?rect=366%2C0%2C1819%2C1819\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/19425fc2-ac1a-4667-9fae-559e4c1297de.jpg?rect=0%2C144%2C2551%2C1531\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/19425fc2-ac1a-4667-9fae-559e4c1297de.jpg?rect=776%2C0%2C1000%2C1819\"},\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770735600,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/s829f07fe681?dice_id=s829f07fe681\",\"post_competition_referral\":\"https://link.dice.fm/Hbf25d17d994?dice_id=Hbf25d17d994\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d2c8b6619ebf?dice_id=d2c8b6619ebf\",\"post_purchase_referral\":\"https://link.dice.fm/i49adbb10fb8?dice_id=i49adbb10fb8\",\"post_reminder_referral\":\"https://link.dice.fm/sef235d15231?dice_id=sef235d15231\",\"post_waitinglist_referral\":\"https://link.dice.fm/nc98bd58936a?dice_id=nc98bd58936a\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ruins - Outburn\",\"redirect_url\":\"https://open.spotify.com/track/0EZCSszPYCf5rz0nUQWA7G\",\"artist\":\"Ruins\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9742001c37af8ee6228bbe869cfb28bffb17b623?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Outburn\"},{\"type\":\"apple_music\",\"title\":\"Ruins - Outburn\",\"redirect_url\":\"https://mus