\"},\"perm_name\":\"soho-theatre-walthamstow-yoy72\",\"accessibility\":{\"url\":\"https://sohotheatre.com/accessible-performances/\"},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-05-08T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:13\",\"about\":{\"description\":\"Dutch composer and pianist **Joep Beving** returns to the stage in 2026 with a new album and a new series of performances shaped by the ideas and musical explorations he has been developing in recent years. His focus on themes such as change, uncertainty and renewal has led him to search for ways in which sound can create space for reflection and connection in a world that often feels in flux.\\n\\nKnown for his reflective and spacious piano work, Joep’s latest material - featured on his forthcoming album - moves with a sense of openness and curiosity. It balances structure and intuition, often feeling guided by both the human hand and something more organic. The pieces invite listeners into moments of stillness, movement and contemplation, where clarity and ambiguity can coexist.\\n\\nThese concerts bring Joep’s evolving musical language to an intimate live setting, offering audiences the first chance to experience the atmosphere and ideas that shape his new album.\\n\\nSupport comes from **Michael A. Muller**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. U16s must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"543378ce-c5d2-4781-a2c2-b605f4ce0ab1\",\"seats_io_public_key\":\"4c41b814-5560-49f4-aabc-51ed462da4bd\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1764666000,\"seats_io_public_key\":\"4c41b814-5560-49f4-aabc-51ed462da4bd\",\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Michael A. Muller\",\"image\":null,\"artist_id\":\"132951\",\"about\":null,\"is_headliner\":false},{\"name\":\"Joep Beving\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb5cc83133b730d75e7c0f3625\"},\"artist_id\":\"9756\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/bf9c6b35-2571-4126-b66b-dfef14b015e5.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/bf9c6b35-2571-4126-b66b-dfef14b015e5.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/bf9c6b35-2571-4126-b66b-dfef14b015e5.jpg?rect=450%2C0%2C1100%2C2000\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"692dc4ae3f4fd2000145c396\",\"name\":\"Joep Beving\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T09:00:00+00:00\",\"sale_end_date\":\"2026-05-08T18:00:00+01:00\",\"sale_start_date\":\"2025-12-04T09:00:00+00:00\",\"event_start_date\":\"2026-05-08T19:00:00+01:00\",\"event_end_date\":\"2026-05-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"926dl9-joep-beving-8th-may-soho-theatre-walthamstow-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3642},\"max_tickets\":8,\"social_links\":{\"event_share\":\"https://link.dice.fm/Y42526854391?dice_id=Y42526854391\",\"post_competition_referral\":\"https://link.dice.fm/H2d69316ffa6?dice_id=H2d69316ffa6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D190bb66e712?dice_id=D190bb66e712\",\"post_purchase_referral\":\"https://link.dice.fm/D17282619508?dice_id=D17282619508\",\"post_reminder_referral\":\"https://link.dice.fm/x36f1b22a08c?dice_id=x36f1b22a08c\",\"post_waitinglist_referral\":\"https://link.dice.fm/k304c24d1417?dice_id=k304c24d1417\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Where Love Lives (Come On In) - Classic Mix\",\"redirect_url\":\"https://open.spotify.com/track/3I3C1f1JzPPK6zTDSHDXTw\",\"artist\":\"Where Love Lives (Come On In)\",\"preview_url\":\"https://p.scdn.co/mp3-preview/499233a0f68c3646033ccd9557f7b188922a2e20?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Classic Mix\"},{\"type\":\"apple_music\",\"title\":\"Alison Limerick - Where Love Lives (featured on the John Lewis Christmas Advert 2025)\",\"redirect_url\":\"https://music.apple.com/us/album/where-love-lives-featured-on-the-john-lewis-christmas/273861300?i=273861379&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alison Limerick\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/fb/f5/55/fbf555ac-7fa0-59de-c5a6-e2e9b36aff12/mzaf_3959739351674222600.plus.aac.p.m4a\",\"track_name\":\"Where Love Lives (featured on the John Lewis Christmas Advert 2025)\"}],\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Senbla.\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1778263200,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-08T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:14\",\"about\":{\"description\":\"*Singer-songwriter Alison Limerick has announced a London headline show for 2026, taking place at Islington Assembly Hall on Friday 8 May.*\\n\\n*The announcement follows on from the recent resurgence of her legendary house/dance music hit ‘Where Love Lives’ (the classic Frankie Knuckles & David Morales mix), which features prominently in this year’s nostalgic John Lewis Christmas advert, alongside a re-imagined version by globally acclaimed artist and producer Labrinth.*\\n\\n*The campaign taps into the warmth and sentimentality of the season while spotlighting one of dance music’s most enduring vocal anthems - a track that became a defining moment of UK club and rave culture in the early ’90s.*\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765447200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Alison Limerick\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb5e8b9043206e9ad1fdf1da6e\"},\"artist_id\":\"46673\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/44648f10-1eec-4071-b01e-f30fdeacecda.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/44648f10-1eec-4071-b01e-f30fdeacecda.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/44648f10-1eec-4071-b01e-f30fdeacecda.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69296c3184d3e300013ef825\",\"name\":\"Alison Limerick\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-11T10:00:00+00:00\",\"sale_end_date\":\"2026-05-08T21:00:00+01:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-05-08T19:00:00+01:00\",\"event_end_date\":\"2026-05-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"ryapow-alison-limerick-8th-may-islington-assembly-hall-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3575,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/a26d1c2ee3b7?dice_id=a26d1c2ee3b7\",\"post_competition_referral\":\"https://link.dice.fm/Fade6137db44?dice_id=Fade6137db44\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/abd756e0c819?dice_id=abd756e0c819\",\"post_purchase_referral\":\"https://link.dice.fm/L40c7f13f07a?dice_id=L40c7f13f07a\",\"post_reminder_referral\":\"https://link.dice.fm/ff6c1e73b348?dice_id=ff6c1e73b348\",\"post_waitinglist_referral\":\"https://link.dice.fm/z54378f7692a?dice_id=z54378f7692a\"},\"previews\":[],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1778263200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-08T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:15\",\"about\":{\"description\":\"AGMP Concerts presents\\n\\nOMAR SOSA & SECKOU KEITA SUBA TRIO with Gustavo Ovalles\\n\\nThe Atlantic Ocean separates Cuba and Senegal, the respective birthplaces of piano virtuoso Omar Sosa and kora maestro Seckou Keita, a distance diminished by their shared ancestral connection to Africa. When the pair met in 2012, Seckou loved Omar for his musical spirituality, whilst Omar saw in Seckou a rare ability to collaborate but not lose his identity. Their debut album Transparent Water (2017) was hailed as \\\"beautiful, rhapsodic... spiritual\\\" (Songlines) and \\\"mesmerising, evocative and sophisticated\\\" (World Music Central).\\n\\nOmar Sosa has released over 30 albums during an incredible career that has included nominations for seven GRAMMY or Latin GRAMMY awards; Seckou Keita is a multi-award winner, most recently as the prestigious BBC Radio 2 Folk Musician of the Year (2019). Recorded during lockdown and released in 2021, Sosa and Keita's second album SUBA is a hymn to hope, to a new dawn of compassion and real change in a post-pandemic world, a visceral reiteration of humanity's perennial prayer for peace and unity. Joining Omar Sosa and Seckou Keita in the studio and for live performances is the inimitable Venezuelan percussionist Gustavo Ovalles.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1764028800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/776711fd-ad07-463b-bba1-387689f35a87.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/776711fd-ad07-463b-bba1-387689f35a87.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/776711fd-ad07-463b-bba1-387689f35a87.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6926363ebadc12000157949a\",\"name\":\"Omar Sosa & Seckou Keita Suba Trio\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T00:00:00+00:00\",\"sale_end_date\":\"2026-05-08T01:15:00+01:00\",\"sale_start_date\":\"2025-11-25T00:00:00+00:00\",\"event_start_date\":\"2026-05-08T19:00:00+01:00\",\"event_end_date\":\"2026-05-08T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"nvwg93-omar-sosa-seckou-keita-suba-trio-8th-may-union-chapel-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3523},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/ode9afbe5471?dice_id=ode9afbe5471\",\"post_competition_referral\":\"https://link.dice.fm/Wa9ac5700a6d?dice_id=Wa9ac5700a6d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ge91a2959133?dice_id=ge91a2959133\",\"post_purchase_referral\":\"https://link.dice.fm/y3f932742aaa?dice_id=y3f932742aaa\",\"post_reminder_referral\":\"https://link.dice.fm/m754f9cebccd?dice_id=m754f9cebccd\",\"post_waitinglist_referral\":\"https://link.dice.fm/p274255aa53e?dice_id=p274255aa53e\"},