ortrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/a20ce2d4-bd90-4aa1-a114-8f98891378af.jpg?rect=1223%2C0%2C1426%2C2592\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Matt Hennessy\",\"image\":null,\"artist_id\":\"127367\",\"about\":null,\"is_headliner\":false},{\"name\":\"Dean Longden\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebd8549dd2a7070f9059305fa1\"},\"artist_id\":\"125613\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1766880000,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Dean Longden - Creeping Up\",\"redirect_url\":\"https://open.spotify.com/track/2KTJ47CNrFvEVgyWUBJP92\",\"artist\":\"Dean Longden\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bf2904cb9ab32ff6f0b02036866f87e6004303fe?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Creeping Up\"},{\"type\":\"apple_music\",\"title\":\"Dean Longden - Creeping Up\",\"redirect_url\":\"https://music.apple.com/us/album/creeping-up/1849250960?i=1849250961&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dean Longden\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/3e/3a/d2/3e3ad273-5a2b-7628-490b-a74e555220d2/mzaf_8879066182790171540.plus.aac.p.m4a\",\"track_name\":\"Creeping Up\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T09:30:00+00:00\",\"sale_end_date\":\"2026-03-14T17:00:00+00:00\",\"sale_start_date\":\"2025-11-28T09:30:00+00:00\",\"event_start_date\":\"2026-03-14T19:30:00+00:00\",\"event_end_date\":\"2026-03-14T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Kings Place.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/m71a6a6281ef?dice_id=m71a6a6281ef\",\"post_competition_referral\":\"https://link.dice.fm/cda4e2582612?dice_id=cda4e2582612\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x54f41241697?dice_id=x54f41241697\",\"post_purchase_referral\":\"https://link.dice.fm/U17c778bf0b9?dice_id=U17c778bf0b9\",\"post_reminder_referral\":\"https://link.dice.fm/B79953fbc5c2?dice_id=B79953fbc5c2\",\"post_waitinglist_referral\":\"https://link.dice.fm/xbe75ac0efe7?dice_id=xbe75ac0efe7\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"***Renowned for her distinctive and award-winning vocal prowess, Lady Nade possesses one of the most singular voices in the UK music scene. Critics and fans alike have often drawn comparisons between Lady Nade’s voice and the legendary Nina Simone. An artist known for paying homage to those who have profoundly influenced her journey, Lady Nade holds Nina Simone in high regard.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nNina Simone, an icon and consummate musical storyteller of the twentieth century, left behind a legacy of liberation, empowerment, passion, and love through her extraordinary body of work. By the end of her life, she had garnered an unprecedented level of recognition. Her music reached millions through recordings, film, television, and the digital sphere. In the last decade of her life alone, she sold over a million CDs, solidifying her status as a global best-seller.\\n\\nAs a black woman, **Lady Nade** acknowledges Nina Simone’s trailblazing role in paving the way for artists of her generation. Simone’s tenacity encouraged them not to abandon their dreams and aspirations. Lady Nade is honored to celebrate Nina Simone’s life and enduring legacy alongside some of the UK’s most accomplished musicians.\\n\\nThis high-energy performance is a heartfelt dedication to recreating the transformative sound that blended popular tunes of the era into a distinctive fusion of jazz, blues, gospel, and folk music.\\n\\n***This event will last approximately 2 hours, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773516600,\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":4,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:78\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"id\":\"692968e1c05f54000165d924\",\"name\":\"Lady Nade sings Nina Simone\",\"perm_name\":\"oen8ba-lady-nade-sings-nina-simone-14th-mar-kings-place-hall-two-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/d8079f20-4c16-461a-9133-5f2ed82dd417.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/d8079f20-4c16-461a-9133-5f2ed82dd417.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/d8079f20-4c16-461a-9133-5f2ed82dd417.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"new\":false,\"announcement_date_unix\":1764322200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2947,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-12T15:00:00+01:00\",\"sale_end_date\":\"2026-03-14T19:30:00+00:00\",\"sale_start_date\":\"2025-09-15T09:00:00+01:00\",\"event_start_date\":\"2026-03-14T19:30:00+00:00\",\"event_end_date\":\"2026-03-14T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by BOTW.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/lc0ef824deff?dice_id=lc0ef824deff\",\"post_competition_referral\":\"https://link.dice.fm/Zdeb9873d024?dice_id=Zdeb9873d024\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/pb3d27fae63f?dice_id=pb3d27fae63f\",\"post_purchase_referral\":\"https://link.dice.fm/Z66ea418df52?dice_id=Z66ea418df52\",\"post_reminder_referral\":\"https://link.dice.fm/L1317415ff69?dice_id=L1317415ff69\",\"post_waitinglist_referral\":\"https://link.dice.fm/p34e47fdc6fc?dice_id=p34e47fdc6fc\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nNew date added! New tickets available here https://link.dice.fm/T0d6da7973a9\\n\\nJens Lekman is an accidental wedding singer. But he’s also a wedding singer for a reason. Ever since his 2004 song “If You Ever Need a Stranger (To Sing at Your Wedding)” he has had a side gig fielding requests from strangers to sing at their weddings. For over twenty years, he’s had a particular vantage point from which to see the role love songs can play in our lives. In 2020, he and novelist David Levithan co-conceived a novel-with-music, Songs from Other People’s Weddings. Originally this album was meant to contain the songs from the weddings in the book, but as the novel came together, Lekman began to imagine what happened between the book’s chapters. The book and the album eventually became intertwined but also found their own paths. The book remained the structure of the story, but the album sometimes snuck behind the scenes. Stories from the songs made their way into the book and vice versa. The result is an exploration of what we sing about when we sing about love -- euphoria, doubt, dislocation, tenderness, conflict, playfulness, gratitude, ingratitude, longing, belonging, questioning, answering. It’s very much about a relationship and how it’s reflected through the relationships and weddings of others, but most of all it’s a lovesong to lovesongs\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":260,\"name\":\"Bird On The Wire\",\"privacy_policy_link\":\"https://www.birdonthewire.net/privacy-policy\",\"fb_pixel_id\":\"168353773761986\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773516600,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"per