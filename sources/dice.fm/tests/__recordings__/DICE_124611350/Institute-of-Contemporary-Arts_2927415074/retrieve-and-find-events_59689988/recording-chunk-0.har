\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-denmark-street-oe2r5\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-25T19:15:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Rough Trade Denmark Street is very excited to present an in-store performance and signing from ShitKid. This unique event celebrates the release of their new album 'The Essential (Vol 1)' released via PNKSLM Recordings.\\n\\nCD/LP purchases will be shipped at release from 27th Feb via Second Class Mail.\\n\\nTicket transfers will be off to avoid shipping issues, please make sure you either purchase your own ticket or attend the event together.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/shitkid/the-essential-vol-1\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE3MTkxMCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ1MDc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Nzo0NS4xMzc5NzFaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzM1NywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE3MTkxMCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ1MDc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Nzo0NS4xMzc5ODhaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzM1OCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6OTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":900,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE3MTkxMCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ1MDc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Nzo0NS4xMzc5OThaIiwicHJpY2UiOjkwMCwidmFyaWFudF9pZCI6MzM1OSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTIwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE3MTkxMCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQ1MDc4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Nzo0NS4xMzgwMDZaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjMzNjAsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:79\",\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"presented_by\":\"Presented by Rough Trade.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"ShitKid\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-01/334190ba-10eb-43f2-a6c1-f17b84d6a261.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"4744\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1769076000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-22T10:00:00+00:00\",\"sale_end_date\":\"2026-03-04T06:00:00+00:00\",\"sale_start_date\":\"2026-01-22T10:00:00+00:00\",\"event_start_date\":\"2026-03-25T19:15:00+00:00\",\"event_end_date\":\"2026-03-25T20:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69661cba4b9de600015a3b61\",\"name\":\"ShitKid: Live + Signing\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2106},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Sugar Town\",\"redirect_url\":\"https://open.spotify.com/track/7yK4I3dJwpJa25vXnaQReM\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b1717705f9251a5f311d2b7c3a00bcf8e803e18b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sugar Town\"}],\"faqs\":[{\"id\":68841,\"title\":\"Can I bring a camera?\",\"body\":\"Please note no professional cameras are allowed. Small cameras are fine but anything too big or with a detachable lense will be turned away as we are a small space.\",\"order\":0},{\"id\":68842,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":1},{\"id\":68843,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":2},{\"id\":68844,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 15-30 minutes, playing songs from the new release or a Q&A. Please note there is only 15min between the door time and the stage time.\",\"order\":3},{\"id\":68845,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":4},{\"id\":68846,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":68847,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":68848,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":7},{\"id\":68849,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":8},{\"id\":69009,\"title\":\"Can I bring a camera?\",\"body\":\"Please note no professional cameras are allowed. Small cameras are fine but anything too big or with a detachable lense will be turned away as we are a small space.\",\"order\":9},{\"id\":69010,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":10},{\"id\":69011,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":11},{\"id\":69012,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 15-30 minutes, playing songs from the new release or a Q&A. Please note there is only 15min between the door time and the stage time.\",\"order\":12},{\"id\":69013,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":13},{\"id\":69014,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":14},{\"id\":69015,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":15},{\"id\":69016,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":16},{\"id\":69017,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":17}],\"score\":0,\"shopping_cart_enabled\":true,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"7dmak6-compost-compost-compost-residency-4-25th-mar-dream-bags-jaguar-shoes-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774467000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/5c94907a-9d32-4078-890f-136e27c8529b.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/5c94907a-9d32-4078-890f-136e27c8529b.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/5c94907a-9d32-4078-890f-136e27c8529b.jpg?rect=675%2C0%2C1650%2C3000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/e8b886192b87?dice_id=e8b886192b87\",\"post_competition_referral