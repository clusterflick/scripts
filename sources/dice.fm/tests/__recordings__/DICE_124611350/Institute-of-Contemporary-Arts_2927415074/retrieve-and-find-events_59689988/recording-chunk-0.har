e_end_date\":\"2026-03-12T19:00:00+00:00\",\"sale_start_date\":\"2026-01-15T10:00:00+00:00\",\"event_start_date\":\"2026-03-12T19:30:00+00:00\",\"event_end_date\":\"2026-03-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"The Way You Are\",\"redirect_url\":\"https://open.spotify.com/track/5PutKSBKAVHWCxVhEthgIW\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6525f7a5271097f9befd1d7303d246db806c7259?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Way You Are\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Olivia Cuttill\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebb20069e919af7b3b5a1c31b3\"},\"artist_id\":\"95153\",\"about\":{\"description\":\"Olivia Cuttill is a London-based trumpet player and composer, graduate of Leeds Conservatoire, APPAG Martin Hummel Award Winner, APPG Best Newcomer Nominee, Presto Music’s Newcomer Of The Year, and Peter Whitingham 2024 Award Winner.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"The 2 and the 4\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":68120,\"title\":\"Is there reserved seating?\",\"body\":\"No, so please come when the doors open if you'd like a spot in the front!\",\"order\":0},{\"id\":68121,\"title\":\"What are the door and show times?\",\"body\":\"Doors open at 7:30, with the band on at 8pm.\",\"order\":1},{\"id\":68122,\"title\":\"Can I bring my lovely dog?\",\"body\":\"Yes! Gigs by The 2 and the 4 are always dog friendly for friendly dogs on leads.\",\"order\":2}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"17004\",\"name\":\"The Star By Hackney Downs\",\"address\":\"35 Queens Down Road, Hackney, London, E5 8NN, United Kingdom\",\"location\":{\"lat\":51.55315,\"lng\":-0.05776},\"image\":null,\"city\":{\"id\":\"6778fdabe81e04c767ac592f\",\"name\":\"Stoke Newington\",\"location\":{\"lat\":51.5583952,\"lng\":-0.0930404,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-star-by-hackney-downs-k63oo\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-12T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"141616\",\"name\":\"The 2 and the 4\",\"image\":{\"url\":null},\"perm_name\":\"the-2-and-the-4-ym3xa\",\"profile_active\":true},\"announcement_date_unix\":1767902400,\"social_links\":{\"event_share\":\"https://link.dice.fm/Obc847c44101?dice_id=Obc847c44101\",\"post_competition_referral\":\"https://link.dice.fm/t337472efe92?dice_id=t337472efe92\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G87513e909c0?dice_id=G87513e909c0\",\"post_purchase_referral\":\"https://link.dice.fm/C53088db6a7c?dice_id=C53088db6a7c\",\"post_reminder_referral\":\"https://link.dice.fm/zc2c84673f4f?dice_id=zc2c84673f4f\",\"post_waitinglist_referral\":\"https://link.dice.fm/d0c2ca442cfa?dice_id=d0c2ca442cfa\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k6ab6o-olivia-cuttill-trio-12th-mar-the-star-by-hackney-downs-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":2360,\"name\":\"Davin Does Ltd\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1205921890985832\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773343800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:77\",\"price\":{\"currency\":\"GBP\",\"amount\":1400,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/5c1e7bc1-168d-4744-b9ba-2312e8f964cd.jpg?rect=0%2C0%2C4320%2C4320\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/5c1e7bc1-168d-4744-b9ba-2312e8f964cd.jpg?rect=0%2C864%2C4320%2C2592\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/5c1e7bc1-168d-4744-b9ba-2312e8f964cd.jpg?rect=972%2C0%2C2376%2C4320\"},\"id\":\"6960baea21ba710001ab6fe5\",\"name\":\"Olivia Cuttill Trio\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Leeds Conservatoire grad **Olivia Cuttill** is a London-based muti award-winning jazz trumpet player and composer. For this special intimate evening, Olivia will be sharing the stage with guitarist **Bim Williams** and bassist **Josh Vadiveloo**. This cracking band will play a collection of standards and modern compositions, with influences from Louis Armstrong, Ella Fitzgerald, Harry Sweets Edison, Sarah Vaughan and more. Come for a captivating night of jazz, blues and all things swing!\\n\\nOlivia is a musician whose star is rising fast – an APPAG Martin Hummel Award Winner, APPG Best Newcomer Nominee, Presto Music’s Newcomer Of The Year, and Peter Whitingham 2024 Award Winner.\\n\\n**The 2 and the 4** is thrilled to bring you this trio for our series of Hot Music in Small Rooms. Each of these players is a big talent, and it's a treat to catch them in a truly charming and cosy space!\\n\\nAnd no need to leave the hound at home. Our gigs are always dog-friendly for friendly dogs on leads.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-08T20:00:00+00:00\",\"sale_end_date\":\"2026-03-12T19:00:00+00:00\",\"sale_start_date\":\"2026-01-08T20:00:00+00:00\",\"event_start_date\":\"2026-03-12T19:30:00+00:00\",\"event_end_date\":\"2026-03-12T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Olivia Cuttill - Ain't No Doubt Theme\",\"redirect_url\":\"https://music.apple.com/us/album/aint-no-doubt-theme/1724844855?i=1724845168&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Olivia Cuttill\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/cc/89/28/cc892852-a5b8-252c-96b0-5f677437ed82/mzaf_17961470405718565077.plus.aac.p.m4a\",\"track_name\":\"Ain't No Doubt Theme\"},{\"type\":\"spotify\",\"title\":\"Olivia Cuttill - Ain't No Doubt Theme\",\"redirect_url\":\"https://open.spotify.com/track/4k1D1DHcZRPfojtw2dZcqB\",\"artist\":\"Olivia Cuttill\",\"preview_url\":\"https://p.scdn.co/mp3-preview/12006e7ff84aa2bd2e186bb94934d3bb910a9981?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Ain't No Doubt Theme\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Rabbitts\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-19/7d65a386-ab3f-4b46-be2f-c3c6f9bddb5f.jpg?rect=1%2C0%2C639%2C639\"},\"artist_id\":\"78041\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Silver Birch Sound.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"373\",\"name\":\"Paper Dr