6952c4\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-03-27T23:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nCHAMOS are bringing Newroz 2026 to London.\\n\\nAfter back-to-back sold out shows in 2025, it’s time for something bigger - and what’s a better moment than the start of their new year?\\n\\nKnown for their genre-spanning DJ sets that seamlessly blend West Asian influences, bass, and percussion, CHAMOS truly embody their name—meaning \\\"friends\\\"—as they bring together diverse sounds and audiences.\\n\\nWith members from Kurdish and Dutch backgrounds, their music naturally fuses traditional and electronic elements.\\n\\nCHAMOS transform EartH Hall into Club Newroz, celebrating culture together.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExNzEyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIyMTU3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTE4OTdaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6Mjc3NSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExNzEyNiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIyMTU3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTE5MTRaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6Mjc3NiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":50