2C1073\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/f586df3e-acd7-49fe-954b-ed2fec006ebd.jpg?rect=571%2C0%2C646%2C1174\"},\"id\":\"6970d17fd9f12000017b61ac\",\"name\":\"The Rizz + Sweet Unrest + Charlie Blitz \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**What Does Not Presents: The Rizz for a very special headline show and it’s gonna be a proper one. If you’re into guitars, big choruses, and a band that actually means it onstage, this is your night.**\\n\\nAnd the support acts are stacked with talent too.\\n\\n**The Rizz** are a punchy five-piece rock ’n’ roll band from Southeast London, blending classic British swagger with modern urgency. Known for their relentless live energy and infectious hooks, they’ve built a reputation the hard way on the capital’s grassroots circuit. Drawing inspiration from The Clash, Arctic Monkeys and early Oasis, they’ve earned standout festival slots including Isle of Wight and Camp Bestival, cementing their status as one of London’s most exciting rising live acts.\\n\\n**Sweet Unrest**, an indie band that's coined their sound as ‘Gritpop’. Expect timeless melodies, gut punching choruses, and relentless stage energy.\\n\\n**Charlie Blitz,** a South London local that takes Hip Hop and Rap to another level. Expect sharp hooks and a set with some Bromley swagger.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T14:00:00+00:00\",\"sale_end_date\":\"2026-02-26T21:00:00+00:00\",\"sale_start_date\":\"2026-01-21T18:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Rizz - Love Smugglers\",\"redirect_url\":\"https://music.apple.com/us/album/love-smugglers/1734633553?i=1734633770&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Rizz\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/63/37/c4/6337c4ff-775e-4838-33ec-59b6f8d10b02/mzaf_8970431849620056212.plus.aac.p.m4a\",\"track_name\":\"Love Smugglers\"},{\"type\":\"spotify\",\"title\":\"The Rizz - Love Smugglers\",\"redirect_url\":\"https://open.spotify.com/track/3FcPxwzPWKFGDpX1zzoUgZ\",\"artist\":\"The Rizz\",\"preview_url\":\"https://p.scdn.co/mp3-preview/70621ca71f5148bd40e6464ecb5879c83387c3a4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Love Smugglers\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Fox & Firkin.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"15510\",\"name\":\"Fox And Firkin\",\"address\":\"316 Lewisham High Street, Lewisham, London, SE13 6JZ, United Kingdom\",\"location\":{\"lat\":51.45698,\"lng\":-0.01441},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-04/8f120254-16c6-4f38-a599-6dbc7a16c8db.jpg?rect=0%2C0%2C2363%2C2363\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"announcement_date_unix\":1768209300,\"social_links\":{\"event_share\":\"https://link.dice.fm/a7a3a376e273?dice_id=a7a3a376e273\",\"post_competition_referral\":\"https://link.dice.fm/j6910fa41870?dice_id=j6910fa41870\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T14ffd2d2c95?dice_id=T14ffd2d2c95\",\"post_purchase_referral\":\"https://link.dice.fm/I2b0e81a05e8?dice_id=I2b0e81a05e8\",\"post_reminder_referral\":\"https://link.dice.fm/Y0c1f08bf537?dice_id=Y0c1f08bf537\",\"post_waitinglist_referral\":\"https://link.dice.fm/t3366a58fae3?dice_id=t3366a58fae3\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"nvkb93-sans-soucis-presents-gensq-26th-feb-fox-and-firkin-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772132400,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:75\",\"price\":{\"currency\":\"GBP\",\"amount\":1122,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/d425309b-dd41-42fa-b23a-c2e0a7bc9970.jpg?rect=0%2C108%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/d425309b-dd41-42fa-b23a-c2e0a7bc9970.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/d425309b-dd41-42fa-b23a-c2e0a7bc9970.jpg?rect=169%2C0%2C743%2C1350\"},\"id\":\"6964bb273980da000141d5b7\",\"name\":\"Sans Soucis presents gensq+\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Sans Soucis (they/them) presents a curated night of poetry and music via gensq+, a travelling archive dedicated to a generation of queer people of colour who want to foster community and shape culture. \\n\\nThis event will feature a poetic conversation between friends, Cora Dessalines (they/them) and Lala-Simone Springer (she/they), plenty of time to socialize, and DJ sets by London-based, Martinican and Guadalupean Djablès  (she/they), followed by South African London-based afrorave sensation Toya Delazy DJ Set (she/they).\\n\\nDoor open at 7pm \\n\\nClosing time: 11pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T09:15:00+00:00\",\"sale_end_date\":\"2026-02-26T19:00:00+00:00\",\"sale_start_date\":\"2026-01-12T09:15:00+00:00\",\"event_start_date\":\"2026-02-26T19:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sans Soucis - Sexed & Sexual (Elkka’s C*nty House Remix)\",\"redirect_url\":\"https://music.apple.com/us/album/sexed-sexual-elkkas-c-nty-house-remix/1746342682?i=1746342689&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sans Soucis\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/26/58/d4/2658d4d0-bb4c-f1ea-4267-b8d7c36b9b1f/mzaf_10835213175606422219.plus.aac.p.m4a\",\"track_name\":\"Sexed & Sexual (Elkka’s C*nty House Remix)\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Zach Thompson\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-21/546b797a-6a7c-4221-8d86-adfffa742652.jpg?rect=210%2C0%2C630%2C630\"},\"artist_id\":\"126157\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Third Man Records.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"titl