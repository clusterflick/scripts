":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"123141\",\"name\":\"The Fighting Cocks Bar and Venue\",\"image\":{\"url\":null},\"perm_name\":\"the-fighting-cocks-bar-and-venue-xr3d3\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:39\",\"date_unix\":1777746600,\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/r6f5661d0db8?dice_id=r6f5661d0db8\",\"post_competition_referral\":\"https://link.dice.fm/Q2144eb1eb99?dice_id=Q2144eb1eb99\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t6c0ff62acb6?dice_id=t6c0ff62acb6\",\"post_purchase_referral\":\"https://link.dice.fm/M42d9aee8ea3?dice_id=M42d9aee8ea3\",\"post_reminder_referral\":\"https://link.dice.fm/Gb8bf9bd2e4e?dice_id=Gb8bf9bd2e4e\",\"post_waitinglist_referral\":\"https://link.dice.fm/ge6726c4b332?dice_id=ge6726c4b332\"},\"perm_name\":\"py5rqp-nuns-of-the-tundra-2nd-may-the-fighting-cocks-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-18/a66323ee-ef8c-47f5-83be-059c0577eeb7.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-18/a66323ee-ef8c-47f5-83be-059c0577eeb7.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-18/a66323ee-ef8c-47f5-83be-059c0577eeb7.jpg?rect=169%2C0%2C743%2C1350\"},\"properties\":[],\"about\":{\"description\":\"**Nuns of the Tundra**  \\nFuse stoner rock riffs, alt rock song dynamics and raw garage rock recording vibes together formulating a unique new-wave rock sound. Nuns take pride in their elixir of fuzzy, overdriven tones, summoning huge riffs whilst experimenting with time signatures, big choruses and diverse song compositions to create a sonic palette that’s instantly recognisable. Looking to innovate and create new sounds, as well as pay homage to the scenes that created their love of music, NUNS OF THE TUNDRA have carved out an identity that’s both fresh and nostalgic. Specialising in gargantuan riffs to rival the masters and choruses designed to blow up festival stages, NUNS are not ones to skip on your playlists.\\n\\n**WREX**  \\nBrighton-born duo WREX make electro-charged alternative rock to turbocharge heartbeats, snap necks and fill both dancefloors and mosh pits. Shades of punk, nu-metal, pop and trance collide and coalesce but never clash; a wild explosion of riffs and synths that pulls from influences as diverse as While She Sleeps, Faithless and Linkin Park.  \\n  \\n**DELLA NOVA**  \\nFusing hard rock, grunge, and progressive influences, three-piece outfit DELLA NOVA have been making waves since their debut. A regular on London’s live circuit, DELLA NOVA are known for their high-energy, unforgettable performances at venues like Camden Assembly, Amersham Arms, The Black Heart and more. Their self-titled debut dropped in December 2024, with new music landing early 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"696cea26fd69a10001ed7d21\",\"name\":\"Nuns Of The Tundra\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nuns Of The Tundra\",\"image\":null,\"artist_id\":\"116054\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T10:00:00+00:00\",\"sale_end_date\":\"2026-05-02T15:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:30:00+0