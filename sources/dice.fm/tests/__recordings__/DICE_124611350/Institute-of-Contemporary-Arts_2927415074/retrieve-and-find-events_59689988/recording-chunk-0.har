ile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BCLUBS%2BLIMITED%2BPRIVACY%2BAND%2BCOOKIES%2BSTATEMENT.pdf\",\"fb_pixel_id\":\"1020185540161660\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:12\",\"about\":{\"description\":\"**\\\\*SECOND DATE ADDED\\\\***\\n\\nOn Thursday 26 March, we pay tribute to one of soul’s most timeless voices, as a live band reimagines the music of Sade on stage.\\n\\nWith Raelle leading the performance, expect a night of smooth groove, quiet power and songs that have soundtracked decades, from deep cuts to undeniable classics.\\n\\nA celebration of elegance, emotion and live musicianship, performed in full under the lights.\\n\\n**Please note that this event is not in association with Sade, nor will she be performing.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event. Bring your ID card with you. ID Scanner in place. \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1748905200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Raelle\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-05-17/ce443a62-66a5-4823-84c8-821c5102a272.jpg?rect=0%2C652%2C5288%2C5288\"},\"artist_id\":\"26301\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/26a46831-0a7f-4370-84b4-5412f874ab43.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/26a46831-0a7f-4370-84b4-5412f874ab43.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/26a46831-0a7f-4370-84b4-5412f874ab43.jpg?rect=338%2C0%2C825%2C1500\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6986105cb3d4660001e4d0c4\",\"name\":\"A Live Band Performs Sade\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-06-03T00:00:00+01:00\",\"sale_end_date\":\"2026-04-23T23:00:00+01:00\",\"sale_start_date\":\"2026-02-11T09:45:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"8e6mov-a-live-band-performs-sade-23rd-apr-night-tales-loft-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1854,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/A751c33b8297?dice_id=A751c33b8297\",\"post_competition_referral\":\"https://link.dice.fm/Ye6955026939?dice_id=Ye6955026939\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V225dd191d43?dice_id=V225dd191d43\",\"post_purchase_referral\":\"https://link.dice.fm/R48365dfbce7?dice_id=R48365dfbce7\",\"post_reminder_referral\":\"https://link.dice.fm/m2f23e82dbe7?dice_id=m2f23e82dbe7\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ldbd3990666f?dice_id=Ldbd3990666f\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Nine Lives\",\"redirect_url\":\"https://open.spotify.com/track/7uv7lkQBgkhqHezQam0fQ6\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4da95c30596bbda29b483a56d6eba798731e6bfa?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Nine Lives\"},{\"type\":\"apple_music\",\"title\":\"Calva Louise - Con Corazon\",\"redirect_url\":\"https://music.apple.com/us/album/con-corazon/1702038051?i=1702038075&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Calva Louise\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/68/38/df/6838df57-c733-25c7-2964-3d94aa7cdbd4/mzaf_7653446570948765042.plus.aac.p.m4a\",\"track_name\":\"Con Corazon\"}],\"faqs\":[{\"id\":74999,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":75000,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":75001,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Live Nation\",\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1776967200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":\"2026-04-23T23:00:00+01:00\"}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:13\",\"about\":{\"description\":\"The sprawling story of Calva Louise, the band that found each other from opposite corners of the world - whose combined influences and experiences created a myriad of captivating threads entwined into their existence. Metal, punk, electronica and art rock weave through grandiose narratives and cinematic storytelling with a mindblowing visual delivery - Welcome to the Calva Louise Universe and the release of their new studio album, Edge of the Abyss, which is co-produced by Pendulum's Gareth McGrillen and will be released on 11 July via Mascot Records.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"announcement_date_unix\":1770631200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Calva Louise\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb8beea0bf706cdb20d1dc8f48\"},\"artist_id\":\"9547\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https: