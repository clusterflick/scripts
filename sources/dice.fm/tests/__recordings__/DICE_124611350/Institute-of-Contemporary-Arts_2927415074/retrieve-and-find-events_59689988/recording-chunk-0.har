ue,\"is_hidden_event\":false,\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:52\",\"about\":{\"description\":\"TRIO EXPLORATIONS\\n\\nThree leading voices from London’s forward-looking jazz community—Sheldon Agwu (Electric Guitar), Max Luthert (Upright Bass & Modular Synth), and Yusuf Ahmed (Drums & Percussion)—come together to form a trio that thrives on curiosity, groove, and sonic adventure.\\n\\nTheir music moves fluidly between lush harmony, textural experimentation, and rhythmic intensity, creating a sound that feels both expansive and immediate.\\n\\nGuitarist Sheldon Agwu blends Jazz Guitar with ambient layers and electronic colours, shaping a distinctive musical identity reflected in his projects Kintsugi, Vtet Live at Mu, and Seeds of Sanctum.\\n\\nBassist and modular architect Max Luthert, known for collaborations with Nubya Garcia, Zara McFarlane, and Moses Boyd, brings a deeply grounded yet exploratory presence that anchors—and often propels—the trio’s improvisational pathways.\\n\\nDrummer & Percussionist Yusuf Ahmed (Qwalia, Unknown to Known) channels Jazz, Afro-funk, and global rhythmic traditions into a dynamic voice that balances drive, nuance, and invention.\\n\\nTogether, the trio offers a night of immersive interplay, atmospheric soundscapes, and bold improvisation—music that lives at the crossroads of Jazz, Electronics, and boundary-pushing rhythm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1771200000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/bd0376b2-2fd4-4bcc-921f-f8baf91a149b.jpg?rect=0%2C0%2C2400%2C2400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/bd0376b2-2fd4-4bcc-921f-f8baf91a149b.jpg?rect=0%2C880%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/bd0376b2-2fd4-4bcc-921f-f8baf91a149b.jpg?rect=320%2C0%2C1760%2C3200\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"699350cb863db300015685b4\",\"name\":\"Trio Explorations\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-04-24T18:00:00+01:00\",\"sale_start_date\":\"2026-02-16T00:00:00+00:00\",\"event_start_date\":\"2026-04-24T19:00:00+01:00\",\"event_end_date\":\"2026-04-25T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"bb8mwx-trio-explorations-24th-apr-sjq-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2423,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/d44e331ad92f?di