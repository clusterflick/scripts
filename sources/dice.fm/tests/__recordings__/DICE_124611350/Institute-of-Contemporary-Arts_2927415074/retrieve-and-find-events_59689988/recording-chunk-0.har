b0159.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69443c1c1cc65f000167dc6f\",\"name\":\"House Gospel Choir presents: Sanctuary - Week 1\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"This April, The Jazz Cafe hosts House Gospel Choir for a four-week residency that lifts house music to new heights with soaring vocals and gospel energy.\\n\\nFrom their origins in London to stages at festivals and clubs worldwide, HGC fuse house, garage and gospel into live performances that fill rooms with heat and heart.\\n\\nA true roof-blowing celebration of voice-driven house anthems and spine-tingling singing to kick off the spring with a rush of sensations hot enough to burn themselves into memory.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T10:00:00+00:00\",\"sale_end_date\":\"2026-04-04T02:00:00+01:00\",\"sale_start_date\":\"2025-12-22T10:00:00+00:00\",\"event_start_date\":\"2026-04-03T22:30:00+01:00\",\"event_end_date\":\"2026-04-04T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Riton, MNEK, House Gospel Choir - Deeper\",\"redirect_url\":\"https://open.spotify.com/track/5XCJndUuktaxfVruAek3mT\",\"artist\":\"Riton, MNEK, House Gospel Choir\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f8ee5d2e1e8608a37fccc03c096e928da5694075?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Deeper\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Maximum\",\"image\":null,\"artist_id\":\"37554\",\"about\":null,\"is_headliner\":false},{\"name\":\"Boy Better Know\",\"image\":null,\"artist_id\":\"625\",\"about\":null,\"is_headliner\":false},{\"name\":\"JME\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/84a83f2c944190db0e01f506db5a2041c76e13