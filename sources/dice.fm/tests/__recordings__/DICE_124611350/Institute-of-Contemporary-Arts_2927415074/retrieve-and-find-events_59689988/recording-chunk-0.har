\",\"profile_active\":true},\"id\":\"68bea54432301300012fd38e\",\"seats_io_event_id\":null,\"name\":\"Charm of Finches\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"92goen-charm-of-finches-18th-feb-the-grace-london-tickets\",\"date_unix\":1771443000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tei Shi\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/cc326f74ffe553c039911f8374121916de7108c7\"},\"artist_id\":\"738\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":40567,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-26/faf7276c-2c7e-4e89-919a-b8874dc8e92f.jpg?rect=0%2C251%2C4181%2C4181\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-26/faf7276c-2c7e-4e89-919a-b8874dc8e92f.jpg?rect=0%2C1359%2C4181%2C2509\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-26/faf7276c-2c7e-4e89-919a-b8874dc8e92f.jpg?rect=654%2C0%2C2874%2C5226\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Tei Shi - Go Slow\",\"redirect_url\":\"https://open.spotify.com/artist/1xcMOgFUM1IYZE22YjCvsL\",\"artist\":\"Tei Shi\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3d236872fa891cffbc48ab9ee3a9b56b9afdc4af\",\"track_name\":\"Go Slow\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1756285200,\"max_tickets\":6,\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Eat Your Own Ears presents Tei Shi at The Lexington.\\n\\nTei Shi (pronounced “tay-shee”) is the moniker of singer-songwriter & producer Valerie Teicher Barbosa.\\n\\nGrowing up between Bogotá, Colombia, & Vancouver, Canada, Tei Shi is heavily influenced by her ever-changing environment & cross-cultural identity.\\n\\nSince her first two EPs, ‘Saudade’ (2013) & ‘Verde’ (2015), “introduced her to the world as a skilled & fluid vocalist... Her groundbreaking song ‘Bassically’ garnered over 21 million streams on Spotify alone & set the scene for her critically acclaimed debut album ‘Crawl Space’ (2017) - leading her to embark on world tours & make headway in the art & fashion world.\\n\\nShe wrote & was featured on Blood Orange's 'Hope' off his album 'Negro Swan' & starred in its music video alongside Tyler the Creator & A$AP Rocky, also performing the song onstage at 2019’s Coachella Music Festival. In November of 2019, Tei Shi released ‘La Linda,’ her much- anticipated second full-length album. On this album, Tei Shi further embraces her Latin roots & multicultural identity, seamlessly shifting between the languages & musical genres that make her such a unique songwriter & noteworthy artist.\\n\\nTei Shi went on to release her 2020 pandemic-made EP 'Die 4 Ur Love', followed by her third full length album 'Valerie' in 2024. 2025 holds her fourth album, ‘Make believe I make believe’, with its initial singles 'Best Be Leaving' and ‘Drop Dead’ released this Spring.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Eat Your Own Ears.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:59\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Uf265356276d?dice_id=Uf265356276d\",\"post_competition_referral\":\"https://link.dice.fm/sf584eb30fd9?dice_id=sf584eb30fd9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k0bcd32d914a?dice_id=k0bcd32d914a\",\"post_purchase_referral\":\"https://link.dice.fm/C4a174b27988?dice_id=C4a174b27988\",\"post_reminder_referral\":\"https://link.dice.fm/N63b7db41a5d?dice_id=N63b7db41a5d\",\"post_waitinglist_referral\":\"https://link.dice.fm/ncf9317b43be?dice_id=ncf9317b43be\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-27T10:00:00+01:00\",\"sale_end_date\":\"2026-02-18T18:00:00+00:00\",\"sale_start_date\":\"2025-08-29T10:00:00+01:00\",\"event_start_date\":