%2C2007%2C3649\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Glyders - Maria's Hunt\",\"redirect_url\":\"https://open.spotify.com/track/3n8UB5MYRg6jZg2rpOcHa1\",\"artist\":\"Glyders\",\"preview_url\":\"https://p.scdn.co/mp3-preview/08453c7e8852df578495dde5a8ed2cd4498ac36a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Maria's Hunt\"},{\"type\":\"apple_music\",\"title\":\"Glyders - Maria's Hunt\",\"redirect_url\":\"https://music.apple.com/us/album/marias-hunt/1649385996?i=1649386001&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Glyders\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/27/c2/ca/27c2ca08-3dd1-e147-1c2c-5fd488a73b83/mzaf_9989630735507341170.plus.aac.p.m4a\",\"track_name\":\"Maria's Hunt\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765101600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"***Glyders -*** Formed in Chicago by partners Josh Condon and Eliza Weber, Glyders make maximal minimal rock & roll with nocturnal mystery pulsing in the mix, cutting above rigorous roadhouse fare with sounds that twist and grind on their classic inspirations. Joined by Joe Seger on drums, Glyders’ high lonesome way is mellow but nervy, hip-shaking and deep – a multicolored trip to the ongoing beat of American weirdness.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by REAL\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:44\",\"social_links\":{\"event_share\":\"https://link.dice.f