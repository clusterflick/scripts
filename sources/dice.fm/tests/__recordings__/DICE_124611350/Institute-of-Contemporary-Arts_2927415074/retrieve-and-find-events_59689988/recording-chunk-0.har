\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"THE ROOP\",\"image\":null,\"artist_id\":\"103042\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"92ayyo-euroope-tour-2026-london-15th-apr-229-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/a0cfd21d-ce59-4051-9257-487003185f65.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/a0cfd21d-ce59-4051-9257-487003185f65.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/a0cfd21d-ce59-4051-9257-487003185f65.jpg?rect=675%2C0%2C1650%2C3000\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Bold, stylish and unmistakably original, THE ROOP; Vaidotas Valiukevicius (vocals), Mantas Banisauskas (guitar) and Robertas Baranauskas (drums), have carved out their own lane as \\\"a different kind of mainstream.\\\" Since forming in Vilnius, Lithuania in 2014, the trio has blended luxurious synth-pop with raw emotion, wrapped in a signature visual style that's both elegant and deeply expressive.\\n\\nThe world discovered THE ROOP with \\\"On Fire\\\" in 2020, a viral Eurovision favourite that became an anthem of empowerment for millions. Their follow-up entry \\\"Discoteque\\\" lit up the Eurovision 2021 stage, finishing 8th and launching the band onto the international scene.\\n\\nTheir 2025 album Momentum marks the next chapter in THE ROOP's evolution - vibrant, daring, and sonically richer than ever. \\\"Steal Me\\\" delivers sleek synth-pop and irresistible romantic tension. \\\"Chica Chico\\\" bursts with sunny, Mediterranean energy. \\\"Just Think About It\\\" leans into reflective melancholy, exploring authenticity in a digital age. Each track shows a band expanding their palette while staying true to the emotional depth that defines them.\\n\\nTo see THE ROOP live is a full sensory experience: visually striking, emotionally charged, and irresistibly uplifting. The band are renowned for their magnetic stage presence and genuine connection with the crowd. One of their standout career moments came in 2024, when they opened for Ed Sheeran on his stadium tour, cementing their place as a world-class live act.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+, U18's acc by an adult. Physical photo ID required for entry.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Shame\",\"redirect_url\":\"https://open.spotify.com/track/1d39v4V4DmrrLiFX4DKHBv\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5baf6bcd7cdc572e6573ed34ff2b0880a16e3368?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Shame\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776276000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"644\",\"name\":\"St Pancras Old Church\",\"address\":\"Pancras Road, London NW1 1UL\",\"location\":{\"lat\":51.5351939,\"lng\":-0.131893999999988},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.50765