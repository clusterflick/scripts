c?dice_id=x61fdbf5734c\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":20,\"presented_by\":\"Presented by Under The Radar London.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:44\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T17:30:00+00:00\",\"sale_end_date\":\"2026-05-15T23:45:00+01:00\",\"sale_start_date\":\"2025-12-17T18:30:00+00:00\",\"event_start_date\":\"2026-05-16T19:00:00+01:00\",\"event_end_date\":\"2026-05-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1765992600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1921,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6941dfbb63390f00010b34e3\",\"name\":\"Under The Radar x Rachel Croft\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rachel Croft\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-11-08/7c4fbf35-23ef-49d9-a934-71ddf953a3ce.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"63562\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"mx8lrw-under-the-radar-x-rachel-croft-16th-may-oslo-hackney-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/9ec3c87f-52bb-4cee-a349-c4f38c1a4151.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/9ec3c87f-52bb-4cee-a349-c4f38c1a4151.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/9ec3c87f-52bb-4cee-a349-c4f38c1a4151.jpg?rect=675%2C0%2C1650%2C3000\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Rachel Croft returns to London with her band for a blistering show featuring new songs and guests — in collaboration with Under The Radar London.\\n\\nAn internationally recognised musician, Rachel Croft is known for her powerful vocals, cinematic songwriting, and electrifying stage presence. Her works have been featured on Netflix, BBC Two, and premiered on major global outlets including CMT (USA) and the BBC.\\n\\nDescribed as “truly exceptional” by BBC Introducing, her distinctive sound has graced iconic venues such as The Bitter End (New York), The Bluebird Cafe (Nashville), Bush Hall and Camden Assembly in London, alongside special performances in spaces like Abbey Road Studios and The Blue Room in London’s O2 Arena.\\n\\nBeyond music, Rachel is a multifaceted creative force. She brings her vision to life through original pen and ink illustrations, mixed media animation, lino cuts, and video editing, weaving her visual art into all of her projects.\\n\\nThrough her collaboration with Under The Radar, Rachel seeks to inspire aspiring female and underrepresented artists to pursue a career in music. An exclusive meet & greet + community event will take place ahead of the show for members of the Under The Radar community, centered around turning music into a full-time venture — head to UTR's channels to find out how to be part of it.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":2229,\"name\":\"Broadside Hacks\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1476463663168370\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"