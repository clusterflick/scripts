bb3b8aef1c8?dice_id=Ebb3b8aef1c8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K57f057c7b19?dice_id=K57f057c7b19\",\"post_purchase_referral\":\"https://link.dice.fm/C96cf36ba4a4?dice_id=C96cf36ba4a4\",\"post_reminder_referral\":\"https://link.dice.fm/j15caaf68d0a?dice_id=j15caaf68d0a\",\"post_waitinglist_referral\":\"https://link.dice.fm/qbae6be8b157?dice_id=qbae6be8b157\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"537xal-marta-valadon-satin-beige-george-huxtable-26th-feb-the-harrison-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772133300,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:86\",\"price\":{\"currency\":\"GBP\",\"amount\":1350,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0754e11-b383-465e-821e-006aecd7ed30.jpg?rect=765%2C0%2C3072%2C3072\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0754e11-b383-465e-821e-006aecd7ed30.jpg?rect=0%2C156%2C4602%2C2761\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0754e11-b383-465e-821e-006aecd7ed30.jpg?rect=1456%2C0%2C1690%2C3072\"},\"id\":\"696a37de51a5bd00016eb976\",\"name\":\"Marta Valadon, Satin Beige, George Huxtable\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The Harrison Kings Cross, a lovely offbeat Victorian boozer with its cellar venue with perfect acoustics is the home of our new monhly \\\"Folk Club\\\" - folk, jazz, blues, we have if all! Come join us for a night of incredible music:\\n\\n**Marta Valadon** is a free spirit who began her career traveling all across Europe in her van, making the street her first and foremost stage. She has since settled in London, where she has woven herself into the fabric of its roots music scene. Marta has evolved as an artist adopting a unique Mediterranean and Eastern European jazz style, blended with poignant and emotive lyrics. Marta released her debut album “Queen of Shadows” in March 2025.\\n\\n**Satin Beige** is an R&B cellist and singer songwriter. Her cello-infused, lyrically soulful R'n'B has drawn comparisons to a \\\"lovechild of Ed Sheeran and Alicia Keys\\\". Captivating audiences across the UK. She has performed for Sir Paul McCartney, and has featured on tracks spun on Rinse FM, BBC 6 Music and 1Xtra. Satin continues to captivate audiences across the UK, at venues such as Liverpool’s Tung Auditorium and Pizza Express Live, Holborn, and supporting the likes of noughties band Space.\\n\\n**George Huxtable (Hux) i**s a UK-based Aussie song maker and artist. Describing himself as ‘soully pop’, George is an electrifying live artist and storyteller. He has headlined Colours Hoxton, The Bedford and Pizza Express , and after a little break to focus on writing, he returns to debut a his new songs.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T00:00:00+00:00\",\"sale_end_date\":\"2026-02-26T21:00:00+00:00\",\"sale_start_date\":\"2026-01-16T00:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:15:00+00:00\",\"event_end_date\":\"2026-02-26T23:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Marta Valadon - Flying\",\"redirect_url\":\"https://open.spotify.com/track/6PFyNUWyiWGWEN4gtyKe0K\",\"artist\":\"Marta Valadon\",\"preview_url\":\"https://p.scdn.co/mp3-preview/eb63608cd19b2746b9320018e25870d2d09aee0d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Flying\"},{\"type\":\"apple_music\",\"title\":\"Marta Valadon - Flying\",\"redirect_url\":\"https://music.apple.com/us/album/flying/1795656404?i=1795656622&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Marta Valadon\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/c8/12/3d/c8123dfb-f6fb-fa48-d486-77ca1d16861b/mzaf_1381963534310947722.plus.aac.p.m4a\",\"track_name\":\"Flying\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Barbarella\",\"image\":null,\"artist_id\":\"73032\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Strongroom + Queer Brewing.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":5,\"properties\":[],\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"3126\",\"name\":\"Strongroom\",\"image\":{\"url\":null},\"perm_name\":\"strongroom-bpmk\",\"profile_active\":false},\"announcement_date_unix\":1771027200,\"social_links\":{\"event_share\":\"https://link.dice.fm/tbc5267f675a?dice_id=tbc5267f675a\",\"post_competition_referral\":\"https://link.dice.fm/faadc395a3b3?dice_id=faadc395a3b3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/fd9a09fc41e7?dice_id=fd9a09fc41e7\",\"post_purchase_referral\":\"https://link.dice.fm/n5282af8b57e?dice_id=n5282af8b57e\",\"post_reminder_referral\":\"https://link.dice.fm/v4334d382515?dice_id=v4334d382515\",\"post_waitinglist_referral\":\"https://link.dice.fm/t3b8a7d8381b?dice_id=t3b8a7d8381b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"mx3a5k-srp-x-qb-barbarella-supports-26th-feb-strongroom-bar-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":null,\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1772134200,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:87\",\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/b117fa84-921e-4204-824a-a6977608f057.jpg?rect=0%2C292%2C1170%2C1170\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/b117fa84-921e-4204-824a-a6977608f057.jpg?rect=0%2C526%2C1170%2C702\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/b117fa84-921e-4204-824a-a6977608f057.jpg?rect=103%2C0%2C964%2C1753\"},\"id\":\"69909919a9ed3b000198a6c9\",\"name\":\"SRP x QB | BARBARELLA + Supports\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Strongroom + Queer Brewing** are proud to present this evening celebrating LGBTQ+ History month with all things that encompass '**Synth**'. We'll have live artists + DJs and a line up of Queer Brewing beers avail to buy.\\n\\nThis LGBTQ+ History Month, Queer Brewing have released two beers to honour Alan L. Hart and Wendy Carlos, two trans innovators who were pioneers in their respective fields of science and innovation.\\n\\n**Synth** is a big and bold tropical IPA, which celebrates the pioneering composer and musician Wendy Carlos’ lasting impact on electronic music.\\n\\n**Barbarella**\\n\\nBarbarella is a half-Italian, London-based singer whose voice moves between celestial heights and human intimacy, holding audiences through emotionally charged performances.\\n\\nEmerging from South East London s queer underground, she first gained recognition fronting Barbarella s Bang Bang, a band embedded in London s grassroots and alternative live scene.\\n\\nProudly an independent artist from the start, she led the band to multiple appearances at Glastonbury Festival, Boomtown, Fuji Rock, and other international stages.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T00:00:00+00:00\",\"sale_end_date\":\"2026-02-26T20:00:00+00:00\",\"sale_start_date\":\"2026-02-14T00:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:30:00+00:00\",\"event_end_date\":\"2026-02-26T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fire Escape\",\"image\":null,\"artist_id\":\"133795\",\"about\":null,\"is_headliner\":false},{\"name\":\"yurn\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-09/f4c24472-d4d0-4787-bb8c-2b9ba79ef169.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"133799\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lots Of\",\"image\":null,\"artist_id\":\"133800\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Cav Presents.\",\"tty_to_extras\":[],\"is_ticket_avail