",\"post_reminder_referral\":\"https://link.dice.fm/v7af6c0b845f?dice_id=v7af6c0b845f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q700c71acdd3?dice_id=Q700c71acdd3\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Kerrank! - The Kerrang! Tribute band\\n\\nRelive the 90s-00s of KERRANG! Dust off your studded belts, sharpen your eyeliner, and get your vans on...\\n\\nKerrank! will be hitting the stage, bringing you a non-stop night of the greatest rock, metal, punk, and emo anthems that defined a generation playing the tracks that dominated the airwaves and kept your MP3 player on repeat:\\n\\nAll Killer, No Filler: My Chemical Romance, Linkin Park, Blink-182, Green Day, Slipknot, Good Charlotte, Limp Bizkit, The Offspring, and every banger in between\\n\\nhttps://www.instagram.com/kerrankband/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1779469200,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-22T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",