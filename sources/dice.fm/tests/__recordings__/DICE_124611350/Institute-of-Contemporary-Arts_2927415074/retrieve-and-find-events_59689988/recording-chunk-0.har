0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-one-yo6v\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-10T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-13/5ef93a1d-2590-4214-b6e7-d2582bb1bd5f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-13/5ef93a1d-2590-4214-b6e7-d2582bb1bd5f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-13/5ef93a1d-2590-4214-b6e7-d2582bb1bd5f.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/g0aa593ea23e?dice_id=g0aa593ea23e\",\"post_competition_referral\":\"https://link.dice.fm/u0844a960a17?dice_id=u0844a960a17\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r4cb615e0075?dice_id=r4cb615e0075\",\"post_purchase_referral\":\"https://link.dice.fm/T6a0887a7aed?dice_id=T6a0887a7aed\",\"post_reminder_referral\":\"https://link.dice.fm/g09c10b4865c?dice_id=g09c10b4865c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Mdcef4fea260?dice_id=Mdcef4fea260\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:57\",\"properties\":[],\"presented_by\":\"Presented by Kings Place.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760522400,\"id\":\"68ef6f72bfa439000177a09b\",\"name\":\"The Gigspanner Big Band\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"***The Gigspanner Big Band are a unique force in British folk music… Their high-energy, virtuosic performances appeal equally to traditionalists and to those looking for something more experimental, and they have garnered praise from publications as varied as fRoots, The Telegraph and The Wire, where they were described as ‘melodically folk-rooted yet open and innovative beyond the constraints of genre’.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nBeginning life as a trio – with legendary Steeleye Span fiddle player Peter Knight being joined by percussionist Sacha Trochet and guitarist Roger Flack – the line-up has been expanded to form The Gigspanner Big Band, with acclaimed multi instrumental duo Edgelarks (Phillip Henry and Hannah Martin - BBC Folk Awards ‘Best Duo’) and Bellowhead co-founder and melodeon player extraordinaire, John Spiers, joining the fray.\\n\\nWhile Peter Knight, as part of Steeleye Span’s classic 1970s line-up, helped invent a brand of folk rock that is still influential today, John Spiers, has had an equally profound impact on the landscape of traditional music over the last two decades.\\n\\nCharacterised by riotous inventiveness, technically gifted individual playing and subtle collaborative interaction, this coming together of several of the biggest names on the folk-roots scene, combines a deep knowledge of roots traditions with a ceaselessly boundary pushing approach.\\n\\n***This event will last approximately 2 hours, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"date_unix\":1775844000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1964,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-02T10:00:00+01:00\",\"sale_end_date\":\"2026-04-10T19:00:00+01:00\",\"sale_start_date\":\"2025-09-05T10:00:00+01:00\",\"event_start_date\":\"2026-04-10T19:00:00+01:00\",\"event_end_date\":\"2026-04-10T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8nqwb-dan-byrne-10th-apr-the-lower-third-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dan Byrne\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-15/8ca00651-02cc-4aba-a078-bcc928977d53.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"128831\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kit Trigg\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebfa56d2a523b4ba6a219c44e9\"},\"artist_id\":\"3199\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":