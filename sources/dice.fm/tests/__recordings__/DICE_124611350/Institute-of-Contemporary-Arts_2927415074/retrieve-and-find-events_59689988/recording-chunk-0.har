lly_locked\":false,\"impression_id\":\"49b4780d575288c7:7\",\"date_unix\":1782671400,\"price\":{\"currency\":\"GBP\",\"amount\":2436,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Sb2e62e78f36?dice_id=Sb2e62e78f36\",\"post_competition_referral\":\"https://link.dice.fm/w3e0c8388bc3?dice_id=w3e0c8388bc3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ce6ae2acf396?dice_id=ce6ae2acf396\",\"post_purchase_referral\":\"https://link.dice.fm/V8701ca30aab?dice_id=V8701ca30aab\",\"post_reminder_referral\":\"https://link.dice.fm/z92bf0dbdf9a?dice_id=z92bf0dbdf9a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pb70c0de3f33?dice_id=Pb70c0de3f33\"},\"perm_name\":\"bb85mx-electric-six-28th-jun-the-100-club-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/2639697e-332b-4b4f-a36b-053b42559155.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/2639697e-332b-4b4f-a36b-053b42559155.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/2639697e-332b-4b4f-a36b-053b42559155.jpg?rect=675%2C0%2C1650%2C3000\"},\"properties\":[],\"about\":{\"description\":\"Danger! Danger! Detroit legends, Electric Six are heading back to the UK for some intimate summer shows!\\n\\nMixing garage rock, disco, punk, new wave, and metal into cleverly dumb, in-your-face songs celebrating hedonism in multiple forms. They found international success through a relentless touring and recording schedule and an unerring commitment to their over-the-top style, delivering energy and absurdity in equal measure.\\n\\nKnown for their HUGE hits “Gay Bar”, “Dance Commander” and “Danger! High Voltage” plus a slew of fantastic albums, including their exceptional recent release, Turquoise; their live show is the most fun you can have with your clothes on…\\n\\nSupport comes from a band described as ‘A bloodstained fur coat, floating on the undulating beat of street talk’ - the one and only, Enjoyable Listens. Make sure you arrive in good time to see them.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"699495f057beb20001039018\",\"name\":\"Electric Six\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Electric Six - Danger! High Voltage!\",\"redirect_url\":\"https://open.spotify.com/track/3R4n4d2XZEbZz9av18quL5\",\"artist\":\"Electric Six\",\"preview_url\":\"https://p.scdn.co/mp3-preview/cc1cf8eb33facb7418e7724a271d06ffb9e4f887?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Danger! High Voltage!\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Electric Six\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-15/2775c4a7-662a-4d12-8c2e-9279e02a52e9.jpg?rect=125%2C0%2C750%2C750\"},\"artist_id\":\"7377\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sun 28 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T10:00:00+00:00\",\"sale_end_date\":\"2026-06-29T21:30:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-06-29T19:00:00+01:00\",\"event_end_date\":\"2026-06-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"2847