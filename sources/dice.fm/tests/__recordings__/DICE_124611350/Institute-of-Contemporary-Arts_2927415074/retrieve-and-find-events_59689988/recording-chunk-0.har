4},\"venues\":[{\"id\":\"341\",\"name\":\"Egg LDN\",\"address\":\"5-13 Vale Royal, N7 9AP, London, Greater London, England, United Kingdom\",\"location\":{\"lat\":51.54190842683617,\"lng\":-0.12452391847395687},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"egg-ldn-jx7m\",\"accessibility\":{\"url\":\"https://egglondon.co.uk/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T22:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/c0c2177d-8987-411c-8887-7478b91e381a.jpg?rect=0%2C166%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/c0c2177d-8987-411c-8887-7478b91e381a.jpg?rect=0%2C326%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/c0c2177d-8987-411c-8887-7478b91e381a.jpg?rect=89%2C0%2C622%2C1131\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1717246800,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Wednesday Club at Egg London\\n\\nMidweek, done properly.\\n\\nEvery Wednesday, Wednesday Club brings house, tech house, electro and hip hop to Egg London — built for students and anyone looking to switch off and reset before the weekend.\\n\\nDoors open from 22:30 – 04:00, with free entry before midnight plus a free shot when claimed online.\\n\\nExpect solid music all night, a mixed crowd, and selected drinks at £5 across the event.\\n\\nWhether you’re coming straight from uni, work, or just need a midweek release — Wednesday Club keeps things moving without the weekend\\n\\nchaos.\\n\\nEgg London\\n\\n 22:30 – 04:00\\n\\n Free entry before 00:00 + free shot (online claim required) \\n\\nHouse · Tech House · Electro · Hip Hop \\n\\n£5 selected drinks all night\\n\\nEgg London is a strictly 18+ venue. To enhance safety and security, we have installed a Club Scan system at the front door. All guests are required to present a valid physical form of photo ID for scanning upon entry. Acceptable forms of ID include an unexpired passport, driving license, provisional driving license, or a photo card featuring the PASS hologram. Please note that photocopies, digital images, or screenshots of IDs will not be accepted under any circumstances.\\n\\nThank you for your cooperation in ensuring a safe and smooth entry process.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by EGG.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:65\",\"social_links\":{\"event_share\":\"https://link.dice.fm/N237afdfe9df?dice_id=N237afdfe9df\",\"post_competition_referral\":\"https://link.dice.fm/rb9ff11865b4?dice_id=rb9ff11865b4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V6a28d383565?dice_id=V6a28d383565\",\"post_purchase_referral\":\"https://link.dice.fm/X516660022b1?dice_id=X516660022b1\",\"post_reminder_referral\":\"https://link.dice.fm/S9710f5f1c72?dice_id=S9710f5f1c72\",\"post_waitinglist_referral\":\"https://link.dice.fm/j4da55d95a39?dice_id=j4da55d95a39\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-06-01T14:00:00+01:00\",\"sale_end_date\":\"2026-02-19T02:30:00+00:00\",\"sale_star