’s Acoustic Stage.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-10T22:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/cff7a75d-e8ef-4d8a-954e-c7b5644b0159.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/cff7a75d-e8ef-4d8a-954e-c7b5644b0159.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/cff7a75d-e8ef-4d8a-954e-c7b5644b0159.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Lad308916da4?dice_id=Lad308916da4\",\"post_competition_referral\":\"https://link.dice.fm/dd45eb706b17?dice_id=dd45eb706b17\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k470e2a43ba3?dice_id=k470e2a43ba3\",\"post_purchase_referral\":\"https://link.dice.fm/B76e582e8a2d?dice_id=B76e582e8a2d\",\"post_reminder_referral\":\"https://link.dice.fm/g18fed827347?dice_id=g18fed827347\",\"post_waitinglist_referral\":\"https://link.dice.fm/W2cccc07eca7?dice_id=W2cccc07eca7\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"