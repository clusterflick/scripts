n about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/fc6bd75a-8247-4e6c-bae2-3a6438eea4ab.jpg?rect=0%2C0%2C1074%2C1074\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/fc6bd75a-8247-4e6c-bae2-3a6438eea4ab.jpg?rect=0%2C215%2C1074%2C644\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/fc6bd75a-8247-4e6c-bae2-3a6438eea4ab.jpg?rect=242%2C0%2C591%2C1074\"},\"previews\":[],\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"announcement_date_unix\":1769446800,\"max_tickets\":8,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"e645d7c4-3d86-4144-a8bc-bd964ddec5b7\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"about\":{\"description\":\"Booking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by FCA.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:87\",\"social_links\":{\"event_share\":\"https://link.dice.fm/M272af16c0f9?dice_id=M272af16c0f9\",\"post_competition_referral\":\"https://link.dice.fm/V7655e3a1a48?dice_id=V7655e3a1a48\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Aa9723d19223?dice_id=Aa9723d19223\",\"post_purchase_referral\":\"https://link.dice.fm/X97e7be1e682?dice_id=X97e7be1e682\",\"post_reminder_referral\":\"https://link.dice.fm/w96c18da422c?dice_id=w96c18da422c\",\"post_waitinglist_referral\":\"https://link.dice.fm/X4cb86ebc95b?dice_id=X4cb86ebc95b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T17:00:00+00:00\",\"sale_end_date\":\"2026-03-19T21:00:00+00:00\",\"sale_start_date\":\"2026-01-26T17:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T23:00:00+00:00\",\"is_multi_days_event\":f