ull,\"presented_by\":\"Presented by Eat Your Own Ears.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10\",\"name\":\"Eat Your Own Ears\",\"image\":{\"url\":null},\"perm_name\":\"eat-your-own-ears-z82z\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"926wb7-dream-ivory-9th-jun-oslo-hackney-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781028000,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:10\",\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oslo-hackney-je6z\",\"accessibility\":{\"url\":\"https://www.oslohackney.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-09T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dream, Ivory\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb6a583c132634673256e568e9\"},\"artist_id\":\"67409\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Eat Your Own Ears presents Dream, Ivory at Oslo.\\n\\nGrowing up in Southern California, the Baello brothers were each other’s universe. “We experienced the world through the same frame, Christian says. That frame was heavily influenced by the number of times they moved, their identity as first generation Filipino Americans, and their parents’ love of music. Enlisted in piano lessons by their dad at a young age (“it wasn’t a choice,” Louie jokes), the Baello brothers cut their teeth covering the music their parents were raised on, everything from ABBA and the Bee Gees to the Beatles.\\n\\nChristian helms the production on Dream, Ivory tracks while Louie is the primary lyricist/vocalist, but every song they make is a true collaboration. Music has always been central to their sense of self-perception, but it’s just one of the brothers’ many talents. Together, they make all of Dream, Ivory’s artwork, videos, and visuals.\\n\\nAge: 16+ (under 18s accompanied by an adult)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-09T15:00:00+00:00\",\"sale_end_date\":\"2026-06-09T18:00:00+01:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-06-09T19:00:00+01:00\",\"event_end_date\":\"2026-06-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6936f44ce8138f0001a2618d\",\"name\":\"Dream, Ivory\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-08/939e01ef-fa6f-47f9-add6-f32c9308eede.jpg?rect=0%2C0%2C1246%2C1246\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-08/939e01ef-fa6f-47f9-add6-f32c9308eede.jpg?rect=0%2C413%2C1246%2C748\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-08/939e01ef-fa6f-47f9-add6-f32c9308eede.jpg?rect=191%2C0%2C865%2C1573\"},\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixe