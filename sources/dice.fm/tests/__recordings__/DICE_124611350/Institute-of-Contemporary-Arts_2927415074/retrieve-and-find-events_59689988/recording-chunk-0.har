ues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-15T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/c84facbe-f81b-414f-8000-6c0b23240ce0.jpg?rect=8%2C0%2C1904%2C1904\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/c84facbe-f81b-414f-8000-6c0b23240ce0.jpg?rect=0%2C376%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/c84facbe-f81b-414f-8000-6c0b23240ce0.jpg?rect=437%2C0%2C1047%2C1904\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/F085f9d5cd3e?dice_id=F085f9d5cd3e\",\"post_competition_referral\":\"https://link.dice.fm/d2821050c1f3?dice_id=d2821050c1f3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ab72fd20c339?dice_id=Ab72fd20c339\",\"post_purchase_referral\":\"https://link.dice.fm/j8c1de3ac9a3?dice_id=j8c1de3ac9a3\",\"post_reminder_referral\":\"https://link.dice.fm/X0e58c8c4f93?dice_id=X0e58c8c4f93\",\"post_waitinglist_referral\":\"https://link.dice.fm/q4e09f570fe4?dice_id=q4e09f570fe4\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:39\",\"properties\":[],\"presented_by\":\"Presented by Lazuli.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765843200,\"id\":\"69416602da176500019c0975\",\"name\":\"Lazuli plus special guests Jones & Son\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"French Progressive Rock Innovators LAZULI Announce ‘Être et ne plus être UK Mini-Tour’ for October 2026\\n\\nFrench progressive rock sensation LAZULI are delighted to announce a short, highly anticipated return to the UK in October 2026. Known globally for their unique blend of rock, world music, and poetic French lyricism, the quintet will perform four exclusive dates, including a headline slot at the renowned Summer's End festival, the legendary Trading Boundaries in Fletching with special guests Jones & Son supporting them in London and rock stalwarts, Jump joint headlining in Birmingham.\\n\\nLAZULI, hailed as the \\\"French ambassadors of progressive rock,\\\" continue to mesmerize audiences with their intricate compositions and distinctive instrumentation. Central to their unique sound is the Léode, an instrument invented and played by Claude Leonetti, a sonic box of tricks that delivers sounds ranging from soaring textures to deep, guttural tones. Joined by the powerful voice and evocative lyrics of frontman Dominique Leonetti, the band creates a truly unforgettable and theatrical live experience.\\n\\nThe four-date run will give British fans a rare opportunity to witness one of the genre’s most captivating live acts, showcasing some of their latest studio album, Être et ne plus être.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"date_unix\":1792087200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3931},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T10:00:00+00:00\",\"sale_end_date\":\"2026-10-15T21:00:00+01:00\",\"sale_start_date\":\"2025-12-18T10:00:00+00:00\",\"event_start_date\":\"2026-10-15T19:00:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"mx855v-wishbone-ash-15th-oct-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"We Stand as One\",\"redirect_url\":\"https://open.spotify.com/track/0StROHvvuCv6YcLQ9YNx9o\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/23cca908ef7aa910c5425c8c54a71cec378197ce?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"We Stand as One\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wishbone Ash\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c541691c5deff70c190f9a7c9\"},\"artist_id\":\"18519\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-15T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/ace259a8-6d06-43c5-9a6c-a9cf1825a3b2.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/ace259a8-6d06-43c5-9a6c-a9cf1825a3b2.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/ace259a8-6d06-43c5-9a6c-a9cf1825a3b2.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/le5aaea572ca?dice_id=le5aaea572ca\",\"post_competition_referral\":\"https://link.dice.fm/d03c2d0715cc?dice_id=d03c2d0715cc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c485189480e2?dice_id=c485189480e2\",\"post_purchase_referral\":\"https://link.dice.fm/t0b4ea47ebb6?dice_id=t0b4ea47ebb6\",\"post_reminder_referral\":\"https://link.dice.fm/kfdc931425ba?dice_id=kfdc931425ba\",\"post_waitinglist_referral\":\"https://link.dice.fm/L99771747c71?dice_id=L99771747c71\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:40\",\"properties\":[],\"presented_by\":\"Presented by The Gig Cartel.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765879200,\"id\":\"6932abb413249f00011757b1\",\"name\":\"Wishbone Ash\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"WISHBONE ASH\\n\\nTHE TIME WAS TOUR 2026\\n\\nFor over five decades, Wishbone Ash has stood as one of rock music’s most enduring and influential forces, their pioneering twin-lead guitar sound providing a blueprint for the generations of rock, metal, and progressive artists that followed in their footsteps. With an extensive catalogue, countless miles on the road, and a legacy woven into the fabric of rock history, they continue to inspire audiences worldwide. Don’t miss this exciting opportunity to experience a legendary band that don’t just celebrate their illustrious past, but continue to embrace the future.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1792087200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1695},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T00:00:00+00:00\",\"sale_end_date\":\"2026-10-15T21:00:00+01:00\",\"sale_start_date\":\"2025-12-04T00:00:00+00:00\",\"event_start_date\":\"2026-10-15T19:00:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5k692-hackney-folk-club-bruce-molsky-darol-anger-15th-oct-chats-palace-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Bruce Molsky - Cotton Eyed Joe\",\"redirect_url\":\"https://music.apple.com/us/album/cotton-eyed-joe/160414785?i=160414928&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Bruce Molsky\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/d4/6b/8d/d46b8d24-7e64-fb11-928d-40f5ae6e6a58/mzaf_15181835705316733288.plus.aac.p.m4a\",\"track_name\":\"Cotton Eyed Joe\"},{\"type\":\"spotify\",\"title\":\"Bruce Molsky - Cotton Eyed Joe\",\"redirect_url\":\"https://open.spotify.com/track/1IzNk6X94JkDcdJr5nDaFt\",\"artist\":\"Bruce Molsky\",\"preview_url\":\"https://p.scdn.co/mp3-preview/25e1d33545cdf2a629935a77eecd895c7a187f89?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Cotton Eyed Joe\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bruce Molsky\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-10/9d280e8e-66f6-4f62-bd7a-5ba441dd5e10.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"24060\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"171\",\"name\":\"Chats Palace\",\"address\":\"42-44 Brooksby's Walk, London E9 6DF\",\"location\":{\"lat\":51.5502294,\"lng\":-0.0429139000000305},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-15T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-04/ef790079-85d6-4677-a646-2fbe49cf414e.jpg?rect=136%2C0%2C902%2C902\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-04/ef790079-85d6-4677-a646-2fbe49cf414e.jpg?rect=0%2C99%2C1173%2C704\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-04/ef790079-85d6-4677-a646-2fbe49cf414e.jpg?rect=339%2C0%2C496%2C902\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/f5b9aa36728a?dice_id=f5b9aa36728a\",\"post_competition_referral\":\"https://link.dice.fm/Fef1814b8e77?dice_id=Fef1814b8e77\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tfc188fb58a0?dice_id=Tfc188fb58a0\",\"post_purchase_referral\":\"https://link.dice.fm/P319f069c928?dice_id=P319f069c928\",\"post_reminder_referral\":\"https://link.dice.fm/Mcc0048b36ec?dice_id=Mcc0048b36ec\",\"post_waitinglist_referral\":\"https://link.dice.fm/we476080c70c?dice_id=we476080c70c\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:41\",\"properties\":[],\"presented_by\":\"Presented by Hackney Folk Club\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764806400,\"id\":\"69318e30da8c070001f43040\",\"name\":\"Hackney Folk Club - Bruce Molsky & Darol Anger\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"*Hackney Folk Club Presents:***  \\n  \\nBruce Molsky & Darol Anger**\\n\\nDarol and Bruce have been musical explorers together for years, sharing a creative universe that’s resulted in some epic collaborations, crashing each other’s concerts and recordings, and just finding big joy in playing together.\\n\\nBack home, Bruce and Darol tour extensively. Bruce also holds the title of “Visiting Scholar in the American Roots Music Program” at Berklee College of Music, where he is the go-to guy for the next generation of roots musicians.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"date_unix\":1792087200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3695,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-10-15T05:45:00+01:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-10-15T19:00:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"2w7gem-the-long-ryders-15th-oct-electric-ballroom-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Run Dusty Run\",\"redirect_url\":\"https://open.spotify.com/track/6PIO6pbY13BYsxgVMk5sxm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a5ef0d20275c280230394959fe7d7cbb6243f1f9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Run Dusty Run\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":60335,\"title\":\"Venue Accessibility Information\",\"body\":\"https://electricballroom.co.uk/disabled-access/\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Long Ryders\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7f0c951f893b3d4e8e506d5f\"},\"artist_id\":\"9859\",\"about\":{\"description\":\"Often credited as founders of the alt-country movement, The Long Ryders add a rough-hewn edge to the typically sentimental country sound. The first new Long Ryders’ studio album for 30 years, Psychedelic Country Soul, was released in 2019, and the fact that it went straight to number one on Amazon’s Americana charts proves their significance to the genre.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"55\",\"name\":\"Electric Ballroom\",\"address\":\"184 Camden High St, London NW1 8QP\",\"location\":{\"lat\":51.5396558,\"lng\":-0.143191399999978},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/fab0b36d-a5a4-4e37-a541-2c5af15a3bc1.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"electric-ballroom-j78v\",\"accessibility\":{\"url\":\"http://electricballroom.co.uk/disabled-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-15T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/e8c0dc42-6ece-47c1-96ae-641fa222d3b7.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/e8c0dc42-6ece-47c1-96ae-641fa222d3b7.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/e8c0dc42-6ece-47c1-96ae-641fa222d3b7.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Z6d2b771f5e6?dice_id=Z6d2b771f5e6\",\"post_competition_referral\":\"https://link.dice.fm/d87d38a22125?dice_id=d87d38a22125\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H67032f21370?dice_id=H67032f21370\",\"post_purchase_referral\":\"https://link.dice.fm/cfb4948a5349?dice_id=cfb4948a5349\",\"post_reminder_referral\":\"https://link.dice.fm/d031f8a783d7?dice_id=d031f8a783d7\",\"post_waitinglist_referral\":\"https://link.dice.fm/U31068152758?dice_id=U31068152758\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:42\",\"properties\":[],\"presented_by\":\"Presented by AGMP.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764201600,\"id\":\"6929c0897a757300018c770d\",\"name\":\"The Long Ryders\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"AGMP Concerts Presents\\n\\nTHE LONG RYDERS\\n\\nThe Long Ryders, pioneers of the Alt-Country movement, return to the stage with the same fiery spirit that first made them legends. Fusing punk energy with country-rock harmonies, the band bridged the gap between Gram Parsons and today's Americana heroes, influencing acts such as Wilco, The Jayhawks, and Uncle Tupelo.\\n\\nRising from the Los Angeles scene, The Long Ryders made their mark with acclaimed albums including Native Sons and State of Our Union, featuring the alt-radio classic \\\"Looking for Lewis & Clark.\\\" Their sound-12-string guitars, heartfelt songwriting, and a raw, roots-driven edge-helped define a generation and inspire a movement.\\n\\nFollowing their celebrated 2019 release Psychedelic Country Soul, the band returned to the studio to craft September November, their first album since the passing of bassist Tom Stevens. Still a thrilling live force, The Long Ryders deliver shows packed with history, heart, and unrelenting energy. Saddle up-don't miss the ride.\\n\\nThis event is 14 and over. 14s to 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"1442\",\"name\":\"AGMP\",\"image\":{\"url\":null},\"perm_name\":\"agmp-99g9\",\"profile_active\":false},\"date_unix\":1792087200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2308,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-10T15:00:00+01:00\",\"sale_end_date\":\"2026-10-15T18:00:00+01:00\",\"sale_start_date\":\"2025-10-13T15:00:00+01:00\",\"event_start_date\":\"2026-10-15T19:00:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"53x52y-the-narrator-15th-oct-the-black-heart-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artis