uba with swagger, precision and serious soul — played by musicians who live and breathe it.\\n\\nExpect sweat, smiles and non-stop movement.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:85\",\"social_links\":{\"event_share\":\"https://link.dice.fm/m3e8a876c60e?dice_id=m3e8a876c60e\",\"post_competition_referral\":\"https://link.dice.fm/wfb7d766530a?dice_id=wfb7d766530a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Md118e8d179b?dice_id=Md118e8d179b\",\"post_purchase_referral\":\"https://link.dice.fm/Y84203d0e9a2?dice_id=Y84203d0e9a2\",\"post_reminder_referral\":\"https://link.dice.fm/M8a75780e79d?dice_id=M8a75780e79d\",\"post_waitinglist_referral\":\"https://link.dice.fm/S2aad086cab9?dice_id=S2aad086cab9\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T13:00:00+00:00\",\"sale_end_date\":\"2026-03-19T19:00:00+00:00\",\"sale_start_date\":\"2026-02-05T13:00:00+00:00\",\"event_start_date\":\"2026-03-19T19:00:00+00:00\",\"event_end_date\":\"2026-03-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1965,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"69846a540aefc000014b5c7f\",\"seats_io_event_id\":null,\"name\":\"Havana Música: A Celebration of Cuban Music\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nv92al-havana-msica-a-celebration-of-cuban-music-19th-mar-the-jazz-cafe-london-tickets\",\"date_unix\":1773946800,\"score\":0,\"tty_to_extras\":