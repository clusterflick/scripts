2026-01-06/86dca728-baff-4dff-b71d-34d377423d42.jpg?rect=340%2C0%2C440%2C800\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/P23b3305870d?dice_id=P23b3305870d\",\"post_competition_referral\":\"https://link.dice.fm/c5a3cfc885dc?dice_id=c5a3cfc885dc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N07f623456a5?dice_id=N07f623456a5\",\"post_purchase_referral\":\"https://link.dice.fm/N565cee7430e?dice_id=N565cee7430e\",\"post_reminder_referral\":\"https://link.dice.fm/P97466dfc607?dice_id=P97466dfc607\",\"post_waitinglist_referral\":\"https://link.dice.fm/n4805e6ae126?dice_id=n4805e6ae126\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:65\",\"properties\":[],\"presented_by\":\"Presented by DHP\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767780000,\"id\":\"695d2e8254794b00012bea4a\",\"name\":\"Black Water County\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"*DHP presents...*\\n\\n**BLACK WATER COUNTY**\\n\\n*Plus guests...*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"date_unix\":1792864800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4074},\"unicorn\":false,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"cbd4642e-74dd-47c5-9215-31a5c6df07f6\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T13:45:00+00:00\",\"sale_end_date\":\"2026-10-23T09:00:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-10-24T19:00:00+01:00\",\"event_end_date\":\"2026-10-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"xek2gl-panchiko-24th-oct-roundhouse-london-tickets\",\"seats_io_event_id\":\"cbd4642e-74dd-47c5-9215-31a5c6df07f6\",\"previews\":[{\"type\":\"spotify\",\"title\":\"D>E>A>T>H>M>E>T>A>L\",\"redirect_url\":\"https://open.spotify.com/track/3mkO4ZYDzNMbuJQtzFHz9A\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f56cd235137b3d048614fce0f2e61408ef504dea?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"D>E>A>T>H>M>E>T>A>L\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":54390,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":54391,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":54392,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":54393,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Panchiko\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-03-31/cb187321-f637-4354-b82b-290def0ec1a8.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"41713\",\"about\":{\"description\":\"For years, shoegaze band Panchiko were shrouded in mystery. Formed in Nottingham in the late ’90s by a group of schoolboys, a copy of their 2020 under-the-radar debut EP, D>E>A>T>H>M>E>T>A>L (released shortly before they disbanded) sent the internet into a frenzy after being discovered in a charity shop 16 years later. Once its members – who had all but abandoned their quest for musical stardom – were tracked down, they revived the dreampop ensemble and haven’t looked back since: rereleasing their hazy emo records, performing at SXSW and touring the US.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Alison’s Halo\",\"image\":null,\"artist_id\":\"105513\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-24T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-31/1edf20af-bc80-43f4-8bb3-4bddbc7292a2.jpg?rect=1141%2C0%2C4492%2C4492\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-31/1edf20af-bc80-43f4-8bb3-4bddbc7292a2.jpg?rect=0%2C