tps://dice-media.imgix.net/attachments/2025-09-23/5f4e9fe8-2b6d-4965-98d6-3d4ded3281c5.jpg?rect=0%2C917%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-23/5f4e9fe8-2b6d-4965-98d6-3d4ded3281c5.jpg?rect=334%2C0%2C1833%2C3333\"},\"id\":\"68d6c6c6dc91ea000145693f\",\"name\":\"Piano Pop Starring Tony Ann\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"c790622f-0cf2-4286-b1ac-ba3b76fe7bbd\",\"seats_io_public_key\":\"e0dc9d72-aa88-4eb1-a260-aba6188eb895\",\"seat_selection\":\"enabled\"},\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Tony Ann is a Canadian pianist and composer blending classical precision with modern emotion.\\n\\nWith over 1 billion views, 300 million streams, and more than 6 million followers, he’s become a leading voice in contemporary piano music. His sold-out world tour has included iconic venues like the Olympia in Paris and London’s Barbican, and he is a 2025 JUNO Awards nominee. On October 17, 2025, Tony appears as the sole feature on global superstar Lang Lang’s new album “Piano Book 2,” performing a four-hands version of his diamond-certified single “ICARUS.”\\n\\nIn 2026 he returns to Europe’s most beautiful stages with the violin-cello duo ARKAI, with whom he has created orchestral versions of his signature pieces.\\n\\nhttps://www.tonyann.com/\\n\\nhttps://www.instagram.com/tonyannnn/\\n\\nhttps://www.tiktok.com/@tonyannn\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Over 8's only. Under 16's must be accompanied by an adult 18+\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-25T10:00:00+01:00\",\"sale_end_date\":\"2026-04-17T12:00:00+01:00\",\"sale_start_date\":\"2025-09-25T10:00:00+01:00\",\"event_start_date\":\"2026-04-19T19:30:00+01:00\",\"event_end_date\":\"2026-04-19T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sun 19 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Peaches\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb742308bc67e0af52374f8a71\"},\"artist_id\":\"133410\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Metropolis Music.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":73252,\"title\":\"Age Restriction\",\"body\":\"Standing: 11pm curfew: +14yrs; post 11pm: +18yrs\\n\\nSeated: 11pm curfew: +8yrs, under 14yrs need a guardian; post 11pm: +18yrs\",\"order\":0},{\"id\":73253,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":1}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"934\",\"name\":\"O2 Forum Kentish Town\",\"address\":\"9-17 Highgate Rd, London NW5 1JY\",\"location\":{\"lat\":51.5521427,\"lng\":-0.142224499999998},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-forum-kentish-town-8er7\",\"accessibility\":{\"url\":\"https://ac