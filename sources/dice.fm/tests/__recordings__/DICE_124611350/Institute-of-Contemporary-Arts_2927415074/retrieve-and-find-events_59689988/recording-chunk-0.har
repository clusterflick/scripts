\",\"name\":\"Chris Brain\",\"perm_name\":\"3og9dl-chris-brain-22nd-may-moth-club-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-05/64dc2c41-8a8e-4344-84a2-154f578121d4.jpg?rect=0%2C499%2C2002%2C2002\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-05/64dc2c41-8a8e-4344-84a2-154f578121d4.jpg?rect=0%2C900%2C2002%2C1201\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-05/64dc2c41-8a8e-4344-84a2-154f578121d4.jpg?rect=176%2C0%2C1650%2C3000\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Chris Brain\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe30a270b4141483db3129dbe\"},\"artist_id\":\"39901\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1767610800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1813,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Midnight Sky\",\"redirect_url\":\"https://open.spotify.com/track/2l5Cuhp91DVHhIpH1stCBi\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2b4216e4d16a773a9310dc0fc17b2e26a0c17a9b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Midnight Sky\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T17:00:00+00:00\",\"sale_end_date\":\"2026-05-22T21:00:00+01:00\",\"sale_start_date\":\"2025-12-01T17:00:00+00:00\",\"event_start_date\":\"2026-05-22T19:30:00+01:00\",\"event_end_date\":\"2026-05-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by EartH.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/v92845fb8a80?dice_id=v92845fb8a80\",\"post_competition_referral\":\"https://link.dice.fm/S5b2cbf66b44?dice_id=S5b2cbf66b44\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z3b1ef7170ac?dice_id=z3b1ef7170ac\",\"post_purchase_referral\":\"https://link.dice.fm/gaa73a9a0d66?dice_id=gaa73a9a0d66\",\"post_reminder_referral\":\"https://link.dice.fm/F7a8ba1dbce9?dice_id=F7a8ba1dbce9\",\"post_waitinglist_referral\":\"https://link.dice.fm/ee4c568b7fd8?dice_id=ee4c568b7fd8\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\n**The Hackney Folk Club and Fire in the Mountain Present Brighde Chaimbeul + Nora Brown and Stephanie Coleman co-headline.**\\n\\nBrighde Chaimbeul and Nora Brown are both young leading lights in the traditional music scene. They here join forces for a special one off show at EartH in Hackney, presenting their interpretation and take on both Scottish and Southern Appalachian Folk Music. This special concert will bring together two much- maligned instruments – The Scottish Small Pipes and The Banjo – to prove how versatile and beautiful these instruments can be.\\n\\nNora Brown is the “brightest young star in old-time music” (Songlines), playing traditional music focused on southern Appalachian banjo and guitar, with her singing revealing her “thirst for storytelling.”( NPR) . She digs deep: “a reverent nod to deeply-rooted ole-time traditions, and an exhibit of sonic heirlooms carefully amended to meet a modern moment with vintage elegance.\\n\\nScottish smallpipes player Brìghde Chaimbeul (pronounched Breetch-er Hime-bowl) is a leading purveyor of experimental Celtic music. Her piping has earned her a BBC Young Folk Award and a BBC Horizon Award, and seen her perform for heads of state at the Cop26 climate conference. She’s brought her instrument to a global stage, and has worked with a range of other artists\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779474600,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-05-22T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":true,\"max_tickets\":6,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzODY2NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTMwODM1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1Ni45MjY4NzhaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzAzOCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzODY2NSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTMwODM1LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NTo1Ni45MjY5MDNaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzAzOSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"res