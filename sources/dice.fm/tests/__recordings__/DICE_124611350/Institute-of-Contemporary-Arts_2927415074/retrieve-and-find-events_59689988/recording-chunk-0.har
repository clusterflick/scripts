live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/E49654540466?dice_id=E49654540466\",\"post_competition_referral\":\"https://link.dice.fm/K1ad17218c1b?dice_id=K1ad17218c1b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Beaf12098a99?dice_id=Beaf12098a99\",\"post_purchase_referral\":\"https://link.dice.fm/m9c6a21525aa?dice_id=m9c6a21525aa\",\"post_reminder_referral\":\"https://link.dice.fm/g6ce24194115?dice_id=g6ce24194115\",\"post_waitinglist_referral\":\"https://link.dice.fm/e6c292a343c7?dice_id=e6c292a343c7\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Robin Bibi Band was born in the late 90s when Robin was inspired to start his own Texas Style Blues/ Rock band after having worked as a session man with such arists as the Pretty Things, Robert Plant, Jimmy Page, Ben E. King and Helen Shapiro to name but a few.\\n\\nThe Band released their debut Album “Blue Thrash Therapy” in late 1997. Mainly blues standards with a couple of notable original songs thrown in. This album received AirPlay straight away from Paul Jones on Jazz FM & the band started to become popular in the live circuit. The follow up, “Language of Your Soul”, a work of mainly original material, was released to more critical acclaim in 2000. Since then, & 8 more albums and a DVD later, the Robin Bibi Band have established themselves as one of the UK’s hardest working & most popular bands in their genre and Robin had been widely recognised as one of the UK’s finest Blues / Rock guitarists!\\n\\nRobin is at present signed to Ashwood Records and has recently released what’s considered to be his best album yet “No More A Secret”, the first album of exclusively Robin Bibi originals. This album received rave reviews and extensive AirPlay including BBC Radio 2. It peaked at number 2 in the IBBA playlist.\\n\\nRobin has been nominated by the British Blues awards in several categories and won an award for best Guitar Solo from the WRC! The band continue their never ending mission to spread their own personal brand of music and to entertain and lift the spirits of their audiences\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1796569200,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-12-06T15:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:54\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"692f656b96fff8000142c6b5\",\"name\":\"Robin Bibi Band\",\"perm_name\":\"xe75yk-robin-bibi-band-6th-dec-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-30/40449e32-5dea-45b7-94b2-18004f53091c.jpg?rect=266%2C0%2C1516%2C1516\",\"landscape\":\"https://dice-media.imgix.net/