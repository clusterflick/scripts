ry8wuLoKeRybVVpK\",\"artist\":\"LIFE\",\"preview_url\":\"https://p.scdn.co/mp3-preview/923275a6d5a882315812c3ebac59ea252f2d80a5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Bum Hour\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":3725,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by The Jazz Cafe.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":74598,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"bb8aax-baco-exu-do-blues-24th-jun-the-jazz-cafe-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782324000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":20,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:83\",\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-24T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Baco Exu do Blues\",\"image\":null,\"artist_id\":\"64243\",\"about\":{\"description\":\"Baco Exu do Blues is a Brazilian rapper, singer and songwriter known for his poetic lyrics which explore love, sex, power, religion and society. His album QVVJFA sampled Gal Costa, Vinicius de Moraes, Gloria Groove and Muse Maya.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"**A singular force in Brazilian music.**\\n\\nBaco Exu do Blues has spent the last decade reshaping rap from the inside out — fusing razor-sharp lyricism with the emotional depth of MPB, soul, and the blues.\\n\\nFrom the breakthrough intensity of Esú and the era-defining Bluesman to his latest cinematic triumph, HASOS, Baco delivers of fearless Brazilian hip-hop, soul, and introspective storytelling that demand to be experienced live.\\n\\nExpect a show that hits like a manifesto — intimate, confrontational, and unforgettable.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T10:00:00+00:00\",\"sale_end_date\":\"2026-06-24T19:00:00+01:00\",\"sale_start_date\":\"2026-02-05T10:00:00+00:00\",\"event_start_date\":\"2026-06-24T19:00:00+01:00\",\"event_end_date\":\"2026-06-24T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6984565e455a1e00015bb6af\",\"name\":\"Baco Exu do Blues\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/daa7330d-b378-4fb5-82be-dd660d284e0a.jpg?rect=2162%2C78%2C4122%2C4118\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/daa7330d-b378-4fb5-82be-dd660d284e0a.jpg?rect=0%2C258%2C7728%2C4637\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/daa7330d-b378-4fb5-82b