Evening Standard, Faded Glamour, Music Unmasked, Secret Delivery, Don't Need No Melody, Demon FM, K2K Radio and the Hype Machine to name a few.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T00:00:00+00:00\",\"sale_end_date\":\"2026-03-11T18:45:00+00:00\",\"sale_start_date\":\"2026-02-03T00:00:00+00:00\",\"event_start_date\":\"2026-03-11T19:00:00+00:00\",\"event_end_date\":\"2026-03-11T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sylva Faye - Dark Matter\",\"redirect_url\":\"https://music.apple.com/us/album/dark-matter/1838753238?i=1838753239&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sylva Faye\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/45/60/32/456032b8-79bd-1fc3-5111-81688a89d2c5/mzaf_4508135356579798027.plus.aac.p.m4a\",\"track_name\":\"Dark Matter\"},{\"type\":\"spotify\",\"title\":\"Sylva Faye - Dark Matter\",\"redirect_url\":\"https://open.spotify.com/track/34H2MxDcN0FvSqzWTaGGEK\",\"artist\":\"Sylva Faye\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ce708fd3653ff4e79a359463fa1b3b95ececac13?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dark Matter\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Torus\",\"image\":null,\"artist_id\":\"48252\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by InFireworks.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"2427\",\"name\":\"Signature Brew Haggerston\",\"address\":\"340 Acton Mews, London E8 4E