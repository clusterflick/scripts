"Ground Floor, 40 Celebration Ave, East Village, London E20 1DB\",\"location\":{\"lat\":51.54641,\"lng\":-0.00784},\"image\":null,\"city\":{\"id\":\"68348e77ff502a30257b8e25\",\"name\":\"Stratford\",\"location\":{\"lat\":51.545532,\"lng\":-0.007741,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"soul-mama-xeeyl\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-23T18:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":910,\"name\":\"Global Soul\",\"privacy_policy_link\":\"https://globalsoulradio.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:9\",\"about\":{\"description\":\"**Asa Martinson & the Outlet**\\n\\nPPL sponsored London based 7-piece band jazz fusion (Rnb/Afrobeats).\\n\\nLed by Asa Martinson the group is inspired by legends like James Brown, Tony Allen, George Duke, and\\n\\nhis mentor Julian Joseph. Their journey has taken them to some of the UK’s most iconic stages— this\\n\\nsummer selling out Pizza Express Live (Dean Street), 91 Living Room and STEREO Covent Garden. As well as playing Ronnie Scott’s, the 606 Club, and the Barbican—where they’ve refined their genre-defying craft.\\n\\nAsa’s experience with the Royal Philharmonic Orchestra, where he trains gifted school pupils, reinforced his belief in the power of cross-genre music. At this early point in his career Asa is already using his experience in the music industry to support his community.\\n\\nWith a mix of vocal and instrumental tunes, aswell high energy and interactive sets. Prepare for a night of unreleased gems, classic hits, and music to move your body and touch your soul! Debut EP scheduled to come out early 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1755853200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-20/d16e7500-80e3-41a8-b7a9-4f9c20f076c4.jpg?rect=0%2C1000%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-20/d16e7500-80e3-41a8-b7a9-4f9c20f076c4.jpg?rect=0%2C1800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-20/d16e7500-80e3-41a8-b7a9-4f9c20f076c4.jpg?rect=350%2C0%2C3300%2C6000\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6946fc732215d800019b04a0\",\"name\":\" Asa Martinson & The Outlet Live\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-22T10:00:00+01:00\",\"sale_end_date\":\"2026-04-23T18:00:00+01:00\",\"sale_start_date\":\"2025-12-20T10:00:00+00:00\",\"event_start_date\":\"2026-04-23T18:30:00+01:00\",\"event_end_date\":\"2026-04-23T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"xe78lk--asa-martinson-the-outlet-live-23rd-apr-soul-mama-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3366},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dic