cc5ceb0df17d6a6:58\",\"social_links\":{\"event_share\":\"https://link.dice.fm/D244939eaab3?dice_id=D244939eaab3\",\"post_competition_referral\":\"https://link.dice.fm/e9f1e3c47da8?dice_id=e9f1e3c47da8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F2d5f45969d5?dice_id=F2d5f45969d5\",\"post_purchase_referral\":\"https://link.dice.fm/B754dea811c2?dice_id=B754dea811c2\",\"post_reminder_referral\":\"https://link.dice.fm/n66338586531?dice_id=n66338586531\",\"post_waitinglist_referral\":\"https://link.dice.fm/C4d163193d51?dice_id=C4d163193d51\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T14:00:00+01:00\",\"sale_end_date\":\"2026-04-29T10:00:00+01:00\",\"sale_start_date\":\"2025-10-24T14:00:00+01:00\",\"event_start_date\":\"2026-04-29T19:00:00+01:00\",\"event_end_date\":\"2026-04-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2826,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"16\",\"name\":\"Metropolis Music\",\"image\":{\"url\":null},\"perm_name\":\"metropolis-music-jyaj\",\"profile_active\":true},\"id\":\"68fb7ab7b8aac00001ebb307\",\"seats_io_event_id\":null,\"name\":\"Just Mustard\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"rywb5r-just-mustard-29th-apr-electric-brixton-london-tickets\",\"date_unix\":1777485600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-29T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Truman Sinclair\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-30/80ff6e27-4c05-4852-9f0b-a5675b03355c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"125068\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tyler Ballgame\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-13/18a60b6a-8141-43df-97c8-6f2682af73d0.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"99000\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[{\"id\":45907,\"title\":\"What to do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nOnce you activate your ticket, you will no longer be able to send it to a friend.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":0},{\"id\":45908,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":1},{\"id\":45909,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":2},{\"id\":45910,\"title\":\"A show is listed as sold out. How can I get tickets?\",\"body\":\"If a show is listed as sold out on this website then our venue is full to capacity. We recommend you download the DICE app and join the Waiting List for return tickets.\\n\\nYou are welcome to visit the box office when doors open for the event to see if there are any door tickets. We cannot guarantee door tickets will be available in advance. Sorry.\",\"order\":3},{\"id\":45911,\"title\":\"I have mobility issues. How can you help?\",\"body\":\"If you need a seat for medical reasons or need help moving around our venue, or if you’d like to bring a companion along to help you with mobility, you will need to arrange it with us in advance. We suggest you read our accessibility guide and then contact our box office.\",\"order\":4},{\"id\":45912,\"title\":\"Do I need ID? What type of ID is accepted?\",\"body\":\"Bring ID if you look 25 years of age or younger. We accept the following forms of photo ID.\\n\\n\\\\- Passport\\n\\n\\\\- Driving licence card\\n\\n\\\\- PASS card. You can apply for a PASS card at www.pass-scheme.org.uk\",\"order\":5},{\"id\":45913,\"title\":\"Can I bring food?\",\"body\":\"We do not allow you to bring food or drink into the venue. Chewing gum is also not permitted inside the venue.\",\"order\":6},{\"id\":45914,\"title\":\"Is there a cloakroom?\",\"body\":\"Yes, we have a cloakroom in the Foyer Bar space. As you walk up the entrance stairs and straight ahead towards the Foyer Bar the cloakroom is on the left. Each item is charged at £3.\",\"order\":7}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-22/f100a750-c580-4110-8764-dd9b7ead3a33.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-22/f100a750-c580-4110-8764-dd9b7ead3a33.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-22/f100a750-c580-4110-8764-dd9b7ead3a33.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Help Me Out\",\"redirect_url\":\"https://open.spotify.com/track/1rxu3wmoE4XtdUb6hmXw9N\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fa1de837312e6e8d65c29e2b8e2208a4a7a89b69?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Help Me Out\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1758555000,\"max_tickets\":6,\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Rough Trade Records is thrilled to announce Tyler Ballgame’s stunning debut album For the First Time, Again, out January 30th, 2026. A bracing reminder of how great songs delivered by a gifted vocalist can move, captivate and inspire, it boasts 12 finely crafted tunes rooted in classic rock, indie and Americana. Ballgame’s infectious melodies draw the listener into a story, and his message of belief in one’s true self resonates deep and wide.\\n\\nThe album’s lead single, the rhapsodic Lennon-meets-Orbison ‘I Believe In Love’ is out today with a video by Ballgame’s friends and roommates Joey Casale and Victoria Gagnaire Stein. Recorded live, the song is the first one that Ballgame wrote explicitly knowing there would be a record and that it would change his life. “I had met \\\\[producer Jonathan\\\\] Rado and he told me to write the biggest song in the world, so I sat down at my kitchen table for two days and put the puzzle of the composition together. It’s turned into an anthem about love of love and the fools it makes,” he explains.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Communion One and Metropolis Music\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:59\",\"social_links\":{\"event_share\":\"https://link.dice.fm/T1554e4cc96c?dice_id=T1554e4cc96c\",\"post_competition_referral\":\"https://link.dice.fm/r6ea05d6c1bb?dice_id=r6ea05d6c1bb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ae4e4fc94403?dice_id=ae4e4fc94403\",\"post_purchase