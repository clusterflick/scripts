\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:52\",\"social_links\":{\"event_share\":\"https://link.dice.fm/jdeab6e9250a?dice_id=jdeab6e9250a\",\"post_competition_referral\":\"https://link.dice.fm/i3386a9f9073?dice_id=i3386a9f9073\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Da5e7e95a299?dice_id=Da5e7e95a299\",\"post_purchase_referral\":\"https://link.dice.fm/vaf6593f5e6a?dice_id=vaf6593f5e6a\",\"post_reminder_referral\":\"https://link.dice.fm/s739e0f7540a?dice_id=s739e0f7540a\",\"post_waitinglist_referral\":\"https://link.dice.fm/eba290a0667a?dice_id=eba290a0667a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-04-11T11:00:00+01:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-04-11T13:00:00+01:00\",\"event_end_date\":\"2026-04-11T16:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"695668602a8e2500015ace85\",\"seats_io_event_id\":null,\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"py5yqy-gingers-big-drag-bottomless-brunch-11th-apr-balls-brothers-austin-friars-london-tickets\",\"date_unix\":1775908800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T13:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:53\",\"social_links\":{\"event_share\":\"https://link.dice.fm/k266e2407437?dice_id=