uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Simone White\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/35/7f/f1/357ff1e2-e8ff-59f6-47ec-82f81d16f610/mzaf_10948024745424519582.plus.aac.p.m4a\",\"track_name\":\"Semaphores\"},{\"type\":\"spotify\",\"title\":\"Simone White - Semaphores\",\"redirect_url\":\"https://open.spotify.com/track/4p6MBOz6DzFnAvEZajw4cw\",\"artist\":\"Simone White\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c15809340051898c3b7a33d84a32f0c923c85bd6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Semaphores\"}],\"faqs\":[{\"id\":64079,\"title\":\"Is the event wheelchair accessible?\",\"body\":\"Yes! There is a narrow corridor to navigate but it is possible to access the space in a wheelchair. Please send a message to Dice when you book so that the venue can prepare in advance for your arrival.\",\"order\":0},{\"id\":64080,\"title\":\"Is the space seated or standing?\",\"body\":\"The venue is unreserved seating in armchairs and sofas\",\"order\":1},{\"id\":64081,\"title\":\"Will Simone be signing records after the show?\",\"body\":\"Yes! There will be a merch stall selling Simone's most recent albums and she will be around to say hello and sign your records\",\"order\":2}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"k6nko9-june-freedom-live-28th-mar-islington-assembly-hall-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774724400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-12/f48e76b5-8080-49ad-b16d-6bdae7b8abdc.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-12/f48e76b5-8080-49ad-b16d-6bdae7b8abdc.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-12/f48e76b5-8080-49ad-b16d-6bdae7b8abdc.jpg?rect=243%2C0%2C594%2C1080\"},\"max_tickets\":4,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ad4f4f0c88eb?dice_id=Ad4f4f0c88eb\",\"post_competition_referral\":\"https://link.dice.fm/w20db7b0bd90?dice_id=w20db7b0bd90\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/da70e7cde34a?dice_id=da70e7cde34a\",\"post_purchase_referral\":\"https://link.dice.fm/x482df472166?dice_id=x482df472166\",\"post_waitinglist_referral\":\"https://link.dice.fm/Lb80c80d83d4?dice_id=Lb80c80d83d4\",\"post_reminder_referral\":\"https://link.dice.fm/C14bf1a7bac9?dice_id=C14bf1a7bac9\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"June Freedom is an international Cape Verdean recording artist known for blending Afro-Latin rhythms with alt-pop, R&B, and worldbeat. Raised in Cape Verde on the island of Fogo, June’s earliest influences came from Tropical Club—his mother’s Cape Verdean restaurant, a local landmark where live music, family, and food came together. That space wasn’t just part of his upbringing—it was the foundation of his creative world.\\n\\nSinging in English, Portuguese, Spanish, and Kriolu, June’s multilingual sound reflects his layered identity. With over 300 million streams across platforms and more than 2 million monthly listeners on Spotify, June is currently the most streamed Cape Verdean artist worldwide. While his recordings deliver a smooth, genre-blending sound that moves easily between dancefloor and daydream, June’s live shows take the energy to another level.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:86\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"presented_by\":\"Pr