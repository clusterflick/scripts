purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"MOTH Club\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"2195325970769692\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:42\",\"properties\":[],\"presented_by\":\"Presented by MOOF Magazine.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760614200,\"id\":\"68f0d901c35b8500010bc357\",\"name\":\"Matthew C. Whitaker (HENGE) + Shunya\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Join Matthew C. Whitaker (HENGE) and Shunya for an evening of music celebrating the release of Whitaker’s second solo album,Songs for the Weary - a collection of graceful compositions incorporating classical guitar, rich string arrangements, and subtle electronics. Offering a serene listening experience, the album unfolds across eight gentle pieces woven with intricate harmonies and warm instrumentation. Co-produced and arranged in collaboration with Alan Keary (Shunya), the performance will also feature songs from Whitaker’s 2016 debut, The Man with the Anvil Hat, alongside a solo set by Shunya and special reworkings of select songs from the HENGE back catalogue.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T10:00:00+01:00\",\"sale_end_date\":\"2026-03-07T18:00:00+00:00\",\"sale_start_date\":\"2025-09-30T10:00:00+01:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bby23k-mother-vulture-album-launch-show-7th-mar-rough-trade-east-london-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"The Wave\",\"redirect_url\":\"https://open.spotify.com/track/1ucgU7eAodKiYVx4TKGFYs\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a1c0b4877c58fe864e975e97ca211c08909574eb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Wave\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":36022,\"title\":\"Is Rough Trade Nottingham wheelchair accessible?\",\"body\":\"Rough Trade Nottingham's venue is on the first floor. We are lift accessible if you want an alternative. Just speak to a member of Rough Trade staff or security upon arrival, we will show and help you access the space.\",\"order\":0},{\"id\":36023,\"title\":\"Can I arrange accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seatsn available for sold out events.\",\"order\":1},{\"id\":36032,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":2},{\"id\":36024,\"title\":\"How do I get a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":3},{\"id\":36025,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release. There is an hour between the door time and the stage time.\",\"order\":4},{\"id\":36026,\"title\":\"I can’t attend the show! Can I still get my record signed?\",\"body\":\"Yes! We will always aim to get all event orders signed. Although this sometimes depends on the artist's schedule. We keep event stock for 1 week before returning it to our warehouse. If you can’t pick it up within a week please contact the store of your event.\",\"order\":5},{\"id\":36027,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":6},{\"id\":36028,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":7},{\"id\":36029,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":8},{\"id\":36030,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":9},{\"id\":36031,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":10},{\"id\":49728,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":11},{\"id\":49729,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":12},{\"id\":49730,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":13},{\"id\":49731,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":14},{\"id\":49732,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":15},{\"id\":49733,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":16},{\"id\":49734,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":17},{\"id\":49735,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":18},{\"id\":49736,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":19},{\"id\":49737,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":20},{\"id\":49738,\"title\":\"I can’t attend the show! Can I still get my record signed?\",\"body\":\"Yes! We will always aim to get all event orders signed. Although this sometimes depends on the artist's schedule. We keep event stock for 1 week before returning it to our warehouse. If you can’t pick it up within a week please contact the store of your event.\",\"order\":21}],\"summary_lineup\":{\"top_artists