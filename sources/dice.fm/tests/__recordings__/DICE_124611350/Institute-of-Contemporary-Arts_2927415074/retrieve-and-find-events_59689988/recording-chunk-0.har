jowLCJldmVudF9pZCI6NTQ2NDA4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1Nzo1NS41NDU5MjdaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjMzOTgsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"public_refund_policy\":null,\"venues\":[{\"id\":\"14095\",\"name\":\"Rough Trade Denmark Street\",\"address\":\"24 Denmark Street, Camden, London, WC2H 8NJ, United Kingdom\",\"location\":{\"lat\":51.51547,\"lng\":-0.12933},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-denmark-street-oe2r5\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-17T19:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Courtney Marie Andrews\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-08-27/c8d402b3-61ba-4b41-9051-5533d3f1824f.jpg?rect=510%2C0%2C2005%2C2005\"},\"artist_id\":\"3915\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[{\"id\":69748,\"title\":\"Can I bring a camera?\",\"body\":\"Please note no professional cameras are allowed. Small cameras are fine but anything too big or with a detachable lense will be turned away as we are a small space.\",\"order\":0},{\"id\":69749,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":1},{\"id\":69750,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":2},{\"id\":69751,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 15-30 minutes, playing songs from the new release or a Q&A. Please note there is only 15min between the door time and the stage time.\",\"order\":3},{\"id\":69752,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":4},{\"id\":69753,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":69754,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":69755,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":7},{\"id\":69756,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":8}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/ee6df06f-6532-44a2-b8f6-85f84a788a8d.jpg?rect=1032%2C0%2C6192%2C6192\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/ee6df06f-6532-44a2-b8f6-85f84a788a8d.jpg?rect=0%2C619%2C8256%2C4954\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/ee6df06f-6532-44a2-b8f6-85f84a788a8d.jpg?rect=2425%2C0%2C3406%2C6192\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Courtney Marie Andrews - Little Picture of a Butterfly\",\"redirect_url\":\"https://open.spotify.com/track/2R2AITSPOZeKXwekNA46ug\",\"artist\":\"Courtney Marie Andrews\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8f4a8de9c8bdb729f53159fabaf1dd913cad7ba1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Little Picture of a Butterfly\"},{\"type\":\"apple_music\",\"title\":\"Courtney Marie Andrews - Little Picture of a Butterfly\",\"redirect_url\":\"https://music.apple.com/us/album/little-picture-of-a-butterfly/1841948802?i=1841949016&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Courtney Marie Andrews\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/f2/91/2c/f2912cbd-a661-b3d1-fbf7-b00071ee79b1/mzaf_15954047114478091449.plus.aac.p.m4a\",\"track_name\":\"Little Picture of a Butterfly\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768561200,\"max_tickets\":6,\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Rough Trade Denmark Street is very excited to present an acoustic performance and signing from Courtney Marie Andrews. This unique event celebrates the release of her new album 'Valentine' released via Loose Future.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade Denmark Street on the day of the show.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade Denmark Stree on the day of the show.\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":true,\"is_hidden_event\":false,\"presented_by\":\"Presented by Rough Trade.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:16\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Zb6c58f1b83a?dice_id=Zb6c58f1b83a\",\"post_competition_referral\":\"https://link.dice.fm/J1d183bc7bbf?dice_id=J1d183bc7bbf\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ccb35aa302d0?dice_id=Ccb35aa302d0\",\"post_purchase_referral\":\"https://link.dice.fm/Gf61b18b6dd2?dice_id=Gf61b18b6dd2\",\"post_reminder_referral\":\"https://link.dice.fm/Qd867fbe646a?dice_id=Qd867fbe646a\",\"post_waitinglist_referral\":\"https://link.dice.fm/O2b823bc68c0?dice_id=O2b823bc68c0\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T11:00:00+00:00\",\"sale_end_date\":\"2026-02-17T19:15:00+00:00\",\"sale_start_date\":\"2026-01-16T11:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:15:00+00:00\",\"event_end_date\":\"2026-02-17T20:45:00+00:00\",\"is_