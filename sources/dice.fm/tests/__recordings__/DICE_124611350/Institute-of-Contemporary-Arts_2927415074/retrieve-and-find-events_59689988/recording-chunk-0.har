\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"dka9a6-the-skinner-brothers-28th-may-scala-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1779993000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:15\",\"price\":{\"currency\":\"GBP\",\"amount\":3193,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/1f9356ed-3618-4e07-ae8c-0e0214d05e7e.jpg?rect=254%2C193%2C3033%2C3031\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/1f9356ed-3618-4e07-ae8c-0e0214d05e7e.jpg?rect=0%2C1428%2C3508%2C2105\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/1f9356ed-3618-4e07-ae8c-0e0214d05e7e.jpg?rect=390%2C0%2C2729%2C4961\"},\"id\":\"6929e5fec05f54000137d8cd\",\"name\":\"The Skinner Brothers\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"For over ten years The Skinner Brothers have been fighting to build this world from nothing. A fully independent band creating something real with no label and no machine behind it. And on this night the doors open into the SB universe for the first time in full.\\n\\nThis will be an immersive show where the entire venue becomes part of the experience. Fans who came to the last tour felt a taste of it. At Scala we are pulling out every stop and bringing the whole world of SB to life.!\\n\\nWe will be playing a full mix from across our entire catalogue. Old songs new songs deep cuts and the tunes that shaped every era. It is a night made for every SB fan on the planet and for anyone ready to step inside what we have built.\\n\\nThis is independent music presented at its highest level. Run by the band. Driven by the community. A celebration of everything we have survived and everything that comes next.\\n\\nStep into the world of SB.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-30T10:00:00+00:00\",\"sale_end_date\":\"2026-05-28T18:30:00+01:00\",\"sale_start_date\":\"2025-12-08T10:00:00+00:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Culture Non-Stop\",\"redirect_url\":\"https://open.spotify.com/track/5mAwMdHBj8wpRoqWYuwfBN\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/04585ddd49ef47eeee44d2615470a8dc5a222588?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Culture Non-Stop\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Biird\",\"image\":null,\"artist_id\":\"129940\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExOTY3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIzMTM3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTM5MDlaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6Mjc5MSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExOTY3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIzMTM3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTM5MjZaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6Mjc5MiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExOTY3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIzMTM3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTM5MzVaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6Mjc5MywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExOTY3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIzMTM3LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTM5NDRaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjI3OTQsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF