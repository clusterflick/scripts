_active\":false},\"announcement_date_unix\":1770681600,\"social_links\":{\"event_share\":\"https://link.dice.fm/R9a09b24e593?dice_id=R9a09b24e593\",\"post_competition_referral\":\"https://link.dice.fm/H8528dc1c2b5?dice_id=H8528dc1c2b5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/geeb7ec15a36?dice_id=geeb7ec15a36\",\"post_purchase_referral\":\"https://link.dice.fm/c8c3d98962a7?dice_id=c8c3d98962a7\",\"post_reminder_referral\":\"https://link.dice.fm/g220737c4a3a?dice_id=g220737c4a3a\",\"post_waitinglist_referral\":\"https://link.dice.fm/R3f15eada097?dice_id=R3f15eada097\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"xe6bbm-guns-2-roses-5th-apr-new-cross-inn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775408400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:72\",\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/2b85093c-0e67-4ceb-b1b7-519703afc8e9.jpg?rect=0%2C0%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/2b85093c-0e67-4ceb-b1b7-519703afc8e9.jpg?rect=0%2C384%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/2b85093c-0e67-4ceb-b1b7-519703afc8e9.jpg?rect=432%2C0%2C1056%2C1920\"},\"id\":\"698b1233059d0a0001230df9\",\"name\":\"Guns 2 Roses\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Guns 2 Roses\\n\\nThe most notorious Guns N Roses tribute in history, etc. 2002. The only GNR tribute to play live with 4 different members of Guns N Roses!\\n\\nhttps://www.facebook.com/gunsnrosestributebanduk/\\n\\nhttps://www.instagram.com/guns2rosesofficial/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T00:00:00+00:00\",\"sale_end_date\":\"2026-04-03T17:00:00+01:00\",\"sale_start_date\":\"2026-02-10T00:00:00+00:00\",\"event_start_date\":\"2026-04-05T18:00:00+01:00\",\"event_end_date\":\"2026-04-05T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"BLACK | LAKES\",\"image\":null,\"artist_id\":\"132950\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ghost Dance\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-26/c433a6e0-c3be-485a-89fa-8bf91d8a2792.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"71787\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Awakening\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb034848fb447bac3fe0173664\"},\"artist_id\":\"119193\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":true,\"donation\":null,\"presented_by\":\"Presented by The Underworld.\",\"tty_to_extras\":[{\"ticket_type_id\":1146968,\"extra_ids\":[\"1153252\"]}],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":64419,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":64420,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":64421,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-05T18:00:00+01:00\",\"doors_close_date\":\"2026-04-05T22:30:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"announcement_date_unix\":1765828800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Wff740f40137?dice_id=Wff740f40137\",\"post_competition_referral\":\"https://link.dice.fm/mef6dd895adc?dice_id=mef6dd895adc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/pf90056334a3?dice_id=pf90056334a3\",\"post_purchase_referral\":\"https://link.dice.fm/M3a34fe0c3b7?dice_id=M3a34fe0c3b7\",\"post_reminder_referral\":\"https://link.dice.fm/J6774f200ba1?dice_id=J6774f200ba1\",\"post_waitinglist_referral\":\"https://link.dice.fm/Yae6219573a6?dice_id=Yae6219573a6\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"k6nyno-the-awakening-5th-apr-the-underworld-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1775408400,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:73\",\"price\":{\"currency\":\"GBP\",\"amount\":2987,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/ea624ff1-1c55-4fc1-9ed9-587d0261e9f2.jpg?rect=404%2C0%2C1630%2C1630\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/ea624ff1-1c55-4fc1-9ed9-587d0261e9f2.jpg?rect=0%2C84%2C2437%2C1462\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/ea624ff1-1c55-4fc1-9ed9-587d0261e9f2.jpg?rect=770%2C0%2C897%2C1630\"},\"id\":\"6940646dd6697a000111d0c1\",\"name\":\"THE AWAKENING\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The Awakening is a dark musical project born in Johannesburg, South Africa, in the late ’90s as the creative expression of vocalist, multi-instrumentalist, author, actor and songwriter Ashton Nyte. The Awakening’s sound has morphed and mutated over the years, incorporating elements of Gothic Rock, Darkwave, Gothic Metal, Industrial Rock, Post-punk, Electronic, New Wave, Folk Noir and other theatrical meanderings.\\n\\nFrontman Ashton Nyte has released 8 solo albums and 2 books in addition to his work as The Awakening. He has contributed vocals and lyrics to several other projects, featuring members of The Cure, Peter Murphy, The Mission, Beauty In Chaos, and All About Eve, among others.\\n\\nNyte has written and performed in theatrical productions and hosted philanthropic events, including his Rock Against Rape concert series and presenting a lecture series at US universities focusing on tolerance and acceptance. He has had songs featured in major television shows like Pretty Little Liars: Original Sin (HBOMax), The Purge (USA Network), among others.\\n\\nMusic journalists have described Nyte as \\\"Johannesburg's Bowie\\\" for his widely varying musical styles and theatrical performance approach. With a catalogue of over 350 released original songs, Ashton Nyte and The Awakening have enjoyed airplay and chart success on major independent radio stations worldwide and have toured extensively and headlined music festivals in the USA, Europe, and South Africa to upwards of 30,000 people.\\n\\nThis is a 18+ event. / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T20:00:00+00:00\",\"sale_end_date\":\"2026-04-05T16:30:00+01:00\",\"sale_start_date\":\"2025-12-15T20:00:00+00:00\",\"event_start_date\":\"2026-04-05T18:00:00+01:00\",\"event_end_date\":\"2026-04-05T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Frenna\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0fabf87dd3f43dad9d2d7982\"},\"artist_id\":\"134108\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Live Nation\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0