",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-24T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/4d89cfa1-3021-4f7e-a8a9-236dd153d310.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/4d89cfa1-3021-4f7e-a8a9-236dd153d310.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/4d89cfa1-3021-4f7e-a8a9-236dd153d310.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Yf6d48532bdc?dice_id=Yf6d48532bdc\",\"post_competition_referral\":\"https://link.dice.fm/cf146370f8f7?dice_id=cf146370f8f7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h731a77e9876?dice_id=h731a77e9876\",\"post_purchase_referral\":\"https://link.dice.fm/y754443aa062?dice_id=y754443aa062\",\"post_reminder_referral\":\"https://link.dice.fm/R221401bf6d2?dice_id=R221401bf6d2\",\"post_waitinglist_referral\":\"https://link.dice.fm/K21743694a2d?dice_id=K21743694a2d\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:64\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771200000,\"id\":\"69938181c152b20001ab42f1\",\"name\":\"Solarzone\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"***Solarzone***\\n\\nOriginally formed in 1986, Solarzone are currently one of the most prominent 80’s covers bands on the circuit.\\n\\nKnown for their distinctive dark synth-pop with an edgy rock sound, they take well known 80’s classics and make them their own. With their trade-mark mash-ups and their own reimagining of iconic songs, Solarzone have created a truly unique, yet familiar soundtrack celebrating that legendary decade.\\n\\nAs a 5 piece, Solarzone’s gigs fuse live instruments with backing tracks that have been fully produced by the band. With rasping lead vocals that are both powerful and soulful, their sound is taken to a new level with their live silky 4-part harmonies.\\n\\nOn stage, Solarzone have an enviable reputation for being unapologetic crowd pleasers, and with their growing fan-base, anyone will tell you that their performances are an anthemic experience, not just a gig.\\n\\nSPOILER ALERT:\\n\\nSolarzone ARE NOT a traditional 80’s tribute band. Solarzone are nostalgia on steroids.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1792864800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2308,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-07T10:00:00+00:00\",\"sale_end_date\":\"2026-10-24T18:00:00+01:00\",\"sale_start_date\":\"2026-01-09T10:00:00+00:00\",\"event_start_date\":\"2026-10-24T19:00:00+01:00\",\"event_end_date\":\"2026-10-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"oegbmy-black-water-county-24th-oct-the-black-heart-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotif