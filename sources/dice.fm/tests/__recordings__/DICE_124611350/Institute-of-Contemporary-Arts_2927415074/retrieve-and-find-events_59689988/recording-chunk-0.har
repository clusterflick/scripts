},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":true,\"impression_id\":\"ab902a79f4685193:38\",\"about\":{\"description\":\"Barcelona’s Lia Kali is one of the most magnetic new voices in Spain’s urban music scene. Blending soul, reggae, rap and jazz, she transforms raw emotion into songs of power and healing.\\n\\nHer debut album Contra Todo Pronóstico has surpassed 40 million streams, earning multiple IAM RAP Awards including Best MC and Best Album, and a place in Mondo Sonoro’s Top 10 Albums of 2023. With more than five million monthly listeners and sold-out shows across Spain and Latin America, Lia Kali has become a bold new voice redefining Spain’s urban sound.\\n\\nCollaborating with some of the most exciting artists in the scene — including Duki, Rels B, Eladio Carrión, Kany García SFDK, Duki, and Nanpa Básico — she continues to push boundaries and bring her unmistakable energy to every project.\\n\\nPerforming for the first time at La linea Festival. Expect intensity, heart, and a performance that leaves its mark.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1763467200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lia Kali\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-11-25/1e3c57a4-58e9-469e-b5e6-ff6abfbacae4.jpg?rect=1%2C0%2C619%2C619\"},\"artist_id\":\"64712\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/12f724f6-c99f-4f4d-9ab7-523bde73f163.jpg?rect=0%2C317%2C2534%2C2534\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/12f724f6-c99f-4f4d-9ab7-523bde73f163.jpg?rect=0%2C824%2C2534%2C1520\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/12f724f6-c99f-4f4d-9ab7-523bde73f163.jpg?rect=396%2C0%2C1742%2C3167\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"691b31dcf508ae0001472731\",\"name\":\"Lia Kali\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-04-23T21:00:00+01:00\",\"sale_start_date\":\"2025-11-19T12:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:30:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,