32b8f?dice_id=B6f85d032b8f\",\"post_purchase_referral\":\"https://link.dice.fm/Rc78debe7930?dice_id=Rc78debe7930\",\"post_reminder_referral\":\"https://link.dice.fm/Lee3b549b8bf?dice_id=Lee3b549b8bf\",\"post_waitinglist_referral\":\"https://link.dice.fm/M451c4641c28?dice_id=M451c4641c28\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":469,\"name\":\"Number 90 London\",\"privacy_policy_link\":\"https://number90bar.co.uk/privacy-policy/\",\"fb_pixel_id\":\"795025754901092\",\"ga_tracking_id\":\"UA-107908506-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:40\",\"properties\":[],\"presented_by\":\"Presented by Number 90 London\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768816800,\"id\":\"696df3dfd704a60001bf5b98\",\"name\":\"Plants Can Dance\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"An Ambient Deep Listening Concert\\n\\nStep into a slow, immersive sound world where attention softens and listening deepens.\\n\\nPlants Can Dance and Mushrooms Sing invites you to an ambient concert rooted in stillness, texture, and quiet transformation.\\n\\nFeaturing Li Yilei and Brian d’Souza, this special gathering also marks the launch of Sunflowers, Brian d’Souza’s new album, released on Music To Watch Seeds Grow By.\\n\\nLet the afternoon unfold gently — sound as environment, music as atmosphere.\\n\\nSunday 22nd February\\n\\n4:00 PM\\n\\nHideout\\n\\n92 Wallis Rd, London E9 5LN, UK\\n\\nCome, listen deeply, and let time slow.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing