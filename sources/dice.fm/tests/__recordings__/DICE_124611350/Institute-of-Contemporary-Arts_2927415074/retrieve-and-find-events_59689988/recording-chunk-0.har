-b09e31b6e01d.jpg?rect=0%2C157%2C850%2C510\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/9e40de36-cd44-4726-a880-b09e31b6e01d.jpg?rect=199%2C0%2C453%2C824\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/T53e267ba4ba?dice_id=T53e267ba4ba\",\"post_competition_referral\":\"https://link.dice.fm/V1f9e10b4e64?dice_id=V1f9e10b4e64\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V84b44043d41?dice_id=V84b44043d41\",\"post_purchase_referral\":\"https://link.dice.fm/oa9317585772?dice_id=oa9317585772\",\"post_reminder_referral\":\"https://link.dice.fm/xcdfb9e77e30?dice_id=xcdfb9e77e30\",\"post_waitinglist_referral\":\"https://link.dice.fm/G79d4a10734c?dice_id=G79d4a10734c\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:31\",\"properties\":[],\"presented_by\":\"Presented by 229.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770026400,\"id\":\"6978e273140e9c00012f3324\",\"name\":\"The Rezillos\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"The Rezillos are a punk/new wave band formed in Edinburgh, Scotland, in 1976. Their independent debut single, 'I Can't Stand My Baby' shot them to underground fame initially via airings on the radio show of BBC Radio 1's John Peel.\\n\\nTheir follow up classic singles 'My Baby Does Good Sculptures', 'Top of the Pops' and 'Destination Venus' signalled critically acclaimed milestones for the band.\\n\\nThe Rezillos recorded their landmark album 'Can't Stand the Rezillos' in New York's fabled Power Station studio, immersed themselves in the local music scene and dropped in during downtime to play a gig at CBGB's, the hub of Punk Rock music. The album reached the top 10 in the UK album chart and is lauded as a punk classic.\\n\\nAn AGMP Concerts presentation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"date_unix\":1791655200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3966,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T14:00:00+00:00\",\"sale_end_date\":\"2026-10-09T15:00:00+01:00\",\"sale_start_date\":\"2025-11-21T10:00:00+00:00\",\"event_start_date\":\"2026-10-10T19:00:00+01:00\",\"event_end_date\":\"2026-10-10T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eow99d-robyn-hitchcock-10th-oct-union-chapel-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Robyn Hitchcock - The Ghost in You\",\"redirect_url\":\"https://open.spotify.com/track/5Tbx1OpKwSWSeKlcE2WA0T\",\"artist\":\"Robyn Hitchcock\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6f65099137021892ab7ef40b48e316a3725f178f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Ghost in You\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Robyn Hitchcock\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb196c112d21673241ef88bc97\"},\"artist_id\":\"6355\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-10T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-13/fb4469d6-0004-4714-beab-c32cd7a1cbfe.jpg?rect=0%2C41%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-13/fb4469d6-0004-4714-beab-c32cd7a1cbfe.jpg?rect=0%2C201%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-13/fb4469d6-0004-4714-beab-c32cd7a1cbfe.jpg?rect=158%2C0%2C485%2C881\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/xe53535e941b?dice_id=xe53535e941b\",\"post_competition_referral\":\"https://link.dice.fm/I2aaff870185?dice_id=I2aaff870185\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ob4e9634e995?dice_id=ob4e9634e995\",\"post_purchase_referral\":\"https://link.dice.fm/U991e45bb2d2?dice_id=U991e45bb2d2\",\"post_reminder_referral\":\"https://link.dice.fm/Z192649b4873?dice_id=Z192649b4873\",\"post_waitinglist_referral\":\"https://link.dice.fm/f404efd6cf61?dice_id=f404efd6cf61\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:32\",\"properties\":[],\"presented_by\":\"Presented by DHP FAMILY.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763474400,\"id\":\"691a2b0f38c37f0001f06092\",\"name\":\"Robyn Hitchcock\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"DHP Presents :\\n\\nROBYN HITCHCOCK\\n\\nWith a career now spanning six decades, Robyn Hitchcock remains a truly one - of - a - kind artist – surrealist rock ‘n’ roller, iconic troubadour, guitarist, poet, painter, and performer. An unparalleled, deeply individualistic songwriter and stylist, Hitchcock has traversed many genres with humor, intelligence and origina lity over 30 albums and seemingly infinite live performances. From The Soft Boys’ proto - psych - punk and The Egyptians’ Dadaist pop to solo masterpieces like 1984’s milestone I Often Dream of Trains and 1990’s Eye , Hitchcock has crafted a strikingly origin al oeuvre rife with sagacious observation, astringent wit, recurring marine life, mechanized rail services, cheese, Clint Eastwood, and innumerable finely drawn characters, real and imagined.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"date_unix\":1791655200,\"event_tag\":null}],\"title\":\"Sat 10 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":4485,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T00:00:00+00:00\",\"sale_end_date\":\"2026-10-11T18:00:00+01:00\",\"sale_start_date\":\"2026-01-23T00:00:00+00:00\",\"event_start_date\":\"2026-10-11T19:00:00+01:00\",\"event_end_date\":\"2026-10-11T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"537l9d-jimmy-sax-live-in-london-11th-oct-o2-shepherds-bush-empire-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":71638,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jimmy Sax\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb9b912cfc5454e0003e103b18\"},\"artist_id\":\"65588\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"of