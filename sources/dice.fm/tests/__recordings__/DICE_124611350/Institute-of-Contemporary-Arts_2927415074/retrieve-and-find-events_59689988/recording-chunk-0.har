/c69980eafe3d?dice_id=c69980eafe3d\",\"post_reminder_referral\":\"https://link.dice.fm/jceb079e058d?dice_id=jceb079e058d\",\"post_waitinglist_referral\":\"https://link.dice.fm/cc9377575926?dice_id=cc9377575926\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:68\",\"properties\":[],\"presented_by\":\"Presented by RnBX London\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768176900,\"id\":\"696502e3cf484800012f0d1a\",\"name\":\"RnBX London x Lovers Rock UK - R&B Club Night\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"RnBX x Lovers Rock UK\\n\\nAbout the Event\\n\\nRnBX proudly joins forces with Lovers Rock UK to bring you a smooth, grown, and soulful club night experience in the heart of London. This special collaboration blends the timeless sounds of sensational R&B, Lovers Rock and Reggae classicsand , creating the perfect soundtrack for an unforgettable night out.\\n\\nSet inside The Camden, this event is designed for music lovers who appreciate quality vibes, real energy, and a mature crowd. Whether you’re coming to dance, vibe, or simply enjoy great music with great people, expect an atmosphere filled with rhythm, romance, and feel-good energy from start to finish.\\n\\nThis is more than just a party it’s a celebration of culture, connection, and music that brings people together on the dancefloor.\\n\\nDate: Saturday 7th March 2026\\n\\nTime: 10:00 PM – 4:00 AM\\n\\nLast Entry: 1:00 AM (strictly no entry after this time)\\n\\nVenue: The Camden, 65 Crowndale Rd, London NW1 1TN\\n\\nMusic Policy\\n\\nOn the night, our DJs will be delivering a seamless blend of:\\n\\n\\\\- Timeless R&B slow jams and anthems\\n\\n\\\\- Lovers Rock classics\\n\\n\\\\- Old school & new school R&B and Reggae\\n\\n\\\\- Dancefloor favourites to keep the energy flowing all night\\n\\nA carefully curated mix of nostalgic hits and modern favourites, guaranteed to keep you moving well into the early hours.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 21+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2249\",\"name\":\"VIBE LDN\",\"image\":{\"url\":null},\"perm_name\":\"vibe-ldn-a6xq\",\"profile_active\":false},\"date_unix\":1772920800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1760},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-01-20T10:00:00+00:00\",\"sale_end_date\":\"2026-03-08T01:00:00+00:00\",\"sale_start_date\":\"2025-09-17T12:30:00+01:00\",\"event_start_date\":\"2026-03-07T22:00:00+00:00\",\"event_end_date\":\"2026-03-08T04:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"xe7gql-lovers-rock-uk-x-rnbx-7th-mar-the-camden-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://music.apple.com/us/album/here-i-come/309122317?i=309122381&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/9b/df/c2/9bdfc21c-1bc2-08eb-7aa2-913bbedbaffc/mzaf_11117592686509478017.plus.aac.p.m4a\",\"track_name\":\"Here I Come\"},{\"type\":\"spotify\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://open.spotify.com/track/0LSHXCQswjJre98L53YrOH\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a6eab2cfaedb80e809496819dff1928332c442b2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Here I Come\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\