,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-23T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"London-based electronic krautrock/dance band The French Laundry play their first headline show at The Shacklewell Arms, with support from Orlanda and Jake Grandorge!\\n\\nExploiting a dishevelled clutter of tools including a synthesiser, oboe, drum machine, and several guitars, the Laundry have spent the last few months perfecting a set of drone-based dance tracks that hold an outlying place somewhere in between 2000’s club and 70’s psychedelia.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:47\",\"billing_promoter\":{\"id\":\"245\",\"name\":\"LNZRT\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-12/1814e171-32d9-4237-848d-85f91f0af396.jpg\"},\"perm_name\":\"lnzrt-jeed\",\"profile_active\":true},\"presented_by\":\"Presented by MDST.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The French Laundry\",\"image\":null,\"artist_id\":\"128588\",\"about\":null,\"is_headliner\":false},{\"name\":\"Orlanda\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebfe4fd9a26319