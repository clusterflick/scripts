:true},\"seats_io_event_id\":null,\"perm_name\":\"av3dwx-echo-wave-sessions-live-for-charity-28th-feb-bold-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772305200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:82\",\"venues\":[{\"id\":\"16134\",\"name\":\"Bold\",\"address\":\"126 Dartmouth Park Hill, Islington, London, N19 5HH, United Kingdom\",\"location\":{\"lat\":51.569066,\"lng\":-0.142419},\"image\":null,\"city\":{\"id\":\"67a4f245752bf63d0be1e422\",\"name\":\"Archway\",\"location\":{\"lat\":51.564906,\"lng\":-0.142079,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"bold-8em3w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Osian \",\"image\":null,\"artist_id\":\"40304\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":4},\"about\":{\"description\":\"Echo Wave Sessions — the charity event series run by Real Sounds — is putting on a fundraising gig in London to support Young Sounds UK. Every ticket purchased helps young musicians from low-income families access music and overcome financial and social barriers.\\n\\n***Weekday Social -*** A little loud, a little soft, nostalgic and introspective. London based three-piece of three non-Londoners: Louise on lead vocals and guitar, Gavin on backing vocals and bass, Ben on drums.\\n\\n***Osian -*** North London born and raised, Alternative pop fused with Rnb colours to create an energetic and soulful set performed by a talented and experienced band\\n\\n**Cafe House** \\\\- are an alternative band based in South London. Offsetting the rough, patchwork songwriting against the smooth, jazz infused rhythm section to create a swinging, soulful dislocation of guitar music.\\n\\n***Modem. -*** Modem is a self-recorded compilation of musings and meanderings, originating in Leeds but now treading the streets of London, UK.\\n\\n***dontcallmestacey*** - is a new indie artist who is still discovering their 'sound'. they write with heart and honesty and have a smooth voice with raw edges. as they are discovering who they are as an artist, they sing songs that they enjoy and hope that others will enjoy and connect with the music too.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T11:00:00+00:00\",\"sale_end_date\":\"2026-02-28T21:00:00+00:00\",\"sale_start_date\":\"2026-01-13T11:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696531d3875e550001b087f8\",\"name\":\"Echo Wave Sessions: Live For Charity\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/9c850ebd-2d5f-45f1-9b54-e19b510cee5d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/9c850ebd-2d5f-45f1-9b54-e19b510cee5d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/9c850ebd-2d5f-45f1-9b54-e19b510cee5d.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768302000,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Pb8aec187ebe?dice_id=Pb8aec187ebe\",\"post_competition_referral\":\"https://link.dice.fm/j55bd23037a3?dice_id=j55bd23037a3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a169369fd4bd?dice_id=a169369fd4bd\",\"post_purchase_referral\":\"https://link.dice.fm/Tfe534ed2938?dice_id=Tfe534ed2938\",\"post_reminder_referral\":\"https://link.dice.fm/Sdb00d9e630a?dice_id=Sdb00d9e630a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cb5fdf658df9?dice_id=Cb5fdf658df9\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1906},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Rough Trade.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":67543,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":67544,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":67545,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":67546,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":67547,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":67548,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":67549,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":67550,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":67551,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":67552,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"oego7m-mammal-hands-live-signing-28th-feb-rough-trade-east-london-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1772305200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:83\",\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mammal Hands\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-07/c3d8086f-bf58-4930-b9e1-2902d9da4dba.jpg?rect=1000%2C0%2C4000%2C4000\"},\"artist_id\":\"2654\",\"about\":{\"description\":\"Carving their atmospheric sound out of long jam sessions, Mammal Hands’ ambient jazz combines piano melodies, globally-influenced drums and saxophone. Based in Norwich, the trio won praise from Mojo and Loud and Quiet for 2020’s Captured Spirits. They’ve since supported fellow instrumental ensemble GoGo Penguin on tour, and played the Montreal Jazz Festival.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Rough Trade East is very excited to present an in-store live performance and signing from Mammal Hands. This unique event celebrates the release of their new album 'Circadia' released via Act Music.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/mammal-hands/circadia\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T15:00:00+00:00\",\"sale_end_date\":\"2026-02-28T21:00:00+00:00\",\"sale_start_date\":\"2026-01-14T15:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"695e74cf8a3cee00010191e6\",\"name\":\"Mammal Hands: Live + Signing\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/284e4f6d-9f39-4e63-80bb-4ba4cf571dc9.jpg?rect=1000%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/284e4f6d-9f39-4e63-80bb-4ba4cf571dc9.jpg?rect=0%2C200%2C6000%2C3600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/284e4f6d-9f39-4e63-80bb-4ba4cf571dc9.jpg?rect=1900%2C0%2C2200%2C4000\"},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pi