ndary_status\":null,\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room\",\"privacy_policy_link\":\"https://91livingroom.com/homepage/privacy-policy/\",\"fb_pixel_id\":\"580346810496200\",\"ga_tracking_id\":\"302117538\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:30\",\"properties\":[],\"presented_by\":\"Presented by Ninety One Living Room.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1745449200,\"id\":\"6984cf8d56c5300001b0d0f6\",\"name\":\"Jazz on the Lane: Jemima Whyte\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"We're excited to introduce our new Sunday series, Jazz on the Lane, featuring a rotating line up of collectives and trios every week from London's thriving jazz scene, in the heart of Brick Lane.\\n\\nJoin us as we bring the community together through incredible music & banging drinks.\\n\\nThis Sunday, we welcome saxophonist, vocalist and composer Jemima Whyte to the stage.\\n\\nABOUT JEMIMA WHYTE\\n\\nJemima Whyte is the newest alto saxophonist, vocalist and composer beginning to excite jazz audiences in venues across London. With roots in the north, her style has been heavily shaped by the vibrant dance culture and afrobeat scenes in Leeds at venues including The Old Red Bus Station and Hifi Club, and her distinctive sound and dynamic improvisation drawing from contemporary alto masters like Kenny Garrett.\\n\\nBacked by a 7-piece powerhouse band including an all-female horn frontline, Jemima’s compositions blend energising grooves with rich horn lines, whilst incorporating her love for old school breaks and intimate gospel interludes.\\n\\nThis is an 18+ event, physical & scannable ID required for entry.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10115\",\"name\":\"Ninety One\",\"image\":{\"url\":null},\"perm_name\":\"ninety-one-m75r\",\"profile_active\":true},\"date_unix\":1772388000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":770,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T00:00:00+00:00\",\"sale_end_date\":\"2026-02-27T17:00:00+00:00\",\"sale_start_date\":\"2026-01-30T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T18:00:00+00:00\",\"event_end_date\":\"2026-03-01T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5dvg5-scouts-1st-mar-new-cross-inn-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Scouts\",\"image\":null,\"artist_id\":\"133337\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0