:{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-04/d7415567-8930-47cd-a1db-77c8b4de8a00.jpg?rect=0%2C500%2C2001%2C2001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-04/d7415567-8930-47cd-a1db-77c8b4de8a00.jpg?rect=0%2C900%2C2001%2C1201\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-04/d7415567-8930-47cd-a1db-77c8b4de8a00.jpg?rect=176%2C0%2C1650%2C3000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/n19853377f3e?dice_id=n19853377f3e\",\"post_competition_referral\":\"https://link.dice.fm/S8c5d4fae254?dice_id=S8c5d4fae254\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e963c03e568a?dice_id=e963c03e568a\",\"post_purchase_referral\":\"https://link.dice.fm/Bbbc9c5af451?dice_id=Bbbc9c5af451\",\"post_waitinglist_referral\":\"https://link.dice.fm/g5820ca7a988?dice_id=g5820ca7a988\",\"post_reminder_referral\":\"https://link.dice.fm/S5a93115f281?dice_id=S5a93115f281\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"101\",\"name\":\"Dingwalls\",\"address\":\"Middle Yard, Camden Lock, London NW1 8AB\",\"location\":{\"lat\":51.5414979,\"lng\":-0.145865500000014},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dingwalls-jan2\",\"accessibility\":{\"url\":\"https://dingwalls.com/info/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Vincen García is a Spanish bassist from Valencia, acclaimed as one of the most prestigious figures in the modern jazz and funk scene worldwide. He has over 14 years of professional experience, having developed a distinctive, modern sound marked by energetic and gritty execution.\\n\\nBorn into a musical family—his mother a vocalist and his father a trumpeter—Vincen was introduced to performance and touring at an early age. He began playing bass in his high school band and developed his craft entirely as a self-taught musician.\\n\\nVincen is among the most listened-to bassists globally in terms of streaming, amassing hundreds of thousands of followers and millions of views and reactions. Additionally, he has been one of the most impactful artists in the genre, performing at festivals such as the Montreux Jazz Festival (Switzerland), the North Sea Jazz Festival (Netherlands), or the Pori Jazz Festival (Finland).\\n\\nHis first album, titled\\\\*Ventura\\\\*, is received an overwhelmingly positive reception in cities around the world. Vincen García also collaborates on tours with international artists like Cory Wong and Jesús Molina. The artist will present his second album in 2026 with a world tour that will span every continent. With all of this, he has become one of the most important and influential Spanish artists on an international level.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:88\",\"billing_promoter\":{\"id\":\"264\",\"name\":\"Band on the Wall\",\"image\":{\"url\":null},\"perm_name\":\"band-on-the-wall-jy72\",\"profile_active\":false},\"presented_by\":\"Presented by Band on the Wall.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vincen García\",\"image\":null,\"artist_id\":\"117224\",\"about\":null,\"is_headliner\