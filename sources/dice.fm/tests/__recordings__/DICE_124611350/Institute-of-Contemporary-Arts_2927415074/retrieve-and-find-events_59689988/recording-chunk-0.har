0ca8c?dice_id=I8b7dff0ca8c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Wdf189e5fb52?dice_id=Wdf189e5fb52\",\"post_purchase_referral\":\"https://link.dice.fm/Kb5484d4eb4c?dice_id=Kb5484d4eb4c\",\"post_reminder_referral\":\"https://link.dice.fm/h811ece27051?dice_id=h811ece27051\",\"post_waitinglist_referral\":\"https://link.dice.fm/F564a930705d?dice_id=F564a930705d\"},\"perm_name\":\"ry9xa5-cristobal-pesce-10th-jul-e1-london-tickets\",\"secondary_status\":\"rescheduled\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/b7859bde-fcc0-40ad-854d-f850bceae22d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/b7859bde-fcc0-40ad-854d-f850bceae22d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/b7859bde-fcc0-40ad-854d-f850bceae22d.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"This July, Cristobal Pesce returns to E1 on the 10th July following three sold-out chapters that left the room wrung out and asking for more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698ca9968e03fb0001549388\",\"name\":\"Cristobal Pesce\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cristobal Pesce\",\"image\":null,\"artist_id\":\"120599\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Fri 10 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-16T12:00:00+01:00\",\"sale_end_date\":\"2026-07-11T21:00:00+01:00\",\"sale_start_date\":\"2026-01-29T12:00:00+00:00\",\"event_start_date\":\"2026-07-11T13:00:00+01:00\",\"event_end_date\":\"2026-07-11T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":true,\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":17882,\"title\":\"Where I can find more information about accessibility at Kaleidoscope Festival?\",\"body\":\"Head here to find out more: https://kaleidoscope-festival.com/info/accessibility/\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23128,\"title\":\"Where do I enter the festival site?\",\"body\":\"We have only one entrance, located on the east side of the Palace next to our East Court car park. Avoid arriving via the west/Muswell Hill side of the venue, as this route includes a significant detour around the event site.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":23129,\"title\":\"How do I access the VIP area?\",\"body\":\"If you have booked a VIP upgrade, enter the festival and head straight to the Phoenix Bar & Pizzeria on the Terrace. Once there, you will be checked into the VIP area, which opens at the same time as doors, and closes at 9.30pm.\\n\\nContact our Visitor Services Team on visitor.services@alexandrapalace.com or 020 8365 4343 if you have any questions.\",\"order\":6},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7},{\"id\":30527,\"title\":\"What does the Kaleidoscope Festival VIP upgrade include? \",\"body\":\"Exclusive access to the indoor Phoenix Bar & Pizzeria throughout the Festival\\n\\nPrivate bar and terrace with seating overlooking the Cloud 10 stage\\n\\nUse of the Phoenix Bar & Pizzeria to order food and drinks\\n\\nDedicated toilets\\n\\nTo book select VIP Upgrade when purchasing a ticket on the DICE app.\\n\\n\\\\* Please note this is an upgrade package only; a ticket for general admission must be purchased separately\\n\\nT&Cs:\\n\\nEach person with an upgrade must also have a valid general admission ticket to enter the event.\\n\\nYou will not be able to attend with just an upgrade ticket.\\n\\nKindly be advised you are responsible for paying for any additional beverages and snacks.\\n\\nThere is not a separate standing area for hospitality ticket holders.\\n\\nThe hospitality area is not stage-facing, you will need to access the main arena to watch the show.\\n\\nAny seating is subject to availability.\\n\\nSubject to booking fees.\",\"order\":9}],\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[{\"ticket_type_id\":1009701,\"extra_ids\":[\"1013447\",\"1198904\",\"1013448\",\"1013446\",\"1013445\"]},{\"ticket_type_id\":1014642,\"extra_ids\":[\"1013447\",\"1013448\",\"1013446\",\"1013445\"]},{\"ticket_type_id\":1009703,\"extra_ids\":[\"1013447\",\"1013448\",\"1013446\",\"1013445\"]