\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"electric-ballroom-j78v\",\"accessibility\":{\"url\":\"http://electricballroom.co.uk/disabled-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-28T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Caifanes\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3f58860477b33dfae15b16e0\"},\"artist_id\":\"130257\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":73651,\"title\":\"Venue Accessibility Information\",\"body\":\"If you have accessibility requirements and wish to attend a show, please head to our Disabled Access page (https://electricballroom.co.uk/disabled-access/) first for all relevant information regarding how to buy an accessible ticket (linked on the individual event), then contact us prior to the show – admin@electricballroom.co.uk. – so that we can ensure we can provide you with all necessary requirements.\",\"order\":0},{\"id\":73652,\"title\":\"Age Restrictions\",\"body\":\"Strict 14+ policy, therefore no one under 14 will be admitted.\\n\\n14 can be admitted. 14 and 15-year olds MUST be accompanied by an 18+ adult whilst in venue.\\n\\n16 and over do not need to be accompanied by an adult.\\n\\nAttendees may be required to show valid ID. For this reason, we advise everyone to bring valid physical photo ID. This means no matter how old you are, you may be asked to present a valid ID. Any ticket holder unable to present valid physical ID on request will not be admitted and will not be eligible for a refund.\",\"order\":1}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-14/d6c51589-6cab-417a-8e76-2ef72ddb09a9.jpg?rect=617%2C0%2C2453%2C2453\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-14/d6c51589-6cab-417a-8e76-2ef72ddb09a9.jpg?rect=0%2C121%2C3686%2C2212\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-14/d6c51589-6cab-417a-8e76-2ef72ddb09a9.jpg?rect=1169%2C0%2C1349%2C2453\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Caifanes - Afuera\",\"redirect_url\":\"https://open.spotify.com/track/3pJfnBjO3kjudEchcPEDxS\",\"artist\":\"Caifanes\",\"preview_url\":\"https://p.scdn.co/mp3-preview/591162fa56209fa874c6dd5b22711423ec1220b9?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Afuera\"},{\"type\":\"apple_music\",\"title\":\"Caifanes - Afuera\",\"redirect_url\":\"https://music.apple.com/us/album/afuera/205385037?i=205385055&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Caifanes\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/42/c8/62/42c86224-f0d4-0162-b9af-1dde1a8da021/mzaf_6866673339347491186.plus.aac.p.m4a\",\"track_name\":\"Afuera\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1763467200,\"max_tickets\":6,\"marketeers\":[{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"La Linea Festival presents Caifanes at Electric Ballroom\\n\\nFormed in Mexico City in 1987, Caifanes are one of the most iconic and influential bands in Latin rock history. Blending post-punk, new wave, and traditional Mexican sounds, they helped define the rock en español movement and inspired a generation across Latin America and beyond.\\n\\nFrom the first notes of La Negra Tomasa to the soaring power of Afuera and Viento, their music is raw, emotional and instantly recognisable. On stage, Caifanes deliver with the intensity and spirit that have made them one of Latin America’s most beloved live acts.\\n\\nThis is a rare chance to see Caifanes in an intimate London venue. Expect a night of passion, nostalgia and songs that will stay with you long after the lights go down.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event (under 16's must be accompanied by an adult 18+)\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by La Linea Festival.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:45\",\"social_links\":{\"event_share\":\"https://link.dice.fm/lbcc0d13ef86?dice_id=lbcc0d13ef86\",\"post_competition_referral\":\"https://link.dice.fm/t0e36bdfea97?dice_id=t0e36bdfea97\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l7ddb69719bb?dice_id=l7ddb69719bb\",\"post_purchase_referral\":\"https://link.dice.fm/qba9eba89d60?dice_id=qba9eba89d60\",\"post_reminder_referral\":\"https://link.dice.fm/C31dfef1e690?dice_id=C31dfef1e690\",\"post_waitinglist_referral\":\"https://link.dice.fm/kf657435634a?dice_id=kf657435634a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T12:00:00+00:00\",\"sale_end_date\":\"2026-04-28T17:00:00+01:00\",\"sale_start_date\":\"2025-11-19T12:00:00+00:00\",\"event_start_date\":\"2026-04-28T19:00:00+01:00\",\"event_end_date\":\"2026-04-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3750,\"sales_tax\":0,\"amount_from