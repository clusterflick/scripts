":null,\"billing_promoter\":{\"id\":\"2368\",\"name\":\"Night Tales Loft\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/6e6ef849-1334-49eb-a7bd-a888e14902a0.jpg\"},\"perm_name\":\"night-tales-loft-dvlq\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:61\",\"date_unix\":1778004000,\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/q0965283ca1b?dice_id=q0965283ca1b\",\"post_competition_referral\":\"https://link.dice.fm/i696014d8f97?dice_id=i696014d8f97\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ib700aa13827?dice_id=ib700aa13827\",\"post_purchase_referral\":\"https://link.dice.fm/Ba86caffe8d2?dice_id=Ba86caffe8d2\",\"post_reminder_referral\":\"https://link.dice.fm/P5c38610ccb9?dice_id=P5c38610ccb9\",\"post_waitinglist_referral\":\"https://link.dice.fm/pf994aad322d?dice_id=pf994aad322d\"},\"perm_name\":\"537688--playback-mac-miller-candlelit-listening-5th-may-night-tales-loft-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/a1446848-2384-4eb4-b6e2-f6ad84253a5f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/a1446848-2384-4eb4-b6e2-f6ad84253a5f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/a1446848-2384-4eb4-b6e2-f6ad84253a5f.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"**Presented by Johnnie Walker Black Label x NT’s Loft**\\n\\nWow, due to the popularity of our first two Playback: Mac Miller events, a third special date has now been added. Playback is a candlelit listening session series, where over 200 candles transform the space into a warm, intimate haven. We gather to honour the timeless sounds of iconic artists – a night to listen, connect, and take it all in.\\n\\n**We again celebrate the legacy of Mac Miller a curated journey through his most soulful, playful, and poignant works.** From laid-back classics to introspective gems, we revisit the music that cemented him as one of hip-hop’s most beloved voices, all powered through Funktion-One in a glowing candlelit setting.\\n\\nJohnnie Walker Black Label returns to elevate the evening, with signature serves available at the bar throughout the night. **Guests arriving before 8pm will receive a complimentary drink to begin the evening in style (Limited to First 50 Customers).**\\n\\nPlease note: This is a listening session only. Mac Miller will not perform live.\\n\\n—\\n\\nTickets\\n\\nReserved seating ticket holders must arrive by 20:00. Seating is first come, first served. Ticket does not guarantee seating will be available.\\n\\n—\\n\\nSchedule\\n\\n7:00PM – Doors & Playlist\\n\\n8:15PM – Listening Session Begins (90 mins)\\n\\nLimited capacity. Arrive early, stay late.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event. Bring your ID card with you. ID Scanner in place. \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69778b0b239e65000132e24a\",\"name\":\" Playback: Mac Miller [Candlelit Listening]\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Mac Miller - Circles\",\"redirect_url\":\"https://music.apple.com/us/album/circles/1494022962?i=1494022963&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mac Miller\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/33/93/68/33936818-38fd-4884-a264-3992a10621d7/mzaf_12372756666047929169.plus.aac.p.m4a\",\"track_name\":\"Circles\"},{\"type\":\"spotify\",\"title\":\"Mac Miller - Circles\",\"redirect_url\":\"https://open.spotify.com/track/4jXl6VtkFFKIt3ycUQc5LT\",\"artist\":\"Mac Miller\",\"preview_url\":\"https://p.s