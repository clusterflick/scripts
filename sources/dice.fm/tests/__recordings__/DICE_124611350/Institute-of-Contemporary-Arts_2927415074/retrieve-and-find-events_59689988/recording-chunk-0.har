rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/gb43b8e0aa58?dice_id=gb43b8e0aa58\",\"post_competition_referral\":\"https://link.dice.fm/kad875a5ea9c?dice_id=kad875a5ea9c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ue1a087f1491?dice_id=Ue1a087f1491\",\"post_purchase_referral\":\"https://link.dice.fm/Bd9b89bbced1?dice_id=Bd9b89bbced1\",\"post_reminder_referral\":\"https://link.dice.fm/q314a83bb976?dice_id=q314a83bb976\",\"post_waitinglist_referral\":\"https://link.dice.fm/x709993154ab?dice_id=x709993154ab\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:28\",\"properties\":[],\"presented_by\":\"Presented by 100 Club.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766503800,\"id\":\"694ac2821d72490001c11f95\",\"name\":\"Gürl\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"This is club metal. This is androgyny. This is a sugar rush.\\n\\nMaking their 100 Club debut, Gürl return to London, bringing their unique pounding club metal to the legendary music venue.\\n\\n\\\"It's like Charlie xcx meets Bring Me The Horizon. Four-to-the-floor, c\\\\*nty pop metal\\\".\\n\\nFollowing their UK tour with Mallory Knox, Gürl's amassed an army of 4am trauma dump emos who love Addison Rae as much as Deftones, wear Gucci in the mosh pit, and who's handbag contents are frankly unhinged. Expect a metal rave like no other, in London's most iconic venue.\\n\\nFFO Bring Me The Horizon, Frost Children, Julia Wolf, Nova Twins, Bad Omens\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"7103\",\"name\":\"100 Club\",\"image\":{\"url\":null},\"perm_name\":\"100-club-lnlp\",\"profile_active\":true},\"date_unix\":1791570600,\"event_tag\":null}],\"title\":\"Fri 09 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T12:00:00+00:00\",\"sale_end_date\":\"2026-10-10T18:30:00+01:00\",\"sale_start_date\":\"2026-02-17T10:00:00+00:00\",\"event_start_date\":\"2026-10-10T18:30:00+01:00\",\"event_end_date\":\"2026-10-10T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"xe6rqe-myles-sanko-10th-oct-the-jazz-cafe-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":76456,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Myles Sanko\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb575c7176d63c66a836f78995\"},\"artist_id\":\"133951\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":20,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-10T18:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/3710001b-135b-41e0-8500-74d53487a8e0.jpg?rect=0%2C229%2C987%2C986\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/3710001b-135b-41e0-8500-74d53487a8e0.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/3710001b-135b-41e0-8500-74d53487a8e0.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/r7f3198f2cba?dice_id=r7f3198f2cba\",\"post_competition_referral\":\"https://link.dice.fm/Zea9583c5296?dice_id=Zea9583c5296\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d19727ed1c83?dice_id=d19727ed1c83\",\"post_purchase_referral\":\"https://link.dice.fm/fd26ca3a1383?dice_id=fd26ca3a1383\",\"post_reminder_referral\":\"https://link.dice.fm/l212c2a3cf9a?dice_id=l212c2a3cf9a\",\"post_waitinglist_referral\":\"https://link.dice.fm/p175fb14f81f?dice_id=p175fb14f81f\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:29\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770984000,\"id\":\"698db94e1b84b10001f2dd4a\",\"name\":\"Myles Sanko\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Internationally-acclaimed UK artist Myles Sanko delivers a live show that fuses jazz, soul, and hip-hop with the rhythmic influences of his Ghanaian heritage.**\\n\\nBacked by a dynamic band on piano, Rhodes, saxophone, guitar, bass, and drums, the performance is both intimate and electrifying, balancing intricate musicianship with raw emotional power.\\n\\nSanko’s set includes material from his sixth studio album, Let It Unfold (213 Music, 4 Oct 2024), bringing his contemporary, deeply personal sound to the stage while exploring themes of growth, self-acceptance, and resilience.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1791653400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T04:00:00+00:00\",\"sale_end_date\":\"2026-10-10T17:00:00+01:00\",\"sale_start_date\":\"2025-11-28T04:00:00+00:00\",\"event_start_date\":\"2026-10-10T18:30:00+01:00\",\"event_end_date\":\"2026-10-10T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"yonkkv-road-10th-oct-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Road - Világcsavargó\",\"redirect_url\":\"https://open.spotify.com/track/5yXIrcn5xSRmHWTgacadvH\",\"artist\":\"Road\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ff549e5161221ae95e41932a6f63121c6ea58181?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Világcsavargó\"},{\"type\":\"apple_music\",\"title\":\"Road - Világcsavargó\",\"redirect_url\":\"https://music.apple.com/us/album/vil%C3%A1gcsavarg%C3%B3/608399463?i=608399775&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Road\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/5d/f6/69/5df669cc-a5c4-9827-c7e7-6584208ef767/mzaf_12155285841803282007.plus.aac.p.m4a\",\"track_name\":\"Világcsavargó\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":60287,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":60288,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":60289,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-10T18:30:00+01:00\",\"doors_close_date\":\"2026-10-10T22:00:00+01:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/feb76a54-719c-4481-952e-82c34d6797bd.jpg?rect=0%2C0%2C4252%2C4252\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/feb76a54-719c-4481-952e-82c34d6797bd.jpg?rect=0%2C851%2C4252%2C2551\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/feb76a54-719c-4481-952e-82c34d6797bd.jpg?rect=957%2C0%2C2339%2C4252\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/m9acf731c083?dice_id=m9acf731c083\",\"post_competition_referral\":\"https://link.dice.fm/H66ae0cbd869?dice_id=H66ae0cbd869\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m10b8aabd265?dice_id=m10b8aabd265\",\"post_purchase_referral\":\"https://link.dice.fm/y19592d580cc?dice_id=y19592d580cc\",\"post_reminder_referral\":\"https://link.dice.fm/O76aec5911be?dice_id=O76aec5911be\",\"post_waitinglist_referral\":\"https://link.dice.fm/P042fb0d8da8?dice_id=P042fb0d8da8\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\"