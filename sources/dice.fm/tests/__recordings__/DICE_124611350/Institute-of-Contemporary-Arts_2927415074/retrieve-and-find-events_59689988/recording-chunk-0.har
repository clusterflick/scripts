e,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T13:00:00+00:00\",\"doors_close_date\":null},{\"id\":\"3616\",\"name\":\"The Good Mixer\",\"address\":\"The Good Mixer, 30 Inverness St, Camden Town, London NW1 7HJ, UK\",\"location\":{\"lat\":51.5394501,\"lng\":-0.1446118},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-good-mixer-ylla\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T13:00:00+00:00\",\"doors_close_date\":null},{\"id\":\"14448\",\"name\":\"The Elephants Head\",\"address\":\"224 Camden High Street, Camden, London, NW1 8QR, United Kingdom\",\"location\":{\"lat\":51.54071,\"lng\":-0.14392},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-elephants-head-6dd93\",\"accessibility\":{\"url\":\"https://www.elephantsheadcamden.com/index\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"DEADLETTER\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7fe5e42d53515ff4f812442f\"},\"artist_id\":\"24916\",\"about\":{\"description\":\"Celebrate the release of Deadletter's new album 'Existence is Bliss' by joining them on a pub crawl around Camden, London. The band will play a 20-30min live set at each of the following venues, including tracks from the new album and hits! The band have also put some money behind the bar at each venue, sign-up to their mailing list to claim your free drink (terms & conditions apply).\\n\\nFiddlers Elbow - 1pm\\n\\nElephants Head - 3pm\\n\\nGood Mixer - 5pm\\n\\nFormed in Yorkshire and based in south London, DEADLETTER layer their socially charged post-punk with grit, satire and saxophone. Released in 2022, the band’s debut EP HEAT! – which generously speckles their cynical sound with disco and funk – won praise from DIY Magazine. Live, their old-school rambunctious style has won them performance slots at fashion week parties and tours with Placebo, while solo they’ve headlined London institutions Scala, 100 Club and The Windmill.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"about\":{\"description\":\"Celebrate the release of Deadletter's new album 'Existence is Bliss' by joining them on a pub crawl around Camden, London. The band will play a 20-30min live set at each of the following venues, including tracks from the new album and hits! The band have also put some money behind the bar at each venue, sign-up to their mailing list to claim your free drink (terms & conditions apply).\\n\\nFiddlers Elbow - 1pm\\n\\nElephants Head - 3pm\\n\\nGood Mixer - 5pm\\n\\nFormed in Yorkshire and based in south London, DEADLETTER layer their socially charged post-punk with grit, satire and saxophone. Released in 2022, the band’s debut EP HEAT! – which generously speckles their cynical sound with disco and funk – won praise from DIY Magazine. Live, their old-school rambunctious style has won them performance slots at fashion week parties and tours with Placebo, while solo they’ve headlined London institutions Scala, 100 Club and The Windmill.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T16:30:00+00:00\",\"sale_end_date\":\"2026-02-27T13:00:00+00:00\",\"sale_start_date\":\"2026-02-16T17:00:00+00:00\",\"event_start_date\":\"2026-02-27T13:00:00+00:00\",\"event_end_date\":\"2026-02-27T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[\"selling_fast\"],\"id\":\"69934b888f8d5800012c4c6a\",\"name\":\"Deadletter Camden Pub Crawl\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/edd29086-4ba9-4e58-aee0-a020818268f2.jpg?rect=130%2C0%2C2740%2C2740\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/edd29086-4ba9-4e58-aee0-a020818268f2.jpg?rect=0%2C470%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/edd29086-4ba9-4e58-aee0-a020818268f2.jpg?rect=747%2C0%2C1507%2C2740\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771259400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ud66af682797?dice_id=Ud66af682797\",\"post_competition_referral\":\"https://link.dice.fm/Y99fb907c579?dice_id=Y99fb907c579\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e67bea5bb3ea?dice_id=e67bea5bb3ea\",\"post_purchase_referral\":\"https://link.dice.fm/G1d1b142dd79?dice_id=G1d1b142dd79\",\"post_reminder_referral\":\"https://link.dice.fm/Rc1e5ebc4bc2?dice_id=Rc1e5ebc4bc2\",\"post_waitinglist_referral\":\"https://link.dice.fm/V718230e99f4?dice_id=V718230e99f4\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"DEADLETTER - To the Brim\",\"redirect_url\":\"https://open.spotify.com/track/6YjU68fNU3Qnj7f9yhwzIE\",\"artist\":\"DEADLETTER\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b51e54941671645ec3684e37393f72fdc3a64c78?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"To the Brim\"},{\"type\":\"apple_music\",\"title\":\"DEADLETTER - To the Brim\",\"redirect_url\":\"https://music.apple.com/us/album/to-the-brim/1847402688?i=1847402890&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"DEADLETTER\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/43/8a/52/438a52d8-3757-8b72-dd3c-bd3e00dae32a/mzaf_13346024386372384584.plus.aac.p.m4a\",\"track_name\":\"To the Brim\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":null,\"seats_io_public_key\":null,\"presented_by\":\"Presented by AEG.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":17883,\"title\":\"Where can I find out more information about travelling to Alexandra Palace?\",\"body\":\"Head here to find out more and stay up to date: https://www.alexandrapalace.com/visitor-information/get-here/\",\"order\":0},{\"id\":23131,\"title\":\"Is there a cloakroom?\",\"body\":\"£5 for bags (under A4 size only), £3 for coats and £2 for all other items (card only). Large bags are not allowed inside the venue at all (including the cloakroom).\",\"order\":1},{\"id\":17884,\"title\":\"What do I do on the day of the event?\",\"body\":\"On the day of the event (usually 2h before it starts) you’ll be able to activate your ticket in the app and generate your unique QR code.\\n\\nJust follow these steps.\\n\\n1\\\\. Open the DICE app. Tap the ticket icon at the bottom of the screen.\\n\\n2\\\\. Choose the event.\\n\\n3\\\\. Tap Activate QR code.\\n\\nIf you bought tickets for a group and you’re arriving together, you can show everyone’s tickets on your device to the door staff.\",\"order\":2},{\"id\":17885,\"title\":\"What if I can’t make the event anymore? \",\"body\":\"**Offer your ticket to another fan**\\n\\nWe believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the wait list: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the wait list function switched on, and tickets can only be added to the wait list after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the wait list works https://dice.fm/help/article?id=4409669479953\",\"order\":3},{\"id\":23132,\"title\":\"Is there an after show party?\",\"body\":\"Happening in the Phoenix Bar until 1am. Please note this is not an official party related to the artist or promoter.\",\"order\":4},{\"id\":17886,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":5},{\"id\":64322,\"title\":\"How do I add my code?\",\"body\":\"In your email from co:brand, you will have received a unique code. You must apply this code to the event page before you can purchase tickets.\\n\\nTo apply your code on DICE:\\n\\n1\\\\. Follow the link in the email to the event page.\\n\\n2\\\\. Select the event date you wish to purchase tickets for.\\n\\n3\\\\. In the app: Scroll down to the section that says \\\"Got a code?\\\"\\n\\n4\\\\. On the web: Look for \\\"Got a code?\\\" on the left-hand side of the page, under the event image.\\n\\n5\\\\. Enter your unique code and tap Apply. This will unlock the ability to purchase tickets when they go on sale.\\n\\nOnce you’ve applied the code, the code unlocks the ability to purchase tickets for that specific show (up to the ticket limit). If you close the app or exit the window for some reason, the code to purchase tickets will remain linked to your account. You can simply head back to the event page/checkout, and the access will still be applied.\",\"order\":6},{\"id\":23130,\"title\":\"Can I bring a bag?\",\"body\":\"You're welcome to bring a bag for your essentials into the festival. However, there won’t be a cloakroom available, and large bags will not be allowed in so please leave them at home.\\n\\nExemptions apply for medical purposes, but we ask that you contact us in advance if this applies to you via access@alexandrapalace.com.\",\"order\":6},{\"id\":23133,\"title\":\"Can I pay in cash?\",\"body\":\"Ally Pally is now fully cashless so bring your card/phone with you to pay across the site.\",\"order\":7},{\"id\":64321,\"title\":\"How many tickets can I buy?\",\"body\":\"You can buy up to 4 tickets per person / code. If you buy multiple, you must arrive at the venue together.\",\"order\":9},{\"id\":64314,\"title\":\"Can I transfer my ticket?\",\"body\":\"Ticket transfers are not available for this event. If you have multiple tickets, you must arrive together. If you cannot attend and the option is visible, please return your ticket to the wait list.\",\"order\":10},{\"id\":64394,\"title\":\"I don't have a code\",\"body\":\"The codes come from co:brand directly and we're not able to give these out.\",\"order\":11}],\"billing_promoter\":{\"id\":\"1871\",\"name\":\"Alexandra Palace\",\"image\":{\"url\":null},\"perm_name\":\"alexandra-palace-oybm\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"ww5ddn-fred-again-27th-feb-alexandra-palace-london-tickets\",\"is_fully_locked\":true,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772211600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":4,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:18\",\"venues\":[{\"id\":\"179\",\"name\":\"Alexandra Palace\",\"address\":\"Alexandra Palace, Alexandra Palace Way, London N22 7AY\",\"location\":{\"lat\":51.5941783,\"lng\":-0.130773299999987},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/284d14ab-cfd4-49de-aeca-561e3b4888b2.jpg?rect=0%2C0%2C512%2C512\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"alexandra-palace-j7v7\",\"accessibility\":{\"url\":\"https://www.alexandrapalace.com/visitor-information/ticketing/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"Alexandra Palace Great Hall\",\"doors_open_date\":\"2026-02-27T17:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fred again..\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-17/da72ae2d-ba45-4dfb-a1d7-df7e996f9a56.jpg?rect=0%2C585%2C3980%2C3980\"},\"artist_id\":\"14147\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Website opens at 9:30am. On sale at 10:00am\\n\\n**Fred again.. USB002 at Alexandra Palace**\\n\\n**\\\\+ guests TBA**\\n\\nTo be able to purchase tickets when they go on sale, you will need to have registered before 10pm on Sunday 14 December 2025.Please note that transfer will not be available on DICE for this event. Please ensure to arrive with your full party.\\n\\nPhones: We’ll provide a sticker at entry to cover your phone cameras so everyone can stay in the moment. No cameras / video cameras allowed.\\n\\n*If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally*\\n\\n*Venue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#*\\n\\nPrice includes a £2.50 venue restoration levy.\\n\\n18+ only. Valid, government-issued photo ID is required for entry. Photos or photocopies of your ID are not an acceptable form of identification.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-13T19:18:00+00:00\",\"sale_end_date\":\"2026-02-27T21:00:00+00:00\",\"sale_start_date\":\"2025-12-18T09:30:00+00:00\",\"event_start_date\":\"2026-02-27T17:00:00+00:00\",\"event_end_date\":\"2026-02-27T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":true,\"properties\":[],\"id\":\"693d7b7493e4d40001699abd\",\"name\":\"Fred again..\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-13/2c78e159-247e-439c-96c2-971b26fc0368.jpg?rect=0%2C462%2C3695%2C3695\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-13/2c78e159-247e-439c-96c2-971b26fc0368.jpg?rect=0%2C1201%2C3695%2C2217\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-13/2c78e159-247e-439c-96c2-971b26fc0368.jpg?rect=578%2C0%2C2540%2C4619\"},\"marketeers\":[{\"id\":959,\"name\":\"Alexandra Palace\",\"privacy_policy_link\":\"https://www.alexandrapalace.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":\"AW-784377975\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2333,\"name\":\"Fred again..\",\"privacy_policy_link\":\"https://sites.google.com/goodlife-management.com/fredagainprivacy/home?authuser=2)\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitt