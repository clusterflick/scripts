ll},\"presented_by\":\"Presented by Ninety One Living Room.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":null,\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/ldebc83c6615?dice_id=ldebc83c6615\",\"post_competition_referral\":\"https://link.dice.fm/Y6cde7067185?dice_id=Y6cde7067185\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p1ec4a2e21a7?dice_id=p1ec4a2e21a7\",\"post_purchase_referral\":\"https://link.dice.fm/Bdbf0afc8390?dice_id=Bdbf0afc8390\",\"post_reminder_referral\":\"https://link.dice.fm/bb0a40fee974?dice_id=bb0a40fee974\",\"post_waitinglist_referral\":\"https://link.dice.fm/Lf1b6d7530a7?dice_id=Lf1b6d7530a7\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"\\\\*This is an 18+ event, physical & scannable ID required on entry.\\n\\nOn Saturday 21st Feb, come n get down as jazz-soul singer Connie Eliza and her band bring your fave disco, funk & soul classics to life. From Diana Ross to Stevie Wonder and everything in between, you're in for a high energy night of big party anthems. Book your table below to secure your spot!\\n\\nTABLE BOOKINGS : https://www.opentable.co.uk/r/ninety-one-living-room-london\\n\\nDoors 6pm with live music from 7pm.\\n\\nABOUT CONNIE ELIZA\\n\\nWhen life starts to feel a little too loud, Connie Eliza has the kind of voice that helps you tune back in. The independent jazz-soul singer from Essex brings a silky yet powerful vocal tone and a deep love for groove, drawing influence from artists like Stevie Wonder, Lianne La Havas and 70s disco/soul.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room\",\"privacy_policy_link\"