se_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:29\",\"social_links\":{\"event_share\":\"https://link.dice.fm/C164d204c5e0?dice_id=C164d204c5e0\",\"post_competition_referral\":\"https://link.dice.fm/V1e72c8d5af3?dice_id=V1e72c8d5af3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m20529e06964?dice_id=m20529e06964\",\"post_purchase_referral\":\"https://link.dice.fm/a91ae8df5f69?dice_id=a91ae8df5f69\",\"post_reminder_referral\":\"https://link.dice.fm/e140ea270284?dice_id=e140ea270284\",\"post_waitinglist_referral\":\"https://link.dice.fm/P0a98df90b37?dice_id=P0a98df90b37\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-03-21T12:00:00+00:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-03-21T13:00:00+00:00\",\"event_end_date\":\"2026-03-21T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"6956684aec8c810