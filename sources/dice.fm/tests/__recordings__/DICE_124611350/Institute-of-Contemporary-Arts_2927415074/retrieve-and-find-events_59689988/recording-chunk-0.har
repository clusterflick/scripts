,\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T22:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"227\",\"name\":\"The Doctor's Orders\",\"image\":{\"url\":null},\"perm_name\":\"the-doctors-orders-zl6r\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/j6a693aed964?dice_id=j6a693aed964\",\"post_competition_referral\":\"https://link.dice.fm/Rbcfc8b85eae?dice_id=Rbcfc8b85eae\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ob59c258704d?dice_id=ob59c258704d\",\"post_purchase_referral\":\"https://link.dice.fm/E3812263e7bc?dice_id=E3812263e7bc\",\"post_reminder_referral\":\"https://link.dice.fm/sc2ec76c65cf?dice_id=sc2ec76c65cf\",\"post_waitinglist_referral\":\"https://link.dice.fm/K760b1ea9946?dice_id=K760b1ea9946\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":10,\"presented_by\":\"Presented by The Doctor's Orders.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:82\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T06:00:00+00:00\",\"sale_end_date\":\"2026-04-16T21:00:00+01:00\",\"sale_start_date\":\"2025-12-22T07:00:00+00:00\",\"event_start_date\":\"2026-04-16T22:30:00+01:00\",\"event_end_date\":\"2026-04-17T02:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1766383200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3093,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69496f60c54ede000165fd7b\",\"name\":\"9th Wonder\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"9th Wonder\",\"image\":null,\"artist_id\":\"118005\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mr. Thing\",\"image\":null,\"artist_id\":\"78406\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mr Thing\",\"image\":null,\"artist_id\":\"30340\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"3on8n8-9th-wonder-16th-apr-the-jazz-cafe-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/de75950c-a6a3-44ac-b3ec-6727ca23bf4d.jpg?rect=0%2C0%2C1181%2C1181\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/de75950c-a6a3-44ac-b3ec-6727ca23bf4d.jpg?rect=0%2C236%2C1181%2C709\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/de75950c-a6a3-44ac-b3ec-6727ca23bf4d.jpg?rect=266%2C0%2C650%2C1181\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"The Doctor’s Orders presents\\n\\n9th Wonder\\n\\nSuper Producer for Little Brother, Jay-Z, Drake, Anderson Park, Rapsody, Mary J Blige, Erykah Badu, De La Soul, Destiny’s Child & more\\n\\n9th Wonder (Little Brother)\\n\\nMr Thing & The Shejay\\n\\nFor a very special one-off event The Doctor's Orders bring super producer 9th Wonder to London.\\n\\nThe Grammy winning producer responsible for hits by the likes of Jay-Z, Destinies Child, Mary J Blige & Drake is already a good friend of and firm favorite of The Doctor’s Orders this his first ever show in Manchester is sure to cause a stir. When not working with a who’s who of Hip-Hop and RnB he is a lecturer at both Harvard and Duke Universities.\\n\\nWith a soul drenched sound crafted in his time as one third of Little Brother, 9th Wonder will be spinning a selection of his own productions and the music that influenced one of the greatest living producers.\\n\\nHe is joined by two of the UK’s best DJs in the shape of DJ Mr Thing & The Shejay.\\n\\nYou can expect a night packed with classic Hip-Hop, Soul, RnB from the most respected and in demand names in the world.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Thu 16 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzNDAxNywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTI4ODU0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1OTowMC4yOTEzMThaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6Mjk5MSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEzNDAxNywidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZC