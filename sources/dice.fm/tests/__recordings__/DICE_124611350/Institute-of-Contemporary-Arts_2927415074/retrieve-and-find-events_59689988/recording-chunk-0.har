has_multiple_ticket_types\":true,\"impression_id\":\"4699078e3c3acde4:25\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/4d7358aa-425a-420f-b5cd-8f81d0eaa652.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/4d7358aa-425a-420f-b5cd-8f81d0eaa652.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/4d7358aa-425a-420f-b5cd-8f81d0eaa652.jpg?rect=506%2C0%2C1238%2C2250\"},\"id\":\"6968d34734000a0001b1e52b\",\"name\":\"Season: Eaves Wilder, Kissing on Camera, Slumber\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The greatest band that ever lived\\\" - NME in an article written in a 2036 retrospective of Slumber's first decade.\\n\\nTaking over the Shacklewell Arms with a lineup of their own curation, Slumber kindly open up proceedings on the evening before handing over to Kissing on Camera and our special guest headliner Eaves Wilder.\\n\\nWe're thrilled to be hosting Slumber's night of The Season in one of the best venues in East London.\\n\\nSeasons Change: Welcome to Season Two\\n\\nTickets on Sale now or pick up a Season Ticket to every show in February at https://link.dice.fm/theseason\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T09:00:00+00:00\",\"sale_end_date\":\"2026-02-25T18:00:00+00:00\",\"sale_start_date\":\"2026-01-15T17:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:00:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Corner Couch\",\"redirect_url\":\"h