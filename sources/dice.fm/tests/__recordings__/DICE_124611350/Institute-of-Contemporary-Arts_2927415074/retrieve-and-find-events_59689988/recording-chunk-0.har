lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-14T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"136165\",\"name\":\"Mirror TV\",\"image\":{\"url\":null},\"perm_name\":\"mirror-tv-xlylk\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/v34c34c1c4d7?dice_id=v34c34c1c4d7\",\"post_competition_referral\":\"https://link.dice.fm/rb8a535b9e05?dice_id=rb8a535b9e05\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t36556fa48e7?dice_id=t36556fa48e7\",\"post_purchase_referral\":\"https://link.dice.fm/rcdfcd7ec072?dice_id=rcdfcd7ec072\",\"post_reminder_referral\":\"https://link.dice.fm/z555ea4fbb9a?dice_id=z555ea4fbb9a\",\"post_waitinglist_referral\":\"https://link.dice.fm/T2af131ed856?dice_id=T2af131ed856\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":10,\"presented_by\":\"Presented by Mirror TV.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:30\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-04-14T17:00:00+01:00\",\"sale_start_date\":\"2026-02-05T10:30:00+00:00\",\"event_start_date\":\"2026-04-14T19:30:00+01:00\",\"event_end_date\":\"2026-04-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770202800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"id\":\"6973ac0a637cfd00010ed422\",\"name\":\"The DNA Test + Rocktone Rebel + Waterdeer\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rocktone Rebel\",\"image\":null,\"artist_id\":\"132830\",\"about\":null,\"is_headliner\":false},{\"name\":\"WaterDeer\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273807399d85ead12b6f9ef3b42\"},\"artist_id\":\"132828\",\"about\":null,\"is_headliner\":false},{\"name\":\"The DNA Test \",\"image\":null,\"artist_id\":\"132829\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"6dnkq3-the-dna-test-rocktone-rebel-waterdeer-14th-apr-paper-dress-vintage-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/8d380da1-fba7-4a3b-8e1f-047156d8c822.jpg?rect=0%2C0%2C2480%2C2480\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/8d380da1-fba7-4a3b-8e1f-047156d8c822.jpg?rect=0%2C496%2C2480%2C1488\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/8d380da1-fba7-4a3b-8e1f-047156d8c822.jpg?rect=558%2C0%2C1364%2C2480\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"MIRROR TV PRESENTS!\\n\\nTHE DNA TEST LONDON DEBUT SHOW!\\n\\nPart band, part art experiment, The DNA Test is what happens when post-punk lineage meets electronic ritual. Featuring Martina Spetlova ( LOGGSPLITTER / FACEKINI), Jem Doulton (THURSTON MOORE GROUP / AU PAIRS / MELOS KALPA ), and Austin ( SNAPPED ANKLES / LOGGSPLITTER) the trio combine live drums, thunderous Latvian Pērkons drum machinery, wild and organic Soma Terra synths with incantatory vocals to build a wild grooves within a living soundscape. Responding to the politics of DNA, borders, and belonging, the project questions the logic of origin myths with wit and bite. Serious ideas, sweaty execution. The DNA Test doesn’t offer answers - it sets the test on fire.\\n\\nROCKTONE REBEL\\n\\nOnce and still a one man band. Now supported live by a band of friends. AMEDEO'S ROCKTONE REBEL are a fresh blend of calypso math lo-fi exuberance. Fresh groovy fun msic.\\n\\nWATERDEER\\n\\nStubbornly clinging to the flotsam and jetsam of a rapidly receding 20th century, Waterdeer are a six piece dream pop band that blend ethereal melodies, downtempo rhythms, and haunting vocals to conjure a sound that wouldn't have been out of place on the early 90s Too Pure roster. Think PJ Harvey, Movietone, Mazzy Star, The For Carnation, you know, the good stuff. Ask us about our favourite David Lynch film.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":69067,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":69068,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":69069,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":69070,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"properties\":[],\"date_unix\":1776191400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-14T19:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"388\",\"name\":\"Roundhouse\",\"image\":{\"url\":null},\"perm_name\":\"roundhouse-jyav\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/w41524e56fc0?dice_id=w41524e56fc0\",\"post_competition_referral\":\"https://link.dice.fm/kf059c0265d0?dice_id=kf059c0265d0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V674b68fd867?dice_id=V674b68fd867\",\"post_purchase_referral\":\"https://link.dice.fm/t525a12f3ee9?dice_id=t525a12f3ee9\",\"post_reminder_referral\":\"https://link.dice.fm/t3e0d56ce744?dice_id=t3e0d56ce744\",\"post_waitinglist_referral\":\"https://link.dice.fm/Wc9be33006c8?dice_id=Wc9be33006c8\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":\"c724b587-92a7-4350-b7d3-75376531badb\",\"max_tickets\":10,\"presented_by\":\"Presented by Roundhouse.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:31\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T10:00:00+00:00\",\"sale_end_date\":\"2026-04-13T10:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-04-14T19:30:00+01:00\",\"event_end_date\":\"2026-04-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1768384800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3065},\"id\":\"6967c6562a025600018f365b\",\"name\":\"Julie's Top 5 LIVE\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Trevor Nelson\",\"image\":null,\"artist_id\":\"93935\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rachel Anson\",\"image\":null,\"artist_id\":\"10827\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"new\":false,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"c724b587-92a7-4350-b7d3-75376531badb\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"enabled\"},\"perm_name\":\"av3gvv-julies-top-5-live-14th-apr-roundhouse-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/9314fe87-e2a7-403a-bcc4-0f2904ecedd2.jpg?rect=0%2C10%2C1260%2C1260\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/9314fe87-e2a7-403a-bcc4-0f2904ecedd2.jpg?rect=0%2C262%2C1260%2C756\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/9314fe87-e2a7-403a-bcc4-0f2904ecedd2.jpg?rect=278%2C0%2C704%2C1280\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Get ready for a night of unfiltered music-ranking chaos as Julie Adenuga brings her hit show Julie’s Top 5 to its biggest stage yet – expect side-eyes, shouting matches and a celebration of British music past and present.\\n\\nJoin Julie and her special guests **Trevor Nelson**, **Rachael Anson**, **Sarel** and **Chuckie Online** plus more to be announced, as they battle it out to answer one impossible question: What are the Top 5 Black British Anthems of all time?\\n\\nEach guest will arrive armed with their own personal Top 5, but by the end of the night, they must collectively agree on just five songs to make the final list. Friendships may be tested. Egos will be bruised.\\n\\nWith Black British music spanning generations and genres, from Grime and Garage to Rap, Afro Swing and beyond, this isn’t just a debate, it’s a celebration of a rich, always evolving musical legacy.\\n\\nSoundtracked by Julie’s house band, alongside some very special surprise live performances, this is the kind of energy you simply cannot recreate from your sofa. And it’s what Three Sixty festival is all about.\\n\\nAre you ready to throw hands for Talkin’ The Hardest, campaign for POW or petition for P’s & Q’s? Bring your opinions. Bring your energy. Bring your voice, because at the end of the night, only five songs will survive.\\n\\nThis is an all-ages event (Under 16s accompanied by an adult, Under 14s accompanied and in seats).\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776191400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.1208059000000503