"name\":\"Beret live in London\",\"perm_name\":\"dkaqo6-beret-live-in-london-16th-nov-o2-academy-islington-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/104a8d66-2856-40a5-a512-d499f5c6f901.jpg?rect=0%2C3%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/104a8d66-2856-40a5-a512-d499f5c6f901.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/104a8d66-2856-40a5-a512-d499f5c6f901.jpg?rect=169%2C0%2C743%2C1350\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Beret\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb45f28c2a8e2ef0728cd66f67\"},\"artist_id\":\"131247\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765326600,\"faqs\":[{\"id\":63514,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3999},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Mon 16 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T14:00:00+00:00\",\"sale_end_date\":\"2026-11-18T19:00:00+00:00\",\"sale_start_date\":\"2026-01-15T14:00:00+00:00\",\"event_start_date\":\"2026-11-18T19:00:00+00:00\",\"event_end_date\":\"2026-11-18T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Jazz Cafe.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/cf35d2e8933d?dice_id=cf35d2e8933d\",\"post_competition_referral\":\"https://link.dice.fm/S3a774b7c885?dice_id=S3a774b7c885\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t2684989b7f0?dice_id=t2684989b7f0\",\"post_purchase_referral\":\"https://link.dice.fm/w75c419efb01?dice_id=w75c419efb01\",\"post_reminder_referral\":\"https://link.dice.fm/i7f6d02b3222?dice_id=i7f6d02b3222\",\"post_waitinglist_referral\":\"https://link.dice.fm/B9586b2ab28e?dice_id=B9586b2ab28e\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**The all-encompassing, high-latitude soundscapes of RYMDEN.**\\n\\nHaving spent decades shaping the architecture of European jazz, **Bugge Wesseltoft**, **Magnus Öström**, and **Dan Berglund** move between **melancholic piano motifs** and **visceral**, **rock-inflected percussion**. It is a partnership defined by a near-telepathic chemistry, where **intricate rhythmic layers** give way to **expansive**, **open-ended exploration**.\\n\\nA sound rooted in Scandinavian atmosphere, yet untethered from tradition—a mature, intuitive dialogue between three artists who helped write the book on contemporary improvisation.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795028400,\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-18T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:15\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"6967c9d38fc9840001aa3873\",\"name\":\"Rymden\",\"perm_name\":\"py56mp-rymden-18th-nov-the-jazz-cafe-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/22334529-0cb1-4f14-a621-bc42180371c9.jpg?rect=0%2C0%2C1748%2C1748\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/22334529-0cb1-4f14-a621-bc42180371c9.jpg?rect=0%2C350%2C1748%2C1049\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/22334529-0cb1-4f14-a621-bc42180371c9.jpg?rect=394%2C0%2C961%2C1748\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rymden\",\"image\":null,\"artist_id\":\"132401\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1768399200,\"faqs\":[{\"id\":69477,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T14:30:00+00:00\",\"sale_end_date\":\"2026-11-17T09:00:00+00:00\",\"sale_start_date\":\"2025-12-05T14:30:00+00:00\",\"event_start_date\":\"2026-11-18T19:00:00+00:00\",\"event_end_date\":\"2026-11-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Serious.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":\"ace98f7b-5f86-4680-99a6-8a3e04fe243e\",\"social_links\":{\"event_share\":\"https://link.dice.fm/o34eaddacd0b?dice_id=o34eaddacd0b\",\"post_competition_referral\":\"https://link.dice.fm/X23e4897cc4b?dice_id=X23e4897cc4b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kf53cf3568c1?dice_id=kf53cf3568c1\",\"post_purchase_referral\":\"https://link.dice.fm/h7870a5f6755?dice_id=h7870a5f6755\",\"post_reminder_referral\":\"https://link.dice.fm/Ofc878a64684?dice_id=Ofc878a64684\",\"post_waitinglist_referral\":\"https://link.dice.fm/n3ca1aa358e6?dice_id=n3ca1aa358e6\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Fatoumata Diawara is pure energy. Her vibrant voice tells the story of Africa—its suffering and its rediscovered joys—sung in her mother tongue, Bambara. She is a captivating artist, able to stir emotions, to make her audience laugh, cry, and above all, dance.\\n\\nA free woman above all else, she uses art as a path. Through her singing, she addresses crucial subjects such as female genital mutilation and forced marriage—personal hardships that she transforms into a universal message of hope and resilience. Having fled Mali at the age of 19 to write her own story, Fatoumata Diawara continues, at 43, to examine society’s flaws while celebrating her dual life as an artist and a mother.\\n\\nA major figure in African music, whose presence on stage is always a moment of bubbling intensity!\\n\\nThis is an all-ages event (Under 16s accompanied by an adult, Under 14s accompanied and in seats).\",\"highlights\":[]},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"marketeers\":[{\"id\":1446,\"name\":\"Serious\",\"privacy_policy_link\":\"https://serious.org.uk/serious-ticketing-t-cs\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795028400,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-18T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:16\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1432\",\"name\":\"Serious\",\"image\":{\"url\":null},\"perm_name\":\"serious-nyo9\",\"profile_active\":true},\"id\":\"6939830ecb73ba00019358f7\",\"name\":\"Fatoumata Diawara\",\"perm_name\":\"k6nn88-fatoumata-diawara-18th-nov-roundhouse-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/ff06b0c1-33db-4228-be99-076a4d65c88f.jpg?rect=0%2C1584%2C6336%2C6336\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/ff06b0c1-33db-4228-be99-076a4d65c88f.jpg?rect=0%2C2851%2C6336%2C3802\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/ff06b0c1-33db-4228-be99-076a4d65c88f.jpg?rect=555%2C0%2C5227%2C9504\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Fatoumata Diawara\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-10/65ca9f32-3ab4-4009-bb93-662118223c41.jpg?rect=1%2C0%2C639%2C639\"},\"artist_id\":\"7775\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764945000,\"faqs\":[{\"id\":61981,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":61982,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":61983,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":61984,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3320},\"has_multiple_ticket_types\":true,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"ace98f7b-5f86-4680-99a6-8a3e04fe243e\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"enabled\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Fatoumata Diawara - Boloko\",\"redirect_url\":\"https://open.spotify.com/track/78obrwKhMqymbOiW0lLidh\",\"artist\":\"Fatoumata Diawara\",\"preview_url\":\"https://p.scdn.co/mp3-preview/61ba20ebf360c8fc946cffb5e2c5d970cfcae14d?cid=65b2e37aa72641ac8d34c44cec272b2e\",\"track_name\":\"Boloko\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Wed 18 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T12:00:00+00:00\",\"sale_end_date\":\"2026-11-19T18:00:00+00:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-11-19T19:00:00+00:00\",\"event_end_date\":\"2026-11-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":true,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/C0c0bb6487ac?dice_id=C0c0bb6487ac\",\"post_competition_referral\":\"https://link.dice.fm/Pe6efa460fb5?dice_id=Pe6efa460fb5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kdeb01fa7f9d?dice_id=kdeb01fa7f9d\",\"post_purchase_referral\":\"https://link.dice.fm/Zf9e66939e5f?dice_id=Zf9e66939e5f\",\"post_reminder_referral\":\"https://link.dice.fm/Pe1e275e07af?dice_id=Pe1e275e07af\",\"post_waitinglist_referral\":\"https://link.dice.fm/Od4585b54246?dice_id=Od4585b54246\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"\\\"Tools of Oppression / Rule by Deception\\\", the last new full-length album by THE HOPE CONSPIRACY was engineered by Kurt Ballou and Zach Weeks at God City Studios. Artwork for the release was created by acclaimed artist Alexander Heir (Death/Traitors).\\n\\nThis is true sonic violence aimed at political division, economic manipulation, war profiteering, media propaganda and other vile forms of global oppression.\\n\\nAir raid sirens wail as the foreboding \\\"Those Who Gave Us Yesterday\\\" and \\\"The Prophets and Doom\\\" explode forth like burning shrapnel. The hell ride continues with \\\"A Struggle ForPower\\\" and \\\"Live In Fear\\\", two vicious blasts supercharged with malice and contempt. \\\"Shock By Shock\\\" and \\\"Of A Dying Nation\\\" introduce doom and gloom heaviness, grinding down the tempo to a mid-paced barrage. \\\"Confusion/Chaos/Misery\\\" picks up the pace, going scorched-earth policy on the sociopolitical nightmares that ensnare us all while \\\"Broken Vessels\\\" plows into overdrive about mental illness and addiction as a whole. This leads to \\\"The West Is Dead\\\" a dystopian hook laden hardcore anthem, and epic closer \\\"The Specter Looms\\\"; An ominous soundtrack to the steady decline of our modern age.\\n\\nThere is no question, THE HOPE CONSPIRACY is back to make a cold hard statement about existence in the end times.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795114800,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-19T19:00:00+00:00\",\"doors_close_date\":\"2026-11-19T23:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:17\",\"tty_to_extras\":[{\"ticket_type_id\":1185269,\"extra_ids\":[\"1191911\"]}],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"6982389b9178fb0001c4ff1b\",\"name\":\"THE HOPE CONSPIRACY\",\"perm_name\":\"oeveay-the-hope-conspiracy-19th-nov-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/2b714c23-5ab8-4ace-bfd5-f4d2013805f6.jpg?rect=0%2C0%2C2200%2C2200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/2b714c23-5ab8-4ace-bfd5-f4d2013805f6.jpg?rect=0%2C440%2C2200%2C1320\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/2b714c23-5ab8-4ace-bfd5-f4d2013805f6.jpg?rect=495%2C0%2C1210%2C2200\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Hope Conspiracy\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-23/b1b3e350-ffe9-4661-bb8d-0e390ae618f2.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"94517\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1770206400,\"faqs\":[{\"id\":74036,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":74037,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":74038,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"price\":{\"currency\":\"GBP\",\"amount\":3327,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Animal Farm\",\"redirect_url\":\"https://open.spotify.com/track/1QfjU50ABFOfNhoQVREWXa\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1d7ca3aa854db91843143cbb4096d1b6dafc6f12?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Animal Farm\"},{\"type\":\"apple_music\",\"title\":\"The Hope Conspiracy - Fragile\",\"redirect_url\":\"https://music.apple.com/us/album/fragile/493520847?i=493521068&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Hope Conspiracy\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/bc/c1/04/bcc104f3-e48c-beea-89e5-2a75373e438a/mzaf_14964420486926184876.plus.aac.p.m4a\",\"track_name\":\"Fragile\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-31T00:00:00+00:00\",\"sale_end_date\":\"2026-11-19T20:00:00+00:00\",\"sale_start_date\":\"2026-01-31T00:00:00+00:00\",\"event_start_date\":\"2026-11-19T19:00:00+00:00\",\"event_end_date\":\"2026-11-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Hackney Folk Club\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/m1f2a78f9d45?dice_id=m1f2a78f9d45\",\"post_competition_referral\":\"https://link.dice.fm/a8b86461e1b9?dice_id=a8b86461e1b9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jdf2cfb376a3?dice_id=jdf2cfb376a3\",\"post_purchase_referral\":\"https://link.dice.fm/H58bde3b2023?dice_id=H58bde3b2023\",\"post_reminder_referral\":\"https://link.dice.fm/w9146e48b5ae?dice_id=w9146e48b5ae\",\"post_waitinglist_referral\":\"https://link.dice.fm/g34c10c7bbdb?dice_id=g34c10c7bbdb\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"*Hackney Folk Club Presents*  \\n  \\n**Chris Wood**  \\n*\\\"... at art school they said I had a remarkable eye for trivia, like it was a bad thing.\\\"*  \\n  \\nReflections on minor league football, empty nest syndrome, learning to swim, Cook-in Sauce and of course, the Gecko as a metaphor for contemporary society! \\n\\nTom Robinson and Chris Difford are fans while Stick In The Wheel and The Unthanks look to him as an influence. In a world of soundbites and distractions Chris Wood is a truth seeker. His writing is permeated with love and wry intelligence, uplifting and challenging as he celebrates the sheer one-thing-after-anotherness of life.\\n\\nWinner of 6 BBC Folk Awards, he's played with The Royal Shakespeare Company and was a key member of The Imagined Village along with Billy Bragg, Martin and Eliza Carthy. A wise and soulful craftsman, his concerts are a cliche free zone.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1795114800,\"venues\":[{\"id\":\"171\",\"name\":\"Chats Palace\",\"address\":\"42-44 Brooksby's Walk, London E9 6DF\",\"location\":{\"lat\":51.5502294,\"lng\":-0.0429139000000305},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-19T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:18\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"id\":\"697d528daaeef300019d3aa3\",\"name\":\"Hackney Folk Club: Chris Wood\",\"perm_name\":\"nvkrd9-hackney-folk-club-chris-wood-19th-nov-chats-palace-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-31/42cb225e-a302-4469-8f78-b9707a90e5d5.jpg?rect=1312%2C0%2C3376%2C3376\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-31/42cb225e-a302-4469-8f78-b9707a90e5d5.jpg?rect=187%2C0%2C5627%2C3376\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-31/42cb225e-a302-4469-8f78-b9707a90e5d5.jpg?rect=2072%2C0%2C1857%2C3376\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Chris Wood\",\"image\":null,\"artist_id\":\"61602\",\"about\":{\"description\":\"With a background in traditional English church music, songwriter and composer Chris Wood has been an important figure in the British folk scene since his debut in 1990. A multi-instrumentalist, Wood often plays viola, fiddle and guitar, as well as providing all the main vocals for both his solo and collaborative projects.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"new\":false,\"announcement_date_unix\":1769817600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1413},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T10:00:00+00:00\",\"sale_end_date\":\"2026-11-19T17:00:00+00:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-11-19T19:00:00+00:00\",\"event_end_date\":\"2026-11-19T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Bird On The Wire\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":12},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/d4149638622e?dice_id=d4149638622e\",\"post_competition_referral\":\"https://link.dice.fm/rac28a