7253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:28\",\"properties\":[],\"presented_by\":\"Presented by Short Waves.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769126400,\"id\":\"69735a328627e10001ba86ea\",\"name\":\"Vecinos + Knots\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Short Waves Presents:\\n\\nVecinos is a band born in Barcelona that has been gaining ground in the independent scene with a sound that blends punk, pop, and garage, paired with ironic, emotional, and everyday lyrics.\\n\\nAfter three EPs, they present Centro de Ayuda, a 10-track album that explores precarity, humor, routine, and friendship. The release includes a documentary recorded at La Mina studio that showcases their creative process. In addition, they are developing Fin del informativo, a musical late-night show that mixes current affairs, humor, and generational catharsis.\\n\\nKnots are a Tropicalia and Motown-infused rock n roll band from South London. In December, they released a double A-side, Boring Twenties/Still Morning, and they’ll release their debut album, the International Brigades, later this year.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2399\",\"name\":\"The Victoria Dalston\",\"image\":{\"url\":null},\"perm_name\":\"the-victoria-dalston-l3wp\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"