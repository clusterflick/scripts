esented_by\":\"Presented by Rough Trade.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:49\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T09:00:00+00:00\",\"sale_end_date\":\"2026-05-16T20:00:00+01:00\",\"sale_start_date\":\"2026-01-27T16:45:00+00:00\",\"event_start_date\":\"2026-05-16T19:15:00+01:00\",\"event_end_date\":\"2026-05-16T20:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1769504400,\"offers_extras\":true,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1586},\"id\":\"6978e7040ce9fa0001a318a2\",\"name\":\"Smag På Dig Selv: Stripped Back + Signing\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Smag På Dig Selv\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-09/e6c95a37-cb77-4783-a4be-9ba91c48ed07.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"120768\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"bb329x-smag-p-dig-selv-stripped-back-signing-16th-may-rough-trade-denmark-street-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/3b8c4078-636c-4c59-8cd5-f68c0045d4d6.jpg?rect=833%2C0%2C3335%2C3335\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/3b8c4078-636c-4c59-8cd5-f68c0045d4d6.jpg?rect=0%2C168%2C5000%2C3000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/3b8c4078-636c-4c59-8cd5-f68c0045d4d6.jpg?rect=1583%2C0%2C1834%2C3335\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Rough Trade Denmark Street is very excited to present an in-store performance and signing from Smag På Dig Selv. This unique event celebrates the release of their new album 'This Is Why We Lost' released via Def Presse.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade Denmark Street on the day of the show.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/smag-pa-dig-selv/this-is-why-we-lost-1\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5NjU5MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTU2MDY4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NjgzMTVaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6Mzc4NywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE5NjU5MSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF