00\",\"sale_end_date\":\"2026-05-20T21:00:00+01:00\",\"sale_start_date\":\"2026-02-04T09:00:00+00:00\",\"event_start_date\":\"2026-05-20T19:45:00+01:00\",\"event_end_date\":\"2026-05-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770195600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69824c33bf44f40001b55031\",\"name\":\"Ribbon Skirt\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ribbon Skirt\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-14/03fd912a-33ea-41fa-86e2-9db466f1dbdf.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"124278\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"dkqkdv-ribbon-skirt-20th-may-windmill-brixton-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/95ff33ff-784d-45b1-8ff6-5a092bc692de.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/95ff33ff-784d-45b1-8ff6-5a092bc692de.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/95ff33ff-784d-45b1-8ff6-5a092bc692de.jpg?rect=169%2C0%2C743%2C1350\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"\\\\[RIBBON SKIRT\\\\](https://linktr.ee/ribbonskirtband)\\n\\n... is a Montreal-based post-punk band led by Anishinaabe musician Tashiina Buswa and lead guitarist Billy Riley. The band released their debut album, Bite Down, on Mint Records in April 2025. Produced by Scott Munro (Preoccupations) and mixed by Greg Saunier (Deerhoof), the album marks a shift toward a darker, more introspective sound, exploring themes of memory, grief, and Buswa’s connection to her Indigenous identity and cultural practices.\\n\\nRibbon Skirt has performed at major festivals across North America, including SXSW, New Colossus, Sled Island, Sappyfest, and Pop Montreal, sharing the stage with artists like Dehd, Ombiigizi, Packs, Wombo, Marnie Stern, Enumclaw, and Chad VanGaalen.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":42139,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1779303600,\"tty_to_extras\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_op