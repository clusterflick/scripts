eferral\":\"https://link.dice.fm/o9f3b9296f01?dice_id=o9f3b9296f01\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:22\",\"properties\":[],\"presented_by\":\"Presented by Kilimanjaro in conjunction with Junzi Arts.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763662500,\"id\":\"691f5a2b73695a000120e781\",\"name\":\"Eric Christian\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Kili Presents In Conjunction with Junzi Arts\\n\\nEric Christian\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 14s to be accompanied by an adult / only permitted in reserved seats.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"date_unix\":1791565200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1845,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T10:00:00+00:00\",\"sale_end_date\":\"2026-10-09T17:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-10-09T19:00:00+01:00\",\"event_end_date\":\"2026-10-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"wwey8p-ulrika-spacek-9th-oct-the-dome-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ulrika Spacek - Picto\",\"redirect_url\":\"https://open.spotify.com/track/2UBRx5bJDivBNBtmmQBZwD\",\"artist\":\"Ulrika Spacek\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ac4330fef6708d9c6f435a8b9a379fb4bc2d88d3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Picto\"},{\"type\":\"apple_music\",\"title\":\"Ulrika Spacek - Picto\",\"redirect_url\":\"https://music.apple.com/us/album/picto/1841611473?i=1841611612&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ulrika Spacek\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/3c/47/22/3c4722d1-4070-5e40-7e5a-08b6ff877dcb/mzaf_13607784895464252612.plus.aac.p.m4a\",\"track_name\":\"Picto\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":12},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ulrika Spacek\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-17/f82c2b53-d311-415a-8f2d-0d30326b00ee.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"2164\",\"about\":{\"description\":\"If all the world is a stage, then our performance is a lonely one. Reflected not through eyes but through screens ad infinitum, our audience – real or imagined – is no longer a burden but a need. Attention, recognition, validation: we trade our interior worlds for the thrill of public display. In a hyper-individual world, Ulrika Spacek’s fourth album EXPO offers an antidote.\\n\\nEven as its five members have been pulled by tides of their own, Ulrika Spacek has always been a symbol of collective art. Despite a range of day jobs (experimental physicists, graphic designers, music producers) the collective pursuit is there in the shared dream logic of the music: the off-kilter melodies, jagged guitars and cirrus cloud atmospherics. It’s there, in all the things that are said and unsaid between them; there in the writing, producing and mixing processes they share in. And even as each of their parts moves toward a unified vision, it’s never more keenly felt than in the bigger picture to which Ulrika Spacek belong.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"84\",\"name\":\"The Dome\",\"address\":\"2A Dartmouth Park Hill, London NW5 1HL\",\"location\":{\"lat\":51.5579086,\"lng\":-0.139039799999978},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-dome-jq5a\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-09T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/040ea36e-7ac9-40c0-aacc-9ab1f3fa1ddc.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/040ea36e-7ac9-40c0-aacc-9ab1f3fa1ddc.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/040ea36e-7ac9-40c0-aacc-9ab1f3fa1ddc.jpg?rect=563%2C0%2C1375%2C2500\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Nbab241efa89?dice_id=Nbab241efa89\",\"post_competition_referral\":\"https://link.dice.fm/idfbd0fdea48?dice_id=idfbd0fdea48\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Yf85741fe996?dice_id=Yf85741fe996\",\"post_purchase_referral\":\"https://link.dice.fm/N4a4b3