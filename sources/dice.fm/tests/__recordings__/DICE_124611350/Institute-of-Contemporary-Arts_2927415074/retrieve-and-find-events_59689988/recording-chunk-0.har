ocation\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"here-at-outernet-wgbx\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/24679933108753-HERE-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-14T19:00:00+01:00\",\"doors_close_date\":\"2026-04-14T23:00:00+01:00\"}],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/nf770e2c03fc?dice_id=nf770e2c03fc\",\"post_competition_referral\":\"https://link.dice.fm/feca08beb4e4?dice_id=feca08beb4e4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T8adfe079330?dice_id=T8adfe079330\",\"post_purchase_referral\":\"https://link.dice.fm/Y42c5d783ff5?dice_id=Y42c5d783ff5\",\"post_reminder_referral\":\"https://link.dice.fm/S75905852488?dice_id=S75905852488\",\"post_waitinglist_referral\":\"https://link.dice.fm/zba561a1e95b?dice_id=zba561a1e95b\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by SJM\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:24\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T20:00:00+00:00\",\"sale_end_date\":\"2026-04-14T21:00:00+01:00\",\"sale_start_date\":\"2025-12-04T10:00:00+00:00\",\"event_start_date\":\"2026-04-14T19:00:00+01:00\",\"event_end_date\":\"2026-04-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1764619200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2244},\"id\":\"6929d084bbd68d0001ff4bf0\",\"name\":\"Aries\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Aries\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebec2df9a6cb848545e47bb0e6\"},\"artist_id\":\"15928\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"new\":false,\"seating\":null,\"perm_name\":\"oeqlx5-aries-14th-apr-here-at-outernet-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/d2202131-ae27-49e8-a7fb-4e14905379c8.jpg?rect=390%2C0%2C1880%2C1880\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/d2202131-ae27-49e8-a7fb-4e14905379c8.jpg?rect=0%2C142%2C2660%2C1596\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/d2202131-ae27-49e8-a7fb-4e14905379c8.jpg?rect=813%2C0%2C1034%2C1880\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"*\\\\*For accessibility information please see the accessibility information button/link below*\\n\\nAn artist who has always been closely guarded, Aries’ latest release GLASS JAW is his most personal work to date. Aries has always moved on the margins and lived as an outsider. After earning notoriety in the creatively fertile YouTube boom, deconstructing the music of Drake and Lil Uzi Vert with near-surgical understanding of production, Aries had been nurturing a vision as an artist in his own right which led him to belong to a musical movement which completely redefined alternative music through online community.\\n\\nThe tension between confidence and fragility defines the central thesis of GLASS JAW. Sonically, the album sees Aries take bolder swings away from the trap rhythms that once defined him without compromising on his knack for anthemic choruses. His fluency in experimental hip-hop has never been stronger - and he turns it all on a dime with his honeyed, unmistakable voice which rides the knife edge between pop and something altogether darker.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ (14-16s with an adult) event - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BCLUBS%2BLIMITED%2BPRIVACY%2BAND%2BCOOKIES%2BSTATEMENT.pdf\",\"fb_pixel_id\":\"1020185540161660\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776189600,\"tty_to_extras\":[],\"venues\":[{\"id\":\"2691\",\"name\":\"Night Tales Loft\",\"address\":\"207, 1 Westgate St, London E8 3RL, UK\",\"location\":{\"lat\":51.53753889999999,\"lng\":-0.05786670000000001},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/9ded5223-ee50-49da-9cc8-dfb16fb11e4e.jpg?rect=0%2C0%2C1317%2C1317\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"night-tales-loft-39wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-14T19:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"2368\",\"name\":\"Night Tales Loft\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/6e6ef849-1334-49eb-a7bd-a888e14902a0.jpg\"},\"perm_name\":\"night-tales-loft-dvlq\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/qd4f67a44089?dice_id=qd4f67a44089\",\"post_competition_referral\":\"https://link.dice.fm/J32c2f000208?dice_id=J32c2f000208\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C4f3199489f6?dice_id=C4f3199489f6\",\"post_purchase_referral\":\"https://link.dice.fm/m3e49ddaf325?dice_id=m3e49ddaf325\",\"post_reminder_referral\":\"https://link.dice.fm/kade17a81811?dice_id=kade17a81811\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ta71a306d57e?dice_id=Ta71a306d57e\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by NT's Loft.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:25\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T11:00:00+01:00\",\"sale_end_date\":\"2026-04-14T19:00:00+01:00\",\"sale_start_date\":\"2025-09-30T11:30:00+01:00\",\"event_start_date\":\"2026-04-14T19:00:00+01:00\",\"event_end_date\":\"2026-04-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1759226400,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"id\":\"698c81d49b9cd80001b3aefb\",\"name\":\" Playback: Fred Again.. [Candlelit Sessions]\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"xe6xpl--playback-fred-again-candlelit-sessions-14th-apr-night-tales-loft-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/57c534c5-6c86-4fb7-a03f-1584e2f310fc.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/57c534c5-6c86-4fb7-a03f-1584e2f310fc.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/57c534c5-6c86-4fb7-a03f-1584e2f310fc.jpg?rect=338%2C0%2C825%2C1500\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Presented by Johnnie Walker Black Label × NT’s Loft\\n\\nOn Tuesday, 14th of April, we turn our focus to Fred again..; an emotional, euphoric journey through one of the most defining electronic artists of this generation. From the intimate storytelling of *Actual Life* and *Actual Life 2*, to the explosive energy of *Actual Life 3* and the global impact of *Secret Life* and his arena-filling live shows, this session explores the vulnerability, connection and catharsis that have reshaped modern dance music.\\n\\nPlayback returns as a candlelit listening experience where over 200 candles transform NT’s Loft into a glowing sanctuary. Designed to slow the pace, each session invites guests to disconnect from the noise and fully immerse themselves in the music shaping global culture.\\n\\nExperience every synth swell, vocal sample and bassline through the warmth and precision of Funktion-One sound, in an intimate, candlelit setting.\\n\\nJohnnie Walker Black Label returns to elevate the evening, with signature serves available throughout the night. Guests arriving before 8pm will receive a complimentary drink to begin the evening in style (Limited to First 50 Customers).\\n\\nTickets\\n\\nReserved seating ticket holders must arrive by 8:00 PM. Seating is first come, first served.\\n\\n—\\n\\nSchedule\\n\\n7:00 PM – Doors & Playlist\\n\\n8:15 PM – Listening Session Begins (90 mins)\\n\\nLimited capacity. Arrive early, stay late.\",\"highlights\