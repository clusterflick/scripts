m/kb7b1faca72a?dice_id=kb7b1faca72a\",\"post_reminder_referral\":\"https://link.dice.fm/z603f155ad40?dice_id=z603f155ad40\",\"post_waitinglist_referral\":\"https://link.dice.fm/X9a76ac8ec4c?dice_id=X9a76ac8ec4c\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T10:00:00+00:00\",\"sale_end_date\":\"2026-08-20T18:00:00+01:00\",\"sale_start_date\":\"2026-01-21T10:00:00+00:00\",\"event_start_date\":\"2026-08-20T19:00:00+01:00\",\"event_end_date\":\"2026-08-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2077,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"13616\",\"name\":\"The Black Heart\",\"image\":{\"url\":null},\"perm_name\":\"the-black-heart-yq6r\",\"profile_active\":false},\"id\":\"6966738abbdd5700017b0912\",\"seats_io_event_id\":null,\"name\":\"Zatokrev\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"7dp787-zatokrev-20th-aug-the-black-heart-london-tickets\",\"date_unix\":1787248800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-20T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Trash Kit\",\"image\":null,\"artist_id\":\"4088\",\"about\":null,\"is_headliner\":false},{\"name\":\"Linda Smith\",\"image\":null,\"artist_id\":\"82179\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[{\"id\":73888,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/ebb927e8-2fd0-4ee1-b3cb-008eefdf4e63.jpg?rect=781%2C0%2C3345%2C3345\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/ebb927e8-2fd0-4ee1-b3cb-008eefdf4e63.jpg?rect=0%2C201%2C4907%2C2944\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/ebb927e8-2fd0-4ee1-b3cb-008eefdf4e63.jpg?rect=1534%2C0%2C1840%2C3345\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Linda Smith - Afternoon Tea\",\"redirect_url\":\"https://music.apple.com/us/album/afternoon-tea/1717169561?i=1717170013&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Linda Smith\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/88/98/c4/8898c41a-3230-70ed-4fa9-ac1e19b585a5/mzaf_8648012190738986699.plus.aac.p.m4a\",\"track_name\":\"Afternoon Tea\"},{\"type\":\"spotify\",\"title\":\"Linda Smith - Afternoon Tea\",\"redirect_url\":\"https://open.spotify.com/track/4iRlGmolR0wTbitMoU5prk\",\"artist\":\"Linda Smith\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f2330ba3893510e784a1c9ec3c9c5bf41581e260?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Afternoon Tea\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770121800,\"max_tickets\":6,\"marketeers\":[{\"id\":20,\"name\":\"Upset The Rhythm\",\"privacy_policy_link\":\"http://www.upsettherhythm.co.uk/privacypolicy.html http://www.upsettherhythm.co.uk/privacypolicy.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"LINDA SMITH is a pioneer of home recording who self released her music originally on cassette starting in 1987. In the early 90’s, indie labels Slumberland and Harriet Records expanded her reach with the release of two seven inch eps. Recently, Brooklyn label Captured Tracks has reissued two complete albums on vinyl and she has begun to tour in the US and internationally for the first time. Upset The Rhythm released a recent split single between Smith and The Smashing Times last year too. Paste magazine called Linda Smith “a hidden treasure of America's pop underground”, while Jangle Pop Hub has written that “essentially this is the best bedroom pop you are ever likely to hear, directly from an age that did not really know what to do with it”. For this rare UK show Linda will be joined by her live band.\\n\\nhttps://lindasmith2.bandcamp.com/\\n\\nTRASH KIT are Ray Aggs (guitar, vocals), Rachel Horwood (drums, vocals) and Clémentine March (bass). Three deeply creative individuals who play in a multitude of other groups including Bas Jan and Sacred Paws, not to mention their solo outings. Their songs once succinct, patchwork post-punk numbers of an honest diary-like nature now tussle more with long-form songwriting, expeditious polyphony and cascades of sung-spoke vocals. Although Trash Kit have their forebears in bands like Sleater Kinney, The Ex and The Raincoats, their sound is still very much their own take on facing forwards and relies as much on the naturalism of an internalised folk music as on their sincerity of vision. Since forming in 2009, Trash Kit have released three albums for Upset The Rhythm and a selection of singles. Trash Kit's approach to life as with music is one of openness, inclusion and potential and most recent album ‘Horizon’ has this in dutiful abundance.\\n\\nhttps://upsettherhythm.bandcamp.com/album/horizon\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Upset The Rhythm.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:13\",\"social_links\":{\"event_share\":\"https://link.dice.fm/d7e98a1cf59e?dice_id=d7e98a1cf59e\",\"post_competition_referral\":\"https://link.dice.fm/C4d90c8162fd?dice_id=C4d90c8162fd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/zbfa8377a753?dice_id=zbfa8377a753\",\"post_purchase_referral\":\"https://link.dice.fm/b47b7b7e906d?dice_id=b47b7b7e906d\",\"post_reminder_referral\":\"https://link.dice.fm/Ub754238aad5?dice_id=Ub754238aad5\",\"post_waitinglist_referral\":\"https://link.dice.fm/U1f6119d3658?dice_id=U1f6119d3658\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T12:30:00+00:00\",\"sale_end_date\":\"2026-08-20T18:00:00+01:00\",\"sale_start_date\":\"2026-02-03T12:30:00+00:00\",\"event_start_date\":\"2026-08-20T19:30:00+01:00\",\"event_end_date\":\"2026-08-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1589,\"sales_tax\":0,\"amount_from\":null},\