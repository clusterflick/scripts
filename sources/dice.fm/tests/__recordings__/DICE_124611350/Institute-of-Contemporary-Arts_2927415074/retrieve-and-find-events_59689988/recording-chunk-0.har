io-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/c6/00/ef/c600eff8-0c4a-d9d9-455e-bef5ea0274b4/mzaf_14733497146889174381.plus.aac.p.m4a\",\"track_name\":\"I Love Music (A Tom Moulton Mix)\"},{\"type\":\"spotify\",\"title\":\"The O'Jays - I Love Music - A Tom Moulton Mix\",\"redirect_url\":\"https://open.spotify.com/track/0X3gRDW1QOfcbXAD4AHgYU\",\"artist\":\"The O'Jays - I Love Music - A Tom Moulton Mix\",\"preview_url\":\"https://p.scdn.co/mp3-preview/669d8d36213223cb4f5934b82486383ba84d3219?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The O'Jays - I Love Music - A Tom Moulton Mix\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Wed 16 Dec\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T00:00:00+00:00\",\"sale_end_date\":\"2026-12-17T19:30:00+00:00\",\"sale_start_date\":\"2026-01-13T19:00:00+00:00\",\"event_start_date\":\"2026-12-17T19:00:00+00:00\",\"event_end_date\":\"2026-12-17T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/hf2b864d3835?dice_id=hf2b864d3835\",\"post_competition_referral\":\"https://link.dice.fm/ic9bdf359f5d?dice_id=ic9bdf359f5d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B754e6d5aa61?dice_id=B754e6d5aa61\",\"post_purchase_referral\":\"https://link.dice.fm/E51e3a956bd2?dice_id=E51e3a956bd2\",\"post_reminder_referral\":\"https://link.dice.fm/o6de1d507a96?dice_id=o6de1d507a96\",\"post_waitinglist_referral\":\"https://link.dice.fm/qd88167858b2?dice_id=qd88167858b2\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Join us for an intimate evening with possibly the greatest storyteller of all time - Spike from The Quireboys - with his 'Off the Record - A Life in Rock & Roll' tour, accompanied by Chris Heilman.\\n\\nSpike is the founder and unmistakable frontman of The Quireboys, one of the UK’s most enduring rock ’n’ roll bands. Through every chapter and line-up change, he’s been the band’s constant heartbeat - songwriter, singer, and the voice behind classics like Hey You, I Don’t Love You Anymore, and 7 O’Clock, penned with long-time collaborator Guy Bailey.\\n\\nAlongside his work with The Quireboys, Spike has also had a succession of critically acclaimed solo records and treasured collaborations. Music is Spike’s lifeblood. Always has been and always will be.\\n\\nWhen the pandemic brought touring to a halt, Spike stripped things back with a series of intimate acoustic shows to support his Late Night Song Book album - one of the first live music offerings as lockdown eased in 2021. These storytelling-led performances quickly became a fan favourite and remain one of Spike’s favourite performance showpieces. Even though the newly re-formed Quireboys continue to sell out larger venues, he is very much at home with his acoustic guitar, accompanied by Chris Heilmann.\\n\\n2026 promises to be a packed year, with shows across Europe and the USA - but as always, Spike will return home to the UK to deliver his unique and much-loved solo performances to fans old and new.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1797534000,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7