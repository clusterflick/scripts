},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-20/3b23c1ff-a71d-4ceb-9085-984e551fc9b2.jpg?rect=250%2C0%2C1000%2C1000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-20/3b23c1ff-a71d-4ceb-9085-984e551fc9b2.jpg?rect=0%2C50%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-20/3b23c1ff-a71d-4ceb-9085-984e551fc9b2.jpg?rect=475%2C0%2C550%2C1000\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"698c7deb1715d7000171c19c\",\"name\":\"Higgo & Friends TBA\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-03-20T05:30:00+00:00\",\"sale_end_date\":\"2026-04-25T02:00:00+01:00\",\"sale_start_date\":\"2025-03-21T10:00:00+00:00\",\"event_start_date\":\"2026-04-24T18:00:00+01:00\",\"event_end_date\":\"2026-04-25T03:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"q29ebo-higgo-friends-tba-24th-apr-night-tales-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4120},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/E6d8aeae9cb4?dice_id=E6d8aeae9cb4\",\"post_competition_referral\":\"https://link.dice.fm/f97b97de4b9b?dice_id=f97b97de4b9b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u1400c0e14d2?dice_id=u1400c0e14d2\",\"post_purchase_referral\":\"https://link.dice.fm/o552c908410e?dice_id=o552c908410e\",\"post_reminder_referral\":\"https://link.dice.fm/f58ee6aea79b?dice_id=f58ee6aea79b\",\"post_waitinglist_referral\":\"https://link.dice.fm/t11c78bb3c42?dice_id=t11c78bb3c42\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Faris Shafi, Umair Butt & Gharvi Group - Blockbuster\",\"redirect_url\":\"https://music.apple.com/us/album/blockbuster/1745124085?i=1745124099&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Faris Shafi, Umair Butt & Gharvi Group\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/29/73/fe/2973fef5-f4fb-32b2-56f6-b2a614c1e2c1/mzaf_15599708740263520.plus.aac.p.m4a\",\"track_name\":\"Blockbuster\"}],\"faqs\":[{\"id\":73624,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is an 18+ event. In order to verify your age, ID may be requested. For this reason, we advise that all customers bring valid ID. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Strings Entertainment & The White Wolfe Company.\",\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"date_unix\":1777050000,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"highlights\":[],\"profile_active\":true,\"space_name\":\"EartH Hall\",\"doors_open_date\":\"2026-04-24T18:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":true,\"impression_id\":\"ab902a79f4685193:45\",\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nFARIS SHAFI – THE MAN WHO KNOWS NO BORDERS\\n\\nGet ready for the “Bar Without Borders” Debut UK Tour!\\n\\nDate: Friday, 24th April 2026\\n\\nVenue: Earth, Hackney\\n\\nExperience the unstoppable energy of Faris Shafi live—raw, fearless, and boundary-breaking.\\n\\nBrought to you by Strings Entertainment & The White Wolfe Company\\n\\nThis is going to be a legendary night you won’t want to miss.\\n\\nABOUT THE ARTIST\\n\\nFaris Shafi is a prominent Pakistani rapper, songwriter, and performer known for his sharp lyricism, bold social commentary, and genre-blending sound. Rising to wider recognition through platforms like Coke Studio Pakistan, he stands out for mixing Urdu, Punjabi, and English with heavy beats, satire, and poetic aggression. Faris often challenges political hypocrisy, class divides, and cultural norms in South Asia, using humor and provocation as tools of critique. With tracks that balance raw energy and intellectual depth, he has carved a distinct space in the regional hip-hop scene, earning a reputation as an artist who is unapologetically original and unafraid to speak truth to power.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 18+ event. Valid ID required.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1770026400,\"seats_io_public_key\":null,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4OTkwMSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUzMDM2LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NjQ5ODhaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzY0OSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4OTkwMSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUzMDM2LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NjUwMDVaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzY1MCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"pr