022d5cbdb7b3c7a:32\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-05T00:00:00+00:00\",\"sale_end_date\":\"2026-05-16T13:00:00+01:00\",\"sale_start_date\":\"2025-11-05T00:00:00+00:00\",\"event_start_date\":\"2026-05-16T13:00:00+01:00\",\"event_end_date\":\"2026-05-16T17:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1762300800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"id\":\"690b6822ff2bad0001dd2427\",\"name\":\"Will Wilde Band\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"yogewv-will-wilde-band-16th-may-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-30/b3f57c3a-c6cf-4b5e-8622-9662d7fdd77d.jpg?rect=0%2C74%2C1452%2C1452\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-12-30/b3f57c3a-c6cf-4b5e-8622-9662d7fdd77d.jpg?rect=0%2C365%2C1452%2C871\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-12-30/b3f57c3a-c6cf-4b5e-8622-9662d7fdd77d.jpg?rect=286%2C0%2C880%2C1600\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Will Wilde is a force to be reckoned with - a phenomenal harmonica player with a voice to match.\\n\\nWill's intense harmonica style steals the spotlight from the traditional blues rock guitar, with a sound that owes as much to Gary Moore as it does to Sonny Boy Williamson. \\\"I’m always looking to make new sounds with the harmonica, pushing its boundaries, trying to change people’s perception of it.” In fact Will has gone one step further and created his own signature \\\"Wilde Tuned\\\" harmonicas so he can play licks that weren’t possible before. “They enable me to hold my own with any blues rock guitarist”.\\n\\nWill gained popularity on Youtube with his mind blowing harmonica covers of classic rock guitar solos, such as Lynyrd Skynyrd's Free Bird, which racked up over 3.5 million views, and helped him gain his 94K+ subscribers. These videos brought him to the attention of blues rock guitar legend Walter Trout, who invited him to play on his album 'Broken', which went to number one on the Billboard Blues Album Chart.\\n\\nWill has released four studio albums and one live album: Unleashed (2010), Raw Blues (2013), Live In Hamburg (2015), Bring It On Home (2018) and Bad Luck Friday (2022), as well as appearing as a guest harmonica player on albums by Walter Trout, Toby Lee, Brave Rival, Earl Thomas and Krissy Matthews.\\n\\nWill was nominated \\\"Instrumentalist of the Year\\\" in the UK Blues Awards 2024.\\n\\n***Sponsored by Last Piastre Records.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778936400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"15510\",\"name\":\"Fox And Firkin\",\"address\":\"316 Lewisham High Street, Lewisham, London, SE13 6JZ, United Kingdom\",\"location\":{\"lat\":51.45698,\"lng\":-0.01441},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-04/8f120254-16c6-4f38-a599-6dbc7a16c8db.jpg?rect=0%2C0%2C2363%2C2363\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-16T14:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/S468e0b2eedc?dice_id=S468e0b2eedc\",\"post_competition_referral\":\"https://link.dice.fm/P4fb371ae1d8?dice_id=P4fb371ae1d8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F8e60638c6df?dice_id=F8e60638c6df\",\"post_purchase_referral\":\"https://link.dice.fm/e032733cb5e6?dice_id=e032733cb5e6\",\"post_reminder_referral\":\"https://link.dice.fm/C3e31b04e4ae?dice_id=C3e31b04e4ae\",\"post_waitinglist_referral\":\"https://link.dice.fm/ra46a9b8bc33?dice_id=ra46a9b8bc33\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by The Fox & Firkin.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:33\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T00:00:00+00:00\",\"sale_end_date\":\"2026-05-16T17:00:00+01:00\",\"sale_start_date\":\"2026-02-10T00:00:00+00:00\",\"event_start_date\":\"2026-05-16T14:00:00+01:00\",\"event_end_date\":\"2026-05-16T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770681600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2402},\"id\":\"698b13909ea50d0001d3117f\",\"name\":\"Craig Charles & Hot Piece of Brass - Open Air All Dayer\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Craig Charles\",\"image\":null,\"artist_id\":\"3814\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"bb8kkx-craig-charles-hot-piece-of-brass-open-air-all-dayer-16th-may-fox-and-firkin-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/8061105a-5893-40f4-8a8c-43bebff67d38.jpg?rect=427%2C0%2C1707%2C1707\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/8061105a-5893-40f4-8a8c-43bebff67d38.jpg?rect=0%2C86%2C2560%2C1536\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/8061105a-5893-40f4-8a8c-43bebff67d38.jpg?rect=811%2C0%2C939%2C1707\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"**Craig Charles & Hot Piece of Brass - Open Air All Dayer**\\n\\nBack for it's 3rd edition we welcome our longterm friend of the fox CRAIG CHARLES for another funkier all dayer in our tropical oasis.\\n\\nFor this year he's joined by the 8-strong brass explosion HOT PIECE OF BRASS 🎷\\n\\nSet among the trees, this is a daytime session built for dancing, relaxing and soaking up the soundtrack. As ever, expect a laid back outdoor atmosphere with great food, a well stocked bar, garden seating and a feel good crowd from start to finish.\\n\\n\\\\-------------------\\n\\nLeading the day is Craig Charles, a true heavyweight of UK music culture. From Red Dwarf and Robot Wars to Radio 6 Music and Radio 2, his journey from screen to decks has made him one of the country’s most respected voices in funk and soul. Since 2002 his BBC 6 Music Funk and Soul Show has introduced generations of dancers to timeless classics and future favourites, earning him a global following and a reputation for joyful, high energy sets that always deliver.\\n\\nAdding a live twist to the day are Hot Piece of Brass, trailblazers of the new generation of UK brass bands. This electrifying powerhouse have established themselves on an eclectic range of stages across the globe. Known for their genre-defying blend of blazing horns, funk-driven rhythms, and dynamite vocals, they’ve captivated audiences in sold-out venues across the UK and beyond.\\n\\nSupport acts to be announced soon.\\n\\nDoors open at 12pm Live music and DJs from 2pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778943600,\"tty_to_extras\":[],\"venues\":[{\"id\":\"829\",\"name\":\"New River Studios\",\"address\":\"199 Eade Rd, London N4 1DN, United Kingdom\",\"location\":{\"lat\":51.5749501,\"lng\":-0.0881636000000299},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-river-studios-g5e6\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-16T16:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/