001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hootananny-brixton-parp\",\"accessibility\":{\"url\":\"https://hootanannybrixton.co.uk/info/#:~:text=Venue%20Access%20Policy,Phone%20number%20020%2077373%207273.\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-12T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:63\",\"about\":{\"description\":\"Nine Sparks Riots is the passion project of composer, arranger, and trombonist Kristian Persson – a constantly evolving universe of jazz, funk, and neo-soul. The music bursts with energy and feels like pure euphoria, where playful melodies and vibrant riffs meet lush electronic soundscapes. Together with his skilled fellow musicians, Persson shapes an unlikely fusion of dynamic groove and emotional depth, where every beat pulses with life and intensity.\\n\\nIn recent years, the project has toured across Sweden, Finland, Estonia, Germany, the United Kingdom, Portugal, and Poland. Their music has generated millions of streams and features collaborations with artists such as Braxton Cook, Mark Lettieri, Philip Lassiter, Javier Santiago, Swatkins, Tingsek, Allen Stone, and Miike Snow.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765324800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Nine Sparks Riots\",\"image\":null,\"artist_id\":\"111974\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/6d5bbc2c-436b-43b5-8548-160830232da6.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/6d5bbc2c-436b-43b5-8548-160830232da6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/6d5bbc2c-436b-43b5-8548-160830232da6.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"693944606faa1d0001028782\",\"name\":\"Nine Sparks Riots\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T00:00:00+00:00\",\"sale_end_date\":\"2026-05-12T22:00:00+01:00\",\"sale_start_date\":\"2025-12-10T00:00:00+00:00\",\"event_start_date\":\"2026-05-12T19:00:00+01:00\",\"event_end_date\":\"2026-05-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"2w787a-nine-sparks-riots-12th-may-hootananny-brixton-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1700,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/se005b1f6984?dice_id=se005b1f6984\",\"post_competition_referral\":\"https://link.dice.fm/l6b6e9c3c164?dice_id=l6b6e9c3c164\",\"post_purchase_extras_available_referral\":\"