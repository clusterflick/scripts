//link.dice.fm/M3368264e94d?dice_id=M3368264e94d\",\"post_reminder_referral\":\"https://link.dice.fm/K7862ea20911?dice_id=K7862ea20911\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"17599\",\"name\":\"St John the Baptist Church, Hoxton\",\"address\":\"85 Pitfield Street, Hackney, London, N1 6NP, United Kingdom\",\"location\":{\"lat\":51.53054,\"lng\":-0.08361},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"st-john-the-baptist-church-hoxton-l8vgl\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"We’re happy to announce that Mandalakia will be performing on 21 March at St John’s Church. We’re especially excited to be sharing the stage with the wonderful Amena and her band — and to be collaborating together for this special night.\\n\\nMandalakia\\n\\nMandalakia is a London born project that breathes new life into the traditional music of Greece. With a distinctive approach, the band weave together the vibrant tapestry of Anatolian and Eastern Mediterranean music with the harmonic progressions and sound world of modern styles.\\n\\nAmena is an Egyptian-born and raised vocalist who has long dreamed of pursuing a life in music. In 2021, she moved to London to study at the Guildhall School of Music & Drama, where she immersed herself in jazz and contemporary music while staying deeply connected to her Arabic roots. Now, having recently completed her studies, she is focused on expanding the reach of Arabic jazz in the UK, bridging traditions and building new musical conversations.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:2\",\"billing_promoter\":{\"id\":\"14551\",\"name\":\"Mandalakia \",\"image\":{\"url\":null},\"perm_name\":\"mandalakia-l88vl\",\"profile_active\":false},\"presented_by\":\"Presented by Mandalakia.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Mandalakia\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-06/a12d613a-053e-4c00-9b26-080b522aa2ef.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"120511\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1769013000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T16:30:00+00:00\",\"sale_end_date\":\"2026-03-21T19:00:00+00:00\",\"sale_start_date\":\"2026-01-21T16:30:00+00:00\",\"event_start_date\":\"2026-03-21T19:30:00+00:00\",\"event_end_date\":\"2026-03-21T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6972b1f47752d600018a65a8\",\"name\":\"Mandalakia and Amena \",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1133},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"nvkwe9-the-utopiates-live-in-london-21st-mar-the-grace-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774121400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/2acf00d9-8e33-46cc-9e29-bce34995481c.jpg?rect=324%2C0%2C3328%2C3328\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/2acf00d9-8e33-46cc-9e29-bce34995481c.jpg?rect=0%2C167%2C4992%2C2995\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/2acf00d9-8e33-46cc-9e29-bce34995481c.jpg?rect=1581%2C0%2C1830%2C3328\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/La2ee1150c0e?dice_id=La2ee1150c0e\",\"post_competition_referral\":\"https://link.dice.fm/z8e92c7ed1d0?dice_id=z8e92c7ed1d0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c3275eb79fe8?dice_id=c3275eb79fe8\",\"post_purchase_referral\":\"https://link.dice.fm/p8604bb05173?dice_id=p8604bb05173\",\"post_waitinglist_referral\":\"https://link.dice.fm/pe5b82602cb3?dice_id=pe5b82602cb3\",\"post_reminder_referral\":\"https://link.dice.fm/uaec025d5441?dice_id=uaec025d5441\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**Gotobeat is excited to team up with The Grace to welcome The Utopiates with special guests on Saturday, March 21st.**\\n\\n**THE UTOPIATES -** Join BBC Radio 6, Indie-Electronic band, The Utopiates, in celebrating the release of their second album, \\\"Let's Make This Happen\\\".\\n\\nWith the release of their second album 'Let's Make This Happen' in March the indie-electronic purveyors of grooove anthems, The Utopiates, couldn't miss out on the chance to celebrate the launch in their home city of London. Join them at The Grace on Saturday, March 21st!\\n\\n**The Rizz -** The Rizz are a punchy five-piece rock ‘n’ roll outfit based in south-London, blending unmistakable British attitude with modern urgency. Known for their relentless live energy and infectious hooks, they deliver a sound that nods to the past whilst hitting hard in the present.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:3\",\"billing_promoter\":{\"id\":\"5184\",\"name\":\"Gotobeat\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-03/167fd842-233e-4076-a3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"presented_by\":\"Presented by Gotobeat.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Utopiates \",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7af4262f355b73f14f1da139\"},\"artist_id\":\"25243\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Rizz  \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-13/3067883c-4514-4926-8455-89a0bfe669a5.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"59302\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.co