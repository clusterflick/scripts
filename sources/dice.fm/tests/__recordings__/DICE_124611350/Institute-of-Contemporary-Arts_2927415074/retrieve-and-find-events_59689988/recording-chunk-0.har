e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-05T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eric Martin\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-01/74e28467-df48-4029-9c83-9dc727ae1748.jpg?rect=0%2C104%2C1000%2C1000\"},\"artist_id\":\"130846\",\"about\":null,\"is_headliner\":false},{\"name\":\"Geoff Tate\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/10dc8f31d2be0bb0f8980266283969aa4428c706\"},\"artist_id\":\"12002\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/ef667fe3-5654-4fcc-90e0-1283bf854122.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/ef667fe3-5654-4fcc-90e0-1283bf854122.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/ef667fe3-5654-4fcc-90e0-1283bf854122.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Geoff Tate - She Slipped Away\",\"redirect_url\":\"https://music.apple.com/gb/album/she-slipped-away/1045649575?i=1045649576&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Geoff Tate\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music3/v4/89/11/de/8911de15-442b-5a19-2867-9b0cfdd3f67e/mzaf_6183285584142739637.plus.aac.p.m4a\",\"track_name\":\"She Slipped Away\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764871200,\"max_tickets\":8,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Legendary vocalist GEOFF TATE, the original voice of QUEENSRŸCHE and the creative force behind the groundbreaking concept album Operation: mindcrime, will bring his celebrated Operation: mindcrime – The Final Chapter Tour to Islington Assembly Hall in London on Saturday, September 5, 2026.\\n\\nThis performance marks the final live chapter in Tate’s decades-long journey performing one of Progressive Metal’s most iconic works. Fans can expect an unforgettable evening as Tate and his exceptional band perform Operation: mindcrime in its entirety—along with highlights from Operation: mindcrime II and other classics from his storied career.\\n\\nJoining GEOFF TATE on this special night will be very special guest ERIC MARTIN, the powerhouse vocalist best known as the frontman for Multi-Platinum Rock band MR. BIG. Martin will open the evening with an acoustic set featuring fan favourites and deep cuts from his remarkable career.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Born Again Concerts.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:41\",\"social_links\":{\"event_share\":\"https://link.dice.fm/l5e7945d6888?dice_id=l5e7945d6888\",\"post_competition_referral\":\"https://link.dice.fm/Tb89559a45c7?dice_id=Tb89559a45c7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G64b91323759?dice_id=G64b91323759\",\"post_purchase_referral\":\"https://link.dice.fm/acfab6df557d?dice_id=acfab6df557d\",\"post_reminder_referral\":\"https://link.dice.fm/J9c83dfbfc1e?dice_id=J9c83dfbfc1e\",\"post_waitinglist_referral\":\"https://link.dice.fm/B9bcc57f856a?dice_id=B9bcc57f856a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T18:00:00+00:00\",\"sale_end_date\":\"2026-09-05T21:00:00+01:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-09-05T19:00:00+01:00\",\"event_end_date\":\"2026-09-05T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4218},\"properties\":[],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"692ff8676a42750001361be8\",\"seats_io_event_id\":null,\"name\":\"Geoff Tate's Operation: Mindcrime\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8oevr-geoff-tates-operation-mindcrime-5th-sep-islington-assembly-hall-london-tickets\",\"date_unix\":178863