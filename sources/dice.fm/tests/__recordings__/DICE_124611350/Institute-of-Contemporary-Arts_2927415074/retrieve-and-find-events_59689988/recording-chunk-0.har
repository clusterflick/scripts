c7123469.jpg?rect=0%2C931%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-01-06/a89d1d5a-0e58-4a24-bd2c-537ac7123469.jpg?rect=174%2C0%2C1700%2C3091\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1766062800,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":600},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-14T18:00:00+00:00\",\"sale_start_date\":\"2025-12-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-14T20:00:00+00:00\",\"event_end_date\":\"2026-03-14T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Conway Hall.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/kf4b512baec6?dice_id=kf4b512baec6\",\"post_competition_referral\":\"https://link.dice.fm/T01d897e46a8?dice_id=T01d897e46a8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/F5626ff4c63c?dice_id=F5626ff4c63c\",\"post_purchase_referral\":\"https://link.dice.fm/Cdbcba3aabe2?dice_id=Cdbcba3aabe2\",\"post_reminder_referral\":\"https://link.dice.fm/o3204c7c0bae?dice_id=o3204c7c0bae\",\"post_waitinglist_referral\":\"https://link.dice.fm/x8cff926ea46?dice_id=x8cff926ea46\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"“*Peter’s Field is an astonishing work…a compelling, passionate performance, radio-ballad-like, evocative and haunting*.” **Songlines Magazine**\\n\\n***Peter’s Field*** is an epic musical chronicle by folk singer, songwriter and storyteller **Sean Cooney** (The Young'uns), that tells the story of one of the most important days in working class history.\\n\\nOn 16th August 1819, 60,000 people gathered in the centre of Manchester. Many had walked miles to be there from all across Lancashire. They went to hear the famous radical speaker Henry ‘Orator’ Hunt who called for working people to have the vote. They were unarmed and peaceful. Local magistrates sent in the yeomanry cavalry and 15th Hussars to disperse the crowd and arrest Hunt. At least 18 people were killed and hundreds injured in the murderous scenes that followed. Women were deliberately targeted. It became known as the Peterloo Massacre. The magistrates and military were completely exonerated and it would be 100 years until working people had the vote.\\n\\n***Peter’s Field*** is born from years of research and comprises 19 original songs by Cooney performed with **Rowan Rheingans** and **Sam Carter** alongside a compelling spoken narrative derived from hundreds of eyewitness accounts.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. Under 16's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773518400,\"venues\":[{\"id\":\"3223\",\"name\":\"Conway Hall\",\"address\":\"25 Red Lion Square Holborn, London WC1R 4RL UK\",\"location\":{\"lat\":51.51948760000001,\"lng\":-0.1168424},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"conway-hall-obq5\",\"accessibility\":{\"url\":\"https://www.conwayhall.org.uk/about-us/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:84\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"5578\",\"name\":\"Conway Hall\",\"image\":{\"url\":null},\"perm_name\":\"conway-hall-5nry\",\"profile_active\":false},\"id\":\"6925bb5ccaf2b40001a9a229\",\"name\":\"Peter's Field \",\"perm_name\":\"mx86dl-peters-field-14th-mar-conway-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/eb1ecc8d-b589-4e4e-bc1c-e0539b107e3a.jpg?rect=304%2C0%2C893%2C893\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/eb1ecc8d-b589-4e4e-bc1c-e0539b107e3a.jpg?rect=6%2C0%2C1488%2C893\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/eb1ecc8d-b589-4e4e-bc1c-e0539b107e3a.jpg?rect=505%2C0%2C491%2C893\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1765497600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1808},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-14T13:00:00+00:00\",\"sale_end_date\":\"2026-03-15T02:00:00+00:00\",\"sale_start_date\":\"2025-11-14T13:00:00+00:00\",\"event_start_date\":\"2026-03-14T20:00:00+00:00\",\"event_end_date\":\"2026-03-15T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Blues Kitchen Brixton.\",\"is_ticket_available_at_door\":true,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,