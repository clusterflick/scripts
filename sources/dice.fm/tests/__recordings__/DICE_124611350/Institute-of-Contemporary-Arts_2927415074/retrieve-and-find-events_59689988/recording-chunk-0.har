e_name\":null,\"doors_open_date\":\"2026-02-18T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jóhann Jóhannsson\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-19/5fa8a389-75f4-4bf9-aa98-a487371f173b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"121125\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-05-15/0b44ff7c-dd7e-409d-92e9-0d81d6c207ba.jpg?rect=1238%2C0%2C5046%2C5046\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-05-15/0b44ff7c-dd7e-409d-92e9-0d81d6c207ba.jpg?rect=0%2C505%2C6728%2C4037\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-05-15/0b44ff7c-dd7e-409d-92e9-0d81d6c207ba.jpg?rect=1977%2C0%2C2775%2C5046\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Jóhann Jóhannsson - Arrival\",\"redirect_url\":\"https://music.apple.com/us/album/arrival/1440758063?i=1440758324&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Jóhann Jóhannsson\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/57/99/f7/5799f70a-83bb-d103-a351-01914b12c04c/mzaf_9697681840519311621.plus.aac.p.m4a\",\"track_name\":\"Arrival\"},{\"type\":\"spotify\",\"title\":\"Jóhann Jóhannsson - Prisoners\",\"redirect_url\":\"https://open.spotify.com/track/2y7G7IRQXoM6EQZfFoROuw\",\"artist\":\"Jóhann Jóhannsson\",\"preview_url\":\"https://p.scdn.co/mp3-preview/954300e24a9f40c64a392f457042733ca47da9cf?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Prisoners\"}],\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"announcement_date_unix\":1747816200,\"max_tickets\":6,\"marketeers\":[{\"id\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"6ad25724-c838-4111-9733-80b216a3eace\",\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"seat_selection\":\"enabled\"},\"about\":{\"description\":\"Baba Yaga's Hut and The Barbican presents:\\n\\nJóhann Jóhannsson: Cinematic Suites\\n\\nThis special performance of Jóhann Jóhannsson's Cinematic Suites, brings to life the evocative musical landscapes of four acclaimed films: The Theory of Everything, Prisoners, Sicario and Arrival.\\n\\nTonight's audience will be treated to a celebration of the late Icelandic composer's cinematic masterpieces, as we honour Jóhannsson’s legacy and the transformative power of music in film.\\n\\nJóhannsson's elegantly minimalist score for James Marsh's film, The Theory of Everything, escorts audiences on an inspirational biographical journey through the adult life of renowned physicist Stephen Hawking. And experience Jóhannsson's powerfully moving compositions, which heighten the cinematic tension, emotion, and narrative depth of three films from visionary director Denis Villeneuve; Prisoners, Sicario and Arrival.\\n\\nThese suites of music, masterfully performed by the London Contemporary Orchestra, will transport audiences through the haunting and emotive soundscapes that have become synonymous with Jóhannsson's genius. Audiences will be treated to a unique multimedia experience, as the performance is synchronized with imagery from the films.\\n\\nJoin us for a night of cinematic and musical brilliance that promises to captivate and inspire..\\n\\nWednesday 18 February 2026\\n\\nBarbican Hall, 7pm\\n\\nTickets from £30 plus booking fee\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Baba Yaga's Hut.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:48\",\"social_links\":{\"event_share\":\"https://link.dice.fm/e09b83e7e080?dice_id=e09b83e7e080\",\"post_competition_referral\":\"https://link.dice.fm/nf7c20a279db?dice_id=nf7c20a279db\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X11b5f1bc365?dice_id=X11b5f1bc365\",\"post_purchase_referral\":\"https://link.dice.fm/q3a263aed37b?dice_id=q3a263aed37b\",\"post_reminder_referral\":\"https://link.dice.fm/j195b4639b5e?dice_id=j195b4639b5e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Be3dcae8a4c3?dice_id=Be3dcae8a4c3\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-05-21T09:30:00+01:00\",\"sale_end_date\":\"2026-02-18T16:00:00+00:00\",\"sale_start_date\":\"2025-05-23T10:00:00+01:00\",\"event_start_date\":\"2026-02-18T19:30:00+00:00\",\"event_end_date\":\"2026-02-18T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3366},\"properties\":[],\"billing_promoter\":{\"id\":\"927\",\"name\":\"Baba Yaga's Hut\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-17/84092575-7b18-48f1-a81d-3e429d6f7b2b.jpg\"},\"perm_name\":\"baba-yagas-hut-l8ob\",\"profile_active\":true},\"id\":\"682ae4a619c4c30001fdc3fb\",\"seats_io_event_id\":\"6ad25724-c838-4111-9733-80b216a3eace\",\"name\":\"Jóhann Jóhannsson's: Cinematic Suites\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"dk9b26-jhann-jhannssons-cinemati