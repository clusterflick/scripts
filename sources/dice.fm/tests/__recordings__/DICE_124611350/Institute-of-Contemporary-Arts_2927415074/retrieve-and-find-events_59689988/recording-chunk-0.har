le_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/152f9ece-5c96-4389-86c1-72388865f750.jpg?rect=0%2C666%2C2757%2C2757\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/152f9ece-5c96-4389-86c1-72388865f750.jpg?rect=0%2C1217%2C2757%2C1654\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/152f9ece-5c96-4389-86c1-72388865f750.jpg?rect=255%2C0%2C2248%2C4088\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Better\",\"redirect_url\":\"https://open.spotify.com/track/5SWDPgL0V0z52CsbvPEOVF\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/88d5ea66f5a4363a4eb4c2fe473a9fd10c6d71c7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Better\"}],\"seats_io_public_key\":\"1c381828-86dd-4f2b-9d28-ed6f89c79409\",\"announcement_date_unix\":1764633600,\"max_tickets\":6,\"marketeers\":[{\"id\":228,\"name\":\"Southbank Centre\",\"privacy_policy_link\":\"https://www.southbankcentre.co.uk/policies/privacy\",\"fb_pixel_id\":\"1145741552151564\",\"ga_tracking_id\":\"UA-86802192-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"da190104-e524-43fc-90f8-530e2bed8f22\",\"seats_io_public_key\":\"1c381828-86dd-4f2b-9d28-ed6f89c79409\",\"seat_selection\":\"enabled\"},\"about\":{\"description\":\"With a 2024 Mercury Music Prize-nominated debut album, Bad With Names, under his belt, corto.alto is going from strength to strength.\\n\\ncorto.alto has been described as a traditional jazz head raised in the age of the internet, bringing a fresh perspective to a heady mix of intuitive improvisation, electronic production, broken beat bounce and bass-heavy dub.\\n\\nIt’s been an intense but rewarding few years for Shortall and his corto.alto project (the stage name a nod to his Irish-Spanish heritage, translating as ‘short.tall’ in Spanish).\\n\\nHis 2024 album, 30/108, saw him freely blend genre, tempo and instrumentation across 30 tracks, showcasing his flair for fast-thinking creativity, innovation and improvisation over a more rigid studio approach.\\n\\ncorto.alto’s blistering live shows see him turn band-leader, amongst his crew of hyper-talented musicians – all close friends and frequent collaborators – along with handling bass, synth, trombone and effects.\\n\\nThe ticket price includes a £2 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Southbank Centre.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:11\",\"social_links\":{\"event_share\":\"https://link.dice.fm/e7cbebf8ecf7?dice_id=e7cbebf8ecf7\",\"post_competition_referral\":\"https://link.dice.fm/H4006dd71bdc?dice_id=H4006dd71bdc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e6ea4fd113cd?dice_id=e6ea4fd113cd\",\"post_purchase_referral\":\"https://link.dice.fm/k66709d61434?dice_id=k66709d61434\",\"post_reminder_referral\":\"https://link.dice.fm/t3e268473548?dice_id=t3e268473548\",\"post_waitinglist_referral\":\"https://link.dice.fm/H3bca51b4710?dice_id=H3bca51b4710\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-03-12T06:00:00+00:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-03-15T20:00:00+00:00\",\"event_end_date\":\"2026-03-15T21:30:00+00:00\",\"is_multi_days_event\