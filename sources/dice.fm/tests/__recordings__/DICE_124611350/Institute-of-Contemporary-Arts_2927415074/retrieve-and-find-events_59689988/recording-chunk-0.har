tition_referral\":\"https://link.dice.fm/M415b4e07aff?dice_id=M415b4e07aff\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V6f43603d7f8?dice_id=V6f43603d7f8\",\"post_purchase_referral\":\"https://link.dice.fm/u720e3763b06?dice_id=u720e3763b06\",\"post_reminder_referral\":\"https://link.dice.fm/m3526c002278?dice_id=m3526c002278\",\"post_waitinglist_referral\":\"https://link.dice.fm/t102005bd826?dice_id=t102005bd826\"},\"perm_name\":\"92xv8d-the-boojums-1st-apr-the-waiting-room-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-12/8bd253f0-944c-456e-bd22-f0441ca56c63.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-12/8bd253f0-944c-456e-bd22-f0441ca56c63.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-12/8bd253f0-944c-456e-bd22-f0441ca56c63.jpg?rect=675%2C0%2C1650%2C3000\"},\"properties\":[],\"about\":{\"description\":\"***THE BOOJUMS -*** Formed in 2024, The Boojums have quickly built a reputation for their refreshingly raw and unfiltered sound—equal parts nostalgic and forward-looking. Recorded live off the floor, their debut album channels themes of small-town escape, personal reckoning, and full-throttle freedom.\\n\\n***M. Woodroe*** - moody alternative band who has quickly shot out of the local DIY scene in Brighton to gain a reputation as one of the city's exciting emerging acts.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch.\\n\\n***Note: 18+ ID required.*** These events frequently sell out so we recommend buying tickets in advance.\\n\\n***Refunds:*** Tickets are for the full event and not for individual artists. If an artist cancels your tickets are still valid for the event. We cannot offer refunds.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69369ddbc2a1990001f7b79e\",\"name\":\"The Boojums\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Boojums\",\"image\":null,\"artist_id\":\"113638\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T09:00:00+00:00\",\"sale_end_date\":\"2026-04-01T19:00:00+01:00\",\"sale_start_date\":\"2025-12-03T09:00:00+00:00\",\"event_start_date\":\"2026-04-01T19:00:00+01:00\",\"event_end_date\":\"2026-04-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"seating\":null,\"announcement_date_unix\":1764752400,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-01T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:68\",\"date_unix\":1775066400,\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/ae23bb5d663e?dice_id=ae23bb5d663e\",\"post_competition_referral\":\"https://link.dice.fm/Ta24d839e715?dice_id=Ta24d839e715\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b40660b6dae3?dice_id=b40660b6dae3\",\"post_purchase_referral\":\"https://link.dice.fm/odf84bff24f0?dice_id=odf84bff24f0\",\"post_reminder_referral\":\"https://link.dice.fm/I3fb17224d39?dice_id=I3fb17224d39\",\"post_waitinglist_referral\":\"https://link.dice.fm/X978812db536?dice_id=X978812db536\"},\"perm_name\":\"oeqwdg-independance-1st-apr-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=875%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=125%2C0%2C3750%2C2250\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=1381%2C0%2C1238%2C2250\"},\"properties\":[],\"about\":{\"description\":\"Independence project & Clubs provide a multitude of activities so that people can participate in new experiences and in things that they enjoy.\\n\\nFrom our own research we learned that previous live music events in Chelmsford that supported the learning disability community had all ceased, certainly club nights are just not happening. We've sprung into action to make a change.\\n\\nIndepenDANCE was born! We've partnered with Eazee Learning & Hot Box. Both organisations share our ethos and always go the extra mile whilst making a difference in their communities, so it’s the perfect match!\\n\\nWe are excited and hopeful that we will create a real buzz around these nights. Ultimately enabling people with additional needs the opportunity to let their hair down, meet friends & have a DANCE!\\n\\nThis is carried out in a safe environment with staff on hand to support; those attending will enjoy their night with the confidence that there are people around them that are there to help.\\n\\nOur music acts will be showcasing the superb talent within the additional needs community and the DJs providing the entertainment also have additional needs, playing the best in House, UK garage, R&B, Decades, theme nights and Club Classics.\\n\\nWe are hopeful to put on many live music events in the future and they will always be run like any other club night, promoting inclusion and diversity, and enabling people to enjoy real life experiences. Please spread the message and help us to make them a success. Let's Go!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6930af53162a01000140ff46\",\"name\":\"Independance\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The O'Jays - I Love Music (A Tom Moulton Mix)\",\"redirect_url\":\"https://music.apple.com/us/album/i-love-music-a-tom-moulton-mix/901402450?i=901402465&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The O'Jays\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/c6/00/ef/c600eff8-0c4a-d9d9-455e-bef5ea0274b4/mzaf_14733497146889174381.plus.aac.p.m4a\",\"track_name\":\"I Love Music (A Tom Moulton Mix)\"},{\"type