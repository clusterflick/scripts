\"https://link.dice.fm/r8c0dc12fab0?dice_id=r8c0dc12fab0\",\"post_competition_referral\":\"https://link.dice.fm/S80c05012114?dice_id=S80c05012114\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ra0300a28ba6?dice_id=ra0300a28ba6\",\"post_purchase_referral\":\"https://link.dice.fm/D7d20a26ea57?dice_id=D7d20a26ea57\",\"post_waitinglist_referral\":\"https://link.dice.fm/Fcdd72c2f064?dice_id=Fcdd72c2f064\",\"post_reminder_referral\":\"https://link.dice.fm/z6c0c9611345?dice_id=z6c0c9611345\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-24T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Hear Ocean Songs - a new album merging ambient, contemporary classical, jazz and rock music - performed live, take home a free signed album, and chat to the artists. Our exciting cross-genre line-up features Lottie P (Goat Girl), Steve Pretty (Hackney Colliery Band), Colin Riley (composer) and Nic Pendlebury (Smith Quartet). Full of unusual sounds - conch shells, electronically manipulated vocals and trumpets, bowed wine glasses and electric viola.\\n\\nCommissioned by Royal Museums Greenwich and First Light Festival, this “docu-pop” project celebrates our oceans with a selection of songs about whales, waves, myths and climate, with recorded spoken-word contributions from oceanographer Helen Czerski and broadcaster George Monbiot.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:62\",\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"presented_by\":\"Presented by Theatreship.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1770940800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T00:00:00+00:00\",\"sale_end_date\":\"2026-03-24T22:00:00+00:00\",\"sale_start_date\":\"2026-02-13T00:00:00+00:00\",\"event_start_date\":\"2026-03-24T19:30:00+00:00\",\"event_end_date\":\"2026-03-24T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"698f3c0c68765d0001a04ae5\",\"name\":\"Guest Event: Ocean Songs Launch Party\",\"price\":{\"currency\":\"GBP\",\"amount\":927,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[{\"id\":76730,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"l89vrx-fool-two-hands-will-reach-out-coma-fields-24th-mar-the-shacklewell-arms-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774380600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/ef53e3c6-0e3d-4500-801c-8bee63a72eb4.jpg?rect=0%2C0%2C770%2C770\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/ef53e3c6-0e3d-4500-801c-8bee63a72eb4.jpg?rect=0%2C154%2C770%2C462\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/ef53e3c6-0e3d-4500-801c-8bee63a72eb4.jpg?rect=173%2C0%2C424%2C770\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/jeccb32888e5?dice_id=jeccb32888e5\",\"post_competition_referral\":\"https://link.dice.fm/d6cc8f0f32d2?dice_id=d6cc8f0f32d2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/kde8fd7f2c24?dice_id=kde8fd7f2c24\",\"post_purchase_referral\":\"https://link.dice.fm/U04b36ebffc9?dice_id=U04b36ebffc9\",\"post_waitinglist_referral\":\"https://link.dice.fm/U57b7d6ff244?dice_id=U57b7d6ff244\",\"post_reminder_referral\":\"https://link.dice.fm/s9d21267c6e6?dice_id=s9d21267c6e6\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"10\",\"name\":\"The Shacklewell Arms\",\"address\":\"71 Shacklewell Lane, London E8 2EB\