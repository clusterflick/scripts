/AudioPreview211/v4/1e/21/03/1e21039f-1abd-b66e-da96-42cd2df3f238/mzaf_2649827075247185158.plus.aac.p.m4a\",\"track_name\":\"Personal Jesus\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764115200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Following on from a packed out debut in 2025 at Camden’s iconic Electric Ballroom we are pleased to announce the return on THE DEVOUT to the venue on Saturday 5th September 2026.\\n\\nThe UK’s best loved Depeche Mode Tribute Act, The Devout, have brought the Depeche Mode experience to another level visually, aurally and musically.\\n\\nIn 2026, the band are embarking on their European Black Celebration Tour.. A concert lasting over 2 hours 30 mins, filled with hits, fan favourites but with a nod to the 40th Anniversary of the legendary Black Celebration album.\\n\\nThe band members are made up of well known artists in their own right.\\n\\nReza Udhin (Killing Joke, Inertia, Black Volition)\\n\\nKeith Trigwell (Speak & Spell, Form)\\n\\nBarclay Quarton (The Doors Experience)\\n\\nThe Devout’s show transports the audience back to a Depeche Mode concert, at their peak with authentic reproductions of the songs together with astounding visuals, that take the audience back to those great innovative tours.\\n\\nWith sell out concerts, show after show.. the band’s following “Just Can’t Get Enough” of this experience!\\n\\nThis event is 14 and over. 14s to 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Pad Presents.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:43\",\"social_links\":{\"event_share\":\"https://link.dice.fm/ncbb2dbb8227?dice_id=ncbb2dbb8227\",\"post_competition_referral\":\"https://link.dice.fm/Mb8efd3a7071?dice_id=Mb8efd3a7071\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z28cd5eb16cb?dice_id=Z28cd5eb16cb\",\"post_purchase_referral\":\"https://link.dice.fm/Jbbfa4de2719?dice_id=Jbbfa4de2719\",\"post_reminder_referral\":\"https://link.dice.fm/P453a202bb4d?dice_id=P453a202bb4d\",\"post_waitinglist_referral\":\"https://link.dice.fm/bed19f47d4c8?dice_id=bed19f47d4c8\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T00:00:00+00:00\",\"sale_end_date\":\"2026-09-05T17:00:00+01:00\",\"sale_start_date\":\"2025-11-26T00:00:00+00:00\",\"event_start_date\":\"2026-09-05T19:30:00+01:00\",\"event_end_date\":\"2026-09-05T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2163,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"14332\",\"name\":\"The Pad Presents\",\"image\":{\"url\":null},\"perm_name\":\"the-pad-presents-nvlp3\",\"profile_active\":false},\"id\":\"69272a9fd7d5410001ce2a86\",\"seats_io_event_id\":null,\"name\":\"The Devout\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"2w7d9a-the-devout-5th-sep-electric-ballroom-london-tickets\",\"date_unix\":1788633000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 05 Sep\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-06T15:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/937da01a-3a53-44e0-81b3-006f11db4130.jpg?rect=0%2C0%2C797%2C797\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/937da01a-3a53-44e0-81b3-006f11db4130.jpg?rect=0%2C346%2C797%2C478\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/937da01a-3a53-44e0-81b3-006f11db4130.jpg?rect=77%2C0%2C643%2C1169\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Leavin' Trunk - Claw Hammer\",\"redirect_url\":\"https://music.apple.com/us/album/claw-hammer/1783727850?i=1783727852&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Leavin' Trunk\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/fc/59/59/fc5959cd-2560-29b7-9de0-17f83123e3cb/mzaf_1004524564569327322.plus.aac.p.m4a\",\"track_name\":\"Claw Hammer\"},{\"type\":\"spotify\",\"title\":\"Leavin' Trunk - Claw Hammer\",\"redirect_url\":\"https://open.spotify.com/track/0Ww3Tdi9OmHfQ3Lgfx1RzJ\",\"artist\":\"Leavin' Trunk\",\"preview_url\":\"https://p.scdn.co/mp3-preview/15cccc8646b1ac728382a410df4e90f1bfb5e54a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Claw Hammer\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764547200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"LEAVIN’ TRUNK is the latest exciting venture by five great musicians & entertainers already familiar to many with a working knowledge of the UK blues scene.\\n\\nA powerful, funky groove, infused with a scintilla of New Orleans gumbo; & some great tunes - band originals and re-interpretations of wonderful old songs from all sorts of obscure corners of the blues & soul catalogue. We defy you NOT to dance to this band!\\n\\nFrontman Tim Aves has led a series of great bands, including Essex r’n’b rockers Automatic Slim, Texas blues outfit The Rockin’ Armadillos & the Howlin’ Wolf-inspired Tim Aves & WOLFPACK.\\n\\nOn bass is Rob “Tank” Barry, a musician whose dedication to the groove has also earned him stage time with UK Blues Challenge winners LaVendore Rogue, Hokie Joint, Ian Siegal, Jon Amor, much-loved Californian bluesman Lightnin’ Willie & Jose Ramirez, among others.\\n\\nDrummer John Butters is the driving force behind a succession of legendary bands since the 1970s, including The Mean Red Spiders, The Groove Doctors and most recently, Blues Situation.\\n\\nOn Guitar is Craig Fillbrook via Blues Situation, Voodoo Bones & the Rhythm Boys & on the blues circuit with the Mark Sharpe Blues Band & Giles King’s Goofa Dust.\\n\\nFinally, the ace up the Leavin’ Card sleeve is Adam Whyatt, whose classy, soulful keyboards have graced many excellent bands, including The Shaboogamoo Shufflers, The Midnight Specials, Papa Rocksy, South of the Border & the Bluesome Twosome (with New Orleans' Nolan Wiltz).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Black Frog\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:44\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Cd378facbd9d?dice_id=Cd378facbd9d\",\"post_competition_referral\":\"https://link.dice.fm/ja7dac19e3d7?dice_id=ja7dac19e3d7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b9aa821a79be?dice_id=b9aa821a79be\",\"post_purchase_referral\":\"https://link.dice.fm/Af26fd45b0e0?dice_id=Af26fd45b0e0\",\"post_reminder_referral\":\"https://link.dice.fm/l76f532136ce?dice_id=l76f532136ce\",\"post_waitinglist_referral\":\"https://link.dice.fm/wa2354d9db6e?dice_id=wa2354d9db6e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:00:00+00:00\",\"sale_end_date\":\"2026-09-06T15:00:00+01:00\",\"sale_start_date\":\"2025-12-01T00:00:00+00:00\",\"event_start_date\":\"2026-09-06T15:00:00+01:00\",\"event_end_date\":\"2026-09-06T20:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"692e26a24c69ef000136e5d5\",\"seats_io_event_id\":null,\"name\":\"Leavin' Trunk\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"pyranl-leavin-trunk-6th-sep-hot-box-chelmsford-tickets\",\"date_unix\":1788703200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3060\",\"name\":\"The Bread and Roses\",\"address\":\"The Bread and Roses, 68 Clapham Manor St, Clapham Common SW4 6DZ\",\"location\":{\"