_enabled\",\"hours\":24},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2434,\"name\":\"The Corbyn Project\",\"privacy_policy_link\":\"https://thecorbynproject.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":true,\"date_unix\":1780592400,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:67\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2931},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/c068e97d-bf2b-46d7-9217-9210ad8230f1.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/c068e97d-bf2b-46d7-9217-9210ad8230f1.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/c068e97d-bf2b-46d7-9217-9210ad8230f1.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"6985bcf0726fc70001d6dbcd\",\"name\":\" Bulletproof Festival: Maruja\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"This event will take place in EartH Hall.\\n\\nA new multi-venue music festival taking place in London from 4-6 June 2026, featuring Maruja, SPRINTS, Pussy Riot:Riot Days and many more.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T16:00:00+00:00\",\"sale_end_date\":\"2026-06-04T21:00:00+01:00\",\"sale_start_date\":\"2026-02-11T11:00:00+00:00\",\"event_start_date\":\"2026-06-04T18:00:00+01:00\",\"event_end_date\":\"2026-06-04T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Blind Spot\",\"redirect_url\":\"https://open.spotify.com/track/3WGcg3U8eAUg0MnUIVf3Ky\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/57a5d613c64cdd9628065126a2d249b79cd8ab0e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Blind Spot\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sugar\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-03/fd81e611-ece0-4b27-b369-68c88e1cffa9.jpg?rect=167%2C0%2C666%2C666\"},\"artist_id\":\"128291\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Clapham Grand.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"max_tickets\":8,\"properties\":[],\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-04T18:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"announcement_date_unix\":1769004000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Qc0ea3b11fa9?dice_id=Qc0ea3b11fa9\",\"post_competition_referral\":\"https://link.dice.fm/Sfcc67ca5b5c?dice_id=Sfcc67ca5b5c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/hffeaaa6f466?dice_id=hffeaaa6f466\",\"post_purchase_referral\":\"https://link.dice.fm/A13d5dbfd4fa?dice_id=A13d5dbfd4fa\",\"post_reminder_referral\":\"https://link.dice.fm/p12476de1257?dice_id=p12476de1257\",\"post_waitinglist_referral\":\"https://link.dice.fm/O4a8d3bd7ec2?dice_id=O4a8d3bd7ec2\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"3oggep-sugar-4th-jun-the-clapham-grand-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780594200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:68\",\"price\":{\"currency\":\"GBP\",\"amount\":7129,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/59e594e5-d2db-460b-aeb4-50ecd20766e9.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/59e594e5-d2db-460b-aeb4-50ecd20766e9.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/59e594e5-d2db-460b-aeb4-50ecd20766e9.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"696fa3826b08a40001a67a3f\",\"name\":\"SUGAR\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**THURSDAY 4TH JUNE / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. ONE HOUR AFTER DOORS / SHOW ENDS APPROX. 10:30PM**\\n\\n**This is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)**\\n\\n**SUGAR has partnered with PLUS1 so that £2 from every ticket sold will go to organizations working to support and empower the health and wellbeing of LGBTQ+ communities. www.plus1.org**\\n\\nHaving already placed his indelible mark on modern music with **Hüsker Dü** and solo album ***Workbook***, **Bob Mould** enlisted bassist **David Barbe** and drummer **Malcolm Travis** leading to the formation of **SUGAR**, who made their live debut in early 1992 at Athens, GA’s famed **40 Watt Club**. Named by ***NME*** as its 1992 **Album of the Year**, SUGAR’s now-classic debut album, ***Copper Blue***, immediately proved a sensation, earning worldwide acclaim and landmark status for the melodic strength and intensely cathartic popcraft of songs like **'A Good Idea'**, **'Helpless'**, and the alternative rock radio hit and ***MTV* favourite**, **'If I Can’t Change Your Mind'**. The trio quickly found themselves performing on increasingly larger stages, including a legendary show-stealing set at London’s **Great X-pectations Festival** in Finsbury Park.\\n\\nWith the wind at their back, SUGAR unleashed ***Beaster*** in 1993, making a momentous debut at #3 on the UK’s **Official Albums Chart** as well as at #4 on **Billboard’s Heatseekers** chart in the US. Though recorded during the same sessions that yielded Copper Blue, the six-song mini-album evinced a more visceral energy and dark melancholy than its predecessor, highlighted by such pulverising expressions of sacrilegious fury as '**Judas Cradle**' and '**JC Auto**'. 1994’s second full-length LP, ***File Under: Easy Listening*** once again made an explosive arrival among the **top 10** on the **UK Official Albums Chart**, this time landing in the upper reaches of the overall **Billboard 200.** The album saw SUGAR pushing boundaries yet again on songs like the Americana-tinged '**Believe What You’re Saying**' and the incendiary '**Gee Angel**', tackling a wider range of musical approaches without sacrificing their signature intensity and unrestrained power. Despite their successes, SUGAR called it a day following a Japanese tour in early 1995. A series of live recordings, reissues, and anthologies served to magnify the band’s legacy over the three decades since, confirming SUGAR as incontrovertible masters of high-volume guitar-fuelled rock for the ages. The original members of SUGAR reconvened in June 2025 to record '**House Of Dead Memories**' & '**Long Live Love'**, the first new SUGAR songs in over three decades.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must accompanied by an adult 21+ (max. 2 U18s per adult 21+)\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T14:00:00+00:00\",\"sale_end_date\":\"2026-06-04T18:30:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-06-04T18:30:00+01:00\",\"event_end_date\":\"2026-06-04T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dreamers’ Circus\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb2365821dda0d57f3b2ef50f9\"},\"artist_id\":\"130728\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DMP and Fire in the Mountain Festival LTD.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-04T18:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"announcement_date_unix\":1764239400,\"social_links\":{\"event_share\":\"https://link.dice.fm/Na8bc8352510?dice_id=Na8bc8352510\",\"post_competition_referral\":\"https://link.dice.fm/U95d9480d2b2?dice_id=U95d9480d2b2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ee9033aad361?dice_id=ee9033aad361\",\"post_purchase_referral\":\"https://link.dice.fm/ed8c13bd1370?dice_id=ed8c13bd1370\",\"post_reminder_referral\":\"https://link.dice.fm/c37439f7189e?dice_id=c37439f7189e\",\"post_waitinglist_referral\":\"https://link.dice.fm/E469e64521a2?dice_id=E469e64521a2\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"6dwqw2-dreamers-circus-and-duo-ruut-4th-jun-union-chapel-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780594200,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:69\",\"price\":{\"currency\":\"GBP\",\"amount\":2809,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/0462fd42-ba9a-447a-9f28-45b9b7c5e75d.jpg?rect=0%2C2%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/0462fd42-ba9a-447a-9f28-45b9b7c5e75d.jpg?rect=0%2C502%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/0462fd42-ba9a-447a-9f28-45b9b7c5e75d.jpg?rect=562%2C0%2C1377%2C2503\"},\"id\":\"692853d693485f0001d37f6d\",\"name\":\"Dreamers' Circus and Duo Ruut\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"*DMP and Fire in the Mountain Present....***  \\n  \\nDREAMERS’ CIRCUS**  \\n*World-class new Nordic music*\\n\\nDreamers’ Circus is one of the most acclaimed and adventurous acoustic bands in the Nordic region. Blending Nordic folk with classical lyricism, jazz improvisation, and pop energy, the trio creates a sound that is both rooted and forward-looking.\\n\\nSince forming in Copenhagen, the group – Nikolaj Busk (piano, accordion), Rune Tonsgaard Sørensen (violin), and Ale Carr (cittern) – has released seven albums, toured internationally, and earned major awards including recognition as a “Special Ensemble” by the Danish Arts Foundation.\\n\\nWith backgrounds spanning folk, classical, and jazz, they bring virtuosity and imagination to every performance. Their latest album Handed On reflects on their musical heritage, while their dynamic live shows showcase the playful joy and precision that define their unique sound.\\n\\n*“They’re world class. Now the world needs to hear them.”* — **Sing Out**\\n\\n*Support Act:* \\\\*\\\\*Duo Ruut\\n\\nDuo Ruut's\\\\*\\\\* sound is based on the common ground that two young Estonian musicians and songwriters, Ann-Lisett Rebane and Katariina Kivi have explored since coming together in 2017.\\n\\nTheir sound ties together a single Estonian zither and two distinct voices. Inspired by the traditions of their Estonian heritage, they draw influence from both the beliefs of different cultures and their own contemporary and emotive songwriting.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T10:30:00+00:00\",\"sale_end_date\":\"2026-06-04T18:00:00+01:00\",\"sale_start_date\":\"2025-11-27T11:45:00+00:00\",\"event_start_date\":\"2026-06-04T18:30:00+01:00\",\"event_end_date\":\"2026-06-04T23:00