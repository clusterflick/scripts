romoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"announcement_date_unix\":1764201600,\"social_links\":{\"event_share\":\"https://link.dice.fm/udeb0b52d132?dice_id=udeb0b52d132\",\"post_competition_referral\":\"https://link.dice.fm/Yf1f9e4c680e?dice_id=Yf1f9e4c680e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Kead77208d0c?dice_id=Kead77208d0c\",\"post_purchase_referral\":\"https://link.dice.fm/g7ff4b2aa8ea?dice_id=g7ff4b2aa8ea\",\"post_reminder_referral\":\"https://link.dice.fm/Rd9e5cfbe394?dice_id=Rd9e5cfbe394\",\"post_waitinglist_referral\":\"https://link.dice.fm/Yfe1417da2d4?dice_id=Yfe1417da2d4\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eobqbw-black-orchid-empire-31st-may-new-cross-inn-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780246800,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:53\",\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/58fa53d3-8863-4ad9-9447-4dee61c68c40.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/58fa53d3-8863-4ad9-9447-4dee61c68c40.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/58fa53d3-8863-4ad9-9447-4dee61c68c40.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"69283c0df940a40001e61b84\",\"name\":\"Black Orchid Empire\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Black Orchid Empire\\n\\nBLACK ORCHID EMPIRE create huge, memorable rock music that combines heavy-hitting savagery with intense melodic beauty.\\n\\nTheir technical, fearlessly complex grooves and gigantic sing-along choruses have already earned them a widespread fanbase.\\n\\nA ferociously tight live band, BLACK ORCHID EMPIRE have toured Europe and the UK extensively, supporting Skunk Anansie, HED P.E, INME, Cellar Darling and Black Map as well as festival slots at Download, Standon Calling, Tech Fest, Teddy Rocks and Planet Rockstock.\\n\\nFollowing on from album releases with Long Branch Records and Season Of Mist, the band recently signed with Year Of The Rat Records landing support from BBC Radio 1, Spotify and Kerrang and released their fourth single ‘The Labyrinth’ on 7th November 2025.\\n\\nhttps://blackorchidempire.com/\\n\\n\\\\+ supports\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T00:00:00+00:00\",\"sale_end_date\":\"2026-05-29T17:00:00+01:00\",\"sale_start_date\":\"2025-11-27T00:00:00+00:00\",\"event_start_date\":\"2026-05-31T18:00:00+01:00\",\"event_end_date\":\"2026-05-31T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Marta Del Grandi\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-11-23/240c7834-8354-4061-8045-972af83ec7fd.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"57119\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Citizen Live.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"8761\",\"name\":\"The Social\",\"address\":\"5 Little Portland Street, Westminster, London, W1W 7JA, United Kingdom\",\"location\":{\"lat\":51.51719,\"lng\":-0.141157},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-social-rnvy\",\"accessibility\":{\"url\":\"https://www.thesocial.com/access/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-31T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"11372\",\"name\":\"Citizen Live\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-07-04/3986ab94-e1cf-489e-95df-450093b12e1c.jpg\"},\"perm_name\":\"citizen-live-6al8\",\"profile_active\":true},\"announcement_date_unix\":1770721200,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ib7efe23c8f6?dice_id=Ib7efe23c8f6\",\"post_competition_referral\":\"https://link.dice.fm/K1be1cacd5f3?dice_id=K1be1cacd5f3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jb8c8aadcb79?dice_id=jb8c8aadcb79\",\"post_purchase_referral\":\"https://link.dice.fm/w0dec8297ba7?dice_id=w0dec8297ba7\",\"post_reminder_referral\":\"https://link.dice.fm/pa230ed3476a?dice_id=pa230ed3476a\",\"post_waitinglist_referral\":\"https://link.dice.fm/z5ae9604f692?dice_id=z5ae9604f692\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"g5m9pb-marta-del-grandi-31st-may-the-social-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780250400,\"has_multiple_ticket_types\":true,\"impression_id\":\"55e67ca3ba9827ff:54\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1950},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-06/44d5a8da-db09-4f6e-b773-7b8b13ec5844.jpg?rect=0%2C0%2C1024%2C1024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-06/44d5a8da-db09-4f6e-b773-7b8b13ec5844.jpg?rect=0%2C205%2C1024%2C614\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-06/44d5a8da-db09-4f6e-b773-7b8b13ec5844.jpg?rect=231%2C0%2C563%2C1024\"},\"id\":\"6989ae1bd98d12000186e281\",\"name\":\"Marta Del Grandi\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Marta Del Grandi is a Milan-based singer-songwriter. A musician with a jazz background, she studied at the G. Verdi Conservatory in Milan and in Belgium at the Royal Conservatory of Ghent. Guided by a strong passion for travel and for discovering different places and cultures, she later moved first to China for a short period and then to Nepal, where she spent two and a half years in Kathmandu. Living in such a different place and gaining a deep understanding of it greatly influenced her worldview and, consequently, the music and lyrics she wrote for her solo debut Until We Fossilize (2021). Released on the British label Fire Records, the album is an avant-pop work that blends folk-rock idioms, Lynchian atmospheres, and cinematic arrangements reminiscent of Ennio Morricone’s film scores. In 2023, this was followed by Selva (Fire Records), which was acclaimed by both audiences and critics, placing her among the most prominent emerging talents on the national scene. Her latest work, Dream Life, is set for release on January 30 via Fire Records.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T11:00:00+00:00\",\"sale_end_date\":\"2026-05-31T19:00:00+01:00\",\"sale_start_date\":\"2026-02-10T11:00:00+00:00\",\"event_start_date\":\"2026-05-31T19:00:00+01:00\",\"event_end_date\":\"2026-05-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Shy Heart\",\"redirect_url\":\"https://open.spotify.com/track/0anPYWVzJQVb831KO8nWuz\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/bf5f1342f82112356c28347f849e173125fbe1ed?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Shy Heart\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Patrick Sweany\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-04-27/96cbe1d1-5a56-4d6c-83dc-8752a89cd72d.jpg?rect=0%2C106%2C428%2C428\"},\"artist_id\":\"73635\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DHP FAMILY.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":71661,\"title\":\"Accessibility\",\"body\":\"The Grace has 12 steps into the venue, with no disabled toilet. There is no accessible area inside the venue. Companion ticket for someone to assist them up the stairs and to the toilet & early access available.\\n\\nDirect contact: accessibility@thegarage.london\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-