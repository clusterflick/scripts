nk.dice.fm/ua9cef1d26c7?dice_id=ua9cef1d26c7\",\"post_competition_referral\":\"https://link.dice.fm/Secf36cedbb7?dice_id=Secf36cedbb7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Aa4315e88a31?dice_id=Aa4315e88a31\",\"post_purchase_referral\":\"https://link.dice.fm/f270a3433d0a?dice_id=f270a3433d0a\",\"post_reminder_referral\":\"https://link.dice.fm/Qcc16b4bfa37?dice_id=Qcc16b4bfa37\",\"post_waitinglist_referral\":\"https://link.dice.fm/x331d100f166?dice_id=x331d100f166\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T09:00:00+00:00\",\"sale_end_date\":\"2026-02-28T14:15:00+00:00\",\"sale_start_date\":\"2025-11-28T09:00:00+00:00\",\"event_start_date\":\"2026-02-28T14:00:00+00:00\",\"event_end_date\":\"2026-02-28T15:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":309},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"68f228e18aafe3000177ccd7\",\"seats_io_event_id\":null,\"name\":\"Time Flash\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"53xq98-time-flash-28th-feb-the-obie-theatre-the-brit-school-london-tickets\",\"date_unix\":1772287200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"15810\",\"name\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768327200,\"max_tickets\":100,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by House of Burlesque.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:16\",\"social_links\":{\"event_share\":\"https://link.dice.fm/A63d18fff919?dice_id=A63d18fff919\",\"post_competition_referral\":\"https://link.dice.fm/wd6d6dddba9d?dice_id=wd6d6dddba9d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/U5ef2a27426c?dice_id=U5ef2a27426c\",\"post_purchase_referral\":\"https://link.dice.fm/i4adb1630271?dice_id=i4adb1630271\",\"post_reminder_referral\":\"https://link.dice.fm/Raaa88b381eb?dice_id=Raaa88b381eb\",\"post_waitinglist_referral\":\"https://link.dice.fm/Xa552695721f?dice_id=Xa552695721f\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T18:00:00+00:00\",\"sale_end_date\":\"2026-02-28T15:00:00+00:00\",\"sale_start_date\":\"2026-01-14T11:00:00+00:00\",\"event_start_date\":\"2026-02-28T18:00:00+00:00\",\"event_end_date\":\"2026-02-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2035},\"properties\":[],\"billing_promoter\":{\"id\":\"2924\",\"name\":\"House of Burlesque\",\"image\":{\"url\":null},\"perm_name\":\"house-of-burlesque-6pd8\",\"profile_active\":false},\"id\":\"6966732be0f5310001759453\",\"seats_io_event_id\":null,\"name\":\"House of Burlesque Speakeasy \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"g5dr72-house-of-burlesque-speakeasy-28th-feb-qt-london-tickets\",\"date_unix\":1772301600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 28 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/7bdf3896-9ca5-4a4b-b376-dcc101e9e38d.jpg?rect=0%2C0%2C4096%2C4096\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/7bdf3896-9ca5-4a4b-b376-dcc101e9e38d.jpg?rect=0%2C819%2C4096%2C2458\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/7bdf3896-9ca5-4a4b-b376-dcc101e9e38d.jpg?rect=922%2C0%2C2253%2C4096\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Alala - Dr Who Theme (Epic Version)\",\"redirect_url\":\"https://music.apple.com/us/album/dr-who-theme-epic-version/1336552926?i=1336553434&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alala\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/b2/90/8c/b2908c37-5cd3-6b1e-3e43-c987ba3bf8a0/mzaf_2602961328776739711.plus.aac.p.m4a\",\"track_name\":\"Dr Who Theme (Epic Version)\"},{\"type\":\"spotify\",\"title\":\"Mount Royal Orchestra - Dr. Who Theme Song\",\"redirect_url\":\"https://open.spotify.com/track/05qpEZ1yTXieCtvS7CmUQ9\",\"artist\":\"Mount Royal Orchestra\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8bbcb0e8faef6ead81c0357d75476375447a181e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dr. Who Theme Song\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768759200,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**FRIDAY 6TH MARCH / DOORS & BARS OPEN 6.30PM / SHOW STARTS APPROX 7:45PM / SHOW ENDS APPROX 10.30PM / INTERGALACTIC DISCO ENDS 1:00AM / 18+**\\n\\n**Are you ready for the adventure of a lifetime?**\\n\\n**Then take our hands and ALLONS-LGBT!! 🏳️‍🌈🏳️‍⚧️✨**\\n\\nOur first epic show of 2026 is materialising this March at the magnificent Clapham Grand!\\n\\nPrepare for another amazing adventure aboard our legendary LGBTQ+ARDIS, featuring extraterrestrial entertainment from our interstellar line-up, plenty of surprises, and all the cosmic campery you could dream of… all inspired by the greatest show in the galaxy: DOCTOR WHO!\\n\\n*(Full lineup to be announced in time, keep your eye-stalks on @gallifreycabaret on Insta / @gallycab on Bluesky)*\\n\\nPlus! because we're landing on a FRIDAY NIGHT, you’d best believe we’re gunna keep the fun going 'til the early hours. We’ll have interdimensional DJs, galactic go-gos and queer cosmic bangers playing nonstop after the main show ends, so let's \\\\*\\\\*EXTERMINATE THE DANCEFLOOR!!\\\\*\\\\* Doctor's orders ;)\\n\\nAnd that's not all...\\n\\n**CHARITY RAFFLE** with amazing Who-themed prizes\\n\\n**COSTUME PARADE** feat. a special guest judge and grand prize\\n\\n**MERCH** from our lil corner of the cosmos to yours x\\n\\ndid we mention **SURPRISES..?** ;)\\n\\nSo! Strap on your vortex manipulators... Sonic your screwdrivers... Prepare your wibbly-wobblies for a timey-wiming...\\n\\nBecause when you have all of Time and Space - - *ANYTHING COULD HAPPEN..!! 🥳💫*\\n\\nDISCLAIMER: this is an unofficial fan event, not affiliated with the official Doctor Who brand (even tho we love them very very much xoxox)\\n\\n**Important information:**\\n\\nFor any ticketing enquiries, please contact DICE via their Help Desk. For any information about the show, accessibility or timings, please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question\\n\\nCheck out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:17\",\"social_links\":{\"event_share\":\"https://link.dice.fm/D0d54e92b57f?dice_id=D0d54e92b57f\",\"post_competition_referral\":\"https://link.dice.fm/pe9ed512945e?dice_id=pe9ed512945e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C9c49e3abed7?dice_id=C9c49e3abed7\",\"post_purchase_referral\":\"https://link.dice.fm/hef7b69f83e5?dice_id=hef7b69f83e5\",\"post_reminder_referral\":\"https://link.dice.fm/U239bd619d24?dice_id=U239bd619d24\",\"post_waitinglist_referral\":\"https://link.dice.fm/rd4c9a930654?dice_id=rd4c9a930654\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-18T18:00:00+00:00\",\"sale_end_date\":\"2026-03-06T18:30:00+00:00\",\"sale_start_date\":\"2026-01-18T18:30:00+00:00\",\"event_start_date\":\"2026-03-06T18:30:00+00:00\",\"event_end_date\":\"2026-03-07T01:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1351},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"696a25a42971ef00016ecaee\",\"seats_io_event_id\":null,\"name\":\"The Gallifrey Cabaret \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"dk386e-the-gallifrey-cabaret-6th-mar-the-clapham-grand-london-tickets\",\"date_unix\":1772821800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"7425\",\"name\":\"Big Penny Social\",\"address\":\"1 Priestley Way, London E17 6AL, UK\",\"location\":{\"lat\":51.59085509999999,\"lng\":-0.04131809999999999},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-09-15/018322b6-65c3-40f9-851e-9d09dfa35252.jpg?rect=0%2C0%2C1000%2C1000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"big-penny-social-ayxd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"faqs\":[{\"id\":60264,\"title\":\"I have a group booking of seated tickets, is there a way we can sit together?\",\"body\":\"Although our seating is unassigned if you have a group booking of THREE or more we'll automatically reserve your seats together for you!\\n\\nIf your group purchased tickets separately, just email us at: contact@evewrestling.com letting us know the names and number of people in your group and we'll get it sorted\",\"order\":0},{\"id\":60265,\"title\":\"I'm entitled to a Complimentary Carers ticket, how do I go about getting this?\",\"body\":\"Please email us at: contact@evewrestling.com and we'll sort that for you.\",\"order\":1},{\"id\":60266,\"title\":\"What is the age policy?\",\"body\":\"This event is strictly 18+. Nobody under the age of 18 can attend this event, even if accompanied by an adult.\",\"order\":2},{\"id\":60267,\"title\":\"Is there parking onsite?\",\"body\":\"Unfortunately there is no onsite parking.\",\"order\":3},{\"id\":60268,\"title\":\"Is there a content warning for this show?\",\"body\":\"EVE events contain strong language, loud noises and simulated fight scenes throughout which can at times spill into the audience. EVE events include cabaret acts which may be provocative in nature. Flashing lights are used at our events. As such, EVE events may not be suitable for everyone.\",\"order\":4},{\"id\":60269,\"title\":\"Is the venue accessibility friendly?\",\"body\":\"Yes, Big Penny Social is accessibility friendly. If you have any concerns please contact us at: contact@evewrestling.com and we'll be happy to answer and questions or concerns you may have.\",\"order\":5}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-27/d4282697-7b6d-4e94-accb-2cf1b0fe92b9.jpg?rect=1000%2C0%2C4016%2C4016\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-27/d4282697-7b6d-4e94-accb-2cf1b0fe92b9.jpg?rect=0%2C203%2C6016%2C3610\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-27/d4282697-7b6d-4e94-accb-2cf1b0fe92b9.jpg?rect=1904%2C0%2C2209%2C4016\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Shampoo - Trouble\",\"redirect_url\":\"https://open.spotify.com/track/5EQU2jes2sHygS3cFLGuso\",\"artist\":\"Shampoo\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8ccb3dd8053bdc2b419c5e77b251b7396b0f01ee?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Trouble\"},{\"type\":\"apple_music\",\"title\":\"Shampoo - Trouble\",\"redirect_url\":\"https://music.apple.com/us/album/trouble/690736025?i=690736592&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Shampoo\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/17/9e/38/179e3888-d06e-6223-bc8d-0ab4fe00f2be/mzaf_3102298072896786063.plus.aac.p.m4a\",\"track_name\":\"Trouble\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764270000,\"max_tickets\":10,\"marketeers\":[{\"id\":1146,\"name\":\"EVE: Riot Grrrls of Wrestling\",\"privacy_policy_link\":null,\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"On Friday March 6th, EVE presents Women Behaving Badly!\\n\\nThe spectacular, immersive, live action stunt filled world of women's pro-wrestling mixed with neo-burlesque, comedy and more! Now that's an International Women's Day celebration we can get on board with!\\n\\nWomen Behaving Badly will feature international wrestling stars from Japan and Europe, such as Dublin's almost \\\"perma-drunk\\\" Session Moth Martina, & Tokyo bad-ass Miyu Yamashita, plus award-winning neo-burlesque stars Donna Poderosa and Aya L'Storm!\\n\\nCelebrate International Women's Day as your favourite girl gang takes over E17. You bring yourself and we'll bring our critically acclaimed chaos!\\n\\nEVE is produced by the western-world's longest running promoters of this genre, Emily & Dann Read, alongside AEW Star Will Ospreay.\\n\\nDon't just take our word for it - check out what others had to say:\\n\\n\\\"I had one of the funniest, most uplifting nights ever at EVE!\\\" - Kathy Burke, Actor, Comedian and Producer\\n\\n\\\"I brought my sisters and a few friends and we had such an amazing time. Everyone should get to know EVE!” - Netflix GLOW Star & Musician Kate Nash\\n\\n“A clear message of empowerment...And inclusivity” - Red Bulletin\\n\\n“Their athleticism is captivating...I’m in awe!” Women’s Health\\n\\nPlease note this is an 18+ event - no one under the age of 18 can attend this event, accompanied or otherwise. For full terms and conditions and event policies please go to: www.evewrestling.com/policies\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by EVE: Riot Grrrls of Wrestling.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:18\",\"social_links\":{\"event_share\":\"https://link.dice.fm/id04f34bee50?dice_id=id04f34bee50\",\"post_competition_referral\":\"https://link.dice.fm/maf295c9ea0c?dice_id=maf295c9ea0c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n9c2adb0b34a?dice_id=n9c2adb0b34a\",\"post_purchase_referral\":\"https://link.dice.fm/T3a3e788bbff?dice_id=T3a3e788bbff\",\"post_reminder_referral\":\"https://link.dice.fm/F0df9e300330?dice_id=F0df9e300330\",\"post_waitinglist_referral\":\"https://link.dice.fm/B535e62c4976?dice_id=B535e62c4976\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T19:00:00+00:00\",\"sale_end_date\":\"2026-03-06T21:30:00+00:00\",\"sale_start_date\":\"2025-11-27T19:00:00+00:00\",\"event_start_date\":\"2026-03-06T20:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2500},\"properties\":[],\"billing_promoter\":{\"id\":\"13383\",\"name\":\"EVE: Riot Grrrls of Wrestling\",\"image\":{\"url\":null},\"perm_name\":\"eve-riot-grrrls-of-wrestling-wnqr\",\"profile_active\":true},\"id\":\"69289d8635bac90001013e42\",\"seats_io_event_id\":null,\"name\":\"Women Behaving Badly #IWD2026\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"2w7da7-women-behaving-badly-iwd2026-6th-mar-big-penny-social-london-tickets\",\"date_unix\":1772827200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 06 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"14139\",\"name\":\"Balls Brothers Austin Friars\",\"address\":\"10-11 Austin Friars, City of London, London, EC2N 2HG, United Kingdom\",\"location\":{\"lat\":51.51571,\"lng\":-0.08527},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"balls-brothers-austin-friars-mxb5v\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-21/99c997cd-f9e7-45f9-83fd-1e42b19b930b.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1733436900,\"max_tickets\":104,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Darling, are you searching for a drag brunch like no other? Are you craving an afternoon of glittering, prosecco-fuelled, unadulterated drag fabulousness? Well, look no further than Ginger’s Big Drag Brunch– the most camp and outrageous event to grace London’s bottomless brunch scene.\\n\\nHosted by Ms Ginger Phlappage, and her squad of sassy, hilarious brunch queens & kings, Ginger’s Big Drag Brunch brings you a boozy afternoon of drag performances, games, challenges, quizzes and plenty of audience participation, honey!\\n\\nCome prepared for free-flowing Prosecco and a scrummy two course brunch menu, with live DJs playing your favourite dance classics.\\n\\nWith a whole host of fabulous drag queens from across London and beyond performing their most gag-worthy lip-sync numbers, dance extravaganzas and side-splitting comedy skits, guests at Ginger’s Big Drag Brunch will be in for quite the show!\\n\\nVenue: Balls Brothers, Austin Friars– 5 minute walk from Liverpool Street Station.\\n\\n2 course meal and Bottomless Prosecco for 1.5 hrs\\n\\n1-4pm- doors open at 1pm, Prosecco 2pm- 4pm\\n\\nBRUNCH MAINS\\n\\nCheeseburger on a toasted bun w/ French fries Burger garnish\\n\\nAvocado on toast with poached eggs V\\n\\nFalafel & spinach burger with vegan lime yoghurt on a toasted bun with French fries Burger garnish- V VG GF option available on request\\n\\nBRUNCH DESSERT\\n\\nVanilla Cheesecake with raspberry coulis V\\n\\nChocolate Pot with raspberry coulis VG GF DF\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:19\",\"social_links\":{\"event_share\":\"https://link.dice.fm/g784b55e5cf7?dice_id=g784b55e5cf7\",\"post_competition_referral\":\"https://link.dice.fm/t2ac9d45095d?dice_id=t2ac9d45095d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Sb281929ee6f?dice_id=Sb281929ee6f\",\"post_purchase_referral\":\"https://link.dice.fm/qbdecb47f296?dice_id=qbdecb47f296\",\"post_reminder_referral\":\"https://link.dice.fm/s2e3422e6c04?dice_id=s2e3422e6c04\",\"post_waitinglist_referral\":\"https://link.dice.fm/ub491a9d9402?dice_id=ub491a9d9402\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-12-05T22:15:00+00:00\",\"sale_end_date\":\"2026-03-07T12:00:00+00:00\",\"sale_start_date\":\"2024-12-05T22:15:00+00:00\",\"event_start_date\":\"2026-03-07T13:00:00+00:00\",\"event_end_date\":\"2026-03-07T16:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5557},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"6956683aec8c81000111d040\",\"seats_io_event_id\":null,\"name\":\"Ginger's Big Drag Bottomless Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"k6a6ml-gingers-big-drag-bottomless-brunch-7th-mar-balls-brothers-austin-friars-london-tickets\",\"date_unix\":1772888400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"2590\",\"name\":\"Phoenix Arts Club\",\"address\":\"Phoenix St, London WC2H 8BU, UK\",\"location\":{\"lat\":51.5144031,\"lng\":-0.12897139999995488},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"phoenix-arts-club-98pn\",\"accessibility\":{\"url\":\"https://phoenixartsclub.com/about-us/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T13:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=1313%2C0%2C3375%2C3375\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=188%2C0%2C5625%2C3375\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-04-07/33faac06-3359-43e3-ac78-66689d8c9a6c.jpg?rect=2072%2C0%2C1856%2C3375\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1744050600,\"max_tickets\":99,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"From the creators of Ginger’s Big Drag Brunch get ready to grab life by the balls with The Big Drag Bingo Brunch—your favorite drag bingo experience with a fabulous bottomless brunch twist, darling!\\n\\nJoin us for a glittering bottomless drag extravaganza, where we’ll play the campiest, most outrageous game of bingo you’ve ever experienced—think your Nanna’s dabber, but with a fabulous twist! Our stunning drag superstars will have you on your feet, dancing, and cheering faster than you can say \\\"HOUSE!\\\"\\n\\nExpect bonkers fun as we serve up hilarious bingo rounds, ridiculous games and lip sync battles, jaw-dropping drag performances, and a vibrant atmosphere filled with live DJs spinning the hottest party anthems. With bottomless Prosecco flowing and BIG prizes to be won, this event has something for everyone to enjoy!\\n\\nVenue- Phoenix Arts Club - nearest stations Tottenham Court Rd,\\n\\n(Doors 1pm) Show 1.30-3.30pm. Prosecco 1.30pm - 3.30pm. Bar and kitchen will remain open to purchase additional drinks throughout.\\n\\n\\\\* if you order food on the day, the options will be Pizza only.\\n\\nMAINS\\n\\n\\\\-Cheeseburger on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Buttermilk Chicken burger with cheese on a brioche bun, baby gem, beef tomato burger sauce GF on request\\n\\n\\\\-Vegan burger on a brioche bun, baby gem, beef tomato burger sauce V VG GF on request\\n\\nDESSERT\\n\\n\\\\-Chocolate and orange torte with vanilla ice cream VG V GF\\n\\n\\\\-Vanilla cheesecake with strawberry sauce V\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Party with Ginger.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:20\",\"social_links\":{\"event_share\":\"https://link.dice.fm/sf3445761ccb?dice_id=sf3445761ccb\",\"post_competition_referral\":\"https://link.dice.fm/o4d338fa44af?dice_id=o4d338fa44af\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K0dc52f07ad7?dice_id=K0dc52f07ad7\",\"post_purchase_referral\":\"https://link.dice.fm/Gf270a1adc0e?dice_id=Gf270a1adc0e\",\"post_reminder_referral\":\"https://link.dice.fm/Va2d3597f92d?dice_id=Va2d3597f92d\",\"post_waitinglist_referral\":\"https://link.dice.fm/q5a2e6d880d1?dice_id=q5a2e6d880d1\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-04-07T19:30:00+01:00\",\"sale_end_date\":\"2026-03-07T13:30:00+00:00\",\"sale_start_date\":\"2025-04-07T19:30:00+01:00\",\"event_start_date\":\"2026-03-07T13:00:00+00:00\",\"event_end_date\":\"2026-03-07T15:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2003},\"properties\":[],\"billing_promoter\":{\"id\":\"14767\",\"name\":\"Party with Ginger\",\"image\":{\"url\":null},\"perm_name\":\"party-with-ginger-3oogv\",\"profile_active\":false},\"id\":\"694e4e22b191a40001d0a76f\",\"seats_io_event_id\":null,\"name\":\"The Big Drag Bingo Brunch \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"92w29o-the-big-drag-bingo-brunch-7th-mar-phoenix-arts-club-london-tickets\",\"date_unix\":1772888400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"15810\",\"name\":\"QT\",\"address\":\"66 Great Queen Street, Camden, London, WC2B 5BX, United Kingdom\",\"location\":{\"lat\":51.51584,\"lng\":-0.12026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"qt-8ea25\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770310800,\"max_tickets\":100,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by House of Burlesque.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:21\",\"social_links\":{\"event_share\":\"https://link.dice.fm/i49312accd2b?dice_id=i49312accd2b\",\"post_competition_referral\":\"https://link.dice.fm/j6a9db73424d?dice_id=j6a9db73424d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ga7ed9b2db9f?dice_id=Ga7ed9b2db9f\",\"post_purchase_referral\":\"https://link.dice.fm/C8eb6ad4465f?dice_id=C8eb6ad4465f\",\"post_reminder_referral\":\"https://link.dice.fm/k2f35d0416f3?dice_id=k2f35d0416f3\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q11a448e3fd9?dice_id=Q11a448e3fd9\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T17:00:00+00:00\",\"sale_end_date\":\"2026-03-07T15:00:00+00:00\",\"sale_start_date\":\"2026-02-06T11:00:00+00:00\",\"event_start_date\":\"2026-03-07T18:00:00+00:00\",\"event_end_date\":\"2026-03-07T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2035},\"properties\":[],\"billing_promoter\":{\"id\":\"2924\",\"name\":\"House of Burlesque\",\"image\":{\"url\":null},\"perm_name\":\"house-of-burlesque-6pd8\",\"profile_active\":false},\"id\":\"698482b04e762d00015354f6\",\"seats_io_event_id\":null,\"name\":\"House of Burlesque Speakeasy \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l89wvx-house-of-burlesque-speakeasy-7th-mar-qt-london-tickets\",\"date_unix\":1772906400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 07 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-11T17:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Gregório Duvivier\",\"image\":null,\"artist_id\":\"132985\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-26/36aa7577-4a73-461c-ad85-a899bf606f1f.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-26/36aa7577-4a73-461c-ad85-a899bf606f1f.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/36aa7577-4a73-461c-ad85-a899bf606f1f.jpg?rect=169%2C0%2C743%2C1350\"},\"previews\":[{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/nGN201c2SpWT2hee5tEaPSxFwenK02FtJH402mEeErYZws.m3u8\",\"track_name\":\"\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769526000,\"max_tickets\":20,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Tickets available for the late evening session: https://link.dice.fm/S248e2800856\\n\\nGregório Duvivier does not see the Portuguese language merely as a homeland, but as an obsession. Or, as young people would say, a hyperfocus. After all, words have been an inexhaustible source of humor since the very beginning.\\n\\nThe show blends stand-up comedy with spoken poetry and a dramaturgy that weaves everything together. Stand-up poetry? Linguistic comedy? Call it what you like. Gregório prefers: Poetic Comedy. Directed by actress Luciana Paes, Gregório explores the power of speech and reminds us that human beings are nothing more than talking monkeys — and all other differences stem from that.\\n\\nA breakthrough hit seen by over 200,000 spectators now arrives in London for an exciting journey through words and the power of language.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by H2N Culture Connectors.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:22\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Ff843b078671?dice_id=Ff843b078671\",\"post_competition_referral\":\"https://link.dice.fm/B94d845a4453?dice_id=B94d845a4453\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C1b2e98242d0?dice_id=C1b2e98242d0\",\"post_purchase_referral\":\"https://link.dice.fm/u84d5142a5cd?dice_id=u84d5142a5cd\",\"post_reminder_referral\":\"https://link.dice.fm/dd3c297abe7c?dice_id=dd3c297abe7c\",\"post_waitinglist_referral\":\"https://link.dice.fm/B7aea7cafc05?dice_id=B7aea7cafc05\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T15:00:00+00:00\",\"sale_end_date\":\"2026-03-11T19:00:00+00:00\",\"sale_start_date\":\"2026-01-27T15:00:00+00:00\",\"event_start_date\":\"2026-03-11T17:00:00+00:00\",\"event_end_date\":\"2026-03-11T19:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"c