donation\":null,\"streaming_options\":null,\"impression_id\":\"3775695cf81d3a40:27\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"6987598aa97ca5000105488b\",\"name\":\"The Rions \",\"perm_name\":\"py9mrk-the-rions-22nd-may-islington-assembly-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/a195cd62-aa9a-4f14-9eaa-ecfb0e31bee8.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/a195cd62-aa9a-4f14-9eaa-ecfb0e31bee8.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/a195cd62-aa9a-4f14-9eaa-ecfb0e31bee8.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Rions\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-08/c1fe9a59-c2f5-41bf-bb62-974d0c3fb432.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"102869\",\"about\":null,\"is_headliner\":true},{\"name\":\"Bean Magazine\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1fe8f07f6d7658e61b97edd5\"},\"artist_id\":\"130275\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1770717600,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1913},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T10:00:00+00:00\",\"sale_end_date\":\"2026-05-22T18:00:00+01:00\",\"sale_start_date\":\"2026-02-09T10:00:00+00:00\",\"event_start_date\":\"2026-05-22T19:00:00+01:00\",\"event_end_date\":\"2026-05-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by 229.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/G6223ca14525?dice_id=G6223ca14525\",\"post_competition_referral\":\"https://link.dice.fm/I540f359992f?dice_id=I540f359992f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Da12dd781bdb?dice_id=Da12dd781bdb\",\"post_purchase_referral\":\"https://link.dice.fm/z7f5c4a96aab?dice_id=z7f5c4a96aab\",\"post_reminder_referral\":\"https://link.dice.fm/r421bc3cd139?dice_id=r421bc3cd139\",\"post_waitinglist_referral\":\"https://link.dice.fm/rbe4867ae699?dice_id=rbe4867ae699\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Cinematic rock outfit Earthside have announced their debut foray into headlining some key European shows in May/June 2026 to round off the chapter for “Let The Truth Speak”.\\n\\nEarthside’s blend of cinematic post- rock tendencies with worldly collaborators bring a type of live energy that is unique and compelling amidst their peers. Earthside weaves between an instrumental band and one who is enhanced by visual elements and collaborators, presenting a unique show for all to see.\\n\\n*“A thrillingly euphoric experience” - **Kerrang!***\\n\\n*“Let The Truth Speak is an album of multiple layers. Its rich, diverse and thought-provoking themes venture way beyond simplistic labels” - **Prog Magazine***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779472800,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-22T19:00:00+01:00\",\"doors_close_date\":null}],\"statu