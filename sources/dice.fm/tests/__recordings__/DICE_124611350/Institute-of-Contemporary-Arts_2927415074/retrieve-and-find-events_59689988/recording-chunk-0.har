orm\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:40\",\"about\":{\"description\":\"**This event will end by 10pm**\\n\\nSupport act: **Amelia Rose**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ only (under 18s must be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765191600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Amelia Rose\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27392055a1b5304e34ad6f93fb4\"},\"artist_id\":\"132198\",\"about\":null,\"is_headliner\":false},{\"name\":\"Anatole Muster\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb24fb63c2e392b0a47aae3afc\"},\"artist_id\":\"41901\",\"about\":{\"description\":\"At 23 years of age, Swiss producer and accordion phenomenon Anatole Muster has already gained critical praise from both musicians and fans alike. His unique approach to modern jazz got featured by Jamie Cullum on his BBC 2 radio show and made him collaborate with genre-bending heavyweights just as Tennyson, Kiefer or Louis Cole.\\n\\nAnatole’s music has propelled him to perform worldwide, including shows at MontreuxJazz Autumn of Music festival, Rio Montreux Jazz Festival, OFF Festival, M4Music Switzerland, a sold-out Minaret Records-Show in Los Angeles and two sold-out performances at Ronnie Scott’s Jazz Club in London, to name a few.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/6de1c493-1176-456b-bcf9-5d1e8ae1b738.jpg?rect=0%2C0%2C2221%2C2221\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/6de1c493-1176-456b-bcf9-5d1e8ae1b738.jpg?rect=0%2C444%2C2221%2C133