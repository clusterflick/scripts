31b809e2\"},\"perm_name\":\"926o99-cavalcade-guests-28th-mar-the-victoria-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/866fc193-7ce3-4c77-8db5-aa97a3f9ad5a.jpg?rect=0%2C22%2C960%2C960\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/866fc193-7ce3-4c77-8db5-aa97a3f9ad5a.jpg?rect=0%2C312%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/866fc193-7ce3-4c77-8db5-aa97a3f9ad5a.jpg?rect=150%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"Cavalcade are reuniting for a one-off fundraising show in support of the British Heart Foundation.\\n\\nJack (lead guitar) is running the London Marathon 2026 to raise money for BHF, a cause that means a lot to all of us — so we’re getting back on stage to help push his fundraising over the line.\\n\\nAll proceeds from this gig will go directly to the British Heart Foundation.\\n\\nIt also happens to mark 10 years since Cavalcade first formed, so expect a night filled with throwbacks, big moments, and a proper send-off.\\n\\nJoin us as we headline The Victoria, Dalston on Saturday 28th March 2026.\\n\\nOne night only. One last time. See you down the front. x\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692443f8b341a50001e8c544\",\"name\":\"Cavalcade + guests \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cavalcade\",\"image\":null,\"artist_id\":\"22568\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-14T13:00:00+00:00\",\"sale_end_date\":\"2026-03-28T18:00:00+00:00\",\"sale_start_date\":\