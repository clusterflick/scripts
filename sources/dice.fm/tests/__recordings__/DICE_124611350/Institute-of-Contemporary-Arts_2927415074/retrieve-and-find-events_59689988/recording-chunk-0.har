":51.5062896,\"lng\":-0.129788700000063},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-03/7e6891a2-2daa-457c-8dc9-d3acb58f537b.jpg?rect=832%2C0%2C1643%2C1643\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ica-institute-of-contemporary-arts-jvrv\",\"accessibility\":{\"url\":\"https://www.ica.art/visit/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Feeo\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebb4a2c2799cd73211c6fb16f9\"},\"artist_id\":\"26025\",\"about\":null,\"is_headliner\":false},{\"name\":\"Loraine James\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-09-27/c9af160e-5cdf-48ad-8aa3-de6087b807df.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"11950\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"A double header featuring feeo and Whatever The Weather, alias of visionary electronic producer Loraine James. Both sets will be presented in-the-round and using the venue's state-of-the-art 360° soundsystem, d&b Soundscape.\\n\\n**feeo**'s debut album, Goodness, released on AD 93 in October 2025, is an open, impressionistic assemblage of drone, ambient, experimental electronic, improvisational and minimalist dance music. Illuminated with breathtaking vocals and uncanny poetics, across protean forms and voices, feeo explores an ever-evolving counterpoint between connection and isolation, the city and the natural world.\\n\\nShe describes the album as “an exploration of simultaneous yet opposing states of being; darkness and lightness, obscurity and visibility and most fundamentally, solitude and togetherness. Each song is an adumbration; a partial sketch of one aspect of the LP - each finding its complete meaning when read in the context of the whole.”\\n\\n**Whatever The Weather** is the ambient-leaning alias of visionary electronic producer Loraine James.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-08T10:00:00+00:00\",\"sale_end_date\":\"2026-02-26T20:30:00+00:00\",\"sale_start_date\":\"2025-12-09T10:00:00+00:00\",\"event_start_date\":\"2026-02-26T19:30:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6932d8a09f9ef00001dff999\",\"name\":\"In the Round: feeo + Whatever The Weather\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-05/3328d7cf-7a98-40e5-84b5-962baba09530.jpg?rect=0%2C9%2C1445%2C1445\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-05/3328d7cf-7a98-40e5-84b5-962baba09530.jpg?rect=0%2C298%2C1445%2C867\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-05/3328d7cf-7a98-40e5-84b5-962baba09530.jpg?rect=320%2C0%2C805%2C1463\"},\"marketeers\":[{\"id\":861,\"name\":\"Institute of Contemporary Arts\",\"privacy_policy_link\":\"https://ica.art/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1765188000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_l