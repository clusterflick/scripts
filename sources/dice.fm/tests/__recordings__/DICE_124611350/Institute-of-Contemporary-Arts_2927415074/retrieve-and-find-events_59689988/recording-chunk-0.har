l\":\"https://link.dice.fm/o657129fdf60?dice_id=o657129fdf60\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:15\",\"properties\":[],\"presented_by\":\"Presented by Paper Dress Vintage.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768262400,\"id\":\"69667b197c7aa500016df95c\",\"name\":\"Eclectrik! ft. Jemima Whyte, Mansilla + Love Cloud\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"⚡ Eclectrik! are back with another stunning line-up featuring 7-piece horn-led powerhouse **Jemima Whyte**, groovy Latin-infused Jazz/Soul from multi-instrumentalist **Mansilla** & an opening set from 7-piece roots reggae, RnB & Afro-Latin newcomers **Love Cloud** ⚡\\n\\nAfter the live music, Eclectrik! resident DJs will be spinning a dancefloor-friendly mix of House, Jazz, Afrobeat, Latin Rhythms & Funk till late - for this edition they'll be joined by special guest DJ **Alix John** (Just 4 The Beat Records) for an opening set of jazz and underground Chicago house, the perfect way to take the baton from Jemima...\\n\\nPerforming live..\\n\\n⚡ **JEMIMA WHYTE**\\n\\nSaxophonist, vocalist and composer Jemima Whyte has been bringing a fresh and exciting sound to venues across London in the last year.\\n\\nWith roots in the north, her style has been heavily shaped by the vibrant dance culture and afrobeat scenes in Leeds as well as her love for old school soul records and retro sounds.\\n\\nBacked by a 7-piece powerhouse band including an all-female horn frontline, Jemima’s compositions blend energising grooves with rich horn lines and joyful harmonies.\\n\\n⚡ **MANSILLA**\\n\\nSwiss-Peruvian artist Mansilla is a multi-instrumentalist, songwriter, vocalist & producer. Named after his grandmother’s Peruvian surname, meaning “*a residence or stopping place*,” Mansilla’s sound reflects a heritage shaped by movement, cultural fusion and self-discovery.\\n\\nBlending groove-driven, hypnotic production with Latin syncopation and atmospheric, call-and-response energy, his music draws on influences from D’Angelo, Jordan Rakei, London jazz, acid jazz and classic soul, infused with the Latin traditions he grew up with.\\n\\n⚡ **LOVE CLOUD**\\n\\nLove Cloud are a 7-piece collective blending roots reggae, RnB and Afro-Latin rhythms. Fronted by soul powerhouse Woloh and built on grooves shape on London’s jazz and funk circuit, they channel the spirit of Sault, Talking Heads and Fela Kuti while creating something distinctly their own.\\n\\nExpect a set of bass-driven, hornlit grooves and dynamic high energy performance.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2624\",\"name\":\"Paper Dress Vintage\",\"image\":{\"url\":null},\"perm_name\":\"paper-dress-vintage-67xq\",\"profile_active\":false},\"date_unix\":1771702200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T09:00:00+00:00\",\"sale_end_date\":\"2026-02-21T21:00:00+00:00\",\"sale_start_date\":\"2026-01-13T10:00:00+00:00\",\"event_start_date\":\"2026-02-21T19:30:00+00:00\",\"event_end_date\":\"2026-02-21T23:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":f