ice\":{\"currency\":\"GBP\",\"amount\":3300,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by DMP.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":70314,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"billing_promoter\":{\"id\":\"1768\",\"name\":\"DMP\",\"image\":{\"url\":null},\"perm_name\":\"dmp-d5kq\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"92w6yn-the-del-fuegos-20th-jun-the-lexington-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781982000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:70\",\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-20T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Del Fuegos\",\"image\":null,\"artist_id\":\"132545\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"The Del Fuegos are an American rock and roll band. Formed in 1981, the group came of age in Boston and its members still consider themselves products of one of the city’s many musical golden ages. After signing with Slash Records, home of X, the Blasters, Los Lobos, Gun Club and more, the band released three records on the label, including their charting songs “Backseat Nothing,” “Don’t Run Wild” and “I Still Want You.” Touring internationally with acts including Tom Petty and the Heartbreakers, ZZ Top, and INXS, the group made friends and fans among such notables as Robert Plant, Sam Phillips, Tom Petty and comedian Steven Wright.\\n\\nThe relationship between brothers Warren Zanes and Dan Zanes, then and now, has been described as both “fractious” and “electric,” but the brothers, along with founding band member Tom Lloyd and drummer Woody Geissmann, have gone on to notable post-band successes. Dan won a Grammy and continues to record with his wife Claudia for Smithsonian/Folkways. Warren, a New York Times best-selling author of Tom Petty’s biography and more and Grammy-nominated documentary producer of Twenty Feet from Stardom and more, is an executive producer of the cinematic adaptation of his book, Deliver Me from Nowhere: The Making of Bruce Springsteen’s Nebraska. Tom, living in California, earned a Ph.D from CalTech and quietly remains the most successful of the bunch. Woody, a Boston-area fixture, founded Right Turn, an organization focused on recovery.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-16T11:00:00+00:00\",\"sale_end_date\":\"2026-06-20T18:00:00+01:00\",\"sale_start_date\":\"2026-01-19T11:00:00+00:00\",\"event_start_date\":\"2026-06-20T20:00:00+01:00\",\"event_end_date\":\"2026-06-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696d169b3717da000171a13f\",\"name\":\"The Del Fuegos\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-18/552aaa85-d5a2-4b34-aa3c-74f261e29a01.jpg?rect=106%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-18/552aaa85-d5a2-4b34-aa3c-74f261e29a01.jpg?rect=0%2C90%2C980%2C588\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-18/552aaa85-d5a2-4b34-aa3c-74f261e29a01.jpg?rect=279%2C0%2C422%2C768\"},\"marketeers\":[{\"id\":2237,\"name\":\"DMP\",\"privacy_policy_link\":\"https://www.dmpuk.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768561200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Off4ddcd2637?dice_id=Off4ddcd2637\",\"post_competition_referral\":\"https://link.dice.fm/L4346ccf6622?dice_id=L4346ccf6622\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K1c5ad7e454f?dice_id=K1c5ad7e454f\",\"post_purchase_referral\":\"https://link.dice.fm/x4bc11db6b9f?dice_id=x4bc11db6b9f\",\"post_reminder_referral\":\"https://link.dice.fm/ce5e6f73075f?dice_id=ce5e6f73075f\",\"post_waitinglist_referral\":\"https://link.dice.fm/r8a9a48d99d7?dice_id=r8a9a48d99d7\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Del Fuegos - Anything You Want\",\"redirect_url\":\"https://music.a