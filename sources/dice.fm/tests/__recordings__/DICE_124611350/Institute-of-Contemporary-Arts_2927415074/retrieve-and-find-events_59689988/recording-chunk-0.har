n\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":68198,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":68199,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\\n\\nSeating is reserved for this event and you will be automatically assigned the best available seats within your chosen area. Seat details are available immediately after purchase. Please follow the link in your confirmation email if you wish to change your seats. For any queries please contact help@dice.fm. Please note we cannot guarantee that seated tickets offered via the Waiting List will be located together.\",\"order\":1}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pennines\",\"image\":null,\"artist_id\":\"130839\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tangled Hair\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb41c2243eba5f4915382783de\"},\"artist_id\":\"1909\",\"about\":null,\"is_headliner\":false},{\"name\":\"toe\",\"image\":null,\"artist_id\":\"132186\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T18:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/465a7c4b-9ee5-4366-b9a2-0655b7cee249.jpg?rect=0%2C376%2C2248%2C2248\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/465a7c4b-9ee5-4366-b9a2-0655b7cee249.jpg?rect=0%2C826%2C2248%2C1349\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/465a7c4b-9ee5-4366-b9a2-0655b7cee249.jpg?rect=299%2C0%2C1650%2C3000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Sec9a051752c?dice_id=Sec9a051752c\",\"post_competition_referral\":\"https://link.dice.fm/Cfbcde3582db?dice_id=Cfbcde3582db\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b8918fe08ed6?dice_id=b8918fe08ed6\",\"post_purchase_referral\":\"https://link.dice.fm/Rf0c9e426f15?dice_id=Rf0c9e426f15\",\"post_reminder_referral\":\"https://link.dice.fm/lcfb4864e15d?dice_id=lcfb4864e15d\",\"post_waitinglist_referral\":\"https://link.dice.fm/d4039f1c8750?dice_id=d4039f1c8750\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:73\",\"properties\":[],\"presented_by\":\"Presented by Pink Mist.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768212000,\"id\":\"6961216bfb34210001d18c29\",\"name\":\"toe\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**\\\\*\\\\*\\\\*Due to phenomenal demand, this show has upgraded to Troxy\\\\*\\\\*\\\\***\\n\\nWe are beyond excited to announce the long-awaited return of the incredible, hugely influential and much-loved Japanese band, toe. Blending together an intricate and stunning mix of post-rock, jazz, electronica, math-rock, R&B and much more, these shows have been long, long in the making.\\n\\ntoe only been to the UK twice in their entire career, in 2013 (a sold-out London show at XOYO) and in 2016 (or an ArcTanGent Festival exclusive) - but they've been highly influential on the world of math rock both here and in Japan.\\n\\nOn top of that, the band also recently celebrated the 25th Anniversary with a huge in-the-round (sumo) arena show in Tokyo, and these shows - billed as the “Loneliness Will Shine” tour are part of their 25th anniversary touring.\\n\\nAs if there wasn’t a way this show could be any more unmissable, toe will be joined by indie-math legends Tangled Hair - playing a rare London show with, whisper it, new material - and, returning to London for the first time in well over a decade, Pennines; UK emo-math legends whom the internet has recently discovered, and quite rightly, gone totally bananas for.\\n\\nIf that sounds unmissable, it’s because it is. You know what to do…\\n\\nTickets include a £2.25 venue restoration levy.\\n\\nFor Accessible Tickets please email accesstickets@troxy.co.uk with the show you'd like to attend, your full name, phone number and your access requirements and we'll be back in touch as soon as possible to arrange this for you. This will be done on a first come first served basis.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"date_unix\":1775926800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":4007,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T16:00:00+00:00\",\"sale_end_date\":\"2026-04-11T17:00:00+01:00\",\"sale_start_date\":\"2026-01-19T16:00:00+00:00\",\"event_start_date\":\"2026-04-11T18:00:00+01:00\",\"event_end_date\":\"2026-04-11T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5d6ab-mortuary-drape-11th-apr-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Hater of Fucking Humans\",\"redirect_url\":\"https://open.spotify.com/track/10RuW5E2ty5Uj9ymGFezC9\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/27b2ca685ef80a5986c222b8949d2d3216f06e94?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Hater of Fucking Humans\"},{\"type\":\"apple_music\",\"title\":\"Mortuary Drape - Primordial\",\"redirect_url\":\"https://music.apple.com/us/album/primordial/1606083031?i=1606083034&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mortuary Drape\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/54/5a/f0/545af072-1994-50b8-a19e-428b7d0837e5/mzaf_13170560722395700781.plus.aac.p.m4a\",\"track_name\":\"Primordial\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":70163,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":70164,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":70165,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vacivus\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2738286142e121324a13fbfb16f\"},\"artist_id\":\"56055\",\"about\":null,\"is_headliner\":false},{\"name\":\"Adorior\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273333a53d8f4c3bcff26369900\"},\"artist_id\":\"49593\",\"about\":null,\"is_headliner\":false},{\"name\":\"Mortuary Drape\",\"image\":null,\"artist_id\":\"69171\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T18:00:00+01:00\",\"doors_close_date\":\"2026-04-11T22:00:00+01:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-23/0e083cab-f358-4021-9698-d690144a4e50.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-23/0e083cab-f358-4021-9698-d690144a4e50.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-23/0e083cab-f358-4021-9698-d690144a4e50.jpg?rect=563%2C0%2C1375%2C2500\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/B5cd215e87b5?dice_id=B5cd215e87b5\",\"post_competition_referral\":\"https://link.dice.fm/tc6d890cd588?dice_id=tc6d890cd588\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l53445059c2d?dice_id=l53445059c2d\",\"post_purchase_referral\":\"https://link.dice.fm/Kef3633a4b5a?dice_id=Kef3633a4b5a\",\"post_reminder_referral\":\"https://link.dice.fm/h7e438684b24?dice_id=h7e438684b24\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ze440d0007c8?dice_id=Ze440d0007c8\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:74\",\"properties\":[],\"presented_by\":\"Presented by Morbid Angle.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768838400,\"id\":\"696a711eff0e400001dc8517\",\"name\":\"MORTUARY DRAPE\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"UK exclusive Mortuary Drape\\n\\nThe Masters of Morbid Metal celebrating 40 years of Wildness & Perversion with London degenerates Adorior and Vacivus, purveyors of savage UK death metal.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1775926800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1122,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-07T13:30:00+00:00\",\"sale_end_date\":\"2026-04-11T17:00:00+01:00\",\"sale_start_date\":\"2026-01-07T13:30:00+00:00\",\"event_start_date\":\"2026-04-11T18:00:00+01:00\",\"event_end_date\":\"2026-04-11T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"eo3vy6-the-shabs-half-dead-album-launch-london-11th-apr-signature-brew-haggerston-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Shabs - To the Streets\",\"redirect_url\":\"https://music.apple.com/us/album/to-the-streets/1539997052?i=1539997516&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Shabs\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview114/v4/6c/9f/e3/6c9fe3d5-1332-a5f3-4666-949b03803a6b/mzaf_11792970076748688457.plus.aac.p.m4a\",\"track_name\":\"To the Streets\"},{\"type\":\"spotify\",\"title\":\"The Shabs - To the Streets\",\"redirect_url\":\"https://open.spotify.com/track/1EccyzPYihlaRxnkOOI1Oc\",\"artist\":\"The Shabs\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3107a80e2fd4019600d75d9319e9c11ca0d8e657?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"To the Streets\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Shabs\",\"image\":null,\"artist_id\":\"87835\",\"about\":null,\"is_headliner\":false},{\"name\":\"Chuck SJ \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-08-02/74c2778d-f7cd-419a-ba05-3a701ebdb6ef.jpg?rect=0%2C514%2C2480%2C2480\"},\"artist_id\":\"30382\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"2427\",\"name\":\"Signature Brew Haggerston\",\"address\":\"340 Acton Mews, London E8 4EA, UK\",\"location\":{\"lat\":51.5368309,\"lng\":-0.07585579999999936},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/a4d49491-4b57-4ec6-9c10-4055162cd091.jpg?rect=589%2C0%2C2354%2C2354\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"signature-brew-haggerston-l3yw\",\"accessibility\":{\"url\":\"https://www.signaturebrew.co.uk/pages/signature-brews-frequently-asked-questions-faqs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-11T18:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/fb3f95ab-c8c4-4215-a24e-ec4ee8f90735.jpg?rect=0%2C1%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/fb3f95ab-c8c4-4215-a24e-ec4ee8f90735.jpg?rect=0%2C161%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/fb3f95ab-c8c4-4215-a24e-ec4ee8f90735.jpg?rect=180%2C0%2C441%2C802\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/N22e0319c9dc?dice_id=N22e0319c9dc\",\"post_competition_referral\":\"https://link.dice.fm/B0569a200d3b?dice_id=B0569a200d3b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ja4312b2cb71?dice_id=Ja4312b2cb71\",\"post_purchase_referral\":\"https://link.dice.fm/y573533ce764?dice_id=y573533ce764\",\"post_reminder_referral\":\"https://link.dice.fm/X58459c796b9?dice_id=X58459c796b9\",\"post_waitinglist_referral\":\"https://link.dice.fm/O88ca8575460?dice_id=O88ca8575460\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:75\",\"properties\":[],\"presented_by\":\"Presented by Signature Brew.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767792600,\"id\":\"695e59628a3cee00019d7783\",\"name\":\"The Shabs \\\"Half Dead\\\" Album Launch | London\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Signature Brew presents\\n\\nThe Shabs \\\"Half Dead\\\" Album Launch\\n\\nwith\\n\\nThe Shabs - https://www.instagram.com/theshabsband/\\n\\nGLU - https://www.instagram.com/glu4eva/\\n\\nChuck SJ - https://www.instagram.com/chuckintransit/\\n\\nSince forming in Cape Town in 2012, The Shabs have gigged extensively across South Africa, the UK, and Europe, earning a reputation for their tight, energetic live shows that blend melodic sing-along folk with the raw energy and DIY ethos of punk rock. Drawing influence from artists like PUP, Frank Turner, The Front Bottoms, and Against Me!, The Shabs deliver heartfelt, anthemic tunes that are honest, raw, and deeply relatable — guaranteed to get fists pumping and voices singing along.\\n\\nTheir 4th album, Half Dead, is a collection of songs capturing the energy and headspace of a band trying to adapt to the damaged, post-pandemic world around them with positivity, love and empathy. A band that believes in who they are, what they do, and that their music can contribute towards a brighter future.\\n\\nSaturday 11th April 2026 / Doors 6pm\\n\\nSignature Brew Haggerston\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"3591\",\"name\":\"Signature Brew Haggerston\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-19/cf9f0866-c543-4008-8b08-026157cfb350.jpg\"},\"perm_name\":\"signature-brew-haggerston-3m2g\",\"profile_active\":true},\"date_unix\":1775926800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2653,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-23T11:00:00+00:00\",\"sale_end_date\":\"2026-04-10T15:00:00+01:00\",\"sale_start_date\":\"2025-12-23T11:00:00+00:00\",\"event_start_date\":\"2026-04-11T18:30:00+01:00\",\"event_end_date\":\"2026-04-11T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"wwr3yx-the-zac-schulze-gang-11th-apr-the-garage-london-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Zac Schulze Gang\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-11-27/434ee269-934a-4aef-9085-3318036e164e.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"108655\",\"about\":null,\"is_headliner\":true},{\"name\":\"Fine Lime\",\"image\":null,\"artist_id\":\"131768\",\"about\":null,\"is_headliner\":false},{\"name\":\" Mitchell Lane \",\"image\":{\"url\":\"https://dice-media.