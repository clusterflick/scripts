ets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:30:00+00:00\",\"sale_end_date\":\"2026-03-31T19:00:00+01:00\",\"sale_start_date\":\"2025-12-01T15:00:00+00:00\",\"event_start_date\":\"2026-03-31T19:00:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Black Frog.\",\"seating\":null,\"announcement_date_unix\":1764549000,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-31T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:53\",\"date_unix\":1774980000,\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/b2cf5ed7f5da?dice_id=b2cf5ed7f5da\",\"post_competition_referral\":\"https://link.dice.fm/Pd1e423e36fc?dice_id=Pd1e423e36fc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c5f4e28624ca?dice_id=c5f4e28624ca\",\"post_purchase_referral\":\"https://link.dice.fm/he08167236cf?dice_id=he08167236cf\",\"post_reminder_referral\":\"https://link.dice.fm/a435601f710b?dice_id=a435601f710b\",\"post_waitinglist_referral\":\"https://link.dice.fm/nd06bb9a0226?dice_id=nd06bb9a0226\"},\"perm_name\":\"2w7p96-mim-grey-31st-mar-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-05-19/4d72b496-2bcc-4436-9c25-cd227af2a1a2.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-05-19/4d72b496-2bcc-4436-9c25-cd227af2a1a2.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-05-19/4d72b496-2bcc-4436-9c25-cd227af2a1a2.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Get ready for the unforgettable soul-stirring melodies and heartfelt lyrics in the enchanting world of MIM GREY!\\n\\nBorn and raised in North London with a voice that resonates deep within your soul, telling powerful stories that tug at your heartstrings, Mim is the embodiment of classic songwriting.\\n\\nSir Tom Jones himself can't help but sing her praises, declaring her as his favorite singer. Michael Ball hails her a as \\\"the most beautiful voice to come out of the UK in a very long time.\\\" Robert Elms from BBC Radio London admits, \\\"She's rather good and rather gorgeous, but don't let that influence you.\\\"\\n\\nSir Paul McCartney is a devoted admirer, repeatedly inviting her to grace his personal engagements. Her creative prowess has undoubtedly adorned the soundscapes that have graced your ears, and she's even co-written songs for none other than Kylie Minogue.\\n\\nHer first two albums, the critically acclaimed 'Grey Matters' and 'Chasing Tigers' have received resounding praise and Radio 2 plays by Paul O'Grady, Sarah Kennedy, Robert Elms, and Sir Terry Wogan.\\n\\nHer singles 'Just As You Are' and 'Ways Of Love' soared to the coveted No.1 spot on the UK Country Charts. She penned and released 'Xmas Kiss', a BBC Radio 2 play-listed track that reched No.1 in the UK Country Charts, No.5 in Nashville, and graced the film 'Foster', starring Richard E Grant and Toni Collette.\\n\\nAn evening with Mim Grey is an evening of musical enchantment that lingers long after the final note fades away\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692d8a66e52c240001e9a923\",\"name\":\"Mim Grey\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Mim Grey - I Can't Make You Love Me\",\"redirect_url\":\"https://music.apple.com/us/album/i-cant-make-you-love-me/1685000870?i=1685001210&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Mim Grey\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/1f/09/23/1f0923bc-d0e3-7d97-41a6-f30a592b20f4/mzaf_16898842645058615972.plus.aac.p.m4a\",\"track_name\":\"I Can't Make You Love Me\"},{\"type\":\"spotify\",\"title\":\"Mim Grey - I Can't Make You Love Me\",\"redirect_url\":\"https://open.spotify.com/track/0RQXNxQa2cR1lrA6Qh2UO6\",\"artist\":\"Mim Grey\",\"preview_url\":\"https://p.scdn.co/mp3-preview/0ad573c2332eb57aa0e8fec126fc431c2623a868?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I Can't Make You Love Me\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"m