lewell-arms-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/9b46bba8-4088-4b3a-8a92-01e4d46a9362.jpg?rect=0%2C0%2C3376%2C3376\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/9b46bba8-4088-4b3a-8a92-01e4d46a9362.jpg?rect=0%2C675%2C3376%2C2026\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/9b46bba8-4088-4b3a-8a92-01e4d46a9362.jpg?rect=760%2C0%2C1857%2C3376\"},\"properties\":[],\"about\":{\"description\":\"Support act: **Restless Taxis** and **Yaz León**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ only (photo ID required)\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6968c9fa69a3850001e29f53\",\"name\":\"RY-GUY (EP Launch) + Restless Taxis + Yaz León\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"RY-GUY - Skyscraper\",\"redirect_url\":\"https://open.spotify.com/track/6a3WAALuT084X8ZswIT4Wa\",\"artist\":\"RY-GUY\",\"preview_url\":\"https://p.scdn.co/mp3-preview/19da4e2100b54dc0c4b4b2d5483baed2cedf02a4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Skyscraper\"},{\"type\":\"apple_music\",\"title\":\"RY-GUY - Skyscraper\",\"redirect_url\":\"https://music.apple.com/us/album/skyscraper/1800652730?i=1800652731&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"RY-GUY\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/96/c4/14/96c41484-e84d-ab4e-e381-26281dfbcab4/mzaf_12885970155582865308.plus.aac.p.m4a\",\"track_name\":\"Skyscraper\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Yaz León\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe54916fdc7b4607922bd2b10\"},\"artist_id\":\"58402\",\"about\":null,\"is_headliner\":false},{\"name\":\"Restless Taxis\",\"image\":null,\"artist_id\":\"57035\",\"about\":null,\"is_headliner\":false},{\"name\":\"RY-GUY\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb51c62a320fc9d7c59d8da398\"},\"artist_id\":\"67565\",\"about\":{\"description\":\"RY-GUY is a South London-based artist whose music sits at the intersection of soul, psychedelia and art-pop, shaped by a deep sense of heritage and a commitment to telling stories often left unheard. Born in London to a West Indian/Caribbean family with roots in Guyana and Barbados, RY-GUY is highly influenced by the soundsystem culture of his Guyanese / Caribbean heritage as well as art movements like Impressionism and Surrealism and treats songwriting as both personal expression and cultural document.\\n\\nHis new EP, 'like a river' (27/03/26) was recorded across Salvation Studios, Speedy Wunderground and RAK, RY-GUY co-produced the record with Adele Phillips. Since RY-GUY's debut EP, 'As The Light Leaks' (2023), he has received significant radio support from the likes of BBC 6 Music's Steve Lemacq and Radio X's John Kennedy.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-24T20:00:00+00:00\",\"sale_end_date\":\"2026-03-25T19:00:00+00:00\",\"sale_start_date\":\"2025-11-24T20:00:00+00:00\",\"event_start_date\":\"2026-03-31T19:30:00+01:00\",\"event_end_date\":\"2026-03-31T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\