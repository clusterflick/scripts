id\":null,\"google_ads_conversion_id\":\"456276871\",\"google_ads_purchase_conversion_label\":\"E1p8CPXdoaUbEIf3yNkB\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:64\",\"properties\":[],\"presented_by\":\"Presented by DHP FAMILY.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1756285200,\"id\":\"68a9fe31e7afdd0001f8ef5e\",\"name\":\"Kadebostany\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Kadebostany continues its legacy with the launch of the “The Outsider” era.\\n\\nAfter conquering Europe with a sold-out tour, the Kadebostany Republic returns stronger than ever, armed with new music, a powerful visual identity, a spectacular new live show, and the forthcoming album “The Outsider” (out January 2026).\\n\\nRacking up more than 5 billion global streams and major critical acclaim, Kadebostany has been on a skyrocketing trajectory over the last 10 years.\\n\\nThe project first broke through with numerous chart-topping singles such as “Castle in the Snow”, “Mind if I Stay”, “Early Morning Dreams”, his acclaimed reimagining of Beyoncé’s “Crazy in Love” (50 Shades of Grey), and more recently “Wild in Secret”.\\n\\nKadebostany has dominated the charts in over 30 countries, performed over 700 live shows in more than 25 countries, and have been praised by international press such as Vice, GQ, Spin, American Songwriter, CNN, Rolling Stone, Vogue, MixMag, EDM.com, Run The Trap, Time Out, Marie Claire, and many more.\\n\\nMore recently, Kadebostany's \\\"Early Morning Dreams\\\" went viral on TikTok with over 3 billion streams, got nominated on the official Grammy ballot for \\\"Best Pop Performance\\\", performed at the Champions League's final, composed the soundtrack of the documentary Obvious, synch for Armani's new fashion show or Netflix's As The Crow Flies, performed a live stream watched live by over 350'000 people simultaneously.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event (under 16s to be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"date_unix\":1772564400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T13:00:00+00:00\",\"sale_end_date\":\"2026-03-03T19:30:00+00:00\",\"sale_start_date\":\"2026-02-13T13:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:30:00+00:00\",\"event_end_date\":\"2026-03-03T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5myv2-biba-3rd-mar-the-elephants-head-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":76732,\"title\":\"Entry Requirements\",\"body\":\"Always bring ID.\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"14448\",\"name\":\"The Elephants Head\",\"address\":\"224 Camden High Street, Camden, London, NW1 8QR, United Kingdom\",\"location\":{\"lat\":51.54071,\"lng\":-0.14392},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-elephants-hea