107e40a-708e-b7ce-4c74-ddb49daffafd/mzaf_3590716578485449862.plus.aac.p.m4a\",\"track_name\":\"Devote\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Eat Your Own Ears.\",\"billing_promoter\":{\"id\":\"10\",\"name\":\"Eat Your Own Ears\",\"image\":{\"url\":null},\"perm_name\":\"eat-your-own-ears-z82z\",\"profile_active\":true},\"date_unix\":1776969000,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"41\",\"name\":\"The Waiting Room\",\"address\":\"175 Stoke Newington High Street, London N16 0LH\",\"location\":{\"lat\":51.5620818,\"lng\":-0.0738883999999871},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-waiting-room-jxea\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1337,\"name\":\"Eat Your Own Ears\",\"privacy_policy_link\":\"https://www.eatyourownears.com/privacy-cookies-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:40\",\"about\":{\"description\":\"Eat Your Own Ears presents Pitou at The Waiting Room.\\n\\n\\\"Amsterdam-born artist Pitou has one of the most arresting voices to emerge from this year, drawing comparisons to the likes of Laura Marling and Julia Holter, crafting intelligent folk-pop that balances the darkness and light of human emotion.\\\" - The Independent\\n\\nDutch songwriter and composer Pitou has unveiled new single “Too Good To Go”, a wonderfully scattershot song brimming with mania, mischief and cacophony – somewhere in the vein of Björk, Meredith Monk, Jockstrap, and (especially rhythmically) Orchestra Baobab.\\n\\nSupport from Beth Jones\\n\\nAge restriction 18+\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1758099600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pitou\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb49b19d7050ebc956f4eaa35f\"},\"artist_id\":\"5452\",\"about\":{\"description\":\"Dutch folk singer Pitou was fascinated by music from a young age, whether it played from classical radio or the cassettes her parents collected on their travels around the globe. Her goosebump-inducing voice imitates a bird’s coo in one breath and switches to a powerful belt the next. She has performed at some of Europe’s most prestigious concert halls, including L’Olympia, Ancienne Belgique and Het Concertgebouw.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-12/002c0eee-79cf-44b1-b3a8-7636a37d5715.jpg?rect=192%2C0%2C897%2C897\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-12/002c0eee-79cf-44b1-b3a8-7636a37d5715.jpg?rect=0%2C65%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-12/002c0eee-79cf-44b1-b3a8-7636a37d5715.jpg?rect=394%2C0%2C493%2C897\"},\"offers_extra