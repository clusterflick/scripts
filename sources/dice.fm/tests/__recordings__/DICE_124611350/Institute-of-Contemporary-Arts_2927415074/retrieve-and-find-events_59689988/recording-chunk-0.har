Time\"},{\"type\":\"apple_music\",\"title\":\"Apollo Brown & Ras Kass - Giraffe P*ssy (feat. Royce da 5'9\\\", Xzibit, Bishop Lamont)\",\"redirect_url\":\"https://itunes.apple.com/gb/album/giraffe-p-ssy-feat-royce-da-59-xzibit-bishop-lamont/909822088?i=909822096&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Apollo Brown & Ras Kass\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/Music4/v4/c8/f2/da/c8f2da0d-231c-1c15-0f7f-4387c38d031a/mzaf_3315720629610924515.plus.aac.p.m4a\",\"track_name\":\"Giraffe P*ssy (feat. Royce da 5'9\\\", Xzibit, Bishop Lamont)\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1766142000,\"max_tickets\":6,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**Detroit’s Apollo Brown brings his Gas Mask Anniversary Tour to our stage — a rare chance to experience one of modern hip-hop’s most revered producers live.**\\n\\nA master of boom bap in the 21st century, Brown has spent the last decade redefining the sound, blending soul, grit and deep musicality in the tradition of J Dilla, Pete Rock and DJ Premier.\\n\\nDrawing from classic RnB, left-field influences and a Midwestern mentality, his productions are raw, reflective and built for head-nods and screwfaces alike.\\n\\nCelebrating the cult-classic *Gas Mask* album, Brown is joined on the night by **Guilty Simpson** and **Journalist 103**, bringing the record’s stark lyricism and grey-sky beats to life.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Jazz Cafe.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:43\",\"social_links\":{\"event_share\":\"https://link.dice.fm/nb274770a2b4?dice_id=nb274770a2b4\",\"post_competition_referral\":\"https://link.dice.fm/U8aa5b88734d?dice_id=U8aa5b88734d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i0507758c027?dice_id=i0507758c027\",\"post_purchase_referral\":\"https://link.dice.fm/M9c7588e2e2a?dice_id=M9c7588e2e2a\",\"post_reminder_referral\":\"https://link.dice.fm/oa63d1a3c0b0?dice_id=oa63d1a3c0b0\",\"post_waitinglist_referral\":\"https://link.dice.fm/ce34deb83c01?dice_id=ce34deb83c01\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-19T11:00:00+00:00\",\"sale_end_date\":\"2026-04-28T19:00:00+01:00\",\"sale_start_date\":\"2025-12-19T11:00:00+00:00\",\"event_start_date\":\"2026-04-28T19:00:00+01:00\",\"event_end_date\":\"2026-04-28T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2625,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"id\":\"6942aff2b88ce80001830315\",\"seats_io_event_id\":null,\"name\":\"Apollo Brown (Gas Mask Anniversary Tour) \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nvwpeq-apollo-brown-gas-mask-anniversary-tour-28th-apr-the-jazz-cafe-london-tickets\",\"date_unix\":1777399200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"t