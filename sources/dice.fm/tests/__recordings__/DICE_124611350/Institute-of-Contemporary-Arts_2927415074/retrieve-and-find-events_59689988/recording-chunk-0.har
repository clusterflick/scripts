a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T17:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Rough Trade East is very excited to present an acoustic performance and Q&A from Foy Vance. This unique event celebrates the release of his new album 'The Wake' released via Rounder.\\n\\nCD/LP purchases will be shipped at release from 13/03 via Second Class Mail.\\n\\nFans will receive a pre-signed print on the day of the event.\\n\\nTicket transfers will be off to avoid shipping issues, please make sure you either purchase your own ticket or attend the event together.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/foy-vance/the-wake\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4ODE0OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUyMjY0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODowOS44NDk4OTZaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MzYyNSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4ODE0OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUyMjY0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODowOS44NDk5MTlaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MzYyNiwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6OTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":900,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4ODE0OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUyMjY0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODowOS44NDk5NDRaIiwicHJpY2UiOjkwMCwidmFyaWFudF9pZCI6MzYyNywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTIwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE4ODE0OCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTUyMjY0LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1ODowOS44NDk5NTNaIiwicHJpY2UiOjEyMDAsInZhcmlhbnRfaWQiOjM2MjgsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Campaign Against Living Miserably\",\"charity_registration_number\":\"1110621\"},\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:21\",\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"presented_by\":\"Presented by Rough Trade.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Foy Vance\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-08-11/3b58009c-493d-445c-aa04-317e0dde6a44.jpg?rect=0%2C0%2C1500%2C1500\"},\"artist_id\":\"2549\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1770804000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T10:00:00+00:00\",\"sale_end_date\":\"2026-03-22T17:00:00+00:00\",\"sale_start_date\":\"2026-02-11T10:00:00+00:00\",\"event_start_date\":\"2026-03-22T17:00:00+00:00\",\"event_end_date\":\"2026-03-22T19:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"697b84e31b04b6000104273e\",\"name\":\"Foy Vance: Acoustic/Q&A\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2101},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Foy Vance - Hi, I’m The Preacher's Son\",\"redirect_url\":\"https://music.apple.com/us/album/hi-im-the-preachers-son/1860981940?i=1860981942&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Foy Vance\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/3b/b1/56/3bb156ec-7616-0c1c-ea59-b03d34b3bd9e/mzaf_2829628979653523228.plus.aac.p.m4a\",\"track_name\":\"Hi, I’m The Preacher's Son\"}],\"faqs\":[{\"id\":73050,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":73051,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":73052,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":73053,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":73054,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":73055,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":73056,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":73057,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":73058,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":73059,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"score\":0,\"shopping_cart_enabled\":true,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"l89qxl-london-music-ultimate-showcase-all-dayer-22nd-mar-the-hope-and-anchor-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774199700,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-04/856d9bd3-a987-4464-a6de-bdd49b9ff5c9.jpg?rect=0%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-04/856d9bd3-a987-4464-a6de-bdd49b9ff5c9.jpg?rect=0%2C256%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-04/856d9bd3-a987-4464-a6de-bdd49b9ff5c9.jpg?rect=288%2C0%2C704%2C1280\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/l6ed6182beff?dice_id=l6ed6182beff\",\"post_competition_referral\":\"https://link.dice.fm/ide0e8acfa1c?dice_id=ide0e8acfa1c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/J1157ef0bcdb?dice_id=J1157ef0bcdb\",\"post_purchase_referral\":\"https://link.dice.fm/qc3b90021260?dice_id=qc3b90021260\",\"post_waitinglist_referral\":\"https://link.dice.fm/Kae715b3dc51?dice_id=Kae715b3dc51\",\"post_reminder_referral\":\"https://link.dice.fm/u631189efbd2?dice_id=u631189efbd2\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"13762\",\"name\":\"The Hope and Anchor\",\"address\":\"207 Upper Street, Islington, London, N1 1RL, United Kingdom\",\"location\":{\"lat\":51.54325,\"lng\":-0.10354},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-hope-and-anchor-2nqp\",\"accessibility\":{\"url\":\"https://hopeandanchor.info/contact/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T17:15:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:22\",\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"presented_by\":\"Presented by London Music Showcase.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Molly Chadwick\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3b1e93cbc97c2e4fa40afb30\"},\"artist_id\":\"130783\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":5},\"marketeers\":[],\"announcement_date_unix\":1758582000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-23T00:00:00+01:00\",\"sale_end_date\":\"2026-03-22T17:00:00+00:00\",\"sale_start_date\":\"2025-09-23T00:00:00+01:00\",\"event_start_date\":\"2026-03-22T17:15:00+00:00\",\"event_end_date\":\"2026-03-22T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"698384a8c2be5a00014b8f52\",\"name\":\"London Music Ultimate Showcase: All Dayer\",\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"ww5qdg-geirrur-anna-gumundsdttir-antoine-prat-pre-concert-recital-22nd-mar-conway-hall-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774200600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-22/c835c72c-347f-4cb0-9808-3ae0119198a2.jpg?rect=212%2C0%2C857%2C857\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-22/c835c72c-347f-4cb0-9808-3ae0119198a2.jpg?rect=0%2C45%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-22/c835c72c-347f-4cb0-9808-3ae0119198a2.jpg?rect=405%2C0%2C471%2C857\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/oabea03611b7?dice_id=oabea03611b7\",\"post_competition_referral\":\"https://link.dice.fm/s646d9c07b66?dice_id=s646d9c07b66\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/sb3f65b51e6e?dice_id=sb3f65b51e6e\",\"post_purchase_referral\":\"https://link.dice.fm/x45879b65920?dice_id=x45879b65920\",\"post_waitinglist_referral\":\"https://link.dice.fm/c21bf24eaebf?dice_id=c21bf24eaebf\",\"post_reminder_referral\":\"https://link.dice.fm/G4d8b841d217?dice_id=G4d8b841d217\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"3223\",\"name\":\"Conway Hall\",\"address\":\"25 Red Lion Square Holborn, London WC1R 4RL UK\",\"location\":{\"lat\":51.51948760000001,\"lng\":-0.1168424},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"conway-hall-obq5\",\"accessibility\":{\"url\":\"https://www.conwayhall.org.uk/about-us/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T17:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Icelandic cellist **Geirþrúður Anna Guðmundsdóttir** and French pianist **Antoine Préat** offer a wide-ranging programme for their debut at Conway Hall. Schumann’s Fantasiestücke radiate warmth and intimacy, while Beethoven’s exuberant *A major Sonata* displays dialogue of equal partners. Nadia Boulanger’s *Trois Pièces* offer refined, introspective beauty; Sibelius’s miniatures blend Nordic melancholy and charm; and Grieg’s passionate *A minor Sonata* crowns the recital with sweeping Romantic fervour rooted in Norwegian song and dance.\\n\\n**Schumann** | Fantasiestücke Op.73\\n\\n**Beethoven** | Sonata in A Op.69\\n\\n**Nadia Boulanger** | Trois Pièces\\n\\n**Sibelius** | 4 Pieces Op.78\\n\\n**Grieg** | Sonata in A minor Op.36\\n\\nGeirþrúður Anna Guðmundsdóttir • *cello*\\n\\nAntoine Préatr • *piano*\\n\\n**Pre-Concert Recital with Leo Little**\\n\\nWinner of our Clements Prize for composers in November 2025, **Leo Little** is not only an accomplished composer but a promising pianist of the new generation. A current student at the Royal College of Music, he makes his debut at Conway Hall performing a varied programme of 20th-century piano music, exploiting the piano to its fullest!\\n\\n**Shostakovich** | Prelude and Fugue in G Minor Op.87/22\\n\\n**Bartók** | Suite Op.14\\n\\n**Debussy** | Étude No.11\\n\\n**Scriabin** | Sonata No.5 Op.53\\n\\nLeo Little • *piano*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. Under 16's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:23\",\"billing_promoter\":{\"id\":\"5578\",\"name\":\"Conway Hall\",\"image\":{\"url\":null},\"perm_name\":\"conway-hall-5nry\",\"profile_active\":false},\"presented_by\":\"Presented by Conway Hall.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":4},\"marketeers\":[],\"announcement_date_unix\":1765497600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-22T15:30:00+00:00\",\"sale_start_date\":\"2025-12-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-22T17:30:00+00:00\",\"event_end_date\":\"2026-03-22T20:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6925bb226af4f8000138f0ee\",\"name\":\"Geirþrúður Anna Guðmundsdóttir & Antoine Préat + Pre-Concert Recital\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":718},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"7dmr6p-seek-harbour-22nd-mar-new-cross-inn-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774202400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/d6279aab-1c74-4ef4-88d4