2025-08-29/5589facd-f62d-4943-a2f0-53bde18f1b07.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-29/5589facd-f62d-4943-a2f0-53bde18f1b07.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-29/5589facd-f62d-4943-a2f0-53bde18f1b07.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Gallowstreet, the Dutch brass band with an attitude.\\n\\nHailing from the Galgenstraat in Amsterdam they have refined their sound through the course of 5 albums.\\n\\nOver a decade of innovating brass music, Gallowstreet has been up and at it. Armed with 7 horn players and 1 drummer the band employs a wide range of musical genres to tell stories with their compositions, most of them beat driven, all of them with anthemic quality.\\n\\nGallowstreet has proven to be a big inspiration for the emerging European Brass Band scene. There’s not a week that goes by without a video of one of the songs being covered by young enthusiastic brass bands from around the globe. Their songs have seen re-arrangements for a wide range of ensembles and Gallowstreet has been a consistent source of inspiration for other bands.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":null,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1779300000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-20T19:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/y9432488698d?dice_id=y9432488698d\",\"post_competition_referral\":\"https://link.dice.fm/jb308a2079f7?dice_id=jb308a2079f7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/gff97e7a2371?dice_id=gff97e7a2371\",\"post_purchase_referral\":\"https://link.dice.fm/D97e33e5bee7?dice_id=D97e33e5bee7\",\"post_reminder_referral\":\"https://link.dice.fm/T97ba336db23?dice_id=T97ba336db23\",\"post_waitinglist_referral\":\"https://link.dice.fm/R685a0ba8262?dice_id=R685a0ba8262\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Control Voltage\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:90\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-26T12:00:00+01:00\",\"sale_end_date\":\"2026-05-20T19:00:00+01:00\",\"sale_start_date\":\"2025-07-26T12:00:00+01:00\",\"event_start_date\":\"2026-05-20T19:00:00+01:00\",\"event_end_date\":\"2026-05-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1753527600,\"offers_extras\":false,\"secondary_status\":\"rescheduled\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"id\":\"6883a755eb40b400018d80af\",\"name\":\"Control Voltage: Electronic Music Open Mic\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"2wb93p-control-voltage-electronic-music-open-mic-20th-may-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/3a19103b-12bd-4a34-aea9-7da035dce6ce.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/3a19103b-12bd-4a34-aea9-7da035dce6ce.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/3a19103b-12bd-4a34-aea9-7da035dce6ce.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"The name says it all, Electronic Music Open Mic or EMOM for short is an open stage night for local electronic musicians.\\n\\nThis free night will showcase up to 7 local electronic artists performing an array of different types of music ranging from house, techno, ambient, industrial, chiptune, looping, field recording, experimental electronica and more.\\n\\nEMOM has become a movement over the last 2 years with regular independent nights hosted in many cities and counties across the UK. This night is aimed at giving local electronic music artists a supportive space to play live and experiment.\\n\\nThese nights are great fun for both artists and fans of electronic music, you never know what genre you might hear next!\\n\\nThe format is simple; each artist will get a 20-minute window (including set up time) to do their thing before handing over to the next artist. The only rule is no guitars unless they are being used to generate soundscapes or some other style of music in keeping with these nights.\\n\\nIf you’d like to play, please email controlvoltageemom@gmail.com to register. If you’d just like to come along and watch, just click the ‘buy now’ link to secure your place. The night is completely free whether you are playing or watching.\\n\\nAll ages welcome – under 16 to be accompanied by a responsible adult.\\n\\nThis event is hosted by Control Voltage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 to be accompanied by a responsible adult\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":627,\"name\":\"Colours\",\"privacy_policy_link\":\"https://colourshoxton.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1779301800,\"tty_to_extras\":[],\"venues\":[{\"id\":\"839\",\"name\":\"Colours Hoxton\",\"address\":\"2-4 Hoxton Square, London N1 6NU\",\"location\":{\"lat\":51.527453,\"lng\":-0.0816949999999679},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"colours-hoxton-mxew\",\"accessibility\":{\"url\":\"https://colourshoxton.com/wp-content/uploads/2022/02/Colours-Accessibility-Documen