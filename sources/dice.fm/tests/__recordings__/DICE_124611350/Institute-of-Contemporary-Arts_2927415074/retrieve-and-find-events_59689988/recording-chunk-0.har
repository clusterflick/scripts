i_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Short Waves.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/ie1073d90042?dice_id=ie1073d90042\",\"post_competition_referral\":\"https://link.dice.fm/zbfd908312a7?dice_id=zbfd908312a7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Je8c3b6916d1?dice_id=Je8c3b6916d1\",\"post_purchase_referral\":\"https://link.dice.fm/J37a4b53301b?dice_id=J37a4b53301b\",\"post_reminder_referral\":\"https://link.dice.fm/qdcc5035a181?dice_id=qdcc5035a181\",\"post_waitinglist_referral\":\"https://link.dice.fm/w3343aa4f554?dice_id=w3343aa4f554\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"*Short Waves Presents:*\\n\\n**Candide**, the progressive punk trio, erupts as a kind of theatrical fever dream: a shambolic yet exacting northern soul dancer, the mighty boosh of rock. Their debut ‘Rage Ballet’ encapsulates this ethos: garage-guitar fireworks collide with Baroque-esque melodrama; these are the melodies of a boy band exploding at Chernobyl; a sneering punk tantrum dissolving into a strange, tender daydream.\\n\\nIn short, Candide is one of London’s most theatrical and original new bands, fusing a rich visual and sonic world with electric stagecraft, making them the perfect act to cut through and wake up the room (or field).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pi