\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-20T18:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"The Absolute Stone Roses\\n\\nThe Absolute Stone Roses are a Tribute Band to the Manchester legends The Stone Roses. Their aim is to recreate that iconic sound and vibe that you get at a Stone Roses concert and bring it to live audiences all over the Uk and Europe.\\n\\nThe Absolute Stone Roses have performed several times alongside Clint Boon (Inspiral Carpets) and the Manchester legend Bez (The Happy Mondays) both Manchester Legends in their own right.\\n\\nThey have also played shows with some of the cast from Shane Meadows channel 4 drama (This is England) with Thomas Turgoose aka Shuan and Andrew Shim aka Milky. They have shared the stage with other Britpop Legends such as The Lightning Seeds, Nigel Clarke (Dodgy) and Tommy Scott from the band (Space)\\n\\nThe Absolute Stone Roses play an awesome set of all the best roses material.\\n\\nExpect to hear all the classics Waterfall, Made of Stone, Resurrection, I Wanna Be Adored, Fools Gold, Love Spreads and many more.\\n\\nIf you've never seen the real deal or want to re-live your youth or want to feel that vibe then The Absolute Stone Roses will take you on a trip with the attitude and baggy fashion.\\n\\nhttps://www.theabsolutestoneroses.com/\\n\\n\\\\+ supports\\n\\nKapowski\\n\\nBritpop and 90s covers band serving nostalgia to London and Kent. Raucous versions of your favourite tunes from the era including Oasis, Blur, Pulp, Supergrass, Menswear, Republica, and more!\\n\\nhttps://www.thisiskapowski.com/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:31\",\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"presented_by\":\"Presented by New Cross Live.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Absolute Stone Roses\",\"image\":null,\"artist_id\":\"122533\",\"about\":null,\"is_headliner\":false},{\"name\":\"KAPOWSKI\",\"image\":null,\"artist_id\":\"73346\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1753052400,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-21T00:00:00+01:00\",\"sale_end_date\":\"2026-03-20T17:00:00+00:00\",\"sale_start_date\":\"2025-07-21T00:00:00+01:00\",\"event_start_date\":\"2026-03-20T18:00:00+00:00\",\"event_end_date\":\"2026-03-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"687e50448fe4cd000143711c\",\"name\":\"The Absolute Stone Roses\",\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"The Stone Roses - Elephant Stone - Remastered\",\"redirect_url\":\"https://open.spotify.com/track/57inMtXj5ZwnevKzP49bTT\",\"artist\":\"The Stone Roses - Elephant Stone - Remastered\",\"preview_url\":\"https://p.scdn.co/mp3-preview/33