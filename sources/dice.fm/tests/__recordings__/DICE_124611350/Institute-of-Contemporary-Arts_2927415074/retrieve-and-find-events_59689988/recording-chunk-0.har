32593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776535200,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:30\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3642},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-16/d834e4cb-d723-46db-bb86-1dbcecc3f494.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-16/d834e4cb-d723-46db-bb86-1dbcecc3f494.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-16/d834e4cb-d723-46db-bb86-1dbcecc3f494.jpg?rect=270%2C0%2C660%2C1200\"},\"id\":\"68c99a2b6274750001c6ebcb\",\"name\":\"The High Kings\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"*Ireland’s leading folk group, The High Kings, are set to excite fans once again with the announcement of their Rocky Road Tour 2026.*\\n\\n*As global ambassadors of Irish heritage and storytelling, The High Kings have consistently brought the timeless tradition of folk music to audiences worldwide, earning them chart-topping success and widespread acclaim. With their signature blend of classic tradition and modern edge, The Rocky Road Tour promises to be a vibrant showcase of Irish culture, energy, and musicality.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T10:00:00+01:00\",\"sale_end_date\":\"2026-04-18T21:00:00+01:00\",\"sale_start_date\":\"2025-09-19T10:00:00+01:00\",\"event_start_date\":\"2026-04-18T19:00:00+01:00\",\"event_end_date\":\"2026-04-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Robert Jon & The Wreck\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc5d81c60dff2797f5782c971\"},\"artist_id\":\"21793\",\"about\":null,\"is_headliner\":true},{\"name\":\"Sam Morrow\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-28/97180209-e479-43b9-9af7-008a0c36f8a7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"10094\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by DHP FAMILY.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":40545,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permit