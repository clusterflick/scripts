",\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1778695200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-13T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:79\",\"about\":{\"description\":\"Independence project & Clubs provide a multitude of activities so that people can participate in new experiences and in things that they enjoy.\\n\\nFrom our own research we learned that previous live music events in Chelmsford that supported the learning disability community had all ceased, certainly club nights are just not happening. We've sprung into action to make a change.\\n\\nIndepenDANCE was born! We've partnered with Eazee Learning & Hot Box. Both organisations share our ethos and always go the extra mile whilst making a difference in their communities, so it’s the perfect match!\\n\\nWe are excited and hopeful that we will create a real buzz around these nights. Ultimately enabling people with additional needs the opportunity to let their hair down, meet friends & have a DANCE!\\n\\nThis is carried out in a safe environment with staff on hand to support; those attending will enjoy their night with the confidence that there are people around them that are there to help.\\n\\nOur music acts will be showcasing the superb talent within the additional needs community and the DJs providing the entertainment also have additional needs, playing the best in House, UK garage, R&B, Decades, theme nights and Club Classics.\\n\\nWe are hopeful to put on many live music events in the future and they will always be run like any other club night, promoting inclusion and diversity, and enabling people to enjoy real life experiences. Please spread the message and help us to make them a success. Let's Go!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1764752400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=875%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=125%2C0%2C3750%2C2250\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-06-22/92afaec7-8946-4a5c-ab7a-aa2e92a858d4.jpg?rect=1381%2C0%2C1238%2C2250\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6930afe035b9fc0001f57d01\",\"name\":\"Independance\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T09:00:00+00:00\",\"sale_end_date\":\"2026-05-13T19:00:00+01:00\",\"sale_start_da