xel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:94\",\"about\":{\"description\":\"Eliane Correa presents: Las salseras - a tribute to Celia Cruz\\n\\nA one-night-only celebration of the Queen of Salsa, her music, and the power of women in the genre.\\n\\nLas Salseras, the UK’s first all-star female salsa orchestra, brings together ten of the top Latin and UK musicians for a tribute to Celia Cruz on her centenary.\\n\\nLed by renowned music director Eliane Correa and fronted by Afro-Latin powerhouse Juanita Euka, the band delivers electrifying renditions of Celia’s greatest hits—‘La Vida es un Carnaval’, ‘Quimbara, Oye Cómo Va’—alongside handpicked gems from her legendary repertoire.\\n\\nExpect a joyous, high-octane, and musically masterful night where tradition, talent, and unstoppable energy collide.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1763467200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-16/395691ae-536b-4f63-81cc-2003a5d79657.jpg?rect=210%2C0%2C840%2C840\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/395691ae-536b-4f63-81cc-2003a5d79657.jpg?rect=0%2C42%2C1260%2C756\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/395691ae-536b-4f63-81cc-2003a5d79657.jpg?rect=399%2C0%2C462%2C840\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6916f6562d3b060001e