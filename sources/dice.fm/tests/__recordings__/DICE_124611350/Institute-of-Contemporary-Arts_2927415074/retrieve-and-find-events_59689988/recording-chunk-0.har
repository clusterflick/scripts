\"type\":\"apple_music\",\"title\":\"Pharaoh Overlord - Mystery Shopper\",\"redirect_url\":\"https://music.apple.com/us/album/mystery-shopper/271609402?i=271609897&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Pharaoh Overlord\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/86/dd/92/86dd92e2-37b6-9a4b-1a47-5fb6edfb7994/mzaf_2056956670736766677.plus.aac.p.m4a\",\"track_name\":\"Mystery Shopper\"}],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"eoayyd-austra-23rd-mar-village-underground-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774294200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-07/062cf55f-6afd-4180-af62-c63ca03ac69f.jpg?rect=780%2C0%2C3117%2C3117\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-07/062cf55f-6afd-4180-af62-c63ca03ac69f.jpg?rect=0%2C156%2C4676%2C2806\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-07/062cf55f-6afd-4180-af62-c63ca03ac69f.jpg?rect=1481%2C0%2C1714%2C3117\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/xea49ef4d2f3?dice_id=xea49ef4d2f3\",\"post_competition_referral\":\"https://link.dice.fm/P1574e8a5d28?dice_id=P1574e8a5d28\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p5432eb53dec?dice_id=p5432eb53dec\",\"post_purchase_referral\":\"https://link.dice.fm/O6e87db83d2a?dice_id=O6e87db83d2a\",\"post_waitinglist_referral\":\"https://link.dice.fm/rc84f45572ad?dice_id=rc84f45572ad\",\"post_reminder_referral\":\"https://link.dice.fm/Cdb97f3d7ea0?dice_id=Cdb97f3d7ea0\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-23T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Austra, the pop project of Canadian vocalist and composer Katie Stelmanis, returns with a powerful new show ahead of her upcoming album Chin Up Buttercup, due out November 14 via Domino.\\n\\nStelmanis, a classically trained musician and opera devotee with four previous albums and a Canadian Screen Award under her belt, has been singing dramatic arias about tragedy for years. But the emotional core of Chin Up Buttercup hits differently — rooted in her own experience of heartbreak after a sudden breakup in early 2020.\\n\\n“I was completely blindsided... the person I loved woke up one day, told me she wasn’t happy, and I basically never saw her again,” Stelmanis shares.\\n\\nThe album’s title references the pressure to keep going — to “chin up” and smile — even when everything falls apart. Co-produced with Kieran Adams, the record draws sonic inspiration from the Eurodance of Madonna’s Ray of Light era, blending hypnotic dancefloor energy with elegant, heart-healing melodies.\\n\\nStelmanis turned her personal pain into poetic fragments in a cathartic Google Doc, which ultimately shaped the album’s raw and fearless lyrics. Its first single, “Math Equation”, captures that energy vividly:\\n\\n“You said I needed my own friends / So I found them / Then you fucked them.”\\n\\nBoth a biting clapback and a bittersweet plea for connection, the song is steeped in the kind of sapphic chaos that threads its way through the entire album. “Math Equation” is out now, accompanied by a video directed by Trevor Blumas.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:50\",\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"presented_by\":\"Presented by Parallel Lines.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Austra\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebf4d20a45d5d010de3a342f43\"},\"artist_id\":\"3781\",\"about\":null,\"is_headliner\":false},{\"name\":\"Tess Roby\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba5acd949365441bc455b0603\"},\"artist_id\":\"8008\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":141,\"name\":\"Parallel Lines\",\"privacy_policy_link\":\"https://www.parallellinespromotions.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads