t\":\"dryhope\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ef83be5bf87d7d009f6018cc59bbe0d1f1a7d7a5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dweller\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-01T10:00:00+01:00\",\"sale_end_date\":\"2026-03-14T17:00:00+00:00\",\"sale_start_date\":\"2025-10-03T09:00:00+01:00\",\"event_start_date\":\"2026-03-14T18:00:00+00:00\",\"event_end_date\":\"2026-03-14T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Underworld.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Dbd2130ae7d6?dice_id=Dbd2130ae7d6\",\"post_competition_referral\":\"https://link.dice.fm/v3f8ec37c31d?dice_id=v3f8ec37c31d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/z3b7b8bf05b7?dice_id=z3b7b8bf05b7\",\"post_purchase_referral\":\"https://link.dice.fm/S1d2604d8c87?dice_id=S1d2604d8c87\",\"post_reminder_referral\":\"https://link.dice.fm/A9c3ae76fdf0?dice_id=A9c3ae76fdf0\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q75291b267d3?dice_id=Q75291b267d3\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"GLAMOUR OF THE KILL are a British Metalcore band that blend hard-hitting riffs, soaring melodies, and anthemic choruses into a unique and electrifying sound.\\n\\nEmerging from the UK metal scene, they quickly gained a reputation for their high-energy live performances - Being rewarded with tours across the globe with bands such as PAPA ROACH, AVENGED SEVENFOLD, BULLET FOR MY VALENTINE and tours across North America, Mainland Europe, Japan and appearances at many mainstream festivals, a prestigious slot on Download Festival's main stage being a highlight.\\n\\nAs of 2025 the boys are back with the new thrash anthems “Grace of God”, “Vengeance” and “Feed Them to the Pigs”.\\n\\nIn January 2026 they will release their highly anticipated third full length album “Vengeance”.\\n\\nThis show is not to be missed!\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets: theunderworldcamden.co.uk\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2205,\"name\":\"GOTK\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"629323223411999\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"date_unix\":1773511200,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"