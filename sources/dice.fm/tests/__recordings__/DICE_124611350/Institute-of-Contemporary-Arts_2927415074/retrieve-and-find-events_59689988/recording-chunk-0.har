d\":222,\"name\":\"Baba Yaga's Hut\",\"privacy_policy_link\":\"https://www.babayagashut.com/privacy-policy\",\"fb_pixel_id\":\"1263983106946503\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780511400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:66\",\"price\":{\"currency\":\"GBP\",\"amount\":3204,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/c28c9a75-7b77-439a-b5cb-130f1bab8246.jpg?rect=340%2C0%2C1368%2C1368\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/c28c9a75-7b77-439a-b5cb-130f1bab8246.jpg?rect=0%2C70%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/c28c9a75-7b77-439a-b5cb-130f1bab8246.jpg?rect=648%2C0%2C752%2C1368\"},\"id\":\"6927361c9a3c660001195961\",\"name\":\"Merzbow\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Baba Yaga's Hut Presents:\\n\\nMerzbow at IKLECTIK\\n\\nMerzbow (メルツバウ) A vegan, straight edge noise project of Masami Akita from Japan. Merzbow started out in the noise industrial scene of early 1980s and began releasing music. In the 1990s, Merzbow were influenced by grind core and released an album on the death metal label Relapse. In the late 1990s, he resonated with Mego's \\\"punk computer music\\\" and were one of the first in Japanese Noise Scene to adopt a live performance technique using laptop computers.\\n\\nSince around 2003, he has practiced veganism from the perspective of \\\"animal rights.\\\" He creates works on themes such as \\\"anti-whaling,\\\" \\\"anti-dolphin fishing,\\\" \\\"anti-fur,\\\" and \\\"liberation of livestock animals.\\\" In recent years, he has been creating music that is not limited to digital or analog. Recently, he has been experimenting with incorporating AI into album artwork.\\n\\nHe has also collaborated with Balazs Pandi, Mats Gustafsson, Thurston Moore, Boris, Keiji Haino, Richard Pinhas (Heldon), Duenn, Nyantra, Lawrence English, Xiu Xiu, Gezan, Alessandro Cortini, Vanity Productions, Vatican Shadow, Bastard Noise, Meat Beat Manifesto and others.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T10:00:00+00:00\",\"sale_end_date\":\"2026-06-03T18:00:00+01:00\",\"sale_start_date\":\"2025-12-04T10:00:00+00:00\",\"event_start_date\":\"2026-06-03T19:30:00+01:00\",\"event_end_date\":\"2026-06-03T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Merzbow - Woodpecker No. 1\",\"redirect_url\":\"https://open.spotify.com/track/4UO1pfxi5fDbxshrwwznJ2\",\"artist\":\"Merzbow\",\"preview_url\":\"https://p.scdn.co/mp3-preview/cfe8ddb6a0d5b982829bb152757d36d33f82b125?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Woodpecker No. 1\"},{\"type\":\"apple_music\",\"title\":\"Merzbow - Woodpecker No. 1\",\"redirect_url\":\"https://music.apple.com/us/album/woodpecker-no-1/281914115?i=281914245&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Merzbow\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/3e/9e/b1/3e9eb1b0-1261-fbfa-cde5-3fe8d08f6001/mzaf_14445270584348198012.plus.aac.p.m4a\",\"track_name\":\"Woodpecker No. 1\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Wed 03 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"s