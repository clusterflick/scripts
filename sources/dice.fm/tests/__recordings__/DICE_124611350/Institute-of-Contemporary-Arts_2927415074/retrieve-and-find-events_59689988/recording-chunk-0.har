name\":null,\"doors_open_date\":\"2026-05-19T19:45:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"5285\",\"name\":\"Other Side Promotions\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-09/c8464497-8f12-4558-84bb-ede11bc2ddb5.jpg\"},\"perm_name\":\"other-side-promotions-r5gv\",\"profile_active\":true},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/i75a79608b4f?dice_id=i75a79608b4f\",\"post_competition_referral\":\"https://link.dice.fm/h17ca0a239ef?dice_id=h17ca0a239ef\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a34c7357667a?dice_id=a34c7357667a\",\"post_purchase_referral\":\"https://link.dice.fm/n559ef6f6246?dice_id=n559ef6f6246\",\"post_reminder_referral\":\"https://link.dice.fm/c1399a3c7c68?dice_id=c1399a3c7c68\",\"post_waitinglist_referral\":\"https://link.dice.fm/D68999d89d4a?dice_id=D68999d89d4a\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Other Side Promotions.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:77\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T13:45:00+00:00\",\"sale_end_date\":\"2026-05-19T19:00:00+01:00\",\"sale_start_date\":\"2026-02-05T13:45:00+00:00\",\"event_start_date\":\"2026-05-19T19:45:00+01:00\",\"event_end_date\":\"2026-05-19T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770299100,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1550,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69849d4669e2610001b8cea1\",\"name\":\"OSP Presents: pôt-pot + Frankie Teardrop Dead\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Frankie Teardrop Dead\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27380ec97a60d523963137301e5\"},\"artist_id\":\"9223\",\"about\":null,\"is_headliner\":false},{\"name\":\"pôt-pot\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-29/d1f2c8a4-4e74-42c2-86ba-cf32b11d55d1.jpg?rect=77%2C0%2C372%2C372\"},\"artist_id\":\"129595\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"rywbgq-osp-presents-pt-pot-frankie-teardrop-dead-19th-may-strongroom-bar-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/e44baf0c-1292-4e83-b18d-1b6a2a24c6cd.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/e44baf0c-1292-4e83-b18d-1b6a2a24c6cd.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/e44baf0c-1292-4e83-b18d-1b6a2a24c6cd.jpg?rect=486%2C0%2C1188%2C2160\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"**OSP present a night of motorik, groovy psychedelic krautrock, with Lisbon based quintet pôt-pot and Cambodia based Frankie Teardrop Dead.**\\n\\n**pôt-pot:**\\n\\npôt-pot are an Irish quintet based in Lisbon, Portugal. The band infuse the propulsive rhythms of krautrock with a phosphorescent psych-rock radiance, all underscored by harmonium drones, hypnotic vocal harmonies, and layers of rough-hewn texture. They deal in deep grooves and cooking listeners to completion.\\n\\nFollowing 2023 EP Ode To A, pôt-pot released their second EP “GOING INSANE” on cult Porto based label Socorro, with a limited vinyl run via Ireland’s beloved Blowtorch Records, receiving much critical acclaim.\\n\\npôt-pot signed with LA-based Felte Records, with whom they released their critically acclaimed debut album “Warsaw 480km” in September 2025, which was deservedly named as one on BBC6 Music's albums of 2025.\\n\\nhttps://www.instagram.com/potpotband\\n\\nhttps://potpot.bandcamp.com/album/warsaw-480km\\n\\n**Frankie Teardrop Dead:**\\n\\nFrankie Teardrop Dead began as a swirling collision of psychedelic rock and shadowed melody, born in the warehouse spaces of North London, shaped in Manchester, and now rebuilt in Cambodia. What started as a full band has evolved into a duo, stripped back to its core and driven by a sharper, more electronic pulse.\\n\\nThe project has always lived on the edges. Dreamy, gritty, and restless, it moves between haze and clarity, intimacy and momentum.\\n\\nhttps://linktr.ee/frankieteardropdead\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Tue 19 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":30466,\"title\":\"The Jazz Cafe FAQ's\",\"body\":\"Please follow this link for all Jazz Cafe FAQ's: https://thejazzcafe.com/faqs/?\",\"order\":0}],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1779292800,\"tty_to_extras\":[],\"venues\":[{\"id\":\"4