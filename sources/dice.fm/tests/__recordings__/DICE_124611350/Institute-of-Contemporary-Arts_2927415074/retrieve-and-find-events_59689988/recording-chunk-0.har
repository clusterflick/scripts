m_name\":\"toulouse-lautrec-jazz-club-ryy6r\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:17\",\"date_unix\":1774803600,\"price\":{\"currency\":\"GBP\",\"amount\":3550,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/ya50eb519aba?dice_id=ya50eb519aba\",\"post_competition_referral\":\"https://link.dice.fm/t2f176aa8aad?dice_id=t2f176aa8aad\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r2d20ea07aa0?dice_id=r2d20ea07aa0\",\"post_purchase_referral\":\"https://link.dice.fm/f689c8ce1c24?dice_id=f689c8ce1c24\",\"post_reminder_referral\":\"https://link.dice.fm/Rad8812b1467?dice_id=Rad8812b1467\",\"post_waitinglist_referral\":\"https://link.dice.fm/We7221df153f?dice_id=We7221df153f\"},\"perm_name\":\"py9e3p-buena-vista-social-club-live-revue-29th-mar-toulouse-lautrec-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=140%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=0%2C76%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/00f422d6-96ed-42f9-a3e9-4a543a4437d4.jpg?rect=320%2C0%2C440%2C800\"},\"properties\":[],\"about\":{\"description\":\"A Journey Through the Golden Age of Cuban Music.\\n\\nStep into the vibrant world of Havana with the Buena Vista Social Club Live Revue, a dazzling celebration of Cuba’s most iconic musical heritage. This unforgettable tribute brings the timeless sounds of son, bolero, danzón, and cha-cha-cha to life, performed by some of the UK’s finest Cuban musicians.\\n\\nInspired by the legendary 1997 Grammy-winning album produced by Ry Cooder and Juan de Marcos González, this live revue pays homage to the spirit and soul of the original Buena Vista ensemble, a project that united the greatest living masters of pre-revolutionary Cuban music.\\n\\nExpect infectious rhythms, soulful trumpet solos, intricate guitar work, and vocals steeped in love, nostalgia, and joy. It’s a night that will transport you straight to Havana’s smoky clubs and sun-drenched plazas, and you may just find yourself dancing before the night is through.\\n\\nBand Line-Up\\n\\nLuke Rattenbury – tres, guitar, vocals\\n\\nEddie Myer – bass, vocals\\n\\nAdriana Lord – lead vocals\\n\\nMickey Ball – trumpet\\n\\nSatin Singh – congas\\n\\nVancho Manoilovich – timbales, drums\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"698f0e7b3a8ebd0001681b09\",\"name\":\"Buena Vista Social Club Live Revue\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Buena Vista Social Club - Chan Chan\",\"redirect_url\":\"https://open.spotify.com/track/3bxZhauuIU4ubctdRZwPYW\",\"artist\":\"Buena Vista Social Club\",\"preview_url\":\"https://p.scdn.co/mp3-preview/74dc6eb8f978e16ef80b0c17df14d13c353a733d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Chan Chan\"},{\"type\":\"apple_music\",\"title\":\"Buena Vista Social Club - Chan Chan\",\"redirect_url\":\"https://music.apple.com/us/album/chan-chan/1716598034?i=1716598344&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Buena Vista Social Club\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/9f/b3/bb/9fb3bb95-dce9-bd65-7d91-4e9c4322dbc0/mzaf_17702336458070202791.plus.aac.p.m4a\",\"track_name\":\"Chan Chan\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Buena Vista Social Club\",\"image\":null,\"artist_id\":\"73269\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":20,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-25T12:45:00+00:00\",\"sale_end_date\":\"2026-03-29T16:30:00+01:00\",\"sale_start_date\":\"2026-01-25T12:45:00+00:00\",\"event_start_date\":\"2026-03-29T18:00:00+01:00\",\"event_end_date\":\"2026-03-29T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":72000,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":72001,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":72002,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Underworld.\",\"seating\":null,\"announcement_date_unix\":1769345100,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-29T18:00:00+01:00\",\"doors_close_date\":\"2026-03-29T22:00:00+01:00\"}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:18\",\"date_unix\":1774803600,\"price\":{\"currency\":\"GBP\",\"amount\":3554,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/If23813c2f1d?dice_id=If23813c2f1d\",\"post_competition_referral\":\"https://link.dice.fm/S033649c644f?dice_id=S033649c644f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Of58af535f39?dice_id=Of58af535f39\",\"post_purchase_referral\":\"https://link.dice.fm/Ade1b3641e86?dice_id=Ade1b3641e86\",\"post_reminder_referral\":\"https://link.dice.fm/K61321599bcb?dice_id=K61321599bcb\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q531e1b03223?dice_id=Q531e1b03223\"},\"perm_name\":\"k6ayxp-rebellion-uk-feat-madball-and-more-29th-mar-the-underworld-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-25/7d9dc15c-a23b-450a-ac1a-5f50a9b29ff6.jpg?rect=333%2C0%2C3264%2C3264\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-25/7d9dc15c-a23b-450a-ac1a-5f50a9b29ff6.jpg?rect=0%2C454%2C3929%2C2357\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-25/7d9dc15c-a23b-450a-ac1a-5f50a9b29ff6.jpg?rect=1067%2C0%2C1795%2C3264\"},\"properties\":[],\"about\":{\"description\":\"Madball emerged in 1988 as a side project of N.Y.C. hardcore pioneers Agnostic Front, blending hardcore punk’s raw aggression with the weight of metal to help define the beatdown sound. Frontman Freddy Cricien is the younger brother of AF vocalist Roger Miret, and when Agnostic Front disbanded in 1992, Madball became the members’ primary focus. Following their debut EP in 1989, the band quickly established themselves at the forefront of the New York hardcore scene, releasing landmark albums such as Set It Off (1994), Demonstrating My Style (1996), Look My Way (1998), Hold It Down (2000), Infiltrate the System (2007), Hardcore Lives (2014), and For the Cause (2018).\\n\\nAfter early lineup changes, Madball solidified their reputation through relentless touring and straight-ahead hardcore releases, eventually signing with Roadrunner Records. A brief breakup in 2001 led to a reformation in 2002, followed by continued touring and releases including Legacy, Empire, and Infiltrate the System. Later years saw further lineup shifts and label changes, with the band returning strongly in 2014 and again in 2018 with For the Cause, co-produced by Tim Armstrong and featuring Ice-T. Madball have remained an active live force into the 2020s, collaborating with Pain of Truth on 2023’s “You & Me” and continuing their legacy as one of hardcore’s most enduring bands.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"id\":\"697610e87752d600014095ce\",\"name\":\"REBELLION UK feat. MADBALL and more!\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Smile Now Pay Later\",\"redirect_url\":\"https://open.spotify.com/track/2qubO22BwvgFwR0Rw5G0be\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e797819adf3f7eb1f0581a59d97104c4e1184a32?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Smile Now Pay Later\"},{\"type\":\"apple_music\",\"title\":\"Madball - New York City\",\"redirect_url\":\"https://music.apple.com/us/album/new-york-city/214513091?i=214513112&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Madball\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/9f/11/b5/9f11b533-886d-7b87-ea5c-e408b604b2b5/mzaf_3854712121810150302.plus.aac.p.m4a\",\"track_name\":\"New York City\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tempers Fray\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27366b95ccdf28ea725a9fe58db\"},\"artist_id\":\"52706\",\"about\":null,\"is_headliner\":false},{\"name\":\"Last Wishes\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc55b9829324df255cf1d697c\"},\"artist_id\":\"35662\",\"about\":null,\"is_headliner\":false},{\"name\":\"Born From Pain\",\"image\":null,\"artist_id\":\"104928\",\"about\":null,\"is_headliner\":false},{\"name\":\"Madball\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-05-15/b7da8852-9d2f-4d9c-bdff-112c4c6d562c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"18249\",\"about\":null,\"is_headliner\":true}],\"total_artists\":4,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-13T14:00:00+01:00\",\"sale_end_date\":\"2026-03-27T16:30:00+00:00\",\"sale_start_date\":\"2025-10-14T14:00:00+01:00\",\"event_start_date\":\"2026-03-29T18:00:00+01:00\",\"event_end_date\":\"2026-03-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by New Cross Live.\",\"seating\":null,\"announcement_date_unix\":176