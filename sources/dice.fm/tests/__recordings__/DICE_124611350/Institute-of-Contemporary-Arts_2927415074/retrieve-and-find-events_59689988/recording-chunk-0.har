_texts\":0},\"new\":false,\"announcement_date_unix\":1770199200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4488},\"has_multiple_ticket_types\":true,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"d3dea399-23af-491b-a297-57099e4083ae\",\"seats_io_public_key\":\"19f74e3d-efaf-4a71-9476-13370248a171\",\"seat_selection\":\"disabled\"},\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Mon 23 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T16:00:00+00:00\",\"sale_end_date\":\"2026-11-25T19:00:00+00:00\",\"sale_start_date\":\"2026-02-13T09:00:00+00:00\",\"event_start_date\":\"2026-11-25T19:00:00+00:00\",\"event_end_date\":\"2026-11-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Live Nation\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/O4c7312511d3?dice_id=O4c7312511d3\",\"post_competition_referral\":\"https://link.dice.fm/b6591d2c1c30?dice_id=b6591d2c1c30\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m4e86f077041?dice_id=m4e86f077041\",\"post_purchase_referral\":\"https://link.dice.fm/X9dbe5cf47b6?dice_id=X9dbe5cf47b6\",\"post_reminder_referral\":\"https://link.dice.fm/S18a4facc9df?dice_id=S18a4facc9df\",\"post_waitinglist_referral\":\"https://link.dice.fm/x754f16ef1a7?dice_id=x754f16ef1a7\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Hailing from The Hague, Netherlands, Son Mieux is a seven-piece powerhouse that has taken the European music scene by storm. Led by the charismatic Camiel Meiresonne, this dynamic ensemble crafts an irresistible sonic tapestry that seamlessly weaves danceable rhythms with poignant, story-driven lyrics. They have produced two acclaimed albums and hits like \\\"Tonight\\\" and \\\"Multicolor,\\\" achieving platinum status in the Netherlands. Their collaboration with Nile Rodgers on \\\"This Is The Moment\\\" in 2024 further solidified their innovative reputation.\\n\\nTheir electrifying live performances have become their signature strength, transforming every concert into an unforgettable celebration. Son Mieux has conquered the main stages of premier Dutch festivals and left an undeniable mark on the European festival circuit. Beyond the festival scene, Son Mieux has embarked on a series of headline tours, selling out venues across Europe's cultural capitals, including London, Berlin, Hamburg, and Zurich. Their ability to consistently deliver spellbinding performances has established them as one of the most exciting live acts on the continent.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_