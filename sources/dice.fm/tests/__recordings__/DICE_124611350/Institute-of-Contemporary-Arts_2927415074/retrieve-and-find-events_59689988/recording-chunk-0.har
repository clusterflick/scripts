250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-24/0b6e39d7-44d8-4245-918c-892a6bb9bd92.jpg?rect=506%2C0%2C1238%2C2250\"},\"unicorn\":false,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1758729600,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1154,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sat 23 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T18:00:00+00:00\",\"sale_end_date\":\"2026-05-24T00:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-05-24T12:00:00+01:00\",\"event_end_date\":\"2026-05-24T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Eastern Electrics\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Iebad7762131?dice_id=Iebad7762131\",\"post_competition_referral\":\"https://link.dice.fm/x9fac73ba837?dice_id=x9fac73ba837\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/mf17d6c0eb33?dice_id=mf17d6c0eb33\",\"post_purchase_referral\":\"https://link.dice.fm/O44451e224ac?dice_id=O44451e224ac\",\"post_reminder_referral\":\"https://link.dice.fm/H0122ce5dc9d?dice_id=H0122ce5dc9d\",\"post_waitinglist_referral\":\"https://link.dice.fm/pd73dbb6eb2f?dice_id=pd73dbb6eb2f\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Two of melodic techno's most influential artists collide.\\n\\nA whole day's programming with many more names to be announced.\\n\\n\\\\--------------------------------------------------------------\\n\\n𝗩𝗜𝗣 𝗧𝗶𝗰𝗸𝗲𝘁𝘀\\n\\nFor those seeking an elevated experience, VIP tickets are available offering exclusive queue jump and VIP lounge where you can access a premium bar with bespoke drink selections, a designated chill out space, private viewing area of the stage close to the artists and VIP toilet access.\\n\\n\\\\--------------------------------------------------------------\\n\\n𝗔𝗰𝗰𝗲𝘀𝘀𝗶𝗯𝗶𝗹𝗶𝘁𝘆 𝗤𝘂𝗲𝗿𝗶𝗲𝘀 & 𝗣𝗲𝗿𝘀𝗼𝗻𝗮𝗹 𝗔𝘀𝘀𝗶𝘀𝘁𝗮𝗻𝘁 𝗧𝗶𝗰𝗸𝗲𝘁𝘀\\n\\nWe strive to make our events accessible to everyone who would like to attend. If you have any specific queries about accessibility or would like to apply for a Personal Assistant ticket, please email us at leytonjubilee@elixarevents.com\\n\\n\\\\---------------------------------------------------------------\\n\\n𝗧𝗶𝗰𝗸𝗲𝘁𝘀 𝗙𝗼𝗿 𝗚𝗼𝗼𝗱\\n\\nWe also work with Tickets For Good to provide tickets to NHS & Charity workers at a discount. You can check if you qualify & grab these via their website.\\n\\n\\\\--------------------------------------------------------------\\n\\n𝗧𝗶𝗰𝗸𝗲𝘁𝘀 𝗙𝗼𝗿 𝗟𝗼𝗰𝗮𝗹 𝗥𝗲𝘀𝗶𝗱𝗲𝗻𝘁𝘀\\n\\nIf you are a local resident, tickets are available free or at a discount depending on your proximity to the park. To find out if you are eligible for these, please send across a valid form of ID as well as proof of address to leytonjubilee@elixarevents.com\\n\\n\\\\---------------------------------------------------------------\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1779620400,\"venues\":[{\"id\":\"17685\",\"name\":\"Leyton Jubilee Park\",\"address\":\"Seymour Road, Waltham Forest, London, E10 7BL, United Kingdom\",\"location\":{\"lat\":51.563121092258626,\"lng\":-0.0238762195