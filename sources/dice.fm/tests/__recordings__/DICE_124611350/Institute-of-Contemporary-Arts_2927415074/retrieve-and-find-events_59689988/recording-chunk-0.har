8e-932e03a66e9f.jpg?rect=0%2C135%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-24/46120e9b-925e-4f53-ab8e-932e03a66e9f.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-24/46120e9b-925e-4f53-ab8e-932e03a66e9f.jpg?rect=169%2C0%2C743%2C1350\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1755558000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/I9366c332af4?dice_id=I9366c332af4\",\"post_competition_referral\":\"https://link.dice.fm/z6b8a16892b8?dice_id=z6b8a16892b8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Me543f80c165?dice_id=Me543f80c165\",\"post_purchase_referral\":\"https://link.dice.fm/Z228187ff1ff?dice_id=Z228187ff1ff\",\"post_reminder_referral\":\"https://link.dice.fm/ob93a4a69c56?dice_id=ob93a4a69c56\",\"post_waitinglist_referral\":\"https://link.dice.fm/D7ef209c9b3f?dice_id=D7ef209c9b3f\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by London Music Showcase.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"xe6wee-london-music-ultimate-showcasezac-and-the-new-men-6th-mar-the-hope-and-anchor-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772824500,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:81\",\"venues\":[{\"id\":\"13762\",\"name\":\"The Hope and Anchor\",\"address\":\"207 Upper Street, Islington, London, N1 1RL, United Kingdom\",\"location\":{\"lat\":51.54325,\"lng\":-0.10354},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-hope-and-anchor-2nqp\",\"accessibility\":{\"url\":\"https://hopeandanchor.info/contact/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:15:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Zac and The New Men\",\"image\":null,\"artist_id\":\"82818\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T00:00:00+00:00\",\"sale_end_date\":\"2026-03-06T19:30:00+00:00\",\"sale_start_date\":\"2026-02-06T00:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:15:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6985bcb67dea650001d72656\",\"name\":\"London Music Ultimate Showcase:Zac and the New Men\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/8cf4a851-d613-4194-871b-813f5071d787.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/8cf4a851-d613-4194-871b-813f5071d787.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/8cf4a851-d613-4194-871b-813f5071d787.jpg?rect=173%2C0%2C422%2C768\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770336000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/u537369103cb?dice_id=u537369103cb\",\"post_competition_referral\":\"https://link.dice.fm/V43a12d24928?dice_id=V43a12d249