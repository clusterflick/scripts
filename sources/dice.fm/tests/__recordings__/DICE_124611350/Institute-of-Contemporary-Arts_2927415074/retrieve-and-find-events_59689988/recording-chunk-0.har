pt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"As if stepping right out of a spaceship from the seventies, the Butter Funk Family channels the energy of classic funk for the 21st century and beyond.\\n\\nLed by two-time GRAMMY Award-winning powerhouse artist, multi-instrumentalist Printz Board, the Los Angeles-based collective unlock an undeniable and unbreakable groove with no shortage of grit and gusto.\\n\\nWith horns blaring, guitars bobbing and weaving, and vocals roaring straight from the gut, you’ve got no choice but to move…\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hootananny Brixton.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:11\",\"social_links\":{\"event_share\":\"https://link.dice.fm/P79fa45356f8?dice_id=P79fa45356f8\",\"post_competition_referral\":\"https://link.dice.fm/G363e82e8990?dice_id=G363e82e8990\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s0f6923d100f?dice_id=s0f6923d100f\",\"post_purchase_referral\":\"https://link.dice.fm/Ia367176b62c?dice_id=Ia367176b62c\",\"post_reminder_referral\":\"https://link.dice.fm/F3b15b25d765?dice_id=F3b15b25d765\",\"post_waitinglist_referral\":\"https://link.dice.fm/F4dcd891065e?dice_id=F4dcd891065e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T10:00:00+00:00\",\"sale_end_date\":\"2026-02-17T21:30:00+00:00\",\"sale_start_date\":\"2025-12-01T18:00:00+00:00\",\"event_start_date\":\"2026-02-17T19:00:00+00:00\",\"event_end_date\":\"2026-02-17T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":