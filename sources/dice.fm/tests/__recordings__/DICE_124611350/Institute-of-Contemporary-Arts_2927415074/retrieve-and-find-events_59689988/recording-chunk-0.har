trait\":\"https://dice-media.imgix.net/attachments/2026-01-27/5e42779b-1b2c-49a2-a78e-2a87673a44f8.jpg?rect=226%2C0%2C552%2C1004\"},\"id\":\"6978d1eb0ce9fa0001062949\",\"name\":\"Ghost-Note \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Ghost-Note are an explosion of sound.**\\n\\nLed by Snarky Puppy’s multi-Grammy-winning drummer Robert “Sput” Searight alongside Nate Werth, this is funk in its most thrilling, forward-thinking form.\\n\\nAn all-star collective at its core, Ghost-Note’s ranks read like a modern music hall of fame, with members connected to Prince, Kendrick Lamar, Erykah Badu, Herbie Hancock, Snoop Dogg, Justin Timberlake and beyond.\\n\\nBlurring the lines between funk, Afrobeat, hip-hop, psychedelia and global rhythms, the band push the genre into new territory, collaborating with Kamasi Washington, Karl Denson and Bobby Sparks along the way.\\n\\nNow, Ghost-Note bring their unmistakable live show — dazzling solos, air-tight arrangements and irresistible groove — to our stage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T10:00:00+00:00\",\"sale_end_date\":\"2026-06-01T19:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-06-01T19:00:00+01:00\",\"event_end_date\":\"2026-06-01T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Swagism\",\"redirect_url\":\"https://open.spotify.com/track/5SNFzpHOj5vXckFEkqjX1t\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5941e63e382ecbbe1eaab55a6c8272a8cffddbf0?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Swagism\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Case Oats\",\"image\":{\"url\":\"https://dice-media.im