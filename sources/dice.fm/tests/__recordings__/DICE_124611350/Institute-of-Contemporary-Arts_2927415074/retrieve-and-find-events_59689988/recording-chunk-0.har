\\n\\nThe Phonics simply love playing the songs of their musical idols and this passion shines through when you hear them live. Their set has something for all fans including hits such as Have a Nice Day, Maybe Tomorrow, Dakota and Handbags & Gladrags, not to mention those amazing album tracks for the diehard Stereophonics fans.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:41\",\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false},\"presented_by\":\"Presented by Hootananny Brixton.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Phonics\",\"image\":null,\"artist_id\":\"117118\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1767744000,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-07T00:00:00+00:00\",\"sale_end_date\":\"2026-03-20T21:00:00+00:00\",\"sale_start_date\":\"2026-01-07T00:00:00+00:00\",\"event_start_date\":\"2026-03-20T19:00:00+00:00\",\"event_end_date\":\"2026-03-20T22:00:00