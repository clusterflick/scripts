ot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-25T15:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-02/1f4fc5c3-c5b8-4873-8d8e-60da22c941bc.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-02/1f4fc5c3-c5b8-4873-8d8e-60da22c941bc.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-02/1f4fc5c3-c5b8-4873-8d8e-60da22c941bc.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/p4478c915f2e?dice_id=p4478c915f2e\",\"post_competition_referral\":\"https://link.dice.fm/O0fd0dab70e8?dice_id=O0fd0dab70e8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/p01e280c97bd?dice_id=p01e280c97bd\",\"post_purchase_referral\":\"https://link.dice.fm/b286c88c1858?dice_id=b286c88c1858\",\"post_reminder_referral\":\"https://link.dice.fm/ya04e6ecda69?dice_id=ya04e6ecda69\",\"post_waitinglist_referral\":\"https://link.dice.fm/A2f87b9255d2?dice_id=A2f87b9255d2\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:69\",\"properties\":[],\"presented_by\":\"Presented by Black Frog\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764633600,\"id\":\"692f3da53f4fd200018746fa\",\"name\":\"Soulweaver\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Soulweaver are a UK-based hard rock power trio with a rich history. Formed in 2009 by one of rock's hardest working couples, Goodge (lead guitar and vocals) and 'M' (bass and backing vocals), the band has undergone a transformation with the addition of powerhouse drummer James Barber, returning with a new momentum and fire in 2023 after an eight-year hiatus.\\n\\nTheir comeback single 'Red' marked a bold statement of intent, showcasing massive hooks, melodic firepower, and their signature fusion of hard rock grit and modern metal urgency. Their music blends arena-ready riffs, anthemic choruses, and progressive touches with an unmistakable classic British rock spirit.\\n\\nWith global radio play and a growing army of fans, Soulweaver has shared the stage with top international acts like Black Star Riders, Wishbone Ash, and The Quireboys. Throughout their career, Soulweaver has received high critical acclaim, with praise from notable music outlets like Classic Rock Magazine, MetalTalk, and Total Rock Radio to name but a few.\\n\\n“The debut album sees them committing some of their original material to record and is a collection of great catchy songs. Its a cracking album which delivers a punch with a fresh sound and plenty of hooks” — THE CLASSIC ROCK SOCIETY\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1792940400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T12:00:00+01:00\",\"sale_end_date\":\"2026-10-25T18:00:00+00:00\",\"sale_start_date\":\"2025-10-24T12:00:00+01:00\",\"event_start_date\":\"2026-10-25T18:30:00+00:00\",\"event_end_date\":\"2026-10-25T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"53xg5y-sabbat-25th-oct-the-black-heart-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation