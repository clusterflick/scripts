vent\",\"artist\":\"Celeste\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview122/v4/f3/db/50/f3db50af-2a97-bf45-d052-e44c45df18ed/mzaf_18410906128556864785.plus.aac.p.m4a\",\"track_name\":\"Strange\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T06:45:00+00:00\",\"sale_end_date\":\"2026-03-14T17:00:00+00:00\",\"sale_start_date\":\"2026-01-20T07:00:00+00:00\",\"event_start_date\":\"2026-03-14T17:00:00+00:00\",\"event_end_date\":\"2026-03-14T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Solstice Events.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/R88de59b5bb1?dice_id=R88de59b5bb1\",\"post_competition_referral\":\"https://link.dice.fm/Yd49a5b7b492?dice_id=Yd49a5b7b492\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W50f96fc26f9?dice_id=W50f96fc26f9\",\"post_purchase_referral\":\"https://link.dice.fm/ub4ab6cbe4f3?dice_id=ub4ab6cbe4f3\",\"post_reminder_referral\":\"https://link.dice.fm/pb11e1459807?dice_id=pb11e1459807\",\"post_waitinglist_referral\":\"https://link.dice.fm/u65c6893592b?dice_id=u65c6893592b\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"ALLDAY INDIE INDOOR FESTIVAL - BOXPARK WEMBLEY\\n\\n🎉 A MASSIVE ALL-DAY THROWBACK PARTY CELEBRATING THE SOUND OF YOUR YOUTH. 🎉\\n\\nWe're going all in on the golden era of indie - when iPods were loaded, jeans were skinny, and festivals were lawless.\\n\\nEXPECT TO HEAR THE BIGGEST INDIE ANTHEMS FROM:\\n\\nARCTIC MONKEYS / THE 1975 / THE KOOKS / FLORENCE + THE MACHINE / JAMIE T / BLOC PARTY / MGMT / VAMPIRE WEEKEND / THE WOMBATS / FOALS / THE MACCABEES / TWO DOOR CINEMA CLUB / THE LIBERTINES / FRIENDLY FIRES / THE STROKES / ALT-J / THE VACCINES / YEAH YEAH YEAHS / THE XX + MORE\\n\\n\\\\+ ERA-DEFINING BANGERS FROM:\\n\\nLa Roux - In for the Kill (Skream Remix) / Dizzee Rascal / Example / Justice / Martin Solveig / Calvin Harris (OG era only)\\n\\n(Because indie nights always got messy in the best way.)\\n\\nWHAT TO EXPECT:\\n\\nNon-stop indie anthems & dancefloor chaos\\n\\nFestival-style DJs, visuals, confetti & immersive production\\n\\nThe best street food, cocktails, and day party energy in the city\\n\\nA crowd of thousands reliving the glory days of indie mayhem\\n\\n\\\"Indie is a feeling - the sound that shaped a generation.\\\"\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1773507600,\"venues\":[{\"id\":\"5481\",\"name\":\"Boxpark Wembley\",\"address\":\"18 Olympic Way, Wembley Park, Wembley HA9 0NU, UK\",\"location\":{\"lat\":51.56034849999999,\"lng\":-0.2794966999999999},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"boxpark-wembley-pk6k\",\"accessibility\":{\"url\":\"https://boxpark.co.uk/faqs/\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-14T17:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:48\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"3123\",\"name\":\"Solstice Events\",\"image\"