ctive\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-09T20:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/5e7b702d-97d7-4822-82fe-de3426bfa012.jpg?rect=191%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/5e7b702d-97d7-4822-82fe-de3426bfa012.jpg?rect=0%2C39%2C1150%2C690\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/5e7b702d-97d7-4822-82fe-de3426bfa012.jpg?rect=364%2C0%2C422%2C768\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/S6fafad605b1?dice_id=S6fafad605b1\",\"post_competition_referral\":\"https://link.dice.fm/he114534f3d3?dice_id=he114534f3d3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/y88cc72a0c77?dice_id=y88cc72a0c77\",\"post_purchase_referral\":\"https://link.dice.fm/naf81985f80c?dice_id=naf81985f80c\",\"post_reminder_referral\":\"https://link.dice.fm/We7ed078a2f7?dice_id=We7ed078a2f7\",\"post_waitinglist_referral\":\"https://link.dice.fm/g1ec17661dd6?dice_id=g1ec17661dd6\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"43dbb1788c9c854f:39\",\"properties\":[],\"presented_by\":\"Presented by Movimientos.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770595200,\"id\":\"6989f455c71b8700017b1003\",\"name\":\"Turbo Sonidero\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"After 6 years since his last visit, Turbo Sonidero is finally back in London for a one-off special at one of London's finest club spots, The Carpet Shop. A rare chance to catch a pioneering force in the global cumbia scene. His music hard, heavy, minimalist and haunted.\\n\\nTurbo Sonidero, an East Side San José music producer with roots in Puebla, has carved out a unique and compelling sound by fusing the vibrant energy of Cumbia Sonidera with the aesthetics of Rap and electronic music.\\n\\nSince 2008, Turbo Sonidero has been a dedicated record collector and innovative producer, co-founding Grupo Jejeje and spearheading both the Kumbia Net/Kumbia Obscura collective and Discos Piramide Record Label, championing exciting new cumbia talent from Mexico and beyond.\\n\\nHis music is inspired by Sonido Dueñez, the artist whose broken turntable infamously spawned ‘cumbia rebajada’ – a transformation into slow & low rebajadas reminiscent of the late DJ Screw.\\n\\nLike Sonido Dueñez, Turbo Sonidero has found new ways to push the rich history of cumbia music into new zones, blending cumbia sonidera with R&B oldies, hip-hop and cumbia editada – loop and sample-based Colombian dance music.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2296\",\"name\":\"Movimientos\",\"image\":{\"url\":null},\"perm_name\":\"movimientos-6ey2\",\"profile_active\":false},\"date_unix\":1775761200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T10:00:00+00:00\",\"sale_end_date\":\"2026-04-08T12:00:00+01:00\",\"sale_start_date\":\"2025-12-05T11:00:00+00:00\",\"event_start_date\":\"2026-04-09T21:00:00+01:00\",\"event_end_date\":\"2026-04-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ryawmw-orchard-9th-apr-elgar-room-at-royal-albert-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn