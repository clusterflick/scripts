":[{\"type\":\"spotify\",\"title\":\"Mama Said\",\"redirect_url\":\"https://open.spotify.com/track/3eiTlfmClIHJS7Vq4IwkBZ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dac546937f6d3d9cc57831c1a192c3c7a5e0da90?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Mama Said\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764151200,\"max_tickets\":6,\"marketeers\":[{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Cat Clyde is a singer/songwriter based out of rural Ontario, Canada. A combination of driven, soulful blues and sweet, folk- tinged, dulcet tones that carry a particular sense of familiarity provide the structure on which she creates her unique sound. With influences ranging from Patsy Cline and Lead Belly to Karen Dalton and Bobbie Gentry, this patchwork of musical significance, when stitched to her modern approach, fits like a well-tailored, corduroy-road cloth. Cat is currently finishing up her next album to be released on Concord Records, with one song being released so far, “Wild One”.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Parallel Lines\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:82\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Zd7e6fdcbc0f?dice_id=Zd7e6fdcbc0f\",\"post_competition_referral\":\"https://link.dice.fm/X4d8c1b8e5ca?dice_id=X4d8c1b8e5ca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X02ce29bcdb7?dice_id=X02ce29bcdb7\",\"post_purchase_referral\":\"https://link.dice.fm/J3c056e34e56?dice_id=J3c056e34e56\",\"post_reminder_referral\":\"https://link.dice.fm/R1405c1a3ff8?dice_id=R1405c1a3ff8\",\"post_waitinglist_referral\":\"https://link.dice.fm/v0fd31eed4d2?dice_id=v0fd31eed4d2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T10:00:00+00:00\",\"sale_end_date\":\"2026-04-30T19:00:00+01:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-04-30T19:00:00+01:00\",\"event_end_date\":\"2026-04-30T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1683,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"id\":\"6925f7f47654940001b4ff69\",\"seats_io_event_id\":null,\"name\":\"Cat Clyde\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"nvwg8l-cat-clyde-30th-apr-the-lower-third-london-tickets\",\"date_unix\":1777572000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"150\",\"name\":\"Bush Hall\",\"address\":\"310 Uxbridge Rd, London W12 7LJ\",\"location\":{\"lat\":51.5065655,\"lng\":-0.231633699999975},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-10-27/5f32c34f-a15a-457c-9953-ae3fe3a46464.jpg?rect=0%2C47%2C226%2C226\"},