bc56?dice_id=ue07e723bc56\",\"post_reminder_referral\":\"https://link.dice.fm/H6467c6bd4bd?dice_id=H6467c6bd4bd\",\"post_waitinglist_referral\":\"https://link.dice.fm/G51e609eb66d?dice_id=G51e609eb66d\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Skullcrusher - Song for Nick Drake\",\"redirect_url\":\"https://open.spotify.com/track/01B4EffzLZbFRVRMyRgta1\",\"artist\":\"Skullcrusher\",\"preview_url\":\"https://p.scdn.co/mp3-preview/74d438d828700a2dbcaaca359a2cea8fda7ce324?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Song for Nick Drake\"},{\"type\":\"apple_music\",\"title\":\"Skullcrusher - Dragon\",\"redirect_url\":\"https://music.apple.com/us/album/dragon/1800019489?i=1800019675&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Skullcrusher\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/52/5c/0a/525c0a93-694c-7811-dec2-c5ffd566e531/mzaf_9120927187760847812.plus.aac.p.m4a\",\"track_name\":\"Dragon\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Tue 16 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":3837,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":19233,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":19234,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":19235,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"yoar82-letlive-17th-jun-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781719200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"announced\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:47\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-17T19:00:00+01:00\",\"doors_close_date\":\"2026-06-17T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"letlive.\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/07016d102e5afc026b494731afce19df38a545fc\"},\"artist_id\":\"2335\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"letlive. is\\n\\nJason Aalon Butler - Vocals\\n\\nJean Nascimento - Guitar\\n\\nJeff Sahyoun - Guitar\\n\\nletlive. is returning. The trailblazing progressive soul punk outfit from Los Angeles, California, known for their genre-defying sound and raw intensity, is again stepping onto the stage.\\n\\nFormed in 2002, letlive. quickly established themselves as one of the most energetic and emotionally charged acts in the alternative music scene. Fronted by the dynamic and impassioned Jason Aalon Butler, the band blended elements of hardcore, punk, R&B, and soul to create a unique sonic identity that resonated with fans worldwide.\\n\\nTheir breakout album, Fake History (2010), gained critical acclaim for its raw emotion and innovative sound, earning them a dedicated following. This success led to their signing with Epitaph Records, where they released two more groundbreaking albums: The Blackest Beautiful (2013) and If I’m the Devil... (2016). Both records showcased the band’s evolution, tackling social justice, personal struggle, and self-discovery themes with unrelenting honesty and creativity.\\n\\nKnown for their legendary live performances, letlive. became a force of nature on stage, with shows described as chaotic yet cathartic experiences. Their unfiltered energy and Butler’s explosive stage presence connected deeply with audiences, making every performance unforgettable.\\n\\nThe band announced its breakup shortly after releasing If I’m the Devil…, and it went on hiatus. Now, letlive. is ready to return, reignited by founding members Jean Nascimento (guitar) and Jeff Sahyoun (guitar). The band is embarking on its first shows since 2016, with a highly anticipated tour spanning Australia, Europe, and the United States.\\n\\nHighlights include headline dates and appearances at major festivals like 2000 Trees, Vans Warped Tour, and When We Were Young. Jason, Jeff, and Jean will be joined by Sage Webber (Point North) on drums and Skyler Accord (Issues) on bass.\\n\\nletlive.'s return is more than a farewell — it’s a rebirth. This reunion celebrates their groundbreaking past and continues their mission to challenge, inspire, and connect with fans through their unapologetically honest and emotionally charged music.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T10:00:00+00:00\",\"sale_end_date\":\"2026-06-17T18:00:00+01:00\",\"sale_start_date\":\"2026-02-18T10:00:00+00:00\",\"event_start_date\":\"2026-06-17T19:00:00+01:00\",\"event_end_date\":\"2026-06-17T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"698f3cde68765d000129575c\",\"name\":\"letlive.\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/62f3c270-b0e7-4901-ac7f-29dd3077be21.jpg?rect=2878%2C0%2C5746%2C5746\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/62f3c270-b0e7-4901-ac7f-29dd3077be21.jpg?rect=963%2C0%2C9577%2C5746\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/62f3c270-b0e7-4901-ac7f-29dd3077be21.jpg?rect=4171%2C0%2C3160%2C5746\"},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771236000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/c51d0348e8bf?dice_id=c51d0348e8bf\",\"post_competition_referral\":\"https://link.dice.fm/X93d856ec51f?dice_id=X93d856ec51f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h8865a01b4ac?dice_id=h8865a01b4ac\",\"post_purchase_referral\":\"https://link.dice.fm/R964a710bfaf?dice_id=R964a710bfaf\",\"post_reminder_referral\":\"https://link.dice.fm/T36725441e50?dice_id=T36725441e50\",\"post_waitinglist_referral\":\"https://link.dice.fm/yfdabd94b427?dice_id=yfdabd94b427\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"A Weak Ago\",\"redirect_url\":\"https://open.spotify.com/track/3rY98pNrVY2OOacnbxbI0E\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f2a615a5b5ec812880e24e0e1e9bc057844e653f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"A Weak Ago\"},{\"type\":\"apple_music\",\"title\":\"letlive. - Younger\",\"redirect_url\":\"https://music.apple.com/us/album/younger/1485058066?i=1485058076&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"letlive.\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/c9/ae/c3/c9aec35c-fa48-9c4c-1dd2-ecae3088b83a/mzaf_15285239984523530799.plus.aac.p.m4a\",\"track_name\":\"Younger\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"EUR\",\"amount\":1442,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Présenté par DEAD CHIC.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"143414\",\"name\":\"DEAD CHIC\",\"image\":{\"url\":null},\"perm_name\":\"dead-chic-2pdn7\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"q27p6p-dead-chic-live-ldn-17th-jun-the-water-rats-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1781719200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:48\",\"venues\":[{\"id\":\"529\",\"name\":\"The Water Rats\",\"address\":\"328 Gray's Inn Rd, London WC1X 8BZ\",\"location\":{\"lat\":51.5290131,\"lng\":-0.119418900000028},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-water-rats-zg85\",\"accessibility\":{\"url\":\"https://www.thewaterratsvenue.london/location/#:~:text=The%20Pub%20and%20the%20Live,There%20is%20no%20lift.\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-17T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dead Chic\",\"image\":null,\"artist_id\":\"109277\",\"about\":{\"description\":\"**Dead Chic** bring their dark, cinematic rock to The Water Rats for their UK debut. Fronted by Andy Balcon (UK) (Heymoonshaker) alongside French guitarist Damien Félix (FR) (ex-Catfish), the band fuse heavy rock, soul and raw emotion into a sound built for the stage — intense, visceral and uncompromising.\\n\\nTheir debut album Serenades & Damnation earned strong critical praise, with **Rolling Stone France** hailing Dead Chic as : *“a cinematic and brilliantly orchestrated blend of heavy rock and soul.”*\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"UK Debut Show\\n\\nDead Chic (FR) make their UK live debut at The Water Rats, London.\\n\\nA powerful blend of dark, cinematic rock and soul, built for intensity and atmosphere.\\n\\nAn explosive live band\\n\\nFeaturing Andy Balcon (Heymoonshaker) and Damien Félix (ex-Catfish), delivering raw, visceral performances.\\n\\nCritically acclaimed\\n\\nTheir debut album Serenades & Damnation was praised by Rolling Stone France as\\n\\n“a cinematic and brilliantly orchestrated blend of heavy rock and soul.”\\n\\n⚡ A rare, unmissable show\\n\\nA one-off London performance that promises energy, emotion and impact.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Réservé aux plus de 18 ans\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{