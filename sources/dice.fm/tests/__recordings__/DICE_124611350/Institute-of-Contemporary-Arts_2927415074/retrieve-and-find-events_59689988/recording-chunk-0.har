ull,\"doors_open_date\":\"2026-11-19T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":4,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:19\",\"tty_to_extras\":[],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"112\",\"name\":\"Bird On The Wire\",\"image\":{\"url\":null},\"perm_name\":\"bird-on-the-wire-jqo9\",\"profile_active\":true},\"id\":\"696a15c3eb5a600001edd1f5\",\"name\":\"Life Without Buildings\",\"perm_name\":\"xe2k5e-life-without-buildings-19th-nov-koko-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/d7b02c7d-d839-4e4f-93ac-fbfebf57ab20.jpg?rect=0%2C0%2C1350%2C1350\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/d7b02c7d-d839-4e4f-93ac-fbfebf57ab20.jpg?rect=0%2C270%2C1350%2C810\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/d7b02c7d-d839-4e4f-93ac-fbfebf57ab20.jpg?rect=304%2C0%2C743%2C1350\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Life Without Buildings\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b273f557471eedfbd9a7ab55d75b\"},\"artist_id\":\"132484\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1768557600,\"faqs\":[{\"id\":51573,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0}],\"price\":{\"currency\":\"GBP\",\"amount\":4421,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T12:00:00+00:00\",\"sale_end_date\":\"2026-11-19T19:00:00+00:00\",\"sale_start_date\":\"2025-11-28T12:00:00+00:00\",\"event_start_date\":\"2026-11-19T19:00:00+00:00\",\"event_end_date\":\"2026-11-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Control Voltage\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":null,\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Kcfddd8d5885?dice_id=Kcfddd8d5885\",\"post_competition_referral\":\"https://link.dice.fm/mee985c2691f?dice_id=mee985c2691f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/f3b662e00ab4?dice_id=f3b662e00ab4\",\"post_purchase_referral\":\"https://link.dice.fm/Ab6fe5085461?dice_id=Ab6fe5085461\",\"post_reminder_referral\":\"https://link.dice.fm/W7b79c18314e?dice_id=W7b79c18314e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cab97436b9a6?dice_id=Cab97436b9a6\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The name says it all, Electronic Music Open Mic or EMOM for short is an open stage night for local electronic musicians.\\n\\nThis free night will showcase up to 7 local electronic artists performing an array of different types of music ranging from house, techno, ambient, industrial, chiptune, looping, field recording, experimental electronica and more.\\n\\nEMOM has become a movement over the last 2 years with regular independent nights hosted in many cities and counties across the UK. This night is aimed at giving local electronic music artists a supportive space to play live and experiment.\\n\\nThese nights are great fun for both artists and fans of electronic music, you never know what genre you might hear next!\\n\\nThe format is simple; each artist will get a 20-minute window (including set up time) to do their thing before handing over to the next artist. The only rule is no guitars unless they are being used to generate soundscapes or some other style of music in keeping with these nights.\\n\\nIf you’d like to play, please email controlvoltageemom@gmail.com to register. If you’d just like to come along and watch, just click the ‘buy now’ link to secure your place. The night is completely free whether you are playing or watching.\\n\\nAll ages welcome – under 16 to be accompanied by a responsible adult.\\n\\nThis event is hosted by Control Voltage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 to be accompanied by a responsible adult\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1795114800,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-19T19:00:00+00:00\",\"do