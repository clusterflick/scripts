types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-01/29751b65-9055-46de-a765-dc4211eb4f0f.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-01/29751b65-9055-46de-a765-dc4211eb4f0f.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-01/29751b65-9055-46de-a765-dc4211eb4f0f.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"announcement_date_unix\":1759275000,\"max_tickets\":4,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"bf278881-798e-4760-b411-3fe3d4dd451a\",\"seats_io_public_key\":\"b6cacc81-15a1-4778-90c1-515c20e0c024\",\"seat_selection\":\"disabled\"},\"about\":{\"description\":\"***Kris Drever is among Scotland’s most acclaimed and distinctive contemporary musicians, celebrated for his warm voice, virtuosically expressive guitar playing and imaginative and evocative songwriting.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nRaised in the Orkney Islands, Kris Drever has carved out a unique place at the intersection of traditional folk and modern acoustic music, as a solo artist and as one-third of the award-winning trio Lau. His solo work combines lyrics of depth and authenticity with expertly pitched arrangements, exploring themes of place, identity, and social change, delivered with clarity, compassion, and poetic insight.\\n\\nKris will be playing some brand new songs from his new album, as well as a selection from his back catalogue of originals and his storied interpretations of traditional material.\\n\\n**In partnership with Alan Bearman Music**\\n\\n***This event will last approximately 110 minutes, including an interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Kings Place.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:26\",\"social_links\":{\"event_share\":\"https://link.dice.fm/xbc22300308d?dice_id=xbc22300308d\",\"post_competition_referral\":\"https://link.dice.fm/Cd89b5be85bb?dice_id=Cd89b5be85bb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I25f086d4dd9?dice_id=I25f086d4dd9\",\"post_purchase_referral\":\"https://link.dice.fm/i1d2588f507e?dice_id=i1d2588f507e\",\"post_reminder_referral\":\"https://link.dice.fm/Tcb92d326011?dice_id=Tcb92d326011\",\"post_waitinglist_referral\":\"https://link.dice.fm/C32195f0a176?dice_id=C32195f0a176\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-01T00:30:00+01:00\",\"sale_end_date\":\"2026-04-26T14:00:00+01:00\",\"sale_start_date\":\"2025-10-02T11:45:00+01:00\",\"event_start_date\":\"2026-04-26T18:30:00+01:00\",\"event_end_date\":\"2026-04-26T20:50:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2729,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"id\":\"68de5608242d8600016b1cdf\",\