itinglist_referral\":\"https://link.dice.fm/Ga8cd9c20bc5?dice_id=Ga8cd9c20bc5\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"5375qk-former-champ-flypaper-starter-car-12th-mar-the-victoria-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1773343800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:79\",\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-02/b550a637-e31d-457c-989d-e4e750ee17f2.jpg?rect=898%2C0%2C3649%2C3649\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-02/b550a637-e31d-457c-989d-e4e750ee17f2.jpg?rect=0%2C192%2C5444%2C3266\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-02/b550a637-e31d-457c-989d-e4e750ee17f2.jpg?rect=1719%2C0%2C2007%2C3649\"},\"id\":\"6957b9882a8e250001daa615\",\"name\":\"Former Champ + Flypaper + Starter Car\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Triples Is Best is delighted to return to The Victoria Dalston on March 12th with the excellent Former Champ!\\n\\nHailing from Ireland and Scotland and based now in Glasgow, the five members of Former Champ are long-time friends, and their music holds traces of years of shared tastes and swapped, well-loved records. There’s echoes of Teenage Fanclub’s melodic sixth sense, The Strokes’ early dichotomy of coolness and control, and the primary-coloured hedonism of Thin Lizzy.\\n\\nThey recently released their debut album ‘i saw you in paradise’ on their own label Hand of God. Receiving widespread support from Stereogum, Brooklyn Vegan, The Skinny, 6 Music and BBC Radio, the record's ten tracks sparkle with melody, character, and sharply recognisable details of love, friendship and contemporary life. It’s a perfect-ten of perfect pop.\\n\\nSupport comes from Flypaper and Starter Car\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-05T09:00:00+00:00\",\"sale_end_date\":\"2026-03-12T18:00:00+00:00\",\"sale_start_date\":\"2026-01-05T09:30:00+00:00\",\"event_start_date\":\"2026-03-12T19:30:00+00:00\",\"event_end_date\":\"2026-03-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Former Champ - porcelain\",\"redirect_url\":\"https://music.apple.com/us/album/porcelain/1816006918?i=1816006919&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Former Champ\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/be/28/14/be2814db-55ed-f09f-b4a3-f74cc34481ae/mzaf_14248621800663580443.plus.aac.p.m4a\",\"track_name\":\"porcelain\"},{\"type\":\"spotify\",\"title\":\"Former Champ - porcelain\",\"redirect_url\":\"https://open.spotify.com/track/3O8faLQo4WfTrQmntxMcKa\",\"artist\":\"Former Champ\",\"preview_url\":\"https://p.scdn.co/mp3-preview/dc99bdd559194b7f360a7250855d895fe40e88d7?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"porcelain\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"nam