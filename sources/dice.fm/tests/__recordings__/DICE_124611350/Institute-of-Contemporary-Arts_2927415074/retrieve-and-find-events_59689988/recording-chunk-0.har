78\"]}],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"id\":\"698c4ae35ebe0e0001ffc9d7\",\"name\":\"MUNA: Q&A + Album Playback\",\"perm_name\":\"oev5br-muna-qa-album-playback-20th-feb-rough-trade-east-london-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/5812c352-e0b2-4573-b968-a323ea4421d1.jpg?rect=433%2C0%2C1684%2C1684\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/5812c352-e0b2-4573-b968-a323ea4421d1.jpg?rect=0%2C77%2C2550%2C1530\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/5812c352-e0b2-4573-b968-a323ea4421d1.jpg?rect=812%2C0%2C926%2C1684\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"new\":false,\"announcement_date_unix\":1770984000,\"faqs\":[{\"id\":76169,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":76170,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":76171,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":76172,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":76173,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":76174,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":76175,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":76176,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":76177,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":76178,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2080},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"MUNA - Dancing On The Wall\",\"redirect_url\":\"https://open.spotify.com/track/3bGsC1pOytPEIeYL51p9Pp\",\"artist\":\"MUNA\",\"preview_url\":\"https://p.scdn.co/mp3-preview/630e49cfb028abbcbd79fc7c435057773e92855d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dancing On The Wall\"},{\"type\":\"apple_music\",\"title\":\"MUNA - Dancing On The Wall\",\"redirect_url\":\"https://music.apple.com/us/album/dancing-on-the-wall/1870702692?i=1870702698&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"MUNA\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/7a/ff/bd/7affbd11-d26c-6276-4dc8-a377902d44ab/mzaf_7002778124496334496.plus.aac.p.m4a\",\"track_name\":\"Dancing On The Wall\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T18:15:00+00:00\",\"sale_end_date\":\"2026-02-20T21:30:00+00:00\",\"sale_start_date\":\"2026-02-10T18:15:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by False Locust.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/s4c34154cead?dice_id=s4c34154cead\",\"post_competition_referral\":\"https://link.dice.fm/Ce9b6770f9c5?dice_id=Ce9b6770f9c5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k6d0ac035abd?dice_id=k6d0ac035abd\",\"post_purchase_referral\":\"https://link.dice.fm/Yea42520c38c?dice_id=Yea42520c38c\",\"post_reminder_referral\":\"https://link.dice.fm/E2cfe144677f?dice_id=E2cfe144677f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Gfa5a7084633?dice_id=Gfa5a7084633\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Delighted to make a last-minute, impromptu return to THE Horse Hospital, featuring some of our favourite artists in the world: Kenichi Iwasa + Elvin Brandhi, each playing solo, and as a duo. And! Boy Lucid, and aloisius (DJ).\\n\\nElvin Brandhi is an improvising lyricist, producer and sound artist from Bridgend, Wales making auto-tune blast beats from field recordings, tapes, instruments and voice. Live shows are unyielding bursts of erupting animation where her caustic stream of consciousness cavorts with restless, glitched out heaviness.\\n\\nKenichi Iwasa is a London based improviser and multidisciplinary artist from Japan. Also known for his legendary event Krautrock Karaoke night, he has collaborated with visual artists and musicians such as Beatrice Dillon, Maxwell Sterling and Linder Sterling.\\n\\naloisius is an improvisation based artist, dj, curator & founder of the gesamtkunstwerk 'life is beautiful'.\\n\\nBoy Lucid is a composer from Ireland based in London. Interweaving field recordings with digital instrumentals, unknown voices and song, they form mythical landscapes of loss, longing and connection. They currently explore vocal improvisation and are part of the collective Roca, organising outdoor events in parks when it's warm.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"1505\",\"name\":\"The Horse Hospital\",\"address\":\"The Horse Hospital, 30 Colonnade, Bloomsbury, London WC1N 1JD, UK\",\"location\":{\"lat\":51.5230123,\"lng\":-0.12402510000003986},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-horse-hospital-g7ka\",\"accessibility\":{\"url\