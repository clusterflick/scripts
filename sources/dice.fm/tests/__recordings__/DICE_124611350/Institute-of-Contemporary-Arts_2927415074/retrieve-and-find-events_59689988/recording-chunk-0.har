perm_name\":\"229-zl9b\",\"accessibility\":{\"url\":\"https://229.london/access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T18:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"SUPERFEST 90x–2000x brings the iconic atmosphere of the 90s and 2000s back to London.\\n\\nA powerful live concert featuring legendary hits of the era, performed by well-known artists and special guests.\\n\\nExpect a large stage production, professional concert sound, high-energy performances and the true nostalgia of two unforgettable decades.\\n\\nThis is a night filled with the music we grew up with all in one place, one night only.\\n\\nAlexa Pol & Project A\\n\\nGroup SHPAGAT\\n\\nDaria Chebotareva\\n\\nTAKNADO\\n\\nSamanta Kobakova\\n\\nAleksey Matveev\\n\\nDJ Vlas\\n\\nand special guests\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-25T00:00:00+00:00\",\"sale_end_date\":\"2026-02-27T17:00:00+00:00\",\"sale_start_date\":\"2026-01-25T00:00:00+00:00\",\"event_start_date\":\"2026-02-27T18:30:00+00:00\",\"event_end_date\":\"2026-02-27T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69767087b8b6e40001da13d4\",\"name\":\"SUPERFEST 90x–2000x\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-25/03035f6f-6ab8-47e3-a80c-9e3e43ac8bb8.jpg?rect=0%2C241%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-25/03035f6f-6ab8-47e3-a80c-9e3e43ac8bb8.jpg?rect=0%2C625%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-25/03035f6f-6ab8-47e3-a80c-9e3e43ac8bb8.jpg?rect=300%2C0%2C1321%2C2402\"},\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769299200,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/Za47e1e26aa2?dice_id=Za47e1e26aa2\",\"post_competition_referral\":\"https://link.dice.fm/ye56207a67f5?dice_id=ye56207a67f5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Yf3e8df2ef7e?dice_id=Yf3e8df2ef7e\",\"post_purchase_referral\":\"https://link.dice.fm/O6d371c3d043?dice_id=O6d371c3d043\",\"post_reminder_referral\":\"https://link.dice.fm/D77ada424803?dice_id=D77ada424803\",\"post_waitinglist_referral\":\"https://link.dice.fm/B661c0de5c9a?dice_id=B661c0de5c9a\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Short Waves.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"2399\",\"name\":\"The Victoria Dalston\",\"image\":{\"url\":null},\"perm_name\":\"the-victoria-dalston-l3wp\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"eo3ep2-ulysses-wells-alex-colman-more-tba-27th-feb-the-victoria-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772217000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:25\",\"venues\":[{\"id\":\"54\",\"name\":\"The Victoria\",\"address\":\"451 Queensbridge Road, London E8 3AS\",\"location\":{\"lat\":51.5457498,\"lng\":-0.0701916000000438},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-victoria-j5wd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ulysses Wells\",\"image\":null,\"artist_id\":\"30999\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Short Waves Presents:\\n\\n**Ulysses Wells**, the genre-defying British artist known for blending blues, psychedelia, electronica, rock, and acoustic folk, enters 2026 at full velocity returning to the stage with a live show built for impact! \\n\\nFollowing years of critically praised releases, sold-out performances, and a six-week European tour as supporting guitarist with Queens of the Stone Age, Wells comes back sharpened, heavier, and more assured than ever. Night after night, performing to thousands, he absorbed the discipline, power, and danger of arena-level rock an influence now fully embedded in his own live shows.\\n\\nThis is not a solo show. Itʼs a band in full flight. \\n\\nWells is joined by a formidable group of long-standing collaborators Jason Gale (bass), Josh Bennet (drums), and Henry Grigg (keys) musicians widely regarded as some of the UKʼs finest players with special musical friends and collaborators appearing at select shows, giving each night its own unique character and sonic breadth.Together, they deliver a live performance rooted in years of shared experience: tight, explosive, dynamic, and deeply musical. \\n\\n“In a world full of digital drums and polished edges, I wanted this record to feel human,” says Wells. \\n\\n“Itʼs about friction, imperfection, and energy the things that made me fall in love with music in the first place.” \\n\\nOriginally from Warwickshire and now based in London, Wells spent months in creative isolation refining material that has been quietly developing for over seven years. That patience has paid off. His catalogue spanning multiple Albums and singles has amassed millions of streams, while his reputation as a must-see live performer continues to grow. \\n\\nWells has previously toured with Bastille, Lewis Capaldi, and Barns Courtney, and shared festival stages with George Ezra, Jake Bugg, and Sea Girls. His music has featured across dozens of Spotify and Apple Music editorial playlists, including Best New Rock and Best of the Week, and has been championed by Radio X, Beats 1, The Line of Best Fit, and Gigslutz.\\n\\nHis songs have also secured major sync placements across Netflix, E4, Sky Sports, and the Premier League. His work has drawn praise from across the rock world including a succinct endorsement from Metallicaʼs Lars Ulrich, who described it simply as: “Just awesome.” \\n\\nIn 2026, with a renewed focus on independence, a battle-hardened live band, and the confidence of an artist who has stood shoulder-to-shoulder with one of rockʼs most revered acts, Ulysses Wellsʼ live shows are raw, loud, intimate, and unmissable. \\n\\nThis is not nostalgia. \\n\\nThis is modern rock played like it matters.\\n\\n\\\\+ **Alex Colman**: Acoustic Rock, Blues and Americana delivered authentically by a seasoned performer who means it\\n\\n\\\\+ more tba\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-11T23:00:00+00:00\",\"sale_end_date\":\"2026-02-27T17:30:00+00:00\",\"sale_start_date\":\"2026-01-11T23:00:00+00:00\",\"event_start_date\":\"2026-02-27T18:30:00+00:00\",\"event_end_date\":\"2026-02-27T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696560b6875e55000146b65d\",\"name\":\"Ulysses Wells + Alex Colman & more tba\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/0132bcb6-e3fc-4472-b1e4-ac7eaf8f9e7b.jpg?rect=353%2C0%2C1333%2C1333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/0132bcb6-e3fc-4472-b1e4-ac7eaf8f9e7b.jpg?rect=0%2C67%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/0132bcb6-e3fc-4472-b1e4-ac7eaf8f9e7b.jpg?rect=634%2C0%2C733%2C1333\"},\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1768172400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/jf0428d69d7d?dice_id=jf0428d69d7d\",\"post_competition_referral\":\"https://link.dice.fm/J1d8aca3374b?dice_id=J1d8aca3374b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c34f34e38dae?dice_id=c34f34e38dae\",\"post_purchase_referral\":\"https://link.dice.fm/hc5bc857548d?dice_id=hc5bc857548d\",\"post_reminder_referral\":\"https://link.dice.fm/Kf5ee8b0979a?dice_id=Kf5ee8b0979a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Uc8acde36659?dice_id=Uc8acde36659\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":3605,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by SJM Concerts.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":23938,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth: 15cm\",\"order\":0},{\"id\":73873,\"title\":\"How tickets work for O2 Academy Brixton? \",\"body\":\"Tickets will be in the O2 Academy Venues app as they’re handling ticket scanning for this event. We will email you when your tickets are available in the app.\\n\\nHow to use your tickets:\\n\\n1\\\\. Get the O2 Academy Venues app: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\\n\\n2\\\\. Sign up using the email you used to purchase your tickets on DICE\\n\\n3\\\\. At the door, show your tickets on the O2 Academy Venues app (not DICE)\",\"order\":1},{\"id\":73874,\"title\":\"How do I download the O2 Academy Venues app?\",\"body\":\"The O2 Academy Venues app is available to download for iOS and Android: https://www.academymusicgroup.com/o2academybrixton/o2-academy-venues-app\",\"order\":2},{\"id\":73875,\"title\":\"How do I find my ticket?\",\"body\":\"Your ticket is stored on the “Tickets” section of the O2 Academy Venues app. Simply select where you booked your tickets and log in using the email address you purchased your tickets with.\",\"order\":3},{\"id\":73876,\"title\":\"Can I change my seat?\",\"body\":\"Seats can’t be changed after booking, so please review your selection carefully before checkout.\",\"order\":4},{\"id\":73877,\"title\":\"Do I need to transfer tickets to the rest of my group?\",\"body\":\"Yes, access to the venue requires all members of your group to have their own ticket, so make sure you transfer these in the O2 Academy Venues app before arriving at the venue. Ticket transfer will not be available for this event on DICE.\",\"order\":5},{\"id\":73878,\"title\":\"I can’t make it anymore, can I sell my ticket? \",\"body\":\"DICE Wait list returns are not available for this venue. You must use the O2 Academy Venues app to securely resell your tickets to another fan.\",\"order\":6},{\"id\":73879,\"title\":\"How to book accessible tickets for O2 Academy Brixton\",\"body\":\"More info on accessibility here: https://www.academymusicgroup.com/o2academybrixton/accessibility\",\"order\":7},{\"id\":73941,\"title\":\"How do I travel to the venue?\",\"body\":\"The venue is easily accessible by public transport. There are no parking facilities. Check all local transport routes for the latest information, services and timetables.\\n\\nLocation information and all accessible travel options can be found here: https://www.academymusicgroup.com/o2academybrixton/getting-here\\n\\nPlan ahead and always know how you're going to get home.\",\"order\":8}],\"billing_promoter\":{\"id\":\"1141\",\"name\":\"SJM Concerts\",\"image\":{\"url\":null},\"perm_name\":\"sjm-concerts-xe8k\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"eorodw-tourist-27th-feb-o2-academy-brixton-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772218800,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:26\",\"venues\":[{\"id\":\"650\",\"name\":\"O2 Academy Brixton\",\"address\":\"211 Stockwell Road, London SW9 9SL\",\"location\":{\"lat\":51.4653454,\"lng\":-0.115164400000026},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-academy-brixton-bbav\",\"accessibility\":{\"url\":\"https://www.academymusicgroup.com/o2academybrixton/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-27T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tourist\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb23551061ed0a6992577f0bec\"},\"artist_id\":\"88\",\"about\":{\"description\":\"London-based songwriter Tourist makes yearning, bittersweet dance tracks designed for the afters and beyond. Tourist first came on to the scene with offbeat remixes of offbeat artists such as Ariel Pink and HEALTH, and his self-titled 2012 EP possessed sunny ’80s-inspired synthesiser melodies and leisurely tempos that were in line with the chillwave subgenre. But Tourist’s subsequent work took a darker, more poignant turn: “You know a Venn diagram,\\\" he once told Billboard. \\\"My left circle would be electronic music and the right circle would be emotions, atmosphere, honesty.”\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Duskus\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-11/f4f01885-2e16-4176-9ab8-06432530f849.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"86249\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"SJM Concerts Presents:\\n\\nTourist\\n\\nPlus Support\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"8+, u14s in the balcony with 18+\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\