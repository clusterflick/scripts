.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/7991bb37-6491-447e-becb-c111e9f04343.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/7991bb37-6491-447e-becb-c111e9f04343.jpg?rect=563%2C0%2C1375%2C2500\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1771272000,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ddd2ae71db88?dice_id=Ddd2ae71db88\",\"post_competition_referral\":\"https://link.dice.fm/B01c2a87d5d0?dice_id=B01c2a87d5d0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K0badb890209?dice_id=K0badb890209\",\"post_purchase_referral\":\"https://link.dice.fm/s0394b7d9112?dice_id=s0394b7d9112\",\"post_reminder_referral\":\"https://link.dice.fm/Ca32a9c21929?dice_id=Ca32a9c21929\",\"post_waitinglist_referral\":\"https://link.dice.fm/S8b7058afea9?dice_id=S8b7058afea9\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Ninety One Living Room.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"10115\",\"name\":\"Ninety One\",\"image\":{\"url\":null},\"perm_name\":\"ninety-one-m75r\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"av3ga2-birty-jazz-electronic-fusion-28th-feb-ninety-one-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772301600,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:69\",\"venues\":[{\"id\":\"3396\",\"name\":\"Ninety One \",\"address\":\"91 Brick Ln, Spitalfields, London E1 6QL, UK\",\"location\":{\"lat\":51.5214425,\"lng\":-0.07235059999999999},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"ninety-one-6pob\",\"accessibility\":{\"url\":\"https://91livingroom.com/access-faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"about\":{\"description\":\"On Saturday 28th February, we are hyped to welcome \\\"birty\\\" - the debut project from saxophonist, vocalist and producer Hannah-Mae Birtwell to the Ninety One Stage.\\n\\nThe live band features Hannah-Mae on sax, vocals and sampler, alongside James Morgan (drums), Basile Petite (bass) and Jack Page (keys), delivering an energetic and explorative performance rooted in groove, collaboration and electronic/jazz genre-fusion.\\n\\nDoors 6pm with live music from 7pm.\\n\\nbirty's music encompasses breakbeat, garage, jazz, hip-hop, DnB and more — blending live improvisation with tight electronic grooves and sample-based vocals.\\n\\n\\\"birty\\\" is the debut project from saxophonist, vocalist and producer Hannah-Mae Birtwell. Hannah has gained recognition performing with numerous projects including Nubiyan Twist, TC & The Groove Family and Dargz across the UK and Europe.\\n\\nWhilst studying jazz saxophone at Leeds Conservatoire, Hannah was captivated by the city's vibrant underground electronic music scene. After becoming a well-established DJ, she began producing music that combined her saxophone performance with her passion for electronic music and classic dance grooves. This is when \\\"birty\\\" was born.\\n\\nBook your table here: https://www.opentable.co.uk/r/ninety-one-living-room-london\\n\\n\\\\*This is an 18+ event, physical & scannable ID required on entry.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-27T00:00:00+00:00\",\"sale_end_date\":\"2026-02-28T20:30:00+00:00\",\"sale_start_date\":\"2025-10-27T01:00:00+00:00\",\"event_start_date\":\"2026-02-28T18:00:00+00:00\",\"event_end_date\":\"2026-02-28T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6966726f2a0256000138b9d3\",\"name\":\"Birty: Jazz & Electronic Fusion \",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/dc773684-7e66-42fc-8872-3e6ec41b5293.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/dc773684-7e66-42fc-8872-3e6ec41b5293.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/dc773684-7e66-42fc-8872-3e6ec41b5293.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room\",\"privacy_policy_link\":\"https://91livingroom.com/homepage/privacy-policy/\",\"fb_pixel_id\":\"580346810496200\",\"ga_tracking_id\":\"302117538\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1761523200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/K77d6c126804?dice_id=K77d6c126804\",\"post_competition_referral\":\"https://link.dice.fm/Z6fd555de70b?dice_id=Z6fd555de70b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ua2e8b21bb7b?dice_id=Ua2e8b21bb7b\",\"post_purchase_referral\":\"https://link.dice.fm/e41fa35e350b?dice_id=e41fa35e350b\",\"post_reminder_referral\":\"https://link.dice.fm/Q142b5c6b35a?dice_id=Q142b5c6b35a\",\"post_waitinglist_referral\":\"https://link.dice.fm/B979f09fe36a?dice_id=B979f09fe36a\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5371},\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"presented_by\":\"Presented by Mama Ghar Entertainment.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"seats_io_event_id\":\"a88b190f-2d6b-4d86-873b-8e50f9a5add3\",\"perm_name\":\"5385wl-bipul-chettri-the-travelling-band-kutumba-28th-feb-troxy-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772301600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":8,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:70\",\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":\"2026-02-28T23:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bipul Chettri\",\"image\":null,\"artist_id\":\"130396\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"about\":{\"description\":\"An Event for All Generations that will transport the soul of Nepalese Cultural origin & Himalayas to the heart of London! The Nepal Music Festival 2026 is featuring two of the biggest names in Nepali music !\\n\\nNepal’s Greatest Instrumental Band:\\n\\n​KUTUMBA\\n\\n​The Voice of the Mountains:\\n\\n​BIPUL CHETTRI AND THE TRAVELLING BAND\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"a88b190f-2d6b-4d86-873b-8e50f9a5add3\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T17:00:00+00:00\",\"sale_end_date\":\"2026-02-28T22:00:00+00:00\",\"sale_start_date\":\"2025-11-20T16:00:00+00:00\",\"event_start_date\":\"2026-02-28T18:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"691c9b44354a90000160be30\",\"name\":\"Bipul Chettri & The Travelling Band + Kutumba\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/38de9c2e-e4ed-4a86-a1ec-5fedc1b8903d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/38de9c2e-e4ed-4a86-a1ec-5fedc1b8903d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/38de9c2e-e4ed-4a86-a1ec-5fedc1b8903d.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1763571600,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/V6b958a63180?dice_id=V6b958a63180\",\"post_competition_referral\":\"https://link.dice.fm/J72de5d8bf02?dice_id=J72de5d8bf02\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ce87d3e9f808?dice_id=Ce87d3e9f808\",\"post_purchase_referral\":\"https://link.dice.fm/ua03a00c46fa?dice_id=ua03a00c46fa\",\"post_reminder_referral\":\"https://link.dice.fm/ad2f9e28970f?dice_id=ad2f9e28970f\",\"post_waitinglist_referral\":\"https://link.dice.fm/k797297ebe40?dice_id=k797297ebe40\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":2740,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":39941,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":39942,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":39943,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"53gpyd-the-callous-daoboys-sold-out-28th-feb-the-underworld-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":\"waiting-list\",\"date_unix\":1772301600,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:71\",\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":\"2026-02-28T22:00:00+00:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Love Rarely\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba5c86ac4de9ef0c1f3429f1c\"},\"artist_id\":\"107103\",\"about\":null,\"is_headliner\":false},{\"name\":\"Knives\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-05/86261085-0787-474e-9d0e-4b18ac93183d.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"71768\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Callous Daoboys\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-03-31/e03183b8-e55e-4c2f-8265-25c90173e65a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"48572\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"about\":{\"description\":\"I Don’t Want To See You In Heaven (MRNK Heavy) A fearlessly free-spirited collective from Atlanta, Georgia, The Callous Daoboys revels in high- strung extremity, careening from furious metal cacophony to unabashed rock 'n roll and back again. The band Kerrang! hails as “gloriously chaotic” is like a Molotov cocktail combining extreme metal and nü-metal with life-affirming glee, as each song deliriously swerves across stylistic lines. The Callous Daoboys are frontman Carson Pace, possessed like a young Mike Patton; fretboard-abusing guitarists Maddie Caffrey and Daniel Hodsdon; frantic bassist Jackie Buckalew;destructive drummer Matthew Hague; and spirited violinist Amber Christman. Celebrated by SPIN, Fader, Revolver, Brooklyn Vegan, and New Noise (who praised the band as “innovative, unflinching, brazen”), The Callous Daoboys have turned heads on raucous tours with TesseracT, Protest The Hero, and SeeYouSpaceCowboy, and at prestigious international metal festivals. Celebrity Therapist (2022) more than delivered on the promise of the band’s early rumblings. I Don’t Want to See You in Heaven (2025) ups the ante on every conceivable level. The album was produced by Dom Maduri (Silly Goose, GEL, Bummer Hill). Musically, every side of the band is also explored, with dizzyingly venomous results. Songs like “Distracted by the Mona Lisa,” “Lemon,” “The Demon of Unreality Limping Like a Dog,” run the gamut between frenzied metalcore assault and rock n’ roll abandon.\\n\\n\\\\-\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club, get your tickets: theunderworldcamden.co.uk\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-27T10:00:00+01:00\",\"sale_end_date\":\"2026-02-28T18:00:00+00:00\",\"sale_start_date\":\"2025-08-29T10:00:00+01:00\",\"event_start_date\":\"2026-02-28T18:00:00+00:00\",\"event_end_date\":\"2026-02-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68a8662fe3d6e300018f5d40\",\"name\":\"THE CALLOUS DAOBOYS | SOLD OUT\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-26/33be2120-3ae3-4d11-8319-67805f7c70dc.jpg?rect=0%2C0%2C2500%2C2500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-26/33be2120-3ae3-4d11-8319-67805f7c70dc.jpg?rect=0%2C500%2C2500%2C1500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-26/33be2120-3ae3-4d11-8319-67805f7c70dc.jpg?rect=563%2C0%2C1375%2C2500\"},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1756285200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/a6092ca23bbe?dice_id=a6092ca23bbe\",\"post_competition_referral\":\"https://link.dice.fm/O9823fd70c4f?dice_id=O9823fd70c4f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/wca498fae8fb?dice_id=wca498fae8fb\",\"post_purchase_referral\":\"https://link.dice.fm/D389f40e0abc?dice_id=D389f40e0abc\",\"post_reminder_referral\":\"https://link.dice.fm/e34b48519191?dice_id=e34b48519191\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z1118844985a?dice_id=Z1118844985a\"},\"unicorn_extras\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Callous Daoboys - Beautiful Dude Missile\",\"redirect_url\":\"https://music.apple.com/us/album/beautiful-dude-missile/1624790406?i=1624790411&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Callous Daoboys\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/79/0b/0c/790b0c13-7b54-c1