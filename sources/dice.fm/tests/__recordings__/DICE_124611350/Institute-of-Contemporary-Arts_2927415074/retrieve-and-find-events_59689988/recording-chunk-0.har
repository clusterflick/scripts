{\"name\":\"Die Kur\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebcae91db737d8fa6699fa0460\"},\"artist_id\":\"10544\",\"about\":null,\"is_headliner\":false}],\"total_artists\":5,\"total_free_texts\":5},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"14077\",\"name\":\"LVLS\",\"address\":\"3 Succession Walk, Tower Hamlets, London, E3 2RX, United Kingdom\",\"location\":{\"lat\":51.54048,\"lng\":-0.02084},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-21/ad72e6a5-12a2-4237-a9ca-943cef71211f.jpg?rect=0%2C0%2C192%2C192\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"lvls-g5oe6\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T14:00:00+00:00\",\"doors_close_date\":\"2026-03-07T22:30:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-20/5f318660-1d59-4368-9eb6-a2ffec96f50a.jpg?rect=444%2C67%2C837%2C835\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-20/5f318660-1d59-4368-9eb6-a2ffec96f50a.jpg?rect=0%2C285%2C1477%2C886\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-20/5f318660-1d59-4368-9eb6-a2ffec96f50a.jpg?rect=338%2C0%2C801%2C1456\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/V1736f0e591b?dice_id=V1736f0e591b\",\"post_competition_referral\":\"https://link.dice.fm/f10b31a8c17f?dice_id=f10b31a8c17f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W28016bfffdc?dice_id=W28016bfffdc\",\"post_purchase_referral\":\"https://link.dice.fm/Qd5ee8e6cc8d?dice_id=Qd5ee8e6cc8d\",\"post_reminder_referral\":\"https://link.dice.fm/he5436194bed?dice_id=he5436194bed\",\"post_waitinglist_referral\":\"https://link.dice.fm/rff8bef0016f?dice_id=rff8bef0016f\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:14\",\"properties\":[],\"presented_by\":\"Presented by LVLS London & The Engine Rooms.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766188800,\"id\":\"6946908cba92450001505be8\",\"name\":\"Haunted Echoes Fest\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Haunted Echoes Fest is *BACK* with a dark alternative, gothic & industrial live music in Hackney Wick this March 7th!**\\n\\nJoin us on the *7th of March in Hackney Wick, East London* for an immersive night of live music, bringing together boundary-pushing artists from across the UK underground music scene. This event is a must for fans of goth, industrial, metal and experimental live music in London.\\n\\nThe lineup features **Die Kur**, legendary avant-garde industrial music pioneers, alongside **Æl-Fierlen**, fusing black metal and shoegaze into an intense and atmospheric live set. **Palindrones** deliver shimmering industrial synthpop, blending heavy electronics with dark melodic hooks.\\n\\nAlso appearing are **Hades Labyrinth** with crushing doom metal, **The Silent Er**a bringing cinematic heaviness and post-metal atmospheres, **Deity and Devilry** with dramatic symphonic metal, and **Cryogenica**, known for their high-energy, synth-driven dark alternative sound.\\n\\nA rare gathering of emerging and established acts shaping the future of gothic, industrial and experimental underground music in East London, **this is one of the most distinctive live music events in Hackney Wick this March.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"14743\",\"name\":\"LVLS London & The Engine Rooms\",\"image\":{\"url\":null},\"perm_name\":\"lvls-london--the-engine-rooms-3oonv\",\"profile_active\":true},\"date_unix\":1772841600,\"event_tag\":null}],\"title\":\"Fri 06 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1236},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T10:00:00+00:00\",\"sale_end_date\":\"2026-03-07T12:00:00+00:00\",\"sale_start_date\":\"2025-12-12T10:00:00+00:00\",\"event_start_date\":\"2026-03-07T12:00:00+00:00\",\"event_end_date\":\"2026-03-07T17:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5kx22-uk-garage-brunch-with-lisa-maffia-crew-7th-mar-the-clapham-grand-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":12,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T12:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-12/65a46d07-f25f-4836-b9e7-0f2f51bcb919.jpg?rect=0%2C0%2C1344%2C1344\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-12/65a46d07-f25f-4836-b9e7-0f2f51bcb919.jpg?rect=0%2C269%2C1344%2C806\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-12/65a46d07-f25f-4836-b9e7-0f2f51bcb919.jpg?rect=303%2C0%2C739%2C1344\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/na5015afaa6b?dice_id=na5015afaa6b\",\"post_competition_referral\":\"https://link.dice.fm/C8eeec1a804b?dice_id=C8eeec1a804b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/e81b382a5e76?dice_id=e81b382a5e76\",\"post_purchase_referral\":\"https://link.dice.fm/oc48ffacbd36?dice_id=oc48ffacbd36\",\"post_reminder_referral\":\"https://link.dice.fm/Pc7f3dff9bbc?dice_id=Pc7f3dff9bbc\",\"post_waitinglist_referral\":\"https://link.dice.fm/S17cd750c014?dice_id=S17cd750c014\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:15\",\"properties\":[],\"presented_by\":\"Presented by The Clapham Grand.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765533600,\"id\":\"693bfc17e029830001eb1048\",\"name\":\"UK Garage Brunch with Lisa Maffia & Crew\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**UK GARAGE BRUNCH! 🤩**  \\n**SATURDAY 7th March 2026**\\n\\n\\\\*DOORS: 12PM  \\nEVENT END: 5PM  \\n\\\\*\\n\\n**Valid physical Photo ID is required!**\\n\\nWe are super excited to announce our next UK Garage Brunch.\\n\\nThis event is held on Saturday 7th March 2026 at Clapham Grand 12pm - 5pm\\n\\nDoors open at 12pm - Bottomless starts at 12:30 and ends at 1:30\\n\\nIf you have any dietary requirements, please email Dan from the Garage Brunch UK team on dan@lyricaluk.com. You must do this by the Wednesday before the event, at the latest (Wed 4th March)!!!\\n\\nPlease note: Bottomless booze finishes at 1:30pm.\\n\\n▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\\n\\n**Line up**\\n\\n★★ OXIDE & NEUTRINO\\n\\n★★ LISA MAFFIA & ROMEO\\n\\n★★ DAN JOLLY\\n\\n★★ KYLA Performing “DO YOU MIND\\n\\n★★ PIED PIPER & SHARKY P\\n\\n★★ DAN DA MAN\\n\\n★★ MISTER E\\n\\n▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\\n\\n**FOOD & DRINK**\\n\\nBottomless rum punch cocktails\\n\\nBottomless 12:30 - 1:30pm\\n\\nFood by Thunderbird chicken\\n\\nV (Quorn)\\n\\nVegan option available. Please contact us 3 days prior the event\\n\\n▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\\n\\n**ATTRACTIONS**\\n\\n★ UNLIMITED FOOD & DRINK (60 min)\\n\\n★ FREE GIVEAWAYS\\n\\n★ FULLY LICENSE BARS\\n\\n★ GAMES\\n\\n★ CHILL OUT AREA\\n\\n\\\\+ LOADS MORE !!!!\\n\\n*For any ticketing queries please contact DICE's Help Centre first, or contact info@claphamgrand.com*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"date_unix\":1772884800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1739,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T12:00:00+00:00\",\"sale_end_date\":\"2026-03-06T16:00:00+00:00\",\"sale_start_date\":\"2026-01-29T12:00:00+00:00\",\"event_start_date\":\"2026-03-07T14:00:00+00:00\",\"event_end_date\":\"2026-03-07T17:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bb395v-mass-7th-mar-the-bath-house-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"PYTKO\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb69e06b459566334a031b0b30\"},\"artist_id\":\"70623\",\"about\":null,\"is_headliner\":false},{\"name\":\"Barney Kass\",\"image\":null,\"artist_id\":\"133034\",\"about\":null,\"is_headliner\":false},{\"name\":\"Julia Mahrer Vinas\",\"image\":null,\"artist_id\":\"133035\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"13103\",\"name\":\"The Bath House\",\"address\":\"80 Eastway, Hackney, London, E9 5JH, United Kingdom\",\"location\":{\"lat\":51.54757,\"lng\":-0.02949},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d