92b10fac8\",\"post_reminder_referral\":\"https://link.dice.fm/Vda623450f10?dice_id=Vda623450f10\",\"post_waitinglist_referral\":\"https://link.dice.fm/f312aaa1f69e?dice_id=f312aaa1f69e\"},\"is_hidden_event\":false,\"secondary_status\":\"rescheduled\",\"marketeers\":[{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+Last+.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"db136d3610fd9326:43\",\"properties\":[],\"presented_by\":\"Presented by London Music Showcase.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768176000,\"id\":\"6964c793db940900014b2dac\",\"name\":\"London Music Ultimate Showcase: Festival All Dayer\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"👀 Something is happening…\\n\\nThe best way I can describe it is like one member said to me:\\n\\n‘Tim - It’s like freshers week, every week, but better, with bands and stuff…’\\n\\nand that’s how it’s been over the last 7 years since we created this group. It’s honestly the most fun we’ve had and I’m inviting everyone of you because something’s been happening for a while now and you just don’t know about it…It’s a Showcase of some of the Best London bands playing their music in London - and it’s also a MEETUP group, so you can watch the gig with a mix of regular members and newcomers. Feel free to come on your own or bring your friends and meet new people. Look for the ‘MEETUP SIGN’ or ask the Host on the Door when you arrive. It’s an awesome line-up and at one of the Top Venues in London - Great place for a beer, meet new people and see some amazing unsigned bands! 🔥🔥🚒🍻\\n\\n\\\\*\\n\\n🎶‼️ THE ULTIMATE LONDON GIG MEETUP! 💣‼️\\n\\n💥 London Music Showcase\\n\\nThere aren’t enough emojis for this, so I’ll keep it simple: BE THERE.\\n\\nIf you’ve been to the MEET-UPS over the last 7 years, you’ll know what it’s all about so come down, bring your friends, bring your foes, cancel your wedding, book Granny out of the retirement home. Whatever it takes, she won’t want miss it 😄🍻\\n\\n\\\\*\\n\\nGig Meetups 👀‼️👇\\n\\nhttps://dice.fm/promoters/london-music-showcase-6ko3\\n\\nhttps://www.instagram.com/londonmusicshowcase/\\n\\nhttps://www.meetup.com/London-Music-Showcase-Gigs-Drinks/\\n\\nhttps://www.facebook.com/LondonMusicShowcase\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10872\",\"name\":\"London Music Showcase\",\"image\":{\"url\":null},\"perm_name\":\"london-music-showcase-6ko3\",\"profile_active\":true},\"date_unix\":1771779600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":4000,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T11:00:00+00:00\",\"sale_end_date\":\"2026-02-22T17:00:00+00:00\",\"sale_start_date\":\"2025-11-17T11:00:00+00:00\",\"event_start_date\":\"2026-02-22T17:00:00+00:00\",\"event_end_date\":\"2026-02-22T19:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"8ere5r-talib-kweli-matinee-22nd-feb-the-jazz-cafe-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"2000 Seasons\",\"redirect_url\":\"https://open.spotify.com/track/5fAacciZPmLLFrr8RZ5fvn\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ad88cd4