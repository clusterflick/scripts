ed\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":4,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-19T10:00:00+00:00\",\"sale_end_date\":\"2026-03-29T21:00:00+01:00\",\"sale_start_date\":\"2025-12-19T10:00:00+00:00\",\"event_start_date\":\"2026-03-29T19:00:00+01:00\",\"event_end_date\":\"2026-03-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Gise Events.\",\"seating\":null,\"announcement_date_unix\":1766138400,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-29T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:25\",\"date_unix\":1774807200,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5371},\"social_links\":{\"event_share\":\"https://link.dice.fm/T5d2982e25ac?dice_id=T5d2982e25ac\",\"post_competition_referral\":\"https://link.dice.fm/W34630fa507c?dice_id=W34630fa507c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Kd101b0bcedd?dice_id=Kd101b0bcedd\",\"post_purchase_referral\":\"https://link.dice.fm/t602e5c67ea9?dice_id=t602e5c67ea9\",\"post_reminder_referral\":\"https://link.dice.fm/U80282a37983?dice_id=U80282a37983\",\"post_waitinglist_referral\":\"https://link.dice.fm/e00d2e9baa23?dice_id=e00d2e9baa23\"},\"perm_name\":\"eobn7w-cakal-29th-mar-islington-assembly-hall-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/601f009d-c2b3-4478-b98e-9b7052e327d0.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/601f009d-c2b3-4478-b98e-9b7052e327d0.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/601f009d-c2b3-4478-b98e-9b7052e327d0.jpg?rect=180%2C0%2C440%2C800\"},\"properties\":[],\"about\":{\"description\":\"One of Turkey’s leading new-generation artists, Çakal is coming to London for the first time with a high-energy live show featuring a special visual production and immersive stage design.\\n\\nKnown for chart-topping hits like “Lütfen,” “İmdat,” “Dünya Fani,” “Mahvettim,” and “Duman,” Çakal has become a defining voice of modern Turkish rap, blending melodic hooks with contemporary trap influences.\\n\\nThis exclusive London debut promises an unforgettable night of music and atmosphere.\\n\\nDon’t miss Çakal live in London.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6943fb67a1b6e2000187aa87\",\"name\":\"Cakal\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Cakal & Mavi - Gözler\",\"redirect_url\":\"https://music.apple.com/us/album/g%C3%B6zler/1574851681?i=1574851909&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Cakal & Mavi\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/6b/26/bc/6b26bc4d-5ccf-f747-5573-9c0540fb7aac/mzaf_17910674877565577720.plus.aac.p.m4a\",\"track_name\":\"Gözler\"},{\"type\":\"spotify\",\"title\":\"cakal - JET BABA\",\"redirect_url\":\"https://open.spotify.com/track/0nJVAwPZjuuBS9rc9KVD2v\",\"artist\":\"cakal\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a694bcbea7b06638030b7122bf7ffa2ed0d008dc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"JET BABA\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"c