alse,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"After Featuring in Last Novembers Radio City Sessions and with his debut headline show mid 2025 (sell out) Dan Owen is returning in 2026 to blow you away. During his last performance at Hot Box he recieved the longest standing ovation recorded at Hot Box lasting an impressive 3 minutes. This show is part of his 3rd album tour so expect new tunes and old!\\n\\nDAN OWEN\\n\\nKnown for his arresting, husky vocals and gritty, blues-infused pop/rock, Dan Owen is a British alternative singer/songwriter from Shropshire, England.\\n\\nDan played like he was headlining Wembley: in fact, if he gave it any more effort, we’d be genuinely concerned that he was about to have a heart attack.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":null,\"faqs\":[{\"id\":75830,\"title\":\"Entry Requirements\",\"body\":\"Always bring ID.\",\"order\":0}],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Violets\",\"redirect_url\":\"https://open.spotify.com/track/2Ma5ZhLb9WKRcecZuTm0J3\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2e7318d788fd20de1264f57adc1af71cba39f11f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Violets\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776277800,\"tty_to_extras\":[],\"venues\":[{\"id\":\"14448\",\"name\":\"The Elephants Head\",\"address\":\"224 Camden High Street, Camden, London, NW1 8QR, United Kingdom\",\"location\":{\"lat\":51.54071,\"lng\":-0.14392},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Euro