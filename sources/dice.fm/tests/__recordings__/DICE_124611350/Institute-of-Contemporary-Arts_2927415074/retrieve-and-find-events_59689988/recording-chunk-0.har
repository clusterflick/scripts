ld8Z&ct=app_event\",\"artist\":\"Rowan and Friends\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/72/b5/b2/72b5b2f6-91e8-435d-3654-beab48d15cbc/mzaf_8821227686154871127.plus.aac.p.m4a\",\"track_name\":\"I've Been Thinking About Jesus\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Falling Moon.\",\"billing_promoter\":{\"id\":\"11150\",\"name\":\"Falling Moon\",\"image\":{\"url\":null},\"perm_name\":\"falling-moon-b7wx\",\"profile_active\":false},\"date_unix\":1776967200,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"956\",\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road, london SE15 3BE\",\"location\":{\"lat\":51.4582576,\"lng\":-0.0521545000000287},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-ivy-house-nvk5\",\"accessibility\":{\"url\":\"https://www.ivyhousenunhead.com/about\"},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:14\",\"about\":{\"description\":\"On Thursday 23rd April we host the Rowan and Friends album launch at the Ivy House in Nunhead with support from Luce Rushton and one more excellent act to be revealed in due course.\\n\\nWe love Rowan and Friends and we look forwards to hearing their 2nd album \\\"Go On! Roll That Old Boulder Away\\\", and this show, which will be part of their UK tour!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769679000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Luce Rushton\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb5fb7f43584afe00de1ad7db0\"},\"artist_id\":\"81935\",\"about\":null,\"is_headliner\":false},{\"name\":\"Rowan & Friends\",\"image\":null,\"artist_id\":\"116308\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/744f47e5-1f68-4dcb-8dc5-7d90ec07d6d6.jpg?rect=0%2C0%2C2449%2C2449\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/744f47e5-1f68-4dcb-8dc5-7d90ec07d6d6.jpg?rect=0%2C490%2C2449%2C1469\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/744f47e5-1f68-4dcb-8dc5-7d90ec07d6d6.jpg?rect=551%2C0%2C1347%2C2449\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"697bd35d5ee9f00001f805d4\",\"name\":\"Rowan and Friends album launch show w/ Luce Rushton\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T09:30:00+00:00\",\"sale_end_date\":\"2026-04-23T19:00:00+01:00\",\"sale_start_date\":\"2026-01-29T21:30:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"bb3qbo-rowan-and-friends-album-launch-show-w-luce-rushton-23rd-apr-the-ivy-house-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5033},\"max_tickets\":8,\"social_links\":{\"event_share\":\"https://link.dice.fm/S8bc98206cf3?dice_id=S8bc98206cf3\",\"post_competition_referral\":\"https://link.dice.fm/W994ebc1dab2?dice_id=W994ebc1dab2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/r66f847dd889?dice_id=r66f847dd889\",\"post_purchase_referral\":\"https://link.dice.fm/he583be72ab4?dice_id=he583be72ab4\",\"post_reminder_referral\":\"https://link.dice.fm/h8c49f4b6537?dice_id=h8c49f4b6537\",\"post_waitinglist_referral\":\"https://link.dice.fm/yc3cb2b84dad?dice_id=yc3cb2b84dad\"},\"previews\":[],\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by The Clapham Grand.\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"date_unix\":1776967200,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:15\",\"about\":{\"description\":\"**THURSDAY 23RD APRIL / DOORS & BARS OPEN 7PM / SHOW STARTS APPROX. 9PM / SHOW ENDS 11PM / DJ FROM 11PM**\\n\\n**This is a 14+ event. Under 18s must have a Circle Standing ticket and be accompanied by an adult 21+ (Max. 2 U18s per adult 21+)**\\n\\nCrvena Jabuka Finally Returns to London as Part of the 40th Anniversary Tour\\n\\nAfter a run of sold-out concerts and unforgettable nights across Balkan region and Europe, legendary pop-rock band Crvena Jabuka is finally coming to London as part of their major world anniversary tour celebrating 40 years of music, emotions, and songs that have shaped generations.\\n\\nLondon is finally next, with the concert taking place at the much-loved and iconic Clapham Grand on Thursday, 23 April 2026. For many fans, this is a long-awaited return - it’s time to repeat the spectacle! After London the world tour will continue in the USA, Canada & Australia.\\n\\nThe atmosphere before and after the concert will be set by Tulum Crew, with DJs Alej and Saki delivering an energetic warm-up and an unforgettable after party.\\n\\nOn this special tour, audiences are once again enjoying the band’s timeless hits. Recently, in front of thousands of fans at Arena Zagreb, the crowd sang along to classics such as “Ima nešto od srca do srca”, “Tugo nesrećo”, “Nekako s proljeća”, “Dirlija”, “Bježi kišo s prozora”, “Stižu me sjećanja”, and many other songs that have become part of the collective musical memory.\\n\\nLondon audiences can look forward to an evening full of emotion, nostalgia, laughter, and sing-alongs — the kind of night only Crvena Jabuka can deliver. Four decades of music, one unforgettable evening, and countless memories.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must have a Circle Standing ticket and be accompanied by an adult 21+ (Max. 2 U18s per adult 21+)\",\"highlights\":[]},\"seating\":null,\"announcement_date_unix\":1769698800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/f46d7c64-0178-4a7a-9b56-2aafc168c2b3.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/f46d7c64-0178-4a7a-9b56-2aafc168c2b3.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/f46d7c64-0178-4a7a-9b56-2aafc168c2b3.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"697b7346cc32100001f8120a\",\"name\":\"Crvena Jabuka\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T15:00:00+00:00\",\"sale_end_date\":\"2026-04-23T19:00:00+01:00\",\"sale_start_date\":\"2026-01-29T15:00:00+00:00\",\"event_start_date\":\"2026-04-23T19:00:00+01:00\",\"event_end_date\":\"2026-04-23T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"537k7y-crvena-jabuka-23rd-apr-the-clapham-grand-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig