ase_referral\":\"https://link.dice.fm/Mcfa6aab6069?dice_id=Mcfa6aab6069\",\"post_reminder_referral\":\"https://link.dice.fm/m4032d5aa42a?dice_id=m4032d5aa42a\",\"post_waitinglist_referral\":\"https://link.dice.fm/ye2d9b099a2c?dice_id=ye2d9b099a2c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eo3l66-gigue-production-presents-kalben-live-in-london-5th-jun-the-garage-london-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1693,\"name\":\"Gotobeat\",\"privacy_policy_link\":\"https://www.gotobeat.com/privacy-policy/\",\"fb_pixel_id\":\"570786809997969\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1780682400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:81\",\"price\":{\"currency\":\"GBP\",\"amount\":4032,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/09b8b124-af7e-4cf8-9b7a-b470a3d9fc93.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/09b8b124-af7e-4cf8-9b7a-b470a3d9fc93.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/09b8b124-af7e-4cf8-9b7a-b470a3d9fc93.jpg?rect=243%2C0%2C594%2C1080\"},\"id\":\"695fd2f67d3c8900014d3f48\",\"name\":\"Gigue Production presents: Kalben live in London!\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"After an almost sold-out show last year, we’re coming back for more—because we didn’t get enough. As part of the 10th anniversary tour of her album Kayıp Aşklar Ülkesi, Kalben returns to London on June 5, 2026, at The Garage. With her velvet-like voice, emotional intensity, and undeniable energy, Kalben turns the stage into a shared, intimate space where songs become conversations and the audience becomes part of the moment.\\n\\nThis special night marks one of the European legs of her anniversary tour, celebrating a decade of music, stories, and connection, with Güneş Özgeç opening the night.\\n\\nWho is Kalben?\\n\\nKalben is an artist who treats her songs as confessions and her concerts as sincere, safe meeting spaces. Drawing from folk, blues, and indie pop, she weaves vulnerability and strength together, expressing deep emotions through simple yet striking lyrics.\\n\\nHer stage is a place where love, loss, freedom, and the courage of being human are spoken out loud.\\n\\nTransforming the audience from listeners into participants at every show, Kalben celebrates her 10th year as an artist with Land of Lost Lovers, released in 2026. Standing out within her rich discography—alongside albums such as Sonsuza Kadar, Kalp Hanım, and Eski Dünyanın Yangını, as well as numerous singles, duets, live recordings, and EPs—this album is considered one of her most profound and grounded works, both vocally and lyrically.\\n\\nThe Land of Lost Lovers tour—marking Kalben’s most free and fearless era—continues.\\n\\n14+; under 16s must be accompanied by an adult; no under 14s admitted at any time.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T12:00:00+00:00\",\"sale_end_date\":\"2026-06-05T18:00:00+01:00\",\"sale_start_date\":\"2026-01-09T12:00:00+00:00\",\"event_start_date\":\"2026-06-05T19:00:00+01:00\",\"event_end_date\":\"2026-06-05T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Haydi Söyle\",