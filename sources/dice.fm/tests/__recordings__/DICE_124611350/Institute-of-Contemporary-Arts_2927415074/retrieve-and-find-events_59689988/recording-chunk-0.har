\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"downstairs-at-the-dome-z6d3\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-12T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"streaming_options\":null,\"marketeers\":[{\"id\":1752,\"name\":\"Green Man\",\"privacy_policy_link\":\"https://www.greenman.net/information/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":\"waiting-list\",\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:61\",\"about\":{\"description\":\"Our first GM Presents shows come from the luminous Way Dynamic! Hailing from Melbourne, Dylan Young’s solo project melds folk-pop, art rock and baroque pop together to create a sound that will stop you in your tracks. They’ve quietly become your favourite band’s favourite band, with tour support for the likes of Waxahatchee, MJ Lenderman, Black Country, New Road and This Is Lorelei.\\n\\nOver the years (almost 25!) thousands of artists have graced our GM stages - discovering & platforming rising talent from across the globe is what keeps us going year on year. It goes without saying that we’re absolutely buzzed to bring Way Dynamic to London in May and Wales this August for GM26!\\n\\nThis show marks Way Dynamic’s first ever UK show, so catch them early, they're set for beautiful things. Oh and if you’ve not heard summer release ‘Massive Shoe’, get it on immediately… its been on repeat at GMHQ.\\n\\nThis ticket includes a £1.20 venue levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event. Under 18's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1770717600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Way Dynamic\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb83d0f86e3fa5efa6ce78ef87\"},\"artist_id\":\"133406\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-05/c86ae4ea-f920-48e0-8263-9efe83b54b3e.jpg?rect=0%2C603%2C2397%2C2397\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-05/c86ae4ea-f920-48e0-8263-9efe83b54b3e.jpg?rect=0%2C1082%2C2397%2C1438\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-05/c86ae4ea-f920-48e0-8263-9efe83b54b3e.jpg?rect=208%2C0%2C1981%2C3602\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6984e4ff0c23490001ab9233\",\"name\":\"Way Dynamic\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T10:00:00+00:00\",\"sale_end_date\":\"2026-05-12T17:00:00+01:00\",\"sale_start_date\":\"2026-02-11T10:00:00+00:00\",\"event_start_date\":\"2026-05-12T19:00:00+01:00\",\"event_end_date\":\"2026-05-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"2w8re7-way-dynamic-12th-may-downstairs-at-the-dome-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1731,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/if6d46802449?d