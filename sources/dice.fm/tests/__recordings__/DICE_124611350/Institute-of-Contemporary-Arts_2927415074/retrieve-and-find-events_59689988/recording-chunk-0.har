416ee.jpg?rect=381%2C0%2C438%2C796\"},\"properties\":[],\"about\":{\"description\":\"If you'd like to learn more about the venue's story and mission, along with how you can play your part to support them - please head here: https://bit.ly/support-ally-pally\\n\\nVenue terms and conditions can be viewed here: https://www.alexandrapalace.com/terms-and-conditions/#\\n\\nPrice includes a £2.50 venue restoration levy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69283adc9e1eda00011b7749\",\"name\":\"Super Furry Animals plus very special guests The Beta Band\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Super Furry Animals - Hello Sunshine\",\"redirect_url\":\"https://open.spotify.com/track/5vhEIPQww4g2A8zFgkDsQs\",\"artist\":\"Super Furry Animals\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c21debce4fb101858f9ac5d655d87b2a92983d85\",\"track_name\":\"Hello Sunshine\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Beta Band\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-10/9a0df960-f3c0-4c28-b2a1-5a43a8a02065.jpg?rect=84%2C0%2C833%2C833\"},\"artist_id\":\"78503\",\"about\":null,\"is_headliner\":false},{\"name\":\"Super Furry Animals \",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6772690000c46c2108f2a669b8d856f4e7331c\"},\"artist_id\":\"149\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-02T00:00:00+00:00\",\"sale_end_date\":\"2026-07-09T06:00:00+01:00\",\"sale_start_date\":\"2025-12-02T00:00:00+00:00\",\"event_start_date\":\"2026-07-12T19:30:00+01:00\",\"event_end_date\":\"2026-07-12T22:00:00+01:00\",\"is_multi_days_event\":fal