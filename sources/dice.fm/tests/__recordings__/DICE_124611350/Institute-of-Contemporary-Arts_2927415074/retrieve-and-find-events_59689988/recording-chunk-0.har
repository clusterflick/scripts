l\":\"https://link.dice.fm/vdc6d06ae4c8?dice_id=vdc6d06ae4c8\"},\"perm_name\":\"xe2ngk-kendra-morris-parlor-greens-taylor-williams-7th-may-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/54b5d7ad-c6ea-4ea0-af52-bd83053f9f5e.jpg?rect=0%2C0%2C774%2C774\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/54b5d7ad-c6ea-4ea0-af52-bd83053f9f5e.jpg?rect=0%2C155%2C774%2C464\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/54b5d7ad-c6ea-4ea0-af52-bd83053f9f5e.jpg?rect=174%2C0%2C426%2C774\"},\"properties\":[],\"about\":{\"description\":\"**Kendra Morris, Parlor Greens and Taylor Williams come together on stage for a live set defined by rhythm, interplay, and the thrill of three distinct voices fusing as one.**\\n\\nKendra Morris brings the imaginative, genre-blending energy of her fourth album Next, where doo-wop, boom-bap, rocksteady and vintage soul collide into something uniquely her own. On stage, she channels that kaleidoscopic vision live, balancing nuance, heart and spontaneity in every performance.\\n\\nParlor Greens provide the instrumental backbone, delivering rich, funky grooves that move with precision and soul. From gospel-tinged shuffles to fiery RnB solos, their chemistry is effortless, their sound both joyous and deeply expressive.\\n\\nTaylor Williams rounds out the lineup with warm, melodic vocals, grounding the collaboration while adding intimacy and subtle dynamism.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6969176bdbbdd60001516e48\",\"name\":\"Kendra Morris + Parlor Greens + Taylor Williams\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Banshee\",\"redirect_url\":\"https://open.spotify.com/track/3GmYxpXRc62mj4SuJ4WEsl\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ec21978c09bf59774a27ded699956f5247e0475a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Banshee\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kendra Morris\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-26/0b119bd5-f4a4-44d7-a9c4-01bc4cc30ef4.jpg?rect=0%2C55%2C531%2C531\"},\"artist_id\":\"14482\",\"about\":null,\"is_headliner\":false},{\"name\":\"Parlor Greens\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-02-28/d217e953-6de0-47b9-8770-f745b003b553.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"114779\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T00:00:00+00:00\",\"sale_end_date\":\"2026-05-07T17:00:00+01:00\",\"sale_start_date\":\"2026-01-09T00:00:00+00:00\",\"event_start_date\":\"2026-05-07T19:00:00+01:00\",\"event_end_date\":\"2026-05-07T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":68367,\"title\":\"Venue Restoration Levy\",\"body\":\"The restoration levy is £1.20 for 229.\",\"order\":0}],\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by 229.\",\"seating\":null,\"announc