c4rmK8\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1bae417cb8e456f39436aa5235b3447e4135f8c2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I Am\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765792800,\"max_tickets\":6,\"marketeers\":[{\"id\":495,\"name\":\"Hootananny Brixton\",\"privacy_policy_link\":\"https://hootanannybrixton.co.uk/terms-conditions/\",\"fb_pixel_id\":\"284708469113050\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":\"CALJTQBC77UCMC06OO60\",\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Satsang celebrates the 10 Year Anniversary of their landmark album 'The Story of You'. Come see the album played in its entirety as well as other Satsang favourites.\\n\\nDrawing inspiration from a diverse array of musical traditions, Satsang's sound is characterised by rich harmonies, infectious rhythms, and thought-provoking lyrics that resonate with audiences across the globe. With roots in the mountains of Montana, Satsang's music reflects the natural beauty and spiritual depth of his surroundings, while also addressing contemporary issues and themes.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hootananny Brixton.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:38\",\"social_links\":{\"event_share\":\"https://link.dice.fm/O9153876c857?dice_id=O9153876c857\",\"post_competition_referral\":\"https://l