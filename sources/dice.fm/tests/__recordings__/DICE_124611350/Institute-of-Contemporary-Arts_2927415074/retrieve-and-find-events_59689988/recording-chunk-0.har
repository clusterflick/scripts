d=T03c9c7c3562\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E8be38da52da?dice_id=E8be38da52da\",\"post_purchase_referral\":\"https://link.dice.fm/qb66c925d9a6?dice_id=qb66c925d9a6\",\"post_reminder_referral\":\"https://link.dice.fm/kaae00197fd3?dice_id=kaae00197fd3\",\"post_waitinglist_referral\":\"https://link.dice.fm/sb2e9296292c?dice_id=sb2e9296292c\"},\"shopping_cart_enabled\":true,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by NTS & FORM.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:83\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T12:00:00+00:00\",\"sale_end_date\":\"2026-04-17T21:00:00+01:00\",\"sale_start_date\":\"2025-11-28T10:00:00+00:00\",\"event_start_date\":\"2026-04-17T18:00:00+01:00\",\"event_end_date\":\"2026-04-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":\"2025-11-27T10:00:00+00:00\"},\"announcement_date_unix\":1764158400,\"offers_extras\":false,\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":4481,\"sales_tax\":0,\"amount_from\":null},\"id\":\"692478ed6bd9380001fd9c70\",\"name\":\"Yves (NTS 15)\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Yves\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-26/bdefd87b-7590-4f26-b023-bbe27350c439.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"5026\",\"about\":null,\"is_headliner\":true},{\"name\":\"Mechatok\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc04a4e2eb577da5827ef4c18\"},\"artist_id\":\"15120\",\"about\":null,\"is_headliner\":false},{\"name\":\"Oli XL\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0e72ca43274e4b72f14086e1\"},\"artist_id\":\"45116\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"538d58-yves-nts-15-17th-apr-earth-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/eea99623-a4e8-4a9e-a7e9-fe7f106c142b.jpg?rect=0%2C0%2C1015%2C1015\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/eea99623-a4e8-4a9e-a7e9-fe7f106c142b.jpg?rect=0%2C203%2C1015%2C609\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/eea99623-a4e8-4a9e-a7e9-fe7f106c142b.jpg?rect=229%2C0%2C558%2C1015\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"**NTS15 Presents**\\n\\n**This event will take place in EartH Hall.**\\n\\nSeoul-based artist Yves builds little worlds out of glitches and melodies — pop songs that move like club tracks but think like diary pages. Her music lives where warm synths, breakable feelings, and night-bus headphones meet.\\n\\nUncover 15 events across 1 week in London as part of 15 years of NTS - April 13-19\\n\\n*For more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk*\\n\\n*EartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Call Me Malcolm - Jacob\",\"redirect_url\":\"https://music.apple.com/us/album/jacob/1370115359?i=1370115695&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Call Me Malcolm\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/06/15/55/061555c5-d119-ddb9-2567-9d767079a809/mzaf_15762119903952809267.plus.aac.p.m4a\",\"track_name\":\"Jacob\"},{\"type\":\"spotify\",\"title\":\"Call Me Malcolm - Jacob\",\"redirect_url\":\"https://open.spotify.com/track/31jmCGM5heLOJ0hru4KFXL\",\"artist\":\"Call Me Malcolm\",\"preview_url\":\"https://p.scdn.co/mp3-preview/aef6f94a0a402e9e3b6323eca0a0706dc214ec5e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Jacob\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776445200,\"tty_to_extras\":[],\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-17T18:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"1888\",\"name\":\"New Cross Live\",\"image\":{\"url\":null},\"perm_name\":\"new-cross-live-y8la\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/x3824c8a5c16?dice_id=x3824c8a5c16\",\"post_competition_referral\":\"https://link.dice.fm/hb704b1d4154?dice_id=hb704b1d4154\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Oc3344fbe4d1?dice_id=Oc3344fbe4d1\",\"post_purchase_referral\":\"https://link.dice.fm/x622d1ad01bb?dice_id=x622d1ad01bb\",\"post_reminder_referral\":\"https://link.dice.fm/w5cc9094b0b8?dice_id=w5cc9094b0b8\",\"post_waitinglist_referral\":\"https://link.dice.fm/jb11aeb986eb?dice_id=jb11aeb986eb\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Be Sharp Promotions.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:84\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-18T00:00:00+00:00\",\"sale_end_date\":\"2026-04-17T17:00:00+01:00\",\"sale_start_date\":\"2025-11-19T10:00:00+00:00\",\"event_start_date\":\"2026-04-17T18:00:00+01:00\",\"event_end_date\":\"2026-04-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1763424000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"id\":\"691c8c2046f3090001e6ec4b\",\"name\":\"Call Me Malcolm\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Call Me Malcolm\",\"image\":null,\"artist_id\":\"93386\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"926be9-call-me-malcolm-17th-apr-new-cross-inn-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-18/3b29a990-b00f-4b83-9214-5ec882a75cf6.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-18/3b29a990-b00f-4b83-9214-5ec882a75cf6.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-18/3b29a990-b00f-4b83-9214-5ec882a75cf6.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Call Me Malcolm\\n\\nRazor-toothed, harmony infused, delicately ferocious ska. British 5-piece Call Me Malcolm exploded onto the Ska Punk scene in 2018 with a record described by ska legends Less Than Jake as \\\"a saving grace of the genre.\\\" Malcolm's genre blending mastery and intricate songwriting has since crafted \\\"some of the most special, unique, ambitious music in the punk underground. (BrooklynVegan) landing them at #8 in Ska Punk Daily's \\\"Albums of the Decade\\\" and #15 in Brooklyn Vegan's \\\"Best Punk Albums of 2020\\\" with consecutive releases.  \\n\\n2024 saw the release of 'Echoes and Ghosts', a 10-track, melodic powerhouse about identity, self, and suicide. Songwriter-in-chief Lucias describes it as \\\"a eulogy for the parts of myself I killed with medication, and a love letter to the silhouette I became.\\\"    \\n\\nCall Me Malcolm are the first UK band to sign with Bad Time Records (We Are The Union, Kill Lincoln, JER/Skatune Network).\\n\\n\\\"Genius\\\" - Vive Le Rock\\n\\n\\\"Nothing short of epic.\\\" - RockFreaks\\n\\n\\\"Real artistic and musical perfection.\\\" - Au Rythme du Ska\\n\\nhttps://linktr.ee/callmemalcolm\\n\\n\\\\+ supports\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s require an adult)\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":33471,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":33472,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":33473,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attenda