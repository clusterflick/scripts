",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-cause-at-60-dock-road-outside-odor\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-03T10:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"3657\",\"name\":\"The Cause \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-15/c8b2ac35-81ad-4c5a-b04a-d4b4438e3e68.jpg\"},\"perm_name\":\"the-cause-p7ek\",\"profile_active\":true},\"announcement_date_unix\":1771286400,\"social_links\":{\"event_share\":\"https://link.dice.fm/K323a96d2d7e?dice_id=K323a96d2d7e\",\"post_competition_referral\":\"https://link.dice.fm/aad6b87c0473?dice_id=aad6b87c0473\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w6452255a1ef?dice_id=w6452255a1ef\",\"post_purchase_referral\":\"https://link.dice.fm/Ddecaed2f84f?dice_id=Ddecaed2f84f\",\"post_reminder_referral\":\"https://link.dice.fm/i15b8c09070b?dice_id=i15b8c09070b\",\"post_waitinglist_referral\":\"https://link.dice.fm/U13b70b8cc01?dice_id=U13b70b8cc01\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"oev66r-a-very-very-good-friday-with-ross-from-friends-3rd-apr-the-cause-at-60-dock-road-outside-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775206800,\"has_multiple_ticket_types\":true,\"impression_id\":\"7a59805d984377b8:14\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1288},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/d36b0b56-52a4-46b6-bd3f-515968439be1.jpg?rect=0%2C180%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/d36b0b56-52a4-46b6-bd3f-515968439be1.jpg?rect=0%2C396%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/d36b0b56-52a4-46b6-bd3f-515968439be1.jpg?rect=144%2C0%2C792%2C1440\"},\"id\":\"69949a414e2eac00018d9050\",\"name\":\"A very very Good Friday with Ross From Friends \",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"House\\n\\nElectro\\n\\nFrom dawn ‘til dusk, 8 systems, one huge lineup, you know how we do… 3rd of April will be A Very Very Good Friday indeed.\\n\\nOur annual Easter Festival returns marking the start of Spring. Not built for the weak, this is a proper all day endurance. We don’t get many Bank Holiday Fridays, so we’re not wasting a minute. The first full venue show. The first real moment of the year.\\n\\nphase 1 a-z\\n\\nCybotron LIVE\\n\\nEllen Allien b2b Dr Rubinstein\\n\\nRoss From Friends (DJ)\\n\\na-z\\n\\nDetroit In Effect b2b FREAKENSTEIN\\n\\nHannah Holland\\n\\nJames Massiah\\n\\nJos\\n\\nSteven Julien: 808 Prince LIVE\\n\\nSystem Olympia\\n\\nTee Tee\\n\\nWeval (DJ)\\n\\nplus many more to come across 7+ dancefloors\\n\\nIf you’re new here, and the above doesn’t convince you, let us fill you in on AVVGF… It’s one of our rare flagship shows that sees us utilise the entire footprint of our docklands home, with soundsystems in every corner, for an extra long all day party, taking place on another rarity, a bank holiday Friday on Easter weekend.\\n\\nPre-sale totally sold out but general release of all ticket types are now on sale. A big old Bank Holiday all-dayer, from £8? Go get it.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T00:00:00+00:00\",\"sale_end_date\":\"2026-04-03T22:00:00+01:00\",\"sale_start_date\":\"2026-02-17T00:00:00+00:00\",\"event_start_date\":\"2026-04-03T10:00:00+01:00\",\"event_end_date\":\"2026-04-03T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Talk to Me You'll Understand\",\"redirect_url\":\"https://open.spotify.com/track/4Z4i631BesV0P6LTvfLAdL\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ae027a16e6a0f9b936e13ca64735023bdb065d9c?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Talk to Me You'll Understand\"},{\"type\":\"apple_music\",\"title\":\"Ross from Friends - In an Emergency\",\"redirect_url\":\"https://itunes.apple.com/gb/album/in-an-emergency/1217222670?i=1217222671&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ross from Friends\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview122/v4/8b/45/c3/8b45c370-3ea0-573d-c101-4df727a065f9/mzaf_4996350352985156548.plus.aac.p.m4a\",\"track_name\":\"In an Emergency\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Yungblud\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3b0371642fae86417c8dcda1\"},\"artist_id\":\"8156\",\"about\":{\"description\":\"English singer, songwriter and musician YUNGBLUD blends glam and punk rock with youthful angst and gritty vocals. His projects explore themes of growing up queer, unlearning toxic masculinity and self-destructive tendencies, while his live performances are a display of maximalist heavy sounds and a tongue-in-cheek on-stage persona.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":true,\"donation\":null,\"presented_by\":\"Presented by Rough Trade.\",\"tty_to_extras\":[{\"ticket_type_id\":1127284,\"extra_ids\":[\"1132943\"]},{\"ticket_type_id\":1127285,\"extra_ids\":[\"1132943\"]},{\"ticket_type_id\":1127286,\"extra_ids