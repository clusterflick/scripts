on\":{\"lat\":51.50033,\"lng\":-0.082},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"morocco-bound-wnln\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-04T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"14196\",\"name\":\"Morocco Bound\",\"image\":{\"url\":null},\"perm_name\":\"morocco-bound-6d3nb\",\"profile_active\":false},\"announcement_date_unix\":1756422000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ne4e95e48bf8?dice_id=Ne4e95e48bf8\",\"post_competition_referral\":\"https://link.dice.fm/o591d20a5ae3?dice_id=o591d20a5ae3\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d61b9adcbb5c?dice_id=d61b9adcbb5c\",\"post_purchase_referral\":\"https://link.dice.fm/ifa2f07d3d9a?dice_id=ifa2f07d3d9a\",\"post_reminder_referral\":\"https://link.dice.fm/Eb0c6ca78b67?dice_id=Eb0c6ca78b67\",\"post_waitinglist_referral\":\"https://link.dice.fm/Y669fed399ae?dice_id=Y669fed399ae\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"v3q9g6-bossa-nova-a-tribute-to-joo-gilberto-by-mario-bakuna-4th-apr-morocco-bound-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1775325600,\"has_multiple_ticket_types\":false,\"impression_id\":\"7a59805d984377b8:53\",\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=834%2C0%2C3333%2C3333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=0%2C167%2C5000%2C3000\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-29/21a13d74-c258-4c2c-b554-72338c2b8359.jpg?rect=1584%2C0%2C1833%2C3333\"},\"id\":\"6970d1d7eb8bbb00016a88bf\",\"name\":\"Bossa Nova: A Tribute to João Gilberto by Mario Bakuna\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"**Line-up: Mario Bakuna – acoustic guitar and vocals**\\n\\nAfter selling out his first show at Morocco Bound we are pleased to announce a second date in the new year!\\n\\nJoin him in celebrating the legacy of João Gilberto, the legendary Brazilian musician and pioneering father of Bossa Nova in the late 1950s. In this heartfelt tribute, Mario Bakuna presents reinterpretations of Gilberto’s work alongside his own original compositions. Audiences can expect a rich blend of traditional samba elements, syncopated rhythms of plucked chords, and the breezy sophistication that defines Bossa Nova.\\n\\nMario Bakuna is a Brazilian composer, arranger, vocalist, and guitarist with over 20 years of professional experience, currently based in London, UK. Well known for his deep exploration of traditional Brazilian rhythms, samba, jazz, and bossa nova, Mario focuses on both original compositions and fresh arrangements of works by iconic artists like Tom Jobim, Dorival Caymmi, Paulo Moura, and João Donato. In recent years, he has also dedicated his research and performance to reinterpreting Samba Jazz, a genre that emerged in 1950s Rio de Janeiro through the work of artists like Luiz Eça, Tamba Trio, and Edson Machado. This style blends Brazilian standards with sophisticated harmonies influenced by the post–bossa nova movement.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-29T00:00:00+01:00\",\"sale_end_date\":\"2026-04-04T18:00:00+01:00\",\"sale_start_date\":\"2026-01-21T14:00:00+00:00\",\"event_start_date\":\"2026-04-04T19:00:00+01:00\",\"event_end_date\":\"2026-04-04T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Beiral\",\"redirect_url\":\"https://open.spotify.com/track/5ON5zhF1Nfrs0H4PjuVoMb\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/667854aaefe9a82b5612eaad9caff180c2dc16e3?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Beiral\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wreathe\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-06/3752bff9-53cb-42cd-9b3c-5ce9afe64ba9.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"110033\",\"about\":null,\"is_headliner\":false},{\"name\":\"Habak\",\"image\":null,\"artist_id\":\"61220\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Human Disease Promo\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"98\",\"name\":\"The Black Heart\",\"address\":\"2-3 Greenland Pl, London NW1 0AP\",\"location\":{\"lat\":51.5387812,\"lng\":-0.141761200000019},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-11-28/687dc696-b005-45e0-a194-c89d23ee7bed.jpg?rect=1%2C0%2C2716%2C2716\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_n