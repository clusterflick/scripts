\"https://link.dice.fm/g458f4b51946?dice_id=g458f4b51946\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T11:00:00+00:00\",\"sale_end_date\":\"2026-04-30T19:15:00+01:00\",\"sale_start_date\":\"2026-01-09T11:00:00+00:00\",\"event_start_date\":\"2026-04-30T19:30:00+01:00\",\"event_end_date\":\"2026-04-30T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1389,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"7103\",\"name\":\"100 Club\",\"image\":{\"url\":null},\"perm_name\":\"100-club-lnlp\",\"profile_active\":true},\"id\":\"695b76da268f63000151a4d8\",\"seats_io_event_id\":null,\"name\":\"Sababa 5 + DJ Kobayashi\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"8e8akw-sababa-5-dj-kobayashi-30th-apr-the-100-club-london-tickets\",\"date_unix\":1777573800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-30T20:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"KNEECAP\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-11/6c7c070e-3c84-48d7-928c-4dd6533b9f0c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"9570\",\"about\":{\"description\":\"More darkness. More confrontation. More craic. More energy. More solidarity. More absolute bangers. And more fuel for the unrelenting engine that powers this unstoppable force. For their remarkable second album, Kneecap have come out fighting.\\n\\nClosing 2025 with two sold out nights in front of 24,000 Fenians at Dublin’s huge 3Arena, and beginning the year with a tour of Japan, 2026 will see Kneecap play their biggest headline show to date at Crystal Palace Park in London, as well as multiple festival headline slots. Pressure makes diamonds, and FENIAN glistens with Kneecap’s uncut gems.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":72392,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":72393,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":1},{\"id\":72394,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":2},{\"id\":72395,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":3},{\"id\":72396,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":4},{\"id\":72397,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":5},{\"id\":72398,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":6},{\"id\":72399,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":72400,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":72401,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/0eefa5cd-95f7-43bb-9110-404a3ad7bb7c.jpg?rect=1009%2C0%2C4858%2C4858\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/0eefa5cd-95f7-43bb-9110-404a3ad7bb7c.jpg?rect=0%2C366%2C6876%2C4126\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/0eefa5cd-95f7-43bb-9110-404a3ad7bb7c.jpg?rect=2102%2C0%2C2672%2C4858\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Get Your Brits Out\",\"redirect_url\":\"https://open.spotify.com/track/6sPWEWONwBV54qKVLZ1IQm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2863af2c8c55234183da5718182d552493caf8f1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Get Your Brits Out\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769684400,\"max_tickets\":6,\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Rough Trade location is very excited to present an in-store live performance from KNEECAP. This unique event celebrates the release of their new album FENIAN, released via Heavenly.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://shop.roughtrade.com › products › fenian\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Rough Trade.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:94\",\"social_links\":{\"event_share\":\"https://link.dice.fm/x4033aea5f36?dice_id=x4033aea5f36\",\"post_competition_referral\":\"https://link.dice.fm/Tfb71be95ec0?dice_id=Tfb71be95ec0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x9ae16d7d808?dice_id=x9ae16d7d808\",\"post_purchase_referral\":\"https://link.dice.fm/N14fbb23747b?dice_id=N14fbb23747b\",\"post_reminder_referral\":\"https://link.dice.fm/gfd16f03c37b?dice_id=gfd16f03c37b\",\"post_waitinglist_referral\":\"https://link.dice.fm/k6cd1f811783?dice_id=k6cd1f811783\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T11:00:00+00:00\",\"sale_end_date\":\"2026-04-28T18:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-04-30T20:00:00+01:00\",\"event_end_date\":\"2026-04-30T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1668},\"properties\":[],\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"id\":\"6978eb5145d9b30001c77224\",\"seats_io_event_id\":null,\"name\":\"KNEECAP: Live Performance\",\"offers_extras\":true,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"eo3x26-kneecap-live-performance-30th-apr-rough-trade-east-london-london-tickets\",\"date_unix\":1777575600,\"score\":0,\"tty_to_extras\":[{\"ticket_type_id\":1178515,\"extra_ids\":[\"1185032\"]},{\"ticket_type_id\":1178516,\"extra_ids\":[\"1185032\"]},{\"ticket_type_id\":1178517,\"extra_ids\":[\"1185032\"]},{\"ticket_type_id\":1178518,\"extra_ids\":[\"1185032\"]},{\"ticket_type_id\":1181257,\"extra_ids\":[\"1185032\"]},{\"ticket_type_id\":1182079,\"extra_ids\":[\"1185032\"]}],\"event_tag\":null}],\"title\":\"Thu 30 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-01T18:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Headache\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb65f233b0d88ce3616f7a2275\"},\"artist_id\":\"130380\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":70167,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/ec1848aa-2ff1-4d9c-9306-85c38b9290fa.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/ec1848aa-2ff1-4d9c-9306-85c38b9290fa.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/ec1848aa-2ff1-4d9c-9306-85c38b9290fa.jpg?rect=270%2C0%2C660%2C1200\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Headache - Truisms 4 Dummies\",\"redirect_url\":\"https://open.spotify.com/track/40oMDrqiESAbKzfnK6avpB\",\"artist\":\"Headache\",\"preview_url\":\"https://p.scdn.co/mp3-preview/01f188fa1e497c8e9ff4d005d506fd1d860ab33b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Truisms 4 Dummies\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1768993200,\"max_tickets\":6,\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1031,\"name\":\"Communion ONE\",\"privacy_policy_link\":\"https://www.communionmusic.co.uk/terms/communion-one-privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Thank You For Almost Everything is the sophomore album for Headache, a collaboration between writer and poet Francis Hornsby Clark and music-producer Joseph Thornalley aka Vegyn. This new album follows on the surprise underground success of their debut: The Head Hurts But The Heart Knows The Truth (released 31 May 2023) releasing on Vegyn’s own PLZ Make It Ruins label.\\n\\nThank You For Almost Everything continues the original’s distinct style of Trip-Hop / Downtempo Electronica but combining with its own unique (and now imitated) AI-voiced spoken word. For this new album, Headache steps away from the hum-drum of Blighty and instead focuses his gaze to sunnier shores. Recalling personal histories of ruffled hair and school cafeterias, ancient unsolved Albionic riddles, Rome’s changing seasons and its poignant graffiti, arguments with girlfriends at luxury hotel beachfront restaurants, and what it truly feels like to be alive in this inscrutable but beautiful world.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":true,\"is_hidden_event\":false,\"presented_by\":\"Presented by dollop. \",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:95\",\"social_links\":{\"event_share\":\"https://link.dice.fm/aa9c409243f2?dice_id=aa9c409243f2\",\"post_competition_referral\":\"https://link.dice.fm/vd7f80e905a2?dice_id=vd7f80e905a2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ze1fd93cd362?dice_id=Ze1fd93cd362\",\"post_purchase_referral\":\"https://link.dice.fm/sfb17ff3155d?dice_id=sfb17ff3155d\",\"post_reminder_referral\":\"https://link.dice.fm/md5a022b58d2?dice_id=md5a022b58d2\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q406ec762e8f?dice_id=Q406ec762e8f\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T11:00:00+00:00\",\"sale_end_date\":\"2026-05-01T21:00:00+01:00\",\"sale_start_date\":\"2026-01-23T09:00:00+00:00\",\"event_start_date\":\"2026-05-01T18:00:00+01:00\",\"event_end_date\":\"2026-05-01T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3291},\"properties\":[],\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"id\":\"696faa399edb9500015228cb\",\"seats_io_event_id\":null,\"name\":\"Headache\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"7dpep9-headache-1st-may-village-underground-london-tickets\",\"date_unix\":1777654800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 01 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
