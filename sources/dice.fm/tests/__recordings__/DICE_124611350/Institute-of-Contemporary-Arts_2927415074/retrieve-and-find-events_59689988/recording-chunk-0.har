pg?rect=175%2C0%2C1650%2C3000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Yf7ecbc93ec1?dice_id=Yf7ecbc93ec1\",\"post_competition_referral\":\"https://link.dice.fm/T4d311d2bc0d?dice_id=T4d311d2bc0d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Va640187f87b?dice_id=Va640187f87b\",\"post_purchase_referral\":\"https://link.dice.fm/kc45c39999a6?dice_id=kc45c39999a6\",\"post_waitinglist_referral\":\"https://link.dice.fm/Q1c0b056581e?dice_id=Q1c0b056581e\",\"post_reminder_referral\":\"https://link.dice.fm/j61aac30233d?dice_id=j61aac30233d\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"5484\",\"name\":\"Next Door Records\",\"address\":\"304 Uxbridge Rd, London W12 7LJ, UK\",\"location\":{\"lat\":51.5063731,\"lng\":-0.2315609},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"next-door-records-qgaa\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-25T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**The Dream** is a 5 piece folk rock project that fuses the structure and lyricism of traditional folk with modern day indie pop sensibilities.\\n\\n**Lex Vervain**, new-town troubadour, singer, songwriter and guitarist operates out of SE London. His music is in tune with the Elliott Smith/ Alex G alt camp, sharp words and serious tunes, songs that come from a small world caught up in the metropolis.\\n\\nHe put out his debut, self-titled EP in June 2025 recorded with Joseph Futak (Lilo, Tapir, Baggio Band, Luce Rushton...) and gigged through London with Your French Girlfriend, djank, Ewe & Friends, The Sunken Sea, Lando Manning, Mary, Luce Rushton, Tall Child, Kitty.... Lex plays solo live shows, focusing on ear-pricking vocals, crisp acoustic fretwork, reverb and soft electronic beats to deliver. He also plays keys in Ellie Bleach’s band and often backs Luce Rushton at her shows. Lex’s next single ‘New Weight’ will be released in February and his second EP is due to arrive in early Spring 2026.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:75\",\"billing_promoter\":{\"id\":\"7075\",\"name\":\"Next Door Records\",\"image\":{\"url\":null},\"perm_name\":\"next-door-records-lnvx\",\"profile_active\":false},\"presented_by\":\"Presented by Next Door Records.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lex Vervain\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebbecf9a2082d6e60d7f0d876d\"},\"artist_id\":\"125610\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1770076800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T00:00:00+00:00\",\"sale_end_date\":\"2026-03-25T18:45:00+00:00\",\"sale_start_date\":\"2026-02-03T00:00:00+00:00\",\"event_start_date\":\"2026-03-25T19:00:00+00:00\",\"event_end_date\":\"2026-03-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6981e40879917b0001de93e0\",\"name\":\"The Dream + Lex Vervain\",\"price\":{\"currency\":\"GBP\",\"amount\":600,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\"