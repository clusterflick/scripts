6830001c48682\",\"name\":\"Live Music on a Bus\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Fancy seeing some live music on a double decker bus? Music tastemaker Dan Sheed of Turtle Tempo has you covered. Join us in Wood Green for live music from 4 unique artists in CJ Pandit, Cora, Gabriel Chanin & Ivana June.\\n\\nPlease arrive within good time. Hop on board from 7pm!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-25T12:30:00+00:00\",\"sale_end_date\":\"2026-03-12T22:00:00+00:00\",\"sale_start_date\":\"2026-01-25T12:30:00+00:00\",\"event_start_date\":\"2026-03-12T19:30:00+00:00\",\"event_end_date\":\"2026-03-12T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Notting Hill Arts Club.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"80\",\"name\":\"Notting Hill Arts Club\",\"address\":\"21 Notting Hill Gate, London W11 3JQ\",\"location\":{\"lat\":51.509239,\"lng\":-0.194435099999964},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"notting-hill-arts-club-4n2q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-12T19:30:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1523\",\"name\":\"Notting Hill Arts Club\",\"image\":{\"url\":null},\"perm_name\":\"notting-hill-arts-club-okgr\",\"profile_active\":false},\"announcement_date_unix\":1768482000,\"social_links\":{\"event_share\":\"https://link.dice.fm/p58b1e57814e?dice_id=p58b1e57814e\",\"post_competition_referral\":\"https://link.dice.fm/z8620273a217?dice_id=z8620273a217\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/t294c936865e?dice_id=t294c936865e\",\"post_purchase_referral\":\"https://link.dice.fm/T2b455821933?dice_id=T2b455821933\",\"post_reminder_referral\":\"https://link.dice.fm/K099f424e501?dice_id=K099f424e501\",\"post_waitinglist_referral\":\"https://link.dice.fm/s4bd4fdf918a?dice_id=s4bd4fdf918a\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"mxlp7k-hyperreal-album-launch-party-support-12th-mar-notting-hill-arts-club-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773343800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:75\",\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/eb376150-9a9a-453c-935c-e9540abd2e43.jpg?rect=0%2C900%2C5400%2C5400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/eb376150-9a9a-453c-935c-e9540abd2e43.jpg?rect=0%2C1980%2C5400%2C3240\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/eb376150-9a9a-453c-935c-e9540abd2e43.jpg?rect=720%2C0%2C3960%2C7200\"},\"id\":\"696e52e223ec800001e89bde\",\"name\":\"Hyperreal Album Launch Party + Support\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"“…Imagine an Electrifying Fusion of Futuristic SynthPop, Shoegaze guitars, DreamPop & Cosmic Lush Synths from the year 9000, in Los Angeles, in dazzling colourful outfits…..Think “Sprinkles and Rainbows” meets Alice in Wonderland meets Sgt. Pepper….& elevated by a Black Gospel Soul Choir…”\\n\\nThe raw, electrifying energy of soul-stirring Black Gospel harmonies, fused with lush synths, shoegaze guitars, and DreamPop soundscapes, creates a euphoric live experience like no other…add in an AfroFuturistic rhythm section with a female drummer and you really do have something completely different.\\n\\nHyperreal are on the road with their debut album, “you. me. us”..A rallying cry for those who are different, misfits, and outsiders who struggle to fit in to be their true selves and take pride in being away from the norm. With music described as joyful sadness, this is introspective, soul searching, heart on sleeve lyrics boosted by the no holds barred Euphoria that only a Black Gospel Choir can bring!!\\n\\nSupport from Saint Lore and Silent Star!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T13:00:00+00:00\",\"sale_end_date\":\"2026-03-12T21:00:00+00:00\",\"sale_start_date\":\"2026-01-19T15:30:00+00:00\",\"event_start_date\":\"2026-03-12T19:30:00+00:00\",\"event_end_date\":\"2026-03-12T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lois\",\"image\":null,\"artist_id\":\"1825\",\"about\":null,\"is_headliner\":false},{\"name\":\"Edie Bens\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb44fd639ae29fe8eaa5306ab8\"},\"artist_id\":\"14610\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_fre