d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-18T15:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=256%2C0%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=0%2C154%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-07-07/e8e9152a-48c6-4102-9fce-f32d1d7046ed.jpg?rect=602%2C0%2C845%2C1536\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/zeb6d8caf22a?dice_id=zeb6d8caf22a\",\"post_competition_referral\":\"https://link.dice.fm/g4124f3656e0?dice_id=g4124f3656e0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/tda2e1c5ec46?dice_id=tda2e1c5ec46\",\"post_purchase_referral\":\"https://link.dice.fm/b83a15e3b0ff?dice_id=b83a15e3b0ff\",\"post_reminder_referral\":\"https://link.dice.fm/Tfa72ae4b26f?dice_id=Tfa72ae4b26f\",\"post_waitinglist_referral\":\"https://link.dice.fm/ac7b02e301d7?dice_id=ac7b02e301d7\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"d6e15a092fa69dd9:51\",\"properties\":[],\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764201600,\"id\":\"6928debe7a75730001172409\",\"name\":\"Hot Box Blues Jam\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"On the 3rd Sunday of every month Jamie Williams & Laura Tuckey host the HOT BOX blues jam, featuring The Roots Collective as house band.\\n\\nThe full backline is already on stage so just rock up with your instrument, plug in and have a great time playing alongside some of the best in the business.\\n\\nThere's a place for all levels of musician, and if you don't know a plectrum from a g-String, just grab a drink and enjoy the show!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"date_unix\":1792333800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3642},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T10:00:00+00:00\",\"sale_end_date\":\"2026-10-18T21:00:00+01:00\",\"sale_start_date\":\"2025-11-13T10:00:00+00:00\",\"event_start_date\":\"2026-10-18T19:00:00+01:00\",\"event_end_date\":\"2026-10-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"92xkgn-walter-trout-18th-oct-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"We're All In This Together (feat. Joe Bonamassa)\",\"redirect_url\":\"https://open.spotify.com/track/39LlmbBbxFCHfEeAstj2o8\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/c2f3ba60e3d189b757c93cd14cbc123599e9baef?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"We're All In This Together (feat. Joe Bonamassa)\"},{\"type\":\"apple_music\",\"title\":\"Walter Trout - Saw My Mama Cryin'\",\"redirect_url\":\"https://music.apple.com/gb/album/saw-my-mama-cryin/518069912?i=518069923&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Walter Trout\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music/2c/65/15/mzm.bxseadth.aac.p.m4a\",\"track_name\":\"Saw My Mama Cryin'\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Walter Trout\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc2820c9a31d2dc97490fdb16\"},\"artist_id\":\"15873\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-18T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-06/1ea1596d-7d4a-480d-8c93-66caa7736f5c.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-06/1ea1596d-7d4a-480d-8c93-66caa7736f5c.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-06/1ea1596d-7d4a-480d-8c93-66caa7736f5c.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/gcc3ef90065d?dice_id=gcc3ef90065d\",\"post_competition_referral\":\"https://link.dice.fm/g00bf84182c2?dice_id=g00bf84182c2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H18d8c1b05fb?dice_id=H18d8c1b05fb\",\"post_purchase_referral\":\"https://link.dice.fm/p30b4e5f769f?dice_id=p30b4e5f769f\",\"post_reminder_referral\":\"https://link.dice.fm/Y8b3ddc9e097?dice_id=Y8b3ddc9e097\",\"post_waitinglist_referral\":\"https://link.dice.fm/e3d46f6d2e22?dice_id=e3d46f6d2e22\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:52\",\"properties\":[],\"presented_by\":\"Presented by The Gig Cartel.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1763028000,\"id\":\"690db3c4bed7110001d8d91c\",\"name\":\"Walter Trout\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Few artists play with the fire, soul, and honesty of Walter Trout. For over five decades, this blues-rock titan has poured his heart into every note, channelling life’s highs and lows through that unmistakable guitar tone and a voice etched with experience.\\n\\nIn 2026, Walter returns to the stage—and this is not just another gig. It’s a celebration of survival, a howl of defiance, and a communion of souls brought together by the unbreakable spirit of the blues.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1792346400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6206},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-03-28T14:00:00+00:00\",\"sale_end_date\":\"2026-10-18T15:00:00+01:00\",\"sale_start_date\":\"2025-04-02T14:00:00+01:00\",\"event_start_date\":\"2026-10-18T19:00:00+01:00\",\"event_end_date\":\"2026-10-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ryxo7y-ezhel-18th-oct-o2-forum-kentish-town-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Geceler\",\"redirect_url\":\"https://open.spotify.com/track/0R0o8uOkDz40XsR6uwThfQ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3d6646bf4a88b1b00a063149b6358e0b062107ff?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Geceler\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":15597,\"title\":\"Can I take a bag?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags including rucksacks are not allowed. There are no facilities to leave large bags or luggage. If you really have to bring a bag – and it’s preferable you don’t, please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ezhel\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-22/9a85b559-ea0c-42b8-bc05-862df6928360.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"7637\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"934\",\"name\":\"O2 Forum Kentish Town\",\"address\":\"9-17 Highgate Rd, London NW5 1JY\",\"location\":{\"lat\":51.5521427,\"lng\":-0.142224499999998},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"o2-forum-kentish-town-8er7\",\"accessibility\":{\"url\":\"https://academymusicgroup.com/o2forumkentishtown/access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-18T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-03-26/6a44d5d5-f46b-4780-a191-508d42d99bd9.jpg?rect=0%2C1034%2C4136%2C4136\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-03-26/6a44d5d5-f46b-4780-a191-508d42d99bd9.jpg?rect=0%2C1861%2C4136%2C2482\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-03-26/6a44d5d5-f46b-4780-a191-508d42d99bd9.jpg?rect=362%2C0%2C3412%2C6204\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/tfceab99ad0f?dice_id=tfceab99ad0f\",\"post_competition_referral\":\"https://link.dice.fm/Xfff8b0a5041