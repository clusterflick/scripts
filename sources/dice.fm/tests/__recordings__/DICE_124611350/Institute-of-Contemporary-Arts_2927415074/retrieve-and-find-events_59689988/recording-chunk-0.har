6969000,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"373\",\"name\":\"Paper Dress Vintage\",\"address\":\"352a Mare Street, London, E8 1HR, United Kingdom\",\"location\":{\"lat\":51.54733,\"lng\":-0.05467},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-29/13fc3fd2-f3f2-4ebb-b479-d3d2d7cf5214.jpg?rect=683%2C0%2C2731%2C2731\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"paper-dress-vintage-ja37\",\"accessibility\":{\"url\":\"https://paperdressvintage.co.uk/faqs\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-23T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":220,\"name\":\"Paper Dress Vintage\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1196387937118330\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:35\",\"about\":{\"description\":\"Irish singer-songwriter Oscar Blue returns to London for a headline show at Paper Dress Vintage on the eve of the release of his debut album Birds in Winter.\\n\\nThis show follows sold-out headline dates in London, Leeds and Limerick last year.\\n\\n\\\\---\\n\\nIrish artist Oscar Blue is a rising Irish singer-songwriter known for live performances that blend heartfelt intimacy with soaring energy. His shows move effortlessly between pin-drop stillness and full-band euphoria, leaving audiences both uplifted and undone.\\n\\nBased between London and rural Ireland, Oscar has built a strong live following across the UK and Europe, touring with and supporting artists such as Darren Kiely, Kingfishr, Seafret, Son’s of the East and more.\\n\\nHis debut album “Birds in Winter” is to be released in April 2026 and marks the most exciting year of the artists' career yet, as Oscar continues to prove himself as one of the most authentic and captivating voices emerging on the live scene.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769508000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Oscar Blue\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/61ff225d-28b3-48b8-82b0-470e65064e28.jpg?rect=0%2C54%2C532%2C532\"},\"artist_id\":\"74877\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-06/5a9c2045-dca1-4ea7-8765-a586cb9d184f.jpg?rect=0%2C320%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-06/5a9c2045-dca1-4ea7-8765-a586cb9d184f.jpg?rect=0%2C576%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-06/5a9c2045-dca1-4ea7-8765-a586cb9d184f.jpg?rect=112%2C0%2C1056%2C1920\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"695d1023405c510001e3eea8\",\"name\":\" Oscar Blue\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T10:00:00+00:00\",\"sale_end_date\":\"2026-04-23T18:45:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"20