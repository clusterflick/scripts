ew\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Modern Woman - Dashboard Mary\",\"redirect_url\":\"https://open.spotify.com/track/7pozVrkNzYLcymGuGDtbIQ\",\"artist\":\"Modern Woman\",\"preview_url\":\"https://p.scdn.co/mp3-preview/50627ba1dba1c74063bc35a86b5d9c03ae8f4403?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Dashboard Mary\"},{\"type\":\"apple_music\",\"title\":\"Modern Woman - Dashboard Mary\",\"redirect_url\":\"https://music.apple.com/us/album/dashboard-mary/1861571647?i=1861572202&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Modern Woman\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/fd/49/57/fd495727-8365-0936-8b18-891ddf354513/mzaf_13668458612349394031.plus.aac.p.m4a\",\"track_name\":\"Dashboard Mary\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Modern Woman\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebedabd79f13a0329a1d6e6035\"},\"artist_id\":\"18822\",\"about\":{\"description\":\"We’ve been highly anticipating Modern Woman’s debut album for a while now and it’s finally on the horizon. ‘Johnny’s Dreamworld’ is out on May 1st 2026 via their new label One Little Independent Records and we’re throwing a party at The Lexington to celebrate on 6th May. The LP represents the culmination of songwriter Sophie Harris’s early, intimate project into a full-bodied band capable of folding post-punk, avant-garde, and folk traditions into a live force of dynamic originality. At its heart, the record explores the strange poetry buried within the ordinary. Harris’s lyrics, steeped in literary detail and filmic atmosphere, draw from a fascination with the dark underbelly of the everyday and the contradictions of womanhood.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"ti