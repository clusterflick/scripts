:null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-12-10/5fc22b6d-5312-4a84-a4f0-498f67af4aa3.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Resonance are a collective based in Essex for the creation and appreciation of electronic music, visual arts and performance. This is an open call to all the electronic music producers of Essex…. It doesn’t matter how much you may have spent on a set of studio headphones or monitors, nothing quite compares to hearing your music in a club on a load soundsystem. So come down with a USB stick with your latest masterpiece on it and we’ll play it back to you at the levels that music deserves to be heard at.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 To be accompanied by an Adult\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"693c9b303c077e000122ce96\",\"name\":\"Resonance Open System\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Resonance open system\",\"image\":null,\"artist_id\":\"28224\",\"about\":{\"description\":\"Formed in 2019, Resonance are a creative collective spotlighting the freshest talent in electronic music, performance and visual art in Essex. A community project, the collective has branched into radio, livestreams and even a record label, and regularly platforms burgeoning DJs and producers as part of its Open System series.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/Lo