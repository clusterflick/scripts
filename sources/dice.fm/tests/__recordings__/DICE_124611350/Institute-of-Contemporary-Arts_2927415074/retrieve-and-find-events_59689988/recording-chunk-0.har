ll},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2183,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":4,\"social_links\":{\"event_share\":\"https://link.dice.fm/U23ed0a2744e?dice_id=U23ed0a2744e\",\"post_competition_referral\":\"https://link.dice.fm/k0d47611faae?dice_id=k0d47611faae\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O4d3ef6f8661?dice_id=O4d3ef6f8661\",\"post_purchase_referral\":\"https://link.dice.fm/Q03abecc443a?dice_id=Q03abecc443a\",\"post_reminder_referral\":\"https://link.dice.fm/S873a879af74?dice_id=S873a879af74\",\"post_waitinglist_referral\":\"https://link.dice.fm/u6f8b6061d66?dice_id=u6f8b6061d66\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"The Sky Is on Fire\",\"redirect_url\":\"https://open.spotify.com/track/4etFJkYcvov4yAPtzQnAXp\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e95daff517640ae968e03e950f435996f79a2188?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Sky Is on Fire\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Kings Place.\",\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"date_unix\":1777127400,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"5073\",\"name\":\"Kings Place (Hall Two)\",\"address\":\"Kings Place, 90 York Way, London N1 9GU, UK\",\"location\":{\"lat\":51.53485440000001,\"lng\":-0.1219841},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"kings-place-hall-two-a95d\",\"accessibility\":{\"url\":\"https://www.kingsplace.co.uk/your-visit/access-information/\"},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-25T15:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1141,\"name\":\"Kings Place \",\"privacy_policy_link\":\"https://www.kingsplace.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:81\",\"about\":{\"description\":\"***At Kings Place Folk Weekend, Ellie Gowers presents an evening of reflective, beautifully detailed songs — carried by her expressive voice, lyrical craft and quietly magnetic stage presence. A chance to experience one of the UK folk scene’s most resonant emerging artists up close.***  \\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\nRising UK folk artist **Ellie Gowers** is inspired by the likes of Jeff Buckley and MIPSO, her new material sees her pushing into more emotionally spacious and contemporary territory — while retaining the grounded storytelling that first brought her acclaim. These songs explore the aftermath of life on the road: themes of absence, longing, and emotional duality woven through rich acoustic textures and lyrical craft.\\n\\nEllie is one of the most distinctive rising voices in UK folk, praised by *The Guardian* for her ‘delicacy, precision and gentle delight.’ Her music blends contemporary acoustic textures with the narrative depth of traditional folk, drawing on themes of distance, longing and the emotional aftershocks of life on the road.\\n\\nHer latest EP *You, The Passenger* has received national attention, with airplay on BBC Radio 2, BBC 6 Music and the RADMAC show. Influenced by artists such as MIPSO and Jeff Buckley, these new songs reveal a more spacious and exploratory side to her writing, while retaining the grounded intimacy that first brought her acclaim.\\n\\n***This event will last for approximately 75 minutes, with no interval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1763600400,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-20/9a74c5a0-e9c8-42d5-8bcb-09557070c313.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-20/9a74c5a0-e9c8-42d5-8bcb-09557070c313.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-20/9a74c5a0-e9c8-42d5-8bcb-09557070c313.jpg?rect=243%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69202af0aaa72100010b0b73\",\"name\":\"Folk Weekend: Ellie Gowers\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-20T01:00:00+00:00\",\"sale_end_date\":\"2026-04-25T14:00:00+01:00\",\"sale_start_date\":\"2025-11-20T01:00:00+00:00\",\"event_start_date\":\"2026-04-25T15:30:00+01:00\",\"event_end_date\":\"2026-04-25T17:15:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"xekooe-folk-weekend-ellie-gowers-25th-apr-kings-place-hall-two-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amo