\":[{\"name\":\"Goose\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-26/74b5eae5-4501-48af-9794-ed3387758c63.jpg?rect=0%2C0%2C1080%2C1080\"},\"artist_id\":\"52970\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765274400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3662,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Synrise\",\"redirect_url\":\"https://open.spotify.com/track/4SD5ttMTZP2HF3EP9bWe4W\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b41be16eaad263fe7d8a43ecd61a897de5c1c988?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Synrise\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-24T11:00:00+01:00\",\"sale_end_date\":\"2026-05-22T17:00:00+01:00\",\"sale_start_date\":\"2025-10-27T10:00:00+00:00\",\"event_start_date\":\"2026-05-22T19:00:00+01:00\",\"event_end_date\":\"2026-05-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Pad Presents.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Za218ebff1a5?dice_id=Za218ebff1a5\",\"post_competition_referral\":\"https://link.dice.fm/g34bf6666c4b?dice_id=g34bf6666c4b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/L5ffc13a60c1?dice_id=L5ffc13a60c1\",\"post_purchase_referral\":\"https://link.dice.fm/sc6edc1419d8?dice_id=sc6edc1419d8\",\"post_reminder_referral\":\"https://link.dice.fm/Rc78900edb7a?dice_id=Rc78900edb7a\",\"post_waitinglist_referral\":\"https://link.dice.fm/C67c1930c808?dice_id=C67c1930c808\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"The Hillbilly Moon Explosion + Guests\\n\\n7pm, Friday 22nd May, 229, London\\n\\nThe Hillbilly Moon Explosion are heading back to the UK for a short run of dates calling into 229, London on Friday 22nd May following a sold-out show in the City in 2025.\\n\\nFormed in 1998 in Zurich, Switzerland, The Hillbilly Moon Explosion exists in a middle ground between the traditionalism of many rockabilly revival bands and the rougher, spookier sound of psychobilly.\\n\\nFounded by vocalist and rhythm guitarist Emanuela Hutter and bassist/vocalist Oliver Baroni, their music has more than its share of retro twang, with Hutter's polished, enigmatic singing blending with the sometimes raucous, sometimes moody guitar lines, and they add dashes of rockabilly, surf, blues, punk, lounge pop, country and even ska to season their evocative mix.\\n\\nThe band staked out their trademark sound on 2002's Introducing the Hillbilly Moon Explosion, they fully hit their creative stride on 2011's Buy Beg or Steal, and they collaborated with psychobilly veteran Mark \\\"Sparky\\\" Phillips for 2019's The Sparky Sessions.\\n\\nSpecial guest support TBC.\\n\\nTickets online from Seetickets\\n\\n14+ only. 14s to 15s must be accompanied by an adult. No refunds will be given for incorrectly booked tickets.\",\"highlights\":[]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":294,\"name\":\"229 The Venue\",\"privacy_policy_link\":\"https://229.london/dataprotection/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779472800,\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"add