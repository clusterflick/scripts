_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1587\",\"name\":\"Prince of Peckham\",\"address\":\"1 Clayton Rd, Peckham, London SE15 5JA, UK\",\"location\":{\"lat\":51.47358029999999,\"lng\":-0.06533349999995153},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"prince-of-peckham-m2dv\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T21:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:73\",\"about\":{\"description\":\"MIXTAPE – Every Friday Night at Prince of Peckham!\\n\\nYour Friday nights just got patterned! We’re running the hottest tracks from across the charts and the streets, from the throwbacks you love to the tunes taking over right now. We’re talking the finest selectors spinning non-stop fire from across the globe.\\n\\nPull up and catch our DJs doing what they do best, setting the vibe from start to finish. If it’s a banger, it’s on their playlist.\\n\\nVisit our website to secure a table at https://princeofpeckham.co.uk .\\n\\nEntry Policy:\\n\\nTickets do not guarantee entry. They provide priority access and queue jump, but entry remains subject to venue capacity and conditions.\\n\\nDress Code: No sportswear, tracksuits, or track shorts. Guests not adhering to the dress code will be refused entry, regardless of ticket purchase. No refunds will be issued.\\n\\nAge Policy: 21+ only. A valid photo ID is required for entry.\\n\\nTicket holders are guaranteed 