tion_referral\":\"https://link.dice.fm/l2b46faf6c04?dice_id=l2b46faf6c04\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Y96e4b0c466f?dice_id=Y96e4b0c466f\",\"post_purchase_referral\":\"https://link.dice.fm/c044cb6355f3?dice_id=c044cb6355f3\",\"post_reminder_referral\":\"https://link.dice.fm/W170d5cef085?dice_id=W170d5cef085\",\"post_waitinglist_referral\":\"https://link.dice.fm/u28c7f3d7354?dice_id=u28c7f3d7354\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"8e8b92-nayar-collective-guests-13th-mar-muse-at-rsa-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1773424800,\"has_multiple_ticket_types\":false,\"impression_id\":\"49dcf1c1636e57c2:92\",\"price\":{\"currency\":\"GBP\",\"amount\":1350,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/2de766a6-6d44-486c-8bad-7594a22069d2.jpg?rect=234%2C0%2C1107%2C1107\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/2de766a6-6d44-486c-8bad-7594a22069d2.jpg?rect=0%2C81%2C1575%2C945\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/2de766a6-6d44-486c-8bad-7594a22069d2.jpg?rect=483%2C0%2C609%2C1107\"},\"id\":\"69650218c2abd3000127c224\",\"name\":\"Nayar Collective + Guests\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Join us for our monthly unplugged concert at MUSE at RSA House set behind The Strand. A totally non amplified concert, its takes place in the historic Tavern Room adjacent to their hidden gem of a modern British cocktail bar Muse.\\n\\nFor our March concert we are delighted to welcome NAYAR COLLECTIVE.\\n\\n**NAYAR COLLECTIVE** embrace the world with compassion, seeing its flaws and finding light and hope within them. Deep, emotive vocals hover over delicate arrangements, creating a soul-stirring chamber-folk that offers warmth, solace and inspiration. Initiated by Vedantha Kumar (vocals), with Inês Delgado (violin), Karl D'Souza (piano) and Jamil de Dominicis (guitar)\\n\\n*With special guest to be announced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-13T18:30:00+00:00\",\"sale_start_date\":\"2026-01-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-13T18:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Fri 13 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
