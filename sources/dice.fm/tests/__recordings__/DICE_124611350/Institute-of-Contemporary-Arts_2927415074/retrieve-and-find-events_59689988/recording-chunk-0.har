":\"https://link.dice.fm/wcc2e0650ca3?dice_id=wcc2e0650ca3\",\"post_competition_referral\":\"https://link.dice.fm/t009d52760a0?dice_id=t009d52760a0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u637a448fab8?dice_id=u637a448fab8\",\"post_purchase_referral\":\"https://link.dice.fm/Pc93ac4119bb?dice_id=Pc93ac4119bb\",\"post_reminder_referral\":\"https://link.dice.fm/bd7b16d1ec7b?dice_id=bd7b16d1ec7b\",\"post_waitinglist_referral\":\"https://link.dice.fm/Vbcf84a8ed48?dice_id=Vbcf84a8ed48\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Electric Star Pubs.\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"136032\",\"name\":\"Electric Star Pubs\",\"image\":{\"url\":null},\"perm_name\":\"electric-star-pubs-nb53l\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"eop85w-rockaoke-26th-jun-the-star-of-kings-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782500400,\"public_refund_policy\":null,\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:94\",\"venues\":[{\"id\":\"13434\",\"name\":\"The Star of Kings\",\"address\":\"126 York Way, Islington, London, N1 0AX, United Kingdom\",\"location\":{\"lat\":51.53636,\"lng\":-0.12205},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-star-of-kings-8dy5\",\"accessibility\":{\"url\":\"https://starofkings.co.uk/wp-content/uploads/2024/09/SOK-Venue-Brochure-2024-compressed.pdf\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-26T20:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Rockaoke\",\"image\":null,\"artist_id\":\"126109\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Join us for singalong fun twice a month, every second and last Friday!\\n\\nBringing you the ultimate live band Karaoke experience that will set the tone for an unforgettable year. Be part of the action as you step into the spotlight and belt out your favourite tunes in front of a lively crowd. Channel your inner Debbie Harry, Ed Sheeran, or Justin Bieber and make this year's Rockaoke a night to remember!\\n\\nA unique Karaoke singing experience.\\n\\nA perfect experience for anyone!\\n\\n“Most fun ever? We reckon so!” – Time Out London\\n\\n“Karaoke’s much cooler older brother, ROCKAOKE” – Sunday Times\\n\\n“The best rockaoke band on the planet\\\" – Virgin Radio\\n\\n“So wrong, it’s right!” – Ibiza Rocks\\n\\n\\\"The band make you feel like a proper ROCKSTAR, they don’t make you sound like one, but they make you feel like one - \\\"Chris Moyles, Radio DJ\\n\\n“Paulo Nutini, The Fratellis and McFly were among the acts who performed exclusive live sessions for the intimate audience in the Virgin Radio VIP Sessions, setting the stage for ROCKAOKE” – OK Magazine\\n\\n“Thank you SO much. We all had a great great time and I think the warmth, enthusiasm and kindness of the band added so much.” – Kate Harwood (BBC Head of Drama & Serials)\\n\\n“I recently attended a Rockaoke night in Cardiff and was absolutely blown away by your performance and the whole atmosphere of the event. I have never witnessed anything quite like it and the talent the band demonstrated with their wide repertoire was incredible.” – Beth (Cancer Research Wales)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-08-20T15:30:00+01:00\",\"sale_end_date\":\"2026-06-26T23:30:00+01:00\",\"sale_start_date\":\"2025-08-20T15:30:00+01:00\",\"event_start_date\":\"2026-06-26T20:00:00+01:00\",\"event_end_date\":\"2026-06-27T00:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"68a6cde46e16cb0001a81c73\",\"name\":\"Rockaoke\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-08-20/b2efd44e-7529-4002-a060-a3613c1ab72a.jpg?rect=506%2C0%2C1238%2C2250\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1755700200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/dcedb582ec51?dice_id=dcedb582ec51\",\"post_competition_referral\":\"https://link.dice.fm/afac3084da69?dice_id=afac3084da69\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m12e05415f29?dice_id=m12e05415f29\",\"post_purchase_referral\":\"https://link.dice.fm/Ff9c6d3d21a7?dice_id=Ff9c6d3d21a7\",\"post_reminder_referral\":\"https://link.dice.fm/qc88abaa594f?dice_id=qc88abaa594f\",\"post_waitinglist_referral\":\"https://link.dice.fm/f5a49b785be1?dice_id=f5a49b785be1\"},\"unicorn_extras\":false,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 26 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6345},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Live Nation & Festival Republic. \",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[{\"id\":74039,\"title\":\"Age Restricition\",\"body\":\"Children 12 and under are free with an adult ticket holder aged 18 or over. Anyone under age 16 must be accompanied by a ticket holder over 18 years old. Please note that there is no separate children's area at this event. Children 12 and under free of charge with ticket holding adult.\",\"order\":0},{\"id\":74050,\"title\":\"Re-admission\",\"body\":\"Strictly No Readmission\",\"order\":1},{\"id\":74051,\"title\":\"Bag Policy\",\"body\":\"These events are big-bag free. Only bags smaller than a sheet of A4 paper will be permitted. People without bags will get in quicker.\\n\\nThis event is strictly no readmission.\",\"order\":2},{\"id\":74052,\"title\":\"Accessibility information\",\"body\":\"Please buy your event ticket first. You will then need to apply for any accessible facilities you require. Only buy a ticket for the customer who requires accessible facilities and any friends or family attending.\\n\\nYou do not need to buy a ticket for your approved Essential Companion. Essential Companion ticket requests will be processed as part of the accessible facilities application process.\\n\\nFor full details of the accessible facilities provided at the event, and the application process, visit the accessibility section of the website: https://www.festivalrepublic.com/accessibility/crystal-palace-park\",\"order\":3},{\"id\":74040,\"title\":\"Ticket Terms and Conditions\",\"body\":\"Tickets are only valid when purchased directly from official agents of Festival Republic. We do not accept Print at Home tickets, Booking Confirmations, screenshots or photos of tickets. Tickets for this event have a unique barcode which will be scanned on entry and if found to be duplicated, either in error or for fraudulent gain, only the first instance of the ticket scanned will be admitted regardless of original ownership. Customers may be prosecuted if found to have deliberately duplicated and resold tickets for fraudulent gain.\\n\\nFull terms and conditions: https://www.festivalrepublic.com/events/crystal-palace-park/terms-and-conditions\",\"order\":4},{\"id\":74053,\"title\":\"Ticket limits\",\"body\":\"Please note: There is a ticket limit of 6 tickets per person, per address and per credit card on this event. Please adhere to published ticket limits. Persons who exceed the ticket limit may have any or all of their order(s) and tickets cancelled without prior notice by the Ticket Agent in its discretion. This includes orders associated with the same name, e-mail address, billing address, credit card number or other information.\",\"order\":5}],\"billing_promoter\":{\"id\":\"13907\",\"name\":\"Festival Republic\",\"image\":{\"url\":null},\"perm_name\":\"festival-republic-7d367\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"k696yo-kneecap-27th-jun-crystal-palace-park-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782558000,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:95\",\"venues\":[{\"id\":\"12315\",\"name\":\"Crystal Palace Park\",\"address\":\"Crystal Palace Park, Crystal Palace Parade, London, England SE19 2BA, United Kingdom\",\"location\":{\"lat\":51.421673,\"lng\":-0.075321},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"crystal-palace-park-mnav\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-27T12:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Madra Salach\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-05/1c62a5ca-bbd2-46d1-9e28-b9d6a9a20737.jpg?rect=0%2C85%2C854%2C854\"},\"artist_id\":\"127227\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gurriers\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-03/6953a446-9a8f-45bf-a2c7-9eafca6f6745.jpg?rect=625%2C0%2C2500%2C2500\"},\"artist_id\":\"44168\",\"about\":null,\"is_headliner\":false},{\"name\":\"Biig Piig\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-03/a58e821a-ce7e-40f1-8391-8622208ad405.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"7246\",\"about\":null,\"is_headliner\":false},{\"name\":\"Fat Dog\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-28/f541ca52-bc56-47b0-94d9-9a3e3dac62d5.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"23063\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Mary Wallopers\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-11/b1cca8be-3584-4c2e-9298-84b602efe9a8.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"32400\",\"about\":null,\"is_headliner\":false}],\"total_artists\":6,\"total_free_texts\":0},\"about\":{\"description\":\"West Belfast and Derry trio Kneecap have today announced their biggest headline show to date, taking place at London’s Crystal Palace Park on Saturday 27 June 2026.\\n\\nThey’ll be joined on the day by special guests The Mary Wallopers, Fat Dog, Biig Piig, Gurriers and Madra Salach for what is set to be one of the largest gatherings in the 2026 London Irish calendar.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event - under 16s accompanied by an adult 18+. \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T14:06:00+00:00\",\"sale_end_date\":\"2026-06-25T10:00:00+01:00\",\"sale_start_date\":\"2026-02-04T14:08:00+00:00\",\"event_start_date\":\"2026-06-27T12:00:00+01:00\",\"event_end_date\":\"2026-06-27T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6982409a6b8e7500016b1c2b\",\"name\":\"Kneecap\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/dd4579c2-91bf-4984-8444-507079ab26eb.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/dd4579c2-91bf-4984-8444-507079ab26eb.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/dd4579c2-91bf-4984-8444-507079ab26eb.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[{\"id\":1196,\"name\":\"Festival Republic\",\"privacy_policy_link\":\"https://www.festivalrepublic.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1707,\"name\":\"Live Nation UK\",\"privacy_policy_link\":\"https://www.livenation.co.uk/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1770213960,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/va676c62d275?dice_id=va676c62d275\",\"post_competition_referral\":\"https://link.dice.fm/U92a4e568d6e?dice_id=U92a4e568d6e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E0a0784cac6c?dice_id=E0a0784cac6c\",\"post_purchase_referral\":\"https://link.dice.fm/k2ec5edec908?dice_id=k2ec5edec908\",\"post_reminder_referral\":\"https://link.dice.fm/y025391f13a5?dice_id=y025391f13a5\",\"post_waitinglist_referral\":\"https://link.dice.fm/W7f852153ae0?dice_id=W7f852153ae0\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"spotify\",\"title\":\"Get Your Brits Out\",\"redirect_url\":\"https://open.spotify.com/track/6sPWEWONwBV54qKVLZ1IQm\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/2863af2c8c55234183da5718182d552493caf8f1?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Get Your Brits Out\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Black Frog\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"ryald5-gerry-jablonski-27th-jun-hot-box-chelmsford-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1782565200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"8fa9a59af65bb1b7:96\",\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-27T14:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Gerry Jablonski & the Electric Band\",\"image\":null,\"artist_id\":\"23337\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"Aberdeen’s internationally acclaimed blues-rock outfit, The Gerry Jablonski Band, is charging into 2025 with a new weapon in their arsenal—frontman and powerhouse vocalist, Nicky Aiken. A familiar face on the Aberdeen music scene and a former Royal Marine Commando, Aiken trades in military tours for international music tours as he joins the band full-time.\\n\\nThe announcement follows a standout guest performance with the band at their Aberdeen show last September, where sparks flew and the chemistry was undeniable. Frontman Gerry Jablonski recalls, “We knew it would take a special kind of lunatic to come aboard this ship of fools. But after that gig, it was clear—we had to take the collaboration further. The music just clicked.”\\n\\nAiken, who has shared stages with the likes of Marti Pellow and fronted his own band Nicky Aiken and the Temple Sons, was, in his own words, “in between things” when he got the call. A chance supermarket encounter with Jablonski Band harmonica player Pete led to the now-fateful invite. “I think he felt sorry for me,” laughs Aiken. “Next thing I knew, I was mid-set at their show with about 10 minutes’ rehearsal.”\\n\\nTheir signature blend of heavy riffs, searing harp, and blues-infused rock continues to evolve—with the addition of rich vocal harmonies and a rejuvenated sound thanks to Aiken’s dynamic voice.\\n\\n***Sponsored by Last Piastre Records.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T00:00:00+00:00\",\"sale_end_date\":\"2026-06-27T14:00:00+01:00\",\"sale_start_date\":\"2025-12-01T00:00:00+00:00\",\"event_start_date\":\"2026-06-27T14:00:00+01:00\",\"event_end_date\":\"2026-06-27T17:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"692e0e9e8bd4dc0001ae105b\",\"name\":\"Gerry Jablonski\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-01/7bfe2f1c-939a-40f2-944a-b665eeed91eb.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-01/7bfe2f1c-939a-40f2-944a-b665eeed91eb.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-01/7bfe2f1c-939a-40f2-944a-b665eeed91eb.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764547200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/V753a53a5d84?dice_id=V753a53a5d84\",\"post_competition_referral\":\"https://link.dice.fm/Mebbb47ba22b?dice_id=Mebbb47ba22b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v5293fe62310?dice_id=v5293fe62310\",\"post_purchase_referral\":\"https://link.dice.fm/te635d1d6e79?dice_id=te635d1d6e79\",\"post_reminder_referral\":\"https://link.dice.fm/od1229cf08f5?dice_id=od1229cf08f5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z0a03912c175?dice_id=Z0a03912c175\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Gerry Jablonski & The Electric Band - Blues Power\",\"redirect_url\":\"https://music.apple.com/us/album/blues-power/325345659?i=325345668&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Gerry Jablonski & The Electric Band\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/Music2/v4/ea/65/32/ea6532e0-0521-ccd4-f0ef-24a85d484e54/mzaf_371606272940796578.plus.aac.p.m4a\",\"track_name\":\"Blues Power\"},{\"type\":\"spotify\",\"title\":\"Gerry Jablonski And The Electric Band - Too Hot\",\"redirect_url\":\"https://open.spotify.com/track/7AT8cS3ws1RRP1lS0QyN8Z\",\"artist\":\"Gerry Jablonski And The Electric Band\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7214d2e87f64bb95a111b95221b42e2784ce5fd2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Too Hot\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Sat 27 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null}],\"next_page_cursor\":\"\"}",
