3/fd9b834a-a64d-4fcb-5e47-1dcb514f51eb/mzaf_1184311930285588477.plus.aac.p.m4a\",\"track_name\":\"Switch Up The Flava\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T10:00:00+00:00\",\"sale_end_date\":\"2026-02-19T12:00:00+00:00\",\"sale_start_date\":\"2026-01-23T10:00:00+00:00\",\"event_start_date\":\"2026-02-20T23:00:00+00:00\",\"event_end_date\":\"2026-02-21T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Barbican.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/f0fe1e4242bb?dice_id=f0fe1e4242bb\",\"post_competition_referral\":\"https://link.dice.fm/Y98b06effdba?dice_id=Y98b06effdba\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/j8485e969bc3?dice_id=j8485e969bc3\",\"post_purchase_referral\":\"https://link.dice.fm/If91d0e9cff8?dice_id=If91d0e9cff8\",\"post_reminder_referral\":\"https://link.dice.fm/r2e3ed7ce5d0?dice_id=r2e3ed7ce5d0\",\"post_waitinglist_referral\":\"https://link.dice.fm/v6faf1eeac59?dice_id=v6faf1eeac59\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Join Eastern Margins, the home of alternative Asian culture, for a co-curated line-up of their signature underground East & South-East club sounds.\\n\\nanyone can dance, our series of late-night parties travelling around the world via the local diasporas in the UK, kicks off with Eastern Margins creating a dialogue between the diaspora and the local.\\n\\nThey aim to serve those looking for an inclusive but safe space, identity discovery via music and a chance to get sweaty in the basement of Europe’s largest performing arts centre.\\n\\nFounded in 2018, the UK collective celebrating alternative East and South East Asian (ESEA) creativity has welcomed J-Pop, hyperpop, techno, rap, pop-punk, jazz, grime and many more genres onto its roster.\\n\\nMost recently, they’ve brought everything together with the second year of their Margins United festival celebrating ESEA culture and they’re set to bring these alternative sounds to light in the Barbican’s ClubStage after hours.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771628400,\"venues\":[{\"id\":\"11246\",\"name\":\"Barbican - Level - 1 Clubstage\",\"address\":\"Barbican Centre, Silk St, London, England EC2Y 8DP, United Kingdom\",\"location\":{\"lat\":51.5199796875,\"lng\":-0.096157625},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"barbican---level---1-clubstage-vnog\",\"accessibility\":{\"url\":\"https://www.barbican.org.uk/your-visit/accessibility/access-scheme\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T23:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":4,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:76\",\"tty_to_extras\":[],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"688\",\"name\":\"The Barbican\",\"image\":{\"url\":null},\"perm_name\":\"the-barbican-yova\",\"profile_active\":false},\"id\":\"696b688677cea60001467392\",\"name\":\"ClubStage: Eastern Margins\",\"perm_name\":\"6dn9q2-clubstage-eastern-margins-20th-feb-barbican-level-1-clubstage-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0e41db6-f580-431c-8b9c-88c159de8540.jpg?rect=682%2C0%2C2725%2C2725\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0e41db6-f580-431c-8b9c-88c159de8540.jpg?rect=0%2C136%2C4088%2C2453\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-16/a0e41db6-f580-431c-8b9c-88c159de8540.jpg?rect=1295%2C0%2C1499%2C2725\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1768989600,\"faqs\":[{\"id\":70156,\"title\":\"How do I get to the ClubStage? \",\"body\":\"Entry to the venue will be via the roadway to the left of Silk Street entrance, which will take you directly to the venue on Level -1. The accessible entrance and exit are via the main entrance on Silk Street.\",\"order\":0},{\"id\":70157,\"title\":\"Are there any warnings for this event?\",\"body\":\"This event may include loud music, flashing lights, haze and explicit imagery.\",\"order\":1},{\"id\":70158,\"title\":\"Will the event be photographed?\",\"body\":\"Photography will be taking place during this event for promotional purposes. Please speak to a member of staff if you do not wish to be photographed or have any questions.\",\"order\":2},{\"id\":70159,\"title\":\"Is there an age restriction for this event?\",\"body\":\"This event is strictly 18+ (All attendees must bring accepted form of legal ID).\",\"order\":3}],\"price\":{\"currency\":\"GBP\",\"amount\":2133,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Fri 20 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[