p.scdn.co/mp3-preview/f5f569fda8dfb67dbfbbcb58169d6476f36c8b74?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Transmission\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Rich Mix.\",\"billing_promoter\":{\"id\":\"12032\",\"name\":\"Rich Mix\",\"image\":{\"url\":null},\"perm_name\":\"rich-mix-n5pq\",\"profile_active\":false},\"date_unix\":1778263200,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"111\",\"name\":\"Rich Mix\",\"address\":\"35-47 Bethnal Green Rd, London E1 6LA\",\"location\":{\"lat\":51.5243489,\"lng\":-0.0732477000000245},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rich-mix-4w2r\",\"accessibility\":{\"url\":\"https://www.richmix.org.uk/plan-your-visit/accessibility\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-08T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":1118,\"name\":\"Rich Mix\",\"privacy_policy_link\":\"https://richmix.org.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":\"rescheduled\",\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:19\",\"about\":{\"description\":\"Support will come from Torn Relics and Ekstasis\\n\\nMargaret Chardiet is an interdisciplinary sound artist born and based in New York City. Raised by underground musicians and artists, Margaret was surrounded by a collective of the city’s impassioned, cultural detritus. Instead of following a path of higher education, she began the experimental project Pharmakon in 2006, at the age of 16. Pharmakon as a project, entity, and process, has evolved and exists in true protean form, developing alongside (or more so within) Margaret’s personal experience and auto-didactic philosophies. Her work as a whole is a forced self-possession, a celebration of ferality and viscereality, which performatively abandons a society that has never accepted anything it couldn’t also exploit. Chardiet uses electronic synthesis as a tool to transfer this self-possession physiologically and intra-spatially into the bodies of their audience. Timbre becomes temper. Ferality, a social contagion or biorhythm. Margaret has also played in numerous punk groups that extend out to a greater international D.I.Y. music community, and has composed score and original music for the films Transfiguration (2017), and Sound of Metal (2019).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1756218600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Pharmakon\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/321b5057f56142673cebe2210ffce4c6c07d3db8\"},\"artist_id\":\"4130\",\"about\":null,\"is_headliner\":false},{\"name\":\"Ekstasis\",\"image\":null,\"artist_id\":\"58110\",\"about\":null,\"is_headliner\":false},{\"name\":\"Torn Relics\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27304fb9e8bf3855985076d0cb3\"},\"artist_id\":\"34780\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"tota