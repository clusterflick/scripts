41\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S3fbb87f030e?dice_id=S3fbb87f030e\",\"post_purchase_referral\":\"https://link.dice.fm/o1ce9eeb3988?dice_id=o1ce9eeb3988\",\"post_waitinglist_referral\":\"https://link.dice.fm/i9fe4eb2efa1?dice_id=i9fe4eb2efa1\",\"post_reminder_referral\":\"https://link.dice.fm/Odd9e8abb45d?dice_id=Odd9e8abb45d\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-22T18:00:00+00:00\",\"doors_close_date\":\"2026-03-22T22:00:00+00:00\"}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Bi-2 will perform in London with one of their most beautiful programs accompanied by a symphony orchestra. Spectators will experience the majestic sound of their favorite songs performed live with orchestral accompaniment. The concerts create a solemn and mysterious atmosphere with Gothic-inspired design and stunning stage elements – black velvet, candles, a round mirror screen, and magnificent costumes. The performance will include the group’s greatest hits as well as songs from all Bi-2 albums, including the Hallelujah album released in 2022. The Bi-2 with Orchestra project has been ongoing for around 20 years, collaborating with top international orchestras, legendary studios, and experienced sound engineers.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":\"7f1597c4-7081-48a7-8bbe-4cffe330fa7a\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"impression_id\":\"45901351f3567a3a:34\",\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"presented_by\":\"Presented by Fish Can Fly.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Би-2\",\"image\":null,\"artist_id\":\"92696\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\