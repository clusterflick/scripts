\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/02/92/ea/0292ea46-0193-4695-dcf0-6ce92e03944d/mzaf_15951258470499245224.plus.aac.p.m4a\",\"track_name\":\"Earlier Nights\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765497600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Wirral-raised and London-based, Blair is an alternative rap artist whose sound blends elements of dance, jazz, and indie rock. The themes he explores tell a coming of age story through language that is sometimes elusive, sometimes direct. He grew up listening to Slipknot, Loyle Carner, and anything in between, and his music is a reflection of that - jazzy voicings are paired with smooth vocal delivery, washy guitars are offset by dancefloor rhythms. In all his tracks, Blair uses variety to create a fresh sonic aesthetic.\\n\\n**SUPPORT FROM GOOSTAVO AND LAILA SMITH**\\n\\nDesperate to share what life is like being neurodivergent, Angus Bruce began releasing music under **GOOSTAVO**. Picking up the saxophone at aged 8 he fell in love with jazz, learning to produce as a teenager, and falling in love with hip hop and rap during his time living and studying music in Southampton. Since moving to London a few years ago, alongside supporting artists like GIYA and DARGZ, GOOSTAVO has sold out shows at NextDoorRecords, The Troubadour, and The Libra alongside being a finalist in tbe 2024 Cross The Tracks Emerging Artist Competition.\\n\\n**Laila Smith** makes art-forward pop music that spills into installations and interactive digital media. Before beginning her solo project, she was a jazz prodigy, studied social theory at Harvard, and was lauded in the New York Times for her experimental vocal practice.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Next Door Records.\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:90\",\"social_links\":{\"event_share\":\"https://link.dice.fm/G812ff59b066?dice_id=G812ff59b066\",\"post_competition_referral\":\"https://link.dice.fm/d197ab8e5150?dice_id=d197ab8e5150\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K73cb45847f1?dice_id=K73cb45847f1\",\"post_purchase_referral\":\"https://link.dice.fm/A643a6b69fd1?dice_id=A643a6b69fd1\",\"post_reminder_referral\":\"https://link.dice.fm/i9ed8ade8592?dice_id=i9ed8ade8592\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hb7e188e702d?dice_id=Hb7e188e702d\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-02-19T18:30:00+00:00\",\"sale_start_date\":\"2025-12-12T00:15:00+00:00\",\"event_start_date\":\"2026-02-19T19:00:00+00:00\",\"event_end_date\":\"2026-02-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":612,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"7075\",\"name\":\"Next Door Records\",\"image\":{\"url\":null},\"perm_name\":\"next-door-records-lnvx\",\"profile_active\":false},\"id\":\"693c44b60d349b000171029b\",\"seats_io_event_id\":null,\"name\":\"Blair\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"538l78-blair-19th-feb-next-door-records-london-tickets\",\"date_unix\":1771527600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"im