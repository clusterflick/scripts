":null},\"announcement_date_unix\":1768566600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"id\":\"696a2e9e51a5bd0001f84c1f\",\"name\":\"Marcos Valle (Matinee Show)\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"eo3ww2-marcos-vallematinee-show-20th-may-the-jazz-cafe-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-02/4d8be593-d4cc-4181-a779-9ebaa9d292f2.jpg?rect=0%2C3%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-02/4d8be593-d4cc-4181-a779-9ebaa9d292f2.jpg?rect=0%2C196%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-02/4d8be593-d4cc-4181-a779-9ebaa9d292f2.jpg?rect=150%2C0%2C469%2C852\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"***\\\\*Matinee Show added due to high demand\\\\****\\n\\n**Samba & bossa to psychedelic MPB & beach boogie, Marcos Valle is one the most important musical artists in Brazil’s history.**\\n\\nFew artists in any era can claim a career as stylistically adventurous as his.\\n\\nThe renaissance man of Brazilian pop has collaborated with Leon Ware, Sarah Vaughan, and Chicago; been sampled by Jay-Z, Kanye West, Childish Gambino, Madlib, and Kaytranada; and seen his songs recorded by everyone from Frank Sinatra and Bebel Gilberto to Emma Bunton of the Spice Girls, who covered his classic ‘Os Grilos (The Crickets Sing for Anamaria)’.\\n\\nA true legend of global music, nobody gets the party started like Marcos Valle.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\