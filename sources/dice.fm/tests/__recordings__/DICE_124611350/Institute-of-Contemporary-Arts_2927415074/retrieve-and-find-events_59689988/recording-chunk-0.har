highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-09T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/faac4344-cda0-48f2-bb33-892f5ff71ed4.jpg?rect=0%2C91%2C1333%2C1333\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/faac4344-cda0-48f2-bb33-892f5ff71ed4.jpg?rect=0%2C600%2C1333%2C800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/faac4344-cda0-48f2-bb33-892f5ff71ed4.jpg?rect=117%2C0%2C1100%2C2000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/q33f78161f0f?dice_id=q33f78161f0f\",\"post_competition_referral\":\"https://link.dice.fm/H1f0a249ecbc?dice_id=H1f0a249ecbc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/x36572c2f732?dice_id=x36572c2f732\",\"post_purchase_referral\":\"https://link.dice.fm/Nff4dc5746ed?dice_id=Nff4dc5746ed\",\"post_reminder_referral\":\"https://link.dice.fm/sfaa6bd583d3?dice_id=sfaa6bd583d3\",\"post_waitinglist_referral\":\"https://link.dice.fm/rcba2744e98c?dice_id=rcba2744e98c\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":134,\"name\":\"CLUB.THE.MAMMOTH.\",\"privacy_policy_link\":\"http://bit.ly/ctmprivacystatement\",\"fb_pixel_id\":\"284003435619398\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1737,\"name\":\"Sebright Arms\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/630f3de7c213c45e2e1a26eb/t/6788e53103ae512a44d3fc44/1737024817425/Privacy+Policy+-+Sebright+Arms.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:29\",\"properties\":[],\"presented_by\":\"Presented by CLUB.THE.MAMMOTH.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1761120000,\"id\":\"68f74ca50557000001d9a374\",\"name\":\"Bibi Club\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Bibi Club is the musical project of Adèle Trottier-Rivard on vocals and keyboard, and Nicolas Basque on guitar. The pair named themselves “Bibi Club” for the discotheque in their living room, where their “bibis”—loved ones—come to dance.\\n\\nTheir debut album, Le Soleil et la Mer (2022) has made Bibi Club one of Quebec's most captivating bands. Acclaimed across continents, they earned the title of Breakthrough artist at the 2022 GAMIQ Awards, a nomination for Discovery of the Year at the ADISQ Awards, and a spot on the Polaris Music Prize long list. Le Devoir named it one of the best albums of the year while Les Inrocks, Magic Magazine, Libération, also celebrated it. The duo then appeared in Les Inrocks' ranking of the best albums of the year, in Tsugi's ranking of the 10 revelations of the year and was supported by Steve Lamacq show on BBC6 Music.\\n\\nWith Feu de Garde (2024) they expanded their sound with darker textures and luminous synths, earning them, once again, nominations at the ADISQ Awards and a nomination on the Polaris Music Prize short list, in addition to being celebrated as one of FNAC's albums of the month and receiving solid reviews from MOJO, Télérama, Record Collector, Uncut, and more. Their hypnotic and spellbinding live performances have shone at SXSW, The Great Escape Festival, Focus Wales, MaMA Festival, Osheaga, as well as stages in Brazil, Germany, and Canada. They have also opened for Blonde Redhead, Pomme, and November Ultra, among others. Their next album, Amaro, will be released in February 2026 on Secret City Records.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1280\",\"name\":\"CLUB.THE.MAMMOTH\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-26/b7c6d4f5-e734-437e-aea8-bf1dbd513d1a.jpg\"},\"perm_name\":\"clubthemammoth-nyaq\",\"profile_active\":true},\"date_unix\":1775757600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1400,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T21:00:00+00:00\",\"sale_end_date\":\"2026-04-09T17:00:00+01:00\",\"sale_start_date\":\"2026-02-13T21:00:00+00:00\",\"event_start_date\":\"2026-04-09T19:30:00+01:00\",\"event_end_date\":\"2026-04-09T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"g5m2ga-ags-connolly-band-9th-apr-the-scolt-head-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Ags Connolly - A Good Memory for Pain\",\"redirect_url\":\"https://music.apple.com/us/album/a-good-memory-for-pain/1605065702?i=1605066037&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ags Connolly\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/65/8e/f0/658ef0d3-06f4-9a61-e840-cb78b552d6e3/mzaf_15865012239765905929.plus.aac.p.m4a\",\"track_name\":\"A Good Memory for Pain\"},{\"type\":\"spotify\",\"title\":\"Ags Connolly - A Good Memory for Pain\",\"redirect_url\":\"https://open.spotify.com/track/6KCSYMtyUhB4PWgmVTKXpB\",\"artist\":\"Ags Connolly\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f35940997ccb5b8f4e2dea2d431d45b7a3368cf2?cid=921526b9c2da4b7b