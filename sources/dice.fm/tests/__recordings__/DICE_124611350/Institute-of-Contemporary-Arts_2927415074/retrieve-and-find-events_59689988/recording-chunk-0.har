y_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-30T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-28/afedcb5a-3045-4258-914f-88182955eb75.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-28/afedcb5a-3045-4258-914f-88182955eb75.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-28/afedcb5a-3045-4258-914f-88182955eb75.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1753527600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"The name says it all, Electronic Music Open Mic or EMOM for short is an open stage night for local electronic musicians.\\n\\nThis free night will showcase up to 7 local electronic artists performing an array of different types of music ranging from house, techno, ambient, industrial, chiptune, looping, field recording, experimental electronica and more.\\n\\nEMOM has become a movement over the last 2 years with regular independent nights hosted in many cities and counties across the UK. This night is aimed at giving local electronic music artists a supportive space to play live and experiment.\\n\\nThese nights are great fun for both artists and fans of electronic music, you never know what genre you might hear next!\\n\\nThe format is simple; each artist will get a 20-minute window (including set up time) to do their thing before handing over to the next artist. The only rule is no guitars unless they are being used to generate soundscapes or some other style of music in keeping with these nights.\\n\\nIf you’d like to play, please email controlvoltageemom@gmail.com to register. If you’d just like to come along and watch, just click the ‘buy now’ link to secure your place. The night is completely free whether you are playing or watching.\\n\\nAll ages welcome – under 16 to be accompanied by a responsible adult.\\n\\nThis event is hosted by Control Voltage.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"Under 18 to be accompanied by a responsible adult\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Control Voltage\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:90\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Kfcd2bf01e80?dice_id=Kfcd2bf01e80\",\"post_competition_referral\":\"https://link.dice.fm/k69dfb01a697?dice_id=k69dfb01a697\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z793397f446f?dice_id=Z793397f446f\",\"post_purchase_referral\":\"https://link.dice.fm/Veb834f06279?dice_id=Veb834f06279\",\"post_reminder_referral\":\"https://link.dice.fm/W2eaf6a6d6e4?dice_id=W2eaf6a6d6e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/d3f0804f56c2?dice_id=d3f0804f56c2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-07-26T12:00:00+01:00\",\"sale_end_date\":\"2026-09-30T19:00:00+01:00\",\"sale_start_date\":\"2025-07-26T12:00:00+01:00\",\"event_start_date\":\"2026-09-30T19:00:00+01:00\",\"event_end_date\":\"2026-09-30T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"6883a9bbb058390001cc3d7f\",\"seats_io_event_id\":null,\"name\":\"Control Voltage: Electronic Music Open Mic\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"dknvmq-control-voltage-electronic-music-open-mic-30th-sep-hot-box-chelmsford-tickets\",\"date_unix\":1790791200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 30 Sep\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-01T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sixpence None the Richer\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-08/6090bd65-876c-41a3-a5bf-e05eae520ff9.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"131144\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-10/fb923b5c-0a09-450b-af19-ddf88f1216f3.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-10/fb923b5c-0a09-450b-af19-ddf88f1216f3.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-10/fb923b5c-0a09-450b-af19-ddf88f1216f3.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/J00l602lLnkj9nyGdblS702a007OxR5D8dCkWcifM3vGScM.m3u8\",\"track_name\":\"\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1765879200,\"max_tickets\":8,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Sixpence None the Richer are renowned for their distinctive blend of indie-rock and introspective songwriting. With a gorgeous sound that is anchored in Leigh Nash’s unmistakable vocals and Matt Slocum’s intricate guitar work, their live performances leave audiences completely captivated.\\n\\nFormed in 1992 by Matt Slocum and Leigh Nash in New Braunfels, Texas, Sixpence None the Richer now have a discography spanning six full-length albums and the newly released Rosemary Hill EP. The band has received critical acclaim, having been nominated for two Grammy Awards, won numerous Dove Awards, and received honors.\\n\\nOn their return to touring in 2024 through 2025, their first time since 2013, lead singer Leigh Nash shared her excitement, saying, “I want to come out swinging.”\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by DHP Family.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:91\",\"social_links\":{\"event_share\":\"https://link.dice.fm/I8c0e09223c4?dice_id=I8c0e09223c4\",\"post_competition_referral\":\"https://link.dice.fm/Nf5f159d6213?dice_id=Nf5f159d6213\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/k9c7991fee9a?dice_id=k9c7991fee9a\",\"post_purchase_referral\":\"https://link.dice.fm/wa2ba0fc3a4b?dice_id=wa2ba0fc3a4b\",\"post_reminder_referral\":\"https://link.dice.fm/a1400da26519?dice_id=a1400da26519\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ye9a4739c27a?dice_id=Ye9a4739c27a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T10:00:00+00:00\",\"sale_end_date\":\"2026-10-01T21:00:00+01:00\",\"sale_start_date\":\"2025-12-19T09:00:00+00:00\",\"event_start_date\":\"2026-10-01T19:00:00+01:00\",\"event_end_date\":\"2026-10-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4737},\"properties\":[],\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"id\":\"693aac851679d50001a97ff8\",\"seats_io_event_id\":null,\"name\":\"Sixpence None The Richer\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"3onwrl-sixpence-none-the-richer-1st-oct-islington-assembly-hall-london-tickets\",\"date_unix\":1790877600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"90\",\"name\":\"KOKO\",\"address\":\"1A Camden High St, London NW1 7JE\",\"location\":{\"lat\":51.5347507,\"lng\":-0.138054300000022},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/5f06821a-da0b-4985-9a41-f48ae4872759.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"koko-z9b7\",\"accessibility\":{\"url\":\"https://www.koko.co.uk/access-and-facilities\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-01T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vanessa Paradis\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb0ed21d575f90079f2c7e4117\"},\"artist_id\":\"132731\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[{\"id\":71310,\"title\":\"KOKO Accessibility Information\",\"body\":\"The KOKO venue has limited space for accessibility. Accessibility tickets are only purchasable through the KOKO website and once these tickets have been sold, we cannot accept any further accessibility requests. If you require Accessibility tickets and these are no longer available, please do not purchase a GA ticket and expect to be accommodated as these will be refused. This is a strict policy to make sure the venue is safe for all customers.\\n\\nFor further information please see https://www.koko.co.uk/faqs and if you have any questions regarding accessibility contact ACCESS@koko.uk.com\",\"order\":0},{\"id\":71311,\"title\":\"Ticket Resale Restrictions\",\"body\":\"1\\\\. Your ticket purchase constitutes a personal, revocable license and, at all times, remains the property of the promoters. This ticket must be surrendered to the promoters upon request.\\n\\n2\\\\. Your ticket/s are sold by the promoters directly to you the consumer. Any tickets purchased by business or traders in breach of the terms and conditions of ticket sale will be cancelled. By accepting these terms and conditions you confirm that you are a consumer.\\n\\n3\\\\. Your ticket/s will IMMEDIATELY BECOME INVALID if resold OR OFFERED FOR SALE unless the sale is through the Artist’s official re-sale channels as advertised, or ticket agent fan to fan exchange (where applicable). Tickets sold via third parties and other unauthorised outlets, including online auction sites, are not valid for admission. The resale of a ticket renders it invalid and may lead to refusal of entry.\\n\\n4\\\\. Ticket sales are limited to a maximum of 6 per person.\\n\\n5\\\\. Only tickets purchased through approved ticket agents are valid for admission. The venue reserves the right to refuse admission.\",\"order\":1}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-22/e823b161-f4c8-4bb1-a40b-19558efb352b.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-22/e823b161-f4c8-4bb1-a40b-19558efb352b.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-22/e823b161-f4c8-4bb1-a40b-19558efb352b.jpg?rect=180%2C0%2C440%2C800\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770807600,\"max_tickets\":6,\"marketeers\":[{\"id\":918,\"name\":\"KOKO\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"421051646826847\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2075,\"name\":\"KOKO 2\",\"privacy_policy_link\":\"https://www.koko.co.uk/privacy-policy\",\"fb_pixel_id\":\"2512980718968598\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Kilimanjaro Live presents\\n\\nVanessa Paradis\\n\\n\\\\+ guests\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"exte