d\":\"95f5e6a9ee55de96:60\",\"date_unix\":1778004000,\"price\":{\"currency\":\"GBP\",\"amount\":3450,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/s06d0966de41?dice_id=s06d0966de41\",\"post_competition_referral\":\"https://link.dice.fm/T5ba44022a23?dice_id=T5ba44022a23\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V7887365b1b0?dice_id=V7887365b1b0\",\"post_purchase_referral\":\"https://link.dice.fm/w73b31d19add?dice_id=w73b31d19add\",\"post_reminder_referral\":\"https://link.dice.fm/Red6759ccffd?dice_id=Red6759ccffd\",\"post_waitinglist_referral\":\"https://link.dice.fm/n37b7c1d4aef?dice_id=n37b7c1d4aef\"},\"perm_name\":\"eordby-maneva-5th-may-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/e91aa476-513b-41b5-91af-3454ca59aa20.jpg?rect=226%2C243%2C1634%2C1634\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/e91aa476-513b-41b5-91af-3454ca59aa20.jpg?rect=0%2C286%2C2203%2C1322\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/e91aa476-513b-41b5-91af-3454ca59aa20.jpg?rect=581%2C0%2C1042%2C1894\"},\"properties\":[],\"about\":{\"description\":\"**Two decades deep, Brazil’s biggest reggae band brings their warm grooves, storytelling, and unmistakable energy to our stage.**\\n\\nFormed in São Paulo in 2005, Maneva crafts reggae that’s both deeply Brazilian and globally resonant.\\n\\nTheir set spans a catalogue of hits — from Seja Para Mim to O Destino Não Quis — alongside tracks from Origem, their latest album.\\n\\nTight, emotive, and full of pulse, every song carries the rhythm, soul, and heart that earned them a Grammy Latino nomination.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6989fc0f01e0c90001a73b83\",\"name\":\"Maneva\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":