nder_referral\":\"https://link.dice.fm/H3af7208bb8e?dice_id=H3af7208bb8e\",\"post_waitinglist_referral\":\"https://link.dice.fm/G2c0d4c33e46?dice_id=G2c0d4c33e46\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"yoal9v-mixtape-the-euro-step-heartless-crew-17th-apr-prince-of-peckham-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776456000,\"has_multiple_ticket_types\":true,\"impression_id\":\"ebbfe7c73b45a3bb:11\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":900},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/409e2b6e-558f-417a-9a80-38777bd31483.jpg?rect=522%2C0%2C2048%2C2048\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/409e2b6e-558f-417a-9a80-38777bd31483.jpg?rect=0%2C97%2C3091%2C1855\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/409e2b6e-558f-417a-9a80-38777bd31483.jpg?rect=983%2C0%2C1126%2C2048\"},\"id\":\"698b18aa9c47a20001334dc5\",\"name\":\"MIXTAPE : THE EURO STEP - HEARTLESS CREW\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"MIXTAPE – Every Friday Night at Prince of Peckham!\\n\\nYour Friday nights just got patterned! We’re running the hottest tracks from across the charts and the streets, from the throwbacks you love to the tunes taking over right now. We’re talking the finest selectors spinning non-stop fire from across the globe.\\n\\nPull up and catch our DJs doing what they do best, setting the vibe from start to finish. If it’s a banger, it’s on their playlist.\\n\\nVisit our website to secure a table at https://princeofpeckham.co.uk .\\n\\nEntry Policy:\\n\\nTickets do not guarantee entry. They provide priority access and queue jump, but entry remains subject to venue capacity and conditions.\\n\\nDress Code: No sportswear, tracksuits, or track shorts. Guests not adhering to the dress code will be refused entry, regardless of ticket purchase. No refunds will be issued.\\n\\nAge Policy: 21+ only. A valid photo ID is required for entry.\\n\\nTicket holders are guaranteed priority entry until 11 PM (subject to capacity). From 11pm entry will be at the discretion of the venue.\\n\\nLast Entry: Doors close at 12:30 AM. Ticket holders arriving after this time will be refused entry with no refund.\\n\\nAll rights of admission are reserved by Prince of Peckham.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 21+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T00:00:00+00:00\",\"sale_end_date\":\"2026-04-17T19:00:00+01:00\",\"sale_start_date\":\"2026-02-10T00:00:00+00:00\",\"event_start_date\":\"2026-04-17T21:00:00+01:00\",\"event_end_date\":\"2026-04-18T01:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by The Blues Kitchen Camden.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":20,\"properties\":[],\"venues\":[{\"id\":\"1779\",\"name\":\"The Blues Kitchen Camden\",\"address\":\"111-113 Camden High St, London NW1 7SN, UK\",\"location\":{\"lat\":51.5370635,\"lng\":-0.1412731000000349},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27