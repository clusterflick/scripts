:\"https://dice-media.imgix.net/attachments/2026-01-28/c2b9a0dc-a35b-4de0-9fd0-075a8c2fd377.jpg?rect=0%2C58%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/c2b9a0dc-a35b-4de0-9fd0-075a8c2fd377.jpg?rect=471%2C0%2C558%2C1015\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/G79d4b015ef1?dice_id=G79d4b015ef1\",\"post_competition_referral\":\"https://link.dice.fm/ydcda90ae258?dice_id=ydcda90ae258\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ba39701ee7d2?dice_id=Ba39701ee7d2\",\"post_purchase_referral\":\"https://link.dice.fm/k13adef5eeef?dice_id=k13adef5eeef\",\"post_reminder_referral\":\"https://link.dice.fm/M633555e81ab?dice_id=M633555e81ab\",\"post_waitinglist_referral\":\"https://link.dice.fm/j4a7c266a022?dice_id=j4a7c266a022\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"db136d3610fd9326:42\",\"properties\":[],\"presented_by\":\"Presented by The Fox & Firkin.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769558400,\"id\":\"697a31833669740001be758a\",\"name\":\"Alvorada + Iñes Loubet – Carnival Special\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Brazilian instrumental quintet **Alvorada** will be joined by singer **Ines Loubet** for a round-the-table special show to bring the spirit of old-time carioca carnival to London. Expect an afternoon of infectious choro melodies, soulful samba songs and playful interaction!\\n\\nAlvorada are an award-winning quintet who play Brazilian music inspired by the choro tradition. Now in their tenth year, Alvorada have delighted audiences at festivals and venues across the UK and internationally. With two highly-acclaimed albums – First Light (2019) and Faz Tempo (2024) – and multiple radio appearances to their name, Alvorada play “music that won’t let you stay still” (BBC Radio 3).\\n\\nInês Loubet is one of London’s most exciting vocalists and interpreters of samba. A singer-songwriter hailing from Portugal, Inês blends Latin jazz, Tropicália, and soulful grooves into her signature sound. With extensive radio play and celebrated live performances, Inês continues to enchant listeners worldwide, solidifying her place as a vital voice in contemporary jazz and world music.\\n\\nInês Loubet will be singing roots sambas and playing percussion with Alvorada, a unique collaboration for the Fox & Firkin.\\n\\nMusicians:\\n\\nRachel Hayter – flute\\n\\nAndrew Woolf – clarinet\\n\\nJeremy Shaverin – cavaquinho\\n\\nLuiz Morais – 7-string guitar\\n\\nAndres Ticino – percussion\\n\\nInes Loubet — vocals & percussion\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"date_unix\":1771779600,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T00:00:00+00:00\",\"sale_end_date\":\"2026-02-22T17:00:00+00:00\",\"sale_start_date\":\"2026-01-13T00:00:00+00:00\",\"event_start_date\":\"2026-02-22T17:00:00+00:00\",\"event_end_date\":\"2026-02-22T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvkbn3-london-music-ultimate-showcase-festival-all-dayer-22nd-feb-the-old-blue-last-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"SEY.MOUR. - Drive\",\"redirect_url\":\"https://open.spotify.com/track/2pAephI8rAz9wXCjEmIKtm\",\"artist\":\"SEY.MOUR.\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1b23