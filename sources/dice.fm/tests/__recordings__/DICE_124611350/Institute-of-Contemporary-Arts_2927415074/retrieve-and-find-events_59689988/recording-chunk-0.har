":\"the-jazz-cafe-4m7k\",\"accessibility\":{\"url\":\"https://thejazzcafelondon.com/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-02T22:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:49\",\"date_unix\":1777757400,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":700},\"social_links\":{\"event_share\":\"https://link.dice.fm/Kafbde8fa129?dice_id=Kafbde8fa129\",\"post_competition_referral\":\"https://link.dice.fm/V2d0816d9e74?dice_id=V2d0816d9e74\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i9aced85fa81?dice_id=i9aced85fa81\",\"post_purchase_referral\":\"https://link.dice.fm/J4820fb9450f?dice_id=J4820fb9450f\",\"post_reminder_referral\":\"https://link.dice.fm/w67bcaae1c9c?dice_id=w67bcaae1c9c\",\"post_waitinglist_referral\":\"https://link.dice.fm/E8da600ae2b1?dice_id=E8da600ae2b1\"},\"perm_name\":\"oev26m-byron-the-aquarius-bank-holiday-special-2nd-may-the-jazz-cafe-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/851fb0a4-d2b8-4c9b-b31f-07d32e2258d0.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/851fb0a4-d2b8-4c9b-b31f-07d32e2258d0.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/851fb0a4-d2b8-4c9b-b31f-07d32e2258d0.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Soul City welcomes Chicago house specialist Byron The Aquarius for a Bank Holiday Saturday club special at the legendary Jazz Cafe.\\n\\nDrawing from jazz, deep house and classic Chicago rhythms, his sets balance musical depth with locked-in dancefloor pressure. He's known for his work on labels like Sound Signature and Axis and has had countless global festival appearances.\\n\\nByron’s music sits at the intersection of soulful house and club sophistication, so expect warm grooves and rolling keys all night long!\\n\\nSoul City brings together decades of house music culture guided by trusted DJs who know how to work the room.\\n\\nWarm, unpretentious, and built on great records and good energy in one of the UK’s most iconic venues.\\n\\nEarly tickets from £5.\\n\\nExclusive areas on our mezzanine overlooking the dancefloor are available via our website.\\n\\n\\\\----------------------------------------------------------------------------------------------\\n\\nPlease adhere to specified entry times on your ticket to avoid potential late surcharge. Last entry is at 2am. Tickets are always available on the door but the price is higher than advance tickets.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6980c74915495800015321f4\",\"name\":\"Byron The Aquarius: Bank Holiday Special\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Feel My Thoughts - Bruh\",\"redirect_url\":\"https://open.spotify.com/track/59S0MtYYJskLwLGV9fyZiq\",\"artist\":\"Feel My Thoughts\",\"preview_url\":\"https://p.scdn.co/mp3-preview/7e5bdbb48edf8b1d8330907f7b12122215606b3d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Bruh\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Byron The Aquarius\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb59d91e609a5d60d98abe7c9b\"},\"artist_id\":\"4456\"