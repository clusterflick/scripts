arketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1771689600,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:2\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2022-10-28/cba635d8-6c2e-4825-82db-c63ee0cad9eb.jpg?rect=8%2C0%2C894%2C894\",\"landscape\":\"https://dice-media.imgix.net/attachments/2022-10-28/cba635d8-6c2e-4825-82db-c63ee0cad9eb.jpg?rect=0%2C174%2C910%2C546\",\"portrait\":\"https://dice-media.imgix.net/attachments/2022-10-28/cba635d8-6c2e-4825-82db-c63ee0cad9eb.jpg?rect=209%2C0%2C492%2C894\"},\"id\":\"69845942455a1e0001079fce\",\"name\":\"FRANCESCA WOODMAN: DOCUMENTARY SCREENING\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The tragic story of Francesca Woodman, a photographer renowned for her nude self-portraits, is also the story of her brilliantly artistic family. Director C. Scott Willis shows how the struggle for fame in the world of art resulted in tragedy.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-05T09:00:00+00:00\",\"sale_end_date\":\"2026-02-21T15:45:00+00:00\",\"sale_start_date\":\"2026-02-05T09:00:00+00:00\",\"event_start_date\":\"2026-02-21T16:00:00+00:00\",\"event_end_date\":\"2026-02-21T18:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null}],\"title\":\"Sat 21 Feb\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship and Broadside Hacks.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[{\"id\":57985,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-22T14:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/Pe8e303070e9?dice_id=Pe8e303070e9\",\"post_competition_referral\":\"https://link.dice.fm/n24876c9dd5e?dice_id=n24876c9dd5e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/c110a10bb236?dice_id=c110a10bb236\",\"post_purchase_referral\":\"https://link.dice.fm/Mec83a820757?dice_id=Mec83a820757\",\"post_reminder_referral\":\"https://link.dice.fm/Ya03d0f6d01f?dice_id=Ya03d0f6d01f\",\"post_waitinglist_referral\":\"https://link.dice.fm/Qa9b1e7a7e93?dice_id=Qa9b1e7a7e93\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"rynkpw-metropolis-ft-live-original-score-matinee-22nd-feb-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1771772400,\"has_multiple_ticket_types\":false,\"impression_id\":\"2a9532c5f9eec3df:3\",\"price\":{\"currency\":\"GBP\",\"amount\":1133,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/1ba7e036-ac8c-4f98-8ff9-f17f13d3449e.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/1ba7e036-ac8c-4f98-8ff9-f17f13d3449e.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/1ba7e036-ac8c-4f98-8ff9-f17f13d3449e.jpg?rect=173%2C0%2C422%2C768\"},\"id\":\"697ce9ba5b8a5a0001f0d5a5\",\"name\":\"'Metropolis' ft. live original score (matinee)\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Theatreship and Broadside Hacks Presents...\\n\\nScreening of Fritz langs visionary master piece, 'Metropolis', accompanied by live music from Joe Harvey-Whyte, aboard Theatreship; a performing arts space on a historic ship in the old docks of Canary Wharf. (Supported by BFI FAN)\\n\\nThe modern restored version of Metropolis, widely circulated today, is based primarily on material from the surviving U.S. distribution negative. In contrast, the rare cut version presented here, was derived from one of the now long-lost European negatives. As a result, there are some notable differences in performance and shot composition. It runs at a brisk 60 minutes and it is, in a very real sense, a different version of the film. This print has likely passed through countless hands, projected in living rooms across decades, and now finds a new audience in digital form.\\n\\nJoe Harvey-Whyte is also a multidisciplinary artist working at the cross section between ambient/experimental music, visual art and environmental sound. His solo work combines the sound of the pedal steel guitar with electronics and field recordings to make works that create a space for deep listening and reflection whilst attempting to translate and subtly amplify the quieter moments of everyday life.\\n\\n**This event is part of Silent Film with New Sound season at Theatreship.**\\n\\n**Programme supported by Film Hub London, managed by Film London. Proud to be a partner of the BFI Film Audience Network, funded by the National Lottery.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 15+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T00:00:00+00:00\",\"sale_end_date\":\"2026-02-22T18:00:00+00:00\",\"sale_start_date\":\"2026-01-26T00:00:00+00:00\",\"event_start_date\":\"2026-02-22T15:00:00+00:00\",\"event_end_date\":\"2026-02-22T18:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Joe Harvey-Whyte - Flatland\",\"redirect_url\":\"https://music.apple.com/us/album/flatland/1586102408?i=1586102409&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Joe Harvey-Whyte\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/55/48/f5/5548f5a4-b118-4000-b566-5a04a266d7e8/mzaf_534292032434442397.plus.aac.p.m4a\",\"track_name\":\"Flatland\"},{\"type\":\"spotify\",\"title\":\"Joe Harvey-Whyte - Plainsong\",\"redirect_url\":\"https://open.spotify.com/track/50g0Y8sQd54uJMfh9wmPTJ\",\"artist\":\"Joe Harvey-Whyte\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fde9874353fee05871d404967cf28583de6cd7eb?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Plainsong\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Theatreship and Broadside Hacks.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"faqs\":[{\"id\":71954,\"title\":\"Theatreship Accessibility Policy\",\"body\":\"Theatreship is committed to broadening access to the arts - we know that ticket price is a huge barrier for some. If the regular ticket price is beyond what you feel able to afford for whatever reason, please don't hesitate to email us at tickets@theatreship.co.uk and we will send a ticket at whatever price works for you, no questions asked.\\n\\nDue to the historic nature of the ship, we’re sorry to say there is not currently step-free access into the theatre space. We have dedicated staff on hand to help with stairs, and an onsite wheelchair once you’re inside the venue. If you have any access needs, please do e-mail us at access@theatreship.co.uk, we're always happy to hear from you, and we'll do whatever we can to help!\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"14088\",\"name\":\"Theatreship\",\"address\":\"South Quay Plaza 2, London, England E14 9SH, United Kingdom\",\"location\":{\"lat\":51.500574,\"lng\":-0.01734},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/325a798f-118c-4bd1-ad3e-4bfdd4f477dc.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"theatreship-yo272\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-22T19:00:00+00:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"140292\",\"name\":\"Theatreship\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-11-16/51664b22-6eb3-4e8a-8a59-f7fb6862942d.jpg\"},\"perm_name\":\"theatreship-dx586\",\"profile_active\":true},\"announcement_date_unix\":1769385600,\"social_links\":{\"event_share\":\"https://link.dice.fm/f415cd5079f6?dice_id=f415cd5079f6\",\"post_competition_referral\":\"https://link.dice.fm/n99a18459db0?dice_id=n99a18459db0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/xf8e45d23f67?dice_id=xf8e45d23f67\",\"post_purchase_referral\":\"https://link.dice.fm/r2ce050c72e5?dice_id=r2ce050c72e5\",\"post_reminder_referral\":\"https://link.dice.fm/Y653771eb2bc?dice_id=Y653771eb2bc\",\"post_waitinglist_referral\":\"https://link.dice.fm/jda69cf1031c?dice_id=jda69cf1031c\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"av3wrq-metropolis-ft-live-original-score-22nd-feb-theatreship-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"mark