:51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T18:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/4937bd51-c26e-4e88-9783-1d6c51ed2440.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/4937bd51-c26e-4e88-9783-1d6c51ed2440.jpg?rect=0%2C440%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/4937bd51-c26e-4e88-9783-1d6c51ed2440.jpg?rect=160%2C0%2C880%2C1600\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Yfd17e80ba13?dice_id=Yfd17e80ba13\",\"post_competition_referral\":\"https://link.dice.fm/f227f0bf7207?dice_id=f227f0bf7207\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D4ee124daa1f?dice_id=D4ee124daa1f\",\"post_purchase_referral\":\"https://link.dice.fm/n17d2bfaad4f?dice_id=n17d2bfaad4f\",\"post_reminder_referral\":\"https://link.dice.fm/N47d4cb03ced?dice_id=N47d4cb03ced\",\"post_waitinglist_referral\":\"https://link.dice.fm/C6445dc0b7c4?dice_id=C6445dc0b7c4\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:32\",\"properties\":[],\"presented_by\":\"Presented by The Fox & Firkin.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1767717900,\"id\":\"695d3f066dab5a00012659d1\",\"name\":\"Sarabanda present Yuri Moreno sings Celia Cruz\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Sarabanda present\\n\\nYuri Moreno Sings Celia Cruz\\n\\nThe ‘Queen of Salsa’, Celia Cruz is one of the best known and most-loved Salsa musicians. Hailing from Cuba, where she first made a name for herself, Celia Cruz relocated to New York where she became one of the leading lights of the iconic Fania All Stars. Tonight we launch this project celebrating the life and works of Celia Cruz with Cuban songstress Yuri Moreno interpreting some of Celia’s great works. Plus there’ll be a selection of Sarabanda original tunes for good measure.\\n\\nJoin us for a special evening of glorious music.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10745\",\"name\":\"The Fox & Firkin\",\"image\":{\"url\":null},\"perm_name\":\"the-fox--firkin-em3y\",\"profile_active\":false},\"date_unix\":1772388000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-11-28T00:00:00+00:00\",\"sale_end_date\":\"2026-03-01T20:00:00+00:00\",\"sale_start_date\":\"2025-12-10T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T18:00:00+00:00\",\"event_end_date\":\"2026-03-01T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvwny3-not-the-usual-jam-free-1st-mar-grow-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T11:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2024-11-28/45f872f2-6e80-46f4-a2d4-951d15918aa8.jpg?rect=582%2C0%2C2979%2C2979\",\"landscape\":\"https://dice-media.imgix.net/attachments/2024-11-28/45f872f2-6e80-46f4-a2d4-951d15918aa8.jpg?rect=0%2C147%2C4476%2C2686\",\"portrait\":\"https://dice-media.imgix.net/attachments/2024-11-28/45f872f2-6e80-46f4-a2d4-951d15918aa8.jpg?rect=1419%2C0%2C1638%2C2979\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/h8521e50f981?dice_id=h8521e50f981\",\"post_competition_referral\":\"https://link.dice.fm/k874f7d0ab23?dice_id=k874f7d0ab23\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W56e6ab23f2f?dice_id=W56e6ab23f2f\",\"post_purchase_referral\":\"https://link.dice.fm/wb1186092438?dice_id=wb1186092438\",\"post_reminder_referral\":\"https://link.dice.fm/X3844b9af26c?dice_id=X3844b9af26c\",\"post_waitinglist_referral\":\"https://link.dice.fm/Qbcca82353e0?dice_id=Qbcca82353e0\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:33\",\"properties\":[],\"presented_by\":\"Presented by Grow, Hackney.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1732752000,\"id\":\"69398f8f3bf9990001bf71dc\",\"name\":\"Not The Usual Jam // Free\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"David (The Orbalist, Hackney Rhythm) hosts a jam that’s open, inclusive, and entirely pay-to-play free. This is a space where synths, sequencers, MPCs, and E-drums meet guitars, basses, keys, and acoustic drums.\\n\\nThe magic began when David met Alessandro Corda, a versatile musician, DJ, and producer. Sharing a passion for music and a vision for community-driven creativity, Alex became a key collaborator. From managing the stage to driving improvements behind the scenes, Alex has helped elevate the jam into something truly special.\\n\\nJoin us on the first Sunday of every month. Whether you're a seasoned performer or a newcomer, this is your space to explore. Free admission, a safe atmosphere, and a welcoming vibe make it the perfect spot for everyone—keyboard virtuosos, beatmakers, and vocal storytellers alike.\\n\\nOur stage has seen everything: the raw vocals of new singers, the experimental loops of producers, and performances by talents like Charlie Stacey, Qoha, George The Poet, and more. Regulars like Alex Mike The Mic, Freddie Mpanga, Nico (MoorMoor), and others bring their creativity, celebrating progress and fostering growth.\\n\\nThe NTUJ session is a sandbox for sonic exploration where genres blur and magic happens. Bring your instruments, drum machines, unconventional gear, and curiosity.\\n\\nQuestions? Email infohackneyrhythm@gmail.com, or just bring your passion and show up!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"date_unix\":1772388000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2648,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-17T13:00:00+01:00\",\"sale_end_date\":\"2026-03-01T17:00:00+00:00\",\"sale_start_date\":\"2025-09-19T09:00:00+01:00\",\"event_start_date\":\"2026-03-01T18:00:00+00:00\",\"event_end_date\":\"2026-03-01T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"q2arvo-dead-pioneers-1st-mar-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Bad Indian\",\"redirect_url\":\"https://open.spotify.com/track/0W2xuJwNn3pJ4g6xSY1e4m\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/4536ed33d9bf475eba16cfe8a730f79c98fe0d78?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Bad Indian\"},{\"type\":\"apple_music\",\"title\":\"Dead Pioneers - Tired\",\"redirect_url\":\"https://music.apple.com/us/album/tired/1777855003?i=1777855197&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dead Pioneers\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/3e/17/d3/3e17d305-ca2f-35fb-608e-4126e4418d30/mzaf_733549057182325068.plus.aac.p.m4a\",\"track_name\":\"Tired\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[{\"id\":45224,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":45225,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":45226,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dead Pioneers \",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-12/f5a9755e-fd46-439e-ae70-360bf718667d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"96988\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T18:00:00+00:00\",\"doors_close_date\":\"2026-03-01T22:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-16/108b7355-b862-42a4-8de7-5216a6e5922b.jpg?rect=1266%2C0%2C5072%2C5072\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-16/108b7355-b862-42a4-8de7-5216a6e5922b.jpg?rect=0%2C255%2C7604%2C4562\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-16/108b7355-b862-42a4-8de7-5216a6e5922b.jpg?rect=2407%2C0%2C2790%2C5072\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/U79305cb7e2b?dice_id=U79305cb7e2b\",\"post_competition_referral\":\"https://link.dice.fm/R555367409a8?dice_id=R555367409a8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/B55e38924552?dice_id=B55e38924552\",\"post_purchase_referral\":\"https://link.dice.fm/g6ad29e7b043?dice_id=g6ad29e7b043\",\"post_reminder_referral\":\"https://link.dice.fm/i5296ce57251?dice_id=i5296ce57251\",\"post_waitinglist_referral\":\"https://link.dice.fm/C01d4c05fd8d?dice_id=C01d4c05fd8d\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:34\",\"properties\":[],\"presented_by\":\"Presented by The Underworld.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1758110400,\"id\":\"68c985c69782d10001ca1276\",\"name\":\"DEAD PIONEERS\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Dead Pioneers, the indigenous punk rock band from Denver, have never been afraid to use their art as a vehicle to express their beliefs and anger at the current political landscape in America. Over two albums – their self-titled debut in 2023 and ‘PO$T AMERICAN’ from earlier this year, the band have concocted a unique blend of spoken word, hypnotic post-rock and punk roots that has quickly caught the imagination of music fans searching for something new, something real and a band with something to say.\\n\\nDead Pioneers have now returned with a new single that is perhaps their most enraged work to date. ‘Freedom Means Something’ was recorded at the same time as ‘PO$T AMERICAN’, but didn’t make the album at the time, yet despite being written over a year ago, it captures the political and social moment of the United States and the anger, fear and vitriol that comes in policy changes and egregious decisions being made by this current administration.\\n\\n“It was one of a few pieces we did that didn’t make the album cut at the time,” clarifies frontman Gregg Deal. “It wasn’t an issue of good or not, so much as curating our second record to something that made sense. We are so pleased to be releasing this piece now. Much like our second record, we wrote for the moment and didn’t expect the message of the music to be more relevant to what is currently happening here. We stand by our message, politically, socially and culturally, in hopes for change. These statements are meant to be in the moment of recognizing that there are those among us, the most vulnerable, that will be the first to feel the effects of what we can only call oppressive. It is our moral duty and obligation to say the quiet thing out loud in an effort to use the medium of music to provide another way to hear ideas that stand in opposition of policies that align with the principles of white supremacy and fascism and nazi ideology, undermining the basic principles of freedom. We hope you see this in Freedom Means Something.”\\n\\n“We will tar and feather you with your money and prepare you for your place in the annals of historical genocide. Amidst the nationalistic maniacs that destroy families and land, and legacy and truth and decency. Your end is near,” says Gregg in the song’s closing verse. It’s powerful, intense and righteous.\\n\\nListen to ‘Freedom Means Something’ here:\\n\\nhttps://dead-pioneers.ffm.to/freedom-means-something\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1772388000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":718},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-12T00:00:00+00:00\",\"sale_end_date\":\"2026-03-01T16:30:00+00:00\",\"sale_start_date\":\"2025-12-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-01T18:30:00+00:00\",\"event_end_date\":\"2026-03-01T20:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"nvwadq-minguet-quartet-1st-mar-conway-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"3223\",\"name\":\"Conway Hall\",\"address\":\"25 Red Lion Square Holborn, London WC1R 4RL UK\",\"location\":{\"lat\":51.51948760000001,\"lng\":-0.1168424},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"conway-hall-obq5\",\"accessibility\":{\"url\":\"https://www.conwayhall.org.uk/about-us/faqs/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-01T18:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0473b0b-b4c6-4d5a-b860-593f2aeeea03.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0473b0b-b4c6-4d5a-b860-593f2aeeea03.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0473b0b-b4c6-4d5a-b860-593f2aeeea03.jpg?rect=173%2C0%2C422%2C768\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/A77e2097d1b2?dice_id=A77e2097d1b2\",\"post_competition_referral\":\"https://link.dice.fm/Gc8ad349b41c?dice_id=Gc8ad349b41c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G30afa601aec?dice_id=G30afa601aec\",\"post_purchase_referral\":\"https://link.dice.fm/V2454159e49b?dice_id=V2454159e49b\",\"post_reminder_referral\":\"https://link.dice.fm/R166c526b1f4?dice_id=R166c526b1f4\",\"post_waitinglist_referral\":\"https://link.dice.fm/a266cabbb713?dice_id=a266cabbb713\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"e044e34315b96a4b:35\",\"properties\":[],\"presented_by\":\"Presented by Conway Hall.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765497600,\"id\":\"6925baa420c2fc0001c4829e\",\"name\":\"Minguet Quartet\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"For their welcome return to Conway Hall, the German **Minguet Quartet** foreground the fourth string quartet by Pēteris Vasks, who celebrates his 80th birthday in 2026. Either side of the Vasks come Mozart's *D minor quartet*, dedicated to Haydn, and Brahms' first essay in the genre, of which the composer wrote that as Mozart had gone to \\\"particular trouble\\\" in composing six \\\"beautiful\\\" Haydn Quartets, he had done his \\\"very best to turn out one or two passably decent ones.\\\"\\n\\n**Mozart** | Quartet in D minor K421\\n\\n**Vasks** | Quartet No.4\\n\\n**Brahms** | Quartet in C minor Op.51/1\\n\\nUlrich Isfort • *violin*\\n\\nAnnette Reisinger • *violin*\\n\\nAida-Carmen Soanea • *viola*\\n\\nMatthias Diener • *cello*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an all ages event. Under 16's must be accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"5578\",\"name\":\"Conway Hall\",\"image\":{\"url\":null},\"perm_name\":\"conway-hall-5nry\",\"profile_active\":false},\"date_unix\":1772389800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1850,\"sales_tax\":0,\"amount_from\":null},\