quare\":\"https://dice-media.imgix.net/attachments/2025-10-03/81f56ee3-eaff-4a0d-ac0a-1cd65fad969e.jpg?rect=856%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-03/81f56ee3-eaff-4a0d-ac0a-1cd65fad969e.jpg?rect=0%2C187%2C5211%2C3127\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-03/81f56ee3-eaff-4a0d-ac0a-1cd65fad969e.jpg?rect=1643%2C0%2C1925%2C3500\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Julian Lage is a world-class guitar virtuoso and composer, hailed as one of his generation's greatest talents by critics and colleagues alike. Born in California and currently based in New York City, Lage began his musical career at a very young age, and has charted a colorful, ever changing, and ever innovative path since, one that has, so far, earned him five GRAMMY nominations, one Independent Music Award and countless invitations to collaborate with the best and brightest working in music today.\\n\\nLage's most recent studio release is 2024's critically acclaimed Speak to Me (Blue Note Records), which was nominated for Best Contemporary Instrumental Album at the 67th annual GRAMMY Awards. Over the course of his multi-decade career, Lage has collaborated with fellow musical heavyweights including Gary Burton, Yoko Ono, Jim Hall, John Zorn and more.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"7+. Under 16s must be accompanied by an adult. \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Pick Me Up\",\"redirect_url\":\"https://open.spotify.com/track/61xAkK279yWEUDwnuVIdwa\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/26ccc292e5b1cb91395272db220764e44440e117?cid