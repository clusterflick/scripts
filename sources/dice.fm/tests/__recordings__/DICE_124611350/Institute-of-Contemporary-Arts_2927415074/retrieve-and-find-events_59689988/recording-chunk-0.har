\":1772823600,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"status\":\"sold-out\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:74\",\"venues\":[{\"id\":\"10\",\"name\":\"The Shacklewell Arms\",\"address\":\"71 Shacklewell Lane, London E8 2EB\",\"location\":{\"lat\":51.5531551,\"lng\":-0.0699228999999377},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-shacklewell-arms-z82z\",\"accessibility\":{\"url\":\"https://www.shacklewellarms.com/info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-06T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Parviz\",\"image\":null,\"artist_id\":\"56343\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Club.The.Mammoth. presents\\n\\nParviz\\n\\nplus Special Guest Lisa Boostani\\n\\nParviz’s self-titled debut album is slated for release in 2026: infused with psych, funk and classic sounds from the Persian world, it evokes the spirit of Iran’s 70’s music scene while adding a contemporary touch. At times buoyant, variegated and contemplative, it’s like an old taping of Iran’s beloved show Rangarang brought back to life. Flowing detuned synths and DIY aesthetics give it this indie je-ne-sais-quoi; it’s candid, nostalgic, dreamy and fierce, both rooted in Persian culture and distinctly modern.\\n\\nLead single “Azadeh” — a female given name meaning “free-spirited” — pays homage to the “Woman Life Freedom” movement, with artwork by Rana Fadavi emphasising its urgency. Follow-up “Sappho’s Fragments” aired on BBC Radio 6 and has totalled more than 300k streams in its first 6 months after release.\\n\\nParviz’s music aired on BBC Radio 1, Radio 6, FIP, and has been found on playlists from Facemelts, A1234 and many more. Parviz will be touring in the UK in February & March 2026 for his “Khorshid Khanoom” tour, and will be playing at the Shacklewell Arms in London on 6th March.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-21T13:15:00+00:00\",\"sale_end_date\":\"2026-03-06T17:00:00+00:00\",\"sale_start_date\":\"2025-11-25T10:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:00:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69206a9aaaa72100018184fa\",\"name\":\"Parviz + Lisa Boostani\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-21/a7e67a86-0f4b-40db-9816-a59a549ebee2.jpg?rect=0%2C128%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-21/a7e67a86-0f4b-40db-9816-a59a549ebee2.jpg?rect=0%2C344%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-21/a7e67a86-0f4b-40db-9816-a59a549ebee2.jpg?rect=173%2C0%2C734%2C1335\"},\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":134,\"name\":\"CLUB.THE.MAMMOTH.\",\"privacy_policy_link\":\"http://bit.ly/ctmprivacystatement\",\"fb_pixel_id\":\"28400343