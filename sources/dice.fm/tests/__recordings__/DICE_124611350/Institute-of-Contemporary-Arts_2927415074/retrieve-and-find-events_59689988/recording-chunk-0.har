ed\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:91\",\"about\":{\"description\":\"Yung Bleu – Debut London Headline Show: “I Can’t Wait To See You”\\n\\nGet ready, London! Yung Bleu is making his debut headline appearance in the city with the highly anticipated “I Can’t Wait To See You” show. Known for his platinum records, chart-topping singles, and signature blend of R&B and hip-hop, Yung Bleu brings raw emotion, unforgettable melodies, and undeniable star power to every performance.\\n\\nThis landmark show celebrates his journey from rising Southern talent to international sensation. Fans can expect hit songs, exclusive performances, and a night full of energy, vibes, and unforgettable moments. Don’t miss your chance to see one of the most exciting voices in modern R&B live for the very first time in London.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1770402600,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Yung Bleu \",\"image\":null,\"artist_id\":\"29781\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/4927e072-f03a-418b-9a55-49f6cd529191.jpg?rect=0%2C0%2C2000%2C2000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/4927e072-f03a-418b-9a55-49f6cd529191.jpg?rect=0%2C400%2C2000%2C1200\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/4927e072-f03a-418b-9a55-49f6cd529191.jpg?rect=450%2C0%2C1100%2C2000\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"69863672eb4e46000138c36e\",\"name\":\"Yung Bleu – Debut London Headline Show: “I Can’t Wait To See You”\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-06T18:30:00+00:00\",\"sale_end_date\":