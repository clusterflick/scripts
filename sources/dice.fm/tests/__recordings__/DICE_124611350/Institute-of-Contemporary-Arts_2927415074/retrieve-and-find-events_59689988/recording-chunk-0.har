556-9b28-44fe-bf0b-2744f96b5071.jpg?rect=718%2C0%2C1150%2C1150\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/65e47556-9b28-44fe-bf0b-2744f96b5071.jpg?rect=66%2C0%2C1917%2C1150\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/65e47556-9b28-44fe-bf0b-2744f96b5071.jpg?rect=708%2C0%2C633%2C1150\"},\"id\":\"696f86650d25f80001a05b14\",\"name\":\"Sugar Horse\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"The Black Heart presents...\\n\\n**SUGAR HORSE  \\n***Plus guests...*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-30T10:00:00+00:00\",\"sale_end_date\":\"2026-04-18T18:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-04-18T19:00:00+01:00\",\"event_end_date\":\"2026-04-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Shearling\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb147beda2fe1d4ae33b818e7e\"},\"artist_id\":\"123953\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by JOY..\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":67503,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-18T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"1674\",\"name\":\"JOY.\",\"image\":{\"url\":null},\"perm_name\":\"joy-bv9o\",\"profile_active\":false},\"announcement_date_unix\":1768237200,\"social_links\":{\"event_share\":\"https://link.dice.fm/l90b365b82db?dice_id=l90b365b82db\",\"post_competition_referral\":\"https://link.dice.fm/g20893d8d738?dice_id=g20893d8d738\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E83515483482?dice_id=E83515483482\",\"post_purchase_referral\":\"https://link.dice.fm/Xb73c98c81cc?dice_id=Xb73c98c81cc\",\"post_reminder_referral\":\"https://link.dice.fm/E0c81f7430da?dice_id=E0c81f7430da\",\"post_waitinglist_referral\":\"https://link.dice.fm/y94cf5322cf5?dice_id=y94cf5322cf5\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"537drw-shearling-18th-apr-the-lexington-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":1595,\"name\":\"JOY.\",\"privacy_policy_link\":\"https://www.joyconcerts.com/privacy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776535200,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:26\",\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/db19e69b-beca-45ed-91d6-63988cbf5940.jpg?rect=0%2C843%2C3282%2C3282\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/db19e69b-beca-45ed-91d6-63988cbf5940.jpg?rect=0%2C1078%2C3282%2C1969\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/db19e69b-beca-45ed-91d6-63988cbf5940.jpg?rect=507%2C0%2C2269%2C4125\"},\"id\":\"695e45aad3cf730001d15880\",\"name\":\"Shearling\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Serving as a spiritual continuation of the now-defunct Sprain, Shearling exhibits the reunion of a now decade-old collaborative force between guitarists Alexander Kent and Sylvie Simmmons. A subsequent recruiting of percussionist Andrew Chanover, bassist Wesley Nelson, and Keyboardist Elizabeth Carver filled out their orchestrally-minded roster. The band was mostly quiet for its first year of existence, avoiding live performances to instead focus on their brazen debut ‘Motherfucker, I am Both: “Amen” and \\\"Hallelujah\\\"…’ The record retains Sprain’s characteristic commitment to intensity, further mutated through a newfound lens of collagist approach. Featuring only a single, hour-plus long song, Motherfucker is a demanding exhibition of uncompromising ethos. Shearling’s aggressive live performances and meticulous recordings demonstrate an ambition, audacity, and emotional vulnerability that few contemporary bands can parallel.\\n\\nFFO: Chat Pile / Yhwh Nailgun / Sumac / Model/Actriz / Big Brave / Divide & Dissolve / Sunn O))) / Melt-Banana / Lightning Bolt / Liturgy / Shellac / Xiu Xiu / Ken Mode\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T17:00:00+00:00\",\"sale_end_date\":\"2026-04-18T16:00:00+01:00\",\"sale_start_date\":\"2026-01-14T10:00:00+00:00\",\"event_start_date\":\"2026-04-18T19:00:00+01:00\",\"event_end_date\":\"2026-04-18T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Big Narstie\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-16/35af4f99-5ab5-4b7e-a096-05ff0a52f7ac.jpg?rect=1%2C0%2C639%2C639\"},\"artist_id\":\"949\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by 229.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":58630,\"title\":\"Venue Restoration Levy\",\"body\":\"The restoration levy is £1.20 for 229.\",\"order\":0}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"399\",\"name\":\"229\",\"address\":\"229 Great Portland St, London W1W 5PN, UK\",\"location\":{\"lat\":51.523568,\"lng\":-0.144821},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-04-28/84389ecd-ecb4-45bc-a846-5cf9964535ff.jpg?rect=180%2C0%2C838%2C838\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a