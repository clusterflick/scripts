e Watching\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5558f80e28bedb6ba01244105f609523508e8b60?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Live at Salt Shed\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-05T11:00:00+00:00\",\"sale_end_date\":\"2026-05-22T18:00:00+01:00\",\"sale_start_date\":\"2026-01-05T11:00:00+00:00\",\"event_start_date\":\"2026-05-22T19:30:00+01:00\",\"event_end_date\":\"2026-05-22T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Broadside Hacks.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/E84de92874a5?dice_id=E84de92874a5\",\"post_competition_referral\":\"https://link.dice.fm/ddd44ee983c6?dice_id=ddd44ee983c6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/H2252ed4cdd4?dice_id=H2252ed4cdd4\",\"post_purchase_referral\":\"https://link.dice.fm/Oe887de60780?dice_id=Oe887de60780\",\"post_reminder_referral\":\"https://link.dice.fm/rafd9a961743?dice_id=rafd9a961743\",\"post_waitinglist_referral\":\"https://link.dice.fm/q7b53ea4d47e?dice_id=q7b53ea4d47e\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Chris Brain is a Yorkshire-based folk singer-songwriter whose work sits firmly in the British pastoral tradition, shaped by close attention to place, memory and emotional nuance. His fourth album, Red Sun Rising (2026), is a quietly powerful collection of songs centred on yearning, restlessness and the desire for change\\n\\nRooted in acoustic textures and intimate storytelling, Red Sun Rising feels like a record made in motion: landscapes shifting, seasons turning, inner lives gently unsettled. Brain’s songwriting balances melody and restraint.\\n\\nA familiar voice on BBC Radio 6 Music and the BBC Radio 2 Folk Show, Chris Brain has toured extensively across the UK and internationally, including a seven-date sold-out tour of Japan. In 2026, he returns with a UK & Ireland tour to accompany the release of Red Sun Rising.\\n\\n“There are shades of the master Ralph McTell here and I can think of no greater compliment than that, I love It” – Mark Radcliffe, BBC 2 Folk Show\\n\\n\\\"Yorkshire singer songwriter Brain consistently impresses with his third album” - ★★★★ Daily Express\\n\\n“Contemporary folk song at its finest” - ★★★★ Songlines Magazine\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2229,\"name\":\"Broadside Hacks\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"1476463663168370\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_