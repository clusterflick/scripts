om 21st November via Second Class Mail. Please note we can only ship to the UK so sales for this event are strictly restricted to this territory.\\n\\nTicket transfer will be off for this event to avoid any shipping issues. Please purchase separate tickets if you're not planning to attend together.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/aerosmith-and-yungblud/one-more-time-ep\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's with an adult - physical photo ID required.\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-19T17:00:00+00:00\",\"sale_end_date\":\"2026-04-03T21:00:00+01:00\",\"sale_start_date\":\"2025-11-21T11:00:00+00:00\",\"event_start_date\":\"2026-04-03T18:30:00+01:00\",\"event_end_date\":\"2026-04-03T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Patience (feat. YUNGBLUD & Polo G)\",\"redirect_url\":\"https://open.spotify.com/track/1FhmdSGBoEqFLW16PlZOiZ\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/969ae64403a9358cc24b6bf8967a6671edf8c5d2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Patience (feat. YUNGBLUD & Polo G)\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Elisabeth Troy\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebea955a637fc53540d350ba64\"},\"artist_id\":\"11129\",\"about\":null,\"is_headliner\":false},{\"name\":\"Kele Le Roc\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-19/ef193f9e-900d-42f6-a71c-17e41b0f721c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"31397\",\"about\":null,\"is_headliner\":false},{\"name\":\"3 Of A Kind\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2731da92be87d4af91a6993a06b\"},\"artist_id\":\"17840\",\"about\":null,\"is_he