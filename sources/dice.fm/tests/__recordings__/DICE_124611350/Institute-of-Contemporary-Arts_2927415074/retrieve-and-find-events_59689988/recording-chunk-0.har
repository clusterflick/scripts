xtras\":true,\"perm_name\":\"nvkxd9--jehnny-beth-18th-mar-the-dome-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"15510\",\"name\":\"Fox And Firkin\",\"address\":\"316 Lewisham High Street, Lewisham, London, SE13 6JZ, United Kingdom\",\"location\":{\"lat\":51.45698,\"lng\":-0.01441},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-04/8f120254-16c6-4f38-a599-6dbc7a16c8db.jpg?rect=0%2C0%2C2363%2C2363\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fox-and-firkin-8ev7w\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/d9e66251-35a1-403b-bd72-73cef8076817.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/d9e66251-35a1-403b-bd72-73cef8076817.jpg?rect=0%2C154%2C768%2C461\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/d9e66251-35a1-403b-bd72-73cef8076817.jpg?rect=173%2C0%2C422%2C768\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769436900,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Kristina Rhodes:\\n\\nKristina Rhodes blends live ambient cello with layered, drifting loops and vocal textures. With a background as a session musician performing with artists including JADE, Wu-Lu, Charlotte Plank, Demi Lovato and more, their music carries a strong sense of space and emotion, inviting listeners into an immersive soundscape.\\n\\nPub Singer:\\n\\nPub Singer is the new incarnation of Salford born singer/songwriter Kid Cruise. With much self-reflection and re-evaluation, a new character was unlocked; an unconscious act of rebellion in some ways. Pub Singer is a more grown up, introspective yet self professedly “less concerned” song writer, with a refreshing disregard to the current musical landscape.\\n\\nMiddle Name John (EP Release Show):\\n\\nOn this special evening to celebrate the release of his upcoming EP, ‘is it the bills?’, Middle Name John will be performing with a full band. Picking up where he left off with his 2024 album on Slowfoot Records but ramping up the sonic experimentation. Middle Name John is a performing artist and writer expressing life’s uncertainty while showcasing expansive musicianship.\\n\\nDime:\\n\\nFormed in Deptford by Basile Petite, Max O’Donnell, Pete Hill &Sam Warner. Dime create ambient soundscapes, anthemic melodies and driving club beats reminiscent of the early 00’s. Having played for Artists including;\\n\\nThe Streets, Alfa Mist, Hak Baker and Nubiyan Twist, Dime utilise a range of influences in their compositions that move between genre and texture.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Fox & Firkin.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:49\",\"social_links\":{\"event_share\":\"https://link.dice.fm/I3478c056b9d?dice_id=I3478c056b9d\",\"post_competition_referral\":\"https://l