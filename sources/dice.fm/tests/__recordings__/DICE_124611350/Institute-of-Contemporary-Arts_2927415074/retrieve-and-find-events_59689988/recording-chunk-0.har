:{\"description\":\"Trip hop duo Frizzy P & Mr Cole bring their mix of old school hip-hop and jazz to Brixton\\n\\nFrizzy P is a French-born artist raised in the UK, while Mr Cole is a French-based producer. Their intimate, emotionally charged sound has helped the two artists establish themselves as increasingly important figures on the independent music scene. Expect a night of their distinctive style that adopts a smooth and passionate trip-hop-inspired groove.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hootananny Brixton.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:53\",\"social_links\":{\"event_share\":\"https://link.dice.fm/H0a7cb857791?dice_id=H0a7cb857791\",\"post_competition_referral\":\"https://link.dice.fm/L7ed3644aa3c?dice_id=L7ed3644aa3c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Me9b6e0f4b48?dice_id=Me9b6e0f4b48\",\"post_purchase_referral\":\"https://link.dice.fm/x361edfea122?dice_id=x361edfea122\",\"post_reminder_referral\":\"https://link.dice.fm/g81eba010dd7?dice_id=g81eba010dd7\",\"post_waitinglist_referral\":\"https://link.dice.fm/K08ddbd81e20?dice_id=K08ddbd81e20\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-28T18:00:00+00:00\",\"sale_end_date\":\"2026-03-18T21:30:00+00:00\",\"sale_start_date\":\"2025-11-04T18:00:00+00:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"8240\",\"name\":\"Hootananny Brixton\",\"image\":{\"url\":null},\"perm_name\":\"hootananny-brixton-yn9r\",\"profile_active\":false