ff840bbd86?dice_id=Yfff840bbd86\",\"post_waitinglist_referral\":\"https://link.dice.fm/I60562d3508a?dice_id=I60562d3508a\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":225,\"name\":\"Bad Vibrations\",\"privacy_policy_link\":\"http://www.badvibrations.co.uk/privacy-policy-mojave\",\"fb_pixel_id\":\"744309937658318\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2440,\"name\":\"The Shacklewell Arms\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"551066515482061\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:69\",\"properties\":[],\"presented_by\":\"Presented by Bad Vibrations\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765533600,\"id\":\"6936ef8372726a0001b39bd9\",\"name\":\"Le Lamb + Brain Leak + Hanna, The Big Bad Wolf\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Le Lamb** are Brighton’s wildest psychedelic alt-rock experience. Frontwoman Lady Lamb commands the stage in a lamb wool bikini and sheep skull headpiece, transforming every show into a surreal, otherworldly journey. Their music shifts from hypnotic, dreamlike textures to crashing, high-voltage energy, all anchored by raw, dramatic vocals. Every performance is a theatrical spectacle where visuals, emotion, and audience participation collide, inviting fans into a strange, unforgettable world where anything can happen.\\n\\n**Brain Leak**’s music is essentially an audio diary filled with frantic emotion, delicate sombre moments, unpredictable structures and deeply personal lyrics. She shares her experiences and introspections with hooky melodies on a bed of contrasting guitar sounds that go between soft and over-driven tones, accompanied by enigmatic bass lines and intricate drumming. The songwriter is a French/US national, Cardiff born, Manchester based artist Tara-Gabriella Engelhardt. She is backed by a band of the finest femmes; Giulia Bonometti on bass, Jessica Branney on guitar and Sidonie Hand-Halford on drums.\\n\\n**Hanna, The Big Bad Wolf** is a Ukraine-born artist weaving global influences into a haunting blend of melancholic melodies and dark, introspective lyrics. Her solo project explores duality and self-discovery through pain, heartbreak, and reflection. If you find yourself questioning every choice and overanalyzing every feeling - this music might speak to you.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ only (photo ID required)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"12\",\"name\":\"Bad Vibrations\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/dfc81b8e-e212-4b13-a954-3348aa9a856e.jpg\"},\"perm_name\":\"bad-vibrations-jqa4\",\"profile_active\":true},\"date_unix\":1772566200,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1311,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-29T11:00:00+00:00\",\"sale_end_date\":\"2026-03-03T18:00:00+00:00\",\"sale_start_date\":\"2025-10-29T11:00:00+00:00\",\"event_start_date\":\"2026-03-03T19:30:00+00:00\",\"event_end_date\":\"2026-03-03T22:45:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"oene7y-alice-costelloe-3rd-mar-sjq-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Alice Costelloe - Move On With The Year\",\"redirect_url\":\"https://open.spotify.com/track/3jGUjrKkX14hv83huun4v2\",\"artist\":\"Alice Costelloe\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6312303bc21cc1fa6e3d859c45063f9f6c479505?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Move On With The Year\"},{\"type\":\"apple_music\",\"title\":\"Alice Costelloe - Move On With The Year\",\"redirect_url\":\"https://music.apple.com/us/album/move-on-with-the-year/1844444428?i=1844444649&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Alice Costelloe\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/ba/89/3e/ba893e76-4a0a-4c65-7088-0665cd4d0921/mzaf_4095419343522893435.plus.aac.p.m4a\",\"track_name\":\"Move On With The Year\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Alice Costelloe\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-08-08/d5f73c2a-b4cf-49a8-a4ed-6ed877c1b4ef.jpg?rect=0%2C84%2C856%2C856\"},\"artist_id\":\"45365\",\"about\":{\"description\":\"*\\\"We're big fans\\\"* **LAUREN LAVERNE, BBC 6 MUSIC**\\n\\n*\\\"Soothing slice of indie-pop. The sound of an artist taking control of her creative path\\\"* **DIY MAGAZINE**\\n\\n*\\\"Fascinating...held together by the intriguing arrangement and her assured lyrical touch.\\\"* **CLASH MAGAZINE**\\n\\n*\\\"A lovely optimistic record to see us through\\\"* **STEVE LAMACQ, BBC 6 MUSIC**\\n\\n*\\\"Confessional songwriting with delicate art pop influences and spacious, synth-laden arrangements\\\"* **UNDER THE RADAR MAGAZINE**\\n\\n*\\\"I'm loving it\\\"* **CRAIG CHARLES, BBC 6 MUSIC**\\n\\n*\\\"Optimistic indie-pop gem\\\"* **DORK MAGAZINE**\\n\\n*\\\"Back out on her own and sounding amazing\\\"* **JOHN KENNEDY, RADIO X**\\n\\n*\\\"90’s indie-pop-rock soundscapes...we're obsessed\\\"* **WONDERLAND MAGAZINE**\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space