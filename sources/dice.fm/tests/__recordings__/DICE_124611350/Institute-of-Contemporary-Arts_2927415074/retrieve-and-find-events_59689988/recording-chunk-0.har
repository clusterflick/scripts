title\":\"Gigs\"}],\"about\":{\"description\":\"Kilimanjaro and Live Nation presents\\n\\nCavetown - Running With Scissors Tour\\n\\n\\\\+ Dreamer Isioma\\n\\nThis event is 14 and over. Under 16s must be accompanied by an adult.  Any ticket holder unable to present valid identification indicating that they are at least 14 years of age will not be admitted to this event and will not be eligible for a refund.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:49\",\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"presented_by\":\"Presented by Kilimanjaro & Live Nation.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cavetown\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-18/a527b83e-50dc-4bad-8572-939319ab1f6d.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"6947\",\"about\":{\"description\":\"One of Gen Z’s most prominent bedroom popstars, Cavetown’s foray into music began with a ukulele and a YouTube channel at the age of 14. Quickly becoming an online sensation, his homegrown, self-produced pop marries together floaty electronics, gentle storytelling and flourishes of acoustic indie, with Clash describing 2022’s worm food as “nothing short of masterful experimentation and thoughtful creativity”. With live shows that feel as intimate as his music, the singer – who is based in Cambridge – has sold out the Roundhouse and performed at Primavera Sound.\",\"highlights\":[]},\"is_headliner\":true},{\"name\":\"Dreamer Isioma\",\"image\":null,\"artist_id\":\"79351\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":1175,\"name\":\"Ki