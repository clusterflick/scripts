g\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:89\",\"venues\":[{\"id\":\"7609\",\"name\":\"The Lower Third\",\"address\":\"26 Denmark St, London WC2H 8NJ, UK\",\"location\":{\"lat\":51.5154881,\"lng\":-0.1291489},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-09-02/07187d0d-81c0-4ec9-96b2-d5998bd884b9.jpg?rect=0%2C0%2C3600%2C3600\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lower-third-pply\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/26962165083409-The-Lower-Third-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"The Lower Third (Up)\",\"doors_open_date\":\"2026-03-06T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"about\":{\"description\":\"R&B meets alt-pop as Swedish breakout artist Dione brings her newly released EP Heals Me to London for her first ever UK show - live on March 6. Expect a dark, immersive sound, magnetic vocals, and boundary-pushing production from one of Europe’s most exciting new names.\\n\\nAt just 20 years old, Dione has already collaborated with heavyweights like Ty Dolla Sign, Swedish House Mafia, and Boi-1da, and has quickly built serious momentum across the scene. Following her acclaimed debut EP Phases , blending R&B, hip-hop, and left-field pop - she earned a spot on Spotify’s Artists to Watch 2025, with buzz accelerating after a standout Way Out West Festival appearance alongside Yung Lean, Charli XCX, and Mk.gee.\\n\\nNow she arrives in the UK for the very first time, before heading to Oslo, Copenhagen, and Stockholm. Catch Dione in London while it’s still intimate, this is the kind of debut show people talk about after she blows up.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-12T18:00:00+00:00\",\"sale_end_date\":\"2026-03-06T19:30:00+00:00\",\"sale_start_date\":\"2026-01-12T18:00:00+00:00\",\"event_start_date\":\"2026-03-06T19:30:00+00:00\",\"event_end_date\":\"2026-03-06T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"696537248dca4900015ead9d\",\"name\":\"Dione\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-12/a814d76d-3582-4dc9-b2a1-0c8e0ce21501.jpg?rect=941%2C0%2C3890%2C3890\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-12/a814d76d-3582-4dc9-b2a1-0c8e0ce21501.jpg?rect=0%2C195%2C5833%2C3500\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-12/a814d76d-3582-4dc9-b2a1-0c8e0ce21501.jpg?rect=1847%2C0%2C2140%2C3890\"},\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":819,\"name\":\"The Lower Third\",\"privacy_policy_link\":\"https://thelowerthird.co.uk/privacy-notice/\",\"fb_pixel_id\":\"783951717556608\",\"ga_tracking_id\":\"G-ZVCKXCPJY8\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"sh