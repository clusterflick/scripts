d Kingdom\"},\"perm_name\":\"the-castle-wwpv\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-18T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Stunt Pilots\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc671c6c47609d25b4acfbd2e\"},\"artist_id\":\"72526\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lloyd John\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7b181532fbdfc7018c505f14\"},\"artist_id\":\"84864\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/8e6038de-e75f-40d5-9d4d-a3d1c2442fff.jpg?rect=0%2C0%2C1414%2C1414\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/8e6038de-e75f-40d5-9d4d-a3d1c2442fff.jpg?rect=0%2C460%2C1414%2C848\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/8e6038de-e75f-40d5-9d4d-a3d1c2442fff.jpg?rect=221%2C0%2C972%2C1767\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Lloyd John - Took It Too Far\",\"redirect_url\":\"https://open.spotify.com/track/2nJ6hsl148RgG6qaJuFdiy\",\"artist\":\"Lloyd John\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f8c6600f912a1bd44970c9cfc3984a34510e3e8e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Took It Too Far\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770803100,\"max_tickets\":10,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Hailing from Limerick, Ireland, Lloyd John emerges as a dynamic force of unbridled energy and emotion in his performance. Driven by a pursuit of evocative storytelling, Lloyd's music blends Alternative Rock paired with his glamorous performance style, leaving an indelible mark on his audience. In 2023, Lloyd embarked on his debut tour, selling out headline shows across coveted venues in Cork, Limerick and London — mesmerising audiences from barricade to the bar. This achievement cemented him as a must-see live performer, ahead of his decision to move to London. Throughout his musical evolution, Lloyd has shared stages with acclaimed acts such as Medium Build, Kingfishr, Baby Queen, Cassia and many more, honing his craft and absorbing inspiration from each collaborative encounter. Now returning to the stage for his first tour since 2023, Lloyd steps into a bold new era following over two years of intense musical development in London. The tour sees him curating immersive, high-energy nights — from a standout London headline at The Castle, Whitechapel featuring Milan-based electronic rock outfit Stunt Pilots on their UK debut, to a genre-blurring trad session interlude designed to keep the energy surging throughout the night. With a distinctive sound that defies convention and a stage presence that commands attention, Lloyd John is rapidly ascending as a beacon of talent in the music industry. As noted by Hot Press, he is “quickly becoming a rising star.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by JUKEBOX\",\"streaming_options\":null,\"impression_id\":\"7edfaa6f16d85d00:50\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Tcb947df7577?dice_id=Tcb947df7577\",\"post_competition_referral\":\"https://link.dice.fm/J07f8071fcc9?dice_id=J07f8071fcc9\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/vdfffd328a95?dice_id=vdfffd328a95\",\"post_purchase_referral\":\"https://link.dice.fm/g8827d