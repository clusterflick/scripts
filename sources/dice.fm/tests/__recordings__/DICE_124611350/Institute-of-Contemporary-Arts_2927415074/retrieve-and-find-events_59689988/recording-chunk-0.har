\":false}],\"total_artists\":10,\"total_free_texts\":0},\"faqs\":[{\"id\":54017,\"title\":\"Accessibility\",\"body\":\"For customers with disabilities wishing to book the accessible viewing areas, please visit the festival website or AXS.com\",\"order\":0},{\"id\":54020,\"title\":\"What are the gate times?\",\"body\":\"Gates Open: 14:00 – please note the gates will be open approx. 60 minutes early for the customers who select Primary Entry or VIP tickets.\",\"order\":1},{\"id\":57370,\"title\":\"What is the sustainability levy?\",\"body\":\"The Sustainability Levy is used on innovative event-power technologies, resource-intensive recycling schemes and other groundbreaking initiatives which will help move the industry towards a sustainable future.\",\"order\":2},{\"id\":57809,\"title\":\"Age restriction\",\"body\":\"16+ only. Anyone aged 16-17 must be accompanied by a parent or guardian (18 or over)\",\"order\":3}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/c0acca6a-3d8c-47da-bd0f-74d7dcece91c.jpg?rect=0%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/c0acca6a-3d8c-47da-bd0f-74d7dcece91c.jpg?rect=0%2C288%2C1440%2C864\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/c0acca6a-3d8c-47da-bd0f-74d7dcece91c.jpg?rect=324%2C0%2C792%2C1440\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763370000,\"max_tickets\":6,\"marketeers\":[{\"id\":35,\"name\":\"the Event Organiser, AEG Presents\",\"privacy_policy_link\":\"https://www.aegpresents.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Victoria Park\\n\\nTickets for this event will not be available in the DICE app. Instead, your tickets will be ready to use in the official All Points East app which is due to launch next summer. Instructions on how to download the app and access your tickets will be sent closer to the festival date.\\n\\n16+ only. Anyone aged 16-17 must be accompanied by a parent or guardian (18 or over)\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by AEG.\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:15\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Yf0da5173151?dice_id=Yf0da5173151\",\"post_competition_referral\":\"https://link.dice.fm/fd0e0d3bf7b6?dice_id=fd0e0d3bf7b6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Z2c19efc1da1?dice_id=Z2c19efc1da1\",\"post_purchase_referral\":\"https://link.dice.fm/u1bb69f4906c?dice_id=u1bb69f4906c\",\"post_reminder_referral\":\"https://link.dice.fm/Bb6d81ad4345?dice_id=Bb6d81ad4345\",\"post_waitinglist_referral\":\"https://link.dice.fm/P445bc57faae?dice_id=P445bc57faae\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T09:00:00+00:00\",\"sale_end_date\":\"2026-08-21T07:00:00+01:00\",\"sale_start_date\":\"2025-11-20T09:00:00+00:00\",\"event_start_date\":\"2026-08-22T14:00:00+01:00\",\"event_end_date\":\"2026-08-22T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":10515},\"properties\":[],\"billing_promoter\":{\"id\":\"461\",\"name\":\"AEG\",\"image\":{\"url\":null},\"perm_name\":\"aeg-4rkv\",\"profile_active\":false},\"i