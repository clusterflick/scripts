\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:62\",\"social_links\":{\"event_share\":\"https://link.dice.fm/r8edb5df9d67?dice_id=r8edb5df9d67\",\"post_competition_referral\":\"https://link.dice.fm/x543114a70ca?dice_id=x543114a70ca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g5ac4f01f3bc?dice_id=g5ac4f01f3bc\",\"post_purchase_referral\":\"https://link.dice.fm/j1afe6f0d17e?dice_id=j1afe6f0d17e\",\"post_reminder_referral\":\"https://link.dice.fm/v1d4f07d0c9e?dice_id=v1d4f07d0c9e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Pf527ebae149?dice_id=Pf527ebae149\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-29T11:00:00+00:00\",\"sale_end_date\":\"2026-04-24T20:30:00+01:00\",\"sale_start_date\":\"2026-02-02T19:00:00+00:00\",\"event_start_date\":\"2026-04-24T20:00:00+01:00\",\"event_end_date\":\"2026-04-24T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":824},\"properties\":[],\"billing_promoter\":{\"id\":\"5585\",\"name\":\"The BRIT School Limited\",\"image\":{\"url\":null},\"perm_name\":\"the-brit-school-limited-r59q\",\"profile_active\":true},\"id\":\"697b842c7b70f90001189223\",\"seats_io_event_id\":null,\"name\":\"Six\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l8bmxr-six-24th-apr-the-obie-theatre-the-brit-school-london-tickets\",\"date_unix\":1777057200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 24 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-25T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":45915,\"title\":\"What do I do if I have a question about the show or venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help.\",\"order\":0},{\"id\":45916,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"Check out our venue access info here on our website, here: https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us prior to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":45917,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries, please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":2},{\"id\":45918,\"title\":\"Can I come back in if I leave the venue during a show or event?\",\"body\":\"Unless otherwise stated all our events have a no re-admission policy.\",\"order\":3},{\"id\":45919,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-19/a1fe9f9d-3655-4519-a798-d4cb3bead068.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-19/a1fe9f9d-3655-4519-a798-d4cb3bead068.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-19/a1fe9f9d-3655-4519-a798-d4cb3bead068.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1758531600,\"max_tickets\":12,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**SATURDAY 25 APRIL / DOORS & BARS OPEN 7PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS / 18+**\\n\\n**Meet and Greet tickets available from Ticketek**\\n\\n*Clapham Grand is a palace of variety! We’ve had everything here from the filming of Magic Mike 3 to Magic Men & even Magic Dyke. This time round it’s those cheeky boys from down under. In their own words…*\\n\\nFor over 30 years, Australia’s Thunder from Down Under has been the ultimate girls’ night out! Direct from Australia, these all-Aussie heartthrobs have transformed male revue into a world-class entertainment phenomenon.\\n\\nRenowned for their high-energy routines and interactive performances, Australia’s Thunder from Down Under has built a devoted fanbase across the globe, thrilling audiences from North America to Europe, Asia, New Zealand, and beyond.\\n\\nWith multiple touring troupes performing year-round, the show’s international reach continues to grow, selling out arenas, theatres, and events in major cities worldwide. Fresh from a sell-out tour of The Netherlands and Canada to headline appearances in Macau, and a record-breaking 25-year residency in Las Vegas, Australia’s Thunder from Down Under delivers heat, charm, and excitement wherever they go, leaving fans on the edge of their seats and coming back for more.\\n\\nFor more information visit thunderfromdownunder.comIf you have any questions please scroll down to the FAQ section below.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:63\",\"social_links\":{\"event_share\":\"https://link.dice.fm/u1c1b7984078?dice_id=u1c1b7984078\",\"post_competition_referral\":\"https://link.dice.fm/I6ac6d1f4f29?dice_id=I6ac6d1f4f29\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/T73ccf053efb?dice_id=T73ccf053efb\",\"post_purchase_referral\":\"https://link.dice.fm/Ya0bde930807?dice_id=Ya0bde930807\",\"post_reminder_referral\":\"https://link.dice.fm/Jda11cc32ef1?dice_id=Jda11cc32ef1\",\"post_waitinglist_referral\":\"https://link.dice.fm/h6109c1ac517?dice_id=h6109c1ac517\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-22T10:00:00+01:00\",\"sale_end_date\":\"2026-04-25T18:30:00+01:00\",\"sale_start_date\":\"2025-09-25T09:00:00+01:00\",\"event_start_date\":\"2026-04-25T19:00:00+01:00\",\"event_end_date\":\"2026-04-25T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3787},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"68cd789d230e2d0001b9bb91\",\"seats_io_event_id\":null,\"name\":\"Thunder From Down Under\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"53a8ny-thunder-from-down-under-25th-apr-the-clapham-grand-london-tickets\",\"date_unix\":1777140000,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sat 25 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-26T17:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/c271b6d8-6bd1-4723-a9a0-fcf2945e426b.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/c271b6d8-6bd1-4723-a9a0-fcf2945e426b.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/c271b6d8-6bd1-4723-a9a0-fcf2945e426b.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1764268200,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**SUNDAY 26TH APRIL / MEET & GREET DOORS & BARS OPEN 5PM / MEET & GREET SESSION BEGINS APPROX. 5:30PM / GENERAL ADMISSION DOORS OPEN 7PM / SHOW STARTS APPROX 8PM**\\n\\n**This is a 14+ event. Under 18s must be accompanied by an adult over 21 (max. 2 under 18s per adult 21+)**\\n\\nThe Official Series Seven Tour of RuPaul’s Drag Race UK will visit venues and theatres across the country in April 2026. Expect a night of pure extravaganza as all 12 queens from Series Seven werk their way to a city near you.\\n\\nWitness the Charisma, Uniqueness, Nerve and Talent of your favourite queens live on stage.\\n\\nA pre-sale for mailing-list subscribers opens Tuesday December 2nd at 10am. Sign up at www.kikitour.co.uk\\n\\nAcclaimed for their production values, the tour promises the unexpected, featuring the full Season Seven cast: Bonnie Ann Clyde, Bones, Catrin Feelings, Chai T Grande, Elle Vosque, Nyongbella, Paige Three, Pasty, Sally TM, Silllexa Diction, Tayris Mongardi and Viola - hosted by Drag Race UK Season One star Divina De Campo.\\n\\nPresented by DDC Productions and Stefan Evans Live\\n\\nDivina De Campo, Director of DDC Productions, said:\\n\\n“This is an incredibly talented cast. I’m excited to work with them to produce something special.”\\n\\nStefan Evans, Director of Stefan Evans Live, said:\\n\\n“This tour represents six years of partnership with Divina and with the Drag Race franchise. I’m excited to show the UK what we can do.”\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must be accompanied by an adult over 21 (max. 2 under 18s per adult 21+)\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:64\",\"social_links\":{\"event_share\":\"https://link.dice.fm/la112057cae6?dice_id=la112057cae6\",\"post_competition_referral\":\"https://link.dice.fm/C46b62acab34?dice_id=C46b62acab34\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g42b8d24f741?dice_id=g42b8d24f741\",\"post_purchase_referral\":\"https://link.dice.fm/o0e67f1a492c?dice_id=o0e67f1a492c\",\"post_reminder_referral\":\"https://link.dice.fm/G7eb95bb9c1c?dice_id=G7eb95bb9c1c\",\"post_waitinglist_referral\":\"https://link.dice.fm/ue2daa77c90e?dice_id=ue2daa77c90e\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-27T18:30:00+00:00\",\"sale_end_date\":\"2026-04-26T18:45:00+01:00\",\"sale_start_date\":\"2025-12-04T10:00:00+00:00\",\"event_start_date\":\"2026-04-26T17:00:00+01:00\",\"event_end_date\":\"2026-04-26T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":\"2025-12-02T10:00:00+00:00\"},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4100},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"6928837f35bac90001256218\",\"seats_io_event_id\":null,\"name\":\"RuPaul's Drag Race UK Series 7 Live Show\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"g5kgya-rupauls-drag-race-uk-series-7-live-show-26th-apr-the-clapham-grand-london-tickets\",\"date_unix\":1777219200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sun 26 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-29T18:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/ea7017c6-16d6-43c7-b1b1-f7721124fc5b.jpg?rect=0%2C8%2C3836%2C3836\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-13/ea7017c6-16d6-43c7-b1b1-f7721124fc5b.jpg?rect=0%2C775%2C3836%2C2302\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-13/ea7017c6-16d6-43c7-b1b1-f7721124fc5b.jpg?rect=859%2C0%2C2119%2C3852\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1768384800,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**WEDNESDAY 29TH APRIL / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. 7:30PM / SHOW ENDS APPROX. 10:30PM**\\n\\n**This is an 18+ event  \\n**  \\nMove over Ember Island Players, we’re here - bigger and better - to provide a faithful(ish) recreation of Avatar: the Last Airbender!\\n\\nThe Last Hairbender is a celebration of all things ATLA and Legend of Korra - heroes, villains, fire lords, cabbage merchants - by an all-star, all-POC cast of drag & cabaret superstars and hosted by Asian drag icon Mild Peril. Dress in your finest, sip some tea (or hot leaf juice), and prepare to be wowed and/or terrified by London's best and silliest!\\n\\nAnd we do mean dress your finest, because our fabulous costume competition is back - arrive ready in costume to strut and slay and even win prizes! From kings to spirits to sky bison, we want to see them all.\\n\\nJoin us at the iconic Clapham Grand for an evening for drag, burlesque, comedy, lipsyncing, dance and more queer nerdiness!\\n\\n*Psst…it's 20 years since the first season of Avatar aired. Yes, we feel as old as you do.*\\n\\nIf you'd like to attend but ticket prices are a barrier, please get in touch at itsmemildperil@gmail.com, we'll sort you out.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:65\",\"social_links\":{\"event_share\":\"https://link.dice.fm/h27b74515792?dice_id=h27b74515792\",\"post_competition_referral\":\"https://link.dice.fm/mee9bbb61507?dice_id=mee9bbb61507\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Qf32aff0b567?dice_id=Qf32aff0b567\",\"post_purchase_referral\":\"https://link.dice.fm/Db5bc8653820?dice_id=Db5bc8653820\",\"post_reminder_referral\":\"https://link.dice.fm/tec9253f6cfc?dice_id=tec9253f6cfc\",\"post_waitinglist_referral\":\"https://link.dice.fm/p1a6b7026d84?dice_id=p1a6b7026d84\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-14T10:00:00+00:00\",\"sale_end_date\":\"2026-04-29T18:30:00+01:00\",\"sale_start_date\":\"2026-01-14T10:00:00+00:00\",\"event_start_date\":\"2026-04-29T18:30:00+01:00\",\"event_end_date\":\"2026-04-29T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2369},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"696632caed07460001f4b8eb\",\"seats_io_event_id\":null,\"name\":\"Avatar: The Last Hairbender\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb3mrg-avatar-the-last-hairbender-29th-apr-the-clapham-grand-london-tickets\",\"date_unix\":1777483800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 29 Apr\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-17T18:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-14/952ab835-b6f0-4d25-b7c2-2592d7b5ce76.jpg?rect=0%2C0%2C1024%2C1024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-14/952ab835-b6f0-4d25-b7c2-2592d7b5ce76.jpg?rect=0%2C205%2C1024%2C614\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-14/952ab835-b6f0-4d25-b7c2-2592d7b5ce76.jpg?rect=231%2C0%2C563%2C1024\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1760439600,\"max_tickets\":8,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**DOORS AND BARS OPEN 6:00PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\nThe Fringe Theatre Awards are throwing their very first annual awards ceremony on Sunday, 17th May at 19:00 – and you’re invited to the celebration!\\n\\nThis night is all about the magic, mischief, and marvels of fringe theatre. We’ll cheer, we’ll laugh, we’ll applaud – and most importantly, we’ll crown the winners of each category! It’s going to be bold, brilliant, and bursting with fringe spirit – don’t miss it!\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:66\",\"social_links\":{\"event_share\":\"https://link.dice.fm/p7a99f48f318?dice_id=p7a99f48f318\",\"post_competition_referral\":\"https://link.dice.fm/Pae28cc90a79?dice_id=Pae28cc90a79\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P11f385b497a?dice_id=P11f385b497a\",\"post_purchase_referral\":\"https://link.dice.fm/Qfad22523014?dice_id=Qfad22523014\",\"post_reminder_referral\":\"https://link.dice.fm/bfe3865ec44c?dice_id=bfe3865ec44c\",\"post_waitinglist_referral\":\"https://link.dice.fm/C30d71f0cf72?dice_id=C30d71f0cf72\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-14T12:00:00+01:00\",\"sale_end_date\":\"2026-05-17T17:45:00+01:00\",\"sale_start_date\":\"2025-10-14T12:00:00+01:00\",\"event_start_date\":\"2026-05-17T18:00:00+01:00\",\"event_end_date\":\"2026-05-17T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2799,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"68ed0305b07ec60001e547bc\",\"seats_io_event_id\":null,\"name\":\"The Fringe Theatre Awards Ceremony 2025/26\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":false,\"perm_name\":\"92x83n-the-fringe-theatre-awards-ceremony-202526-17th-may-the-clapham-grand-london-tickets\",\"date_unix\":1779037200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sun 17 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-24T14:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/52329311-56a0-4381-840a-8a1a4163f2f1.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/52329311-56a0-4381-840a-8a1a4163f2f1.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/52329311-56a0-4381-840a-8a1a4163f2f1.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763337600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"HotHaus Drag Presents: Afternoon HotHaus\\n\\nFancy spending a Sunday afternoon with us? Well for the first time ever you can! You can expect all the elements of a HotHaus show you have come to know and love but in the afternoon! So, you’ll be home in plenty of time and ready for your Monday.\\n\\nWe are also making the show a 15+ entry, under 18s to be accompanied by adults in a 1:1 ratio. You may have teenagers who would love to see a drag show or are still exploring who they are in life. Well now they’ll have a safe space to be who they want to be.\\n\\nIt will be an afternoon of feel-good fun and vibes in a relaxed, chilled atmosphere.\\n\\nDoors open 2pm – show starts 3pm\\n\\nHotHaus is a safe space for EVERYONE and EVERYONE is welcome.\\n\\nHosted by Kenzie Blackheart\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"15+ entry, under 18s to be accompanied by adults in a 1:1 ratio\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:67\",\"social_links\":{\"event_share\":\"https://link.dice.fm/sb7be5b21887?dice_id=sb7be5b21887\",\"post_competition_referral\":\"https://link.dice.fm/z1b34d197704?dice_id=z1b34d197704\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I3828a241812?dice_id=I3828a241812\",\"post_purchase_referral\":\"https://link.dice.fm/r670bc8cd8e9?dice_id=r670bc8cd8e9\",\"post_reminder_referral\":\"https://link.dice.fm/Z5e21f8e47cd?dice_id=Z5e21f8e47cd\",\"post_waitinglist_referral\":\"https://link.dice.fm/y64426a4a759?dice_id=y64426a4a759\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T00:00:00+00:00\",\"sale_end_date\":\"2026-05-24T13:00:00+01:00\",\"sale_start_date\":\"2025-11-17T00:00:00+00:00\",\"event_start_date\":\"2026-05-24T14:00:00+01:00\",\"event_end_date\":\"2026-05-24T19:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"691afd21547a4400016911fd\",\"seats_io_event_id\":null,\"name\":\"HotHaus Drag Presents: Afternoon HotHaus\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"xe7ea3-hothaus-drag-presents-afternoon-hothaus-24th-may-hot-box-chelmsford-tickets\",\"date_unix\":1779627600,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Sun 24 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-03T18:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-28/913f50b5-9384-4d02-a539-f62d1c839655.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-28/913f50b5-9384-4d02-a539-f62d1c839655.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-28/913f50b5-9384-4d02-a539-f62d1c839655.jpg?rect=243%2C0%2C594%2C1080\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1769605200,\"max_tickets\":16,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**WEDNESDAY 3RD JUNE / DOORS & BARS OPEN 6:30PM / SHOW STARTS APPROX. ONE HOUR AFTER DOORS / SHOW ENDS APPROX. 9:30PM**\\n\\n**This is a 14+ event. Under 18s must be accompanied by an adult over 21 (max. 2 U18s per 21+)**\\n\\nThe 2026 Battersea Jazz Festival will begin with a bang: A jazz ballet! The Hugo Jennings Big Band will perform original arrangements from Sergei Prokofiev's Romeo and Juliet (famous for containing the theme from The Apprentice), accompanying dancers from Battersea's very own E33 Dance Company. Expect a night of swinging music, world-class dance, and storytelling in this interpretation of one of William Shakespeare's most iconic plays and one of the most legendary ballets of the 20th Century.\\n\\nThe original ballet for Romeo and Juliet, with music by the great Russian composer Sergei Prokofiev, was first performed in the Soviet Union in 1940. This jazz re-imagining of the music will be written by Battersea Jazz Festival Founder, pianist and singer Hugo Jennings, with inspiration from jazz heroes such as Duke Ellington. The Hugo Jennings Big Band features some of the very finest musicians in British jazz, and the brand new choreography from E33 Dance Company will be performed by some of the top professional dancers in London today.\\n\\nJoin us at one of London's most iconic venues for an unforgettable night of music, dance, and storytelling.\\n\\n**If you have any questions please scroll down to the FAQ section below.**\\n\\nThis is a 14+ event. Under 18s must be accompanied by an adult over 21 (max. 2 U18s per 21+)\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Clapham Grand.\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:68\",\"social_links\":{\"event_share\":\"https://link.dice.fm/jf905e773e9f?dice_id=jf905e773e9f\",\"post_competition_referral\":\"https://link.dice.fm/G584fd5d0f59?dice_id=G584fd5d0f59\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u704b6d1554e?dice_id=u704b6d1554e\",\"post_purchase_referral\":\"https://link.dice.fm/L4545e3460d0?dice_id=L4545e3460d0\",\"post_reminder_referral\":\"https://link.dice.fm/x681cae26ddc?dice_id=x681cae26ddc\",\"post_waitinglist_referral\":\"https://link.dice.fm/U9451d56dc42?dice_id=U9451d56dc42\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-28T13:00:00+00:00\",\"sale_end_date\":\"2026-06-03T18:30:00+01:00\",\"sale_start_date\":\"2026-01-28T13:00:00+00:00\",\"event_start_date\":\"2026-06-03T18:30:00+01:00\",\"event_end_date\":\"2026-06-03T21:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1464},\"properties\":[],\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"6979fe932991e50001cdb76f\",\"seats_io_event_id\":null,\"name\":\"Romeo and Juliet in Swing - Battersea Jazz Festival\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"eo3mky-romeo-and-juliet-in-swing-battersea-jazz-festival-3rd-jun-the-clapham-grand-london-tickets\",\"date_unix\":1780507800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Wed 03 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-06-05T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/8197330f-e4e6-4ced-9ec6-8cf490038dc5.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/8197330f-e4e6-4ced-9ec6-8cf490038dc5.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/8197330f-e4e6-4ced-9ec6-8cf490038dc5.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763337600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**HotHaus Drag Presents: LipSync Wars 2 (Charity Show)**\\n\\nLipSync Wars is back bigger and fiercer than ever, with Barbra The Barber wanting to defend her title as our official LipSync Assassin.\\n\\nIt’s our charity show for 2026 with all proceeds being split evenly between the chosen charities of our incredible cast taking part, all of whom are giving their time for FREE.\\n\\nThe judges for the evening are YOU. Yes, you’ll be deciding by cheering the loudest for your winner of each round of the competition including the overall winner. So, as you can see, you’ll have a very important role to play, and we really need you there. Who will be the Official LipSync Assassin? Only you can decide.\\n\\nMAKE SURE YOU BRING A FEW EXTRA POUND COINS WITH YOU, AS WE’RE HAVING A RAFFLE TOO!\\n\\nDoors open 7pm – show starts 8pm\\n\\nHotHaus is a safe space for EVERYONE and EVERYONE is welcome.\\n\\nHosted by Kenzie Blackheart\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:69\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Dbf07fbcec05?dice_id=Dbf07fbcec05\",\"post_competition_referral\":\"https://link.dice.fm/Uee52baf3a18?dice_id=Uee52baf3a18\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g6aea5d9db6c?dice_id=g6aea5d9db6c\",\"post_purchase_referral\":\"https://link.dice.fm/p8b34f5b93d8?dice_id=p8b34f5b93d8\",\"post_reminder_referral\":\"https://link.dice.fm/Hcc1bdcf1997?dice_id=Hcc1bdcf1997\",\"post_waitinglist_referral\":\"https://link.dice.fm/q70e7956499b?dice_id=q70e7956499b\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T00:00:00+00:00\",\"sale_end_date\":\"2026-06-05T19:00:00+01:00\",\"sale_start_date\":\"2025-11-17T00:00:00+00:00\",\"event_start_date\":\"2026-06-05T19:00:00+01:00\",\"event_end_date\":\"2026-06-05T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"691c312d811cc900017bc329\",\"seats_io_event_id\":null,\"name\":\"HotHaus Drag Presents: LipSync Wars 2 (Charity Show)\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"eobomo-hothaus-drag-presents-lipsync-wars-2-charity-show-5th-jun-hot-box-chelmsford-tickets\",\"date_unix\":1780682400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 05 Jun\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-31T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/70b40e51-b99b-4fce-96df-9c84bcf9cc62.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/70b40e51-b99b-4fce-96df-9c84bcf9cc62.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/70b40e51-b99b-4fce-96df-9c84bcf9cc62.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763337600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**HotHaus Drag Presents: Haustonbury - The Festival Show**\\n\\nYou’ve heard of Glastonbury, but since it’s not taking place this year, we are giving you Haustonbury - The Festival Show. It’s our nod to this iconic event and our tribute to the incredible stars who have graced its stages over the years.\\n\\nWear your brightest festival clothes and imagine you are in a muddy field (you can even wear your wellies if you want!) You’ll almost feel like you’re there!\\n\\nYou’re going to be in for a night of festival fun, done ‘The HotHaus Way’.\\n\\nDoors open 7pm – show starts 8pm\\n\\nHotHaus is a safe space for EVERYONE and EVERYONE is welcome.\\n\\nHosted by Kenzie Blackheart\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:70\",\"social_links\":{\"event_share\":\"https://link.dice.fm/P19292175429?dice_id=P19292175429\",\"post_competition_referral\":\"https://link.dice.fm/qae7eef3f625?dice_id=qae7eef3f625\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/U2e5eb5b41c5?dice_id=U2e5eb5b41c5\",\"post_purchase_referral\":\"https://link.dice.fm/r8aab7a9f9cc?dice_id=r8aab7a9f9cc\",\"post_reminder_referral\":\"https://link.dice.fm/Q9cf605c4196?dice_id=Q9cf605c4196\",\"post_waitinglist_referral\":\"https://link.dice.fm/dd1e1b3ecbfd?dice_id=dd1e1b3ecbfd\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T00:00:00+00:00\",\"sale_end_date\":\"2026-07-31T19:00:00+01:00\",\"sale_start_date\":\"2025-11-17T00:00:00+00:00\",\"event_start_date\":\"2026-07-31T19:00:00+01:00\",\"event_end_date\":\"2026-07-31T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2200,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"id\":\"691aff49b82e4a0001be9a50\",\"seats_io_event_id\":null,\"name\":\"HotHaus Drag Presents: Haustonbury - The Festival Show\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"avevw2-hothaus-drag-presents-haustonbury-the-festival-show-31st-jul-hot-box-chelmsford-tickets\",\"date_unix\":1785520800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null}],\"title\":\"Fri 31 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-23T14:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-17/3d036774-56e7-4aba-8a15-a3c4ece494e4.jpg?rect=0%2C0%2C3500%2C3500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-17/3d036774-56e7-4aba-8a15-a3c4ece494e4.jpg?rect=0%2C700%2C3500%2C2100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-17/3d036774-56e7-4aba-8a15-a3c4ece494e4.jpg?rect=788%2C0%2C1925%2C3500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1763337600,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"HotHaus Drag Presents: Afternoon HotHaus\\n\\nFancy spending a Sunday afternoon with us? Well for the first time ever you can! You can expect all the elements of a HotHaus show you have come to know and love but in the afternoon! So, you’ll be home in plenty of time and ready for your Monday.\\n\\nWe are also making the show a 15+ entry, under 18s to be accompanied by adults in a 1:1 ratio. You may have teenagers who would love to see a drag show or are still exploring who they are in life. Well now they’ll have a safe space to be who they want to be.\\n\\nIt will be an afternoon of feel-good fun and vibes in a relaxed, chilled atmosphere.\\n\\nDoors open 2pm – show starts 3pm\\n\\nHotHaus is a safe space for EVERYONE and EVERYONE is welcome.\\n\\nHosted by Kenzie Blackheart\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"15+ entry, under 18s to be accompanied by adults in a 1:1 ratio\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"29d7bae4e57e800a:71\",\"social_links\":{\"event_share\":\"https://link.dice.fm/z945e68d42c1?dice_id=z945e68d42c1\",\"post_competition_referral\":\"https://link.dice.fm/wb8b1be2e83d?dice_id=wb8b1be2e83d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ka765031d103?dice_id=ka765031d103\",\"post_purchase_referral\":\"https://link.dice.fm/Xeabe35d43e5?dice_id=Xeabe35d43e5\",\"post_reminder_referral\":\"https://link.dice.fm/W48d9ba52eaf?dice_id=W48d9ba52eaf\",\"post_waitinglist_referral\":\"https://link.dice.fm/U6c945b247cb?dice_id=U6c945b247cb\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-17T00:00:00+00:00\",\"sale_end_date\":\"2026-08-23T13:00:00+01:00\",\"sale_start_date\":\"2025-11-17T00:00:00+00:00\",\"event_start_date\":\"2026-08-23T14:00:00+01:00\",\"event_end_date\":\"2026-08-23T19:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\