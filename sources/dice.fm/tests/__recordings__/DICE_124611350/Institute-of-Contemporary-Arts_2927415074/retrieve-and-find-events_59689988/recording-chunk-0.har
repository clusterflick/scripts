/2025-07-03/167fd842-233e-4076-a3d3-2059c62ce48f.jpg\"},\"perm_name\":\"gotobeat-qgxx\",\"profile_active\":true},\"id\":\"696e609baaf1ab0001d9c578\",\"name\":\"French Dogs live in London\",\"perm_name\":\"rynar5-french-dogs-live-in-london-20th-feb-notting-hill-arts-club-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/8aed89f4-a445-4c55-b6a1-4507eac0c2f4.jpg?rect=0%2C256%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/8aed89f4-a445-4c55-b6a1-4507eac0c2f4.jpg?rect=0%2C563%2C1536%2C922\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/8aed89f4-a445-4c55-b6a1-4507eac0c2f4.jpg?rect=205%2C0%2C1126%2C2048\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Havocks\",\"image\":null,\"artist_id\":\"108272\",\"about\":null,\"is_headliner\":false},{\"name\":\"French Dogs\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-01-26/e65939f9-bb07-4d03-9965-b841c7c37828.jpg?rect=0%2C0%2C3000%2C3000\"},\"artist_id\":\"83829\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1768841100,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1224,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T09:00:00+00:00\",\"sale_end_date\":\"2026-02-20T21:00:00+00:00\",\"sale_start_date\":\"2026-01-13T10:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:30:00+00:00\",\"event_end_date\":\"2026-02-21T03:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by All Spells\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/n98305aecd62?dice_id=n98305aecd62\",\"post_competition_referral\":\"https://link.dice.fm/occb9523d3e4?dice_id=occb9523d3e4\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/O718817d8d78?dice_id=O718817d8d78\",\"post_purchase_referral\":\"https://link.dice.fm/Y58ca0f243ae?dice_id=Y58ca0f243ae\",\"post_reminder_referral\":\"https://link.dice.fm/Jc4bfb366638?dice_id=Jc4bfb366638\",\"post_waitinglist_referral\":\"https://link.dice.fm/Oc6bbced18a1?dice_id=Oc6bbced18a1\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Promo duo All Spells bring 4 acts to The George Tavern on a Friday night.\\n\\n**The Motor Show** draw their inspiration from artists like Fat White Family, The Monks, Viagra Boys, Ennio Morricone, Tammy Wynette, and Parquet Courts. The band revs up a gritty mix of garage fuzz and backcountry twang. A late-night joyride gone wrong. Music to crash your car to. They have been featured in The Quietus, Kaltblut, and EARMILK, and championed by Emily Pilbeam on BBC Radio 6 Music and Jess Iszatt on BBC Introducing London. Known for their high-octane live shows, they've shared stages with English Teacher, Fat Dog, Ditz, and Etran de l’Aïr.\\n\\n**The Franks** have been steadily releasing singles over the past few years that show their consistent knack for truly great songwriting. With a DIY attitude combined with influences that range from obscure lo-fi 60s garage sweetness to the crippled psychedelia of The Brian Jonestown Massacre, their sound culminates in something that evokes the vulnerable melody of Galaxie 500 with the punk spirit of The Gun Club.\\n\\n**Meat Cute** is suicide cabaret, a shambling parody of male perspective. Song about joy and jizz; the rest is meat.\\n\\nOpening the bill is **Cracked Lime**, a duo who have been around since last summer and already shared stages with some of London’s best underground artists such as Spanish Horses, Henry Coke, Charlemagne and Red Ivory. Expect lively songs to dance to.\\n\\nFree badges on entry\\n\\n\\\\-\\n\\n*🍕 £1 off our pizza with this ticket!*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771615800,\"venues\":[{\"id\":\"1252\",\"name\":\"The George Tavern\",\"address\":\"373 Commercial Rd, London E1 0LA, UK\",\"location\":{\"lat\":51.51433609999999,\"lng\":-0.05291299999998955},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-george-tavern-kx88\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:30:00+00:00\",\"doors_close_date\":\"2026-02-21T03:00:00+00:00\"}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:58\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"2617\",\"name\":\"The George Tavern\",\"image\":{\"url\":null},\"perm_name\":\"the-george-tavern-xwke\",\"profile_active\":false},\"id\":\"6966c539e0f531000152b09f\",\"name\":\"All Spells: The Motor Show / The Franks / Meat Cute / Cracked Lime\",\"perm_name\":\"k6aro9-all-spells-the-motor-show-the-franks-meat-cute-cracked-lime-20th-feb-the-george-tavern-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-13/3b8e9d89-260b-4ab7-9cad-d91fcf931e6f.jpg?rect=0%2C170%2C1536%2C1536\",\"landscape\":\"https://dice-media.imgix.net