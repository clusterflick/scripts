ate\":\"2026-05-27T22:30:00+01:00\",\"sale_start_date\":\"2023-03-15T17:00:00+00:00\",\"event_start_date\":\"2026-05-27T18:00:00+01:00\",\"event_end_date\":\"2026-05-27T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Night Tales Loft.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/z5d81e478709?dice_id=z5d81e478709\",\"post_competition_referral\":\"https://link.dice.fm/z1e47583a906?dice_id=z1e47583a906\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/fac341684d68?dice_id=fac341684d68\",\"post_purchase_referral\":\"https://link.dice.fm/K28781e8a625?dice_id=K28781e8a625\",\"post_reminder_referral\":\"https://link.dice.fm/q8e344ac715c?dice_id=q8e344ac715c\",\"post_waitinglist_referral\":\"https://link.dice.fm/lf8be73e6c71?dice_id=lf8be73e6c71\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Every Wednesday, Patterns brings together some of London's finest musicians for an evening of improvised music. From Jazz to Soul, Broken-Beat to Hip Hop and beyond, our weekly jazz sessions offer a space for collaboration between musicians of all styles and flavours.\\n\\nStriving to always be inclusive and showcase the best of emerging talent; egos are always left at the door to create an intimate experience for the listeners and performers alike.\\n\\nLive music starts at 8pm. Playlist before.\\n\\nP A T T E R N S\\n\\n\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\\\_\\n\\n**ONLINE TICKETS**\\n\\n- Different ticket types are available.\\n- Please check the information on your ticket before making a purchase.\\n\\n**TABLE BOOKINGS**\\n\\n- Guarantee yourself a table by booking a table via our website ➡ www.ntloft.co.uk\\n- There are 2 sessions available:\\n\\n\\\\- Early Session = 6pm - 9pm\\n\\n\\\\- Late Session = 9:15pm - 11pm\\n\\n- If you have a table for the early session, you may be asked to leave your table for the start of the late session. You are welcome to stay and stand in the venue. Other seating will be arranged if available.\\n\\n**WALK-INS**\\n\\n- Entry is FREE before 7:30pm.\\n- Entry after 7:30pm is £5.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":99,\"name\":\"Night Tales\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/5e2aabd2b0d5c87010fb3d64/t/5e3f17972c3202581310afa8/1581193111803/BACKGROUND+CLUBS+LIMITED+PRIVACY+AND+COOKIES+STATEMENT.pdf\",\"fb_pixel_id\":\"219310887034475\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BCLUBS%2BLIMITED%2BPRIVACY%2BAND%2BCOOKIES%2BSTATEMENT.pdf\",\"fb_pixel_id\":\"1020185540161660\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1779901200,\"venues\":[{\"id\":\"2691\",\"name\":\"Night Tales Loft\",\"address\":\"207, 1 Westgate St, London E8 3RL, UK\",\"locatio