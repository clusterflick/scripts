redirect_url\":\"https://music.apple.com/us/album/your-day/1702965723?i=1702965724&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Pastel\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/99/44/19/99441963-9fe6-97c0-2f6e-c29e25a26b6d/mzaf_5765940995546522859.plus.aac.p.m4a\",\"track_name\":\"Your Day\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-13T00:00:00+00:00\",\"sale_end_date\":\"2026-03-13T21:30:00+00:00\",\"sale_start_date\":\"2025-11-18T10:00:00+00:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Rough Trade.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":true,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/R56da564b075?dice_id=R56da564b075\",\"post_competition_referral\":\"https://link.dice.fm/nc54b8921b57?dice_id=nc54b8921b57\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E839006453a1?dice_id=E839006453a1\",\"post_purchase_referral\":\"https://link.dice.fm/ica56b284780?dice_id=ica56b284780\",\"post_reminder_referral\":\"https://link.dice.fm/ec68003e0c2e?dice_id=ec68003e0c2e\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ra5744c070ee?dice_id=Ra5744c070ee\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Rough Trade East is very excited to present an in-store live performance and signing from Yonaka. This unique event celebrates the release of their new album 'Until You're Satisfied' released via Distiller Music.\\n\\nTickets for this event also include a physical copy of the fantastic new album on your format of choice to be collected from Rough Trade East on the day of the show.\\n\\nMore product information can be found HERE >> https://www.roughtrade.com/product/yonaka/until-youre-satisfied\\n\\nAccessibility:\\n\\nFor accessible tickets, free PA/Carer tickets and other accessibility requests please go to dice.fm/contact. Rough Trade is wheelchair accessible with step free access.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":88,\"name\":\"Rough Trade\",\"privacy_policy_link\":\"https://www.roughtrade.com/gb/privacy\",\"fb_pixel_id\":\"140305603371460\",\"ga_tracking_id\":\"UA-1783149-3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1773428400,\"venues\":[{\"id\":\"202\",\"name\":\"Rough Trade East London\",\"address\":\"The Old Truman Brewery, 150 Brick Lane, London E1 6QL\",\"location\":{\"lat\":51.5217064,\"lng\":-0.0722892999999658},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/07d0d459-3704-44e0-b9e6-2a2920355fb6.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"rough-trade-east-london-4bwm\",\"accessibility\":{\"url\":\"https://dice.fm/help/article?id=29038379509137\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-13T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"a49ac62417ecfc95:17\",\"tty_to_extras\":[{\"ticket_type_id\":1100456,\"extra_ids\":[\"1105649\"]},{\"ticket_type_id\":1100457,\"extra_ids\":[\"1105649\"]},{\"ticket_type_id\":1119642,\"extra_ids\":[\"1105649\"]},{\"ticket_type_id\":1119643,\"extra_ids\":[\"1105649\"]},{\"ticket_type_id\":1119644,\"extra_ids\":[\"1105649\"]},{\"ticket_type_id\":1194370,\"extra_ids\":[\"1105649\"]}],\"secondary_status\":\"waiting-list\",\"billing_promoter\":{\"id\":\"236\",\"name\":\"Rough Trade\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-22/9fc79b92-f049-4139-9903-f93a90a88363.jpg\"},\"perm_name\":\"rough-trade-jqgp\",\"profile_active\":true},\"id\":\"6915c5cc250bf000013eaf4e\",\"name\":\"Yonaka: Live + Signing\",\"perm_name\":\"av7m5x-yonaka-live-signing-13th-mar-rough-trade-east-london-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-13/451add83-3c8c-4be5-908a-9c4b9edc859c.jpg?rect=0%2C53%2C3761%2C3761\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-13/451add83-3c8c-4be5-908a-9c4b9edc859c.jpg?rect=0%2C1223%2C3761%2C2257\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-13/451add83-3c8c-4be5-908a-9c4b9edc859c.jpg?rect=588%2C0%2C2586%2C4702\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"YONAKA\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb6ec6d640fc946557b068d71f\"},\"artist_id\":\"1397\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"announcement_date_unix\":1762992000,\"faqs\":[{\"id\":57373,\"title\":\"How do I arrange a carer/PA ticket?\",\"body\":\"Free PA and Carer tickets can be added onto an existing ticket by reaching out to dice.fm/contact. If possible please request these as soon as possible after purchase of your original ticket to ensure availability. These spots are limited for sold out events.\",\"order\":0},{\"id\":57374,\"title\":\"If there is a signing at the event, can I have a photo with the artist?\",\"body\":\"We want everyone to enjoy their moment at these special intimate events. Although this is solely at the discretion of the artist or their management, there may be some cases where they don’t want photos.\",\"order\":1},{\"id\":57375,\"title\":\"Can I upgrade my CD to an LP or the other way around on the night?\",\"body\":\"Sometimes this is possible, sometimes not. It all depends on if we have extra stock on the night!\",\"order\":2},{\"id\":57376,\"title\":\"If there is a signing at the event, can I bring other stuff to get signed?\",\"body\":\"This is purely at the discretion of the artist and management.\",\"order\":3},{\"id\":57377,\"title\":\"Do you have accessible seating?\",\"body\":\"Accessible seating can be requested prior to the event through dice.fm/contact or by contacting us directly. Please note that we only have a very limited number of seats available for sold out events.\",\"order\":4},{\"id\":57378,\"title\":\"Where do I pick up my album?\",\"body\":\"When you arrive, a member of staff will scan your ticket and give you your pre-order upon entry. In some cases the album will be shipped and there will be a print to be signed instead. You won’t be able to collect the album on the way out after the event.\",\"order\":5},{\"id\":57379,\"title\":\"Is Rough Trade East London wheelchair accessible?\",\"body\":\"Rough Trade East London is wheelchair acccessible via ramp, and has an accessible toilet.\",\"order\":6},{\"id\":57380,\"title\":\"How long is the show and is there a support act?\",\"body\":\"Unless stated, there is just one set with no support, these are usually shorter than your average headline set. They’re between 30-50 minutes, playing songs from the new release or a Q&A. There is an hour between the door time and the stage time.\",\"order\":7},{\"id\":57381,\"title\":\"How do I know when it starts?\",\"body\":\"The doors and set times are listed on your DICE ticket and on the DICE event. This differs from store to store.\",\"order\":8},{\"id\":57382,\"title\":\"I don’t have a CD/Record player, can I just buy a ticket for the gig?\",\"body\":\"Unfortunately no, if general entry/free entry tickets aren’t listed there is no way to buy a ticket without an album.\",\"order\":9}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1606},\"has_multiple_ticket_types\":true,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Seize the Power\",\"redirect_url\":\"https://open.spotify.com/track/794IGyga5qnhlzOUimLOMw\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/db349c987e26b116114ae872eab787d6cd9014a5?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Seize the Power\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-23T09:00:00+01:00\",\"sale_end_date\":\"2026-03-13T15:00:00+00:00\",\"sale_start_date\":\"2025-09-26T09:00:00+01:00\",\"event_start_date\":\"2026-03-13T19:00:00+00:00\",\"event_end_date\":\"2026-03-13T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by DHP FAMILY.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/E1ba21dba471?dice_id=E1ba21dba471\",\"post_competition_referral\":\"https://link.dice.fm/leabf8b55e28?dice_id=leabf8b55e28\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Mae72efd6c92?dice_id=Mae72efd6c92\",\"post_purchase_referral\":\"https://link.dice.fm/Tfb4ab3973c4?dice_id=Tfb4ab3973c4\",\"post_reminder_referral\":\"https://link.dice.fm/N4c1