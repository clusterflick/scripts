b-af49-c6793f626785.jpg?rect=0%2C0%2C2668%2C2668\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-16/07163c81-c520-4a9b-af49-c6793f626785.jpg?rect=0%2C534%2C2668%2C1601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-16/07163c81-c520-4a9b-af49-c6793f626785.jpg?rect=601%2C0%2C1467%2C2668\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Jed6d15b459a?dice_id=Jed6d15b459a\",\"post_competition_referral\":\"https://link.dice.fm/y68c7cdde818?dice_id=y68c7cdde818\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X2f55f9b6896?dice_id=X2f55f9b6896\",\"post_purchase_referral\":\"https://link.dice.fm/j73de6c0b1fd?dice_id=j73de6c0b1fd\",\"post_reminder_referral\":\"https://link.dice.fm/b9e8b6f88e56?dice_id=b9e8b6f88e56\",\"post_waitinglist_referral\":\"https://link.dice.fm/u4f8695a15cf?dice_id=u4f8695a15cf\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:46\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1765962000,\"id\":\"69419c45f99f16000142dccc\",\"name\":\" Yttling Jazz\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"**Björn Yttling brings his Yttling Jazz project back to the stage, blending cinematic atmosphere with sharp, swinging modern jazz.**\\n\\nBest known as the bassist of Swedish indie trio Peter Bjorn and John and a producer for Lykke Li and Primal Scream, Yttling draws on influences from Charles Mingus to Brian Eno on the 2025 album Illegal Hit. The music moves between shadowed textures, bold horn lines, and restless grooves, performed by a heavyweight Swedish ensemble.\\n\\nAt the piano and Hammond organ, Yttling steers the group through tightly composed themes and open improvisation — a rare, immersive jazz set where every player is given room to stretch.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1772478000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2653,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-05T12:45:00+01:00\",\"sale_end_date\":\"2026-03-02T15:30:00+00:00\",\"sale_start_date\":\"2025-09-05T12:45:00+01:00\",\"event_start_date\":\"2026-03-02T19:00:00+00:00\",\"event_end_date\":\"2026-03-02T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"mxp62w-grandson-2nd-mar-o2-forum-kentish-town-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"grandson - Blood // Water\",\"redirect_url\":\"https://open.spotify.com/track/7clyJIrLkEbXUDwj1tC9zz\",\"artist\":\"grandson\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3bc8fde2aa82913de35f70e24aa12db04647daea?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Blood // Water\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"G