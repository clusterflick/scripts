erral\":\"https://link.dice.fm/kc5ac26de289?dice_id=kc5ac26de289\",\"post_reminder_referral\":\"https://link.dice.fm/a9c82c2f1289?dice_id=a9c82c2f1289\",\"post_waitinglist_referral\":\"https://link.dice.fm/J9c02de11fb8?dice_id=J9c02de11fb8\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by REAL\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:64\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-22T11:00:00+00:00\",\"sale_end_date\":\"2026-04-16T23:00:00+01:00\",\"sale_start_date\":\"2025-11-22T11:00:00+00:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1763809200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1400,\"sales_tax\":0,\"amount_from\":null},\"id\":\"691c522d436dd500013f987a\",\"name\":\"Ralph Heidel\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ralph Heidel\",\"image\":null,\"artist_id\":\"65595\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"oeqkpm-ralph-heidel-16th-apr-sjq-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-18/e43a0b8a-b55c-47af-8fc2-53e8a031791f.jpg?rect=0%2C977%2C2433%2C2433\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-18/e43a0b8a-b55c-47af-8fc2-53e8a031791f.jpg?rect=0%2C1085%2C2433%2C1460\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-18/e43a0b8a-b55c-47af-8fc2-53e8a031791f.jpg?rect=219%2C0%2C1996%2C3629\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"***Ralph Heidel*** \\\\- Ralph Heidel's third studio album, \\\"anyways. onto better things,\\\" is his most personal and intimate work to date, focusing on hope while not shying away from heaviness. With a wink, he bids farewell to a time when making music became a survival strategy. Heidel, who has established himself as a jazz prodigy, composer, multi-instrumentalist, and sought-after producer (including Apsilon, Casper, Finn Ronsdorf, Bazzazian), demonstrates on this album his unique ability to express emotional depth and complexity through tender, haunting melodies and a deeply sensitive production. His solo work is characterized by the interplay of analog and electronic sounds, featuring intimate piano themes and warm saxophone.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch.\\n\\n***Note: 18+ ID required.*** These events frequently sell out so we recommend buying tickets in advance.\\n\\n***Refunds:*** Tickets are for the full event and not for individual artists. If an artist cancels your tickets are still valid for the event. We cannot offer refunds.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Twat Union - Danger Boob\",\"redirect_url\":\"https://open.spotify.com/track/5bUPv6JSIXd3Aucq0J3iLF\",\"artist\":\"Twat Union\",\"preview_url\":\"https://p.scdn.co/mp3-preview/399b7ce5e2516086cbddcf272fd51445fe0150c8?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Danger Boob\"},{\"type\":\"apple_music\",\"title\":\"Twat Union - Red Flag\",\"redirect_url\":\"https://music.apple.com/us/album/red-flag/1801255530?i=1801255536&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Twat Union\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/a5/09/c3/a509c30d-4c8a-96b4-e798-68fdda5e018f/mzaf_13599680110216692528.plus.aac.p.m4a\",\"track_name\":\"Red Flag\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776362400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:00:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/b15dd732d9fa?dice_id=b15dd732d9fa\",\"post_competition_referral\":\"https://link.dice.fm/h4b036284099?dice_id=h4b036284099\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l5fee84a16c0?dice_id=l5fee84a16c0\",\"post_purchase_referral\":\"https://link.dice.fm/D7e90363208b?dice_id=D7e90363208b\",\"post_reminder_referral\":\"https://link.dice.fm/Ice15d1234d5?dice_id=Ice15d1234d5\",\"post_waitinglist_referral\":\"https://link.dice.fm/b92b2e3ef4a2?dice_id=b92b2e3ef4a2\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:65\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-03T00:00:00+00:00\",\"sale_end_date\":\"2026-04-16T19:00:00+01:00\",\"sale_start_date\":\"2025-11-03T00:00:00+00:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1762128000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1100,\"sales_tax\":0,\"amount_from\":null},\"id\":\"690885c190c2c500019ed7f3\",\"name\":\"Twat Union / Bridget.\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Twat Union\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb86fcb9990d296a2263590c06\"},\"artist_id\":\"78228\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"bbn83m-twat-union-bridget-16th-apr-hot-box-chelmsford-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-03/af441437-cd30-4345-98d4-a08bd68000b1.jpg?rect=0%2C0%2C4688%2C4688\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-03/af441437-cd30-4345-98d4-a08bd68000b1.jpg?rect=0%2C938%2C4688%2C2813\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-03/af441437-cd30-4345-98d4-a08bd68000b1.jpg?rect=1055%2C0%2C2578%2C4688\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Six-piece feminist punk outfit, ***Twat Union***, affectionately known as ‘**The Twats**’, bring their trademark, provocative humour and immersive approach to **Hot Box**. Expect original songs about thigh chafing, mansplaining and urinary tract infections.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":52777,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":52778,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":52779,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Livin' La Vida Loca - World Anthem\",\"redirect_url\":\"https://open.spotify.com/track/57S5za6Qjr59eAuyVxBRZF\",\"artist\":\"Livin' La Vida Loca\",\"preview_url\":\"https://p.scdn.co/mp3-preview/50d4a91c2fcdd5daf4e2a27cf7e946246019cf5e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"World Anthem\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776362400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-16T19:00:00+01:00\",\"doors_close_date\":\"2026-04-16T23:00:00+01:00\"}],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/Q35e72e94305?dice_id=Q35e72e94305\",\"post_competition_referral\":\"https://link.dice.fm/Sa260b1fb527?dice_id=Sa260b1fb527\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/eab3044c8589?dice_id=eab3044c8589\",\"post_purchase_referral\":\"https://link.dice.fm/Iac27292a40f?dice_id=Iac27292a40f\",\"post_reminder_referral\":\"https://link.dice.fm/f1a5ce47a671?dice_id=f1a5ce47a671\",\"post_waitinglist_referral\":\"https://link.dice.fm/u4fd137792c6?dice_id=u4fd137792c6\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by The Underworld.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:66\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-23T00:00:00+01:00\",\"sale_end_date\":\"2026-04-16T18:00:00+01:00\",\"sale_start_date\":\"2025-10-23T00:00:00+01:00\",\"event_start_date\":\"2026-04-16T19:00:00+01:00\",\"event_end_date\":\"2026-04-16T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1761174000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1515,\"sales_tax\":0,\"amount_from\":null},\"id\":\"68fa36c4dbed63000101bc9f\",\"name\":\"GYPSY PISTOLEROS\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Continental Lovers\",\"image\":null,\"artist_id\":\"27467\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gypsy Pistoleros\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebcbe3a83c7908066c7544dbec\"},\"artist_id\":\"40449\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":3},\"new\":false,\"seating\":null,\"perm_name\":\"av7gwq-gypsy-pistoleros-16th-apr-the-underworld-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-23/3d18af80-ea75-4939-b457-89a1e0149fb4.jpg?rect=661%2C0%2C1544%2C1546\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-23/3d18af80-ea75-4939-b457-89a1e0149fb4.jpg?rect=212%2C0%2C2577%2C1546\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-23/3d18af80-ea75-4939-b457-89a1e0149fb4.jpg?rect=1075%2C0%2C850%2C1546\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"The world’s only Glam Punk Goth ’n’ Roll outlaws return with their most ambitious and eclectic album yet — Dark Faerie Tales, out April 17th, 2026 on The New Church Records / Plastichead Distribution. Available worldwide & instore on three-colour vinyl, digipak CD, and digital. Accompanied by the announcement of initial U.K 2026 Tour dates to back the release!\\n\\nFollowing the success of Church of the Pistoleros — hailed as one of 2025’s most fearless and eclectic rock albums — the Pistoleros have conjured something even bolder: a dark fairytale for the damned, a love letter to the beautiful and broken, and a twisted hymn for the strange of heart.\\n\\nBorn from the fires of their own mythology, Dark Faerie Tales drifts through haunted woods and neon dreams — where sleaze-drenched punk anthems meet gothic grandeur, and glam swagger burns with outlaw soul. Produced and co-written once again by sonic alchemist Dave Draper (Michael Monroe, Ginger Wildheart, The Wildhearts, Ryan Hamilton, Elvana, Therapy, etc), it’s a record that breathes rebellion and myth\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"In Case I Fall for You\",\"redirect_url\":\"https://open.spotify.com/track/2qz7KoWTLGuWuIfwqZmk4y\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a80fa08e163d198f8be1386f55e2c5e2870f5933?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"In Case I Fall for You\"},{\"type\":\"apple_music\",\"title\":\"Black Sea Dahu - The Core\",\"redirect_url\":\"https://music.apple.com/gb/album/the-core/1426272899?i=1426273513&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Black Sea Dahu\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview118/v4/8c/cd/19/8ccd19d0-b3b5-c982-9b30-a2f32eaa8b27/mzaf_3563044839660202317.plus.aac.p.m4a\",\"track_name\":\"The Core\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776362400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500