ll,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1772047800,\"has_multiple_ticket_types\":false,\"impression_id\":\"4699078e3c3acde4:48\",\"price\":{\"currency\":\"GBP\",\"amount\":700,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-11/9a9339d9-890c-407c-81c6-3d327208a53c.jpg?rect=0%2C1745%2C8500%2C8500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-11/9a9339d9-890c-407c-81c6-3d327208a53c.jpg?rect=0%2C2805%2C8500%2C5100\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-11/9a9339d9-890c-407c-81c6-3d327208a53c.jpg?rect=1305%2C0%2C5891%2C10710\"},\"id\":\"6965578e097f7e0001c567d5\",\"name\":\"Long Distance Runner Residency #4\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Too Bright to See presents:\\n\\na residency with Long Distance Runner\\n\\n4th of the Series with Maiden & studio20\\n\\nNoise meets ambience, post-rock colliding with film-scores, Long Distance Runner are an instrumental four-piece from London. Melodic distortion, chiming guitar riffs, spiralling drum patterns, and moments of gentle calm build up emotional tension, before releasing in cathartic moments of calm and chaos. (https://www.instagram.com/longdistancerunner___/)\\n\\nMaiden are a London based 4 piece, their work delicately balances searching reflection and forward-thinking experimentation. Elements of avant-pop, dream-pop are abstracted through gothy atmospheres and reimagined through unsettled cityscapes. (https://www.instagram.com/_maiden____/)\\n\\nstudio20 is a band operating from the Kent countryside. They blur electronics, alt-pop hooks and emo’s raw nerve endings, leaving a sticky, sonic residue. Unwilling to be categorised, their gravitational sound pulls you in and keeps you stuck. (https://www.instagram.com/studio20.archive/)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-13T10:00:00+00:00\",\"sale_end_date\":\"2026-02-25T22:00:00+00:00\",\"sale_start_date\":\"2026-01-13T10:00:00+00:00\",\"event_start_date\":\"2026-02-25T19:30:00+00:00\",\"event_end_date\":\"2026-02-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Lower Slaughter\",\"image\":null,\"artist_id\":\"5565\",\"about\":null,\"is_headliner\":false},{\"name\":\"Handcuff\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-01-29/7e7fd2f0-3d94-4219-856a-51cb049c7d45.jpg?rect=201%2C0%2C1199%2C1199\"},\"artist_id\":\"64773\",\"about\":null,\"is_headliner\":false},{\"name\":\"Incaseyouleave\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-03-01/22bdeead-fbd2-47ea-aaf2-cb65b662c11a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"34353\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Diminishing Returns.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"37\",\"name\":\"The Old Blue Last\",\"address\":\"38 Great Eastern Street, London EC2A 3ES\",\"location\":{\"lat\":51.5245266,\"lng\":-0.0806281999999783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"per