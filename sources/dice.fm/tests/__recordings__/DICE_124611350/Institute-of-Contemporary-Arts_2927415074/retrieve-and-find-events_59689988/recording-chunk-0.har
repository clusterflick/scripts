cked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/6d782998-f38c-4d70-9629-079896557357.jpg?rect=80%2C0%2C896%2C896\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/6d782998-f38c-4d70-9629-079896557357.jpg?rect=0%2C88%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/6d782998-f38c-4d70-9629-079896557357.jpg?rect=354%2C0%2C493%2C896\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Greyhounds - B Sizzle\",\"redirect_url\":\"https://music.apple.com/us/album/b-sizzle/1832174417?i=1832174636&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Greyhounds\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/c9/2d/67/c92d675b-a190-cc60-b77d-a97a6bc2b5d0/mzaf_9075389542720371761.plus.aac.p.m4a\",\"track_name\":\"B Sizzle\"},{\"type\":\"spotify\",\"title\":\"Greyhounds - B Sizzle\",\"redirect_url\":\"https://open.spotify.com/track/4QPe1u3OM3wUHs5jLDG5xq\",\"artist\":\"Greyhounds\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e7ebe4278aba2823942810e015ed59abd1e6a674?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"B Sizzle\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1769166000,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"***Greyhounds -*** Rising out of the Austin, Texas music scene, the Greyhounds, a duo comprising guitarist Andrew Trube and keyboardist Anthony Farrell, feature a unique sound that mixes R&B, soul, funk, and the Bakersfield country of Buck Owens into a style that has been described as \\\"Hall & Oates meets ZZ Top,\\\" and the duo's exciting live shows have earned them a large and loyal fan following. The pair met in the late '90s, and immediately began writing and playing together, placing tunes with artists like Susan Tedeschi and Derek Trucks while building up a songwriting catalog and gathering new fans with each show.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by REAL\",\"streaming_options\":null,\"impression_id\":\"e551cd9f216396a3:29\",\"social_links\":{\"event_share\":\"https://link.dice.fm/x949e1f9eef8?dice_id=x949e1f9eef8\",\"post_competition_referral\":\"https://link.dice.fm/M83c458bbdb6?dice_id=M83c458bbdb6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/rdfe95d7a191?dice_id=rdfe95d7a191\",\"post_purchase_referral\":\"https://link.dice.fm/T1aa4d944a3d?dice_id=T1aa4d944a3d\",\"post_reminder_referral\":\"https://link.dice.fm/S22b80e1c833?dice_id=S22b80e1c833\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ge7b479950d4?dice_id=Ge7b479950d4\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T11:00:00+00:00\",\"sale_end_date\":\"2026-08-29T23:00:00+01:00\",\"sale_start_date\":\"2026-01-30T11:00:00+00:00\",\"event_start_date\":\"2026-08-29T19:00:00+01:00\",\"event_end_date\":\"2026-08-29T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2402,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"id\":\"69676e7d802098000167ffef\",\"seats_io_event_id\":null,\"name\":\"Greyhounds\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"7d