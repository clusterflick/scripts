\"https://link.dice.fm/gef34b9e5848?dice_id=gef34b9e5848\",\"post_reminder_referral\":\"https://link.dice.fm/q123116e2597?dice_id=q123116e2597\",\"post_waitinglist_referral\":\"https://link.dice.fm/wb5bd1334941?dice_id=wb5bd1334941\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":627,\"name\":\"Colours\",\"privacy_policy_link\":\"https://colourshoxton.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:40\",\"properties\":[],\"presented_by\":\"Presented by Colours.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1760310000,\"id\":\"690340b84258ce0001c4781a\",\"name\":\"Opal Ocean\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Opal Ocean is an Australian acoustic duo redefining what two guitars can do. Blending elements of flamenco, rock, and progressive music, Alex Champ and Nadav Tabak craft a sound that’s both technically impressive and deeply expressive.\\n\\nTheir breakout single, J.A.M., resonated across the globe, quickly gaining millions of views and establishing their unique voice in the instrumental music scene. Since then, they’ve continued to evolve, building a loyal international following through dynamic live performances and genre-blending compositions.\\n\\nFrom intimate venues to major festivals, Opal Ocean has taken their music to audiences around the world, touring across Australia, Europe, Canada, and beyond. Along the way, they’ve shared stages with renowned artists, collaborated with industry icons like Jordan Rudess of Dream Theater, and released a series of albums and EPs that highlight their musical range and creative depth.\\n\\nWhether in the studio or on stage, Opal Ocean delivers an immersive experience—rhythmic, melodic, and full of energy. With new music in the works and a growing global presence, Alex and Nadav continue to push the boundaries of acoustic sound while staying true to their roots.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"99\",\"name\":\"Colours Hoxton\",\"image\":{\"url\":null},\"perm_name\":\"colours-hoxton-zl3w\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":2287,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":false,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-22T11:00:00+01:00\",\"sale_end_date\":\"2026-03-07T14:00:00+00:00\",\"sale_start_date\":\"2025-10-24T10:00:00+01:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"l8geqw-terno-rei-7th-mar-the-courtyard-theatre-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Solidão de Volta\",\"redirect_url\":\"https://open.spotify.com/track/5JDL8Z21Du2vvBB1NU3Atj\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d0c93d61f0d5d29109d62118b46f2970a8e88e92?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Solidão de Volta\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Terno Rei\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb5b50950f4987d00ae9a9215d\"},\"artist_id\":\"64903\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"27\",\"name\":\"The Courtyard Theatre\",\"address\":\"Bowling Green Walk, 40 Pitfield St, London N1 6EU\",\"location\":{\"lat\":51.5279204,\"lng\":-0.0833459000000403},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-courtyard-theatre-zl8w\",\"accessibility\":{\"url\":\"https://thecourtyard.org.uk/location-and-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-07T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-21/7c59df8c-3e5a-41cb-9a8f-abdebced3114.jpg?rect=0%2C150%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-21/7c59df8c-3e5a-41cb-9a8f-abdebced3114.jpg?rect=0%2C390%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-21/7c59df8c-3e5a-41cb-9a8f-abdebced3114.jpg?rect=188%2C0%2C825%2C1500\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/t70f4593e5b7?dice_id=t70f4593e5b7\",\"post_competition_referral\":\"https://link.dice.fm/s4a3ca67d059?dice_id=s4a3ca67d059\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V470835a0ed3?dice_id=V470835a0ed3\",\"post_purchase_referral\":\"https://link.dice.fm/u7dec82780c3?dice_id=u7dec82780c3\",\"post_reminder_referral\":\"https://link.dice.fm/B40e941a38f4?dice_id=B40e941a38f4\",\"post_waitinglist_referral\":\"https://link.dice.fm/J15a3870eb59?dice_id=J15a3870eb59\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":25,\"name\":\"The Courtyard Theatre\",\"privacy_policy_link\":\"http://www.thecourtyard.org.uk/content/16/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:41\",\"properties\":[],\"presented_by\":\"Presented by Kilimanjaro.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1761127200,\"id\":\"68f88e9495037c00010d91b2\",\"name\":\"Terno Rei\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Kili Presents:\\n\\nTerno Rei\\n\\nTerno Rei has become one of the leading names in contemporary Brazilian alternative music over the last decade. With confessional lyrics that span generations, coupled with a unique sound that straddles genres like dream pop, post-punk, and alternative rock, the quartet has become a reference for its captivating sensitivity and melancholy. Formed in São Paulo in 2010, the group consists of Ale Sater (vocals and bass), Bruno Paschoal (guitar, vocals, and synthesizers), Greg Maya (guitar and synthesizers), and Luis Cardoso (drums and vocals).\\n\\nTheir fifth record Nenhuma Estrela was released in 2025 through Balaclava Records, produced by Gustavo Schirmer and mixed by Nicolas Vernhes, who has worked with names such as The War on Drugs, Wild Nothing and Deerhunter.\\n\\nNenhuma Estrela showcases a mature synthesis of the influences and sounds that have marked the band's trajectory over the past ten years, while simultaneously proposing innovations, reflecting a period of evolution for the group. These songs are melancholic and introspective, accompanied by an atmosphere and musical aesthetic typical of the 80s and 90s, characterized by guitar riffs and synthesizer arrangements that create a soundscape. The band offers an ode to 90s alternative music, with nods to trip hop, acoustic ballads and soft pop, with nocturnal tones, influenced by 80s groups such as Blue Nile and Prefab Sprout.\\n\\nThe record also features a special guest appearance by Lô Borges from Clube da Esquina on \\\"Relógio\\\". A refined vocal melody, intertwined with slightly psychedelic guitar arrangements, which evokes the universe created by the Minas Gerais composer in his classic collective band. In Nenhuma Estrela, Terno Rei presents itself in its most mature phase, both in aesthetics and compositions, and offers an album that is, at the same time, introspective and expansive.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (Under 16’s to be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"91\",\"name\":\"Kilimanjaro\",\"image\":{\"url\":null},\"perm_name\":\"kilimanjaro-43px\",\"profile_active\":false},\"date_unix\":1772910000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1418,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-16T12:30:00+01:00\",\"sale_end_date\":\"2026-03-07T18:30:00+00:00\",\"sale_start_date\":\"2025-10-16T12:30:00+01:00\",\"event_start_date\":\"2026-03-07T19:00:00+00:00\",\"event_end_date\":\"2026-03-07T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"av7oyq-matthew-c-whitaker-henge-shunya-7th-mar-moth-club-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Matthew C. Whitaker - Feud\",\"redirect_url\":\"https://open.spotify.com/track/4pqK2gD3yNzSvbRSpdPCpA\",\"artist\":\"Matthew C. Whitaker\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f748b5671a02ab0c58b51f42fb37175cfd17545a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Feud\"},{\"type\":\"apple_music\",\"title\":\"Matthew C. Whitaker - Feud\",\"redirect_url\":\"https://music.apple.com/us/album/feud/1828415908?i=1828416301&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Matthew C. Whitaker\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/99/f5/47/99f547e6-05dd-62f3-ec01-f0129ee5d62a/mzaf_815898568113639279.plus.aac.p.m4a\",\"track_name\":\"Feud\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":false,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Matthew C. Whitaker\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-11/1d5d1cb1-f792-43f1-a923-67f195a8737f.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"128675\",\"about\":null,\"is_headliner\":false},{\"name\":\"SHUNYA\",\"image\":null,\"artist_id\":\"30430\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"43\",\"name\":\"MOTH Club\",\"address\":\"Old Trades Hall, Valette Street, London E9 6NU\",\"location\":{\"lat\":51.5450825,\"lng\":-0.0546326999999565},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2