n\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"London-based composer, producer, and singer Lauren Auder returns with “yes”, her first release since 2023 — a euphoric love song co-produced with dviance and Alex Parish. Blending house-influenced pianos, Madchester-inspired grooves, and tightly delivered lyricism, the track captures the rush and tumbling sensation of falling in love. Following her critically acclaimed debut album the infinite spine and collaborations with Caroline Polachek, Celeste, and Vegyn, Auder continues to expand her baroquely orchestrated pop universe — one that bridges classical, post-rock, and experimental sounds with raw emotional clarity.\\n\\nTo mark this new chapter, FIGURA is inviting Lauren to a special live show, offering audiences an intimate first glimpse into her next era.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:17\",\"billing_promoter\":{\"id\":\"139313\",\"name\":\"FIGURA\",\"image\":{\"url\":null},\"perm_name\":\"figura-rly8q\",\"profile_active\":false},\"presented_by\":\"Presented by FIGURA.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_art