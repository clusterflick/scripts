456\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-29/f9c3c63a-4e3a-4701-8968-aa19b3561cd1.jpg?rect=0%2C173%2C5184%2C3110\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-29/f9c3c63a-4e3a-4701-8968-aa19b3561cd1.jpg?rect=1642%2C0%2C1901%2C3456\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"DBA!\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-22/18d9d1f8-6200-4f1c-97b2-d74f69905140.jpg?rect=0%2C0%2C1080%2C1080\"},\"artist_id\":\"129271\",\"about\":{\"description\":\"DBA! emerged from the gritty underbelly of Liverpool’s music scene in early 2024. A band of misfits and odd parts that somehow crashed together and clicked into place. DBA! was birthed in a DIY demo studio tucked into the literal basement drain of a Liverpool nightclub. The damp and unorthodox space - rented in defiance of skeptical glances from peers - became a safe space where late night sessions gave way to the creation of their sound, blending 90s alternative rock, garage rock and indie, drawing from bands such as Eels, Pavement, The Breeders, Elastica and Beck.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1769767200,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"DBA! - D.P.D.\",\"redirect_url\":\"https://music.apple.com/us/album/d-p-d/1802090758?i=1802090759&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"DBA!\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/2a/d1/28/2ad128bd-d32f-a2a5-f084-4415b95029b4/mzaf_16065973765574846077.plus.aac.p.m4a\",\"track_name\":\"D.P.D.\"},{\"type\":\"spotify\",\"title\":\"DBA! - D.P.D.\",\"redirect_url\":\"https://open.spotify.com/track/6rkRiK5K8zh1PL3yKHHU1n\",\"artist\":\"DBA!\",\"preview_url\":\"https://p.scdn.co/