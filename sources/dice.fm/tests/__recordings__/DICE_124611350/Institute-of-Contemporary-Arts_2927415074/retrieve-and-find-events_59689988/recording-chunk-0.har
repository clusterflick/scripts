e/1745489453?i=1745490500&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ishmael Ensemble\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/7e/e6/76/7ee6768d-8a5f-b0af-9c01-58d38190f1a8/mzaf_16688186660691715168.plus.aac.p.m4a\",\"track_name\":\"In Time\"},{\"type\":\"spotify\",\"title\":\"Ishmael Ensemble - In Time\",\"redirect_url\":\"https://open.spotify.com/track/6ax631gOV5ElXjydAFwTDu\",\"artist\":\"Ishmael Ensemble\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e0fd5decf0d16281d4679b2bb174592168811105?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"In Time\"}],\"faqs\":[{\"id\":47034,\"title\":\"What are the age restrictions?\",\"body\":\"This is a 16+ event. All attendees 16-17s must be accompanied by a responsible adult who is 18 or older (1:1 ratio). To verify age, ID may be requested. We advise all customers to bring valid ID. For further information, see Age and ID in FAQs. Right of admission reserved.\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Earth Cruises.\",\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"date_unix\":1778349600,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":false,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"highlights\":[],\"profile_active\":true,\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-05-09T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:42\",\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nIshmael Ensemble returns to London in May 2026 for a special one-off performance at EartH, Hackney, joined by The Rituals Orchestra and a host of guest vocalists.\\n\\nFollowing the acclaimed release of their 2024 album Rituals and an extensive tour across the UK, Europe & Australia, bandleader Pete Cunningham expands on the ideas first explored in the recording studio. For the album sessions, Cunningham assembled a unique combination of harp, string & horn players to create lush, cinematic textures; now brought to life on stage alongside guest vocalists, the forming of The Rituals Orchestra has offered an opportunity to re-interpret music from the entire Ishmael Ensemble back catalogue in a new and exciting way.\\n\\nEarlier this year, Cunningham unveiled the expanded live project with a performance captured at Bristol’s iconic Mouth Without venue. Released as a short film on YouTube, the collaboration was met with widespread praise, showcasing Ishmael Ensemble at their most ambitious.\\n\\nThe project made its live debut at Forwards Festival in Bristol, where it captivated festivalgoers and sparked calls from fans for more opportunities to experience this unique performance. Responding to that demand, Ishmael Ensemble has announced a one-off headline show in London, offering audiences a chance to witness the full force of The Rituals Orchestra in an intimate setting.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1758790800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ishmael Ensemble\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc2f2d55d56e71b7022ec3b3b\"},\"artist_id\":\"127825\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-24/57abdecd-0341-484d-af67-5acd80e10038.jpg?rect=420%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-24/57abdecd-0341-484d-af67-5acd80e10038.jpg?rect=60%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-24/57abdecd-0341-484d-af67-5acd80e10038.jpg?rect=663%2C0%2C594%2C1080\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"68d4259a9d0b970001533aba\",\"name\":\" Ishmael Ensemble with Rituals Orchestra\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-2