nix\":1783965600,\"price\":{\"currency\":\"GBP\",\"amount\":1320,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/f948c6601e74?dice_id=f948c6601e74\",\"post_competition_referral\":\"https://link.dice.fm/S915280a6d0c?dice_id=S915280a6d0c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/K602cdedb043?dice_id=K602cdedb043\",\"post_purchase_referral\":\"https://link.dice.fm/P449eb191658?dice_id=P449eb191658\",\"post_reminder_referral\":\"https://link.dice.fm/ja4d0f479612?dice_id=ja4d0f479612\",\"post_waitinglist_referral\":\"https://link.dice.fm/L4d5d6d7c6c5?dice_id=L4d5d6d7c6c5\"},\"perm_name\":\"g5mo8a-the-next-agenda-13th-jul-hot-box-chelmsford-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/ab92db21-40ce-450b-9156-7ad28bae617d.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/ab92db21-40ce-450b-9156-7ad28bae617d.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/ab92db21-40ce-450b-9156-7ad28bae617d.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Born out of the ashes of the apocalypse, The Next Agenda serve up a noisy uptight raucous sound inspired the great late 60’s bands like The Open Mind, Fire, The 13th Floor Elevators and early Pink Floyd.\\n\\nIn your face guitar from Jason How and a super tight rhythm section wraps around poignant socially conscious lyrics that ooze melody and harmony.\\n\\nSinging about population bombs and Sidcup station you won’t forget the lyrics in a hurry…\\n\\nThe Next Agenda are proud to have supported the Buzzcocks at The Forum in Tunbridge Wells last year and also have recently had word from JJ Burnel of The Stranglers that they will be supporting them at some stage when they return to the UK….\\n\\n‘Seriously, this is top stuff’ – *Captain Sensible*\\n\\n‘This is kick ass Garage Rock. Great songwriting, Great tones and a killer band’ – *Duff McKagan*\\n\\n‘Kick ass sound’– *James LoMenzo – Megadeth*\\n\\n‘Garage Music is alive and not just well, but bloody great, thanks to The Next Agenda. If you liked Lenny Kaye’s ‘Nuggets’ records you’ll like this. I loved ‘Nuggets’ and I love this!’ *– Jake Burns – Stiff Little Fingers*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6981385853a2670001749a52\",\"name\":\"The Next Agenda\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Next Agenda\",\"image\":null,\"artist_id\":\"133457\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Mon 13 Jul\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-26T17:00:00+00:00\",\"sale_end_date\":\"2026-07-13T09:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-07-14T19:00:00+01:00\",\"event_end_date\":\"2026-07-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":70602,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":70603,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":70604,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":70605,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"marketeers\":[{\"id\":1175,\"name\":\"Kilimanjaro Live Limited\",\"privacy_policy_link\":\"https://myticket.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":\"29fc7159-e6e6-4eb1-964b-d90e06ade036\",\"presented_by\":\"Presented by Action!\",\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"29fc7159-e6e6-4eb1-964b-d90e06ade036\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"enabled\"},\"announcement_date_unix\":1769446800,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url