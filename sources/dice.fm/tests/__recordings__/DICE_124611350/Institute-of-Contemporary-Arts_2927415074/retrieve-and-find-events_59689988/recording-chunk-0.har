_id=cc1a6b3bad9e\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"504\",\"name\":\"The Stags Head\",\"address\":\"55 Orsman Rd, London N1 5RA\",\"location\":{\"lat\":51.5364126,\"lng\":-0.0808194999999614},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-stags-head-zk5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-21T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"***Blame Caesar -*** Real Sounds are delighted to welcome back Blame Caesar. The Bedfordshire boys have become known for their emotionally charged high octane indie anthems, and polished live sets. Not to be missed.\\n\\n***Carousel -*** With influences ranging from 70's psychedelia to modern experimental rock, Carousel delivers a sonic experience that is both nostalgic and cutting-edge.\\n\\n**Smoking Ocean** - is a four-piece alt-rock band making waves with big hooks, raw energy, and a sound that keeps evolving. Frontman Luca leads the charge alongside Aaron on lead guitar, Liam on bass and Mat on drums.They’ve honed a sound that’s equal parts emotional and explosive—gritty verses, soaring choruses, and melodies that stick. Not chasing trends, Smoking Ocean is driven by a shared passion to create music that’s honest, loud, and real. With new tracks on the horizon and live shows ramping up, the band is just getting started.\\n\\n**Local Man** \\\\- Hailing from North London, Local Man deal in familiar sounds - Warm like a cheap bitter, cool like the milk in a Tetley’s, and just as necessary. Made for damp pavements and midweek pints. Support your local.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch at info@realsounds.uk.\\n\\n***Refunds:*** Tickets are for the full event and not for individual artists. If an artist cancels your tickets are still valid for the event. We cannot offer refunds.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:89\",\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"presented_by\":\"Presented by REAL\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Carousel\",\"image\":null,\"artist_id\":\"94215\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":3},\"marketeers\":[],\"announcement_date_unix\":1764586800,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-01T11:00:00+00:00\",\"sale_end_date\":\"2026-03-21T23:00:00+00:00\",\"sale_start_date\":\"2025-12-01T11:00:00+00:00\",\"event_start_date\":\"2026-03-21T19:00:00+00:00\",\"event_end_date\":\"2026-03-21T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"692db8f58bd4dc0001647f4c\",\"name\":\"Blame Caesar, Carousel, Smoking Ocean. Local Man\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"BLAME CAESAR - Chrysalis\",\"redirect_url\