1766\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ella Raphael\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1fe5cfe3863ee40e70fa6125\"},\"artist_id\":\"102995\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1765455300,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":618,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ella Raphael - Tangled Love\",\"redirect_url\":\"https://open.spotify.com/track/4SRLIrLAf1GWlHP1nZT3Ar\",\"artist\":\"Ella Raphael\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ea51eabba284fd4ebda3730d174f18e897e06c67?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Tangled Love\"},{\"type\":\"apple_music\",\"title\":\"Ella Raphael - Tangled Love\",\"redirect_url\":\"https://music.apple.com/us/album/tangled-love/1753056829?i=1753057172&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ella Raphael\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/cd/ca/14/cdca14f4-65b4-9e55-f9e5-ed9d9f7b593f/mzaf_4475574336673880299.plus.aac.p.m4a\",\"track_name\":\"Tangled Love\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null}],\"title\":\"Thu 26 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-28T19:00:00+00:00\",\"sale_end_date\":\"2026-11-27T17:00:00+00:00\",\"sale_start_date\":\"2025-11-28T19:00:00+00:00\",\"event_start_date\":\"2026-11-27T17:00:00+00:00\",\"event_end_date\":\"2026-11-27T21:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by The Clapham Grand.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/Za59843b0626?dice_id=Za59843b0626\",\"post_competition_referral\":\"https://link.dice.fm/H426a3995f5f?dice_id=H426a3995f5f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Dcf3636b7c6f?dice_id=Dcf3636b7c6f\",\"post_purchase_referral\":\"https://link.dice.fm/y93dec4d891b?dice_id=y93dec4d891b\",\"post_reminder_referral\":\"https://link.dice.fm/g4d3feaef242?dice_id=g4d3feaef242\",\"post_waitinglist_referral\":\"https://link.dice.fm/r1e6e743639f?dice_id=r1e6e743639f\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**FRIDAY 27TH NOVEMBER / DOORS & BARS OPEN 6PM / SHOW STARTS APPROX. 1 HOUR AFTER DOORS**\\n\\n**This is an 18+ event**\\n\\nIndiepalooza is an amazing touring indie-rock tribute festival featuring leading tributes to the Killers, Arctic Monkeys, Oasis and Sam Fender, all on night. This has sold out 1000 cap+ venues all over the country and in it’s 4th year.\\n\\nThe Kopycat Killers, Oasis 96, Scam Fender and Sub-Arctic Monkeys are some of the best tributes in the world, playing huge festivals both in the UK and abroad to thousands and thousands, now all coming together on this special touring festival show.\\n\\n“This. Is. Great. He is selling out all over the UK!” - Chris Moyles, Radio X\\n\\n“This is Great. He does sound great to be fair!” - Greg James, Radio 1\\n\\n4 HOURS OF WALL TO WALL BANGERS ALL NIGHT!!! - Expect Mr Brightside, Don’t Look Back In Anger, Seventeen Going Under, I Bet That You Look Good On The Dancefloor, Hypersonic Missiles, Somebody Told Me, Wonderwall, Mardy Bum, Human, When You Were Young, Will We Talk?, Do I Wanna Know, Supersonic, All These Things That I’ve Done, She’s Electric, Why’d You Only Call Me When You’re High, Cigarettes and Alcohol, Read My Mind, Florescent Adolescent, Glamorous Indie Rock N Roll, R U Mine?, Smile Like You Mean It, Spit Of You, 505, Getting Started, Snap Out Of It, Some Might Say, People Watching and many more!\\n\\nWebsites - http://thekopycatkillers.com // http://scamfender.com // http://subarcticmonkeys.com\\n\\nInstagram - http://instagram.com/thekopycatkillerstribute // http://instagram.com/scamfender // http://instagram.com/subarcticmonkeystribute // http://instagram.com/oasis96tribute\\n\\n\\\\-- \\\"Best tribute band I've ever seen, and I've photographed hundreds\\\" D.Cowley\\n\\n\\\\-- \\\"Scam Fender sound great to be fair, this is great\\\" - Greg James Radio One - 7.2.22\\n\\n\\\\-- \\\"I've booked tribute in LA for years, this is the best of the best\\\" - Steve Ochs\\n\\n\\\\-- \\\"I've seen Killers 50 times in 9 countries, I was blown away by this tribute\\\" - V.Moran\\n\\nHundreds more testimonials - http://thekopycatkillers.com/testimonials\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1795798800,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-05/35fd37f7-73c6-4d16-a3a1-47ab54898234.jpg?rect=359%2C0%2C1334%2C1334\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-27T17:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":8,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"764f3889713ed38b:41\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"id\":\"69286cd795055c0001548fe8\",\"name\":\"Indiepalooza Festival:  Kopycat Killers v Scam Fender v Subarctic Monkeys v Oasis96\",\"perm_name\":\"g5ky96-indiepalooza-festival-kopycat-killers-v-scam-fender-v-subarctic-monkeys-v-oasis96-27th-nov-the-clapham-grand-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/6890ba7f-2cc2-49ea-a353-9c0e002d19d4.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/6890ba7f-2cc2-49ea-a353-9c0e002d19d4.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/6890ba7f-2cc2-49ea-a353-9c0e002d19d4.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1764356400,\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"You can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"price\":{\"currency\":\"GBP\",\"amount\":3200,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-10T00:00:00+00:00\",\"sale_end_date\":\"2026-11-27T17:00:00+00:00\",\"sale_start_date\":\"2025-12-10T00:00:00+00:00\",\"event_start_date\":\"2026-11-27T18:00:00+00:00\",\"event_end_date\":\"2026-11-27T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"New Cross Live presents\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/S357afab95c8?dice_id=S357afab95c8\",\"post_competition_referral\":\"https://link.dice.fm/U338e646e776?dice_id=U338e646e776\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i63dfa88d22e?dice_id=i63dfa88d22e\",\"post_purchase_referral\":\"https://link.dice.fm/xb8dd8489b32?dice_id=xb8dd8489b32\",\"post_reminder_referral\":\"https://link.dice.fm/n21fd2aa2713?dice_id=n21fd2aa2713\",\"post_waitinglist_referral\":\"https://link.dice.fm/B11547ead94f?dice_id=B11547ead94f\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"DIRTY DC (The AC/DC Tribute)\\n\\nhttps://www.thedirtydc.com/\\n\\nFriday 27th Nov 2026\\n\\nNew Cross Inn\\n\\nLondon\\n\\nDoors 6pm\\n\\n£15 ADV // £18 OTD\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":