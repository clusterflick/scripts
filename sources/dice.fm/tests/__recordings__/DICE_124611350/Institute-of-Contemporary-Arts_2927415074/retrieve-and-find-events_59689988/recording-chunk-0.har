":{\"region\":\"eu\",\"seats_io_event_id\":\"093bbad1-0da7-41da-947b-025d7fcf6662\",\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-17T12:35:00+00:00\",\"sale_end_date\":\"2026-11-02T09:00:00+00:00\",\"sale_start_date\":\"2026-02-17T12:37:00+00:00\",\"event_start_date\":\"2026-11-03T19:00:00+00:00\",\"event_end_date\":\"2026-11-03T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"bb85bk-cat-power-3rd-nov-roundhouse-london-tickets\",\"seats_io_event_id\":\"093bbad1-0da7-41da-947b-025d7fcf6662\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Cat Power - Sea of Love\",\"redirect_url\":\"https://open.spotify.com/artist/6G7OerKc3eBO9sVkRNopFC\",\"artist\":\"Cat Power\",\"preview_url\":\"https://p.scdn.co/mp3-preview/56d16147f62549fd2e40e1110c29d6d4ca0ffe52\",\"track_name\":\"Sea of Love\"},{\"type\":\"spotify\",\"title\":\"The Greatest\",\"redirect_url\":\"https://open.spotify.com/track/0OVXLPJPDCFn1IV6bFxY1N\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/8cdce1823b1ef92ed3bb6a1206ff9bfa9fd1c763?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"The Greatest\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"668c8537-569b-459b-aa5d-df72d382717b\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":77219,\"title\":\"Where are my tickets?\",\"body\":\"**IMPORTANT: Read here about your Roundhouse tickets**\\n\\nPlease note you will need to access your tickets via the Roundhouse Online Wallet at - http://wallet.roundhouse.org.uk\\n\\nYour tickets WILL NOT be available in the DICE app. Just follow the below steps below on the day of event to access your ticket to the show:\\n\\nHead to http://wallet.roundhouse.org.uk\\n\\nSign in using your DICE account email address - if you already had a Roundhouse account under the same email address, enter the password associated with this email address. If you didn’t have one, Roundhouse will have created one for you and you’ll just need to reset the password before logging in.\\n\\nIf you need to reset your password, you’ll be taken to http://roundhouse.org.uk, but you need to log in again at http://wallet.roundhouse.org.uk to access your ticket.\\n\\nThe QR code should appear a couple of hours before the stated time on your ticket\\n\\nIf you want to transfer your tickets to a friend please do so at least 4 hours before the event within the Roundhouse ticket wallet.\\n\\nIf you cannot access your tickets in the Roundhouse online wallet please visit the venue box office when you arrive and one of the team will be happy to assist you.\\n\\nFull information regarding the Roundhouse online wallet can be found at - https://www.roundhouse.org.uk/faqs/digital-tickets/\",\"order\":0},{\"id\":77220,\"title\":\"Security\",\"body\":\"On arrival you will be greeted by our ticket scanners and our security teams. Our security checks include bag searches and a search of individuals using wands. Please be prepared upon arrival to go through this process and help speed up the entry. Our security teams are there for your safety but we recognise that this process can be daunting for some. Please do raise any concerns with staff members when you arrive so that we can support you where needed.\",\"order\":1},{\"id\":77221,\"title\":\"Prohibited Items\",\"body\":\"We reserve the right to prohibit specific items from the Roundhouse Premises. A full list of prohibited items can be found in our Admissions Terms & Conditions: https://www.roundhouse.org.uk/terms-policies/admissions-terms/\\n\\nUnfortunately flags and banners are not permitted into the venue as they can obstruct the view for other people in the audience. Please note this list is not exhaustive. The Venue Management has the right to prohibit any other items that are not included in this list but are deemed to cause a risk to the building or people.\",\"order\":2},{\"id\":77222,\"title\":\"Accessibility Tickets\",\"body\":\"Accessibility tickets must be booked directly with the venue, not through DICE. Please get in touch with the venue via access@roundhouse.org.uk prior to purchasing.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cat Power\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebda19135d5733a4ceaca360f7\"},\"artist_id\":\"1545\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"114\",\"name\":\"Roundhouse\",\"address\":\"Roundhouse, Chalk Farm Rd, London NW1 8EH\",\"location\":{\"lat\":51.5430406,\"lng\":-0.15131180000003},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-24/2fce8c34-cb66-4510-a1d0-f2c07a1f9479.jpg?rect=0%2C0%2C2889%2C2889\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"roundhouse-4296\",\"accessibility\":{\"url\":\"https://www.roundhouse.org.uk/visit/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-03T19:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-17/51f949c0-c016-4a6d-b51a-a28408cc11b4.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-17/51f949c0-c016-4a6d-b51a-a28408cc11b4.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-17/51f949c0-c016-4a6d-b51a-a28408cc11b4.jpg?rect=180%2C0%2C440%2C800\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/zf65243b04cc?dice_id=zf65243b04cc\",\"post_competition_referral\":\"https://link.dice.fm/X1ab98942ae2?dice_id=X1ab98942ae2\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/R30062b325db?dice_id=R30062b325db\",\"post_purchase_referral\":\"https://link.dice.fm/C8bd79b518d5?dice_id=C8bd79b518d5\",\"post_reminder_referral\":\"https://link.dice.fm/L9174ee0a300?dice_id=L9174ee0a300\",\"post_waitinglist_referral\":\"https://link.dice.fm/Z9e611c1f53a?dice_id=Z9e611c1f53a\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":35,\"name\":\"the Event Organiser, AEG Presents\",\"privacy_policy_link\":\"https://www.aegpresents.co.uk/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:83\",\"properties\":[\"selling_fast\"],\"presented_by\":\"Presented by AEG.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771331700,\"id\":\"699460484bcc730001902487\",\"name\":\"Cat Power\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"AEG Presents\\n\\nCat Power\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages (u16s to be acc / u14s to be acc and seated)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"461\",\"name\":\"AEG\",\"image\":{\"url\":null},\"perm_name\":\"aeg-4rkv\",\"profile_active\":false},\"date_unix\":1793732400,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3157,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T11:00:00+00:00\",\"sale_end_date\":\"2026-11-03T18:00:00+00:00\",\"sale_start_date\":\"2025-12-05T11:00:00+00:00\",\"event_start_date\":\"2026-11-03T19:30:00+00:00\",\"event_end_date\":\"2026-11-03T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"3on56g-any-given-day-3rd-nov-the-underworld-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Any Given Day - Coward King\",\"redirect_url\":\"https://music.apple.com/us/album/coward-king/1102806711?i=1102807067&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Any Given Day\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/85/35/04/85350458-caa9-5ac2-8ce5-f9fd74d97355/mzaf_10796428941364624293.plus.aac.p.m4a\",\"track_name\":\"Coward King\"},{\"type\":\"spotify\",\"title\":\"Any Given Day - Coward King\",\"redirect_url\":\"https://open.spotify.com/track/7KfQtmhOj2OpvSF4Y91loK\",\"artist\":\"Any Given Day\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5aea86184e907262238044b039de2fa4f2ca1220?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Coward King\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":60400,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":60401,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":60402,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Any Given Day\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb45b0d66b23c40e8c728aa4b4\"},\"artist_id\":\"130829\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-11-03T19:30:00+00:00\",\"doors_close_date\":\"2026-11-03T22:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-29/3ada3f67-f81e-4280-b815-8c609f72e7f3.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-29/3ada3f67-f81e-4280-b815-8c609f72e7f3.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-29/3ada3f67-f81e-4280-b815-8c609f72e7f3.jpg?rect=675%2C0%2C1650%2C3000\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/cbae94796f6a?dice_id=cbae94796f6a\",\"post_competition_referral\":\"https://link.dice.fm/H194822c4d85?dice_id=H194822c4d85\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Xcf3059d0d8a?dice_id=Xcf3059d0d8a\",\"post_purchase_referral\":\"https://link.dice.fm/R932725547fd?dice_id=R932725547fd\",\"post_reminder_referral\":\"https://link.dice.fm/Eb91915e9d15?dice_id=Eb91915e9d15\",\"post_waitinglist_referral\":\"https://link.dice.fm/C1f9c2330728?dice_id=C1f9c2330728\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:84\",\"properties\":[],\"presented_by\":\"Presented by DHP Family\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1764932400,\"id\":\"692ab0ba84d3e30001ae629b\",\"name\":\"ANY GIVEN DAY\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"In November 2026, ANY GIVEN DAY will return to Europe for their next tour! Focused, confident, and armed with a set that clearly reflects their musical development over the past years. New songs bring fresh impact, while the best-of material underlines why the band has long established itself beyond Germany and its neighbouring countries.\\n\\nThe band is looking forward to finally bringing these new tracks to the stage and hitting the road again.\\n\\nFor the first time, the tour includes headline shows in London, Budapest, Stockholm, and Copenhagen. A consistent step forward and a clear sign of how firmly the band is now anchored across Europe.\\n\\nThis tour marks the next professional step in their evolution: Ruhrpott mentality, executed precisely on an international level. Exactly what you can expect from ANY GIVEN DAY.\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"date_unix\":1793734200,\"event_tag\":null}],\"title\":\"Tue 03 Nov\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1250,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-03T00:00:00+00:00\",\"sale_end_date\":\"2026-11-04T19:30:00+00:00\",\"sale_start_date\":\"2026-02-03T00:00:00+00:00\",\"event_start_date\":\"2026-11-04T19:00:00+00:00\",\"event_end_date\":\"2026-11-04T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ry9yl5-waves-crashing-and-healees-4th-nov-hot-box-chelmsford-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Waves Crashing - Sea of Change\",\"redirect_url\":\"https://open.spotify.com/track/4qVvi3C3BxOsV4znG3NBvq\",\"artist\":\"Waves Crashing\",\"preview_url\":\"https://p.scdn.co/mp3-preview/54d8ddc6e1d4538fc4762b8fcf491c722d963157?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Sea of Change\"},{\"type\":\"apple_music\",\"title\":\"Waves Crashing - Sea of Change\",\"redirect_url\":\"https://music.apple.com/us/album/sea-of-change/1794649073?i=1794649077&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Waves Crashing\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/69/e0/67/69e0670d-1df6-ac60-0902-9a0491de1599/mzaf_3914539539092491392.plus.aac.p.m4a\",\"track_name\":\"Sea of Change\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[{\"