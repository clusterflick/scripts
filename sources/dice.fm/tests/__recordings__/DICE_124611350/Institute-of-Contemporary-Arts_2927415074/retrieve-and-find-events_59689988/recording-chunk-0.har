ount_from\":1760},\"social_links\":{\"event_share\":\"https://link.dice.fm/r83f24c4c310?dice_id=r83f24c4c310\",\"post_competition_referral\":\"https://link.dice.fm/p709bf1b3c8c?dice_id=p709bf1b3c8c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/b2e6f2009862?dice_id=b2e6f2009862\",\"post_purchase_referral\":\"https://link.dice.fm/Kab7ce91a78a?dice_id=Kab7ce91a78a\",\"post_reminder_referral\":\"https://link.dice.fm/L760e224637d?dice_id=L760e224637d\",\"post_waitinglist_referral\":\"https://link.dice.fm/sa1016f5ef84?dice_id=sa1016f5ef84\"},\"perm_name\":\"eobl22-lovers-rock-london-reggae-classics-dancehall-2nd-may-the-camden-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/6d20d61e-8a66-4ebd-b948-2f538dfe1028.jpg?rect=540%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/6d20d61e-8a66-4ebd-b948-2f538dfe1028.jpg?rect=180%2C0%2C1800%2C1080\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/6d20d61e-8a66-4ebd-b948-2f538dfe1028.jpg?rect=783%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"Lovers Rock UK Club Night – London Edition\\n\\nDate: Saturday, 2nd May 2026\\n\\n🕗Time: 10:30 PM – 4:00 AM (Last entry strictly 1:00 AM)\\n\\n📍Venue: The Camden, 65 Crowndale Rd, London NW1 1TN\\n\\n🎟️ Age: 21+ (ID Required)\\n\\n👗 Dress Code: Smart/Casual – No sportswear, no hats\\n\\n🚗 Parking: Paid parking available nearby\\n\\n✨ Event Description:\\n\\nStep into the heart of London for a night dedicated to the soulful sounds of Lovers Rock. Lovers Rock UK returns to The Camden with an immersive club night celebrating Reggae classics, Lovers Rock gems, and Dancehall vibes. This event is crafted for the grown and stylish crowd who appreciate authentic music, good energy, and unforgettable moments. Expect an atmosphere filled with rhythm, culture, and pure Lovers Rock magic.\\n\\n🎧 Music Policy\\n\\nOur DJs will be spinning the very best of Lovers Rock, Reggae classics, and Dancehall blending timeless tracks from the golden era with fresh new school selections to keep the dance floor alive all night long.\\n\\n💌 Table Reservations: loversrockuk1@gmail.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6925e483532e2f00018ec753\",\"name\":\"Lovers Rock - London (Reggae Classics & Dancehall)\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://music.apple.com/us/album/here-i-come/309122317?i=309122381&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/9b/df/c2/9bdfc21c-1bc2-08eb-7aa2-913bbedbaffc/mzaf_11117592686509478017.plus.aac.p.m4a\",\"track_name\":\"Here I Come\"},{\"type\":\"spotify\",\"title\":\"Dennis Brown - Here I Come\",\"redirect_url\":\"https://open.spotify.com/track/0LSHXCQswjJre98L53YrOH\",\"artist\":\"Dennis Brown\",\"preview_url\":\"https://p.scdn.co/mp3-preview/a6eab2cfaedb80e809496819dff1928332c442b2?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Here I Come\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Sat 02 May\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-17T00:00:00+00:00\",\"sale_end_date\":\"2026-05-03T15:00:00+01:00\",\"sale_start_date\":\"2026-01-17T00:00:00+00:00\",\"event_start_date\":\"2026-05-03T15:00:00+01:00\",\"event_end_date\":\"202