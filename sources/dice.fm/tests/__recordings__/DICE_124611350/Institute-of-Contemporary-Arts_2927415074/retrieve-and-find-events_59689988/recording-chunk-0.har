":1700,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":10,\"social_links\":{\"event_share\":\"https://link.dice.fm/Fbe081aa8294?dice_id=Fbe081aa8294\",\"post_competition_referral\":\"https://link.dice.fm/B7cd35f2b972?dice_id=B7cd35f2b972\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/n83906f53963?dice_id=n83906f53963\",\"post_purchase_referral\":\"https://link.dice.fm/h8c3ccc089b1?dice_id=h8c3ccc089b1\",\"post_reminder_referral\":\"https://link.dice.fm/C1732178a5cc?dice_id=C1732178a5cc\",\"post_waitinglist_referral\":\"https://link.dice.fm/F12c16246dbb?dice_id=F12c16246dbb\"},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Harry Christelis - We Whittled a Spoon (feat. Christos Stylianides, Andrea Di Biase & Dave Storey)\",\"redirect_url\":\"https://music.apple.com/us/album/we-whittled-a-spoon-feat-christos-stylianides/1837300215?i=1837300219&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Harry Christelis\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/e9/fc/6f/e9fc6f22-bb6a-6569-938e-46f7b35414e0/mzaf_8639787927882297025.plus.aac.p.m4a\",\"track_name\":\"We Whittled a Spoon (feat. Christos Stylianides, Andrea Di Biase & Dave Storey)\"},{\"type\":\"spotify\",\"title\":\"Harry Christelis - Blues of the Birds\",\"redirect_url\":\"https://open.spotify.com/track/2i4VCz93wThqh04G9Mq0Zg\",\"artist\":\"Harry Christelis\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f13cc0c85bb1227626c0893de854fe3b8661e478?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Blues of the Birds\"}],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Harry Christelis.\",\"billing_promoter\":{\"id\":\"10230\",\"name\":\"Harry Christelis\",\"image\":{\"url\":null},\"perm_name\":\"harry-christelis-5bld\",\"profile_active\":false},\"date_unix\":1778781600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1565\",\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church St, Stoke Newington, London N16 9ES, UK\",\"location\":{\"lat\":51.5613778,\"lng\":-0.0847131000000445},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-church-stoke-newington-x9am\",\"accessibility\":{\"url\":\"https://www.theoldchurch.org.uk/access\"},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-05-14T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:93\",\"about\":{\"description\":\"Guitarist and composer Harry Christelis presents his new album, *Preserving Fictions* — an exploration of how music and art can serve as a means to preserve and document the seeming truths we see, hear, feel, and experience every day. This record sees Christelis delve deeper into a sound world that has become synonymous with his name, fusing elements of jazz and folk traditions with ambient drones and delicate electronic textures to create a truly immersive listening experience.\\n\\nFeaturing his long-standing quartet of *Christos Stylianides* (trumpet/effects), *Andrea Di Biase* (double bass/synth), and *Dave Storey* (drums), the highly acclaimed musicians break free from their traditional roles within the jazz idiom. Instead, they embrace a deeply communal approach to improvisation, colouring, shaping, and delineating every moment of each piece together. Across the adventurous album, the listener is taken on a journey that moves through dreamy psychedelic trips, expansive soundscapes, delicate moments of intimacy, and furious bursts of energy — all seamlessly bound by a tone that holds sombre and hopeful feelings in harmonious equilibrium.\\n\\n*“Compelling ambient music pitched somewhere between In A Silent Way-era Miles Davis and late-era Talk Talk”* – The Guardian\\n\\n*“Breathy and textural tones that perfectly create a sense of space and memory”* – Soweto Kinch, BBC Radio 3\\n\\nHarry Christelis: guitar\\n\\nChristos Stylianides: trumpet\\n\\nAndrea Di Biase: double bass\\n\\nDave Storey: drums\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1768122000,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Harry Christelis\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-10-13/41446c0d-036e-4560-bcd1-c05cf164f195.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"61807\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/d6559077-2ef3-4676-9fb8-e08fe118dc1c.jpg?rect=0%2C0%2C3000%2C3000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/d6559077-2ef3-4676-9fb8-e08fe118dc1c.jpg?rect=0%2C600%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/d6559077-2ef3-4676-9fb8-e08fe118dc1c.jpg?rect=675%2C0%2C1650%2C3000\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6960eb0a7a976f0001325f4e\",\"name\":\"Harry Christelis - Album Launch Concert\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-11T09:00:00+00:00\",\"sale_end_date\":\"2026-05-14T19:00:00+01:00\",\"sale_start_date\":\"2026-01-11T09:00:00+00:00\",\"event_start_date\":\"2026-05-14T19:00:00+01:00\",\"event_end_date\":\"2026-05-14T22:30:00+01:00\