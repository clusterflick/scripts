dice-media.imgix.net/attachments/2026-01-26/7622f607-ef3b-413e-aae0-cba12237f4cd.jpg?rect=0%2C90%2C980%2C588\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-26/7622f607-ef3b-413e-aae0-cba12237f4cd.jpg?rect=279%2C0%2C422%2C768\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/s6758fb35bc3?dice_id=s6758fb35bc3\",\"post_competition_referral\":\"https://link.dice.fm/T45d8054d0f0?dice_id=T45d8054d0f0\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s895fbf0990f?dice_id=s895fbf0990f\",\"post_purchase_referral\":\"https://link.dice.fm/hab2bca8f7cc?dice_id=hab2bca8f7cc\",\"post_reminder_referral\":\"https://link.dice.fm/J1f0a01a6fde?dice_id=J1f0a01a6fde\",\"post_waitinglist_referral\":\"https://link.dice.fm/I24525956d93?dice_id=I24525956d93\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":2237,\"name\":\"DMP\",\"privacy_policy_link\":\"https://www.dmpuk.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:35\",\"properties\":[],\"presented_by\":\"Presented by DMP.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1769515200,\"id\":\"697765bb020ddf00010595c0\",\"name\":\"James McCurtry\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"James McMurtry returns with the black dog and the wandering boy June 20, 2025 via new west records  featuring Sarah Jarosz, Charlie sexton, Bonnie Whitmore, Bukka Allen, and more  rolling stone country premieres title track today   “James McMurtry may be the truest, fiercest songwriter of his generation” - Stephen King\\n\\nJames McMurtry will release the black dog and the wandering boy on June 20 via new west records. the 10-song collection was co-produced by McMurtry & Don Dixon (R.E.M., the Smithereens) and is his first album in four years. it follows his 2021 acclaimed new west debut, the horses and the hounds, which uncut magazine said “lifts storytelling-in-song to meticulous new levels” and pitchfork awarded an 8.0, saying “James Mcurtry stands out even among the lone star state’s finest songwriters…” the black dog and the wandering boy features appearances by Sarah Jarosz, Charlie Sexton, Bonnie Whitmore, Bukka Allen, and more alongside his trusted backing band—cornbread on bass, Tim Holt on guitar, Daren Hess on drums, and Betty Soo on backing vocals.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages - Under 16s to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1768\",\"name\":\"DMP\",\"image\":{\"url\":null},\"perm_name\":\"dmp-d5kq\",\"profile_active\":false},\"date_unix\":1791915300,\"event_tag\":null}],\"title\":\"Tue 13 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":4737},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T10:00:00+00:00\",\"sale_end_date\":\"2026-10-14T21:00:00+01:00\",\"sale_start_date\":\"2026-02-06T10:00:00+00:00\",\"event_start_date\":\"2026-10-14T19:00:00+01:00\",\"event_end_date\":\"2026-10-14T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"5372ry-crash-test-dummies-celebrating-35-years-14th-oct-islington-assembly-hall-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":47386,\"title\":\"Support the Supports\",\"body\":\"Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.\",\"order\":2},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Crash Test Dummies\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1f124f02ea71550139299bed\"},\"artist_id\":\"29061\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-14T19:00:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/b2364f33-67c8-44af-857c-7c6dcdf97628.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/b2364f33-67c8-44af-857c-7c6dcdf97628.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/b2364f33-67c8-44af-857c-7c6dcdf97628.jpg?rect=243%2C0%2C594%2C1080\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/n1de3874736d?dice_id=n1de3874736d\",\"post_competition_referral\":\"https://link.dice.fm/se230343246f?dice_id=se230343246f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/M23b442c83fc?dice_id=M23b442c83fc\",\"post_purchase_referral\":\"https://link.dice.fm/jb4f2672d31d?dice_id=jb4f2672d31d\",\"post_reminder_referral\":\"https://link.dice.fm/Sacfdc326c71?dice_id=Sacfdc326c71\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ya7cfd3b1615?dice_id=Ya7cfd3b1615\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:36\",\"properties\":[],\"presented_by\":\"Presented by DHP.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770199200,\"id\":\"6980777eaf2c730001ace903\",\"name\":\"Crash test Dummies: Celebrating 35+ years\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"One of the most recognizable voices in Canadian music history, Crash Test Dummies is a three-time Grammy–nominated and JUNO Award–winning alternative rock band that rose to global fame in the early 1990s. Throughout their career, they have stayed true to their folk‑tinged, alt‑rock roots—anchored by Brad Roberts’ unmistakable baritone and Ellen Reid’s signature folk‑rock blend.\\n\\nTheir dynamic, high‑energy live show features the band’s most iconic hits, performed by original members Brad Roberts, Ellen Reid, Dan Roberts, and Mitch Dorge. They are joined onstage by long‑time guitarist Stuart Cameron and the talented Leith Fleming‑Smith, one of Canada’s standout keyboardists.\\n\\n*Islington Assembly Hall has launched 'Support the Supports' a campaign to help introduce more music lovers to the up-and-coming acts that open the show! Show up to the venue prior to 8pm and you are in with a chance to win a mystery prize, from drinks vouchers to exclusive merchandise from artists that have previously played the venue. Use the #supportthesupports through socials when you discover a new favourite act at Islington Assembly Hall.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"date_unix\":1792000800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1650,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T10:00:00+00:00\",\"sale_end_date\":\"2026-10-14T18:00:00+01:00\",\"sale_start_date\":\"2026-02-04T10:00:00+00:00\",\"event_start_date\":\"2026-10-14T20:00:00+01:00\",\"event_end_date\":\"2026-10-14T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"2wknp7-axel-flovent-14th-oct-the-grace-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Axel Flovent - Forest Fires\",\"redirect_url\":\"https://open.spotify.com/track/6AQ3guMjWgetjRpQASwrE5\",\"artist\":\"Axel Flovent\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9375ec63ac4878c8038c3ccc2fd0057fb0fe366b?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Forest Fires\"},{\"type\":\"apple_music\",\"title\":\"Axel Flóvent - Beach\",\"redirect_url\":\"https://music.apple.com/us/album/beach/1611912544?i=1611912877&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Axel Flóvent\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/c6/58/0e/c6580e95-4e1c-4eea-2c2a-3aac61e8b141/mzaf_13021784201455853184.plus.aac.p.m4a\",\"track_name\":\"Beach\"}],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":73277,\"title\":\"Accessibility\",\"body\":\"The Grace has 12 steps into the venue, with no disabled toilet. There is no accessible area inside the venue. Companion ticket for someone to assist them up the stairs and to the toilet & early access available.\\n\\nDirect contact: accessibility@thegarage.london\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Axel Flovent\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/bb05323f220edfc6d8c6aa60d882a45b8fece6db\"},\"artist_id\":\"2588\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"1116\",\"name\":\"The Grace\",\"address\":\"Highbury Cres, Highbury East, London N5 1RD, UK\",\"location\":{\"lat\":51.5466983,\"lng\":-0.10384290000001783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-grace-yo5p\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-10-14T19:30:00+01:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/19c04d07-40f0-4503-ae34-377eb2186c1e.jpg?rect=758%2C0%2C3029%2C3029\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/19c04d07-40f0-4503-ae34-377eb2186c1e.jpg?rect=0%2C152%2C4544%2C2726\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/19c04d07-40f0-4503-ae34-377eb2186c1e.jpg?rect=1439%2C0%2C1666%2C3029\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Me6200071284?dice_id=Me6200071284\",\"post_competition_referral\":\"https://link.dice.fm/V501ae1afdb7?dice_id=V501ae1afdb7\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Od7fdf724b43?dice_id=Od7fdf724b43\",\"post_purchase_referral\":\"https://link.dice.fm/nb6c24569232?dice_id=nb6c24569232\",\"post_reminder_referral\":\"https://link.dice.fm/of8a3437cb90?dice_id=of8a3437cb90\",\"post_waitinglist_referral\":\"https://link.dice.fm/dbaf1a2bb9ea?dice_id=dbaf1a2bb9ea\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":2237,\"name\":\"DMP\",\"privacy_policy_link\":\"https://www.dmpuk.com/privacy-policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"d6e15a092fa69dd9:37\",\"properties\":[],\"presented_by\":\"Presented by The London Roots Festival\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770199200,\"id\":\"697cb689ec0b390001bf4a77\",\"name\":\"Axel Flovent\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Axel Flóvent is an Icelandic indie-folk artist whose soft, introspective songs blend Nordic melancholy with a warm, hopeful atmosphere. Growing up in a musical family in Húsavík, he began releasing raw, early demos that led to his breakout single, \\\"Forest Fires,\\\" which is now streamed over 90 million times. His music draws from influences such as Bon Iver and Adrianne Lenker, blending gentle folk, ambient textures, and emotional honesty. After years of living in Reykjavík, Axel has returned to his hometown, where he continues to craft reflective, heartfelt songs - including new releases like singles “Nowhere” (December 19th 2025), “In The Grass” (January 30th 2026) and his upcoming EP, Fleeing the Shore set for April 24th 2026. That marks his first fully self-produced body of work.\\n\\n\\\"London. Enjoy a cozy evening of indie folk with Axel Flóvent. He will perform new material from his upcoming album, along with old favourites. A song collection blending melancholia, Nordic atmospheres and self reflection. Perfect for a hideaway from the rain this fall 🍂 Tickets on sale now.\\\"\\n\\n\\\"I look forward to seeing you in London for a cozy evening this October 🍂 I will perform some brand new material from my upcoming album for the first time, along with old favourites. Hope to see you there.\\\"\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1768\",\"name\":\"DMP\",\"image\":{\"url\":null},\"perm_name\":\"dmp-d5kq\",\"profile_active\":false},\"date_unix\":1792004400,\"event_tag\":null}],\"title\":\"Wed 14 Oct\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":3122,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"c01b9e96-9efb-4707-816b-6f0a6224bdd6\",\"seats_io_public_key\":\"a695a669-bcc2-43e4-942c-124cc9914f8a\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-23T10:00:00+00:00\",\"sale_end_date\":\"2026-10-15T16:00:00+01:00\",\"sale_start_date\":\"2026-01-30T10:00:00+00:00\",\"event_start_date\":\"2026-10-15T19:00:00+01:00\",\"event_end_date\":\"2026-10-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"py598w-mt-jones-15th-oct-o2-shepherds-bush-empire-london-tickets\",\"seats_io_event_id\":\"c01b9e96-9efb-4707-816b-6f0a6224bdd6\",\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"a695a669-bcc2-43e4-942c-124cc9914f8a\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":71090,\"title\":\"What's the bag policy?\",\"body\":\"Security – Bag Policy\\n\\nLarge bags – including rucksacks are not allowed.\\n\\nThere are no facilities to leave large bags or luggage.\\n\\nIf you really have to bring a bag – and it’s preferable you don’t – please make sure it’s small.\\n\\nOnly one small bag per person is permitted and it must not be bigger than A4 size.\\n\\nHeight: 28.7cm\\n\\nWidth: 21cm\\n\\nDepth 15cm\",\"order\":0}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"MT Jones\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-06-11/54f39aed-706e-4142-8b41-12b06312c462.jpg?rect=0%2C54%2C533%2C533\"},\"artist_id\":\"95297\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"538\",\"name\":\"O2 Shepherds Bush Empire\",\"address\":\"Shepherd's Bush Green, London W12 8TT\",\"location\":{\"lat\":51.5032636,\"lng\":-0.22311579999996},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB