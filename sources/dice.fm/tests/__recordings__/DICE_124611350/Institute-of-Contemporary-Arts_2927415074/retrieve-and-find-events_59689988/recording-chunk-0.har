announcement_date_unix\":1768219200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":3647,\"sales_tax\":0,\"amount_from\":null},\"id\":\"69613babffbf2e00015fbeef\",\"name\":\"Bresh\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bresh\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7bb736ec3ddc035cbc41fa54\"},\"artist_id\":\"31827\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"yo6rda-bresh-14th-apr-scala-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/0dc7ef4a-3d5f-4229-8580-1309e5e02f11.jpg?rect=92%2C680%2C2003%2C2001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/0dc7ef4a-3d5f-4229-8580-1309e5e02f11.jpg?rect=0%2C702%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/0dc7ef4a-3d5f-4229-8580-1309e5e02f11.jpg?rect=338%2C0%2C1485%2C2700\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Italian artist Bresh comes to London for a special live show at Scala on 14 April.\\n\\nA key figure in Italian music, this show marks his Paris debut, following his recent arena tour which culminated with two sold-out nights at the Unipol Forum in Milan in November and three sold-out shows at Porto Antico in Genova scheduled for next year.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":64326,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"marketeers\":[],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"The Burning Hell - Brazil Nuts and Blue Curaçao\",\"redirect_url\":\"https://music.apple.com/us/album/brazil-nuts-and-blue-cura%C3%A7ao/1786671860?i=1786671867&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Burning Hell\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/1d/d8/e6/1dd8e67c-a05e-48d9-f367-9e670eb7d5ab/mzaf_2751165245403499197.plus.aac.p.m4a\",\"track_name\":\"Brazil Nuts and Blue Curaçao\"},{\"type\":\"spotify\",\"title\":\"The Burning Hell - Brazil Nuts and Blue Curacao\",\"redirect_url\":\"https://open.spotify.com/track/7hdeJZOUIgSvlaJzFDTwl9\",\"artist\":\"The Burning Hell\",\"preview_url\":\"https://p.scdn.co/mp3-preview/1251a474dd507521240a668bf8d3060ad111ff55?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Brazil Nuts and Blue Curacao\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776191400,\"tty_to_extras\":[],\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-14T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"1711\",\"name\":\"Folklore (Label)\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-07-07/3bb4efaa-5b2f-48dd-818a-8fc78c758f3c.jpg\"},\"perm_name\":\"folklore-label-w8nx\",\"profile_active\":true},\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/Edf5b00909b0?dice_id=Edf5b00909b0\",\"post_competition_referral\":\"https://link.dice.fm/Le2b4fbf0443?dice_id=Le2b4fbf0443\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/g8ddf6317a8f?dice_id=g8ddf6317a8f\",\"post_purchase_referral\":\"https://link.dice.fm/ac89ac2d8cb4?dice_id=ac89ac2d8cb4\",\"post_reminder_referral\":\"https://link.dice.fm/be87d2c5d230?dice_id=be87d2c5d230\",\"post_waitinglist_referral\":\"https://link.dice.fm/L45a97c21115?dice_id=L45a97c21115\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Folklore (Label).\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:33\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-17T09:00:00+00:00\",\"sale_end_date\":\"2026-04-14T18:30:00+01:00\",\"sale_start_date\":\"2025-12-17T09:00:00+00:00\",\"event_start_date\":\"2026-04-14T19:30:00+01:00\",\"event_end_date\":\"2026-04-14T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1765962000,\"offers_extras\":false,\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":2183,\"sales_tax\":0,\"amount_from\":null},\"id\":\"693d75e25525a5000181be9b\",\"name\":\"The Burning Hell + Carsie Blanton\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Burning Hell\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe6294a2944ade1072489a238\"},\"artist_id\":\"805\",\"about\":null,\"is_headliner\":false},{\"name\":\"Carsie Blanton\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb3b3c1b2ff4be40c21342fe23\"},\"artist_id\":\"38023\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"k6nd7l-the-burning-hell-carsie-blanton-14th-apr-the-lexington-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-13/a3e2a413-e2fb-4c37-a505-997e7a723d03.jpg?rect=0%2C455%2C3091%2C3091\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-13/a3e2a413-e2fb-4c37-a505-997e7a723d03.jpg?rect=0%2C1073%2C3091%2C1855\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-13/a3e2a413-e2fb-4c37-a505-997e7a723d03.jpg?rect=446%2C0%2C2200%2C4000\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Due to high demand, we have added an extra date!!\\n\\nThe Burning Hell met Carsie Blanton at a far-flung, small-town gig, and everybody fell in love with each other. They bonded over a shared affection for science fiction and socialism, and made plans to do some writing together. Pretty soon, this new American-Canadian alliance found themselves in a little village in Ireland making a whole record.\\n\\nCarsie, Joe, Mathias and Ariel brought out the silliest and most diabolical sides of each other, shouting down billionaires and war criminals, writing muppet musicals about cybernetics and the inevitable collapse of capitalism.\\n\\nEverything is Great is the result, a co-created album of outraged, outrageous, and ultimately optimistic anthems that invite everyone to join the party. They’ll be on tour together in 2026, playing songs from each of their extensive catalogues plus plenty of new ones, in a show that they have been persuaded by more cautious friends not to call “Martinis and Molotovs.”\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":1736,\"name\":\"The Old Blue Last\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/6272794b194fd97dab3c181a/t/6788e4b811d6695126bd8709/1737024696600/Privacy+Policy+-+The+Old+Blue+Last+.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1737,\"name\":\"Sebright Arms\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/630f3de7c213c45e2e1a26eb/t/6788e53103ae512a44d3fc44/1737024817425/Privacy+Policy+-+Sebright+Arms.pdf\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Winter McQuinn & Acacia Pip - Working On Me\",\"redirect_url\":\"https://music.apple.com/us/album/working-on-me/1772469041?i=1772469042&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Winter McQuinn & Acacia Pip\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/56/76/7f/56767fbc-ccc9-250c-6700-7c2876b31bd0/mzaf_6377994849938143276.plus.aac.p.m4a\",\"track_name\":\"Working On Me\"},{\"type\":\"spotify\",\"title\":\"Winter McQuinn - Working On Me\",\"redirect_url\":\"https://open.spotify.com/track/4xBKsoy2HwWO8nd1iPu7vy\",\"artist\":\"Winter McQuinn\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3a