_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:59\",\"properties\":[],\"presented_by\":\"Presented by Flash Delirium & Paper Dress Live.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1770368400,\"id\":\"6985b8b3c80b8d0001d008f2\",\"name\":\"Charlie Vaughan (Single Launch) + Ruby Doomsday\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"North London singer-songwriter Charlie Vaughan is back to celebrate the release of new music with friends Ruby Doomsday. Join Charlie and his band for a joyous Friday rock and roll extravaganza.\\n\\nCharlie Vaughan embarked upon a solo venture as an outlet for his life-long love of classic British-pop songwriting - from Ray Davies to Elvis Costello; Neil Hannon to Richard Hawley. Sprinkle in some 60s-sunshine revivalism, with a splash of vintage pop art aesthetics, and blushing endearment and melodic charm is soon to follow. With two EPs to his name, and the backing of John Kennedy, Far Out and Shindig! behind him, expect witty social commentaries or just simple, earnest expressions of love.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"2624\",\"name\":\"Paper Dress Vintage\",\"image\":{\"url\":null},\"perm_name\":\"paper-dress-vintage-67xq\",\"profile_active\":false},\"date_unix\":1775845800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T11:00:00+00:00\",\"sale_end_date\":\"2026-04-10T23:00:00+01:00\",\"sale_start_date\":\"2026-02-02T11:00:00+00:00\",\"event_start_date\":\"2026-04-10T19:30:00+01:00\",\"event_end_date\":\"2026-04-10T23:00:00+01:00\",\"i