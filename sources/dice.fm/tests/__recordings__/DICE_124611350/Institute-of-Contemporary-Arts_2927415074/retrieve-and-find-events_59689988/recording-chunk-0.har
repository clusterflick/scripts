\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-cross-inn-x9yl\",\"accessibility\":{\"url\":\"https://www.newcrossinn.com/accessibility/\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-10T17:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:50\",\"about\":{\"description\":\"Will Whisson\\n\\nWill Whisson is a British singer-songwriter and musician renowned for his emotive storytelling and genre-blending sound that traverses folk, rock, and indie-pop. Emerging as a solo artist in 2016, he quit his job and moved out of London to live out of a camper van, busking across Europe. This nomadic lifestyle led to extensive touring, including over 200 gigs across 10 countries, and the release of two EPs and a debut album, Out of the Woods (2019), recorded in Ireland with producer Martin Quinn.\\n\\nIn 2022, Whisson released his sophomore album, Different Sides, produced by Pete Miles. The album features orchestral\\n\\narrangements and introspective lyrics, with tracks like “These Days Are Dead” receiving critical acclaim and support from platforms such as Record of the Day and folk-punk troubadour Frank Turner. Recently, Whisson has formed a new trio and is working on his third album in a self-built studio in South London. The studio serves as a creative hub for writing, rehearsing, and recording. To support this endeavour, he initiated a crowdfunding campaign aiming to raise funds for essential equipment and materials.\\n\\nKnown for his DIY ethos and grassroots approach, Whisson continues to cultivate a dedicated following through Patreon, live\\n\\nperformances, online engagement, and community support.\\n\\n2026 brings regular new music releases supported by nationwide touring once again.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ under 16's to be accompanied by an adult\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1770595200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/fac3361b-a7b0-4468-8fcd-90b57e4e747f.jpg?rect=11%2C0%2C1442%2C1442\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/fac3361b-a7b0-4468-8fcd-90b57e4e747f.jpg?rect=0%2C282%2C1464%2C878\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/fac3361b-a7b0-4468-8fcd-90b57e4e747f.jpg?rect=336%2C0%2C793%2C1442\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6989d06273772600011e27c4\",\"name\":\"Will Whisson\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-05-08T19:00:00+01:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-05-10T17:00:00+01:00\",\"event_end_date\":\"2026-05-10T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"avp2dq-will-whisson-10th-may-new-cross-inn-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"p