1.jpg?rect=0%2C896%2C3585%2C3585\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-26/7afbc6b4-dcc8-40e2-aa09-2e3f81c64d01.jpg?rect=0%2C1613%2C3585%2C2151\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-26/7afbc6b4-dcc8-40e2-aa09-2e3f81c64d01.jpg?rect=314%2C0%2C2957%2C5377\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/iedbf80391c5?dice_id=iedbf80391c5\",\"post_competition_referral\":\"https://link.dice.fm/jd3061e0d236?dice_id=jd3061e0d236\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Y6f6e497e63f?dice_id=Y6f6e497e63f\",\"post_purchase_referral\":\"https://link.dice.fm/hc2c56134be6?dice_id=hc2c56134be6\",\"post_waitinglist_referral\":\"https://link.dice.fm/I2b9b6d4ab56?dice_id=I2b9b6d4ab56\",\"post_reminder_referral\":\"https://link.dice.fm/sb03aad3bcef?dice_id=sb03aad3bcef\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"profile_active\":true,\"highlights\":[],\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-03-20T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nBig Thief guitarist and celebrated singer-songwriter Buck Meek returns to the UK in Spring 2026 with a headline show at EartH. Following a run of acclaimed international dates across North America, East Asia, and Australia, Meek brings his captivating live performance back to London for the first time since 2023.\\n\\nTouring in support of his widely praised third solo album Haunted Mountain — released in August 2023 and co-written in part with folk icon Jolie Holland it received glowing reviews from Rolling Stone, MOJO, Uncut, and more, cementing Meek’s place as a singular voice in modern folk and indie rock.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists in Hackney to use. Find out more here (https://earthackney.co.uk/about/studio-36/).\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. Every donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\\n\\nA percentage of your donation goes towards a payment processing fee (DICE keeps none of this fee). For a £10 donation, the charity gets £9.75.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA4Mjg3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTA4NDQyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NDY3MDJaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MjUxNywicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA4Mjg3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTA4NDQyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NDY3MTlaIiwicHJpY2UiOjMwMCwidmFyaWFudF9pZCI6MjUxOCwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6NTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":500,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA4Mjg3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTA4NDQyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NDY3MjhaIiwicHJpY2UiOjUwMCwidmFyaWFudF9pZCI6MjUxOSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwMCwicHJvbW90aW9uX2lkIjpudWxsfQ==\",\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTA4Mjg3NiwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTA4NDQyLCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NDY3MzZaIiwicHJpY2UiOjEwMDAsInZhcmlhbnRfaWQiOjI1MjAsInByb21vdGlvbl9pZCI6bnVsbCwicHJvZHVjdF9ncm91cF90eXBlIjoiZG9uYXRpb25zIn0=\"}],\"charity_name\":\"Progression Sessions\",\"charity_registration_number\":\"1182721\"},\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:63\",\"billing_promoter\":{\"id\"