\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-29T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"3126\",\"name\":\"Strongroom\",\"image\":{\"url\":null},\"perm_name\":\"strongroom-bpmk\",\"profile_active\":false},\"announcement_date_unix\":1768867200,\"social_links\":{\"event_share\":\"https://link.dice.fm/Y0a3bf67a55d?dice_id=Y0a3bf67a55d\",\"post_competition_referral\":\"https://link.dice.fm/V6d15af61e2f?dice_id=V6d15af61e2f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V56de7604cdd?dice_id=V56de7604cdd\",\"post_purchase_referral\":\"https://link.dice.fm/R8c605ca8765?dice_id=R8c605ca8765\",\"post_reminder_referral\":\"https://link.dice.fm/N87b9d5147a3?dice_id=N87b9d5147a3\",\"post_waitinglist_referral\":\"https://link.dice.fm/y1e3b9da604b?dice_id=y1e3b9da604b\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"92wwx9-john-motors-live-funk-soul-29th-may-strongroom-bar-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1780079400,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:35\",\"price\":{\"currency\":\"GBP\",\"amount\":700,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-20/7c740016-b29a-46cd-8b99-aaf798dc198d.jpg?rect=0%2C0%2C1430%2C1430\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-20/7c740016-b29a-46cd-8b99-aaf798dc198d.jpg?rect=0%2C286%2C1430%2C858\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-20/7c740016-b29a-46cd-8b99-aaf798dc198d.jpg?rect=322%2C0%2C787%2C1430\"},\"id\":\"696f6a532072010001396f01\",\"name\":\"John Motors | Live Funk + Soul\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Soulsa ® Productions presents the infectious funky and soulful sounds of London's very own rhythmic powerhouse - John Motors.\\n\\nThis buoyant band boasts Reuben Ard on organ, Izzy Stephens on guitar and Andreas Ziarkas on drums. Vivacious vocalist Celia Klein captivates listeners with her passionate delivery and magnetic stage presence.\\n\\nWith a driving passion for high-energy grooves to make you move, this tight outfit is a force to be reckoned with.\\n\\nSupport will come from Soulsa’s Mr Boogie who will be rocking the house from behind the decks before, in between and after the live music.\\n\\n**Relevant links:**\\n\\n**www.linktr.ee/johnmotors**\\n\\n**www.soulsa.co.uk**\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"highlights\":[]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-20T00:00:00+00:00\",\"sale_end_date\":\"2026-05-29T16:00:00+01:00\",\"sale_start_date\":\"2026-01-20T00:00:00+00:00\",\"event_start_date\":\"2026-05-29T19:30:00+01:00\",\"event_end_date\":\"2026-05-30T00:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"John Motors - Groove On Out\",\"redirect_url\":\"https://open.spotify.com/track/6pka4A5IS9ax8zSQ6wqSnu\",\"artist\":\"John Motors\",\"preview_url\":\"https://p.scdn.co/mp3-preview/5f55229f0b30ad2a963286cbba8ead8d3a1c60a6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Groove On Out\"},{\"type\":\"apple_music\",\"title\":\"John Motors - Groove On Out\",\"redirect_url\":\"https://music.apple.com/us/album/groove-on-out/1740020557?i=1740020558&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"John Motors\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/64/40/f5/6440f549-6e10-afb3-b24e-9eb66a8d4d64/mzaf_11442168049370846212.plus.aac.p.m4a\",\"track_name\":\"Groove On Out\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"Biird\",\"image\":null,\"artist_id\":\"129940\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExNzk2OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTIyNDU4LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NjoxNS40NTI4NDRaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6Mjc3OSwicHJvbW90aW9uX2lkIjpudWxsLCJwcm9kdWN0X2dyb3VwX3R5cGUiOiJkb25hdGlvbnMifQ==\"},{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MzAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":300,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTExNzk2OS