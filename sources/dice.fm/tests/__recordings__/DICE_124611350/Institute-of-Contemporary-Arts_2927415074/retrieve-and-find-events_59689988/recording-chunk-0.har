2026-02-15/c1db04a0-8116-44bf-bd64-d5970f4754f8.jpg?rect=0%2C480%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-15/c1db04a0-8116-44bf-bd64-d5970f4754f8.jpg?rect=540%2C0%2C1320%2C2400\"},\"max_tickets\":3,\"social_links\":{\"event_share\":\"https://link.dice.fm/ydae45220eec?dice_id=ydae45220eec\",\"post_competition_referral\":\"https://link.dice.fm/U1c96b40d386?dice_id=U1c96b40d386\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/P315365e99c9?dice_id=P315365e99c9\",\"post_purchase_referral\":\"https://link.dice.fm/d0378c43551e?dice_id=d0378c43551e\",\"post_waitinglist_referral\":\"https://link.dice.fm/B797a7104189?dice_id=B797a7104189\",\"post_reminder_referral\":\"https://link.dice.fm/e40f4199f990?dice_id=e40f4199f990\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"15146\",\"name\":\"Fabwick\",\"address\":\"Queens Yard, Tower Hamlets, London, E9 5EN, United Kingdom\",\"location\":{\"lat\":51.542882,\"lng\":-0.022885},\"image\":null,\"city\":{\"id\":\"65e5f91831f8011ecb903745\",\"name\":\"Leytonstone\",\"location\":{\"lat\":51.565785,\"lng\":0.007698,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"fabwick-v3vmv\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-20T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**The Prez & Friends Open Mic is back!** We are kicking off our new residency at Fabwick with ‘The Mic Is Hers’, a celebration for Women’s History Month. Hosted by the soulful north-west songstress Doëlla, this special night is run by the women of our growing community. We invite you all to join and celebrate with us.\\n\\nPlease arrive early to enjoy our games night during the first hour before we dive into an incredible all-female house band, soulful DJs, an open jam and a party to end the night at 01:00. To commemorate the occasion, exclusive Prez & Friends merchandise will be on sale throughout the event for those wanting a keepsake of the evening.\\n\\nEvery purchase automatically enters you into our raffle to win free merch and an exclusive bag by AGP. Please note the lucky winner must be present at the venue to claim their prize. This is an 18+ event and a valid physical ID is required for entry. Doors open at 19:30 and will close at 21:55 so do ensure you arrive in good time to catch the full vibe.\\n\\nFor the artists wishing to grace the stage, we have just 8 performance slots available. Please fill out the form in our Linktree as soon as possible to secure your place and follow us on Instagram for all future residency news.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:50\",\"billing_promoter\":{\"id\":\"144700\",\"name\":\"PREZ & FRIENDS\",\"image\":{\"url\":null},\"perm_name\":\"prez--friends-6r5p7\",\"profile_active\":false},\"presented_by\":\"Presented by PREZ & FRIENDS\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":8},\"marketeers\":[],\"announcement_date_unix\":1771009200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T19:00:00+00:00\",\"sale_end_date\":\"2026-03-20T22:00:00+00:00\",\"sale_start_date\":\"2026-02-13T20:00:00+00:00\",\"event_start_date\":\"2026-03-20T19:30:00+00:00\",\"event_end_date\":\"2026-03-21T01:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"6990b7b33a8ebd0001ee11d4\",\"name\":\"The Mic Is Hers by Prez & Friends \",\"price\":{\"currency\":\"GBP\",\"amount\":800,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[{\"id\":76736,\"title\":\"Open Mic Ticket & Raffle T&Cs \",\"body\":\"By purchasing a ticket, you will be automatically entered into our raffle for a chance to win some exclusive Prez & Friends merch and a limited edition AGP bag. The winner will be announced live on the night of the show and you must be present at the venue to claim your prize. One entry is valid per ticket holder and prizes are non-transferable with no cash alternatives available. Good luck.\",\"order\":0}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"py9q7w-index-for-working-musik-static-palm-jolt-20th-mar-the-old-blue-last-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774035000,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/8fa58897-c463-4f8c-a499-e7d355d80818.jpg?rect=400%2C0%2C1600%2C1600\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/8fa58897-c463-4f8c-a499-e7d355d80818.jpg?rect=0%2C80%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/8fa58897-c463-4f8c-a499-e7d355d80818.jpg?rect=760%2C0%2C880%2C1600\"},\"max_tickets\":30,\"social_links\":{\"event_share\":\"https://link.dice.fm/D83d34b19d95?dice_id=D83d34b19d95\",\"post_competition_referral\":\"https://link.dice.fm/V310ad992f7e?dice_id=V310ad992f7e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/V9699fcfa3e5?dice_id=V9699fcfa3e5\",\"post_purchase_referral\":\"https://link.dice.fm/e1f5fd089af9?dice_id=e1f5fd089af9\",\"post_waitinglist_referral\":\"https://link.dice.fm/b549d85d0ca3?dice_id=b549d85d0