eet, Southwark, London, SE1 3HB, United Kingdom\",\"location\":{\"lat\":51.50033,\"lng\":-0.082},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"morocco-bound-wnln\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-20T19:00:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"14196\",\"name\":\"Morocco Bound\",\"image\":{\"url\":null},\"perm_name\":\"morocco-bound-6d3nb\",\"profile_active\":false},\"announcement_date_unix\":1771261200,\"social_links\":{\"event_share\":\"https://link.dice.fm/L6d8d9a8ffe4?dice_id=L6d8d9a8ffe4\",\"post_competition_referral\":\"https://link.dice.fm/cef5e961205c?dice_id=cef5e961205c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Ddead7137c5c?dice_id=Ddead7137c5c\",\"post_purchase_referral\":\"https://link.dice.fm/Oee995a305f5?dice_id=Oee995a305f5\",\"post_reminder_referral\":\"https://link.dice.fm/M12c6a75827c?dice_id=M12c6a75827c\",\"post_waitinglist_referral\":\"https://link.dice.fm/zeca257f7ccc?dice_id=zeca257f7ccc\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"eor2aw-isabel-maria-20th-apr-morocco-bound-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1776708000,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:58\",\"price\":{\"currency\":\"GBP\",\"amount\":1200,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-14/19214029-345f-472e-bff2-e7cea69d03cd.jpg?rect=0%2C722%2C5504%2C5504\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-14/19214029-345f-472e-bff2-e7cea69d03cd.jpg?rect=0%2C2477%2C5504%2C3302\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-14/19214029-345f-472e-bff2-e7cea69d03cd.jpg?rect=482%2C0%2C4541%2C8256\"},\"id\":\"6990732468765d0001036e73\",\"name\":\"Isabel Maria\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"Isabel Maria’s “Because I Care” UK Tour heads to London for an intimate solo show. Be amongst the first to hear her shiny new EP live, also featuring old favourites and the stories behind Isabel’s unapologetically honest songs.\\n\\nPen in hand, ribbon in hair, 19 year old singer-songwriter Isabel Maria has been shattering expectations since 2021. The self proclaimed ‘pensive popstar’ pairs contagious melodies and piano-driven production with ineffably personal lyricism, resulting in a sound championed by the likes of BBC Radio 1 and Rolling Stone Espanõl.\\n\\nHailing from North East England, Isabel’s career had humble beginnings with secret songs written on her grandad’s old Casio. Fast forward ten years, and now she’s embellished her bookshelf with a North East Culture Award, an Alan Hull Award, and a Northern Writers Award, sharing her songs with hundreds of thousands of listeners and performing them across the UK, Spain, and the United States.\\n\\nFor fans of Olivia Rodrigo, Taylor Swift and Phoebe Bridgers, Isabel’s music is a painstaking exploration of introversion, teenage girlhood, and burnout. Already beloved by an ever-growing, ever-dedicated fanbase, 2026 promises even more for Isabel. With an incoming sophomore EP and her debut UK-wide headline tour in the spring, you won’t be able to look away.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T17:00:00+00:00\",\"sale_end_date\":\"2026-04-20T18:30:00+01:00\",\"sale_start_date\":\"2026-02-16T17:00:00+00:00\",\"event_start_date\":\"2026-04-20T19:00:00+01:00\",\"event_end_date\":\"2026-04-20T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Isabel Maria - Fairweather Friends\",\"redirect_url\":\"https://open.spotify.com/track/5UaE3ZGeZT07BDjZ42pVpz\",\"artist\":\"Isabel Maria\",\"preview_url\":\"https://p.scdn.co/mp3-preview/b910769225781eeb10065e4b86f826be0a853f9f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Fairweather Friends\"},{\"type\":\"apple_music\",\"title\":\"Isabel Maria - Fairweather Friends\",\"redirect_url\":\"https://music.apple.com/us/album/fairweather-friends/1844615642?i=1844615644&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Isabel Maria\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/f7/80/bc/f780bc70-f576-2e3b-154b-8c2899c1489d/mzaf_3538895830817652224.plus.aac.p.m4a\",\"track_name\":\"Fairweather Friends\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Rumpled\",\"image\":null,\"artist_id\":\"89162\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Gotobeat.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[{\"id\":69784,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":69785,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":69786,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"h