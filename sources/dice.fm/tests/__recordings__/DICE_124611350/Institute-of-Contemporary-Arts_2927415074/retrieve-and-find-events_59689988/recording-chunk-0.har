\"dk6oye-yumi-zouma-25th-mar-islington-assembly-hall-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774465200,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-03/17df6811-0afe-4fc4-bf61-34398395c7bc.jpg?rect=0%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-03/17df6811-0afe-4fc4-bf61-34398395c7bc.jpg?rect=0%2C800%2C4000%2C2400\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-03/17df6811-0afe-4fc4-bf61-34398395c7bc.jpg?rect=900%2C0%2C2200%2C4000\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/I74dc96a9529?dice_id=I74dc96a9529\",\"post_competition_referral\":\"https://link.dice.fm/lfb029ab5b3a?dice_id=lfb029ab5b3a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/idbd7377e651?dice_id=idbd7377e651\",\"post_purchase_referral\":\"https://link.dice.fm/o6e98810e9df?dice_id=o6e98810e9df\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ee0ab9326fe2?dice_id=Ee0ab9326fe2\",\"post_reminder_referral\":\"https://link.dice.fm/Ed5d50e3c3f0?dice_id=Ed5d50e3c3f0\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":{\"lat\":51.5395894,\"lng\":-0.102482699999996},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/05562e9c-c684-4beb-b818-4e908bbfb14d.jpg?rect=712%2C0%2C2832%2C2832\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"islington-assembly-hall-z8e2\",\"accessibility\":{\"url\":\"http://islingtonassemblyhall.co.uk/about/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-25T19:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"sold-out\",\"secondary_status\":\"waiting-list\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"*Composed of members Christie Simpson (vocals, keyboards), Josh Burgess (guitar, bass, vocals, keyboards), Charlie Ryder (guitar, bass, keyboards), and Olivia Campion (drums), Yumi Zouma originally joined forces in 2013. While all New Zealanders, the four members have always lived separately in different cities, with Christie based in Melbourne, Charlie in London, Josh in New York, and Olivia in Wellington.*\\n\\n*Yumi Zouma's storied career has spanned over an entire decade – from the shoegaze and dream-pop of their first EP, EP I, and the blogosphere ubiquity of the early single \\\"A Long Walk Home For Parted Lovers\\\" in 2014, to the synth pop of their debut LP, Yoncalla, tours with Lorde, Jamie xx, and Magdalena Bay, global support from Pitchfork, Stereogum, Consequence of Sound, The FADER, SPIN, The Guardian, and radio spins from SiriusXM and Triple J.*\\n\\n*By purchasing a ticket to this event you are agreeing to adhere to Islington Assembly Hall's terms and conditions: https://islingtonassemblyhall.co.uk/customer-terms-conditions-2022/*\\n\\n*All tickets to shows at Islington Assembly Hall are subject to a Venue Levy of £1.50 + VAT. As a Grade II listed building, this levy will be reinvested into Islington Assembly Hall and its services, meaning the customer experience can continue to be enhanced.*\\n\\nThis is a 16+ event – you may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":true,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"45901351f3567a3a:72\",\"billing_promoter\":{\"id\":\"1607\",\"name\":\"Islington Assembly Hall\",\"image\":{\"url\":null},\"perm_name\":\"islington-assembly-hall-78g9\",\"profile_active\":false},\"presented_by\":\"Presented by Live Nation. \",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Vera Ellen\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-01-29/0f91ee35-288c-4ea5-a640-913d62be9f0c.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"93787\",\"about\":null,\"is_headliner\":false},{\"name\":\"Yumi Zouma\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba93dc9dfe9464fd7978bb758\"},\"artist_id\":\"62\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1759741200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-06T10:00:00+01:00\",\"sale_end_date\":\"2026-03-25T21:00:00+00:00\",\"sale_start_date\":\"2025-10-08T10:00:00+01:00\",\"event_start_date\":\"2026-03-25T19:00:00+00:00\",\"event_end_date\":\"2026-03-25T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"68dcf2c00f5b5800016b3f49\",\"name\":\"Yumi Zouma\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2494},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"In Ca