perties\":[],\"venues\":[{\"id\":\"78\",\"name\":\"Scala\",\"address\":\"Scala, 275 Pentonville Rd, London N1 9NL, UK\",\"location\":{\"lat\":51.5308033,\"lng\":-0.12080590000005031},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-02-10/84c4e891-e02c-45c6-8678-bf48caad44d9.jpg?rect=1000%2C0%2C4000%2C4000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"scala-j55d\",\"accessibility\":{\"url\":\"http://scala.co.uk/admission/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-19T19:30:00+01:00\",\"doors_close_date\":\"2026-04-19T23:00:00+01:00\"}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"2066\",\"name\":\"Scala\",\"image\":{\"url\":null},\"perm_name\":\"scala-9b69\",\"profile_active\":false},\"announcement_date_unix\":1761732000,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ea3d5ce9ac05?dice_id=Ea3d5ce9ac05\",\"post_competition_referral\":\"https://link.dice.fm/N2df6f2c7f58?dice_id=N2df6f2c7f58\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Uacaf40ed31f?dice_id=Uacaf40ed31f\",\"post_purchase_referral\":\"https://link.dice.fm/N111489f8fcd?dice_id=N111489f8fcd\",\"post_reminder_referral\":\"https://link.dice.fm/x23d560b1f63?dice_id=x23d560b1f63\",\"post_waitinglist_referral\":\"https://link.dice.fm/z6a2e9e59cc4?dice_id=z6a2e9e59cc4\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"pypra8-frank-turner-19th-apr-scala-london-tickets\",\"unicorn\":true,\"status\":\"sold-out\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[{\"id\":13,\"name\":\"Scala\",\"privacy_policy_link\":\"https://scala.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"shopping_cart_enabled\":false,\"date_unix\":1776623400,\"has_multiple_ticket_types\":false,\"impression_id\":\"ebbfe7c73b45a3bb:55\",\"price\":{\"currency\":\"GBP\",\"amount\":4611,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":false,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-28/adcff869-ddcf-49a2-b791-05fb6e2c18fb.jpg?rect=0%2C420%2C4480%2C4480\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-28/adcff869-ddcf-49a2-b791-05fb6e2c18fb.jpg?rect=0%2C2016%2C4480%2C2688\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-28/adcff869-ddcf-49a2-b791-05fb6e2c18fb.jpg?rect=392%2C0%2C3696%2C6720\"},\"id\":\"690105386e982900014fe59d\",\"name\":\"Frank Turner\",\"seating\":null,\"secondary_status\":\"waiting-list\",\"new\":false,\"about\":{\"description\":\"Frank Turner is one of the UK’s most successful artists. He released his tenth studio album ‘Undefeated’ in May 2024 which debuted at Number 3 in the Oicial Album Chart and Number 1 in the Independent Album Chart. His album ‘FTHC’ (Feb 2022) became his first #1 hit with the previous four albums all peaking in the Top 3. With over a million albums sold worldwide, he has three gold-certified albums and one silver status.\\n\\nSince his first solo gig in 2004, Frank has played his 3000th show in Feb 2025 at Alexandra Palace, London, which sold out within 24 hours of being on general sale. His biggest UK headline shows include aforementioned Alexandra Palace, O2 Arena and Wembley Arena. He has performed at almost every UK venue imaginable, from tiny clubs to stadiums as well as the opening ceremony of 2012 London Olympics.\\n\\nInternationally, Frank has played headline shows in all continents with big followings across Europe and North America. He completed the ambitious 50 States in 50 Days tour in 2022 – the first non-US citizen to do so. His award-winning 4-day festival, Lost Evenings takes place in a dierent city each year - this year in Edinburgh, Scotland, and next year in Dallas, TX.\\n\\nDuring the pandemic, Frank raised almost £300K for grassroot music venues with a weekly series of livestreams resulting in the Music Venue Trust awarding him the Outstanding Achievement for Grassroots Music Venues. Building on this, Frank completed a Music Venue Trust World Record of playing 15 shows in 24 hours – all in grassroot venues and in conjunction with independent record shops.\\n\\nA max of 6 tickets per person and per household applies.\\n\\nTickets in excess of this may be cancelled.\\n\\nTickets must not be purchased with the intention of reselling them.\\n\\nIf you can no longer use your tickets, you may only resell them through the DICE Wait List\\n\\nYou may not resell or offer to resell tickets for this event through any unauthorised resale site\\n\\nAny tickets purchased, resold or offered for resale in breach of these special conditions may be cancelled.  \\n  \\nFull T&Cs: https://dice.fm/help/article?id=40430412359185\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-29T10:00:00+00:00\",\"sale_end_date\":\"2026-04-19T18:30:00+01:00\",\"sale_start_date\":\"2025-10-31T10:00:00+00:00\",\"event_start_date\":\"2026-04-19T19:30:00+01:00\",\"event_end_date\":\"2026-04-19T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Sandy Sheets\",\"redirect_url\":\"https://open.spotify.com/track/3c5LfLYsfeJcfXkuW9JDxE\",\"art