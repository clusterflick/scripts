d_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:66\",\"about\":{\"description\":\"Folksinger Willi Carlisle holds tight the conviction that love is bigger than hate, and no-one is expendable. Carlisle’s music has always been a dance between absurdity, spectacle, and philosophy. On his fourth studio album, Winged Victory, Carlisle returns with his signature blend of traditionally-rooted folk music and kaleidoscope of oddball characters to confer with his core tenets in more overt and provocative ways.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762858800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Willi Carlisle\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-12-09/5f598dd7-1b4e-44a9-8225-a2726c4dd837.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"65589\",\"about\":null,\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-10/dbd55cde-ebb3-4683-9f2c-cc0f3f17a719.jpg?rect=0%2C212%2C1875%2C1875\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-10/dbd55cde-ebb3-4683-9f2c-cc0f3f17a719.jpg?rect=0%2C688%2C1875%2C1125\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-10/dbd55cde-ebb3-4683-9f2c-cc0f3f17a719.jpg?rect=250%2C0%2C1375%2C2500\"},\"offers_extras\":false,\"unicorn_extras\":false,\"id\":\"6913341720bb270001bd1a57\",\"name\":\"Willi Carlisle\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T11:00:00+00:00\",\"sale_end_date\":\"2026-04-24T18:00:00+01:00\",\"sale_start_date\":\"2025-11-13T11:00:00+00:00\",\"event_start_date\":\"2026-04-24T19:30:00+01:00\",\"event_end_date\":\"2026-04-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"eow6yo-willi-carlisle-24th-apr-moth-club-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1450,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/T2a42f4320d4?dice_id=T2a42f4320d4\",\"post_competition_referral\":\"https://link.dice.fm/h38b3891126d?dice_id=h38b3891126d\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/N9cd15d5ec34?dice_id=N9cd15d5ec34\",\"post_purchase_referral\":\"https://link.dice.fm/Ca22c0fa64d9?dice_id=Ca22c0fa64d9\",\"post_reminder_referral\":\"https://link.dice.fm/o3e3b7ed5832?dice_id=o3e3b7ed5832\",\"post_waitinglist_referral\":\"https://link.dice.fm/G78d8b2c0b09?dice_id=G78d8b2c0b09\"},\"previews\":[],\"faqs\":[],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by Scruff of the Neck.\",\"billing_promoter\":{\"id\":\"315\",\"name\":\"Scruff of the Neck\",\"image\":{\"url\":null},\"perm_name\":\"scruff-of-the-neck-4m5v\",\"profile_active\":false},\"date_unix\":1777055400,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"982\",\"name\":\"Dream Bags Jaguar Shoes\",\"address\":\"32-34 Kingsland Rd, London E2 8DA\",\"location\":{\"lat\":51.5280931,\"lng\":-0.0778017000000091},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"dream-bags-jaguar-shoes-8e67\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":\"rescheduled\",\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:67\",\"about\":{\"description\":\"Scruff of the Neck presents\\n\\n**Lucy Dreams**\\n\\n\\\"The Pet Shop Boys of the Future\\\" — live in London!\\n\\nFresh from tours through Japan, Canada, and Europe, and winners of the XA Music Award, Lucy Dreams unveil their upcoming LP VVVVV in the UK for the very first time. Don’t miss this glimpse into the future of pop!\\n\\n🗯️ “A quite irresistible show” — Line Of Best F\\n\\nAt the intersection of dreampop, electronica, and synthwave, the two stage personas Zero and One, guided by their artificial band member Lucy, take the audience on an audiovisual journey into the future of pop music. Some describe it as “Tame Impala in Blade Runner mode,” others as “otherworldly and intense.”\\n\\n🗯️ “Could be a major breakthrough this year” — Wonderland\\n\\nLucy Dreams call their self-invented genre SonicWaveArtPop. Their accompanying manifesto will be released as a concept LP and presented within an atmospheric live show: “Insider tip for concert of the year” — Volume\\n\\nListen: https://artist.sptfy.com/Qb5A  \\nFacebook: https://www.facebook.com/lucy.dreams.dp  \\nInstagram: https://www.instagram.com/lucy.dreams.dp\\n\\nFriday 24 April 2026 | Dream Bags, London  \\nWith support  \\n18+ | £12 Adv | Doors 19:30\\n\\nwww.scruffoftheneck.com  \\nwww.yearsendfest.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762426800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Angel B Valentine\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb1287f78a881696685494ade7\"},\"artist_id\":\"110086\",\"about\":null,\"is_headliner\":false},{\"name\":\"Lucy Dreams\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-30/53e5b459-badb-4189-8c0f-ea35754d56e7.jpg?rect=0%2C0%2C2000%2C2000\"},\"artist_id\":\"60266\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-06/c4662808-1631-4abc-9af4-dc8830d90771.jpg?rect=729%2C0%2C1875%2C1875\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-06/c4662808-1631-4abc-9af4-dc8830d90771.jpg?rect=104%2C0%2C3125%2C1875\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-06/c4662808-1631-4abc-9af4-dc8830d90771.jpg?rect=1151%2C0%2C1031%2C1875\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"690c7d14c5e79d0001b47de3\",\"name\":\"Lucy Dreams \",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-06T11:00:00+00:00\",\"sale_end_date\":\"2026-04-24T19:30:00+01:00\",\"sale_start_date\":\"2025-11-06T11:00:00+00:00\",\"event_start_date\":\"2026-04-24T19:30:00+01:00\",\"event_end_date\":\"2026-04-24T23:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"8exlkr-lucy-dreams-24th-apr-dream-bags-jaguar-shoes-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2251},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/M2e049e6bb98?dice_id=M2e049e6bb98\",\"post_competition_referral\":\"https://link.dice.fm/Wd1b57a59765?dice_id=Wd1b57a59765\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m3ee9fa9cb5a?dice_id=m3ee9fa9cb5a\",\"post_purchase_referral\":\"https://link.dice.fm/p1e9b98f7404?dice_id=p1e9b98f7404\",\"post_reminder_referral\":\"https://link.dice.fm/U9fb04dd59d3?dice_id=U9fb04dd59d3\",\"post_waitinglist_referral\":\"https://link.dice.fm/L0f9012ad8e5?dice_id=L0f9012ad8e5\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Atlantic Diva\",\"redirect_url\":\"https://open.spotify.com/track/5Rvvv94WBHJ7xBTv4wDqzV\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/27a81eee48ec86d62295c12e762adb070136af4f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Atlantic Diva\"},{\"type\":\"apple_music\",\"title\":\"Malibu - Atlantic Diva\",\"redirect_url\":\"https://music.apple.com/us/album/atlantic-diva/1646698851?i=1646699305&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Malibu\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/3c/08/ae/3c08aed4-ef36-bdaa-8728-61da4947049d/mzaf_3521438713112254776.plus.aac.p.m4a\",\"track_name\":\"Atlantic Diva\"}],\"faqs\":[{\"id\":52765,\"title\":\"What are the age restrictions for this event?\",\"body\":\"This is a 16+ event. All attendees 16-17s must be accompanied by a responsible adult who is 18 or older (1:1 ratio). To verify age, ID may be requested. We advise all customers to bri\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by dollop.\",\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"date_unix\":1777055400,\"has_multiple_ticket_types\":true,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"earth-76a7\",\"accessibility\":{\"url\":\"https://bit.ly/44dzl75\"},\"highlights\":[],\"profile_active\":true,\"space_name\":\"EartH Theatre\",\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1974,\"name\":\"dollop\",\"privacy_policy_link\":\"https://drive.google.com/file/d/16UVpg18ttwovfSbZnDM7zF4D9bJM42VA/view\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":true,\"impression_id\":\"ab902a79f4685193:68\",\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nMalibu is a French composer and vocalist whose art is bound to meditation. A musician by trade but an allegorist in practice, her compositions exist as fragments of an imagination as wide as the sea and as open as the sky above it.\\n\\nLoose threads of drone, neoclassical, dance, and pop are woven within contexts of introspection and evanescence. Between these threads is a sonic lexicon entirely her own. Muted pianos and soaring woodwinds sit atop deep, dense waves of strings and pads. Her vocals, a cast of whispers, shift from intimate spoken word passages, long vocalized breaths, and gasps that feel like instruments in their own right. What culminates is a sanctuary for romantic musings on cities, seas, and the self to take place comfortably—ephemerally so, but everlasting all the same.\\n\\nMalibu's artistry encompasses an unparalleled live performance, featuring a seamless blend of tracks meant to induce a state of euphoria and entrancement, enhanced by attentive lighting cues and sound dynamics. This live acumen has earned her spots at festivals such as Atonal and C2C, and as the opening act for frequent collaborator Oklou’s Choke Enough tour. The philosophy of her live performances extends to her acclaimed NTS radio show United in Flames, where she and a cast of guests (including Evian Christ, Casey MQ, Stella Explorer) bring meaningful thought and reason to an otherwise purely curatorial offering. A cinematic artist by nature, she is also a well-versed composer for film, notably scoring 2024’s La Fille Qui Explose (The Exploding Girl), which was featured at the Cannes Film Festival.\\n\\n\\\\- Written by Billie Bugara\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1762336800,\"seats_io_public_key\":null,\"donation\":{\"description\":\"At EartH, we want our space to give back to the community. That’s why we teamed up with Progression Sessions to open Studio 36 inside our venue. Studio 36 provides music making facilities and expertise for free to young musicians in London who face a variety of barriers that might prevent them from making the most of their creativity and talent. \\n\\nEvery donation helps keep Studio 36 open and accessible, so that more young people can find their voice, develop their talents and feel supported as they take their next steps.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTEwNDcwNCwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTE3MzI2LCJjcmVhdGVkX2F0IjoiMjAyNi0wMi0xN1QxNjo1NzoyNC4wOTM3MDlaIiwicHJpY2UiOjEwMCwidmFyaWFudF9pZCI6MjY4MiwicHJvbW