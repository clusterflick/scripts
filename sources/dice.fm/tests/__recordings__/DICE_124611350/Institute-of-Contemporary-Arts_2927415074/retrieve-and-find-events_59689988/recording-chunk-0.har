ost_reminder_referral\":\"https://link.dice.fm/Ka99247f47d8?dice_id=Ka99247f47d8\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T18:00:00+00:00\",\"doors_close_date\":\"2026-03-28T22:00:00+00:00\"}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Originally Formed as a pandemic project, GRIDIRON — (Mathew Karll, vocals; Will Kaelin, guitar and vocals; Xavier Wilson, guitar; William Livesay, bass; and Tyler Mullen, drums) has since grown into a full-fledged entity, features members of Never Ending Game, Simulakra, and Scarab, and connects the Philly, Delaware, and Michigan areas.\\n\\nGridiron are expected to follow up their buzzy 2022 effort, No Good At Goodbyes, in spring of next year with their sophomore album, via Blue Grape Music, with major touring to surround it, including the recently announced stop at Sonic Temple, handful of December shows, and Festivals throughout the new year.\\n\\nJoin us for the after party from 11pm to 3am at The Underworld's Camden Rocks Club - get your tickets: theunderworldcamden.co.uk\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:75\",\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"presented_by\":\"Presented by The Underworld.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Splitknuckle\",\"image\":null,\"artist_id\":\"67683\",\"about\":null,\"is_headliner\":false},{\"name\":\"Missing Link\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-08-27/58b156ed-743e-4d43-bc5c-539acff03a47.jpg?rect=0%2C56%2C529%2C529\"},\"artist_id\":\"68286\",\"about\":null,\"is_headliner\":false},{\"name\":\"Gridiron\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-06-20/ae8501ba-b94b-4f0b-add0-5b2248ae3755.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"55011\",\"about\":null,\"is_headliner\":true}],\"total_artists\":3,\"total_free_texts\":1},\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"announcement_date_unix\":1756681200,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-01T00:00:00+01:00\",\"sale_end_date\":\"2026-03-28T17:00:00+00:00\",\"sale_start_date\":\"2025-09-05T11:00:00+01:00\",\"event_start_date\":\"2026-03-28T18:00:00+00:00\",\"event_end_date\":\"2026-03-28T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"68b5da086e216400019e91b6\",\"name\":\"GRIDIRON\",\"price\":{\"currency\":\"GBP\",\"amount\":2704,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"No Good At Goodbyes\",\"redirect_url\":\"https://open.spotify.com/track/76p9SVJz9HDQxXzN8EwEJj\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9e35326c47dbbfd0e0b7f8db37018fa50eeff6ef?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"No Good At Goodbyes\"},{\"type\":\"apple_music\",\"title\":\"Gridiron - 25-8\",\"redirect_url\":\"https://music.apple.com/us/album/25-8/1615780301?i=1615780307&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Gridiron\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview116/v4/bf/59/8a/bf598a31-4c38-6089-5822-3febf572abf4/mzaf_15666610213038524328.plus.aac.p.m4a\",\"track_name\":\"25-8\"}],\"faqs\":[{\"id\":42024,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":42025,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":42026,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"3ovxkv-crystal-tides-28th-mar-electric-ballroom-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774720800,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-27/09428735-7a51-4cb7-9f2a-0b39fe8340a7.jpg?rect=0%2C899%2C3482%2C3482\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-27/09428735-7a51-4cb7-9f2a-0b39fe8340a7.jpg?rect=0%2C1596%2C3482%2C2089\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-27/09428735-7a51-4cb7-9f2a-0b39fe8340a7.jpg?rect=289%2C0%2C2904%2C5280\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Nbe65ba78c72?dice_id=Nbe65ba78c72\",\"post_competition_referral\":\"https://link.dice.fm/Dafbbbf78bec?dice_id=Dafbbbf78bec\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/i5ae6518c168?dice_id=i5ae6518c168\",\"post_purchase_referral\":\"https://link.dice.fm/ve77f68c8e96?dice_id=ve77f68c8e96\",\"post_waitinglist_referral\":\"https://link.dice.fm/J0e942d1c4d4?dice_id=J0e942d1c4d4\",\"post_reminder_referral\":\"https://link.dice.fm/T98ae8acab5e?dice_id=T98ae8acab5e\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"55\",\"name\":\"Electric Ballroom\",\"address\":\"184 Camden High St, London NW1 8QP\",\"location\":{\"lat\":51.5396558,\"lng\":-0.143191399999978},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/fab0b36d-a5a4-4e37-a541-2c5af15a3bc1.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"electric-ballroom-j78v\",\"accessibility\":{\"url\":\"http://electricballroom.co.uk/disabled-access/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T18:00:00+00:00\",\"doors_close_date\":null}],\"unicorn\":false,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"SJM Concerts Present\\n\\nCrystal Tides + Luna Bay\\n\\nCrystal Tides are an electrifying indie rock band from the coastal city of Portsmouth, United Kingdom. Formed in the vibrant music scene of this historic naval town, the band has quickly captivated audiences with their catchy melodies, lively performances, and heartfelt lyrics. With multiple sold-out shows and successful UK tours under their belt, Crystal Tides has established themselves as a rising force in the indie music landscape\\n\\nTheir sound is a captivating blend of infectious guitar riffs and anthemic choruses, drawing inspiration from bands like Arctic Monkeys, The Wombats, and Catfish and The Bottlemen. This unique fusion of catchy hooks and emotive storytelling leaves listeners singing along long after the music stops.\\n\\nCrystal Tides have made a mark on the live circuit, performing sold out shows such as across the country in London, Portsmouth, Southampton, Bristol, Birmingham & Leeds. They have graced the stages of numerous festivals, including the Main Stage at Victorious, Truck, Great Escape, Tramlines, Kendal Calling, Live at Leeds, Isle of Wight Festival, Sound City, and 110 Above. The band has also supported notable acts across the UK, including Ocean Alley, Feeder, Sundara Karma, The Hoosiers, Twin Atlantic, The Lottery Winners, Andrew Cushin, and The Snuts.\\n\\nThe band recently released a new EP on September 27 named ‘The Middle’, with a debut album planned for 2025 (TBC). Their UK headline tour in October featured performances at iconic venues, including a sold-out show at London’s Lafayette, along with additional sold-out dates in Bristol, Birmingham and Leeds. The band have already sold out Portsmouth Guildhall in just six days for their March 22, 2025, show.\\n\\nCrystal Tides have gained significant traction in the digital space, landing on multiple editorial playlists across platforms such as Spotify (Fresh Finds, Peach, Hot New Bands), Apple Music (New Music Daily, The New Rock), and Amazon (Breakthrough Rock, Fresh Alternative). Their music has been featured in popular TV shows, including \\\"Made in Chelsea\\\" and \\\"This Morning.\\\" They have received media coverage from outlets like Gigwise, CLASH, Fame, and Earmilk, and showcased their talent in an interview and live session on BBC 5 Live, alongside multiple features on ITV News and BBC South Today.\\n\\nThe band has enjoyed considerable radio play, with multiple spins on BBC Radio 1 from Gemma Bradley and Nels Hylton, as well as on BBC Radio 6 with Steve Lamacq and Chris Hawkins. They have also been featured on Radio X and spent six weeks on the Virgin Radio UK Playlist. Their music has been recognized by BBC Introducing Solent as Track of the Week and received B-list support from Amazing Radio.\\n\\nAs they continue to gain momentum, Crystal Tides are poised for an exciting future, ready to take their infectious sound to even larger audiences. Keep an eye on this remarkable band as they ride the waves of their musical journey.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (under 16s to be accompanied by an adult).\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:76\",\"billing_promoter\":{\"id\":\"1141\",\"name\":\"SJM Concerts\",\"image\":{\"url\":null},\"perm_name\":\"sjm-concerts-xe8k\",\"profile_active\":true},\"presented_by\":\"Presented by SJM Concerts.\",\"properties\":[],\"unicorn_extras\":false,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Crystal Tides\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-27/bc0a3b99-e882-49bf-8f34-9cfe42ab339b.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"40317\",\"about\":null,\"is_headliner\":true},{\"name\":\"Luna Bay \",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/73091e7705652af03798825296e02204c053f6eb\"},\"artist_id\":\"8276\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"marketeers\":[{\"id\":622,\"name\":\"Patterns\",\"privacy_policy_link\":\"https://patternsbrighton.com/privacy-policy/\",\"fb_pixel_id\":\"930519437021916\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checko