nterval.***\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Kings Place.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:89\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Qaaaaea9fc7e?dice_id=Qaaaaea9fc7e\",\"post_competition_referral\":\"https://link.dice.fm/fd30cfd505ee?dice_id=fd30cfd505ee\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l01760ab9026?dice_id=l01760ab9026\",\"post_purchase_referral\":\"https://link.dice.fm/o50c573990af?dice_id=o50c573990af\",\"post_reminder_referral\":\"https://link.dice.fm/ja0b61d8fcfa?dice_id=ja0b61d8fcfa\",\"post_waitinglist_referral\":\"https://link.dice.fm/ub88f958415f?dice_id=ub88f958415f\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T01:00:00+00:00\",\"sale_end_date\":\"2026-04-30T18:00:00+01:00\",\"sale_start_date\":\"2026-02-02T01:00:00+00:00\",\"event_start_date\":\"2026-04-30T19:30:00+01:00\",\"event_end_date\":\"2026-04-30T21:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2402,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2362\",\"name\":\"Kings Place\",\"image\":{\"url\":null},\"perm_name\":\"kings-place-29op\",\"profile_active\":false},\"id\":\"6982f3ffbf44f400012030d4\",\"seats_io_event_id\":null,\"name\":\"Muco: Book of Voices\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bbxo3m-muco-book-of-voices-30th-apr-kings-place-hall-two-london-tickets\",\"date_unix\":1777573800,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5073\",\"name\":\"