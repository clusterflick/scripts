ighlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C250%2C1001%2C1001\",\"landscape\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=0%2C450%2C1001%2C601\",\"portrait\":\"https://dice-media.imgix.net/attachments/2023-07-19/042cc3b1-9ac8-4947-8f09-722659ba176a.jpg?rect=88%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770310800,\"max_tickets\":100,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"theatre\",\"value\":\"culture:theatre\",\"title\":\"Theatre\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Under the streets of the world famous London's West End lurks a world of stockings, feathers and fabulousness. The UK's TOP Burlesque production house's weekly Saturday night residency, started at the legendary Madame Jojo's, is here and is the perfect start to the party! Venture under the streets of London to spend some time with 'Burlesque Queen' (What's on Stage) Miss Tempest Rose and the stars of The House of Burlesque…\\n\\nSee Burlesque dancing divas, tantalising tassel-twirlers, and cabaret glitterati with everything in between in an uplifting fabulous live show performed in the round. This special early show is the perfect prelude to dinner and a night on the town if you are heading out after, or all guests are welcome to stay on after the show to dance the night away at the venue. Arrive early doors to enjoy special Happy Hour, DJ afterparty till late.\\n\\n\\\\*Please note all tickets are non-refundable\",\"highlights\":[{\"type\":\"