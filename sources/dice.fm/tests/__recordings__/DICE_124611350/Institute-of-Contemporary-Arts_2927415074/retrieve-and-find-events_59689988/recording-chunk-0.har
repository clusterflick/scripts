riction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T16:00:00+00:00\",\"sale_end_date\":\"2026-05-28T18:30:00+01:00\",\"sale_start_date\":\"2026-02-11T16:00:00+00:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"spotify\",\"title\":\"Funeral Singers\",\"redirect_url\":\"https://open.spotify.com/track/0RDZz06qs6X8EtoqPmppRA\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/688885c5568228e9103f82f295439e4f6a08d06a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Funeral Singers\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"AWARÉ\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc396b4ce49292f33b1d33f6a\"},\"artist_id\":\"132619\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"offers_extras\":false,\"donation\":null,\"presented_by\":\"Presented by Woodburner.\",\"tty_to_extras\":[],\"is_ticket_available_at_door\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"faqs\":[],\"max_tickets\":6,\"properties\":[],\"venues\":[{\"id\":\"2453\",\"name\":\"The Round Chapel\",\"address\":\"1D Glenarm Rd, Clapton, London E5 0NP, UK\",\"location\":{\"lat\":51.55224260000001,\"lng\":-0.052109599999994316},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-round-chapel-g9np\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-28T19:30:00+01:00\",\"doors_close_date\":null}],\"seats_io_event_id\":null,\"billing_promoter\":{\"id\":\"7495\",\"name\":\"Woodburner\",\"image\":{\"url\":null},\"perm_name\":\"woodburner-on25\",\"profile_active\":true},\"announcement_date_unix\":1768996800,\"social_links\":{\"event_share\":\"https://link.dice.fm/Mb043e5f715d?dice_id=Mb043e5f715d\",\"post_competition_referral\":\"https://link.dice.fm/Z2b718cece39?dice_id=Z2b718cece39\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h31e223d63ce?dice_id=h31e223d63ce\",\"post_purchase_referral\":\"https://link.dice.fm/w4d609568db7?dice_id=w4d609568db7\",\"post_reminder_referral\":\"https://link.dice.fm/La02daec0d26?dice_id=La02daec0d26\",\"post_waitinglist_referral\":\"https://link.dice.fm/i17730fdfd71?dice_id=i17730fdfd71\"},\"attendance_type\":\"live_only\",\"acquisition_type\":\"purchase\",\"perm_name\":\"g5dd85-awar-28th-may-the-round-chapel-london-tickets\",\"unicorn\":true,\"status\":\"on-sale\",\"is_fully_locked\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"marketeers\":[],\"shopping_cart_enabled\":false,\"date_unix\":1779993000,\"has_multiple_ticket_types\":false,\"impression_id\":\"55e67ca3ba9827ff:14\",\"price\":{\"currency\":\"GBP\",\"amount\":6600,\"sales_tax\":0,\"amount_from\":null},\"unicorn_extras\":true,\"streaming_options\":null,\"seats_io_public_key\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-21/a31037f8-1446-4e1b-830a-dfb401cd5fc1.jpg?rect=433%2C0%2C1043%2C1043\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-21/a31037f8-1446-4e1b-830a-dfb401cd5fc1.jpg?rect=86%2C0%2C1738%2C1043\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-21/a31037f8-1446-4e1b-830a-dfb401cd5fc1.jpg?rect=668%2C0%2C574%2C1043\"},\"id\":\"6970b043d9f120000161e34f\",\"name\":\"AWARË\",\"seating\":null,\"secondary_status\":null,\"new\":false,\"about\":{\"description\":\"In the stunning surrounds of Hackney’s Round Chapel, you are invited to embark on a sonic journey. This is more than a concert; it is a sacred experience where music becomes a vessel, connecting the individual to the universal.\\n\\nThe journey begins in silence, a fertile space where sound emerges as a gentle breath, and melodies form an intricate web that transcends the boundaries of time and place.\\n\\nAWARË is a living, breathing expression of music—vibrant, raw, and deeply authentic. It calls us back to what is essential, inviting us to lose ourselves in sound and let its resonance awaken parts of us we’ve long forgotten.\\n\\nThis collaboration is not merely a performance but a meeting of kindred spirits—a dialogue carried through each note, each chord. Together, they create a space where music transforms, where the self fades, and the universal emerges in its place.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-21T12:00:00+00:00\",\"sale_end_date\":\"2026-05-28T21:00:00+01:00\",\"sale_start_date\":\"2026-01-21T12:00:00+00:00\",\"event_start_date\":\"2026-05-28T19:30:00+01:00\",\"event_end_date\":\"2026-05-28T22:30:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"previews\":[{\"type\":\"apple_music\",\"title\":\"Ram Dass & AWARÉ - Heart Takes Flight\",\"redirect_url\":\"https://music.apple.com/us/album/heart-takes-flight/1584843709?i=1584843719&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Ram Dass & AWARÉ\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/6f/bd/cb/6fbdcb3e-032c-cc0b-904e-25ba985719ac/mzaf_697887026270164272.plus.aac.p.m4a\",\"track_name\":\"Heart Takes Flight\"}],\"score\":0,\"is_hidden_event\":false,\"event_tag\":null},{\"summary_lineup\":{\"top_artists\":[{\"name\":\"The Skinner Brothers\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e