:true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-02T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"992\",\"name\":\"Lout Promotions\",\"image\":{\"url\":null},\"perm_name\":\"lout-promotions-dkme\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"95f5e6a9ee55de96:34\",\"date_unix\":1777744800,\"price\":{\"currency\":\"GBP\",\"amount\":2266,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Zb3aa2617cb7?dice_id=Zb3aa2617cb7\",\"post_competition_referral\":\"https://link.dice.fm/af5ce01e5c59?dice_id=af5ce01e5c59\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Xbae33d7d9b9?dice_id=Xbae33d7d9b9\",\"post_purchase_referral\":\"https://link.dice.fm/ba2557912603?dice_id=ba2557912603\",\"post_reminder_referral\":\"https://link.dice.fm/Q8e3ea108c21?dice_id=Q8e3ea108c21\",\"post_waitinglist_referral\":\"https://link.dice.fm/D74cabd8d738?dice_id=D74cabd8d738\"},\"perm_name\":\"2wenmm-barbara-2nd-may-the-victoria-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-12/6e204790-5e5d-462c-b61c-307c837e38ee.jpg?rect=150%2C0%2C900%2C900\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-12/6e204790-5e5d-462c-b61c-307c837e38ee.jpg?rect=0%2C90%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-12/6e204790-5e5d-462c-b61c-307c837e38ee.jpg?rect=353%2C0%2C495%2C900\"},\"properties\":[],\"about\":{\"description\":\"Charming chamber pop from Brighton group Barbara.\\n\\nInspired by 1970s greats - the Kinks, ABBA, ELO - Barbara make classic, irresistible pop music with a literary approach.\\n\\nBarbara have previously toured with Paul Weller, The Divine Comedy, Haircut One Hundred, Kid Creole & the Coconuts and Dean Friedman.\\n\\nThere’s something for everyone in Barbara’s sound: 70s US AM radio, a dash of English music hall, the effortless catchiness of a Broadway musical, a sprinkling of sequinned power pop, luscious Disney strings and glorious golden harmonies.\\n\\nAnd please… don’t forget to dance!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6914842a3c93ba000119a51c\",\"name\":\"Barbara\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Barbara - These New Communications\",\"redirect_url\":\"https://open.spotify.com/track/1tu7560oCKi24t2fhxlgPA\",\"artist\":\"Barbara\",\"preview_url\":\"https://p.scdn.co/mp3-preview/f50724eb125db1a239ca839a27a1f5f137521e27?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"These New Communications\"},{\"type\":\"apple_music\",\"title\":\"Barbara - These New Communications\",\"redirect_url\":\"https://music.apple.com/us/album/these-new-communications/1828642711?i=1828642868&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Barbara\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/c1/d2/88/c1d288e2-5862-be89-c032-a9c60e84ca5b/mzaf_14127299450143869165.plus.aac.p.m4a\",\"track_name\":\"These New Communications\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-11T18:00:00+00:00\",\"sale_end_date\":\"2026-05-02T17:00:00+01:00\",\"sale_start_date\":\"2025-11-11T18:00:00+00:00\",\"event_start_date\":\"2026-05-02T19:00:00+01:00\",\"event_end_date\":\"2026-05-02T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_