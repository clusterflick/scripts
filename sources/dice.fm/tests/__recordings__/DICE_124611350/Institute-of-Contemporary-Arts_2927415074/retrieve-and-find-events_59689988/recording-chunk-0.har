m.mux.com/fCBr2yXrzUOcGuwpkNndAPCiM28eK00IIlIxPAk2ejUM.m3u8\",\"track_name\":\"\"},{\"type\":\"apple_music\",\"title\":\"Drake - Hotline Bling\",\"redirect_url\":\"https://music.apple.com/us/album/hotline-bling/1440841363?i=1440841730&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Drake\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/c7/b1/f3/c7b1f35a-8d24-735b-5923-1fb52fc7647e/mzaf_12441003627825640809.plus.aac.p.m4a\",\"track_name\":\"Hotline Bling\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-04T10:00:00+00:00\",\"sale_end_date\":\"2026-02-20T16:00:00+00:00\",\"sale_start_date\":\"2025-12-05T10:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by SJM Concerts.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_disabled\"},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/f939a430ad3d?dice_id=f939a430ad3d\",\"post_competition_referral\":\"https://link.dice.fm/I881980d1818?dice_id=I881980d1818\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/o6531e5fc495?dice_id=o6531e5fc495\",\"post_purchase_referral\":\"https://link.dice.fm/ida281959112?dice_id=ida281959112\",\"post_reminder_referral\":\"https://link.dice.fm/L8d0c6a4b1cb?dice_id=L8d0c6a4b1cb\",\"post_waitinglist_referral\":\"https://link.dice.fm/F59a4378785d?dice_id=F59a4378785d\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"SJM Concerts Present\\n\\npanicbaby\\n\\nPlus Julia Alexa\\n\\nShe introduced her project in July 2025 with “Claw Marks,” now at 10 million streams, followed by “other boys are boring,” which has surpassed 4 million. Most recently, she released “avoidant little b <3,” the third chapter in her unfolding story, already topping 500k streams since its November 14th release. Across social media, videos using her music have generated over 2 billion views, underscoring her rapidly expanding reach and the deep connection her songs inspire.\\n\\nHer upcoming single “soft prn” marks the next exciting step, continuing the momentum around her project and expanding the world she’s building release by release.\\n\\npanicbaby is also stepping confidently onto the stage. She’s been announced as support for global superstar Artemas on the London date of his upcoming tour at the iconic Roundhouse on February 3rd and will soon embark on her own EP tour.\\n\\nInfluenced by Sofia Coppola’s atmosphere, Lykke Li’s fragility and Lana Del Rey’s introspection, her sound is fragile yet fierce, poetic yet direct and made for the people that feel everything all the time.\\n\\nHer debut EP f u jonathan arrives February 13th, offering her most direct, emotionally charged work to date - a distilled version of everything that makes panicbaby resonate so deeply.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 14+ event (under 16s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":1987,\"name\":\"SJM Concerts\",\"privacy_policy_link\":\"https://privacy.sjmconcerts.com/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771614000,\"venues\":[{\"id\":\"12\",\"name\":\"Camden Assembly\",\"address\":\"49 Chalk Farm Road, London NW1 8AN\",\"location\":{\"lat\":51.5431088,\"lng\":