nt\":false,\"venues\":[{\"id\":\"1252\",\"name\":\"The George Tavern\",\"address\":\"373 Commercial Rd, London E1 0LA, UK\",\"location\":{\"lat\":51.51433609999999,\"lng\":-0.05291299999998955},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-george-tavern-kx88\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-05-09T15:00:00+01:00\",\"doors_close_date\":\"2026-05-09T03:00:00+01:00\"}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"2abc553d5c73db35:28\",\"about\":{\"description\":\"EuroHeedfest, the essential annual Europe-based gathering for Guided By Voices and Robert Pollard fans worldwide, returns for its 14th edition and its second year at our new home, The George Tavern in East London. Expect quality live music, free-flowing drinks, and animated conversation with fellow obsessives.\\n\\nEuroHeedfest house band Band of Pricks, performing their customary GBV hits and live favourites, plus a full performance of Under The Bushes Under The Stars in celebration of its 30th anniversary.\\n\\nSpecial guests Your Volunteer Fire Department, a South-East London supergroup featuring members of Baggio and others, playing favourites from the GBV/Pollard canon.\\n\\nWe are very much hoping to welcome back Cocks of the Block, featuring GBV superfan Carl Dalemo and Björn Ågren of Razorlight, for their first appearance in four years. Their return is intended but must remain TBC, pending Razorlight’s touring schedule.\\n\\nFollowing last year’s first visit from US comrades, we’re delighted to welcome Teenage FBI for their London debut. Owen, Jackson and Stephen are US HeedFest veterans, performing material spanning the entire Guided By Voices catalogue.\\n\\nReturning for their third appearance after rousing opening sets in 2024 and 2025 are Angus Knight’s Airshow '88.\\n\\nAs ever, there will be an acoustic open mic in the garden from shortly after doors until the first band starts, so arrive early if you’d like to play, watch fellow fans, or catch some surprise performances.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1769515200,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-27/11dbed3f-344f-43fa-bde7-8afae95fefdd.jpg?rect=0%2C0%2C800%2C800\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-27/11dbed3f-344f-43fa-bde7-8afae95fefdd.jpg?rect=0%2C160%2C800%2C480\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-27/11dbed3f-344f-43fa-bde7-8afae95fefdd.jpg?rect=180%2C0%2C440%2C800\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"6978c050d272e3000190d841\",\"name\":\"EuroHeedfest 14: Annual Guided By Voices Fan Event\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-27T12:00:00+00:00\",\"sale_end_date\":\"2026-05-09T21:00:00+01:00\",\"sale_start_date\":\"2026-01-30T12:00:00+00:00\",\"event_start_date\":\"2026-05-09T15:00:00+01:00\",\"event_end_date\":\"2026-05-09T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"2wk57a-euroheedfest-14-annual-guided-by-voices-fan-event-9th-may-the-george-tavern-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":n