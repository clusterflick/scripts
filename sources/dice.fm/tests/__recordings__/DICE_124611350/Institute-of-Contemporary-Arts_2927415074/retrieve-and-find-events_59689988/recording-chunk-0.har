\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"e044e34315b96a4b:81\",\"properties\":[],\"presented_by\":\"Presented by The Jazz Cafe.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1768410000,\"id\":\"6967c703e0f531000180170b\",\"name\":\"Madame Jazz ft. Bel Cobain\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"London’s premier showcase for UK female jazz and soul.\\n\\nCurated and DJ’d by Ella Knight, it’s a night of vibrant grooves, bold performances, and fresh talent pushing the boundaries of jazz and soul.\\n\\nThe tipple-bill line up is headed up by east London’s introspective, jazz-inspired songstress Bel Cobain who weaves soft-toned vocals with dreamlike textures and poetic song writing. Her music drifts between intimacy and expansiveness, creating a quietly hypnotic live experience.\\n\\nExpertly selected sounds, high-energy sets, and moments of pure discovery — a celebration of artistry, creativity, and the voices you need to hear now.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"43\",\"name\":\"The Jazz Cafe\",\"image\":{\"url\":null},\"perm_name\":\"the-jazz-cafe-43ox\",\"profile_active\":false},\"date_unix\":1772650800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":6356},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-16T00:00:00+00:00\",\"sale_end_date\":\"2026-03-04T17:00:00+00:00\",\"sale_start_date\":\"2025-12-16T00:00:00+00:00\",\"event_start_date\":\"2026-