media.imgix.net/attachments/2021-10-27/5f32c34f-a15a-457c-9953-ae3fe3a46464.jpg?rect=0%2C47%2C226%2C226\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"bush-hall-4bkk\",\"accessibility\":{\"url\":\"https://bushhallmusic.co.uk\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-13T19:30:00+01:00\",\"doors_close_date\":null}],\"billing_promoter\":{\"id\":\"34\",\"name\":\"Upset The Rhythm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/42ef555c-26cf-421b-b66e-2030c1977b0c.jpg\"},\"perm_name\":\"upset-the-rhythm-z8e2\",\"profile_active\":true},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/qdec7186d903?dice_id=qdec7186d903\",\"post_competition_referral\":\"https://link.dice.fm/yacbf9bd07c6?dice_id=yacbf9bd07c6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ddd5fe0d2a04?dice_id=ddd5fe0d2a04\",\"post_purchase_referral\":\"https://link.dice.fm/od4b5bafe516?dice_id=od4b5bafe516\",\"post_reminder_referral\":\"https://link.dice.fm/p6a6fa96eef3?dice_id=p6a6fa96eef3\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ke176fabf9c3?dice_id=Ke176fabf9c3\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Upset The Rhythm.\",\"streaming_options\":null,\"impression_id\":\"86cf2032e1cbfbea:22\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T14:00:00+00:00\",\"sale_end_date\":\"2026-04-13T18:00:00+01:00\",\"sale_start_date\":\"2025-12-15T14:00:00+00:00\",\"event_start_date\":\"2026-04-13T19:30:00+01:00\",\"event_end_date\":\"2026-04-13T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1765807200,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2040,\"sales_tax\":0,\"amount_from\":null},\"id\":\"694005e5ce09ed0001e3214a\",\"name\":\"Bill Orcutt\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Bill Orcutt\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/255b292e9e51364e23d1fb4cf71f7ce52f77cbfb\"},\"artist_id\":\"42526\",\"about\":{\"description\":\"BILL ORCUTT is a guitarist and composer. He has been described as “thrillingly original” (Will Ainsley, Bandcamp Daily) as \\\"a go-for-broke guitar improviser,\\\" (Ben Ratliff, New York Times) “creating a new language” (Marc Masters, Pitchfork) whose playing would \\\"make Derek Bailey do a double-take\\\" (Lars Gotrich, NPR). Orcutt tours actively, appearing at festivals worldwide, including Rewire (The Hague), Presences Electronique (Paris), Jazz em Agosto (Lisbon), Goner Fest (Memphis), Musique Actuelle (Victoriaville), Big Ears (Knoxville), Music Unlimited (Wels), Le Guess Who? (Utrecht), Nouveau Festival du Centre Pompidou (Paris), Unsound (Krakow), a Maida Vale session for BBC 3 (London) and a Tiny Desk concert for NPR.\\n\\n2025 saw Orcutt release ‘Another Perfect Day’, his first solo electric guitar record since 2017’s eponymous Bill Orcutt. While that eight-year gap might not seem like a ton of time on the cosmic scale, it nonetheless represents a busy half-decade plus for Orcutt projects: a raft of improv collaborations, an acclaimed run of chopped and looped albums on Fake Estates, and the collision of Orcutt’s computer and guitar music on Music For Four Guitars and last year’s How to Rescue Things, both on Palilalia. The undeniable alchemy of those latter mashups inspired not only a wider appreciation of Orcutt-as-composer, but also the resurrection of Orcutt-as-bandleader, as the Bill Orcutt Quartet hit the road in support of Four Guitars, Orcutt’s first work with a proper score. ‘Another Perfect Day’ sees Orcutt building tension with short phrases, repeated with slight variability until it seems like they’ll never stop, finally slamming into a fresh line like the dawning valley at the crest of the mountain pass. It’s an affirmation that Orcutt is above all a lead player - angular runs scaling the heavens, ricocheting back to ground zero before climbing again.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"mx89p9-bill-orcutt-13th-apr-bush-hall-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/202ef2a0-2f06-4dcc-803e-cc243175fcd1.jpg?rect=28%2C0%2C1133%2C1133\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/202ef2a0-2f06-4dcc-803e-cc243175fcd1.jpg?rect=0%2C210%2C1189%2C713\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/202ef2a0-2f06-4dcc-803e-cc243175fcd1.jpg?rect=283%2C0%2C623%2C1133\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"BILL ORCUTT is a guitarist and composer. He has been described as “thrillingly original” (Will Ainsley, Bandcamp Daily) as \\\"a go-for-broke guitar improviser,\\\" (Ben Ratliff, New York Times) “creating a new language” (Marc Masters, Pitchfork) whose playing would \\\"make Derek Bailey do a double-take\\\" (Lars Gotrich, NPR). Orcutt tours actively, appearing at festivals worldwide, including Rewire (The Hague), Presences Electronique (Paris), Jazz em Agosto (Lisbon), Goner Fest (Memphis), Musique Actuelle (Victoriaville), Big Ears (Knoxville), Music Unlimited (Wels), Le Guess Who? (Utrecht), Nouveau Festival du Centre Pompidou (Paris), Unsound (Krakow), a Maida Vale session for BBC 3 (London) and a Tiny Desk concert for NPR.\\n\\n2025 saw Orcutt release ‘Another Perfect Day’, his first solo electric guitar record since 2017’s eponymous Bill Orcutt. While that eight-year gap might not seem like a ton of time on the cosmic scale, it nonetheless represents a busy half-decade plus for Orcutt projects: a raft of improv collaborations, an acclaimed run of chopped and looped albums on Fake Estates, and the collision of Orcutt’s computer and guitar music on Music For Four Guitars and last year’s How to Rescue Things, both on Palilalia. The undeniable alchemy of those latter mashups inspired not only a wider appreciation of Orcutt-as-composer, but also the resurrection of Orcutt-as-bandleader, as the Bill Orcutt Quartet hit the road in support of Four Guitars, Orcutt’s first work with a proper score. ‘Another Perfect Day’ sees Orcutt building tension with short phrases, repeated with slight variability until it seems like they’ll never stop, finally slamming into a fresh line like the dawning valley at the crest of the mountain pass. It’s an affirmation that Orcutt is above all a lead player - angular runs scaling the heavens, ricocheting back to ground zero before climbing again.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":2293,\"name\":\"NTS\",\"privacy_policy_link\":\"https://www.nts.live/privacy-policy\",\"fb_pixel_id\":\"1897748661137190\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,