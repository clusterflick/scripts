l,\"external_link\":null}]},\"id\":\"69650ea0fe1f180001de84ac\",\"name\":\"Kit Sebastian\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Pangea\",\"redirect_url\":\"https://open.spotify.com/track/7temtwzguIVsHoT3ewhnxh\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/ee9e186aeb33caca32dfb2c5178b04b4d310e018?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Pangea\"},{\"type\":\"apple_music\",\"title\":\"Kit Sebastian - Tyranny 20\",\"redirect_url\":\"https://music.apple.com/gb/album/tyranny-20/1456307777?i=1456307780&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kit Sebastian\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview123/v4/12/44/ff/1244ff3f-6ac4-9ba8-6849-cbbbbaa2ec26/mzaf_8522812485783257804.plus.aac.p.m4a\",\"track_name\":\"Tyranny 20\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Kit Sebastian\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-01/8b5b033e-dc11-4ce8-9c7a-6293aa03eec6.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"17334\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-15T10:00:00+00:00\",\"sale_end_date\":\"2026-04-01T18:00:00+01:00\",\"sale_start_date\":\"2025-12-15T10:00:00+00:00\",\"event_start_date\":\"2026-04-01T19:30:00+01:00\",\"event_end_date\":\"2026-04-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":63810,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":63811,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":63812,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Gotobeat\",\"seating\":null,\"announcement_date_unix\":1765792800,\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-01T19:30:00+01:00\",\"doors_close_date\":\"2026-04-01T23:00:00+01:00\"}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:74\",\"date_unix\":1775068200,\"price\":{\"currency\":\"GBP\",\"amount\":3080,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/p8a59417b514?dice_id=p8a59417b514\",\"post_competition_referral\":\"https://link.dice.fm/Yfc26478de2f?dice_id=Yfc26478de2f\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/ic26d38f36bb?dice_id=ic26d38f36bb\",\"post_purchase_referral\":\"https://link.dice.fm/i6265417e8fc?dice_id=i6265417e8fc\",\"post_reminder_referral\":\"https://link.dice.fm/Y5f20de27a12?dice_id=Y5f20de27a12\",\"post_waitinglist_referral\":\"https://link.dice.fm/y8fbfe245866?dice_id=y8fbfe245866\"},\"perm_name\":\"eobywd-katarsis-sold-out-1st-apr-the-underworld-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-15/3f5a7b89-f347-4a04-90bc-4628d609a132.jpg?rect=0%2C0%2C3813%2C3813\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-15/3f5a7b89-f347-4a04-90bc-4628d609a132.jpg?rect=0%2C763%2C3813%2C2288\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-15/3f5a7b89-f347-4a04-90bc-4628d609a132.jpg?rect=858%2C0%2C2097%2C3813\"},\"properties\":[],\"about\":{\"description\":\"This show is now SOLD OUT - join the waiting list to be informed of any returns.\\n\\nKatarsis is a Lithuanian alternative/experimental rock band known for their emotionally intense sound and genre-bending compositions. Their debut single “Vasara galvoj minoras” became a breakthrough hit. The band explores themes of pain, longing, and liberation—what they call a process of emotional catharsis.\\n\\nIn May 2024, they released their first EP “Dausos”, further expanding their sonic palette. In 2025, Katarsis represented Lithuania in the Eurovision Song Contest with their song “Tavo akys”, finishing 16th in the Grand Final.\\n\\nTheir music is not just entertainment, but an authentic connection with their audience.The band aspires for their music to reach as many people as possible, fostering a deeper connection with listeners both in Lithuania and beyond. They are touring Europe again in 2026 after a very successful European tour in 2025!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"id\":\"693a7fbf12fc840001890123\",\"name\":\"KATARSIS | SOLD OUT\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-04-01T21:00:00+01:00\",\"sale_start_date\":\"2026-02-16T00:00:00+00:00\",\"event_start_date\":\"2026-04-01T19:45:00+01:00\",\"event_end_date\":\"2026-04-01T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Windmill Brixton.\",\"seating\":null,\"announcement_date_unix\":1771200000,\"venues\":[{\"id\":\"441\",\"name\":\"Windmill Brixton\",\"address\":\"22 Blenheim Gardens, London SW2 5BZ\",\"location\":{\"lat\":51.454073,\"lng\":-0.122336300000029},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"windmill-brixton-jxdl\",\"accessibility\":{\"url\":\"https://www.windmillbrixton.co.uk/visitor-info\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-01T19:45:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"487\",\"name\":\"Windmill Brixton\",\"image\":{\"url\":null},\"perm_name\":\"windmill-brixton-4mgk\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:75\",\"date_unix\":1775069100,\"price\":{\"currency\":\"GBP\",\"amount\":700,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/odba4caae6ca?dice_id=odba4caae6ca\",\"post_competition_referral\":\"https://link.dice.fm/v719abe5c82e?dice_id=v719abe5c82e\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Xc2a3416b2b4?dice_id=Xc2a3416b2b4\",\"post_purchase_referral\":\"https://link.dice.fm/bab45d380400?dice_id=bab45d380400\",\"post_reminder_referral\":\"https://link.dice.fm/L22e497ca251?dice_id=L22e497ca251\",\"post_waitinglist_referral\":\"https://link.dice.fm/m205500ca9d9?dice_id=m205500ca9d9\"},\"perm_name\":\"8e626w-paper-hats-mptl-microplastics-dog-saints-1st-apr-windmill-brixton-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/86b06ecc-5645-407f-85f0-b4f90d5cf411.jpg?rect=0%2C0%2C2400%2C2400\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/86b06ecc-5645-407f-85f0-b4f90d5cf411.jpg?rect=0%2C480%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/86b06ecc-5645-407f-85f0-b4f90d5cf411.jpg?rect=540%2C0%2C1320%2C2400\"},\"properties\":[],\"about\":{\"description\":\"paper hats with MPTLM & Dog Saints\\n\\nThis is no April Fool’s! paper hats celebrate something special at their spiritual home, The Windmill Brixton, alongside two of their favourite acts. After a massive in-the-round fundraiser for their upcoming EP at Venue MOT, the gig is set to be an emotionally purging night of noisy post-hardcore. Moshing, dancing, screaming, and singing are all welcome. Part of a string of spring dates that take the group from the West Country to Yorkshire and back. Get your tickets quick, the last one sold out!\\n\\nSupport comes from MPTL Microplastics, whose industrial-folk debut album ‘Sod In Heaven’ blew everyone’s minds, and Dog Saints, who are adapting their emo-indie bangers into an ultra-special acoustic set.\\n\\nhttps://www.instagram.com/thisisnotpaperhats/\\n\\nhttps://www.instagram.com/mptlmicroplastics/\\n\\nhttps://www.instagram.com/dogsaintsdogsaints/\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"699397edc152b20001decd79\",\"name\":\"paper hats, MPTL Microplastics, Dog Saints\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Dog Saints\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba56fec949b71b0a83e4dd0d4\"},\"artist_id\":\"120315\",\"about\":null,\"is_headliner\":false},{\"name\":\"MPTL Microplastics\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-02-13/a8315a11-7501-4000-9e97-8a668f0fed1a.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"134010\",\"about\":null,\"is_headliner\":false},{\"name\":\"paper hats\",\"image\":null,\"artist_id\":\"69316\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-10T17:00:00+00:00\",\"sale_end_date\":\"2026-04-02T00:00:00+01:00\",\"sale_start_date\":\"2026-02-10T17:00:00+00:00\",\"event_start_date\":\"2026-04-01T20:00:00+01:00\",\"event_end