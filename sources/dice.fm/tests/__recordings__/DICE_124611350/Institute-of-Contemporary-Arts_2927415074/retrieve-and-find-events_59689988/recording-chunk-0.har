":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1050},\"seats_io_public_key\":null,\"presented_by\":\"The Season x Far Out Magazine\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"1634\",\"name\":\"InFireworks\",\"image\":{\"url\":null},\"perm_name\":\"infireworks-8vqv\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"2wkel7-the-season-x-far-out-jeanie-and-the-white-boys-28th-feb-the-old-blue-last-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772305200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:77\",\"venues\":[{\"id\":\"37\",\"name\":\"The Old Blue Last\",\"address\":\"38 Great Eastern Street, London EC2A 3ES\",\"location\":{\"lat\":51.5245266,\"lng\":-0.0806281999999783},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-old-blue-last-4ryw\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Getner\",\"image\":null,\"artist_id\":\"133123\",\"about\":null,\"is_headliner\":false},{\"name\":\"Femur\",\"image\":null,\"artist_id\":\"17427\",\"about\":null,\"is_headliner\":false},{\"name\":\"Jeanie and the White Boys\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-10-09/76d04a20-441a-4421-bdf0-64958bc5a1de.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"109092\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"about\":{\"description\":\"Far Out Magazine present the Season Finale at the Old Blue Last.\\n\\nIt’s not a Season without an explosive Season Finale: Far Out gets wild with Jeanie and the White Boys, Getner and Femur.\\n\\n“Overwhelmingly, it feels like no one in London right now embodies the truth of punk quite like Jeanie Crystal. She’s Poly Styrene, a true working class hero, a storm, a ball of energy, a born star and a vision of her own making, and to witness a Jeanie and the White Boys gig is to witness an artist who truly embodies herself and her message, sticking two middle fingers up at any corner of the world that might doubt her, delivering a ‘fuck you’ to misogyny and to rich kids parading as broke artists.” - Far Out on their Class of 2026 pick\\n\\nIt’s going to be a wild night with wild warm up, kicking off with the raw energy of Manchester’s GETNER and Sheffield doom psych garage punks Femur. Let’s go out with a bang.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-02-28T18:30:00+00:00\",\"sale_start_date\":\"2026-02-04T11:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"69827083bf44f40001efe784\",\"name\":\"The Season x Far Out: Jeanie and the White Boys\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/aa1bd6dd-3efe-4f94-9704-964f4c217378.jpg?rect=0%2C0%2C2250%2C2250\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/a