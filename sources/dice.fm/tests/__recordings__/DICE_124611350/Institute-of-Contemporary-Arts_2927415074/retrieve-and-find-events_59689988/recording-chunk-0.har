e_id=ydcc2c040159\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by Maze and Peter Azzopardi Music .\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:11\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-10-03T10:00:00+01:00\",\"sale_end_date\":\"2026-05-15T17:30:00+01:00\",\"sale_start_date\":\"2025-10-03T10:00:00+01:00\",\"event_start_date\":\"2026-05-15T18:30:00+01:00\",\"event_end_date\":\"2026-05-15T21:45:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1759482000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1854,\"sales_tax\":0,\"amount_from\":null},\"id\":\"68dea9343aedc100019dfb3b\",\"name\":\"MAZE & PETER AZZOPARDI\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"g5lvoa-maze-peter-azzopardi-15th-may-scala-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-02/5bebc934-2398-48be-b820-d71c339ec7b5.jpg?rect=76%2C0%2C941%2C941\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-10-02/5bebc934-2398-48be-b820-d71c339ec7b5.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-10-02/5bebc934-2398-48be-b820-d71c339ec7b5.jpg?rect=169%2C0%2C743%2C1350\"},\"has_multiple_ticket_types\":false,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"Maze & Peter Azzopardi to headline at the Iconic Scala in Kings cross– Biggest Show to date.\\n\\nLONDON, UK – Rising UK indie stars Peter Azzopardi and Maze are set to take centre stage for their biggest headline show to date at the legendary Scala in King’s Cross, bringing their electrifying live energy to one of London’s most iconic venues.\\n\\nIn a bold, self-promoted move, they promise an unforgettable night of raw talent, anthemic hooks, and a celebration of the independent music scene. Taking place on Friday 15th May 2026, the night will feature DJ sets from Tommy McGuinness of The Marquis and will be compered by Mark Speller, of This Is The Music.\\n\\nSupport acts are still to be confirmed, with more announcements expected in the coming weeks.\\n\\nThis is more than a gig – it’s a moment. Don’t miss it.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"No One Quite Like You\",\"redirect_url\":\"https://open.spotify.com/track/7tZ0pfBE636piibuydEf6e\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/fd22d2bfa4dda7b22c8d69d1a4051c24bdc467e4?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"No One Quite Like You\"},{\"type\":\"apple_music\",\"title\":\"Tricky - The Only Way\",\"redirect_url\":\"https://itunes.apple.com/gb/album/the-only-way/id1256505006?i=1256505560&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Tricky\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/apple-assets-us-std-000001/AudioPreview117/v4/35/ac/e4/35ace41a-3b59-c289-dfad-875b423c8abe/mzaf_3587797601427154210.plus.aac.p.m4a\",\"track_name\":\"The Only Way\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"properties\":[],\"date_unix\":1778868000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-15T19:00:00+01:00\",\"doors_close_date\":\"2026-05-15T23:00:00+01:00\"}],\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/Ge5149145bdf?dice_id=Ge5149145bdf\",\"post_competition_referral\":\"https://link.dice.fm/jafcef0cc5ca?dice_id=jafcef0cc5ca\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Tacec00b9e2b?dice_id=Tacec00b9e2b\",\"post_purchase_referral\":\"https://link.dice.fm/q8eb584dc7b1?dice_id=q8eb584dc7b1\",\"post_reminder_referral\":\"https://link.dice.fm/T088aecb2011?dice_id=T088aecb2011\",\"post_waitinglist_referral\":\"https://link.dice.fm/l359d11e2d99?dice_id=l359d11e2d99\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":\"697ae624-9caa-4676-a8d4-993435727754\",\"max_tickets\":8,\"presented_by\":\"Presented by Eat Your Own Ears and Motion.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:12\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-22T10:00:00+01:00\",\"sale_end_date\":\"2026-05-15T22:00:00+01:00\",\"sale_start_date\":\"2025-09-24T10:00:00+01:00\",\"event_start_date\":\"2026-05-15T19:00:00+01:00\",\"event_end_date\":\"2026-05-15T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1758531600,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":5371},\"id\":\"68ca8bb26586ba0001238cd0\",\"name\":\"Tricky\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tricky\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebe9766b4ae86d12fec7d51379\"},\"artist_id\":\"86\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":2},\"new\":false,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"697ae624-9caa-4676-a8d4-993435727754\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"perm_name\":\"7dll7p-tricky-15th-may-troxy-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-09-17/d282a01e-2053-46e3-b0b7-a40d5971e801.jpg?rect=5%2C7%2C945%2C944\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-09-17/d282a01e-2053-46e3-b0b7-a40d5971e801.jpg?rect=0%2C188%2C960%2C576\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-09-17/d282a01e-2053-46e3-b0b7-a40d5971e801.jpg?rect=219%2C0%2C523%2C951\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":false,\"score\":0,\"about\":{\"description\":\"**VENUE PRESALE: WEDS 24TH SEPT @ 10AM**\\n\\n**GENERAL SALE: FRI 26TH SEPT @ 10AM**\\n\\nRenowned as one of the most innovative and influential artists of the past few decades, Tricky returns to the stage for a powerful live experience, presenting a newly conceived show in 2026. Featuring a striking visual design this performance offers a bold reimagining of his catalogue while showcasing his continued evolution as an artist. Tricky will be joined by special guest vocalist Marta Zlakowska.\\n\\nFrom his groundbreaking debut to his work with Massive Attack and other influential collaborations (PJ Harvey, Björk), Tricky has consistently challenged convention and expanded the boundaries of contemporary music. His artistry has earned admiration across generations, with David Bowie himself counted amongst his fans, praising Tricky’s singular vision and fearless creativity.\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":74484,\"title\":\"What photo ID to bring?\",\"body\":\"‘Physical Photo ID is a requirement of entry’ that ‘Photo ID must be in the form of a valid passport, national ID card, or driving license. We do not accept digital copies of IDs or images of IDs on mobile phones. Admission will be refused to customers who arrive without a physical photo ID.\",\"order\":0}],\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778868000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"6559\",\"name\":\"HERE at Outernet\",\"address\":\"Denmark St, Charing Cross Rd, London WC2H 8LH, UK\",\"location\":{\"lat\":51.5152089,\"lng\":-0.1295818},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-09-23/44412f0d-34b8-41b5-8483-6f9558894d40.jpg?rect=0%2C0%2C400%2C400\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"here-at-outernet-wgbx\",\"accessibility\":{\"url\":\"https://dicefm.zendesk.com/hc/en-gb/articles/24679933108753-HERE-at-Outernet-Accessibility-FAQs\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-05-15T19:00:00+01:00\",\"doors_close_date\":\"2026-05-15T22:00:00+01:00\"}],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"social_links\":{\"event_share\":\"https://link.dice.fm/g3276187f052?dice_id=g3276187f052\",\"post_competition_referral\":\"https://link.dice.fm/seecbbd3944c?dice_id=seecbbd3944c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/lb5c4f6cb2e4?dice_id=lb5c4f6cb2e4\",\"post_purchase_referral\":\"https://link.dice.fm/L062a7663146?dice_id=L062a7663146\",\"post_reminder_referral\":\"https://link.dice.fm/tc1d37dd228e?dice_id=tc1d37dd228e\",\"post_waitinglist_referral\":\"https://link.dice.fm/I83d87e06481?dice_id=I83d87e06481\"},\"shopping_cart_enabled\":false,\"seats_io_event_id\":null,\"max_tickets\":6,\"presented_by\":\"Presented by SJM.\",\"streaming_options\":null,\"impression_id\":\"3022d5cbdb7b3c7a:13\",\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-11T10:00:00+00:00\",\"sale_end_date\":\"2026-05-15T20:00:00+01:00\",\"sale_start_date\":\"2026-02-13T10:00:00+00:00\",\"event_start_date\":\"2026-05-15T19:00:00+01:00\",\"event_end_date\":\"2026-05-15T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1770804000,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3366},\"id\":\"698c582796e4530001cb2a64\",\"name\":\"Hasan Raheem\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Hasan Raheem\",\"image\":null,\"artist_id\":\"74221\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"new\":false,\"seating\":null,\"perm_name\":\"mx3mdl-hasan-raheem-15th-may-here-at-outernet-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/57cae272-1cc3-4a15-8abb-ac8a77c59568.jpg?rect=0%2C0%2C1264%2C1264\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/57cae272-1cc3-4a15-8abb-ac8a77c59568.jpg?rect=0%2C261%2C1264%2C758\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/57cae272-1cc3-4a15-8abb-ac8a77c59568.jpg?rect=280%2C0%2C704%2C1280\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"*\\\\*For accessibility information please see the accessibility information button/link below*\\n\\nHey, I’m Hasan.\\n\\n‍I grew up in Gilgit, surrounded by mountains and quiet moments. Eventually, life brought me to Karachi, where I thought I'd just study medicine and figure things out as I went. Honestly, I didn't plan on any of this—music was just something I loved doing after class, a way to unwind, write down feelings, and jam with friends.\\n\\nFast forward a bit, and now I'm touring the world, playing shows from the US to the UK, and finding myself in places I never imagined. It's genuinely been wild seeing people connect to my songs—something that started out as a personal outlet becoming something bigger, shared, and meaningful.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ (14-16s with an adult) event - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[{\"id\":31977,\"title\":\"Accessible and carer ticketing information\",\"body\":\"The accessible area for this show is full, and all the free personal assistant tickets have been assigned. We will not be able to accommodate any more requests. We apologise for any inconvenience this may cause.\\n\\nhttps://support.dice.fm/article/179-accessibilty-tickets-for-islington-assembly-hall\",\"order\":0},{\"id\":31976,\"title\":\"Stage Times \",\"body\":\"Stage times are posted at 11am on the day of the show on our venue website.\",\"order\":1},{\"id\":57461,\"title\":\"Age Restricition\",\"body\":\"This is a 14+ event – 14 and 15 year olds must be accompained by an adult. You may be asked to prove your age and if you are not able to show valid ID, you may be refused entry. Valid ID includes passports, driving licences, over 16+ zip oyster photocard and citizen cards. Photocopies will not be accepted.\",\"order\":3}],\"marketeers\":[{\"id\":1,\"name\":\"Islington Assembly Hall\",\"privacy_policy_link\":\"https://islingtonassemblyhall.co.uk/legal-information/\",\"fb_pixel_id\":\"679202632593023\",\"ga_tracking_id\":\"UA-980124-39\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Clinton Kane - I GUESS I'M IN LOVE\",\"redirect_url\":\"https://open.spotify.com/track/1is8gU4RVcN4J8xItxWoOY\",\"artist\":\"Clinton Kane\",\"preview_url\":\"https://p.scdn.co/mp3-preview/cf41c8b3268141df27b6a252f0b4ea72f6453901?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"I GUESS I'M IN LOVE\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1778868000,\"tty_to_extras\":[],\"venues\":[{\"id\":\"34\",\"name\":\"Islington Assembly Hall\",\"address\":\"Upper Street, London N1 2UD\",\"location\":