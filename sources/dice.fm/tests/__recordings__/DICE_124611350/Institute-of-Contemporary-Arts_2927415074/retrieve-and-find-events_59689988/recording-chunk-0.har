t/attachments/2026-02-16/7496d568-352d-4422-86ba-1d37ad1da81f.jpg?rect=0%2C450%2C2250%2C1350\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/7496d568-352d-4422-86ba-1d37ad1da81f.jpg?rect=506%2C0%2C1238%2C2250\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/h09f575286f1?dice_id=h09f575286f1\",\"post_competition_referral\":\"https://link.dice.fm/Aaeb2f397492?dice_id=Aaeb2f397492\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/I329fbadf51c?dice_id=I329fbadf51c\",\"post_purchase_referral\":\"https://link.dice.fm/d133ea46c1f2?dice_id=d133ea46c1f2\",\"post_reminder_referral\":\"https://link.dice.fm/X1671c6a1854?dice_id=X1671c6a1854\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cc21f8f0b2fe?dice_id=Cc21f8f0b2fe\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":675,\"name\":\"Ninety One Living Room\",\"privacy_policy_link\":\"https://91livingroom.com/homepage/privacy-policy/\",\"fb_pixel_id\":\"580346810496200\",\"ga_tracking_id\":\"302117538\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:83\",\"properties\":[],\"presented_by\":\"Presented by Ninety One Living Room.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1745449200,\"id\":\"6992f3077e78bc0001830f77\",\"name\":\"Jazz on the Lane: LA Family Trio \",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Introducing our new Sunday series, Jazz on the Lane, featuring a rotating line up of collectives and trios every week from London's thriving jazz scene, in the heart of Brick Lane.\\n\\nThis Sunday, we welcome Jazz Fusion group, the LA Family Trio for a high energy night of live music. The talented trio is made Up of (Drums) Johnathan “LA Jrums” Allen, (Piano) Auris Delan, and (Bass) Theo Archer.\\n\\nABOUT LA FAMILY TRIO\\n\\nAn eclectic mash-up of all things fusion, whether that be Jazz, Classical, Contemporary, Soca, Dancehall or Grime, if it sounds good we've put it together. Led by Johnathan AKA LA Jrums, the trio specialise in playing complex written pieces, progressive on the spot improvised pieces as well as arranged covers of songs that you could've sworn never sounded that way originally.\\n\\nJoin us as we bring the community together through incredible music & banging drinks.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"18+ event. Physical, scannable ID required for entry (all ages)\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10115\",\"name\":\"Ninety One\",\"image\":{\"url\":null},\"perm_name\":\"ninety-one-m75r\",\"profile_active\":true},\"date_unix\":1772992800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":3000},\"unicorn\":true,\"streaming_options\":null,\"seating\":{\"region\":\"eu\",\"seats_io_event_id\":\"1af78865-a2ed-4a90-8b52-3ce8366de3d5\",\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"seat_selection\":\"enabled\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-13T18:00:00+00:00\",\"sale_end_date\":\"2026-03-08T21:00:00+00:00\",\"sale_start_date\":\"2026-02-16T18:00:00+00:00\",\"event_start_date\":\"2026-03-08T18:00:00+00:00\",\"event_end_date\":\"2026-03-08T22:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ry9peq-mega-maalai-8th-mar-troxy-london-tickets\",\"seats_io_event_id\":\"1af78865-a2ed-4a90-8b52-3ce8366de3d5\",\"previews\":[],\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"seats_io_public_key\":\"d31cbde6-a999-4e14-8ec1-e975c10adbf1\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[{\"id\":20779,\"title\":\"How can I purchase an accessible ticket?\",\"body\":\"Please email accesstickets@troxy.co.uk with a copy of your proof of eligibility.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"order\":0},{\"id\":20780,\"title\":\"Can I get a carer ticket if I have a standing or circle ticket?\",\"body\":\"We can offer free companion tickets upon receipt of proof of eligibility and your DICE booking confirmation at accesstickets@troxy.co.uk. Companion ticket availability is limited in the Circle, so please reach out to check availability before purchasing a Circle ticket.\",\"order\":1}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":2},\"offers_extras\":false,\"max_tickets\":8,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"583\",\"name\":\"Troxy\",\"address\":\"490 Commercial Road, London E1 0HX\",\"location\":{\"lat\":51.5127267,\"lng\":-0.0440164000000323},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-02-09/061113a1-696d-4a63-976d-388707e1d2c4.jpg?rect=0%2C0%2C2750%2C2750\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"troxy-ww3x\",\"accessibility\":{\"url\":\"https://troxy.co.uk/accessibility/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-08T18:00:00+00:00\",\"doors_close_date\":\"2026-03-08T22:00:00+00:00\"}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-13/377aab71-dc65-4d80-a72f-15fbc40b50da.jpg?rect=0%2C29%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-13/377aab71-dc65-4d80-a72f-15fbc40b50da.jpg?rect=0%2C351%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-13/377aab71-dc65-4d80-a72f-15fbc40b50da.jpg?rect=169%2C0%2C743%2C1350\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/T22c0b28dada?dice_id=T22c0b28dada\",\"post_competition_referral\":\"https://link.dice.fm/F3f321d9bc4b?dice_id=F3f321d9bc4b\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G275ff45c146?dice_id=G275ff45c146\",\"post_purchase_referral\":\"https://link.dice.fm/c8f6ec40d3e3?dice_id=c8f6ec40d3e3\",\"post_reminder_referral\":\"https://link.dice.fm/rdcd04923f10?dice_id=rdcd04923f10\",\"post_waitinglist_referral\":\"https://link.dice.fm/bc34fa648415?dice_id=bc34fa648415\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":14,\"name\":\"Troxy\",\"privacy_policy_link\":\"https://troxy.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"impression_id\":\"a3ead428a6c1b92b:84\",\"properties\":[\"selling_fast\"],\"presented_by\":\"Presented by Imperial College Union Tamil Society.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1771005600,\"id\":\"698f271e7b796100011e621e\",\"name\":\"Mega Maalai\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Mega Maalai is Imperial College London International Tamil Society’s annual flagship event, showcasing performances that reflect the heart of Tamil culture. Bringing exciting performers, exhilarating dance moves and electrifying music, expect powerful acts, immersive narratives, and an atmosphere driven by creativity, pride, and passion. Join us to witness a one of a kind evening, bringing Tamil culture to the stage!\\n\\nBooking fees include a £2.25 venue restoration levy per ticket.\\n\\n**Accessible Bookings:**\\n\\nTickets for Troxy’s step-free seated accessible area are available directly from this listing as Accessible Area tickets. If you’ve purchased Accessible Area tickets for this event and haven’t done so for a previous event at Troxy, please email accesstickets@troxy.co.uk with a copy of your proof of eligibility. We accept PIP letters, Access Cards, Blue Badge, Doctor's notes, etc. Please ensure that this is sent to us within 7 days of your purchase, as failure to do so could result in your ticket being cancelled and refunded. Please direct all other accessibility enquiries to accesstickets@troxy.co.uk.\\n\\nFor more information about Accessible bookings and example proof of eligibility, visit https://troxy.co.uk/accessibility/.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 14+ event.\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"1554\",\"name\":\"Troxy\",\"image\":{\"url\":null},\"perm_name\":\"troxy-5wrl\",\"profile_active\":false},\"date_unix\":1772992800,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2024-11-28T00:00:00+00:00\",\"sale_end_date\":\"2026-03-08T20:00:00+00:00\",\"sale_start_date\":\"2026-02-12T00:00:00+00:00\",\"event_start_date\":\"2026-03-08T18:00:00+00:00\",\"event_end_date\":\"2026-03-08T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"ry9pgr-not-the-usual-jam-free-8th-mar-grow-london-tickets\",\"seats_io_event_id\":null,\"previews\":[],\"donation\":null,\"public_refund_policy\":null,\"seats_io_public_key\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"unicorn_extras\":true,\"faqs\":[],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"offers_extras\":false,\"max_tickets\":6,\"shopping_cart_enabled\":false,\"venues\":[{\"id\":\"954\",\"name\":\"Grow\",\"address\":\"Grow, 98C Main Yard, Wallis Rd, Hackney Wick, London E9 5LN\",\"location\":{\"lat\":51.5441605,\"lng\":-0.0236324999999624},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"grow-537l\",\"accessibility\":{\"url\":\"https://www.growhackney.co.uk/access-accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-08T11:00:00+00:00\",\"doors_close_date\":null}],\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-12/679f1ae3-dec2-4c85-ad64-c6fd5afc96b8.jpg?rect=267%2C0%2C1067%2C1067\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-12/679f1ae3-dec2-4c85-ad64-c6fd5afc96b8.jpg?rect=0%2C54%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-12/679f1ae3-dec2-4c85-ad64-c6fd5afc96b8.jpg?rect=507%2C0%2C587%2C1067\"},\"status\":\"on-sale\",\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/add1335c246d?dice_id=add1335c246d\",\"post_competition_referral\":\"https://link.dice.fm/w2a63d17e6e8?dice_id=w2a63d17e6e8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/C1071d667414?dice_id=C1071d667414\",\"post_purchase_referral\":\"https://link.dice.fm/v83dfc32c353?dice_id=v83dfc32c353\",\"post_reminder_referral\":\"https://link.dice.fm/Hcac4df2ac0d?dice_id=Hcac4df2ac0d\",\"post_waitinglist_referral\":\"https://link.dice.fm/t305c5da6e95?dice_id=t305c5da6e95\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[],\"impression_id\":\"a3ead428a6c1b92b:85\",\"properties\":[],\"presented_by\":\"Presented by Grow, Hackney.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1732752000,\"id\":\"698dd4d80c842f0001969c06\",\"name\":\"Not The Usual Jam // Free\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"Come to Not The Usual Jam (NTUJ) and experience free live music in our reimagined canalside snug, transformed into a warm, plant-filled stage space. This cross-genre jam welcomes guest artists who spotlight women and diaspora voices, expanding the sound and energy of the night.\\n\\nWhether you’re a keyboardist, beatmaker, vocalist, storyteller, or just starting out, this jam is open to all. It’s also a great place to meet other artists and spark future collaborations.\\n\\nAs an audience member, you’ll be just a few feet from musicians across genres, witnessing spontaneous, one-of-a-kind moments you won’t hear anywhere else. To mark the season, enjoy a festive menu with mulled wine and mulled apple to keep things cosy.\\n\\nSpecial guests to be announced.\\n\\nNTUJ is hosted by Luis David Fernández Gago and Alessandro Corda, musicians, producers and curators committed to nurturing artists through experimentation, collaboration and community.\\n\\nWant to take part? Bring your instrument. Questions: infohackneyrhythm@gmail.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"score\":0,\"billing_promoter\":{\"id\":\"10561\",\"name\":\"Grow, Hackney\",\"image\":{\"url\":null},\"perm_name\":\"grow-hackney-rdpy\",\"profile_active\":false},\"date_unix\":1772992800,\"event_tag\":null},{\"tty_to_extras\":[{\"ticket_type_id\":1161392,\"extra_ids\":[\"1167548\"]},{\"ticket_type_id\":1161393,\"extra_ids\":[\"1167548\"]},{\"ticket_type_id\":1161417,\"extra_ids\":[\"1167548\"]},{\"ticket_type_id\":1161418,\"extra_ids\":[\"1167548\"]},{\"ticket_type_id\":1194365,\"extra_ids\":[\"1167548\"]}],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"unicorn\":true,\"streaming_options\":null,\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-09T10:00:00+00:00\",\"sale_end_date\":\"2026-03-08T20:00:00+00:00\",\"sale_start_date\":\"2026-01-09T10:00:00+00:00\",\"event_start_date\":\"2026-03-08T18:00:00+00:00\",\"event_end_date\":\"2026-03-08T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"is_fully_locked\":false,\"perm_name\":\"92wo66-katherine-priddy-live-signing-8th-mar-rough-trade-east-london-london-tickets\",\"seats_io_event_id\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Indigo\",\"redirect_url\":\"https://open.spotify.com/track/4dEShdbZOn5qXWXQbUyGh9\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/289e3c7201d9c63cc97d68dc1d642b4c0f04f0c6?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Indigo\"}],\"donation\":{\"description\":\"Help save a life. Someone in the UK dies by suicide every 90 minutes. Artists, musicians, and entertainers have an increased risk of suicide. Rough Trade is proud to partner with Campaign Against Living Miserably (CALM) in support of their incredible work challenging the stigma surrounding suicide and mental health.\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-08-28/af5fb538-b9c7-4f41-bf11-48d1d9d6d45a.jpeg?rect=342%2C0%2C1365%2C1365\"},\"variants\":[{\"price\":{\"id\":\"eyJ0aWVyX2luZGV4IjowLCJwcmljZSI6MTAwLCJwcm9tb3Rpb25faWQiOm51bGx9\",\"currency\":\"GBP\",\"amount\":100,\"sales_tax\":0},\"reserve_token\":\"eyJpZCI6MTE2NzU0OSwidHlwZSI6InByb2R1Y3QiLCJ0aWVyX2luZGV4IjowLCJldmVudF9pZCI6NTQyOTQyLCJjcmVhdGVk