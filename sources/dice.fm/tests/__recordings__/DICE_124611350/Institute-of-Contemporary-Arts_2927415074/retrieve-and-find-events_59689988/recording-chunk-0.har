\":\"2026-03-28T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1280\",\"name\":\"CLUB.THE.MAMMOTH\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-03-26/b7c6d4f5-e734-437e-aea8-bf1dbd513d1a.jpg\"},\"perm_name\":\"clubthemammoth-nyaq\",\"profile_active\":true},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:2\",\"date_unix\":1774726200,\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/qe9af2d57d22?dice_id=qe9af2d57d22\",\"post_competition_referral\":\"https://link.dice.fm/k32eace3c785?dice_id=k32eace3c785\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l2c7e2c6a7b6?dice_id=l2c7e2c6a7b6\",\"post_purchase_referral\":\"https://link.dice.fm/A162534a0d4d?dice_id=A162534a0d4d\",\"post_reminder_referral\":\"https://link.dice.fm/x4b1358f109a?dice_id=x4b1358f109a\",\"post_waitinglist_referral\":\"https://link.dice.fm/v95c5584bc9a?dice_id=v95c5584bc9a\"},\"perm_name\":\"v3gl8g-dreamwave-honest-work-28th-mar-the-old-blue-last-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-18/294e2b49-8692-461f-8375-baa841703dc8.jpg?rect=0%2C456%2C3648%2C3648\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-18/294e2b49-8692-461f-8375-baa841703dc8.jpg?rect=0%2C1186%2C3648%2C2189\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-18/294e2b49-8692-461f-8375-baa841703dc8.jpg?rect=570%2C0%2C2508%2C4560\"},\"properties\":[],\"about\":{\"description\":\"Club the Mammoth x Outfit are proud to present Bristol's Dreamwave.\\n\\nFREE ENTRY & LIMITED COLOUR VINYL EXCLUSIVELY AVAILABLE AT RELEASE SHOWS!\\n\\nFollowing up ‘Moon Dogs’ (EP - April 2025), a summer filled with festivals, and a sold out show at The Garage London supporting Frankie & The Witch Fingers, Dreamwave return with the announcement of ‘Drifter’ (via Stolen Body Records) the band's third EP since 2024. The effort sees the band double down on their exploration into the vast world of genres that fall under the ‘Neo- Psychedelia’ umbrella; usually pushing and pulling between Garage Rock and Dream Pop.\\n\\nSingles leading up to the EP have received praise across BBC 6 Music, various blogs and has earned a fan in Danger Mouse (Gnarls Barkley, Broken Bells) who added Dreamwave to his playlist ‘Danger Mouse Juke Box’. They have also shared stages with Radio Free Alice, Frankie & The Witch Fingers, The Bug Club, Wine Lips, The Limiñanas & Wombo.\\n\\nFFO — a must-listen for fans of early Thee Oh Sees, B-52’s, Frankie & The Witch Fingers\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69468ded739dc200018c4a7f\",\"name\":\"Dreamwave + Honest Work\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Dreamwave - Moon Buggy\",\"redirect_url\":\"https://open.spotify.com/track/0l4IH56m1D3qowSgpfgHNr\",\"artist\":\"Dreamwave\",\"preview_url\":\"https://p.scdn.co/mp3-preview/97f032837ea05291665e79bba72ba6f945203417?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Moon Buggy\"},{\"type\":\"apple_music\",\"title\":\"Dreamwave - Moon Buggy\",\"redirect_url\":\"https://music.apple.com/us/album/moon-buggy/1843117011?i=1843117012&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Dreamwave\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/dd/7c/fb/dd7cfba2-e925-1bb6-0b77-5ee101c05f16/mzaf_13036990991149799627.plus.aac.p.m4a\",\"track_name\":\"Moon Buggy\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Honest Work\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-10-10/a76b1e26-2b84-4279-a11a-ed752e2aae6c.jpg?rect=864%2C0%2C3456%2C3456\"},\"artist_id\":\"64538\",\"about\":null,\"is_headliner\":false},{\"name\":\"Dreamwave\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-03/df62baf3-c01c-4b18-956d-8858fd2e9707.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"54761\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"score\":0,\"max_tickets\":4,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-26T00:00:00+00:00\",\"sale_end_date\":\"2026-03-28T17:00:00+00:00\",\"sale_start_date\":\"2025-11-26T00:00:00+00:00\",\"event_start_date\":\"2026-03-28T19:30:00+00:00\",\"event_end_date\":\"2026-03-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":1980,\"name\":\"The 100 Club\",\"privacy_policy_link\":\"https://the100club.co.uk/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by The Pad Presents.\",\"seating\":null,\"announcement_date_unix\":1764115200,\"venues\":[{\"id\":\"66\",\"name\":\"The 100 Club\",\"address\":\"100 Oxford St, Fitzrovia, London W1D 1LL, UK\",\"location\":{\"lat\":51.5161551,\"lng\":-0.1353063999999904},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/35e8f238-d827-4132-8534-bc474249d988.jpg?rect=0%2C0%2C500%2C500\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-100-club-z997\",\"accessibility\":{\"url\":\"https://www.the100club.co.uk/access-info/#:~:text=The%20100%20Club%20is%20an,disabled%20customers%20to%20the%20venue.&text=There%20is%20level%20access%20from,or%20a%20lift%20on%20site.\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-28T19:30:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"14332\",\"name\":\"The Pad Presents\",\"image\":{\"url\":null},\"perm_name\":\"the-pad-presents-nvlp3\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"19a35eea7aa005ca:3\",\"date_unix\":1774726200,\"price\":{\"currency\":\"GBP\",\"amount\":2472,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/Ae0daf32a565?dice_id=Ae0daf32a565\",\"post_competition_referral\":\"https://link.dice.fm/zbe29112a090?dice_id=zbe29112a090\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Hb8a11f78edc?dice_id=Hb8a11f78edc\",\"post_purchase_referral\":\"https://link.dice.fm/w9843f15d0d5?dice_id=w9843f15d0d5\",\"post_reminder_referral\":\"https://link.dice.fm/V0809fdf3939?dice_id=V0809fdf3939\",\"post_waitinglist_referral\":\"https://link.dice.fm/Zf52bb9f9888?dice_id=Zf52bb9f9888\"},\"perm_name\":\"8erom5-evil-blizzard-28th-mar-the-100-club-london-tickets\",\"secondary_status\":\"waiting-list\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0cd7b9f-0a66-4ef9-a34e-f089d7bbd375.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0cd7b9f-0a66-4ef9-a34e-f089d7bbd375.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-26/a0cd7b9f-0a66-4ef9-a34e-f089d7bbd375.jpg?rect=270%2C0%2C660%2C1200\"},\"properties\":[],\"about\":{\"description\":\"Preston’s Evil Blizzard are truly an enigma. A mystery. A baffling conundrum. Three bass players, a guitarist, a singing drummer, an array of rubber masks that will give both children and adults sleepless nights for days on end, laying there, sweating, convulsing – they are the most ingenious and charismatic live experience on the music scene today. Evil Blizzard delve into many musical genres. From Krautrock to pop to even heavy dub. No genre is safe from their reach. But who are their influences? Who do they appeal to? Filthy Dirty explained in a recent interview. “People with more money than taste, ideally. We seem to have a similar appeal right across any genre; metal, indie, dance, goth, dub; you name it – we can annoy anyone. We could start a new ‘goth/dub’ genre. We’re the kings of Gub.” Opening for such diverse acts as Space, Sleaford Mods, Ruts DC, Gnod, Hawkwind, Killing Joke, Public Image Limited, Bo Ningen and Embrace. Blizzard have not only won over partisan crowds but have gone on to conquer such music festivals as Kendal Calling, Supersonic, Rebellion, The Great British Alternative Music Festival and The International Festival of Psychedelia in Liverpool. With a new album due in Spring 2026, it is time to once again get EVIL.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69272885fa5c0f00014a921b\",\"name\":\"Evil Blizzard\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Are You Evil?\",\"redirect_url\":\"https://open.spotify.com/track/0a1tlprGK3w8Nsks1P3jiz\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/59b97a82e11ca55a85c245f75d276ffc84225402?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Are You Evil?\"},{\"type\":\"apple_music\",\"title\":\"Evil Blizzard - Are You Evil?\",\"redirect_url\":\"https://music.apple.com/us/album/are-you-evil/1286467762?i=1286467768&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Evil Blizzard\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/91/c0/e1/91c0e18a-5e55-e81b-bd72-03dac1e395fe/mzaf_17580392778012742990.plus.aac.p.m4a\",\"track_name\":\"Are You Evil?\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Evil Blizzard\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b27319fae1e50daf9449cb94fe01\"},\"artist_id\":\"3390\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-24T00:00:00+00:00\",\"sale_end_date\":\"2026-03-28T18:30:00+00:00\",\"sale_start_date\":\"2025-11-24T00:00:00+00:00\",\"event_start_date\":\"2026-03-28T19:30:00+00:00\",\"event_end_date\":\"2026-03-28T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[{\"id\":96,\"name\":\"JaguarShoes Collective\",\"privacy_policy_link\":\"http://www.jaguarshoes.com/privacy-policy/\",\"fb_pixel_id\":\"429057253484103\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\