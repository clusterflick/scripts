ists\":[{\"name\":\"Le Junk\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-05-23/38a18901-4030-427e-92ed-6ecfab36a9e7.jpg?rect=0%2C0%2C2985%2C2985\"},\"artist_id\":\"20155\",\"about\":null,\"is_headliner\":false},{\"name\":\"Michael Georgian\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-04-23/20ed33fc-d8a7-44ed-9880-7efc0f9637c0.jpg?rect=0%2C0%2C1464%2C1464\"},\"artist_id\":\"25521\",\"about\":null,\"is_headliner\":false},{\"name\":\"Debdepan\",\"image\":null,\"artist_id\":\"57581\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1769688000,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":0,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[{\"type\":\"spotify\",\"title\":\"Le Junk - Rich Romance\",\"redirect_url\":\"https://open.spotify.com/track/278aQB58ZO8MADRdEvylfk\",\"artist\":\"Le Junk\",\"preview_url\":\"https://p.scdn.co/mp3-preview/d809028c15117ecdd286d418c1ca9b5e0ee2817e?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Rich Romance\"},{\"type\":\"apple_music\",\"title\":\"Le Junk - Rich Romance\",\"redirect_url\":\"https://music.apple.com/gb/album/rich-romance/1512819857?i=1512819859&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Le Junk\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview123/v4/c1/41/d5/c141d55b-81c9-5954-c1fd-23bfd2dbb9a3/mzaf_13093520068216514627.plus.aac.p.m4a\",\"track_name\":\"Rich Romance\"}],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T12:00:00+00:00\",\"sale_end_date\":\"2026-02-20T20:00:00+00:00\",\"sale_start_date\":\"2026-01-15T12:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Brixton Jamm.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/yafcef1e4d81?dice_id=yafcef1e4d81\",\"post_competition_referral\":\"https://link.dice.fm/U5a693dfed15?dice_id=U5a693dfed15\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h72f25c7c897?dice_id=h72f25c7c897\",\"post_purchase_referral\":\"https://link.dice.fm/m7d34d4d4849?dice_id=m7d34d4d4849\",\"post_reminder_referral\":\"https://link.dice.fm/Bc9feaed5c1b?dice_id=Bc9feaed5c1b\",\"post_waitinglist_referral\":\"https://link.dice.fm/v259117bc5e0?dice_id=v259117bc5e0\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Los 4 Live in the UK!\\n\\nFor the first time ever, straight from Havana, Cuba, the pioneers of cubaton — Los 4 — are landing in London for an unforgettable night of high-energy Latin rhythms, tropical vibes, and pure Cuban fire 🔥\\n\\n📍 Brixton Jamm, London\\n\\n📅 Friday 20th February 2026\\n\\n🕖 Doors open at 7PM\\n\\n🎟️ Tickets from £40 – Limited availability!\\n\\nGet ready to dance all night to the explosive sound that’s taken Cuba and the world by storm. Fusing the heat of reggaeton with the soulful grooves of Cuban timba, Los 4 created their own unique sound — Cubaton — a rhythm that moves both body and soul.\\n\\nFormed in 2009 by rapper Jorge “Jorgito” Junior, the group rose from the legacy of legendary band Eddy-K..\\n\\nKnown for their electric live performances, powerful stage presence, and the unmistakable sound of Havana’s streets, Los 4 have toured across the world — and now they’re finally bringing the party to London!\\n\\nThis is more than a concert — it’s a Cuban experience. Expect irresistible beats, non-stop dancing, and pure Havana heat all night long.\\n\\nOnline tickets available now. Don’t delay — secure your spot today!\\n\\n🎫 Don’t miss history in the making – this event will sell out fast!\\n\\n👉 Secure your tickets now and be part of Los 4’s first-ever UK show!\\n\\nThis one party you’ll be talking about all year. Grab your tickets now before they’re gone!\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"address\":\"261 Brixton Rd, London SW9 6LH\",\"location\":{\"lat\":51.4709902,\"lng\":-0.112441100000069},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/f7441ba7-e272-4e0e-b7da-04a2804f9273.jpg?rect=0%2C0%2C300%2C300\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"brixton-jamm-zk8z\",\"accessibility\":{\"url\":\"https://brixtonjamm.org/faq/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":49,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:41\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"4\",\"name\":\"Brixton Jamm\",\"image\":{\"url\":null},\"perm_name\":\"brixton-jamm-zk8z\",\"profile_active\":false},\"id\":\"6968d4c79c0ffc000129ea55\",\"name\":\"Los 4\",\"perm_name\":\"k6aoal-los-4-20th-feb-brixton-jamm-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-15/80262fc6-4287-4a42-8a41-80679f50aaf7.jpg?rect=0%2C0%2C842%2C842\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-15/80262fc6-4287-4a42-8a41-80679f50aaf7.jpg?rect=0%2C169%2C842%2C505\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-15/80262fc6-4287-4a42-8a41-80679f50aaf7.jpg?rect=190%2C0%2C463%2C842\"},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Los 4\",\"image\":null,\"artist_id\":\"132436\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"announcement_date_unix\":1768478400,\"faqs\":[],\"price\":{\"currency\":\"GBP\",\"amount\":4400,\"sales_tax\":0,\"amount_from\":null},\"has_multiple_ticket_types\":false,\"seating\":null,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-07T00:00:00+00:00\",\"sale_end_date\":\"2026-02-20T18:00:00+00:00\",\"sale_start_date\":\"2026-01-07T00:00:00+00:00\",\"event_start_date\":\"2026-02-20T19:00:00+00:00\",\"event_end_date\":\"2026-02-20T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"presented_by\":\"Presented by Morocco Bound.\",\"is_ticket_available_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/n0df87b809d7?dice_id=n0df87b809d7\",\"post_competition_referral\":\"https://link.dice.fm/qb4f9f151bbb?dice_id=qb4f9f151bbb\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/X8781a661a98?dice_id=X8781a661a98\",\"post_purchase_referral\":\"https://link.dice.fm/Rd9c0b487dd3?dice_id=Rd9c0b487dd3\",\"post_reminder_referral\":\"https://link.dice.fm/j3d9c70dbe0b?dice_id=j3d9c70dbe0b\",\"post_waitinglist_referral\":\"https://link.dice.fm/U502f7a1eb5a?dice_id=U502f7a1eb5a\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"**Ella Clayton**  \\n  \\nBorn and raised in London, Ella Clayton released her debut album Murmurations in 2022, a deeply personal collection of songs that established her as a rising voice in the UK’s indie-folk scene. The record was followed in 2023 by Stairwell, a stripped-back acoustic EP recorded in a three-story stairwell, capturing the raw intimacy of her live sound.\\n\\nProducer Lester Duval (Pip Millet, Odd910) and Ella decided to record the backbone of the album live to capture the raw energy and connection between musicians Ella on vocals, Lester on bass, Fabio De Oliveira on drums and percussion, Alex Crawford on guitar. George Ezra invited them to his studio Hotel Quebec, and in three days, the album was brought into being.  \\n  \\n**Edie Bens**  \\n  \\nRising Welsh singer-songwriter Edie Bens has an undeniable talent for classic songwriting with candid charm when taking delicate stories from her travels with her band. Inspired by artists like Bruce Springsteen, Maggie Rogers and Holly Humberstone, Edie began writing her own songs when she was just 10 years old. Edie has spent the past year writing and collaborating with Flyte, Benjamin Francis Leftwich, Josh Scarbrow (Arlo Parks), Jonny Coffer (FKA Twigs), Burke Reid (Courtney Barnett) and performing alongside Richy Mitch And The Coal Miners, COIN, Howl & The Hum, Tom Walker & KT Tunstall.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[],\"date_unix\":1771614000,\"venues\":[{\"id\":\"13583\",\"name\":\"Morocco Bound\",\"address\":\"1a Morocco Street, Southwark, London, SE1 3HB, United Kingdom\",\"location\":{\"lat\":51.50033,\"lng\":-0.082},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"count