st_purchase_referral\":\"https://link.dice.fm/cc2c8ac18083?dice_id=cc2c8ac18083\",\"post_reminder_referral\":\"https://link.dice.fm/q6d598e4eb75?dice_id=q6d598e4eb75\",\"post_waitinglist_referral\":\"https://link.dice.fm/bf622cf6fa00?dice_id=bf622cf6fa00\"},\"perm_name\":\"nvwmw3-the-butterfly-wheel-red-hash-cormac-russell-31st-mar-paper-dress-vintage-london-tickets\",\"secondary_status\":\"rescheduled\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-24/b4be5bbe-4c0c-4919-98a6-0c9cb75358c4.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-24/b4be5bbe-4c0c-4919-98a6-0c9cb75358c4.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-24/b4be5bbe-4c0c-4919-98a6-0c9cb75358c4.jpg?rect=243%2C0%2C594%2C1080\"},\"properties\":[],\"about\":{\"description\":\"The Butterfly Wheel proudly present the launch of their brand-new EP — a powerful unveiling of four freshly recorded tracks that mark the beginning of a new musical era.\\n\\nThis special night celebrates the official release of the EP and offers an exclusive glimpse into the songs that will shape their forthcoming full-length album, arriving in 2026. It will be the only live preview of these new recordings before their release — a moment the band have been eagerly waiting to share.\\n\\nJoin us for an immersive evening of psychedelic rock, mythic atmospheres and cinematic soundscapes — live at Paper Dress Vintage, Hackney, London — as The Butterfly Wheel step into a new creative cycle with raw emotion, mystical storytelling and transportive performances.\\n\\nWe’re honoured to be joined by Cormac Russell, whose heartfelt, soulful and poetic songwriting will set the tone for the night as special guest support.\\n\\nWe’re also thrilled to welcome Red Hash Band, lighting up the stage with their rising psychedelic underground sound — the perfect energy to launch the evening into another realm.\\n\\nThis is our EP launch, and we are deeply excited to release the new tracks that will form the heart of our upcoming 2026 album. Come witness the next chapter unfold — within one of London’s most beloved independent venues.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"6924bc9af61e420001d1a8a7\",\"name\":\"The Butterfly Wheel + Red Hash + Cormac Russell \",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":3},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Tue 31 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-23T00:00:00+00:00\",\"sale_end_date\":\"2026-04-01T17:00:00+01:00\",\"sale_start_date\":\"2025-12-23T00:00:00+00:00\",\"event_start_date\":\"2026-04-01T18:00:00+01:00\",\"event_end_date\":\"2026-04-01T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by New Cross Live.\",\"seating\":null,\"announcement_date_unix\":1766448000,\"venues\":[{\"id\":\"1641\",\"name\":\"New Cross Inn\",\"address\":\"New Cross Inn, 323 New Cross Rd, London SE14 6AS, UK\",\"location\":{\"lat\":51.4757899,\"lng\":-0.037162699999953475},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-13/ba29f2fe-617e-4542-80b7-6e2529031d70.jpg?rect=0%2C0%2C225%2C225\"},\"city\":{\"id\":\"54d8a