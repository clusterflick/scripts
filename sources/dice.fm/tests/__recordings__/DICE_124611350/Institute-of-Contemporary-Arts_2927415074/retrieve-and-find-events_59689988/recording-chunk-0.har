d\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"Ella Raphael is blessed with an amazing voice; a woozy, bluesy, euphoric sound that’s filled with warmth and emotion. Brought up on Elvis, Ella Fitzgerald and Edith Piaf her travels in the UK, US, Australia and Spain have refined that eclectic mix, adding The Shirelles, Julee Cruise, Love, Serge Gainsbourg, Karen Dalton (to whom her lilting vocal occasionally recalls), ESG, Broadcast, Vashti Bunyan, Catherine Ribeiro + Alpes, the original masters of Tropicalia, exotic 50s guitars and the more esoteric sounds of The Beatles.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345119\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false},{\"id\":2439,\"name\":\"MOTH Club\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":\"2195325970769692\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\