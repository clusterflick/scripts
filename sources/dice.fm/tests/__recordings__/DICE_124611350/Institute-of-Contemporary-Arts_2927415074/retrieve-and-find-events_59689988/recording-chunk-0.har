 Grandad \",\"image\":null,\"artist_id\":\"129112\",\"about\":null,\"is_headliner\":false},{\"name\":\"Cherryholt\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb11a7a946838527c208477e3b\"},\"artist_id\":\"129163\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"LONGWAVE at The Phoenix Arts Club. For the \\\"I was there when...\\\" moments. Hosted by Dora DB. Showcasing the best and brightest new musical talents along with special guest DJs. In one of the UK's most iconic live venues. Show starts at 7:30PM sharp.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-02T00:00:00+00:00\",\"sale_end_date\":\"2026-02-27T19:30:00+00:00\",\"sale_start_date\":\"2026-02-02T00:00:00+00:00\",\"event_start_date\":\"2026-02-27T18:30:00+00:00\",\"event_end_date\":\"2026-02-27T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6980f71a53a26700016ad06f\",\"name\":\"LONGWAVE\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-10/c3d537b7-26bf-4a8b-892e-1cd5e263935a.jpg?rect=0%2C0%2C1200%2C1200\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-10/c3d537b7-26bf-4a8b-892e-1cd5e263935a.jpg?rect=0%2C240%2C1200%2C720\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-10/c3d537b7-26bf-4a8b-892e-1cd5e263935a.jpg?rect=270%2C0%2C660%2C1200\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1769990400,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/J43ac6845f1d?dice_id=J43ac6845f1d\",\"post_competition_referral\":\"https://link.dice.fm/X867b4d58331?dice_id=X867b4d58331\",\"post_purch