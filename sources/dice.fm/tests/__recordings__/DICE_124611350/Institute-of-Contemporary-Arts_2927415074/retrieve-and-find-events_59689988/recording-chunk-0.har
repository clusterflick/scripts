\"},{\"type\":\"apple_music\",\"title\":\"The Hellp - Here I Am\",\"redirect_url\":\"https://music.apple.com/us/album/here-i-am/1845205215?i=1845205471&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"The Hellp\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/3f/15/df/3f15dfd0-fafe-f6d1-ce50-12d8bbe928a3/mzaf_11149334950744620525.plus.aac.p.m4a\",\"track_name\":\"Here I Am\"},{\"type\":\"trailer\",\"title\":null,\"redirect_url\":null,\"artist\":\"\",\"preview_url\":\"https://stream.mux.com/8WQsoT3GIB3Ll6UXCaI6Nqeqitt59aNNtiiWm5lBBaU.m3u8\",\"track_name\":\"\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1764082800,\"max_tickets\":6,\"marketeers\":[{\"id\":818,\"name\":\"HERE at Outernet\",\"privacy_policy_link\":\"https://hereldn.com/privacy-policy/\",\"fb_pixel_id\":\"1415783946118882\",\"ga_tracking_id\":\"G-QH4NRPEYW3\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"sold-out\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"The Hellp are an American indie-electronic band pushing sonic boundaries with a never-ending evolution and a refusal to be confined to any one genre or audience. Connected through fashion—Dillon as a celebrated photographer and Lucy as a model—they’ve forged their own brand of electroslash chaos. Rising from working-class roots through grit and a shared artistic vision, they’ve become key figures in modern music. Their high-energy shows, genre-blurring productions, and meticulous attention to detail have earned them a cult following. From odd jobs, to fashion’s favorites, to today, on the pages of PAPER, Pitchfork, Complex, The FACE, & more — The Hellp aren’t just setting trends, they’re ushering in the next generation of rockstar.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"14+ (U16’s must be accompanied by an adult) - physical photo ID required\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by WME\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:44\",\"social_links\":{\"event_share\":\"https://link.dice.fm/B1bf21bc72a3?dice_id=B1bf21bc72a3\",\"post_competition_referral\":\"https://link.dice.fm/p2d13bfd5d26?dice_id=p2d13bfd5d26\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/u46ba6db22da?dice_id=u46ba6db22da\",\"post_purchase_referral\":\"https://link.dice.fm/Ke0867ddb4c1?dice_id=Ke0867ddb4c1\",\"post_reminder_referral\":\"https://link.dice.fm/o736e77ecbd5?dice_id=o736e77ecbd5\",\"post_waitinglist_referral\":\"https://link.dice.fm/N5e336dc621d?dice_id=N5e336dc621d\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T15:00:00+00:00\",\"sale_end_date\":\"2026-03-18T19:00:00+00:00\",\"sale_start_date\":\"2025-11-26T10:00:00+00:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":\"waiting-list\",\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2805},\"properties\":[],\"billing_promoter\":{\"id\":\"8466\",\"name\":\"Outernet Venue Ltd\",\"image\":{\"url\":null},\"perm_name\":\"outernet-venue-ltd-96a7\",\"profile_active\":true},\"id\":\"691ef45ecaef440001baefce\",\"seats_io_event_id\":null,\"name\":\"The Hellp \",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"oeq3rg-the-hellp-18th-mar-here-at-outernet-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5071\",\"name\":\"Piano Smithfield\",\"address\":\"14 Long Ln, Barbican, London EC1A 9PN, UK\",\"location\":{\"lat\":51.5197837,\"lng\":-0.0989723},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"piano-smithfield-oxa5\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Matt Kent\",\"image\":null,\"artist_id\":\"74054\",\"about\":null,\"is_headliner\":false},{\"name\":\"Matt Kent\",\"image\":null,\"artist_id\":\"74054\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":3},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-16/b0f7caf3-669c-4471-b79e-f4f94a3e3bef.jpg?rect=1000%2C0%2C4000%2C4000\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-16/b0f7caf3-669c-4471-b79e-f4f94a3e3bef.jpg?rect=0%2C200%2C6000%2C3600\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-16/b0f7caf3-669c-4471-b79e-f4f94a3e3bef.jpg?rect=1900%2C0%2C2200%2C4000\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Kiki Annette - Icarus\",\"redirect_url\":\"https://open.spotify.com/track/64y45jc2xYmy7m7VP78MVB\",\"artist\":\"Kiki Annette\",\"preview_url\":\"https://p.scdn.co/mp3-preview/365ab1b8cd6911e5c57b375c7119cd18c75d375d?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Icarus\"},{\"type\":\"apple_music\",\"title\":\"Kiki Annette - Icarus\",\"redirect_url\":\"https://music.apple.com/us/album/icarus/1867172998?i=1867172999&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Kiki Annette\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/a5/86/14/a5861448-1f3f-bcf1-54fb-f3d293d2694d/mzaf_9335215820683295830.plus.aac.p.m4a\",\"track_name\":\"Icarus\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1771200000,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**Kiki Annette** writes like a cinephile dreams - in slow dissolves, quiet devastations and dialogue echoing long after the credits roll. With her velvet voice, Kiki traces the emotional contours of girlhood, grief and glamour on top of raw baritone guitar riﬀs and cinematic arrangements. Imagine Florence Welch with an all-black wardrobe and you're basically halfway there\\n\\nRecognized by London Jazz News for his “vocal quality, confidence, and ease on stage,” **Matt Kent** is carving out a distinctive space in pop music. His viral series Turning Classical Music into Pop Songs has amassed over 40 million views on TikTok, building a loyal audience of more than 300,000 followers across platforms. Kent’s releases have surpassed 15 million streams, establishing him as one of the most compelling crossover voices emerging from London’s live music scene. Kent’s songwriting and performance have earned recognition in international competitions including The Coffee Music Project, A Singing Heart (hosted by New York Encounter), and the Gwangju Busking World Cup. In collaboration with pianist and songwriter Liv Lester, Kent has performed at iconic venues including Ronnie Scott’s, The Bedford, and The Bitter End. The duo previously opened for James Bay at CarFest South following recognition from UK radio host Chris Evans.\\n\\nWith singer-songwriter **Maya** opening the night.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Success Express.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:45\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Y67a43e52e5c?dice_id=Y67a43e52e5c\",\"post_competition_referral\":\"https://link.dice.fm/fba09c6a9607?dice_id=fba09c6a9607\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/W15e84d2ad17?dice_id=W15e84d2ad17\",\"post_purchase_referral\":\"https://link.dice.fm/u2561347e0dc?dice_id=u2561347e0dc\",\"post_reminder_referral\":\"https://link.dice.fm/k171290891c4?dice_id=k171290891c4\",\"post_waitinglist_referral\":\"https://link.dice.fm/p4fbef16304a?dice_id=p4fbef16304a\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-16T00:00:00+00:00\",\"sale_end_date\":\"2026-03-18T21:30:00+00:00\",\"sale_start_date\":\"2026-02-16T00:00:00+00:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T22:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1300,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"5755\",\"name\":\"Success Express\",\"image\":{\"url\":null},\"perm_name\":\"success-express-7a9b\",\"profile_active\":true},\"id\":\"6993939493c72200015f53ab\",\"seats_io_event_id\":null,\"name\":\"Kiki Annette, Matt Kent x Liv Lester, Maya\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"l89ebx-kiki-annette-matt-kent-x-liv-lester-maya-18th-mar-piano-smithfield-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Cardboard\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-04-08/d9a3cee3-9a87-464d-a002-32b860ed359f.jpg?rect=0%2C53%2C535%2C535\"},\"artist_id\":\"48875\",\"about\":null,\"is_headliner\":false},{\"name\":\"Flytrap\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb419df538c0d025fbc901bad5\"},\"artist_id\":\"49538\",\"about\":null,\"is_headliner\":false},{\"name\":\"Bang Mary\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebc6a06c9382d1ab23d3aa64a4\"},\"artist_id\":\"125760\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"faqs\":[{\"id\":76276,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/41d09ea2-1563-430d-ae74-d09a17c883fe.jpg?rect=0%2C0%2C2135%2C2135\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/41d09ea2-1563-430d-ae74-d09a17c883fe.jpg?rect=0%2C427%2C2135%2C1281\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/41d09ea2-1563-430d-ae74-d09a17c883fe.jpg?rect=481%2C0%2C1174%2C2135\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770890400,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Introducing... Swinging From The Chandelier.\\n\\nA new gig series at The Lexington bringing the most exciting, lively, raucous new bands to our North London stage.\\n\\nCreated by Alice behind the bar, expect to experience energy in all its forms with a DIY edge, from bands that get you shifting and leave your ears ringing.\\n\\n\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\\\*\\n\\n#1\\n\\nKicking off our big sweaty launch party in style:\\n\\nBANG MARY - A noisy punch in the mouth to get things started\\n\\nFLYTRAP - Enigmatic travellers of time, genre and dynamics\\n\\nFEASTS - Urgent Nowrich post-punk duo that know how to own a stage\\n\\nCARDBOARD - Indie-punks taking over the circuit with the release of their debut album last year\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Swinging from the Chandelier Presents.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:46\",\"social_links\":{\"event_share\":\"https://link.dice.fm/q93c7512c410?dice_id=q93c7512c410\",\"post_competition_referral\":\"https://link.dice.fm/hba82af510e5?dice_id=hba82af510e5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/S13db2dbdfe7?dice_id=S13db2dbdfe7\",\"post_purchase_referral\":\"https://link.dice.fm/Uc9ceecf8a82?dice_id=Uc9ceecf8a82\",\"post_reminder_referral\":\"https://link.dice.fm/R29bf51ab673?dice_id=R29bf51ab673\",\"post_waitinglist_referral\":\"https://link.dice.fm/Hd8083b13316?dice_id=Hd8083b13316\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-12T10:00:00+00:00\",\"sale_end_date\":\"2026-03-18T19:30:00+00:00\",\"sale_start_date\":\"2026-02-12T10:00:00+00:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":660},\"properties\":[],\"billing_promoter\":{\"id\":\"2420\",\"name\":\"The Lexington\",\"image\":{\"url\":null},\"perm_name\":\"the-lexington-dvvo\",\"profile_active\":true},\"id\":\"698cadca04e39d00013bb200\",\"seats_io_event_id\":null,\"name\":\"SFTC #1: Cardboard, Feasts, Flytrap, Bang Mary\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"v39mgd-sftc-1-cardboard-feasts-flytrap-bang-mary-18th-mar-the-lexington-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"5484\",\"name\":\"Next Door Records\",\"address\":\"304 Uxbridge Rd, London W12 7LJ, UK\",\"location\":{\"lat\":51.5063731,\"lng\":-0.2315609},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"next-door-records-qgaa\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":true,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ba3bf5-e7c8-4543-8dfc-4ca4aa132801.jpg?rect=0%2C504%2C3024%2C3024\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ba3bf5-e7c8-4543-8dfc-4ca4aa132801.jpg?rect=0%2C1109%2C3024%2C1814\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-09/b0ba3bf5-e7c8-4543-8dfc-4ca4aa132801.jpg?rect=403%2C0%2C2218%2C4032\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1770595200,\"max_tickets\":6,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Noam Solomons-Wise is an award-winning composer, drummer and improviser from London. Noam was the winner of the 2025 Dankworth prize (small band category), and a semi-finalist of BBC Young Jazz Musician 2022. He is establishing his voice as a composer and improviser on the London jazz scene after completing his undergraduate in music at the University of Cambridge. He currently studies at the Royal Academy of Music. Noam has performed at venues across London and Cambridge including at the Vortex jazz club, and at Cambridge Jazz Festival, and is a member of several projects in London spanning a variety of genres: jazz, alt rock, folk, synth-pop, and free-jazz. On the 18th March he will bring the first line-up of his London project who will play a selection of Noam’s originals.\\n\\nFor a taste of Noam’s music, you can listen to ‘The Lost Shore’ here: https://youtu.be/Hf5d2qAfkyo\\n\\nLine-up:\\n\\nNoam Solomons-Wise (drums and composition)\\n\\nElliot Wong (alto saxophone)\\n\\nCameron Scott (euphonium)\\n\\nLaurie Rich (piano)\\n\\nZaki Osahn (double bass)\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Next Door Records.\",\"streaming_options\":null,\"impression_id\":\"67e592f56c886db9:47\",\"social_links\":{\"event_share\":\"https://link.dice.fm/E2dc0a3370ed?dice_id=E2dc0a3370ed\",\"post_competition_referral\":\"https://link.dice.fm/ec4ea059e887?dice_id=ec4ea059e887\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Hf8871e59ded?dice_id=Hf8871e59ded\",\"post_purchase_referral\":\"https://link.dice.fm/y84a29bf996a?dice_id=y84a29bf996a\",\"post_reminder_referral\":\"https://link.dice.fm/M902325023e4?dice_id=M902325023e4\",\"post_waitinglist_referral\":\"https://link.dice.fm/Ldbe7b6cabe2?dice_id=Ldbe7b6cabe2\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-09T00:00:00+00:00\",\"sale_end_date\":\"2026-03-18T19:00:00+00:00\",\"sale_start_date\":\"2026-02-09T00:00:00+00:00\",\"event_start_date\":\"2026-03-18T19:00:00+00:00\",\"event_end_date\":\"2026-03-18T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":663},\"properties\":[],\"billing_promoter\":{\"id\":\"7075\",\"name\":\"Next Door Records\",\"image\":{\"url\":null},\"perm_name\":\"next-door-records-lnvx\",\"profile_active\":false},\"id\":\"6989df6a17306f0001040456\",\"seats_io_event_id\":null,\"name\":\"NJSW Quintet\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"bb8pmo-njsw-quintet-18th-mar-next-door-records-london-tickets\",\"date_unix\":1773860400,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":6},\"venues\":[{\"id\":\"84\",\"name\":\"The Dome\",\"address\":\"2A Dartmouth Park Hill, London NW5 1HL\",\"location\":{\"lat\":51.5579086,\"lng\":-0.139039799999978},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-dome-jq5a\",\"accessibility\":{\"url\":\"https://domelondon.co.uk/faq\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-18T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Jehnny Beth\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb90b5e4535f1ee55645038536\"},\"artist_id\":\"17760\",\"about\":{\"description\":\"After her start as the lead singer in English post-punk band Savages, French musician and vocalist Jehnny Beth launched her solo career with Nine Inch Nails-produced debut album To Love Is To Live in 2020. The project showed Beth’s grasp on rock and her ability to exist comfortably in contrasts; veering from tender piano ballads to hardcore metal, while keeping her feminist themes of sexual exploration and empowerment at the centre of each song. Her career is full of wide-ranging collaborations, including Joe Talbot, Gorillaz, Romy from The xx and FLOOD.\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-29/3f688c3d-00c0-4090-a3ba-e79b807c7549.jpg?rect=0%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-