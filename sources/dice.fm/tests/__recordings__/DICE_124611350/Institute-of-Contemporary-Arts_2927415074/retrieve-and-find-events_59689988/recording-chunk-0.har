extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest\",\"seating\":null,\"announcement_date_unix\":1755817200,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"hot-box-r7wq\",\"accessibility\":{\"url\":\"https://www.hotboxlive.co.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-06T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"4307\",\"name\":\"Hot Box Live Community Interest \",\"image\":{\"url\":null},\"perm_name\":\"hot-box-live-community-interest-7v77\",\"profile_active\":false},\"has_multiple_ticket_types\":false,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:93\",\"date_unix\":1786039200,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"social_links\":{\"event_share\":\"https://link.dice.fm/n548b9c69db5?dice_id=n548b9c69db5\",\"post_competition_referral\":\"https://link.dice.fm/Aff32c9153ff?dice_id=Aff32c9153ff\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/vea9c05c76e0?dice_id=vea9c05c76e0\",\"post_purchase_referral\":\"https://link.dice.fm/Efc1e2c41a97?dice_id=Efc1e2c41a97\",\"post_reminder_referral\":\"https://link.dice.fm/H23d3b651299?dice_id=H23d3b651299\",\"post_waitinglist_referral\":\"https://link.dice.fm/O39a7c21d326?dice_id=O39a7c21d326\"},\"perm_name\":\"k6rlo8-heathen-apostles-ft-chopper-from-the-cramps-6th-aug-hot-box-chelmsford-tickets\",\"secondary_status\":\"rescheduled\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-02/438bc247-2a9f-49db-876b-5f9d8515450d.jpg?rect=471%2C0%2C2059%2C2059\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-02/438bc247-2a9f-49db-876b-5f9d8515450d.jpg?rect=0%2C130%2C3000%2C1800\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-02/438bc247-2a9f-49db-876b-5f9d8515450d.jpg?rect=934%2C0%2C1132%2C2059\"},\"properties\":[],\"about\":{\"description\":\"Born of the voices of past lives and baptized in the dust bowl dirt, the Gothic Americana music of the Heathen Apostles harkens back to a bygone chapter of American history. Using contrasting influences such as Bauhaus, Nick Cave & the Bad Seeds and The Pogues along with Howlin’ Wolf, Loretta Lynn (the band covers her classic Fist City) and Bessie Smith, the Heathen Apostles have created a style of music that will conjure both angels and demons, and will enlighten a darkened soul.\\n\\nForming the band together in 2013, Mather Louth (Radio Noir) and rock n roll veteran Chopper Franklin (The Cramps, Mau Maus, Nick Curran & the Lowlifes) quickly uncovered a mutual appreciation for murder balladry, Americana, and memento mori. The landscape was further tilled with the addition of Luis Mascaro on violin.\\n\\nTheir 6 critically acclaimed albums, along with their many EPs and singles (their release The Fall was named Best EP of 2018 by Folk n Rock magazine), capture the essence of the Heathen Apostles modus operandi: Southern Gothic Americana imagery surrounded by haunting, minor-chord melodies, musical influences including Gothic Roots music, Bluegrass, Blues, and Gypsy Jazz, all deftly bound together by the band’s dark and sometimes brooding sense of a bygone age. Most recently, the band completed tours of both mainland Europe as well as the UK in support of their latest release, The In Between, with plans to return for two tours in 2026 in support of their forthcoming EP.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"68a883967b7fef000111a3d4\",\"name\":\"HEATHEN APOSTLES ft Chopper from The Cramps\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Heathen Apostles - Paint the Stars\",\"redirect_url\":\"https://open.spotify.com/track/1F5qZNTSzN07XWwD3HOt2v\",\"artist\":\"Heathen Apostles\",\"preview_url\":\"https://p.scdn.co/mp3-preview/94d5bd1697eed2bffa868a0c3cb75fd079dd2a02?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Paint the Stars\"},{\"type\":\"apple_music\",\"title\":\"Heathen Apostles - Paint the Stars\",\"redirect_url\":\"https://music.apple.com/us/album/paint-the-stars/1384834598?i=1384835171&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Heathen Apostles\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/1e/6f/a8/1e6fa8ad-ebb3-ab84-f163-ee850ab52565/mzaf_3584734353575693447.plus.aac.p.m4a\",\"track_name\":\"Paint the Stars\"}],\"unicorn\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Heathen Apostles\",\"image\":null,\"artist_id\":\"119121\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-15T12:00:00+00:00\",\"sale_end_date\":\"2026-08-06T21:00:00+01:00\",\"sale_start_date\":\"2026-01-16T10:00:00+00:00\",\"event_start_date\":\"2026-08-06T19:30:00+01:00\",\"event_end_date\":\"2026-08-06T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[{\"id\":69386,\"title\":\"What are the ages restrictions for this event?\",\"body\":\"This is a 16+ event. Each under 18 must be accompanied by a responsible adult (1:1 ratio). Customers may be requested to provide valid physical photo ID upon entry, this is to ensure customer safety and ensure our legal age requirements are met. For this reason, we request that all customers bring valid ID. Digital or photocopied ID will not be accepted. For further information see Age and ID in FAQ’s. Right of admission reserved.\",\"order\":0}],\"marketeers\":[{\"id\":854,\"name\":\"Village Underground\",\"privacy_policy_link\":\"https://villageunderground.co.uk/privacy-policy/\",\"fb_pixel_id\":\"574810874256593\",\"ga_tracking_id\":\"G-TTMX0FS0EH\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"SOfECKivg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1496,\"name\":\"Como No\",\"privacy_policy_link\":\"https://www.comono.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1012760396803642\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Como No.\",\"seating\":null,\"announcement_date_unix\":1768478400,\"venues\":[{\"id\":\"835\",\"name\":\"Village Underground\",\"address\":\"54 Holywell Lane, London EC2A 3PQ, UK\",\"location\":{\"lat\":51.5234726,\"lng\":-0.07799529999999777},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/5b7b8372-c6a3-4dfa-ad59-4bfaabe94ddc.jpg?rect=317%2C0%2C1365%2C1365\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"village-underground-wwop\",\"accessibility\":{\"url\":\"https://bit.ly/3EhSLgF\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-06T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"11556\",\"name\":\"Village Underground\",\"image\":{\"url\":null},\"perm_name\":\"village-underground-n5v8\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:94\",\"date_unix\":1786041000,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2987},\"social_links\":{\"event_share\":\"https://link.dice.fm/K13d6ea306ad?dice_id=K13d6ea306ad\",\"post_competition_referral\":\"https://link.dice.fm/Icb57c2c92e8?dice_id=Icb57c2c92e8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/uad3cf079e2f?dice_id=uad3cf079e2f\",\"post_purchase_referral\":\"https://link.dice.fm/cbb6a765dd2e?dice_id=cbb6a765dd2e\",\"post_reminder_referral\":\"https://link.dice.fm/Jd0ad5abab3a?dice_id=Jd0ad5abab3a\",\"post_waitinglist_referral\":\"https://link.dice.fm/j2950b63bbdb?dice_id=j2950b63bbdb\"},\"perm_name\":\"yo67ep-ebony-6th-aug-village-underground-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-14/e25a7d53-622f-4513-817a-d2507bcf84ab.jpg?rect=0%2C0%2C2480%2C2480\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-14/e25a7d53-622f-4513-817a-d2507bcf84ab.jpg?rect=0%2C1010%2C2480%2C1488\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-14/e25a7d53-622f-4513-817a-d2507bcf84ab.jpg?rect=276%2C0%2C1929%2C3508\"},\"properties\":[],\"about\":{\"description\":\"Ebony, at 25, is one of the leading voices of female rap in Brazil, with her songs reaching the top of the Spotify charts and her live shows featured at major festivals across the country.\\n\\nBorn and raised in Queimados, Rio de Janeiro, Ebony had an upbringing which, to this day, affects her songwriting style. As a Black child adopted by white religious parents, growing up in what used to be one of Rio de Janeiro’s most dangerous neighbourhoods, navigating between the streets, the church, abuse, and an introspective eccentricity, the stories Ebony tells are some of the most captivating in Brazilian hip hop.\\n\\nHer breakout track “Pensamentos Intrusivos” reached #1 on Brazil’s Spotify Viral Chart, with multiple releases placing across national charts. She has performed live at the Multishow Awards, Brazil’s main music awards ceremony, and appeared on the cover of ELLE Brazil, as well as becoming the first Brazilian female rapper to cover Galore Magazine.\\n\\nDon’t miss Ebony’s London debut, her first UK show to date.\\n\\nIf you have any queries or would like more information about access at Village Underground, please see our FAQs here: https://bit.ly/3EhSLgF, or contact access@villageunderground.co.uk.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null}]},\"id\":\"69677330c5db31000181591e\",\"name\":\"Ebony\",\"shopping_cart_enabled\":true,\"new\":false,\"previews\":[{\"type\":\"spotify\",\"title\":\"Ebony - Extraordinária\",\"redirect_url\":\"https://open.spotify.com/track/3WC5FPpPuiU8eauNnyY8dK\",\"artist\":\"Ebony\",\"preview_url\":\"https://p.scdn.co/mp3-preview/6d59730f0802597ee356140e1022d38aafcd006a?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Extraordinária\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ebony\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb07f2470fe2912086a7fd0aae\"},\"artist_id\":\"132449\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null}],\"title\":\"Thu 06 Aug\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-11-25T12:20:00+00:00\",\"sale_end_date\":\"2026-08-06T16:00:00+01:00\",\"sale_start_date\":\"2025-11-25T13:00:00+00:00\",\"event_start_date\":\"2026-08-07T13:30:00+01:00\",\"event_end_date\":\"2026-08-07T22:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Krankbrother.\",\"seating\":null,\"announcement_date_unix\":1764073200,\"venues\":[{\"id\":\"1265\",\"name\":\"Finsbury Park\",\"address\":\"Finsbury Park, London N4, UK\",\"location\":{\"lat\":51.563296,\"lng\":-0.1074350000000095},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"finsbury-park-x9wa\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-07T13:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"1599\",\"name\":\"Krankbrother\",\"image\":{\"url\":null},\"perm_name\":\"krankbrother-lqdb\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:95\",\"date_unix\":1786105800,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":7478},\"social_links\":{\"event_share\":\"https://link.dice.fm/Aa781182dedb?dice_id=Aa781182dedb\",\"post_competition_referral\":\"https://link.dice.fm/E30882bb0f7c?dice_id=E30882bb0f7c\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/jc41b57b43d5?dice_id=jc41b57b43d5\",\"post_purchase_referral\":\"https://link.dice.fm/l7fed7da99ec?dice_id=l7fed7da99ec\",\"post_reminder_referral\":\"https://link.dice.fm/S4e270793f9d?dice_id=S4e270793f9d\",\"post_waitinglist_referral\":\"https://link.dice.fm/b2275bce5225?dice_id=b2275bce5225\"},\"perm_name\":\"6dwmy7-sammy-virji-7th-aug-finsbury-park-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-11-25/c26df850-1443-433a-b8db-584c4975231c.jpg?rect=205%2C0%2C1638%2C1638\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-11-25/c26df850-1443-433a-b8db-584c4975231c.jpg?rect=0%2C205%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-11-25/c26df850-1443-433a-b8db-584c4975231c.jpg?rect=574%2C0%2C901%2C1638\"},\"properties\":[],\"about\":{\"description\":\"Get ready for a landmark summer moment as Sammy Virji headlines Finsbury Park on 7th August 2026.\\n\\nFresh off a run of explosive festival sets and global tours, Sammy brings his unmistakable blend of garage, speed garage, bassline, and high-energy club heaters to one of London's most iconic outdoor spaces.\\n\\nJoined by a cutting-edge lineup of Sammy's favourite artists (to be announced), this open-air spectacle will feature world-class production, heavy low-end, and a pure summer-day atmosphere - all set beneath the lucious treeline in Finsbury Park.\\n\\nThis is set to be one of the standout dance events of the 2026 festival season.\\n\\nGeneral and accessibility queries- Please email info@krankbrother.com\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"692597473e080500010fdfd6\",\"name\":\"Sammy Virji\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sammy Virji & Skepta - Cops & Robbers\",\"redirect_url\":\"https://music.apple.com/us/album/cops-robbers/1814574193?i=1814574286&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sammy Virji & Skepta\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/89/29/f0/8929f049-19d2-8365-573f-bfb184c9c1f6/mzaf_2759811006643577957.plus.aac.p.m4a\",\"track_name\":\"Cops & Robbers\"}],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sammy Virji\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5ebb38c33fce521d635825b1354\"},\"artist_id\":\"51232\",\"about\":null,\"is_headliner\":false},{\"name\":\"Malugi\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-01/af6a05ef-9831-432a-9e39-a7d3490866ab.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"68610\",\"about\":null,\"is_headliner\":false},{\"name\":\"Oppidan\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-12-10/35307