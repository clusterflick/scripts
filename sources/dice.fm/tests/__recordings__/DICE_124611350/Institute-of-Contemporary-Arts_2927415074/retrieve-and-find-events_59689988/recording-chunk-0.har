dice_id=X611a03dc7d0\",\"post_reminder_referral\":\"https://link.dice.fm/G9e8d095507a?dice_id=G9e8d095507a\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"16568\",\"name\":\"World Heart Beat Embassy Gardens\",\"address\":\"3 Ponton Road, Wandsworth, London, SW11 7BA, United Kingdom\",\"location\":{\"lat\":51.481919,\"lng\":-0.133104},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"world-heart-beat-embassy-gardens-dkv2e\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-26T18:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"**About the artist**\\n\\nSarah L King started singing in soul and gospel choirs before emerging as a solo artist. She inherited a good ear for harmonies and a highly intuitive melodic instinct from her musical heritage, her father a jazz trumpeter and band leader. Sarah has had a richly creative career writing film scripts and directing short films before immersing herself fully into music. This experience has given her a confident ability to write and compose music and convey memorable imagery through her lyrics. Sarah’s music regularly features on Jazz FM and BBC3. She is a regular on the London circuit at Pizza Express Soho, 606 Club, Hampstead Jazz Club, and toured Stockholm with her Swedish trio in 2025.\\n\\n**About the performance**\\n\\nJazz-soul vocalist Sarah L King presents her much-anticipated second album, 'The Light Ahead'. Produced by ECN Music with Claire Martin OBE at the helm, Sarah and her trio of world-class musicians (plus guests) bring eight exciting original songs and four surprise covers from her album, released in March 2026. Infectious, soulful, inspiring.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"14e26421af20bb85:16\",\"billing_promoter\":{\"id\":\"139902\",\"name\":\"World Heart Beat\",\"image\":{\"url\":null},\"perm_name\":\"world-heart-beat-bmv9k\",\"profile_active\":false},\"presented_by\":\"Presented by World Heart Beat.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sarah L King\",\"image\":null,\"artist_id\":\"58078\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"marketeers\":[],\"announcement_date_unix\":1765588500,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-13T01:15:00+00:00\",\"sale_end_date\":\"2026-03-26T19:30:00+00:00\",\"sale_start_date\":\"2025-12-13T02:00:00+00:00\",\"event_start_date\":\"2026-03-26T19:30:00+00:00\",\"event_end_date\":\"2026-03-26T21:30:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"693bd6cb078df6000103d0d1\",\"name\":\"Sarah L King Presents The Light Ahead\",\"price\":{\"currency\":\"GBP\",\"amount\":2448,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"apple_music\",\"title\":\"Sarah L King - As Though You Were Mine\",\"redirect_url\":\"https://music.apple.com/us/album/as-though-you-were-mine/1727183360?i=1727183368&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sarah L King\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/d6/66/2e/d6662eb3-4ca3-fc35-8095-6a463225c7bd/mzaf_11019120892972758980.plus.aac.p.m4a\",\"