nk.dice.fm/sf1db0288820?dice_id=sf1db0288820\",\"post_purchase_referral\":\"https://link.dice.fm/fcc82b16f00d?dice_id=fcc82b16f00d\",\"post_reminder_referral\":\"https://link.dice.fm/y16248bfa1f9?dice_id=y16248bfa1f9\",\"post_waitinglist_referral\":\"https://link.dice.fm/E9e3f3a72d3a?dice_id=E9e3f3a72d3a\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1299},\"seats_io_public_key\":null,\"presented_by\":\"Presented by Hackney Folk Club\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"8999\",\"name\":\"Fire in the Mountain Festival\",\"image\":{\"url\":null},\"perm_name\":\"fire-in-the-mountain-festival-ltd-lbop\",\"profile_active\":false},\"seats_io_event_id\":null,\"perm_name\":\"pyr69y-hackney-folk-club-alkanna-graeca-5th-mar-chats-palace-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:34\",\"venues\":[{\"id\":\"171\",\"name\":\"Chats Palace\",\"address\":\"42-44 Brooksby's Walk, London E9 6DF\",\"location\":{\"lat\":51.5502294,\"lng\":-0.0429139000000305},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"chats-palace-jo5y\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":4},\"about\":{\"description\":\"Hackney Folk Club - An International Woman’s Day Special Event  \\nChats Palace  \\nThursday 5th March 2026  \\n7pm - 11pm,  \\n£15/£13/£12 members\\n\\n**Alkanna Graeca**  \\nAlkanna Graeca is a vocal trio blending raw folk traditions from the Balkans, East Mediterranean, and Black Sea with improvisation and expansive soundscapes. Formed by Dunja Botic, Alexandra Achillea, and Irini Arabatzi, the trio’s music intertwines the rich cultural heritage of their homelands with a bold, boundary-pushing edge. Hailed as “rising stars of polyphonic singing”, they have been selling out venues and drawing audiences in across festival stages in the UK and Greece.\\n\\n**TIMINGS**  \\nDoors 7pm  \\nSession: 7pm  \\nFloorspots: 8pm  \\nAlkanna Graeca: 9pm  \\nSingaround: 10-11pm\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-03T19:00:00+00:00\",\"sale_end_date\":\"2026-03-05T21:15:00+00:00\",\"sale_start_date\":\"2025-12-03T21:30:00+00:00\",\"event_start_date\":\"2026-03-05T19:00:00+00:00\",\"event_end_date\":\"2026-03-05T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"693093db35b9fc0001872f83\",\"name\":\"Hackney Folk Club - Alkanna Graeca\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-03/b042dccf-6b44-4f0d-9a3d-145f87b9bc80.jpg?rect=195%2C0%2C1211%2C1211\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-03/b042dccf-6b44-4f0d-9a3d-145f87b9bc80.jpg?rect=0%2C126%2C1600%2C960\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-03/b042dccf-6b44-4f0d-9a3d-145f87b9bc80.jpg?rect=467%2C0%2C666%2C1211\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764788400,\"donation\":null,\"has_multiple_ticket_types\":true,\"social_links\":{\"event_share\":\"https://link.dice.fm/zf1c30d62982?dice_id=zf1c30d62982\",\"post_competition_referral\":\"https://link.dice.fm/Xb457aafd55a?dice_id=Xb457aafd55a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Dfec49db9210?dice_id=Dfec49db9210\",\"post_purchase_referral\":\"https://link.dice.fm/p02aa386fd48?dice_id=p02aa386fd48\",\"post_reminder_referral\":\"https://link.dice.fm/Re70601bc3c5?dice_id=Re70601bc3c5\",\"post_waitinglist_referral\":\"https://link.dice.fm/Va44e976228d?dice_id=Va44e976228d\"},\"unicorn_extras\":true,\"previews\":[],\"score\":0,\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1400},\"seats_io_public_key\":null,\"presented_by\":\"Presented by REAL\",\"is_ticket_available_at_door\":false,\"attendance_type\":\"live_only\",\"faqs\":[],\"billing_promoter\":{\"id\":\"12522\",\"name\":\"REAL\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-04-07/94ee93c8-9fa3-48b9-ae67-0215c3e3b070.jpg\"},\"perm_name\":\"real-vxyd\",\"profile_active\":true},\"seats_io_event_id\":null,\"perm_name\":\"9262rn-robin-richards-of-dutch-uncles-5th-mar-sjq-london-tickets\",\"is_fully_locked\":false,\"is_hidden_event\":false,\"secondary_status\":null,\"date_unix\":1772737200,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"96caedaf310297b1:35\",\"venues\":[{\"id\":\"181\",\"name\":\"SJQ\",\"address\":\"10A Bradbury Street, London N16 8JN\",\"location\":{\"lat\":51.548677,\"lng\":-0.0767180999999937},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-14/8d708e25-8424-478d-bba7-b394578460a7.jpg?rect=899%2C0%2C3744%2C3744\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"sjq-4pqp\",\"accessibility\":{\"url\":\"http://servantjazzquarters.com/#contact\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-05T19:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Martha Rose\",\"image\":null,\"artist_id\":\"120225\",\"about\":null,\"is_headliner\":false},{\"name\":\"Robin Richards\",\"image\":null,\"artist_id\":\"130334\",\"about\":null,\"is_headliner\":true}],\"total_artists\":2,\"total_free_texts\":0},\"about\":{\"description\":\"The Debut Album Tour, With Full Band\\n\\n***Robin Richards*** - A composer and performer bridging the gap between the classical and popular music traditions. Robin Richards' work is published by Domino Publishing and released via Memphis Industries and PRAH Recordings, with outputs spanning film scores, public art productions, concert hall performances and record releases.\\n\\n**Martha Rose** - An English musician living in Berlin. Her new album “Close to Close” was produced with and mixed by ET (Discovery Zone, John Moods) in Neukölln. The album uses sampled voices, water, flutes, and breathy synth sounds alongside drum machines and a collection of vintage Yamaha keyboards to create a minimal and intimate space.\\n\\n***Artists:*** We are always interested in hearing from talented artists. If you’d like to play at our future events, please get in touch.\\n\\n***Note: 18+ ID required.*** These events frequently sell out so we recommend buying tickets in advance.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"da