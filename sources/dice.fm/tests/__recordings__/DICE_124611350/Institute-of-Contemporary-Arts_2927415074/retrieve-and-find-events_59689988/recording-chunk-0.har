ral\":\"https://link.dice.fm/B591fe664a0a?dice_id=B591fe664a0a\"},\"is_hidden_event\":false,\"secondary_status\":null,\"marketeers\":[{\"id\":1300,\"name\":\"Old Empire \",\"privacy_policy_link\":null,\"fb_pixel_id\":\"252622951855502\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":false,\"show_opt_in_form\":false,\"opt_out_as_default\":false}],\"impression_id\":\"43dbb1788c9c854f:51\",\"properties\":[],\"presented_by\":\"Presented by Old Empire.\",\"attendance_type\":\"live_only\",\"announcement_date_unix\":1766052000,\"id\":\"693c160a0d349b0001c4cb8f\",\"name\":\"Sumac\",\"acquisition_type\":\"purchase\",\"new\":false,\"is_ticket_available_at_door\":false,\"about\":{\"description\":\"SUMAC is the powerhouse trio of Aaron Turner (Isis, Old Man Gloom,Mamiffer), Nick Yacyshyn (Baptists), and Brian Cook (Russian Circles, These Arms Are Snakes). SUMAC invests in the recursive exercises of chaos and control, and the results are a testament to the tour-honed collective intuition and technical skills of these veteran players.\\n\\nOn 'The Healer', the Northwest-based trio deepens its multi-faceted exploration into the parallel experiences of creation and destruction. Over the course of 4 tracks in 76 minutes, SUMAC presents a sequence of shifting movements which undergo a constant process of expansion, contraction, corruption and regrowth.\\n\\n14+ only. Anyone under the age of 16 must be accompanied by a parent or guardian.\",\"highlights\":[]},\"score\":0,\"billing_promoter\":{\"id\":\"80\",\"name\":\"Old Empire\",\"image\":{\"url\":null},\"perm_name\":\"old-empire-4n2q\",\"profile_active\":false},\"date_unix\":1775844000,\"event_tag\":null},{\"tty_to_extras\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1300,\"sales_tax\":0,\"amount_from\":null},\"unicorn\":