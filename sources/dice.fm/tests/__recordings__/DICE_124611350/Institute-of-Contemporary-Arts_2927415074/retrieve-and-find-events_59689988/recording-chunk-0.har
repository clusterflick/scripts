,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"status\":\"on-sale\",\"streaming_options\":null,\"max_tickets\":6,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"impression_id\":\"049f414030f6e5e4:16\",\"venues\":[{\"id\":\"8368\",\"name\":\"Elgar Room at Royal Albert Hall\",\"address\":\"Elgar Room at Royal Albert Hall\",\"location\":{\"lat\":51.501267,\"lng\":-0.17754},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"elgar-room-at-royal-albert-hall-da6q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-26T21:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Tom Ford\",\"image\":null,\"artist_id\":\"36778\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":1},\"about\":{\"description\":\"Tom Ford has weaved his signature mixing of genres, emphasis on improvisation and diverse influence from the likes of The Police, The Smiths, Allan Holdsworth and Milton Nascimento into his 2026 debut album in. 'goodbye, forever' articulates Tom's ambition as a Singer-songwriter, guitarist and producer to really showcase his influences and love of varied music in a format that is both unashamed and unrestricted.\\n\\nWith an emphasis on the power of collaboration, the album features some well known musicians from the worldwide jazz scene with features from Chris ‘Daddy’ Dave, Frederico Heliodoro, Anatole Muster, Otis Sandsjo and Logan Kane to name a few. Tom will perform this new material with a stripped back guitar-bass-drums trio with Daisy George on bass and King Ike-Elechi on drums, preferring to interpret the music raw and rough live in line with his love of 80s post punk and new wave.\\n\\nOur intimate Late Night Jazz series presents sensational music in the Elgar Room, celebrating the freshest sounds on the London scene alongside the finest in jazz standards.\\n\\nWe have a laid-back attitude at Late Night Jazz at the Royal Albert Hall. Customers are welcome to dance, move around, sing along, and enjoy themselves in whatever way feels most comfortable!\\n\\nAll customers aged 14 years or below must be accompanied by an adult aged 18 years or over\",\"highlights\":[]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-05T10:00:00+00:00\",\"sale_end_date\":\"2026-02-25T12:00:00+00:00\",\"sale_start_date\":\"2025-12-05T11:00:00+00:00\",\"event_start_date\":\"2026-02-26T21:00:00+00:00\",\"event_end_date\":\"2026-02-26T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"6932acd99f829400011f5315\",\"name\":\"Late Night Jazz: Tom Ford\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-04/3413b95f-2e95-4e5d-b85b-32de068166c0.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-04/3413b95f-2e95-4e5d-b85b-32de068166c0.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-04/3413b95f-2e95-4e5d-b85b-32de068166c0.jpg?rect=243%2C0%2C594%2C1080\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1764928800,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Tb9409085f72?dice_id=Tb9409085f72\",\"post_competition_referral\":\"https://link.dice.fm/u785a4a2a347?dice_id=u785a4a2a347\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/M26b6bec4c59?dice_id=M26b6bec4c59\",\"post_purchase_referral\":\"https://link.dice.fm/Y9b82615fe89?dice_id=Y9b82615f