tive\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-07-25T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"is_hidden_event\":false,\"seats_io_public_key\":null,\"streaming_options\":null,\"donation\":null,\"billing_promoter\":{\"id\":\"6234\",\"name\":\"229\",\"image\":{\"url\":null},\"perm_name\":\"229-82l5\",\"profile_active\":false},\"has_multiple_ticket_types\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"impression_id\":\"49b4780d575288c7:71\",\"date_unix\":1785002400,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2390},\"social_links\":{\"event_share\":\"https://link.dice.fm/k44ef1e2335d?dice_id=k44ef1e2335d\",\"post_competition_referral\":\"https://link.dice.fm/w77a4908bbd5?dice_id=w77a4908bbd5\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/a6c62f48b220?dice_id=a6c62f48b220\",\"post_purchase_referral\":\"https://link.dice.fm/df0c392d3ad5?dice_id=df0c392d3ad5\",\"post_reminder_referral\":\"https://link.dice.fm/Q730447d7391?dice_id=Q730447d7391\",\"post_waitinglist_referral\":\"https://link.dice.fm/Cc5714038c90?dice_id=Cc5714038c90\"},\"perm_name\":\"eo3l7d-sssputnik-electronic-25th-jul-229-london-tickets\",\"secondary_status\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/b1de8705-2697-42dd-893e-ee2be7873c3f.jpg?rect=276%2C0%2C980%2C980\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/b1de8705-2697-42dd-893e-ee2be7873c3f.jpg?rect=0%2C31%2C1532%2C919\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/b1de8705-2697-42dd-893e-ee2be7873c3f.jpg?rect=497%2C0%2C539%2C980\"},\"properties\":[],\"about\":{\"description\":\"Celebrate the 40th Anniversary of the groundbreaking album FLAUNT IT with a high-velocity electronic assault. SSSPUTNIK ELECTRONIC returns to unleash a neon-drenched, cyber-punk spectacle that redefined the future of rock ‘n’ roll.\\n\\n​UNLEASHING ALL THE HITS LIVE:\\n\\nLOVE MISSILE F1-11 | DANCERAMA | SEX BOMB BOOGIE | ATARI BABY | 21ST CENTURY BOY\\n\\n​Prepare for a sonic reboot of the ultra-glam, ultra-violent sounds that hacked the charts. This is the ultimate sci-fi disco experience—faster, louder, and still light years ahead.\\n\\n​FLAUNT IT. THE FUTURE IS NOW.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"id\":\"695e952600191f0001c85020\",\"name\":\"SSSPUTNIK ELECTRONIC\",\"shopping_cart_enabled\":false,\"new\":false,\"previews\":[],\"unicorn\":true,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"score\":0,\"max_tickets\":6,\"event_tag\":null},{\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-13T21:00:00+00:00\",\"sale_end_date\":\"2026-07-25T19:00:00+01:00\",\"sale_start_date\":\"2025-12-13T21:00:00+00:00\",\"event_start_date\":\"2026-07-25T19:00:00+01:00\",\"event_end_date\":\"2026-07-25T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"offers_extras\":false,\"faqs\":[],\"marketeers\":[],\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":true,\"seats_io_event_id\":null,\"presented_by\":\"Presented by Hot Box Live Community Interest Company.\",\"seating\":null,\"announcement_date_unix\":1765659600,\"venues\":[{\"id\":\"3785\",\"name\":\"Hot Box\",\"address\":\"28 Viaduct Rd, Chelmsford CM1 1TS, UK\",\"location\":{\"lat\":51.7359952,\"lng\":0.4672127},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-06-29/9ff0c867-708b-4d5c-834d-a927e4e4ae83.jpg?rect=0%2C0%2C1200%2C1200\"},\"city\":{\"id\":\"5eb9799ae1727402966007e1\",\"name\":\"Chelmsford\",\"location\":{\"lat\":51.736717,\"lng\":0.466083,\"accuracy\":12,\"