ghlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-28T18:00:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"La Bouche Manouche\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eba3a5edd70226aaa9f0e26c4d\"},\"artist_id\":\"131983\",\"about\":{\"description\":\"With Andy Ruiz-Palma on lead guitar, Nathan Mansfield on violin/trumpet, Amy Baldwin on double bass, La Bouche Manouche is made up of highly experienced, in-demand performers who have played in many prestigious venues such as the Royal Albert Hall, the Barbican Centre, the Southbank Centre, the Royal Festival Hall and Ronnie Scotts.\\n\\nCatch this highly anticipated performance from one of the UK’s top gypsy jazz bands!\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"about\":{\"description\":\"After two sold-out shows, La Bouche Manouche return with Got A Little Rhythm!, a joyful celebration of gypsy jazz swing inspired by the glamour of the Jazz Age.\\n\\nShowcasing music from their newly released second album, the band also perform highlights from the much-loved repertoire that has earned them over 5 million YouTube views. Expect the infectious swing of Django Reinhardt originals, timeless Billie Holiday classics, French chansons, tangos and crowd-favourite gypsy tunes.\\n\\nFeaturing the critically acclaimed Irene Serra on vocals, La Bouche Manouche is a vintage jazz quintet steeped in the sound of the Parisian Hot Club. Their stylish, genre-spanning set moves effortlessly from Edith Piaf classics and the Great American Songbook to Latin-tinged rhythms and soulful swing.\\n\\nAn unmissable evening of elegance, rhythm and gypsy jazz joie de vivre.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-05T00:00:00+00:00\",\"sale_end_date\":\"2026-02-28T18:00:00+00:00\",\"sale_start_date\":\"2026-01-05T00:00:00+00:00\",\"event_start_date\":\"2026-02-28T19:00:00+00:00\",\"event_end_date\":\"2026-02-28T20:15:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"shopping_cart_enabled\":false,\"properties\":[],\"id\":\"695ce35ae5759c0001dc0f69\",\"name\":\"La Bouche Manouche ft. Irene Serra (early show)\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=381%2C0%2C1280%2C1280\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=0%2C64%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-05/556f827f-78ba-4e4e-a906-ce94b86c5826.jpg?rect=608%2C0%2C704%2C1280\"},\"marketeers\":[],\"new\":false,\"offers_extras\":false,\"tty_to_extras\":[],\"announcement_date_unix\":1767571200,\"donation\":null,\"has_multiple_ticket_types\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/f5f74035b0bc?dice_id=f5f74035b0bc\",\"post_competition_referral\":\"https://link.dice.fm/l5a6e234ee82?dice_id=l5a6e234ee82\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D9f9981c8979?dice_id=D9f9981c8979\",\"post_purchase_referral\":\"https://link.dice.fm/C114828ed262?dice_id=C114828ed262\",\"post_reminder_referral\":\"https://link.dice.fm/e0df671a9cfc?dice_id=e0df671a9cfc\",\"post_waitinglist_referral\":\"https://link.dice.fm/D8dd7d01a058?dice_id=D8dd7d01a058\"},\"unicorn_extras\":true,\"previews\":[{\"type\":\"apple_music\",\"title\":\"La Bouche Manouche - He's a Tramp (feat. Irene Serra)\",\"redirect_url\":\"https://music.apple.com/us/album/hes-a-tramp-feat-irene-serra/1681466316?i=1681466319&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"La Bouche Manouche\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview126/v4/e8/f6/22/e8f6221b-e536-b0a4-eb2c-ea2fb2184365/mzaf_17015953663156823438.pl