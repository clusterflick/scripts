:\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-ivy-house-nvk5\",\"accessibility\":{\"url\":\"https://www.ivyhousenunhead.com/about\"},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-17T19:30:00+00:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"My Mercury\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb21c2d75ea6335bba48642e57\"},\"artist_id\":\"119288\",\"about\":null,\"is_headliner\":false},{\"name\":\"tall child\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb47122cfc81938d2e58a0a1a8\"},\"artist_id\":\"119229\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-07/c89a4271-ca4c-463f-80b7-06503aac2a58.jpg?rect=300%2C0%2C768%2C768\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-07/c89a4271-ca4c-463f-80b7-06503aac2a58.jpg?rect=44%2C0%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-07/c89a4271-ca4c-463f-80b7-06503aac2a58.jpg?rect=473%2C0%2C422%2C768\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"tall child - Oh Well, That's Life.\",\"redirect_url\":\"https://open.spotify.com/track/7nTw3OTA5n18vBNymopIDr\",\"artist\":\"tall child\",\"preview_url\":\"https://p.scdn.co/mp3-preview/91cb446e5eff1b51cd800be2aec4d889b370da26?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Oh Well, That's Life.\"},{\"type\":\"apple_music\",\"title\":\"tall child - Oh Well, That's Life.\",\"redirect_url\":\"https://music.apple.com/us/album/oh-well-thats-life/1808698628?i=1808698782&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"tall child\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/1d/69/c5/1d69c533-6663-6d95-65b3-fee99f5f9cd1/mzaf_6340187069388711860.plus.aac.p.m4a\",\"track_name\":\"Oh Well, That's Life.\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1767776400,\"max_tickets\":20,\"marketeers\":[],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"New Lands returns for another helping; joined by My Mercury and tall child. Buy a ticket in advance to receive a FREE pint of New Lands lager at the gig!\\n\\nMichael Xanthe George Georgia. A 4-piece indie/alt-country band out of London. Michael’s songwriting is as influenced by the places he’s lived as other music, from Atlantic Canada’s coastline to the rainforests of British Columbia, to Montreal, to the desert of California, and finally to London. These are Americana-kissed, alt-country imbued, leftfield indie songs. They are also none of these things. They are a new band gloriously out of step, and all the more fascinating for it.\\n\\ntall child is the alias for Zha Gandhi, a South East London based musician of Nigerian/Indian heritage paving the way for black artists in the indie music scene. tall child takes inspiration from the likes of Mitski, Radiohead, Rachel Chinouriri and Arlo Parks, to create a beautifully intimate and authentic basis for their soundscape. They build on this with a brutally honest style of lyricism, that explores their experiences as a queer disabled POC, to develop a sonic space especially for those who feel their differences being used against them.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by Th