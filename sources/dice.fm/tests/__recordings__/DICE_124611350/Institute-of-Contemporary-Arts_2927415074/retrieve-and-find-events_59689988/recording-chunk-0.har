d\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"night-tales-loft-39wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-28T19:00:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-11/afa208e9-7cb4-422a-9f39-6fb3019396ef.jpg?rect=0%2C0%2C1500%2C1500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-11/afa208e9-7cb4-422a-9f39-6fb3019396ef.jpg?rect=0%2C300%2C1500%2C900\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-11/afa208e9-7cb4-422a-9f39-6fb3019396ef.jpg?rect=338%2C0%2C825%2C1500\"},\"previews\":[],\"seats_io_public_key\":null,\"announcement_date_unix\":1759226400,\"max_tickets\":6,\"marketeers\":[{\"id\":1827,\"name\":\"Night Tales Loft\",\"privacy_policy_link\":\"https://static1.squarespace.com/static/62502cbe020d59057d88d958/t/62bb7163377da00692cca3bd/1656451427778/BACKGROUND%2BCLUBS%2BLIMITED%2BPRIVACY%2BAND%2BCOOKIES%2BSTATEMENT.pdf\",\"fb_pixel_id\":\"1020185540161660\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"Presented by Johnnie Walker Black Label × NT’s Loft\\n\\nOn Tuesday 28th of April, we turn our focus to Frank Ocean; a transcendent journey through one of the most influential and elusive voices of modern music. From the nostalgic storytelling of *channel ORANGE* to the raw introspection of *Blonde* and the mastery of countless features in tracks by Tyler the Creator and Beyonce, this session explores the vulnerability, innovation and emotional depth that define his artistry. Blending alternative R&B, soul, ambient textures and poetic lyricism, Frank Ocean’s music captures the complexity of love, identity and self-discovery.\\n\\nPlayback returns as a candlelit listening experience where over 200 candles transform NT’s Loft into a glowing sanctuary. Designed to slow the pace, each session invites guests to disconnect from the noise and fully immerse themselves in the music shaping global culture.\\n\\nExperience every layered harmony, subtle production detail and confessional lyric through the warmth and precision of Funktion-One sound, in an intimate, candlelit setting.\\n\\nJohnnie Walker Black Label returns to elevate the evening, with signature serves available throughout the night. Guests arriving before 8pm will receive a complimentary drink to begin the evening in style (Limited to First 50 Customers).\\n\\nTickets\\n\\nReserved seating ticket holders must arrive by 8:00 PM. Seating is first come, first served.\\n\\n—\\n\\nSchedule\\n\\n7:00 PM – Doors & Playlist\\n\\n8:15 PM – Listening Session Begins (90 mins)\\n\\nLimited capacity. Arrive early, stay late.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event. Bring your ID card with you. ID Scanner in place. \",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by NT's Loft.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:41\",\"social_links\":{\"event_share\":\"https://link.dice.fm/kcf1aac43bdb?dice_id=kcf1aac43bdb\",\"post_competition_referral\":\"https://link.dice.fm/bf63c556ac50?dice_id=bf63c556ac50\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/w08a724b4a93?dice_id=w08a724b4a93\",\"post_purchase_referral\":\"https://link.dice.fm/wc9307da32ce?dice_id=wc9307da32ce\",\"post_reminder_referral\":\"https://link.dice.fm/y444e167c59a?dice_id=y444e167c59a\",\"post_waitinglist_referral\":\"https://link.dice.fm/R9e1f781e81c?dice_id=R9e1f781e81c\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-09-30T11:00:00+01:00\",\"sale_end_date\":\"2026-04-28T19:00:00+01:00\",\"sale_start_date\":\"2025-09-30T11:30:00+01:00\",\"event_start_date\":\"2026-04-28T19:00:00+01:00\",\"event_end_date\":\"2026-04-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1185,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"2368\",\"name\":\"Night Tales Loft\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-03-28/6e6ef849-1334-49eb-a7bd-a888e14902a0.jpg\"},\"perm_name\":\"night-tales-loft-dvlq\",\"profile_active\":false},\"id\":\"698c86241715d700010d7f9f\",\"seats_io_event_id\":null,\"name\":\" Playback: Frank Ocean [Candlelit Sessions]\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"2w8vbm--playback-frank-ocean-candlelit-sessions-28th-apr-night-tales-loft-london-tickets\",\"date_unix\":1777399200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"53\",\"name\":\"The Underworld\",\"address\":\"174 Camden High St, London NW1 0NE\",\"location\":{\"lat\":51.5391426,\"lng\":-0.142163900000014},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-07-25/f029c393-780a-492d-8c51-acec64197fc4.jpg?rect=391%2C0%2C1569%2C1569\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-underworld-zg7p\",\"accessibility\":{\"url\":\"https://www.theunderworldcamden.co.uk/about/\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-28T19:00:00+01:00\",\"doors_close_date\":\"2026-04-28T23:00:00+01:00\"}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"Sanctuary\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab6761610000e5eb7083f7c1ff93f953e0469614\"},\"artist_id\":\"25037\",\"about\":{\"description\":\"SANCTUARY quickly became a key part of the city’s influential heavy metal scene. The band’s sound, centered on the distinctive high-pitched vocals of the late Warrel Dane and established them as a prominent force. Their debut album, Refuge Denied (1988), was notably produced by Megadeth frontman Dave Mustaine, helping to launch the band into the global metal consciousness., Sanctuary gathered supporters all around the globe, upping the ante considerably when unleashing the darker, more refined masterpiece that is “Into the Mirror Black” in 1990. While the grunge-style brought the band’s commercial career to an unfortunate halt, the end of the band’s first phase meant the rise of Nevermore who released several much-acclaimed albums via Century Media Records between 1995 and 2010. In 2011, Sanctuary reformed and celebrated their live comeback, performed at high profile festivals such as Wacken, Metalcamp, Bloodstock and 70K Tons Of Metal cruise. In 2014 they released “The Year The Sun Died” and landed at #39 in the German charts. In 2017, the restored and remixed 1986 demo recordings were released as the historical “Inception” release, which charted on #53 in Germany. On December 13th, 2017, vocalist Warrel Dane tragically passed away. The band initially embarked on a tribute tour, recruiting Witherfall singer Joseph Michael to fill the vocal spot. The reaction to Michael’s performances was very positive and the band chose to continue with the focus shifting to new material. The band is aiming to deliver a unique sound that remains familiar to die-hard fans. The current lineup of Sanctuary includes Joseph Michael on vocals, alongside original members Lenny Rutledge (guitars) and Dave Budbill (drums), and George Hernandez on bass. Sanctuary has, and always will be a two guitar band and will have a second guitar player for all upcoming live shows. You can catch the band performing special sets of Refuge Denied or Into The Mirror Black at festivals in 2026.\\n\\nThe band is actively working on a new full-length album, tentatively titled Transmutation, which is expected to include tracks such as “We Are The Fallen,” “Not Of The Living,” and “Blind.”\\n\\nSanctuary is eager to bring a new show and new music to Europe and the rest of the globe once again ! See you on the road !\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":1},\"faqs\":[{\"id\":73345,\"title\":\"Offer your ticket to another fan\",\"body\":\"We believe tickets belong in the hands of fans, and that they should only ever be sold for a fair price. That’s why we have the Waiting List: if you can’t make it to a sold-out event, you can add your ticket to the queue to be purchased by another fan. If the ticket is sold, you’ll get your money back – no drama, no rip-offs.\\n\\nThere are a few conditions, though. Not every show will have the Waiting List function switched on, and tickets can only be added to the Waiting List after a show sells out. On top of that – and this is important – you’ll only get your money back if another fan buys your ticket.\\n\\nLearn more about how the Waiting List works https://dice.fm/help/article?id=4409669479953\",\"order\":0},{\"id\":73346,\"title\":\"Transfer your ticket to a friend \",\"body\":\"If a friend is keen to attend an event you can’t make, you can transfer your ticket to them quickly and securely within the app. Just make sure you have their number saved in your phone, and that they have a DICE account registered with that number.\\n\\nAfter you transfer the ticket, it will be stored within the DICE app on your friend’s phone – there’s no fiddling with name changes, emailing PDFs, or sending across screenshots. It’s just another way we make sure tickets don’t fall into the wrong hands.\\n\\nThe whole process takes seconds, here’s a step-by-step breakdown https://dice.fm/help/article?id=4409669378449\",\"order\":1},{\"id\":73347,\"title\":\"Can I purchase tickets from a third-party ticket website?\",\"body\":\"DICE does not participate in re-selling with any third-party sites as our tickets are only accessible via our app using the unique QR code that can only be activated on the day of the event.\\n\\nYou will be rejected at the door, if you show a ticket from third-party ticket resale site.\\n\\nOur wait list feature puts fans first and ensures they aren’t being charged more than the actual ticket price. The wait list is the only way to ensure you are purchasing a genuine ticket that will give you entry into your favourite events!\",\"order\":2}],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-30/eaf5a1ae-02d9-49df-9974-72663e1a68f0.jpg?rect=1120%2C0%2C4480%2C4480\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-30/eaf5a1ae-02d9-49df-9974-72663e1a68f0.jpg?rect=0%2C224%2C6720%2C4032\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-30/eaf5a1ae-02d9-49df-9974-72663e1a68f0.jpg?rect=2128%2C0%2C2464%2C4480\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Future Tense\",\"redirect_url\":\"https://open.spotify.com/track/5Hlk3eLQfrHb5NYeqEcnWY\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/3b315491e69b810178a89cf40a11ac478fbd243f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Future Tense\"},{\"type\":\"apple_music\",\"title\":\"Sanctuary - Die for My Sins\",\"redirect_url\":\"https://music.apple.com/us/album/die-for-my-sins/186384246?i=186384401&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Sanctuary\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/ad/71/5c/ad715cd5-4d1c-7399-e1ec-b7988bd329bb/mzaf_1186156277495567858.plus.aac.p.m4a\",\"track_name\":\"Die for My Sins\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770202800,\"max_tickets\":6,\"marketeers\":[{\"id\":21,\"name\":\"The Underworld\",\"privacy_policy_link\":\"https://www.theunderworldcamden.co.uk/privacy-policy/\",\"fb_pixel_id\":\"1396572940874608\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"acquisition_type\":\"purchase\",\"seating\":null,\"about\":{\"description\":\"**40 YEARS OF SANCTUARY**\\n\\nSANCTUARY quickly became a key part of the city’s influential heavy metal scene. The band’s sound, centered on the distinctive high-pitched vocals of the late Warrel Dane and established them as a prominent force. Their debut album, Refuge Denied (1988), was notably produced by Megadeth frontman Dave Mustaine, helping to launch the band into the global metal consciousness., Sanctuary gathered supporters all around the globe, upping the ante considerably when unleashing the darker, more refined masterpiece that is “Into the Mirror Black” in 1990. While the grunge-style brought the band’s commercial career to an unfortunate halt, the end of the band’s first phase meant the rise of Nevermore who released several much-acclaimed albums via Century Media Records between 1995 and 2010. In 2011, Sanctuary reformed and celebrated their live comeback, performed at high profile festivals such as Wacken, Metalcamp, Bloodstock and 70K Tons Of Metal cruise. In 2014 they released “The Year The Sun Died” and landed at #39 in the German charts. In 2017, the restored and remixed 1986 demo recordings were released as the historical “Inception” release, which charted on #53 in Germany. On December 13th, 2017, vocalist Warrel Dane tragically passed away. The band initially embarked on a tribute tour, recruiting Witherfall singer Joseph Michael to fill the vocal spot. The reaction to Michael’s performances was very positive and the band chose to continue with the focus shifting to new material. The band is aiming to deliver a unique sound that remains familiar to die-hard fans. The current lineup of Sanctuary includes Joseph Michael on vocals, alongside original members Lenny Rutledge (guitars) and Dave Budbill (drums), and George Hernandez on bass. Sanctuary has, and always will be a two guitar band and will have a second guitar player for all upcoming live shows. You can catch the band performing special sets of Refuge Denied or Into The Mirror Black at festivals in 2026.\\n\\nThe band is actively working on a new full-length album, tentatively titled Transmutation, which is expected to include tracks such as “We Are The Fallen,” “Not Of The Living,” and “Blind.”\\n\\nSanctuary is eager to bring a new show and new music to Europe and the rest of the globe once again! See you on the road!\\n\\nThis is a 14+ event. 14 and 15 year olds MUST be accompanied by an adult (18+) / All ticketholders under the age of 25 will be required to carry PHOTO ID.\",\"highlights\":[]},\"attendance_type\":\"live_only\",\"shopping_cart_enabled\":false,\"is_hidden_event\":false,\"presented_by\":\"Presented by The Underworld.\",\"streaming_options\":null,\"impression_id\":\"8cc5ceb0df17d6a6:42\",\"social_links\":{\"event_share\":\"https://link.dice.fm/jeaa4309cd5f?dice_id=jeaa4309cd5f\",\"post_competition_referral\":\"https://link.dice.fm/O0e615fdb2ec?dice_id=O0e615fdb2ec\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/s14753929d30?dice_id=s14753929d30\",\"post_purchase_referral\":\"https://link.dice.fm/c63a7d059089?dice_id=c63a7d059089\",\"post_reminder_referral\":\"https://link.dice.fm/E169dfe54fca?dice_id=E169dfe54fca\",\"post_waitinglist_referral\":\"https://link.dice.fm/i9b13ba3feca?dice_id=i9b13ba3feca\"},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-02-04T11:00:00+00:00\",\"sale_end_date\":\"2026-04-28T17:30:00+01:00\",\"sale_start_date\":\"2026-02-06T11:00:00+00:00\",\"event_start_date\":\"2026-04-28T19:00:00+01:00\",\"event_end_date\":\"2026-04-28T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":2987,\"sales_tax\":0,\"amount_from\":null},\"properties\":[],\"billing_promoter\":{\"id\":\"52\",\"name\":\"The Underworld\",\"image\":{\"url\":null},\"perm_name\":\"the-underworld-zkx8\",\"profile_active\":false},\"id\":\"697d0e5aaaeef30001697120\",\"seats_io_event_id\":null,\"name\":\"SANCTUARY\",\"offers_extras\":false,\"new\":false,\"unicorn_extras\":true,\"perm_name\":\"6dny27-sanctuary-28th-apr-the-underworld-london-tickets\",\"date_unix\":1777399200,\"score\":0,\"tty_to_extras\":[],\"event_tag\":null},{\"unicorn\":true,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,