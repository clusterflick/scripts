?rect=341%2C0%2C1367%2C1367\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"moth-club-43ox\",\"accessibility\":{\"url\":\"https://mothclub.co.uk/Access\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-04-26T19:30:00+01:00\",\"doors_close_date\":null}],\"summary_lineup\":{\"top_artists\":[{\"name\":\"GROUP A.D.\",\"image\":null,\"artist_id\":\"132737\",\"about\":{\"description\":\"Group A.D. is a brand new Leeds based project and we’re very excited for them to play their debut London show at Moth Club in the round. The name stands for The Group For Action & Dance, and their music sits somewhere between dubbed out, psychedelic no-wave and spaghetti western orchestral maximalism. Across their debut EP 'Colour Space Transform', tracks slip between the orchestral flourishes of John Barry and Ennio Morricone, the surf-rock of Jet Harris and spectral ‘80s dance floor maximalism - with each style appearing as suggestion rather than imitation.\\n\\nSamples punctuate the songs throughout - narrations, incandescent preachers, machines, children’s voices, all a patchwork of cut-out motifs that open portals into uncanny new worlds. More to come from Group A.D. very soon.\",\"highlights\":[]},\"is_headliner\":true}],\"total_artists\":1,\"total_free_texts\":0},\"faqs\":[],\"has_multiple_ticket_types\":false,\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/9465ac2d-79d1-463a-9510-c4421038761a.jpg?rect=0%2C3%2C3533%2C3533\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/9465ac2d-79d1-463a-9510-c4421038761a.jpg?rect=0%2C709%2C3533%2C2120\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/9465ac2d-79d1-463a-9510-c4421038761a.jpg?rect=794%2C0%2C1946%2C3538\"},\"previews\":[{\"type\":\"spotify\",\"title\":\"Group A.D. - Colour Space Transform\",\"redirect_url\":\"https://open.spotify.com/track/0A0VsCXJxayY5vrPt7jTn0\",\"artist\":\"Group A.D.\",\"preview_url\":\"https://p.scdn.co/mp3-preview/e4a6485f098f73a60969e3c5d8a23ad9e3ce019f?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Colour Space Transform\"},{\"type\":\"apple_music\",\"title\":\"Group A.D. - Colour Space Transform\",\"redirect_url\":\"https://music.apple.com/us/album/colour-space-transform/1869353749?i=1869353751&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Group A.D.\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/c4/ac/0d/c4ac0d3e-b851-39b8-6e76-47fc3cdc1f71/mzaf_15716471718739928157.plus.aac.p.m4a\",\"track_name\":\"Colour Space Transform\"}],\"seats_io_public_key\":null,\"announcement_date_unix\":1770199200,\"max_tickets\":6,\"marketeers\":[{\"id\":19,\"name\":\"LNZRT\",\"privacy_policy_link\":\"https://lanzaroteworks.com/Privacy-Policy\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":225,\"name\":\"Bad Vibrations\",\"privacy_policy_link\":\"http://www.badvibrations.co.uk/privacy-policy-mojave\",\"fb_pixel_id\":\"744309937658318\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":954,\"name\":\"MOTH\",\"privacy_policy_link\":null,\"fb_pixel_id\":\"2922216871345