ver Studios\",\"address\":\"199 Eade Rd, London N4 1DN, United Kingdom\",\"location\":{\"lat\":51.5749501,\"lng\":-0.0881636000000299},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"new-river-studios-g5e6\",\"accessibility\":{\"url\":null},\"highlights\":[],\"profile_active\":false,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:30:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":39,\"name\":\"Chaos Theory\",\"privacy_policy_link\":\"https://mailchi.mp/341b88261463/gdpr \",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false},{\"id\":1562,\"name\":\"Chaos Theory\",\"privacy_policy_link\":\"https://chaostheorymusic.co.uk/privacy-statement/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:63\",\"about\":{\"description\":\"Already garnering a loyal fanbase since their debut self-titled 2023 album, and especially due to their electrifying live performances, we can't wait to see what **PEACH** will bring us next with the release of their second album *Only Love*.\\n\\nThey have impressed audiences when sharing the stage with legends including Mclusky, CLT DRP, LIFE, Chiyoda Ku, Skin Failure, and Every Hell, and when playing at festivals including Arctangent, 15 Years Of Chaos, and 2000 Trees.\\n\\n*“If you were a fan of the Dope, Guns N’ Fucking In The Streets compilation albums, and love the idea of those scrapping with Amyl & The Sniffers with shades of Dry-era PJ Harvey, then you’ll love PEACH.” – Daniel P Carter (Radio 1 Rock Show)*\\n\\n*“Mighty and honest.” – Occhi Magazine*\\n\\n\\\\*“The song-writing is enrapturing, the production is welcomingly refreshing and the performances are top notch.” – Noizze\\n\\nSupports TBA\\n\\n£16 on the door\\n\\nNew River Studios is a fully accessible venue\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1765450800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"PEACH\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-01-23/e9bab475-dde0-466e-9769-7b997b558795.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"80478\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-11/88c2e541-4543-4dd7-8ce1-c393ce30f149.jpg?rect=42%2C0%2C4160%2C4160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-11/88c2e541-4543-4dd7-8ce1-c393ce30f149.jpg?rect=0%2C208%2C6240%2C3744\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-11/88c2e541-4543-4dd7-8ce1-c393ce30f149.jpg?rect=1976%2C0%2C2288%2C4160\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"693a9db4e837840001af1541\",\"name\":\"Peach: Only Love album 'launch party'\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-11T11:00:00+00:00\",\"sale_end_date\":\"2026-04-24