support\\n\\nWARDOGS were formed in Italy 2009, “… we didn’t want to make a copy of the original band, but respect the tradition; something of our own…original to some extent. In other words, we wanted to keep the RAMONES Legacy alive; starting where they stopped. The sounds reflect this philosophy; big and heavy, dirty and direct, as if the RAMONES were still playing today\\\"\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages  (U18s to be accompanied by an adult)\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1768817700,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Wardogs\",\"image\":null,\"artist_id\":\"108760\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-19/97289d3d-0b66-4cba-87cf-675a4e31c5a2.jpg?rect=227%2C0%2C826%2C826\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-19/97289d3d-0b66-4cba-87cf-675a4e31c5a2.jpg?rect=0%2C29%2C1280%2C768\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-19/97289d3d-0b66-4cba-87cf-675a4e31c5a2.jpg?rect=413%2C0%2C454%2C826\"},\"offers_extras\":false,\"unicorn_extras\":true,\"id\":\"696f42e1d3217c00019be09c\",\"name\":\"Wardogs\",\"new\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-01-19T10:15:00+00:00\",\"sale_end_date\":\"2026-04-24T17:00:00+01:00\",\"sale_start_date\":\"2026-01-19T10:15:00+00:00\",\"event_start_date\":\"2026-04-24T19:00:00+01:00\",\"event_end_date\":\"2026-04-24T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"perm_name\":\"k6aneo-wardogs-24th-apr-cart-horses-london-tickets\",\"score\":0,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"event_tag\":null},{\"is_ticket_available_at_door\":false,\"seats_io_event_id\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1623,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Gc25d1ddb9e2?dice_id=Gc25d1ddb9e2\",\"post_competition_referral\":\"https://link.dice.fm/i6bb12ffec78?dice_id=i6bb12ffec78\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/l8f9bd4975b7?dice_id=l8f9bd4975b7\",\"post_purchase_referral\":\"https://link.dice.fm/Vd40c2c9abc1?dice_id=Vd40c2c9abc1\",\"post_reminder_referral\":\"https://link.dice.fm/V196343ca51c?dice_id=V196343ca51c\",\"post_waitinglist_referral\":\"https://link.dice.fm/O1469061d291?dice_id=O1469061d291\"},\"previews\":[],\"faqs\":[{\"id\":64406,\"title\":\"Venue Accessibility Information\",\"body\":\"The Lexington is an early Victorian building and as such is not easily accessible for anyone with limited mobility. While the main bar is on the ground floor and accessible without steps the music venue is up a flight of stairs. We’re happy to help with access where possible; for any further information please contact us: info@thelexington.co.uk.\",\"order\":0}],\"acquisition_type\":\"purchase\",\"properties\":[],\"presented_by\":\"Presented by FORM.\",\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"date_unix\":1777053600,\"has_multiple_ticket_types\":false,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"attendance_type\":\"live_only\",\"unicorn\":true,\"is_hidden_event\":false,\"venues\":[{\"id\":\"23\",\"name\":\"The Lexington\",\"address\":\"96-98 Pentonville Rd, London N1 9JB\",\"location\":{\"lat\":51.5317299,\"lng\":-0.111416400000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-lexington-jomz\",\"accessibility\":{\"url\":\"https://www.thelexington.co.uk/about.php\"},\"highlights\":[],\"profile_active\":true,\"space_name\":null,\"doors_open_date\":\"2026-04-24T19:00:00+01:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"streaming_options\":null,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"secondary_status\":null,\"is_fully_locked\":false,\"tty_to_extras\":[],\"shopping_cart_enabled\":false,\"impression_id\":\"ab902a79f4685193:57\",\"about\":{\"description\":\"FORM Presents\\n\\nlavender\\n\\n\\\\+ Special Guests\\n\\n\\\"Meet lavender, a winsome London-based duo consisting of Oskar Rice and Adam Jackson. You can hear the confluence of their weirdly disconnected musical worlds merge on these songs. Their influences, which range from American Football to Burial, Steve Reich to J Dilla, are mixed up in a minestrone of sounds. The songs, with these vivid textural patterns, gossamer-thin layers of audio competing and commingling to create these magical, melody-rich results. Big fans of sampling, it’s hard to pinpoint exactly where they begin and Adam’s voice or Oskar’s beats end. And that’s how they like it. Multiple plays reward the listener as the music unravels and gradually reveals its secrets.” - Bill Brewster\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null}]},\"seating\":null,\"announcement_date_unix\":1768384800,\"seats_io_public_key\":null,\"donation\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"lavender\",\"image\":{\"url\":\"https://dice-