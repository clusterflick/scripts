/London\",\"announcement_date\":\"2026-01-26T17:00:00+00:00\",\"sale_end_date\":\"2026-04-12T19:00:00+01:00\",\"sale_start_date\":\"2026-01-26T17:00:00+00:00\",\"event_start_date\":\"2026-04-12T19:00:00+01:00\",\"event_end_date\":\"2026-04-12T23:00:00+01:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"announcement_date_unix\":1769446800,\"offers_extras\":false,\"secondary_status\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2805},\"id\":\"6945c4cdab956f0001842c80\",\"name\":\"Ex-Otago\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Ex-Otago\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2025-12-03/e988ab87-5372-49b0-aa48-51b370667df0.jpg?rect=667%2C0%2C2667%2C2667\"},\"artist_id\":\"91261\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"new\":false,\"seating\":null,\"perm_name\":\"eob97w-ex-otago-12th-apr-the-lower-third-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-19/3deb0cc0-4f22-46c3-a42f-d325320cba9b.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-19/3deb0cc0-4f22-46c3-a42f-d325320cba9b.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-19/3deb0cc0-4f22-46c3-a42f-d325320cba9b.jpg?rect=243%2C0%2C594%2C1080\"},\"has_multiple_ticket_types\":true,\"unicorn_extras\":true,\"score\":0,\"about\":{\"description\":\"Ex-Otago live in London for the '10 anni di Marassi'  \\n  \\nGli Ex-Otago si formano a Genova nel 2002 come trio acustico, sono tra le prime band ad esplorare il suono indie pop d’oltreoceano e a sposarlo alla canzone italiana. Negli ultimi vent’anni, attraverso vari cambi di formazione, si sono confrontati con un pubblico sempre più ampio. Se la consacrazione come nome cult della scena underground è stata decretata da “Mezze Stagioni” (2011), le successive evoluzioni sono state il successo nazionale del disco “Marassi” (2016) e la partecipazione al festival di Sanremo nel 2019 con “Solo una canzone”. Dopo una lunga pausa, nel 2023 hanno pubblicato l’album “Auguri” e sono tornati ad attraversare il Paese con il loro canzoniere fatto ormai interamente di classici del pop d’autore.\\n\\n*For accessibility information please see the accessibility information button/link below.*\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 16+ event\",\"subtitle\":null,\"external_link\":null}]},\"acquisition_type\":\"purchase\",\"event_tag\":null},{\"unicorn\":false,\"donation\":null,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"faqs\":[],\"marketeers\":[{\"id\":380,\"name\":\"Columbo Music\",\"privacy_policy_link\":\"https://thecolumbogroup.com/privacy-policy/\",\"fb_pixel_id\":\"298700384025189\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"attendance_type\":\"live_only\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Deixa (feat. Ana Gabriela)\",\"redirect_url\":\"https://open.spotify.com/track/3fLqmaO4vvZpFZSZy52VMp\",\"artist\":\"\",\"preview_url\":\"https://p.scdn.co/mp3-preview/9abad982e572c4bc71e72abb28812f262d3c37dd?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Deixa (feat. Ana Gabriela)\"}],\"is_fully_locked\":false,\"is_ticket_available_at_door\":false,\"is_hidden_event\":false,\"seats_io_public_key\":null,\"properties\":[],\"date_unix\":1776016800,\"tty_to_extras\":[],\"venues\":[{\"id\":\"415\",\"name\":\"The Jazz Cafe\",\"address\":\"5 Parkway, London NW1 7PG\",\"location\":{\"lat\":51.5387845,\"lng\":-0.143146300000012},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,