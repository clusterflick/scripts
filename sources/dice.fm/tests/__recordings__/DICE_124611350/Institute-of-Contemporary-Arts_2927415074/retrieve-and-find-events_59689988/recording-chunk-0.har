able_at_door\":false,\"properties\":[],\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"unicorn_extras\":false,\"offers_extras\":false,\"attendance_type\":\"live_only\",\"seats_io_event_id\":null,\"social_links\":{\"event_share\":\"https://link.dice.fm/r8f98e08b217?dice_id=r8f98e08b217\",\"post_competition_referral\":\"https://link.dice.fm/M55d7e8d9ddd?dice_id=M55d7e8d9ddd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/se129210fbf7?dice_id=se129210fbf7\",\"post_purchase_referral\":\"https://link.dice.fm/C1c945dbce0b?dice_id=C1c945dbce0b\",\"post_reminder_referral\":\"https://link.dice.fm/U1533ea172aa?dice_id=U1533ea172aa\",\"post_waitinglist_referral\":\"https://link.dice.fm/xe738359cb19?dice_id=xe738359cb19\"},\"is_fully_locked\":false,\"is_hidden_event\":false,\"about\":{\"description\":\"FORM Presents\\n\\nCASS MCCOMBS\\n\\n\\\\+ Brigid Mae Power\\n\\nOver the past twenty plus years, Cass McCombs has journeyed a singular path as an uncompromising song-carver, guitarist and singer. Along with the finest squadron of collaborators and bandmates, his music travels gracefully over seemingly contradictory terrain, from infectious guitar riffage to intensely personal lyricism.\\n\\nIn August 2025, Cass released his newest album “Interior Live Oak” to rave reviews including 5 stars from the Guardian, an 8.1 from Pitchfork who said “16 songs and not a throwaway among them…,” a 9/10 from Uncut Magazine, and a rave from Mojo magazine who said “...this is the kind of record it’s impossible to be casual about.”\\n\\nInterior Live Oak is his most personal album to date, and, more than anyprevious record, shows his vast range as a lyricist and musician. It draws fromeverything Cass has created over two decades of experimentation to cut throughwith a direct and clarifying light. Cass McCombs will embark on his “Interior Live Oak Live” tour over 2026. He lives in New York City.\",\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages, under 16s accompanied by an adult.\",\"subtitle\":null,\"external_link\":null}]},\"seats_io_public_key\":null,\"marketeers\":[{\"id\":338,\"name\":\"FORM Presents\",\"privacy_policy_link\":\"https://formpresents.com/privacy-policy/\",\"fb_pixel_id\":\"502219323814680\",\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"date_unix\":1771614000,\"venues\":[{\"id\":\"65\",\"name\":\"Union Chapel\",\"address\":\"Compton Terrace, London N1 2UN, UK\",\"location\":{\"lat\":51.5447669,\"lng\":-0.102892500000053},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"union-chapel-jx9a\",\"accessibility\":{\"url\":\"https://www.unionchapel.org.uk/accessibility\"},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-02-20T19:00:00+00:00\",\"doors_close_date\":null}],\"status\":\"on-sale\",\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"shopping_cart_enabled\":false,\"max_tickets\":6,\"donation\":null,\"streaming_options\":null,\"impression_id\":\"80cf0d405ef65b94:49\",\"tty_to_extras\":[],\"secondary_status\":null,\"billing_promoter\":{\"id\":\"9454\",\"name\":\"FORM\",\"image\":{\"url\":null},\"perm_name\":\"form-5rnk\",\"profile_active\":false},\"id\":\"68f21d5d8aafe30001f643ab\",\"name\":\"Cass McCombs + band\",\"perm_name\":\"xekrq3-cass-mccombs-band-20th-feb-union-chapel-london-tickets\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-10-17/a5fe07dc-24b1-4c6e-b37