kora-and-tomorrows-warriors-frontline-19th-mar-elgar-room-at-royal-albert-hall-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1773950400,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2025-12-22/de49e19a-9999-463a-acb9-cc470ccb1c96.jpg?rect=0%2C0%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2025-12-22/de49e19a-9999-463a-acb9-cc470ccb1c96.jpg?rect=0%2C384%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2025-12-22/de49e19a-9999-463a-acb9-cc470ccb1c96.jpg?rect=432%2C0%2C1056%2C1920\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/Sdf1672d8504?dice_id=Sdf1672d8504\",\"post_competition_referral\":\"https://link.dice.fm/Te1e2f615031?dice_id=Te1e2f615031\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/za8e2d40fc15?dice_id=za8e2d40fc15\",\"post_purchase_referral\":\"https://link.dice.fm/V67190539e28?dice_id=V67190539e28\",\"post_waitinglist_referral\":\"https://link.dice.fm/K7230d2b53d2?dice_id=K7230d2b53d2\",\"post_reminder_referral\":\"https://link.dice.fm/idc07a3230ea?dice_id=idc07a3230ea\"},\"is_fully_locked\":false,\"venues\":[{\"id\":\"8368\",\"name\":\"Elgar Room at Royal Albert Hall\",\"address\":\"Elgar Room at Royal Albert Hall\",\"location\":{\"lat\":51.501267,\"lng\":-0.17754},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"accuracy\":12,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"54d8a87238fe5d27d500988a\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"elgar-room-at-royal-albert-hall-da6q\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-03-19T19:30:00+00:00\",\"doors_close_date\":null}],\"unicorn\":true,\"status\":\"on-sale\",\"secondary_status\":null,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"about\":{\"description\":\"Acclaimed jazz talent development charity, Tomorrow’s Warriors presents two all-female ensembles at different stages of their musical journeys, plus a special DJ set from Olivier award-winning composer, drummer, and Tomorrow’s Warriors Music Leader, Romarna Campbell, as part of our month-long celebration of International Women’s Day.\\n\\nTomorrow’s Warriors’ all-female flagship development ensemble, Frontline, will begin the evening with their powerful live show drawing inspiration from the jazz greats and blending a contemporary vibe with elements of jazz-fusion, funk, and R&B.\\n\\nHeadlining the evening is Ankora, an eight-piece ensemble that evolved from the previous iteration of Frontline into a formidable band in their own right. Featuring Mali Sheard, Keira Chakraborty, Hannah Clifton, Klara Devlin, Miranda Radford, Tami Adebanjo, Kezia Abuoma and Holly Reinhardt, Ankora is the exciting new step that the ensemble is taking as they journey deeper into their own musicality and establish their reputations as part of the current generation of musicians that are set to shape the sound of tomorrow’s London jazz scene.\\n\\nOur intimate Late Night Jazz series presents sensational music in the Elgar Room, celebrating the freshest sounds on the London scene alongside the finest in jazz standards.\\n\\nWe have a laid-back attitude at Late Night Jazz at the Royal Albert Hall. Customers are welcome to dance, move around, sing along, and enjoy themselves in whatever way feels most comfortable!\\n\\nAll customers aged 14 years or below must be accompanied by an adult aged 18 years or over\",\"highlights\":[]},\"acquisition_type\":\"purchase\",\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"has_multiple_ticket_types\":false,\"donation\":null,\"seats_io_event_id\":null,\"seats_io_public_key\":null,\"impression_id\":\"8245dee419ed43db:26\",\"billing_promoter\":{\"id\":\"2558\",\"name\":\"Royal Albert Hall\",\"image\":{\"url\":null},\"perm_name\":\"royal-albert-hall-8m2r\",\"profile_active\":false},\"presented_by\":\"Presented by Royal Albert Hall.\",\"properties\":[],\"unicorn_extras\":true,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"marketeers\":[],\"announcement_date_unix\":1766361600,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2025-12-22T00:00:00+00:00\",\"sale_end_date\":\"2026-03-18T12:00:00+00:00\",\"sale_start_date\":\"2025-12-22T00:00:00+00:00\",\"event_start_date\":\"2026-03-19T20:00:00+00:00\",\"event_end_date\":\"2026-03-19T23:00:00+00:00\",\"is_multi_days_event\":false,\"pre_sale_start_date\":null},\"id\":\"69497d052f57c30001e60083\",\"name\":\"Ankora and Tomorrow’s Warriors Frontline\",\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"new\":false,\"attendance_type\":\"live_only\",\"previews\":[],\"faqs\":[],\"score\":0,\"shopping_cart_enabled\":false,\"event_tag\":null}],\"title\":\"Thu 19 Mar\",\"image\":null,\"key\":null,\"action\":null,\"subtitle\":null,\"suggestion_type\":null,\"suggestion_name\":null,\"section_type\":\"events_vertical\",\"load_more\":null,\"section_hash\":null},{\"events\":[{\"is_ticket_available_at_door\":false,\"offers_extras\":false,\"is_hidden_event\":false,\"perm_name\":\"3owolx-malan-betsan-20th-mar-next-door-records-london-tickets\",\"seating\":null,\"tty_to_extras\":[],\"streaming_options\":null,\"date_unix\":1774029600,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-02-03/4227d1fe-877e-4d31-b44e-d0e51211bd57.jpg?rect=0%2C790%2C4735%2C4735\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-02-03/4227d1fe-877e-4d31-b44e-d0e51211bd57.jpg?rect=0%2C1737%2C4735%2C2841\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-02-03/4227d1fe-877e-4d31-b44e-d0e51211bd57.jpg?rect=631%2C0%2C3473%2C6314\"},\"max_tickets\":6,\"social_links\":{\"event_share\":\"https://link.dice.fm/e47d80