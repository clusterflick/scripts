ull,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"social_links\":{\"event_share\":\"https://link.dice.fm/T3712d3419f4?dice_id=T3712d3419f4\",\"post_competition_referral\":\"https://link.dice.fm/M5a8f1b00ef8?dice_id=M5a8f1b00ef8\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/v732954ce80a?dice_id=v732954ce80a\",\"post_purchase_referral\":\"https://link.dice.fm/Dfb6deb5205b?dice_id=Dfb6deb5205b\",\"post_reminder_referral\":\"https://link.dice.fm/i9e03f65ce44?dice_id=i9e03f65ce44\",\"post_waitinglist_referral\":\"https://link.dice.fm/H75816631c59?dice_id=H75816631c59\"},\"faqs\":[],\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"1505\",\"name\":\"The Horse Hospital\",\"address\":\"The Horse Hospital, 30 Colonnade, Bloomsbury, London WC1N 1JD, UK\",\"location\":{\"lat\":51.5230123,\"lng\":-0.12402510000003986},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-horse-hospital-g7ka\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[{\"type\":\"capacity\",\"title\":\"120 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-11-03T19:30:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-24T12:15:00+01:00\",\"sale_end_date\":\"2026-11-03T18:00:00+00:00\",\"sale_start_date\":\"2026-07-24T12:15:00+01:00\",\"event_start_date\":\"2026-11-03T19:30:00+00:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-11-03T23:00:00+00:00\",\"is_multi_days_event\":false},\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"perm_name\":\"l87yew-mississippi-records-presents-a-peoples-history-of-music-3rd-nov-the-horse-hospital-london-tickets\",\"summary_lineup\":{\"top_artists\":[{\"name\":\"Eric Isaacson\",\"image\":null,\"artist_id\":\"142335\",\"about\":{\"description\":\"A PEOPLE'S HISTORY OF MUSIC is a slideshow / lecture / film presentation which draws from archival film, sound clips and images to tell a history of global music scenes that struggled and endeavoured during periods of authoritarianism. The project, developed by Eric Isaacson, is a timely and compelling story of how powerful interests try to control music and how people fight back, nimbly evading systemic repressions by puritans, corporations and tech lords alike.\\n\\nMaking wide, bold swings, the show covers music from Ethiopia, Germany, North Korea, Cambodia, Brazil, Kenya, the USA and beyond, while drawing on Eric’s colourfully described, personal experiences of the fascist creep.\\n\\nEric Isaacson is the founder of Mississippi Records and many other small esoteric record labels such as Cairo, Pyramid and Velvet Ramp. Over the past twenty- three years he's released over 390 records and 165 mixtapes of DIY music from around the world. Eric is known for his humbly comical, singular style and for his ability to revitalize audiences through digging up buried treasures from the global music underground.\\n\\nhttps://www.mississippirecords.net/\",\"highlights\":[]},\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"seating\":null,\"has_multiple_ticket_types\":false,\"id\":\"6a634a585238c700010029c2\",\"billing_promoter\":{\"id\":\"34\",\"name\":\"Upset The Rhythm\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/42ef555c-26cf-421b-b66e-2030c1977b0c.jpg\"},\"perm_name\":\"upset-the-rhythm-z8e2\",\"profile_active\":true},\"properties\":[],\"about\":{\"description\":\"A PEOPLE'S HISTORY OF MUSIC is a slideshow / lecture / film presentation which draws from archival film, sound clips and images to tell a history of global music scenes that struggled and endeavoured during periods of authoritarianism. The project, developed by Eric Isaacson, is a timely and compelling story of how powerful interests try to control music and how people fight back, nimbly evading systemic repressions by puritans, corporations and tech lords alike.\\n\\nMaking wide, bold swings, the show covers music from Ethiopia, Germany, North Korea, Cambodia, Brazil, Kenya, the USA and beyond, while drawing on Eric’s colourfully described, personal experiences of the fascist creep.\\n\\nEric Isaacson is the founder of Mississippi Records and many other small esoteric record labels such as Cairo, Pyramid and Velvet Ramp. Over the past twenty- three years he's released over 390 records and 165 mixtapes of DIY music from around the world. Eric is known for his humbly comical, singular style and for his ability to revitalize audiences through digging up buried treasures from the global music underground.\\n\\nhttps://www.mississippirecords.net/\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Upset The Rhythm.\",\"subtitle\":null,\"external_link\":null}]},\"presented_by\":\"Presented by Upset The Rhythm.\",\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1793734200,\"offers_extras\":false,\"secondary_status\":null}",
