          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-02/2f424d8e-d066-459f-8684-32b24b3cc73d.jpg?rect=0%2C0%2C4500%2C4500\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-02/2f424d8e-d066-459f-8684-32b24b3cc73d.jpg?rect=0%2C900%2C4500%2C2700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-02/2f424d8e-d066-459f-8684-32b24b3cc73d.jpg?rect=1013%2C0%2C2475%2C4500\"},\"unicorn\":true,\"about\":{\"description\":\"Deeper Into Movies is digging into the VHS collection to bring you a series of double bills.\\n\\nWe're not trying to match the films through obvious themes or connections—this is more like walking into a video store and picking two tapes that catch your eye. Unexpected combinations of forgotten gems, cult oddities and straight to vidoe bangers.\\n\\n**CELLAR DWELLER (1988)**\\n\\nOne of the great late-80s video store monsters. When an aspiring comic-book artist inherits the studio of a legendary illustrator, drawings begin to manifest in horrifying ways, unleashing a gleefully grotesque creature brought to life through richly tactile practical effects.Cellar Dweller remains one of Empire Pictures' most underrated gems - it's a gloriously gooey mix of comic-book horror, haunted-house gothic, and practical-effects excess.\\n\\n**DEATH WISH CLUB (1984)**\\n\\nMedical student Glen Marshall becomes obsessed after seeing Gretta, a carnival runaway turned nightclub pianist and adult film star, on screen. His search for the enigmatic woman draws him into the orbit of her wealthy, manipulative benefactor and an exclusive society whose members flirt with death as the ultimate thrill, staging increasingly elaborate life-or-death games in pursuit of transcendence.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"is_fully_locked\":false,\"acquisition_type\":\"purchase\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"unicorn_extras\":true,\"price\":{\"currency\":\"GBP\",\"amount\":600,\"sales_tax\":0,\"amount_from\":null},\"is_hidden_event\":false,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"marketeers\":[],\"shopping_cart_enabled\":true,\"streaming_options\":null,\"name\":\"VHS DOUBLE BILL: DEATH WISH CLUB + CELLAR DWELLER \",\"secondary_status\":null,\"date_unix\":1788008400,\"social_links\":{\"event_share\":\"https://link.dice.fm/W8c1de48614a?dice_id=W8c1de48614a\",\"post_competition_referral\":\"https://link.dice.fm/D24001cc06dd?dice_id=D24001cc06dd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/D6affc949687?dice_id=D6affc949687\",\"post_purchase_referral\":\"https://link.dice.fm/S68cb9f4c6a6?dice_id=S68cb9f4c6a6\",\"post_reminder_referral\":\"https://link.dice.fm/qa4e78e6401f?dice_id=qa4e78e6401f\",\"post_waitinglist_referral\":\"https://link.dice.fm/zf675cf0ac60?dice_id=zf675cf0ac60\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-29T14:00:00+01:00\",\"doors_close_date\":null}],\"announcement_date_unix\":1782860400,\"seats_io_public_key\":null,\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Film Screening\",\"image\":{