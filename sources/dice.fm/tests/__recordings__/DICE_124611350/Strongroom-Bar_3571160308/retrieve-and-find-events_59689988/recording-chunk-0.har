          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"WEEKNIGHT TAPES\\n\\nPlaying classic concerts, festival appearances and music films in the pub.\\n\\nBig screens. Classic shows. Cold pints.\\n\\n12th August - The Strokes MTV $2 Bill (2002)\\n\\n19th August - Monterey Pop Festival (1967)\\n\\n26th August - Fela Kuti Live at Glastonbury (1984)\\n\\n2nd September - Jazz On A Summer's Day - Newport Jazz Festival (1958)\\n\\n9th September - The White Stripes Under Blackpool Lights (2004)\\n\\n16th September - Fatboy Slim Live on Brighton Beach (2001)\\n\\n23rd September - The Cure - In Orange (1987)\\n\\n30th September - Elvis Presley - Comeback Special (1968)\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by OSLO\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oslo-hackney-je6z\",\"accessibility\":{\"url\":\"https://www.oslohackney.com/accessibility/\"},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"370 capacity\"},{\"type\":\"accessibility\",\"title\":\"Accessibility information\",\"external_link\":\"https://www.oslohackney.com/accessibility/\"}],\"space_name\":null,\"doors_open_date\":\"2026-09-23T19:30:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"ww9l5x-weeknight-tapes-the-cure-in-orange-1987-23rd-sep-oslo-hac