m\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-05T14:00:00+01:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-16T17:15:00+01:00\",\"sale_end_date\":\"2026-09-05T14:00:00+01:00\",\"sale_start_date\":\"2026-07-16T17:15:00+01:00\",\"event_start_date\":\"2026-09-05T14:00:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-09-05T15:30:00+01:00\",\"is_multi_days_event\":false},\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"perm_name\":\"oe823a-the-snare-uk-premiere-5th-sep-the-haggerston-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"seating\":null,\"has_multiple_ticket_types\":false,\"id\":\"6a5901d247c4e1000132d21c\",\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"properties\":[],\"about\":{\"description\":\"Cassady McClincy Zhang, best known for playing Lydia on “The Walking Dead,” stars as Dani, an 18-year-old straight-A student living on the precarious edge of lower-middle-class America. Between a fast-food job, caring for her younger brother, and a father in prison, college represents her chance to build a different life. Then an arrest threatens to wipe it all away.\\n\\nAfter police find a small amount of drugs on Dani, her scholarship becomes leverage. Rather than immediately charge her, officers offer a deal: help them make a drug bust, and they’ll make her problem disappear. Unfortunately, the only dealer Dani knows is Marty, played by Dempsey Bryk, a young man she’s increasingly drawn to. What begins as a seemingly straightforward bargain quickly traps Dani between protecting herself, betraying someone she cares about, and a police operation whose demands keep escalating.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"presented_by\":\"Presented by Deeper Into Movies.\",\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1788613200,\"offers_extras\":false,\"secondary_status\":null}",
