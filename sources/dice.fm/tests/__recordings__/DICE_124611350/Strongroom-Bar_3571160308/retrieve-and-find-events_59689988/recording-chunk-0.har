            "text": "{\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-07-16/dc9f6aa6-e891-48ee-8b53-8212a95ea81b.jpg?rect=345%2C0%2C1358%2C1358\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-07-16/dc9f6aa6-e891-48ee-8b53-8212a95ea81b.jpg?rect=0%2C65%2C2048%2C1229\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-07-16/dc9f6aa6-e891-48ee-8b53-8212a95ea81b.jpg?rect=651%2C0%2C747%2C1358\"},\"presented_by\":\"Presented by Deeper Into Movies. \",\"unicorn\":true,\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"faqs\":[],\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-26T14:00:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"bb9lpv-heaven-knows-what-26th-sep-the-haggerston-london-tickets\",\"marketeers\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":30,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"HEAVEN KNOWS WHAT \",\"social_links\":{\"event_share\":\"https://link.dice.fm/o6a4b4044aa8?dice_id=o6a4b4044aa8\",\"post_competition_referral\":\"https://link.dice.fm/j3e4fe1c78be?dice_id=j3e4fe1c78be\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/m01adcc0da4c?dice_id=m01adcc0da4c\",\"post_purchase_referral\":\"https://link.dice.fm/zf0ce93c4d90?dice_id=zf0ce93c4d90\",\"post_reminder_referral\":\"https://link.dice.fm/Oec7226b633b?dice_id=Oec7226b633b\",\"post_waitinglist_referral\":\"https://link.dice.fm/P29520940a8e?dice_id=P29520940a8e\"},\"is_hidden_event\":false,\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"announcement_date_unix\":1784218500,\"is_fully_locked\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-16T17:15:00+01:00\",\"sale_end_date\":\"2026-09-26T14:00:00+01:00\",\"sale_start_date\":\"2026-07-16T17:15:00+01:00\",\"event_start_date\":\"2026-09-26T14:00:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-09-26T16:00:00+01:00\",\"is_multi_days_event\":false},\"has_multiple_ticket_types\":false,\"id\":\"6a590218a8967f0001f579c1\",\"properties\":[],\"is_ticket_available_at_door\":false,\"seating\":null,\"donation\":null,\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1790427600,\"offers_extras\":false,\"secondary_status\":null,\"previews\":[],\"about\":{\"description\":\"Heaven Knows What resets the genre of drug addiction drama by combining stylistic cinematography with an incredible autobiographical performance by first-time actor Arielle Holmes.\\n\\nSet on the streets of post-financial crash New York, it depicts the real story of a drug-addicted lovers struggling from moment to moment, surrounded by a circle of deceptive and flaky individuals.\\n\\nThe story of how the film came to be made is as fascinating as the film itself. Co-directors and brothers Josh and Benny Safdie were filming test shots in the diamond district of New York when they discovered the 20-year old Holmes, whose charisma shone through her rough exterior. They convinced her to write a memoir about her life, Mad Love in New York City, which was turned into a script.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies. \",\"subtitle\":null,\"external_link\":null}]}}",
