          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"Made over seven years, Paris Is Burning offers an intimate portrait of rival fashion houses, from fierce contests for trophies to house mothers offering sustenance in a world rampant with homophobia, transphobia, racism, AIDS, and poverty. Featuring legendary voguers, drag queens, and trans women including Willi Ninja, Pepper LaBeija, Dorian Corey, and Venus Xtravaganza. Paris Is Burning brings it, celebrating the joy of movement, the force of eloquence, and the draw of community.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-22T14:00:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"wwmd6v-paris-is-burning-22nd-aug-the-haggerston-london-tickets\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"PARIS IS BURNING\",\"social_links\":{\"event_share\":\"https://link.dice.fm/e8fdc6a372c5?dice_id=e8fdc6a372c5\",\"post_competition_referral\":\"https://l