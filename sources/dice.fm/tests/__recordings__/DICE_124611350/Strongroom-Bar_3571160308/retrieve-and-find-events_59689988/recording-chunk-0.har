          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"So you want money to make to your short film?\\n\\nIn this session, Kino CEO Dustin Curtis Murphy speaks to other short film financiers about their varying processes and how your funding application can stand out from the rest.\\n\\nThe Kino Short Film Fund offers up to £5000 to cover the costs of Production, Post-Production and/or Distribution + access to equipment + mentorship.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"one_liner\":null,\"highlights\":[{\"type\":\"promoter\",\"title\":\"Presented by Kino Short Film.\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"300 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-08-29T12:00:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"2wqwp6-kino-industry-session-finding-short-film-funding-29th-aug-strongroom-bar-london-tickets\",\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":20,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name