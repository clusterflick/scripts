            "mimeType": "application/json; charset=utf-8",
            "text": "{\"faqs\":[],\"unicorn_extras\":true,\"about\":{\"description\":\"Join us for a special family screening of Fantastic Mr. Fox (2009), Wes Anderson's charming stop-motion adaptation of Roald Dahl's beloved classic.\\n\\nMr. Fox can't resist one last daring raid on the farms of the ruthless Boggis, Bunce and Bean, setting off an adventure full of clever schemes, unforgettable characters, and heartwarming family moments.\\n\\nBursting with Anderson's signature visual style, sharp humour, and an all-star voice cast, Fantastic Mr. Fox is a joyful celebration of family, friendship, and embracing who you are. A modern animated classic that's just as entertaining for adults as it is for children.\\n\\n**Certificate: PG**\\n\\n**Running Time: 87 minutes**\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"All ages\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1000},\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"previews\":[],\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"FANTASTIC MR. FOX  (FAMILY FILM SCREENING) \",\"is_hidden_event\":false,\"acquisition_type\":\"purchase\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-02/2e9b33c7-cc02-4476-8779-12013bd67181.jpg?rect=560%2C0%2C1440%2C1440\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-02/2e9b33c7-cc02-4476-8779-12013bd67181.jpg?rect=80%2C0%2C2400%2C1440\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-02/2e9b33c7-cc02-4476-8779-12013bd67181.jpg?rect=884%2C0%2C792%2C1440\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"7425\",\"name\":\"Big Penny Social\",\"address\":\"1 Priestley Way, London E17 6AL, UK\",\"location\":{\"lat\":51.59085509999999,\"lng\":-0.04131809999999999},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2022-09-15/018322b6-65c3-40f9-851e-9d09dfa35252.jpg?rect=0%2C0%2C1000%2C1000\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"big-penny-social-ayxd\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"2000 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-12-05T12:00:00+00:00\",\"doors_close_date\":null}],\"announcement_date_unix\":1785753000,\"social_links\":{\"event_share\":\"https://link.dice.fm/K4a1378324ae?dice_id=K4a1378324ae\",\"post_competition_referral\":\"https://link.dice.fm/qf1c46d18b6a?dice_id=qf1c46d18b6a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/zd6e6a5dcda3?dice_id=zd6e6a5dcda3\",\"post_purchase_referral\":\"https://link.dice.fm/Q5e1aaa2d577?dice_id=Q5e1aaa2d577\",\"post_reminder_referral\":\"https://link.dice.fm/Qfc094ed64bf?dice_id=Qfc094ed64bf\",\"post_waitinglist_referral\":\"https://link.dice.fm/ac3614fc9458?dice_id=ac3614fc9458\"},\"is_fully_locked\":false,\"unicorn\":true,\"multi_step_extras\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"perm_name\":\"q2qbp9-fantastic-mr-fox-family-film-screening-5th-dec-big-penny-social-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-08-03T11:30:00+01:00\",\"sale_end_date\":\"2026-12-05T11:00:00+00:00\",\"sale_start_date\":\"2026-08-03T11:30:00+01:0