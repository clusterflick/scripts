          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-03/72ac92cd-3f96-495a-89e8-d0a3bac40452.jpg?rect=0%2C26%2C1754%2C1754\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-03/72ac92cd-3f96-495a-89e8-d0a3bac40452.jpg?rect=0%2C377%2C1754%2C1052\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-03/72ac92cd-3f96-495a-89e8-d0a3bac40452.jpg?rect=381%2C0%2C993%2C1806\"},\"presented_by\":\"Presented by EartH. \",\"unicorn\":true,\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[{\"ticket_type_id\":1360599,\"extra_ids\":[\"1371157\"]},{\"ticket_type_id\":1360600,\"extra_ids\":[\"1371157\"]}],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"donation\":null,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":2818},\"billing_promoter\":{\"id\":\"11564\",\"name\":\"EartH\",\"image\":{\"url\":null},\"perm_name\":\"earth-yxox\",\"profile_active\":false},\"marketeers\":[{\"id\":863,\"name\":\"EartH\",\"privacy_policy_link\":\"https://earthackney.co.uk/privacy-policy/\",\"fb_pixel_id\":\"498772217287544\",\"ga_tracking_id\":\"G-6QJEY8LKG2\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":\"781332317\",\"google_ads_purchase_conversion_label\":\"nxkPCNyPg5caEN3eyPQC\",\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"about\":{\"description\":\"This event will take place in EartH Theatre.\\n\\nOn a distant planet, size determines destiny. A fever dream of liberation, set to jazz from the void.\\n\\nScreening of 70s surrealist epic, La Planète Sauvage with a live score performed by HAHA Sounds Collective, introduced by Pierre Bouvier Patron.\\n\\nFeaturing: Alex Burke, Clementine Brown, Eno Inwang, Joel Burton, Magdalena McLean, Marie Merlet, Nathan Pigott, Oscar Robertson, Phoebe Coco, Sarah Downie, Syd Kemp, Tom McBrien, Victoria Hamblett.\\n\\nFor more information on access at EartH, please see our FAQs here: https://bit.ly/44dzl75 or contact us at access@earthackney.co.uk\\n\\nEartH is a social enterprise committed to supporting new musicians, with music studios in the venue that are completely free for young artists to use. When you attend a show in EartH Theatre, head to the back of the space to rent a cushion for just £2. Not only will you get to sit more comfortably, but all proceeds go towards funding Studio 36. Find out more here: https://earthackney.co.uk/about/studio-36/\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"16+ event. (16-17 with a responsible adult 18+,1:1) \",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by EartH. \",\"subtitle\":null,\"external_link\":null}]},\"name\":\"La Planète Sauvage screening with live score by HaHa Sounds Collective\",\"is_hidden_event\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/Q2e00b6cd988?dice_id=Q2e00b6cd988\",\"post_competition_referral\":\"https://link.dice.fm/Q4a96fbed6cc?dice_id=Q4a96fbed6cc\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/Kd90739133fb?dice_id=Kd90739133fb\",\"post_purchase_referral\":\"https://link.dice.fm/E3c01c084742?dice_id=E3c01c084742\",\"post_reminder_referral\":\"https://link.dice.fm/Rab3ba7ff0d5?dice_id=Rab3ba7ff0d5\",\"post_waitinglist_referral\":\"https://link.dice.fm/ff9e187af070?dice_id=ff9e187af070\"},\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"venues\":[{\"id\":\"1955\",\"name\":\"EartH\",\"address\":\"11 Stoke Newington Rd, London N16 8BH, UK\",\"location\":{\"lat\":51.5509892,\"lng\":-0.07532500000002074},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2023-02-02/92037b31-0756-4c73-9f1b-11e5c4753296.jpg?rect=683%2C0%2C1365%2C1365\"}