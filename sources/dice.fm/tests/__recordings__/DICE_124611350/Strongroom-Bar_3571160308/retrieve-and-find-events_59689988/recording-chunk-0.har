            "mimeType": "application/json; charset=utf-8",
            "text": "{\"billing_promoter\":{\"id\":\"11708\",\"name\":\"Kino Short Film\",\"image\":{\"url\":null},\"perm_name\":\"kino-short-film-n5g5\",\"profile_active\":false},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-07-23/739c4510-c019-4308-a647-9f1634defeb2.jpg?rect=0%2C0%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-07-23/739c4510-c019-4308-a647-9f1634defeb2.jpg?rect=0%2C384%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-07-23/739c4510-c019-4308-a647-9f1634defeb2.jpg?rect=432%2C0%2C1056%2C1920\"},\"presented_by\":\"Presented by Kino Short Film.\",\"unicorn\":true,\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"faqs\":[],\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"300 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-08-29T15:30:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"avxvy2-kino-industry-session-making-laughs-a-livelihood-29th-aug-strongroom-bar-london-tickets\",\"marketeers\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":20,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Kino Industry Session: Making Laughs A Livelihood\",\"social_links\":{\"event_share\":\"https://link.dice.fm/Y85d2220aad2?dice_id=Y85d2220aad2\",\"post_competition_referral\":\"https://link.dice.fm/P3f740a6d4cd?dice_id=P3f740a6d4cd\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/G37d1d74550d?dice_id=G37d1d74550d\",\"post_purchase_referral\":\"https://link.dice.fm/P1f60a80b795?dice_id=P1f60a80b795\",\"post_reminder_referral\":\"https://link.dice.fm/Zadd4a79ef8a?dice_id=Zadd4a79ef8a\",\"post_waitinglist_referral\":\"https://link.dice.fm/M58d55fbcc16?dice_id=M58d55fbcc16\"},\"is_hidden_event\":false,\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"announcement_date_unix\":1784365200,\"is_fully_locked\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-18T10:00:00+01:00\",\"sale_end_date\":\"2026-08-29T15:45:00+01:00\",\"sale_start_date\":\"2026-07-18T10:30:00+01:00\",\"event_start_date\":\"2026-08-29T15:30:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-08-29T16:30:00+01:00\",\"is_multi_days_event\":false},\"has_multiple_ticket_types\":false,\"id\":\"6a61bc950561440001735422\",\"properties\":[],\"is_ticket_available_at_door\":false,\"seating\":null,\"donation\":null,\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1788013800,\"offers_extras\":false,\"secondary_status\":null,\"previews\":[],\"about\":{\"description\":\"What makes a character, scene or line funny? And how can answering that question be your career?\\n\\nWriter/director/producer Izzy Mant and director Jennifer Sheridan have told comic stories across film and TV, including ***Peep Show**, **The Other Bennet Sister**, **Extraordinary**, **Toast of London**,* ***The Windsors*** and ***Trying***. They share the comedy tricks and techniques they’ve learned throughout their careers, alongside the story of how they built award-winning careers developing, writing and directing comedy for major broadcasters and streamers.\\n\\nBetween them, Izzy and Jen have won two BAFTAs, two Royal Television Society Awards and a Venice Television Society Award. They’ll offer practical insights for directors, writers, script editors and anyone looking to raise a laugh, as well as an honest look behind the scenes of building a successful career in comedy.\\n\\nThis industry session is a fundraiser for Izzy’s comedy-thriller Kino Original short film, ***How To Do A Kidnap***. 100% of ticket sale proceeds will go towards production costs.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"one_liner\":null,\"highlights\":[{\"type\":\"promoter\",\"title\":\"Presented by Kino Short Film.\",\"subtitle\":null,\"external_link\":null}]}}",
