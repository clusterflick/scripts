          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-12/0a05dfb6-77a5-46ec-a62f-096a779c63be.jpg?rect=716%2C993%2C1555%2C1555\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-12/0a05dfb6-77a5-46ec-a62f-096a779c63be.jpg?rect=0%2C1010%2C2480%2C1488\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-12/0a05dfb6-77a5-46ec-a62f-096a779c63be.jpg?rect=276%2C0%2C1929%2C3508\"},\"unicorn\":true,\"about\":{\"description\":\"THE INDIE SLEAZE ERA IN THIS LOVE TRIANGLE ROM-COM\\n\\nA 24-year-old music critic (Barbie Ferreira) gets romantically involved with two members of the same indie band she is covering, set against Montreal's vibrant indie music scene in 2011.\\n\\nMile End Kicks is a Canadian coming-of-age romantic comedy film written and directed by Chandler Levack. The film stars Barbie Ferreira as Grace Pine, a young woman who moves to Montreal, Quebec, in 2011 with the goal of writing a book about Alanis Morissette’s album Jagged Little Pill but instead becomes romantically involved with Archie (Devon Bostick) and Chevy (Stanley Simons), two members of the aspiring indie rock band Bone Patrol, and takes a job as the band’s publicist.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"is_fully_locked\":false,\"acquisition_type\":\"purchase\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"unicorn_extras\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"is_hidden_event\":false,\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"marketeers\":[],\"shopping_cart_enabled\":true,\"streaming_options\":null,\"name\":\"MILE END KICKS \",\"secondary_status\":null,\"date_unix\":1789410600,\"social_links\":{\"event_share\":\"https://link.dice.fm/Ndb51013954c?dice_id=Ndb51013954c\",\"post_competition_referral\":\"https://link.dice.fm/w47493d6a014?dice_id=w47493d6a014\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/tc15934fa56e?dice_id=tc15934fa56e\",\"post_purchase_referral\":\"https://link.dice.fm/g4ecd0ed8a99?dice_id=g4ecd0ed8a99\",\"post_reminder_referral\":\"https://link.dice.fm/Id1c04a24505?dice_id=Id1c04a24505\",\"post_waitinglist_referral\":\"https://link.dice.fm/xb9c78bed0dd?dice_id=xb9c78bed0dd\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"956\",\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road, london SE15 3BE\",\"location\":{\"lat\":51.4582576,\"lng\":-0.0521545000000287},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-ivy-house-nvk5\",\"accessibility\":{\"url\":\"https://www.ivyhousenunhead.com/about\"},\"profile_active\":false,\"highlights\":[{\"type\":\"accessibility\",\"title\":\"Accessibility information\",\"external_link\":\"https://www.ivyhousenunhead.com/about\"}],\"space_name\":null,\"doors_open_date\":\"2026-09-14T19:30:00+01:00\",\"doors_close_date\":null}],\"announcement_date_unix\":1786553100,\"seats_io_public_key\":null,\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Film Screening\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-09-15/0b8ef9ab-63ad-41fd-bec4-98e25f9bca16.jpg?rect=67%2C0%2C798%2C798\"},\"artist_id\":\"11393\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-08-12T17:45:00+01:00\",\"sale_end_date\":\"2026-09-14T19:00:00+01:00\",\"sale_start_date\":\"2026-08-12T1