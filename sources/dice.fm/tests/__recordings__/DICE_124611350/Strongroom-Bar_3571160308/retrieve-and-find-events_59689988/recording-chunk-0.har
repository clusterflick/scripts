          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"At the moment Anna’s (Nicole Kidman) husband, Sean, dies while jogging in Central Park, a child is born. Ten years later, as Anna has just accepted a marriage proposal from boyfriend Joseph (Danny Huston), that child slips into her apartment and informs her that he is Sean, returned. So begins Glazer’s eerie, utterly unpredictable, and controversial drama, which boasts a screenplay co-written by longtime Buñuel collaborator Jean-Claude Carrière; a rich, fully orchestrated score from composer Alexandre Desplat; daringly underexposed cinematography by the late, great Harris Savides, which helps create the film’s atmosphere of endless emotional winter; and Kidman at her icy best.s and relationships with wry humor and refreshing frankness.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event.\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-19T14:00:00+01:00\",\"doors_close_date\":null}],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\