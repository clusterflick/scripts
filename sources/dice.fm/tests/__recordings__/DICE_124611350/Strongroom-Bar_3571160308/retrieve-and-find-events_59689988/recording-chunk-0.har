            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"A selection of new works from Kino community members & festival alumni. Our alums have qualified for the Best British Short BIFA in the past… why not give a BIFA to one of them this year?\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Kino Short Film.\",\"subtitle\":null,\"external_link\":null}]},\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":11},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"13499\",\"name\":\"art'otel London Hoxton\",\"address\":\"1-3 Rivington Street, Hackney, London, EC2A 3DT, United Kingdom\",\"location\":{\"lat\":51.52617,\"lng\":-0.08326},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"artotel-london-hoxton-lper\",\"accessibility\":{\"url\":null},\"profile_active\":false,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-29T13:00:00+01:00\",\"doors_close_date\":null}],\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-07-14/e3ce39f4-c807-4772-8e85-cd92f6b3f0de.jpg?rect=0%2C0%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-07-14/e3ce39f4-c807-4772-8e85-cd92f6b3f0de.jpg?rect=0%2C384%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-07-14/e3ce39f4-c807-4772-8e85-cd92f6b3f0de.jpg?rect=432%2C0%2C1056%2C1920\"},\"name\":