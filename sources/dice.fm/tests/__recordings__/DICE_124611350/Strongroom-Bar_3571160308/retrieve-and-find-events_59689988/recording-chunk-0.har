\\nFollow us on instagram for more movie events @deepermovies\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]}}",
