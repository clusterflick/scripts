            "mimeType": "application/json; charset=utf-8",
            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-17/9a5196ee-2879-4745-bd5f-1edc59577b75.jpg?rect=1050%2C1077%2C2373%2C2373\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-17/9a5196ee-2879-4745-bd5f-1edc59577b75.jpg?rect=0%2C900%2C4500%2C2700\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-17/9a5196ee-2879-4745-bd5f-1edc59577b75.jpg?rect=1013%2C0%2C2475%2C4500\"},\"presented_by\":\"Presented by Deeper Into Movies.\",\"unicorn\":true,\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"donation\":null,\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"marketeers\":[],\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"about\":{\"description\":\"Eventually stars burn out. The Weiss family is the archetypical Hollywood dynasty: father Stafford is an analyst and coach, who has made a fortune with his self-help manuals; mother Cristina mostly looks after the career of their son Benjie, 13, a child star. Driven by an intense need for fame and validation, the members of this dysfunctional family are chasing celebrity, one another and the relentless ghosts of their pasts.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"name\":\"MAPS TO THE STARS\",\"is_hidden_event\":false,\"social_links\":{\"event_share\":\"https://link.dice.fm/P3450545f647?dice_id=P3450545f647\",\"post_competition_referral\":\"https://link.dice.fm/pe5846414454?dice_id=pe5846414454\",\"post_p