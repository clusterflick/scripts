            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-04/63e6671b-26e5-4756-b394-fb1da6d55737.jpg?rect=0%2C0%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-04/63e6671b-26e5-4756-b394-fb1da6d55737.jpg?rect=0%2C216%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-04/63e6671b-26e5-4756-b394-fb1da6d55737.jpg?rect=243%2C0%2C594%2C1080\"},\"unicorn\":true,\"attendance_type\":\"live_only\",\"donation\":null,\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"previews\":[],\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":1500},\"announcement_date_unix\":1785834000,\"max_tickets\":12,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"The Rocky Horror Picture Show Movie Night\",\"is_hidden_event\":false,\"marketeers\":[{\"id\":12,\"name\":\"The Clapham Grand\",\"privacy_policy_link\":\"https://claphamgrand.com/privacy-policy/\",\"fb_pixel_id\":\"1705644923004016\",\"ga_tracking_id\":\"UA-5134978-1\",\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"social_links\":{\"event_share\":\"https://link.dice.fm/R1bc059081f5?dice_id=R1bc059081f5\",\"post_competition_referral\":\"https://link.dice.fm/ue861920de1a?dice_id=ue861920de1a\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/d8f8b2a14966?dice_id=d8f8b2a14966\",\"post_purchase_referral\":\"https://link.dice.fm/Nf8bb7a6b688?dice_id=Nf8bb7a6b688\",\"post_reminder_referral\":\"https://link.dice.fm/P5f90a6de06a?dice_id=P5f90a6de06a\",\"post_waitinglist_referral\":\"https://link.dice.fm/Xd80d57e1a45?dice_id=Xd80d57e1a45\"},\"faqs\":[{\"id\":48280,\"title\":\"What do I do if I have a question about the venue?\",\"body\":\"Check out all FAQs for attending shows on our website, here: https://claphamgrand.com/faqs/\\n\\nFor any further information about the show, timings, age restrictions or general questions please contact Team Grand on info@claphamgrand.com detailing your enquiry and the show/date in question and we’ll be happy to help\",\"order\":0},{\"id\":48281,\"title\":\"I have questions about access, where can I get the information I need?\",\"body\":\"Please note our Upstairs Bar is not wheelchair accessible & you will need to be able to take 8 flights of stairs to the 5th floor.\\n\\nYou can see our venue access info here - https://claphamgrand.com/accessibility/\\n\\nIf you require PA tickets or seat reservations for access reasons please contact us **prior** to purchasing your tickets to ensure we have availability and can meet your requirements. The best way to do this is by calling us on 020 7223 6523 or emailing access@claphamgrand.com & including your phone number in the email. Our office hours are 9am-5.30pm Mon – Sat\",\"order\":1},{\"id\":48284,\"title\":\"What can I expect in terms of flashing lights, loud noises and other similar elements?\",\"body\":\"Please note there may be strobes, flashing lights, loud noises, confetti, the occasional balloon drop and other fun stuff used in the venue. If you have any concerns about this don’t hesitate to contact us if you need any further assistance, we want to make sure you have a safe and enjoyable experience with us\",\"order\":2},{\"id\":48282,\"title\":\"I have already purchased my tickets & have questions about the tickets themselves\",\"body\":\"For any ticketing enquiries - for example where to find your tickets or about the Dice app please contact DICE via their Help Desk. If you still have questions after this, please email info@claphamgrand.com\",\"order\":3},{\"id\":48285,\"title\":\"What is 'unallocated' seating?\",\"body\":\"Most of our seated shows have unallocated seating, meaning seating is on a first come, first served basis in the area you have bought a ticket for (eg stalls/circle). We never sell more tickets than there are seats available - so if you've bought a ticket for a seat, you'll definitely get a seat, you just won't have a specific seat reserved.\",\"order\":4}],\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"1061\",\"name\":\"The Clapham Grand\",\"address\":\"The Clapham Grand, 21-25 St John's Hill, London SW11 1TT, UK\",\"location\":{\"lat\":51.4629923,\"lng\":-0.169368800000029},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2026-07-03/e259969a-4ab9-4749-9fe1-18cf6d32bda9.jpg?rect=0%2C0%2C1080%2C1080\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-clapham-grand-ry8v\",\"accessibility\":{\"url\":\"https://claphamgrand.com/accessibility/\"},\"profile_active\":true,\"highlights\":[{\"type\":\"accessibility\",\"title\":\"Accessibility information\",\"external_link\":\"https://claphamgrand.com/accessibility/\"}],\"space_name\":null,\"doors_open_date\":\"2026-10-31T18:00:00+00:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-08-04T10:00:00+01:00\",\"sale_end_date\":\"2026-10-31T18:00:00+00:00\",\"sale_start_date\":\"2026-08-25T10:00:00+01:00\",\"event_start_date\":\"2026-10-31T18:00:00+00:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-10-31T22:00:00+00:00\",\"is_multi_days_event\":false},\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"perm_name\":\"ryrb2r-the-rocky-horror-picture-show-movie-night-31st-oct-the-clapham-grand-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"seating\":null,\"has_multiple_ticket_types\":false,\"id\":\"6a71bda2acb4fb00012220d6\",\"billing_promoter\":{\"id\":\"399\",\"name\":\"The Clapham Grand\",\"image\":{\"url\":null},\"perm_name\":\"the-clapham-grand-zl9b\",\"profile_active\":false},\"properties\":[],\"about\":{\"description\":\"**SATURDAY 31ST OCTOBER / DOORS & BARS OPEN 6PM / LIVE SHOW & MOVIE FROM 7PM / LAST ENTRY 8PM / 18+**\\n\\n**It’s nearly time to do The Time Warp… again! Our Rocky Horror Movie Night is back and on actual Halloween too 🎃 Celebrate 50 years of this iconic film with us this October!**\\n\\nCome give yourself over to maximum pleasure… 🫦\\n\\nDust off those corsets and pink rubber gloves. Grab your emergency supply of Newspapers, loo roll, confetti, water pistols and toast and get your sweet transvestite arses down to the biggest & best Rocky Horror Picture Show screening in London, UK, hell THE WORLD 🌏\\n\\nSing-A-Long to the movie on a massive 25ft screen 📺\\n\\nYour Frank-N-Furter host - Drag Star Miss Leigh Ding! 👠\\n\\nOur Dreamteam showteam 🕺\\n\\nThe Sweetest Transvestite costume comp & Damn It Janet dance-offs ☠️\\n\\nCamp cocktails 🍹\\n\\nFrank N Furter hotdogs & nachos (Vegan goodness too!) 🌭\\n\\nOooky-spooky decor 🏚️\\n\\nPopcorn ONLY £3 🍿\\n\\n& The Time Warp. Again & Again & Again! 🕺💃\\n\\nFeel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar & food stalls stay open during the movie.\\n\\n**Your ticket includes entry to The Grand’s Halloween Party, too! Please note that last entry is 8pm and there is no re-entry between events.**\\n\\n**If you have any questions please scroll down to the FAQ section below.**\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by The Clapham Grand.\",\"subtitle\":null,\"external_link\":null}]},\"presented_by\":\"Presented by The Clapham Grand.\",\"seats_io_public_key\":null,\"status\":\"announced\",\"date_unix\":1793469600,\"offers_extras\":false,\"secondary_status\":null}",
