          ],
          "headersSize": 453,
          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-06-26/216f4a30-21ec-4a68-9bfa-75bfcb5592af.jpg?rect=0%2C0%2C2160%2C2160\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-06-26/216f4a30-21ec-4a68-9bfa-75bfcb5592af.jpg?rect=0%2C432%2C2160%2C1296\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-06-26/216f4a30-21ec-4a68-9bfa-75bfcb5592af.jpg?rect=486%2C0%2C1188%2C2160\"},\"unicorn\":true,\"about\":{\"description\":\"**Other Side Promotions present an excellent night of psychedelia from Australian headliners The Dharma Chain, plus special guests Low Harness.**\\n\\nPlus opening at 8pm we have an added London premier of a documentary Screening (20 mins duration):\\n\\n'We Sound Like Helicon' A short film about Psychedelia and creative collaboration. (full bio below)\\n\\nFeaturing Helicon & Al Lover\\n\\n**\\\\*PLEASE NOTE THAT HELICON WILL NOT BE PERFORMING AT THIS EVENT\\\\***\\n\\n𝐓𝐡𝐞 𝐃𝐡𝐚𝐫𝐦𝐚 𝐂𝐡𝐚𝐢𝐧:\\n\\nOriginally from Byron Bay, Australia, The Dharma Chain is a psychedelic rock band formed in 2020 and now based in Berlin. Their sound blends shoegaze, post-punk, and neo-psychedelia with flashes of ’60s rock, featuring distorted, ethereal guitars, reverb-soaked mixed vocals, industrial undertones, and atmospheric synths.\\n\\nAfter relocating to Berlin, the band signed with Anomic Records & released their debut album NOWHERE in 2022, with a second album 'Some Kind Of Pure State' released on Spinda Records on 5th June 2026.\\n\\nhttps://linktr.ee/thedharmachain\\n\\n𝐋𝐨𝐰 𝐇𝐚𝐫𝐧𝐞𝐬𝐬:\\n\\nA union of four seasoned DIY minds, Low Harness was born in 2023 when members met through working at Penryn DIY hub the Fish Factory Arts Space. With Hannah Gledhill and Martin Pease favouring alternative tunings, it was only a matter of time before they were writing together. Joined by Ed Shellard on drums and Alex Harmer on bass, the record emerged quickly after practising in a friend’s garage, with sonic touchpoints including 90s noise rock, Sonic Youth, Wire, MBV, Glenn Branca, and Einstürzende Neubauten. Their debut album Salvo was released in 2024.\\n\\nLow Harness supported the Manic Street Preachers for two nights in 12 April 2025 at the Barrowland Ballroom in Glasgow.\\n\\nhttps://linktr.ee/lowharness\\n\\n'We Sound Like Helicon' Documentary Screening - London premier!\\n\\n(20 mins duration / 8:00pm to 8:20pm)\\n\\nA short film about Psychedelia and creative collaboration.\\n\\nFeaturing Helicon & Al Lover\\n\\n\\\\*PLEASE NOTE THAT HELICON WILL NOT BE PERFORMING AT THIS EVENT\\\\*\\n\\nDirected by filmmaker James Ewen, the 20-minute documentary follows the collaboration between Glasgow psych-rock band HELICON and Los Angeles beat culture artist/DJ AL LOVER, exploring what happens when people from different musical backgrounds come together to create something neither could have made alone.\\n\\nFrom home demos and studio sessions to interviews, live shows and experimentation, WE SOUND LIKE HELICON is filmed around the recording of their new album ARISE at Castle of Doom Studios in Glasgow, capturing the humour, friendships and creative chaos that developed along the way.\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"one_liner\":null,\"highlights\":[{\"type\":\"promoter\",\"title\":\"Presented by Other Side Promotions.\",\"subtitle\":null,\"external_link\":null}]},\"is_fully_locked\":false,\"acquisition_type\":\"purchase\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"unicorn_extras\":true,\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"is_hidden_event\":false,\"billing_promoter\":{\"id\":\"5285\",\"name\":\"Other Side Promotions\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-09/c8464497-8f12-4558-84bb-ede11bc2ddb5.jpg\"},\"perm_name\":\"other-side-promotions-r5gv\",\"profile_active\":true},\"marketeers\":[],\"shopping_cart_enabled\":true,\"streaming_options\":null,\"name\":\"OSP Presents: The Dharma Chain (AUS) + Low Harness + DOC Screening: We Sound Like Helicon\",\"secondary_status\":null,\"date_unix\":1788461100,\"social_links\":{\"event_share\":\"https://link.dice.fm/K8365bc45a32?dice_id=K8365bc45a32\",\"post_competition_referral\":\"https://link.dice.fm/G98954bd40d6?dice_id=G98954bd40d6\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/o85daa93353a?dice_id=o85daa93353a\",\"post_purchase_referral\":\"https://link.dice.fm/j6edf0258642?dice_id=j6edf0258642\",\"post_reminder_referral\":\"https://link.dice.fm/N7356f37bf58?dice_id=N7356f37bf58\",\"post_waitinglist_referral\":\"https://link.dice.fm/U709472de428?dice_id=U709472de428\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"300 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-09-03T19:45:00+01:00\",\"doors_close_date\":null}],\"announcement_date_unix\":1782480600,\"seats_io_public_key\":null,\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Low Harness\",\"image\":null,\"artist_id\":\"138536\",\"about\":null,\"is_headliner\":false},{\"name\":\"The Dharma Chain\",\"image\":null,\"artist_id\":\"116835\",\"about\":null,\"is_headliner\":false}],\"total_artists\":2,\"total_fr