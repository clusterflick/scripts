          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"unicorn\":true,\"about\":{\"description\":\"We Are Making A Film About Mark Fisher — a 65-minute cinematic experiment exploring the continuing relevance of the late theorist’s ideas on capitalism, culture, and the future.\\n\\nBlending documentary, performance, and hauntological fiction, the film follows Parkins — a time-slipped character — through ghostly landscapes and digital spaces, tracing Fisher’s thought from the 1990s to our algorithmic present.\\n\\nCreated collaboratively by over 70 artists through Instagram (@markfisherfilm), the film embodies Fisher’s call for collective imagination beyond capitalist realism.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"summary_lineup\":{\"top_artists\":[{\"name\":\"Film Screening\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2020-09-15/0b8ef9ab-63ad-41fd-bec4-98e25f9bca16.jpg?rect=67%2C0%2C798%2C798\"},\"artist_id\":\"11393\",\"about\":null,\"is_headliner\":false}],\"total_artists\":1,\"total_free_texts\":0},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"venues\":[{\"id\":\"2338\",\"name\":\"The Haggerston\",\"address\":\"438 Kingsland Rd, London E8 4AA, UK\",\"location\":{\"lat\":51.5423183,\"lng\":-0.0758063000000675},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"the-haggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-08-22T16:00:00+01:00\",\"doors_close_date\":null}],\"price\