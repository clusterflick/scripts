          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"about\":{\"description\":\"WEEKNIGHT TAPES\\n\\nPlaying classic concerts, festival appearances and music films in the pub.\\n\\nBig screens. Classic shows. Cold pints.\\n\\n12th August - The Strokes MTV $2 Bill (2002)\\n\\n19th August - Monterey Pop Festival (1967)\\n\\n26th August - Fela Kuti Live at Glastonbury (1984)\\n\\n2nd September - Jazz On A Summer's Day - Newport Jazz Festival (1958)\\n\\n9th September - The White Stripes Under Blackpool Lights (2004)\\n\\n16th September - Fatboy Slim Live on Brighton Beach (2001)\\n\\n23rd September - The Cure - In Orange (1987)\\n\\n30th September - Elvis Presley - Comeback Special (1968)\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by OSLO\",\"subtitle\":null,\"external_link\":null}]},\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"billing_promoter\":{\"id\":\"67\",\"name\":\"DHP FAMILY\",\"image\":{\"url\":null},\"perm_name\":\"dhp-family-43kx\",\"profile_active\":true},\"unicorn\":true,\"marketeers\":[{\"id\":1201,\"name\":\"DHP Family\",\"privacy_policy_link\":\"https://www.dhpfamily.com/privacy-policy/\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"max_tickets\":6,\"public_refund_policy\":null,\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-05/ff7195c0-6e50-48e1-9ae4-46aa46541b9a.jpg?rect=0%2C180%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-05/ff