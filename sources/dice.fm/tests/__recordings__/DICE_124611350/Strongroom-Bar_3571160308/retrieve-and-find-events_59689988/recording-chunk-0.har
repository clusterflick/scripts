            "text": "{\"billing_promoter\":{\"id\":\"11708\",\"name\":\"Kino Short Film\",\"image\":{\"url\":null},\"perm_name\":\"kino-short-film-n5g5\",\"profile_active\":false},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=588%2C0%2C1511%2C1511\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=84%2C0%2C2518%2C1511\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-01-09/81bbbaba-025d-4ee7-8937-ba8e5a2a53d9.jpg?rect=928%2C0%2C831%2C1511\"},\"presented_by\":\"Presented by Kino Short Film.\",\"unicorn\":true,\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"faqs\":[],\"venues\":[{\"id\":\"298\",\"name\":\"Strongroom Bar\",\"address\":\"120-124 Curtain Rd, Shoreditch, London EC2A 3SQ, UK\",\"location\":{\"lat\":51.5259644,\"lng\":-0.0801498},\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-11-09/01c2cab5-15ea-48e0-a0b4-d9ed0465d9db.jpg?rect=0%2C0%2C850%2C850\"},\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"strongroom-bar-4bym\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"300 capacity\"}],\"space_name\":null,\"doors_open_date\":\"2026-08-25T19:00:00+01:00\",\"doors_close_date\":null}],\"perm_name\":\"92rago-short-film-open-screen-25th-aug-strongroom-bar-london-tickets\",\"marketeers\":[],\"price\":{\"currency\":\"GBP\",\"amount\":1000,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":20,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Short Film Open Screen\",\"social_links\":{\"event_share\":\"https://link.dice.fm/S1ba2704a778?dice_id=S1ba2704a778\",\"post_competition_referral\":\"https://link.dice.fm/D5dfa48d2822?dice_id=D5dfa48d2822\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/h1d6466b205f?dice_id=h1d6466b205f\",\"post_purchase_referral\":\"https://link.dice.fm/b1ca46df58e9?dice_id=b1ca46df58e9\",\"post_reminder_referral\":\"https://link.dice.fm/F0b6e9ccd536?dice_id=F0b6e9ccd536\",\"post_waitinglist_referral\":\"https://link.dice.fm/pc1a18c69d8e?dice_id=pc1a18c69d8e\"},\"is_hidden_event\":false,\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"announcement_date_unix\":1776070800,\"is_fully_locked\":false,\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":1},\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-04-13T10:00:00+01:00\",\"sale_end_date\":\"2026-08-25T20:00:00+01:00\",\"sale_start_date\":\"2026-07-04T10:30:00+01:00\",\"event_start_date\":\"2026-08-25T19:00:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-08-25T23:00:00+01:00\",\"is_multi_days_event\":false},\"has_multiple_ticket_types\":false,\"id\":\"6a4904ca1634340001f9d11e\",\"properties\":[],\"is_ticket_available_at_door\":false,\"seating\":null,\"donation\":null,\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1787680800,\"offers_extras\":false,\"secondary_status\":null,\"previews\":[],\"about\":{\"description\":\"Whether you’re looking for a chance to screen your short film in front of a live audience for free OR you’re looking to watch something wild, wacky, and creative outside of the mainstream, our open mic is refreshingly non-competitive in an all-too-oftentimes intimidating industry.\\n\\nBoth industry professionals and first-timers bring their shorts to Kino making the quality of cinema screened at each event both diverse and entertaining. And with such a broad spectrum of new work being screened, our Open Screen is a genuine reflection of the current output of London based filmmakers.\\n\\nREGISTER TO SCREEN YOUR SHORT FILM HERE: www.kinoshortfilm.com/short-film-openmic\\n\\n- One film per filmmaker\\n- Register in advance\\n- Filmmakers must be present to introduce film\\n- Films are accepted on a first-come, first-screened basis\\n- Film running time should be under 10 mins\\n\\nThis is an 18+ event. This venue has a strict No ID, No entry Policy. Physical government photo ID required, we do not accept photos or copies of ID’s.\",\"one_liner\":null,\"highlights\":[{\"type\":\"promoter\",\"title\":\"Presented by Kino Short Film.\",\"subtitle\":null,\"external_link\":null}]}}",
