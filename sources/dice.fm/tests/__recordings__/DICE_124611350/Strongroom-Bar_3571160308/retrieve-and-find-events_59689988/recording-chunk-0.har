          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"faqs\":[],\"unicorn_extras\":true,\"about\":{\"description\":\"The many faces of moden masculinity. Old men, young men, queer men… Men doing the right things and men doing the wrong things. From toxic takes to hold accountable bad behaviour, to portraits of positive male role models, this screening block offers a myriad of the male experience.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Kino Short Film.\",\"subtitle\":null,\"external_link\":null}]},\"price\":{\"currency\":\"GBP\",\"amount\":1500,\"sales_tax\":0,\"amount_from\":null},\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"previews\":[],\"max_tickets\":6,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":24},\"name\":\"Kino London Short Film Festival: Modern Masculine\",\"is_hidden_event\":false,\"acquisition_type\":\"purchase\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-07-14/afe0139a-4fa8-4aae-b2ba-ea94a12de558.jpg?rect=0%2C0%2C1920%2C1920\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-07-14/afe0139a-4fa8-4aae-b2ba-ea94a12de558.jpg?rect=0%2C384%2C1920%2C1152\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-07-14/afe0139a-4fa8-4aae-b2ba-ea94a12de558.jpg?rect=432%2C0%2C1056%2C1920\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"13499\",\"name\":\"art'otel London Hoxton\",\"address\":\"1-3 Rivington Street, Hackney, London, EC2A 3DT, United Kingdom\",\"location\":{\"lat\":51.52617,\"lng\":-0.08326},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"artotel-london-hoxton-lper\",\"ac