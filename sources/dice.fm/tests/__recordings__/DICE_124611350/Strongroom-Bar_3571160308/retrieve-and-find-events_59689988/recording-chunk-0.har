aggerston-29wp\",\"accessibility\":{\"url\":null},\"profile_active\":true,\"highlights\":[],\"space_name\":null,\"doors_open_date\":\"2026-09-12T14:00:00+01:00\",\"doors_close_date\":null}],\"is_fully_locked\":false,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-16T00:00:00+01:00\",\"sale_end_date\":\"2026-09-12T14:00:00+01:00\",\"sale_start_date\":\"2026-07-16T00:00:00+01:00\",\"event_start_date\":\"2026-09-12T14:00:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-09-12T16:30:00+01:00\",\"is_multi_days_event\":false},\"tags_types\":[{\"name\":\"film\",\"value\":\"culture:film\",\"title\":\"Film\"}],\"seats_io_event_id\":null,\"perm_name\":\"eo6g7y-crumb-12th-sep-the-haggerston-london-tickets\",\"summary_lineup\":{\"top_artists\":[],\"total_artists\":0,\"total_free_texts\":0},\"seating\":null,\"has_multiple_ticket_types\":false,\"id\":\"6a58e1ab493a0000016a272c\",\"billing_promoter\":{\"id\":\"1357\",\"name\":\"Deeper Into Movies\",\"image\":{\"url\":null},\"perm_name\":\"deeper-into-movies-pgep\",\"profile_active\":true},\"properties\":[],\"about\":{\"description\":\"Terry Zwigoff’s landmark 1995 film is an intimate documentary portrait of the underground artist Robert Crumb, whose unique drawing style and sexually and racially provocative subject matter have made him a household name in popular American art. Zwigoff candidly and colorfully delves into the details of Crumb’s incredible career and life, including his family of reclusive eccentrics, some of the most remarkable people you’ll ever see on-screen. At once a profound biographical portrait, a riotous examination of a man’s controversial art, and a devastating look at a troubled family, Crumb is a genuine American original.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Deeper Into Movies.\",\"subtitle\":null,\"external_link\":null}]},\"presented_by\":\"Presented by Deeper Into Movies.\",\"seats_io_public_key\":null,\"status\":\"on-sale\",\"date_unix\":1789218000,\"offers_extras\":false,\"secondary_status\":null}",
