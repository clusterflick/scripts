            "mimeType": "application/json; charset=utf-8",
            "text": "{\"faqs\":[],\"unicorn_extras\":true,\"about\":{\"description\":\"WEEKNIGHT TAPES\\n\\nPlaying classic concerts, festival appearances and music films in the pub.\\n\\nBig screens. Classic shows. Cold pints.\\n\\n12th August - The Strokes MTV $2 Bill (2002)\\n\\n19th August - Monterey Pop Festival (1967)\\n\\n26th August - Fela Kuti Live at Glastonbury (1984)\\n\\n2nd September - Jazz On A Summer's Day - Newport Jazz Festival (1958)\\n\\n9th September - The White Stripes Under Blackpool Lights (2004)\\n\\n16th September - Fatboy Slim Live on Brighton Beach (2001)\\n\\n23rd September - The Cure - In Orange (1987)\\n\\n30th September - Elvis Presley - Comeback Special (1968)\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is an 18+ event\",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by OSLO\",\"subtitle\":null,\"external_link\":null}]},\"price\":{\"currency\":\"GBP\",\"amount\":null,\"sales_tax\":null,\"amount_from\":0},\"attendance_type\":\"live_only\",\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"previews\":[],\"max_tickets\":6,\"public_refund_policy\":null,\"name\":\"Weeknight Tapes - Fatboy Slim live on Brighton Beach (2001)\",\"is_hidden_event\":false,\"acquisition_type\":\"purchase\",\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-08-05/ff7195c0-6e50-48e1-9ae4-46aa46541b9a.jpg?rect=0%2C180%2C1080%2C1080\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-08-05/ff7195c0-6e50-48e1-9ae4-46aa46541b9a.jpg?rect=0%2C396%2C1080%2C648\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-08-05/ff7195c0-6e50-48e1-9ae4-46aa46541b9a.jpg?rect=144%2C0%2C792%2C1440\"},\"is_ticket_available_at_door\":false,\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{