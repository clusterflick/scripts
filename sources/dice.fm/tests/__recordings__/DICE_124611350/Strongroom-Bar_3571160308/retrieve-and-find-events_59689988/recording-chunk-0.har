            "text": "{\"billing_promoter\":{\"id\":\"3316\",\"name\":\"Portals\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2021-09-15/254bb28c-10fd-4cb3-b04e-170620d66d4a.jpg\"},\"perm_name\":\"portals-y3ev\",\"profile_active\":true},\"unicorn\":true,\"summary_lineup\":{\"top_artists\":[{\"name\":\"Youthmovies\",\"image\":{\"url\":\"https://dice-i-scdn-co.imgix.net/image/ab67616d0000b2735acdb9f3f95630a062a76ec9\"},\"artist_id\":\"63848\",\"about\":null,\"is_headliner\":false},{\"name\":\"Verse Metrics\",\"image\":null,\"artist_id\":\"141896\",\"about\":null,\"is_headliner\":false},{\"name\":\"For Breakfast\",\"image\":{\"url\":\"https://dice-media.imgix.net/attachments/2024-06-03/62686f1d-e832-4438-8d85-55cf51d646e7.jpg?rect=0%2C0%2C640%2C640\"},\"artist_id\":\"18704\",\"about\":null,\"is_headliner\":false}],\"total_artists\":3,\"total_free_texts\":0},\"attendance_type\":\"live_only\",\"multi_step_extras\":false,\"tty_to_extras\":[],\"streaming_options\":null,\"shopping_cart_enabled\":true,\"faqs\":[],\"venues\":[{\"id\":\"21\",\"name\":\"Oslo Hackney\",\"address\":\"1a Amhurst Road, Hackney, London, E8 1LL, United Kingdom\",\"location\":{\"lat\":51.54716,\"lng\":-0.05558},\"image\":null,\"city\":{\"id\":\"54d8a23438fe5d27d500001c\",\"name\":\"London\",\"location\":{\"lat\":51.507653,\"lng\":-0.107722,\"place\":\"Europe/London\"},\"country_code\":\"GB\",\"country_id\":\"GB\",\"country_name\":\"United Kingdom\"},\"perm_name\":\"oslo-hackney-je6z\",\"accessibility\":{\"url\":\"https://www.oslohackney.com/accessibility/\"},\"profile_active\":true,\"highlights\":[{\"type\":\"capacity\",\"title\":\"370 capacity\"},{\"type\":\"accessibility\",\"title\":\"Accessibility information\",\"external_link\":\"https://www.oslohackney.com/accessibility/\"}],\"space_name\":null,\"doors_open_date\":\"2026-10-03T18:00:00+01:00\",\"doors_close_date\":null}],\"marketeers\":[{\"id\":762,\"name\":\"Portals\",\"privacy_policy_link\":\"http://portalsrock.com/terms.html\",\"fb_pixel_id\":null,\"ga_tracking_id\":null,\"tiktok_pixel_id\":null,\"twitter_pixel_id\":null,\"twitter_checkout_initiated_pixel_id\":null,\"twitter_purchase_pixel_id\":null,\"google_ads_conversion_id\":null,\"google_ads_purchase_conversion_label\":null,\"show_web_opt_in_form\":true,\"show_opt_in_form\":true,\"opt_out_as_default\":false}],\"price\":{\"currency\":\"GBP\",\"amount\":2751,\"sales_tax\":0,\"amount_from\":null},\"max_tickets\":4,\"public_refund_policy\":{\"type\":\"cooling_off_enabled\",\"hours\":1},\"name\":\"Portals Presents: Youthmovies, Verse Metrics, For Breakfast\",\"social_links\":{\"event_share\":\"https://link.dice.fm/a87fd4700a1f?dice_id=a87fd4700a1f\",\"post_competition_referral\":\"https://link.dice.fm/a6949722a492?dice_id=a6949722a492\",\"post_purchase_extras_available_referral\":\"https://link.dice.fm/E7c8ba937f0b?dice_id=E7c8ba937f0b\",\"post_purchase_referral\":\"https://link.dice.fm/E9b2637d95b6?dice_id=E9b2637d95b6\",\"post_reminder_referral\":\"https://link.dice.fm/E0ff2c249ea1?dice_id=E0ff2c249ea1\",\"post_waitinglist_referral\":\"https://link.dice.fm/E8cd1937911a?dice_id=E8cd1937911a\"},\"is_hidden_event\":false,\"unicorn_extras\":true,\"acquisition_type\":\"purchase\",\"is_ticket_available_at_door\":false,\"is_fully_locked\":false,\"tags_types\":[{\"name\":\"gig\",\"value\":\"music:gig\",\"title\":\"Gigs\"}],\"seats_io_event_id\":null,\"perm_name\":\"3o78d8-portals-presents-youthmovies-verse-metrics-for-breakfast-3rd-oct-oslo-hackney-london-tickets\",\"seating\":null,\"dates\":{\"timezone\":\"Europe/London\",\"announcement_date\":\"2026-07-16T10:00:00+01:00\",\"sale_end_date\":\"2026-10-03T16:00:00+01:00\",\"sale_start_date\":\"2026-07-16T10:00:00+01:00\",\"event_start_date\":\"2026-10-03T18:00:00+01:00\",\"pre_sale_start_date\":null,\"event_end_date\":\"2026-10-03T22:00:00+01:00\",\"is_multi_days_event\":false},\"images\":{\"square\":\"https://dice-media.imgix.net/attachments/2026-07-15/da42890f-0298-4f19-8102-15bf9c3ae343.jpg?rect=0%2C1639%2C4961%2C4961\",\"landscape\":\"https://dice-media.imgix.net/attachments/2026-07-15/da42890f-0298-4f19-8102-15bf9c3ae343.jpg?rect=0%2C2020%2C4961%2C2977\",\"portrait\":\"https://dice-media.imgix.net/attachments/2026-07-15/da42890f-0298-4f19-8102-15bf9c3ae343.jpg?rect=551%2C0%2C3859%2C7016\"},\"announcement_date_unix\":1784192400,\"has_multiple_ticket_types\":false,\"id\":\"6a57817f13e1fc000109ca86\",\"properties\":[],\"about\":{\"description\":\"Youthmovies - Dense, restless sound that veered through noise, post-rock, math rock, psych, jazz, and krautrock, often within the same song, Youthmovies (2002-2010) were a fiercely unclassifiable quintet from Oxford.\\n\\nTouring extensively, they built a reputation as a chaotic and immersive live act. Beyond conventional shows, they performed improvised soundtracks in galleries, theatres, and forests - playing as backing band for Saul Williams and Can's Damo Suzuki, among others.\\n\\nThis show, their first London date in 16 years (!), marks a rare return from a band whose quiet influence on the UK underground far outweighed their commercial footprint.\\n\\nFFO: Squid, Black midi, Do Make Say Think, King Crimson, American Football.\\n\\nVerse Metrics - An atmospheric alternative indie rock band from central Scotland whose music fuses the cerebral precision of math-rock with the cinematic sweep of post-rock. With their style described by GoldFlakePaint as “emotionally raw... but always poignant and beautiful,” the band balance technical intricacy with heartfelt storytelling, soaring melodies and evocative lyrics exploring memory, isolation, and connection\\n\\nFFO: Interpol, Twilight Sad, And So I Watch You From Afar\\n\\nFor Breakfast - Post-rock, dream pop, folk, prog and psychedelia, blending influences gleaned from a range of musical backgrounds. Folkloric vocals and wistful, haunted instrumentation offering a deep sense of place and presence.\",\"one_liner\":null,\"highlights\":[{\"type\":\"age_restriction\",\"title\":\"This is a 16+ event (under 18’s accompanied). \",\"subtitle\":null,\"external_link\":null},{\"type\":\"promoter\",\"title\":\"Presented by Portals.\",\"subtitle\":null,\"external_link\":null}]},\"presented_by\":\"Presented by Portals.\",\"donation\":null,\"seats_io_public_key\":null,\"status\":\"sold-out\",\"date_unix\":1791046800,\"offers_extras\":false,\"secondary_status\":\"waiting-list\",\"previews\":[{\"type\":\"spotify\",\"title\":\"Youthmovies - Thazn\",\"redirect_url\":\"https://open.spotify.com/track/1AvfWAX6asPk0s4wtMD8uY\",\"artist\":\"Youthmovies\",\"preview_url\":\"https://p.scdn.co/mp3-preview/50b9b05f6e6a76fedd2eea6972da5bcd17516adc?cid=921526b9c2da4b7b96e197790a02347e\",\"track_name\":\"Thazn\"},{\"type\":\"apple_music\",\"title\":\"Youthmovies - Thazn\",\"redirect_url\":\"https://music.apple.com/us/album/thazn/372772554?i=372772614&uo=4&at=1001ld8Z&ct=app_event\",\"artist\":\"Youthmovies\",\"preview_url\":\"https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/ce/0a/1e/ce0a1e88-6574-072b-a1bb-822046f3e41a/mzaf_9531199612161038648.plus.aac.p.m4a\",\"track_name\":\"Thazn\"}]}",
