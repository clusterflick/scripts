handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Priya Aggarwal-Shah\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-jAfpVdvBHnIl5FZ\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_3.png\",\"bio_short\":\"\",\"first_name\":\"Sonal\",\"last_name\":\"Magecha\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Sonal M\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-NKY3QsD7qMtkCmW\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_40.png\",\"bio_short\":null,\"first_name\":\"Punam\",\"last_name\":\"Vaja\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Punam Vaja\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":4,\"ticket_count\":4,\"hosts\":[{\"api_id\":\"usr-nhcjwYmliAj7si7\",\"avatar_url\":\"https://images.lumacdn.com/avatars/i1/b257d1bc-13ee-4c99-8003-266cc33c92ab.jpg\",\"bio_short\":null,\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Adorned Narratives\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f8efe0\",\"#f69a36\",\"#0f0404\",\"#f25f7f\"],\"palette\":{\"neutral\":[{\"color\":\"#0f0404\",\"percentage\":5.45},{\"color\":\"#f8efe0\",\"percentage\":55.57}],\"vibrant\":[{\"color\":\"#f69a36\",\"percentage\":23.98},{\"color\":\"#f25f7f\",\"percentage\":1.54}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/kn/cccb436b-9ef9-40e8-83e0-8b756522eb79.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-kBXB2byxcZOvfMY\",\"cents\":1500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-webPxzncnRUiPqq\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Sharing Joy Circle Ticket\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f8f0e0\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"⭐Join us for the next Adorned Narratives event ⭐\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Continuing with the theme of joy, we welcome you to explore the art of sari draping.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The sari is six yards of story. Of memory, migration, celebration, and self. And yet for so many of us, it can feel like a garment we admire from a distance, something saved for special occasions, something that feels a little out of reach in everyday life.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This event is an invitation to change that.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Joining us is Niddhi Uppal, sari creative and artist, whose work invites people to discover the playfulness and expressive possibilities of this iconic textile. Niddhi brings warmth, curiosity, and a deep love for the sari into everything she does, and this afternoon will be no different.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Together we'll explore how the sari connects us to personal, cultural, and collective identity across generations. We'll talk about what it means to find joy through this garment, and how to begin wearing it in ways that feel confident, easy and genuinely yours. Style that belongs just as much in the modern world as it does in our memories.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you are encountering the sari for the first time, or gently reconnecting with a tradition that feels familiar but distant, this is a welcoming space for learning, conversation, and creativity, with joy sitting at the centre.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come and find your joy in six yards.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/gh/72162786-e297-4a75-9f6c-2fabd333ef8f.jpg\",\"width\":810,\"height\":1080,\"image_id\":\"local-upload-blob:https://luma.com/a2d260bd-9f66-4476-b2f8-91eb2c2f483a\",\"mime_type\":null,\"uploaded_at\":\"2026-08-20T08:42:52.562+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"What To Bring:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We invite you to bring a sari that you would like to drape. It may be something you own or one passed down from family members. You are also welcome to bring any accessories such as belts or broaches that you would like to experiment with.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will also have some saris available on the day along with pins and other accessories.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’ll also provide light snacks and refreshments.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Agenda:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔸\",\"type\":\"text\"},{\"text\":\"12:30pm:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Arrival\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔸\",\"type\":\"text\"},{\"text\":\"12:45pm:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Introductions\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔸\",\"type\":\"text\"},{\"text\":\"1pm:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Sari Draping with Nidhi\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔸\",\"type\":\"text\"},{\"text\":\"3pm:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Reflections\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔸\",\"type\":\"text\"},{\"text\":\"3:30pm:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Closing\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About Nidhi\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nidhi is a London-born sari stylist and experimental draper who transforms this unstitched garment into a canvas for modern storytelling. Blending a backaround in Science research with her Punjabi heritage, Nidhi treats fabric as a versatile sculpture. Known as a 'sari scientist,' her avant-garde styling has been featured on red carpets, film, exhibitions, and TV. Her community workshops promote inclusivity, sustainability, and playful, gender-fluid experimentation, celebrating the evolution of this textile art.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About Adorned Narratives\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A‌dorned Narratives is a space where adornment and style become a connection to identity.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We believe the pieces we wear are never just objects. They carry memory, heritage, emotion, and quiet meaning. Within them live the echoes of who we are, where we come from, and how we choose to express ourselves in the world.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Adorned Narratives is a community for South Asian women who have always known that what we wear carries something deeper. We use style, adornment, and identity as the anchors to find a deeper connection to ourselves and others. We believe the objects we wear hold stories worth telling: of the past we've inherited, the present we're living, and the future we're shaping on our own terms.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is a space where narratives unfold, identities are honoured, and community is gently, powerfully woven together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You belong here.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Founded by Anisha Parmar & Neelam Mistry-Thaker\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You can find our more about Adorned Narratives by following us over on \",\"type\":\"text\"},{\"text\":\"Instagram\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/adornednarratives/\"}}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"signing up to our newsletter\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://eepurl.com/iXf7OM\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Adorned Narratives has kindly been funded by the \",\"type\":\"text\"},{\"text\":\"Girl Dreamer\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://girldreamer.co.uk/\"}}]},{\"text\":\" Dream Fund. With the funds we have carefully curated a series of events throughout 2026 to connect with the community, explore the themes that matter the most to you and encourage any feedback.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
