inkedin_handle\":null,\"name\":\"Ye Jin Kim\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":12,\"ticket_count\":12,\"hosts\":[{\"api_id\":\"usr-G79Ya0kcHrOoCQw\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_5.png\",\"bio_short\":\"\",\"first_name\":\"Kollab\",\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Kollab\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#eeecee\",\"#3c7fc8\",\"#6aa9d4\",\"#101112\"],\"palette\":{\"neutral\":[{\"color\":\"#101112\",\"percentage\":6.17},{\"color\":\"#eeecee\",\"percentage\":16.19}],\"vibrant\":[{\"color\":\"#3c7fc8\",\"percentage\":7.39},{\"color\":\"#6aa9d4\",\"percentage\":6.95}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/fh/0c5e2e09-ed30-4984-b8c3-8406e7c21fdd.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-4FeJBy1Swi1ePGr\",\"cents\":300,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-lNxxBPl4v2edZmN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":12,\"num_guests\":12,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":300,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":38,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"ko\",\"theme_meta\":{\"name\":\"드리미\",\"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#ccd1ff\",\"color2\":\"#d6ccff\",\"color3\":\"#ccf1ff\"},\"tint_color\":\"#d6ccff\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"KOLLAB Creative Connect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"영국에서 활동하는 다양한 분야의 창작자들이 한자리에 모이는 KOLLAB의 첫 네트워킹 데이입니다.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"음악, 공연·연극·무용, 시각예술·디자인, 음식·F&B, 공예·패션, 문화기획까지 — 서로 다른 분야에서 활동하지만 '영국에서 창작한다'는 공통점을 가진 사람들이 만나 자연스럽게 대화를 나누고, 앞으로 함께할 수 있는 협업의 씨앗을 심는 시간을 만들고자 합니다.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"이번 자리에서는 영국에서 활동하며 쌓아온 경험과 이야기를 나눠주실 초청 게스트의 짧은 토크, 서로의 분야를 알아가는 아이스브레이킹 게임, 관심사가 통하는 사람들끼리 깊게 대화할 수 있는 소그룹 세션, 그리고 자유롭게 자신의 프로젝트를 소개할 수 있는 오픈마이크 시간이 준비되어 있습니다.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"혼자 활동하며 막막했던 순간이 있었다면, 새로운 협업 상대를 찾고 있다면, 혹은 그저 비슷한 길을 걷는 사람들과 이야기 나누고 싶다면 — 편하게 오셔서 함께해주세요.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 Equiano Room, Fitzrovia Community Centre\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🗓 2026년 10월 3일\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🎟 참가비 £3+다과(선착순 25명)\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
