alse,\"location_type\":\"offline\",\"name\":\"The Mandem: Link Up!\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/w1/0b611fd0-22ec-4c4f-b9b5-ec4b7143caa4.png\",\"start_at\":\"2026-09-24T16:30:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"gcxy9244\",\"user_api_id\":\"usr-BYVKFDmuNQwBUfW\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Better Space\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJ0zF7994bdkgRKsBgsrtzDqk\",\"city_state\":\"London, England\",\"description\":\"\",\"country_code\":\"GB\",\"full_address\":\"Better Space, 127 Farringdon Rd, London EC1R 3DA, UK\",\"apple_maps_place_id\":\"ID8FF2D6A7389D339\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.10885779999999999,\"latitude\":51.5235777},\"waitlist_enabled\":true,\"waitlist_status\":\"active\"},\"start_at\":\"2026-09-24T16:30:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-BYVKFDmuNQwBUfW\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_35.png\",\"bio_short\":\"\",\"first_name\":\"Studio\",\"last_name\":\"Augusto\",\"instagram_handle\":\"__studioaugusto\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Studio Augusto\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"StudioAugusto\",\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#000000\",\"#ffffff\",\"#4b4b4b\",\"#b1b1b1\"],\"palette\":{\"neutral\":[{\"color\":\"#000000\",\"percentage\":49.78},{\"color\":\"#ffffff\",\"percentage\":48.83}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/w1/0b611fd0-22ec-4c4f-b9b5-ec4b7143caa4.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"evtticktyp-DOXf9X4VmlquBpD\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-ipUFgF6MHk5iaZ4\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fcedd4\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"roc-grotesk\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for an evening of community, conversation, and connection. The Mandem is a supportive space where men can come together, share experiences, and connect. We are now hosted by \",\"type\":\"text\"},{\"text\":\"Better Space London\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.betterspace.london/\"}}]},{\"text\":\", in Farringdon/Clerkenwell.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to Expect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Film screening exploring themes of identity, relationships, mental health, and social issues\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Shared meal and open discussion about the film\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Safe space for check-ins and honest conversation\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Opportunity to connect with like-minded men from diverse backgrounds\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Founded in 2018 by artist Francis Augusto, The Mandem has evolved into a community centred on kindness, food, and learning. Our Link Ups create an environment where men can explore their feelings, make connections across social circles, and support one another.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This isn't therapy, but it's a space that encourages conversations about the everyday, mental health, fears, and experiences. Some conversations might inspire further reflection or professional support.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All who identify as men are welcome.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Supported by Islington Giving: Make it Happen Fund.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
