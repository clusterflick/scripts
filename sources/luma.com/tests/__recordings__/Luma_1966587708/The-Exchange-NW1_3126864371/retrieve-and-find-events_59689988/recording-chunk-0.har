eum_token_requirements\":[],\"event_api_id\":\"evt-OuWUrDKc9wmdb4x\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":100,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"4\",\"name\":\"General Admission\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":6,\"num_guests\":6,\"spots_remaining\":94,\"is_disabled\":false},{\"api_id\":\"ttype-WyBmNwoCLOtxOgn\",\"cents\":1000,\"currency\":\"gbp\",\"description\":\"Help to support the continued future of AlgoRhythms!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-OuWUrDKc9wmdb4x\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":100,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":500,\"position\":\"6\",\"name\":\"Donation/supporter Tier\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":100,\"is_disabled\":false},{\"api_id\":\"ttype-EdPPl0TdhDYEl7Q\",\"cents\":null,\"currency\":null,\"description\":\"For students and people with no or low income\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-OuWUrDKc9wmdb4x\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":25,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Student/low/no-waged\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":23,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-tech\",\"description\":\"Join a hackathon, jam on product design, and meet fellow tinkerers in the industry of tomorrow.\",\"event_count\":4069,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/lg/3b7cf2a0-077f-40ca-aab8-1a8d07affbd1.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/v7/3f6baafa-d90d-4013-9853-0fa10331f796.png\",\"name\":\"Tech\",\"page_title\":\"Tech Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/z8/cb71384a-87a9-4be7-bbdf-1c2d6381d872.png\",\"slug\":\"tech\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/1908a653-edb9-431e-8ecf-b4d61249a446.png\",\"subscriber_count\":73356,\"tint_color\":\"#5773CF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":1000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":192,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"life\"},\"tint_color\":\"#edb5e3\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expect lovely vibes, hand coded sounds and visuals, dancing, making new friends 🌼\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Plus we will have ribbon craft too! Make yourself a bow 🎀 or flower 🌼 😃\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"From 6:30pm we have a round table meetup - an opportunity to say hi 👋, learn more about live coding 📚 or share something you have been doing recently 💻😃\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Then from 7:30pm we plug into the Funktion One soundsystem and start the 15 minute performance slots and anyone - yes anyone! - is welcome to perform 💞\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"At London Live Coding, we want to give everyone the opportunity to perform.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"hard_break\"},{\"text\":\"If you missed out last time because all the slots filled up, send us a DM on Instagram (@algorave_london) and we'll make sure you're included in the performance lineup for the next Algorhythms.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"There are lots of places to eat nearby, or there is an attached Mexican Streetfood restaurant that comes highly recommended 😋\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Make friends, have fun or simply soak up the vibes ☺️\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"💖 What is Live Coding or Algorave? 💖\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Well, we're not 100% sure ourselves, come help us find out!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Usually it involves getting a bunch of people together with computery devices like laptops etc, writing some code to make amazing visuals and music, then combining that with lovely vibes and lots of fun 🥳\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will be aiming to stream audio+video during the event.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
