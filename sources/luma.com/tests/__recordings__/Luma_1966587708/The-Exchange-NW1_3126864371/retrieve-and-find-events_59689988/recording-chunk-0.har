}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/x2/35c75cb1-5c0d-4a82-94a4-d3f890544c8f.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-9fd9Ezow7HgGpXX\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-uJD2AWFBDxjJKZW\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":17,\"num_guests\":17,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-family\",\"description\":\"From pregnancy to college applications, find a moms’ walk, summer camp, or tutoring group and meet other families.\",\"event_count\":612,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/q4/1198a595-5920-4eec-bfdb-3bcd63965716.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/aq/f5fbdde4-46a9-4d9e-b730-7144b3c0e335.png\",\"name\":\"Family\",\"page_title\":\"Family Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/01/09874dae-ea3a-499c-8558-f51be7617a1a.png\",\"slug\":\"family\",\"social_image_url\":\"https://images.lumacdn.com/uploads/q6/6073105a-fe9c-4969-acd5-738987a39227.png\",\"subscriber_count\":1014,\"tint_color\":\"#AE6BCF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#676b3a\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join \",\"type\":\"text\"},{\"text\":\"MODIE\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://modie.co/\"}}]},{\"text\":\" and Anete for an intimate morning exploring how fashion, identity, and practicality intersect throughout motherhood.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Designed for mothers at every stage, including moms-to-be, this workshop brings together honest conversations, expert insights, and practical tools to help you build a wardrobe that reflects who you are today and works for the realities of everyday life.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"The morning will include:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"• A conversation with \",\"type\":\"text\"},{\"text\":\"Silva Hrabar-Owens,\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" founder of \",\"type\":\"text\"},{\"text\":\"No More Nobody\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://nomorenobody.com/\"}},{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"and Lecturer at London College of Fashion, UAL, on identity, visibility, and how personal style evolves through motherhood.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"• \",\"type\":\"text\"},{\"text\":\"A practical workshop\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" on understanding fabrics, care labels, and investing in pieces that can withstand real-life motherhood.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"• \",\"type\":\"text\"},{\"text\":\"A live wardrobe audit \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"featuring pieces from \",\"type\":\"text\"},{\"text\":\"Ren Cordeza\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://rencordeza.com/\"}},{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://rencordeza.com/\"}}]},{\"text\":\"and \",\"type\":\"text\"},{\"text\":\"ACIEN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://acien.co.uk/\"}},{\"type\":\"bold\"}]},{\"text\":\", exploring fit, quality, versatility, and everyday wearability.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"• \",\"type\":\"text\"},{\"text\":\"An introduction to MODIE’s platform \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"for discovering conscious, female-founded brands and making more informed wardrobe choices.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Guests are invited to bring 1–2 wardrobe pieces that represent their own style journey, whether it’s a pre-motherhood favourite, an item they no longer reach for, or an everyday essential.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A relaxed morning of conversation and community for mothers looking to reconnect with their personal style and redefine what dressing for motherhood can look like.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We hope to see you there!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"With love,\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Anete x\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About MODIE\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"MODIE is a community marketplace for discovering and shopping a curated circle of unique emerging labels from around the world. If the retail world had a rebel child, it might look like us. Instead of traditional ads, we focus on raw, post-purchase reviews, letting the community tell each brand’s story. Shoppers get a \",\"type\":\"text\"},{\"text\":\"“trusted friend”\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" view of what’s actually worth the investment, and in return for sharing their experiences post purchase, they earn rewards to spend on their next find.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Exclusive access to MODIE is currently by invitation or application only.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As a valued guest, we’d love to offer you the opportunity to join the MODIE community \",\"type\":\"text\"},{\"text\":\"here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://l.instagram.com/?u=https%3A%2F%2Fchat.whatsapp.com%2FJw8Kyawmqew9PDwUIogAYW%3Fs%3Dcl%26p%3Di%26mlu%3D4%26ilr%3D4%26utm_source%3Dig%26utm_medium%3Dsocial%26utm_content%3Dlink_in_bio%26fbclid%3DPAcGRvZgJleHRuA2FlbQIxMQBzcnRjBmFwcF9pZA85MzY2MTk3NDMzOTI0NTkAAaeofLPQ1IsxFpTjHC47jFXrrpa0eSDxqI4LnxPPWj6d1BHaxj_twhUC19dhsg_aem_2WjtfFlFC5QDbLHO73zmwg&e=AUDIwKDa6Sa6luye223gPbQu85FeAK7iaAzmR8hVSQ0cY9oWzocK_6VEcOpYmYXbd_CAp67X2eQRoSv8ZV72XOpyw9Rta1szKpsNF26LSVcYYJZW1PBlNdiEL83YJL8cc3dKUGR_SoPm\"}}]},{\"text\":\" and app (to access: Apple users \",\"type\":\"text\"},{\"text\":\"here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://testflight.apple.com/join/Ymv3S2n5?utm_source=ig&utm_medium=social&utm_content=link_in_bio\"}}]},{\"type\":\"hard_break\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://testflight.apple.com/join/Ymv3S2n5?utm_source=ig&utm_medium=social&utm_content=link_in_bio\"}}]},{\"text\":\"and Android users \",\"type\":\"text\"},{\"text\":\"here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://play.google.com/store/apps/details?id=com.mycompany.modie\"}}]},{\"text\":\")\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"s1zeiiav\",\"label\":\"Do you have any dietary requirements or allergies we should keep in mind?\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
