tus\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-ke1KqDsMYtnZesN\",\"avatar_url\":\"https://images.lumacdn.com/uploads/n7/485e9136-58cc-4b06-8bd7-d40d5846f71d.png\",\"bio_short\":\"Modular synth meets and live electronic music performances in London, since 2016\",\"first_name\":\"CV FREQS\",\"last_name\":\"LONDON\",\"instagram_handle\":\"cv_freqs\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"CV FREQS LONDON\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"cv_freqs_london\",\"website\":null,\"youtube_handle\":\"eden_grey\"},{\"api_id\":\"usr-WTHDt0U2a7wWkrw\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_11.png\",\"bio_short\":null,\"first_name\":\"Rob\",\"last_name\":\"Chu\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/robert\",\"name\":\"Rob Chu\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"RobChooses\",\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#020102\",\"#cdc7ca\",\"#e43032\",\"#56d9d5\"],\"palette\":{\"neutral\":[{\"color\":\"#020102\",\"percentage\":39.65},{\"color\":\"#cdc7ca\",\"percentage\":21.9}],\"vibrant\":[{\"color\":\"#e43032\",\"percentage\":3.79},{\"color\":\"#56d9d5\",\"percentage\":1.51},{\"color\":\"#95732c\",\"percentage\":0.67}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/hx/541ed37c-6f71-4a67-b034-2ddb842cd6ff.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-TfDSArvxyPoVaHO\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"Pay-what-you-want\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-JNnws4srLlCs2LJ\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"4\",\"name\":\"Supporters / pay-what-you-want\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-h4DMnwKnTt4HWo1\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-JNnws4srLlCs2LJ\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"FREE\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":500,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":43,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"wave\"},\"tint_color\":\"#030203\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"alternate\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're back for another \",\"type\":\"text\"},{\"text\":\"CV FREQS\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and gathering of modular minds and live synth performers on Sat 26th September, from 5pm to 11pm, at \",\"type\":\"text\"},{\"text\":\"The Foundry Collective\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.thefoundrycollective.org/\"}}]},{\"text\":\", an amazing creative hub and community space supporting local artists and grassroots talent in North Acton.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/kd/38c8765d-9047-4efc-9239-6534b1830008.jpg\",\"width\":4672,\"height\":7008,\"image_id\":\"local-upload-blob:https://luma.com/0d399e16-fd4a-42ef-b085-aa776887d2ed\",\"mime_type\":null,\"uploaded_at\":\"2026-09-09T17:07:55.529+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meet familiar faces of \",\"type\":\"text\"},{\"text\":\"CV FREQS\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://cv-freqs.com\"}},{\"type\":\"bold\"}]},{\"text\":\" and the \",\"type\":\"text\"},{\"text\":\"London Modular Synthesis\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.meetup.com/london-modular-synthesis-group\"}},{\"type\":\"bold\"}]},{\"text\":\" group, and make new friends over modular synths.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bring your modular rack, semi-modular, synths, drum machines, and DIY gear (and don't forget extension leads, patch cables, audio cable, small speakers and headphones!). Everyone at all levels is welcomed and this event is open to those who are not into modular (yet!).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Schedule for the day is subject to change but expect:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"17:00 - 20:00 Meet and greet, show and tell, talk modules, share patch ideas, collaborative jams, visual+music collaborations\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"20:00 - 23:00 Evening of live performances from EMOM community\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The area will be set up with a few tables for your gear. Table spots are allocated on a first come, first serve basis. We have access to a projector and \",\"type\":\"text\"},{\"text\":\"CHAU_AV\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/chau_av/\"}}]},{\"text\":\" will be helping out with her amazing visuals. If you would like to showcase some visuals too, please bring your laptop! EMOM walk-ins are available.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Entrance is \",\"type\":\"text\"},{\"text\":\"FREE\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" / pay-what-you-want, but please sign-up so we have a good idea of numbers. Donations taken at the door will go to \",\"type\":\"text\"},{\"text\":\"CV FREQS CIC\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and reinvested to support venue hire, artists and technicians at future events.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/mm/26d6361c-3c7f-4e42-ac06-1e06d46b2374.jpg\",\"width\":7008,\"height\":4672,\"image_id\":\"local-upload-blob:https://luma.com/1a4b0cd4-60f7-4d34-aead-6a6d1fbc8dbb\",\"mime_type\":null,\"uploaded_at\":\"2026-09-09T03:51:01.038+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Food and drinks will be available to purchase from the well-stocked bar and kitchen at The Foundry Collective. Please show your support to them!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Important disclaimer\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will be sharing a public space with others at the The Foundry Collective community. \",\"type\":\"text\"},{\"text\":\"By attending this meetup, you agree that CV FREQS CIC, LMS meetup organisers, and The Foundry Collective are not responsible for any lost, stolen, or damaged equipment.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Attendees are solely responsible for setting up, monitoring, and supervising their own gear at all times. Please look out for each other and handle other people's instruments only with their explicit permission, and use power connections at your own risk.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Accessibility\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We'll be at the ground floor at the same level as the door entrance. There will be flashing visuals and strobe lighting.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"zyllomr5\",\"label\":\"Will you be bringing your modular rack or synths and need a table? (Tables are allocated on first come/first serve basis).\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"27g71e3e\",\"label\":\"Will you be performing on the day? This is to manage the schedule, walk-ins are available.\",\"options\":[\"Yes\",\"No\",\"Undecided\"],\"required\":false,\"question_type\":\"dropdown\"},{\"id\":\"n64fnjpr\",\"label\":\"Terms and Conditions\",\"terms\":{\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Important disclaimer\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will be sharing a public space with others at the The Foundry Collective community. \",\"type\":\"text\"},{\"text\":\"By attending this meetup, you agree that CV FREQS CIC, LMS meetup organisers, and The Foundry Collective are not responsible for any lost, stolen, or damaged equipment.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Attendees are solely responsible for setting up, monitoring, and supervising their own gear at all times. Please look out for each other and handle other people's instruments only with their explicit permission, and use power connections at your own risk.\",\"type\":\"text\"}]}]},\"content_type\":\"text\",\"require_review\":true,\"collect_signature\":false},\"required\":true,\"question_type\":\"terms\"},{\"id\":\"7d0euxwr\",\"label\":\"What is your Instagram username?\",\"required\":false,\"question_type\":\"instagram\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
