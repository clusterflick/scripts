:\"https://images.lumacdn.com/uploads/7b/f3930d36-b2f2-4df3-8db6-798df9b0897f.png\",\"name\":\"Fitness\",\"page_title\":\"Fitness Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/w4/5281e210-fc19-4d94-9885-9ec1f9e5c579.png\",\"slug\":\"fitness\",\"social_image_url\":\"https://images.lumacdn.com/uploads/fm/30c63ffc-b3b4-4b0e-abda-d280f51efd3c.png\",\"subscriber_count\":20053,\"tint_color\":\"#5DA3C9\"}],\"ticket_info\":{\"price\":{\"cents\":3500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#151515\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for Pilates Content Day at Hiraya Pilates, Islington 💚\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"content creators and those who want to film their workouts coming together to join a Pilates class where they can film themselves for content on social media\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" as a content creator it can be hard to find studios that allow filming, so this is an opportunity for us to come together and get some content in a safe and supportive space with other creators\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Who:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" everyone is welcome, this event will be most suited to people who want to film their workout, beginners are welcome!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"When:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" October 3, 3pm - 5pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Where:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Hiraya Pilates, Unit 103, 436 Essex Rd, N1 3QP\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What should I bring:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" a tripod (we will be providing some for those who don't have one!)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"To see content from our previous events, follow @pilatescontentday on TikTok and Instagram\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please note tickets are not refundable and latecomers will be turned away to avoid disruption to the class.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"See you there! 🖤\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"qroyu7mp\",\"label\":\"Have you done Pilates before? How long have you been doing Pilates?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"yo6xm2ch\",\"label\":\"Have you been to Hiraya Pilates before?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"bae2vvgx\",\"label\":\"How did you hear about this event?\",\"options\":[\"Phoebe Parke Pilates Instagram\",\"Phoebe Parke Pilates Mailing List\",\"Phoebe Parke Pilates TikTok\",\"Pilates Content Day Instagram\",\"Pilates Content Day TikTok\",\"From The Studio\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"ewqi4d65\",\"label\":\"What are you hoping to get from this event?\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"c2rr54ep\",\"label\":\"Do you need us to provide a tripod for you?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"fxy8dekg\",\"label\":\"Do you consent to us sharing your Instagram handle with the rest of the group?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"el5qtfk7\",\"label\":\"What is your Instagram handle?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"l29zwr9h\",\"label\":\"Do you consent to being filmed on the day, and featured in video clips and footage on social media?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"1ihwqhcy\",\"label\":\"Order your post-workout tea, coffee or matcha below\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"it8wxakc\",\"label\":\"Do you have any dietary requirements?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"i2fogqss\",\"label\":\"Anything else we should know before the event to enhance your experience on the day?\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
