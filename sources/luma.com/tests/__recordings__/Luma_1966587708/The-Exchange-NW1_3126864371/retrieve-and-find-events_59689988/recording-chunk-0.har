-social/qn/13bc881e-8d91-4423-a0ae-662a723864d5.png\",\"start_at\":\"2026-10-21T18:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"ici-theatre-rent-the-musical-21-october\",\"user_api_id\":\"usr-EzC0lLGhwxKJdYb\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"The Duke of York's Theatre\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJ9Xzh2s0EdkgR0IDjYM50k80\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"The Duke of York's Theatre\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"The Duke of York's Theatre, St Martin's Ln, London WC2N 4BG, UK\",\"region_short\":\"England\",\"short_address\":\"St Martin's Ln, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"👉 Please arrive at the venue no later than 7:00 PM.\\n🎟️ The ICI ticket is for confirmation purposes only.\\n📲 Ensure Luma App is downloaded before arrival.\\n🎭 Your entry ticket will be shared after you have checked in via the ICI Luma App.\\nApple: https://apps.apple.com/gb/app/luma-delightful-events/id1546150895\\nAndroid: https://play.google.com/store/apps/details?id=com.luma.studio\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"The Duke of York's Theatre, St Martin's Ln, London WC2N 4BG, UK\",\"region_short\":\"England\",\"short_address\":\"St Martin's Ln, London\",\"apple_maps_place_id\":\"IE77AEF700A85DC67\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.1270735,\"latitude\":51.51023670000001},\"waitlist_enabled\":true,\"waitlist_status\":\"active\"},\"cover_image\":{\"colors\":[\"#191a1e\",\"#45383d\",\"#cf221b\",\"#f2ece7\"],\"palette\":{\"neutral\":[{\"color\":\"#191a1e\",\"percentage\":27.68},{\"color\":\"#f2ece7\",\"percentage\":3.62},{\"color\":\"#45383d\",\"percentage\":9.02}],\"vibrant\":[{\"color\":\"#cf221b\",\"percentage\":8.41}]}},\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-PEEWAEsjhk29NQl\",\"avatar_url\":\"https://images.lumacdn.com/calendars/nz/fe02d1d1-d706-4361-a959-640169413cfd.png\",\"coordinate\":{\"longitude\":-0.12758619999999998,\"latitude\":51.5072178},\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/fb/d00d2299-55bc-42c7-811f-07857c45cf33.jpg\",\"description_short\":\"It's Culture Innit (ICI) is a welcoming space for gay, bi, trans, and queer men to connect in real life. Founded in London in 2015, it’s now active in Sydney and Berlin.\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"itscultureinnit\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJdd4hrwug2EcRmSrV3Vo6llI\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"free\",\"luma_plus_active\":false,\"meta_pixel_id\":null,\"name\":\"It's Culture Innit - London\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟 Refund Policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets are non-refundable unless:\\n• The event is cancelled\\n• The event does not meet minimum numbers\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"🔁 Need to Sell Your Ticket?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"While we set up the new waitlist system on Luma, you can offer your ticket to another member via the ICI WhatsApp group. \",\"type\":\"text\"},{\"text\":\"https://chat.whatsapp.com/J