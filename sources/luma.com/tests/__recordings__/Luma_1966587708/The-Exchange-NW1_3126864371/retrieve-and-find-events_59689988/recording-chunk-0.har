ne\":\"America/Los_Angeles\",\"twitter_handle\":\"0oj4m1t\",\"username\":\"ooj\",\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-uysTDOmSWUYIl0k\",\"avatar_url\":\"https://images.lumacdn.com/uploads/l5/df42a039-f102-4014-bcfb-b348fc105128.jpg\",\"bio_short\":\"feeling of computing\\nink and switch\\ni’m your girlfriend\",\"first_name\":\"chee\",\"last_name\":\"rabbits\",\"instagram_handle\":\"achiotevalentina\",\"is_verified\":false,\"linkedin_handle\":\"/in/chee-rabbits-9b895222b\",\"name\":\"chee\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":\"cheedear\",\"username\":\"cheerabbits\",\"website\":\"https://chee.party\",\"youtube_handle\":null},{\"api_id\":\"usr-zCWEH1OJZ496XYl\",\"avatar_url\":\"https://images.lumacdn.com/avatars/od/6977cd89-4919-4588-b93e-b0e8fd7085e1.jpg\",\"bio_short\":null,\"first_name\":\"Abi\",\"last_name\":\"Ke\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Abi Ke\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":34,\"ticket_count\":34,\"hosts\":[{\"api_id\":\"usr-A7Ro7BOUOeWYpbi\",\"avatar_url\":\"https://images.lumacdn.com/avatars/ws/7f44729e-a4f2-4a17-ac79-293a8df85f36\",\"bio_short\":\"\",\"first_name\":\"Lu\",\"last_name\":\"Wilson\",\"instagram_handle\":\"TodePond\",\"is_verified\":false,\"linkedin_handle\":\"/in/TodePond\",\"name\":\"Lu Wilson\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":\"TodePond\",\"username\":\"TodePond\",\"website\":\"https://todepond.com\",\"youtube_handle\":\"TodePond\"},{\"api_id\":\"usr-NzJJyHoUnQt90ht\",\"avatar_url\":\"https://images.lumacdn.com/avatars/rs/b4005288-44e8-472e-aa71-127a18d8f030\",\"bio_short\":\"Live coder based in London working with the Syntə language.\\nI help run events and help others to run events too 😊\\nsyntel8.bandcamp.com\",\"first_name\":\"Daniel\",\"last_name\":\"Arves\",\"instagram_handle\":\"syntel8_\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Daniel\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://synte.codeberg.page\",\"youtube_handle\":null},{\"api_id\":\"usr-rHfAZbGsWowAEpI\",\"avatar_url\":\"https://images.lumacdn.com/avatars/j3/074db3be-0fb4-4f37-a504-1480923a452b.jpg\",\"bio_short\":\"\",\"first_name\":\"Nadezhda\",\"last_name\":\"𐔌՞. .՞𐦯\",\"instagram_handle\":\"nadyaviaproxy\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Nadezhda 𐔌՞. .՞𐦯\",\"tiktok_handle\":null,\"timezone\":\"America/Chicago\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f1dcfa\",\"#e09bcf\",\"#612739\",\"#e93227\"],\"palette\":{\"neutral\":[{\"color\":\"#612739\",\"percentage\":4.84},{\"color\":\"#f1dcfa\",\"percentage\":23.39}],\"vibrant\":[{\"color\":\"#e09bcf\",\"percentage\":12.92},{\"color\":\"#e93227\",\"percentage\":4.53}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/6v/e92d52d3-44fb-4957-9b50-30f240b93301.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-RA3IRtXULbMH35o\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-BUKoKsU3fB5stD7\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":34,\"num_guests\":34,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":116,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#AB46DD\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-mode\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Algoravioli London is back at the Greyhound with a brand new event, where all the night's electronic music and visuals are made LIVE ... entirely FROM SCRATCH 🫥🎀\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Everything you see and hear will be entirely improvised from a blank screen. Experience music being created from nothing! Watch visuals being crafted out of thin air!! ☁️💖☁️\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This practice is part of a larger international movement known as \\\"\",\"type\":\"text\"},{\"text\":\"From Scratch\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://zenodo.org/records/3939206\"}}]},{\"text\":\"\\\" and we're pleased to join it with our very own London edition. Our rules are adapted from both the Barcelona and Mexico City editions:\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":1},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Start with a blank screen \",\"type\":\"text\"},{\"text\":\"(and an empty mind).\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Play for 18 minutes\",\"type\":\"text\"},{\"text\":\" (this includes plugging in time).\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Everyone must clap at the end no matter the result \",\"type\":\"text\"},{\"text\":\"(remember that this is just for fun).\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you have any questions about what is and isn't allowed in the rules, feel free to \",\"type\":\"text\"},{\"text\":\"join our discord\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://discord.gg/B3ra7F6K3K?utm_source=luma\"}}]},{\"text\":\" and ask in the #from-scratch channel, or DM \",\"type\":\"text\"},{\"text\":\"@algorave_london\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/algorave_london/\"}}]},{\"text\":\" on insta.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Want to perform? Complete beginners and experts are all welcome to sign up: \",\"type\":\"text\"},{\"text\":\">>SIGN UP FORM<<\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://forms.gle/zG2u7SEzzTvqfGh47\"}},{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"We welcome audio performers, visualists, vocalists, freestylers, poets, instrument players, dancers and more! (or just come and watch 😃)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Note: At this event we like human-made and human-written art, not AI stuff 💗\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"peace x\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
