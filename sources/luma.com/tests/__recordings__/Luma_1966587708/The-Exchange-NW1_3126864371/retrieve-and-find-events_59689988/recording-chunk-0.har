l,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-ai\",\"description\":\"Join a hackathon, learn about LLMs and prompt engineering, or connect with other AI practitioners.\",\"event_count\":4171,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png\",\"name\":\"AI\",\"page_title\":\"AI Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png\",\"slug\":\"ai\",\"social_image_url\":\"https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png\",\"subscriber_count\":102003,\"tint_color\":\"#D96D9B\"},{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":179,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"matrix\"},\"tint_color\":\"#010201\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a free screening of \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" The Matrix (1999) [The first one] & discussion, \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\"hosted by Intelligent Internet in partnership with Kensington Central Library.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Film rating:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 15\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Description: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"THE MATRIX is a 1999 sci-fi action in which a computer hacker's reality turns upside down after he uncovers the truth. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Arrive early:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" seats and SWAG bags are first come, first served.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Doors open at 6pm, film starts at 6:45 & event ends at 9:30.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Who’s it for?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Open to everyone! Film buffs, AI/tech professionals, Kensington & Chelsea locals, university students & societies, sixth form/college students, and anyone curious about AI (no technical knowledge needed).\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"RSVP & see you there!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"~ The II Team\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
