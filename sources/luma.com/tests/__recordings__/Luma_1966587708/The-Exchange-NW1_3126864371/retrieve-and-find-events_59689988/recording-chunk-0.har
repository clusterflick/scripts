et_count\":5,\"hosts\":[{\"api_id\":\"usr-VFavA92InFFrfO7\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_43.png\",\"bio_short\":\"\",\"first_name\":\"Nicholas\",\"last_name\":\"Laughton\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Nicholas Laughton\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#e4e7e7\",\"#18250a\",\"#6daa1e\"],\"palette\":{\"neutral\":[{\"color\":\"#18250a\",\"percentage\":0.76},{\"color\":\"#e4e7e7\",\"percentage\":33.29}],\"vibrant\":[{\"color\":\"#6daa1e\",\"percentage\":0.45}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/wy/b50f0430-f9c7-4713-8274-c850d659234a.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-qIil9F5DVU6UanF\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-ASibtOSJCyksxs6\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#e7eaec\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Material Hangout, together with brand partner \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"Aectual\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://aectual.com/\"}},{\"type\":\"italic\"}]},{\"text\":\" and biophilic specialists \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"Planteria\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.planteriagroup.com/\"}},{\"type\":\"italic\"}]},{\"text\":\", are hosting \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"Nature, Reprinted\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" — a Hangout Session over breakfast, exploring how curated planting can enrich a workplace, from wellbeing to design possibility.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Choose from two sessions, Wednesday 30th September and Thursday 1st October, from 8:30am – 10am at the Qwell showroom in Clerkenwell. Start the day hands-on with nature and circular 3D printed materials, whilst hearing how both are being utilised in commercial interiors — from planters to 3D printed façade of buildings.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"w957uexh\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"collect_job_title\":false},{\"id\":\"f5cdkhxy\",\"label\":\"Any dietary requirements?\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
