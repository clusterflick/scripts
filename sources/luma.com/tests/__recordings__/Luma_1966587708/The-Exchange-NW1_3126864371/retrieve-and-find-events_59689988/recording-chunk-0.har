centage\":7.96}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/jb/bb12d660-23b1-4c71-b394-8656915e7db3.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-Kb7wuEv1U9eIdZM\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-hjp3uMJs2nlyfVG\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":748,\"num_guests\":748,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"iridescent-light\"},\"tint_color\":\"#536a78\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're excited to invite you to London Modest Fashion Fest 2026, brought to you by thefajrclub in collaboration with The Exchange in TOCA SOCIAL, White City. This is London's first ever modest fashion fest, bringing together voices, brands, and creatives who are shaping the modest fashion scene into one evening.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The event kicks off with a panel talk featuring industry professionals sharing their insights and experiences, followed by an exhibition showcasing modest fashion as an art form. There will also be plenty of opportunities to connect with others who share an interest in modern fashion and its evolving direction. The evening builds up to a finale of fashion runways, featuring some of your favourite brands alongside local businesses making their mark in the industry.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As an added bonus, sign ups to Toca’s golden goal scheme gets you a FREE DRINK, so you can enjoy the evening while supporting a good cause. We look forward to seeing you there for an evening of fashion, conversation, and community impact.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"hf315fnt\",\"label\":\"Gender?\",\"options\":[\"Female\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"8snnoe26\",\"label\":\"Do you have any allergies?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"isztbl0r\",\"label\":\"Do you pledge to attend & contact thefajrclub in the event of a cancellation?\",\"options\":[\"Yes\"],\"required\":true,\"question_type\":\"dropdown\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
