n.com/uploads/48/7e66113e-b9ac-4b3d-8ac6-aae29eeae2df.jpg\",\"end_at\":\"2026-09-24T15:30:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"AIYA Bureau. The Architecture of Acquisition\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/n9/9fef99ab-7dab-46bf-972b-7a0dd5e962e9.png\",\"start_at\":\"2026-09-24T11:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"a3pu164g\",\"user_api_id\":\"usr-Tn2FvIaEKW9wuTj\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Ladbroke Hall\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJ32NUlHsRdkgRImEW-DKJ_IA\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"Ladbroke Hall\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"Ladbroke Hall, 79 Barlby Rd, London W10 6AZ, UK\",\"region_short\":\"England\",\"short_address\":\"Ladbroke Hall, 79 Barlby Rd, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"Ladbroke Hall, 79 Barlby Rd, London W10 6AZ, UK\",\"region_short\":\"England\",\"short_address\":\"Ladbroke Hall, 79 Barlby Rd, London\",\"place_coordinate\":null,\"apple_maps_place_id\":\"I5D6B9B7AB45CFB1\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.22018549999999998,\"latitude\":51.5233028},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-09-24T11:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-Tn2FvIaEKW9wuTj\",\"avatar_url\":\"https://images.lumacdn.com/uploads/kh/1179e753-f6a6-47af-a428-998d6c40aa9e.png\",\"bio_short\":\"AIYA Bureau is an award-winning interior architect studio based in London, Milan, Moscow and Dubai.\",\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"aiyabureau\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"AIYA Bureau\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"aiyabureau\",\"website\":\"https://aiyabureau.com\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#c7c5bf\",\"#aeaaa0\",\"#888174\",\"#332920\"],\"palette\":{\"neutral\":[{\"color\":\"#aeaaa0\",\"percentage\":11.73},{\"color\":\"#c1bfb7\",\"percentage\":10.79},{\"color\":\"#888174\",\"percentage\":9.86},{\"color\":\"#332920\",\"percentage\":7.67},{\"color\":\"#e9e9e6\",\"percentage\":3.45},{\"color\":\"#cecdc8\",\"percentage\":9.13}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/n9/9fef99ab-7dab-46bf-972b-7a0dd5e962e9.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-81ZLfk3dWASCE6O\",\"cents\":18000,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-ktjDHm7bJSkCda9\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":18000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":9,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"ru\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#837b6f\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We are hosting a private afternoon lecture and lunch at Ladbroke Hall on 24th of September.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Aiya Lisova, Founder of AIYA Bureau, will speak on the decisions that shape a property's long-term value and singularity - how high-quality interiors affect market value and liquidity, and how a home built around an art collection from the earliest planning stages becomes something genuinely irreplaceable. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"The talk will be followed by an open Q&A drawing on real projects and case studies, then lunch at Pollini. Twelve guests, all of whom are buying, developing or investing in property in London.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Thursday, 24th of September - 12:00 to 16:30 Ladbroke Hall, London\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Ticket includes lunch at Pollini at Ladbroke Hall, led by acclaimed Italian chef Emanuele Pollini, as well as a private walkthrough of the spaces of Carpenters Workshop Gallery.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Please note: the event will be held in Russian\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"ruda196i\",\"label\":\"To ensure a comfortable lunch experience, please let us know about any dietary requirements or allergies.\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
