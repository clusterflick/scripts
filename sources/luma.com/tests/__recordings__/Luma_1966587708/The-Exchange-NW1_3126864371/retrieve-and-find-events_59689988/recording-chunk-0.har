as_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":15,\"ticket_count\":15,\"hosts\":[{\"api_id\":\"usr-kdWgyRSbL2nd3GR\",\"avatar_url\":\"https://images.lumacdn.com/uploads/vu/d5695bf0-87cf-403d-989f-d8d67760658d.png\",\"bio_short\":\"A life well-lived. More than just beautiful buildings.\",\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"masonfifth\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Mason & Fifth\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"masonfifth\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f5f5f5\",\"#040303\",\"#797979\",\"#a628c6\"],\"palette\":{\"neutral\":[{\"color\":\"#040303\",\"percentage\":17.78},{\"color\":\"#f5f5f5\",\"percentage\":26.91},{\"color\":\"#797979\",\"percentage\":13}],\"vibrant\":[{\"color\":\"#a628c6\",\"percentage\":8.79},{\"color\":\"#13f9b0\",\"percentage\":7.53},{\"color\":\"#f3124d\",\"percentage\":2.32},{\"color\":\"#37ceed\",\"percentage\":7.18}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/5b/a340fa83-e622-409d-8ce6-bcf4efc4b171.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-6ltCAmaOXcLZFdr\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-NapzzztLvCr1BxI\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":15,\"num_guests\":15,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":35,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f4f4f5\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Little Lagos Kollective (LLK)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" presents poet, playwright, graphic artist Inua Ellams on the eve of his forthcoming books in conversation with Nike Awoyinka and DJ Edu;\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Actual: The Actual is a symphony of personal and political fury sometimes probing delicately, sometimes burning with raw energy. In poems that swerve and crackle with a rare music, Inua Ellams, unleashes a full-throated assault on empire and its legacies of racism, injustice and toxic masculinity. ‘Ellams’ is a mineral-rich poetry, organic in its ability to speak across oceans, cultures and histories’\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Written on the author’s phone, in transit, between meetings, before falling asleep and just after waking, this is poetry as polemic, as an act of resistance, but also as dream-vision. At its heart, this book confronts the absolutism and ‘foolish machismo’ of hero culture from Perseus to Trump, from Batman to Boko Haram.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"This new edition – featuring personal essays initially produced for radio, which unpack the socio-political history informing the poems – looks the world square in the face and asks, ‘What the actual…?’\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Of All The Boys: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"A deeply autobiographical collection of poems probing the end of childhood and the complications of Nigerian Hood, ‘Of All The Boys’ is a dynamic body of work that engages the cultural destruction and devastation of Britain’s looting and sacking of Benin City.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Biog:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Born in Nigeria, INUA ELLAMS is a UK-based poet, playwright and performer who has written for the Royal Shakespeare Company, the National Theatre and the BBC. His published books of poetry include Candy-Coated Unicorns and Converse All Stars, Thirteen Fairy Negro Tales, The Wire-Headed Heathen, #Afterhours and The Actual.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"He is a fellow of The Royal Society of Arts and The Royal Society of Literature. In 2023, he was honoured with an MBE for Services to the Arts and an Honorary Doctorate from the University of the Arts, London.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"‘Ellams’ poetry gleams with a dusty, worn, deeply original beauty and he remains such wonderfully generous company’  \",\"type\":\"text\"},{\"text\":\"– Metro\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"‘Ellams possesses an intuitive and fluid grasp of the eternal virtues and heroic narratives that constitute our trans-global imaginations’ \",\"type\":\"text\"},{\"text\":\"– Major Jackson\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
