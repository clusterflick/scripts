approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Dreamy\",\"type\":\"shader\",\"theme\":\"shader-dark\",\"color1\":\"#0016e6\",\"color2\":\"#2d00e6\",\"color3\":\"#00a6e6\"},\"tint_color\":\"#3100ff\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Dance, move, and experience the energy of Brazil!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join our amazing \",\"type\":\"text\"},{\"text\":\"Fitdance\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/fitdance/\"}}]},{\"text\":\"  instructors \",\"type\":\"text\"},{\"text\":\"Lea Souza \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/leasousareal?utm_source=luma\"}}]},{\"text\":\", \",\"type\":\"text\"},{\"text\":\"Lucas Triay\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/lucastriaydancer/\"}}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"& \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"Isadora Brizolara\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/isabrizo/\"}}]},{\"text\":\" for an unforgettable Brazilian FitDance in the heart of London.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Move. Sweat. Connect.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"More than a dance class, this is an experience.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Every session is a celebration of Brazilian culture, bringing together music, movement and genuine human connection in one vibrant space.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you've never danced before or already love to move, you'll feel welcomed from the very first song. Our easy-to-follow choreography allows everyone to dance, have fun and enjoy the moment—without pressure or judgement.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Leave your worries at the door, reconnect with yourself, meet amazing people and experience the joy, freedom and positive energy that make Brazilian dance so unique.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is your weekly escape. Your community. Your happy place\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"✨ Save the Date\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 \",\"type\":\"text\"},{\"text\":\"Date:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Tuesday\",\"type\":\"text\"},{\"text\":\", \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"22nd September 2026\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"⏰ \",\"type\":\"text\"},{\"text\":\"Time:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 8:30 PM – 9:30 PM\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"📍 Location:\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"DanceWorks Studios – Mayfair \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"16 Balderton St, London W1K 6TN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://maps.google.com/maps/place//data=!4m2!3m1!1s0x4876052d63c76435:0xde8ee91611326ab7?entry=s&sa=X&ved=1t:8290&hl=en-br&ictx=111\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Just opposite the Selfridges Clock, only a few minutes from Bond Street Station.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟 Book your spot now through our\",\"type\":\"text\"},{\"text\":\" portal\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://lu.ma/bdauk\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"🎟 Limited Spots Available\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"To maintain the best experience, comfort, and energy in every session, spaces are limited.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you’ve joined us before, you already know our classes sell out quickly.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"If it’s your first time, this is the perfect opportunity to start.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"📲  Join our \",\"type\":\"text\"},{\"text\":\"WhatsApp community \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/L35Etc9uzDV1mm551ZdaWD?utm_source=luma\"}}]},{\"text\":\"to receive updates about upcoming classes, events, and exclusive announcements.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📸 Follow us on Instagram:\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"• \",\"type\":\"text\"},{\"text\":\"FitDance\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/fitdance/?utm_source=chatgpt.com\"}}]},{\"type\":\"hard_break\"},{\"text\":\"• \",\"type\":\"text\"},{\"text\":\"Brazilian Dance Academy UK\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/bdacademyuk/?utm_source=chatgpt.com\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"#BrazilianDance #Pagofunk #FitDance #BrazilianRhythms #DanceClassLondon #BDA #FitdancecUK #MoveSweatConnect #BrazilianFunk #Swingueira #PagodeBaiano\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"5qv0lw47\",\"label\":\"Please provide your FULL name:\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"teccze6p\",\"label\":\"If your booking is for a group, please provide the information for each person: name and email.\",\"required\":false,\"question_type\":\"long-text\"},{\"id\":\"6ag6cfph\",\"label\":\"Where did you hear about us?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"goonl23a\",\"label\":\"Date of Birthday\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"42hgehy8\",\"label\":\"This Event Will Be Filmed & Photographed. You Must Therefore Agree To Be Photographed &/Or Filmed And Form Part Of Any Future Marketing & Promotions By Haus Media Group,  and Any Of Our Subgroup, Brands & Third Party Sponsors & Supporters. (Note that if you do not give consent you must notify the event organizer as you may be placed where there will be no filming to protect your privacy) We are not responsible on what other students are recording and posting.  Do you give consent?\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"ns6fuvyc\",\"label\":\"What is your Instagram username?\",\"required\":false,\"question_type\":\"instagram\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[{\"api_id\":\"calmemtier-5j6r5vi3o4bxuw7\",\"access_info\":{\"type\":\"payment-recurring\",\"currency\":\"gbp\",\"amount_yearly\":null,\"amount_monthly\":3800,\"require_approval\":false,\"stripe_account_id\":\"acct_1L5ITZIbl3Jf9f7d\",\"stripe_product_id\":\"prod_UafaqXTIGJWGOh\",\"stripe_yearly_price_id\":null,\"stripe_monthly_price_id\":\"price_1TbUFSIbl3Jf9f7d6TRekkqz\"},\"description\":\"Access all BDA classes twice weekly: - Tuesday’s & Thursday's:\\n- No restrictions on class access.\\n- You can cancel your membership anytime. \\n- Keep in mind that your subscription remains active until the end of the cancellation month. After that, no further charges will occur. \\n- There should be a minimum of 4 classes per month on the regular days and at the regular locations\",\"registration_questions\":[{\"id\":\"1gncy9a3\",\"label\":\"What is your Instagram username?\",\"required\":false,\"question_type\":\"instagram\"},{\"id\":\"l7vuw7gu\",\"label\":\"What is your contact phone number?\",\"required\":true,\"question_type\":\"phone-number\"},{\"id\":\"4yf9ie6d\",\"label\":\"Date Of Birth\",\"required\":true,\"question_type\":\"text\"}],\"calendar_api_id\":\"cal-UUmdV32Et0AKggH\",\"tint_color\":\"#146aeb\",\"name\":\"Membership Premium\"}],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
