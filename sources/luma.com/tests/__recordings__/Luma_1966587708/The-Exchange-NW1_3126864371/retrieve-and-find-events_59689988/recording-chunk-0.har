makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":2200,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#c04e4f\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"VERY LIMITED TICKETS AVAILABLE, ONE DRINK INCLUDED IN YOUR TICKET\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for an interactive substack discussion circle hosted and led by Mehek Ali\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will be discussing the question: 'Is Our Creativity Dying?' using a range of different articles and resources to inform us and guide the discussion. Some questions we will explore:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What does it mean to be creative?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What is the role of creativity?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Who gets to be creative?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Are we becoming more, or less creative?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What does creativity look like under capitalism?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Is our collective creativity under threat?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What role do AI and platforms such as IG and TikTok play in our creativity consciousness?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"How do we regain control of our creativity?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Participants will receive a link to the articles closer to the time/ some printed copies of the articles will be available on the day. which we would all read and then come together to discuss and share thoughts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This discussion circle will be led by Mehek Ali:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Mehek is a Law grad turned senior creative at AMALIAH + director and writer. She’s also a retired content creator. Having amassed over 80k followers in TikTok’s golden era (pre-ads), she started to feel creatively disillusioned navigating the demands of short form content platforms that prioritise analytics, censorship, speed and a ‘’well this is what works’’ attitude.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Instead she entered the behind the scenes of the creative world. But agency life was no better - think beefing with CDs to step away from boycott brands, having ideas stolen and contending with who gets to paint unsupervised and who even gets to squiggle on the drawing board.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"FYI: We typically operate a no refunds policy for our events.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
