:\"#f0ad6a\",\"percentage\":15.77},{\"color\":\"#da7a4e\",\"percentage\":4.1}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/gi/1b0895aa-f4e8-42cc-98c0-ef4d7d76da50.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-MzzsSBmInbjO6Yc\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-e46gLqmMSoJmHxc\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-climate\",\"description\":\"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.\",\"event_count\":1574,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png\",\"name\":\"Climate\",\"page_title\":\"Climate Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png\",\"slug\":\"climate\",\"social_image_url\":\"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#146AEB\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a screening and discussion of Guardians of the Wild, a visually stunning short documentary that follows WILDCOAST, an international conservation team working on the frontlines to protect our oceans, coastlines, and wildlife. From the beaches of Oaxaca, where millions of sea turtles return to nest, to the vast mangrove forests that fight climate change, to the remote deserts and coral reefs of Baja California Sur, the film reveals extraordinary places and the communities fighting to keep them alive. Guided by local “guardians” and woven together by the voice of WILDCOAST’s executive director Serge Dedina, Guardians of the Wild is both a celebration of nature’s resilience and a rallying call to defend our planet’s last wild places.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"We will be joined by Ann Wycoff, Development Director at WILDCOAST and producer of the film; and Paula Tussie, Global Strategy Director.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
