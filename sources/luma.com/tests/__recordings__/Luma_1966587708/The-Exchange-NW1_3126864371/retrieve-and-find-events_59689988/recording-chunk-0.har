"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":35,\"ticket_count\":35,\"hosts\":[{\"api_id\":\"usr-AyjbaqIksGzrJCk\",\"avatar_url\":\"https://images.lumacdn.com/uploads/lx/67f0e21d-dd31-4a40-b41f-47237697b18f.png\",\"bio_short\":\"A space where cultural curiosity meets literature\",\"first_name\":\"Atlas\",\"last_name\":\"Book Club\",\"instagram_handle\":\"atlasbookclub.lnd\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Atlas Book Club\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f2ece6\",\"#e54a23\",\"#362a1f\",\"#eec579\"],\"palette\":{\"neutral\":[{\"color\":\"#362a1f\",\"percentage\":4.91},{\"color\":\"#f2ece6\",\"percentage\":31.31}],\"vibrant\":[{\"color\":\"#e54a23\",\"percentage\":13.32},{\"color\":\"#eec579\",\"percentage\":0.72}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/rf/db586c1e-2b41-4697-9f44-2c5998a48147.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-1hGY44AXtNdxIjA\",\"cents\":1800,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-yYG0tw8FNk8guhi\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":35,\"num_guests\":35,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":1800,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f3ebe6\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"For our second destination, we journey to Nigeria through this month's book: \",\"type\":\"text\"},{\"text\":\"Things Fall Apart by Chinua Achebe.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"About the book:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A worldwide bestseller and the first part of Achebe's African Trilogy, \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Things Fall Apart \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\"is the compelling story of one man's battle to protect his community against the forces of change\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Okonkwo is the greatest wrestler and warrior alive, and his fame spreads throughout West Africa like a bush-fire in the harmattan. But when he accidentally kills a clansman, things begin to fall apart. Then Okonkwo returns from exile to find missionaries and colonial governors have arrived in the village. With his world thrown radically off-balance he can only hurtle towards tragedy.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"First published in 1958, Chinua Achebe's stark, coolly ironic novel reshaped both African and world literature, and has sold over ten million copies in forty-five languages. This arresting parable of a proud but powerless man witnessing the ruin of his people begins Achebe's landmark trilogy of works chronicling the fate of one African community, continued in \",\"type\":\"text\"},{\"text\":\"Arrow of God\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"No Longer at Ease\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Atlas Book Club \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"is a community for\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"bringing together intellectually curious people to have meaningful conversations about literature and the world. Everyone is welcome and we encourage being open minded and willing to learn! No expertise or knowledge needed other than having read the book selected for this month.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Accessibility :\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you need any special adjustments please get in touch as we aim to make Atlas as accessible as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Disclaimers:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you join the Waitlist, there will be a temporary charge on your card which will be released if you are not approved for the event.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"If you cannot attend\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via Luma or Instagram (@atlasbookclub.lnd) and we will try and find someone on the Waitlist to take your ticket. Please note that we \",\"type\":\"text\"},{\"text\":\"cannot guarantee a refund\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can't find a suitable replacement.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
