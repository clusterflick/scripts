",\"#ff4d29\",\"#579058\",\"#e3e1e2\"],\"palette\":{\"neutral\":[{\"color\":\"#0c0703\",\"percentage\":29.21},{\"color\":\"#e3e1e2\",\"percentage\":4.59}],\"vibrant\":[{\"color\":\"#ff4d29\",\"percentage\":18.81},{\"color\":\"#579058\",\"percentage\":13.84},{\"color\":\"#8fbfe7\",\"percentage\":3.35},{\"color\":\"#f4bf5f\",\"percentage\":0.69}]}},\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-YsrJozJ532nOmgW\",\"avatar_url\":\"https://images.lumacdn.com/uploads/fa/d52e28ed-63a3-42a2-82bb-29300217623e.png\",\"coordinate\":{\"longitude\":-0.23785350000000002,\"latitude\":51.5000049},\"cover_image_url\":\"https://images.lumacdn.com/uploads/be/242c6ac7-4d1d-4557-96a4-87f97f37cf25.png\",\"description_short\":\"Come vibe with us at the Clubhouse during our 1st BHM residency. More to come soon.\\n\\n📍Hammersmith (near the station)\\n\\nChoose your membership ↘\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"yaad.irl\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":\"/company/yaad-cic\",\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJwzfTXMEPdkgRAGfsoi2uDgQ\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"plus\",\"luma_plus_active\":true,\"meta_pixel_id\":null,\"name\":\"YAAD's Black History Month Clubhouse\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"By purchasing a YAAD October BHM Residency Membership, you agree to the following:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership access\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership gives you access to YAAD's home for October — co-working, makerspace equipment, lounge space, and our full BHM programme of workshops and events. Tuesday to Saturday, 10am-10pm; Sunday, 11am-6pm. Some equipment may be temporarily unavailable when it's off-site for a corporate workshop booking — we'll give as much notice as we can.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Full Access members' free studio time of up to 4 hours at Pirate Studios is subject to availability and is not guaranteed for the full month — we'd recommend booking your slot as early as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Opening hours\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Our hours are based on expected usage and may change during October depending on how the space is actually being used. We'll always give members as much notice as possible of any change.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"25+\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD is a 25+ space. Only purchase a membership or tickets if you are 25 or over. No refunds will be given for lack of adherence to this policy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Payment and billing\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This is a one-off payment covering your membership for October only. Sign-ups are reviewed and approved individually; you won't be charged until your membership is approved. You can cancel at any time before your membership is approved with no charge taken.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refund policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Membership payments already taken are non-refundable. Please make sure the membership is right for you before signing up; we're happy to answer any questions at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\" or \",\"type\":\"text\"},{\"text\":\"instagram.com/yaad.irl\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://instagram.com/yaad.irl\"}}]},{\"text\":\" before you commit.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Equipment and hazard risk\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD's makerspace includes equipment such as sewing machines, a Cricut machine, hot glue guns and a heat press. By using any YAAD equipment, you acknowledge that some tools carry inherent risk of injury (including burns, cuts or similar), and you agree to use them at your own risk and in line with any guidance provided on-site. YAAD is not liable for injury or damage arising from equipment use, except where caused by our negligence.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This October, YAAD is based in Hammersmith. The exact venue is subject to change until contracts are finalised — if it does change, it will remain within Zone 2, in the W, NW or SW London postcode areas.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Events and programme\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"All workshops and events are subject to change, including cancellation, rescheduling, or facilitator changes. We'll always give members as much notice as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Some Friday evening events require a £10 no-show hold when booking. This isn't a ticket price — it's fully refundable and is only kept if you don't check in.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Launch offer (sign up by 21 September)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Full Access (£60) members who sign up by 21 September can (1) bring a friend for free on one evening of their choosing during October, excluding Fridays and (2) the first 24 people to sign up also receive a free Black Tech Fest 2026 Day + Party ticket. Both offers apply once per member and are non-transferable.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Day passes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Day passes are non-refundable and follow the same 25+ policy as membership. Day pass holders are covered by the same photography/videography consent and equipment terms set out in these terms and conditions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography and videography\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD events may be photographed and filmed for community and promotional use. By attending, you consent to being captured in event photography and video content. If you have specific concerns, please let us know on the door and we'll do our best to accommodate you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership period\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership covers the duration of the October residency (1-31 October).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Data\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"We'll use your details to contact you about YAAD events and updates. We won't share your information with third parties without your permission.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Questions?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Email us at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"'Yaad' is a term of endearment for 'home' in Jamaican Patois and is used to describe one's house, roots and comfort.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"slug\":\"yaadbhm26\",\"social_image_url\":\"https://images.lumacdn.com/uploads/id/8e23e557-43b2-4d2b-8cf0-7af67e3aa973.png\",\"start_date\":null,\"stripe_account_id\":\"acct_1TftAtE382iycghr\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#451128\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":\"2026-09-05T10:46:39.153Z\",\"website\":\"https://yaad.space\",\"youtube_handle\":null,\"is_personal\":false,\"personal_user\":null,\"timezone\":\"Europe/London\"},\"start_at\":\"2026-10-09T09:00:00.000Z\",\"hosts\":[{\"api_id\":\"usr-9kJAr7aCciYOfsf\",\"avatar_url\":\"https://images.lumacdn.com/uploads/s7/8b399794-da7e-4651-bfda-ec6f773bf145.jpg\",\"bio_short\":\"25+ multifunctional makerspace, coworking hub & social members’ club. Join our £30 summer taster membership before we open a permanent space\",\"first_name\":\"YAAD\",\"last_name\":\"CIC\",\"instagram_handle\":\"yaad.irl\",\"is_verified\":false,\"linkedin_handle\":\"/company/yaad-cic\",\"name\":\"YAAD CIC\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"theeyaadie\",\"website\":\"https://yaad.space\",\"youtube_handle\":null}],\"guest_count\":0,\"ticket_count\":0,\"ticket_info\":{\"price\":{\"cents\":2000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"regist