\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":2500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":5000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":195,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"warp\"},\"tint_color\":\"#120c0d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"roc-grotesk\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome to Sacred Threads | LA-London: The Collective\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Two Cities. One Creative Language.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"LA-London: The Collective brings together fashion, art and culture, connecting designers and creative talent from Los Angeles and London for a unique evening of creativity, expression and connection in the heart of London.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Set within the beautiful surroundings of St John's Hyde Park, this year's edition, Sacred Threads, brings the creative energy and perspectives of both cities together under one roof.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Guests can expect runway fashion shows, art, performances, music, brand experiences and entertainment, alongside opportunities to meet and connect with designers, artists, models, creatives and industry professionals.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Following our first edition in 2025, Sacred Threads marks the next chapter of LA-London: The Collective, a creative platform built around collaboration, individuality and community, where fashion, art and culture cross borders and new creative connections are made.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"St John’s Church, Hyde Park\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📅 \",\"type\":\"text\"},{\"text\":\"23 September 2026\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"🕖 \",\"type\":\"text\"},{\"text\":\"7:00 PM – Midnight\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come for the fashion. Discover the art. Meet the people behind it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dress to express yourself  and be part of the experience.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Walk With Us and Leave Diamonds Behind.💎\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Fashion, Art and Cultural Event by RunwayDiamonds.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":true,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
