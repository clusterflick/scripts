            "text": "{\"api_id\":\"evt-XimqGKZMISlU678\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-5lYjkSAWV4EqRmF\",\"avatar_url\":\"https://images.lumacdn.com/calendars/3s/7d211ea9-8684-4a1d-89ec-c34db403fde0\",\"coordinate\":{\"longitude\":0.52213,\"latitude\":51.380952},\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/5t/c308ab55-a928-486b-89c9-fe9dee73cc4b\",\"description_short\":\"\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"electricmedway\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":\"/company/electricmedway\",\"location\":{\"city\":\"Chatham\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJ879bI9HM2EcRW7hhxDrYzIE\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"Chatham\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"free\",\"luma_plus_active\":false,\"meta_pixel_id\":null,\"name\":\"Electric Medway\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Guests can request a full refund up to 24 hours before the activity starts. In the rare event that we have to cancel the activity, a full refund will be offered. Similarly, if the activity has to be postponed a full refund will be offered if the rescheduled date is not suitable.\",\"type\":\"text\"}]}]},\"slug\":\"electricmedway\",\"social_image_url\":\"https://images.lumacdn.com/calendar-cover-images/9x/3967ce7e-90cf-4935-829f-7d4f6b6140f2\",\"start_date\":null,\"stripe_account_id\":\"acct_19M224HB2fO5Uddl\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#D69712\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":\"2025-01-06T17:11:45.559Z\",\"website\":\"https:///electricmedway.org\",\"youtube_handle\":\"Electri