um_guests\":18,\"spots_remaining\":2,\"is_disabled\":false},{\"api_id\":\"ttype-YfeIZ6CG29LEbPL\",\"cents\":1499,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-StprdAAOeFYJ5sb\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Full Price\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":\"2026-09-06T23:00:00.000Z\",\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-hmRjZBSnZrHPBwC\",\"cents\":2499,\"currency\":\"gbp\",\"description\":\"Get a discount on a signed copy of dyslexia unlocked plus an early bird ticket for our dyslexia awareness week event.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-StprdAAOeFYJ5sb\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"Book Bundle: Early bird + book\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-09-06T22:59:59.000Z\",\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":1499,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":39,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f9fafc\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"museo\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"DYSLEXIA UNLOCKED LIVE\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Celebrate dyslexia awareness week in style\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dyslexia Awareness Week comes round once a year, and most of us mark it with a LinkedIn post.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This year, spend it in a room full of dyslexic adults instead.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"What you get\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A room that gets it.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Connect with a dyslexia community. You'll hear what's working for other dyslexic adults, share what works for you, and leave with ideas about how to grow with your dyslexia rather than around it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A 30 minute talk\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" on the framework from \",\"type\":\"text\"},{\"text\":\"Dyslexia Unlocked\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", published by Bloomsbury:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Creating Confidence.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Unpicking what school left behind, and accepting a brain that works differently.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Building Systems.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Simple systems that work with how you think rather than against it.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unlocking Strengths.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Working out what your dyslexic strengths actually are, and how to explain them to other people.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your questions answered.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Fifteen minutes, open floor, ask me anything.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Time to stay.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Books, signing, and the people you've just met.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Who it's for\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dyslexic adults, diagnosed or not. Partners, friends, family and colleagues welcome too.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Getting there\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Two minutes from Goodge Street. Step-free and fully wheelchair accessible at street level, with accessible toilets on the same floor. Slides use large, clear type, and nobody will be asked to read anything aloud.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"About Natalie\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I'm Natalie Brooks, founder of Dyslexia in Adults and author of \",\"type\":\"text\"},{\"text\":\"Dyslexia Unlocked\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", published by Bloomsbury. I've spent seven years working with dyslexic adults, from one-to-one coaching through to teams at Microsoft, BCG and the UK Civil Service.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I'm dyslexic and ADHD myself, and I spent years assuming everyone else had been handed a manual I'd missed. There isn't one. So I wrote it.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
