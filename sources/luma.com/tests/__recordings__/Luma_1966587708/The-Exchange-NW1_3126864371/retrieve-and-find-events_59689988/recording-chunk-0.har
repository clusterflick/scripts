_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-ZVv4pHZGyGNDfG9\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_41.png\",\"bio_short\":\"\",\"first_name\":\"Helena\",\"last_name\":\"Puskarz\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Helena Puskarz\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":39,\"ticket_count\":80,\"hosts\":[{\"api_id\":\"usr-2ieFZ9PksnkxaXB\",\"avatar_url\":\"https://images.lumacdn.com/avatars/g3/1bb2706f-4d1d-45b3-8a6b-5c2b0eb69ac0.jpg\",\"bio_short\":\"A curated social–business circle bringing together people who value trust, meaningful conversation, and shared experiences.\",\"first_name\":\"Renata\",\"last_name\":\"\",\"instagram_handle\":\"businesssocialclubuk\",\"is_verified\":false,\"linkedin_handle\":\"/company/businesssocialclub\",\"name\":\"Business Social Club\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"BSC\",\"website\":\"https://www.businesssocialclub.uk/\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#020101\",\"#895d30\",\"#cba435\",\"#e8d2ba\"],\"palette\":{\"neutral\":[{\"color\":\"#020101\",\"percentage\":66.97},{\"color\":\"#e8d2ba\",\"percentage\":0.79}],\"vibrant\":[{\"color\":\"#895d30\",\"percentage\":2.95},{\"color\":\"#cba435\",\"percentage\":0.85}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/mk/c0f15e76-f27a-4a0b-85f9-d7b1d478d506.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-lELm1GKD47OONHB\",\"cents\":3500,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirement