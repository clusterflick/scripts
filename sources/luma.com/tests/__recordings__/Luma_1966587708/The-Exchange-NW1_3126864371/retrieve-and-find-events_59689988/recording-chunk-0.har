c\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refunds can be requested up to 14 calendar days before event date.\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-ASQyKcOwWKgEGV5\",\"avatar_url\":\"https://images.lumacdn.com/uploads/6b/92863e24-a2c5-4388-986a-95155079378b.jpg\",\"bio_short\":\"\",\"first_name\":\"Rich\",\"last_name\":\"Chapple\",\"instagram_handle\":\"richard_chapple_\",\"is_verified\":false,\"linkedin_handle\":\"/in/richardchapple\",\"name\":\"Rich Chapple\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"richchapple\",\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-IzA5BddRmSZexK6\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_14.png\",\"bio_short\":null,\"first_name\":\"Danny\",\"last_name\":\"Rose\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Danny Rose\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-IAL5qAxJM1W25O9\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_42.png\",\"bio_short\":\"drums\",\"first_name\":\"Steve\",\"last_name\":\"White\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Steve White\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#010101\",\"#f5efe2\",\"#ca211c\",\"#4b98d5\"],\"palette\":{\"neutral\":[{\"color\":\"#010101\",\"percentage\":55.08},{\"color\":\"#f5efe2\",\"percentage\":19.41}],\"vibrant\":[{\"color\":\"#ca211c\",\"percentage\":0.12},{\"color\":\"#4b98d5\",\"percentage\":0.11}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/b2/14283435-1a44-4b37-bbf9-7ae08fa6e92c.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-HdLS9p19gW5kkcq\",\"cents\":5000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-QAZ2Wzsv9onOKWN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":5000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":18,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#291a20\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sunday Drum Club: Steve White’s Paradiddle Paradigm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re delighted to welcome \",\"type\":\"text\"},{\"text\":\"Steve White\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" to centre stage for the second \",\"type\":\"text\"},{\"text\":\"Sunday Drum Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", our monthly gathering for drummers to connect, learn, play and be inspired.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hosted at \",\"type\":\"text\"},{\"text\":\"AMP Studios in Hextable, Kent\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", this special afternoon session offers an intimate opportunity to learn directly from one of Britain’s most respected drummers and educators.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎙️ \",\"type\":\"text\"},{\"text\":\"Your Hosts\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Danny Rose\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", renowned educator and drummer with the legendary \",\"type\":\"text\"},{\"text\":\"The Real Thing\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", will host the session alongside \",\"type\":\"text\"},{\"text\":\"Steve White\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", best known for his extensive work with \",\"type\":\"text\"},{\"text\":\"Paul Weller and The Style Council\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", as well as a career spanning live performance, recording and music education.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ \",\"type\":\"text\"},{\"text\":\"Session Two: The Paradiddle Paradigm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Steve will present a special session based on his brand-new book, \",\"type\":\"text\"},{\"text\":\"Paradiddle Paradigm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", co-written with fellow UK drummer \",\"type\":\"text\"},{\"text\":\"Russ Tarley\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Starting with just three familiar sticking patterns, Steve will break down the almost endless ways they can be developed and applied around the drum kit to unlock greater creativity, technique, phrasing and musicality.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is not a typical masterclass. The session will combine explanation, demonstration, practical learning and conversation, including:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A detailed breakdown of three popular sticking patterns\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and the foundations behind them.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Live demonstrations from Steve\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", showing how simple ideas can develop into creative musical vocabulary.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Practical applications around the drum kit\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", helping you improve coordination, phrasing, technique and musicality.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Insight into Steve’s approach to practice and performance\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", drawn from more than four decades as a professional drummer.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Audience Q&A\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", giving you the opportunity to ask Steve questions directly.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A relaxed, community-focused atmosphere\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" for drummers of all styles, levels and backgrounds.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"The Venue\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"AMP Studios\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" offers ample parking, strong transport links and nearby accommodation, making it easy to attend wherever you are travelling from.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Sunday Drum Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is more than a clinic. It is a place to hang out, learn, share stories and be part of the UK drumming community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sunday 22 November\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"14:30 to 17:30\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Tickets: £50\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Links:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"AMP Studios: \",\"type\":\"text\"},{\"text\":\"https://www.amp.school/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.amp.school/\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Steve White: \",\"type\":\"text\"},{\"text\":\"https://www.whiteydrums.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.whiteydrums.com\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Steve White biography: \",\"type\":\"text\"},{\"text\":\"https://en.wikipedia.org/wiki/Steve_White_(drummer)\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://en.wikipedia.org/wiki/Steve_White_(drummer)\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Merch: \",\"type\":\"text\"},{\"text\":\"https://aomap-2.teemill.com/product/amp-sunday-drum-club-plain-tee/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://aomap-2.teemill.com/product/amp-sunday-drum-club-plain-tee/\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"qtDgxyAc\",\"label\":\"Have you been to an AMP event previously?\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
