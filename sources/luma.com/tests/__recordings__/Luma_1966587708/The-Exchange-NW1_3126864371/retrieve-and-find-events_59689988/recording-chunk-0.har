/avatar_26.png\",\"bio_short\":null,\"first_name\":\"Kaisha\",\"last_name\":\"Wade\",\"instagram_handle\":\"kshawade\",\"is_verified\":false,\"linkedin_handle\":\"/in/KaishaWadeSpeid\",\"name\":\"Kaisha-Wade\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-LXvHSB4MDivzFBG\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_24.png\",\"bio_short\":null,\"first_name\":\"Nikki\",\"last_name\":\"Paraskeva\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Nikki Paraskeva\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-tTfVRPRbR5L1gcL\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_18.png\",\"bio_short\":null,\"first_name\":\"Beatrice\",\"last_name\":\"Tanikie-Montagnani\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Beatrice Tanikie-montagnani\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-Ty00xpcAGDyFGRo\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_41.png\",\"bio_short\":null,\"first_name\":\"Olamide\",\"last_name\":\"Taiwo\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Olamide\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"we are unable to refund tickets\",\"type\":\"text\"}]}]},\"guest_count\":5,\"ticket_count\":5,\"hosts\":[{\"api_id\":\"usr-i2BPQA7gwGKrTJl\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_41.png\",\"bio_short\":null,\"first_name\":\"Hillary\",\"last_name\":\"Juma\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Hillary Juma\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#131309\",\"#536738\",\"#614640\",\"#f0ebed\"],\"palette\":{\"neutral\":[{\"color\":\"#131309\",\"percentage\":16.48},{\"color\":\"#f0ebed\",\"percentage\":1.33}],\"vibrant\":[{\"color\":\"#536738\",\"percentage\":9.99},{\"color\":\"#614640\",\"percentage\":8.17}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/no/fdf39210-aabb-4f0e-b72e-1eb8adb47ce0.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-w2GoK1XCtugd76Q\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-39FT6ObHWhlKQQ3\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":35,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"RSVP [Drink included]\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":33,\"is_disabled\":false},{\"api_id\":\"ttype-avkQtn92IiGUIzR\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-39FT6ObHWhlKQQ3\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"RSVP [no drink included]\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":12,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":500,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#5e7b4d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"On & On Presents: Do you really yearn ? with NuAloe\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We sit down for an intimate conversation exploring NuAloe's soon to be released EP, FOR THE YEARNERS a Black Queer Odyssey of Romantic Love\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About NuAloe\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"NuAloe is a South London singer, rapper & host whose sound blends Neo-Soul, R&B, Jazz, Reggae and Afrobeat. Their music explores Blackness, Queerness, Resistance and the everyday realities of South London, creating space for underrepresented voices in contemporary music.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Their live credits also include multiple appearances at Jazz Cafe and Southbank Centre, as well as performances at Brick Lane Jazz Festival, We Out Here, South London Gallery, IKEA’s Ambient Sounds, and their first international show at the International Dub Gathering in Spain and most recent performance at The Royal Albert Hall- Elgar Room\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Their practice is rooted in transparency, resistance and intention. In 2025, they removed their music from Spotify in solidarity with Palestine and others affected by violence, while speaking out against AI that replicates artists’ likenesses and creativity.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" The event is free to attend, but to support the infrastructure of the shop we suggest paying £5 and as form of gratitude you will receive a soft drink.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
