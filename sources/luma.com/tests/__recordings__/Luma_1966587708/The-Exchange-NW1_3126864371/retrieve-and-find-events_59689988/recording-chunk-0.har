e\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-r6gIHTAhpg2WKKc\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_8.png\",\"bio_short\":\"\",\"first_name\":\"Lada\",\"last_name\":\"\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Lada\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-zr6ax89Gc4p4A1A\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_2.png\",\"bio_short\":null,\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Luba \",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":3,\"ticket_count\":3,\"hosts\":[{\"api_id\":\"usr-kmcuyBMfCC1YBSc\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_9.png\",\"bio_short\":\"\",\"first_name\":\"Anzhela\",\"last_name\":\"Curator\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Anzhela\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f2e4d7\",\"#4f4f52\",\"#403d3a\",\"#a5775a\"],\"palette\":{\"neutral\":[{\"color\":\"#403d3a\",\"percentage\":7.98},{\"color\":\"#f2e4d7\",\"percentage\":43.21},{\"color\":\"#4f4f52\",\"percentage\":8.21}],\"vibrant\":[{\"color\":\"#a5775a\",\"percentage\":1.67}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/1v/f1a2c1f3-8ae8-4003-bd26-283a58f63bd5.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-DLZAtRnFgAfqqzc\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UbabTxwGOii0vj4\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f2e5d8\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"MIS-\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" explores error not as a flaw, but as an autonomous mode of existence. Everything commonly perceived as wrong is approached here as a moment in which new meaning emerges. Error disrupts the automatism of perception and compels us to reconsider the boundaries between right and wrong, original and copy, intention and outcome.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Within the context of the exhibition, **mis-**becomes a method. It is a space of misreadings, false memories, failed attempts, technical glitches, and accidental decisions. The works exist in a state of deviation—from function, from convention, from expectation.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Here, error is understood not as the absence of correctness, but as the production of alternatives. Every malfunction, every misstep, opens the possibility of another perspective, another logic, and another reality.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"MIS-\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is an exhibition about what happens when something goes wrong—and about how, precisely in that moment, something new can come into being.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
