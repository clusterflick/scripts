bp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":5000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":78,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#55859d\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"This Black History Month, Sistah Space and Manners London are coming together to host our first-ever sample sale, with all proceeds going directly to Sistah Space, the UK's first domestic abuse charity for Black women.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It's more than a sample sale. It's a community experience because when women come together, magic happens.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Roll up, settle in, grab a refreshment male new mates and and meet some of the incredible people behind Sistah Space, and Manners London including founders Sally Manners and Ngozi Fulani.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Throughout the day there will be a live DJ creating the perfect vibe while you shop and connect. We'll also be running a fundraising raffle packed with amazing  prizes from our generous partners, including a pole class voucher, a Caribbean restaurant dining voucher, and other surprise treats from supporting brands.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your ticket gives you access to a dedicated shopping slot in the Sistah Space shop. During your allocated session, you'll have time to browse a curated edit of donated Manners London pieces.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Every item purchased and every raffle ticket bought  directly supports African and Caribbean heritage women affected by domestic abuse. Your support will help us grow our team and work towards opening the UK's first dedicated refuge for African and Caribbean heritage women and their children escaping abuse.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come for the shopping. Stay for the people. Leave knowing you were part of something bigger.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Spaces are limited and must be booked in advance. Please select your preferred shopping slot when purchasing your ticket.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"See you there!!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Love\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All of us x\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"qsaxv9dy\",\"label\":\"Please share your size (in the format XXS to XXXXL).  We have limited items so we want to curate the event to alll your bodies!\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
