9.55}],\"vibrant\":[{\"color\":\"#f6c521\",\"percentage\":2.53},{\"color\":\"#5f0e2b\",\"percentage\":2.5}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/nc/1cd5853e-81df-4ee4-be5b-cca3269a5b2a.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-fwKxoMW6wdPN4YD\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-HLVeZCjaRQoFeGc\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":17,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fdfdfd\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\\"There is a conversation in the room that only these people at this moment can have\\\"\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"- Adrienne Mariee Brown\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join a playful experiment in using theatre based games and Forum Theatre* methods to explore some of the knotty - and/or silly - challenges of river life. We will decide the topics together, and they could relate to any of the challenges we face in our community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The less theatre experience the better! Bring yourself and a willingness to shake off the day.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is a space for exploration, listening, learning and reflection. Where the workshop goes depends somewhat on the group, but the exploration will all be done through games and world building together. We will check in with each other as the session progresses.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Arrive at 6:30pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Getting started by 6:45pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"End at 9:00pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"There will be a break with drinks and snacks provided.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"*A bit more detail about Forum Theatre\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Forum Theatre was pioneered by Brazilian radical Augusto Boal as a political tool for change (part of Theatre of the Oppressed), but has been widely adapted and used globally in different contexts. In a Forum Theatre ‘show’ the audience, also called spec-actors, are invited to contribute and re-write the story.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Forum theatre games are used in developing a show and can be used in standalone workshops for developing acting skills, or delving into experiences of a community such as this Lea Boaters session.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We'll start by warming up and trying to shake off inhibitions. We'll then set up some scenes relating to boat life using ideas from the group, and we'll ask how they could be different, or even better. We'll generate questions, no doubt with as many answers as people in the room. Together, we will find the discussion that only the people in that room can have.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"...\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A few accessibility notes for the venue:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Due to current building works at the front of Leaside, wheelchair access is currently via a side entrance room only. Please let us know in advance if this is needed.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"There is step-free access to the first floor via a lift, though there is a small lip at the ground floor entrance.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The venue also has hearing loops and accessible toilets.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This workshop is part of a free workshop series by Lea Boaters Organise and Loop Labs by and for boaters on the Lea, running until autumn 2026. The project is funded by The National Lottery Heritage Fund. We want to foster learning and community on the water, and would love you to join us - see \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"full programme here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://luma.com/user/usr-t2CMiN45UCEAmjw\"}},{\"type\":\"italic\"}]},{\"text\":\".\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
