l,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-zqP3t5xNwtpAF02\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_17.png\",\"bio_short\":null,\"first_name\":\"Hannah\",\"last_name\":\"Marshall\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Hannah Marshall\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":48,\"ticket_count\":48,\"hosts\":[{\"api_id\":\"usr-odthF5EVWIRwmoN\",\"avatar_url\":\"https://images.lumacdn.com/uploads/a0/11bdfc94-1812-486e-8bb4-c349f74dc8b8.jpg\",\"bio_short\":null,\"first_name\":\"Common Protocol\",\"last_name\":\"Team\",\"instagram_handle\":\"common_protocol\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Common Protocol Team\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"common_protocol\",\"website\":\"https://common-protocol.com/\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#050505\",\"#53b0de\",\"#fcfefe\",\"#74e24d\"],\"palette\":{\"neutral\":[{\"color\":\"#050505\",\"percentage\":60.56},{\"color\":\"#fcfefe\",\"percentage\":3.67}],\"vibrant\":[{\"color\":\"#53b0de\",\"percentage\":8.45},{\"color\":\"#74e24d\",\"percentage\":1.63},{\"color\":\"#6af0e1\",\"percentage\":2.25}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/2s/64975e2e-f526-42da-a5df-14a51df1bff0.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-nzBHV9xtEnRaqJO\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-0wXaTuG4ta8FRjg\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":48,\"num_guests\":48,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#010102\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"google\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expanding Frequencies\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is a half-day gathering organised by Common Protocol and co-presented with arebyte Digital Art Centre, bringing together artists, curators, and organisers to reflect on the evolving digital art landscape.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The programme combines a panel discussion on infrastructures of support, a series of short presentations by invited practitioners, and an open-format session for exchange and networking.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expanding Frequencies\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is curated by Clara Che Wei Peh, produced by Mary Ann Ng, organised by Common Protocol and co-presented with arebyte Digital Art Centre. This programme is supported by the National Arts Council Singapore and Singapore Global Network (SGN).\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Programme Schedule\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"3.00PM Introduction by Clara Che Wei Peh, Curator, Common Protocol\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"3.05PM Infrastructures of Support\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This panel discussion brings together curators and organisers working across contexts in Singapore and London to consider how structures of support for digital art and innovation are being built and sustained.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Speakers:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pita Arreola, Head of Programmes, arebyte Digital Art Centre,\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Clara Che Wei Peh, Curator and Foundation, Common Protocol\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dr Linda Rocco, Curator (Arts & Technology), Somerset House Studios. Tutor (Research), Royal College of Art\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tsige Tafesse, Producer, Arts Technologies, Serpentine\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"4.00PM Practicing Today\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This session brings together a series of short presentations by four invited practitioners. Each offers insight into how an artist is broadening the digital art landscape from within their own work. The session is co-convened with Dr Sean Cham, artist and researcher based in London.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Speakers:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ibiye Camp, Artist, Designer and Educator\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Adam Cole, Artist / Researcher, Creative Computing Institute, University of the Arts London\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Kim Ying, Artist-technologist\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Studio Playfool, Artist / Designer\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"5.00PM Open Fields\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The programme concludes with an Unconference, designed to encourage dialogue and connection among participants for peer-to-peer exchange and provide ground for future collaborations.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Facilitators:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Abigail Miller, Curator, Writer and Cultural strategist\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Stephanie Yeap, Programme & Communications Manager, Bagri Foundation, and independent arts journalist\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sign up now to join us!\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Designs by Ninaad Kothawade\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Comms support from Ginny Hwang\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"nf9c7tz3\",\"label\":\"Nationality\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"rzvkvu7g\",\"label\":\"City, Country of Residence\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"zv405owv\",\"label\":\"Occupation\",\"options\":[\"Student\",\"Working Professional\",\"Business Owner/Entrepreneur\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"w4o2b7ly\",\"label\":\"School / University (Students only; otherwise enter N/A)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"y34a0nxf\",\"label\":\"Qualification currently pursuing (Students only; otherwise enter N/A)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"0pwh9j6m\",\"label\":\"Year of Graduation (Students only; otherwise enter N/A)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"oqsrbwnc\",\"label\":\"Industry of Work\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"ckyapjjh\",\"label\":\"Job function / Role\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"rugoeurj\",\"label\":\"Job Level\",\"options\":[\"C-Suite\",\"EVP / Director or Lead Specialist\",\"Manager or Senior Specialist\",\"Associate or Executive\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"pz9wzjhw\",\"label\":\"Photography and filming may take place during Expanding Frequencies. Images and recordings may be used by the organisers and event partners for documentation, publicity and communications. If you prefer not to be photographed or filmed, please let a member of the event team know.\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"0kf4jktc\",\"label\":\"Terms and Conditions\",\"terms\":{\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please read the Singapore Global Network's privacy statement at \",\"type\":\"text\"},{\"text\":\"https://singaporeglobalnetwork.gov.sg/privacy-statement/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://singaporeglobalnetwork.gov.sg/privacy-statement/\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I have read and understood Singapore Global Network’s Privacy Statement, and agree to receive news and updates as well as exclusive invitations from Singapore Global Network.\",\"type\":\"text\"}]}]},\"content_type\":\"text\",\"require_review\":false,\"collect_signature\":false},\"required\":true,\"question_type\":\"terms\"},{\"id\":\"9l9v6sxy\",\"label\":\"Are you currently employed?\",\"options\":[\"Yes, full-time\",\"Yes, part-time\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
