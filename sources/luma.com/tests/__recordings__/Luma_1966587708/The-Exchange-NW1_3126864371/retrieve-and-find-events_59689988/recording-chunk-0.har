:false,\"spots_remaining\":15,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#1e6b0a\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sal:mender Magazine\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/salmendermagazine?stkn=MXhtZGE0ZjJ4MnFwcQ==\"}}]},{\"text\":\" presents \",\"type\":\"text\"},{\"text\":\"À Table!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", an intimate dining experience exploring food as a vessel for cultural memory.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Lovingly prepared by \",\"type\":\"text\"},{\"text\":\"Meja Makan\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/_mejamakan_?stkn=MWF1aDVoam1ycXl1cg==\"}}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"Chef Jen \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/jens_tiny_kitchen?stkn=bDR5b2ttYWp1ejA5\"}}]},{\"text\":\", \",\"type\":\"text\"},{\"text\":\"À Table!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" brings together Cameroonian and Indonesian cuisine, exploring the parallels between two food cultures through traditional methods of cooking, preservation and presentation, using leaves as both a means of preparation and a way of bringing food to the table.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Through an interactive dining experience and immersive storytelling, we invite you to take part in the care, craftsmanship and stories held within each dish.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"MENU\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drinks\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Es Teh Sereh (lemongrass iced tea)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Foléré (hibiscus flowers, pineapple, and ginger)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Entrée\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Koki + plantain \",\"type\":\"text\"},{\"text\":\"(black-eyed beans pudding + boiled plantain)\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Egusi pudding + bobolo \",\"type\":\"text\"},{\"text\":\"(ground melon egusi seeds pudding made with eggs, beef, smoked fish and crayfish + fermented cassava in plantain leaves)\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Mains\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nasi Bakar Ayam Kemangi + Teri (\",\"type\":\"text\"},{\"text\":\"anchovies infused rice, with slow cooked shredded chicken in banana leaf)\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nasi Bakar Jamur + Pepes Tahu (\",\"type\":\"text\"},{\"text\":\"spiced mushrooms rice + steamed ground spiced tofu in banana leaf)\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dessert\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Puff Puff + Vanilla Ice Cream (sweet fried dough ball)\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"NUJtXVpM\",\"label\":\"Which menu option applies to you?\",\"options\":[\"Meat\",\"Vegetarian\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"8NfsAQgQ\",\"label\":\"Do you have any allergies or dietary requirements? Please list any allergies, intolerances or other dietary requirements we should be aware of.\",\"required\":true,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
