":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-K07lyu4Kck6zvJ1\",\"cents\":1000,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-JaoSQsNTj9EVDFh\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"6\",\"name\":\"Solidarity/ Pay Forward Ticket\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-sIBe3jYV2noNU15\",\"cents\":56,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-JaoSQsNTj9EVDFh\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":50,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"8\",\"name\":\"Pay what you can\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":48,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"},{\"api_id\":\"cat-climate\",\"description\":\"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.\",\"event_count\":1574,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png\",\"name\":\"Climate\",\"page_title\":\"Climate Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png\",\"slug\":\"climate\",\"social_image_url\":\"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":{\"cents\":56,\"currency\":\"gbp\",\"min_cents\":0,\"is_flexible\":true},\"is_free\":false,\"max_price\":{\"cents\":1000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":33,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#eaa7c8\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"alternate\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hi everyone! Our next book will be Hum by Helen Phillips, it was the winner of the Climate Fiction Prize in 2026 and explores themes of AI & Surveillance alongside the climate crisis.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About hum\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"In a city addled by climate change and populated by intelligent robots called “hums,” May loses her job to artificial intelligence. In a desperate bid to resolve her family’s debt and secure their future for another few months, she becomes a guinea pig in an experiment that alters her face so it cannot be recognized by surveillance.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Seeking some reprieve from her recent hardships and from her family’s addiction to their devices, she splurges on passes that allow them three nights’ respite inside the Botanical Garden: a rare green refuge where forests, streams, and animals flourish. But her insistence that her son, daughter, and husband leave their devices at home proves far more fraught than she anticipated, and the lush beauty of the Botanical Garden is not the balm she hoped it would be. When her children come under threat, May is forced to put her trust in a hum of uncertain motives as she works to restore the life of her family.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Written in taut, urgent prose, \",\"type\":\"text\"},{\"text\":\"Hum\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is a work of speculative fiction that unflinchingly explores marriage, motherhood, and selfhood in a world compromised by global warming and dizzying technological advancement, a world of both dystopian and utopian possibilities. As \",\"type\":\"text\"},{\"text\":\"New York Times\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" bestselling author Jeff VanderMeer says, “Helen Phillips, in typical bravura fashion, has found a way to make visible uncomfortable truths about our present by interrogating the near-future.”\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"8p8rub3n\",\"label\":\"can we add you to the hothouse mailing list so we can keep you updated on future events?\",\"required\":false,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
