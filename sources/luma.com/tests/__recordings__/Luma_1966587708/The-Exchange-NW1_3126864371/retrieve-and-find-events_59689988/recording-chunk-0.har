01fc4a.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-ou05KRZc4xQIemZ\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-FKjcgHNuFzjhYAH\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":22,\"num_guests\":22,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#523928\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Take a break from the Welcome Week buzz and join us for a relaxed afternoon of creativity, conversation and connection at LSE Generate.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drop into the GenDen to try a range of simple crafts, unwind with fellow students, and enjoy a calm, welcoming space away from the crowds. Whether you're looking to meet new people, de-stress before term starts, or simply get creative for a while, you're welcome to stay for five minutes or the whole session.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You'll also have the chance to learn more about LSE Generate, our coworking space, and the events, funding, mentoring and opportunities available to aspiring founders and changemakers throughout the year.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No experience needed, all materials provided, and everyone is welcome.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"gn4mgdv0\",\"label\":\"What is your relationship with LSE?\",\"options\":[\"Student\",\"Alumni\",\"Staff\",\"External\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"cbhvvcuy\",\"label\":\"What level of qualification are you studying or did you study at LSE?\",\"options\":[\"Undergraduate\",\"Masters\",\"PhD\",\"Other\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"ssyr77sv\",\"label\":\"What was the name of your course? (i.e. BSc Economics, PhD Sociology). If you didn't study at LSE, please share the most relevant programme or course (i.e. NYU in London, TRIUM MBA)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"hait2s4w\",\"label\":\"What year will you graduate or did you graduate?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"85x4tpdc\",\"label\":\"What is the name of your company and what does it do?\",\"required\":true,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
