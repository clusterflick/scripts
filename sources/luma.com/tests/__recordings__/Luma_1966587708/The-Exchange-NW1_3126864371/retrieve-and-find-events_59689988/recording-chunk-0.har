user_api_id\":\"usr-PuBXbeMmRM20l42\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"The Handbag Factory - ASC | A home for creative minds | Coworking & Gallery Spaces in London\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJd0TCEpMEdkgRZVq6RZTDYGY\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"The Handbag Factory - ASC | A home for creative minds | Coworking & Gallery Spaces in London\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"The Handbag Factory - ASC | A home for creative minds | Coworking & Gallery Spaces in London, 3 Loughborough St, London SE11 5RB, UK\",\"region_short\":\"England\",\"short_address\":\"The Handbag Factory, 3 Loughborough St, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"The Handbag Factory - ASC | A home for creative minds | Coworking & Gallery Spaces in London, 3 Loughborough St, London SE11 5RB, UK\",\"region_short\":\"England\",\"short_address\":\"The Handbag Factory, 3 Loughborough St, London\",\"place_coordinate\":{\"latitude\":51.487285,\"longitude\":-0.11524699999999999},\"apple_maps_place_id\":\"IFE2D36D89CA54DE7\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.11524699999999999,\"latitude\":51.487285},\"waitlist_enabled\":false,\"waitlist_status\":\"disabled\"},\"start_at\":\"2026-10-15T16:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-fctiW6vD1BlPT5s\",\"avatar_url\":\"https://images.lumacdn.com/uploads/xd/0902674c-72e7-42a6-8502-2f85e734e3ae.png\",\"bio_short\":null,\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"artefundacja\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Arte Fundacja\",\"tiktok_handle\":null,\"timezone\":\"Europe/Warsaw\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#dfbdb9\",\"#fdfcfc\",\"#312722\",\"#9f8869\"],\"palette\":{\"neutral\":[{\"color\":\"#312722\",\"percentage\":10.46},{\"color\":\"#fdfcfc\",\"percentage\":13.51},{\"color\":\"#dfbdb9\",\"percentage\":31.87}],\"vibrant\":[{\"color\":\"#9f8869\",\"percentage\":2.41}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/gr/24d1a49a-3602-4893-9733-60756c9abbe6.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-RB2Wbkd0bkncUfg\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-amdz0YwcXwzfGLh\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":22,\"num_guests\":22,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#dfbeb9\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 \",\"type\":\"text\"},{\"text\":\"Otwarcie: 15 października 2026, godz. 17:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"🖼️ \",\"type\":\"text\"},{\"text\":\"Wystawa czynna do 27 października 2026\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Gallery Two, The Handbag Factory\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"3 Loughborough Street\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"London SE11 5RB\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🇵🇱 \",\"type\":\"text\"},{\"text\":\"O wystawie\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Zapraszamy na wystawę Mateusza Szabłowskiego — młodego polskiego artysty tworzącego w obszarze malarstwa, rzeźby, maski i litografii.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"W centrum jego praktyki artystycznej znajduje się własny wizerunek, wykorzystywany jako podstawowe narzędzie twórcze. Autoportret nie jest dla Szabłowskiego statycznym przedstawieniem, lecz dynamicznym procesem — intymną i performatywną praktyką nieustannego oddalania się od siebie i powracania ku sobie. W ten sposób artysta bada płynność oraz wielowymiarowy charakter tożsamości.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Prace Mateusza Szabłowskiego będzie można oglądać od 15 do 27 października 2026 roku w Gallery Two, The Handbag Factory.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"—\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🇬🇧 \",\"type\":\"text\"},{\"text\":\"About the exhibition\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We invite you to discover the work of Mateusz Szabłowski, an emerging Polish artist whose practice spans painting, sculpture, mask-making and lithography.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"At the heart of his work is the artist’s own image, which he uses as a primary creative tool. For Szabłowski, the self-portrait is not a static representation but a dynamic process—an intimate and performative practice of repeatedly moving away from and returning to oneself. Through this process, he explores the fluid and multidimensional nature of identity.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The exhibition will be on view from 15 to 27 October 2026 at Gallery Two, The Handbag Factory.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
