theme\":\"confetti-dark\"},\"tint_color\":\"#fec8f1\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"google\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/0h/6147184c-81f0-4a15-b066-d61fe5c1eec9.jpg\",\"width\":1080,\"height\":1350,\"image_id\":\"local-upload-blob:https://luma.com/e1f3aeee-c687-4714-8b95-7a11edbe0391\",\"mime_type\":null,\"uploaded_at\":\"2026-09-03T17:47:50.455+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/os/cdf33a8b-9d91-4838-8384-6acd3aa35d66.jpg\",\"width\":1170,\"height\":686,\"image_id\":\"local-upload-blob:https://luma.com/004a3f20-0271-4b6b-8d97-da55dac2dba2\",\"mime_type\":null,\"uploaded_at\":\"2026-02-25T16:20:20.209+00:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/7n/00b28431-2334-46a0-9b1e-c4768f41ced6.jpg\",\"width\":1170,\"height\":1064,\"image_id\":\"local-upload-blob:https://luma.com/96d854e0-080e-4ce1-a6db-64fdb60097ea\",\"mime_type\":null,\"uploaded_at\":\"2026-02-25T16:21:06.665+00:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/tx/ce02ff2b-7434-45f2-906d-87a8de4bd2bc.jpg\",\"width\":1170,\"height\":1085,\"image_id\":\"local-upload-blob:https://luma.com/29ae10c1-7538-42ec-96e3-4bdbad675c64\",\"mime_type\":null,\"uploaded_at\":\"2026-02-25T16:24:25.109+00:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/8p/91de933e-d061-4351-b476-5468cc96007d.jpg\",\"width\":1440,\"height\":1440,\"image_id\":\"local-upload-blob:https://luma.com/cdd249d4-33d9-4f60-80d2-c78ef8ea33d9\",\"mime_type\":null,\"uploaded_at\":\"2026-02-25T17:07:31.306+00:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Saturday 24th October 2026 | The Ministry, London SE1 1DN | \",\"type\":\"text\"},{\"text\":\"6.45PM\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://6.PM\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"October is looming and every Black History Month in the UK, we get reminded of the things we’ve overcome, the people who came before us, the battles that have been fought and the work that still needs to be done.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"And all of that matters, but we are \",\"type\":\"text\"},{\"text\":\"TIYAD!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"… Because when do we get to just..be…happy? As Black people, when do we get to celebrate ourselves without having to attach it to an achievement, a struggle, a campaign or something we’ve had to overcome?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As part of Black History Month: \",\"type\":\"text\"},{\"text\":\"The Black Joy Experience\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" we wanted to create a space that feels specifically for us, a place just…BE.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expect:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎤 Honest conversations\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Real, open panel discussions exploring joy, happiness, identity, community and what it means to create more space for joy in our lives.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🙋🏾‍♀️ Live audience Q&A\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Because this isn't just about listening. You'll have the opportunity to join the conversation and share your own perspective.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🧸 Tapping Into Play with Dionne Reid\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"A playful, interactive workshop designed to help us reconnect with something many of us lose as we get older: \",\"type\":\"text\"},{\"text\":\"the freedom to play.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎬 A celebration of Black Joy on screen\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"A short film showcasing Black creativity, happiness and the many ways joy can look and feel.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎶 Music + after-vibes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Because no experience about Black Joy should end with everyone politely going home. We'll turn the music up and give you space to dance, connect and properly end the night\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No marching, no campaigning, no advocating just a beautiful night to explore the many expressions of our unique joy and learn how to tap back into it.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"wdgnj2bg\",\"label\":\"What does BLACK JOY mean to you?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"v9k1wvpp\",\"label\":\"Can we give you a shout out online? (Share your social handle)\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"6z61vobu\",\"label\":\"I, consent to photographs and video footage being used by The Sitdown UK for promotional and reporting purposes?📷 🎬\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"fhika2io\",\"label\":\"Do you have any accessibility requirements? Please share below how we can best support you:\",\"options\":[\"Audio\",\"Visual\",\"Mobility\",\"Communication Support\",\"Neurodiversity\",\"None\"],\"required\":false,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
