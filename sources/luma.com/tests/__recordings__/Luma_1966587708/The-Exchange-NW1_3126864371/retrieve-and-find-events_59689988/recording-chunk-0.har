:10},{\"color\":\"#cc8a5b\",\"percentage\":2.46}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/9t/fa5d03aa-6c69-46f2-92c2-99b6c1d003fb.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-tAuVvHJtvpS3QQY\",\"cents\":2000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-vWw6BAX9ps4kHeP\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":2000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":20,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#9e1806\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"COMMONPLACE is a series of intimate evenings hosted by William Rayfet Hunter, bringing together writers and guests around a shared theme, a shared table and a shared meal.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For this edition, we gather around the table to explore TASTE through writing, food and conversation.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What does it mean to have taste?\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Taste is appetite and instinct, pleasure and disgust. We have taste in food, music, art, clothes, places, and people. We make judgements about what is beautiful, vulgar, desirable, excessive or worth wanting. Taste can be intimate and instinctive, but it’s also shaped by culture, class, fashion and the people around us.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Across the evening, a selection of writers will respond to the theme through readings and reflections, accompanied by a meal designed to be shared. As ever, COMMONPLACE sits somewhere between a literary event and a dinner party: a space to listen, eat, talk and think together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This ticket guarantees you a seat at the table.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dinner is a set menu, served family style, priced at £50* per person.  A full bar is available on the night, drinks will be added to your bill.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"*A 15% discretionary service charge will be added to your bill\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Wednesday 28th October | 6:30pm | Bistrotheque\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Writers to be announced.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"6yQKMspK\",\"label\":\"Do you have any dietary requirements?\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
