alse,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"falling-leaves\"},\"tint_color\":\"#F8712B\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Celebrate Latin American Heritage Month with an afternoon of community, culture, and connection.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join Latin American entrepreneurs, founders, community members, and allies for networking, conversation, cultural exchange, and celebration. Nuna Peru will share a curated cultural showcase of Peruvian ancestral crafts and textiles, alongside artisan stories.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hosted by:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Nuna Peru, Kasa Cafe, BuildHer Labs, and Latin Americans Rising\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"What to Expect\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Coffee, networking, and community connection\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A welcome from the partner organisations\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A conversation on Latin American heritage, community, and entrepreneurship\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Peruvian crafts, textiles, and artisan stories from Nuna Peru\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Kasa Cafe anniversary celebration\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photos, social content, and closing connection time\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Schedule\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"10:30–11:00am\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Guest arrival, registration, coffee & networking\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"11:00–11:15am\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Welcome and introduction\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"11:15–11:30am\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Latin American Heritage Month, community & entrepreneurship\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"11:30am–12:30pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Peruvian cultural showcase: crafts, textiles & artisan stories\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"12:30–1:00pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Open networking and community engagement\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"1:00–1:20pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Kasa Cafe anniversary celebration and closing remarks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"1:20–1:30pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" — Final photos, social content & closing\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_question