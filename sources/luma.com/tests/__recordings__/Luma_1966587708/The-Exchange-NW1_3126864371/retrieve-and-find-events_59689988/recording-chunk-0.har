e/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":6,\"ticket_count\":6,\"hosts\":[{\"api_id\":\"usr-7e5iXD3pbbnoRMi\",\"avatar_url\":\"https://images.lumacdn.com/avatars/f8/009cc690-bd7e-4432-a3df-a28bf725d88d.jpg\",\"bio_short\":\"curating conversations and gatherings for women around the world.\",\"first_name\":\"Teresa\",\"last_name\":\"Wang\",\"instagram_handle\":\"ter3saw\",\"is_verified\":false,\"linkedin_handle\":\"/in/terwytesa17\",\"name\":\"Teresa Wang\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"teresaaa\",\"website\":\"https://foundhersglobal.com\",\"youtube_handle\":null},{\"api_id\":\"usr-7F4xy6tdKDmFvbH\",\"avatar_url\":\"https://images.lumacdn.com/avatars/86/f90bae4a-5b28-48f3-bffa-63050c50cb6e.jpg\",\"bio_short\":\"\",\"first_name\":\"Diyora\",\"last_name\":\"Islamova\",\"instagram_handle\":\"diyoraislam0va\",\"is_verified\":false,\"linkedin_handle\":\"/in/diyora-islamova-456273259\",\"name\":\"Diyora\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f4ece2\",\"#ced0b6\",\"#45423f\",\"#bd72b5\"],\"palette\":{\"neutral\":[{\"color\":\"#45423f\",\"percentage\":3.45},{\"color\":\"#f4ece2\",\"percentage\":35.37},{\"color\":\"#ced0b6\",\"percentage\":20.9}],\"vibrant\":[{\"color\":\"#bd72b5\",\"percentage\":0.93},{\"color\":\"#bb8844\",\"percentage\":0.98},{\"color\":\"#ac6257\",\"percentage\":1.77}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/ic/bd213f5f-7291-49bd-9d24-f4b5b1df8f26.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-chTtH0j8xD6g8Ss\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-baOCQAqseqEHL2Q\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":6,\"num_guests\":6,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f4ece2\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome to another highly requested session of Audacity Lab!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"‎Open this link to join the official FoundHers Audacity Lab WhatsApp Group: \",\"type\":\"text\"},{\"text\":\"https://chat.whatsapp.com/C3BSKNZKJ5C6XqCCOSkNh8?s=sh&p=i&ilr=4\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/C3BSKNZKJ5C6XqCCOSkNh8?s=sh&p=i&ilr=4\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re continuing with the same format: playful, low-pressure, and genuinely useful. If you’ve been to our session, you know the drill but expect some variation in the games and exercises you’ll do :D\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What if boldness was something you could practice?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This session uses improv to help women in business, tech, and startups build confidence, speak up faster, and stop second-guessing themselves — all essential skills for public speaking, pitching, and everyday communication.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to expect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A fun, low-stakes session of improv exercises led by our improv coach Diyora.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Think quick games, pair work, and a lot of laughter - all with a very real professional payoff.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No scripts. No slides. Just you, your instincts, and a room full of women done playing small.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About our workshop host: Diyora\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I used to dread presentations. Not because I didn’t know my material, but because I’d built the moment up so much in my head that I could never just be myself in the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The fix came from an unexpected place: improv. Learning to get comfortable with being uncomfortable changed how I show up completely and I want that for other women too.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I’m partnering with FoundHers to bring this to women who are done waiting to feel “ready” before taking up space. This is a safe place to practice being bold.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You’ll leave with:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The ability to back yourself in the room, even when you don’t feel ready\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A “yes, and” mindset that helps you respond more naturally under pressure\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Stronger instincts for pitching, presenting, and holding conversations\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A room of brilliant women who just did something a little brave together\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re keeping the group small enough for everyone to actively participate! If you’ve been wanting to get more comfortable speaking up, this is a good place to start.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
