d_start_at\":\"2026-05-06T11:00:00.000Z\",\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":30,\"is_disabled\":false},{\"api_id\":\"ttype-gePPTYOv9cCxbjH\",\"cents\":1000,\"currency\":\"gbp\",\"description\":\"Entry plus a screen-printed canvas OAS tote bag. See a team member in a pink high-vis on the day to collect!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-g87yjR4OBF79lVl\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":30,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"98\",\"name\":\"Entry + OAS Canvas Tote\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":\"2026-05-06T11:00:00.000Z\",\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":30,\"is_disabled\":false},{\"api_id\":\"ttype-4zuS8WtU6wf21uB\",\"cents\":400,\"currency\":\"gbp\",\"description\":\"Open Art Spaces is a social enterprise. Donations help us create even better experiences for artists and visitors alike.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-g87yjR4OBF79lVl\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"99\",\"name\":\"Entry + Donation\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":1200,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#1399dc\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Chelsea Art Market\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/reels/DO3NudwAlY-/\"}},{\"type\":\"bold\"}]},{\"text\":\" Returns for Chelsea Arts festival \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Sunday, November 22 | 11am–4pm | Duke of York Square, Chelsea\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Set in the heart of Chelsea, this festive edition of Chelsea Art Market hosts a celebration of independent artists, makers, and creative communities.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Presented in partnership with Cadogan, the Square will once again transform into an open-air art market, featuring a curated selection of works alongside accessible, thoughtfully priced pieces. Across painting, sculpture, printmaking, photography, and illustration, over 50 artists will showcase a curated range of contemporary work.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Visitors can expect artworks from £5 to £500, creating an inclusive environment that welcomes both first-time buyers and established collectors.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Since its launch in 2022, the Open Art Market has grown into a key platform for emerging and grassroots talent, supporting hundreds of artists, many at the start of their exhibiting journeys, while continuing to champion accessible art in public space. The Chelsea edition builds on this ethos, while reflecting the area’s long-standing cultural heritage and connection to the arts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Throughout the day, visitors are invited to explore artist stalls, take part in creative workshops, and enjoy live musical performances across the Square.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to expect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"● A curated line-up of 35+ independent artists\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"● Original artworks available from £5–£500\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"● Artist-led conversations\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"● Hands-on workshops\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"● Live music throughout the day\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether discovering new artists or simply spending an afternoon in Chelsea, Chelsea Art Market offers a welcoming, thoughtfully curated experience in one of London’s most iconic neighbourhoods.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event details:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🗓 Sunday 22 November\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"⏰ 11am-4pm\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Duke of York Square, Chelsea\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://maps.app.goo.gl/jNwdL1D8gNVhccdQ9\"}},{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"🚇 5 minute walk from Sloane Square Station\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"----\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👋 instagram \",\"type\":\"text\"},{\"text\":\"@openartspaces\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/openartspaces/?utm_source=luma\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📱 tiktok \",\"type\":\"text\"},{\"text\":\"@openartspaces\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.tiktok.com/@openartspaces?utm_source=luma\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🌍 website \",\"type\":\"text\"},{\"text\":\"openartspaces.co.uk\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://openartspaces.co.uk\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📧 sign-up to our \",\"type\":\"text\"},{\"text\":\"newsletter\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://openartspaces.substack.com/?utm_source=luma\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"0aax76u3\",\"label\":\"Postcode:\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"fye86o40\",\"label\":\"Age:\",\"options\":[\"Under 18\",\"18–24\",\"25–34\",\"35–44\",\"45–54\",\"55–64\",\"65+\"],\"required\":false,\"question_type\":\"dropdown\"},{\"id\":\"6q8s3e1s\",\"label\":\"Which best describes your relationship with Chelsea?\",\"options\":[\"I work locally\",\"I live locally\",\"This is my first time visiting\",\"I visit regularly\",\"I came for the Market\"],\"required\":false,\"question_type\":\"multi-select\"},{\"id\":\"zj1adw7d\",\"label\":\"How did you hear about us?\",\"options\":[\"Open Art Spaces instagram\",\"Open Art Spaces Newsletter\",\"Open Art Spaces Tiktok\",\"In Chelsea London Instagram\",\"I've been before\",\"I've joined an Open Art Market before\",\"I know someone trading\",\"Other\"],\"required\":false,\"question_type\":\"dropdown\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
