-7GCCGnquea7KGAv\",\"calendar_api_id\":\"cal-9BC46CcbhZPajam\",\"cover_url\":\"https://images.lumacdn.com/uploads/62/da165ae6-83c1-48f8-bd9b-49e231db63af.png\",\"end_at\":\"2026-10-01T08:45:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"KQ Private View | Londoners on Trial at The London Archives\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/68/c6a2f633-794a-442a-af23-eb7308bcc645.png\",\"start_at\":\"2026-10-01T08:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"k3o931vz\",\"user_api_id\":\"usr-85CkdE9yMtN3ZMk\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"The London Archives\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJec7AjE8bdkgRY0XjMJAM9Yk\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"The London Archives\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"The London Archives, 40 Northampton Rd, London EC1R 0HB, UK\",\"region_short\":\"England\",\"short_address\":\"Bowling Green Lane, 40 Northampton Rd, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"The London Archives, 40 Northampton Rd, London EC1R 0HB, UK\",\"region_short\":\"England\",\"short_address\":\"Bowling Green Lane, 40 Northampton Rd, London\",\"place_coordinate\":{\"latitude\":51.525371199999995,\"longitude\":-0.1074675},\"apple_maps_place_id\":\"IDA3CFEF09ABAF2F6\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.1074675,\"latitude\":51.525371199999995},\"waitlist_enabled\":true,\"waitlist_status\":\"active\"},\"start_at\":\"2026-10-01T08:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-85CkdE9yMtN3ZMk\",\"avatar_url\":\"https://images.lumacdn.com/avatars/70/c7bd8ba6-70f8-4882-a061-76faad9aaf92\",\"bio_short\":\"\",\"first_name\":\"Knowledge\",\"last_name\":\"Quarter\",\"instagram_handle\":\"knowledgequarter\",\"is_verified\":false,\"linkedin_handle\":\"/company/knowledge-quarter\",\"name\":\"Knowledge Quarter\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"kqlondon\",\"website\":\"https://knowledgequarter.london\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#51544d\",\"#0f0f12\",\"#df027e\",\"#fefefe\"],\"palette\":{\"neutral\":[{\"color\":\"#0f0f12\",\"percentage\":14.15},{\"color\":\"#fefefe\",\"percentage\":4.2},{\"color\":\"#51544d\",\"percentage\":15.64}],\"vibrant\":[{\"color\":\"#df027e\",\"percentage\":8.45}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/68/c6a2f633-794a-442a-af23-eb7308bcc645.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-5jii7ewK3MPnlC6\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-7GCCGnquea7KGAv\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":25,\"num_guests\":25,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-xlOFIk7jlaEgnbx\",\"cents\":null,\"currency\":null,\"description\":\"Please register with your staff email to validate your registration.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-7GCCGnquea7KGAv\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"KQ Member Ticket\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#131517\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"True crime didn't start with Netflix. Londoners have been gripped by courtroom drama for centuries, queuing for the latest scandalous broadside, packing public galleries, even staging mock trials in taverns for a night's entertainment.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join one of the curators of \",\"type\":\"text\"},{\"text\":\"Londoners on Trial\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" for an hour inside The London Archives' new exhibition, drawn from court records that span almost 1,000 years of London life. You'll get behind the glass cases to hear the stories that didn't make the headlines, and the ones that very much did.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It's also a chance to look at who the courts protected and who they punished, from the trial of Oscar Wilde to the communities routinely criminalised for stepping outside the norms of their day.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Key Details:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Date: Wednesday 1 October\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Time: 09:00 - 09:45\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location: The London Archives, 40 Northampton Road London EC1R 0HB\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About the Knowledge Quarter\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Knowledge Quarter is an innovation district at the heart of King’s Cross, bringing together world‑leading research institutes, cultural organisations, community groups and cutting‑edge businesses within a one‑mile radius.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Partners include the British Library, the British Museum, Central Saint Martins, Google DeepMind, the Institute of Physics, UCL and Wellcome, all united by a commitment to creating and sharing knowledge.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Knowledge Quarter connects these institutions to drive collaboration, showcase collective strengths and ensure local residents can access and benefit from the district’s resources.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Stay in the loop\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Instagram\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://instagram.com/knowledgequarter\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"LinkedIn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://linkedin.com/company/knowledgequarter\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Subscribe to our newsletter\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://gbr01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fknowledgequarter.createsend.com%2Fh%2Ft%2F8E7ABB84DA6BDB3A%2Fpreview%2F638769652074818623&data=05%7C02%7CLucy.Young%40knowledgequarter.london%7C246502b17f7e4851489408de70985322%7Cee0e2644f2714f28b73c325b6f259af9%7C0%7C0%7C639071996686630559%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=FS3Emw4LyGqqMl4MG0tb1Z0Kt557VsVZcPnA2AvtwvQ%3D&reserved=0\"}}]}]}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"k24xy7el\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"addb28hv\",\"label\":\"How did you hear about this event?\",\"options\":[\"KQ Newsletter\",\"Instagram\",\"Through your Employer\",\"Google Search\",\"Through a Friend/Colleague\",\"Don't Know\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"oosvrfkq\",\"label\":\"By ticking this box, I understand photographs will be taken at the event.\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"xwqch7ah\",\"label\":\"I would like to join Knowledge Quarter's mailing list and receive updates on upcoming events and news about the area. I agree to have my Knowledge Quarter newsletter subscriber activity tracked to improve the quality of content I receive. I agree to Knowledge Quarter's privacy policy and understand I can unsubscribe at any time.\",\"required\":false,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
