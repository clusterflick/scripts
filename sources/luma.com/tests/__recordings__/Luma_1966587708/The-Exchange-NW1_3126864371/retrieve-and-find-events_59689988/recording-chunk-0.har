\":\"https://images.lumacdn.com/uploads/0w/210deed2-3b7f-4a5c-997c-ce182076548a.png\",\"bio_short\":null,\"first_name\":\"Abiola\",\"last_name\":\"Kareem\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Seventh\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"seventhstores\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f7f8f6\",\"#212121\",\"#1e25d9\"],\"palette\":{\"neutral\":[{\"color\":\"#212121\",\"percentage\":2.76},{\"color\":\"#f7f8f6\",\"percentage\":81.16}],\"vibrant\":[{\"color\":\"#1e25d9\",\"percentage\":0.33}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/d1/8491b40e-b8bf-43ce-8dda-1b16096d526f.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-aCdEFESdnvKtEIf\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-KazJWspt6mbLI1y\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":100,\"num_guests\":100,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f7f7f5\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-mode\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"What does it take to build a creative practice that lasts? An intimate evening of honest conversation at Soho House White City.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"I Am Because We Are is a three-part series from Seventh, in collaboration with Soho House White City. It started as a short film we released with film director Jamal Berger. The idea behind it was simple. None of us is an island. We are where we are because of the people who invested their time, their effort and their belief in us. So we've tapped into our community and our network to bring that idea into the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We start with craft.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Built to Last\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our first conversation asks one question: what does it take to build a creative practice that lasts? Not just to launch, but to sustain it when the noise is loud and the pressure is high.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hosted by cultural curator Kazeem Kuteyi, founder of New Currency, joined by:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Daniel Bailey\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", the mind behind MRBAILEY and CONCEPT(K)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Kacion Mayers\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", Editorial Director of LOVE and former Editorial Director of Dazed\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tawanda Chiweshe\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", co-founder of YY\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Shay Latukolan\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", choreographer and director (Jungle, Tyla, Rosalía)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Supporting Kinetika Bloco\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Donations from the evening go to Kinetika Bloco, a youth music charity opening doors for the next generation.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
