            "text": "{\"api_id\":\"evt-4kVRVv5AnZ4xdjF\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-gbmxjEvMhFCz5uY\",\"avatar_url\":\"https://images.lumacdn.com/uploads/q5/e6051aeb-5f38-4433-80d2-99650cffd353.jpg\",\"coordinate\":{\"longitude\":-0.127586,\"latitude\":51.507218},\"cover_image_url\":\"https://images.lumacdn.com/uploads/20/e732c8e1-71ed-4dc6-b48e-563ec66aeb9e.jpg\",\"description_short\":\"Blue Earth is a movement of people on a mission to transform the way the world works. Where innovation meets investment to build a better future for people and planet.\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"blueearthsummit\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":\"/company/blue-earth-summit\",\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJdd4hrwug2EcRmSrV3Vo6llI\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"plus\",\"luma_plus_active\":true,\"meta_pixel_id\":null,\"name\":\"Blue Earth\",\"personal_user_api_id\":null,\"refund_policy\":null,\"slug\":\"blueearth\",\"social_image_url\":\"https://images.lumacdn.com/uploads/2h/09ffd131-d76b-4629-bacb-6753ede2387c.png\",\"start_date\":null,\"stripe_account_id\":\"acct_1S94xkGbghcAdvcU\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#03060d\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":\"blueearthsummit\",\"verified_at\":\"2025-05-15T12:18:09.771Z\",\"website\":\"https://blueearthsummit.com/\",\"youtube_handle\":\"blueearthsummit\",\"is_personal\":false,\"personal_user\":null,\"timezone\":\"Europe/London\",\"charges_enabled\":true,\"payment_methods\":[]},\"meta_pixel_id\":null,\"coupon\":null,\"google_measurement_id\":null,\"stripe_account_id\":\"acct_1S94xkGbghcAdvcU\",\"payment_methods\":[],\"tax_config\":null,\"event\":{\"api_id\":\"evt-4kVRVv5AnZ4xdjF\",\"calendar_api_id\":\"cal-gbmxjEvMhFCz5uY\",\"cover_url\":\"https://images.lumacdn.com/uploads/y3/ff6d5cd6-fe4a-4dc8-b3e8-99b453d81c7d.jpg\",\"end_at\":\"2026-10-14T19:30:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"Rivers 2040 Launch: Film Premiere & Panel Discussion\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/3l/234397e3-b2de-4a15-811b-442d666412d9.png\",\"start_at\":\"2026-10-14T16:30:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"blueearth-o7gn\",\"user_api_id\":\"usr-bFNtVqOfdFZjIGM\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Woolwich Works\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJl59uORKp2EcRJlF3jMlRBU8\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"Woolwich Works\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":\"Royal Arsenal\",\"full_address\":\"Woolwich Works, The Fireworks Factory, 11 No 1 St, Royal Arsenal, London SE18 6HD, UK\",\"region_short\":\"England\",\"short_address\":\"The Fireworks Factory, 11 No 1 St, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"The \\\"Sessions\\\" stage, enter through the main entrance, and after registration take the stairs to your right.\",\"sublocality\":\"Royal Arsenal\",\"country_code\":\"GB\",\"full_address\":\"Woolwich Works, The Fireworks Factory, 11 No 1 St, Royal Arsenal, London SE18 6HD, UK\",\"region_short\":\"England\",\"short_address\":\"The Fireworks Factory, 11 No 1 St, London\",\"place_coordinate\":{\"latitude\":51.4943775,\"longitude\":0.0700396},\"apple_maps_place_id\":\"ICA6AF04FD5732964\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":0.0700396,\"latitude\":51.4943775},\"waitlist_enabled\":false,\"waitlist_status\":\"disabled\"},\"start_at\":\"2026-10-14T16:30:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-DMn2krKR20ka4qa\",\"avatar_url\":\"https://images.lumacdn.com/uploads/wc/9b5d28d3-b273-4305-9fbf-b1a9d2fa2ab8.png\",\"bio_short\":\"The Wildlife Trusts is a movement of 46 local Wildlife Trusts and a central charity working for a thriving natural world.\",\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"thewildlifetrusts\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"The Wildlife Trusts\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"wildlifetrusts\",\"website\":null,\"youtube_handle\":\"TheWildlifeTrusts\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#060709\",\"#6b48cb\",\"#08b5cf\",\"#fafafa\"],\"palette\":{\"neutral\":[{\"color\":\"#060709\",\"percentage\":27.84},{\"color\":\"#fafafa\",\"percentage\":4.41}],\"vibrant\":[{\"color\":\"#6b48cb\",\"percentage\":6.74},{\"color\":\"#08b5cf\",\"percentage\":4.65}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/3l/234397e3-b2de-4a15-811b-442d666412d9.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-lCciR9vVPufSQ2Q\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-4kVRVv5AnZ4xdjF\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":62,\"num_guests\":62,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-climate\",\"description\":\"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.\",\"event_count\":1574,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png\",\"name\":\"Climate\",\"page_title\":\"Climate Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png\",\"slug\":\"climate\",\"social_image_url\":\"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":188,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Dreamy\",\"type\":\"shader\",\"theme\":\"shader-dark\",\"color1\":\"#0015e6\",\"color2\":\"#2c00e6\",\"color3\":\"#00a8e6\"},\"tint_color\":\"#2c00e6\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"An exclusive short film premiere and the launch of Rivers 2040\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join leaders from business, government and conservation for an evening of film, discussion and action focused on the future of the UK's rivers.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The event will mark the launch of Rivers 2040, an ambitious new vision for river recovery, and feature the exclusive premiere of \",\"type\":\"text\"},{\"text\":\"A River Speaks\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", a powerful new short film from the perspective of a river from source to sea\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Rivers 2040: a new vision for river restoration\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Developed by The Wildlife Trusts, Trent Rivers Trust and Intact Insurance, Rivers 2040 uses the River Trent as a model for what's possible, demonstrating how river restoration can deliver economic, environmental and social benefits while creating healthier ecosystems and more resilient communities.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The evening will conclude with a live panel discussion to explore the actions needed to restore our rivers and secure their future.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Speakers / contributors\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Craig Bennett OBE, CEO, \",\"type\":\"text\"},{\"text\":\"The Wildlife Trusts\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Chris Reid, Senior Vice-President, Strategic Distribution, Marketing, Communications & Corporate Affairs, \",\"type\":\"text\"},{\"text\":\"Intact Insurance\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Oliver Harmer, Chief Officer - Strategy,\",\"type\":\"text\"},{\"text\":\" Natural England\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rachel Bennett, Director of Wilder Landscapes and Wilder Communities, \",\"type\":\"text\"},{\"text\":\"Derbyshire Wildlife Trust\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nicole Still, Riverwoods Project Manager, \",\"type\":\"text\"},{\"text\":\"Scottish Wildlife Trust\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Event Programme\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"17.30 Arrival / networking\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:15 Welcome and introduction\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:25 Film Premiere of \",\"type\":\"text\"},{\"text\":\"A River Speaks\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18.35 Panel discussion including Q&A\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"19.30 Drinks & Canapes\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets by invitation only, you do not require a Blue Earth Summit pass to attend this event.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"8uy8s3q3\",\"label\":\"What Organisation do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"wjngj563\",\"label\":\"What best describes you\",\"options\":[\"Founder\",\"Investor\",\"Corporate\",\"NGO\",\"Third Party\",\"Service Provider\",\"Other\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"viyl5hhf\",\"label\":\"What is the size of your company or organisation?\",\"options\":[\"1–10 employees\",\"11–50 employees\",\"51–250 employees\",\"251–1,000 employees\",\"1,001–5,000 employees\",\"5,000+ employees\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"qar7fkc1\",\"label\":\"How did you hear about the event? (If someone, or a company invited you please reference here)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"0k586bnz\",\"label\":\"Do you have any accessibility requirements or adjustments we should be aware of to help you participate fully in this event?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"wn9q8ij7\",\"label\":\"Do you have any special dietary requirements?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"aiqhf4u2\",\"label\":\"Is there any other information we should know?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"jh8xg01l\",\"label\":\"I wish to receive marketing communications from The Wildlife Trusts by email about its events, activities and services. Data will be processed in accordance with The Wildlife Trusts' Privacy Policy: https://www.wildlifetrusts.org/privacy-policy. Consent can be withdrawn at any time.\",\"required\":false,\"question_type\":\"agree-check\"},{\"id\":\"tsolfayx\",\"label\":\"By registering for this event, you acknowledge that the personal information you provide will be shared with the Royal Society of Wildlife Trusts (RSWT) for the purpose of administering and managing the event. Your personal information will be processed in accordance with RSWT's Privacy Policy, available at: https://www.wildlifetrusts.org/privacy-policy, and applicable data protection legislation.\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[{\"api_id\":\"calmemtier-dac4pb3fnglt06g\",\"access_info\":{\"type\":\"free\",\"require_approval\":true},\"description\":\"\",\"registration_questions\":[],\"calendar_api_id\":\"cal-gbmxjEvMhFCz5uY\",\"tint_color\":\"#146AEB\",\"name\":\"Founding Member\"}],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
