ext\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Danceworks Mayfair\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pineapple Studios (Covent Garden)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Manor House Studios (Camden)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unit 3 (South London – Oval)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📝 How to use:\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Purchase your Membership on our website\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Register for classes using the \",\"type\":\"text\"},{\"text\":\"“Member” ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you need to reschedule, choose the \",\"type\":\"text\"},{\"text\":\"“Free/Make-up Class”\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" option and await team approval\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Show up, dance, and enjoy your credits!\",\"type\":\"text\"}]}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟️ Ticket Examples (Included in Membership):\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"POP-UP Class\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\