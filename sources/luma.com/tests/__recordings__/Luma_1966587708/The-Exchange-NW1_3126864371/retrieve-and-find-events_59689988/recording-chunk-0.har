ges.lumacdn.com/avatars/r8/2b577033-dad1-4221-bbb9-c40f8b1f4f3b.jpg\",\"bio_short\":\"\",\"first_name\":\"Mike\",\"last_name\":\"McClelland\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/mike-mcclelland\",\"name\":\"Mike McClelland\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"mikemcclelland\",\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#0d0f13\",\"#302a3c\",\"#5e5088\",\"#aa94ad\"],\"palette\":{\"neutral\":[{\"color\":\"#0e0f13\",\"percentage\":80.33},{\"color\":\"#cec2d7\",\"percentage\":0.99}],\"vibrant\":[{\"color\":\"#452e53\",\"percentage\":1.15},{\"color\":\"#8966aa\",\"percentage\":0.8}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/m9/5ab059d3-4bdd-482d-8414-a2f5b7343958.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"evtticktyp-jVBcsMqxyEkiXmD\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-nPYSkdfB0Cm4sJK\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"4\",\"name\":\"LVC Member\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"evtticktyp-ZD5attEWtDts9eM\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-nPYSkdfB0Cm4sJK\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Guest\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":42,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#a7b9a0\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"garamond\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"This London Venture Club event brings together successful entrepreneurs, business people and investors for an off-the-record evening exploring collectibles and the role they are beginning to play within private wealth.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Collectibles are moving beyond passion purchases into a more considered component of portfolio construction. From contemporary art to watches, wine and other tangible assets, capital is increasingly being allocated where scarcity, cultural relevance and global demand intersect.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Through candid discussion, we will explore where value is emerging across the collectibles landscape, with a particular focus on art in the lead-up to Frieze London. We’ll look at how the market works in practice — from private sales, dealer networks and auctions to where pricing power sits and how experienced collectors and investors gain access to sought-after opportunities.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is an off-the-record evening for London Venture Club members and invited guests, exploring why collectibles, why now, what is driving demand across categories, and how to approach a market defined as much by relationships and judgement as by data.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your Panel\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sowmya Kotha\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is Global Head of Strategic Lending at Deutsche Bank Private Bank. Based in London, she works with private clients on complex and bespoke financing solutions across a range of asset classes, bringing extensive experience in strategic lending and wealth management.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bojana Popovic\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is Co-Founder of Anarchy Art Club, an exclusive collectors’ circle focused on blue-chip art. Previously a specialist in Christie’s Post-War and Contemporary Art Department, she has also worked with leading galleries and art dealers and now advises collectors on contemporary art acquisitions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Natalie Voorheis\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is Director of Valuations at Bonhams, advising private clients on valuations, collections and strategies for sale. Previously at Christie’s, she brings extensive experience across the auction market and private collections.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Daniel Etherton\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is Founder of Decipher, an independent advisory and arts consultancy operating across art, music, sport and luxury. With over a decade of experience spanning Christie’s, private advisory and cultural strategy, he advises collectors, family offices, brands and institutions on acquisitions, private sales, commissions and cultural projects.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About London Venture Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"London Venture Club is a social learning network for successful entrepreneurs, successful business people and active investors who value insight, trust and personal connection.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We bring together entrepreneurs, exited founders, investors and expert voices for candid, off-the-record conversations on the subjects that matter to people building, investing, scaling, exiting and thinking about what comes next.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"xnr34isk\",\"label\":\"Who invited you to join?\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
