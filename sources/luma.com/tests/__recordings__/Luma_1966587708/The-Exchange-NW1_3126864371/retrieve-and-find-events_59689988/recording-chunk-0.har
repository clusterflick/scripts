\"ticket_types\":[{\"api_id\":\"ttype-KV6Ixf6PvOC5QTo\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-bxyxWVHxIIA30lJ\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":121,\"num_guests\":121,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"calendar\",\"avatar_url\":\"https://images.lumacdn.com/calendars/y0/c311155e-883f-4673-810a-c78e3c3ea6c3.png\",\"name\":\"Breakpoint 2026 Community Events\",\"path\":\"/BP-SideEvents\",\"calendar_api_id\":\"cal-NFEDisEmJoSg0TU\",\"calendar_type\":\"calendar_discover\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-crypto\",\"description\":\"A complete guide to the most important crypto gatherings around the world. Join Ethereum and Solana hackathons, learn about zk and layer-2s, and immerse yourself in the world of web3.\",\"event_count\":917,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/vd/d2237ab2-c9d1-4ae2-8c14-1fd57585adf2.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/yl/096bc517-f9fc-49fe-befd-401e29cc4662.png\",\"name\":\"Crypto\",\"page_title\":\"Crypto Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/6z/da7f11e1-86d8-44b5-8e0a-f8de5211225d.png\",\"slug\":\"crypto\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/968fad94-33c6-4d89-a635-9702bfcacca7.png\",\"subscriber_count\":39411,\"tint_color\":\"#806AD6\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":104,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Lavender\",\"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#ebd9ff\",\"color2\":\"#d4a1f9\",\"color3\":\"#eeb8ff\"},\"tint_color\":\"#d4a1f9\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Render Network and Solana are bringing an immersive art activation to Breakpoint 2026 London at \",\"type\":\"text\"},{\"text\":\"FRAMELESS\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", one of the UK’s most striking immersive art venues.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Get immersed in original works from a curated lineup of world-class 3D artists who have imagined a world where the digital and physical dissolve into one another, and the systems shaping our future bend, blur, and beautifully collide.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Guests will be treated to bespoke immersive 3D art, rendered on the Render Network specifically for immersive galleries at FRAMELESS.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Complimentary cocktails and hors d’oeuvres will be served.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Details:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Date \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"– Monday, November 16, 2026\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Time\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – 7:30-10p\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Venue\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – FRAMELESS\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Address\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – 6 Marble Arch, London, W1H 7AP\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"RSVP required\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – space is limited\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
