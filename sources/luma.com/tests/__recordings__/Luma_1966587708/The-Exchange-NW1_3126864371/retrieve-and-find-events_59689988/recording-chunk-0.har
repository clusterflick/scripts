l,\"username\":\"KindHaus\",\"website\":\"https://www.kindhaus.co.uk/\",\"youtube_handle\":\"\"},{\"api_id\":\"usr-3XEShDQKxONhQ3Z\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_30.png\",\"bio_short\":null,\"first_name\":\"Rebecca\",\"last_name\":\"Harris\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Rebecca Harris\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#4e1f74\",\"#db8f7d\",\"#25678f\",\"#d8bc6a\"],\"palette\":{\"neutral\":[{\"color\":\"#4e1f74\",\"percentage\":15.72}],\"vibrant\":[{\"color\":\"#a95b95\",\"percentage\":6.84},{\"color\":\"#d8bc6a\",\"percentage\":3.96},{\"color\":\"#25678f\",\"percentage\":4.91},{\"color\":\"#db8f7d\",\"percentage\":6.15}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/we/c769c37e-1d1a-45d1-b197-55b256dff819.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-9fRVNNyudLSENDj\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-1SyzPZhsQJQyTkz\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":9,\"num_guests\":9,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"},{\"api_id\":\"cat-family\",\"description\":\"From pregnancy to college applications, find a moms’ walk, summer camp, or tutoring group and meet other families.\",\"event_count\":612,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/q4/1198a595-5920-4eec-bfdb-3bcd63965716.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/aq/f5fbdde4-46a9-4d9e-b730-7144b3c0e335.png\",\"name\":\"Family\",\"page_title\":\"Family Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/01/09874dae-ea3a-499c-8558-f51be7617a1a.png\",\"slug\":\"family\",\"social_image_url\":\"https://images.lumacdn.com/uploads/q6/6073105a-fe9c-4969-acd5-738987a39227.png\",\"subscriber_count\":1014,\"tint_color\":\"#AE6BCF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f5eebe\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for Little Echo - an interactive storytelling adventure- for children and their families.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join author and mum Juliana Ohene-Nyako for an immersive reading of \",\"type\":\"text\"},{\"text\":\"Little Echo,\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" a heartwarming story exploring memory, music and the special bond between a mother and her calf.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Children won’t just listen to the story, they’ll become part of it! Together they’ll sing along with Little Echo, search for missing objects, journey through the rainforest with immersive sounds, and put their own memories to work with a creative drawing challenge at the end. Memory Medals will be won!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Inspired by Juliana’s own experience of rebuilding her memory, \",\"type\":\"text\"},{\"text\":\"Little Echo\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" grew from the idea that memory isn’t simply something we have but also something we do.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About the event:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"While all children are welcome, we envision this event appealing to children aged between 0–5 years. There will be an opportunity for parents to meet Juliana, to hear about her amazing journey to her write this beautiful publication, which you can purchase on the day.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This event is free, but we are happy to receive donations.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Everyone is Welcome!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
