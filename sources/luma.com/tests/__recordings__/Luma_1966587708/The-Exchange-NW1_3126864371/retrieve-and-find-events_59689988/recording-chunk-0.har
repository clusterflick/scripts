kers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#d21127\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📚 BOOKS BETWEEN US 🍂\\nAn Autumn Book Swap for sisters in their 20s\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This October, our little bookshop is opening at JSMCC. 🤎\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bring along a book you’ve read, loved and would happily recommend to someone else, and leave with a new read to enjoy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your book can be fiction, non-fiction, Islamic, personal development, biography, poetry or anything in between — we just ask that it is appropriate for the setting and in good condition.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Alongside our book swap, enjoy a cosy cup of chai, autumn treats, conversation starters and the chance to meet and connect with other people in their 20s.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"How it works:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🍂 Bring one pre-loved book\\n📚 Add it to our Book Swap\\n☕ Grab some chai & treats\\n💬 Meet someone new\\n📖 Choose a new book to take home\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bring a book. Take a book. Make a connection.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"ZdW8LsBp\",\"label\":\"Have you been to JSMCC events before?\",\"options\":[\"Yes\",\"No, my first time!\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"h9gPSRim\",\"label\":\"How old are you?\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
