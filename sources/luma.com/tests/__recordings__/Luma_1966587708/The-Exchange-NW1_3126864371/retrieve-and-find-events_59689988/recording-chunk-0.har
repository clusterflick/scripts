":12,\"hosts\":[{\"api_id\":\"usr-NaxhofUkTXMZ3gv\",\"avatar_url\":\"https://images.lumacdn.com/avatars/bj/4be5d56b-c0e4-4980-bfaf-7272547534a2\",\"bio_short\":null,\"first_name\":\"REDEYE\",\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"REDEYE\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#342221\",\"#222220\"],\"palette\":{\"neutral\":[{\"color\":\"#2d1c1c\",\"percentage\":20.37},{\"color\":\"#3e2a27\",\"percentage\":14.9},{\"color\":\"#222220\",\"percentage\":10.63}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/2a/f9248375-38b7-4646-8ddc-6960818e4993.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-NWGQvvHvCSVVtFF\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-CWXqT1dnSE5b7Jy\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":12,\"num_guests\":12,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":68,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#2d1d1c\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"museo\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The first of five screenings under the theme of human rights on screen, with the thematic question: ‘What does it mean to assert your humanity against systems that deny it?’\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About The Film:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Winner of the Golden Bear at the 2024 Berlinale, Mati Diop’s dynamic, otherworldly energy gives voice to the objects looted by Colonial French forces. Amplifying voices from beyond the walls of international museums, this spellbinding work redefines the spaces of culture and art.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We follow the return of these majestic stolen artefacts as they narrate their journey home. A crucial element of the film lies in the connections Diop makes between this colonial history and present-day African identity.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event format:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"On arrival, audiences encounter a musical response to the film, a playlist commissioned from a musician from a non-Western background. You will also receive a postcard copy of an original artwork created in response to the film.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"After the screening, the discussion is explicitly audience-focused. The film provides context; the audience's perspectives and voices are what enrich our gatherings. Our host moves between small group conversations before opening to the full room, building familiarity and dismantling any perceived hierarchy that typically silences people who don't consider themselves film experts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"There are note lines on the back of the postcards and pens for those who'd like to take notes at any point.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
