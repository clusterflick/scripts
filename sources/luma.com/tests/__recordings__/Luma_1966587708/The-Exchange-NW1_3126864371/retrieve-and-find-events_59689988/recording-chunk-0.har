//camdenist.com\"}}]},{\"text\":\" and historic local community narrowboat \",\"type\":\"text\"},{\"text\":\"Tarporley\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.tarporley-camdencanals.org/\"}}]},{\"text\":\" have teamed up to present a short panel discussion and Q&A, (and even some bubbles afterwards).\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Join a hand-picked panel of creatives and changemakers who will discuss how today’s overbearing AI narratives are helping a quiet resurgence in everything analogue, from print magazines to locally-made fashion markets, cinema events to canal boat businesses.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
