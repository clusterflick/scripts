            "mimeType": "application/json; charset=utf-8",
            "text": "{\"api_id\":\"evt-cpg0oUqN0dTBmw6\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-PEEWAEsjhk29NQl\",\"avatar_url\":\"https://images.lumacdn.com/calendars/nz/fe02d1d1-d706-4361-a959-640169413cfd.png\",\"coordinate\":{\"longitude\":-0.12758619999999998,\"latitude\":51.5072178},\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/fb/d00d2299-55bc-42c7-811f-07857c45cf33.jpg\",\"description_short\":\"It's Culture Innit (ICI) is a welcoming space for gay, bi, trans, and queer men to connect in real life. Founded in London in 2015, it’s now active in Sydney and Berlin.\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"itscultureinnit\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJdd4hrwug2EcRmSrV3Vo6llI\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"free\",\"luma_plus_active\":false,\"meta_pixel_id\":null,\"name\":\"It's Culture Innit - London\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟 Refund Policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets are non-refundable unless:\\n• The event is cancelled\\n• The event does not meet minimum numbers\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"🔁 Need to Sell Your Ticket?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"While we set up the new waitlist system on Luma, you can offer your ticket to another member via the ICI WhatsApp group. \",\"type\":\"text\"},{\"text\":\"https://chat.whatsapp.com/JcFYXAeSki31Y7tzWawlSN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/JcFYXAeSki31Y7tzWawlSN\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If someone agrees to take your ticket:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"\\n• Both parties must confirm the transfer\\n• Email \",\"type\":\"text\"},{\"text\":\"admin@itscultureinnit.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:admin@itscultureinnit.com\"}}]},{\"text\":\" with their name and email\\n• We’ll then open up the event for them to book a ticket\\n• Once they’ve completed the purchase, your ticket will be refunded\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Thank you for your support in helping us keep the process smooth, fair, and manageable for everyone.\",\"type\":\"text\"}]}]},\"slug\":\"itscultureinnit\",\"social_image_url\":\"https://images.lumacdn.com/uploads/xt/7c50196e-75a5-4040-906c-8a426f77b929.jpg\",\"start_date\":null,\"stripe_account_id\":\"acct_1QD1Z9I62BAMbnV9\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#682FFF\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":\"2025-07-09T10:03:13.890Z\",\"website\":\"https://itscultureinnit.com/\",\"youtube_handle\":null,\"is_personal\":false,\"personal_user\":null,\"timezone\":\"Europe/London\",\"charges_enabled\":true,\"payment_methods\":[]},\"meta_pixel_id\":null,\"coupon\":null,\"google_measurement_id\":null,\"stripe_account_id\":\"acct_1QD1Z9I62BAMbnV9\",\"payment_methods\":[],\"tax_config\":null,\"event\":{\"api_id\":\"evt-cpg0oUqN0dTBmw6\",\"calendar_api_id\":\"cal-PEEWAEsjhk29NQl\",\"cover_url\":\"https://images.lumacdn.com/uploads/qz/d98ab15e-487b-447b-acaa-0060de573ed8.png\",\"end_at\":\"2026-10-21T21:30:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"