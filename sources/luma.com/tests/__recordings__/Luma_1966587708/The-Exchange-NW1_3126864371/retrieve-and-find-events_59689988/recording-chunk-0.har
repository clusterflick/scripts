er_api_id\":\"usr-w9thJ6hMS3VyGzt\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"Brooklyn\",\"type\":\"google\",\"region\":\"New York\",\"address\":\"Wythe Hotel\",\"country\":\"United States\",\"place_id\":\"ChIJucbIy0JZwokRvgoW5tnNHM0\",\"localized\":null,\"city_state\":\"Brooklyn, NY\",\"description\":\"\",\"sublocality\":\"Williamsburg\",\"country_code\":\"US\",\"full_address\":\"Wythe Hotel, 80 Wythe Ave, Brooklyn, NY 11249, USA\",\"region_short\":\"NY\",\"short_address\":\"80 Wythe Ave, Brooklyn\",\"place_coordinate\":{\"latitude\":40.7218996,\"longitude\":-73.9580678},\"apple_maps_place_id\":\"I5FC6F5773B597598\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-73.9580678,\"latitude\":40.7218996},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"cover_image\":{\"colors\":[\"#000000\",\"#00ff00\",\"#ffffff\"],\"palette\":{\"neutral\":[{\"color\":\"#000000\",\"percentage\":72.06},{\"color\":\"#ffffff\",\"percentage\":3.31}],\"vibrant\":[{\"color\":\"#00ff00\",\"percentage\":23.51}]}},\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-dWMNt952eh2WWAh\",\"avatar_url\":\"https://images.lumacdn.com/calendars/jy/83bff192-8c20-4561-96b1-4b1c2e83c6b3\",\"coordinate\":{\"longitude\":-74.005973,\"latitude\":40.712775},\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/m5/b95a4878-04b4-44bf-a564-2e4143d257db\",\"description_short\":\"Our community helps you face your climate anxiety, connects you to impactful local organizing, and keeps you motivated through camaraderie, creativity, and fun.\\nwww.climatecafe.eco\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"climatecafe.eco\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":{\"city\":\"New York\",\"region\":null,\"country\":\"United States\",\"place_id\":\"ChIJOwg_06VPwokRYv534QaPC8g\",\"timezone\":\"America/New_York\",\"country_code\":\"US\"},\"luma_plan\":\"plus\",\"luma_plus_active\":true,\"meta_pixel_id\":null,\"name\":\"Climate Cafe NYC\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"As a volunteer-run, crowdfunded community, we are unable to offer refunds for ticket cancellations or no-shows. All sales are final. Many of our events are pay-what-you-wish, and every contribution helps us grow and sustain our community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you can no longer attend an event, please notify us \",\"type\":\"text\"},{\"text\":\"at least 48 hours in advance\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", and we’ll be happy to transfer your ticket to a future event. Otherwise, you are always welcome to gift your ticket to a friend by sharing the QR code with them. Please remember to update your RSVP accordingly so we can maintain an accurate headcount.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For free or discounted ticket prices, please consider \",\"type\":\"text\"},{\"text\":\"becoming a member\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://www.climatecafe.eco/member\"}}]},{\"text\":\". Members also get access to exclusive perks, like secret parties and special events.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Finances are never a barrier to participation in our community. If the ticket price for a paid event poses a significant challenge, please reach out to request a discounted ticket or a subsidized membership.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Thank you for your understanding and continued support. We look forward to seeing you soon! 🌻🌍\",\"type\":\"text\"}]},{\"type\":\"button\",\"attrs\":{\"href\":\"https://www.climatecafe.eco/member\",\"text\":\"Become a member\",\"client_id\":\"button-ri82jy0w9spx9g3\"}},{\"type\":\"paragraph\"}]},\"slug\":\"climatecafe\",\"social_image_url\":\"https://images.lumacdn.com/calendar-cover-images/8l/7b2b7f49-771f-4b2b-a292-33136555bb5c\",\"start_date\":null,\"stripe_account_id\":\"acct_1QfVfLECvcbb6GTD\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#568945\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":\"2025-01-06T18:42:40.881Z\",\"website\":\"https://www.climatecafe.eco\",\"youtube_handle\":null,\"is_personal\":false,\"personal_user\":null,\"timezone\":\"America/New_York\"},\"start_at\":\"2026-09-28T21:00:00.000Z\",\"hosts\":[{\"api_id\":\"usr-JGoMI18EL4UBvT1\",\"avatar_url\":\"https://images.lumacdn.com/avatars/eu/63344fc6-c4d5-4e1c-873d-1ee5b847d540\",\"bio_short\":\"Nonprofit center for climate, community, and culture in New York City.\",\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"climateimaginarium\",\"is_verified\":false,\"linkedin_handle\":\"/company/climate-cafe-nyc\",\"name\":\"Climate Imaginarium\",\"tiktok_handle\":null,\"timezone\":\"America/New_York\",\"twitter_handle\":null,\"username\":\"imaginarium\",\"website\":\"https://www.climateimaginarium.org\",\"youtube_handle\":null},{\"api_id\":\"usr-w9thJ6hMS3VyGzt\",\"avatar_url\":\"https://images.lumacdn.com/avatars/zx/98d11125-fe59-42a5-b039-dda3158942e3\",\"bio_short\":\"The social home of climate action in New York City.\",\"first_name\":\"Climate Cafe\",\"last_name\":\"NYC\",\"instagram_handle\":\"climatecafe.eco\",\"is_verified\":false,\"linkedin_handle\":\"/company/climate-cafe-nyc\",\"name\":\"Climate Cafe NYC\",\"tiktok_handle\":null,\"timezone\":\"America/New_York\",\"twitter_handle\":null,\"username\":\"climatecafe\",\"website\":\"https://www.climatecafe.eco\",\"youtube_handle\":null}],\"guest_count\":40,\"ticket_count\":40,\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"usd\",\"min_cents\":0,\"is_flexible\":true},\"is_f