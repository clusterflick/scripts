ndle\":\"/in/jessica-ajose-33522b135\",\"name\":\"Jessica A\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#272624\",\"#3e3e3d\",\"#a38f6f\",\"#f4f4f4\"],\"palette\":{\"neutral\":[{\"color\":\"#272624\",\"percentage\":26.99},{\"color\":\"#f4f4f4\",\"percentage\":10.52},{\"color\":\"#3e3e3d\",\"percentage\":12.45}],\"vibrant\":[{\"color\":\"#a38f6f\",\"percentage\":12.2},{\"color\":\"#4b7a56\",\"percentage\":4.33}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/cz/f7c32189-05a7-4a0d-b0f8-4e653403fdcf.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-YKs5exiiuENgL4P\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cGbUWfSmX1rNAxv\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":33,\"num_guests\":33,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":12,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#a38f6f\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"To celebrate the release of his EP \",\"type\":\"text\"},{\"text\":\"A Son's Guilt\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", Nolais joins Hard to Explain, Easy to Feel for an evening about what it takes to tell the truth about the people who raised you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rather than a traditional playback session, \",\"type\":\"text\"},{\"text\":\"A Son's Guilt\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" becomes the starting point for a wider conversation about family, forgiveness and the long road between the two.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The project traces a relationship with his father through its hardest moments first: the calling out, the confrontation, the parts of the story most people soften. It's only gradually that the record moves toward something closer to understanding, and eventually, acceptance. Nolais has described these as the most honest songs he's ever released, written without dressing up or sugar coating what he actually felt.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What does it mean to be honest about someone you love and are still angry at? Is calling someone out the opposite of forgiving them, or part of how you get there? And what changes once a private reckoning becomes a record other people can hear themselves in?\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Please note that there is one flight of stairs and unfortunately there are no lifts in this building.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
