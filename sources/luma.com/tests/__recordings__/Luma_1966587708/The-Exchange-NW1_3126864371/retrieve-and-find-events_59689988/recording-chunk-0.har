me\":\"Book Launch: The Displacement Dilemma, Second Edition\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/s0/10857972-8f98-4b60-b79b-cfc0f232195b.png\",\"start_at\":\"2026-10-22T17:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"328ekvvr\",\"user_api_id\":\"usr-cdWUVLWtHiypmhH\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Kingsley Napley LLP\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJmegGdVEbdkgRq77kfUdNS6E\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"Kingsley Napley LLP\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"Kingsley Napley LLP, 20 Bonhill St, London EC2A 4DN, UK\",\"region_short\":\"England\",\"short_address\":\"Tabernacle Court, 20 Bonhill St, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"Kingsley Napley LLP, 20 Bonhill St, London EC2A 4DN, UK\",\"region_short\":\"England\",\"short_address\":\"Tabernacle Court, 20 Bonhill St, London\",\"place_coordinate\":{\"latitude\":51.5228815,\"longitude\":-0.086123},\"apple_maps_place_id\":\"IDECE17F845872EC7\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.086123,\"latitude\":51.5228815},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-10-22T17:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-cdWUVLWtHiypmhH\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_5.png\",\"bio_short\":\"\",\"first_name\":\"Nigel\",\"last_name\":\"Cannings\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/ncannings\",\"name\":\"Nigel Cannings\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f0efea\",\"#1f1e1c\",\"#eb361a\",\"#55709b\"],\"palette\":{\"neutral\":[{\"color\":\"#1f1e1c\",\"percentage\":3.51},{\"color\":\"#f0efea\",\"percentage\":93.12}],\"vibrant\":[{\"color\":\"#eb361a\",\"percentage\":0.14},{\"color\":\"#55709b\",\"percentage\":0.13}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/s0/10857972-8f98-4b60-b79b-cfc0f232195b.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-2xYzIvEgFYqYLHY\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-Lthy1EYBBc3sFM2\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":35,\"num_guests\":35,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-ai\",\"description\":\"Join a hackathon, learn about LLMs and prompt engineering, or connect with other AI practitioners.\",\"event_count\":4171,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png\",\"name\":\"AI\",\"page_title\":\"AI Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png\",\"slug\":\"ai\",\"social_image_url\":\"https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png\",\"subscriber_count\":102003,\"tint_color\":\"#D96D9B\"},{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":65,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f0efea\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"factoria\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Wisdom is just time multiplied by mistakes. AI is removing the chance to make them.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The second edition of The Displacement Dilemma by Nigel Cannings is out, and this is its party.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The first edition was mostly the author talking. This one is built on sixteen other voices: a lawyer, a GP, a radiologist, an architect, a recruiter, a psychotherapist, a designer, a turnaround adviser and others.  Each of them brings a fresh perspective:  None of us can quite agree, which reflects how everyone feels about AI.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drinks from six. At about half-past, one of the hosts will interview the author for twenty minutes or so about why he wrote it and where the voices came from, then you get to ask the awkward questions, then more drinks.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"There will be books, with donations to charity.  There may even be signing.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"With thanks to Kingsley Napley for the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"subbasement.press\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://subbasement.press\"}}]},{\"text\":\" for more details on the book, and an exclusive 4,000 word \\\"AI Cut\\\".\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"c3h8b3jl\",\"label\":\"What is your LinkedIn profile?\",\"required\":true,\"question_type\":\"linkedin\"},{\"id\":\"TjiLKnar\",\"label\":\"If you were referred to the event, where you saw the link (helps the approval process)\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
