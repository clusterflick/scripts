"},{\"api_id\":\"usr-syKYkwK7UEaIsJ2\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_3.png\",\"bio_short\":null,\"first_name\":\"Ishana\",\"last_name\":\"Meadows\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Ishana Meadows\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#403d34\",\"#a2845d\",\"#bdb6ad\",\"#c7b96a\"],\"palette\":{\"neutral\":[{\"color\":\"#403d34\",\"percentage\":10.89},{\"color\":\"#bdb6ad\",\"percentage\":6.7}],\"vibrant\":[{\"color\":\"#a2845d\",\"percentage\":7.2},{\"color\":\"#c7b96a\",\"percentage\":3.24}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/c7/58d1eb80-5b15-4044-aa89-4a769435112f.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-nA2xYSJWBNAfd6P\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-0lGtDd17nHuUVzx\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#735f46\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A phone-free hour to scribble, sketch, and sit together outdoors.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" No pressure to \\\"do\\\" anything - just presence, creativity, and quiet company.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Phones go away at the start. What you do with the hour is up to you: sketch, write, doodle, read or simply sit and notice the world around you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Open to all adults (16+), but please ensure you've booked your spot\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/el/8b27b30a-1a05-4719-b7c4-8b660c9b5999.png\",\"width\":3360,\"height\":1890,\"image_id\":\"local-upload-blob:https://luma.com/76194209-2b4f-4487-b90c-3e5ecbcd12d8\",\"mime_type\":null,\"uploaded_at\":\"2026-09-19T20:27:28.090+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Laura Edralin\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", co-founder of Fauna, local calligraphy teacher and podcast host will be welcoming you all to the first of these free un-guided community events and ensure you're all settled before we begin.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This first session is held with local sound practitioner \",\"type\":\"text\"},{\"text\":\"Maria Taffurelli \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"of\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"White Moon Energy\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://whitemoonenergy.com\"}},{\"type\":\"bold\"}]},{\"text\":\", who will bring her crystal singing bowls for a live soundscape to sit and create alongside - gentle, resonant tones to ease you into stillness as you sketch, write, or just breathe. Maria's work draws on sound healing, Reiki, crystal therapy, and plant medicine, rooted in ancestral wisdom and the idea that everything - including us - is frequency and vibration. Connect with her \",\"type\":\"text\"},{\"text\":\"@whitemoonenergy\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/whitemoonenergy/?hl=en\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to bring: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"a sketchbook and any pens, pencils, or pastels (or borrow ours), plus something to sit on if you'd like - a stool, cushion, mat, or blanket. Or just bring yourself.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Communal materials kindly sponsored by \",\"type\":\"text\"},{\"text\":\"Arthur's Coffee House\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.arthurshouses.com/\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The intention of these session is to encourage quiet creative time, therefore please note:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is for adults aged 16+\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Solo participation encouraged\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Groups and friends welcome, but please keep conversations for before or after the session\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Feel free to arrive and leave (quietly) anytime\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"No pets allowed (we're in a gated dog-free zone)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please check the weather before-hand and ensure you bring whatever you need to be comfortable.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Held outside \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"in Ravenscourt Park in the gated picnic area opposite the cafe (The Paddenswick Tea Gardens). Free - sign up for details and any last-minute changes.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
