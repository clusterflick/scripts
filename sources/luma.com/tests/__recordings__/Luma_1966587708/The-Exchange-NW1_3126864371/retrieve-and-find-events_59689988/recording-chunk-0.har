            "text": "{\"api_id\":\"evt-Ph0EGnhGyRSZnXN\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-UXqne43goGrU6PO\",\"avatar_url\":\"https://images.lumacdn.com/calendars/zx/45b23011-813a-4504-9c06-213ea627a547.jpg\",\"coordinate\":null,\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/9p/2e805eef-f078-4555-baee-14414b294d98.png\",\"description_short\":\"Events produced by Rara Avis\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":null,\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":null,\"luma_plan\":\"plus\",\"luma_plus_active\":true,\"meta_pixel_id\":null,\"name\":\"raraavismusic\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We understand that plans can change.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets are fully refundable up to 14 days before the event.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Within 14 days of the event, tickets become non-refundable, but they may be transferred to another person at no additional charge.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If we cancel or reschedule the event, you may choose either:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A full refund, or\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A transfer to future date\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you are unable to attend due to serious illness, medical emergency, or travel disruption, please contact us and we will do our best to find a fair solution.\",\"type\":\"text\"}]}]},\"slug\":\"r