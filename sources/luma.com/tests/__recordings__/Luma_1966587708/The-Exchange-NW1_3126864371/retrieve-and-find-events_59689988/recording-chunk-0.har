GVufDB8fHx8MTc4NzUwMDA0M3ww&ixlib=rb-4.1.0&q=80&w=1080\",\"end_at\":\"2026-10-02T21:30:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"NNG Independence Day Reception\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/29/f117d725-4560-4223-8c3e-042fefc588a8.png\",\"start_at\":\"2026-10-02T17:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"7ijeeqbw\",\"user_api_id\":\"usr-JA3pUAGjALYmucB\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Amazon Corporate Office LHR16\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJHyYc7-4ddkgRgghk0Vs0kCo\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"Amazon Corporate Office LHR16\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"Amazon Corporate Office LHR16, 1 Principal Pl, London EC2A 2FA, UK\",\"region_short\":\"England\",\"short_address\":\"1 Principal Pl, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"Amazon Corporate Office LHR16, 1 Principal Pl, London EC2A 2FA, UK\",\"region_short\":\"England\",\"short_address\":\"1 Principal Pl, London\",\"place_coordinate\":{\"latitude\":51.521899,\"longitude\":-0.07923759999999999},\"apple_maps_place_id\":\"I55B5F2A2E6706475\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.07923759999999999,\"latitude\":51.521899},\"waitlist_enabled\":false,\"waitlist_status\":\"disabled\"},\"start_at\":\"2026-10-02T17:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-JA3pUAGjALYmucB\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_7.png\",\"bio_short\":\"\",\"first_name\":\"NNG\",\"last_name\":\"(Nigeria's Next Generation)\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"NNG - Nigeria's Next Generation\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#e4e4e4\",\"#92a5b5\",\"#2c4548\",\"#0f6871\"],\"palette\":{\"neutral\":[{\"color\":\"#2c4548\",\"percentage\":0.88},{\"color\":\"#e4e4e4\",\"percentage\":20.1}],\"vibrant\":[{\"color\":\"#92a5b5\",\"percentage\":16.11},{\"color\":\"#0f6871\",\"percentage\":0.81}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/29/f117d725-4560-4223-8c3e-042fefc588a8.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-qAuEYQT1u8ngB77\",\"cents\":1000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-p7sNyMqW3tHqgcf\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":25,\"num_guests\":25,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#3CBD2C\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-mode\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"It is our pleasure to invite you to our Independence Day Celebration, an evening of networking, reflection on the Nigerian State, and looking forward, as we come together to mark this special occasion.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The evening will bring together our team, friends, and partners for an evening of connection and conversation. Guests can look forward to an opening keynote, a journey through Nigerian history, a spirited debate on the nation's future, and a showcase of the projects through which NNG is turning ideas into impact, closing with a special poetry performance.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The details are as follows: Date: Friday, 2 October 2026 Arrival: 6:00 PM (programme begins at 6:30 PM) Venue: Amazon Office, Liverpool Street, London Outfit theme: A Touch of Green Admission is £10 (early bird), and £15 thereafter and at the door. (Tickets go to food, entertainment & remainder goes to projects).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We would be delighted to have you join us for what promises to be a memorable evening as we celebrate how far we have come and look ahead to the Nigeria we are building together.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"u7t2xqbh\",\"label\":\"I would like to receive future newsletters and marketing communications from NNG. I understand I can unsubscribe at any time.\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"zz8lux39\",\"label\":\"Would you be keen to join the debate on stage?\",\"options\":[\"Yes\",\"No\"],\"required\":false,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
