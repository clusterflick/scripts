"palette\":{\"neutral\":[{\"color\":\"#1a2528\",\"percentage\":38},{\"color\":\"#ded0ca\",\"percentage\":15.13}],\"vibrant\":[{\"color\":\"#e0292a\",\"percentage\":2.12},{\"color\":\"#df7b2a\",\"percentage\":3.19}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/yd/c22105d5-6f9e-47e9-8daa-60c069bf9f27.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-2VmqcLQGK5vEA3g\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-T7dE9T2UFrsogJS\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":19,\"num_guests\":19,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"falling-leaves\"},\"tint_color\":\"#ed2b32\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Slow down, and soak in the beauty of the season with a cozy, intentional gathering designed for women to wander, chat, and create together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We'll spend the afternoon in the fresh air, collecting beautiful fallen foliage, and crafting handmade botanical keepsakes to take home.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"How It Works\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"👟 \",\"type\":\"text\"},{\"text\":\"Walk & Connect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" We’ll start with a gentle, screen-free stroll to relax, chat, and enjoy the outdoors.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🍁 \",\"type\":\"text\"},{\"text\":\"Gather Leaves:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Pick out your favorite fallen leaves right off the trail as we wander.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📖 \",\"type\":\"text\"},{\"text\":\"Press & Preserve:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" We’ll gather in a cozy space to learn the art of leaf pressing, creating timeless, botanical keepsakes to take home.\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"What to Bring\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📓 \",\"type\":\"text\"},{\"text\":\"Just one heavy book\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" (a thick hardcover works best to press your leaves inside).\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Take a breath, leave the notifications behind, and carry home a little piece of nature. We look forward to sharing this peaceful afternoon with you!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Offline Women\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://offlinewomen.org/?utm_source=luma\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Luma\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://luma.com/offlinewomen\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"WhatsApp\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://whatsapp.com/channel/0029VbCZyvCD38CTaXBpQ72V?utm_source=luma\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"LinkedIn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.linkedin.com/company/offline-women/?utm_source=luma\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
