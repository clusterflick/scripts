\",\"timezone\":\"Europe/London\",\"twitter_handle\":\"louiselton96\",\"username\":null,\"website\":null,\"youtube_handle\":\"nationofartisans\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#6e797e\",\"#090b0e\",\"#fdfdfd\"],\"palette\":{\"neutral\":[{\"color\":\"#090b0e\",\"percentage\":20.39},{\"color\":\"#737d81\",\"percentage\":15.1},{\"color\":\"#69757a\",\"percentage\":13.49},{\"color\":\"#fdfdfd\",\"percentage\":3.8}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/94/fb6777f8-7611-4809-9ae2-d4e6ddb96909.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-DLBzZ3PtFodk4HB\",\"cents\":1800,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-oydFr3BPh07D2Ah\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1800,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":115,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#080a0e\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"futura\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nation of Artisans invites you to the Night of the Gansey.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"us for a extremely chic evening celebrating the mythic world of the gansey.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What is a gansey I hear you ask? Why it is fisherman's jumper, stitched with a unique pattern famed for helping fishing communities identify their lost fishersmun.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will begin the premiere of \",\"type\":\"text\"},{\"text\":\"THE GANSEY FOLK OF HASTINGS, \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\"conceived and directed by friend of Nation of Artisans, Issabella Orlando.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The film looks at the rebirth of the gansey tradition in Hastings through the eyes of knitters, fisherman, and singers united by a shared passion for the gansey.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"But wait there's more! Not just a film premiere, but live musical performances from Hastings's finest sea shantymen \",\"type\":\"text\"},{\"text\":\"Bob Marlin & the Whalers\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", as well as \",\"type\":\"text\"},{\"text\":\"Bev Lee Harding\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a folk singer famed for her beautiful song of gansies.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Do not expect a twee worship of craft, fishing, and the music of the past. Get read of the hottest night the Gansey has ever seen.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drinks, mingles, shanties, ganseys.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dress: Fisherman Chic /  Ganseys\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Tickets: £18.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All aboard.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
