ing App\",\"instagram_handle\":\"siftag.co\",\"is_verified\":false,\"linkedin_handle\":\"/company/siftag\",\"name\":\"Siftag - Natural Fibre Shopping App\",\"tiktok_handle\":\"siftag.com\",\"timezone\":\"Asia/Seoul\",\"twitter_handle\":null,\"username\":\"siftag\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#c8bfb3\",\"#f4f1f1\",\"#281e1b\",\"#b17854\"],\"palette\":{\"neutral\":[{\"color\":\"#281e1b\",\"percentage\":11.06},{\"color\":\"#f4f1f1\",\"percentage\":14.31},{\"color\":\"#c8bfb3\",\"percentage\":23.19}],\"vibrant\":[{\"color\":\"#b17854\",\"percentage\":9.61},{\"color\":\"#a04e37\",\"percentage\":3.78},{\"color\":\"#a5bbe3\",\"percentage\":2.89},{\"color\":\"#7c7127\",\"percentage\":2.42}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/3t/37368ec5-fba2-487d-af16-b81043a96a54.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-PJJHviruUUlCCep\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-4jhaYIZg5vJ5FNf\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":17,\"num_guests\":17,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-climate\",\"description\":\"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.\",\"event_count\":1574,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png\",\"name\":\"Climate\",\"page_title\":\"Climate Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png\",\"slug\":\"climate\",\"social_image_url\":\"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#a46c45\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Consumers scrutinize the ingredients in their food and skincare. Clothing is one of the last major categories where most people don’t; and that is changing.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Join us for an evening hosted by Siftag; the first and largest polyester-free shopping platform, working to dismantle fashion’s dependence on oil. It connects consumers with better products while building a trusted supply chain that helps brands source vetted natural and next-generation sustainable materials and production.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hosted in collaboration with The Mills Fabrica X in London, this event brings together journalists, creators, founders, innovators, and investors to explore how trust is built, demand is created and enduring ventures emerge in a changing industry.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The event will include goodie bags with a variety of sustainable products from our sponsors, drinks and networking with members of our community.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Agenda\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:30 PM:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Panel discussion\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"7:30 PM:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Gifts and first look at brand lineup\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"8:00 PM:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Drinks and networking\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"3dsuaheu\",\"label\":\"LinkedIn Profile?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"4bk2mlst\",\"label\":\"What are you building/working on? (Feel free to say 'not building' or 'stealth' if NA) *\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"gov2g9ke\",\"label\":\"Questions for Panel\",\"required\":false,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
