c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":750,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":1600,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":13,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#bbd0bf\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The London based book club for baddies!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us to debrief this months read \",\"type\":\"text\"},{\"text\":\"‘Verity’ \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"by Colleen Hoover\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"THE PLOT DETAILS 💌\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ Every ticket comes with a curated bookish goody bag.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📚 Chosen the \",\"type\":\"text\"},{\"text\":\"Book Included\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" ticket? Your copy of \",\"type\":\"text\"},{\"text\":\"Verity\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" will be posted straight to your door.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👜 Going \",\"type\":\"text\"},{\"text\":\"Bring Your Own Book\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"? Just bring your copy of \",\"type\":\"text\"},{\"text\":\"Verity\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" along with you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"☕ Come hungry (or caffeinated!) — food & drinks aren’t included in your ticket, but you’ll be able to order whatever you fancy from Kasa on the day.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come for the book, stay for the plot!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"QtJYZWAR\",\"label\":\"If you’ve selected the £22 Book Included ticket, please enter the full UK postal address you’d like your copy of Verity sent to. If you’re bringing your own book, please write N/A\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"DXgxNSCa\",\"label\":\"I confirm that the address I’ve provided is correct and can be used to send my book if I’ve selected the Book Included ticket\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
