bled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":2100,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#4b8250\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join our October \",\"type\":\"text\"},{\"text\":\"ABRC Film Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" for a private screening of \",\"type\":\"text\"},{\"text\":\"Parasite \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"(\",\"type\":\"text\"},{\"text\":\"dir. Bong Joon Ho\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"). This film follows unemployed Ki-taek's family as they take a peculiar interest in the wealthy and glamorous Parks for their livelihood, until they get entangled in an unexpected incident of infiltration. A social commentary, a tragedy, and a comedy all in one. This is not one to miss! \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"The screening will be followed by an \",\"type\":\"text\"},{\"text\":\"in-cinema discussion\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" where we'll dissect the film and its themes as a group.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Popcorn is included in your ticket!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"The \",\"type\":\"text\"},{\"text\":\"screening begins at 12:45 PM\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" sharp, but there will be time to socialise beforehand and afterwards!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"ANTI-BRAINROT CLUB (ABRC) is a creative and intellectual community for those who want to get off their phones, meet like-minded people, and build interesting lives!\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"____________________________\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Disclaimers:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you join the Waitlist, \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"there will be a \",\"type\":\"text\"},{\"text\":\"temporary transaction\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" on your card for the price of the ticket, which will be released if you are not approved for the event by the time it takes place. This is Luma's policy and we do not have access to these funds.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"If you can't attend anymore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via email on \",\"type\":\"text\"},{\"text\":\"team@becomingali.com\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and we will be able to refund you \",\"type\":\"text\"},{\"text\":\"only\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can find someone on the Waitlist to take your spot. Please note that if the event has not reached capacity to develop a Waitlist yet, we cannot process any refunds. \",\"type\":\"text\"},{\"text\":\"We also cannot process same-day refunds or waitlist exchanges.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
