h/3b63ac56-45ac-4eee-8126-0e1d9299107c.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-Q4PJvxdFoZAVH03\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-7n4fjhlegHNij4t\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":42,\"num_guests\":42,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-climate\",\"description\":\"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.\",\"event_count\":1574,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png\",\"name\":\"Climate\",\"page_title\":\"Climate Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png\",\"slug\":\"climate\",\"social_image_url\":\"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":158,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#bffc73\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"The best of London’s independent fashion scene, all under one roof\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://roof.Shopping\"}},{\"type\":\"bold\"}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Shopping, art, DJs, drinks — your Fashion Week plans are officially sorted.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tomorrow’s Tribe X Wild Clouds are taking over The Bomb Factory in Marylebone for a two-day event celebrating great brands, art and the people shaping a more exciting future for fashion.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a weekend of shopping from some of London’s best independent and sustainability-led brands, alongside live DJs, food, drinks and Daira’s latest exhibition, \",\"type\":\"text\"},{\"text\":\"The Living Network: Nature and Community\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Fashion meets art\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The pop-up is hosted in collaboration with Daira, who will be exhibiting \",\"type\":\"text\"},{\"text\":\"The Living Network: Nature and Community\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" during London Fashion Week.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The exhibition brings together artists from South America, Africa and Asia whose work explores climate change through stories of land, water, community and resilience.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Through colour, symbolism and personal storytelling, the exhibition looks at how people around the world are adapting to environmental change — making it a powerful backdrop for a weekend celebrating brands working towards a more thoughtful fashion industry.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"When\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Saturday 27 February 2027\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"10am–7pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sunday 28 February 2027\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"10am–5pm\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Where\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Bomb Factory\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Marylebone, London\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Located in the heart of Marylebone, The Bomb Factory is a large contemporary gallery\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Tickets\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Entry is free, but registration is recommended.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Book your place, bring your friends and join us for London Fashion Week’s independent shopping party.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Shop. Sip. Discover. Repeat.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
