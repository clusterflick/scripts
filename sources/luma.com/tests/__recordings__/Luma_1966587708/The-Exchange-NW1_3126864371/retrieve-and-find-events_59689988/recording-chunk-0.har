atitude\":51.5149377},\"waitlist_enabled\":false,\"waitlist_status\":\"disabled\"},\"start_at\":\"2026-09-25T17:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"No refund\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-vglG6BHJrG2jrCE\",\"avatar_url\":\"https://images.lumacdn.com/uploads/v2/c89b7d13-fbf3-49cf-bdc5-5210792e8995.png\",\"bio_short\":\"Socialite Connections brings professionals, business owners together for networking\",\"first_name\":\"Socialite\",\"last_name\":\"Connections\",\"instagram_handle\":\"socialite_connections\",\"is_verified\":false,\"linkedin_handle\":\"/company/socialite-connections\",\"name\":\"Socialite Connections\",\"tiktok_handle\":\"socialiteconnections\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"socialiteconnec\",\"website\":\"https://eventbrite.co.uk/o/socialite-connections-17781292823\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#120b0b\",\"#bb7037\",\"#faead6\",\"#e0a92b\"],\"palette\":{\"neutral\":[{\"color\":\"#120b0b\",\"percentage\":19.55},{\"color\":\"#faead6\",\"percentage\":5.44}],\"vibrant\":[{\"color\":\"#bb7037\",\"percentage\":8.74},{\"color\":\"#e0a92b\",\"percentage\":2.19}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/id/86cf5e53-7577-4aef-8712-d403a4297434.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-r1fJiH3A9qTdWkO\",\"cents\":1000,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-BeTsXrYgHHyH32F\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#bf773d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome to Socialite Connections - Actors, Screenwriters & Movie Industry Connections\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This London event brings together actors, screenwriters, filmmakers, producers and others working across film and television for an evening designed to encourage genuine introductions, creative conversations and new industry relationships.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you are developing your next screenplay, looking for creative collaborators, building your portfolio, seeking production contacts or simply want to expand your circle within the industry, this is an opportunity to meet people who could play a valuable role in your next project.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Anthologist -\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Located in the heart of the City, on Gresham Street by Bank station, The Anthologist is a gorgeous bar & restaurant with a cosy outside seating area. We are ready to welcome you with delicious travel inspired dishes, gorgeous spritzes & bubbly.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event Schedule\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:00 – 21:00 | Welcome & Warm Intro:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Your name will be checked off the guest list, you will be given a name badge and you will be introduced to each other.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"19:30 – 20:00 | One Min Pitch:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" All attendees will be given the opportunity to introduce themselves to everyone in the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"20:-00 - 21:00 | Informal Networking:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" It will be a free form event where guests can mingle amongst each other in a relaxed environment, when the one minute pitch is finished.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meet actors, screenwriters, filmmakers, producers and others working across film and television\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Discover potential collaborators for your next film, screenplay or creative project\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Build valuable relationships with people who can help move your career or project forward\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Exchange ideas, discuss current projects and discover what others are working on\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Put yourself and your work in front of new industry contacts\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Find potential creative, production and career opportunities\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expand your circle within London’s film and screen industry\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Leave with new contacts, fresh ideas and conversations that could lead to your next project\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Who Should Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Actors looking to meet new industry contacts and discover potential projects\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Screenwriters developing scripts, films or television projects\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Filmmakers and directors looking for creative collaborators\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Producers seeking talent, writers and new projects\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Casting professionals and talent representatives\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Independent filmmakers and emerging production companies\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Film and television creatives looking to expand their industry circle\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Creative entrepreneurs working across film, television and screen entertainment\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Anyone actively building a career, project or business within the film industry\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photos/videos\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" may be taken for promotional purposes.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You will be added to our whatsapp group on the day of the event.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
