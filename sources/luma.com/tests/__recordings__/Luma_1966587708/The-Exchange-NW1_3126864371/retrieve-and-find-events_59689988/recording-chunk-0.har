rts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-fooddrink\",\"description\":\"From morning coffee to late night pizza, enjoy great food and drinks with old and new friends.\",\"event_count\":602,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/xv/2dd876d6-775a-4cec-adba-9d9e94d814a6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/36/a77db635-cb3b-4720-9758-2bc9dae948e4.png\",\"name\":\"Food & Drink\",\"page_title\":\"Food & Drink Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/hj/9724cc70-b0e4-416f-9219-35efbf25fba7.png\",\"slug\":\"food\",\"social_image_url\":\"https://images.lumacdn.com/uploads/ip/9252c72b-62c6-4b5b-b321-5e2ee66757b4.png\",\"subscriber_count\":15402,\"tint_color\":\"#D58530\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#bca0ab\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Toothsome.Treats is back with another \",\"type\":\"text\"},{\"text\":\"#JustIcingAround\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" but this time it’s…\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Cake Clash!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a fun and creative \",\"type\":\"text\"},{\"text\":\"cake decorating workshop\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" where you’ll learn how to ice and decorate your own cake!\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"This is open to ALL GENDERS & IS FREE! 🥰🥳\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What’s included:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🍰 Pre-baked one layer 5-inch cake – \",\"type\":\"text\"},{\"text\":\"ready for you to ice, decorate and take home\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"👩🏾‍🍳 Buttercream, tools & decorating supplies – \",\"type\":\"text\"},{\"text\":\"everything you need is provided\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🍹 Refreshments – \",\"type\":\"text\"},{\"text\":\"keep your creativity flowing while you decorate\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎉 Interactive ice-breaker games & mini challenges – \",\"type\":\"text\"},{\"text\":\"bringing fellowship and plenty of laughter\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎶 Music – \",\"type\":\"text\"},{\"text\":\"enjoy uplifting vibes as you decorate\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Perfect for:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Friends’ day out or solo creative time\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Birthday celebrations\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ready to unleash your creativity? Reserve your spot today. Come have fun, relax, and enjoy the experience!\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"jqBKDgtW\",\"label\":\"Cake flavour\",\"options\":[\"Vanilla\",\"Oreo\"],\"required\":false,\"question_type\":\"dropdown\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
