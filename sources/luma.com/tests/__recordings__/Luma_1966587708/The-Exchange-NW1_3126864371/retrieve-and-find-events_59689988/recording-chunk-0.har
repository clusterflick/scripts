alse,\"linkedin_handle\":null,\"name\":\"Marie JONES\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-X4VoXcSFBvYODeb\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_3.png\",\"bio_short\":null,\"first_name\":\"Louisa\",\"last_name\":\"Knapp\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Louisa Knapp\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":7,\"ticket_count\":7,\"hosts\":[{\"api_id\":\"usr-3lS3vWYG9VcHFXS\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_28.png\",\"bio_short\":\"Founder @ Philippa London Sustainable Luxury Womanswear made in the UK\",\"first_name\":\"Pip\",\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Pip\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#faf5ef\",\"#060605\",\"#946b28\"],\"palette\":{\"neutral\":[{\"color\":\"#060605\",\"percentage\":2.24},{\"color\":\"#faf5ef\",\"percentage\":85.73}],\"vibrant\":[{\"color\":\"#946b28\",\"percentage\":1.23}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/av/25802697-f6fd-4e1a-9fa1-b7724be380bf.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-YQrQ1B9MyVlqKnx\",\"cents\":4000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-vB9T4VizUZip1Lh\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":4000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":23,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fbf5ee\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"You’re invited to an evening celebrating British-made fashion and the people behind it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join \",\"type\":\"text\"},{\"text\":\"Philippa London, Snow Finel, Guillotine England and The Female Archetypes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", with special guest \",\"type\":\"text\"},{\"text\":\"Kate Hills, founder of Make it British\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Enjoy Champagne on arrival, followed by an intimate fashion showcase featuring all four brands. Kate Hills will then share her perspective on British manufacturing and why making in Britain matters, followed by a Q&A.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meet the designers behind the brands, discover and shop their collections, and take home a special gift bag at the end of the evening.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"THE EVENING\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:00-6:30 Arrival & Champagne\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"6:30-6:45 Seating\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"6:45-7:15 British Made Fashion Showcase\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"7:15-7:30 Guest Speaker Kate Hills\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"7:30-8:00 Q&A and meet the designers & shopping\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6–8PM\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"324–325 KING’S ROAD, LONDON SW3\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Places are limited. We look forward to welcoming you.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
