dle\":\"livekindred\",\"is_verified\":false,\"linkedin_handle\":\"/in/live-kindred\",\"name\":\"Kindred\",\"tiktok_handle\":\"livekindred\",\"timezone\":\"America/Chicago\",\"twitter_handle\":\"livekindred\",\"username\":\"livekindred\",\"website\":\"https://livekindred.com\",\"youtube_handle\":\"livekindred\"},{\"api_id\":\"usr-3Wn309jBFQam0BP\",\"avatar_url\":\"https://images.lumacdn.com/avatars/if/62cf75a5-8233-4cb0-bfd2-80a4003206a6.jpg\",\"bio_short\":\"\",\"first_name\":\"Marionette\",\"last_name\":\"Diaz\",\"instagram_handle\":\"marionettediaz\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Marionette Diaz\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#6aa2c8\",\"#000000\"],\"palette\":{\"neutral\":[{\"color\":\"#000000\",\"percentage\":5.48}],\"vibrant\":[{\"color\":\"#6aa2c8\",\"percentage\":92.44}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/xd/f8f13bf3-e16b-4050-9345-d60a695fc462.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-4sLNlss2hla0AAK\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-2yDuHEsDoXpoXHw\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":6,\"num_guests\":6,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":41,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f7f3ef\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join the Kindred community for a unique book club experience where we explore London through literature, hosted by member \",\"type\":\"text\"},{\"text\":\"Marionette\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://livekindred.com/household/cmfcz47ni0158ly2jkzvxuazl?utm_source=luma\"}}]},{\"text\":\". This gathering is designed to help you connect with your local Kindred community, swap travel and hosting stories, share tips, and ask questions about Kindred directly with fellow members. Whether you are a seasoned host, a curious traveler, or somewhere in between, you are welcome here.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎨 \",\"type\":\"text\"},{\"text\":\"Activity details\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What if the city could become part of the story? Join us for a bookish afternoon exploring Peckham through books, bookshops and conversation.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For our third gathering, we’ll dive into Bernardine Evaristo’s \",\"type\":\"text\"},{\"text\":\"Girl, Woman, Other\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", a vibrant, interconnected novel exploring identity, friendship, family, race, love and belonging across London. With Peckham playing an important role in the story, there’s no better place to take our book discussion beyond the page.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’ll embark on a bookshop crawl through \",\"type\":\"text\"},{\"text\":\"Review Bookshop, BOOKS, and Chener Books\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", discovering new reads, sharing perspectives on this month’s book pick, and getting to know one of London’s most creative neighbourhoods along the way. Think of it as a little local adventure, with books as our guide. 📖✨\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The timing is especially fitting as we’ll be gathering during \",\"type\":\"text\"},{\"text\":\"Banned Books Week\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", celebrating the freedom to read and the books that challenge, provoke and open up important conversations.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’ll wrap up at a local pub for drinks, food and more conversation. Whether you’re here for the novel, the bookshops, the Peckham wander, or simply good literary company, everyone is welcome!\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ticket cost:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Free to attend. Everyone covers their own or brings something to share.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"What's included:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" A relaxed literary afternoon featuring a \",\"type\":\"text\"},{\"text\":\"Girl, Woman, Other\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" discussion, a crawl through three independent bookshops, and plenty of time to connect with fellow Kindred members in Peckham.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to bring:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A copy of \",\"type\":\"text\"},{\"text\":\"Girl, Woman, Other\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" if you have one — ideally read before the event, but no pressure to have finished it!\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Comfortable shoes for wandering around Peckham\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Curiosity and an appetite for good books, good places, and good people\",\"type\":\"text\"}]}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"How to Sign Up - \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Your spot is confirmed once you RSVP to this invite.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Where\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Peckham Rye Station\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.google.com/maps/place/Peckham+Rye/@51.4700321,-0.0719542,17z/data=!3m2!4b1!5s0x487603a1c91ae845:0xb1119658ccddf045!4m6!3m5!1s0x487603a1cc2d8521:0xda7e3d77ef93dddb!8m2!3d51.4700321!4d-0.0693739!16s%2Fg%2F1ptz2vmyj?entry=ttu&g_ep=EgoyMDI2MDkwOC4wIKXMDSoASAFQAw%3D%3D\"}}]},{\"text\":\" – Station Way, London SE15 4RX, United Kingdom\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This gathering is part of Kindred’s ongoing effort to help members connect locally through simple, repeatable moments of togetherness. Hosting and traveling through Kindred is about trust, generosity, and real human connection, and this is a chance to experience that spirit in person.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’re brand new or have been part of the community for years, we’d love to see you there.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About the organizer\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Kindred\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://livekindred.com/\"}},{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"is a members-only home-swapping network built on a close-knit community. We make travel more affordable and accessible by allowing you to earn credits for hosting others, either through swaps or while you're away. No money is exchanged between members; everything runs on a simple credit system. Instead of overpaying for rentals while your home sits empty, we empower our members to explore their next destination conveniently and affordably, while fostering a trusted community of people who seek to live a travel-rich lifestyle.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🌎 Website: \",\"type\":\"text\"},{\"text\":\"www.livekindred.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://livekindred.com/\"}}]},{\"text\":\" | 📲 Follow on Socials: \",\"type\":\"text\"},{\"text\":\"@livekindred\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/livekindred\"}}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About your host\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"✨ \",\"type\":\"text\"},{\"text\":\"Marionette \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://livekindred.com/household/cmfcz47ni0158ly2jkzvxuazl?utm_source=luma\"}}]},{\"text\":\"is a Kindred member based in London, bringing together her love for books, writing, and meaningful connections. A lifelong book lover, she believes stories are one of the best ways to discover new places and connect with people. Since moving to London, she’s enjoyed exploring the city through its neighborhoods, cafés, bookshops, and hidden stories.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This book club is a space for anyone who wants to read more, meet new people, and experience London through literature. Whether you’ve called the city home for years or are still discovering its hidden corners, we hope this becomes a place to share stories, spark conversations, and enjoy a little adventure along the way.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Quick FYIs:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📸\",\"type\":\"text\"},{\"text\":\" We love capturing memories together\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"! Tag \",\"type\":\"text\"},{\"text\":\"@livekindred\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/livekindred/\"}}]},{\"text\":\" on socials so we can share the joy. By RSVPing, you agree that photos or videos from the gathering may be shared on Kindred’s channels.\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please note: this event may be photographed or filmed for promotional purposes\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"💫 \",\"type\":\"text\"},{\"text\":\"Want to host a future event or help grow the community?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"Fill out \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://form.typeform.com/to/E9X8tywU\"}}]},{\"text\":\"this form \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://form.typeform.com/to/WtC8H9uo\"}}]},{\"text\":\"to get involved.\",\"type\":\"text\"}]}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"0jekurxo\",\"label\":\"By attending this event, I consent to being photographed, filmed, or recorded, and grant Kindred the perpetual, royalty-free right to use my likeness in any media for promotional, marketing, or other business purposes. I hereby waive any right to inspect or approve the finished materials or to receive compensation for their use.\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"1t1jmdth\",\"label\":\"By participating in this event, you acknowledge and agree that your participation is entirely at your own risk, and you assume full responsibility for any injury, loss, or damage that may arise from or in connection with your participation.\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
