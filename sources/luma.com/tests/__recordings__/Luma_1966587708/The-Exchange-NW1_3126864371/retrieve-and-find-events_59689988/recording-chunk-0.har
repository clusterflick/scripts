approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-ODf3PBICfeyC0qC\",\"avatar_url\":\"https://images.lumacdn.com/uploads/ge/a57b850f-7ea3-4464-8082-48b96bc703f6.png\",\"bio_short\":\"D’Stassi Art is a contemporary gallery in Shoreditch, London, presenting exhibitions by leading and emerging international artists.\",\"first_name\":\"D'Stassi\",\"last_name\":\"Art\",\"instagram_handle\":\"dstassiart\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"D'Stassi Art\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"dstassiart\",\"website\":\"https://www.dstassiart.com\",\"youtube_handle\":\"dstassiart\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#010102\",\"#fcfcfc\",\"#f94243\"],\"palette\":{\"neutral\":[{\"color\":\"#010102\",\"percentage\":33.1},{\"color\":\"#fcfcfc\",\"percentage\":10.7}],\"vibrant\":[{\"color\":\"#f94243\",\"percentage\":4.6}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/9s/eda24a4e-2f58-4e36-b901-779497ac8849.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-egt2HdpT5KMwKwH\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-Yh0camCYQxLTBkD\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":337,\"num_guests\":337,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":1663,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#040404\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"D’Stassi Art presents SAMO : TRANSATLANTICATION, the UK debut exhibition of pioneering New York artist and SAMO© co-creator Al Diaz.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us in London on Friday 25 September for the opening night of this landmark exhibition.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Launch event\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Friday 25 September 2026\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"7 PM until midnight\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"D’Stassi Art, Shoreditch, London\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Born and raised in New York, Diaz emerged from the city’s graffiti scene in the 1970s and became one of the defining voices of its downtown cultural movement. Alongside Jean-Michel Basquiat, he co-created \",\"type\":\"text\"},{\"text\":\"SAMO\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", the enigmatic series of poetic, satirical and often confrontational statements that began appearing across Lower Manhattan in the late 1970s.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Written on walls throughout SoHo and the East Village, SAMO became part artwork, part social commentary and part anonymous mythology. Its language challenged art, commerce, politics, conformity and the culture surrounding them, leaving a lasting mark on the visual history of New York.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Diaz has continued to develop that language over the decades, bringing together text, typography, found materials, collage and the visual vocabulary of the city.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For his first UK exhibition, \",\"type\":\"text\"},{\"text\":\"SAMO : TRANSATLANTICATION\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" brings that story across the Atlantic. A new body of work connects the streets and cultural histories of New York and London, revisiting the spirit of SAMO while placing Diaz’s own voice firmly at the centre of the story.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us at D’Stassi Art in Shoreditch for the opening night.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Friday 25 September 2026\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"6PM till late\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"D’Stassi Art, London\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Admission is complimentary. RSVP required.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"2ldvun6v\",\"label\":\"How did you hear about the exhibition?\",\"options\":[\"D’Stassi Art\",\"Instagram\",\"Artist / Studio\",\"Friend / Invitation\",\"Press / Media\",\"Other\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"zd70mq2m\",\"label\":\"I would like to receive news and invitations from D’Stassi Art\",\"required\":false,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
