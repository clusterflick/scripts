dle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#060606\",\"#fdfcfd\",\"#977644\",\"#de2124\"],\"palette\":{\"neutral\":[{\"color\":\"#060606\",\"percentage\":42.88},{\"color\":\"#fdfcfd\",\"percentage\":13.01}],\"vibrant\":[{\"color\":\"#de2124\",\"percentage\":3.05},{\"color\":\"#977644\",\"percentage\":3.39}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/w4/261d3605-da7e-4c60-bd27-0e15343d081b.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-IVsdAmKFmMJfvBj\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-EfZLPCKWvFBVKAD\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":141,\"num_guests\":141,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":209,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#060606\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 \",\"type\":\"text\"},{\"text\":\"18 października 2026, godz. 17:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"The Duke’s Hall, Royal Academy of Music\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"1 York Gate, Marylebone Road\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"London NW1 5HT\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎹 \",\"type\":\"text\"},{\"text\":\"W programie: Chopin, Szymanowski, Prokofiew\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🇵🇱 \",\"type\":\"text\"},{\"text\":\"O wydarzeniu\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Zapraszamy na recital Jakuba Kuszlika — jednego z najwybitniejszych pianistów młodego pokolenia. W londyńskiej Duke’s Hall artysta wykona utwory Fryderyka Chopina, Karola Szymanowskiego i Siergieja Prokofiewa.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Jakub Kuszlik zdobył IV nagrodę oraz Nagrodę Polskiego Radia za najlepsze wykonanie mazurków podczas XVIII Międzynarodowego Konkursu Pianistycznego im. Fryderyka Chopina w Warszawie. Koncertuje w prestiżowych salach i na festiwalach w Europie, Azji oraz obu Amerykach, współpracując z uznanymi orkiestrami i dyrygentami. Ceniony za wyjątkową wrażliwość muzyczną i głębokie interpretacje repertuaru romantycznego, zyskał uznanie zarówno krytyków, jak i publiczności.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Liczba miejsc jest ograniczona do 230.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"—\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🇬🇧 \",\"type\":\"text\"},{\"text\":\"About the event\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us at London’s Duke’s Hall for a piano recital by Jakub Kuszlik, one of the leading pianists of Poland’s younger generation. The programme will feature works by Fryderyk Chopin, Karol Szymanowski and Sergei Prokofiev.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Kuszlik was awarded Fourth Prize and the Polish Radio Prize for the best performance of mazurkas at the 18th International Fryderyk Chopin Piano Competition in Warsaw. He performs at prestigious concert halls and festivals across Europe, Asia and the Americas, collaborating with leading orchestras and distinguished conductors. Celebrated for his exceptional musical sensitivity and profound interpretations of Romantic repertoire, he has earned acclaim from critics and audiences alike.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Capacity is limited to 230 guests.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
