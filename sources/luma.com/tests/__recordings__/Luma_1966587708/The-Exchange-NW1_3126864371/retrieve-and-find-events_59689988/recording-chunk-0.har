://images.lumacdn.com/event-social/ie/4be1947b-2e9f-4299-8efe-463813f46363.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-UvUK3pxiLEXNjwO\",\"cents\":1500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-CNnsiwWASGl57pM\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[],\"ticket_info\":{\"price\":{\"cents\":1500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#0a0c0a\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"factoria\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome to Socialite Connections – Film, TV, Music & Media Business Networking for Startups & Industry Pros\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meet ambitious founders, creatives, entrepreneurs and industry professionals across film, TV, music and media.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Discover new clients, partnerships, projects, investment opportunities and valuable industry contacts — all in one room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Anthologist -\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Located in the heart of the City, on Gresham Street by Bank station, The Anthologist is a gorgeous bar & restaurant with a cosy outside seating area. We are ready to welcome you with delicious travel inspired dishes, gorgeous spritzes & bubbly.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event Schedule\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:00 – 21:00 | Welcome & Warm Intro:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Your name will be checked off the guest list, you will be given a name badge and you will be introduced to each other.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"19:30 – 20:00 | One Min Pitch:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" All attendees will be given the opportunity to introduce themselves to everyone in the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"20:-00 - 21:00 | Informal Networking:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" It will be a free form event where guests can mingle amongst each other in a relaxed environment, when the one minute pitch is finished.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meet potential \",\"type\":\"text\"},{\"text\":\"clients, partners, investors and collaborators\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Discover new \",\"type\":\"text\"},{\"text\":\"projects, partnerships and commercial opportunities\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Build valuable relationships across the creative industries\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Connect with people who can help \",\"type\":\"text\"},{\"text\":\"grow your business or career\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Turn introductions into \",\"type\":\"text\"},{\"text\":\"real opportunities\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Who Should Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Film, TV, music & media \",\"type\":\"text\"},{\"text\":\"startups\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Founders, entrepreneurs & business owners\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Producers, creatives & industry professionals\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Investors and people seeking funding\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Agencies, brands and media businesses\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Anyone looking for \",\"type\":\"text\"},{\"text\":\"new clients, partnerships, projects or investment\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photos/videos\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" may be taken for promotional purposes.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You will be added to our whatsapp group on the day of the event.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"