ed by Molly Aldridge and inspired by her two sons, Jake and Joshua.\",\"first_name\":\"The JJ\",\"last_name\":\"Club\",\"instagram_handle\":\"thejjclub\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"The JJ Club\",\"tiktok_handle\":\"thejjclub\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"thejjclub\",\"website\":\"https://thejjclub.co.uk\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#ede7e6\",\"#181311\",\"#526ebc\",\"#d1c53e\"],\"palette\":{\"neutral\":[{\"color\":\"#181311\",\"percentage\":12.26},{\"color\":\"#ede7e6\",\"percentage\":28.94}],\"vibrant\":[{\"color\":\"#d1c53e\",\"percentage\":3.22},{\"color\":\"#526ebc\",\"percentage\":4.15},{\"color\":\"#d9945a\",\"percentage\":2.99}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/8y/60214d94-8f4a-4191-b0db-9d03158d8cb6.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-mgS24XzhTvJMq26\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Child Free (under 1 yrs)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false},{\"api_id\":\"ttype-YASNvKUdSqU8Iun\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Adult Free\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false},{\"api_id\":\"ttype-HoNAqv51PE70iNH\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"Child Free (age 1 yr)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false},{\"api_id\":\"ttype-BEHHwMWDcrupuPA\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"98\",\"name\":\"Child Free (age 2 yrs)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":11,\"is_disabled\":false},{\"api_id\":\"ttype-m9kiaKFddBF2ECk\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"99\",\"name\":\"Child Free (age 3 yrs)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false},{\"api_id\":\"ttype-WcnuOLcv4W2gVFM\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"995\",\"name\":\"Child Free (age 4 yrs)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false},{\"api_id\":\"ttype-KKUOOsThbcOZyCw\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-UAApALftGjZy63R\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"998\",\"name\":\"Child Free (age 5 yrs)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":15,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-family\",\"description\":\"From pregnancy to college applications, find a moms’ walk, summer camp, or tutoring group and meet other families.\",\"event_count\":612,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/q4/1198a595-5920-4eec-bfdb-3bcd63965716.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/aq/f5fbdde4-46a9-4d9e-b730-7144b3c0e335.png\",\"name\":\"Family\",\"page_title\":\"Family Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/01/09874dae-ea3a-499c-8558-f51be7617a1a.png\",\"slug\":\"family\",\"social_image_url\":\"https://images.lumacdn.com/uploads/q6/6073105a-fe9c-4969-acd5-738987a39227.png\",\"subscriber_count\":1014,\"tint_color\":\"#AE6BCF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#78935d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The JJ Club is delighted to be partnering with \",\"type\":\"text\"},{\"text\":\"Parkgate House \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"on a series of \",\"type\":\"text\"},{\"text\":\"Stay, Play + Learn\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" sessions – fun and active sessions for under 5s and their families.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Each session will be run by a Parkgate House specialist teacher, focusing on themes such as Art, Music, Drama, Dance and Sport, giving little ones a taste of everything Parkgate House has to offer.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our childcare partner \",\"type\":\"text\"},{\"text\":\"Fox & Cubs\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a brilliant London nanny and household staff agency, will also be on hand to help look after your little ones during the morning, giving you the chance to enjoy some refreshments and connect with other local parents with the peace of mind that your child is safe, happy and engaged in fun and valuable activities.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You will also have an opportunity to meet the Parkgate House team and to ask any questions you may have.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Open to all, whether you're already part of our village or just starting to explore your options.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
