y\":180,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Ticket\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":56,\"num_guests\":56,\"spots_remaining\":124,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":2100,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":127,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#c40001\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Connecting a diverse design crowd, united by the matters that \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"together.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Common Matters hosts exceptional voices from across the creative landscape, to share ideas on the matters that truly matter to design today. That's why there's no theme for the evening. We simply ask interesting people, \\\"what matters to you?\\\"\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Diversity of thought is the lifeblood of creative community, which is why our speakers go beyond the work to share what’s on their mind and in their heart.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Doors 6:30pm. First speaker 7pm.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Speakers\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Aaron Skipper & Ayo Fagbemi, Co-founders of \",\"type\":\"text\"},{\"text\":\"Explorers Club\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://explorers-club.studio/\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Marcos Rodrigues, Interactive Design Director &  Janneke Geerts, Business Director at \",\"type\":\"text\"},{\"text\":\"PORTO ROCHA\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.portorocha.com/\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Emily Ash Powell\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://substack.com/@emilyashpowell\"}}]},{\"text\":\", Independent Writer & Brand Consultant\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"About Common Matters\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Common Matters is brought to you by \",\"type\":\"text\"},{\"text\":\"Craft\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://itscraft.com/\"}}]},{\"text\":\", the global creative talent consultancy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We cultivate creative teams for ambitious brands and agencies globally, planting the seeds of what's next for the design community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Thank you to our wonderful event partners, \",\"type\":\"text\"},{\"text\":\"GF Smith\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.gfsmith.com/\"}}]},{\"text\":\"!\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"The Venue\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our venue is fully wheelchair accessible. If you have any access needs for the night or questions, please email \",\"type\":\"text\"},{\"text\":\"news@itscraft.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:news@itscraft.com\"}}]},{\"text\":\" and we will help you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography and video content may be taken at this event for marketing and promotional purposes. If you do not want to be photographed or filmed, please email \",\"type\":\"text\"},{\"text\":\"news@itscraft.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:news@itscraft.com\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"By purchasing a ticket you'll sign up to receive Craft's occasional newsletter. There's a handy unsubscribe button on each one if you don't fancy it.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":true,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
