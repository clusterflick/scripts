ull,\"cover_image\":{\"colors\":[\"#908531\",\"#fefefc\"],\"palette\":{\"neutral\":[{\"color\":\"#fefefc\",\"percentage\":5.14}],\"vibrant\":[{\"color\":\"#908531\",\"percentage\":12.65}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/d7/00a0fbc0-3dbc-4ae1-97a0-48c679cca3be.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-dL7LDjXmTBPudcZ\",\"cents\":1000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-TCoMu2vPNERdbTr\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":17,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#8d822d\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you're comfortable, confident and can Follow all the moves covered in our Fundamentals Class - Casino (Open Position), Son (Closed Position), Exhibela, Enchufla & Dile Que No - then you're ready for Intermediate\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"In our Intermediate Class, we will cover a selection of moves:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cubanito\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Setenta\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Ochenta\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Sombrero\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Vacilala\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Corona\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Paseala\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’ll also include some variations of these moves to add some flavour to your repertoire, and we’ll work on your ability to connect moves smoothly.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"As always, no partner needed!\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
