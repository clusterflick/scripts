\":\"muutodesign\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Muuto\",\"tiktok_handle\":null,\"timezone\":\"Europe/Copenhagen\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-0C8hCgQfJdryjVB\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_24.png\",\"bio_short\":\"\",\"first_name\":\"Anna\",\"last_name\":\"Mohn Larsen\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Anna Mohn Larsen\",\"tiktok_handle\":null,\"timezone\":\"Europe/Copenhagen\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-llONr43obB6VJgc\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_31.png\",\"bio_short\":null,\"first_name\":\"Sally\",\"last_name\":\"Potter\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Sally Potter\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"SallyPotter\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#8b7c1d\"],\"palette\":{\"neutral\":[],\"vibrant\":[{\"color\":\"#8b7c1d\",\"percentage\":96.26}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/dd/a9f41f16-e726-465a-8cb8-3bdee294cf15.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-B15bdbLJT7KB6dg\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-W5bYmFjHUpBxARC\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":98,\"num_guests\":98,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#8b7c1d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"futura\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Together with Heal’s and media partner ELLE Decoration, we invite you to celebrate Muuto’s 20-year anniversary and the arrival of the Close to Heart Chair by Spacon and the Inner View Object by Lise Vester in London.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"For one evening, guests are invited to be among the first to purchase one of the limited pieces through Heal’s.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Join us to experience the Numbered Edition Designs up close and hear \",\"type\":\"text\"},{\"text\":\"Lise Vester\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" share the story behind the \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Inner View Object\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"—part of a worldwide edition of just \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"150 individually numbered pieces.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"The first 75 guests will receive a special Muuto goodie bag.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Exhibition\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"From 22 September—13 October, Heal’s will offer 5 Close to Heart Chairs and 8 Inner View Objects as part of a series of very limited drops at selected retailers worldwide.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
