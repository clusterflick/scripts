Z1AR\",\"avatar_url\":\"https://images.lumacdn.com/avatars/dr/6d5c397f-795d-4b86-92b9-49669f6d0412.jpg\",\"bio_short\":\"Founded ICI in 2015 to create safe, welcoming spaces for Queer men to connect, be themselves, and share a laugh. I also love Kylie 😜❤️\",\"first_name\":\"Michael\",\"last_name\":\"Zreika\",\"instagram_handle\":\"michaelzreika\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Michael Zreika\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"michaelzreika\",\"website\":null,\"youtube_handle\":\"\"},{\"api_id\":\"usr-Ogj2DmdYzVGWHIj\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_35.png\",\"bio_short\":null,\"first_name\":\"David\",\"last_name\":\"Powell\",\"instagram_handle\":\"davido.ldn\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"David Powell\",\"tiktok_handle\":null,\"timezone\":\"America/New_York\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-qEYcAN0ARFtj8QL\",\"avatar_url\":\"https://images.lumacdn.com/avatars/7n/a815de7d-4d3b-4c30-b2cc-9c87e50f33f7.jpg\",\"bio_short\":null,\"first_name\":\"Robert\",\"last_name\":\"Chisholm\",\"instagram_handle\":\"robmodelling\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Robert Chisholm\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-R1cS2OgCgifINRu\",\"avatar_url\":\"https://images.lumacdn.com/avatars/cx/5f6db13f-63a6-48b4-b923-0aec86fb774f.jpg\",\"bio_short\":\"\",\"first_name\":\"Ian\",\"last_name\":\"Maddox\",\"instagram_handle\":\"NotApplicable\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Ian Maddox\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"},{\"api_id\":\"usr-RGQGVaLuQ9PQMQw\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_15.png\",\"bio_short\":null,\"first_name\":\"Conor\",\"last_name\":\"Sturton\",\"instagram_handle\":\"Conor\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Conor Sturton\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-u0I1aEG1wFt1GkM\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_30.png\",\"bio_short\":null,\"first_name\":\"James\",\"last_name\":\"Upsher\",\"instagram_handle\":\"jamesup84\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"James Upsher\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":false,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟 Refund Policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets are non-refundable unless:\\n• The event is cancelled\\n• The event does not meet minimum numbers\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"🔁 Need to Sell Your Ticket?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"While we set up the new waitlist system on Luma, you can offer your ticket to another member via the ICI WhatsApp group. \",\"type\":\"text\"},{\"text\":\"https://chat.whatsapp.com/JcFYXAeSki31Y7tzWawlSN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/JcFYXAeSki31Y7tzWawlSN\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If someone agrees to take your ticket:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"\\n• Both parties must confirm the transfer\\n• Email \",\"type\":\"text\"},{\"text\":\"admin@itscultureinnit.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:admin@itscultureinnit.com\"}}]},{\"text\":\" with their name and email\\n• We’ll then open up the event for them to book a ticket\\n• Once they’ve completed the purchase, your ticket will be refunded\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Thank you for your support in helping us keep the process smooth, fair, and manageable for everyone.\",\"type\":\"text\"}]}]},\"guest_count\":15,\"ticket_count\":17,\"hosts\":[{\"api_id\":\"usr-EzC0lLGhwxKJdYb\",\"avatar_url\":\"https://images.lumacdn.com/avatars/8i/d25e668f-7b82-4aba-a13a-f31a4863880e.jpg\",\"bio_short\":\"\",\"first_name\":\"It's Culture \",\"last_name\":\"Innit\",\"instagram_handle\":\"itscultureinnit\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"It's Culture Innit\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"itscultureinnit\",\"website\":\"https://www.itscultureinnit.com\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#191a1e\",\"#45383d\",\"#cf221b\",\"#f2ece7\"],\"palette\":{\"neutral\":[{\"color\":\"#191a1e\",\"percentage\":27.68},{\"color\":\"#f2ece7\",\"percentage\":3.62},{\"color\":\"#45383d\",\"percentage\":9.02}],\"vibrant\":[{\"color\":\"#cf221b\",\"percentage\":8.41}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/qn/13bc881e-8d91-4423-a0ae-662a723864d5.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"evtticktyp-Ko9YQJIL19KHLqn\",\"cents\":9200,\"currency\":\"gbp\",\"description\":\"Row A, Seats 10 to 13 and 15 to 18\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cpg0oUqN0dTBmw6\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":8,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"58\",\"name\":\"On Stage Seating Row A\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-06-19T08:00:59.000Z\",\"valid_start_at\":\"2026-06-04T18:00:00.000Z\",\"num_tickets_registered\":8,\"num_guests\":8,\"spots_remaining\":0,\"is_disabled\":true},{\"api_id\":\"evtticktyp-xNaMdkbTKqlShTQ\",\"cents\":9200,\"currency\":\"gbp\",\"description\":\"Row SD, Seats 1, 2, and 5\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cpg0oUqN0dTBmw6\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":2,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"6\",\"name\":\"On Stage Seating Row SD\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-06-19T08:00:59.000Z\",\"valid_start_at\":\"2026-06-04T18:00:00.000Z\",\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":0,\"is_disabled\":true},{\"api_id\":\"evtticktyp-HBYQNGsbMdGl0bA\",\"cents\":7500,\"currency\":\"gbp\",\"description\":\"Row SB, Seats 1 to 7\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cpg0oUqN0dTBmw6\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":7,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"7\",\"name\":\"On Stage Seating Row SB\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-06-19T08:00:59.000Z\",\"valid_start_at\":\"2026-06-04T08:00:00.000Z\",\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":0,\"is_disabled\":true}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":13,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#16161a\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"🎭 Rent the Musical: An Immersive ICI Night Out\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s Culture Innit is still winding down, to become more of a community hub, but when I heard that Rent was returning to the stage in 2026, I knew this was an experience that simply had to be shared with ICI.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rent holds an incredibly vital place in my heart. It was one of the very first musicals I saw when I moved to the UK in the late 1990s, and I later saw it again in Australia.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"At the time, I was used to the massive, traditional productions of the era like Cats, Les Misérables, and The Phantom of the Opera. Rent was something completely different.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It was raw, it was immediate, and it was entirely of its time as we lived through the realities of the HIV/AIDS crisis. It completely changed my understanding of what musical theatre could be, telling the stories of our community with a brilliant, resilient spirit.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The soundtrack is so beautiful that I still listen to it at least once a month, and the power of this production truly has to be seen to be believed.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"ICI has managed to secure a very limited batch of 18 tickets and we will be having an immersive experience with on the stage seating.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The seats are positioned right around the edge of the stage, placing you directly in the heart of the East Village setting.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is an incredibly intimate way to experience the show, though it's worth noting while we will see the actors up close we may be viewing some scenes from the back and side.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"🌟 Event Details\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 Venue: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Duke of York's Theatre, St Martin's Lane, London\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 Date: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Wednesday, 21 October 2026\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🕡 Time:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Meet at 18:45 | Curtain up 19:30\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"⏱ Running time: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Approximately 130 minutes, including one interval\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"🎟 \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Ticket Pricing and Seating Allocation\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Because we are seated directly on the stage, the venue enforces a strict policy: no latecomers will be admitted, and there is no re-admittance if you leave your seat.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please ensure you arrive by 19:00 at the very latest.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🪑On Stage Seating Rows A and SD:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" £92.50\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Seats 10 to 13 and 15 to 18\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🪑On Stage Seating Row SD: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"£75\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"1, 2, and 5\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🪑On Stage Seating Row SB: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"£75\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Row SB, Seats 1 to 7\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📲 Stay Connected: Luma App + ICI WhatsApp\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"To make events run smoother and check-in faster, we now use the Luma app to manage all bookings and event updates.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"✅ Download “Luma: Delightful Events” on the App Store or Google Play\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Apple:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"https://apps.apple.com/gb/app/luma-delightful-events/id1546150895\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://apps.apple.com/gb/app/luma-delightful-events/id1546150895\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Android\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\": \",\"type\":\"text\"},{\"text\":\"https://play.google.com/store/apps/details?id=com.luma.studio\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://play.google.com/store/apps/details?id=com.luma.studio\"}}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Event-specific updates, reminders, changes, and check-in info, will now happen through the \",\"type\":\"text\"},{\"text\":\"built-in Luma chat\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You’ll automatically be added to the conversation for that event.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"💬 \",\"type\":\"text\"},{\"text\":\"Want to chat with others?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join the\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/EHVGIUmlJfn2ZN6T0Gl4MS\"}},{\"type\":\"bold\"}]},{\"text\":\"ICI WhatsApp London Group Chat\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/EHVGIUmlJfn2ZN6T0Gl4MS\"}},{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\"here for casual conversation and community check-ins.\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"ICI-run events only\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Final ticket reminders\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Important announcements\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Gigs, festivals, and concerts\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Classifieds + recommendations\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"General chat + member posts\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your own event shoutouts!\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s a great way to stay connected with the wider ICI community outside of specific events.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"llveefkf\",\"label\":\"What’s your Instagram handle for the group photo tag?\",\"required\":true,\"question_type\":\"instagram\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
