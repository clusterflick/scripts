null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/gw/5e022fae-c72e-490d-a667-77aecebdef60.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-j6a4E4iFNWbo0ac\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-31KDaoDZ8IeHSKY\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":40,\"num_guests\":40,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-tech\",\"description\":\"Join a hackathon, jam on product design, and meet fellow tinkerers in the industry of tomorrow.\",\"event_count\":4069,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/lg/3b7cf2a0-077f-40ca-aab8-1a8d07affbd1.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/v7/3f6baafa-d90d-4013-9853-0fa10331f796.png\",\"name\":\"Tech\",\"page_title\":\"Tech Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/z8/cb71384a-87a9-4be7-bbdf-1c2d6381d872.png\",\"slug\":\"tech\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/1908a653-edb9-431e-8ecf-b4d61249a446.png\",\"subscriber_count\":73356,\"tint_color\":\"#5773CF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":110,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#7b6492\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Monzo Design Hiring Team is hosting an evening to celebrate, empower, and elevate Black talent in Design and Research.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This event brings together community, honest conversation, and real stories from people building impactful careers in design, research, and creative leadership.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 \",\"type\":\"text\"},{\"text\":\"Date:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 23rd September 2026\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🕣\",\"type\":\"text\"},{\"text\":\" Time: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"5:30 PM - 8:30 PM\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Location:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Monzo’s Event Space, Broadwalk House, 5 Appold St, London EC2A 2AG\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👥 \",\"type\":\"text\"},{\"text\":\"Audience:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Black Design & Research professionals, creators, and leaders\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’re just breaking into design, mastering user research, or leading creative teams, this space is built for you to connect, share, and grow.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our Mission\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"To celebrate Black design talent, spark meaningful connections, and explore how lived experiences shape better design, stronger leadership, and real impact in tech.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to Expect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎤 \",\"type\":\"text\"},{\"text\":\"Panel Talk: Navigating Design & Research as a Black Professional\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A candid discussion on navigating the design industry and using your unique perspective as a strength. We’ll cover:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Navigating career growth and progression in Design and Research\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"How lived experiences shape creative perspectives, leadership, and craft\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bringing authenticity to product development and team culture\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Practical advice on building resilience and carving out your path\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🤝 \",\"type\":\"text\"},{\"text\":\"Food, Music & Networking\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Enjoy great food, a live DJ, and dedicated time to relax and connect with fellow designers, researchers, and industry leaders.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hear unfiltered stories:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Learn directly from Black designers and researchers doing the work.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Gain practical insights:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Pick up actionable career advice on craft, leadership, and progression.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expand your network:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Connect with a supportive community shaping the future of design.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ Come for the conversation. Stay for the community. Leave inspired.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"x10izx2a\",\"label\":\"🔗 LinkedIn Profile\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"5fz8zpgd\",\"label\":\"Submit your questions here for the Q&A\",\"required\":true,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
