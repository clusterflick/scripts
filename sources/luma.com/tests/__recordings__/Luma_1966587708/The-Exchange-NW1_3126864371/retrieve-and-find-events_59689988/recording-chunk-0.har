\":\"Pavandeep Basra\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-yBeWeFofbn7Mdt3\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_24.png\",\"bio_short\":\"\",\"first_name\":\"Chloe\",\"last_name\":\"Hickman\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Chloe Hickman\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-ywKGo6HNEnuB4aB\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_10.png\",\"bio_short\":null,\"first_name\":\"Jana\",\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Jana\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-z36NPEdLHiHwKHE\",\"avatar_url\":\"https://images.lumacdn.com/uploads/23/dd4ee119-44b3-46bc-8cb2-462ff9277476.jpg\",\"bio_short\":\"\",\"first_name\":\"Eleena\",\"last_name\":\"F\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/eleena-fatima\",\"name\":\"Eleena F\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"eleena\",\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you can't attend anymore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via email on team@becomingali.com and we will be able to refund you \",\"type\":\"text\"},{\"text\":\"only\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can find someone on the Waitlist to take your spot. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Please note that if the event has not reached capacity to develop a Waitlist yet, we cannot process any refunds. We also \",\"type\":\"text\"},{\"text\":\"cannot\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" process \",\"type\":\"text\"},{\"text\":\"same-day\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" refunds or waitlist exchanges. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Some events we run are non-refundable due to logistics and this is usually specified in the event description.\",\"type\":\"text\"}]}]},\"guest_count\":49,\"ticket_count\":49,\"hosts\":[{\"api_id\":\"usr-xKBHGQBW3FEjAJr\",\"avatar_url\":\"https://images.lumacdn.com/uploads/do/07282fcd-521f-46b8-919c-eb7bcc73d84f.png\",\"bio_short\":\"\",\"first_name\":\"ABRC\",\"last_name\":\"\",\"instagram_handle\":\"becomingalii\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"ABRC\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#c9592b\",\"#e78f49\",\"#fefefd\"],\"palette\":{\"neutral\":[{\"color\":\"#fefefd\",\"percentage\":8.28}],\"vibrant\":[{\"color\":\"#c9592b\",\"percentage\":14.42},{\"color\":\"#e78f49\",\"percentage\":12.05}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/j0/009b5404-ac1e-484d-9633-d0454d28c628.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-C5wyvJXaxSPmtou\",\"cents\":1500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-RgMNCcCRje5UaFz\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"STANDARD\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":49,\"num_guests\":49,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":1500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#cf6331\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"ABRC\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" (\",\"type\":\"text\"},{\"text\":\"Anti-Brainrot Club\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\") invites you to join a special edition of our monthly bookclub in collaboration with \",\"type\":\"text\"},{\"text\":\"Vintage Classics\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" as we discuss two short fiction books! We will also be joined by the \",\"type\":\"text\"},{\"text\":\"Editor\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" who was involved in the release of both books.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All attendees will be mailed copies of each book and as such the tickets are non-refundable\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". Please read \",\"type\":\"text\"},{\"text\":\"both books\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" in preparation for the event.\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A Short Stay in Hell by Steven L. Peck: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"As a faithful Mormon, Soren Johansson has always believed he’ll be reunited with his loved ones after death in an eternal hereafter. Then, he dies. Soren wakes to find himself cast by a God he has never heard of into a Hell whose dimensions he can barely grasp: a vast library he can only escape from by finding the book that contains the story of his life.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"I Who Have Never Known Men\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"by Jacqueline Harpman\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\": Deep underground, thirty-nine women are kept in isolation in a cage. Watched over by guards, the women have no memory of how they got there, no notion of time, and only vague recollection of their lives before. The fortieth prisoner - sits alone an outcast in the corner. Soon she will show herself to be the key to the others' escape and survival in the strange world that awaits them above ground.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will reflect on the common themes, pick favourites, extract lessons, and (of course) socialise in this fun, nerdy evening!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"____________________________\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"ANTI-BRAINROT CLUB (ABRC) is a creative and intellectual community for those who want to get off their phones, meet like-minded people, and build interesting lives!\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Disclaimers:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All information provided by attendees will remain confidential and protected, and will only be shared with Vintage Classics for the delivery of the books.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets for this event are non-refundable and we will not be running a Waitlist as we usually do.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"xfgd9d48\",\"label\":\"Full Delivery Address (Street Name, Building & Flat Number, City)\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"dzurott8\",\"label\":\"Postcode\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
