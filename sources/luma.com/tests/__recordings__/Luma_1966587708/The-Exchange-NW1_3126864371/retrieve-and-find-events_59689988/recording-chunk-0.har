:11,\"hosts\":[{\"api_id\":\"usr-ktZ3c7xu9GlaSYK\",\"avatar_url\":\"https://images.lumacdn.com/avatars/ud/49e150dc-7f02-4d9c-81b5-2a1417bf0b78.jpg\",\"bio_short\":\"Founder & CEO at OPEN.MODE\",\"first_name\":\"Neliana\",\"last_name\":\"Fuenmayor\",\"instagram_handle\":\"openmode.io\",\"is_verified\":false,\"linkedin_handle\":\"/in/nelianafuenmayor\",\"name\":\"Neliana Fuenmayor\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"neliana\",\"website\":\"https://www.openmode.io\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#2b1d15\",\"#955438\",\"#f2f1f1\"],\"palette\":{\"neutral\":[{\"color\":\"#2b1d15\",\"percentage\":18.12},{\"color\":\"#f2f1f1\",\"percentage\":4.32}],\"vibrant\":[{\"color\":\"#955438\",\"percentage\":12.52}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/4i/c850fe71-0c97-42ef-90f1-0783d413d3af.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-ovMQq1wfBqGFw3r\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-dmuXgOpJLvsAGKY\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":50,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":11,\"num_guests\":11,\"spots_remaining\":39,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-ai\",\"description\":\"Join a hackathon, learn about LLMs and prompt engineering, or connect with other AI practitioners.\",\"event_count\":4171,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png\",\"name\":\"AI\",\"page_title\":\"AI Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png\",\"slug\":\"ai\",\"social_image_url\":\"https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png\",\"subscriber_count\":102003,\"tint_color\":\"#D96D9B\"},{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":39,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#D69712\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"futura\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"An evening in Shoreditch to see what we have been building at OPEN.MODE: AI Product Passports for the fashion and lifestyle industry. Join us and experience the LIVE DEMO: tap a dress, ask questions and meet the people behind it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For the past year, my team and I have been building OPEN.MODE: AI Product Passports. A passport gives a garment a voice. It tells you where it came from, what it is made of and who made it, in a form that both people and AI assistants can read and trust.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"On Thursday I am bringing the demo out of the laptop and into the room. I will be wearing it. Tap the dress with your phone and see the passport open up.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to expect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A short welcome and the story so far\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A live, hands on demo: tap, scan, ask\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Time to talk, question and challenge\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Afterwards, we walk across the road for drinks\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Good to know\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Spaces are limited, so please register to save your place\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The exact location in Shoreditch is shared once you register\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We are guests of a lovely cafe, so please grab a coffee or tea when you arrive\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Friends, family, and anyone working in fashion, tech and sustainability are very welcome\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Can't wait to see you there!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Neliana Fuenmayor\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Founder & CEO | OPEN.MODE\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"p18ynbfo\",\"label\":\"What world do you work in?\",\"options\":[\"ashion and lifestyle brand\",\"Retail and ecommerce\",\"Technology and AI\",\"Sustainability and supply chain\",\"Investment (angel, VC, family office)\",\"Media and press\",\"Academia, policy and standards\",\"Friend or family, here to cheer\",\"Other\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"bq055vzz\",\"label\":\"What is your role? Job title and company, in your own words\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"4rkjdjoi\",\"label\":\"Anything you want to ask me, or see on the night? Questions, curiosities, challenges: all welcome. I will answer the best ones live.\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"lt0wge1d\",\"label\":\"What is your LinkedIn profile?\",\"required\":false,\"question_type\":\"linkedin\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
