t\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" refunds or waitlist exchanges. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Some events we run are non-refundable due to logistics and this is usually specified in the event description.\",\"type\":\"text\"}]}]},\"guest_count\":67,\"ticket_count\":67,\"hosts\":[{\"api_id\":\"usr-xKBHGQBW3FEjAJr\",\"avatar_url\":\"https://images.lumacdn.com/uploads/do/07282fcd-521f-46b8-919c-eb7bcc73d84f.png\",\"bio_short\":\"\",\"first_name\":\"ABRC\",\"last_name\":\"\",\"instagram_handle\":\"becomingalii\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"ABRC\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#111210\",\"#23261e\",\"#fdfefd\"],\"palette\":{\"neutral\":[{\"color\":\"#0c0e0d\",\"percentage\":17.07},{\"color\":\"#161714\",\"percentage\":12.7},{\"color\":\"#23261e\",\"percentage\":12.54},{\"color\":\"#fdfefd\",\"percentage\":9.01}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/78/b9a96f45-3039-41f5-8c87-9b049f48af1e.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-BLkW4QR1KztFw4V\",\"cents\":1550,\"currency\":\"gbp\",\"description\":\"No snacks included (No external food/drinks allowed but you can purchase at the venue)!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cETDdF75bn4X9Of\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"STANDARD\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":49,\"num_guests\":49,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-YNM2jb9Eg9PtmiI\",\"cents\":2250,\"currency\":\"gbp\",\"description\":\"Small popcorn + ice cream + bottle of water included in your ticket!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-cETDdF75bn4X9Of\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"98\",\"name\":\"STANDARD + SNACKS\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":18,\"num_guests\":18,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1550,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":2250,\"currency\":\"gbp\"},\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#222720\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"ABRC (Anti-Brainrot Club)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is welcoming the colder months with an iconic screening of the first \",\"type\":\"text\"},{\"text\":\"two episodes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" of \",\"type\":\"text\"},{\"text\":\"The Vampire Diaries\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"! We're heading to Mystic Falls for the evening at a private cinema venue in Soho, so come alone or bring a friend for this cozy ride!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The screening will begin at 7:00 PM\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" but you may arrive from 6:30 PM to the lobby/reception area to socialise with the community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please note that the venue does \",\"type\":\"text\"},{\"text\":\"not\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" allow external food/drinks, but you may purchase on-site or opt for the optional discounted snack package that includes a small popcorn bag (salty or sweet), mini ice cream, and a bottle of water. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"ANTI-BRAINROT CLUB (ABRC) is a creative and intellectual community for those who want to get off their phones, meet like-minded people, and build interesting lives!\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"______________________________________\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Disclaimers:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you join the Waitlist, \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"there will be a \",\"type\":\"text\"},{\"text\":\"temporary charge\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" on your card which will be released if you are not approved for the event. This is Luma's policy and we do not have access to these funds.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"If you can't attend anymore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via email on team@becomingali.com and we will be able to refund you \",\"type\":\"text\"},{\"text\":\"only\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can find someone on the Waitlist to take your spot. \",\"type\":\"text\"},{\"text\":\"We cannot process same-day refunds or waitlist exchanges\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"olyq2gj1\",\"label\":\"What flavour POPCORN would you like? You only need to fill this in if you're getting a STANDARD + SNACKS ticket.\",\"options\":[\"SALTY\",\"SWEET\"],\"required\":false,\"question_type\":\"dropdown\"},{\"id\":\"8q6hoch6\",\"label\":\"What flavour ICE CREAM would you like? You only need to fill this in if you're getting a STANDARD + SNACKS ticket.\",\"options\":[\"VANILLA\",\"CHOCOLATE\",\"STRAWBERRY\"],\"required\":false,\"question_type\":\"dropdown\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"m