"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#ffcccc\",\"color2\":\"#fffbcc\",\"color3\":\"#ddf3d8\"},\"tint_color\":\"#e6d300\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"We Go Way Back | Discover how ancient ancestors live on in our DN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://gbr01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fwww.crick.ac.uk%2Fwhats-on%2Fexhibitions%2Fwe-go-way-back&data=05%7C02%7CLucy.Young%40knowledgequarter.london%7C6c0ceadfa8dc4da7252208dee7e3f854%7Cee0e2644f2714f28b73c325b6f259af9%7C0%7C0%7C639203163488012308%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=eG6PGjKBI3SKtwUy4HB8oa4eztmgDCiTrq7MDx5qsoA%3D&reserved=0\"}}]},{\"text\":\"A\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.crick.ac.uk/whats-on/exhibitions/we-go-way-back\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unlock the secrets hidden in our DNA and discover the extraordinary story of humanity in this new multi-sensory exhibition at the one of the world’s largest bio-medical labs.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Journey through time and discover how revolutionary ancient DNA research reveals the deep connections that link us all – across centuries, continents and cultures.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The exhibition tour will be led by esteemed gallery curator, \",\"type\":\"text\"},{\"text\":\"Kat Nilsson\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.linkedin.com/in/kat-nilsson-she-they-9931238/\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Key Details:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Date: Thursday 24 September\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Time: 08:30 - 10:00\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location: The Francis Crick Institute, NW1\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About the Knowledge Quarter\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Knowledge Quarter is an innovation district at the heart of King’s Cross, bringing together world‑leading research institutes, cultural organisations, community groups and cutting‑edge businesses within a one‑mile radius.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Partners include the British Library, the British Museum, Central Saint Martins, Google DeepMind, the Institute of Physics, UCL and Wellcome, all united by a commitment to creating and sharing knowledge.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Knowledge Quarter connects these institutions to drive collaboration, showcase collective strengths and ensure local residents can access and benefit from the district’s resources.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Stay in the loop\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Instagram\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://instagram.com/knowledgequarter\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"LinkedIn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://linkedin.com/company/knowledgequarter\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Subscribe to our newsletter\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://gbr01.safelinks.protection.outlook.com/?url=https%3A%2F%2Fknowledgequarter.createsend.com%2Fh%2Ft%2F8E7ABB84DA6BDB3A%2Fpreview%2F638769652074818623&data=05%7C02%7CLucy.Young%40knowledgequarter.london%7C246502b17f7e4851489408de70985322%7Cee0e2644f2714f28b73c325b6f259af9%7C0%7C0%7C639071996686630559%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=FS3Emw4LyGqqMl4MG0tb1Z0Kt557VsVZcPnA2AvtwvQ%3D&reserved=0\"}}]}]}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"k24xy7el\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"addb28hv\",\"label\":\"How did you hear about this event?\",\"options\":[\"KQ Newsletter\",\"Instagram\",\"Through your Employer\",\"Google Search\",\"Through a Friend/Colleague\",\"Don't Know\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"oosvrfkq\",\"label\":\"By ticking this box, I understand photographs will be taken at the event.\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"xwqch7ah\",\"label\":\"I would like to join Knowledge Quarter's mailing list and receive updates on upcoming events and news about the area. I agree to have my Knowledge Quarter newsletter subscriber activity tracked to improve the quality of content I receive. I agree to Knowledge Quarter's privacy policy and understand I can unsubscribe at any time.\",\"required\":false,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_mana