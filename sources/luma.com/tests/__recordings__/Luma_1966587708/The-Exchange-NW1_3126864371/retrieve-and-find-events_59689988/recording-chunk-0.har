table Donation supporting \\nhomelessness charity Depaul UK\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-XoFhwQORvWwPx9L\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":15,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"99\",\"name\":\"Patron Ticket incl. Donation\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":12,\"num_guests\":12,\"spots_remaining\":3,\"is_disabled\":false},{\"api_id\":\"ttype-JRhtE9FP9wvqyMI\",\"cents\":7500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-XoFhwQORvWwPx9L\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":16,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"995\",\"name\":\"Final Release |Standard Ticket\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":16,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":6500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":7500,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":20,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#030101\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A monument disappeared. For nearly three decades, its story was almost forgotten. On 28 October, we bring it back to life...\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rescuing Chopin in London - A Story That Found Its Way Home\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is an original cultural production combining \",\"type\":\"text\"},{\"text\":\"live music, theatre and historical storytelling\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" to reveal the remarkable true story of Chopin's London legacy and the lost memorial that eventually found its way home.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For one evening, the National Liberal Club will bring together around \",\"type\":\"text\"},{\"text\":\"100 guests from the worlds of culture, diplomacy, business and the arts\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" for an intimate performance followed by a reception with the artists and guests.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The evening will welcome a number of distinguished Guests of Honour, including Rafał Wiśniewski, Chargé d’affaires a.i. of the Republic of Poland in the United Kingdom.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"An Original Production by Business Social Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Business Social Club's first original cultural production -bringing its distinctive approach to experiences into \",\"type\":\"text\"},{\"text\":\"music, theatre and storytelling\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Produced & Directed by Renata Kaminska, Founder of Business Social Club by Kamreno.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"More Than a Concert\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Live piano, violin, voice and theatre bring to life the extraordinary journey of Chopin's lost London memorial.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Presented to Britain by Poland in 1975, the monument disappeared for years before being rediscovered beneath Waterloo Bridge. Through the determination of \",\"type\":\"text\"},{\"text\":\"Dr Marek Stella-Sawicki\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", it eventually returned to public view at Southbank Centre.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A story of music, memory, British–Polish friendship and determination.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/0w/2b635356-5a43-4a05-81da-24b44ee11258.png\",\"width\":1098,\"height\":325,\"image_id\":\"local-upload-blob:https://luma.com/fe6c5109-d94f-48f4-bb67-97f640c276bf\",\"mime_type\":null,\"uploaded_at\":\"2026-07-18T16:58:39.739+01:00\",\"is_uploading\":false,\"resize_width\":613.75}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Renowned Concert Pianist - Artur Haftman\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The evening will be led by\",\"type\":\"text\"},{\"text\":\" Artur Haftman\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", an acclaimed Polish concert pianist celebrated for his interpretations of Chopin and the Romantic repertoire. Performing internationally in prestigious concert halls and festivals, he combines technical brilliance with remarkable emotional depth.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":\"User Uploaded Image\",\"src\":\"https://images.lumacdn.com/cdn-cgi/image/format=auto,fit=cover,dpr=2,quality=75,width=471/uploads/4r/96c265a9-6258-4754-9f05-858ba5819688.jpg\",\"width\":null,\"height\":null,\"image_id\":null,\"mime_type\":null,\"uploaded_at\":null,\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Special Guest Vocalist - Maja Walentynowicz\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Maja Walentynowicz\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", finalist of the 14th edition of \",\"type\":\"text\"},{\"text\":\"The Voice of Poland\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", brings her distinctive voice and expressive stage presence to the production.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/qp/afa38bf9-9b1f-4fc7-b3b8-0063c0950ac7.png\",\"width\":1537,\"height\":1023,\"image_id\":\"local-upload-blob:https://luma.com/d934cc68-653f-4c0a-8a9e-9abb6b2b0edd\",\"mime_type\":null,\"uploaded_at\":\"2026-07-18T16:44:12.489+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Special Guest Violinist - Georgina Biddle\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Georgina Biddle\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", violinist and keyboard player with British folk-metal band Skyclad, joins the evening for a special guest performance, bringing a distinctive musical dimension to the production.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/sl/e2b7b930-431b-4141-96a5-1b1216d4560e.jpg\",\"width\":543,\"height\":384,\"image_id\":\"local-upload-blob:https://luma.com/083c9e8f-60c6-42e3-91cf-cc2543646253\",\"mime_type\":null,\"uploaded_at\":\"2026-09-06T21:11:54.248+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"A Lost Waltz, Reimagined\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Georgina Biddle and Artur Haftman\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" will perform a specially created violin and piano arrangement of Chopin's recently discovered waltz - \",\"type\":\"text\"},{\"text\":\"believed to be its first public performance in this form\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A long-lost composition meets the story of a long-lost monument.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"From Cardboard City to Today\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The story also returns beneath Waterloo to \",\"type\":\"text\"},{\"text\":\"Cardboard City\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", the homeless community that once existed there. A specially arranged interpretation of Skyclad's \",\"type\":\"text\"},{\"text\":\"Cardboard City\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" connects this chapter of London's past with our support for \",\"type\":\"text\"},{\"text\":\"Depaul UK\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" today.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"The Narrators - Solenn Mara-Lewis & German Segal\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Solenn Mara-Lewis\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a French television and theatre actress trained at the Royal Central School of Speech and Drama, joins \",\"type\":\"text\"},{\"text\":\"German Segal\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a film, television and stage actor who studied at the Moscow Art Theatre School.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Together, they guide the audience through the story, bringing its characters, history and unexpected turns to life through theatrical narration.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/o4/72b90082-98e5-4862-ae3f-ee2a2a2ff9eb.png\",\"width\":1774,\"height\":887,\"image_id\":\"local-upload-blob:https://luma.com/63c3214d-84e1-41ac-8dfd-1a529f190fd8\",\"mime_type\":null,\"uploaded_at\":\"2026-09-06T21:37:15.341+01:00\",\"is_uploading\":false,\"resize_width\":519.328125}},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"The story behind the event\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The WP Times recently featured the remarkable history that inspired \",\"type\":\"text\"},{\"text\":\"Rescuing Chopin in London\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\". You can read the article here: \",\"type\":\"text\"},{\"text\":\"[\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"WP Times link\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://westminsterpimliconews.co.uk/londons-lost-chopin-monument-returns-for-one-night-only/\"}},{\"type\":\"bold\"}]},{\"text\":\"]\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/nu/7068dc06-979c-49f1-9720-3442a6d9d0f1.png\",\"width\":1254,\"height\":1254,\"image_id\":\"local-upload-blob:https://luma.com/87b961ef-99bb-41fd-8aa0-c42d135716eb\",\"mime_type\":null,\"uploaded_at\":\"2026-07-18T16:49:17.687+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dress Code: Elegant / Cocktail Attire\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Cocktail and evening dresses, elegant separates, suits and jackets are encouraged.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Evening Programme\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:45 PM – Welcome Reception\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Drinks and conversation before the performance.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:30 PM – Rescuing Chopin in London\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"A 90-minute journey through live music, theatre, history and storytelling.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"9:00 PM – Meet the Artists & Reception\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Drinks, conversation and an opportunity to meet the performers.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"10:30 PM – Event Concludes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A unique evening where music rescues history… and history finds its way home.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/h7/e4278613-331b-46cd-8845-46837619903a.png\",\"width\":1717,\"height\":916,\"image_id\":\"local-upload-blob:https://luma.com/97708dd4-f7ab-47d7-a545-c4ea15daeb65\",\"mime_type\":null,\"uploaded_at\":\"2026-09-02T12:57:10.031+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/6h/700b484d-fc04-401b-b083-eaf4cd1430e3.png\",\"width\":2172,\"height\":724,\"image_id\":\"local-upload-blob:https://luma.com/608e8302-fdb3-4812-918a-4fa219d3e56c\",\"mime_type\":null,\"uploaded_at\":\"2026-09-21T17:43:24.489+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Supporting Charity Depaul UK\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We are proud to support Depaul UK, a partnering charity of Homewards, the initiative founded by Prince William through The Royal Foundation. The partnership connects the story of Cardboard City featured in our production with meaningful support for people experiencing homelessness today.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/oa/a8dc0a82-f4b0-4d7d-84f6-beb5cd2b5819.png\",\"width\":289,\"height\":124,\"image_id\":\"local-upload-blob:https://luma.com/aade30e8-e3ea-4ed0-8437-b5494e5c57ad\",\"mime_type\":null,\"uploaded_at\":\"2026-08-13T17:25:27.266+01:00\",\"is_uploading\":false,\"resize_width\":200}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Guests can support Depaul UK by choosing a \",\"type\":\"text\"},{\"text\":\"ticket including a charitable donation\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" or donating directly through our dedicated \",\"type\":\"text\"},{\"text\":\"fundraising page\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://donate.depaul.org.uk/?campaign=RescuingChopin\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/bi/e4f9ba2c-1e73-41c6-a3ed-f8c295b309f4.png\",\"width\":1536,\"height\":1024,\"image_id\":\"local-upload-blob:https://luma.com/708b73f6-b658-4e0d-bde6-0b0809dd6045\",\"mime_type\":null,\"uploaded_at\":\"2026-09-10T16:39:36.137+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"How ticketing works\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Choose your preferred \",\"type\":\"text\"},{\"text\":\"ticket type\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and complete your booking through Luma.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Once your purchase is confirmed, you will receive a \",\"type\":\"text\"},{\"text\":\"confirmation email from Luma\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", with the option to add the event directly to your calendar. Please check your \",\"type\":\"text\"},{\"text\":\"spam/junk folder\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if you don’t see it in your inbox.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Luma may also send automatic event reminders as the date approaches.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Approximately \",\"type\":\"text\"},{\"text\":\"one week before the event\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", you will receive a separate email from us with all the practical details for the evening, including arrival information, timings and anything else you need to know.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No need to print your ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - your booking will be on our guest list\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ticket Policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All ticket sales are final and non-refundable. If you can no longer attend, your ticket may be transferred to another person by notifying us in advance. Please check the event date and details carefully before purchasing.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
