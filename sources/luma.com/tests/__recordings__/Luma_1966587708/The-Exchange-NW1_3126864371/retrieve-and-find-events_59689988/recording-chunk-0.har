11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png\",\"subscriber_count\":11169,\"tint_color\":\"#60AD57\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":45,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#181f1d\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"An exclusive sustainability breakfast briefing for senior fashion leaders, hosted by Seismic in partnership BBC StoryWorks and the Global Fashion Agenda.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The morning will open with a special screening of short films from BBC's acclaimed Fashion Redressed series. From there, a panel of brands featured in the films will unpack what it actually takes to turn ambition into impact, before the session moves into a practical roundtable, helping attendees find their own next step forward.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Date & Time:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Tuesday, 6th October 2026, 08:15–11:00am BST\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Location:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Events Hub, Sustainable Ventures, Waterloo, London\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"k1v2cf5r\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"khq0cie5\",\"label\":\"Data Notice: As the hosts of this event, Seismic will collect your registration details (name, email, company, and job role) to manage your attendance and send you post-event resources. This is necessary for us to process your registration and is not optional. You can view our full privacy policy at www.seismic-change.com/privacy-policy/  We'd also love to keep you updated on future events, and to share your details with our co-hosts, Global Fashion Agenda (GFA) and BBC StoryWorks, so they can send you related follow-up communications too. Both are optional, and you can opt out at any time. You can view their privacy policies here: https://globalfashionagenda.org/privacy-policy/ and https://www.bbcstudios.com/privacy\",\"options\":[\"Yes, I'd like to hear from Seismic about future events and updates like this one\",\"Yes, share my details with GFA and BBC StoryWorks so they can send me related follow-up communications and updates about future events and talks\"],\"required\":false,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
