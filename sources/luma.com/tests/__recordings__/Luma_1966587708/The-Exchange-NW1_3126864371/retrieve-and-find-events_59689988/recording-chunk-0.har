name\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refunds are not accepted at this time. We apologise for any inconvenience this may cause.\",\"type\":\"text\"}]}]},\"guest_count\":32,\"ticket_count\":34,\"hosts\":[{\"api_id\":\"usr-nlyYe2tjSkG1FiH\",\"avatar_url\":\"https://images.lumacdn.com/uploads/d6/8358584f-13b9-4649-949a-e63db48f2bb6.jpg\",\"bio_short\":\"\",\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Korean Film Club\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#eae5df\",\"#cf3107\",\"#203870\",\"#486882\"],\"palette\":{\"neutral\":[{\"color\":\"#203870\",\"percentage\":2.74},{\"color\":\"#eae5df\",\"percentage\":77.95}],\"vibrant\":[{\"color\":\"#cf3107\",\"percentage\":4.96},{\"color\":\"#486882\",\"percentage\":0.69}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/55/9224ed86-748a-47c3-a3dc-44a1afaf5766.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-Mdpnx43gH9RLpFE\",\"cents\":1300,\"currency\":\"gbp\",\"description\":\"(incl. 1 welcome wine (red/white) or soda)\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-g013unoub5mSyir\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard Entry\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":\"2026-09-15T08:00:00.000Z\",\"num_tickets_registered\":20,\"num_guests\":20,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-QQfvdnKJ6nsKvCT\",\"cents\":2500,\"currency\":\"gbp\",\"description\":\"Entry + your choice of kimbap, cup ramyeon, hard-boiled egg, and 1 glass of artisan makgeolli\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-g013unoub5mSyir\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"85\",\"name\":\"Entry + Food & Makgeolli\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-09-23T22:59:59.000Z\",\"valid_start_at\":\"2026-09-15T08:00:00.000Z\",\"num_tickets_registered\":9,\"num_guests\":9,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-IX6QBE97EILWfBp\",\"cents\":2100,\"currency\":\"gbp\",\"description\":\"Entry + your choice of kimbap, cup ramyeon, hard-boiled egg, and 1 bottle of purple corn tea (non-alcoholic)\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-g013unoub5mSyir\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"Entry + Food & Corn Tea\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":\"2026-09-23T22:59:59.000Z\",\"valid_start_at\":\"2026-09-15T08:00:00.000Z\",\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1300,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":2500,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#e9e4df\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Seoul. 1970's. Music dabangs are rising in popularity, providing spaces for young people to meet, drink, and listen to vinyl records at a time when the authoritarian government tightly censored popular music and banned hundreds of songs.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This September, Korean Film Club invites you to our own dabang in central London. Immerse yourself in this historically significant Korean film from the 1970's, along with popular music, food, and drinks of the time. This comedy film will remain a mystery until you arrive, but rest assured that Dr. Callum Sol Morrissey will provide the historical and cultural context you need before the film screening. After the screening, we will discuss the film with your host Lia Lee and Dr. Morrissey there to guide the discussion and answer questions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will have limited amounts of artisan, locally made makgeolli (Korean rice wine) from SOOLDOGA. If you've never had it before, now's the perfect chance! We recommend pre-ordering with your ticket for the best price :)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"*\",\"type\":\"text\"},{\"text\":\"Please review the menu below to select your appropriate ticket and for allergen information.*\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"attachment\",\"attrs\":{\"file_url\":\"https://images.lumacdn.com/uploads/pj/67bc87e6-a2b5-42bf-9684-a152a8c51da8.pdf\",\"file_name\":\"PRE-ORDER MENU.pdf\",\"mime_type\":\"application/pdf\",\"file_size_bytes\":615718,\"uploader_user_api_id\":\"usr-nlyYe2tjSkG1FiH\"}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your ticket for this event not only supports Korean Film Club in continuing to bring more Korean films to UK audiences but also supports the charity \",\"type\":\"text\"},{\"text\":\"ThreadAhead\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://threadahead.org/\"}}]},{\"text\":\", whose work reduces the climate impacts of the fashion industry and increases access to clothing for refugees and asylum seekers.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"EVENT ORDER:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6 PM - Doors Open\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:40 PM - Film Introduction\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:45 PM - Lecture by Dr. Callum Sol Morrissey\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7 PM - Film Screening\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"8:45 PM - Discussion & Mingling\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"10 PM - Good night!\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photos and videos will be taken throughout this event. Please let us know if you do not wish to be in any marketing materials.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"lbinz89y\",\"label\":\"What cup ramyeon would you like?\",\"options\":[\"Shin Ramyeon (spicy)\",\"Nongshim Veggie (no spice)\",\"NO PRE-ORDER\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"4erunb3z\",\"label\":\"What kimbap would you like?\",\"options\":[\"Original\",\"Bulgogi\",\"Kimchi (vegetarian)\",\"NO PRE-ORDER\"],\"required\":true,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":true,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
