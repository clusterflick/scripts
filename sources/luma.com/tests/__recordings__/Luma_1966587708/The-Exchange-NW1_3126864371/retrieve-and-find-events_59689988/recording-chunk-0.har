":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/1q/c8361b72-da39-4ddc-821d-4faa5d2dd9bf.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-hV1v5YDz6eQGzcP\",\"cents\":3000,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-Fszlb5S6fOdQeBa\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":9,\"num_guests\":9,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":3000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":11,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#8f06c6\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Curious to try life drawing? Keen to start drawing again? Looking for a new way to get creative, have fun with friends, or a memorable date night? \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for an informal life drawing class, great for all capabilities - beginners and experienced sketchers all welcome. Due to the nature of life drawing, this is only for people aged 18 plus.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ticket includes a glass of Fizz (non-alc options available) on arrival. \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All materials provided, but you are very welcome to bring your own.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The session will run from 7-9pm, but you are welcome to get there for a drink downstairs beforehand.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The event will be hosted in the Private Room above The Snooty Fox - there will be a break for you to get drinks and snacks. The menu is great, so grab a bit before or after the event - or stick around for drinks after the event!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For more information, please don't hesitate to get in touch.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"PLEASE NOTE: Tickets are not refundable.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
