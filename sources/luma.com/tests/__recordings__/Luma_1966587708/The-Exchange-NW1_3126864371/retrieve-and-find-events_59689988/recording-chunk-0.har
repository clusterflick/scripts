irst_name\":\"Caley\",\"last_name\":\"Routledge\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"The Boys Book Club\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#10121b\",\"#514746\",\"#927e6e\",\"#cac9c4\"],\"palette\":{\"neutral\":[{\"color\":\"#10121b\",\"percentage\":16.1},{\"color\":\"#cac9c4\",\"percentage\":8.71},{\"color\":\"#514746\",\"percentage\":14.15}],\"vibrant\":[{\"color\":\"#927e6e\",\"percentage\":9.46},{\"color\":\"#71a5cb\",\"percentage\":0.78}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/q6/bb8c3a72-ecfe-4232-ae08-f9d370f21102.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-lB8XBiD7yWef9nW\",\"cents\":3200,\"currency\":\"gbp\",\"description\":\"This ticket includes a coffee during the read-in, a bookmark, and meat platter roast.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-3tOOUClckN6ytFN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":10,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"5\",\"name\":\"Read-In & Roast\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":8,\"is_disabled\":false},{\"api_id\":\"ttype-tzW61nGOsd397Uj\",\"cents\":2100,\"currency\":\"gbp\",\"description\":\"Alternative to the roast - please check event details for more\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-3tOOUClckN6ytFN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":10,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"6\",\"name\":\"Read-In & Vegi Main\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":10,\"is_disabled\":false},{\"api_id\":\"ttype-1TbxEkGZFoCwtlo\",\"cents\":600,\"currency\":\"gbp\",\"description\":\"This ticket includes a coffee during the read-in, and a bookmark!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-3tOOUClckN6ytFN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":30,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Read-In (Coffee & Bookmark)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":29,\"is_disabled\":false},{\"api_id\":\"ttype-FE3SV8UU5EZbEDW\",\"cents\":100,\"currency\":\"gbp\",\"description\":\"This ticket is for those who want to come along but don't want a coffee (or bookmark).\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-3tOOUClckN6ytFN\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"Read-In (No Coffee/ Bookmark)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":100,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":3200,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":26,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#927e6e\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're back at The Hoxton for another Performative Read-In. Bring a book to read, whatever’s on your shelf, and join us for a coffee, chat, and a few hours of casual reading.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you fancy making it a truly perfect Sunday, stick around afterwards and join us for a roast (dinner - no sick burns will be levelled at you). \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"We'll be experiencing The Hoxton's collaboration with ACME Fire Cult, with chef Andrew Clarke and the team taking over the menu. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"You can read more about this here: \",\"type\":\"text\"},{\"text\":\"https://www.sevenrooms.com/experiences/rondohoxton/rondo-residencies-4684776700231680\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.sevenrooms.com/experiences/rondohoxton/rondo-residencies-4684776700231680\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Run-of-Show\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Read-In: 10:30 - 12:30\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Roast: 12:30 - 14:00\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets & Details\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets to just the 'Read-In' are £6 and include a coffee and a boys' book club bookmark. You can also book a £1 ticket, however, you won't be able to order a coffee on the day as The Hoxton team need us to order via a tab or things get unruly. You'll also receive no bookmark, and that's the real tragedy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets to the 'Read-In & Roast' are £32 and include the meat platter roast, a coffee during the read-in and a boys' book club bookmark. Spots are limited, so we recommend booking early (we'll operate a waitlist after we hit capacity).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A vegetarian main is available as an alternative, however, it is not a roast - it is: Adobo King Oysters, charred corn, tomatillo salsa. To book this, please select the vegetarian ticket, priced at £21 and also includes the coffee and bookmark.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drinks/ starters/ sides/ desserts are not included as part of the roast and will need to be ordered and paid for separately. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Unfortunately, on this occasion we can't coordinate any further dietary constraints. More details on the menu can be found via the link above. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Refunds\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"We're unable to offer refunds for this event, so bookings are final. If you can't make it, let us know, and we'll do our best to fill your spot and then a hold a space for you at our next event, but we can't guarantee this transferability.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"928fqb19\",\"label\":\"Have you been to one of our events before?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
