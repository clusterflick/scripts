            "mimeType": "application/json; charset=utf-8",
            "text": "{\"api_id\":\"evt-DNTY2Imc7FM12oK\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-UUmdV32Et0AKggH\",\"avatar_url\":\"https://images.lumacdn.com/calendars/c8/20ca92e5-a0f2-4ceb-bfa7-71f7d4013d62\",\"coordinate\":{\"longitude\":-0.127586,\"latitude\":51.507218},\"cover_image_url\":\"https://images.lumacdn.com/calendar-cover-images/16/d6d6add8-b53e-4d97-b5b4-76fc2cbc98fe.png\",\"description_short\":\"Aulas de Dança brasileira toda semana\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"braziliandanceuk\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJdd4hrwug2EcRmSrV3Vo6llI\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"free\",\"luma_plus_active\":false,\"meta_pixel_id\":null,\"name\":\"Brazilian Dance Academy UK\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"BRAZILIAN DANCE ACADEMY UK\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Membership Plan\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Classes de Dança Brasileira em Londres\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"www.braziliandance.co.uk\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://www.braziliandance.co.uk\"}}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"MEMBERSHIP – Brazilian Dance Academy UK (English)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟️ Ticket Membership Description:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Enjoy more freedom and flexibility with our new \",\"type\":\"text\"},{\"text\":\"BDA Membership\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"This monthly pass gives you access to up to \",\"type\":\"text\"},{\"text\":\"4 Brazilian Dance sessions\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" across our locations in London.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"💃 What’s included?\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"4 credits = 4 one-hour classes (each class = 1 credit)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Valid for 30 days from the date of first use\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Credits can be used for any Brazilian Dance class: indoor, pop-up, or outdoor (subject to availability)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Missed a class? No problem! You can reschedule it for free by selecting the \",\"type\":\"text\"},{\"text\":\"“Free/Make-up Class”\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" ticket on the website and requesting approval by the day of the session.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 Class Locations:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Danceworks Mayfair\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pineapple Studios (Covent Garden)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Manor House Studios (Camden)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unit 3 (South London – Oval)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📝 How to use:\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Purchase your Membership on our website\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Register for classes using the \",\"type\":\"text\"},{\"text\":\"“Member” ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you need to reschedule, choose the \",\"type\":\"text\"},{\"text\":\"“Free/Make-up Class”\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" option and await team approval\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Show up, dance, and enjoy your credits!\",\"type\":\"text\"}]}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎟️ Ticket Examples (Included in Membership):\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"POP-UP Class\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📍 Danceworks Mayfair – 🗓 Tuesday, 12th August – ⏰ 8PM–9PM\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"POP-UP Class\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📍 Danceworks Mayfair – 🗓 Tuesday, 19th August – ⏰ 8PM–9PM\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"POP-UP Class\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📍 Danceworks Mayfair – 🗓 Tuesday, 26th August – ⏰ 8PM–9PM\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Outdoor Session (TBC)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"📍 South or North London – 🗓 Sept or Oct – ⏰ 5:30PM–7PM (90 min)\",\"type\":\"text\"}]}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🔁 Reschedule & Usage Terms:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"You may reschedule any missed class by reporting your absence the same day and selecting the “Free/Make-up” ticket.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rescheduled classes are subject to space availability and BDA team approval.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unused credits \",\"type\":\"text\"},{\"text\":\"expire 30 days\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" after the first used class.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Credits are \",\"type\":\"text\"},{\"text\":\"non-refundable\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"non-transferable\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", but may be used for pop-up or open-air sessions.\",\"type\":\"text\"}]}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📃 Refund & Ticket Policy:\",\"type\":\"text\