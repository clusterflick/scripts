raph\",\"content\":[{\"text\":\"⏱️ Event Schedule\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Part 1: The Pitch Showcase (Chelsea welcomes BFI film makers and investors)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Door Opening & Welcome\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Filmmaker Lightning Round:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 8 Filmmakers | 1-Minute Pitches\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ecosystem Spotlight:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 5 Industry & Tech Providers | 5-Minute Pitches\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Investor & Capital Pitch:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 5 Investors & Funds | 5-Minute Pitches\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Closing Remarks\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Part 2: Private Dining & VIP Networking (Sloane Square)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Private 3-Course Dinner:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Seated dining with sit down meal for more intimate time and partnerships.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📋 Attendance & Dress Code\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Access:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Approved booked Luma Registration.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dress Code:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Elegant Attire (In keeping with The Sloane Club guidelines). Look glamorous!\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please note: Space for the private dinner is strictly limited and needs booking. A digital pitch directory will be shared with all attendees prior to the event.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"6v8rwuc5\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"25mkq4qn\",\"label\":\"What is your Instagram username?\",\"required\":true,\"question_type\":\"instagram\"},{\"id\":\"tm7umfpx\",\"label\":\"IMDB\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"h6h4aypr\",\"label\":\"Describe your connestion to film\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"pmjsvjpt\",\"label\":\"What is your involvement with the BFI festival\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"dnf914lu\",\"label\":\"What festivals will you attend in the year ahead\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"198ku48k\",\"label\":\"Terms and Conditions\",\"terms\":{\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"I agree to be photographed and the information used by the organisers\",\"type\":\"text\"}]}]},\"content_type\":\"text\",\"require_review\":true,\"collect_sig