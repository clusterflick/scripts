\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#080808\",\"#abc0c7\",\"#e8e9e6\",\"#9c7b63\"],\"palette\":{\"neutral\":[{\"color\":\"#080808\",\"percentage\":21.74},{\"color\":\"#e8e9e6\",\"percentage\":7.91}],\"vibrant\":[{\"color\":\"#9c7b63\",\"percentage\":4.27},{\"color\":\"#abc0c7\",\"percentage\":15.05}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/yy/7db6e2c6-668e-441b-9442-6be10f07e3d8.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-gOsO2aB5082af1J\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-IjgS7buNkPGGqwg\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":8,\"num_guests\":8,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":12,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"falling-leaves\"},\"tint_color\":\"#aabec6\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Switch off the screen and pick up a pen.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The digital world is loud and constant, so we are heading to a cafe to focus on the simple act of journaling.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is an afternoon dedicated to reclaiming our attention and putting our real thoughts onto real paper.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you are a lifelong journaler or have not picked up a pen since school, this is a space to clear your head and reconnect with yourself in the real world.\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📵 \",\"type\":\"text\"},{\"text\":\"Disconnect to Reconnect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" We will gather at the cafe t to switch off our devices and tuck them away.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🖋️ \",\"type\":\"text\"},{\"text\":\"Guided Flow:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" I will share a few optional prompts to get the ink moving, and the first hour is yours to write, doodle, or simply observe your thoughts.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🌿 \",\"type\":\"text\"},{\"text\":\"Gentle Reflection:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" In the last hour, we'll have the opportunity to reflect together, share, and read snippets of our journals (if you choose to!) with the group.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎒 \",\"type\":\"text\"},{\"text\":\"What to Pack:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Please bring a physical journal and your favorite pen.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come as you are and leave with a clearer mind and a fuller journal.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Offline Women\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://offlinewomen.org/?utm_source=luma\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Luma\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://luma.com/offlinewomen\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"WhatsApp\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://whatsapp.com/channel/0029VbCZyvCD38CTaXBpQ72V?utm_source=luma\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"LinkedIn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.linkedin.com/company/offline-women/?utm_source=luma\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
