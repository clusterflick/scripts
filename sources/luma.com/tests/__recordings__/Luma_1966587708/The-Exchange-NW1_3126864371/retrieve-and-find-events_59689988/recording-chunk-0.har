d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":300,\"currency\":\"gbp\",\"min_cents\":0,\"is_flexible\":true},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fed221\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Weekly social writing sessions that help people find their voice and create alongside a community of writers in London.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Each week we explore a different theme through writing exercises, independent writing time, discussion and feedback.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No experience needed. Just bring yourself and something to write with.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pay what you can\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Writer’s Blocc is community-led and we want to keep our weekly sessions accessible. Tickets are pay what you can, with a suggested contribution of £3.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your contribution goes towards the venue, refreshments and helping us continue running The Writer’s Blocc.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you can’t contribute right now, you’re still welcome. 🧱\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_addres