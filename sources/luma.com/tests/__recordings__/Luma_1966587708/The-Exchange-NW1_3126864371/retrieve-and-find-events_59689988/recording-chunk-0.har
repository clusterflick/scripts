y\":null,\"guest_count\":19,\"ticket_count\":19,\"hosts\":[{\"api_id\":\"usr-LGnFj8w0VU8LUpb\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_18.png\",\"bio_short\":\"\",\"first_name\":\"Hello\",\"last_name\":\"The Halley\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"The Halley\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#c3c4c3\",\"#383838\",\"#a92426\"],\"palette\":{\"neutral\":[{\"color\":\"#383838\",\"percentage\":5.33},{\"color\":\"#c3c4c3\",\"percentage\":19.76}],\"vibrant\":[{\"color\":\"#a92426\",\"percentage\":1.27}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/rz/d4414201-27ff-4edc-affc-80e39cb45fc2.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-jBrmTL7QdYcUrXs\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-tSh2YSrM6T0uUDA\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":19,\"num_guests\":19,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":61,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#ccccca\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"departure\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us at The Halley on 1 October for an intimate evening of DJing, music industry insight, open decks and networking with MESSIE and SKALAH.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Both DJs will take you behind the scenes of their approach to DJing, sharing the things they’ve learnt along the way; from track selection and set preparation to building a set, technique and finding your own sound.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"What to expect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The evening will kick off with an interactive workshop where MESSIE and SKALAH will talk through:\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"-How they approach DJing and prepare for a set\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"-Track selection and building a set from start to finish\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"-Their techniques, tips and approaches in the booth\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"-A live DJ demo\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"-The business and industry side of being a DJ\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"-Lessons they’ve learnt throughout their careers\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"There’ll also be plenty of time for Q&A, so bring your questions and make the most of having two experienced DJs in the room.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"After the workshop we’ll open things up for an informal open decks session.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Sign up on the night for a slot, play a few tunes and get real-time feedback and advice from MESSIE and SKALAH while you play. Whether you’re just getting started or have been DJing for years, this is a chance to try something out, ask questions and connect with other DJs.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"We’ll finish the evening with more open decks, drinks and plenty of time to meet other DJs, artists and people working across the music industry.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"The event is aimed at DJs, producers, artists, music industry professionals and anyone interested in learning more about DJing. All experience levels welcome.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Special shoutout to Brixton Brewery for providing refreshments!\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
