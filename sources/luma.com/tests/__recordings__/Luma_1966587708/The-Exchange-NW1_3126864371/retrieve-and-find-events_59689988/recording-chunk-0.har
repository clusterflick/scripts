":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refund will only be given two weeks in advance.\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-x3xLqkBttAU3SAc\",\"avatar_url\":\"https://images.lumacdn.com/avatars/nr/c614ffd6-e681-4c08-9e6d-8f5bf6275ee4.jpg\",\"bio_short\":\"A platform where world-class inspiration meets unstoppable action.\\n🎟️ Top 30 events in London  \\nFounded by Rebecca Rowntree\",\"first_name\":\"Rebecca\",\"last_name\":\"Rowntree\",\"instagram_handle\":\"_getshitdone_\",\"is_verified\":false,\"linkedin_handle\":\"/in/rrowntree\",\"name\":\"Rebecca Rowntree\",\"tiktok_handle\":\"_getshitdone_\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"getshitdone\",\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-7QbD9rm9B59T97a\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_36.png\",\"bio_short\":null,\"first_name\":\"Alex\",\"last_name\":\"Bec\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/alex-bec\",\"name\":\"Alex Bec\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-ovrnfsWvWWR4I1z\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_43.png\",\"bio_short\":null,\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Samar Maakaroun\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-AuBzSPNFla5Tg4T\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_4.png\",\"bio_short\":null,\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":null,\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f7c07d\",\"#fbf9f9\",\"#1b1a1c\",\"#3c5e84\"],\"palette\":{\"neutral\":[{\"color\":\"#1b1a1c\",\"percentage\":5.26},{\"color\":\"#fbf9f9\",\"percentage\":9.1}],\"vibrant\":[{\"color\":\"#f7c07d\",\"percentage\":19.75},{\"color\":\"#fca7d7\",\"percentage\":6.9},{\"color\":\"#3c5e84\",\"percentage\":2.72},{\"color\":\"#f9b1b2\",\"percentage\":13.12}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/rm/245060fd-71d2-4b3e-b4ad-bf497d71cfcb.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-emNAAnly6fQ6BsS\",\"cents\":2250,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-GErSCPgL2kAWaUB\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":100,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":120,\"num_guests\":120,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Melon\",\"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#ff8787\",\"color2\":\"#fff9b3\",\"color3\":\"#aae29e\"},\"tint_color\":\"#fff9b3\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Standing out has never been harder, or more valuable. So what does modern branding look like in the age of everything, everywhere, all at once? And when generating a brand feels ‘easy’ in the age of AI, how do you build something that lasts?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"In this edition of Get Sh*t Done, we'll dive into the world of brand design to tackle these exact questions and much more.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expect our signature unfiltered conversation on the state of modern creativity and branding, featuring three of the sharpest, most interesting brains in the business: a partner at the world's most famous design firm, the co-founder of the global platform that showcases the industry's best, and the creative director behind one of London's most talked-about independent studios.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"They'll reveal their own point of view on what makes great brand design, how to create a unique brand DNA that stands out, and what distinctiveness means to different businesses. And does it look different for an established design firm and a young independent studio?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"And, as always with Get Sh*t Done, this isn't just a panel. You'll get the chance to bring your own challenge to the room, and we'll brainstorm real solutions together. (More on the unique format below.)\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"The Line-Up\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Panellists\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Samar Maakaroun | Partner, Pentagram London\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Pentagram is the most famous design firm in the world, and Samar helps run it. She launched Apple's brand in Arabic, created Dubai's first destination brand, built the identity for the Emirate of Sharjah, and led a regional campaign for Porsche. A designer and typographer working across Arabic and Latin scripts, she crafts identities for a world where nobody is just one thing.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Alex Bec | Co-founder and CEO, It's Nice That\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"For nearly twenty years, It's Nice That has been the place the creative industry goes to see what's good. Alex helped build it from a university project into a global media powerhouse, alongside Creative Lives in Progress and If You Could. He has watched more brand work land, and disappear, than almost anyone alive.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dani Wolf | Co-founder and Creative Director, BADBERRIES\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Dani built BADBERRIES into one of London's most talked-about independent studios on a single rule: playing it safe leads to sameness. A D&AD Pencil-winning creative director with a background in typography and motion, he has delivered brave, playful work for Apple, NBA and Pepsi, and still judges every idea against the harshest feedback he ever got: \\\"I've seen this before.\\\"\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The host\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Rebecca Rowntree\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.linkedin.com/in/rrowntree/?utm_source=luma\"}}]},{\"text\":\", Creative director, Speaker and Founder of Get Sh*t Done\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Rebecca is a creative director who has spent 15+ years leading creative for big brands like Nike, Uber, Kellogg's, PlayStation and Bodyform.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"She founded \",\"type\":\"text\"},{\"text\":\"Get Sh*t Done\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.getshitdone.live/?utm_source=luma\"}}]},{\"text\":\" in 2017 to bring creatives, strategists and brand leaders together to do exactly that: get sh*t done.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Now a sell-out event series and thriving creative community with almost 800 members on WhatsApp alone, Rebecca has appeared at Cannes Lions, MAD//Fest, SXSW and Creative Festival, championing creative collaboration and action over talk.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The format\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Get Sh*t Done isn't your average panel talk. It's part conversation, part problem-solving.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"We'll kick off with a fast-moving panel featuring some of the sharpest minds in branding, and then it's over to you. Got a challenge at work? Launching something new? A brand that isn't landing? Throw it into the room and we'll all work together to come up with solutions 🤛\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Special thanks to \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Framestore\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.framestore.com/\"}},{\"type\":\"bold\"}]},{\"text\":\" for hosting us.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
            "size": 14049
          },
