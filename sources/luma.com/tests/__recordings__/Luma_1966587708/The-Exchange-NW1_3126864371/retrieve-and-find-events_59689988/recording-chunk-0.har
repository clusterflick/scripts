329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":1200,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#ef4f04\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re teaming up with \",\"type\":\"text\"},{\"text\":\"Chiswick Flower Market\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" to bring a pop-up Art Market to the heart of Chiswick High Road — a vibrant destination to explore local art and connect with new talent.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"From small treasures to standout pieces, there's so much to discover. Meet emerging artists, take part in hands-on creative activities, and find something you love, whether you’re a seasoned collector or just starting out.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ Up to 26 unique artists\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"✏️ Beginner-friendly creative activities\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🎶 Live pop-up music + performances\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🤝 Meet artists and connect with the local community\",\"type\":\"text\"}]},{