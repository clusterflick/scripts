"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"fireworks\"},\"tint_color\":\"#9d1b1f\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/81/4fc56134-778a-4748-81b8-59919b86cb16.jpg\",\"width\":5088,\"height\":3392,\"image_id\":\"local-upload-blob:https://luma.com/a9ad40c4-ad97-4fd6-afa8-651a4ea566b2\",\"mime_type\":null,\"uploaded_at\":\"2026-09-04T18:44:14.722+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Tress Gala 2026\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tress Gala is an exclusive event celebrating the best Black hairstylists in the UK and championing excellence within the industry.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Thank you to our 2026 headline sponsor L'Oréal Professional Products and our silver sponsor Haircon.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"www.tressgala.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://www.tressgala.com\"}}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"VENUE\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/ua/dc77f954-e929-4b37-9919-7ae6e453f611.jpg\",\"width\":1080,\"height\":809,\"image_id\":\"local-upload-blob:https://luma.com/3a63f9c5-c78d-4b87-8dd3-79dd7af77828\",\"mime_type\":null,\"uploaded_at\":\"2025-09-23T11:13:23.465+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"THE BALLROOM AT THE LONDONER: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"50 Whitcomb St., London WC2H 7DY.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"NEAREST STATION IS LEICESTER SQUARE OR PICCADILLY CIRCUS.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"DRESS CODE\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The dress code for Tress Gala is \",\"type\":\"text\"},{\"text\":\"ALL BLACK | EVENING WEAR\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". There will be awards for Best Dressed, Best Hair & Most Creative Look.\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"HAIR THEME\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The hair theme for Tress Gala 2026 is \",\"type\":\"text\"},{\"text\":\"WHIMSY\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". There will be awards for Best Hair.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/np/71da0543-f0a8-4e57-8810-adb2fed034ec.jpg\",\"width\":1920,\"height\":1080,\"image_id\":\"local-upload-blob:https://luma.com/e6a9bb66-2857-41ac-a7fa-a5a50b5f626f\",\"mime_type\":null,\"uploaded_at\":\"2026-09-04T12:42:33.605+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"SCHEDULE\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tress Gala is the UK’s premier celebration of Black hairstylists — held during Black History Month that shines a spotlight on emerging Black stylists who are pushing boundaries in creativity, craft, and entrepreneurship.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s a gathering of community, culture, and connection. Please be on time as doors close at 6:15pm.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:00PM - 7:00PM  Red Carpet, Brand Area + Drinks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:00PM - 8:00PM Speeches, Three Course Dinner + Drinks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"8:00PM - 9:00PM Award Ceremony\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"9:00PM - 9:45PM Dessert, Sponsor Awards + Keynote\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"10:00PM - 1:00AM Afterparty + Surprise Guests\",\"type\":\"text\"}]},{\"type\":\"horizontal_rule\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"ABOUT US\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tressly Gala is hosted by Tressly, the home for textured hairstylists.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our vision is to empower textured hairstylists to grow through our technology, events and co-working salons.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"www.tressly.co\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://www.tressly.co\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"hac18he3\",\"label\":\"Do you have any dietary requirements? \",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":