gion_short\":\"England\",\"short_address\":\"Medway Visitor Information Centre, 95 High St, The Precinct, Rochester\",\"place_coordinate\":{\"latitude\":51.388816999999996,\"longitude\":0.5048199},\"apple_maps_place_id\":\"IC9524F02A2F03C52\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":0.5048199,\"latitude\":51.388816999999996},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-09-24T17:50:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Guests can request a full refund up to 24 hours before the activity starts. In the rare event that we have to cancel the activity, a full refund will be offered. Similarly, if the activity has to be postponed a full refund will be offered if the rescheduled date is not suitable.\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-nwddfU4bdLvAxUT\",\"avatar_url\":\"https://images.lumacdn.com/avatars/ge/216561ee-a9a5-458b-9829-be4ec4ea30f0.jpg\",\"bio_short\":null,\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Electric Medway\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-trd1y5YVc7VUlEk\",\"avatar_url\":\"https://images.lumacdn.com/avatars/g1/fb4e8020-7ecb-44d2-a03c-d6ef5400dbcb\",\"bio_short\":\"Enabling communities across Medway to get creative with new technology.\",\"first_name\":\"Janet\",\"last_name\":\"Moore\",\"instagram_handle\":\"electricmedway\",\"is_verified\":false,\"linkedin_handle\":\"/company/electricmedway\",\"name\":\"Electric Medway\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"electricmedway\",\"website\":\"https:///electricmedway.org\",\"youtube_handle\":\"ElectricMedwayTV\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f7d813\",\"#f3f0e7\",\"#191116\",\"#2b3658\"],\"palette\":{\"neutral\":[{\"color\":\"#191116\",\"percentage\":6.35},{\"color\":\"#f3f0e7\",\"percentage\":25.92}],\"vibrant\":[{\"color\":\"#f7d813\",\"percentage\":30.97},{\"color\":\"#cb4540\",\"percentage\":4.76},{\"color\":\"#2b3658\",\"percentage\":3.09}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/6b/b52a7ce0-35a8-412e-9b69-d60dcc4995d8.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-NlUdKb5GkhhYZL7\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-XimqGKZMISlU678\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-l1UsKETqX54pXw2\",\"cents\":700,\"currency\":\"gbp\",\"description\":\"Voluntarily paying a higher fee helps us with rental, equipment and staffing costs, and helps us as we try build the Cinema Club into a longstanding feature of Medway.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-XimqGKZMISlU678\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"85\",\"name\":\"Supporter\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":5,\"num_guests\":5,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-k0AGguLxpf9kWHF\",\"cents\":300,\"currency\":\"gbp\",\"description\":\"For those Under 18, OAPs, or on Universal Credit. If you are able to pay the standard entry then please do so that we can keep costs low and continue to make cinema accessible to all.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-XimqGKZMISlU678\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Concession\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":300,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":700,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":38,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Ocean\",\"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#ccfbff\",\"color2\":\"#cceaff\",\"color3\":\"#ccf9ff\"},\"tint_color\":\"#cceaff\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Electric Medway Cinema Club presents... \",\"type\":\"text\"},{\"text\":\"The Ladykillers \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"(1955)\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/8y/d344015f-9263-4bff-8112-b379ed069e16.jpg\",\"width\":554,\"height\":554,\"image_id\":\"local-upload-blob:https://luma.com/fe621777-fe72-4b7d-ac28-4a6c2798cfb0\",\"mime_type\":null,\"uploaded_at\":\"2026-09-10T11:00:59.911+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎞️  Directed by Alexander Mackendrick, \",\"type\":\"text\"},{\"text\":\"The Ladykillers\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is a crowning achievement of classic British cinema and the definitive dark comedy of the Ealing Studios era. Shot in vibrant, atmospheric Technicolor, the film trades in a uniquely macabre yet whimsical humour, anchored by an unforgettable, toothy performance from Alec Guinness (\",\"type\":\"text\"},{\"text\":\"The Bridge on The River Kwai\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\") as the sinister Professor Marcus.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Supported by a stellar ensemble cast, including a young Peter Sellers (\",\"type\":\"text\"},{\"text\":\"Dr. Strangelove\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"), Cecil Parker (\",\"type\":\"text\"},{\"text\":\"The Admirable Crichton\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\") and Herbert Lom (\",\"type\":\"text\"},{\"text\":\"The Phantom of the Opera\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"), the film balances a brilliant screenplay with sharp slapstick and a gentle, satirical look at post-war British eccentricities, cementing its status as an enduring comedy masterpiece.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🍿 Light snacks are also available to purchase from our box office during the event.\",\"type\":\"text\"}]},{\"type\":\"video_youtube\",\"attrs\":{\"title\":\"The Ladykillers - Official Trailer | Starring Alec Guinness\",\"width\":200,\"height\":113,\"youtube_id\":\"9X_vzsLhbr8\",\"thumbnail_url\":\"https://i.ytimg.com/vi/9X_vzsLhbr8/hqdefault.jpg\",\"thumbnail_width\":480,\"thumbnail_height\":360}},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Singularity \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"(2026)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🎥  Ahead of The Ladykillers, we are delighted to screen an  animation\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"from Blender Studio. \",\"type\":\"text\"},{\"text\":\"Singularity\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" takes place in a distant age of the universe, when the stars and galaxies were young. When an ominous cosmic event swallows a small space critter's home, he must find refuge among a group of others, watched over by a mysterious celestial being.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"A painterly space adventure set in a universe before the beginning of our time, this short film was created using the latest, in-development version of Blender. Directed by Andy Goralczyk, watercolour illustrations, hand-crafted textures and brush strokes intertwine with an intricate, immersive soundscape by sound designer Sander Houtman.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"(CC) Blender Foundation | \",\"type\":\"text\"},{\"text\":\"studio.blender.org\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://studio.blender.org\"}}]}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/p1/4e6ff31d-0976-4dd8-ac55-418a701e757e.webp\",\"width\":2578,\"height\":1080,\"image_id\":\"local-upload-blob:https://luma.com/94394e07-9290-4518-b3ec-f2f6471f10a6\",\"mime_type\":null,\"uploaded_at\":\"2026-09-08T22:19:48.950+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Programme\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:50pm: Doors open\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:10pm: B-movie: \",\"type\":\"text\"},{\"text\":\"Singularity\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" by Blender Studio\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:25pm: Break\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:30pm: Main event: \",\"type\":\"text\"},{\"text\":\"The Ladykillers*\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"*As a PG certificate, this film is suitable for audiences aged 7 years+\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"9:00pm: Break\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"9:10pm: An informal (and optional) post-film discussion\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"9:30pm: End\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Stay and Chat\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"After the screening, we invite you to join a relaxed post-film discussion. Share your thoughts on the story, performances, cinematography or aspects of the film which resonated with you. It's a casual opportunity to connect with fellow film enthusiasts and exchange perspectives. No film analysis expertise required – just bring your impressions and experiences!\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"About Cinema Club\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bringing the best of indie cinema and experimental film to Medway, Electric Medway Cinema Club is chance to catch the movies that may have passed you by, or you would never have considered seeing!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cinema Club events start with a B-movie ahead of the main feature. This could be a short film; immersive game; a virtual reality experience or augmented reality trail. Artworks showcased may be from local creators, internationally acclaimed filmmakers, or works directly commissioned by Electric Medway. Events may also include a guest artist presentation, producer Q&A session, or post-film discussion.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Acknowledgement: \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"This event is funded by BFI Film Audience Network, with partner support from Huguenot Museum and Cinema for All. Photos by Tyler Austin/Electric Medway.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/cl/c2373dea-cdb9-4c11-8380-85f031cc1b73.jpg\",\"width\":1280,\"height\":720,\"image_id\":\"local-upload-blob:https://lu.ma/f3aa962a-6839-48b0-8799-ebc2371fad27\",\"mime_type\":null,\"uploaded_at\":\"2025-03-07T18:53:56.974+00:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/58/ba3c8da8-5895-42d9-b8fc-f8789e9a1f65.png\",\"width\":2011,\"height\":454,\"image_id\":\"local-upload-blob:https://lu.ma/0341a9aa-2c42-4770-80ed-bd3a8433d53a\",\"mime_type\":null,\"uploaded_at\":\"2025-05-14T14:00:08.445+01:00\",\"is_uploading\":false,\"resize_width\":433.96875}},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/editor-images/oz/c977da1c-24aa-499d-9f0f-81a770276b89.png\",\"width\":null,\"height\":null,\"image_id\":null,\"mime_type\":null,\"uploaded_at\":null,\"is_uploading\":false,\"resize_width\":null}}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"wq72bx59\",\"label\":\"I confirm I am the required age for this film's BBFC certification (PG)\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"nvjpkpc1\",\"label\":\"If you have any accessibility needs, please let us know here\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
