"Transfer your ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" to another founder (email us their name/email)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"OR request a \",\"type\":\"text\"},{\"text\":\"credit\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" towards a future PLUGGED or GTM Labs event.\",\"type\":\"text\"}]}]}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"❌ No Show / Day-Of Cancellations\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you don’t attend and didn’t notify us in advance, your ticket is \",\"type\":\"text\"},{\"text\":\"non-refundable\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]}]}]},{\"type\":\"horizontal_rule\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📩 Need a Refund?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Email us at \",\"type\":\"text\"},{\"text\":\"plugged@generalist.company\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" with:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your full name\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Email used to register\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ticket type + refund request\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event URL\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\"}]},\"slug\":\"plugged\",\"social_image_url\":\"https://images.lumacdn.com/calendar-cover-images/el/1bfebe51-17b5-433a-9761-f4bd43c4d3fa\",\"start_date\":null,\"stripe_account_id\":\"acct_1SUuc7Cx