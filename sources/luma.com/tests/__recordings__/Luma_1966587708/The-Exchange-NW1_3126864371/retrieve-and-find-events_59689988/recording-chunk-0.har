s\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refund within 14 days of event.\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-dqiJE59ZvvaqV3Z\",\"avatar_url\":\"https://images.lumacdn.com/uploads/r8/96f2f96c-1ad9-4426-ab70-487fbd9bd2ca.png\",\"bio_short\":\"Accessible art markets and events that empower emerging creatives and make it easy to buy and sell art. 📍 London\",\"first_name\":\"Open Art\",\"last_name\":\"Spaces\",\"instagram_handle\":\"openartspaces\",\"is_verified\":false,\"linkedin_handle\":\"/in/eve-kennedy-693b35232\",\"name\":\"Open Art Spaces\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"Openartspaces\",\"website\":\"https://www.openartspaces.co.uk/\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#e5f213\",\"#1d1d1d\",\"#fefefe\"],\"palette\":{\"neutral\":[{\"color\":\"#1d1d1d\",\"percentage\":9.45},{\"color\":\"#fefefe\",\"percentage\":4.54}],\"vibrant\":[{\"color\":\"#e5f213\",\"percentage\":84.92}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/3d/7713e699-1dd5-4a83-a01e-7a1a0fbf3761.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-BGfgtHrQT1jhbAX\",\"cents\":850,\"currency\":\"gbp\",\"description\":\"Sketchbook and pencils are provided, just turn up!\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-DAJexeDwWA5dSmP\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Orange\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-6hwqOHaSp63a6dk\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"No materials are provided, you're bringing your own art supplies\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-DAJexeDwWA5dSmP\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Yellow\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":2,\"num_guests\":2,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":850,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#e6f314\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Open Art Sketch Club\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👀 Meet outside Gails Bakery, 1 Sclater St, London E1 6HR\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Open Art Sketch Club is a relaxed urban sketching and social event for creatives of all abilities, whether you're picking up a pencil for the first time or sketching professionally.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Together, we'll explore the local area through a guided sketch walk, stopping at carefully selected locations with creative drawing prompts along the way. You'll have plenty of freedom to develop your own ideas, discover new perspectives, and connect with fellow artists. We'll finish back at the Open Art Market to share our work and celebrate a creative afternoon together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Itinerary\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"12:00pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Meet outside Gails Bakery, 1 Sclater St, London E1 6HR (Look out for the Open Art Spaces team in pink high-vis on arrival!)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"12:00pm – 2:30pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Guided sketch walk with drawing prompts and free exploration time\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"2:30pm\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Return to the market\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Running late? No problem. Look for the team in pink high-vis and we'll point you in the right direction.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ticket Options\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🟠 \",\"type\":\"text\"},{\"text\":\"Orange Ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Sketchbook and art materials provided.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🟡 \",\"type\":\"text\"},{\"text\":\"Yellow Ticket\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Bring your own sketchbook and materials.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What's Included?\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A curated route featuring inspiring locations to sketch\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Creative prompts to spark ideas\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Friendly support from the Open Art Spaces team throughout\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A Sketch Club loyalty punch card for repeat attendees\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Opportunities to have your artwork featured on our social media\",\"type\":\"text\"}]}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
