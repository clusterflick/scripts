st_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-D9GZnU0GfrGh7eb\",\"avatar_url\":\"https://images.lumacdn.com/avatars/4g/be099777-3881-42d1-8fea-d82b2cfa9e17.png\",\"bio_short\":\"Parho is a literary and cultural house bringing people together through books, learning and shared experiences.\",\"first_name\":\"Parho\",\"last_name\":\"Co\",\"instagram_handle\":\"parho.co\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Parho Co\",\"tiktok_handle\":\"parhobookclub\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"parho\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#fff2e1\",\"#b62d2c\",\"#2c2219\",\"#2d8bae\"],\"palette\":{\"neutral\":[{\"color\":\"#2c2219\",\"percentage\":0.93},{\"color\":\"#fff2e1\",\"percentage\":46.05}],\"vibrant\":[{\"color\":\"#b62d2c\",\"percentage\":37.9},{\"color\":\"#fec608\",\"percentage\":7.57},{\"color\":\"#2d8bae\",\"percentage\":0.55},{\"color\":\"#ae1966\",\"percentage\":0.5}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/9h/9fb515ac-15cf-4832-b16b-7835badb23b8.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-GSMz6jWGr8KSBvp\",\"cents\":3800,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-GhjjQP1QTL2dGnq\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":3800,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":37,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#b52d2f\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"The Namesake by Jhumpa Lahiri\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Book synopsis:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Namesake follows the life of Gogol Ganguli, the son of Bengali immigrants, as he navigates identity, family expectations, and cultural dislocation in America.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Movie:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Directed by Mira Nair and based on the The Namesake by Jhumpa Lahiri, the movie brings Lahiri's written world to life on screen. It stars Irrfan Khan as Ashoke, Tabu as Ashima, and Kal Penn as Gogol.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Host:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The discussion will be hosted by Mehek Ali: Mehek is senior creative at AMALIAH + director and writer. She’s also a retired content creator - she amassed over 80k followers on TikTok during the platform's golden era (pre-ads) making cultural commentary videos. As an avid movie buff, she's always got more opinions than she knows what to do with - and has just directed her first short film!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We generally operate a no refunds policy.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
