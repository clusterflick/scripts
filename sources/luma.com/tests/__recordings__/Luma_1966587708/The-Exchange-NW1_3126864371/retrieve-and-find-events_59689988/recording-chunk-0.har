            "text": "{\"api_id\":\"evt-f93ktjEXJshZ4bW\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-dTdQS5880NAdK72\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/community_avatar_15.png\",\"coordinate\":null,\"cover_image_url\":null,\"description_short\":null,\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":null,\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":null,\"location\":null,\"luma_plan\":\"free\",\"luma_plus_active\":false,\"meta_pixel_id\":null,\"name\":\"Personal\",\"personal_user_api_id\":\"usr-mHzRFsbin37ck1h\",\"refund_policy\":null,\"slug\":null,\"social_image_url\":null,\"start_date\":null,\"stripe_account_id\":null,\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#F31A7C\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":null,\"website\":null,\"youtube_handle\":null,\"is_personal\":true,\"personal_user\":{\"api_id\":\"usr-mHzRFsbin37ck1h\",\"avatar_url\":\"https://images.lumacdn.com/uploads/rp/32187367-0276-48c4-8eef-c39a86f085dc.png\",\"bio_short\":\"Art Director, brand designer and artist based in London\",\"first_name\":\"Juliet\",\"last_name\":\"Faldin\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/juliet-faldin-30940b1a7\",\"name\":\"Juliet Faldin\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},\"timezone\":null,\"charges_enabled\":null,\"payment_methods\":[]},\"meta_pixel_id\":null,\"coupon\":null,\"google_measurement_id\":null,\"stripe_account_id\":null,\"payment_methods\":[],\"tax_config\":null,\"event\":{\"api_id\":\"evt-f93ktjEXJshZ4bW\",\"calendar_api_id\":\"cal-dTdQS5880NAdK72\",\"cover_url\":\"https://images.lumacdn.com/uploads/60/0a2dffef-ef7d-4203-a91e-34492242cf7a.png\",\"end_at\":\"2026-10-01T20:00:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"Cinema 4D for brand design today\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":true,\"social_image_url\":\"https://images.lumacdn.com/event-social/mo/4756f767-9ced-4222-b67b-2b9732962d60.png\",\"start_at\":\"2026-10-01T18:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"cg4r31u8\",\"user_api_id\":\"usr-mHzRFsbin37ck1h\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Metaview\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJQ_O0eXwddkgRk-OUeGkK1YE\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"Metaview\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"Metaview, Floor 8, 4 Elder St, London E1 6BT, UK\",\"region_short\":\"England\",\"short_address\":\"Floor 8, 4 Elder St, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"Metaview, Floor 8, 4 Elder St, London E1 6BT, UK\",\"region_short\":\"England\",\"short_address\":\"Floor 8, 4 Elder St, London\",\"place_coordinate\":{\"latitude\":51.5219704,\"longitude\":-0.0767434},\"apple_maps_place_id\":null,\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.0767434,\"latitude\":51.5219704},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-10-01T18:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[{\"api_id\":\"usr-4mniaa6Un5YBddw\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_6.png\",\"bio_short\":null,\"first_name\":\"George\",\"last_name\":\"Hay\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"George Hay\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-9NfnyoBZ02MnCKf\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_34.png\",\"bio_short\":null,\"first_name\":\"Daria\",\"last_name\":\"Shcherbak\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/dariashcherbak\",\"name\":\"Daria Shcherbak\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-ZIM6A1HYIruYEyH\",\"avatar_url\":\"https://images.lumacdn.com/uploads/no/dc5bc306-636d-4c71-9945-5df06f5b5e3b.jpg\",\"bio_short\":\"Design Engineer\",\"first_name\":\"Prince\",\"last_name\":\"Kukreja\",\"instagram_handle\":\"princekukrejaa\",\"is_verified\":false,\"linkedin_handle\":\"/in/princekukreja\",\"name\":\"Prince\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":\"pixelprincedev\",\"username\":\"pixelprince\",\"website\":\"https://Pixelprince.dev\",\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":3,\"ticket_count\":3,\"hosts\":[{\"api_id\":\"usr-mHzRFsbin37ck1h\",\"avatar_url\":\"https://images.lumacdn.com/uploads/rp/32187367-0276-48c4-8eef-c39a86f085dc.png\",\"bio_short\":\"Art Director, brand designer and artist based in London\",\"first_name\":\"Juliet\",\"last_name\":\"Faldin\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/juliet-faldin-30940b1a7\",\"name\":\"Juliet Faldin\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-lAXK0DlX5zA1cgB\",\"avatar_url\":\"https://images.lumacdn.com/uploads/7z/cad5b0e4-c65c-47e4-a2d3-ba441b8bea37.png\",\"bio_short\":\"ai-ninjas crafting\\nwhat the world\\nunderstands\\ntomorrow.\",\"first_name\":\"UNKNW\",\"last_name\":\"Studio\",\"instagram_handle\":\"unknw.design\",\"is_verified\":false,\"linkedin_handle\":\"/in/michael-rosenblatt-design\",\"name\":\"UNKNW Studio\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"unknw\",\"website\":\"https://www.unknw.com/\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#080806\",\"#f4faf9\",\"#1750b6\",\"#97753d\"],\"palette\":{\"neutral\":[{\"color\":\"#080806\",\"percentage\":35.95},{\"color\":\"#f4faf9\",\"percentage\":7.35}],\"vibrant\":[{\"color\":\"#1750b6\",\"percentage\":2.98},{\"color\":\"#97753d\",\"percentage\":1.89},{\"color\":\"#4ee2d8\",\"percentage\":1.71}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/mo/4756f767-9ced-4222-b67b-2b9732962d60.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-1A7a223R11F3bsl\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-f93ktjEXJshZ4bW\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":17,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#060808\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"futura\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Wanna go beyond average with your designs?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Everyone's prompting. Almost no one's building. Real 3D craft is the skill that separates your work from the flood of AI slop the patterns, the lens effects, the details you simply can't prompt your way into.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Always wanted to try 3D but never got past the fear (or the interface)? This one's for you. Zero experience needed.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Mike Rosenblatt, co-founder of UNKNW, will walk you through Cinema 4D step by step. By the end of the evening you'll know the difference between good 3D and bad and you'll have made some of the good kind yourself.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The plan\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Gathering\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"C4D basics: the interface\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Basic modelling\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pattern creation\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Custom lens effects\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Each step is a short masterclass followed by hands-on practice. Bring a laptop with Cinema 4D installed the free trial works fine.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Spots are limited. Grab yours early.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"p4j0czjf\",\"label\":\"What is your LinkedIn profile?\",\"required\":false,\"question_type\":\"linkedin\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
