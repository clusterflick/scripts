com/uploads/32/85b78304-ef5d-40db-9fb8-fd14ae91dfe6.png\",\"end_at\":\"2026-09-22T19:45:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"Intermediate - Follower\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":true,\"social_image_url\":\"https://images.lumacdn.com/event-social/d7/00a0fbc0-3dbc-4ae1-97a0-48c679cca3be.png\",\"start_at\":\"2026-09-22T18:45:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"e88t5skn\",\"user_api_id\":\"usr-u4HUnAaEmvEpuLN\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"UNDR House Of Flavaz\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJ79xveDURdkgRkFE_U3RX4mM\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"address\":\"UNDR House Of Flavaz\",\"country\":\"United Kingdom\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"full_address\":\"UNDR House Of Flavaz, 3 Thorpe Cl, London W10 5XL, UK\",\"region_short\":\"England\",\"short_address\":\"3 Thorpe Cl, London\"}},\"city_state\":\"London, United Kingdom\",\"description\":\"Please arrive 10 minute before your class start. If everything runs on time, we get a longer social - and who doesn't want more time to play ;)\",\"sublocality\":null,\"country_code\":\"GB\",\"full_address\":\"UNDR House Of Flavaz, 3 Thorpe Cl, London W10 5XL, UK\",\"region_short\":\"England\",\"short_address\":\"3 Thorpe Cl, London\",\"place_coordinate\":{\"latitude\":51.518194799999996,\"longitude\":-0.2089277},\"apple_maps_place_id\":\"ID845A822E36BFED3\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.2089277,\"latitude\":51.518194799999996},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-09-22T18:45:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":n