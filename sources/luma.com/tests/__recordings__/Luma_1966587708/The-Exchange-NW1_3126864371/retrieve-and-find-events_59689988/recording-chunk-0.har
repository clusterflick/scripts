last_name\":\"Campos de Barros Gordilho\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/valentina-gordilho\",\"name\":\"Valentina Campos de Barros Gordilho\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-mfIOHhI8aOLG20o\",\"avatar_url\":\"https://images.lumacdn.com/uploads/aj/183c40d9-c4a9-410d-8063-4aeac875332c.png\",\"bio_short\":\"Spearheading Community, CEO Office @ Humaans\",\"first_name\":\"Aubry\",\"last_name\":\"Ma\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/aubryma\",\"name\":\"Aubry Ma\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-rBIqutNczugBAlD\",\"avatar_url\":\"https://images.lumacdn.com/avatars/4z/cef8bdac-ecb7-4258-bc73-ec26827b226e.jpg\",\"bio_short\":\"Community @ Corgi UK/EU\",\"first_name\":\"Claudia\",\"last_name\":\"Maggi\",\"instagram_handle\":\"claudiaamaggi\",\"is_verified\":false,\"linkedin_handle\":\"/in/claudiamaggi\",\"name\":\"Claudia Maggi\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":\"claudiaamaggi\",\"username\":\"claudiaamaggi\",\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f5f5f2\",\"#f91325\",\"#100c0c\",\"#113ce5\"],\"palette\":{\"neutral\":[{\"color\":\"#100c0c\",\"percentage\":4},{\"color\":\"#f5f5f2\",\"percentage\":38.73}],\"vibrant\":[{\"color\":\"#f91325\",\"percentage\":7.53},{\"color\":\"#113ce5\",\"percentage\":3.31}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/te/64f4d87b-a1e5-4465-8884-e2a30417fa4d.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-h6NoFijkoEJk8WN\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-EsflvwEEjDyGJMr\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":8,\"num_guests\":8,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":22,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"sunny-shades\"},\"tint_color\":\"#FFAAA5\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Humaans × Corgi presents: Sticker Club 🎨\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"London's first HR sticker design competition.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Free breakfast, good coffee, two office dogs, and two hours to design a sticker then print it on the spot on our sticker machine. The winning design gets professionally printed and packed into Humaans onboarding merch.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No design background needed. Put your design cap on and come draw something.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Run of show ⏰\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🥐 \",\"type\":\"text\"},{\"text\":\"9:00 to 10:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Breakfast and coffee at Corgi Café, free for everyone who signed up. Show your QR code at the door.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✏️ \",\"type\":\"text\"},{\"text\":\"10:00 to 12:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Design session. We'll have a few iPads on site, but bring your own kit if you have one to sketch on.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🖨️ \",\"type\":\"text\"},{\"text\":\"12:00 to 13:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Print your design on our sticker machine, then stick it on the Wall of Fame. Our judges pick the one that goes into production. Everyone leaves with their own sticker.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sticker Club brief 💡\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Future of work. AI in HR. HR tech. Have a look at \",\"type\":\"text\"},{\"text\":\"humaans.io\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://humaans.io\"}}]},{\"text\":\" if you want a steer and get creative.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What's up for grabs 🏆\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🧢 Humaans iconic \\\"End of HR\\\" caps\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"☕ One month of free coffee at Corgi Café\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🤫 A secret prize\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About us\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Humaans helps companies move beyond rigid systems with a best-in-class HRIS and an Agentic AI Workforce that executes admin work end-to-end.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Corgi is an AI-native insurance platform built for startups and technology companies. It makes it faster and simpler for founders to get the right coverage as they grow.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Some of the Humaans team will be there, including someone from our hiring side. If you're curious about what we're building, or about joining us, come find us.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"And you'll meet Hayley 🐶 & Archie 🐕, our joint office dogs, who are handling greetings.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"fs8v999v\",\"label\":\"What company do you work for?\",\"required\":true,\"question_type\":\"company\",\"job_title_label\":\"What is your job title?\",\"collect_job_title\":true},{\"id\":\"nisca3y5\",\"label\":\"What is your LinkedIn profile?\",\"required\":true,\"question_type\":\"linkedin\"},{\"id\":\"5unzvxk9\",\"label\":\"What's your company headcount?\",\"options\":[\"1-25\",\"26-100\",\"101-250\",\"251-500\",\"501-1000\",\"1000+\"],\"required\":true,\"question_type\":\"multi-select\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
