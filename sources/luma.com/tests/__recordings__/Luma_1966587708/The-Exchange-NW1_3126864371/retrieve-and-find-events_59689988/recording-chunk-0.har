hereum_token_requirements\":[],\"event_api_id\":\"evt-ZR8E5POMltxuNg5\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-tech\",\"description\":\"Join a hackathon, jam on product design, and meet fellow tinkerers in the industry of tomorrow.\",\"event_count\":4069,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/lg/3b7cf2a0-077f-40ca-aab8-1a8d07affbd1.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/v7/3f6baafa-d90d-4013-9853-0fa10331f796.png\",\"name\":\"Tech\",\"page_title\":\"Tech Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/z8/cb71384a-87a9-4be7-bbdf-1c2d6381d872.png\",\"slug\":\"tech\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/1908a653-edb9-431e-8ecf-b4d61249a446.png\",\"subscriber_count\":73356,\"tint_color\":\"#5773CF\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Soñador\",\"type\":\"shader\",\"theme\":\"shader-light\",\"color1\":\"#d4d8ff\",\"color2\":\"#e6e0ff\",\"color3\":\"#c7f0ff\"},\"tint_color\":\"#e6e0ff\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"What is a Student Hackathon?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Don’t let the name fool you! A Hackathon is an intensive, one-day sprint where students come together to solve a specific challenge using creativity, strategy, and tools (like Canva!). It’s about teamwork, fast thinking, and hands-on making.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"There is no coding involved\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We are BACK! bringing together London’s most creative students for a full day of building and designing.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why should you participate?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Build Your Portfolio:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Leave with high-quality work you can actually use.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Industry Feedback:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Get your designs and ideas reviewed by the Canva team.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Networking:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Meet other ambitious students from across London’s top universities.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Exclusive Prizes:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" We have some amazing rewards lined up (stay tuned—prizes will be announced soon!).\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Challenges\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Expect high-energy tasks where you will have to solve problems related to:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Personal Branding:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Designing a standout visual identity.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Future Portfolio:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Rethinking how students showcase their work.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Creative CVs:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Transforming the traditional resume into a digital experience.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"⚠️ \",\"type\":\"text\"},{\"text\":\"IMPORTANT: Selection-Based Registration\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Step 1: Submit the Application Form\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Complete the form to apply for the Hackathon. All applications will be reviewed.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Step 2: Confirmation Email\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Selected participants will receive a confirmation email and must confirm their attendance by \",\"type\":\"text\"},{\"text\":\"Thursday Oct 22nd\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your spot is only secured once you have received the confirmation email and confirmed your participation.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Open to all undergraduate students, especially those in Year 2 or 3 of their degree programme. This event is c\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"ompletely free for students.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👉 \",\"type\":\"text\"},{\"text\":\"Join the waitlist now and keep an eye on your inbox. The countdown starts today.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" ⚡️\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"httzv0k1\",\"label\":\"What is the email address associated with your Canva account?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"3z32sl3i\",\"label\":\"Where in the UK are you studying?\",\"options\":[\"England\",\"Scotland\",\"Wales\",\"Northern Ireland\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"3jg8fyva\",\"label\":\"City you live in.\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"2l0cl8no\",\"label\":\"Which university, college, or institution are you currently studying at?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"qn4atnf2\",\"label\":\"What type of student are you?\",\"options\":[\"Undergraduate\",\"Postgraduate (Masters/PhD)\",\"Further Education (FE)\",\"Vocational or Technical Program\",\"International Student\",\"Part-Time\",\"Online or Distance Learning\",\"Other\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"4iw9zroy\",\"label\":\"What year of study are you currently in?\",\"options\":[\"Foundation Year\",\"Undergraduate Year 1\",\"Undergraduate Year 2\",\"Undergraduate Year 3\",\"Undergraduate Year 4 or Final Year\",\"Master’s Student\",\"PhD / Doctoral Student\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"hg6xwgtj\",\"label\":\"What is your expected graduation year?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"rgporju2\",\"label\":\"Are you part of any student clubs, societies, or communities? For example: design club, business society, student union, creative groups, etc. If so, please tell us more!\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"plujzera\",\"label\":\"Do you hold or have you held any leadership roles on campus?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"tajc1277\",\"label\":\"Are you involved in any creative, tech, design, or campus projects you’d like to share?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"j6bewsd0\",\"label\":\"If you have a FB, Instagram, TikTok, X or Bluesky profile you might share Canva-related content to, it would be amazing if you could share your profile link here.\",\"required\":false,\"question_type\":\"url\"},{\"id\":\"2q3qqw5d\",\"label\":\"Please send me updates about Canva products and services. You can unsubscribe at any time.\",\"required\":false,\"question_type\":\"agree-check\"},{\"id\":\"evjpuwbb\",\"label\":\"I confirm that I have read and agree to comply with Canva’s Event Code of Conduct.\",\"required\":true,\"question_type\":\"agree-check\"},{\"id\":\"scortdx6\",\"label\":\"Términos y condiciones\",\"terms\":{\"url\":\"https://www.canva.com/policies/privacy-policy/\",\"content_type\":\"link\",\"collect_signature\":false},\"required\":true,\"question_type\":\"terms\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
