,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#e6dbc7\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"👑 Habeenkii Haweenka - Baraanbur Night\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"An Evening of Women, Culture & Celebration\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A night dedicated to \",\"type\":\"text\"},{\"text\":\"Somali women, our culture, our traditions, and the joy of celebration.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for an intimate \",\"type\":\"text\"},{\"text\":\"Baranbur night\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" celebrating the beauty of Somali heritage through dance, halal- beats, sisterhood, and togetherness.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ \",\"type\":\"text\"},{\"text\":\"What to expect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Traditional Baranbur\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Somali music (halalbeats) & dancing\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Beautiful Somali-inspired atmosphere\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Food, drinks & sweet treats\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Lots of laughter, celebration & sisterhood\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come dressed to celebrate — think \",\"type\":\"text\"},{\"text\":\"Somali glam, traditional attire, dirac, guntiino, or whatever makes you feel like a boqorad\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". 👑\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is a night for the women who carry our culture, celebrate our traditions, and keep the spirit of \",\"type\":\"text\"},{\"text\":\"Baranbur\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" alive.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 Location:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Z Studios  100 Hanger Lane, KT Summit House, London, W5 1EZ\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"📅 Date:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Saturday 3rd October\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"🕐 Time:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 3pm - 7pm\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"👗 Dress Code:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Somali Glam / Traditional Elegance\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Haween • Hiddo • Baranbur • Dabaaldeg\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come as you are. Leave with memories. 🤍\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please note all ticket sales are final as the funds are used to cover the venue and Baraanbur providers. JazakAllahu Khayran for your understanding.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
