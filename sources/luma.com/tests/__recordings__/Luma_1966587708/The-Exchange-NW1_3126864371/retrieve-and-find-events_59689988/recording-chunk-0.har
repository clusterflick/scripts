gun\",\"require_approval\":true,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":37,\"num_guests\":37,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-5n5htFGaxJUPDwZ\",\"cents\":null,\"currency\":null,\"description\":\"Paying in vibes, community support and LinkedIn likes.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-loNaGEzSAMWEIOg\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"6\",\"name\":\"On a Bootstrap Budget\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":73,\"num_guests\":73,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"},{\"api_id\":\"cat-tech\",\"description\":\"Join a hackathon, jam on product design, and meet fellow tinkerers in the industry of tomorrow.\",\"event_count\":4069,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/lg/3b7cf2a0-077f-40ca-aab8-1a8d07affbd1.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/v7/3f6baafa-d90d-4013-9853-0fa10331f796.png\",\"name\":\"Tech\",\"page_title\":\"Tech Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/z8/cb71384a-87a9-4be7-bbdf-1c2d6381d872.png\",\"slug\":\"tech\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/1908a653-edb9-431e-8ecf-b4d61249a446.png\",\"subscriber_count\":73356,\"tint_color\":\"#5773CF\"}],\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":20,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fdfefe\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We are delighted to invite you to a special Israeli Tech Parliament evening with Nir Eyal, bestselling author of \",\"type\":\"text\"},{\"text\":\"Hooked: How to Build Habit-Forming Products\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"Indistractable: How to Control Your Attention and Choose Your Life\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"His books have been essential reading for product leaders over the past decade, shaping how leading companies think about product design and how millions of people approach personal productivity.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"To mark the launch of his new book, \",\"type\":\"text\"},{\"text\":\"Beyond Belief\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", Nir is joining us to explore how our beliefs shape our careers, the companies we build and the paths we take through life.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We all carry beliefs that hold us back, whether about our abilities, our worth or what is possible. But what if beliefs are not things we are stuck with? What if they are tools we can learn to use?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"In this interactive session, Nir will reveal the surprising science behind how beliefs shape our behaviour and how we can deliberately shift from beliefs that limit us to beliefs that liberate us.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drawing from \",\"type\":\"text\"},{\"text\":\"Beyond Belief\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\", Nir will introduce a practical framework built around three powers:\",\"type\":\"text\"}]},{\"type\":\"ordered_list\",\"attrs\":{\"start\":{\"start\":1}},\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Attention:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" How beliefs act as filters that determine what you notice and what you miss entirely.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Anticipation:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Why what you expect to happen often does, and how to harness this force rather than be controlled by it.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Agency:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Proven techniques for adopting new beliefs that expand what you are capable of achieving.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You will leave with practical strategies to identify the hidden beliefs driving your decisions, break free from self-limiting patterns and build a belief system that propels you forward, both at work and in life.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Bio\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nir Eyal is a bestselling author, speaker, and behavioral design consultant who has spent his career at the intersection of psychology, technology, and human potential. His books Hooked: How to Build Habit-Forming Products and Indistractable: How to Control Your Attention and Choose Your Life have been translated into dozens of languages and have shaped how leading companies think about product design and personal productivity. His latest New York Times bestselling book, Beyond Belief, explores how our beliefs function as powerful tools that can either limit or liberate us. Nir has taught at Stanford's Graduate School of Business \",\"type\":\"text\"},{\"text\":\"d.school\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://d.school\"}}]},{\"text\":\" and has consulted with major organizations on applying behavioral science to real-world challenges. His work has been featured in the Harvard Business Review, The Atlantic, TechCrunch, and Psychology Today. Nir writes at \",\"type\":\"text\"},{\"text\":\"NirAndFar.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://NirAndFar.com\"}}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Agenda\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:30\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Arrival, drinks and networking\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"19:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Talk with Nir Eyal\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"20:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Firgun Time\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"20:15\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" – Networking and drinks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As always, the event is free and designed for members of the Israeli Tech Parliament community, bringing together founders, operators, investors and senior leaders from across the UK–Israel tech ecosystem.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Spaces are limited, so please register only if you genuinely plan to attend.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"*By signing up, you agree that we may share your contact details with the event sponsors (when we have some) as they help make these gatherings possible. They may reach out to you after the event about relevant opportunities or collaborations.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"yy63mqxn\",\"label\":\"What is your LinkedIn profile?\",\"required\":true,\"question_type\":\"linkedin\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
