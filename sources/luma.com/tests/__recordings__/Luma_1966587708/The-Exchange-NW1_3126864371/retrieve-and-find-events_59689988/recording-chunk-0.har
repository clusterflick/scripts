\":\"\",\"first_name\":\"Robert\",\"last_name\":\"Kingham\",\"instagram_handle\":\"minimumlabyrinth\",\"is_verified\":false,\"linkedin_handle\":\"/in/robertkingham\",\"name\":\"Robert Kingham\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"robertkingham\",\"website\":\"http://minimumlabyrinth.org/\",\"youtube_handle\":\"minimumlabyrinth\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#ffe01f\",\"#cd2b00\",\"#623707\"],\"palette\":{\"neutral\":[{\"color\":\"#623707\",\"percentage\":3.46}],\"vibrant\":[{\"color\":\"#ffe01f\",\"percentage\":37.14},{\"color\":\"#cd2b00\",\"percentage\":3.78}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/cq/d2188ea1-eb5e-4a50-bdb5-9b5263c7f9ee.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-C4fYgrF0jpK9KMR\",\"cents\":1250,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-5nkM7VaCn5vBYak\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":10,\"num_guests\":10,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-cECKPA54Y2jisss\",\"cents\":750,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-5nkM7VaCn5vBYak\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"Concession\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":750,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":1250,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":9,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"name\":\"Barbie\",\"type\":\"shader\",\"theme\":\"shader-dark\",\"color1\":\"#e600b1\",\"color2\":\"#e60032\",\"color3\":\"#e69100\"},\"tint_color\":\"#e60032\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Palette of Redemption\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" is \",\"type\":\"text\"},{\"text\":\"Minimum Labyrinth\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://minimumlabyrinth.org/\"}}]},{\"text\":\"'s tenth London walk.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"An individual can seek redemption: through art, music and words. But can a whole district of London be redeemed? Even one that has seen as much darkness and suffering as the old parish of \",\"type\":\"text\"},{\"text\":\"St Giles\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"? This short circular walk explores the hues and histories of these careworn streets through Robert Kingham's artful storytelling.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The walk is part of the Bloomsbury Festival, in support of \",\"type\":\"text\"},{\"text\":\"Making Art Together\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://bloomsburyfestival.org.uk/whats-on/making-art-together\"}}]},{\"text\":\", a day of arts events hosted by Bloomsbury Central Baptist Church. 100% of proceeds from this walk will go to the charity \",\"type\":\"text\"},{\"text\":\"Change For Good\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.changeforgood.info/\"}}]},{\"text\":\", which supports those leaving prison and resettling in London to transform their lives through mentoring, advocacy, and peer support.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Frequently asked questions\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What are the two ticket types? \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"The \",\"type\":\"text\"},{\"text\":\"Standard \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"ticket is £12.50, and there is also a \",\"type\":\"text\"},{\"text\":\"Concession \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"rate of £7.50 (for students, unemployed or low income).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Where is the meeting point?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" Outside \",\"type\":\"text\"},{\"text\":\"Bloomsbury Central Baptist Church\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.bloomsbury.org.uk/\"}}]},{\"text\":\", 235 Shaftesbury Avenue WC2H 8EP.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Where do we end up? \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"Back where we started, but wiser.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"How much walking is there?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" The total length of the walk is c. 2km with, unusually, no pub stops along the way.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"How long does the walk take? \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"60 minutes.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Is the walk suitable for wheelchairs?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" Yes. There are a few areas where steps will pose a mild challenge, but you will have a large group with you who are always delighted to help surmount any challenges.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Are there going to be any other dates? \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"You can sign up to the mailing list at \",\"type\":\"text\"},{\"text\":\"Minimum Labyrinth \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://minimumlabyrinth.org/\"}}]},{\"text\":\"to be the first to hear about future dates for this walk.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Are there ID or minimum age requirements to enter the event?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" No. We suggest that this event is more suitable for over-12s.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What's the refund policy?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" Tickets refundable 30 days before the event. If you need to swap with another advertised date we will do our best to help, but you won't be able to 'bank' your ticket for a future unadvertised event.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Do I have to bring my printed ticket to the event?\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" No, your name will be on the list.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Image: \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"Billy Waters, the King of the Buskers of St Giles. Possibly painted by Sir David Wilkie, 1815. Public domain.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
