_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-sJWLykaWx08cpii\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_36.png\",\"bio_short\":null,\"first_name\":\"Yazmin\",\"last_name\":\"Patel\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Yazmin Patel\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Unfortunately no refunds available\",\"type\":\"text\"}]}]},\"guest_count\":7,\"ticket_count\":7,\"hosts\":[{\"api_id\":\"usr-ASQSkiPTr0WHaQb\",\"avatar_url\":\"https://images.lumacdn.com/uploads/ea/6e568583-278a-4e04-bc1b-4073764c47a9.jpg\",\"bio_short\":\"Ancient practice. Modern discipline.\\nAyurveda for those who’ve tried everything else.\",\"first_name\":\"Roshni\",\"last_name\":\"Patel\",\"instagram_handle\":\"tri.kaya\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Roshni Patel\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://trikaya.co.uk\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#5d4335\",\"#241713\"],\"palette\":{\"neutral\":[{\"color\":\"#241713\",\"percentage\":13.05}],\"vibrant\":[{\"color\":\"#5d4335\",\"percentage\":19.3}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/un/583ad221-2814-476c-aa61-cf2c44262b05.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-CqJBIEgANbz9k3A\",\"cents\":5500,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-oNQE9eeSbhYUlx8\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-C1VaNLnt25w9t6c\",\"description\":\"Discover wellness events around you. Come for a walk, yoga or meditation, learn about nutrition and longevity, and connect with other health-conscious people.\",\"event_count\":928,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/m4/a01e1e0d-17dd-40a7-ba23-db7bd120c7f3.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/y5/4f225f49-0c10-4bba-b1cb-77ae216268ac.png\",\"name\":\"Wellness\",\"page_title\":\"Wellness Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/3n/1854fdc7-af9d-4a63-a174-a9bd8dedbee2.png\",\"slug\":\"wellness\",\"social_image_url\":\"https://images.lumacdn.com/uploads/h4/dbbd8345-1419-4dc0-beb6-1a691ddae4fc.png\",\"subscriber_count\":19694,\"tint_color\":\"#73AFBB\"}],\"ticket_info\":{\"price\":{\"cents\":5500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":49,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#73513c\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"TRI Nāda Event Overview\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a 90 mins live meditative sound journey through Polygon Portal’s 360° incredible listening room, to bring you inwards and return you to your true nature.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Classical Indian instrumental and vocal. Bowls, gong and chanting. Ambient electronic.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Date: Saturday 14 November\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Doors: 4:30pm · Starts sharp 5:00pm\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Price: £55\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A truly unique evening, shared with few. Limited seats — book yours now.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Concept: Nāda\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Before the mind settles, before the body releases, there is sound, vibration. This is Nāda: the primordial vibration at the root of ancient Indian (Vedic) philiosophy, said to underlie all creation, and all healing.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Nāda speaks directly to Vata in Ayurveda, the rhythm at the centre of your nervous system, and its capacity to rest and restore.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Through the TRI Nāda sound journey, your descent inwards happens in three stages: The classical Indian dilruba instrument and voice open with an evening raga, gently loosening the grip of the day. Bowls, gong and quiet, rhythmic chant pull you deeper, until sound and stillness blur into one. Ambient electronic, woven back through the dilruba, closes the arc, with the mind and body finally settling into meditative rest.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As the sound fades, light Ayurvedic refreshments arrive, easing you gently back into the room.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Venue: Polygon Portal\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"One of London's most impressive listening spaces, where the 360° spatial audio system delivers sound from every direction at once.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You'll sink into the comfortable recliners, the lights falling to a calming glow, a soft scent settling the air around you. The room becomes womb-like, and then sound moves everywhere - in front of you, around you and through you - to help you return to your true nature.\",\"type\":\"text\"}]},{\"type\":\"image\",\"attrs\":{\"alt\":null,\"src\":\"https://images.lumacdn.com/uploads/rn/972b2eef-8893-4ce7-b7de-2a96a0bada21.png\",\"width\":1179,\"height\":794,\"image_id\":\"https://cdn.prod.website-files.com/6a54e89d33ac790eab2e926c/6aa1bc167df11ce92fff1075_IMG_9035.PNG-zj9tbc5d7y\",\"mime_type\":\"image/png\",\"uploaded_at\":\"2026-09-13T14:32:56.134+01:00\",\"is_uploading\":false,\"resize_width\":null}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Three Artists:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Gurleen Singh\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", an Afghan heritage musician who specialises in playing the ancient Dilruba instrument and is trained in Sikh Classical singing\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Earth Gold\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a soulful sonic artist weaving improvised vocals, spoken word, mantra and healing frequencies into music over 10 years that inspires connection, embodiment, relaxation and transformation.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Suren Seneviratne\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", a Sri Lankan British sound designer and musician who has worked across composition, radio, studio production and performance for the past 15 years to bring together traditional, global and electronic sounds.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About Trikaya\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Trikaya is a luxury Ayurveda practice founded by Roshni Patel, bringing personalised, evidence-informed Ayurvedic care to modern London life. We provide personalised health reviews and experiential events in the heart of central London, focusing across the three systems of digestion, nervous system and hormonal health.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"trikaya.co.uk\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.trikaya.co.uk\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ig: \",\"type\":\"text\"},{\"text\":\"https://www.instagram.com/tri.kaya?stkn=cWh5MW9kNWQzODdq&utm_source=qr\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/tri.kaya?stkn=cWh5MW9kNWQzODdq&utm_source=qr\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
