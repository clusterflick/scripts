t_color\":\"#b3bcc5\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"\\\"In an increasingly fast-paced and globalised world, architecture is continually adapting to new ways of thinking, making, and collaborating.\\\"\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The 2026 Edition of LTAA Ambassadors of Design will explore the journey from concept to implementation, reflecting on the design, technical, cultural, operational, and contextual challenges that shape architectural practice today.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Under the theme \",\"type\":\"text\"},{\"text\":\"“Not Passing the Torch, but Carrying the Flame Together,”\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" this year’s programme will focus on intergenerational methodologies, shared knowledge, and collective progress as architecture evolves across shifting global contexts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drawing on projects and experiences spanning China, India, Saudi Arabia, Italy, Colombia and beyond, members of the London Turkish Architects Association will share their professional insights, creative visions and reflections on shaping architecture across diverse cultures, scales and functions:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tanıl Raif & Mario Serrano Puche (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"T__M Space\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.t--m.space/\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - LTAA Honorary Member\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"İdil Kantarcı (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Foster + Partners\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.fosterandpartners.com/\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - LTAA Honorary Member\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cemre Demirci (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"ZHA\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.zha.com/\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - LTAA Vice President\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sinan Kafadar (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Metex Design\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://metexdesign.com/\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - Moderator & LTAA Member\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Following the success of the First Edition, LTAA Ambassadors of Design 2026 returns to the recently renovated, Grade II-listed\",\"type\":\"text\"},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"Crafts Council Gallery\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://share.google/rb7RCO2Ieseuwe5bg\"}},{\"type\":\"bold\"}]},{\"text\":\", bringing together LTAA members, international architects, designers, creatives and industry peers to celebrate the global achievements of Turkish architects.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Developed with the valued support of \",\"type\":\"text\"},{\"text\":\"Kale\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", our Main Sponsor, and \",\"type\":\"text\"},{\"text\":\"Çuhadaroğlu\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", our Curatorial Partner, this special evening will also feature complimentary beverages courtesy of \",\"type\":\"text\"},{\"text\":\"Kaner International Limited\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and copies of \",\"type\":\"text\"},{\"text\":\"Ekoyapı Magazine\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", our Official Media Partner, showcasing the work of LTAA members. As part of the evening’s art programme, our Art Partner \",\"type\":\"text\"},{\"text\":\"Carpel \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"will present a special exhibition showcasing the works of artist and colour designer \",\"type\":\"text\"},{\"text\":\"Zeynep Sağır\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event Programme:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:00 | Doors Open + Welcome Drinks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"19:00 | Panel Discussion\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"19:50 | Q&A Session\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"20:10 | Networking & Drinks\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"22:00 | Event Conclusion\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"required\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"evivqvad\",\"label\":\"Company/School\",\"required\":true,\"question_type\":\"company\"},{\"id\":\"utdnny5w\",\"label\":\"Please ensure your contact details are complete and accurate. By attending, you consent to photography and recording for promotional, editorial, and communication purposes.\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
