te\":null,\"youtube_handle\":null},{\"api_id\":\"usr-uTYOGFs4qRGenLB\",\"avatar_url\":\"https://images.lumacdn.com/uploads/ur/b53252cb-fcd6-4925-bb63-041613f1d3cd.jpg\",\"bio_short\":\"Award-winning Global DEI Leader\\nCo-founder, Sista’s Inc.\\nAdvisory Board Member, Energyz Black\\nFounding Custodian, The Collective\",\"first_name\":\"Taylor\",\"last_name\":\"Mirkarimi\",\"instagram_handle\":\"otaylorleeo\",\"is_verified\":false,\"linkedin_handle\":\"/in/taylor-mirkarimi\",\"name\":\"Taylor\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":10,\"ticket_count\":10,\"hosts\":[{\"api_id\":\"usr-2dTSXQuzyFHEnM6\",\"avatar_url\":\"https://images.lumacdn.com/uploads/r6/afa6f1a9-0e3d-45bd-a1dc-6eb2ab76ce6e.png\",\"bio_short\":\"Curated rooms of accomplished women.\",\"first_name\":\"Mel\",\"last_name\":\"theCOLLECTIVE\",\"instagram_handle\":\"thecollective_members\",\"is_verified\":false,\"linkedin_handle\":\"/company/thecollective-members\",\"name\":\"Marketing Mel Consulting\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"_theCOLLECTIVE\",\"website\":\"https://www.thecollectivemembers.co.uk\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#2b1011\",\"#695a33\",\"#efedec\"],\"palette\":{\"neutral\":[{\"color\":\"#efedec\",\"percentage\":0.66}],\"vibrant\":[{\"color\":\"#2b1011\",\"percentage\":27.43},{\"color\":\"#695a33\",\"percentage\":1.54}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/go/d11ab285-5a60-46b2-8064-bb0dec8aff8b.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-Hf86052B3Orkn5L\",\"cents\":2200,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-4CaYsJmxAePf8vr\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":30,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"4\",\"name\":\"Guest of theCOLLECTIVE\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":6,\"num_guests\":6,\"spots_remaining\":24,\"is_disabled\":false},{\"api_id\":\"ttype-Dz4YCb8jFemZvlZ\",\"cents\":1800,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-4CaYsJmxAePf8vr\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":30,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"theCOLLECTIVE member\",\"require_approval\":true,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":26,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1800,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":2200,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#0d0505\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Atelier Edit: After Hours at Aranyani, Mayfair\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"When the doors close to the public, they open exclusively for theCOLLECTIVE.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For one evening, we’re taking over Aranyani’s Mayfair boutique for an intimate, after-hours journey into the world of the luxury house, exploring the \",\"type\":\"text\"},{\"text\":\"Indian heritage, artistry and craftsmanship\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" that inspire its one-of-one creations.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Our evening begins with a \",\"type\":\"text\"},{\"text\":\"sparkling reception, signature drinks and elevated Indian-inspired bites and canapés\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", thoughtfully chosen to bring a taste of the culture behind the house into the experience.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As the evening unfolds, the Aranyani team will personally guide us through the enchanting stories behind the collection — from its forest-inspired philosophy and symbolism to the exceptional materials, intricate techniques and considered details that make each piece entirely unique.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Across two floors, guests will discover a curated edit of hero pieces, hear the inspiration behind their creation, explore \",\"type\":\"text\"},{\"text\":\"styling and personal expression\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", and step into the intimate VIP lounge to discover personalisation, embossing, accessories and the finishing touches behind the craft.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"With the boutique \",\"type\":\"text\"},{\"text\":\"closed exclusively for our guests\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and the Aranyani team hosting us personally throughout the evening, this is not simply an opportunity to view a collection.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It is an invitation into the world behind it.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"DRESS CODE: VIBRANT ELEGANCE\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Inspired by the richness of colour found throughout Aranyani’s collections and Indian culture, we invite you to embrace \",\"type\":\"text\"},{\"text\":\"sophisticated colour, beautiful silhouettes and personal expression.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expect craft. Culture. Storytelling. Beautiful hospitality. And, as always, \",\"type\":\"text\"},{\"text\":\"exceptional company. When the event comes to a close we will be enjoying a nightcap at a local watering hole in Mayfair, details TBC.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome to The Atelier Edit.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Attendance \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"capped at 40\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\". Members and guests alike are encouraged to confirm at earliest convenience.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
