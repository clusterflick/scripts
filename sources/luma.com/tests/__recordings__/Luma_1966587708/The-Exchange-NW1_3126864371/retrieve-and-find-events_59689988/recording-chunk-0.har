one\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":39,\"ticket_count\":39,\"hosts\":[{\"api_id\":\"usr-pFFHFvlD3Yj2HWn\",\"avatar_url\":\"https://images.lumacdn.com/avatars/fi/058c208c-cac3-44fb-abc0-b6e8de08aa97\",\"bio_short\":null,\"first_name\":\"Notes from\",\"last_name\":\"Below\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Notes from Below\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":\"NotesFrom_Below\",\"username\":null,\"website\":\"https://notesfrombelow.org/\",\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f7e589\",\"#e51f26\",\"#290f09\"],\"palette\":{\"neutral\":[{\"color\":\"#290f09\",\"percentage\":0.55}],\"vibrant\":[{\"color\":\"#e51f26\",\"percentage\":8.32},{\"color\":\"#f7e589\",\"percentage\":12.25}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/3z/bbed9942-d867-46b9-9fc9-3d76ab117fa4.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-2RVxZyEkm4ewQq7\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-BbdQ8OLFK8DjwvX\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":39,\"num_guests\":39,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#efdd88\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a book launch and discussion on contemporary urban politics with Neil Gray, author of the newly released Take Over The City: Spatial Composition in Italian Autonomy!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"More Details to follow!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6pm - Doors Open\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6.30pm - Launch & Discussion begins\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bar & Snacks available across the night!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is a Pelican House Social Club event. Please register to attend – this will automatically sign you up as a member (for free), and means you can enjoy drinks at our bar.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"---\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✊1970s Italy saw urban uprisings across its cities, as working class residents occupied their houses, hospitals and neighbourhoods. A wave of revolutionary activity, best known by the slogan 'Take Over The City!', this moment is a vital reference point for today's campaigns and struggles over land and urban life! In his new book,\",\"type\":\"text\"},{\"text\":\" Take Over The City: Spatial Composition in Italian Autonomy (Common Notions 2026)\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.commonnotions.org/buy/take-over-the-city?srsltid=AU7gw4XD-KaJwMmCgH8R-zUhpUNFRsiH87-9E-k09_lzR6rlSInBE8CI\"}}]},{\"text\":\", Neil Gray offers the first developed account of how these movements were rooted in the shifts of post-war Italian capitalism, and develops a radical framework for understanding how militants have turned to the streets and social life to challenge the state and capitalist power.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"🏢This book launch will also be a space to hear from activists participating in a number of contemporary campaigns and struggles - over space, housing and community life - as we collectively make sense over the transformation of our cities and towns.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📑The \",\"type\":\"text\"},{\"text\":\"MayDay Rooms \",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://maydayrooms.org/\"}}]},{\"text\":\"will also be holding an archival display of print materials that circulated amongst activists in these years of rebellion. As pamphlets, newspapers and militants moved across borders, a powerful network formed to support, and make sense of, working class-activity that was rapidly developing across Europe - come along to see this important collection of radical history!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📸The book launch coincides with the opening of a new, vast photography exhibition documenting Critical Mass in London. A leaderless murmuration of cyclists that has continued to dis-organise itself for monthly ride across London since 1994, Critical Mass has collectively moved through the city's boroughs in opposition to the all-powerful presence of cars and in an act of controlled chaos. This exhibition on the first floor of the Pelican House event space documents the highs, lows, community, challenges and potential that the ride has experienced across the years.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
