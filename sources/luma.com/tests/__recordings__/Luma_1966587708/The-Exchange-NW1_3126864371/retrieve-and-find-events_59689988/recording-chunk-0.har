8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":1000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":13,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#bb7c03\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Working on a current project? Want to meet new people and enjoy great coffees and cakes? Join the\",\"type\":\"text\"},{\"text\":\" Coffee & Craft Morning\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" at Kiju Coffee House!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’re a seasoned pro or just picking up a new hobby, bring your knitting, crochet, sketching, or any portable craft along for a morning of creativity and convos. If you don’t have a project at the moment, no worries - join us to see what others are up to! I will also be bringing extra materials for sketching and painting on the day if you’re interested in trying something new 🎨🧶\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your ticket includes a drink and a slice of cake to enjoy while you create! ☕️🍰 Please note, tickets are non refundable.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"For any questions, DM on instagram @thebatchpress\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
