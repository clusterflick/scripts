e\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Aljon\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-YtEeFCDWQ3ScEdA\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_37.png\",\"bio_short\":null,\"first_name\":\"Aisha\",\"last_name\":\"\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Aisha\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-zNigGw1OnR1iqxi\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_39.png\",\"bio_short\":null,\"first_name\":\"Mikela\",\"last_name\":\"Alvarado\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Mikela Alvarado\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you can't attend anymore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via email on team@becomingali.com and we will be able to refund you \",\"type\":\"text\"},{\"text\":\"only\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can find someone on the Waitlist to take your spot. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Please note that if the event has not reached capacity to develop a Waitlist yet, we cannot process any refunds. We also \",\"type\":\"text\"},{\"text\":\"cannot\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" process \",\"type\":\"text\"},{\"text\":\"same-day\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" refunds or waitlist exchanges. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Some events we run are non-refundable due to logistics and this is usually specified in the event description.\",\"type\":\"text\"}]}]},\"guest_count\":65,\"ticket_count\":65,\"hosts\":[{\"api_id\":\"usr-xKBHGQBW3FEjAJr\",\"avatar_url\":\"https://images.lumacdn.com/uploads/do/07282fcd-521f-46b8-919c-eb7bcc73d84f.png\",\"bio_short\":\"\",\"first_name\":\"ABRC\",\"last_name\":\"\",\"instagram_handle\":\"becomingalii\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"ABRC\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":\"\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#2e2925\",\"#4e3e31\",\"#7e5b3e\",\"#fcfcfa\"],\"palette\":{\"neutral\":[{\"color\":\"#2e2925\",\"percentage\":14.02},{\"color\":\"#fcfcfa\",\"percentage\":9.62},{\"color\":\"#4e3e31\",\"percentage\":11.39}],\"vibrant\":[{\"color\":\"#7e5b3e\",\"percentage\":11.38}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/js/65188566-7461-489f-9a7f-56ded56f78e9.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-nh33PadkQ1qBJXt\",\"cents\":1200,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-qhiX2v1fENeJYIP\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"STANDARD\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":64,\"num_guests\":64,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":{\"cents\":1200,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"waitlist\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#36261f\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"snpro\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join \",\"type\":\"text\"},{\"text\":\"ABRC (Anti-Brainrot Club)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" for the ultimate anti-brainrot evening at \",\"type\":\"text\"},{\"text\":\"Cremer\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Bring your current read, browse the café's library, or pick from a selection of curated fiction classics for some uninterrupted silent reading time. You'll also get to mingle with other attendees through a reader's bingo and enjoy drinks and snacks from Cremer!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All tickets include \",\"type\":\"text\"},{\"text\":\"one complimentary fiction book\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" which you'll get to take home with you. Please note that tickets do \",\"type\":\"text\"},{\"text\":\"not\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" include the cost of food and drinks.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come solo and meet like-minded strangers, or bring a friend! Either way, it's going to be a cozy evening!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"ANTI-BRAINROT CLUB (ABRC) is a creative and intellectual community for those who want to get off their phones, meet like-minded people, and build interesting lives!\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"_______________________________\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Disclaimers:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you join the Waitlist, \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"there will be a \",\"type\":\"text\"},{\"text\":\"temporary charge\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" on your card which will be released if you are not approved for the event. This is Luma's policy and we do not have access to these funds.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"If you can't attend anymore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", please contact us via email on \",\"type\":\"text\"},{\"text\":\"team@becomingali.com\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and we will be able to refund you \",\"type\":\"text\"},{\"text\":\"only\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" if we can find someone on the Waitlist to take your spot. Please note that if the event has not reached capacity to develop a Waitlist yet, we cannot process any refunds. \",\"type\":\"text\"},{\"text\":\"We also cannot process same-day refunds or waitlist exchanges.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":true,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":true,\"route\":null,\"featured_city\":null}",
