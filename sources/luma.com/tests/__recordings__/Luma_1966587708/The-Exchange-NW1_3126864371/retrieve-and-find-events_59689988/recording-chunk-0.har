ext\":\"Due to venue hiring costs, we are unable to offer refunds for Shruti Sound Circle events.\",\"type\":\"text\"}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-yaD7XFBcdmEJaHh\",\"avatar_url\":\"https://images.lumacdn.com/avatars/jo/7c67b14e-4c46-447d-8595-ae167c813fbf.png\",\"bio_short\":\"A queer and trans+ inclusive sound yoga and arts community.\",\"first_name\":\"Shruti\",\"last_name\":\"Collective\",\"instagram_handle\":\"shruti_collective\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Shruti Collective\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"_shruti\",\"website\":\"https://www.shruticollective.com\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#f7be74\"],\"palette\":{\"neutral\":[],\"vibrant\":[{\"color\":\"#f7be74\",\"percentage\":98.69}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/wk/e14d6a6e-1a62-48f6-871c-9fce7c260957.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-m2OOFxO7BAS7YBF\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"For folks who may need some extra financial assistance.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-shiVOJIDZVl3ROn\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":4,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"3\",\"name\":\"Supported\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":4,\"is_disabled\":false},{\"api_id\":\"ttype-DMmjAjpKwWGs8RX\",\"cents\":900,\"currency\":\"gbp\",\"description\":\"A standard ticket for those who can afford to cover venue hire and/or snack costs.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-shiVOJIDZVl3ROn\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":9,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"5\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":6,\"is_disabled\":false},{\"api_id\":\"ttype-N9napHECdPtS2cU\",\"cents\":1200,\"currency\":\"gbp\",\"description\":\"For those who can contribute a little bit more to Shruti operating costs.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-shiVOJIDZVl3ROn\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":5,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"7\",\"name\":\"Abundance\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":5,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":1200,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":22,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f7be74\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"roc-grotesk\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Overview\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Shruti is a peer community for new and emerging devotional musicians and singers to connect and practice together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We welcome all levels of experience working with voice, sound, mantra, kirtan, sound healing and devotional music, to join us for our drop-in practice sessions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join the whatsapp group here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://chat.whatsapp.com/DmsV2OegNJSFHXQj9974RL?mode=gi_t\"}}]},{\"text\":\" or learn more: \",\"type\":\"text\"},{\"text\":\"www.shruticollective.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.shruticollective.com\"}}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Thursday September 24\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This Circle we welcome Venus (they/them), a queer devotional singer and kirtaneer, to lead us in a shared kirtan\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Venus is a London-based wellbeing facilitator with over nine years of experience in guiding diverse modalities, including Yoga, Pilates, Sound Healing, Kirtan, and Reiki. They are also a vocalist and musician, performing as part of Othon ◯ Venus, where they blend cutting-edge electronic sounds with Mantra.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"As a passionate advocate for equality and accessibility within the wellbeing space, Venus regularly leads yoga and sound sessions at the London LGBT+ Center. They are the founder of The 11th House, an initiative dedicated to providing accessible wellbeing services that center queer and marginalized intersectional identities.  In addition to their work in wellbeing, Venus is a dynamic performance artist and burlesque performer. A proud graduate of the Black Burlesque School, they have graced the stages of notable events such as the Medicine Festival, Papaloko, Riposte, and Torture Garden.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Learn more through \",\"type\":\"text\"},{\"text\":\"Venus' instagram\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/othonovenus/\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"How it works\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come to practice or support others with your voice and instrument! There will be a lot of singing, chanting and music making. We also have a chance for people to connect, share, and build sangha together.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you'd like to lead the circle for 10-15 minutes, please fill out the form when purchasing a ticket. Circle Leads will announce whether they'd like accompanying instruments and sounds or not.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will have a harmonium and mridanga for people to use, so please bring any other instruments you'd like to play.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please arrive 5-minutes before 7pm so that we can settle in together. We will then start with a voice meditation practice and we would like to ensure there's no noise of people entering the space late.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will provide, cushions, snacks and refreshments as well but please bring your water bottle or snacks as needed.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"_______________________________________\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Community Guidelines\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is a sober and queer and trans+ inclusive space, rooted in respect, care and shared exploration.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Ticket Assistance\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Please contact support@shruticollective.com if prices are a barrier to attending.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"wtjhcyai\",\"label\":\"Do you want to lead a sound practice? (You will have 10-15-mins to lead.)\",\"options\":[\"Yes\",\"No\"],\"required\":false,\"question_type\":\"dropdown\"},{\"id\":\"p23eq5u8\",\"label\":\"What will you be practicing? E.g. kirtan, sound bath, singing, instrument etc\",\"required\":true,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
