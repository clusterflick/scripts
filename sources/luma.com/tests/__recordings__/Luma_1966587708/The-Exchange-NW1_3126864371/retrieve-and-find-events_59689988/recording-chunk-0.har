          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"api_id\":\"evt-RiD8mP7J7P6FW7n\",\"accepts_usdc_for_usd\":false,\"calendar\":{\"access_level\":\"public\",\"api_id\":\"cal-YsrJozJ532nOmgW\",\"avatar_url\":\"https://images.lumacdn.com/uploads/fa/d52e28ed-63a3-42a2-82bb-29300217623e.png\",\"coordinate\":{\"longitude\":-0.23785350000000002,\"latitude\":51.5000049},\"cover_image_url\":\"https://images.lumacdn.com/uploads/be/242c6ac7-4d1d-4557-96a4-87f97f37cf25.png\",\"description_short\":\"Come vibe with us at the Clubhouse during our 1st BHM residency. More to come soon.\\n\\n📍Hammersmith (near the station)\\n\\nChoose your membership ↘\",\"end_date\":null,\"event_submission_restriction\":\"open\",\"google_measurement_id\":null,\"instagram_handle\":\"yaad.irl\",\"is_blocked\":false,\"is_verified\":false,\"launch_status\":\"launched\",\"linkedin_handle\":\"/company/yaad-cic\",\"location\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJwzfTXMEPdkgRAGfsoi2uDgQ\",\"timezone\":\"Europe/London\",\"localized\":{\"en-GB\":{\"city\":\"London\",\"region\":\"England\",\"country\":\"United Kingdom\"}},\"country_code\":\"GB\"},\"luma_plan\":\"plus\",\"luma_plus_active\":true,\"meta_pixel_id\":null,\"name\":\"YAAD's Black History Month Clubhouse\",\"personal_user_api_id\":null,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"By purchasing a YAAD October BHM Residency Membership, you agree to the following:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership access\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership gives you access to YAAD's home for October — co-working, makerspace equipment, lounge space, and our full BHM programme of workshops and events. Tuesday to Saturday, 10am-10pm; Sunday, 11am-6pm. Some equipment may be temporarily unavailable when it's off-site for a corporate workshop booking — we'll give as much notice as we can.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Full Access members' free studio time of up to 4 hours at Pirate Studios is subject to availability and is not guaranteed for the full month — we'd recommend booking your slot as early as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Opening hours\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Our hours are based on expected usage and may change during October depending on how the space is actually being used. We'll always give members as much notice as possible of any change.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"25+\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD is a 25+ space. Only purchase a membership or tickets if you are 25 or over. No refunds will be given for lack of adherence to this policy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Payment and billing\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This is a one-off payment covering your membership for October only. Sign-ups are reviewed and approved individually; you won't be charged until your membership is approved. You can cancel at any time before your membership is approved with no charge taken.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refund policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Membership payments already taken are non-refundable. Please make sure the membership is right for you before signing up; we're happy to answer any questions at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\" or \",\"type\":\"text\"},{\"text\":\"instagram.com/yaad.irl\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://instagram.com/yaad.irl\"}}]},{\"text\":\" before you commit.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Equipment and hazard risk\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD's makerspace includes equipment such as sewing machines, a Cricut machine, hot glue guns and a heat press. By using any YAAD equipment, you acknowledge that some tools carry inherent risk of injury (including burns, cuts or similar), and you agree to use them at your own risk and in line with any guidance provided on-site. YAAD is not liable for injury or damage arising from equipment use, except where caused by our negligence.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This October, YAAD is based in Hammersmith. The exact venue is subject to change until contracts are finalised — if it does change, it will remain within Zone 2, in the W, NW or SW London postcode areas.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Events and programme\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"All workshops and events are subject to change, including cancellation, rescheduling, or facilitator changes. We'll always give members as much notice as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Some Friday evening events require a £10 no-show hold when booking. This isn't a ticket price — it's fully refundable and is only kept if you don't check in.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Launch offer (sign up by 21 September)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Full Access (£60) members who sign up by 21 September can (1) bring a friend for free on one evening of their choosing during October, excluding Fridays and (2) the first 24 people to sign up also receive a free Black Tech Fest 2026 Day + Party ticket. Both offers apply once per member and are non-transferable.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Day passes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Day passes are non-refundable and follow the same 25+ policy as membership. Day pass holders are covered by the same photography/videography consent and equipment terms set out in these terms and conditions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography and videography\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD events may be photographed and filmed for community and promotional use. By attending, you consent to being captured in event photography and video content. If you have specific concerns, please let us know on the door and we'll do our best to accommodate you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership period\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership covers the duration of the October residency (1-31 October).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Data\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"We'll use your details to contact you about YAAD events and updates. We won't share your information with third parties without your permission.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Questions?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Email us at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"'Yaad' is a term of endearment for 'home' in Jamaican Patois and is used to describe one's house, roots and comfort.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"slug\":\"yaadbhm26\",\"social_image_url\":\"https://images.lumacdn.com/uploads/id/8e23e557-43b2-4d2b-8cf0-7af67e3aa973.png\",\"start_date\":null,\"stripe_account_id\":\"acct_1TftAtE382iycghr\",\"tax_config\":null,\"tiktok_handle\":null,\"tint_color\":\"#451128\",\"track_meta_ads_from_luma\":false,\"twitter_handle\":null,\"verified_at\":\"2026-09-05T10:46:39.153Z\",\"website\":\"https://yaad.space\",\"youtube_handle\":null,\"is_personal\":false,\"personal_user\":null,\"timezone\":\"Europe/London\",\"charges_enabled\":true,\"payment_methods\":[]},\"meta_pixel_id\":null,\"coupon\":null,\"google_measurement_id\":null,\"stripe_account_id\":\"acct_1TftAtE382iycghr\",\"payment_methods\":[],\"tax_config\":null,\"event\":{\"api_id\":\"evt-RiD8mP7J7P6FW7n\",\"calendar_api_id\":\"cal-YsrJozJ532nOmgW\",\"cover_url\":\"https://images.lumacdn.com/uploads/yd/ba2a32ee-c1b5-45c3-beaa-8feb63c9c774.jpg\",\"end_at\":\"2026-10-09T21:00:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"YAAD Clubhouse: Work, Create, Lounge + BHM Quiz & Karaoke (Black History Month)\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/kn/f76c7a5c-baf5-4d3a-a467-287c70f06a34.png\",\"start_at\":\"2026-10-09T09:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"331jutg7\",\"user_api_id\":\"usr-9kJAr7aCciYOfsf\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"mode\":\"obfuscated\",\"city\":\"London\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"country\":\"United Kingdom\",\"country_code\":\"GB\",\"region\":\"England\",\"region_short\":\"England\"},\"geo_address_visibility\":\"guests-only\",\"coordinate\":{\"latitude\":51.49159440026095,\"longitude\":-0.21841468680072365},\"waitlist_enabled\":false,\"waitlist_status\":\"disabled\"},\"start_at\":\"2026-10-09T09:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"By purchasing a YAAD October BHM Residency Membership, you agree to the following:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership access\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership gives you access to YAAD's home for October — co-working, makerspace equipment, lounge space, and our full BHM programme of workshops and events. Tuesday to Saturday, 10am-10pm; Sunday, 11am-6pm. Some equipment may be temporarily unavailable when it's off-site for a corporate workshop booking — we'll give as much notice as we can.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Full Access members' free studio time of up to 4 hours at Pirate Studios is subject to availability and is not guaranteed for the full month — we'd recommend booking your slot as early as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Opening hours\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Our hours are based on expected usage and may change during October depending on how the space is actually being used. We'll always give members as much notice as possible of any change.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"25+\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD is a 25+ space. Only purchase a membership or tickets if you are 25 or over. No refunds will be given for lack of adherence to this policy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Payment and billing\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This is a one-off payment covering your membership for October only. Sign-ups are reviewed and approved individually; you won't be charged until your membership is approved. You can cancel at any time before your membership is approved with no charge taken.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Refund policy\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Membership payments already taken are non-refundable. Please make sure the membership is right for you before signing up; we're happy to answer any questions at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\" or \",\"type\":\"text\"},{\"text\":\"instagram.com/yaad.irl\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://instagram.com/yaad.irl\"}}]},{\"text\":\" before you commit.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Equipment and hazard risk\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD's makerspace includes equipment such as sewing machines, a Cricut machine, hot glue guns and a heat press. By using any YAAD equipment, you acknowledge that some tools carry inherent risk of injury (including burns, cuts or similar), and you agree to use them at your own risk and in line with any guidance provided on-site. YAAD is not liable for injury or damage arising from equipment use, except where caused by our negligence.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This October, YAAD is based in Hammersmith. The exact venue is subject to change until contracts are finalised — if it does change, it will remain within Zone 2, in the W, NW or SW London postcode areas.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Events and programme\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"All workshops and events are subject to change, including cancellation, rescheduling, or facilitator changes. We'll always give members as much notice as possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Some Friday evening events require a £10 no-show hold when booking. This isn't a ticket price — it's fully refundable and is only kept if you don't check in.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Launch offer (sign up by 21 September)\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Full Access (£60) members who sign up by 21 September can (1) bring a friend for free on one evening of their choosing during October, excluding Fridays and (2) the first 24 people to sign up also receive a free Black Tech Fest 2026 Day + Party ticket. Both offers apply once per member and are non-transferable.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Day passes\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Day passes are non-refundable and follow the same 25+ policy as membership. Day pass holders are covered by the same photography/videography consent and equipment terms set out in these terms and conditions.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography and videography\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"YAAD events may be photographed and filmed for community and promotional use. By attending, you consent to being captured in event photography and video content. If you have specific concerns, please let us know on the door and we'll do our best to accommodate you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Membership period\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Your membership covers the duration of the October residency (1-31 October).\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Data\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"We'll use your details to contact you about YAAD events and updates. We won't share your information with third parties without your permission.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Questions?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Email us at \",\"type\":\"text\"},{\"text\":\"homeislondon.cic@gmail.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"mailto:homeislondon.cic@gmail.com\"}}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"'Yaad' is a term of endearment for 'home' in Jamaican Patois and is used to describe one's house, roots and comfort.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-9kJAr7aCciYOfsf\",\"avatar_url\":\"https://images.lumacdn.com/uploads/s7/8b399794-da7e-4651-bfda-ec6f773bf145.jpg\",\"bio_short\":\"25+ multifunctional makerspace, coworking hub & social members’ club. Join our £30 summer taster membership before we open a permanent space\",\"first_name\":\"YAAD\",\"last_name\":\"CIC\",\"instagram_handle\":\"yaad.irl\",\"is_verified\":false,\"linkedin_handle\":\"/company/yaad-cic\",\"name\":\"YAAD CIC\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"theeyaadie\",\"website\":\"https://yaad.space\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#0c0703\",\"#ff4d29\",\"#579058\",\"#e3e1e2\"],\"palette\":{\"neutral\":[{\"color\":\"#0c0703\",\"percentage\":29.21},{\"color\":\"#e3e1e2\",\"percentage\":4.59}],\"vibrant\":[{\"color\":\"#ff4d29\",\"percentage\":18.81},{\"color\":\"#579058\",\"percentage\":13.84},{\"color\":\"#8fbfe7\",\"percentage\":3.35},{\"color\":\"#f4bf5f\",\"percentage\":0.69}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/kn/f76c7a5c-baf5-4d3a-a467-287c70f06a34.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-hvCseGg5R5nLXRY\",\"cents\":2000,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-RiD8mP7J7P6FW7n\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Day pass (non-members)\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":0,\"num_guests\":0,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-M4vB24ttfTcU3w9\",\"cents\":null,\"currency\":null,\"description\":\"Available to YAAD's Black History Month Members\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-RiD8mP7J7P6FW7n\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":{\"type\":\"memberships\",\"calendar_membership_tier_api_ids\":[\"calmemtier-xcvycjrkxytlc6j\",\"calmemtier-g15g7h4m1imir2g\"]},\"min_cents\":null,\"position\":\"9\",\"name\":\"BHM Membership\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":true}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-games\",\"description\":\"From board game nights and trivia to D&D and video game tournaments, find people to play with.\",\"event_count\":522,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/fp/e9e203d3-6008-4b07-b81a-210a7a028641.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/mp/c65f64de-a537-4867-b7e6-7eedd3470c82.png\",\"name\":\"Games\",\"page_title\":\"Gaming Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/8x/f6681658-cbe7-49d1-a0f2-bed1caef68c2.png\",\"slug\":\"games\",\"social_image_url\":\"https://images.lumacdn.com/uploads/lz/02ab05fa-99c8-43b7-b3f4-d97855ab1766.png\",\"subscriber_count\":1525,\"tint_color\":\"#AF7A35\"}],\"ticket_info\":{\"price\":{\"cents\":2000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#fd4b2a\",\"can_register_for_multiple_tickets\":true,\"font_title\":\"new-spirit\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Every Friday in October is YAADay. We've got \",\"type\":\"text\"},{\"text\":\"work\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" space, \",\"type\":\"text\"},{\"text\":\"creative\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" space and \",\"type\":\"text\"},{\"text\":\"lounge\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" space - all yours from 10am-10pm. Come for the morning, come for the afternoon, or come for the whole day.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"10am-6pm — Co-work and co-create\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Desks, wifi and good company if you're working. Sewing machines, a Cricut, heat press and craft supplies if you're making. Repair something, customise something, start something alongside others.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6pm-10pm — BHM Quiz and Karaoke Night\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"How much do you really know about your roots? Prepare for questions on Black history, music and culture, and a microphone that nobody can be talked out of cause the music is 10/10.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Free for YAAD members with a BHM membership. Or £20 for a day pass if you're not a member which covers the full 10am-10pm. Get your BHM membership here: \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"luma.com/yaadbhm26\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://luma.com/yaadbhm26\"}},{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"---\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Equipment on site to use (for free):\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"DJ setup - decks, headphones + speakers (afternoon onwards)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Sewing machines (x2)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cricut Maker 3 machine\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cricut Heat press\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Craft supplies (paints, brushes, pens, hot glue gun etc)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Fabrics\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography setup - lighting, backdrop stand (ask a team member to set up)\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Podcast/content studio setup (tbc, check our IG for updates)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Drinks and snacks available in the clubhouse.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"​Black Black Blackity Black\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're proud to be exhibiting Black art and Black brands in our space this month. If you want to find our more about them or buy their work, simply scan the QR codes next to their work.\",\"type\":\"text\"}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"​YAAD yuh seh?!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're a new non-profit CIC building a clubhouse for the Culture and the Curious: a multifunctional makerspace, co-working hub and third space for over-25s in West London. We ran 29 creative workshops and events over the summer, but you don't have to call yourself a creative to join us.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"From the corporate mandem to app founders, filmmakers to marketing associates, hobbymaxers to designers - everyone's welcome, and you deserve to be here.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is our first month-long residency and our first Black History Month. Expect a warm and sophisticated space that smells like Oud and is inspired by Caribbean and African interiors.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"kdkcc11l\",\"label\":\"Do you identify as part of a minority or underrepresented group?\",\"options\":[\"Yes\",\"No\",\"Prefer not to say\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"57xvbn3l\",\"label\":\"YAAD operates as a 25+ space. I confirm I'm 25 or over.\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[{\"api_id\":\"calmemtier-xcvycjrkxytlc6j\",\"access_info\":{\"type\":\"payment-once\",\"amount\":4500,\"currency\":\"gbp\",\"require_approval\":true},\"description\":\"Access to YAAD's clubhouse every Friday - co-working, creative space & equipment, and our evening events. \",\"registration_questions\":[{\"id\":\"cvkymknj\",\"label\":\"Phone number\",\"required\":true,\"question_type\":\"phone-number\"},{\"id\":\"a9ofmmjz\",\"label\":\"Date of birth (dd/mm/yyyy)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"upowa56k\",\"label\":\"How did you hear about YAAD?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"665b0jel\",\"label\":\"If someone told you about YAAD, let us know who so we can thank them!\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"g2ud38vh\",\"label\":\"What do you do? Tell us a bit about your work, practice or project (btw you don't have to be in a creative field to join YAAD)\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"tshvd11n\",\"label\":\"Ethnicity\",\"options\":[\"Black African\",\"Black Caribbean\",\"Black — other\",\"Mixed: White and Black Caribbean\",\"Mixed: White and Black African\",\"Mixed: White and Asian\",\"Mixed — other\",\"Asian Indian\",\"Asian Pakistani\",\"Asian Bangladeshi\",\"Asian Chinese\",\"Asian — other\",\"White British\",\"White — other\",\"Arab\",\"Other ethnic group\",\"Prefer not to say\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"bwrj5rxl\",\"label\":\"Gender\",\"options\":[\"Male\",\"Female\",\"Non-binary\",\"Prefer not to say\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"x1nt19sd\",\"label\":\"Which of our events are you most excited about?\",\"options\":[\"Dance class\",\"Sew and repair class\",\"Waistbeads workshop\",\"BHM quiz and karaoke\",\"Creative + Tech build-a-thon\",\"Music production workshops\",\"Birthday social\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"gw3elln5\",\"label\":\"Any accessibility requirements?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"ase3g6p7\",\"label\":\"YAAD operates as a 25+ space. I confirm I'm 25 or over.\",\"required\":true,\"question_type\":\"agree-check\"}],\"calendar_api_id\":\"cal-YsrJozJ532nOmgW\",\"tint_color\":\"#682FFF\",\"name\":\"BHM Membership (Fridays only)\"},{\"api_id\":\"calmemtier-g15g7h4m1imir2g\",\"access_info\":{\"type\":\"payment-once\",\"amount\":6000,\"currency\":\"gbp\",\"require_approval\":true},\"description\":\"Access to YAAD's clubhouse Tuesday to Sunday - co-working, creative space & equipment, our evening events. Plus 4 hours free studio time, and music production sessions. Register by 21 Sept and bring a friend for free for one evening (excluding Fridays) PLUS the first 24 people to sign up get a FREE Black Tech Fest ticket for October 29th. \",\"registration_questions\":[{\"id\":\"uuokn80c\",\"label\":\"Phone number\",\"required\":true,\"question_type\":\"phone-number\"},{\"id\":\"h4dwlpoo\",\"label\":\"Date of birth (dd/mm/yyyy)\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"iewqexix\",\"label\":\"How did you hear about YAAD?\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"6xpxh3yj\",\"label\":\"If someone told you about YAAD, let us know who so we can thank them!\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"e00qhgnb\",\"label\":\"What do you do? Tell us a bit about your work, practice or project (btw you don't have to be in a creative field to join YAAD)\",\"required\":true,\"question_type\":\"long-text\"},{\"id\":\"fjsnbpkf\",\"label\":\"Ethnicity\",\"options\":[\"Black African\",\"Black Caribbean\",\"Black — other\",\"Mixed: White and Black Caribbean\",\"Mixed: White and Black African\",\"Mixed: White and Asian\",\"Mixed — other\",\"Asian Indian\",\"Asian Pakistani\",\"Asian Bangladeshi\",\"Asian Chinese\",\"Asian — other\",\"White British\",\"White — other\",\"Arab\",\"Other ethnic group\",\"Prefer not to say\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"4wvakivn\",\"label\":\"Gender\",\"options\":[\"Male\",\"Female\",\"Non-binary\",\"Prefer not to say\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"dpcv8kc3\",\"label\":\"Which days would you typically use the space?\",\"options\":[\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"86dtcwky\",\"label\":\"Which of our events are you most excited about?\",\"options\":[\"Dance class\",\"Sew and repair class\",\"Waistbeads workshop\",\"BHM quiz and karaoke\",\"Creative + Tech build-a-thon\",\"Music production workshops\",\"Birthday social\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"as354vka\",\"label\":\"Which YAAD equipment are you most likely to use?\",\"options\":[\"Sewing machine\",\"Cricut Maker 3\",\"Heat press\",\"DJ equipment\",\"Photography equipment\",\"Craft supplies\",\"N/A\"],\"required\":true,\"question_type\":\"multi-select\"},{\"id\":\"1i6ixpnr\",\"label\":\"Is there any other equipment you'd love in the space? Think big\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"zx879wgr\",\"label\":\"The first 24 people to sign up get a free Black Tech Fest ticket for October 29th. If you're in the first 24, do you want it?\",\"options\":[\"Yessir!\",\"Nah I'm good\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"2isixjoq\",\"label\":\"Any accessibility requirements?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"gsrxlqsp\",\"label\":\"YAAD operates as a 25+ space. I confirm I'm 25 or over.\",\"required\":true,\"question_type\":\"agree-check\"}],\"calendar_api_id\":\"cal-YsrJozJ532nOmgW\",\"tint_color\":\"#146AEB\",\"name\":\"BHM Membership (Full access)\"}],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
