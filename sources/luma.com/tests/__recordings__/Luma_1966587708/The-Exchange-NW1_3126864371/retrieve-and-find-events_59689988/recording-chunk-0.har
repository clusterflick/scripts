try to show\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-k9CqH89TrIXscNa\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"General Admission\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":8,\"num_guests\":8,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-eED6KlCPy1CDD4A\",\"cents\":5000,\"currency\":\"gbp\",\"description\":\"Front-row seat, welcome drink, priority entry, and exclusive goodie bag.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-k9CqH89TrIXscNa\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"9\",\"name\":\"VIP / Front Row\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":9,\"num_guests\":9,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-vEzGt3BnFACaUhi\",\"cents\":2500,\"currency\":\"gbp\",\"description\":\"This is a charitable donation only and does NOT include entry to the show. To attend the SOLMA Charity Fashion Show, please purchase a General Admission or VIP / Front Row ticket. Every donation helps provide orphaned children with clothing, food, and hope for a brighter future. Thank you for your generosity.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-k9CqH89TrIXscNa\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"95\",\"name\":\"Donation\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":1,\"num_guests\":1,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":{\"cents\":2500,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":{\"cents\":5000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":82,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#f4ebde\",\"can_register_for_multiple_tickets\":true,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for an unforgettable evening where fashion meets purpose.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The \",\"type\":\"text\"},{\"text\":\"SOLMA Charity Fashion Show\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is more than a runway event—it is a movement dedicated to creating a brighter future for orphaned children in Senegal. Every ticket purchased helps support our mission to provide clothing, hope, and dignity to children who need it most.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Founded in 2014, SOLMA — meaning \",\"type\":\"text\"},{\"text\":\"\\\"Wear Me\\\"\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" in Wolof — is a culture-first luxury label built on bold, eye-catching design and a fiercely loyal community. From full tracksuits to bespoke masterpieces, SOLMA dresses a new generation of tastemakers: Premier League footballers, Senegalese national team players, UK artists and creatives who wear the brand not because they're paid to, but because they believe in it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is more than a runway. Expect:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The unveiling of SOLMA's latest collection, live on the catwalk\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A first look at exclusive and bespoke pieces\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Music, culture and community in one room\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The people and partners building the future of African luxury\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Global luxury is being reshaped by afro-diaspora culture. SOLMA is where that culture leads — not follows. Come see why.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"p5sr8mjn\",\"label\":\"What is your Instagram username?\",\"required\":false,\"question_type\":\"instagram\"},{\"id\":\"51a1fgma\",\"label\":\"How did you hear about SOLMA?\",\"required\":false,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
