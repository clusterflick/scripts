:\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":true,\"spots_remaining\":0,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"sold-out\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":true,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#294866\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Girlies Are Reading: September Book Club 💌\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re back for our September book club!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📖 \",\"type\":\"text\"},{\"text\":\"This month we’re reading:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" \",\"type\":\"text\"},{\"text\":\"Cursed Daughters\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\" by Oyinkan Braithwaite 🧡\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Come along for a chat about the book, what we loved (or didn’t 👀) and all our thoughts.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A few things to know:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ You don’t have to finish the book to come along, but we recommend reading as much as you can to avoid spoilers.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"💌 Spaces are limited, so please cancel your spot if you can no longer make it so someone else can join.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📅 Wednesday 30 September\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"⏰ 6:00pm – 7:30pm\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"📍 Waterstones Trafalgar Square Café\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’ve been before or it’s your first time joining us, you’re more than welcome. Come alone or bring a friend!\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"See you there 💌\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
