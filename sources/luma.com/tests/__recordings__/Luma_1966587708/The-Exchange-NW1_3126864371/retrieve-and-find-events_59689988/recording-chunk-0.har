ine\",\"name\":\"The Screening Industry Annual Leadership Forum\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":false,\"social_image_url\":\"https://images.lumacdn.com/event-social/5i/6113db9d-a066-41e8-98f8-f431aeb32039.png\",\"start_at\":\"2026-10-30T13:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"hjs0mg8k\",\"user_api_id\":\"usr-M7uBijIPCnuj05b\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"city\":\"London\",\"type\":\"google\",\"region\":\"England\",\"address\":\"Oyster Shed\",\"country\":\"United Kingdom\",\"place_id\":\"ChIJfWsYnlYDdkgR1GxOG9B7Eqg\",\"city_state\":\"London, England\",\"description\":\"Event is being hosted in a private room \\\"The Captains Table\\\"\",\"country_code\":\"GB\",\"full_address\":\"Oyster Shed, 1 Angel Ln, London EC4R 3AB, UK\",\"place_coordinate\":null,\"apple_maps_place_id\":\"I86FF01B0F12E46FC\",\"mode\":\"shown\"},\"geo_address_visibility\":\"public\",\"coordinate\":{\"longitude\":-0.08980199999999999,\"latitude\":51.509148499999995},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-10-30T13:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":0,\"ticket_count\":0,\"hosts\":[{\"api_id\":\"usr-M7uBijIPCnuj05b\",\"avatar_url\":\"https://images.lumacdn.com/avatars/qe/9f243dc7-16b9-4498-8bf0-4f96e4d055bf.png\",\"bio_short\":null,\"first_name\":\"Anton\",\"last_name\":\"Watson\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/antonwatson\",\"name\":\"Anton Watson\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#1d1a1e\",\"#4a5260\",\"#dfdedd\",\"#9c9fa3\"],\"palette\":{\"neutral\":[{\"color\":\"#181516\",\"percentage\":27.24},{\"color\":\"#f7f6f6\",\"percentage\":9.11}],\"vibrant\":[]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/5i/6113db9d-a066-41e8-98f8-f431aeb32039.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-a5FX75hgsD8N3TU\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-qAyLI3phvFod1Gl\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":18,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#40f5cf\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"geist-mono\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Following the success of our first Industry Leadership Forum, held in London last November. The \",\"type\":\"text\"},{\"text\":\"Background Check Advisory\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" is bringing the event back for 2026 for senior leaders from across the background checking industry to have an honest, forward-looking conversation about \",\"type\":\"text\"},{\"text\":\"where the industry is heading and how leaders & the screening industry can prepare for 2027.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s aptly called\",\"type\":\"text\"},{\"text\":\" The Screening Industry Annual Leadership Forum\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This is an \",\"type\":\"text\"},{\"text\":\"invite-only, in-person gathering of CEOs, MDs and senior industry decision-makers\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", brought toghether by the Background Check Advisory, designed to create space for open discussion away from the usual conference environment.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The aim is simple: to share perspectives, explore the challenges facing the industry, and discuss the ideas, technologies and strategies that will shape the next phase of background screening.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event Details:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Date:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Friday 30th October\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Timing:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 1pm to 4pm, with lunch & refreshments provided\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Location:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" The Captains Table, at the Oyster Shed in Central London\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Attendance:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Free | By Invitation Only | Limited to 20 Leaders\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"There will also be the option to stay on afterwards for some self-funded drinks at the Oyster Shed.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Why Attend?\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The screening market continues to evolve quickly.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Hiring fraud and candidate identity risk are becoming more sophisticated, AI is reshaping recruitment, clients are expecting faster and more intelligent screening, new sources of data are emerging, and technology continues to change how screening services are delivered.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"At the same time, screening providers are having to think increasingly about \",\"type\":\"text\"},{\"text\":\"how they differentiate, innovate and remain relevant in a changing market.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Leadership Forum is designed to give senior industry leaders the opportunity to step away from the day-to-day and discuss some of those bigger questions with industry peers.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Agenda Highlights Include:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Screening Landscape:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" What has changed and what should leaders be preparing for next?\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"CEO Roundtable:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" What’s Keeping Background Check Leaders Up at Night?\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Innovation Lab:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Which technologies, data sources and new approaches could genuinely change screening?\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Changing Client:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" What employers will expect from screening partners in 2027?\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Standing Out in 2027:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Differentiation, positioning and communicating value in an increasingly competitive market\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Attendance will again be deliberately limited to \",\"type\":\"text\"},{\"text\":\"20 senior leaders, with one place per organisation\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", to keep the discussion open, practical and valuable.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"👉 \",\"type\":\"text\"},{\"text\":\"Reserve your place here\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":\"optional\",\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"pje53s7q\",\"label\":\"Your Company\",\"required\":true,\"question_type\":\"text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
