\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#1f1f1f\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will have a relaxed guided walk learning about how the High Street has changed over the years. Our guide is Mr Julian McCarthy from the \",\"type\":\"text\"},{\"text\":\"Maldens and Coombe Heritage Society \",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]},{\"text\":\"(\",\"type\":\"text\"},{\"text\":\"https://maldensandcoombeheritagesociety.weebly.com/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://maldensandcoombeheritagesociety.weebly.com/\"}}]},{\"text\":\")\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Meeting point:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" St. George’s Square (public area in front of the CI Tower, adjacent to the train station)\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"PLEASE ARRIVE 10 minutes in advance, 10:50am\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We will \",\"type\":\"text\"},{\"text\":\"finish\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" at the Watchman (local Wetherspoon) for socialising.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Event is free to attend and donations will be kindly accepted on the day by the Heritage Society.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featur