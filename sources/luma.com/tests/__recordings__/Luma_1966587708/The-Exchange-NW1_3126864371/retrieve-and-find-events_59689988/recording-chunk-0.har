palette\":{\"neutral\":[{\"color\":\"#0a0504\",\"percentage\":22.22},{\"color\":\"#afbfc6\",\"percentage\":2.26}],\"vibrant\":[{\"color\":\"#653610\",\"percentage\":7.94},{\"color\":\"#9d764b\",\"percentage\":7.78}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/o0/9ede1f5b-e1a1-47a4-9bfe-443972bb1f45.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-Zyagsm5izettQ10\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-1Ja8GjWGHjATXkr\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":18,\"num_guests\":18,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":2,\"is_near_capacity\":true,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"falling-leaves\"},\"tint_color\":\"#682FFF\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"There is nothing quite like losing yourself in a good book with the warm aroma of fresh coffee around you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"To share this cozy feeling, you are warmly invited to join us for a slow, unplugged afternoon of reading and connection in a calm cafe setting.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s the perfect setting to disconnect from digital noise, slow down, and nourish your mind in good company.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"How the Afternoon Will Flow:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"☕ 1 Hour of Quiet Reading:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" We will tuck our phones away, settle in with our favorite drinks, and dive into our books together for a full hour of peaceful, shared silence.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"💬 1 Hour of Connection:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Afterward, we’ll close our books and spend time chatting, sharing thoughts on what we’re reading, and getting to know one another.\",\"type\":\"text\"}]}]}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"What to Bring and Know:\",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"📖 Bring your current read:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" A novel, poetry, non-fiction, or anything that speaks to you right now.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"☕ Support the venue:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Grab a drink or a bite to enjoy while we share the space.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"✨ Disconnect to connect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Give yourself the gift of a completely uninterrupted afternoon and keep your phone tucked away.\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We can't wait to welcome you for an afternoon of slow living, shared silence, and gentle, offline connection.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Offline Women\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://offlinewomen.org/?utm_source=luma\"}}]},{\"type\":\"hard_break\"},{\"text\":\"Luma\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://luma.com/offlinewomen\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"WhatsApp\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://whatsapp.com/channel/0029VbCZyvCD38CTaXBpQ72V?utm_source=luma\"}}]},{\"text\":\" | \",\"type\":\"text\"},{\"text\":\"LinkedIn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.linkedin.com/company/offline-women/?utm_source=luma\"}}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
