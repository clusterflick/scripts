andle\":\"/in/karl-virgel-4ba57b133\",\"name\":\"Karl\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-qfYEo4KLCOVzMDt\",\"avatar_url\":\"https://images.lumacdn.com/avatars/gh/41c4cc6b-e8ab-4e4a-817f-5d2c1ee44ecc.jpg\",\"bio_short\":\"CTO @ Third Dimension AI\",\"first_name\":\"Piotr\",\"last_name\":\"Sokólski\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/piotr-sokolski\",\"name\":\"Piotr Sokólski\",\"tiktok_handle\":null,\"timezone\":\"Europe/Istanbul\",\"twitter_handle\":\"pyetras\",\"username\":\"piotrs\",\"website\":null,\"youtube_handle\":\"\"},{\"api_id\":\"usr-rNQRF27yPjSHwAm\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_9.png\",\"bio_short\":null,\"first_name\":\"Chris\",\"last_name\":\"Summers\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Chris Summers\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-U6Bz5dOWMFYEPgm\",\"avatar_url\":\"https://images.lumacdn.com/avatars/16/c7efb41b-3422-4d17-bfcb-34dbd5d348e9.jpg\",\"bio_short\":\"Producer at Venice Immersive & Agog\\nFounder of KRAKED and Associated Industries\",\"first_name\":\"Michael\",\"last_name\":\"Salmon\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/mikecsalmon\",\"name\":\"Michael Salmon\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"Manglebird\",\"website\":null,\"youtube_handle\":\"\"},{\"api_id\":\"usr-wARt04cG3AmeDRX\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_30.png\",\"bio_short\":\"\",\"first_name\":\"Yegor\",\"last_name\":\"Ryabtsov\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/ryabtsov\",\"name\":\"Yegor Ryabtsov\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":47,\"ticket_count\":47,\"hosts\":[{\"api_id\":\"usr-b9rmc0rqCV4R6vi\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_33.png\",\"bio_short\":null,\"first_name\":\"New Media\",\"last_name\":\"London\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"New Media London\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-MdAeD92truAOaIj\",\"avatar_url\":\"https://images.lumacdn.com/uploads/0k/7e8a9798-11ad-4fce-ac1a-42469c29d788.jpg\",\"bio_short\":\"AV Artist\",\"first_name\":\"CHΛU\",\"last_name\":\"\",\"instagram_handle\":\"chau_av\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"CHΛU\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://g--f.net/artists/chau\",\"youtube_handle\":null},{\"api_id\":\"usr-usXQBUSKuQM7PjX\",\"avatar_url\":\"https://images.lumacdn.com/avatars/a6/74fc56ec-08c8-4ad5-bc16-71b2e60d3947.jpg\",\"bio_short\":\"\",\"first_name\":\"Maya\",\"last_name\":\"Toomi\",\"instagram_handle\":\"dea.x.machina\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Dea\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://deabankova.com\",\"youtube_handle\":\"\"},{\"api_id\":\"usr-rtDxar2xaAei8T2\",\"avatar_url\":\"https://images.lumacdn.com/avatars/32/d5d74f84-5759-4116-9507-385afc417bab.png\",\"bio_short\":null,\"first_name\":\"Dylan\",\"last_name\":\"Cruz\",\"instagram_handle\":\"memocrime\",\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Dylan Cruz\",\"tiktok_handle\":null,\"timezone\":\"Europe/Berlin\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://memocrime.com\",\"youtube_handle\":\"memocrime\"}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#010101\",\"#fdfdfc\",\"#69fbfd\",\"#fb5443\"],\"palette\":{\"neutral\":[{\"color\":\"#010101\",\"percentage\":69.95},{\"color\":\"#fdfdfc\",\"percentage\":5.34}],\"vibrant\":[{\"color\":\"#2a47fb\",\"percentage\":0.75},{\"color\":\"#f5f85d\",\"percentage\":0.77},{\"color\":\"#fb5443\",\"percentage\":0.69},{\"color\":\"#69fbfd\",\"percentage\":1}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/1d/7dff5edf-7808-42d2-afe7-2ff5b5cd47ab.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-xWMAlPlcB7mUIxM\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"Join us for an evening of new media, live visuals and creative exchange\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-jFvQe50i8ZB8LDh\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":34,\"num_guests\":34,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-goWsgPf3VVWaCN0\",\"cents\":1000,\"currency\":\"gbp\",\"description\":\"Support New Media London and help us keep creating events for the community.\\n\\nPay a little more if you can, your contribution helps us support artists, develop future workshops and meetups, and keep our events accessible\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-jFvQe50i8ZB8LDh\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":1000,\"position\":\"9\",\"name\":\"Supporter\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-ZDorrUFVYeVBBA9\",\"cents\":null,\"currency\":null,\"description\":\"For students who want to explore, learn and connect with London’s new media community.\\n\\nWe want our events to remain accessible to emerging creatives. Free with a valid student ID.\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-jFvQe50i8ZB8LDh\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":10,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"Student\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":10,\"num_guests\":10,\"spots_remaining\":0,\"is_disabled\":true}],\"featured_infos\":[{\"type\":\"discover\",\"avatar_url\":\"https://images.lumacdn.com/discovery/london-icon.png\",\"tint_color\":\"#e89800\",\"name\":\"London\",\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"name_raw\":\"London\",\"path\":\"/london\"}],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-tech\",\"description\":\"Join a hackathon, jam on product design, and meet fellow tinkerers in the industry of tomorrow.\",\"event_count\":4069,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/lg/3b7cf2a0-077f-40ca-aab8-1a8d07affbd1.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/v7/3f6baafa-d90d-4013-9853-0fa10331f796.png\",\"name\":\"Tech\",\"page_title\":\"Tech Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/z8/cb71384a-87a9-4be7-bbdf-1c2d6381d872.png\",\"slug\":\"tech\",\"social_image_url\":\"https://images.lumacdn.com/uploads/3e/1908a653-edb9-431e-8ecf-b4d61249a446.png\",\"subscriber_count\":73356,\"tint_color\":\"#5773CF\"}],\"ticket_info\":{\"price\":{\"cents\":500,\"currency\":\"gbp\",\"min_cents\":0,\"is_flexible\":true},\"is_free\":false,\"max_price\":{\"cents\":1000,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":33,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"warp\"},\"tint_color\":\"#010101\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"roc-grotesk\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join \",\"type\":\"text\"},{\"text\":\"New Media LDN\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" for our next \",\"type\":\"text\"},{\"text\":\"TouchDesigner Meetup\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", an evening of artist talks, creative experimentation, open visuals and a live electronic set.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’re new to TouchDesigner, use it professionally, or are simply curious about real-time and audiovisual art, come along to meet the community, discover new work and share what you’ve been creating.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Artist Presentations\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’ll start the evening with \",\"type\":\"text\"},{\"text\":\"two presentations from artists working with TouchDesigner\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", sharing their projects, creative processes and ideas.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Special Guest - AMIANGELIKA \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"We’re delighted to welcome \",\"type\":\"text\"},{\"text\":\"AMIANGELIKA\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" (\",\"type\":\"text\"},{\"text\":\"@amiangelika\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/amiangelika/\"}}]},{\"text\":\", \",\"type\":\"text\"},{\"text\":\"https://amiangelika.com/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://amiangelika.com/\"}}]},{\"text\":\") as our special guest for this meetup. An award-winning, London-based new media artist, her practice spans audiovisual live performance, interactive dance, immersive installation and generative visual systems, exploring how technology shapes perception, memory and systems of belief.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Through sound, image and light, she creates shifting environments that move between instability and order, intimacy and distance, and light and shadow.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"During her presentation, AMIANGELIKA will introduce her practice and share an insight into the ideas, processes and interdisciplinary approaches behind her work.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you’d like to take part in a future presentation, please submit your work through our \",\"type\":\"text\"},{\"text\":\"Open Call Form\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://forms.gle/dLkBijbZaixBDfiA6\"}},{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Open Visuals - Bring Your Work\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"After the talks, the gallery opens up to you.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bring your laptop and project your visuals onto the walls of the gallery.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Share a TouchDesigner project you’ve been working on, test an experiment, show something unfinished, or simply play with visuals alongside other artists.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"No formal presentation needed and no pressure to show finished work. \",\"type\":\"text\"},{\"text\":\"Open Visuals is about experimenting, sharing and creating together.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Other visual tools and creative coding practices are welcome too.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Live Electronic Sets \",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"While Open Visuals take over the walls, we’ll have live electronic music throughout the networking session.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Torchcore\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Paul Chamberlain, aka Torchcore (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@torchcore_music\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/torchcore_music/\"}},{\"type\":\"bold\"}]},{\"text\":\", \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"https://torchcore.co.uk/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://torchcore.co.uk/\"}},{\"type\":\"bold\"}]},{\"text\":\"),\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" will join us for a live electronic set.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"With roots in \",\"type\":\"text\"},{\"text\":\"acid punk and psychedelic bands\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", and years spent DJing across acid, electro and techno circuits, Torchcore moved into modular synthesis in 2018.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Now a regular on London lineups, his immersive sets move between \",\"type\":\"text\"},{\"text\":\"ambient atmospheres, dark drones, angular electro, dub and driving techno\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". Every performance is fully improvised, creating a raw and constantly evolving experience where no two shows are the same.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"Dada Sondor\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Dada Sondor (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@dada.sondor\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/dada.sandor/\"}},{\"type\":\"bold\"}]},{\"text\":\", \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"https://dadasandor.com/\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://dadasandor.com/\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" will also perform a \",\"type\":\"text\"},{\"text\":\"live ambient set\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Born into a family of musicians, Dada's practice spans \",\"type\":\"text\"},{\"text\":\"improvisation, modular synthesis, sound engineering and electronic experimentation\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", driven by a fascination with music machines and technology.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"His work has taken him from electronic music into the worlds of avant-garde and experimental sound, including collaborations with artists such as \",\"type\":\"text\"},{\"text\":\"Merzbow and Thurston Moore\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\". As an audiovisual artist, he also explores the relationship between sound and moving image, searching for new ways for the two to interact within his evolving live practice.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Expect an atmospheric, ever-changing live set unfolding alongside the visuals around the gallery.\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Schedule\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"18:00\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - Doors & arrivals\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"18:30\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - TouchDesigner presentations\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"19:30\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - Break\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"19:45 onwards\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" - Open Visuals + networking + live electronic sets\",\"type\":\"text\"}]},{\"type\":\"heading\",\"attrs\":{\"level\":1},\"content\":[{\"text\":\"Who is it for?\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"TouchDesigner artists and learners, creative coders, designers, VJs, AV artists, developers, musicians, filmmakers and anyone curious about real-time visuals and new media.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All levels are welcome - including complete beginners.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"📍 \",\"type\":\"text\"},{\"text\":\"Not For Sale Gallery\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Algha Works, 83 Smeed Rd, London E3 2NR\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"About New Media London\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This event is hosted by \",\"type\":\"text\"},{\"text\":\"New Media LDN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/newmedia.ldn/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\", organised by \",\"type\":\"text\"},{\"text\":\"Dea (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@dea.x.machina\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/dea.x.machina/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\"), CHΛU (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@chau_av\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/chau_av/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\"), Dylan (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@memocrime\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/memocrime/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" and \",\"type\":\"text\"},{\"text\":\"SARV (\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"@sarv.vj\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/sarv.vj\"}},{\"type\":\"bold\"}]},{\"text\":\")\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"New Media LDN\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/newmedia.ldn/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\" is a community bringing together visual artists, creative coders, musicians and immersive creatives through \",\"type\":\"text\"},{\"text\":\"talks, workshops and AV performances\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Follow us on Instagram \",\"type\":\"text\"},{\"text\":\"@newmedia.ldn\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.instagram.com/newmedia.ldn/?utm_source=luma\"}},{\"type\":\"bold\"}]},{\"text\":\" for updates, upcoming workshops and future events.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":{\"api_id\":\"discplace-QCcNk3HXowOR97j\",\"slug\":\"london\",\"name\":\"London\"}}",
