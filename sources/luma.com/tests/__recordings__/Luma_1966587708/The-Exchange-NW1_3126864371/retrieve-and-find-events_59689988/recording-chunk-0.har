\":\"usr-SCPeENSD6gjraxp\",\"avatar_url\":\"https://images.lumacdn.com/uploads/59/641303da-9503-413f-b8db-d8504273d414.jpg\",\"bio_short\":\"Photographer + Director and creative director of Tintra a trail running community & creative agency bringing accessibility to trail + races\",\"first_name\":\"Holly-Marie\",\"last_name\":\"Cato\",\"instagram_handle\":\"h_cato\",\"is_verified\":false,\"linkedin_handle\":\"/in/holly-mariecato\",\"name\":\"Holly-Marie Cato\",\"tiktok_handle\":\"h_cato\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":\"https://www.hollycato.com\",\"youtube_handle\":null},{\"api_id\":\"usr-T0Qux3h1zC6RInS\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_33.png\",\"bio_short\":null,\"first_name\":null,\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/Invitation\",\"name\":\"Nayana\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-tHtqeaCTzVH5rGd\",\"avatar_url\":\"https://images.lumacdn.com/avatars/70/fc54272b-cd13-49bc-8df8-035f463588bb.jpg\",\"bio_short\":\"Multifaceted interested in art, history, politics, business, Tech, design and psychology.\\n\\nWork as a software engineer but currently run a business \",\"first_name\":\"Mimi\",\"last_name\":\"Umoh\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":\"/in/emem-umoh-b606a6125\",\"name\":\"Mimi Umoh\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-xL4LH6JdsYeEhFd\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_30.png\",\"bio_short\":null,\"first_name\":\"Naomi\",\"last_name\":\"Obodosike\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Naomi Obodosike\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"we are unable to refund tickets\",\"type\":\"text\"}]}]},\"guest_count\":20,\"ticket_count\":20,\"hosts\":[{\"api_id\":\"usr-i2BPQA7gwGKrTJl\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_41.png\",\"bio_short\":null,\"first_name\":\"Hillary\",\"last_name\":\"Juma\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Hillary Juma\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#af0a0b\",\"#141013\",\"#c6cac7\",\"#216888\"],\"palette\":{\"neutral\":[{\"color\":\"#141013\",\"percentage\":14.28},{\"color\":\"#c6cac7\",\"percentage\":8.57}],\"vibrant\":[{\"color\":\"#af0a0b\",\"percentage\":25.25},{\"color\":\"#b5800c\",\"percentage\":8.68},{\"color\":\"#216888\",\"percentage\":3.76}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/eu/2919ee8e-8d16-4220-9006-ba8b5be26c53.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-AAH33sw35TJNi4i\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"When you donate £5, you can claim a drink at the event\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-tDaaCCvNC1ONAOw\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"8\",\"name\":\"RSVP [Optional Donation]\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":10,\"num_guests\":10,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-VNYP7JANfYY2uxL\",\"cents\":500,\"currency\":\"gbp\",\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-tDaaCCvNC1ONAOw\",\"is_flexible\":true,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":0,\"position\":\"9\",\"name\":\"RSVP + Vinyl [BUY IN STORE]\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":3,\"num_guests\":3,\"spots_remaining\":null,\"is_disabled\":false},{\"api_id\":\"ttype-T6qWiNdGBJAnwgW\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-tDaaCCvNC1ONAOw\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":10,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"95\",\"name\":\"RSVP [no drink included]\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":7,\"num_guests\":7,\"spots_remaining\":3,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":{\"cents\":500,\"currency\":\"gbp\"},\"is_sold_out\":false,\"spots_remaining\":30,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#ff1b2f\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"departure\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"On & On Presents: Creative Sovereignty with Saxophonist and Flautist, David Kayode. In the session we will explore how Gen-Z musicians are DIY releasing via his latest project Ade Kayode.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"About David\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Emerging as one of the most distinctive new voices in UK jazz, David Kayode is a London-based saxophonist, composer and bandleader rooted in Yoruba tradition, Afro-diasporic rhythm and contemporary jazz. His music fuses carnival energy, spiritual depth and modern improvisation into a sound that is both unmistakably London and globally connected.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A Tomorrow's Warriors Emerging Artist mentored by Gary Crosby OBE and Camilla George, Kayode has performed with the Gary Crosby Sextet in the acclaimed Mingus Moves series, toured internationally with Moses Boyd, and shared stages with Carroll Thompson and Osibisa. He has also spent four years playing with Jazz Jamaica and is a member of the Nu Civilisation Orchestra. He brings his band to Ronnie Scott's for a night that's as spiritually charged as it is impossible to sit still through.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"His debut EP, Ade Kayode, released independently in April 2026, was instantly picked up by JazzFM, BBC3 and One Jazz, and drew acclaim from The Voice (\\\"all of the ingredients to become a genre defying classic\\\") and BBC Radio 3's Soweto Kinch. If you've caught him on the airwaves, this is your chance to hear it live.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Catch one of UK jazz's most exciting rising voices on one of the world's most legendary stages. Come early, come loud, and don't miss it.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Tickets:\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"},{\"type\":\"bold\"}]},{\"text\":\" The event is free to attend, but to support the infrastructure of the shop we suggest paying £5 and as form of gratitude you will receive a soft drink.\",\"type\":\"text\",\"marks\":[{\"type\":\"italic\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":true,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
