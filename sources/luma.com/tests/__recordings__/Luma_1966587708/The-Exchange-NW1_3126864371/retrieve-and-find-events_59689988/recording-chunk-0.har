andle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":14,\"ticket_count\":14,\"hosts\":[{\"api_id\":\"usr-72bDqBBEP59x5k5\",\"avatar_url\":\"https://images.lumacdn.com/uploads/qv/c68d1047-152e-41c0-8a98-0df2bc2b413a.png\",\"bio_short\":\"Where culture meets independent film.\",\"first_name\":\"\",\"last_name\":\"\",\"instagram_handle\":\"cinesavour\",\"is_verified\":false,\"linkedin_handle\":\"/in/cinesavour\",\"name\":\"CineSavour\",\"tiktok_handle\":\"cinesavour\",\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":\"CineSavour\",\"website\":\"https://www.cinesavour.com\",\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#031f08\",\"#f8f3e4\",\"#884a1c\",\"#edca70\"],\"palette\":{\"neutral\":[{\"color\":\"#031f08\",\"percentage\":57.19},{\"color\":\"#f8f3e4\",\"percentage\":5.96}],\"vibrant\":[{\"color\":\"#edca70\",\"percentage\":1.02},{\"color\":\"#884a1c\",\"percentage\":2.12}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/od/92b63534-85b6-43fe-99cc-bf5d15cbda99.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-QRT5D71fMLUFVgD\",\"cents\":2000,\"currency\":\"gbp\",\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-OJRCwrwp5O9hvTL\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"fiat-price\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":14,\"num_guests\":14,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-fooddrink\",\"description\":\"From morning coffee to late night pizza, enjoy great food and drinks with old and new friends.\",\"event_count\":602,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/xv/2dd876d6-775a-4cec-adba-9d9e94d814a6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/36/a77db635-cb3b-4720-9758-2bc9dae948e4.png\",\"name\":\"Food & Drink\",\"page_title\":\"Food & Drink Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/hj/9724cc70-b0e4-416f-9219-35efbf25fba7.png\",\"slug\":\"food\",\"social_image_url\":\"https://images.lumacdn.com/uploads/ip/9252c72b-62c6-4b5b-b321-5e2ee66757b4.png\",\"subscriber_count\":15402,\"tint_color\":\"#D58530\"}],\"ticket_info\":{\"price\":{\"cents\":2000,\"currency\":\"gbp\",\"is_flexible\":false},\"is_free\":false,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":10,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#031f08\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"ivy-presto\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Eastern African coffee meets independent films from the region. The evening begins with a guided cupping, followed by a curated selection of 5 short films, with time to connect over coffee and cocktails throughout the night.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The pilot event ticket includes the coffee tastings with a complementary film screening. You’re also welcome to enjoy drinks from Frequency Coffee throughout the evening, available to purchase separately.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to expect:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"4:00 PM - Doors Open\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Arrive, settle in and get comfortable. An introduction to CineSavour.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"4:15 PM - Coffee Cupping ☕\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"A guided tasting exploring the featured coffee, its origin and flavour story. Countries featured are Ethiopia, Rwanda, Uganda and Kenya.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"5:15 PM - First Film Block 🎬\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Three curated independent short films, \",\"type\":\"text\"},{\"text\":\"each followed by a short recorded message from its filmmaker\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", sharing the inspiration and ideas behind the film.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:15 PM - Interval and Bar\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Take a short break, grab a drink and connect with other guests.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:30 PM - Second Film Block 🎬\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Two further independent short films, \",\"type\":\"text\"},{\"text\":\"each followed by a short filmmaker recording\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\".\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"7:20 PM - Drinks, Conversation and Mingling\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Stay for drinks, conversation about the films with other guests and the opportunity to purchase the featured coffee.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"8:30 PM - Event ends\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
