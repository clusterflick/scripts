"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"},{\"api_id\":\"cat-books\",\"description\":\"Bring your reading to life by joining a book club or hearing an author talk in person.\",\"event_count\":725,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/n0/5147e1e9-00cd-4ea1-86e9-e9b9ebd34ae6.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/3g/f33c0b3c-9090-40bb-b99c-875b534bcee4.png\",\"name\":\"Books\",\"page_title\":\"Book Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/rw/4ea6d3ba-0ad3-44d1-ba37-bcaab65051af.png\",\"slug\":\"books\",\"social_image_url\":\"https://images.lumacdn.com/uploads/bi/d328b247-9ac7-4ac1-9955-50ec16669bec.png\",\"subscriber_count\":1705,\"tint_color\":\"#D5AD37\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":64,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#0d1b35\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"degular\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join Aleksandra Hertelendi for the launch of her new book - Perform & Transform.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"She will be discussing the key themes around transformation that are covered in the book during a Q&A session. There is also an opportunity for you to contribute a question for the Q&A session.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Some of the themes she'll be discussing include:\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"- The 5 S's Framework for more effective transformation\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"- Differences between change and transformation\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"- Where she's seen organisations get transformation right (and where they've gone wrong)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"- The importance of simplicity when it comes to transformation\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Every attendee will also receive a copy of the book to take away with them (with an option to have it signed by the author!).\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:00pm - Doors\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"6:30pm - Q&A Session\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"8:30pm - Event Close\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Welcome drinks and canapes included.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"43vi5x8h\",\"label\":\"Job Title\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"6lpo74d0\",\"label\":\"Company\",\"required\":true,\"question_type\":\"text\"},{\"id\":\"sh54l7au\",\"label\":\"Submit a question you would like Aleksandra to answer during her Q&A session\",\"required\":false,\"question_type\":\"long-text\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
