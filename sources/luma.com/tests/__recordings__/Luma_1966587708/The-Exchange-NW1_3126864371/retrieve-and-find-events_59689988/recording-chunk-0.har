:{\"colors\":[\"#ebebe7\",\"#242021\",\"#e02826\"],\"palette\":{\"neutral\":[{\"color\":\"#242021\",\"percentage\":16.39},{\"color\":\"#ebebe7\",\"percentage\":30.01}],\"vibrant\":[{\"color\":\"#e02826\",\"percentage\":1.05}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/ju/87c3ce52-66b0-4e5c-b38b-3aae1802818a.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-cE3fLM7XboQSGOL\",\"cents\":null,\"currency\":null,\"description\":null,\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-2IGHOSWRohvEpQl\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":false,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":25,\"num_guests\":25,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":null,\"is_near_capacity\":false,\"require_approval\":false},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#eaeae6\",\"can_register_for_multiple_tickets\":false,\"font_title\":\"alternate\",\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"A photo walk, hosted by Aldo King, your local Foto community host. We meet, we walk, we make photos together, no likes or followers involved.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"What to expect\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"You'll spend about two to three hours walking through the city with other photographers from the Foto community. Along the way, you'll make photos, take portraits of each other, and talk to people who notice the same light you do. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"This year's worldwide theme for Foto Walk is “Contrast”... Light against shadow, old against new, whatever catches your eye and won't let it go.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"And for this 📸 “A Very British London” walk, one additional simple mission: photograph London as if you’re making a postcard for someone who has never been here.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"But with a twist: people are as important as landmarks, and there will be fun 5-minute photo challenges along the way, if you are game.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The walk ends at a set point, sometimes with food or a drink afterwards. No experience needed. Bring any camera you own, including your phone.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"The details\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Duration:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 2~3 hours\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Bring:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Comfortable shoes, your camera, water, and a bit of cash for food or drinks\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cost:\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" Free\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Once you register, you'll receive a confirmation with the exact meet-up point and any other details you need to know.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Photography is better with company, so we hope you'll join us.\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"ym86ogja\",\"label\":\"Terms and Conditions\",\"terms\":{\"url\":\"https://docs.google.com/document/d/1JsUMxaxmdTvu7vsgboOkz_fskCz5Q4gQRMbpNZ-Hn78/edit?usp=sharing\",\"content_type\":\"link\",\"collect_signature\":true},\"required\":true,\"question_type\":\"terms\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
