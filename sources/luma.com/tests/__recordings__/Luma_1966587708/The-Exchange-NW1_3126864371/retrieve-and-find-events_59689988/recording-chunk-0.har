tps://images.lumacdn.com/gallery-images/25/219f6e33-163b-46f2-a77e-fe46096e9b12\",\"end_at\":\"2026-09-27T17:00:00.000Z\",\"event_type\":\"independent\",\"hide_rsvp\":false,\"location_type\":\"offline\",\"name\":\"Karaoke Night\",\"one_to_one\":true,\"recurrence_id\":null,\"show_guest_list\":true,\"social_image_url\":\"https://images.lumacdn.com/event-social/12/b45f1778-37a9-4485-a793-c5b5edf3e599.png\",\"start_at\":\"2026-09-27T15:00:00.000Z\",\"timezone\":\"Europe/London\",\"url\":\"z5a8k6t9\",\"user_api_id\":\"usr-qJs7CrIdGABhVcA\",\"visibility\":\"public\",\"virtual_info\":{\"has_access\":false},\"geo_address_info\":{\"mode\":\"obfuscated\",\"city\":\"London\",\"city_state\":\"London, United Kingdom\",\"sublocality\":null,\"country\":\"United Kingdom\",\"country_code\":\"GB\",\"region\":\"England\",\"region_short\":\"England\"},\"geo_address_visibility\":\"guests-only\",\"coordinate\":{\"latitude\":51.51043396679555,\"longitude\":-0.1299245256774257},\"waitlist_enabled\":true,\"waitlist_status\":\"enabled\"},\"start_at\":\"2026-09-27T15:00:00.000Z\",\"guest_data\":{\"email\":null,\"name\":null,\"ticket_key\":null,\"approval_status\":null,\"proxy_key\":null,\"event_tickets\":[],\"payments\":[]},\"featured_guests\":[{\"api_id\":\"usr-53o5exeIBnN5Apu\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_35.png\",\"bio_short\":\"\",\"first_name\":\"Enya\",\"last_name\":\"Yu\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Enya\",\"tiktok_handle\":null,\"timezone\":\"America/New_York\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-k6pbBGcO4dGTG4H\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_1.png\",\"bio_short\":null,\"first_name\":\"Menahil\",\"last_name\":\"Imran\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Menahil Imran\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-uYHR4nRQ5sPJYzN\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_30.png\",\"bio_short\":null,\"first_name\":\"Sana\",\"last_name\":null,\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Sana\",\"tiktok_handle\":null,\"timezone\":\"Europe/Rome\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null},{\"api_id\":\"usr-yv5cntMPN3wsDgc\",\"avatar_url\":\"https://cdn.lu.ma/avatars-default/avatar_39.png\",\"bio_short\":\"\",\"first_name\":\"Carole\",\"last_name\":\"Reniero\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Carole Reniero\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"has_available_ticket_types\":true,\"refund_policy\":null,\"guest_count\":4,\"ticket_count\":4,\"hosts\":[{\"api_id\":\"usr-qJs7CrIdGABhVcA\",\"avatar_url\":\"https://images.lumacdn.com/avatars/d4/2121d6da-3b22-4a3b-8647-1b950ecaf070.jpg\",\"bio_short\":\"\",\"first_name\":\"Satori\",\"last_name\":\"Chang\",\"instagram_handle\":null,\"is_verified\":false,\"linkedin_handle\":null,\"name\":\"Satori Chang\",\"tiktok_handle\":null,\"timezone\":\"Europe/London\",\"twitter_handle\":null,\"username\":null,\"website\":null,\"youtube_handle\":null}],\"referred_by\":null,\"cover_image\":{\"colors\":[\"#6ccdff\",\"#f3ff73\",\"#fdfefe\",\"#3620e0\"],\"palette\":{\"neutral\":[{\"color\":\"#fefdfd\",\"percentage\":10.19}],\"vibrant\":[{\"color\":\"#6dcefd\",\"percentage\":55.66},{\"color\":\"#edfb7c\",\"percentage\":23.04},{\"color\":\"#3d27db\",\"percentage\":9.91}]}},\"cover_video\":null,\"social_image\":{\"cdn_url\":\"https://images.lumacdn.com/event-social/12/b45f1778-37a9-4485-a793-c5b5edf3e599.png\",\"width\":1200,\"height\":630,\"mime_type\":\"image/png\"},\"social_video\":null,\"sessions\":[],\"ticket_types\":[{\"api_id\":\"ttype-WHTq9RsLw9CkbSi\",\"cents\":null,\"currency\":null,\"description\":\"\",\"ethereum_token_requirements\":[],\"event_api_id\":\"evt-rXZmsku2RJaYAbz\",\"is_flexible\":false,\"is_hidden\":false,\"max_capacity\":null,\"max_per_guest\":null,\"membership_restriction\":null,\"min_cents\":null,\"position\":\"8\",\"name\":\"Standard\",\"require_approval\":true,\"tint_color\":null,\"type\":\"free\",\"valid_end_at\":null,\"valid_start_at\":null,\"num_tickets_registered\":4,\"num_guests\":4,\"spots_remaining\":null,\"is_disabled\":false}],\"featured_infos\":[],\"categories\":[{\"api_id\":\"cat-AzVAf6VmE9JEre4\",\"description\":\"Whether it’s painting workshops or pottery classes, join an event to unleash your creativity, learn new techniques, and connect with fellow makers.\",\"event_count\":3528,\"hero_image_desktop_url\":\"https://images.lumacdn.com/uploads/54/bc5c9b4f-cbfd-4f55-84d1-331e0a12523c.png\",\"icon_url\":\"https://images.lumacdn.com/uploads/u8/5eeba5a4-d305-4bc1-9017-329937813f30.png\",\"name\":\"Arts & Culture\",\"page_title\":\"Arts & Culture Events\",\"simple_icon_url\":\"https://images.lumacdn.com/uploads/o1/12999161-f382-4d97-b2f6-281fca336c04.png\",\"slug\":\"arts\",\"social_image_url\":\"https://images.lumacdn.com/uploads/jh/3f4210d6-8dd1-4a12-ae53-adb92d49c333.png\",\"subscriber_count\":25615,\"tint_color\":\"#AEA73C\"}],\"ticket_info\":{\"price\":null,\"is_free\":true,\"max_price\":null,\"is_sold_out\":false,\"spots_remaining\":8,\"is_near_capacity\":false,\"require_approval\":true},\"registration_availability\":\"open\",\"subscribed_to_calendar\":false,\"event_invite\":null,\"manager_info\":null,\"guest_info\":null,\"host_info\":null,\"sold_out\":false,\"locale\":\"en\",\"theme_meta\":{\"theme\":\"legacy\"},\"tint_color\":\"#6dcefd\",\"can_register_for_multiple_tickets\":false,\"font_title\":null,\"description_mirror\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"It’s time to \",\"type\":\"text\"},{\"text\":\"grab the mic and let loose!\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 🎤✨\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Join us for a night of \",\"type\":\"text\"},{\"text\":\"singing, questionable song choices, big main-character moments and plenty of laughs\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" with the TCK community.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Whether you’re the person who knows every word to every song or the person who needs a little encouragement before getting on stage, come along and make some noise with us. Expect a fun, low-pressure night of music, drinks and meeting fellow TCKs.\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"🎟️ £25 per hour \",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"This is the cost for the room, with a \",\"type\":\"text\"},{\"text\":\"maximum capacity of 12 people\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\", with the cost split between everyone attending.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Pick your song, grab the mic, and let’s see what you’ve got.\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\" 🎶🪩\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"———\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"This meet up is hosted by Home London, where Third Culture Kids gather on Sundays throughout the year to connect, explore, and just hang out. If you grew up between cultures, moved around a lot, or never quite fit into one passport, you'll feel right at home here. We do everything from museum visits to park hangs to grabbing a pint at a pub. New faces are always welcome, so come say hi and see what we're about!\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"text\":\"All the best,\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Satori (🇬🇧🇺🇸🇸🇬🇹🇼🇫🇷)\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Home London’s Co-Leader\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"——————-\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"Wondering if you're also Third Culture Kid?\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"Take the quiz -> \",\"type\":\"text\"},{\"text\":\"amiatck.com\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://amiatck.com\"}},{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"Event rules:\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"1. TCKs only\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ non-TCK parents of underage TCKs welcome\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"2. All TCKs welcome\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ all ages, cultures, backgrounds...\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"3. Bring a TCK friend!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ Just have them sign up too\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"4. Be yourself ❤️\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ We want the long answer to where are you from!\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"5. Be kind & respectful 🫂\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ Good vibes only\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"6. Treat Home like your own home 🏠\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"text\":\"❊ Welcome new members like family and contribute to the community\",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"We keep our gatherings for TCKs only and have all members go through the same application process to create a safe, intentional space where everyone is on the same page 💙\",\"type\":\"text\"}]}]},\"eth_address_requirement\":null,\"faqs\":null,\"name_requirement\":\"full-name\",\"phone_number_requirement\":null,\"solana_address_requirement\":null,\"registration_questions\":[{\"id\":\"17qnyjax\",\"label\":\"Do your parents come from different cultures? (nationality, religion, ethnicity, race...)\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"wo2gkuno\",\"label\":\"Did you spend a significant part of your childhood living in a country other than your passport country? (before age 18)\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"aojleex6\",\"label\":\"Did you grow up in a culture different from your parents' cultures? (before age 18)\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"uz80lgj9\",\"label\":\"Is this the first Home London meet-up you have attended?\",\"options\":[\"Yes\",\"No\"],\"required\":true,\"question_type\":\"dropdown\"},{\"id\":\"45tldwiz\",\"label\":\"How did you find out about Home London?\",\"required\":false,\"question_type\":\"text\"},{\"id\":\"rg7p2v7n\",\"label\":\"I consent to photo and videos being taken and used for the hometcklondon social media\",\"required\":true,\"question_type\":\"agree-check\"}],\"prefilled_answers\":{},\"is_flagged\":false,\"is_managing_calendar_admin\":false,\"show_unlock_code_option\":false,\"has_multiple_ticket_types\":false,\"membership_tiers\":[],\"membership_info\":null,\"waitlist_active\":false,\"route\":null,\"featured_city\":null}",
