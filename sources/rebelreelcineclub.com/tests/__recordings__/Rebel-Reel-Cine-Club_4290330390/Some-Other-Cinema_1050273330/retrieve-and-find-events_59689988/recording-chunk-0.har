uthorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"6382079966ef155fd6d1f65e\",\"systemDataId\":\"b2864de9-50a7-408a-9b9b-7d72acb07278\",\"systemDataVariants\":\"720x489,100w,300w,500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"880046-006.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"2c3a43\",\"topRightAverage\":\"304141\",\"bottomLeftAverage\":\"ceb9b5\",\"bottomRightAverage\":\"bb988e\",\"centerAverage\":\"362a29\",\"suggestedBgColor\":\"756a6a\"},\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/b2864de9-50a7-408a-9b9b-7d72acb07278/880046-006.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"720x489\",\"recordTypeLabel\":\"image\"},{\"id\":\"638208724fb1dc65735181da\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1669466226389,\"updatedOn\":1669466226389,\"displayIndex\":4,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"6382079966ef155fd6d1f65e\",\"systemDataId\":\"1657492347914-Q15VQRC7JIJ2EIHTH6Q5\",\"systemDataVariants\":\"720x482,100w,300w,500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"880046-003.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"253243\",\"topRightAverage\":\"7a6450\",\"bottomLeftAverage\":\"04050b\",\"bottomRightAverage\":\"7a6862\",\"centerAverage\":\"43414e\",\"suggestedBgColor\":\"897675\"},\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1657492347914-Q15VQRC7JIJ2EIHTH6Q5/880046-003.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"720x482\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"seoData\":{\"seoTitle\":\"John Waters Classic WITH Odorama Scratch and Sniff cards\",\"seoDescription\":\"Come and scratch and sniff with the Odorama cards at John Waters Polyester at the Arthouse Crouch End.\",\"seoHidden\":false},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"637e0e134563cb5635947495\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787821421160,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Richard E Grant\",\"Bruce Robinson\",\"Paul McGann\",\"Withnail and I\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1669207555772,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1683549692739-HNS8NSAO1I96IUT1C9PG\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"HAROLD AND MAUDE PAST EVENT.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"000000\",\"topRightAverage\":\"0d0d0d\",\"bottomLeftAverage\":\"4f4f4f\",\"bottomRightAverage\":\"2f1c1d\",\"centerAverage\":\"7e9c5c\",\"suggestedBgColor\":\"444335\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-aweey\",\"title\":\"PAST EVENT - Harold and Maude\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\">Rebel Reel Cine Club present an evening to celebrate</p><p class=\\\"sqsrte-large\\\"><strong>Harold and Maude</strong></p><p class=\\\"sqsrte-large\\\"><strong>(dir. Hal Ashby, 1971)</strong></p><p class=\\\"\\\"><strong>Thursday 2 February 2023</strong></p><p class=\\\"\\\"><strong>Main Feature 8.30pm</strong></p><p class=\\\"\\\"><strong>Additional fun stuff to come!</strong></p><p class=\\\"\\\"><strong>DJ 10pm - 11pm</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\"><strong>The Arthouse, Crouch End, London N8</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\"><strong>\\u00A315</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\">8.30\\u201310.00 Hal Ashby\\u2019s Cult Classic with it\\u2019s extraordinary soundtrack composed specially by Cat Stevens</p><p class=\\\"\\\">A huge inspiration for Wes Anderson (Rushmore) and one of the most cult classics - made in 1971 (it didn\\u2019t turn a profit until 1983 BUT has played almost continuously in France since its release).</p><p class=\\\"\\\">One of Rebel Reel Cine Club\\u2019s favourite films \\u2026</p><p class=\\\"\\\">Funerals, suicide references, comedy, living life for the moment - one of the most uplifting (non) Hollywood films ever made from the director of Being Theatre and Shampoo.</p><p class=\\\"\\\">The plot revolves around the exploits of a young man in his early 20s named Harold Chasen (<a href=\\\"https://en.wikipedia.org/wiki/Bud_Cort\\\" title=\\\"Bud Cort\\\">Bud Cort</a>) who is intrigued with death. Harold drifts away from the life that his detached mother (<a href=\\\"https://en.wikipedia.org/wiki/Vivian_Pickles\\\" title=\\\"Vivian Pickles\\\">Vivian Pickles</a>) prescribes for him, and slowly develops a strong friendship, and eventually a romantic relationship, with a 79-year-old woman named Maude (<a href=\\\"https://en.wikipedia.org/wiki/Ruth_Gordon\\\" title=\\\"Ruth Gordon\\\">Ruth Gordon</a>), a Nazi concentration camp survivor who teaches Harold about the importance of living life to its fullest and that life is the most precious gift of all.</p><p class=\\\"\\\">Please note this has an age certificate of 15.</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-aweey\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1683549692739-HNS8NSAO1I96IUT1C9PG/HAROLD+AND+MAUDE+PAST+EVENT.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCent