ntType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"259x194\",\"recordTypeLabel\":\"image\"},{\"id\":\"67e0698d18529b2cf9359cda\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1742760333147,\"updatedOn\":1742760343813,\"displayIndex\":6,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67e068823709be2e154ce376\",\"systemDataId\":\"b85dba2b-22ec-41bb-acf7-c5b5b99b3c65\",\"systemDataVariants\":\"278x181,100w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Unknown-14.jpeg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"d5d5d5\",\"topRightAverage\":\"989898\",\"bottomLeftAverage\":\"959595\",\"bottomRightAverage\":\"666666\",\"centerAverage\":\"5a5a5b\",\"suggestedBgColor\":\"737373\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/b85dba2b-22ec-41bb-acf7-c5b5b99b3c65/Unknown-14.jpeg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"278x181\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"253x200\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"68559139c2b2d56da3a0fbcb\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1625218302697,\"updatedOn\":1787999995275,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1750438262461,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"5b238a6e-c6ca-45bf-81a8-a95491d2e7b2\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"2.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"4e4e4e\",\"topRightAverage\":\"423c1a\",\"bottomLeftAverage\":\"24210f\",\"bottomRightAverage\":\"262311\",\"centerAverage\":\"9d8766\",\"suggestedBgColor\":\"494132\"},\"urlId\":\"dungenessignup-tn58j-8bdl4-lslbh-7mrsw-49epm-f7lzf-z257w-7knte-aj3p6\",\"title\":\"Deep End - Saturday 12 July - Coal House Cafe, Woodberry Wetlands, Nr Manor House - entrance on Woodberry Grove/ Lordship Road N16\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>Deep End</span><br><span>Dir. </span>Jerzy Skolimowski<br>1970</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Jane Asher and John Moulder-Brown, Deep End is a psychological coming of age story, one of David Lynch\\u2019s favourite films \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Set in a swimming pool telling the story of school leaver 15 year old Mike meeting an older colleague in the baths \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Imagine sipping a cool glass of wine, enjoying a luxury Hot Dog, having walked the 200m long broadway over the reeds and edge of the Woodberry Wetlands Lake \\u2026 the sound of Can\\u2019s 14 minute song washing over you in Deep End \\u2026</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">I love this film and I think that anyone coming to watch it is going to go away thinking \\u2018Wow, well that was special\\u2019 \\u2026</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Eats and Music</strong></p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Martin Green will be DJ-ing beforehand a suitably psychedelic set (CAN wrote Mother Sky for the film and it features in a 14 minute Soho scene).</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The team at Woodberry have sourced some Vegan and Meat hot dogs (there\\u2019s a great \\u2018hot dog scene\\u2019 in the film \\u2026)</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Why Watch Deep End?</strong></p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">David Lynch said that he didn\\u2019t like colour films but out of all of them this was his favourite \\u2026 the colours are amazing and remind me of Don\\u2019t Look Now \\u2026</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Jane Asher is so brilliant in this and John Moulder-Brown as the 15 year old.</p><p class=\\\"\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">There are so many brilliant scenes both in Soho and elsewhere in London \\u2026 I love seeing films from the 60s for the London Street scenes.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">If you came to The Swimmer you\\u2019ll love this \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Screening at 8.35pm, gates open for drinks and food from 7.30pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJ Martin Green before the film</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Entrance on New River Path just off Woodberry Road, N16 - DON\\u2019T go to the Bethune entrance as it closes earlier.</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/dungenessignup-tn58j-8bdl4-lslbh-7mrsw-49epm-f7lzf-z257w-7knte-aj3p6\"