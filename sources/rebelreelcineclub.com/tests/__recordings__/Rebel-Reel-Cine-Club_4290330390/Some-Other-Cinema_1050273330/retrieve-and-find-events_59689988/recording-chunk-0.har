"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1634393599728-6I06SD6KTQCY7VI2GQJG/images-1.jpeg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"225x225\",\"recordTypeLabel\":\"image\"},{\"id\":\"637e0e144563cb56359474a6\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1668701791203,\"updatedOn\":1668701795100,\"displayIndex\":4,\"starred\":false,\"passthrough\":false,\"workflowState\":1,\"publishOn\":1668701791203,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"637e0e134563cb5635947495\",\"systemDataId\":\"1668701791408-QLOXJJ9769FWSS5GXU2A\",\"systemDataVariants\":\"480x480,100w,300w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Arthouse, Crouch End.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"ffffff\",\"topRightAverage\":\"ffffff\",\"bottomLeftAverage\":\"ffffff\",\"bottomRightAverage\":\"ffffff\",\"centerAverage\":\"b06c71\",\"suggestedBgColor\":\"d67e83\"},\"urlId\":\"u3l4p7bjdg6d6v7fn4dsqgyexdkt05-n2pcs\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/u3l4p7bjdg6d6v7fn4dsqgyexdkt05-n2pcs\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1668701791408-QLOXJJ9769FWSS5GXU2A/Arthouse%2C+Crouch+End.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"480x480\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"63389016cce9bf7bdc85abed\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787816274822,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Richard E Grant\",\"Bruce Robinson\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1664652200473,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1668851381845-E8HA3V573A6AN3FNSF0K\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"American Werewolf.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"030303\",\"topRightAverage\":\"2b2b2b\",\"bottomLeftAverage\":\"4f4f4f\",\"bottomRightAverage\":\"121313\",\"centerAverage\":\"76211c\",\"suggestedBgColor\":\"362f34\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-jd885\",\"title\":\"PAST EVENT = An American Werewolf In London\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\">Rebel Reel Cine Club present an evening to celebrate</p><p class=\\\"sqsrte-large\\\"><strong>An American Werewolf in London</strong></p><p class=\\\"sqsrte-large\\\"><strong>(dir. John Landis) 1981</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\"><strong>Mon 31 Oct 2022</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\"><strong>Doors 6.30pm, Main Feature 8.00pm</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\"><strong>Camley Street Nature Reserve, Kings Cross (just over the footbridge in Coal Drops Yard)</strong></p><p class=\\\"\\\"><strong>Food and drinks available - special menu to be announced on 24 October</strong></p><p style=\\\"text-align:start;\\\" class=\\\"\\\">7.00\\u20137.45 DJ playing \\u2018an appropriately spooky set\\u2019 whilst you apple bob and order from specially created menu</p><p class=\\\"\\\">We\\u2019ll be screening Kenneth Anger\\u2019s iconic Lucifer Rising pre-film</p><p style=\\\"text-align:start;\\\" class=\\\"\\\">8.00\\u20139.30 Screening of the horror comedy classic An American Werewolf in London - John Landis\\u2019s comedy horror classic from 1981</p><p class=\\\"\\\">David (David Naughton) and Jack (Griffin Dunne), two American college students, are backpacking through Britain when a large wolf attacks them. David survives with a bite, but Jack is brutally killed. As David heals in the hospital, he's plagued by violent nightmares of his mutilated friend, who warns David that he is becoming a werewolf. When David discovers the horrible truth, he contemplates committing suicide before the next full moon causes him to transform from man to murderous beast.</p><p class=\\\"\\\">Please note this is an outdoor screening (although we can move inside it if\\u2019s too cold!) Wrap up warm to keep the chill of the Werewolf at bay</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-jd885\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1668851381845-E8HA3V573A6AN3FNSF0K/American+Werewolf.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"733a32bb-f587-404d-b150-dabb7f39d9ba\",\"sku\":\"WEREWOLF\",\"price\":1500,\"salePrice\":1000,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"15.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"10.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"mightHavePaymentPlan\":false},\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\"