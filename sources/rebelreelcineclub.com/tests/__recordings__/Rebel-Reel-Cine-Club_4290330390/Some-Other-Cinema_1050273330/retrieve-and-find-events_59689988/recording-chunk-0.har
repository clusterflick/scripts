tUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1709117545351-HJPZJABYOV6VVBHOA6FE/SIP0343_11.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1920x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"65df1069cd90b02797f9abd9\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1709117545027,\"updatedOn\":1722852858880,\"displayIndex\":5,\"workflowState\":1,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"65c1689a12432b0aa6b31570\",\"systemDataId\":\"1709117545389-E4U94PI6YHVGHGTHJTA2\",\"systemDataVariants\":\"1920x1080,100w,300w,500w,750w,1000w,1500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"SIP0343_9.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"080507\",\"topRightAverage\":\"030302\",\"bottomLeftAverage\":\"39374f\",\"bottomRightAverage\":\"040404\",\"centerAverage\":\"2d1911\",\"suggestedBgColor\":\"1f1516\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1709117545389-E4U94PI6YHVGHGTHJTA2/SIP0343_9.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1920x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1920x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"65b68e9a134b591dedbf01a6\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787871951945,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Julian Temple\",\"Malcolm McLaren\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1706467007086,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1707428756716-3E2C54FFRY55S7ROJ5OA\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"JULIEN SPELLING.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"696969\",\"topRightAverage\":\"6e6e6e\",\"bottomLeftAverage\":\"484848\",\"bottomRightAverage\":\"524f47\",\"centerAverage\":\"716e57\",\"suggestedBgColor\":\"3a3d3c\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw\",\"title\":\"The Great Rock 'n' Roll Swindle at  100 Club  - Tuesday 12 March from 7.30pm\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rebel Reel Cine Club and Music Film Network present</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">The Great Rock \\u2018n\\u2019 Roll Swindle </p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">At the Iconic 100 Club - where The Sex Pistols played as part of the Punk Special on 20th September 1976</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">Dir. Julien Temple will be introducing the film and taking questions.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><strong>From 7.30pm</strong></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">DJ Martin Green and <a href=\\\"https://www.mixcloud.com/aidan-macmanus\\\">DJ Aiden McManus</a></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">ALSO</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Our friends at the Museum of Youth Culture will be joining us at the 100 Club and they want to see your photographs of being a teenage Punk! Bring along your photographs, flyers and ephemera to be scanned for their collection and share your memories with the museum.&nbsp;</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38