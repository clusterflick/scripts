0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"050505\",\"topRightAverage\":\"020202\",\"bottomLeftAverage\":\"1d1d1d\",\"bottomRightAverage\":\"161616\",\"centerAverage\":\"505050\",\"suggestedBgColor\":\"383838\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/f1caeff9-7529-43fb-832f-cd3a470a7147/RRCC+Alfa+Cinema.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"690136a01941a93aec8c7297\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210922,\"updatedOn\":1741883210922,\"displayIndex\":2,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"690136a01941a93aec8c728f\",\"systemDataId\":\"61c679a9-10bc-49cf-b285-4c02adbb499f\",\"systemDataVariants\":\"5760x3840,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Cinema - 1.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0c0a0d\",\"topRightAverage\":\"0d0d15\",\"bottomLeftAverage\":\"2f2f45\",\"bottomRightAverage\":\"1c1923\",\"centerAverage\":\"212228\",\"suggestedBgColor\":\"302e42\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/61c679a9-10bc-49cf-b285-4c02adbb499f/Cinema+-+1.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"5760x3840\",\"recordTypeLabel\":\"image\"},{\"id\":\"690136a01941a93aec8c729a\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210917,\"updatedOn\":1741883210917,\"displayIndex\":3,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"690136a01941a93aec8c728f\",\"systemDataId\":\"42bcb234-6759-4551-94fb-b4982e957714\",\"systemDataVariants\":\"5760x3840,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Cinema - 2.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"100c13\",\"topRightAverage\":\"0f0d11\",\"bottomLeftAverage\":\"282731\",\"bottomRightAverage\":\"353248\",\"centerAverage\":\"403647\",\"suggestedBgColor\":\"363147\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/42bcb234-6759-4551-94fb-b4982e957714/Cinema+-+2.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"5760x3840\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"68dab727e6715c1b2b6355f3\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1788087308422,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Faye Dunaway\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1759164603274,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"c1891005-0617-42bf-8e47-aec0d33bb79b\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"5.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"4a4a4a\",\"topRightAverage\":\"404348\",\"bottomLeftAverage\":\"555555\",\"bottomRightAverage\":\"747474\",\"centerAverage\":\"be8b8f\",\"suggestedBgColor\":\"5a5558\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-ryyya-s5rd4-ckl8p\",\"title\":\"QUERELLE - Fri 17 Oct 2025 7pm - All is Joy Soho\",\"body\":null,\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">As part of Cine Style the iconic Querelle at All is Joy</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Fassbender\\u2019s last film is like a Jean Paul Gautier perfume soaked fever dream.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Stylistically like a sex pulsating ballet set in the port of Brest and bar cum brothel Le Feria \\u2026the knife fight could have been choreographed for a Matthew Bourne ballet\\u2026<br />The style energy of Querelle is pistol-whip-you-fully-in-the-face-and-grab-you-by-the-balls! \\u2026  red sky a night (someone\\u2019s dead delight) smoking sound stage lighting \\u2026 a sea wall that features 8ft high phallus shaped stone sailor leaning totems\\u2026 costumes so designed and imagery laden that they could be in a Wes Anderson film and characters that include a leather boy policeman, dashing Captain narrator (\\u201Coh captain, I\\u2019m inexplicably dripping with sweat with no top on whilst you appear to be sweat-free under a dashing cloak all epaulets, frogging and sang froid\\u2026 </p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Brad Davies spends much of the film with his top off and Jeanne Moreau\\u2019s dance hungry bar-owner\\u2019s wife is as insatiable as her dice-rolling husband \\u2026 Querelle is based on Jean Genet\\u2019 novel, which itself was an adaptation inspired by Benjamin Britten\\u2019s Opera BIlly Budd, but with the Homo-erotic dial sweatily turned up to 11 \\u2026</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Just don\\u2019t play dice with Feria barman and hungry husband Nono!</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">7pm: DOORS - DJ</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">7.30pm: Introduction with Chris McGill (Rebel Reel Cine Club)</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">8pm: Querelle</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJ until Midnight</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Querelle </strong><br />Dir. Rainer Fassbender 1982<br />1hr 47 mins</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">All Is Joy is a private members bar and events space, signing up will get you a temporary membership for this screening as well as your permanent membership of Rebel Reel Cine Club which comes with your ticket.</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-ryyya-s5rd4-ckl8p\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/c1891005-0617-42bf-8e47-aec0d33bb79b/5.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"d47855c6-fa7f-4295-850e-f01776c3161f\",\"sku\":\"QUERELLE\",\"price\":1000,\"salePrice\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"10.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\