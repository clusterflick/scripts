TypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"recordTypeLabel\":\"store-item\"},{\"id\":\"65c1689a12432b0aa6b31570\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787873290190,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Julian Temple\",\"Malcolm McLaren\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1708341698931,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1709117545303-NQALR7LPRM1N1YK6X4MI\",\"systemDataVariants\":\"1920x1080,100w,300w,500w,750w,1000w,1500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"SIP0343_10.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"3b3718\",\"topRightAverage\":\"352512\",\"bottomLeftAverage\":\"14120a\",\"bottomRightAverage\":\"0c0a07\",\"centerAverage\":\"6b5a4d\",\"suggestedBgColor\":\"32281b\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl\",\"title\":\"Rude Boy - 100 Club  - Tuesday 21 May from 7.30pm - DJs Robin Banks and Aidan McManus\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rebel Reel Cine Club and Music Film Network</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">At the Iconic 100 Club </p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rude Boy</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">A young British punk and roadie for The Clash tries to navigate the socially ripped up world of 1970s England.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Dir. <span style=\\\"color: rgb(77, 81, 86)\\\">Jack Hazan and David Mingay 1980</span></p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">Our friends at the Museum of Youth Culture will be joining us at the 100 Club and they want to see your photographs of being a teenage Punk! Bring along your photographs, flyers and ephemer