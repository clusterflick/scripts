\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"9592bf94-9297-4351-ba0d-3d5e8392eb67\",\"sku\":\"VINDICATIONSWIM\",\"price\":0,\"salePrice\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"mightHavePaymentPlan\":false,\"items\":[{\"id\":\"665da3666f97a251edaec289\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1717412710283,\"updatedOn\":1717597379706,\"displayIndex\":0,\"workflowState\":1,\"publishOn\":1717412710283,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"66352e881f795d1ca9fbed5e\",\"systemDataId\":\"1717412710507-LAKTKLNQI489FC08JTCL\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"VS SATURDAY 8 JUNE.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"313131\",\"topRightAverage\":\"595959\",\"bottomLeftAverage\":\"6f6f6f\",\"bottomRightAverage\":\"201c0c\",\"centerAverage\":\"484848\",\"suggestedBgColor\":\"43423e\"},\"urlId\":\"sbv66yxp9fins5ah9pa5gvb9dtw871\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/sbv66yxp9fins5ah9pa5gvb9dtw871\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1717412710507-LAKTKLNQI489FC08JTCL/VS+SATURDAY+8+JUNE.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"65c15e7d468eb90c9132340f\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787873282893,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Julian Temple\",\"Malcolm McLaren\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1707171536261,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1709115955112-JBMDL6R07PR7TA8SG4N6\",\"systemDataVariants\":\"271x367,100w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Ciao_poster.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"6c6c6c\",\"topRightAverage\":\"6c6c6c\",\"bottomLeftAverage\":\"818181\",\"bottomRightAverage\":\"8e8e8e\",\"centerAverage\":\"656565\",\"suggestedBgColor\":\"595959\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx\",\"title\":\"Ciao Manhattan - 100 Club  - Tuesday 16 April from 7.30pm - DJ and intro with David Shilling\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rebel Reel Cine Club and Music Film Network at the Iconic 100 Club </p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><strong><em>Ciao Manhattan</em></strong></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><span style=\\\"color: rgb(32, 33, 34)\\\">Written and directed by John Palmer and </span><a href=\\\"https://en.wikipedia.org/wiki/David_Weisman\\\" title=\\\"David Weisman\\\">David Weisman</a> 1972</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">4 months before she died Edie Sedgwick made a film about (and not about) her life and the Warhol Set/ World \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">A director whose desire to achieve the impossible and to win at all costs who no-one can recall how he got hired \\u2026 twice losing his leading lady (the second time to her premature death) and yet he still completed the film \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Actor Paul America flees in the middle of a scene, driving off whilst being filmed driving around the Pan An Building, disappears for 18 months and is eventually found in a Michigan jail.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Hundreds of extras dropped acid and chaotically were filmed with a naked Allen Ginsburg walking amongst them\\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">This is <strong><em>Ciao Manhattan</em></strong> </p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Before the film I\\u2019ll be talking to David Shilling - the (in)famous self trained hatmaker born in London whose designs were sold in Bloomingdales in the late 70s.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">David met Andy Warhol in London, frequented Studio 54, visited The Factory, went to a showing by Andy of Chelsea Girls in London, his Tate opening and so much more \\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Our friends at the Museum of Youth Culture will be joining us at the 100 Club and they want to see your photographs of being a teenage Punk! Bring along your photographs, flyers and ephemera to be scanned for their collection and share your memories with the museum.&nbsp;</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1709115955112-JBMDL6R07PR7TA8SG4N6/Ciao_poster.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\