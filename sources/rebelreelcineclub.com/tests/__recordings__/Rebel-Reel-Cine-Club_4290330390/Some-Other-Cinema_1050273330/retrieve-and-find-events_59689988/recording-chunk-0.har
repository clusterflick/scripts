tem\"},{\"id\":\"67e068823709be2e154ce376\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1625218302697,\"updatedOn\":1787965181290,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1742760333986,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"6a8cffb0-8925-410e-9b03-bad823d69f42\",\"systemDataVariants\":\"253x200,100w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"images-8.jpeg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"d5d5d5\",\"topRightAverage\":\"545454\",\"bottomLeftAverage\":\"898989\",\"bottomRightAverage\":\"2d2d2d\",\"centerAverage\":\"4f4f4f\",\"suggestedBgColor\":\"787878\"},\"urlId\":\"dungenessignup-tn58j-8bdl4-lslbh-7mrsw-49epm-f7lzf-2wlpc-maytx-3kbmx\",\"title\":\"A Matter of Life and Death - Saturday 23 August  2025 - Kelly's Snack Shack, Dungeness Beach\",\"body\":null,\"excerpt\":\"<h1 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>A MATTER OF LIFE AND DEATH</strong></h1><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong><span>Directed by POWELL AND PRESSBURGER</span></strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">United Kingdom, <span>1946</span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Fantasy film about Peter Carter, a World War II RAF pilot who is forced to bail out of his crippled plane without a parachute. He wakes up to find he has landed on Earth utterly unharmed\\u2026 which wasn\\u2019t supposed to happen according to the rules of Heaven.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Music before screening from 7.30pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Main film at 8.30pm</p><p class=\\\"\\\" style=\\\"whi