27\",\"parentId\":\"67b849592f805c6bc171d9bc\",\"systemDataId\":\"f179241a-fb48-41da-920a-20ff8ab9bcf9\",\"systemDataVariants\":\"800x800,100w,300w,500w,750w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"raymond-revuebar-soho-london.jpeg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"110c0f\",\"topRightAverage\":\"170a0b\",\"bottomLeftAverage\":\"361b11\",\"bottomRightAverage\":\"502c16\",\"centerAverage\":\"e2b996\",\"suggestedBgColor\":\"6d4330\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/f179241a-fb48-41da-920a-20ff8ab9bcf9/raymond-revuebar-soho-london.jpeg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"800x800\",\"recordTypeLabel\":\"image\"},{\"id\":\"67d3074aad56f8289fdd1642\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210926,\"updatedOn\":1742987667372,\"displayIndex\":7,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67b849592f805c6bc171d9bc\",\"systemDataId\":\"48de1b0f-2ed3-42ab-8685-cb5a00f8e580\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"4.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"471112\",\"topRightAverage\":\"4f1c14\",\"bottomLeftAverage\":\"b58f98\",\"bottomRightAverage\":\"837e7a\",\"centerAverage\":\"ae847b\",\"suggestedBgColor\":\"94766d\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/48de1b0f-2ed3-42ab-8685-cb5a00f8e580/4.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"67d3074aad56f8289fdd1643\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210930,\"updatedOn\":1742987667379,\"displayIndex\":8,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67b849592f805c6bc171d9bc\",\"systemDataId\":\"ba3276c2-e7b7-4429-b4be-342f3a9bc4dd\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"2.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"491010\",\"topRightAverage\":\"521c15\",\"bottomLeftAverage\":\"464646\",\"bottomRightAverage\":\"ab8c8d\",\"centerAverage\":\"6e2a18\",\"suggestedBgColor\":\"5b3c30\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/ba3276c2-e7b7-4429-b4be-342f3a9bc4dd/2.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"67d3074aad56f8289fdd1641\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210925,\"updatedOn\":1742987667384,\"displayIndex\":9,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67b849592f805c6bc171d9bc\",\"systemDataId\":\"32441309-67af-41e6-9460-1aaf6494f3c5\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"INVITATION FOR THE LOOK OF LOVE-3.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"020202\",\"bottomLeftAverage\":\"020202\",\"bottomRightAverage\":\"020202\",\"centerAverage\":\"625959\",\"suggestedBgColor\":\"34342a\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/32441309-67af-41e6-9460-1aaf6494f3c5/INVITATION+FOR+THE+LOOK+OF+LOVE-3.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"67ab15400c464c56c43a7700\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632381040360,\"updatedOn\":1787950911731,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Rio Cinema\",\"The Holy Mountain\",\"Jordorowsky\",\"Kenneth Anger\",\"Magick Lantern\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1739274139693,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"33d47768-c1bb-4335-af70-c61720ef8202\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"3.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"200808\",\"bottomLeftAverage\":\"595959\",\"bottomRightAverage\":\"383834\",\"centerAverage\":\"131414\",\"suggestedBgColor\":\"3c3431\"},\"urlId\":\"punk-m46w4-tp539-exa6m-w8yw9-9kmyd-2g46z\",\"title\":\"Tokyo Dreams - Branded to Kill & Tokyo Toy Boy - 5 March 7.30pm @ Rio Cinema, Dalston\",\"body\":null,\"excerpt\":\"<h4 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>A night to celebrate the dreams and anti-dreams of Tokyo, Japan.</span><br><span>DJs before and after the film including Karis O\\u2019Hara</span></h4><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>DJ from 7pm</span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Seijun Suzuki\\u2019s bonkers super stylish masterpiece about the third rated assassin in Japan - it\\u2019s so much more than a Yakuza flick - more in the vein of a hard boiled soundtrack heavy brilliant cool New Wave looking 60s fashion film - we think you\\u2019ll love it - We\\u2019ve also got a truly enlightening short documentary from Belgium Graduate <strong><span>Esli Khan Balatova </span></strong>we unearthed in the Artsthread 2024 Global Graduate competition (it won)</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Branded to Kill</strong><br><strong>Dir. Seijun Suzuki</strong><br><strong>Japan 1967, 91 minutes</strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong><span>When Japanese New Wave bad boy Seijun Suzuki delivered this brutal, hilarious, and visually inspired masterpiece to the executives at his studio, he was promptly fired. </span><em>Branded to Kill </em><span>(</span><em>Koroshi no rakuin</em><span>) tells the ecstatically bent story of a yakuza assassin with a fetish for sniffing steamed rice (the chipmunk-cheeked superstar Joe Shishido) who botches a job and ends up a target himself. This is Suzuki at his most extreme\\u2014the flabbergasting pinnacle of his sixties pop-art aesthetic.</span></strong></p><h4 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Tokyo Toy Boy<br>Dir, Esli Khan Balatov<br>Belguim 2024, 29 minutes</h4><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong><span>Through an intimate portrait, the documentary </span>explores the battle between self-destruction and a better day tomorrow<span>. Kazuho, \\u200B\\u200Ba 24-year-old former host boy in the shady neighborhoods of Tokyo, bears the scars of a lost generation. Tokyo Toy Boy follows Kazuho's inner struggle. Between the urge for death and the hope for tomorrow, he quietly fights on and shows the struggles of young adults worldwide.</span></strong></p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/punk-m46w4-tp539-exa6m-w8yw9-9kmyd-2g46z\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/33d47768-c1bb-4335-af70-c61720ef8202/3.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"b985ca91-47e8-43b9-a9a0-cca55784175c\",\"sku\":\"BRANDED\",\"price\":1450,\"salePrice\":1250,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"14.50\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"12.50\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"productAddOnsConfiguration\":{\"productAddOns\":[]},\"mightHavePaymentPlan\":false},\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"b985ca91-47e8-43b9-a9a0-cca55784175c\",\"sku\":\"BRANDED\",\"price\":1450,\"salePrice\":1250,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"14.50\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"12.50\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"productAddOnsConfiguration\":{\"productAddOns\":[]},\"mightHavePaymentPlan\":false,\"items\":[{\"id\":\"67b8444f13432229ef9a43f4\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1740129359066,\"updatedOn\":1740129359066,\"displayIndex\":0,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67ab15400c464c56c43a7700\",\"systemDataId\":\"33d47768-c1bb-4335-af70-c61720ef8202\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"3.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"200808\",\"bottomLeftAverage\":\"595959\",\"bottomRightAverage\":\"383834\",\"centerAverage\":\"131414\",\"suggestedBgColor\":\"3c3431\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/33d47768-c1bb-4335-af70-c61720ef8202/3.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"67ab159b92266c68f8e62de5\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1739265435557,\"updatedOn\":1739265435557,\"displayIndex\":1,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67ab15400c464c56c43a7700\",\"systemDataId\":\"611ef851-d67f-4eb1-839d-d53d613f1fd0\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"5th March.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"ad1a25\",\"topRightAverage\":\"f80909\",\"bottomLeftAverage\":\"f32322\",\"bottomRightAverage\":\"434343\",\"centerAverage\":\"111111\",\"suggestedBgColor\":\"942c2c\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/611ef851-d67f-4eb1-839d-d53d613f1fd0/5th+March.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"6738b141fe992e1251605fb5\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632381040360,\"updatedOn\":1787929266512,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Rio Cinema\",\"The Holy Mountain\",\"Jordorowsky\",\"Kenneth Anger\",\"Magick Lantern\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1731867679488,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"aa45569a-33c8-4953-bee9-77af28f59829\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"1.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"2c0a0a\",\"topRightAverage\":\"3e0e0e\",\"bottomLeftAverage\":\"5e5e5e\",\"bottomRightAverage\":\"383834\",\"centerAverage\":\"636664\",\"suggestedBgColor\":\"554d40\"},\"urlId\":\"punk-m46w4-tp539-exa6m-w8yw9-9kmyd\",\"title\":\"A Most Unholy Christmas - Tuesday 17 December from 7pm at the Rio Cinema, Dalston\",\"body\":null,\"excerpt\":\"<h4 style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Celebrate an Alternative Christmas with a screening of the shocking Surrealist Classic The Holy Mountain</strong></h4><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>The Holy Mountain</strong><br>Dir. <span>Alejandro Jodorowsky</span><br>1973</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">x5 DJs in the bar and in the cinema \\u2026</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJs before and after the films - <strong>this is a screening and a party!</strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">With an opening performance by <a href=\\\"https://www.instagram.com/charliejjimenez?igsh=MWxqMDNmNW9rMXFvbA==\\\"><strong>Charlie Jiminez and </strong></a>Nemi Colette, Yiling Zhao, Aimee Ruhinda, Jessica Ridge, Ana Oakes, Lizzie Rose, Soren Muller and Marianna di Majo.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Music performed by Louis Perrit (conductor), Rebecca Burden, Emily Buckley Bunn, Simon Grancher, Otto Hashmi, Aldi Ho, Georgia Tolson, Dilon Harrison and Kim Allahyar\\u0131</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Makeup by Connie Xu, Jade, Varvara Ivanova and Hattie Ford</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Shorts from the Magick Lantern Cycle by Kenneth Anger before the main feature and a short from <a href=\\\"http://zoeticaebb.com\\\">Zoetica Ebb</a></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>The Holy Mountain</strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The scandal of the 1973 Cannes Film Festival, The Holy Mountain is a sprawling phantasmagoria of sacrilegious visual excess and existential yearning - AND What could be more Christmassy than that!</p><p style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Jodorowsky's most ambitious film sees the director himself play The Alchemist, a guru who guides a troupe of pilgrims, each representing a planet of the Solar System, on a magical quest to Lotus Island where they must ascend the Holy Mountain in search of spiritual enlightenment.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJs <a target=\\\"_blank\\\" href=\\\"https://www.instagram.com/jemmabolt/?hl=en-gb\\\"><strong>Jemma Bolt</strong></a><strong> </strong>and <a href=\\\"https://www.instagram.com/blackglovemusic\\\"><strong>Vadim Kosmos</strong></a><strong> </strong>before the film,  <a href=\\\"https://www.instagram.com/pamhoggfashion?igsh=OTVldWYyc2dpeWts\\\"><strong>Pam Hogg, </strong></a> <a href=\\\"https://www.instagram.com/pips_taylor?igsh=MWh2OWcxaTZtNGF6dg==\\\"><strong>Pips Taylor</strong></a> and Gary The Tall after the film to party in the cinema!</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><a href=\\\"https://www.instagram.com/agne.qami?igsh=MXc5bzIzcjZsZ2w2cw==\\\"><strong>Agne Qami</strong></a> is co-curating a selection of Ghosts of Christmas Past and most Unholy images projected on to the screen whilst you dance including the work of <a href=\\\"https://www.instagram.com/pavelanuska?igsh=MXMxZnlxa3ZwN3I1aw==\\\"><strong>Pavel Anuska</strong></a></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">We\\u2019ve got a late licence to party and Rebel Reel friend <a href=\\\"https://www.instagram.com/jeaniejeanphotos?igsh=Ymt0aXMzZmJ2dHBu\\\"><strong>Jeanie Jean Photos</strong></a> will be on hand to record it all!</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The Rio Cinema is <span>107 Kingsland High Street, London, </span>E8 2PB</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/punk-m46w4-tp539-exa6m-w8yw9-9kmyd\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/aa45569a-33c8-4953-bee9-77af28f59829/1.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\