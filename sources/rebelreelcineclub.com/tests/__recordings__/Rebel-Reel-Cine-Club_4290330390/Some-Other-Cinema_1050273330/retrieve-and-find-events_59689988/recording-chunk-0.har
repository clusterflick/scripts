"source\":3},\"colorData\":{\"topLeftAverage\":\"a7a7a7\",\"topRightAverage\":\"ffffff\",\"bottomLeftAverage\":\"6e6e6e\",\"bottomRightAverage\":\"111111\",\"centerAverage\":\"eea4a4\",\"suggestedBgColor\":\"837b7b\"},\"urlId\":\"7tu2uxd4i5igzb0wic3brif9zpnfqx\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/7tu2uxd4i5igzb0wic3brif9zpnfqx\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1695128418875-73I4T6BLXZRMOLVI7272/THE+WICKERMAN+AT+WESTWELL+%281%29.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"64613fd960de2871ee059e15\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632381040360,\"updatedOn\":1787838097312,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Rio Cinema\",\"Northern Soul\",\"Elaine Constantine\",\"Fashion Photography\",\"Wigan Casino\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1684095544383,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1701795092967-N4UXQAALFG7S2IHDD2ZP\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Northern Soul Past Event.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"363636\",\"bottomLeftAverage\":\"1c1c1c\",\"bottomRightAverage\":\"262626\",\"centerAverage\":\"411926\",\"suggestedBgColor\":\"372a29\"},\"urlId\":\"punk-m46w4-tp539-exa6m\",\"title\":\"Northern Soul - Wednesday 27 September at the Rio Cinema, Dalston\",\"body\":null,\"excerpt\":\"<h4 style=\\\"text-align:center;white-space:pre-wrap;\\\">WIGAN CASINO ANNIVERSARY SCREENING!</h4><h4 style=\\\"text-align:center;white-space:pre-wrap;\\\">We had a pre-film chat with Director Elaine Constantine and star Elliot James Landridge</h4><h4 style=\\\"text-align:center;white-space:pre-wrap;\\\">DJ Shaafi (Heart of Soul Peckham) played in the bar playing vinyl and Lucienne Cole (Crawdaddy Soul Club) and Martin Green after</h4><h4 style=\\\"text-align:center;white-space:pre-wrap;\\\"><span style=\\\"color:black\\\">\\u2018 Forget the top ten, it\\u2019s all PROPAGANDA.</span></h4><h4 style=\\\"text-align:center;white-space:pre-wrap;\\\"><span style=\\\"color:black\\\">This is underground but it\\u2019s gonna be massive!'</span></h4><p style=\\\"text-align:center;white-space:pre-wrap;\\\" class=\\\"\\\">Elaine Constantine\\u2019s brilliant reflection of Northern Soul, The Wigan Casino, growing up, identity, music and passion\\u2026</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">DJ Shaafi (Heart of Soul Deptford) pre-film and DJ post-film</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Music in bar from 7pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Screening at 8.30pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rio Cinema is at 107 Kingsland High St, London E8 2PB</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Elaine Constantine is a photographer and film maker has spanned three decades. Internationally celebrated as an image maker with a unique point of view, she grew up shooting for London\\u2019s style bibles in the 1990s, where her documentary-inspired approach to fashion marked her out as a unique voice and her images became instantly recognisable.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><em>\\u201CElaine Constantine is known for her unrivalled ability to capture the familiar rituals, kinetic energy and sheer magic of British youth.</em></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><em>Constantine came to fame in the \\u201890s for her honest, expressive and observational photography first published by The Face magazine.</em></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><em>Brimming with real-time action, back then, Constantine\\u2019s work acted as an antidote to the grunge era. Constantine waits until her models are dancing, cycling, shouting, wrestling, screaming or getting drunk to push the shutter, and it\\u2019s this sense of fearlessness that gives her work a rare authenticity that\\u2019s seen it exhibited at the V&amp;A, Tate Britain and The National Portrait Gallery\\u201D.</em></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Brook McCord, The Face 2021.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Towards the late 90s Elaine became a regular contributor to Italian, American and French Vogues where her vibrant and colourful images leaped out of the pages, projects often inspired by her own teenage memories.</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/punk-m46w4-tp539-exa6m\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1701795092967-N4UXQAALFG7S2IHDD2ZP/Northern+Soul+Past+Event.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"3623f88f-81bf-4d30-acf8-a4c9272db6d2\",\"sku\":\"NORTHERNSOUL\",\"price\":1750,\"salePrice\":1533,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"17.50\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"15.33\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"hei