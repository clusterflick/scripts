mage/png\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"644aa2e5b0997532add527ef\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1682612965728,\"updatedOn\":1682612970981,\"displayIndex\":2,\"workflowState\":1,\"publishOn\":1682612965728,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"63820a1a3522281a4e487bba\",\"systemDataId\":\"1682612968690-AT7RIAZ0R94VJO4R1TMD\",\"systemDataVariants\":\"900x893,100w,300w,500w,750w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"IMG_1237.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"9e9c8b\",\"topRightAverage\":\"656653\",\"bottomLeftAverage\":\"6d6d59\",\"bottomRightAverage\":\"bab8ab\",\"centerAverage\":\"a19e8e\",\"suggestedBgColor\":\"b0a384\"},\"urlId\":\"8cq4svj628hnyyyyzv8h0cohov8go1\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/8cq4svj628hnyyyyzv8h0cohov8go1\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1682612968690-AT7RIAZ0R94VJO4R1TMD/IMG_1237.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"900x893\",\"recordTypeLabel\":\"image\"},{\"id\":\"644aa2e914d39767071ca8ab\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1682612969011,\"updatedOn\":1682612972113,\"displayIndex\":3,\"workflowState\":1,\"publishOn\":1682612969011,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"63820a1a3522281a4e487bba\",\"systemDataId\":\"1682612969884-OAVEXNIRHBLCMBWTH66M\",\"systemDataVariants\":\"1369x1600,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"IMG_1238.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"9c7889\",\"topRightAverage\":\"a38090\",\"bottomLeftAverage\":\"ae8b9d\",\"bottomRightAverage\":\"b895a6\",\"centerAverage\":\"bd98a9\",\"suggestedBgColor\":\"bd8b9c\"},\"urlId\":\"33mkn82dnjlon3i4wbeiarf2v0jlwx\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/33mkn82dnjlon3i4wbeiarf2v0jlwx\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1682612969884-OAVEXNIRHBLCMBWTH66M/IMG_1238.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1369x1600\",\"recordTypeLabel\":\"image\"},{\"id\":\"644aa2b4926a82069fd753c5\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1682612916355,\"updatedOn\":1682612928657,\"displayIndex\":4,\"workflowState\":1,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"63820a1a3522281a4e487bba\",\"systemDataId\":\"1682612923131-Y352AKNZTIT9HD6R8H88\",\"systemDataVariants\":\"6690x8476,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Whitaker Malem with figure portrait CREDIT PHOTO Frederic Aranda.jpg\",\"mediaFocalPoint\":{\"x\":0.5299999713897705,\"y\":0.10000000149011612,\"source\":3},\"colorData\":{\"topLeftAverage\":\"36383c\",\"topRightAverage\":\"515a61\",\"bottomLeftAverage\":\"151211\",\"bottomRightAverage\":\"171717\",\"centerAverage\":\"222225\",\"suggestedBgColor\":\"272526\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1682612923131-Y352AKNZTIT9HD6R8H88/Whitaker+Malem+with+figure+portrait+CREDIT+PHOTO+Frederic+Aranda.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"6690x8476\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"3840x2880\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"63cd5effbf546769ad29af0a\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1625218302697,\"updatedOn\":1787826630248,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1674403736434,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1683545528010-P9WVWXMTBPTWF2WOF592\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"WITHNAIL AND I DUNGENESS PAST EVENT.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0a0a0a\",\"topRightAverage\":\"121212\",\"bottomLeftAverage\":\"303030\",\"bottomRightAverage\":\"141414\",\"centerAverage\":\"415a36\",\"suggestedBgColor\":\"363935\"},\"urlId\":\"dungenessignup-tn58j-8bdl4-lslbh-7mrsw\",\"title\":\"PAST EVENT - Withnail and I - Friday 5th May 2023 Kelly's Snack Shack, Dungeness Beach\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\">Screened at 8.23pm (food from 7pm)</p><p class=\\\"\\\">Outdoor screening</p><p class=\\\"\\\"><strong>(dir. Bruce Robinson, 1987)</strong></p><p class=\\\"\\\"><strong>Main Feature 8.30pm</strong></p><p class=\\\"\\\">Watch-A-Long Bingo Cards</p><p style=\\\"text-align:start;\\\" class=\\\"\\\">We went on holiday to Dungeness by mistake!</p><p class=\\\"\\\">Screening of Bruce Robinson\\u2019s brilliant brilliant funny film - every line is perfect.</p><p class=\\\"\\\">London. The 1960s. Two unemployed actors\\u2014acerbic, elegantly wasted Withnail (Richard E. Grant) and the anxiety-ridden \\\"I\\\" (Paul McGann)\\u2014drown their frustrations in booze, pills, and lighter fluid.</p><p class=\\\"\\\">When Withnail's Uncle Monty (Richard Griffiths) offers his cottage, they escape the squalor of their flat for a week in the country. They soon realize they\\u2019ve gone on holiday by mistake when their wits\\u2014and friendship\\u2014are sorely tested by violent downpours, less than hospitable locals, and empty cupboards. An intelligent, superbly acted, and hilarious film, Bruce Robinson\\u2019s semi-autobiographical cult favourite is laugh out loud funny\\u2026</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/dungenessignup-tn58j-8bdl4-lslbh-7mrsw\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1683545528010-P9WVWXMTBPTWF2WOF592/WITHNAIL+AND+I+DUNGENESS+PAST+EVENT.png\",\"contentType\":\"image/png\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"8395db4c-adb6-4662-8b7b-9daafbbf2bc0\",\"sku\":\"DUNG5MAY\",\"price\":1300,\"salePrice\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"13.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"mainImageId\":\"63cd5effbf546769ad29af2a\",\"images\":[],\"mainImage\":{\"id\":\"63cd5effbf546769ad29af2a\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1625218236175-ZLZXMTQZE6VX8C169CFW/DungenessPowerStation.jpg\",\"systemDataSourceType\":\"JPG\",\"systemDataVariants\":\"2500x1875,100w,300w,500w,750w,1000w,1500w,2500w\",\"originalSize\":\"2500x1875\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"title\":\"\",\"displayIndex\":1},\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"mightHavePaymentPlan\":false},\"pri