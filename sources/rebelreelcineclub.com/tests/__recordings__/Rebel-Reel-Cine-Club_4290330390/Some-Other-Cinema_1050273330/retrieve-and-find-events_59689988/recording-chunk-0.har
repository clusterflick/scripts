0917,\"updatedOn\":1741883210917,\"displayIndex\":2,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"67f92dcd61ae981a88268e4e\",\"systemDataId\":\"42bcb234-6759-4551-94fb-b4982e957714\",\"systemDataVariants\":\"5760x3840,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Cinema - 2.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"100c13\",\"topRightAverage\":\"0f0d11\",\"bottomLeftAverage\":\"282731\",\"bottomRightAverage\":\"353248\",\"centerAverage\":\"403647\",\"suggestedBgColor\":\"363147\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/42bcb234-6759-4551-94fb-b4982e957714/Cinema+-+2.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"5760x3840\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"67e3e193af4ef41c39ffd98e\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787966167152,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1743061918502,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"480bbbc3-8966-4beb-a245-a42d25812f37\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Untitled (Facebook Video).jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0a0605\",\"topRightAverage\":\"0a0605\",\"bottomLeftAverage\":\"060404\",\"bottomRightAverage\":\"262009\",\"centerAverage\":\"111008\",\"suggestedBgColor\":\"3a2e16\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t\",\"title\":\"This Good Friday ... The Long Good Friday - All is Joy, 75 Dean Street, Soho - Friday 18 April\",\"body\":null,\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">\\u201CWell, Now there\\u2019s been an ERUPTION!\\u201D</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">\\u201CWho would do such a thing? it\\u2019s outrageous, outside of Church!\\u2026 you don\\u2019t go crucifying people outside of Church, NOT on Good Friday\\u2019</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">THE SOUNDTRACK BY FRANCIS MONKMAN IS SO GOOD!</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">The Long Good Friday <br>Dir. <span>John Mackenzie</span><br>UK, 1980<br>1hr 45mins</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Suitably atmospheric and 1980s DJ before and after the film in the heart of Gangland Soho, remember it\\u2019s 1980 - don\\u2019t be a mug and dress nice - \\u201Chave a Bloody Mary, it\\u2019s Good Friday!\\u201D</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">We. Rebel Reel, run London\\u2026</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/480bbbc3-8966-4beb-a245-a42d25812f37/Untitled+%28Facebook+Video%29.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\