-item\"},{\"id\":\"675174b978771d72dc0c6454\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787934434332,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Punk\",\"Washington\",\"Pam Hogg\",\"Scott Crawford\",\"Dave Grohl\",\"Ian MacKaye\",\"Thurston Moore\",\"Henry Rollins\",\"Fred Armisen\",\"Fugazi\",\"Dag Nasty\",\"Slickee Boys\",\"Bad Brains\",\"Big Boys\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1733391663279,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"fc641248-beb6-45ff-ba9d-97cde7d717d1\",\"systemDataVariants\":\"1544x2048,100w,300w,500w,750w,1000w,1500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Fuzztones vs the world.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"2280c5\",\"topRightAverage\":\"127ed5\",\"bottomLeftAverage\":\"6a655a\",\"bottomRightAverage\":\"726e65\",\"centerAverage\":\"8a806e\",\"suggestedBgColor\":\"727979\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft\",\"title\":\"The Fuzztones vs The World - UK Premiere - 100 Club, 100 Oxford Street - Wednesday 29 January\",\"body\":null,\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>MusicFilmNetwork presents the UK Premiere of THE FUZZTONES VS THE WORLD</span></p><p class=\\\"MsoNormal\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>WEDNESDAY 29 JANUARY</span></p><p class=\\\"MsoNormal\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>7.00 PM</span></p><p class=\\\"MsoNormal\\\" style=\\\"text-align: start; ; white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>100 CLUB, OXFORD STREET, LONDON</span></p><p class=\\\"accssme-widget-text\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>The Fuzztones vs The World - UK Film premiere!</span></p><p class=\\\"accssme-widget-text\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>A tale of sex, LSD, and rock n roll from acclaimed documentary filmmaker Danny Garcia. Film premiere!</span></p><p class=\\\"accssme-widget-text\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>This film chronicles the highs and lows of an extraordinary band and its unstoppable and charismatic leader, Rudi Protrudi, The Fuzztones whose career spans over 40 years of Garage Rock. Formed in New York City in the early 80s, their redefining brand of Psychedelic Punk spawned an exciting new scene.&nbsp; &nbsp;With 17 line-up changes and countless labels and albums, it\\u2019s been four decades of adventures and misadventures for that Pennsylvania boy who found his passion in Chuck Berry and monster movies and who now, at over 70, plans to die on stage.</span></p><p class=\\\"accssme-widget-text\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>Trailer:&nbsp;&nbsp; </span><a href=\\\"https://www.youtube.com/watch?v=i7XDBENrrSM\\\"><u>https://www.youtube.com/watch?v=i7XDBENrrSM</u></a></p><p class=\\\"MsoNormal\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>+ your dj for the night, the legendary Keb Darge</span></p><p class=\\\"MsoNormal\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DOORS:&nbsp; 7.00 PM</p><p class=\\\"MsoNormal\\\" style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>TICKETS:&nbsp; \\u00A315</span></p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/f