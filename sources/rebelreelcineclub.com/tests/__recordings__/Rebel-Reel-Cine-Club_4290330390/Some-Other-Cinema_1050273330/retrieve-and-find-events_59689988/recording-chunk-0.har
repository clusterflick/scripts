nalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"6522adeadf38c67a132f57ad\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632381040360,\"updatedOn\":1787855352561,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Rio Cinema\",\"Fashion Photography\",\"The Warriors\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1696772126685,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1701794556259-3KBSJ0QFV8INXSIUX6TC\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"THE WARRIORS PAST EVENT.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"4b4b4b\",\"bottomLeftAverage\":\"1c1c1c\",\"bottomRightAverage\":\"292928\",\"centerAverage\":\"b28b51\",\"suggestedBgColor\":\"4a402b\"},\"urlId\":\"punk-m46w4-tp539-exa6m-cfs5a\",\"title\":\"The Warriors - Wednesday 29 November at the Rio Cinema, Dalston\",\"body\":null,\"excerpt\":\"<h4 style=\\\"white-space:pre-wrap;\\\">THE WARRIORS<br>Dir. Walter Hill <strong>1980</strong></h4><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\"><strong>In a dystopian near-future The Warriors are trapped in the Bronx when Cyrus, leader of the Gramercy Riffs is shot \\u2026 with over 30 miles back to Coney Island The Warriors have got to avoid the police and every other gang in New York \\u2026Banned in cinemas at the time due to fights and vandalism it\\u2019s cult status grew \\u2026It\\u2019s genuinely cool \\u2026 come and see for yourself  why this remains a cult classic with a truly brilliant soundtrack</strong></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Music in bar from 7pm with DJ Martin Green</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Screening at 8.30pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Party after the film with DJs</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rio Cinema is at 107 Kingsland High St, London E8 2PB</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Are you A Warrior? A Lizzie? A Hi-Hat? A Saracen? A Bopper? An Electric Illuminator? One of Satans Mothers? This is the biggest gathering of New York\\u2019s gangs \\u2026 in Walter Hill\\u2019s brilliant 1979 film \\u2026 it\\u2019s got a dirty sexy soundtrack \\u2026 Bobbie Mannix\\u2019s costumes are just brilliant - so many patches that Bobbie designed herself - the detail is insane \\u2026</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/punk-m46w4-tp539-exa6m-cfs5a\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1701794556259-3KBSJ0QFV8INXSIUX6TC/THE+WARRIORS+PAST+EVENT.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"b8f49f0d-a955-43db-909b-612e61bc3232\",\"sku\":\"WARRIORS\",\"price\":1500,\"salePrice\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"15.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"mightHavePaymentPlan\":false},\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType