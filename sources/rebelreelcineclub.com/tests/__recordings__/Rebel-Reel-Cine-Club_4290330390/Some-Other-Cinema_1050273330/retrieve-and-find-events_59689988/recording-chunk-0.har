mDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"Polyester-3.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"000000\",\"topRightAverage\":\"010101\",\"bottomLeftAverage\":\"4e4e4e\",\"bottomRightAverage\":\"030303\",\"centerAverage\":\"a99f5f\",\"suggestedBgColor\":\"4a433a\"},\"urlId\":\"1rpx0oxkafb4vgx5uugoxfjc4ienq8\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/1rpx0oxkafb4vgx5uugoxfjc4ienq8\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1668845955468-KT92WMB8DMKWAEN79VNC/Polyester-3.png\",\"contentType\":\"image/png\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"62ec3793913fec3a1843b18a\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1625218302697,\"updatedOn\":1787811524498,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Fashiononfilm\",\"GreyGardens\",\"Maylesbrothers\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1664538540953,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1668846927159-J4ILOLLON3KHNEKY0IVQ\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"PNG\",\"filename\":\"Grey Gardens, Rio-3.png\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"000000\",\"topRightAverage\":\"030303\",\"bottomLeftAverage\":\"4e4e4e\",\"bottomRightAverage\":\"0a0a0a\",\"centerAverage\":\"512d24\",\"suggestedBgColor\":\"534b3a\"},\"urlId\":\"dungenessignup-tn58j-8bdl4-lslbh-wjn44\",\"title\":\"PAST EVENT - Grey Gardens\",\"body\":null,\"excerpt\":\"