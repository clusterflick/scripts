recordTypeLabel\":\"image\"},{\"id\":\"655e31aa4c29950c3bf3e601\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1700671914452,\"updatedOn\":1700671925099,\"displayIndex\":7,\"workflowState\":1,\"publishOn\":1700671914452,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"6522adeadf38c67a132f57ad\",\"systemDataId\":\"1700671919409-USCZ8JWJ6JN5JSW3Q03I\",\"systemDataVariants\":\"3000x2035,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Warriors_Still_C-5883_3367bfb07e5d1517c9aa3e37daa12711b1530e10.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"5d6664\",\"topRightAverage\":\"484b47\",\"bottomLeftAverage\":\"05040a\",\"bottomRightAverage\":\"120d0d\",\"centerAverage\":\"8f7572\",\"suggestedBgColor\":\"474242\"},\"urlId\":\"gmmmuitwyze8etyzm0d02zfobmvjcm\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/gmmmuitwyze8etyzm0d02zfobmvjcm\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1700671919409-USCZ8JWJ6JN5JSW3Q03I/Warriors_Still_C-5883_3367bfb07e5d1517c9aa3e37daa12711b1530e10.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"3000x2035\",\"recordTypeLabel\":\"image\"},{\"id\":\"655e31aa9537da663248bbbd\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1700671914454,\"updatedOn\":1700671936854,\"displayIndex\":8,\"workflowState\":1,\"publishOn\":1700671914454,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"6522adeadf38c67a132f57ad\",\"systemDataId\":\"1700671929395-Z9MTQ40RPCRN1KC5420M\",\"systemDataVariants\":\"3000x4445,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"Warriors_1Sheet_c2255432bcd5908122bc1e53d84b352c31ebcfe4.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"f4f3f4\",\"topRightAverage\":\"ececec\",\"bottomLeftAverage\":\"fbfbfb\",\"bottomRightAverage\":\"f5f5f5\",\"centerAverage\":\"714446\",\"suggestedBgColor\":\"968b90\"},\"urlId\":\"lvw3sqxah8jag50op1idkot465wn21\",\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":2,\"unsaved\":false,\"fullUrl\":\"/bookhere/lvw3sqxah8jag50op1idkot465wn21\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1700671929395-Z9MTQ40RPCRN1KC5420M/Warriors_1Sheet_c2255432bcd5908122bc1e53d84b352c31ebcfe4.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"3000x4445\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"6542852b02ebb64c7c850549\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1787858787876,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Richard E Grant\",\"Bruce Robinson\",\"Paul McGann\",\"Withnail and I\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1698858628764,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"1699440947362-NMCO7PV03PXYGV758WLR\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"IT%27S+A+WONDERFUL+LIFE+AT+WESTWELL.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"c7c7c7\",\"topRightAverage\":\"aaaaaa\",\"bottomLeftAverage\":\"c2ecd8\",\"bottomRightAverage\":\"c5edda\",\"centerAverage\":\"2a2a2a\",\"suggestedBgColor\":\"888482\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-dddzn-mxjr3\",\"title\":\"Westwell Winery, Early Booking - Ashford, Kent - Friday 8th December 7pm, food and more from 5pm\",\"body\":null,\"excerpt\":\"<p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">INSIDE WESTWELL WINERY CELLARDOOR BAR AND PRESSING ROOM</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Rebel Reel Cine Club at Westwell Winery, Kent present an evening to celebrate:</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\"><strong>It\\u2019s A Wonderful Life</strong></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">James Stewart is searing brilliant (and not at all saccharine or schmalzy in one of the ultimate Christmas films \\u2026 well, he\\u2019s kind of welling-up inducing \\u2026)</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">It unflinchingly shows Stewart\\u2019s kindly local banker George brought low by a cruel world \\u2026 it\\u2019s an emotional rollercoaster with laughs and tears \\u2026 friendship and love matter more than money and it\\u2019s the perfect pre-Christmas watch to all come together to watch.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Galia at Westwell\\u2019s favourite film and my mum\\u2019s favourite (who\\u2019ll be watching just like Clarence \\u2026)</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">For another great but different \\u2018angel in overcoat\\u2019 film see Wim Wenders Wings of Desire.</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Early Booking now open - only \\u00A312.50</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">From 6pm, screening at 7pm</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">FAQs</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Is the screening inside or outside: INSIDE</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Should I bring my own chair? We\\u2019ve got benches - you\\u2019re welcome to bring your own chairs those</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">What drinks will there be? Mulled wine, wine (Westwell of course) by the bottle and glass, beers and soft drinks</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">What food is there? Westwell </p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Are there loos? Yes, inside the shed bar!</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Is there parking? Yep - loads</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">What\\u2019s the address/postcode? <span style=\\\"color: rgb(32, 33, 36)\\\"><strong><em>The Vyneyarde, Westwell Ln, Charing TN27 0BW</em></strong></span></p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Westwell Winery is 10 minutes taxi/ car ride from Ashford (35 mins from Kings Cross St Pancras)</p><p class=\\\"sqsrte-large\\\" style=\\\"white-space:pre-wrap;\\\">Ashford Taxis - 01233 888888</p><p class=\\\"\\\" style=\\\"white-space:pre-wrap;\\\">Express Cars - 01784 4211111</p><p class=\\\"\\\" data-rte-preserve-empty=\\\"true\\\" style=\\\"white-space:pre-wrap;\\\"></p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-dddzn-mxjr3\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1699440947362-NMCO7PV03PXYGV758WLR/IT%2527S%2BA%2BWONDERFUL%2BLIFE%2BAT%2BWESTWELL.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"eb0a733e-1c76-4424-b678-f93918da52ed\",\"sku\":\"WONDERFUL\",\"price\":1500,\"salePrice\":1250,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"15.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"12.50\"},\"onSale\":true,\"unlimited\":false,\"qtyInStock\":0,\"width\"