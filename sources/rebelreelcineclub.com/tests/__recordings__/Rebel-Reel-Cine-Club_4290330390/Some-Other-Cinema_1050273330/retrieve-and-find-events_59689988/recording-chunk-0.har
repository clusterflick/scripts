n\":{\"productAddOns\":[]},\"mightHavePaymentPlan\":false,\"items\":[{\"id\":\"698d06b0ea7b683116d427b4\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1770849968255,\"updatedOn\":1775141920118,\"displayIndex\":0,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"698d04a8d435ff039ba3f2cb\",\"systemDataId\":\"3ba472af-d9ef-4223-bab7-90918d79ab32\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Phantom of the paradise-5.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"313131\",\"topRightAverage\":\"a0a0a1\",\"bottomLeftAverage\":\"000000\",\"bottomRightAverage\":\"321d1d\",\"centerAverage\":\"a1a4b7\",\"suggestedBgColor\":\"695e60\"},\"title\":\"Phantom of the paradise-5.jpg\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/3ba472af-d9ef-4223-bab7-90918d79ab32/Phantom+of+the+paradise-5.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"698d04a8d435ff039ba3f2d1\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1625218232438,\"updatedOn\":1629368098364,\"displayIndex\":1,\"workflowState\":1,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"698d04a8d435ff039ba3f2cb\",\"systemDataId\":\"1625218236175-ZLZXMTQZE6VX8C169CFW\",\"systemDataVariants\":\"2500x1875,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"DungenessPowerStation.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"6486a0\",\"topRightAverage\":\"5c7892\",\"bottomLeftAverage\":\"1e1e18\",\"bottomRightAverage\":\"171a17\",\"centerAverage\":\"645a52\",\"suggestedBgColor\":\"5f819c\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1625218236175-ZLZXMTQZE6VX8C169CFW/DungenessPowerStation.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2500x1875\",\"recordTypeLabel\":\"image\"},{\"id\":\"698d04a8d435ff039ba3f2d4\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1625218075573,\"updatedOn\":1629368098358,\"displayIndex\":2,\"workflowState\":1,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"698d04a8d435ff039ba3f2cb\",\"systemDataId\":\"1625218085422-VRWKJ9L43A61VGPOORQY\",\"systemDataVariants\":\"2500x3333,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPG\",\"filename\":\"ProspectCottage.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"5482b5\",\"topRightAverage\":\"5279ac\",\"bottomLeftAverage\":\"8b7058\",\"bottomRightAverage\":\"987d60\",\"centerAverage\":\"9d886d\",\"suggestedBgColor\":\"507db0\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/1625218085422-VRWKJ9L43A61VGPOORQY/ProspectCottage.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"2500x3333\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"69bd02ce33b7493784ce2b1e\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1788180522106,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\",\"Marianne Faithfull\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1773995523270,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"5400532b-2db4-4e4c-8446-a83b4c59b654\",\"systemDataVariants\":\"1080x1080\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"BROKEN ENGLISH.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"020202\",\"topRightAverage\":\"020202\",\"bottomLeftAverage\":\"010101\",\"bottomRightAverage\":\"020202\",\"centerAverage\":\"686868\",\"suggestedBgColor\":\"5b5451\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-ryyya-s5rd4-ckl8p-snhar-cw94n\",\"title\":\"Broken English - Marianne Faithfull - Friday 10 April 2026 6.30pm - QT Club at Middle Eight Screening Room\",\"body\":null,\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Why Broken English?</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Iain Forsyth and Jane Pollard are artists<span> who have regularly collaborated with musicians (such as Nick Cave, Scott Walker and Marianne Faithfull) and were co-curators of the blockbuster exhibition The Horror Show at Somerset House in 2022\\u20133. </span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>Broken English is a documentary set inside a fictionalised framework. It\\u2019s re-ignited my interest in Marianne Faithfull and her amazing body of work directly addressing the dismal of her as a girlfriend/ sex object \\u2026 Her work as an actress, musician (writing and recording 18 Studio Albums) she was an absolute Rebel and steely force of nature quietly wrapped up in a gentle but super cool exterior.</span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>There are moments with the 78 year old Marianne watching herself when young or singing are super tender and moving.</span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>After, we shall dance </span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Doors 6.30pm</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJ 6.30pm to 7.30pm</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">FIlm 7.30pm Introduction with Chris McGill (Rebel Reel Cine Club)</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">7.45pm: Broken English</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">DJ Martin Green before and after the film until Midnight </p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Broken English </strong><br />Dir. Iain Forsyth and Jane Pollard<br />2025 1hr 36mins<br />Marianne Faithfull, Tilda Swinton, George McKay, Nick Cave, Warren Ellis </p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">QT at Middle Eight is a screening room is a luxurious space under the hotel at 69 Great Queen Street directly across from the site of the original Blitz Club.  Between Covent Garden and Holborn in <strong>WC2B</strong></p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-ryyya-s5rd4-ckl8p-snhar-cw94n\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/5400532b-2db4-4e4c-8446-a83b4c59b654/BROKEN+ENGLISH.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"