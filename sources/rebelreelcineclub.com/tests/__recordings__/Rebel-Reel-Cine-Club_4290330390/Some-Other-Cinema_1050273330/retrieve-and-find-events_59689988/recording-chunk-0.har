diaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"050505\",\"topRightAverage\":\"020202\",\"bottomLeftAverage\":\"1d1d1d\",\"bottomRightAverage\":\"161616\",\"centerAverage\":\"505050\",\"suggestedBgColor\":\"383838\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/f1caeff9-7529-43fb-832f-cd3a470a7147/RRCC+Alfa+Cinema.jpg\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"image\"},{\"id\":\"68e5f841531a534c88ca95f3\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210922,\"updatedOn\":1741883210922,\"displayIndex\":2,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"68e5f841531a534c88ca95eb\",\"systemDataId\":\"61c679a9-10bc-49cf-b285-4c02adbb499f\",\"systemDataVariants\":\"5760x3840,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Cinema - 1.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"0c0a0d\",\"topRightAverage\":\"0d0d15\",\"bottomLeftAverage\":\"2f2f45\",\"bottomRightAverage\":\"1c1923\",\"centerAverage\":\"212228\",\"suggestedBgColor\":\"302e42\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/61c679a9-10bc-49cf-b285-4c02adbb499f/Cinema+-+1.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"5760x3840\",\"recordTypeLabel\":\"image\"},{\"id\":\"68e5f841531a534c88ca95f6\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":2,\"addedOn\":1741883210917,\"updatedOn\":1741883210917,\"displayIndex\":3,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"parentId\":\"68e5f841531a534c88ca95eb\",\"systemDataId\":\"42bcb234-6759-4551-94fb-b4982e957714\",\"systemDataVariants\":\"5760x3840,100w,300w,500w,750w,1000w,1500w,2500w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"Cinema - 2.JPG\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"100c13\",\"topRightAverage\":\"0f0d11\",\"bottomLeftAverage\":\"282731\",\"bottomRightAverage\":\"353248\",\"centerAverage\":\"403647\",\"suggestedBgColor\":\"363147\"},\"title\":\"\",\"body\":null,\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"fullUrl\":\"/bookhere/null\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/42bcb234-6759-4551-94fb-b4982e957714/Cinema+-+2.JPG\",\"contentType\":\"image/jpeg\",\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"5760x3840\",\"recordTypeLabel\":\"image\"}],\"pushedServices\":{},\"pendingPushedServices\":{},\"originalSize\":\"1080x1080\",\"recordTypeLabel\":\"store-item\"},{\"id\":\"68da2fc39c32362908ea33d2\",\"collectionId\":\"604e95de63949d1dc619f0de\",\"recordType\":11,\"addedOn\":1632383201443,\"updatedOn\":1788087116401,\"displayIndex\":0,\"starred\":false,\"passthrough\":false,\"tags\":[\"Subculture Screenings\"],\"categoryIds\":[\"604e95de63949d1dc619f0f4\"],\"workflowState\":1,\"publishOn\":1759131179701,\"authorId\":\"5f3bff9c2865d009ade5e427\",\"systemDataId\":\"0e4b9d64-11e1-4f40-adf3-a9aeb530cf92\",\"systemDataVariants\":\"1080x1080,100w,300w,500w,750w,1000w\",\"systemDataSourceType\":\"JPEG\",\"filename\":\"1.jpg\",\"mediaFocalPoint\":{\"x\":0.5,\"y\":0.5,\"source\":3},\"colorData\":{\"topLeftAverage\":\"424242\",\"topRightAverage\":\"414040\",\"bottomLeftAverage\":\"30271f\",\"bottomRightAverage\":\"202020\",\"centerAverage\":\"949287\",\"suggestedBgColor\":\"4e4941\"},\"urlId\":\"droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-25slm\",\"title\":\"SATURDAY NIGHT FEVER - Mon 13 Oct 2025 7pm -The Old Ivy House\",\"body\":null,\"excerpt\":\"<p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>Under-rated? Darker than you remember? Way deeper and more like social commentary than a celebration of flammable flared polyester nonsense? </span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><span>NO POLYESTER FLARES PERMITTED AT REBEL REEL CINE CLUB\\u2026 think more Serpico, Dog Day Afternoon, Raging Bull and Chinatown \\u2026</span><br /><br /><span>\\u2018Tribal Rites of the New Saturday Night\\u2019 \\u2026 or Saturday Night Fever to give it it\\u2019s film title \\u2026</span><br /><br /><span>Saturday Night Fever wasn\\u2019t based on the discos of Brooklyn and Manhattan \\u2013 Nik Cohen may have fibbed about that \\u2026 but his short story, which went on to be adapted by Serpico screenwriter Norman Wexler, is a great dark social commentary with insanely great Cossack moves \\u2026 (in fairness to Nik Cohen he did write his novel I Am Still the Greatest</span><br /><span>says Johnny Angelo which David Bowie ripped off for Ziggy Stardust so a little bit of forgiveness for gilding the rayon lily may be due\\u2026)</span><br /><br /><span>SNF is so dark \\u2026 death, rape, social mobility or lack of it \\u2026 broken dreams and heartbreak (and not in a rom-com way \\u2026)\\u2026</span><br /><span>It also has great clothes albeit the man-made fibre-count is as high as the Brooklyn Bridge \\u2026 sorry Bobby \\u2026</span><br /><br /><span>The opening credits (The Warriors/ The Joker/ The French Connection\\u2026 so many NYC films have similar references\\u2026)</span><br /><br /><span>The Soundtrack too \\u2026 the Bee Gees stuff is actually brilliant \\u2026 AND there\\u2019s David Shire\\u2019s version of Night On Bald Mountain (Mussorgsky\\u2019s ode to the witches dance of spirits on Bald Mountain BUT DISCO \\u2026)\\u2026</span><br /><br /><span>Yes, it revived Disco (oops \\u2026) and it was actually born out Cohen\\u2019s remembrance of a Mod in Shepherd\\u2019s Bush and a gang member from Derry \\u2026</span><br /><br /><span>Whatever \\u2026 the opening sequence is just brilliant and John Travolta was never better \\u2026 \\u201CWould ya just watch the hair. Ya know, I work on my hair a long time and you hit it. He hits my hair!\\u201D.</span></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">7pm: DOORS - DJ Vadim Kosmos</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">7.30pm: Introduction with Vadim Kosmos and Chris McGill (Rebel Reel Cine Club)</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">9.35pm DJ until Midnight</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Saturday Night Fever</strong><br />Dir. John Badham 1977 <br />1hr 59mins.</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">CINE STYLE 2025<br />Presented by Rebel Reel Cine Club with Vadim Kosmos</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>All Is Joy Soho, &nbsp;75 Dean St, London W1D 3PU&nbsp;</strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Tuesday 14 October 7pm<br />Withnail and I</strong> Dir. Bruce Robinson 1987 1hr 47 mins<br />DJ Martin Green and Vadim Kosmos</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\"><strong>Wednesday 15 October 7pm<br /><span>The Eyes of Laura Mars</span></strong> Dir. Irving Kershner 1978 1hr 44 mins<strong><span><br />DJ Sonia Shadid (Hot Pants Nights)</span></strong></p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Friday 17 October 7pm <br /><strong><span>Querelle </span></strong>Dir. Rainer Fassbender 1982 1hr 47 mins<br />DJ before and after</p><p style=\\\"white-space:pre-wrap;\\\" data-rte-preserve-empty=\\\"true\\\">Sunday 19 October 4pm<br /><strong><span>Fallen Angels</span></strong> Dir. Wong Kar Wei 1995 1hr 33 mins<br />Before and after</p>\",\"likeCount\":0,\"commentCount\":0,\"publicCommentCount\":0,\"commentState\":1,\"unsaved\":false,\"fullUrl\":\"/bookhere/p/droog-7w73f-hg8bp-y7rkt-3gjsk-f6pe8-352bw-3nstx-g5pwl-5gk3k-wbbrf-zfdft-m3sgj-bzw8t-p574z-cx7wt-sl3pk-25slm\",\"assetUrl\":\"https://images.squarespace-cdn.com/content/v1/5f3c03f8f64d4e0519d38d26/0e4b9d64-11e1-4f40-adf3-a9aeb530cf92/1.jpg\",\"contentType\":\"image/jpeg\",\"structuredContent\":{\"_type\":\"StoreItem\",\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"0da1520b-b7d7-40b5-935a-61c5e97009ac\",\"sku\":\"SNF\",\"price\":1250,\"salePrice\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"12.50\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"unlimited\":false,\"qtyInStock\":0,\"width\":0.0,\"height\":0.0,\"weight\":0.0,\"imageIds\":[],\"images\":[],\"len\":0.0}],\"variantOptionOrdering\":[\"Ticket Only\"],\"isSubscribable\":false,\"fulfilledExternally\":false,\"productAddOnsConfiguration\":{\"productAddOns\":[]},\"mightHavePaymentPlan\":false},\"priceCents\":0,\"salePriceCents\":0,\"priceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"salePriceMoney\":{\"currency\":\"GBP\",\"value\":\"0.00\"},\"onSale\":false,\"productType\":3,\"customAddButtonText\":\"Add to Cart\",\"useCustomAddButtonText\":false,\"variants\":[{\"attributes\":{\"Ticket Only\":\"\"},\"optionValues\":[{\"optionName\":\"Ticket Only\",\"value\":\"\"}],\"id\":\"0da1520b-b7d7-40b5-935a-61c5e97009ac\",\"sku\