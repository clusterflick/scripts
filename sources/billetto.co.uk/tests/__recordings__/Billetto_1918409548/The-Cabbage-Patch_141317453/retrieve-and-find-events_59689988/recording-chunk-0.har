026ar=16%3A9\\\\u0026crop=faces\\\\u0026s=4d41107d83361bb7ab3e41c9b3dfce95\\\"],\\\"name\\\":\\\"History on Film: La Haine (1995)\\\",\\\"url\\\":\\\"https://billetto.co.uk/e/history-on-film-la-haine-1995-tickets-1768609\\\"}\",\"total_organizer_revenue\":\"0.0\",\"premium\":false,\"eqs_score\":39.14,\"host_ids\":[5342150],\"_tags\":[],\"culture_pass_enabled\":false,\"_geoloc\":{\"lng\":-0.0351,\"lat\":51.475},\"objectID\":\"1768609\",\"_highlightResult\":{\"category\":{\"value\":\"film_media\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"subcategory\":{\"value\":\"film\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"type\":{\"value\":\"screening\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"name\":{\"value\":\"History on Film: La Haine (1995)\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"description\":{\"value\":\"FREE ENTRY, booking is essential. Join us for a 30 th anniversary screening of La Haine , a powerful tale of young people processing and navigating the aftermath of an uprising in Paris’ outskirts, les banlieues , their home and their very futures. Visually stunning, La Haine was both critically acclaimed upon its release in 1995 film, winning a French film academy award for Best Film, and Kassowitz a win as Best Director at Cannes, and a cult classic, considered a masterful exploration of class, social tension and racism in contemporary France. Whether for a first viewing, or another rewatch, this is a rare opportunity to see La Haine (1995) on the big screen, and consider its messages and impact thirty years on. As usual, we'll follow the screening with a post-film discussion. Come for the film, stay for the conversation. All welcome! Don’t miss out on a night where history and art intersect.\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"brand\":{\"value\":\"Black @ Gold : Goldsmiths Black History\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"city\":{\"value\":\"London\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"location_slug\":{\"value\":\"london\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"venue_name\":{\"value\":\"Richard Hoggart Building, Goldsmiths\",\"matchLevel\":\"none\",\"matchedWords\":[]}}},{\"id\":2039782,\"kind\":\"regular\",\"category\":\"film_media\",\"subcategory\":\"film\",\"type\":\"screening\",\"currency\":\"GBP\",\"state\":\"published\",\"venue_type\":null,\"organization_id\":58,\"billetto_score\":null,\"name\":\"'The Holdovers' (2023) (15)\",\"name_truncated\":\"'The Holdovers' (2023) (15)\",\"description\":\"Set in a New England private school just before the Christmas break, director Alexander Payne's award-winning feature is a bitter-sweet drama with an outstanding cast. Described as a 'new festive classic' for its depiction of wintry city scapes and great storytelling, this film mixes humour with poignant performances. A disgruntled teacher (Paul Giamatti) is forced to stay on campus over Christmas to supervise a small group of \\\"holdover\\\" students who have nowhere to go. He ends up stuck with a troubled, grieving 15-year-old student (Dominic Sessa) and the school's head cook (Da'Vine Joy Randolph, who won an Oscar for the role), whose son recently died in the Vietnam War. Expect a warm 'mulled' welcome at the. 1907 at the Cabbage Patch, with festive vibes, even in early December.\",\"price\":9.4,\"price_range\":\"9 GBP\",\"image\":\"https://billetto.imgix.net/go3upelc11pl43i413cuzxz169du?w=640&h=360&fit=crop&auto=compress%2Cformat&rect=0%2C32%2C1050%2C591&s=cec0f2f57496d688ff8c1a60b8cc5f98\",\"uses_generic_billetto_image\":false,\"keywords\":[],\"organizer_id\":1504735,\"organizer_image\":\"https://billetto.imgix.net/1okpbbi3ox2vab0f1e3q6x1ha5u4?s=76ec3fc01723c649d27968ecb0629df8\",\"url\":\"https://billetto.co.uk/e/the-holdovers-2023-15-tickets-2039782\",\"brand\":\"twickenham cinema club\",\"stock\":36,\"on_sale\":true,\"total_clicks\":59,\"starts_at\":\"Dec 01 2026 19:00\",\"ends_at\":\"Dec 01 2026 21:00\",\"hide_end_date\":false,\"country\":\"United Kingdo