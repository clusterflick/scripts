,\"_geoloc\":{\"lng\":-0.3299,\"lat\":51.4488},\"objectID\":\"2039782\",\"_highlightResult\":{\"category\":{\"value\":\"film_media\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"subcategory\":{\"value\":\"film\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"type\":{\"value\":\"screening\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"name\":{\"value\":\"'The Holdovers' (2023) (15)\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"description\":{\"value\":\"Set in a New England private school just before the Christmas break, director Alexander Payne's award-winning feature is a bitter-sweet drama with an outstanding cast. Described as a 'new festive classic' for its depiction of wintry city scapes and great storytelling, this film mixes humour with poignant performances. A disgruntled teacher (Paul Giamatti) is forced to stay on campus over Christmas to supervise a small group of \\\"holdover\\\" students who have nowhere to go. He ends up stuck with a troubled, grieving 15-year-old student (Dominic Sessa) and the school's head cook (Da'Vine Joy Randolph, who won an Oscar for the role), whose son recently died in the Vietnam War. Expect a warm 'mulled' welcome at the. 1907 at the Cabbage Patch, with festive vibes, even in early December.\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"brand\":{\"value\":\"twickenham cinema club\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"city\":{\"value\":\"Twickenham\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"venue_name\":{\"value\":\"The Cabbage Patch\",\"matchLevel\":\"none\",\"matchedWords\":[]}}}],\"nbHits\":4,\"page\":0,\"nbPages\":1,\"hitsPerPage\":1000,\"exhaustiveNbHits\":true,\"exhaustive\":{\"nbHits\":true},\"query\":\"\",\"params\":\"filters=organization_id%3A58+AND+%28type%3Ascreening+OR+subcategory%3Afilm%29+AND+NOT+kind%3Asubscription&hitsPerPage=1000&page=0\",\"queryID\":\"9b6b814b683a491b656193f91e135262\",\"_automaticInsights\":true,\"processingTimeMS\":1,\"processingTimingsMS\":{\"_request\":{\"round