ject\\\"},\\\"location\\\":{\\\"@type\\\":\\\"Place\\\",\\\"address\\\":{\\\"@type\\\":\\\"PostalAddress\\\",\\\"addressCountry\\\":\\\"United Kingdom\\\",\\\"addressLocality\\\":\\\"London\\\",\\\"addressRegion\\\":\\\"Inner London — East\\\",\\\"postalCode\\\":\\\"SE1 8TY\\\",\\\"streetAddress\\\":\\\"London SE1 8TY\\\"},\\\"name\\\":\\\"St John’s Church, Waterloo\\\",\\\"geo\\\":{\\\"@type\\\":\\\"GeoCoordinates\\\",\\\"latitude\\\":51.5045,\\\"longitude\\\":-0.112}},\\\"identifier\\\":\\\"2048027\\\",\\\"offers\\\":[{\\\"@type\\\":\\\"Offer\\\",\\\"availability\\\":\\\"http://schema.org/InStock\\\",\\\"price\\\":\\\"0.0\\\",\\\"name\\\":\\\"General\\\",\\\"priceCurrency\\\":\\\"GBP\\\",\\\"validFrom\\\":\\\"2026-11-09T11:23:53+00:00\\\",\\\"url\\\":\\\"https://billetto.co.uk/e/the-killing-of-awdah-hathaleen-film-screening-and-conversation-with-aziz-hathaleen-tickets-2048027\\\"}],\\\"description\\\":\\\"Join the Britain Palestine Project for a public screening of Palestinian human rights organisation Al-Haq’s investigative film The Killing of Awdah Hathaleen: Beyond a Settler Crime , followed by a conversation with Awdah’s brothe...\\\",\\\"startDate\\\":\\\"2026-11-17T18:00:00+00:00\\\",\\\"image\\\":[\\\"https://billetto.imgix.net/19buhzpa39j6xs71uw8zmrfdvio8?w=640\\\\u0026h=360\\\\u0026fit=crop\\\\u0026auto=compress%2Cformat\\\\u0026rect=0%2C50%2C960%2C540\\\\u0026ar=1%3A1\\\\u0026crop=faces\\\\u0026s=745589282bbe226a1cb18375f185fdeb\\\",\\\"https://billetto.imgix.net/19buhzpa39j6xs71uw8zmrfdvio8?w=640\\\\u0026h=360\\\\u0026fit=crop\\\\u0026auto=compress%2Cformat\\\\u0026rect=0%2C50%2C960%2C540\\\\u0026ar=4%3A3\\\\u0026crop=faces\\\\u0026s=107aa8d91e5d8d5767230a296b38757e\\\",\\\"https://billetto.imgix.net/19buhzpa39j6xs71uw8zmrfdvio8?w=640\\\\u0026h=360\\\\u0026fit=crop\\\\u0026auto=compress%2Cformat\\\\u0026rect=0%2C50%2C960%2C540\\\\u0026ar=16%3A9\\\\u0026crop=faces\\\\u0026s=56c9a90449a173e076bd6a46895e4d33\\\"],\\\"name\\\":\\\"The Killing of Awdah Hathaleen | Film screening and conversation with Aziz Hathaleen\\\",\\\"url\\\":\\\"https://billetto.co.uk/e/the-killing-of-awdah-hathaleen-film-screening-and-conversation-with-aziz-hathaleen-tickets-2048027\\\"}\",\"total_organizer_revenue\":\"21112.0\",\"premium\":false,\"eqs_score\":33.43,\"host_ids\":[4427429],\"_tags\":[],\"culture_pass_enabled\":false,\"_geoloc\":{\"lng\":-0.112,\"lat\":51.5045},\"objectID\":\"2048027\",\"_highlightResult\":{\"category\":{\"value\":\"charity\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"subcategory\":{\"value\":\"international_aid\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"type\":{\"value\":\"screening\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"name\":{\"value\":\"The Killing of Awdah Hathaleen | Film screening and conversation with Aziz Hathaleen\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"description\":{\"value\":\"Join the Britain Palestine Project for a public screening of Palestinian human rights organisation Al-Haq’s investigative film The Killing of Awdah Hathaleen: Beyond a Settler Crime , followed by a conversation with Awdah’s brother, Aziz Hathaleen and Zainah Haroun from Al-Haq. Awdah was a Palestinian teacher, father of three and human rights defender who contributed to the Oscar-winning documentary No Other Land . On 28 July 2025, he was shot and killed while filming a settler attack in his village of Umm al-Kheir, in Masafer Yatta in the occupied West Bank. Using video footage and a reconstruction of the scene, Al-Haq’s film examines the circumstances of Awdah’s killing and places it in the wider context of settler violence in the West Bank. After the screening, we’ll hear from Aziz about his brother and what life is like for the community of Umm al-Kheir today. Tickets are free and everyone is welcome. Please reserve your place through Billetto. Guests will be invited to make an optional donation on the night to support the community of Umm al-Kheir.\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"brand\":{\"value\":\"Britain Palestine Project\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"city\":{\"value\":\"London\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"location_slug\":{\"value\":\"london\",\"matchLevel\":\"none\",\"matchedWords\":[]},\"venue_name\":{\"value\":\"St John’s Church, Waterloo\",\"matchLevel\":\"none\",\"matchedWords\":[]}}},{\"id\":1768609,\"kind\":\"scheduled\",\"category\":\"film_media\",\"subcategory\":\"film\",\"type\":\"screening\",\"currency\":\"GBP\",\"state\":\"published\",\"venue_type\":null,\"organization_id\":58,\"billetto_score\":null,\"name\":\"History on Film: La Haine (1995)\",\"name_truncated\":\"History on Film: La Haine (1995)\",\"description\":\"FREE ENTRY, booking is essential. Join us for a 30 th anniversary screening of La Haine , a powerful tale of young people processing and navigating the aftermath of an uprising in Paris’ outskirts, les banlieues , their home and their very futures. Visually stunning, La Haine was both critically acclaimed upon its release in 1995 film, winning a French film academy award for Best Film, and Kassowitz a win as Best Director at Cannes, and a cult classic, considered a masterful exploration of class, social tension and racism in contemporary France. Whether for a first viewing, or another rewatch, this is a rare opportunity to see La Haine (1995) on the big screen, and consider its messages and impact thirty years on. As usual, we'll follow the screening with a post-film discussion. Come for the film, stay for the conversation. All welcome! Don’t miss out on a night where history and art intersect.\",\"price\":0.0,\"price_range\":\"Free\",\"image\":\"https://billetto.imgix.net/twimdzz9fc2kwtfclce5bup0qmqt?w=640&h=360&fit=crop&auto=compress%2Cformat&rect=0%2C39%2C2060%2C1159&s=0e5a8ea54fbf8ef2dfee81ceab82f1a3\",\"uses_generic_billetto_image\":false,\"keywords\":[],\"organizer_id\":5342150,\"organizer_image\":\"https://billetto.imgix.net/o6br5uqs1om4sk6ud4ifh2xp90xe?s=434767ee