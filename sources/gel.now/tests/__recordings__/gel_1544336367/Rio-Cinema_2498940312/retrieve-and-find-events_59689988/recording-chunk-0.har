:\"\",\"country\":\"\",\"postcode\":\"EC2A 3AY\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":49,\"name\":\"Britannia Row\",\"address\":\"35 Britannia Row\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"N1 8QH\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":50,\"name\":\"Britannia Row Studios\",\"address\":\"35 Britannia Row\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N1 8QH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":true,\"accessibility_notes\":\"\"},{\"id\":225,\"name\":\"Broadway Bookshop\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":63,\"name\":\"Brookhouse Football Club\",\"address\":\"Kingshill Avenue\",\"city\":\"Hayes\",\"country\":\"\",\"postcode\":\"UB4 8DD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":13,\"name\":\"Bureau of Silly Ideas\",\"address\":\"18 Valentia Place\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SW9 8PJ\",\"capacity\":0,\"description\":\"We’re a leading UK outdoor arts not-for-profit, using playful creativity to spark real-world change. From robots in the streets to surprise cabarets, our work gets people smiling, thinking, and talking — the perfect ingredients for starting positive conversations about complex issues.\\n\\nWorking out of railway arches in Brixton we are custodians of one of London’s last dirty making \\u0026 performing spaces.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":223,\"name\":\"Burley Fisher Books\",\"address\":\"400 Kingsland Road\",\"city\":\"\",\"country\":\"\",\"postcode\":\"E8 4AA\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":10,\"name\":\"Cafe Oto\",\"address\":\"18-22 Ashwin St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\" E8 3DL\",\"capacity\":0,\"description\":\"Cafe OTO provides a home for creative new music that exists outside of the mainstream with an evening programme of adventurous live music seven nights a week.\\n\\nThe concert programme at Cafe OTO is managed by OTOProjects – a not-for-profit Community Interest Company (CIC).\\n\\nWe are also open as a cafe during the day, serving a range of pastries and snacks and sellings books, records, tapes and CDs.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":161,\"name\":\"Catford Rhum Arrange\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":199,\"name\":\"Cellar\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":54,\"name\":\"Chats Palace\",\"address\":\"42–44 Brooksby’s Walk\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E9 6DF\",\"capacity\":0,\"description\":\"Chats Palace is a home for radical creativity and collective action. Since 1976, we’ve stood at the heart of our East London community—rooted in working-class culture and driven by the belief that art and education are powerful tools for social change. From our Grade II-listed building, once Homerton Library and gifted to the people by Andrew Carnegie ‘for the betterment of East Londoners,’ we continue a proud legacy of protest, performance, and public dialogue. We champion those who are marginalised, excluded, or silenced—offering a bold, welcoming space where community voices are heard, injustice is challenged, and imagination fuels transformation.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":129,\"name\":\"Chestnuts Community Centre\",\"address\":\"280 St Ann's Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N15 5BN\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":207,\"name\":\"Chisenhale Dance Space\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":181,\"name\":\"Climax London\",\"address\":\"8a Herbal Hill\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"EC1R 5EJ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":53,\"name\":\"Close-Up Cinema\",\"address\":\"97 Sclater Street\",\"city\":\"Lopndon\",\"postcode\":\"E1 6HR\",\"capacity\":0,\"description\":\"Close-Up makes film culture and history accessible through its cinema programmes and Library. Established in 2005, Close-Up is the most comprehensive independent film resource in London.\\n\\nClose-Up's film programmes present a series of films that shaped the art of cinema and its history including regular special events with filmmakers present to discuss their work. Close-Up is committed to supporting and developing the exhibition of independent and experimental cinema, focusing on the cross over between the arts and film culture.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":21,\"name\":\"Club Cheek\",\"address\":\"302-304 Barrington Rd\",\"city\":\"London\",\"postcode\":\"SW9 7JJ\",\"capacity\":0,\"description\":\"Independent DIY nightclub \\u0026 music venue\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":113,\"name\":\"Club Silly\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":159,\"name\":\"Conway Hall\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":214,\"name\":\"Coven Hq\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":236,\"name\":\"Create Destroy Studios, Islington - 161 Marlborough Road #Floor 3 London N16 4NF\",\"address\":\"\",\"capacity\":0,\"on_listings_site\