ent_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":770,\"name\":\"First Release (Party Entry)\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":50,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":true,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":785,\"name\":\"Artwork Print (Sponsor Ticket)\",\"description\":\"Sponsor ticket includes A4 art print. \\nPick up from venue available only.\",\"price\":30,\"currency\":\"GBP\",\"quantity_available\":60,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":44,\"name\":\"art\"},{\"id\":49,\"name\":\"film\"},{\"id\":54,\"name\":\"rave\"},{\"id\":128,\"name\":\"exhibition\"},{\"id\":213,\"name\":\"East London\"},{\"id\":218,\"name\":\"art exhibition\"},{\"id\":229,\"name\":\"South Asia\"},{\"id\":230,\"name\":\"experimental, left field, sound art, performance\"},{\"id\":258,\"name\":\"South Asian music\"},{\"id\":261,\"name\":\"experimental music\"},{\"id\":382,\"name\":\"Bengali\"},{\"id\":406,\"name\":\"Bengali music\"},{\"id\":407,\"name\":\"Asian music\"},{\"id\":516,\"name\":\"film screening\"},{\"id\":552,\"name\":\"clubnight\"}]},{\"id\":766,\"name\":\"HAKEEM (+ Q\\u0026A and Acoustic Set)\",\"start_time\":\"2026-09-19T18:30:00Z\",\"end_time\":\"2026-09-19T23:00:00Z\",\"poster\":\"2e75f1c70b49ea91f8ea5e006985a807.webp\",\"background\":\"\",\"description\":\"Doc’n Roll is delighted to be part of The Music is Black Festival from East Bank and to bring a special event to the Rio Cinema celebrating one of London’s most distinctive contemporary musicians, Hak Baker. \\n\\nThe evening will include a special screening of Hakeem, live Q\\u0026A, and an intimate acoustic performance by Hak Baker, offering audiences a unique opportunity to hear directly from Hak about his journey, creative process, and the experiences that have shaped his career. \\n\\nHak’s story is one of resilience, creativity, and community, making him an inspiring figure for a new generation of artists and music fans alike. \\n\\nSynopsis \\nAn unconventional music documentary for a very unconventional musician, this film follows British singer and rapper Hak Baker over five years. Directed by the filmmaking duo of DEADHORSES (James Topley and Ivo Beckett), Hakeem balances profundity and profanity as Baker confronts the traumas of class and masculinity in the wake of his sudden stardom. An anarchic yet sincere portrait of British lad culture, full of arresting aesthetics and savage honesty, this is more than a chronicle of a musician's life – it’s a fascinating and intimate portrait of existential angst, brotherhood and hope in the face of the taboos that surround male mental health.\\n\\nThe Music is Black Festival from East Bank at Queen Elizabeth Olympic Park is a celebration of Black British music across a full programme of events including four live festival weekends. Led by the artists, creators and collectives who built its legacy and shape what’s next, this is where sound lives and culture moves.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://riocinema.org.uk/Rio.dll/WhatsOn?f=2652932\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"},{\"id\":5,\"name\":\"film\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1969,\"artist_name\":\"Hakeem\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":37,\"name\":\"Rio Cinema\",\"address\":\"107 Kingsland High Street\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":717,\"name\":\"free movements ~ equinox \",\"start_time\":\"2026-09-20T14:00:00Z\",\"end_time\":\"2026-09-20T23:00:00Z\",\"poster\":\"b19d41161a33a1868076374fcd17b20b.webp\",\"background\":\"\",\"description\":\"more info soon \\u003c3\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":2,\"name\":\"gig\"},{\"id\":5,\"name\":\"film\"},{\"id\":8,\"name\":\"poetry\"},{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":21,\"name\":\"Club Cheek\",\"address\":\"302-304 Barrington Rd\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":57,\"name\":\"Free Movements\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":627,\"name\":\"Supporter\",\"price\":25,\"currency\":\"GBP\",\"quantity_available\":100,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":628,\"name\":\"Concession \",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":1,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":629,\"name\":\"Regular\",\"price\":20,\"currency\":\"GBP\",\"quantity_available\":150,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":890,\"name\":\"Everybody to Kenmure Street - Community Screening with Lewisham Anti Raids\",\"start_time\":\"2026-09-21T18:30:00Z\",\"end_time\":\"2026-09-21T21:26:00Z\",\"poster\":\"22a11b48a4885b45675a09396fdfd67c.webp\",\"background\":\"\",\"description\":\"In May 2021, a UK Home Office dawn raid triggers one of the most spontaneous and successful acts of civil resistance in recent memory. In Pollokshields, Scotland’s most diverse neighbourhood, hundreds of residents rush to the streets to stop the deportation of their neighbours. In today’s increasingly far-right political environment of immigration raids, deportation flights and border violence, Everybody to Kenmure Street is an empowering reminder of the importance of collective action.\\n\\n \\n\\nThe screening will be followed by a casual chat with Lewisham Anti Raids @lewisham_anti_raids on the organising they do in the area, and how you can get involved.\\n\\n \\n\\nAll are welcome, no matter your organising experience! The film is rated 12A.\\n\\n \\n\\nPay What You Can tickets are available from £1-8. This event is part of a series of community screenings around London with local anti raids groups, organised by april forrest lin 林森. All ticket revenue will be donated to Lewisham Anti Raids after event costs have been covered.\\n\\n \\n\\n18:30 - Doors open\\n\\n19:00 - Film screening\\n\\n20:45 - Chat with Lewisham Anti Raids\\n\\n21:00 - Chat ends, space stays open\\n\\n21:30 - Event ends\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://www.outsavvy.com/event/38278/everybody-to-kenmure-street-community-screening-with-lewisham-anti-raids\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":5,\"name\":\"film\"},{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":36,\"name\":\"Piehouse Co-Op\",\"address\":\"213-214 Edward Place\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":155,\"name\":\"screening\"},{\"id\":195,\"name\":\"migrant rights\"},{\"id\":222,\"name\":\"community\"},{\"id\":623,\"name\":\"anti-raids\"},{\"id\":624,\"name\":\"collective action\"}]}],\"total_count\":8,\"limit\":100,\"offset\":0}",
