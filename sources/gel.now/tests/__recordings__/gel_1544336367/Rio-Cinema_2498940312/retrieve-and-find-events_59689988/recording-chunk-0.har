:false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":81,\"name\":\"Algha's Plantroom\",\"address\":\"Smeed Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E3 2NR\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":180,\"name\":\"Arch 535\",\"address\":\"Orphans Yard, Brixton Station Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SW9 8QB\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":119,\"name\":\"Art Hub Studios\",\"address\":\"Stanley Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE8 4BL\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":131,\"name\":\"AUTM Haus\",\"address\":\"Unit 3A, 39 Autumn St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E3 2TT\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":130,\"name\":\"Autm Haus\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":33,\"name\":\"Auto Italia\",\"address\":\"44 Bonner Road\",\"city\":\"London\",\"postcode\":\"E2 9JS\",\"capacity\":0,\"description\":\"Auto Italia is a non-profit visual arts institution dedicated to researching, producing and exhibiting work on the intersections of queer studies and social change.\\n\\nOur programme supports artists to develop critical discourse, active research and experimental projects through major commissions and process driven participation projects. This work is presented through exhibitions, performance and live work, international touring projects and creative learning activities for young people.\\n\\nLearning and research underpins all of our activities. We provide a unique context for artists and audiences to explore expanded ideas of community, identity and belonging, and play a sector leadership role in an international network of organisations foregrounding new approaches to artist-led institution building.\\n\\nAuto Italia is situated in the heart of a diverse residential neighbourhood in the London Borough of Tower Hamlets. We are active in facilitating local networks and partnerships that create new ways for audiences to engage with art, and which support children and young people to take active and empowered roles investigating contemporary issues on identity.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":99,\"name\":\"autumn three\",\"address\":\"Unit 3, 39 Autumn Street, Bow\",\"city\":\"London\",\"country\":\"UK\",\"postcode\":\"E3 2TT\",\"capacity\":150,\"description\":\": a place for you, me + tea : ~ an ambient in-between space ✨\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"follow the shipping containers\"},{\"id\":18,\"name\":\"Avalon Cafe\",\"address\":\"Unit D, Industrial Estate, Juno Way\",\"city\":\"London\",\"postcode\":\"SE14 5RW\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":fal