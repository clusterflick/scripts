se,\"lift_access\":false},{\"id\":196,\"name\":\"FOLD\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":197,\"name\":\"FOLD Steam Room\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":182,\"name\":\"Folklore Hoxton\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":59,\"name\":\"FormaHQ\",\"address\":\"140 Great Dover Street\",\"city\":\"London\",\"postcode\":\"SE1 4GW\",\"capacity\":0,\"description\":\"Forma is a contemporary arts organisation based in Southwark, London. Driven by artists and their ideas, we develop collaborative interdisciplinary projects that challenge existing practices, span multiple artistic disciplines and demand new levels of ambition.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":91,\"name\":\"Forno\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":24,\"name\":\"Fox and Firkin\",\"address\":\"316 Lewisham High St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE13 6JZ\",\"capacity\":0,\"description\":\"Fox and Firkin is Lewisham's favourite boozer for live music, DJs, and dancing. From legendary sound system parties to DJ takeovers in South Londons biggest pub garden, you can expect everything from Dub, Electro, House, Broken Beat, Jungle, Dembow and beyond.\",\"on_listings_site\":false,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":11,\"name\":\"Gaffe\",\"address\":\"1 Anthony Way\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N18 3QT\",\"capacity\":400,\"description\":\"a new home for the heads.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":216,\"name\":\"Glengall Wharf Garden\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":35,\"name\":\"Gohub Studios\",\"address\":\"222 Brixton Road\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"SW9 6AH\",\"capacity\":0,\"description\":\"GOHUB STUDIO  is a place for London’s creatives to work, connect and thrive. It is a workspace, studio, and hub for creative workshops. Located on a corner marking the entrance to Brixton, GoHub is a home for a community with a warm and inviting energy. Poetry nights, talks, dances, workshops and more butt up against one another, filling the space with an irresistible spirit of connection and dedication.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":160,\"name\":\"Goldsmiths CCA\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":134,\"name\":\"Green Alley Studios\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":68,