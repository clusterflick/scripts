\",\"postcode\":\"N16 7UU\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":121,\"name\":\"Triangle LGBTQ+ Cultural Centre\",\"address\":\"34 Watsons Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE8 4AU\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":198,\"name\":\"Two Tribes Campfire\",\"address\":\"Tileyard Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N7 9AH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":52,\"name\":\"TWO-PLUS-TWO\",\"address\":\"276 Oak Square (off Stockwell Green)\",\"city\":\"London\",\"postcode\":\"SW9 9AW\",\"capacity\":0,\"description\":\"TWO-PLUS-TWO is an artist-led project space in Stockwell, south west London, in the entrance foyer of Acme Glassyard Studios. Dedicated to connecting artists and curators, TWO-PLUS-TWO’s ethos is to create an engaging, experimental and diverse exhibition programme that positions itself firmly in the space between studio and gallery.   \",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":27,\"name\":\"Unit 58\",\"address\":\"Unit 58, Millmead Industrial Estate, Mill Mead Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N17 9QU\",\"capacity\":320,\"description\":\"Warehouse space and arts hub near Tottenham Hale station with 320 capacity.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":84,\"name\":\"Venue MOT\",\"address\":\"Orion Business Centre, Surrey Canal Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE14 5RT\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":20,\"name\":\"Vespers\",\"address\":\"133A Rye Lane\",\"city\":\"London\",\"postcode\":\"SE15 4BQ\",\"capacity\":0,\"description\":\"VESPERS club Peckham, \\n\\nAt the edge of day, we gather.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":126,\"name\":\"Vortex Jazz Club\",\"address\":\"11 Gillett Square\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 8AZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":69,\"name\":\"Walthamstow Trades Hall\",\"address\":\"61-63 Tower Hamlets Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E17 4RQ\",\"capacity\":0,\"description\":\"Walthamstow Trades Hall \\u0026 Institute is a members’ club, which has proudly stood in its current location for 100 years. There are two bars and a meeting room and it holds regular events, all of which are open to the public. Membership too, is open to all adults for an annual fee.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":74,\"name\":\"Wards Corner Community Space\",\"address\":\"Seven Sisters Market, 245-253 High Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N15 5BT\",\"capacity\":0,\"description\":\"Born from 20 years of community engagement and campaigning, the Wards Corner Community Benefit Society (CBS), made up of local residents, workers and market traders, aims to manage the building once restored.\\n\\nCurrently, we are managing  the Seven Sisters Market community space and supporting the success of the historic traders, who have all returned!\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":209,\"name\":\"Whitechapel Gallery\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":89,\"name\":\"Windmill Brixton\",\"address\":\" 22 Blenheim Gardens, Brixton Hill\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SW2 5BZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":153,\"name\":\"Worlding\",\"address\":\"65-69 County Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE1 4AD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":152,\"name\":\"Worlding\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false}]",
