.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"2w9uob\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,731],&quot;name&quot;:[0,&quot;Discus Music Residency March 2027 - HI RES HEART&quot;],&quot;start_time&quot;:[0,&quot;2027-03-21T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2027-03-21T22:00:00Z&quot;],&quot;poster&quot;:[0,&quot;6430a3e5d75c60319297da2dbd32acdc.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;The Discus Music residency at the Horse Hospital, Colonnade WC1N 1JD takes place on the third Sunday of each month throughout 2027, and rotates between three artists on the label:  Hi Res Heart, Right Here Right Now and The Martin Pyne Ensemble. The venue is fully seated.\\n\\nSUNDAY 21st MARCH 2027 – DOORS 7.30 PM\\nHI RES HEART\\nMartin Archer – saxophones\\nCharlotte Keeffe – trumpet\\nGraham Clark – violin\\nMichael Bardon – double bass\\nMartin Pyne – drums, vibraphone\\nMelanie Little – dance\\n\\nHi Res Heart is an improvising group where spaciousness and fire co-exist. Even when the music is at its most abstract, the spirit of the blues is never too far away. The music is often direct and melodic in an open ended flow which reacts to the moment, while the unusual percussion set up of drum set, hand percussion and vibraphone provides an ever changing textural and rhythmic counterpoint. For this performance we are joined, as we are whenever space and budget permit, by the creative dance of Melanie Little.\\n\\n\\&quot;This is resolutely experimental jazz inventiveness, with room left for each musician&#39;s creativity.\\&quot; - Guy Stuckens RADIO AIR LIBRE\\n\\n\\&quot;There are too many highlights to mention. It may have its roots in the music of 70s Chicago, but it’s superfluous to know this: Hi Res Heart transcend them to create a music of their own that is very much of the 2020s. I could listen to this music all day.\\&quot; - Dominic Rivron, INTERNATIONAL TIMES\\n\\n\\&quot;Will have all your senses on full alert.\\&quot; - PAULA MCADAM\\n\\n\\&quot;Superb examples of what the group can do without charts in front of them. Fans of free jazz and free improvisation will find plenty to get excited about.\\&quot; - Peter Thelen, EXPOSÉ\\n\\n\\&quot;Wild, florid and fantastic in its scope; a must for all those seeking adventure.\\&quot; - Mr Olivetti, FREQ\\n\\n\\&quot;Seven meticulously crafted plays, each as captivating as the last, each with its own unique character.\\&quot; - Marie Mesmer, HIGHLANDS\\n\\n+ SUPPORT\\n\\nDiscus Music: discusmusic.bandcamp.com / discus-music.org\\n\\nWe are a large Sheffield based independent label for creative music with over 200 CD/DL releases, curated by Martin Archer. As well as the residency group leaders Martin Archer, Charlotte Keeffe and Martin Pyne, artists on the label include Keith Tippett, Julie Tippetts, Paul Dunmall, Cecil Taylor, Tony Oxley, Pat Thomas, Laura Cole, Let Spin, Das Rad, Orchestra Of The Upper Atmosphere, Uroboro, Stephen Grew, Guy Segers, Corey Mwamba, Robert Mitchell, Alya Al-Sultani, Inclusion Principle, Johnny Hunter, Mick Beck, Billy Marrows, Jan Todd / frostlake, Faith Brackenbury, Tony Bianco, The Exu, Faradena Afifi, Steve Beresford, Paul Khimasia Morgan, Laura Jurd, Keir Cooper, Ron Caines, Matthew Bourne, Chris Sharkey, Carla Diratz, Theo May, Paul Taylor, This Celestial Engine, Fjall, Walt Shaw, Steve Tromans, Rachel Musson, Mark Sanders, James Mainwaring, Ricard Scott, Army Of Briars, Nick Robonson, Michael Bardon, Bo Meson, Juxtavoices, Alex Ward and many more.\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,331],&quot;name&quot;:[0,&quot;Discus Music&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1Tne7pGr4LHt6OdK&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,306],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,649],&quot;name&quot;:[0,&quot;Standard&quot;],&quot;description&quot;:[0,&quot;Standard general admission.&quot;],&quot;price&quot;:[0,12.5],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,0],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,650],&quot;name&quot;:[0,&quot;Supporter&quot;],&quot;description&quot;:[0,&quot;A voluntary higher price for those who wish to show additional support for this concert series .&quot;],&quot;price&quot;:[0,15],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,0],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,651],&quot;name&quot;:[0,&quot;Concession&quot;],&quot;description&quot;:[0,&quot;Special price for unwaged attendees.&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,0],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,1322],&quot;url&quot;:[0,&quot;https://hiresheart.org/&quot;],&quot;display_title&quot;:[0,&quot;Band website&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-07-22T19:51:42.973512Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-07-22T19:51:42.973512Z&quot;]}],[0,{&quot;id&quot;:[0,1323],&quot;url&quot;:[0,&quot;https://discusmusic.bandcamp.com/&quot;],&quot;display_title&quot;:[0,&quot;Discus Music Bandcamp&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-07-22T19:51:42.973512Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-07-22T19:51:42.973512Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,102],&quot;name&quot;:[0,&quot;improvisation&quot;]}],[0,{&quot;id&quot;:[0,495],&quot;name&quot;:[0,&quot;#dance&quot;]}],[0,{&quot;id&quot;:[0,513],&quot;name&quot;:[0,&quot;free jazz&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">The Discus Music residency at the Horse Hospital, Colonnade WC1N 1JD takes place on the third Sunday of each month throughout 2027, and rotates between three artists on the label:  Hi Res Heart, Right Here Right Now and The Martin Pyne Ensemble. The venue is fully seated.<br /><br />SUNDAY 21st MARCH 2027 – DOORS 7.30 PM<br />HI RES HEART<br />Martin Archer – saxophones<br />Charlotte Keeffe – trumpet<br />Graham Clark – violin<br />Michael Bardon – double bass<br />Martin Pyne – drums, vibraphone<br />Melanie Little – dance<br /><br />Hi Res Heart is an improvising group where spaciousness and fire co-exist. Even when the music is at its most abstract, the spirit of the blues is never too far away. The music is often direct and melodic in an open ended flow which reacts to the moment, while the unusual percussion set up of drum set, hand percussion and vibraphone provides an ever changing textural and rhythmic counterpoint. For this performance we are joined, as we are whenever space and budget permit, by the creative dance of Melanie Little.<br /><br />\"This is resolutely experimental jazz inventiveness, with room left for each musician's creativity.\" - Guy Stuckens RADIO AIR LIBRE<br /><br />\"There are too many highlights to mention. It may have its roots in the music of 70s Chicago, but it’s superfluous to know this: Hi Res Heart transcend them to create a music of their own that is very much of the 2020s. I could listen to this music all day.\" - Dominic Rivron, INTERNATIONAL TIMES<br /><br />\"Will have all your senses on full alert.\" - PAULA MCADAM<br /><br />\"Superb examples of what the group can do without charts in front of them. Fans of free jazz and free improvisation will find plenty to get excited about.\" - Peter Thelen, EXPOSÉ<br /><br />\"Wild, florid and fantastic in its scope; a must for all those seeking adventure.\" - Mr Olivetti, FREQ<br /><br />\"Seven meticulously crafted plays, each as captivating as the last, each with its own unique character.\" - Marie Mesmer, HIGHLANDS<br /><br />+ SUPPORT<br /><br />Discus Music: discusmusic.bandcamp.com / discus-music.org<br /><br />We are a large Sheffield based independent label for creative music with over 200 CD/DL releases, curated by Martin Archer. As well as the residency group leaders Martin Archer, Charlotte Keeffe and Martin Pyne, artists on the label include Keith Tippett, Julie Tippetts, Paul Dunmall, Cecil Taylor, Tony Oxley, Pat Thomas, Laura Cole, Let Spin, Das Rad, Orchestra Of The Upper Atmosphere, Uroboro, Stephen Grew, Guy Segers, Corey Mwamba, Robert Mitchell, Alya Al-Sultani, Inclusion Principle, Johnny Hunter, Mick Beck, Billy Marrows, Jan Todd / frostlake, Faith Brackenbury, Tony Bianco, The Exu, Faradena Afifi, Steve Beresford, Paul Khimasia Morgan, Laura Jurd, Keir Cooper, Ron Caines, Matthew Bourne, Chris Sharkey, Carla Diratz, Theo May, Paul Taylor, This Celestial Engine, Fjall, Walt Shaw, Steve Tromans, Rachel Musson, Mark Sanders, James Mainwaring, Ricard Scott, Army Of Briars, Nick Robonson, Michael Bardon, Bo Meson, Juxtavoices, Alex Ward and many more.<br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/331\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Discus Music </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://hiresheart.org/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Band website </a><a href=\"https://discusmusic.bandcamp.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Discus Music Bandcamp </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin:bottom right\"><button class=\"\n            w-15 h-15 sm:w-16 sm:h-16\n            rounded-full\n            shadow-2xl\n            backdrop-blur-md\n            flex items-center justify-center\n            transition-all duration-200\n            hover:scale-110\n            focus:outline-none focus:ring-2 focus:ring-btn-primary focus:ring-offset-2\n          \" style=\"background-color:#f0f0f0;border:2px solid #2b2b2b20\" aria-label=\"Theme selector\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b2b2b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-7 h-7 sm:w-8 sm:h-8\" aria-hidden=\"true\"><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"#2b2b2b\"></circle><path d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z\"></path></svg></button></div><!--astro:end--></astro-island> <script>(function(){const apiUrl = \"https://api.gel.now\";\n\n      (function () {\n        var endpoint = apiUrl + \"/api/track\";\n        var queue = [];\n        var FLUSH_INTERVAL = 5000;\n        var MAX_BATCH = 20;\n\n        function normalizePath(path) {\n          return path.replace(/\\/\\d+/g, \"/:id\");\n        }\n\n        function queueEvent(evt) {\n          queue.push(evt);\n          if (queue.length >= MAX_BATCH) flush();\n        }\n\n        function flush() {\n          if (queue.length === 0) return;\n          var batch = queue.splice(0, MAX_BATCH);\n          var body = JSON.stringify({ events: batch });\n          if (navigator.sendBeacon) {\n            navigator.sendBeacon(\n              endpoint,\n              new Blob([body], { type: \"application/json\" }),\n            );\n          } else {\n            fetch(endpoint, {\n              method: \"POST\",\n              body: body,\n              keepalive: true,\n              headers: { \"Content-Type\": \"application/json\" },\n            });\n          }\n        }\n\n        var COOKIE_NAME = \"gel_dv\";\n        var today = new Date().toISOString().slice(0, 10);\n        var isNewDailyVisitor = true;\n        var cookies = document.cookie.split(\";\");\n        for (var i = 0; i < cookies.length; i++) {\n          var c = cookies[i].trim();\n          if (c.indexOf(COOKIE_NAME + \"=\") === 0) {\n            if (c.substring(COOKIE_NAME.length + 1) === today) {\n              isNewDailyVisitor = false;\n            }\n            break;\n          }\n        }\n        if (isNewDailyVisitor) {\n          var expires = new Date(Date.now() + 86400000).toUTCString();\n          document.cookie =\n            COOKIE_NAME +\n            \"=\" +\n            today +\n            \"; path=/; expires=\" +\n            expires +\n            \"; SameSite=Lax\";\n        }\n\n        queueEvent({\n          type: \"pageview\",\n          page: normalizePath(window.location.pathname),\n          screen_width: window.screen.width,\n          referrer: document.referrer || \"\",\n          is_new_daily_visitor: isNewDailyVisitor,\n        });\n\n        setInterval(flush, FLUSH_INTERVAL);\n\n        document.addEventListener(\"visibilitychange\", function () {\n          if (document.visibilityState === \"hidden\") flush();\n        });\n\n        window.__trackEvent = function (category, action) {\n          queueEvent({ type: \"event\", category: category, action: action });\n        };\n      })();\n    })();</script> </body> </html>",
