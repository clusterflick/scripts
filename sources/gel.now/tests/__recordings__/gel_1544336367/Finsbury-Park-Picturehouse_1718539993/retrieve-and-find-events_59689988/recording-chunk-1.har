ength + 1) === today) {\n              isNewDailyVisitor = false;\n            }\n            break;\n          }\n        }\n        if (isNewDailyVisitor) {\n          var expires = new Date(Date.now() + 86400000).toUTCString();\n          document.cookie =\n            COOKIE_NAME +\n            \"=\" +\n            today +\n            \"; path=/; expires=\" +\n            expires +\n            \"; SameSite=Lax\";\n        }\n\n        queueEvent({\n          type: \"pageview\",\n          page: normalizePath(window.location.pathname),\n          screen_width: window.screen.width,\n          referrer: document.referrer || \"\",\n          is_new_daily_visitor: isNewDailyVisitor,\n        });\n\n        setInterval(flush, FLUSH_INTERVAL);\n\n        document.addEventListener(\"visibilitychange\", function () {\n          if (document.visibilityState === \"hidden\") flush();\n        });\n\n        window.__trackEvent = function (category, action) {\n          queueEvent({ type: \"event\", category: category, action: action });\n        };\n      })();\n    })();</script> </body> </html>",
