renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Zi8TXm\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,857],&quot;name&quot;:[0,&quot;Valeria Pacific solo showcase: A Door to Experimentation&quot;],&quot;start_time&quot;:[0,&quot;2026-08-14T19:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-14T22:00:00Z&quot;],&quot;poster&quot;:[0,&quot;d22546cd9056b714aaf4dd912a246f0b.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Join us for Valeria Pacific’s Residency Showcase, marking the culmination of her journey as the first artist in Studio 12’s Residency Programme: A Door to Experimentation.\\n\\nAfter two weeks of research, experimentation and creative development, Valeria will present her first solo live performance, offering an insight into the ideas, sounds and discoveries that have emerged throughout her residency.\\n\\nAbout Valeria: Valeria Pacific is a drummer, DJ, community organiser and cultural producer. She is the director and lead drummer of Akolá Tambo, and co-founder and director of Bullerengue Circle. Her work has played a key role in giving visibility to bullerengue in the UK and Europe.\\n_____\\nDiscover the exciting programme we&#39;ve curated throughout the residency, featuring workshops, performances and opportunities to engage with the artists as they develop new work.\\nA Door to Experimentation brings together three emerging artists who are expanding their practice from traditional folk music into experimental, collaborative and cross-disciplinary music-making. Throughout the residency, they are mentored by Patricia Doors, exploring new approaches to sound, performance and creative exchange.\\n\\nThis residency has been made possible with the generous support of Arts Council England, CASA, Movimientos, and the Anglo Chilean Society. \\n\\nProgramme Development &amp; Partnership: Nora Laraki\\n\\n\\n____________\\n\\n\\nMuestra de Residencia de Valeria Pacific\\n\\nAcompáñanos en la Muestra de Residencia de Valeria Pacific, que marca la culminación de su recorrido como la primera artista del programa de residencias de Studio 12: A Door to Experimentation.\\n\\nTras dos semanas de investigación, experimentación y desarrollo creativo, Valeria presentará su primer concierto en solitario, compartiendo con el público una mirada a las ideas, sonidos y descubrimientos que han surgido a lo largo de su residencia.\\nSobre Valeria\\n\\nValeria Pacific es baterista, DJ, organizadora comunitaria y productora cultural. Es directora y baterista principal de Akolá Tambo, y cofundadora y directora de Bullerengue Circle. A través de su trabajo, ha desempeñado un papel fundamental en la difusión y visibilización del bullerengue en el Reino Unido y Europa.\\n\\nDescubre el emocionante programa que hemos creado a lo largo de la residencia, con talleres, presentaciones y oportunidades para conectar con los artistas mientras desarrollan y experimentan con nuevas obras.\\n\\nA Door to Experimentation reúne a tres artistas emergentes que están expandiendo sus prácticas más allá de la música folclórica tradicional hacia formas de creación musical experimentales, colaborativas e interdisciplinarias. A lo largo de la residencia, los artistas cuentan con la mentoría de Patricia Doors, explorando nuevos enfoques del sonido, la interpretación y el intercambio creativo.\\n\\nEsta residencia ha sido posible gracias al generoso apoyo de Arts Council England, CASA, Movimientos y la Anglo Chilean Society.\\n\\nDesarrollo del programa y alianzas: Nora Laraki\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,false],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,true],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,138],&quot;name&quot;:[0,&quot;Studio 12&quot;],&quot;address&quot;:[0,&quot;Studio 12, 1 Addington Square&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;SE5 7JZ&quot;],&quot;capacity&quot;:[0,0],&quot;description&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,216],&quot;name&quot;:[0,&quot;Studio 12&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TYqHHGxrRpNa8w2&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,186],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,760],&quot;name&quot;:[0,&quot;RSVP HERE&quot;],&quot;price&quot;:[0,0],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,60],&quot;quantity_sold&quot;:[0,7],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,165],&quot;name&quot;:[0,&quot;live music&quot;]}],[0,{&quot;id&quot;:[0,261],&quot;name&quot;:[0,&quot;experimental music&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Join us for Valeria Pacific’s Residency Showcase, marking the culmination of her journey as the first artist in Studio 12’s Residency Programme: A Door to Experimentation.<br /><br />After two weeks of research, experimentation and creative development, Valeria will present her first solo live performance, offering an insight into the ideas, sounds and discoveries that have emerged throughout her residency.<br /><br />About Valeria: Valeria Pacific is a drummer, DJ, community organiser and cultural producer. She is the director and lead drummer of Akolá Tambo, and co-founder and director of Bullerengue Circle. Her work has played a key role in giving visibility to bullerengue in the UK and Europe.<br />_____<br />Discover the exciting programme we've curated throughout the residency, featuring workshops, performances and opportunities to engage with the artists as they develop new work.<br />A Door to Experimentation brings together three emerging artists who are expanding their practice from traditional folk music into experimental, collaborative and cross-disciplinary music-making. Throughout the residency, they are mentored by Patricia Doors, exploring new approaches to sound, performance and creative exchange.<br /><br />This residency has been made possible with the generous support of Arts Council England, CASA, Movimientos, and the Anglo Chilean Society. <br /><br />Programme Development & Partnership: Nora Laraki<br /><br /><br />____________<br /><br /><br />Muestra de Residencia de Valeria Pacific<br /><br />Acompáñanos en la Muestra de Residencia de Valeria Pacific, que marca la culminación de su recorrido como la primera artista del programa de residencias de Studio 12: A Door to Experimentation.<br /><br />Tras dos semanas de investigación, experimentación y desarrollo creativo, Valeria presentará su primer concierto en solitario, compartiendo con el público una mirada a las ideas, sonidos y descubrimientos que han surgido a lo largo de su residencia.<br />Sobre Valeria<br /><br />Valeria Pacific es baterista, DJ, organizadora comunitaria y productora cultural. Es directora y baterista principal de Akolá Tambo, y cofundadora y directora de Bullerengue Circle. A través de su trabajo, ha desempeñado un papel fundamental en la difusión y visibilización del bullerengue en el Reino Unido y Europa.<br /><br />Descubre el emocionante programa que hemos creado a lo largo de la residencia, con talleres, presentaciones y oportunidades para conectar con los artistas mientras desarrollan y experimentan con nuevas obras.<br /><br />A Door to Experimentation reúne a tres artistas emergentes que están expandiendo sus prácticas más allá de la música folclórica tradicional hacia formas de creación musical experimentales, colaborativas e interdisciplinarias. A lo largo de la residencia, los artistas cuentan con la mentoría de Patricia Doors, explorando nuevos enfoques del sonido, la interpretación y el intercambio creativo.<br /><br />Esta residencia ha sido posible gracias al generoso apoyo de Arts Council England, CASA, Movimientos y la Anglo Chilean Society.<br /><br />Desarrollo del programa y alianzas: Nora Laraki<br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/216\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Studio 12 </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script