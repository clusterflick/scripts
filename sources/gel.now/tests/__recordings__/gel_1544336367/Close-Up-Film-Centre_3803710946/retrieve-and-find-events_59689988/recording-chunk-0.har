onent-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Z2prhHk\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,697],&quot;name&quot;:[0,&quot;Barzakh برزخ - Fundraiser for Lebanon&quot;],&quot;start_time&quot;:[0,&quot;2026-08-15T18:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-16T02:00:00Z&quot;],&quot;poster&quot;:[0,&quot;55694822047f5e2c94bfdd7c46a96aad.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Barzakh برزخ - Fundraiser for Lebanon: an evening of music and artist solidarity\\n\\nBarzakh is a café-library and cultural space in Hamra, one of Beirut&#39;s most loved neighbourhoods - and a place where many people displaced from southern Lebanon and Beirut&#39;s southern suburbs have recently taken refuge. \\n\\nWhen the war on Lebanon escalated at the end of September 2024, Barzakh transformed into a community kitchen, and its work remains as vital as ever amid the ongoing Israeli bombardment and occupation. Barzakh&#39;s small team works around the clock to distribute around 2,000 hot meals a day to people who have fled their homes, alongside other urgent community needs like medicine and cash support. Running the kitchen costs up to $1,000 a day.\\n\\nJoin us on 15 August at Jam in a Jar, Harringay, for a summer evening of artistic and musical solidarity, raising money to help Barzakh continue this crucial work.\\n\\nExpect:\\n\\n--- Art workshop and games led by Bosla Arts, a platform sharing the work and stories of artists worldwide facing grave challenges to their artistic freedom of expression.\\n\\n--- Live music by Bassel Hariri, a Syrian violinist from Aleppo who has dedicated his music career to exploring different avenues of expressing the sound of the Arab violin.\\n\\n--- Lebanese songs by Sura, a singer-songwriter originally from Lebanon and now based in London, whose music is shaped by both places. After training in opera in Lebanon, she found herself returning to Arabic music after moving to the UK. Her songs draw on the sounds she grew up with, exploring love, nostalgia and belonging.\\n\\n--- DJ set by Riwa, a poet, theatre-maker, sound designer, and puppeteer working in both creative and backstage capacities. Her art puts people and our relationships at the centre of the political narratives we inhabit, with recent explorations including the unpacking of generational baggage and the politics of pop princesses.\\n\\n--- Music from around the world on cassette, chosen by Sha3by Chic of London DJ collective Koshari.\\n\\n--- More TBC!&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}],[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,201],&quot;name&quot;:[0,&quot;Jam in a Jar&quot;],&quot;address&quot;:[0,&quot;599-601 Green Lanes&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;N8 0RE&quot;],&quot;capacity&quot;:[0,0],&quot;description&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,333],&quot;name&quot;:[0,&quot;Lizzy Galliver&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1To8rqK3qYH75AKN&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,308],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,583],&quot;name&quot;:[0,&quot;General&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,90],&quot;quantity_sold&quot;:[0,68],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,584],&quot;name&quot;:[0,&quot;Solidarity&quot;],&quot;price&quot;:[0,15],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,90],&quot;quantity_sold&quot;:[0,24],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,585],&quot;name&quot;:[0,&quot;Pay what you can&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,20],&quot;quantity_sold&quot;:[0,20],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,true],&quot;min_price&quot;:[0,5],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,1149],&quot;url&quot;:[0,&quot;https://jaminajarbar.co.uk&quot;],&quot;display_title&quot;:[0,&quot;Jam in a Jar&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-07-07T22:22:35.094868Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-07-07T22:22:35.094868Z&quot;]}],[0,{&quot;id&quot;:[0,1150],&quot;url&quot;:[0,&quot;https://www.instagram.com/brzkh.space/&quot;],&quot;display_title&quot;:[0,&quot;Barzakh&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-07-07T22:22:35.094868Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-07-07T22:22:35.094868Z&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Barzakh برزخ - Fundraiser for Lebanon: an evening of music and artist solidarity<br /><br />Barzakh is a café-library and cultural space in Hamra, one of Beirut's most loved neighbourhoods - and a place where many people displaced from southern Lebanon and Beirut's southern suburbs have recently taken refuge. <br /><br />When the war on Lebanon escalated at the end of September 2024, Barzakh transformed into a community kitchen, and its work remains as vital as ever amid the ongoing Israeli bombardment and occupation. Barzakh's small team works around the clock to distribute around 2,000 hot meals a day to people who have fled their homes, alongside other urgent community needs like medicine and cash support. Running the kitchen costs up to $1,000 a day.<br /><br />Join us on 15 August at Jam in a Jar, Harringay, for a summer evening of artistic and musical solidarity, raising money to help Barzakh continue this crucial work.<br /><br />Expect:<br /><br />--- Art workshop and games led by Bosla Arts, a platform sharing the work and stories of artists worldwide facing grave challenges to their artistic freedom of expression.<br /><br />--- Live music by Bassel Hariri, a Syrian violinist from Aleppo who has dedicated his music career to exploring different avenues of expressing the sound of the Arab violin.<br /><br />--- Lebanese songs by Sura, a singer-songwriter originally from Lebanon and now based in London, whose music is shaped by both places. After training in opera in Lebanon, she found herself returning to Arabic music after moving to the UK. Her songs draw on the sounds she grew up with, exploring love, nostalgia and belonging.<br /><br />--- DJ set by Riwa, a poet, theatre-maker, sound designer, and puppeteer working in both creative and backstage capacities. Her art puts people and our relationships at the centre of the political narratives we inhabit, with recent explorations including the unpacking of generational baggage and the politics of pop princesses.<br /><br />--- Music from around the world on cassette, chosen by Sha3by Chic of London DJ collective Koshari.<br /><br />--- More TBC!</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/333\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Lizzy Galliver </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://jaminajarbar.co.uk\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Jam in a Jar </a><a href=\"https://www.instagram.com/brzkh.space/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Barzakh </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData