s/poster/f812ca6be6b6bc0972979613d7cd2be5.webp\" alt=\"VENT ⓥ Valentina Magaletti &#38; YPY, Ben Vince\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">VENT ⓥ Valentina Magaletti &amp; YPY, Ben Vince</h1>  </div> <p class=\"text-surface-600 mb-4\"> Wednesday, September 2, 2026 · 7:30 PM – 10:30 PM </p> <div class=\"mb-6\"> <a href=\"/venues/84\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Venue MOT </a> <p class=\"text-sm text-surface-600\">Orion Business Centre, Surrey Canal Rd</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/106\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Ben Vince </a> <span> · </span> <a href=\"/artists/115\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Valentina Magaletti </a> <span> · </span> <a href=\"/artists/1959\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> YPY </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://ra.co/events/2474351\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Valentina Magaletti & YPY (the solo moniker of Japanese musician Koshiro Hino) form an acclaimed experimental, electroacoustic duo. Their collaborative project blends Magaletti's highly percussive, avant-garde drumming with YPY's metallic, handcrafted electronics and polyrhythmic structures, highlighted by their acclaimed LP Kansai Bruises<br /><br />Ben Vince is a striking composer and performer, known for his live improvised saxophone explorations and inventive techniques in creating new rhythms, textures and moods. Through live improvisation, sonic manipulation, reprocessing and looping, whether in the studio or on the stage, his spontaneous yet intuitive approach and collaborative nature surpasses the seeming limitations of his primary instrument.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/368\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> VENT </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchE