ncome tickets. \\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,7],&quot;name&quot;:[0,&quot;performance&quot;]}],[0,{&quot;id&quot;:[0,8],&quot;name&quot;:[0,&quot;poetry&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,193],&quot;name&quot;:[0,&quot;SECRET SOUTH EAST LONDON LOCATION&quot;],&quot;address&quot;:[0,&quot;&quot;],&quot;capacity&quot;:[0,0],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,303],&quot;name&quot;:[0,&quot;The Erogenous Zone&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TieLoGfs2LS9lUR&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,278],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,true],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,548],&quot;name&quot;:[0,&quot;to confess ur sins&quot;],&quot;d