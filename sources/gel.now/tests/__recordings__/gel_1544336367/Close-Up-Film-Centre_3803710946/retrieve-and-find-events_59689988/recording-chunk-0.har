stroke=\"#2b2b2b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-7 h-7 sm:w-8 sm:h-8\" aria-hidden=\"true\"><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"#2b2b2b\"></circle><path d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z\"></path></svg></button></div><!--astro:end--></astro-island> <script>(function(){const apiUrl = \"https://api.gel.now\";\n\n      (function () {\n        var endpoint = apiUrl + \"/api/track\";\n        var queue = [];\n        var FLUSH_INTERVAL = 5000;\n        var MAX_BATCH = 20;\n\n        function normalizePath(path) {\n          return path.replace(/\\/\\d+/g, \"/:id\");\n        }\n\n        function queueEvent(evt) {\n          queue.push(evt);\n          if (queue.length >= MAX_BATCH) flush();\n        }\n\n        function flush() {\n          if (queue.length === 0) return;\n          var batch = queue.splice(0, MAX_BATCH);\n          var body = JSON.stringify({ events: batch });\n          if (navigator.sendBeacon) {\n            navigator.sendBeacon(\n              endpoint,\n              new Blob([body], { type: \"application/json\" }),\n            );\n          } else {\n            fetch(endpoint, {\n              method: \"POST\",\n              body: body,\n              keepalive: true,\n              headers: { \"Content-Type\": \"application/json\" },\n            });\n          }\n        }\n\n        var COOKIE_NAME = \"gel_dv\";\n        var today = new Date().toISOString().slice(0, 10);\n        var isNewDailyVisitor = true;\n        var cookies = document.cookie.split(\";\");\n        for (var i = 0; i < cookies.leng