ible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,53],&quot;name&quot;:[0,&quot;Ormside Projects&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TtpXSGWO0xFUNv4&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,193],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,781],&quot;name&quot;:[0,&quot;3rd Release&quot;],&quot;price&quot;:[0,17.35],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,20],&quot;quantity_sold&quot;:[0,0],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,782],&quot;name&quot;:[0,&quot;Talk &amp; Club Ticket&quot;],&quot;price&quot;:[0,19.5],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,5],&quot;quantity_sold&quot;:[0,1],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">DJ Marcelle returns to Ormside on August 22nd. This time, marking her fourth annual visit to Ormside, we invite the notorious DJ and collector to join us for a live discussion in the space ahead of her extended club set. This offering presents the rare opportunity to hear Marcelle talk through her fascinating life and practice, guided by a handful of records from her colossal collection.<br /><br />Following the discussion, Marcelle’s customary 3 hour set is framed by sets from two masters of open-format selection: London-based Sinny and French-born Wheel of Fortune member Marylou.<br /><br />Now a household name in certain circles, DJ Marcelle’s work is evidence of a lifelong dedication to sonic detail. A champion of tracks that shouldn’t exist – hidden within the grooves of custom dubplates – her sets lead with curiosity, asserting a refreshing and open approach to dancefloor curation. As always, she must be seen to be believed.<br /><br />On closing duties, Marylou returns to Ormside for the first time this year. A Morphine Records associate and member of b4b supergroup Wheel of Fortune (CCL, Nonogigsta, rRoxymore), her psychedelic and multi-faceted DJ sets have earned her position as a deeply respected DJ and organiser on the international stage.<br /><br />sinny opens the night, supporting DJ Marcelle for the 3rd time at Ormside since the yearly event first began. Weaving together strands of historically and personally resonant musics that trace and collapse timelines, sinny’s sets are tactile, thoughtful and narrative held together with textured and immersive sonics.<br /><br />Limited tickets available for pre-show talk (40)<br /><br />Talk - DJ Marcelle in Conversation 21:00 - 23:00<br /><br />Club - 23:00 - 05:00<br /><br />Support from Carhartt WIP<br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/53\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Ormside Projects </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;v