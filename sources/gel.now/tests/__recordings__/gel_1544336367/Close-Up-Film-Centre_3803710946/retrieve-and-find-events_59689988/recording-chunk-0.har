se,\"lift_access\":false},{\"id\":196,\"name\":\"FOLD\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":197,\"name\":\"FOLD Steam Room\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":182,\"name\":\"Folklore Hoxton\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":59,\"name\":\"FormaHQ\",\"address\":\"140 Great Dover Street\",\"city\":\"London\",\"postcode\":\"SE1 4GW\",\"capacity\":0,\"description\":\"Forma is a contemporary arts organisation based in Southwark, London. Driven by artists and their ideas, we develop collaborative interdisciplinary projects that challenge existing practices, span multiple artistic disciplines and demand new levels of ambition.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":91,\"name\":\"Forno\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":24,\"name\":\"Fox and Firkin\",\"address\":\"316 Lewisham High St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE13 6JZ\",\"capacity\":0,\"description\":\"Fox and Firkin is Lewisham's favourite boozer for live music, DJs, and dancing. From legendary sound system parties to DJ takeovers in South Londons biggest pub garden, you can expect everything from Dub, Electro, House, Broken Beat, Jungle, Dembow and beyond.\",\"on_listings_site\":false,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":11,\"name\":\"Gaffe\",\"address\":\"1 Anthony Way\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N18 3QT\",\"capacity\":400,\"description\":\"a new home for the heads.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":216,\"name\":\"Glengall Wharf Garden\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":35,\"name\":\"Gohub Studios\",\"address\":\"222 Brixton Road\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"SW9 6AH\",\"capacity\":0,\"description\":\"GOHUB STUDIO  is a place for London’s creatives to work, connect and thrive. It is a workspace, studio, and hub for creative workshops. Located on a corner marking the entrance to Brixton, GoHub is a home for a community with a warm and inviting energy. Poetry nights, talks, dances, workshops and more butt up against one another, filling the space with an irresistible spirit of connection and dedication.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":160,\"name\":\"Goldsmiths CCA\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":134,\"name\":\"Green Alley Studios\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":68,\"name\":\"Hackney Bridge\",\"address\":\"Units 1-28, ECHO BUILDING, East Bay Lane\",\"city\":\"\",\"country\":\"\",\"postcode\":\"E15 2SJ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":227,\"name\":\"Hayes and Yeading FC\",\"address\":\"Beaconsfield Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"UB4 0SL\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":210,\"name\":\"Hayling Island\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":98,\"name\":\"Helen of Troy\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":173,\"name\":\"Helm, deptford\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":235,\"name\":\"Henry Plavidal\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":39,\"name\":\"Hibiscus Community Centre\",\"address\":\"Buckingham Road\",\"city\":\"London\",\"postcode\":\"E15 1SP\",\"capacity\":0,\"description\":\"Hibiscus Community Centre opened in 1994 in response to the lack of social and leisure facilities for African and Caribbean elders living in the London Borough of Newham. It is home of Hibiscus Caribbean Elderly Association (HCEA) a private company and registered charity which leased the building from the London Borough of Newham to deliver and develop its services. over the last twenty-five years a full range of services reflective of Caribbean culture have been developed and delivered locally and beyond.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":95,\"name\":\"Hillstation Cafe\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":14,\"name\":\"Hootananny\",\"address\":\"95 Effra Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SW2 1DF\",\"capacity\":0,\"description\":\"Legendary live music venue Hootananny Brixton, established in September 2007, has become a beloved cultural landmark, drawing music lovers from all over to its celebrated stage. Crowds attend to enjoy its celebrated array of music shows and club nights highlighting Jungle, Disco, Post-Punk, Reggae, Highlife, House, Electronic music and more.\\n\\nHootananny’s striking Victorian building exudes charm with its spacious beer garden, quirky interiors and welcoming atmosphere. Customers chill out in our second bar with two pool tables and love the delicious street food from our food stalls to complement the musical feast.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":75,\"name\":\"House of Annetta\",\"address\":\"25 Princelet Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E1 6QH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":76,\"name\":\"Housmans Bookshop\",\"address\":\"5 Caledonian Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N1 9DY\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":144,\"name\":\"Hoxton Cabin\",\"address\":\"132 Kingsland Road\",\"city\":\"\",\"country\":\"\",\"postcode\":\"E2 8DP\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":120,\"name\":\"Hundred Years Gallery\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":70,\"name\":\"HWK London\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":118,\"name\":\"Ibraaz\",\"address\":\"93 Mortimer Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"W1W 7SS\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":28,\"name\":\"Iklectik\",\"address\":\"Peckham Levels, 95a Rye Ln\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 4ST\",\"capacity\":0,\"description\":\"IKLECTIK, A RADICAL AND CROSS-DISCIPLINARY APPROACH TO CULTURE MAKING AND GATHERING.\\n\\nWe are a grassroots organisation dedicated to experimental sound, performance and embodied practices and accessible technologies.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":85,\"name\":\"Innervisions Alchemy\",\"address\":\"unit 1, ilderton wharf, rollins street\",\"city\":\"london\",\"country\":\"united kingdom\",\"postcode\":\"se15 1ep\",\"capacity\":100,\"description\":\"Wellness oasis in the heart of South Bermondsey - Exploring the authentic connections between music, ritual and collective healing.\\n\\nSauna, Cold plunge, Massage, Movement, Breathwork, Sound-healing, Medicine.\\n\\n \",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":true,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":213,\"name\":\"Institute of Contemporary Arts\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":115,\"name\":\"Islington Arts Club\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":201,\"name\":\"Jam in a Jar\",\"address\":\"599-601 Green Lanes\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N8 0RE\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":171,\"name\":\"James Graham\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":90,\"name\":\"JUMBI\",\"address\":\"Unit 4.1, Copeland Park  133 Copeland Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 3SN\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":230,\"name\":\"KINDRED\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":151,\"name\":\"Kunstraum\",\"address\":\"21 Roscoe St\",\"city\":\"\",\"country\":\"\",\"postcode\":\"EC1Y 8PT\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":132,\"name\":\"Lake\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":97,\"name\":\"Last Arch\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":56,\"name\":\"Lea Rowing Club\",\"address\":\"\",\"city\":\"London\",\"postcode\":\"E5 9BL\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":155,\"name\":\"Lewisham Art House\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":217,\"name\":\"Live at St Giles\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":202,\"name\":\"LOGMA\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":104,\"name\":\"London Performance Studios\",\"address\":\"Penarth Centre, Ormside Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 1TR\",\"capacity\":120,\"description\":\"London Performance Studios is a queer container for the research, generation, and promotion of artistic voices that meet in the space between the white cube of the gallery and the black box of the theatre. LPS seeks to queer artistic process, championing the politics of making a scene, whether on stage or out in the world.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":true,\"lift_access\":false,\"accessibility_notes\":\"The Penarth Centre does not currently have an operational lift, but we are fundraising to repair this. Many of our performances are held in Studio 1, which does not have step-free access (18 steps). Many of our performances, exhibitions and other events also take place in Studio 3, which is at street-level with step-free access. \\n\\nAll our toilets are gender-neutral. We have an accessible toilet located downstairs.\"},{\"id\":55,\"name\":\"Longfield Hall\",\"address\":\"50 Knatchbull Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE5 9QY\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":143,\"name\":\"Lordship Hub\",\"address\":\"Lordship Rec, Off Higham Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N17 6NU\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":232,\"name\":\"Lordship Recreation Ground\",\"address\":\"\",\"city\":\"\",\"country\":\"\",\"postcode\":\"N17 6NU\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":191,\"name\":\"Love Affair Basement\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":22,\"name\":\"Low Profile Studios\",\"address\":\"94 Vale Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N4 1PT\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":19,\"name\":\"M.O.T.\",\"address\":\"Orion Business Centre, Surrey Canal Rd\",\"city\":\"London\",\"postcode\":\"SE14 5RT\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":163,\"name\":\"magCulture Shop\",\"address\":\"270 St John Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"EC1V 4PE\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":105,\"name\":\"Mariin\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":103,\"name\":\"Martello Street\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":226,\"name\":\"Mascara Bar\",\"address\":\"72 Stamford Hill\",\"city\":\"\",\"country\":\"\",\"postcode\":\"N16 6XS\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":125,\"name\":\"May Day Rooms\",\"address\":\"88 Fleet Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"EC4Y 1DH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":109,\"name\":\"Metamorphika Studio\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":122,\"name\":\"Metroland Studios\",\"address\":\"91 Kilburn Square\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"NW6 6PS\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":108,\"name\":\"Mildmay Community Centre\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":88,\"name\":\"Mimosa House\",\"address\":\"47 Theobalds Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"WC1X 8SP\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":45,\"name\":\"Mosaic Rooms\",\"address\":\"226 Cromwell Road\",\"city\":\"London\",\"postcode\":\"SW5 0SW\",\"capacity\":0,\"description\":\"Founded in London in 2009 by the A.M. Qattan Foundation, Mosaic Rooms supports and amplifies contemporary culture from the Arab world and beyond. Now operating as an independent charity, Mosaic Rooms enters a new chapter, while remaining rooted in its founding values.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":149,\"name\":\"Nadmim\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":174,\"name\":\"Near Seven Sisters, North London\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE14 6AS\",\"capacity\":350,\"description\":\"We live and breathe music, putting on live shows 7 nights a week. Touring bands, local bands, festivals and party nights. We like to mix it up so the only criteria we have when we’re booking is that it sounds fantastic.\\n \\nIf you are interested in playing at the venue or promoting your own night please find out more about our submission process on the Contact page.\\n \\nFor those who want to know all the stats, please download our venue pack.\\n \\nNew Cross Inn is not just about gigs – we are also open daily for food (now serving pizzas including vegan option) and drink. Both the main bar and Stocks Bar downstairs are open nightly from 6pm, serving a wide range of ales, ciders, wines, cocktails and spirits.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"Here at New Cross Inn we are working with the organisation Attitude Is Everything, striving to improve the live music experience for all of our customers, encouraging accessibility and inclusion as well as equality.\\n\\nIf you have any access requirements or questions that are not answered below, please contact us.\\n\\nLevel access from the main entrance to the performance space and bar\\n \\nWe have an accessible toilet in the venue. This is kept locked to ensure it remains usable for customers that need it. Please ask at the bar if you require access.\\n \\nLowered section of the bar for wheelchair users.\\n \\nWe offer a personal assistant / companion ticket for any deaf or disabled customers who would not be able to attend an event here without one. Please contact us at time of booking and we happily arrange this for you.\\n \\nWe can set up a viewing area to the side of the stage on request. Please let us know if you’d like to make use of this when booking a ticket.\"},{\"id\":12,\"name\":\"New River Studios\",\"address\":\"199 Eade Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N4 1DN\",\"capacity\":0,\"description\":\"New River Studios is an arts’ centre, studio provider, venue, education hub, cafe and bar, with a large and diverse range of users.\\n\\nHoused in a converted furniture warehouse in Manor House, North London, New River Studios offers a broad range of facilities which can be easily accessed by the local community, and it hosts a variety of events including gigs, exhibitions, workshops, pop-ups and educational programs.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":101,\"name\":\"Next Door Records (W12)\",\"address\":\"304 Uxbridge Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"W12 7LJ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":238,\"name\":\"Next Door Records Two\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":184,\"name\":\"NORTH LONDON\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":156,\"name\":\"Oitij-jo Arts Space\",\"address\":\"Unit 3, Lighterman House, 3 Clove Crescent \",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"E14 2BB\",\"capacity\":110,\"description\":\"A pop up venue brought to you in collaboration between MisDigest and OITIJ-JO.\",\"on_listings_site\":true,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":165,\"name\":\"Old Blue Last\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":169,\"name\":\"Old School Rooms\",\"address\":\"2 Powerscroft Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E5 0PU\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":106,\"name\":\"Olita\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":237,\"name\":\"Ormside\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":2,\"name\":\"Ormside Projects\",\"address\":\"Penarth Centre, 32 Ormside Street\",\"city\":\"London\",\"country\":\"U.K.\",\"postcode\":\"SE15 1TR\",\"capacity\":0,\"description\":\"arts \\u0026 music project space, est 2015.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":64,\"name\":\"Palace Cinema Art Collective\",\"address\":\"2 Prince of Wales Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"NW5 3LQ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":67,\"name\":\"Palestine House\",\"address\":\"113 high Holborn\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"WC1V 6JQ\",\"capacity\":0,\"description\":\"Located in the heart of Holborn, London, Palestine House is a dynamic community and cultural center that also operates as a private members’ club.\\n\\nDedicated to supporting Palestinian rights, our mission is to provide a welcoming space for Palestinians and allies to come together, celebrate culture, and engage in meaningful advocacy.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":162,\"name\":\"Palm 2\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":240,\"name\":\"Paper Dress Vintage\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":34,\"name\":\"Pelican House\",\"address\":\"144 Cambridge Heath Road\",\"city\":\"London\",\"postcode\":\"E1 5QJ\",\"capacity\":0,\"description\":\"We are a home to grassroots unions, resistance networks, solidarity campaigns and community groups who are committed to the struggle for a just world.\\n\\nA social centre for political and cultural expression, welcoming people locally, across London and beyond to build friendships and share knowledge.\\n\\nwhat we do\\n\\nWe host countercultural events, fundraisers, socials, talks, workshops and film screenings, alongside community meals, coffee mornings and more — creating a space for joy, liberation and collective action.\\n\\nwhat we offer\\n\\nWe offer affordable work, meeting and event spaces for groups committed to creating a globally just, humane and ecologically secure world. We support community and worker organisation, movement building, experimental arts and cultural events.\\n\\nWe are a non-profit and prioritise community benefit in all of our activities.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":242,\"name\":\"pie\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":36,\"name\":\"Piehouse Co-Op\",\"address\":\"213-214 Edward Place\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE8 5HD\",\"capacity\":0,\"description\":\"a not-for-profit, worker-run, wheelchair accessible music and arts venue\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":15,\"name\":\"Planet Wax\",\"address\":\"318 NEW CROSS ROAD\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE14 6AF\",\"capacity\":0,\"description\":\"Record shop in South East London focusing on underground electronic / dance music genres.. Regualr in-store DJ sets and community space for all!\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":133,\"name\":\"Plaster Shop\",\"address\":\"20 Great Chapel Street\",\"city\":\"\",\"country\":\"\",\"postcode\":\"W1F 8FW\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":204,\"name\":\"Queen of Adelaide\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":168,\"name\":\"radial\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":128,\"name\":\"Raleigh Chapel\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":40,\"name\":\"Reference Point\",\"address\":\"2 Arundel Street\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":57,\"name\":\"REinsTate\",\"address\":\"1 Wythes Road\",\"postcode\":\"E16 2DN\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":241,\"name\":\"Rhizomatic\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":141,\"name\":\"Ridley Road Social Club\",\"address\":\"First Floor, 89 Ridley Road\",\"city\":\"\",\"country\":\"\",\"postcode\":\"E8 2PD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":37,\"name\":\"Rio Cinema\",\"address\":\"107 Kingsland High Street\",\"city\":\"London\",\"postcode\":\"E8 2PB\",\"capacity\":0,\"description\":\"The Rio is Hackney’s leading independent cinema, screening films at this address since 1909! Established as a community-led charity in 1976, we hold a remarkable archive as well as being a leading light of London’s thriving film culture. By night we are a vital part of London’s independent cinema scene, hosting film festivals, live scores and Q\\u0026As with directors and incredible live events. We are also a hub for Hackney’s LGBTQIA+ community. We have a vibrant bar and are the perfect place to meet up in Dalston for a drink. \\n\\nBy day, we deliver multiple community screenings Carers \\u0026 Babies club,  Classic Matinees show for seniors, Family Flicks in the school holidays, screenings for D/deaf families, and Relaxed screenings. Thousands of Hackney school children come through our doors every year. \\n\\n ✔️LGBTQIA+ SAFE SPACE ✔️FAMILY FRIENDLY ✔️COMMITTED TO ACCESSIBILITY ✔️ANTI-RACIST\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":83,\"name\":\"Rivoli Ballroom\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":150,\"name\":\"Sands Films\",\"address\":\"82 Saint Marychurch St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE16 4HZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":154,\"name\":\"Sands Films Cinema\",\"address\":\"82 Saint Marychurch St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE16 4HZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":158,\"name\":\"Sands Films Music Room\",\"address\":\"82 Saint Marychurch St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE16 4HZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":31,\"name\":\"Sauna Social Club\",\"address\":\"Railway Arch 842 Brayards Road\",\"city\":\"London\",\"postcode\":\"SE15 2AG\",\"capacity\":0,\"description\":\"We bring people together, creating spaces that improve wellbeing, spark creativity, and offer a healthy alternative to London’s drinking-led social culture.\\n\\nWhen we opened last year, our question was simple: what if, instead of the pub, you met friends in a sauna? Instead of waking up with a hangover, you wake feeling healthy, rested, and creatively inspired.\\n\\nMusic is at the heart of what we do. Our main sauna is built for deep listening, with a custom hi-fi system that can withstand 90°C heat ~14 strangers sitting silently together, immersed in sound from some of London’s best DJs and musicians.\\n\\n​A second, smaller sauna is designed for chatting and meeting new people, while four ice baths (at different temperatures) help build resilience and calm.\\n\\nAround the space, you’ll also find visual art installations, creative materials, and cosy corners for games, reading, or simply resting. Come alone or with friends, everyone is welcome. This is a space for community, creativity, and wellbeing\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":208,\"name\":\"Sebright Arms\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":116,\"name\":\"SECRET LOCATION\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":221,\"name\":\"Secret Location (TBA)\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":229,\"name\":\"Secret Location, Dalston\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":193,\"name\":\"SECRET SOUTH EAST LONDON LOCATION\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":29,\"name\":\"Servants Jazz Quarters\",\"address\":\"10A Bradbury St\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 8JN\",\"capacity\":0,\"description\":\"SJQ has been operating as an independent grassroots music venue since February 2011, and has since established itself as one of the capital’s most highly respected small venues and a well loved and valued haven for our local East-London community. As one of the first music venues in the area, we have been instrumental in making Dalston a key UK destination for music-audiences, becoming known as a central London hub which nurtures \\u0026 promotes both local, national and international artists.\\n\\nWe are a community-focused venue and take pride in providing a safe, friendly and bespoke space for artists and audience alike. We have become a popular industry choice for a wide range of emerging talent as well as established artists, offering independent promoters and  artists a space to experiment and connect with their audiences in an intimate setting. Our unique, open and diverse music policy is reflected in our programme, which ranges from pop, rock, folk, classical,  jazz to electronica, rnb, hip hop \\u0026 beyond.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"The entrance to the bar is on the ground floor level. There is an accessible toilet on the ground floor level and a short staircase to the performance space in the basement. We are happy to assist in any way we can. Please contact the venue in advance or speak to staff on-site for more information.\"},{\"id\":86,\"name\":\"SET 91\",\"address\":\"91 Tabernacle Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"EC2A 4JN\",\"capacity\":0,\"description\":\"SET 91 is a contemporary arts gallery on Tabernacle Street in Old Street, run by London-based arts organisation and registered charity, SET. The space provides a non-profit platform for early-career and underrepresented artists to develop and present new work.\\n\\nProgramme activity unfolds in six-month cycles, bringing together exhibitions, performances and cross-disciplinary projects led by the SET curatorial team, SET studio members and invited collaborators. Alongside this, the gallery hosts a public programme of talks, workshops and discussions.\\n\\nMore information can be found at:https://setspace.uk/set-91/\",\"on_listings_site\":true,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":41,\"name\":\"SET Social\",\"address\":\"55a Nigel Road\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"SE15 4NP\",\"capacity\":230,\"description\":\"SET Social is our not-for-profit arts and social club in Peckham, run by London-based arts organisation and registered charity, SET. Bringing together a café, bar, library, and garden under one roof, the space operates under a Club Premises Certificate licence and runs as a members’ club, with membership helping to keep the doors open and the venue in everyday use as a community-led arts and social centre.\\n\\nAt the heart of SET Social is an exciting and diverse arts and music programme, spanning everything from screenings and workshops to live music and DJ sets. Open seven days a week, the space invites people to drop in – whether that’s for a quiet coffee, time in the library or garden, or a late night at the bar.\\n\\nMembership costs just £12 a year and is reinvested directly into the space, while also supporting SET’s wider charitable projects across London. As a member, you have full access to the venue, events, and late nights, and you’re welcome to bring guests along. With an inclusive ethos always, SET Social remains open and welcoming to all, prioritising affordability, accessibility, self-expression, and a community-focused approach.\\n\\nMore information can also be found at: https://setspace.uk/social/\",\"on_listings_site\":true,\"wheelchair_accessible\":true,\"accessible_bathrooms\":true,\"hearing_loop\":false,\"accessible_parking\":true,\"lift_access\":false,\"accessibility_notes\":\"STEP-FREE ACCESS\\n\\nThe venue is almost entirely step-free, with the exception of the Stage in the Hall, which has a flight of six steps. For the stage in the Red Bar, a small ramp is available to provide step-free access to it.\\n\\n\\nENTRANCES\\n\\nSET Social has two entrances:\\n\\nThe main entrance can be found at the front of the building at the end of the courtyard path; this entrance has a flight of three steps.\\n\\nThe second entrance to the building can be accessed via a ramp and is found on the right hand side of the courtyard path.\\n\\n\\nFACILITIES\\n\\nThere is an accessible toilet located behind the Red Bar. The toilet is equipped with grab bars and adequate space for maneuverability. Staff are happy to provide a key to the toilet upon request.\\n\\nShould members require accessible seating or specific accommodations, please inform the event organiser.\\n\\nShould members require accessible seating or specific accommodations, in the absence of an event, please contact us at social@setspace.uk with ‘Access\\n\\nAssistance’ listed in the email subject, alternatively please speak to the staff on site who will be happy to help.\\n\\n\\nTRANSPORT + PARKING\\n\\nPeckham Rye is the nearest train and tube station, offering Southern train line services and London Overground routes on the Windrush line. Both services are available with step-free access.\\n\\nAccessible parking spaces are available close to the venue.\\n\\n\\nPETS + SERVICE ANIMALS\\n\\nGuide dogs and service dogs are very welcome. SET Social is dog friendly. Pleas feel free to bring along your four-legged friends!\\n\\n\\nSTAFF\\n\\nStaff are knowledgeable of the accessibility features within the space.\\n\\nThe SET team are trained to assist members with accessibility needs and are all happy to help.\\n\\nIf you’re planning a visit, you can find all practical details about our accessibility features and facilities here: https://setspace.uk/social/accessibility-at-set-social/\\n\\n\\n\\n\"},{\"id\":87,\"name\":\"SET Vauxhall\",\"address\":\"Camelford House, Albert Embankment\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE1 7TP \",\"capacity\":0,\"description\":\"SET Vauxhall is a 140,000 sq ft cultural centre at Camelford House on the Thames, offering over 250 studios for more than 600 artists, alongside a project space, a café and bar, and communal areas.  \\n\\nIt represents one of London’s largest artist-led spaces, built to encourage collaboration, experimentation, and community. \",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":30,\"name\":\"Shai Space\",\"address\":\"Studio 4, 17 Latona Rd\",\"city\":\"London\",\"postcode\":\"SE15 6RX\",\"capacity\":0,\"description\":\"Shai Space is a soulful, community-rooted venue in South East London dedicated to intentional experiences through music, food, and connection. Founded in 2024, Shai blends the intimacy of a listening room with the warmth of a cultural home. A place where artists and audiences come together to slow down, share space, and feel deeply.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":110,\"name\":\"SJQ\",\"address\":\"10a Bradbury Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 8JN\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":231,\"name\":\"SOAS Student Union\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":190,\"name\":\"South East London\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":3,\"name\":\"Spanners\",\"address\":\"Arch 504, Ridgway Rd\",\"city\":\"London\",\"country\":\"U.K.\",\"postcode\":\"SW9 7EX\",\"capacity\":90,\"description\":\"Venue supporting sound, image \\u0026 performance in South London.\\nSmall space with decent bar.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":44,\"name\":\"SPIT AND SAWDUST\",\"address\":\"21 Bartholomew Street\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"SE1 4AL\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":80,\"name\":\"St Barnabas Church\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":51,\"name\":\"St James Garlickhythe\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":26,\"name\":\"St