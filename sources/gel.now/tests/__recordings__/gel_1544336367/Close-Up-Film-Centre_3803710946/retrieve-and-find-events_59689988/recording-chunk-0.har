ist:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"1GRCAK\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,734],&quot;name&quot;:[0,&quot;fupper, the dengie hundred and not:hulme&quot;],&quot;start_time&quot;:[0,&quot;2026-08-06T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-07T11:30:00Z&quot;],&quot;poster&quot;:[0,&quot;9e895c42b63c6b5f2739e1054bd61739.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Fupper (live), The Dengie Hundred (live) and not:hulme (dj) will be performing at Spanners on the 6th August for the album launch of ‘Nullius” by Fupper out on Wrongspeed records this summer. \\n\\nFupper\\n\\nFupper (Simon Hughes) will be performing tracks and collages based around the new album ‘Nullius’ which is the fourth Fupper album for Wrong Speed records and comes with a limited edition companion book of the same name. \\n\\nThis album marks Fupper’s 22nd release and fifth book in a project that has lasted for over 30 years with releases on Wrongspeed, Tritone, Jonson Family, Inversions and Diwasou.\\n\\nThe Fupper sound is a blend of nostalgic guitar, down-tuned xylophone, harmonica, slumbering bass, crumbling rhythms fed through manipulated 1/4” tape loops spilling out their own found sounds and curios, gathered together on a 4 track and sampler and let breath until they find their way. \\n\\nSlipstream, wabi-sabi soundtracks and text that celebrate imperfection and transience. \\n\\nwww.fupper.co.uk\\nwww.fupper.bandcamp.com\\n\\n\\nThe Dengie Hundred \\n\\nThe Dengie Hundred is an ongoing project, always in flux, which responds to landscapes, bodies, everyday objects and field recordings. The project includes lo-fi love songs on debut Brackenbank; ferric, guitar-drenched psychogeography on Lammas Land; an album built from samples taken from a piece of plastic tubing, stretched to near-impossible limits, on Tube; two collaborative, shamisen-centred albums with Japan Blues; and two albums of gothic dream pop with writer and singer Gemma Blackshaw.\\n\\nThe Dengie Hundred’s eclectic approach to music making is held together by an underlying dub sensibility, reverb and delay, creating a sonic hall of mirrors where emotions and atmospheres, influences and found sounds get smudged into strange, otherworldly tableaus.\\n\\nCollaboratively and solo, The Dengie Hundred has released music on Sagome, DDS, Somewhere Press, Altered States Tapes, Ethbo, World Of Echo, and their own imprint Tain Records.\\n\\nhttps://tainrecords.bandcamp.com/music\\n\\nDJs not:hulme (Final Image)\\n\\nnot:hulme are Laura Not and Andrew Hulme when they team up at the decks to dj. Laura Not is an artist and dj, working visually and sonically through the medium of collage and curating radio programmes focussing on experimental sounds such as (x)=musik on Lyl radio. Andrew Hulme is a musician and film-maker. He is a founding member of the post-industrial ambient band O Yuki Conjugate and has been active in several other projects such as A Small Good Thing, Gush and most recently dis fac. Laura and Andrew also make music together as a duo and run the label Final Image where they release new and archival material.\\n\\nhttp://soundcloud.com/nothulme\\nhttp://finalimage.bandcamp.com\\nhttps://infanttree.bandcamp.com/album/almost-something-2&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}],[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,5],&quot;name&quot;:[0,&quot;film&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,1899],&quot;artist_name&quot;:[0,&quot;fupper&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1900],&quot;artist_name&quot;:[0,&quot;the dengie hundred&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1901],&quot;artist_name&quot;:[0,&quot;not:hulme