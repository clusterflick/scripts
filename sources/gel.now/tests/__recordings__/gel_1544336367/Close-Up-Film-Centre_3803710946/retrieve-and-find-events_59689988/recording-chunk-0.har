,{&quot;id&quot;:[0,491],&quot;name&quot;:[0,&quot;#live&quot;]}],[0,{&quot;id&quot;:[0,595],&quot;name&quot;:[0,&quot;Intibint&quot;]}],[0,{&quot;id&quot;:[0,596],&quot;name&quot;:[0,&quot;Ormside Projects&quot;]}],[0,{&quot;id&quot;:[0,597],&quot;name&quot;:[0,&quot;flowers.ldn&quot;]}],[0,{&quot;id&quot;:[0,598],&quot;name&quot;:[0,&quot;WSHWSH&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Head on over to Ormside Projects on Thursday 10th September for Intibint's Album Release party: presented by flowers.ldn and WSHWSH.<br /><br />Intibint’s debut album, titled ‘Half Moon Eyes’, is a self-produced project of electronic experimentation inspired by both Arabic and electronic sounds. The work is a progression into Intibint’s world through music, reflecting on the complexities of existing as someone connected to a war-torn homeland while navigating internal and external chaos across love, heartbreak and resistance.<br /><br />The evening will include a live album performance by Intibint, alongside oud and DJ sets from Nihal, Salam Kitty, MAVEEN, candice a.m, and henna by HuqThat.<br /><br />Get your ticket now* and come celebrate with us!<br /><br />🩷🌙🐬🩷🌙🐬🩷🌙🐬<br /><br />*If you're on Universal Credit, an asylum seeker or can't afford a ticket, just email us for a free ticket (flowerssldn@gmail.com) - all are welcome and no one will be turned away for lack of funds.<br /><br />Event Artwork: Intibint</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/49\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> flowers.ldn </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://www.instagram.com/intibint/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Intibint (Instagram) </a><a href=\"https://www.instagram.com/flowerssldn/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> flowers.ldn </a><a href=\"https://www.instagram.com/wshwsh_____/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> WSHWSH </a><a href=\"https://intibint.bandcamp.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Intibint (Bandcamp) </a><a href=\"https://www.instagram.com/nihalelaasar/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Nihal </a><a href=\"https://www.instagram.com/salamkitty.x/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Salam Kitty </a><a href=\"https://www.instagram.com/maveenn/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> MAVEEN </a><a href=\"https://www.instagram.com/candice_a.m/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> candice a.m </a><a href=\"https://www.instagram.com/huqthat/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> HuqThat </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin:bottom right\"><button class=\"\n            w-15 h-15 sm:w-16 sm:h-16\n            rounded-full\n            shadow-2xl\n            backdrop-blur-md\n            flex items-center justify-center\n            transition-all duration-200\n            hover:scale-110\n            focus:outline-none focus:ring-2 focus:ring-btn-primary focus:ring-offset-2\n          \" style=\"background-color:#f0f0f0;border:2px solid #2b2b2b20\" aria-label=\"Theme selector\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b2b2b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-7 h-7 sm:w-8 sm:h-8\" aria-hidden=\"true\"><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"#2b2b2b\"></circle><path d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z\"></path></svg></button></div><!--astro:end--></astro-island> <script>(function(){const apiUrl = \"https://api.gel.now\";\n\n      (function () {\n        var endpoint = apiUrl + \"/api/track\";\n        var queue = [];\n        var FLUSH_INTERVAL = 5000;\n        var MAX_BATCH = 20;\n\n        function normalizePath(path) {\n          return path.replace(/\\/\\d+/g, \"/:id\");\n        }\n\n        function queueEvent(evt) {\n          queue.push(evt);\n          if (queue.length >= MAX_BATCH) flush();\n        }\n\n        function flush() {\n          if (queue.length === 0) return;\n          var batch = queue.splice(0, MAX_BATCH);\n          var body = JSON.stringify({ events: batch });\n          if (navigator.sendBeacon) {\n            navigator.sendBeacon(\n              endpoint,\n              new Blob([body], { type: \"application/json\" }),\n            );\n          } else {\n            fetch(endpoint, {\n              method: \"POST\",\n              body: body,\n              keepalive: true,\n              headers: { \"Content-Type\": \"application/json\" },\n            });\n          }\n        }\n\n        var COOKIE_NAME = \"gel_dv\";\n        var today = new Date().toISOString().slice(0, 10);\n        var isNewDailyVisitor = true;\n        var cookies = document.cookie.split(\";\");\n        for (var i = 0; i < cookies.length; i++) {\n          var c = cookies[i].trim();\n          if (c.indexOf(COOKIE_NAME + \"=\") === 0) {\n            if (c.substring(COOKIE_NAME.length + 1) === today) {\n              isNewDailyVisitor = false;\n            }\n            break;\n          }\n        }\n        if (isNewDailyVisitor) {\n          var expires = new Date(Date.now() + 86400000).toUTCString();\n          document.cookie =\n            COOKIE_NAME +\n            \"=\" +\n            today +\n            \"; path=/; expires=\" +\n            expires +\n            \"; SameSite=Lax\";\n        }\n\n        queueEvent({\n          type: \"pageview\",\n          page: normalizePath(window.location.pathname),\n          screen_width: window.screen.width,\n          referrer: document.referrer || \"\",\n          is_new_daily_visitor: isNewDailyVisitor,\n        });\n\n        setInterval(flush, FLUSH_INTERVAL);\n\n        document.addEventListener(\"visibilitychange\", function () {\n          if (document.visibilityState === \"hidden\") flush();\n        });\n\n        window.__trackEvent = function (category, action) {\n          queueEvent({ type: \"event\", category: category, action: action });\n        };\n      })();\n    })();</script> </body> </html>",
