smoke.hc/\\n\\n\\u0026 more...\\n\\nSunday 6th September\\nNew Cross Inn, nearest stations New Cross and New Cross Gate\\nDoors 6pm\\n£13\\n14+, U16s with an adult 18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/fools-game-last-wishes-malignant-methods\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1358,\"artist_name\":\"Last Wishes\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1360,\"artist_name\":\"Big Smoke\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2264,\"artist_name\":\"Detriment\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":73,\"name\":\"South London\"},{\"id\":74,\"name\":\"heavy\"},{\"id\":81,\"name\":\"ukhc\"},{\"id\":82,\"name\":\"metalcore\"},{\"id\":615,\"name\":\"beatdown\"}]},{\"id\":587,\"name\":\"A Global Grindcore Invasion - Rageous Intent, C.H.O.U., Mindcollapse, Vilmort \\u0026 Frakasø\",\"start_time\":\"2026-09-08T18:00:00Z\",\"end_time\":\"2026-09-08T22:30:00Z\",\"poster\":\"ef3e69ce170a021795af093e97228bc1.webp\",\"background\":\"\",\"description\":\"Real Life Presents\\n\\nA Global Grindcore Invasion. Filthy blastbeat chaos from Spain, China, Scotland, and the UK\\n\\nFeaturing:\\n\\nRageous Intent\\nC.H.O.U.\\nMindcollapse\\nVilmort\\nFrakasø\\n\\nTuesday 8th September\\nNew Cross Inn, nearest stations New Cross Gate and New Cross\\n\\nDoors 6pm\\n£12\\n14+, u16s with an adult 18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/rageous-intent-chou\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1563,\"artist_name\":\"Rageous Intent\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1564,\"artist_name\":\"C.H.O.U.\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1565,\"artist_name\":\"Mindcollapse\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1566,\"artist_name\":\"Vilmort\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1567,\"artist_name\":\"Frakasø\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":37,\"name\":\"noise\"},{\"id\":69,\"name\":\"punk\"},{\"id\":70,\"name\":\"crust punk\"},{\"id\":83,\"name\":\"grindcore\"},{\"id\":404,\"name\":\"South East London\"}]},{\"id\":603,\"name\":\"New Lands \\u0026 SelOut present: Blood Wizard\",\"start_time\":\"2026-09-08T19:30:00Z\",\"end_time\":\"2026-09-08T23:00:00Z\",\"poster\":\"b79aff108acf6f76a3694fb98bf5b8b9.webp\",\"background\":\"\",\"description\":\"New Lands and SelOut team up for a very special night at The Ivy House, with three of South London's finest bands gracing the stage to celebrate the 40th edition of the zine!\\nEmerging in 2021 with an album of home-recordings titled Western Spaghetti, the south London based project, fronted by songwriter Cai Burns quietly gained underground popularity. What began as a solo project with folkier leanings gradually evolved into a collaborative unit which became heavier, slower, and harder to pin down; blending ragged indie rock, dreamy synths,and glitched-out textures. Since then, Blood Wizard have built a devoted following across the UK and afar and have become a fixture of London's DIY scene.\\ntall child is a band of 5 queer friends based in London, also the alias for Zha Gandhi, a musician of Nigerian/Indian heritage. Zha takes inspiration from the likes of Mitski, Radiohead, Rachel Chinouriri and Arlo Parks, to create a beautifully intimate and authentic basis for their soundscape. They build on this with a brutally honest style of lyricism, that explores their experiences as a queer disabled POC, to develop a sonic space especially for those who feel their differences being used against them. Recently announced as the winner for Green Man Rising, they are paving the way for other black artists in the indie music scene. Their debut EP ‘Somehow You Grow' is out now via Sad Club Records!\\nlifepath99 is a noise pop and indie rock project originating from the ether.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":800,\"artist_name\":\"tall child\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1597,\"artist_name\":\"blood wizard\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1598,\"artist_name\":\"lifepath99\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":8,\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road \",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":5,\"name\":\"The Ivy House\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":503,\"name\":\"General Admission\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":100,\"quantity_sold\":7,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":73,\"name\":\"South London\"},{\"id\":108,\"name\":\"peckham\"},{\"id\":109,\"name\":\"nunhead\"},{\"id\":140,\"name\":\"Indie\"},{\"id\":328,\"name\":\"alternative\"},{\"id\":380,\"name\":\"gig\"}]},{\"id\":536,\"name\":\"Up the Youth Club: Emma Warren in conversation with Jack Young\",\"start_time\":\"2026-09-10T19:00:00Z\",\"end_time\":\"2026-09-10T20:30:00Z\",\"poster\":\"fee5846c2c2a358a70dc18a266c7a45e.webp\",\"background\":\"\",\"description\":\"Join us when we welcome Emma Warren to discuss her book Up the Youth Club with Jack Young \\n\\n'Youth clubs have always existed. They always will, because there will always be young people. How we care for our youth, and what we owe them, is a question for all of us.'\\n\\nIn Up the Youth Club, Emma Warren maps the shifting story of youth clubs in the UK and Northern Ireland, from factory workers in Victorian Boys' and Girls' clubs to renegade self-emancipatory spaces in the 1970s and the music-generating youth clubs of more recent decades. With a mixed lineage in church evangelism, the patronage of the upper classes, grassroots' DIY, and erratic state funding, the youth club has had a huge, yet almost invisible, effect on music, sport, culture and society.\\n\\nArguing that we cannot advocate for what we do not understand, Warren positions youth clubs as a kind of engine room - from the famous success stories to come out of their doors, such as The Specials or Stormzy, to the untold stories of young people finding shelter, sustenance and stimulation for over a century - and why their dwindling numbers, largely due to austerity and funding cuts, is of serious concern for us all.\\n\\nWith this impassioned history, Warren invites us to pick up the torch and play an active part in protecting and re-igniting this vital part of UK society.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://events.humanitix.com/up-the-youth-club-emma-warren-in-conversation-with-jack-young\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1458,\"artist_name\":\"Emma Warren\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1459,\"artist_name\":\"Jack Young\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":169,\"name\":\"Old School Rooms\",\"address\":\"2 Powerscroft Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":264,\"name\":\"Pages Of Hackney\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":137,\"name\":\"diy\"},{\"id\":224,\"name\":\"community history\"},{\"id\":339,\"name\":\"youth culture\"}]},{\"id\":582,\"name\":\"Sheila Maurice Grey\",\"start_time\":\"2026-09-10T19:00:00Z\",\"end_time\":\"2026-09-10T23:00:00Z\",\"poster\":\"b3162f4a0d1a60e8119bf3c2bd43c318.webp\",\"background\":\"\",\"description\":\"UK Jazz hero Sheila Maurice Grey is bringing her solo project to the Fox \\u0026 Firkin for the first time.\\n\\nSheila is a London based trumpet and flugelhorn player who leads the world renowned band Kokoroko and has featured on several projects such as Sampha, Little Simz, Yussef Dayes, Stormzy and others.\\n\\nSheila is also a visual artist who loves to paint. Her painting plays an important and central role in her solo music project where she aims to explore her musical voice as well as through her paintings provocatively question the of hyper sexualisation of black women throughout history.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://foxfirkin.com/event/sheila-maurice-grey/\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1558,\"artist_name\":\"sheila maurice grey\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":24,\"name\":\"Fox and Firkin\",\"address\":\"316 Lewisham High St\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":296,\"name\":\"Fox and Firkin\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":23,\"name\":\"jazz\"},{\"id\":59,\"name\":\"Lewisham\"},{\"id\":73,\"name\":\"South London\"},{\"id\":87,\"name\":\"Soulful\"}]},{\"id\":839,\"name\":\"flowers.ldn \\u0026 WSHWSH present: Intibint Album Release Party\",\"start_time\":\"2026-09-10T19:00:00Z\",\"end_time\":\"2026-09-11T00:30:00Z\",\"poster\":\"11fb594f37b2c41ec6ceb61bd133bc3b.webp\",\"background\":\"\",\"description\":\"Head on over to Ormside Projects on Thursday 10th September for Intibint's Album Release party: presented by flowers.ldn and WSHWSH.\\n\\nIntibint’s debut album, titled ‘Half Moon Eyes’, is a self-produced project of electronic experimentation inspired by both Arabic and electronic sounds. The work is a progression into Intibint’s world through music, reflecting on the complexities of existing as someone connected to a war-torn homeland while navigating internal and external chaos across love, heartbreak and resistance.\\n\\nThe evening will include a live album performance by Intibint, alongside oud and DJ sets from Nihal, Salam Kitty, MAVEEN, candice a.m, and henna by HuqThat.\\n\\nGet your ticket now* and come celebrate with us!\\n\\n🩷🌙🐬🩷🌙🐬🩷🌙🐬\\n\\n*If you're on Universal Credit, an asylum seeker or can't afford a ticket, just email us for a free ticket (flowerssldn@gmail.com) - all are welcome and no one will be turned away for lack of funds.\\n\\nEvent Artwork: Intibint\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":2,\"name\":\"gig\"},{\"id\":7,\"name\":\"performance\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":534,\"artist_name\":\"Intibint\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1118,\"artist_name\":\"Nihal El Aasar\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2149,\"artist_name\":\"Salam Kitty\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2151,\"artist_name\":\"candice a.m\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2301,\"artist_name\":\"MAVEEN\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":2,\"name\":\"Ormside Projects\",\"address\":\"Penarth Centre, 32 Ormside Street\",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":49,\"name\":\"flowers.ldn\",\"contact_email\":\"\",\"stripe_account_id\":\