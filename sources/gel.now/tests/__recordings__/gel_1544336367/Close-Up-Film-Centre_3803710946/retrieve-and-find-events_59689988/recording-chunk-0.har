se,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":1,\"name\":\"test venue\",\"address\":\"\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":219,\"name\":\"The Africa Centre\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":189,\"name\":\"The Antwerp Arms\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":78,\"name\":\"The Bath House\",\"address\":\"80 Eastway\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E9 5JH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":205,\"name\":\"The Bunker Club\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":82,\"name\":\"The Bunker Club\",\"address\":\"46 Deptford Broadway\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE8 4PH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":43,\"name\":\"The Carpet Shop\",\"address\":\"Arch 164, 115 Rye Lane\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"SE15 4ST\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":60,\"name\":\"The Catford House\",\"address\":\"Catford Broadway\",\"city\":\"London\",\"postcode\":\"SE6 4SP\",\"capacity\":0,\"description\":\"21st century social club – community pub in the heart of Catford.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":178,\"name\":\"The Cinema Museum\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":117,\"name\":\"The Common Press\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":192,\"name\":\"The Common Press Dalston\",\"address\":\"97 Stoke Newington Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 8BX\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":25,\"name\":\"The Crypt Gallery\",\"address\":\"165 Euston Rd\",\"city\":\"London\",\"postcode\":\"NW1 2BA\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":195,\"name\":\"The Dance Hall\",\"address\":\"1 Navigator Square\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N19 3TD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":185,\"name\":\"The Distillery, N17\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":32,\"name\":\"The Dominion Centre\",\"address\":\"112 The Green\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"UB2 4BQ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":93,\"name\":\"The Engine Rooms Studios | Bow Triangle Business Centre | E3 4UR\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":147,\"name\":\"The Exchange\",\"address\":\"Ernest Harriss House, 61 Elgin Avenue\",\"city\":\"\",\"country\":\"\",\"postcode\":\"W9 2DB\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":176,\"name\":\"The Feminist Library\",\"address\":\"161 Sumner Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 6JL\",\"capacity\":0,\"description\":\"The Feminist Library is a large archive collection of feminist literature, particularly Women’s Liberation Movement materials dating from the late 1960s to the 1990s. We support research, activist and community projects in this field.\\n\\nThe Library is also an autonomous feminist community space. The Library is trans-inclusive, welcomes visitors of any gender, does not require registration or membership, and provides an intersectional, non-sectarian space for the exploration of feminism.\\n\\nThe Feminist Library is a registered charity 1174735 (formerly 272410)\\n\\nCompany no. CE012267\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"Getting here\\n\\nTo reach The Feminist Library, the closest tube station is Peckham Rye (1.3km away) which is not step-free. The route from Peckham Rye station is step-free but not level throughout. The nearest wheelchair accessible tube station is Queen’s Road Peckham, via a boarding ramp. Bus stops for routes 63, 363, 381, and 78 can all be found nearby. The closest bus stop (for routes 63 and 363 only) is ~330m away, the route is step free and level.\\n\\n\\n\\nArrival\\n\\nThe Sojourner Truth Centre which houses the Library is completely step-free with level floors through-out.\\n\\nRing the Feminist Library bells at the doorway (at 137cm), or call us in advance and you will be met. There is a slight depression in the floor where the welcome mat meets the floor. The door is 137cm wide, heavy, and is not automated.\\n\\nA Library Opener will greet you when you arrive and open the door, please let us know if there is any way large or small to make your visit easier. There is no obligation to chat, you can write a message down and show them if you would prefer or email in advance.\\n\\nThere are three doorways to pass through to access the main Library hall. Foyer double door does not stay open on its own. Floors are smooth and may be slippery if wet.\\n\\nThe main Library Hall is a completely step-free space, with level floors throughout. There is a set of double doors into the hall, and typically only one of them is propped open. We will open both on request. We have a variety of chairs including wide seats, and chairs with arm/back-rests. All chairs have back rests. If you need to reserve an armchair or sofa space please get in touch.\\n\\nThere is a narrow kitchen with crockery and cutlery, a mini fridge, and a microwave. You are welcome to bring food into the library, or use the teas and coffee in the kitchen. There is a Londis 72m (~2 mins) away which is step free and level throughout, with a step free route from the library, though please note the pavement may not be level.\\n\\nToilets are all gender neutral. There is one accessible toilet, which does not require a radar key, and two toilet rooms, located just across from library hall, offering cubicles and a urinal. Pull-down changing table is available in the accessible toilet.\\n\\nChildren are welcome but we do not have a creche.\\n\\nAssistance pets are welcome in the Library. There may be dogs in the Library on occasion, please let us know if you are not comfortable with this.\\n\\nHand sanitiser and masks are available. Let the Openers know if you would like others to be masked.\"},{\"id\":114,\"name\":\"The George Tavern\",\"address\":\"373 Commercial Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E1 0LA\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":222,\"name\":\"The Glove That Fits\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":167,\"name\":\"The Grace\",\"address\":\"20-22 Highbury Corner\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N5 1RD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":135,\"name\":\"The Greyhound\",\"address\":\"109 Peckham High Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 5SE\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"WC1N 1JD\",\"capacity\":120,\"description\":\"The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. \",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":172,\"name\":\"The HUB\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":8,\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road \",\"city\":\"London\",\"country\":\"U.K.\",\"postcode\":\"SE15 3BE\",\"capacity\":0,\"description\":\"The Ivy House (as you now see it) was founded in 2013 after residents and locals saved the building from impending demolition and redevelopment. But beer has been served on the site since 1865. \\n\\nWe are London’s first community-owned pub, the first pub in the UK to be listed as an Asset of Community Value, and the first building to be bought under the “community right to bid” provisions of the Localism Act.\\n\\nWe are a safe space for people of all ages, their children, and quite often, their pets. \",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":239,\"name\":\"The Joiners Heart\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":7,\"name\":\"The Lubberfiend\",\"address\":\"81 Blandford St \",\"city\":\"Newcastle upon Tyne\",\"country\":\"U.K.\",\"postcode\":\"NE1 3PZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":42,\"name\":\"The Mildmay Club\",\"address\":\"33-34 Newington Grn\",\"city\":\"London\",\"postcode\":\"N16 9PR\",\"capacity\":0,\"description\":\"The Mildmay Club \\u0026 Institute is a members’ club founded in 1888 and which has been at its present site on Newington Green since 1900.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":102,\"name\":\"The Muddy Puddle\",\"address\":\"142 Albion Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 9PA\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":16,\"name\":\"The Old Church Stoke Newington\",\"address\":\"Stoke Newington Church Street\",\"city\":\"London\",\"country\":\"United Kingdom\",\"postcode\":\"N16 9ES\",\"capacity\":0,\"description\":\"The Old Church is a not-for-profit arts venue in the heart of Stoke Newington, and the only surviving Elizabethan church in London.\\n\\nWe are committed to inspiring arts and celebrating community, hosting a wide variety of music, art, dance, and performance events.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":112,\"name\":\"The Old Nun's Head\",\"address\":\"15 Nunhead Green\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE15 3QQ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":77,\"name\":\"The Orange Room\",\"address\":\"375 High Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E15 4QZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":206,\"name\":\"The Pagan Arms\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":200,\"name\":\"The People's Letters Bookshop\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":66,\"name\":\"The Post Bar\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":157,\"name\":\"The Stag's Head\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":179,\"name\":\"The Theatre at Toynbee Studios  \",\"address\":\"28 Commercial Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E1 6AB\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":194,\"name\":\"The Waiting Room\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":5,\"name\":\"The White Hotel\",\"address\":\"Dickinson St\",\"city\":\"Salford\",\"country\":\"U.K.\",\"postcode\":\"M3 7LW\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":220,\"name\":\"The WORM FACTORY\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":218,\"name\":\"The Writers Room\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":215,\"name\":\"Torriano Meeting House\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":38,\"name\":\"Total Refreshment Centre\",\"address\":\"Foulden Road\",\"city\":\"London\",\"postcode\":\"N16 7UU\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":121,\"name\":\"Triangle LGBTQ+ Cultural Centre\",\"address\":\"34 Watsons Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE8 4AU\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":198,\"name\":\"Two Tribes Campfire\",\"address\":\"Tileyard Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N7 9AH\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":52,\"name\":\"TWO-PLUS-TWO\",\"address\":\"276 Oak Square (off Stockwell Green)\",\"city\":\"London\",\"postcode\":\"SW9 9AW\",\"capacity\":0,\"description\":\"TWO-PLUS-TWO is an artist-led project space in Stockwell, south west London, in the entrance foyer of Acme Glassyard Studios. Dedicated to connecting artists and curators, TWO-PLUS-TWO’s ethos is to create an engaging, experimental and diverse exhibition programme that positions itself firmly in the space between studio and gallery.   \",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":27,\"name\":\"Unit 58\",\"address\":\"Unit 58, Millmead Industrial Estate, Mill Mead Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N17 9QU\",\"capacity\":320,\"description\":\"Warehouse space and arts hub near Tottenham Hale station with 320 capacity.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":84,\"name\":\"Venue MOT\",\"address\":\"Orion Business Centre, Surrey Canal Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE14 5RT\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":20,\"name\":\"Vespers\",\"address\":\"133A Rye Lane\",\"city\":\"London\",\"postcode\":\"SE15 4BQ\",\"capacity\":0,\"description\":\"VESPERS club Peckham, \\n\\nAt the edge of day, we gather.\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":126,\"name\":\"Vortex Jazz Club\",\"address\":\"11 Gillett Square\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N16 8AZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":69,\"name\":\"Walthamstow Trades Hall\",\"address\":\"61-63 Tower Hamlets Road\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"E17 4RQ\",\"capacity\":0,\"description\":\"Walthamstow Trades Hall \\u0026 Institute is a members’ club, which has proudly stood in its current location for 100 years. There are two bars and a meeting room and it holds regular events, all of which are open to the public. Membership too, is open to all adults for an annual fee.\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":74,\"name\":\"Wards Corner Community Space\",\"address\":\"Seven Sisters Market, 245-253 High Rd\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"N15 5BT\",\"capacity\":0,\"description\":\"Born from 20 years of community engagement and campaigning, the Wards Corner Community Benefit Society (CBS), made up of local residents, workers and market traders, aims to manage the building once restored.\\n\\nCurrently, we are managing  the Seven Sisters Market community space and supporting the success of the historic traders, who have all returned!\",\"on_listings_site\":true,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":209,\"name\":\"Whitechapel Gallery\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false},{\"id\":89,\"name\":\"Windmill Brixton\",\"address\":\" 22 Blenheim Gardens, Brixton Hill\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SW2 5BZ\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":153,\"name\":\"Worlding\",\"address\":\"65-69 County Street\",\"city\":\"London\",\"country\":\"\",\"postcode\":\"SE1 4AD\",\"capacity\":0,\"description\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"accessibility_notes\":\"\"},{\"id\":152,\"name\":\"Worlding\",\"address\":\"\",\"capacity\":0,\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false}]",
