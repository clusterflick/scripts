            "mimeType": "text/html",
            "text": "<!DOCTYPE html><html lang=\"en\" data-theme-id=\"grey\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><link rel=\"shortcut icon\" href=\"/favicon.ico\"><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\"><meta name=\"apple-mobile-web-app-title\" content=\"MyWebSite\"><link rel=\"manifest\" href=\"/site.webmanifest\"><title>Queering the Voice Workshop with Guy Harries</title><meta name=\"description\" content=\"grassroots events london\"><!-- Initialize theme from localStorage immediately to prevent flash --><script>(function(){const themesData = {\"grey\":{\"id\":\"grey\",\"name\":\"Charcoal Granite\",\"background\":\"#f0f0f0\",\"foreground\":\"#2b2b2b\",\"accent\":\"#4c6ef5\"},\"grey-indigo\":{\"id\":\"grey-indigo\",\"name\":\"Grey Indigo\",\"background\":\"#3525a1\",\"foreground\":\"#d6d6d6\",\"accent\":\"#4c6ef5\"},\"coral-chocolate\":{\"id\":\"coral-chocolate\",\"name\":\"Coral Chocolate\",\"background\":\"#45301f\",\"foreground\":\"#ff8a7d\",\"accent\":\"#4c6ef5\"},\"mint-teal\":{\"id\":\"mint-teal\",\"name\":\"Teal Mint\",\"background\":\"#cfffa8\",\"foreground\":\"#284654\",\"accent\":\"#4c6ef5\"},\"lavender-plum\":{\"id\":\"lavender-plum\",\"name\":\"Plum Lavender\",\"background\":\"#fbd6ff\",\"foreground\":\"#442f61\",\"accent\":\"#4c6ef5\"},\"olive-lime\":{\"id\":\"olive-lime\",\"name\":\"Lime Olive\",\"background\":\"#403716\",\"foreground\":\"#a6d636\",\"accent\":\"#4c6ef5\"},\"aqua-night\":{\"id\":\"aqua-night\",\"name\":\"Aqua Night\",\"background\":\"#28384f\",\"foreground\":\"#8fffda\",\"accent\":\"#4c6ef5\"},\"peach-brown\":{\"id\":\"peach-brown\",\"name\":\"Brown Peach\",\"background\":\"#ffa347\",\"foreground\":\"#472c10\",\"accent\":\"#1e3a8a\"}};\n\n      (function () {\n        try {\n          const storedThemeId = localStorage.getItem(\"gel-theme\");\n          let theme;\n\n          // Check if custom theme is selected\n          if (storedThemeId === \"custom\") {\n            const customThemeStr = localStorage.getItem(\"gel-custom-theme\");\n            if (customThemeStr) {\n              const customColors = JSON.parse(customThemeStr);\n              theme = {\n                background: customColors.background,\n                foreground: customColors.foreground,\n                accent: \"#4c6ef5\",\n              };\n            }\n          } else if (storedThemeId && themesData[storedThemeId]) {\n            theme = themesData[storedThemeId];\n          }\n\n          if (theme) {\n            const root = document.documentElement;\n\n            // Update data-theme-id attribute so components can read it\n            root.setAttribute(\"data-theme-id\", storedThemeId);\n\n            // Set base theme colors\n            root.style.setProperty(\"--theme-bg\", theme.background);\n            root.style.setProperty(\"--theme-fg\", theme.foreground);\n            root.style.setProperty(\"--theme-accent\", theme.accent);\n            root.style.setProperty(\n              \"--theme-accent-hover\",\n              `color-mix(in oklch, ${theme.accent} 85%, black 15%)`,\n            );\n\n            // Set color-mix variations\n            root.style.setProperty(\n              \"--theme-fg-950\",\n              `color-mix(in oklch, ${theme.foreground} 100%, ${theme.background} 0%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-900\",\n              `color-mix(in oklch, ${theme.foreground} 90%, ${theme.background} 10%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-800\",\n              `color-mix(in oklch, ${theme.foreground} 80%, ${theme.background} 20%)`,\n        