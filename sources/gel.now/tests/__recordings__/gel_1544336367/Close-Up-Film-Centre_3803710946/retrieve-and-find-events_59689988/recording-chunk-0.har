ot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,3],&quot;name&quot;:[0,&quot;exhibition&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,704],&quot;artist_name&quot;:[0,&quot;Joseph Futak&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,8],&quot;name&quot;:[0,&quot;The Ivy House&quot;],&quot;address&quot;:[0,&quot;40 Stuart Road &quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;U.K.&quot;],&quot;postcode&quot;:[0,&quot;SE15 3BE&quot;],&quot;capacity&quot;:[0,0],&quot;description&quot;:[0,&quot;The Ivy House (as you now see it) was founded in 2013 after residents and locals saved the building from impending demolition and redevelopment. But beer has been served on the site since 1865. \\n\\nWe are London’s first community-owned pub, the first pub in the UK to be listed as an Asset of Community Value, and the first building to be bought under the “community right to bid” provisions of the Localism Act.\\n\\nWe are a safe space for people of all ages, their children, and quite often, their pets. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&qu