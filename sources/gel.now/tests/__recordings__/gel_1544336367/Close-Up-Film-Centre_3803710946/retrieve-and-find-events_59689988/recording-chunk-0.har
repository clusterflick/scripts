--> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/853/images/poster/7c74e517fcf77e2df6a0c50840114617.webp\" alt=\"Coby Sey / Miriam Adefris / Elliot Galvin / Tom Skinner (Quartet) | dove, Christine Kirubi\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Coby Sey / Miriam Adefris / Elliot Galvin / Tom Skinner (Quartet) | dove, Christine Kirubi</h1>  </div> <p class=\"text-surface-600 mb-4\"> Tuesday, September 15, 2026 · 7:00 PM – 11:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/17\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> The Horse Hospital </a> <p class=\"text-sm text-surface-600\">Colonnade</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/152\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Coby Sey </a> <span> · </span> <a href=\"/artists/1084\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> dove / Christine Kirubi </a> <span> · </span> <a href=\"/artists/1204\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Tom Skinner </a> <span> · </span> <a href=\"/artists/2203\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Miriam Adefris </a> <span> · </span> <a href=\"/artists/2204\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Elliot Galvin </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i