is.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Z1p02DF\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,706],&quot;name&quot;:[0,&quot;Diversion presents: Material Things, Minus Kendal, Mag&quot;],&quot;start_time&quot;:[0,&quot;2026-07-25T22:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-07-26T03:00:00Z&quot;],&quot;poster&quot;:[0,&quot;ce616977a9c15ac77ea0b7f1b8a459d4.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;t’s been a while since we’ve had an opportunity to do an event at spanners, mid summer parties in the dreamy archway really have a special feeling to them. \\n\\nWe’re extremely excited to present Material Things, an elusive band and collaborative project of Stewart, one of the founding minds behind the beloved and definitive label- 12th isle. Since the first release on the label, a well developed relationship has emerged between Scotland’s Stewart and London-situated drummer Pike Ogilvy, the latter’s percussion featuring fully on the second album- to our mind an impressively dense (but spacious), wiggly and textural work, pike’s live rhythms sparring with synthesised bass, pads and pings.\\nCheck out both releases on the 12th isle bandcamp.\\nI’ve been told on good authority theres lots of yet-unheard material (things) that may be debuted on the 25th. Buzzing!\\n\\nSupport from the singularly talented digger and long (long) time NTS resident, Minus Kendal. Criminally under booked, fully stocked with incredible tunes and raring to go, Fin will be playing for two hours after the band, until closing time.\\nOne of his very incredible and very recent contributions to the musical sphere, the label Ó Mhaidin, first with a compilation album (‘Toothpaste for your Elephant’) sports some of the craziest and best tunes we’ve heard in ages. Cant really sum it up past ecstatic superlatives, but the wildly eclectic nature of the album really runs through Fin as a person, his taste and of course selection.  \\n\\nMag, having moved back to London from Glasgow quite recently, has already made more moves in the big smoke than most do in a few years. Her event ‘Testing the water’ moved down with her and although it sounds like it might be dipping a toe, I would argue the theres alot more splashing involved. (Theres actually a TTW the night before- on the 24th, in a church, featuring 12th isle’s Ru, if you can quite believe your luck.) Dedicated to the weird and experimental, her mixes and dj sets have definitely wormed their way into the ears and minds our little south east London scene.  Regular shows on Glasgow’s Buena Vista, ambient sauna outings and sets supporting some huge names at corsica all attest to Naomi’s tekkers.\\nThe perfect opening set to get down n check out while working through Spanner’s bar offerings.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}],[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,972],&quot;artist_name&quot;:[0,&quot;Mag&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1824],&quot;artist_name&quot;:[0,&quot;Material Things&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1825],&quot;artist_name&quot;:[0,&quot;Minus Kendal&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,3],&quot;name&quot;:[0,&quot;Spanners&quot;],&quot;address&quot;:[0,&quot;Arch 504, Ridgway Rd&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;U.K.&quot;],&quot;p