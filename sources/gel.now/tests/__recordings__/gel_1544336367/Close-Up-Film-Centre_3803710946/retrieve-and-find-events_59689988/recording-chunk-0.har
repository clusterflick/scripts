{&quot;id&quot;:[0,9],&quot;name&quot;:[0,&quot;workshop&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,8],&quot;name&quot;:[0,&quot;The Ivy House&quot;],&quot;address&quot;:[0,&quot;40 Stuart Road &quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;U.K.&quot;],&quot;postcode&quot;:[0,&quot;SE15 3BE&quot;],&quot;capacity&quot;:[0,0],&quot;description&quot;:[0,&quot;The Ivy House (as you now see it) was founded in 2013 after residents and locals saved the building from impending demolition and redevelopment. But beer has been served on the site since 1865. \\n\\nWe are London’s first community-owned pub, the first pub in the UK to be listed as an Asset of Community Value, and the first building to be bought under the “community right to bid” provisions of the Localism Act.\\n\\nWe are a safe space for people of all ages, their children, and quite often, their pets. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,347],&quot;name&quot;:[0,&quot;Evie Garner&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TojWW2dLzSKwAw2&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,322],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,601],&quot;name&quot;:[0,&quot;Standard&quot;],&quot;price&quot;:[0,7],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,20],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,602],&quot;name&quot;:[0,&quot;Unwaged&quot;],&quot;price&quot;:[0,5],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,20],&quot;quantity_sold&quot;:[0,3],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,109],&quot;name&quot;:[0,&quot;nunhead&quot;]}],[0,{&quot;id&quot;:[0,119],&quot;name&quot;:[0,&quot;disco&quot;]}],[0,{&quot;id&quot;:[0,137],&quot;name&quot;:[0,&quot;diy&quot;]}],[0,{&quot;id&quot;:[0,372],&quot;name&quot;:[0,&quot;70s&quot;]}],[0,{&quot;id&quot;:[0,489],&quot;name&quot;:[0,&quot;bingo&quot;]}],[0,{&quot;id&quot;:[0,490],&quot;name&quot;:[0,&quot;brockley&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Feeling lucky? Eyes down looking ... <br /><br />The Ivy House gives Blackpool a run for it's money for one night only. Two little ducks, all the fives, it's all to play for. <br /><br />The night will comprise of 3x games of Bingo, with dazzling prizes to be won, and a bit of a knees up afterwards to dance off all the tension.<br /><br />Dobbers and tickets will be provided on the door. <br /><br />Tickets £7 / £5 unwaged. </div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/347\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Evie Garner </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin:bottom right\"><button class=\"\n            w-15 h-15 sm:w-16 sm:h-16\n            rounded-full\n            shadow-2xl\n            backdrop-blur-md\n            flex items-center justify-center\n            transition-all duration-200\n            hover:scale-110\n            focus:outline-none focus:ring-2 focus:ring-btn-primary focus:ring-offset-2\n          \" style=\"background-color:#f0f0f0;border:2px solid #2b2b2b20\" aria-label=\"Theme selector\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b2b2b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"w-7 h-7 sm:w-8 sm:h-8\" aria-hidden=\"true\"><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"#2b2b2b\"></circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"#2b2b2b\"></circle><path d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z\"></path></svg></button></div><!--astro:end--></astro-island> <script>(function(){const apiUrl = \"https://api.gel.now\";\n\n      (function () {\n        var endpoint = apiUrl + \"/api/track\";\n        var queue = [];\n        var FLUSH_INTERVAL = 5000;\n        var MAX_BATCH = 20;\n\n        function normalizePath(path) {\n          return path.replace(/\\/\\d+/g, \"/:id\");\n        }\n\n        function queueEvent(evt) {\n          queue.push(evt);\n          if (queue.length >= MAX_BATCH) flush();\n        }\n\n        function flush() {\n          if (queue.length === 0) return;\n          var batch = queue.splice(0, MAX_BATCH);\n          var body = JSON.stringify({ events: batch });\n          if (navigator.sendBeacon) {\n            navigator.sendBeacon(\n              endpoint,\n              new Blob([body], { type: \"application/json\" }),\n            );\n          } else {\n            fetch(endpoint, {\n              method: \"POST\",\n              body: body,\n              keepalive: true,\n              headers: { \"Content-Type\": \"application/json\" },\n            });\n          }\n        }\n\n        var COOKIE_NAME = \"gel_dv\";\n        var today = new Date().toISOString().slice(0, 10);\n        var isNewDailyVisitor = true;\n        var cookies = document.cookie.split(\";\");\n        for (var i = 0; i < cookies.length; i++) {\n          var c = cookies[i].trim();\n          if (c.indexOf(COOKIE_NAME + \"=\") === 0) {\n            if (c.substring(COOKIE_NAME.length + 1) === today) {\n              isNewDailyVisitor = false;\n            }\n            break;\n          }\n        }\n        if (isNewDailyVisitor) {\n          var expires = new Date(Date.now() + 86400000).toUTCString();\n          document.cookie =\n            COOKIE_NAME +\n            \"=\" +\n            today +\n            \"; path=/; expires=\" +\n            expires +\n            \"; SameSite=Lax\";\n        }\n\n        queueEvent({\n          type: \"pageview\",\n          page: normalizePath(window.location.pathname),\n          screen_width: window.screen.width,\n          referrer: document.referrer || \"\",\n          is_new_daily_visitor: isNewDailyVisitor,\n        });\n\n        setInterval(flush, FLUSH_INTERVAL);\n\n        document.addEventListener(\"visibilitychange\", function () {\n          if (document.visibilityState === \"hidden\") flush();\n        });\n\n        window.__trackEvent = function (category, action) {\n          queueEvent({ type: \"event\", category: category, action: action });\n        };\n      })();\n    })();</script> </body> </html>",
