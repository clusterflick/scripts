y --> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/587/images/poster/ef3e69ce170a021795af093e97228bc1.webp\" alt=\"A Global Grindcore Invasion - Rageous Intent, C.H.O.U., Mindcollapse, Vilmort &#38; Frakasø\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">A Global Grindcore Invasion - Rageous Intent, C.H.O.U., Mindcollapse, Vilmort &amp; Frakasø</h1>  </div> <p class=\"text-surface-600 mb-4\"> Tuesday, September 8, 2026 · 6:00 PM – 10:30 PM </p> <div class=\"mb-6\"> <a href=\"/venues/65\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> New Cross Inn </a> <p class=\"text-sm text-surface-600\">323 New Cross Road</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1563\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Rageous Intent </a> <span> · </span> <a href=\"/artists/1564\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> C.H.O.U. </a> <span> · </span> <a href=\"/artists/1565\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Mindcollapse </a> <span> · </span> <a href=\"/artists/1566\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Vilmort </a> <span> · </span> <a href=\"/artists/1567\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Frakasø </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://pit.live/events/rageous-intent-chou\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Real Life Presents<br /><br />A Global Grindcore Invasion. Filthy blastbeat chaos from Spain, China, Scotland, and the UK<br /><br />Featuring:<br /><br />Rageous Intent<br />C.H.O.U.<br />Mindcollapse<br />Vilmort<br />Frakasø<br /><br />Tuesday 8th September<br />New Cross Inn, nearest stations New Cross Gate and New Cross<br /><br />Doors 6pm<br />£12<br />14+, u16s with an adult 18+</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/94\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Real Life Presents </a>  </p> <div class=\"mt-6\">  <div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Rageous Intent </p> <a href=\"https://rageousintent.bandcamp.com/album/s-t-2\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Rageous Intent </a> </div><div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> C.H.O.U. </p> <a href=\"https://chaotichumanityobservationunion.bandcamp.com/album/-\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> C.H.O.U. </a> </div><div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Mindcollapse </p> <a href=\"https://mindcollapsegrind.bandcamp.com/album/mindcollapse\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Mindcollapse </a> </div><div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Vilmort </p> <a href=\"https://vilmort.bandcamp.com/album/el-legado-del-exterminio\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Vilmort </a> </div> </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href