ges/poster/40fa064f491d9acbeae4b5fe7b8bcec7.webp\" alt=\"DEAFKIDS, KOMBI &#38; Brava | Real Life Presents\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">DEAFKIDS, KOMBI &amp; Brava | Real Life Presents</h1>  </div> <p class=\"text-surface-600 mb-4\"> Tuesday, October 20, 2026 · 6:00 PM – 10:30 PM </p> <div class=\"mb-6\"> <a href=\"/venues/65\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> New Cross Inn </a> <p class=\"text-sm text-surface-600\">323 New Cross Road</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/2108\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> DEAFKIDS </a> <span> · </span> <a href=\"/artists/2109\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> KOMBI </a> <span> · </span> <a href=\"/artists/2110\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Brava </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://pit.live/events/deaf-kids\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">New Cross Live Presents<br /><br />Deaf Kids<br />Brazilian legends blending the raw spirit of noise punk, global rhythms and experimental electronics into a sonic assault since 2010. Armed with a brand new album 'Cicatrizes Do Futuro' they're here to shake London to the ground.<br /><br />Kombi<br />Ambient drones by Joao of TEST<br /><br />Brava<br />Outsider house music with a hardcore MC, LDN via San Sebastian<br /><br />Tuesday 20th October<br />New Cross Inn, Nearest stations New Cross Gate and New Cross<br />Doors 6pm<br />£17<br />14+, u16s with an adult 18+</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/94\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Real Life Presents </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://deafkidspunx.bandcamp.com/album/cicatrizes-do-futuro\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Deafkids </a><a href=\"https://kombi.bandcamp.com/album/alimento-a-dor\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Kombi </a><a href=\"https://untalasalsa.bandcamp.com/track/mi-nombre-es\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Brava </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userDat