te&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,513],&quot;name&quot;:[0,&quot;Advance&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,45],&quot;quantity_sold&quot;:[0,41],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,958],&quot;url&quot;:[0,&quot;https://kirkbarley.bandcamp.com/album/lux&quot;],&quot;display_title&quot;:[0,&quot;Kirk Barley - Lux&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-06-14T12:45:28.62779Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-06-14T12:45:28.62779Z&quot;]}],[0,{&quot;id&quot;:[0,959],&quot;url&quot;:[0,&quot;https://nonclassical.bandcamp.com/album/almost-not-exactly&quot;],&quot;display_title&quot;:[0,&quot;Tara Cunningham - Almost - Not Exactly&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-06-14T12:45:28.62779Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-06-14T12:45:28.62779Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,8],&quot;name&quot;:[0,&quot;experimental&quot;]}],[0,{&quot;id&quot;:[0,14],&quot;name&quot;:[0,&quot;ambient&quot;]}],[0,{&quot;id&quot;:[0,149],&quot;name&quot;:[0,&quot;live electronic&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Kirk Barley is a Yorkshire-born composer and sound artist working with field recordings, instrumental fragments, found sounds and alternative tuning systems. His new album Arc explores just intonation, off-grid sequencing and shifting rhythmic structures through a sparse palette of guitar, clarinet, metallic percussion and electronic textures. Drawing on minimalism, sample-based hip-hop, dub techno and post-rock, his music moves between detailed acoustic sound and quietly unfolding electronic forms.<br /><br />Tara Cunningham is a guitarist who operates predominantly within improvisational and experimental music. She released her album Almost - Not Exactly via Nonclassical in August 2025, with more solo music to be released later this year. Ongoing projects as a collaborator and side person include: The Sleeves, Modern Nature, Sebastian Rochford, Red Snapper, Liam Noble, Laura Jurd and Caius Williams.<br /><br />Odda Recordings label owner Thea HD brings together lesser-known and overlooked sounds, moving between old soundtracks, library music, experimental electronics and other curious corners. She’ll be selecting records throughout the evening.<br /><br />Wednesday 29 July<br />7pm–11pm<br />Spanners, London<br /><br />£10 advance / £12 on the door / £8 unwaged</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/300\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Kirk Barley </a>  </p> <div class=\"mt-6\">  <div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Kirk Barley - Lux </p> <a href=\"https://kirkbarley.bandcamp.com/album/lux\" target=\"_b