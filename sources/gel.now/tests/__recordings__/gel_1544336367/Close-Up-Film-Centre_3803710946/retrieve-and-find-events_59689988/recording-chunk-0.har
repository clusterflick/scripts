sconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"1oLSby\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,845],&quot;name&quot;:[0,&quot;FOOL Collective - First Showcase&quot;],&quot;start_time&quot;:[0,&quot;2026-08-20T19:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-20T23:00:00Z&quot;],&quot;poster&quot;:[0,&quot;d1651cecf95a4cc00fe40740a9de5771.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;What is FOOL?: It started with song shares. Some of us had done School of Song workshops with Brian Eno, AG Cook, Oneohtrix Point Never and Arca, some did one, some did several, but we all ended up in the same room in London afterwards, talking.\\n\\nSome of us have years of experience. Some have never played a show. Some stepped back from the scene out of disillusionment, others are still finding their footing. And we decided to start something, not to fix a big problem, but to add to what others are already building. We need more.\\n\\nFOOL is founded on that premise. Our aim is to go for showcases where the stage is open to those in the collective, wherever we might be in the journey, not just where we’ve already arrived.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,1277],&quot;artist_name&quot;:[0,&quot;Valeria Radchenko&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;Valeria Radchenko (they/her) is a singer-songwriter, music producer and multimedia artist based in London. Their music is multi-genre and combines instrumentation with electronic dance music elements, centred around their voice. Exploring sound as a form of touch, Valeria is interested in the emotional potential of electronic music - how it can make us feel things that can’t be felt otherwise or that we didn’t know were within us.\\n\\nValeria organises multimedia and grassroots music events with collectives In-Grid and Are We Home Yet? They have performed &amp; DJed across London venues including The Bath House, Ormside Projects and Corsica Studios. In 2024, she received a Help Musicians grant to record and release her first album, VISIONS. “[Valeria’s] music wades into previously unexplored, exciting sonic territories while maintaining a strong sense of grounding and connection to the listener through their honest songwriting, meticulous production and moving performances that feel undoubtedly human” -  Yumé NET, music producer.\\n\\nValeria also works as a composer and sound designer for artists/filmmakers, e.g. scoring April Forrest Lin&#39;s 林森 feature film, (Tending) (to) (Ta) and Elinor Rowlands’ film, Retelling of the Wild Woods.\\n&quot;],&quot;image&quot;:[0,&quot;de5fd5345ce5d113094a42780dae9150.webp&quot;],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,101],&quot;url&quot;:[0,&quot;https://www.instagram.com/valeriiiaaaaa/&quot;],&quot;display_title&quot;:[0,&quot;Instagram&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-08-05T14:28:55.06195Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-05T14:28:55.06195Z&quot;]}],[0,{&quot;id&quot;:[0,102],&quot;url&quot;:[0,&quot;https://valeriaradchenko.bandcamp.com/&quot;],&quot;display_title&quot;:[0,&quot;Bandcamp&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-08-05T14:28:55.06296Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-05T14:28:55.06296Z&quot;]}],[0,{&quot;id&quot;:[0,103],&quot;url&quot;:[0,&quot;https://soundcloud.com/valeria-a&quot;],&quot;display_title&quot;:[0,&quot;Soundcloud&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,2],&quot;date_created&quot;:[0,&quot;2026-08-05T14:28:55.063586Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-05T14:28:55.063586Z&quot;]}],[0,{&quot;id&quot;:[0,104],&quot;url&quot;:[0,&quot;https://www.valeriaradchenko.com/&quot;],&quot;display_titl