/b5c62b1f91cc42f0b6d5ee24f8805dc4.webp\" alt=\"VENT ⓥ DJ Spanish Fly, James Massiah, Nihal\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">VENT ⓥ DJ Spanish Fly, James Massiah, Nihal</h1>  </div> <p class=\"text-surface-600 mb-4\"> Thursday, August 20, 2026 · 8:00 PM – 11:59 PM </p> <div class=\"mb-6\"> <a href=\"/venues/84\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Venue MOT </a> <p class=\"text-sm text-surface-600\">Orion Business Centre, Surrey Canal Rd</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1118\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Nihal El Aasar </a> <span> · </span> <a href=\"/artists/1642\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> James Massiah </a> <span> · </span> <a href=\"/artists/1958\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> DJ Spanish Fly </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://ra.co/events/2469486\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">DJ Spanish Fly is universally known as the \"Godfather of Memphis rap.\" Originating in the South Memphis area, he pioneered the city's signature hip-hop sound by blending 808 drum machines, hypnotic baselines, and dark, lo-fi distortion, laying the early groundwork for modern trap and phonk.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/368\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> VENT </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in 