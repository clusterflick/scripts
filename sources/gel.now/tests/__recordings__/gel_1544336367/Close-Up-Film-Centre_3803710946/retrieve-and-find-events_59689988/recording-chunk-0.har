p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"nFVSd\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,828],&quot;name&quot;:[0,&quot;FREE DRUMMING WORKSHOP FOR FLINTA BY VALERIA PACIFIC&quot;],&quot;start_time&quot;:[0,&quot;2026-08-11T19:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-11T21:00:00Z&quot;],&quot;poster&quot;:[0,&quot;6a391e4e53e5881a9ac3429539da8558.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Join us for a special drumming workshop in Burgess Park led by Valeria Pacific, the first artist in residence as part of Studio 12&#39;s Residency Programme: A Door to Experimentation.\\n\\nThis workshop invites FLINTA participants to explore the drum not only as a musical instrument, but as a technology for communication, community building, presence, collective care and self-expression. Drawing on bullerengue and other Afro-Colombian traditions, we&#39;ll learn foundational techniques and rhythms, reflect on the historical relationship between women and the drum and build confidence through a shared practice. (Bring your own drum - all drums welcome)\\n\\nAbout Valeria: Valeria Pacific is a drummer, DJ, community organiser and cultural producer. She is the director and lead drummer of Akolá Tambo, and co-founder and director of Bullerengue Circle. Her work has played a key role in giving visibility to bullerengue in the UK and Europe.\\n\\n*** Meeting Point Burgess Park - Club House Cafe ***\\n\\n_____\\n\\nDiscover the exciting programme we&#39;ve curated throughout the residency, featuring workshops, performances and opportunities to engage with the artists as they develop new work.\\n\\n&#39;A Door to Experimentation&#39; brings together three emerging artists who are expanding their practice from traditional folk music into experimental, collaborative and cross-disciplinary music-making. Throughout the residency, they are mentored by Patricia Doors, exploring new approaches to sound, performance and creative exchange.\\n\\nThis residency has been made possible with the generous support of Arts Council England, Anglo Chilean Society, Movimientos and CASA.\\n\\nAbout Studio 12\\n\\nStudio 12 is an intimate art space and bespoke cocktail bar in Camberwell rooted in transnational solidarities — dedicated to art, music, poetry and gathering.\\n\\n\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,false],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,9],&quot;name&quot;:[0,&quot;workshop&quot;]}]]],&quot;is_free&quot;:[0,true],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,2128],&quot;artist_name&quot;:[0,&quot;Valeria Pacific&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,216],&quot;name&quot;:[0,&quot;Studio 12&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TYqHHGxrRpNa8w2&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,186],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,737],&quot;name&quot;:[0,&quot;FREE RSVP&quot;],&quot;price&quot;:[0,0],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,11],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,173],&quot;name&quot;:[0,&quot;workshop&quot;]}],[0,{&quot;id&quot;:[0,402],&quot;name&quot;:[0,&quot;Afro-music&quot;]}],[0,{&quot;id&quot;:[0,583],&quot;name&quot;:[0,&quot;drumming&quot;]}],[0,{&quot;id&quot;:[0,584],&quot;name&quot;:[0,&quot;bullerengue&quot;]}],[0,{&quot;id&quot;:[0,585],&quot;name&quot;:[0,&quot;drumming circle&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Join us for a special drumming workshop in Burgess Park led by Valeria Pacific, the first artist in residence as part of Studio 12's Residency Programme: A Door to Experimentation.<br /><br />This workshop invites FLINTA participants to explore the drum not only as a musical instrument, but as a technology for communication, community building, presence, collective care and self-expression. Drawing on bullerengue and other Afro-Colombian traditions, we'll learn foundational techniques and rhythms, reflect on the historical relationship between women and the drum and build confidence through a shared practice. (Bring your own drum - all drums welcome)<br /><br />About Valeria: Valeria Pacific is a drummer, DJ, community organiser and cultural producer. She is the director and lead drummer of Akolá Tambo, and co-founder and director of Bullerengue Circle. Her work has played a key role in giving visibility to bullerengue in the UK and Europe.<br /><br />*** Meeting Point Burgess Park - Club House Cafe ***<br /><br />_____<br /><br />Discover the exciting programme we've curated throughout the residency, featuring workshops, performances and opportunities to engage with the artists as they develop new work.<br /><br />'A Door to Experimentation' brings together three emerging artists who are expanding their practice from traditional folk music into experimental, collaborative and cross-disciplinary music-making. Throughout the residency, they are mentored by Patricia Doors, exploring new approaches to sound, performance and creative exchange.<br /><br />This residency has been made possible with the generous support of Arts Council England, Anglo Chilean Society, Movimientos and CASA.<br /><br />About Studio 12<br /><br />Studio 12 is an intimate art space and bespoke cocktail bar in Camberwell rooted in transnational solidarities — dedicated to art, music, poetry and gathering.<br /><br /><br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/216\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Studio 12 </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin