96d04fd2674928681.webp\" alt=\"Northern Soul Live - The Signatures\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Northern Soul Live - The Signatures</h1>  </div> <p class=\"text-surface-600 mb-4\"> Friday, July 24, 2026 · 8:00 PM – 3:00 AM </p> <div class=\"mb-6\"> <a href=\"/venues/24\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Fox and Firkin </a> <p class=\"text-sm text-surface-600\">316 Lewisham High St</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1560\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> the signatures </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://foxfirkin.com/event/northern-soul-live-the-signatures-24th-july-2026/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">10-piece live band The Signatures bring the classic sound of Northern Soul to life. <br /><br />Experience the soul-stirring magic of The Signatures, The Official backing band for many original Northern Soul artists, as well as being featured as the house band for the Northern Soul Special on The Craig Charles Funk and Soul Show on BBC 6 Music<br /><br />Immerse yourself in the energy of a ten-piece live band, showcasing their exceptional talent in their own distinctive style. The Signatures, along with their power and expression, have worked with more original artists than any other band in the UK delivering a truly authentic performance.<br /><br />+ Gig ticket includes a vinyl-only afterparty from the crew behind Heart of Soul Lewisham – running till late.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/296\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Fox and Firkin </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t