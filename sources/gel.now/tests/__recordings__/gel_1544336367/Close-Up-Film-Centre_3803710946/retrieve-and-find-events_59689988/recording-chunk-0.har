:!0})}connectedCallback(){if(!this.hasAttribute(\"await-children\")||document.readyState===\"interactive\"||document.readyState===\"complete\")this.childrenConnectedCallback();else{let e=()=>{document.removeEventListener(\"DOMContentLoaded\",e),c.disconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"2mLIu8\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,823],&quot;name&quot;:[0,&quot;Noisy Women Present | Phil Minton&#39;s Almost Instant Feral Choir&quot;],&quot;start_time&quot;:[0,&quot;2026-08-06T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-06T22:00:00Z&quot;],&quot;poster&quot;:[0,&quot;1f7114f8d142f4c3c05c522e32abb8a8.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;With Faradena Afifi, Steve Beresford, Iris Colomb, Charlie Foloronsho, Chris Freeman, Aurelie Freoua, Leanne Holroyd, Ningrui Liu, Jo Morrison, Maggie Nicols, Carys Mai, Majik Ogunwa, Jenni Roditi, Anjalika Sagar, Nini Sakhri, Bettina Schroeder, James Smith, Nicky Smith, Julian Woods, Gina Fergione &amp; more!\\n\\nThere will be a solo from Faradena Afifi &amp; a trio from Jo Morrison, Jenni Roditi, Phil Minton &amp; in the first half. \\n\\n\\n--\\n\\nThe Feral Choir project is a series of vocal workshops with non-professionals, leading up to performances. It originated in the late 1980’s when I was asked to do some workshops with ‘non-singers’ in the Musik Centrum Stockholm. The success of these led me to develop the idea further. The choir consists of a three day workshop and performance, not only for singers but for anyone who takes a delight in the freedom to experiment. I encourage participants to take a vocal leap and explore all vocal possibilities through exercises and improvisations, over the workshop period, leading to a concert.\\n\\nFeral Choir workshops and performances have subsequently been held in many different places around the world including Berlin, Centre for Performance Research Cardiff, Musickzentrum Munich, Tokyo, Angelica Bologna, City Festival Lausanne, Institute for Living Voice Antwerp, Baltimore, Nante, Brest, Oxford, Paris, Oakland, Melbourne, St. Paulo, Rio de Janeiro, Bristol, Pau, Florence, Le Man, Trondheim, Rotterdam, Ghent, Zurich, Nancy Vandoeuvre, Poitiers, London, Amsterdam, Warsaw, Brugge, Strasbourg, and Aberystwyth.\\n\\nSome of the choirs have been made up of professionals, sometimes actors and musicians, but many have been amateur groups with no previous musical interest or experience. These have been particularly rewarding, as has the work with teenagers in Belgium and Holland, and the responses from the participants have been overwhelmingly positive.\\n\\nwww.philminton.co.uk \\n\\n--\\n\\nThe Noisy Women Present is a multi-disciplinary creative hub championing diversity and collective virtuosity. Our concerts, workshops and events embrace improvised and experimental music, movement, art and poetry. We believe in individual expression as part of a collaborative, liberating experience.\\n\\nIn 2024 TNWP were awarded a fellowship by the Serpentine Gallery as part of its Support Structures for Support Structures programme. These are awarded to artists at the forefront of social practice, community practice and collaborative working. \\n\\nOur associated ensemble, the Noisy People’s Improvising Orchestra, explores these ideals on a grander scale, and welcomes performers with neuro-diversity and learning differences.\\n\\nPlease get in touch if you’d like to book us for performances and/or workshops.\\n\\nwww.noisywomenpresent.co.uk/\\n\\n-- \\n\\nPoster: Aurelie Freoua&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,2111],&quot;artist_name&quot;:[0,&quot;Noisy Women Present&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2112],&quot;artist_name&quot;:[0,&quot;Feral Choir&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2113],&quot;artist_name&quot;:[0,&quot;Phil Minton&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2126],&quot;artist_name&quot;:[0,&quot;Jenni Roditii&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2172],&quot;artist_name&quot;:[0,&quot;Faradena Afifi&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2173],&quot;artist_name&quot;:[0,&quot;Jo Morrison&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,136],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1THrHlGivx3E4NNy&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,106],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,705],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,100],