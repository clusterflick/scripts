mage on mobile only --> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/692/images/poster/90d698409b13e79b5a917b95e8b40495.webp\" alt=\"GRAIN Presents: Theodora Laird, Mica Levi &#38; Angharad Davies / Brandon Lopez &#38; Caius Williams\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">GRAIN Presents: Theodora Laird, Mica Levi &amp; Angharad Davies / Brandon Lopez &amp; Caius Williams</h1>  </div> <p class=\"text-surface-600 mb-4\"> Wednesday, August 5, 2026 · 7:30 PM – 11:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/17\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> The Horse Hospital </a> <p class=\"text-sm text-surface-600\">Colonnade</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/72\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Theodora Laird </a> <span> · </span> <a href=\"/artists/74\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Caius Williams </a> <span> · </span> <a href=\"/artists/1398\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Angharad Davies </a> <span> · </span> <a href=\"/artists/1798\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Brandon Lopez </a> <span> · </span> <a href=\"/artists/1849\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Mica Levi </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object.fromEntries(Object.entries(t).map(([l,e])=>[l,o(e)]));class y extends HTMLElement{constructor(){super(...arguments);d(this,\"Component\");d(this,\"hydrator\");d(this,\"hydrate\",async()=>{var b;if(!this.hydrator||!this.isConnected)return;let e=(b=this.parentElement)==null?void 0:b.closest(\"astro-island[ssr]\");if(e){e.addEventListener(\"astro:hydrate\",this.hydrate,{once:!0});return}let c=this.querySelectorAll(\"astro-slot\"),n={},h=this.querySelectorAll(\"template[data-astro-template]\");for(let r of h){let s=r.closest(this.tagName);s!=null&&s.isSameNode(this)&&(n[r.getAttribute(\"data-astro-template\")||\"default\"]=r.innerHTML,r.remove())}for(let r of c){let s=r.closest(this.tagName);s!=null&&s.isSameNode(this)&&(n[r.getAttribute(\"name\")||\"default\"]=r.innerHTML)}let p;try{p=this.hasAttribute(\"props\")?m(JSON.parse(this.getAttribute(\"props\"))):{}}catch(r){let s=this.getAttribute(\"component-url\")||\"<unknown>\",v=this.getAttribute(\"component-export\");throw v&&(s+=` (export ${v})`),console.error(`[hydrate] Error parsing props for component ${s}`,this.getAttribute(\"props\"),r),r}let u;await this.hydrator(this)(this.Component,p,n,{client:this.getAttribute(\"client\")}),this.removeAttribute(\"ssr\"),this.dispatchEvent(new CustomEvent(\"astro:hydrate\"))});d(this,\"unmount\",()=>{this.isConnected||this.dispatchEvent(new CustomEvent(\"astro:unmount\"))})}disconnectedCallback(){document.removeEventListener(\"astro:after-swap\",this.unmount),document.addEventListener(\"astro:after-swap\",this.unmount,{once:!0})}connectedCallback(){if(!this.hasAttribute(\"await-children\")||document.readyState===\"interactive\"||document.readyState===\"complete\")this.childrenConnectedCallback();else{let e=()=>{document.removeEventListener(\"DOMContentLoaded\",e),c.disconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"uE2t\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,692],&quot;name&quot;:[0,&quot;GRAIN Presents: Theodora Laird, Mica Levi &amp; Angharad Davies / Brandon Lopez &amp; Caius Williams&quot;],&quot;start_time&quot;:[0,&quot;2026-08-05T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-05T23:00:00Z&quot;],&quot;poster&quot;:[0,&quot;90d698409b13e79b5a917b95e8b40495.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;GRAIN is a concert series and archiving project for experimental and improvised music,  programmed / produced by Caius Williams &amp; Theodora Laird.\\n\\nBrandon Lopez &amp; Caius Williams (duo)\\nTheodora Laird, Mica Levi, Angharad Davies (trio)\\n\\nDoors 7:30, Music 8PM (2 sets with an interval)\\nNO ADMISSION DURING THE SETS\\n\\n\\nBRANDON LOPEZ:\\nis a bassist and composer living in New York City. His work deals with improvisation, finding new sonic possibilities on the double bass.\\n\\nCollaborations with the likes Fred Moten, Gerald Cleaver, John Zorn, The Mat Maneri Quartet, Nate Wooley’s “knknighgh”, Satoko Fuji, Zeena Parkins, Ingrid Laubrock and Tom Rainey, Standing On The Corner, Cecilia Lopez, Ash Fure, Joe Morris, Tyshawn Sorey, and many others.\\n\\nPlaying with the New York Philharmonic 2019 season as a featured soloist with the New York Philharmonic in the premier of Ashley Fure’s “Filament” under the baton of Jaap Van Zweden. His solo work has been featured at the Met Museum in a live collaboration with silent films by directors Stan Brakhage and Germaine Dulac. His collaborative work with Fred Moten and Gerald Cleaver was critically acclaimed by publications of note and won Best of Jazz 2022 in the NYTimes. His most recent solo recording won best of 2023 in the NYC Jazz record. He’s been awarded the Van Lier Fellowship (2018) and Jerome Artist in Residence (2020) at Roulette Intermedium, The Artist in Residence at Issue Project Room (2018), commissions from the Robert D. Bielecki Foundation for the recording of SUN BURNS OUT YOUR EYES (2022), 2023 NYSCA grant for the multimedia piece NADA SAGRADA premiered at the Vision Festival, and an award in 2020 from the Doris Duke Charitable Trust.\\n\\nHe is currently a instructor of improvisation and double bass at the New School for Jazz.\\n\\nCAIUS WILLIAMS:\\nis a musician from London who plays the double bass, guitar, and bass guitar. He works in collaboration with others, alongside various solo projects, often working with improvisation and explorations of resonance, and perception. https://caiuswilliams.bandcamp.com/\\n\\nTHEODORA LAIRD\\nis a vocalist and multidisciplinary artist. Releases under her solo project ‘feeo’ have received critical acclaim. Theodora&#39;s practice has involved in tandem with an interest in situating narratives within freely improvised music, specifically through frequent involvement in the GRAIN residency.\\n\\nANGHARAD DAVIES\\nis a Welsh violinist based in London working with free-improvisation, compositions and performance. Her approach to sound involves attentive listening and exploring beyond the sonic confines of her instrument, her classical training and performance expectation.\\n\\nMICA LEVI\\nis a musician and composer born in Guildford and living in South East London.They use programming software, written notation and improvisation to produce music. &quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,false],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,7],&quot;name&quot;:[0,&quot;performance&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,72],&quot;artist_name&quot;:[0,&quot;Theodora Laird&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,74],&quot;artist_name&quot;:[0,&quot;Caius Williams&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1398],&quot;artist_name&quot;:[0,&quot;Angharad Davies&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1798],&quot;artist_name&quot;:[0,&quot;Brandon Lopez&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1849],&quot;artist_name&quot;:[0,&quot;Mica Levi&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,19],&quot;name&quot;:[0,&quot;GRAIN&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TKAdbGdRnbDoQPr&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,120],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,579],&quot;name&quot;:[0,&quot;Concessions&quot;],&quot;description&quot;:[0,&quot;Low / un-waged, student, UC. If you want to come but ticket prices are a barrier then just get in touch with us&quot;],&quot;price&quot;:[0,8],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_ava