&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,746],&quot;name&quot;:[0,&quot;supporter&quot;],&quot;price&quot;:[0,14],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,40],&quot;quantity_sold&quot;:[0,2],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,261],&quot;name&quot;:[0,&quot;experimental music&quot;]}],[0,{&quot;id&quot;:[0,602],&quot;name&quot;:[0,&quot;electronic music&quot;]}],[0,{&quot;id&quot;:[0,603],&quot;name&quot;:[0,&quot;multigenre&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">What is FOOL?: It started with song shares. Some of us had done School of Song workshops with Brian Eno, AG Cook, Oneohtrix Point Never and Arca, some did one, some did several, but we all ended up in the same room in London afterwards, talking.<br /><br />Some of us have years of experience. Some have never played a show. Some stepped back from the scene out of disillusionment, others are still finding their footing. And we decided to start something, not to fix a big problem, but to add to what others are already building. We need more.<br /><br />FOOL is founded on that premise. Our aim is to go for showcases where the stage is open to those in the collective, wherever we might be in the journey, not just where we’ve already arrived.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/393\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> FOOL Collective </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_