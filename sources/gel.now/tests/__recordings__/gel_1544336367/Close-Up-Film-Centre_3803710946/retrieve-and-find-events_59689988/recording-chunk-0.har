tings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1758,\"artist_name\":\"Jawharp\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1759,\"artist_name\":\"Kunubu\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":7,\"name\":\"psychedelic rock\"},{\"id\":37,\"name\":\"noise\"},{\"id\":71,\"name\":\"metal\"}]},{\"id\":705,\"name\":\"eyes down looking // BINGO @ THE IVY HOUSE\",\"start_time\":\"2026-08-20T19:00:00Z\",\"end_time\":\"2026-08-20T23:00:00Z\",\"poster\":\"e2a80beb79e1eb67665c9aa3e82acaf6.webp\",\"background\":\"\",\"description\":\"Feeling lucky? Eyes down looking ... \\n\\nThe Ivy House gives Blackpool a run for it's money for one night only. Two little ducks, all the fives, it's all to play for. \\n\\nThe night will comprise of 3x games of Bingo, with dazzling prizes to be won, and a bit of a knees up afterwards to dance off all the tension.\\n\\nDobbers and tickets will be provided on the door. \\n\\nTickets £7 / £5 unwaged. \",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":7,\"name\":\"performance\"},{\"id\":9,\"name\":\"workshop\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":8,\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road \",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":347,\"name\":\"Evie Garner\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":601,\"name\":\"Standard\",\"price\":7,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":20,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":602,\"name\":\"Unwaged\",\"price\":5,\"currency\":\"GBP\",\"quantity_available\":20,\"quantity_sold\":3,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":109,\"name\":\"nunhead\"},{\"id\":119,\"name\":\"disco\"},{\"id\":137,\"name\":\"diy\"},{\"id\":372,\"name\":\"70s\"},{\"id\":489,\"name\":\"bingo\"},{\"id\":490,\"name\":\"brockley\"}]},{\"id\":732,\"name\":\"SCOBE 6: BJ Holy / leisure fm / flywheel / scobe collective\",\"start_time\":\"2026-08-20T19:00:00Z\",\"end_time\":\"2026-08-20T23:00:00Z\",\"poster\":\"535f0f1d7760d7c8036b00ea1ceef28c.webp\",\"background\":\"\",\"description\":\"the sixth scobe night - playful and friendly experimental music for freaks and sweethearts \\u003c3\\n\\nthis time with a dream lineup:\\n\\n***\\n\\nBJ Holy:\\n\\nBJ Holy plays flugelhorn and makes music and videos about city life, desire \\u0026 things in between\\n\\n***\\n\\nLeisure FM:\\n\\nleisure fm, a london-based polish twin duo, work with stretched-out beats and basslines, manipulated field recordings and distorted vocals to create murky soundscapes to dissociate to, moving through repetition, rumination, electroclash and broken dance music\\n(¬`‸´¬)♩𖦹 “moody in the club”\\n\\n꩜⋆.°⭑\\n\\nalso co-runners of Polish collective ‘złom’\\n\\n***\\n\\nFlywheel:\\n\\nUK artist flywheel is a musician and producer based in London who has released music with labels including YUKU, Accidental JNR label and Gimme A Break Records. His productions span leftfield techno, ambient and percussive club music. flywheel’s live show is a mess of extension leads and aggro drum machines. His latest EP, ‘Harbinger’ [YUKU] sees flywheel prioritise club-focused sound design, momentum and rhythmic interplay.\\n\\n***\\n\\nscobe collective:\\n\\nscobe resident earnest emo experimental music.\\n\\n\\n7pm onwards\\nno one turned away for lack of funds\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://ra.co/events/2486580\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":325,\"artist_name\":\"leisure fm\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"london-based polish twin electronica duo – leisure fm – utilise stretched-out beats and basslines, manipulated field recordings, and distorted vocals to create murky soundscapes to dissociate to…\\n\\ntheir work explores themes of repetition and rumination, with most tracks composed of loops with sullen lyrics – weaving a loose narrative about esoteric fables, behavioural cycles, and mercurial relationships\\n\\nrecently, they have been exploring capricious electroclash and broken dance music sounds to sulk to…\\n\\n(¬`‸´¬)♩𖦹 “moody in the club”\\n\\n꩜⋆.°⭑\\n\\nwe also co-run ‘złom’ – a polish collective – https://zlom.hotglue.me/\\n\\nhttps://leisurefm.com/\\nhttps://www.instagram.com/leisure.fm/\\nhttps://leisurefm.bandcamp.com/\",\"image\":\"9e1575a1255f36b3dacab22b24ba03f6.webp\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1896,\"artist_name\":\"DJ Holy\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1897,\"artist_name\":\"Flywheel\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1898,\"artist_name\":\"scobe collective\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":3,\"name\":\"Spanners\",\"address\":\"Arch 504, Ridgway Rd\",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":357,\"name\":\"SCOBE\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":8,\"name\":\"experimental\"},{\"id\":13,\"name\":\"electronic\"},{\"id\":165,\"name\":\"live music\"},{\"id\":202,\"name\":\"pop\"}]},{\"id\":845,\"name\":\"FOOL Collective - First Showcase\",\"start_time\":\"2026-08-20T19:00:00Z\",\"end_time\":\"2026-08-20T23:00:00Z\",\"poster\":\"d1651cecf95a4cc00fe40740a9de5771.webp\",\"background\":\"\",\"description\":\"What is FOOL?: It started with song shares. Some of us had done School of Song workshops with Brian Eno, AG Cook, Oneohtrix Point Never and Arca, some did one, some did several, but we all ended up in the same room in London afterwards, talking.\\n\\nSome of us have years of experience. Some have never played a show. Some stepped back from the scene out of disillusionment, others are still finding their footing. And we decided to start something, not to fix a big problem, but to add to what others are already building. We need more.\\n\\nFOOL is founded on that premise. Our aim is to go for showcases where the stage is open to those in the collective, wherever we might be in the journey, not just where we’ve already arrived.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1277,\"artist_name\":\"Valeria Radchenko\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"Valeria Radchenko (they/her) is a singer-songwriter, music producer and multimedia artist based in London. Their music is multi-genre and combines instrumentation with electronic dance music elements, centred around their voice. Exploring sound as a form of touch, Valeria is interested in the emotional potential of electronic music - how it can make us feel things that can’t be felt otherwise or that we didn’t know were within us.\\n\\nValeria organises multimedia and grassroots music events with collectives In-Grid and Are We Home Yet? They have performed \\u0026 DJed across London venues including The Bath House, Ormside Projects and Corsica Studios. In 2024, she received a Help Musicians grant to record and release her first album, VISIONS. “[Valeria’s] music wades into previously unexplored, exciting sonic territories while maintaining a strong sense of grounding and connection to the listener through their honest songwriting, meticulous production and moving performances that feel undoubtedly human” -  Yumé NET, music producer.\\n\\nValeria also works as a composer and sound designer for artists/filmmakers, e.g. scoring April Forrest Lin's 林森 feature film, (Tending) (to) (Ta) and Elinor Rowlands’ film, Retelling of the Wild Woods.\\n\",\"image\":\"de5fd5345ce5d113094a42780dae9150.webp\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2167,\"artist_name\":\"Beuhon\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2168,\"artist_name\":\"Figg Licious\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2169,\"artist_name\":\"OneNineSix\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2170,\"artist_name\":\"Water Lvl\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":18,\"name\":\"Avalon Cafe\",\"address\":\"Unit D, Industrial Estate, Juno Way\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":393,\"name\":\"FOOL Collective\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":744,\"name\":\"low income\",\"price\":6,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":4,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":745,\"name\":\"general admission\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":2,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":746,\"name\":\"supporter\",\"price\":14,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":2,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":261,\"name\":\"experimental music\"},{\"id\":602,\"name\":\"electronic music\"},{\"id\":603,\"name\":\"multigenre\"}]},{\"id\":841,\"name\":\"Deptford Junction Presents: Highstone, Crimson Flame, Faestomp\",\"start_time\":\"2026-08-20T19:30:00Z\",\"end_time\":\"2026-08-20T23:30:00Z\",\"poster\":\"fcac7d2cbd05bd88705a8b206604e3e9.webp\",\"background\":\"\",\"description\":\"Highstone: Highstone are an exciting new band on the London gig circuit. The four-piece draws inspiration from the greats of the ’90s alternative scene - Jeff Buckley, Radiohead, and Nirvana - while also channeling the expansive influence of Pink Floyd and Led Zeppelin. The result is a refreshing, powerful, and almost cinematic sound, brought fully to life through their electrifying live performances.\\n\\nCrimson Flame: Crimson Flame are set to make headlines with their powerhouse singer and rhythm guitarist Chantelle Kimberley and driven by the gritty lead of guitarist Finley White, this duo is making waves in the blues rock scene, tearing up the rules and creating a new era of arena ready blues rock.\\n\\nFaestomp: Faestomp is an East-london singer, songwriter and producer making mellow shuffly rhythms with a stock/MIDI style sound, anchored in pop music.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":true,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2153,\"artist_name\":\"Highstone\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2154,\"artist_name\":\"Crimson Flame\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00: