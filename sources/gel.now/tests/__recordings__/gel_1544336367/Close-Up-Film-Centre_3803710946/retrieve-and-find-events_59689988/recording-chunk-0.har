,&quot;name&quot;:[0,&quot;Koshari &quot;],&quot;start_time&quot;:[0,&quot;2026-07-18T16:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-07-19T04:00:00Z&quot;],&quot;poster&quot;:[0,&quot;d1e8ac122af7625490dbacf9c5694c80.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Remember our parties at the Post Bar? Dancing from sunshine into the early hours? A distant memory since that beloved Tottenham venue shut down suddenly earlier this year, but what if we told you there was a campaign to reopen the Post as a community-run music venue, and that you could contribute to this campaign by... coming to this event?\\n\\nMeet us at @distillery.n17 on 18 July for a classic Koshari day/night party to raise funds for @friendsofpost. We&#39;re really excited to be playing at Distillery for the first time - we&#39;ve got the place from 4-4, and we&#39;ll be joined by a crack team of guest DJs to put fuel on the fire. Don&#39;t miss this one.\\n\\n@sofieok__\\n@izzi_thein\\n@poisonzcora\\n@eda_seyhan&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,677],&quot;artist_name&quot;:[0,&quot;DJ Trigger Happy Ticket Finger&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot