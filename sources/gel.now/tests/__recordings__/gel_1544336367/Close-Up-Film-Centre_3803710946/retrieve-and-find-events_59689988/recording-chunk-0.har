ster/2aa88038b74bdb4a9ead9fc5c5063171.webp\" alt=\"Nyege Nyege presents NAKIBEMBE (Outdoor show)\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Nyege Nyege presents NAKIBEMBE (Outdoor show)</h1>  </div> <p class=\"text-surface-600 mb-4\"> Thursday, July 23, 2026 · 6:00 PM – 9:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/24\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Fox and Firkin </a> <p class=\"text-sm text-surface-600\">316 Lewisham High St</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1712\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Nakibembe Xylophone Troupe </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://foxfirkin.com/event/nyege-nyege-presents-nakibembe-outdoor-show/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Giant Wooden Xylophone – Polyrhythms – Traditional Ugandan Music<br /><br />“A dense tangle of sound, from which distinct melodies, basslines, and rhythms emerge, each musician’s abstract part combining into an entrancing whole.” — Jim Hickson, Songlines<br /><br />The Nakibembe Xylophone Troupe from Uganda performs on the embaire, a giant wooden xylophone played by six musicians, creating hypnotic, joyful music.<br /><br />The troupe has built an international reputation through performances at WOMEX, CTM Festival, Bourse de Commerce (Paris), Holland Festival, Roskilde Festival, Forde Festival (Norway), and more.<br /><br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/296\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Fox and Firkin </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>B