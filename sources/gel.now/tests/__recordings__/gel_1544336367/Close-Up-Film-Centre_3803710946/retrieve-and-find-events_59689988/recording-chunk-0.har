          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "text/html",
            "text": "<!DOCTYPE html><html lang=\"en\" data-theme-id=\"grey\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><link rel=\"shortcut icon\" href=\"/favicon.ico\"><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\"><meta name=\"apple-mobile-web-app-title\" content=\"MyWebSite\"><link rel=\"manifest\" href=\"/site.webmanifest\"><title>TCB - The Toni Cade Bambara School of Organizing</title><meta name=\"description\" content=\"grassroots events london\"><!-- Initialize theme from localStorage immediately to prevent flash --><script>(function(){const themesData = {\"grey\":{\"id\":\"grey\",\"name\":\"Charcoal Granite\",\"background\":\"#f0f0f0\",\"foreground\":\"#2b2b2b\",\"accent\":\"#4c6ef5\"},\"grey-indigo\":{\"id\":\"grey-indigo\",\"name\":\"Grey Indigo\",\"background\":\"#3525a1\",\"foreground\":\"#d6d6d6\",\"accent\":\"#4c6ef5\"},\"coral-chocolate\":{\"id\":\"coral-chocolate\",\"name\":\"Coral Chocolate\",\"background\":\"#45301f\",\"foreground\":\"#ff8a7d\",\"accent\":\"#4c6ef5\"},\"mint-teal\":{\"id\":\"mint-teal\",\"name\":\"Teal Mint\",\"background\":\"#cfffa8\",\"foreground\":\"#284654\",\"accent\":\"#4c6ef5\"},\"lavender-plum\":{\"id\":\"lavender-plum\",\"name\":\"Plum Lavender\",\"background\":\"#fbd6ff\",\"foreground\":\"#442f61\",\"accent\":\"#4c6ef5\"},\"olive-lime\":{\"id\":\"olive-lime\",\"name\":\"Lime Olive\",\"background\":\"#403716\",\"foreground\":\"#a6d636\",\"accent\":\"#4c6ef5\"},\"aqua-night\":{\"id\":\"aqua-night\",\"name\":\"Aqua Night\",\"background\":\"#28384f\",\"foreground\":\"#8fffda\",\"accent\":\"#4c6ef5\"},\"peach-brown\":{\"id\":\"peach-brown\",\"name\":\"Brown Peach\",\"background\":\"#ffa347\",\"foreground\":\"#472c10\",\"accent\":\"#1e3a8a\"}};\n\n      (function () {\n        try {\n          const storedThemeId = localStorage.getItem(\"gel-theme\");\n          let theme;\n\n          // Check if custom theme is selected\n          if (storedThemeId === \"custom\") {\n            const customThemeStr = localStorage.getItem(\"gel-custom-theme\");\n            if (customThemeStr) {\n              const customColors = JSON.parse(customThemeStr);\n              theme = {\n                background: customColors.background,\n                foreground: customColors.foreground,\n                accent: \"#4c6ef5\",\n              };\n            }\n          } else if (storedThemeId && themesData[storedThemeId]) {\n            theme = themesData[storedThemeId];\n          }\n\n          if (theme) {\n            const root = document.documentElement;\n\n            // Update data-theme-id attribute so components can read it\n            root.setAttribute(\"data-theme-id\", storedThemeId);\n\n            // Set base theme colors\n            root.style.setProperty(\"--theme-bg\", theme.background);\n            root.style.setProperty(\"--theme-fg\", theme.foreground);\n            root.style.setProperty(\"--theme-accent\", theme.accent);\n            root.style.setProperty(\n              \"--theme-accent-hover\",\n              `color-mix(in oklch, ${theme.accent} 85%, black 15%)`,\n            );\n\n            // Set color-mix variations\n            root.style.setProperty(\n              \"--theme-fg-950\",\n              `color-mix(in oklch, ${theme.foreground} 100%, ${theme.background} 0%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-900\",\n              `color-mix(in oklch, ${theme.foreground} 90%, ${theme.background} 10%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-800\",\n              `color-mix(in oklch, ${theme.foreground} 80%, ${theme.background} 20%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-700\",\n              `color-mix(in oklch, ${theme.foreground} 70%, ${theme.background} 30%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-600\",\n              `color-mix(in oklch, ${theme.foreground} 60%, ${theme.background} 40%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-500\",\n              `color-mix(in oklch, ${theme.foreground} 50%, ${theme.background} 50%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-400\",\n              `color-mix(in oklch, ${theme.foreground} 40%, ${theme.background} 60%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-300\",\n              `color-mix(in oklch, ${theme.foreground} 30%, ${theme.background} 70%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-200\",\n              `color-mix(in oklch, ${theme.foreground} 20%, ${theme.background} 80%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-100\",\n              `color-mix(in oklch, ${theme.foreground} 10%, ${theme.background} 90%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-50\",\n              `color-mix(in oklch, ${theme.foreground} 5%, ${theme.background} 95%)`,\n            );\n          }\n        } catch (err) {\n          // localStorage not available or error reading, use SSR theme\n        }\n      })();\n    })();</script><link rel=\"stylesheet\" href=\"/_astro/about.DxE5t7jF.css\">\n<style>.ticket{align-items:center;display:flex;flex-direction:column;gap:15px;justify-content:center;padding:15px;width:100%}.ticket img{border-radius:10px;display:block;height:auto;max-width:500px;width:100%}.ticket .download-btn{background-color:#111;border:none;border-radius:8px;color:#f7f7f9;cursor:pointer;font-size:1rem;font-weight:500;padding:12px 24px;transition:background-color .2s ease}.ticket .download-btn:hover{background-color:#333}.ticket .download-btn:active{background-color:#000}.waitlist-modal-overlay{align-items:center;background:#000000b3;display:flex;justify-content:center;inset:0;padding:1rem;position:fixed;z-index:1000}.waitlist-modal{background:#1a1a1a;background:var(--theme-bg,#1a1a1a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:12px;max-width:400px;padding:2rem;position:relative;width:100%}.modal-close{background:none;border:none;color:#888;color:var(--theme-fg-400,#888);cursor:pointer;font-size:1.5rem;line-height:1;padding:.25rem;position:absolute;right:1rem;top:1rem}.modal-close:hover,.waitlist-modal h2{color:#fff;color:var(--theme-fg,#fff)}.waitlist-modal h2{font-size:1.5rem;margin:0 0 .5rem}.waitlist-modal .tier-info{color:#4c6ef5;color:var(--theme-accent,#4c6ef5);font-size:1.125rem;margin-bottom:1rem}.waitlist-description{color:#888;color:var(--theme-fg-400,#888);font-size:.875rem;line-height:1.5;margin-bottom:1.5rem}.waitlist-modal .form-group{margin-bottom:1rem}.waitlist-modal label{color:#fff;color:var(--theme-fg,#fff);display:block;font-size:.875rem;margin-bottom:.5rem}.waitlist-modal input{background:#0a0a0a;background:var(--theme-fg-50,#0a0a0a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:8px;color:#fff;color:var(--theme-fg,#fff);font-size:1rem;padding:.75rem 1rem;width:100%}.waitlist-modal input:focus{border-color:#4c6ef5;border-color:var(--theme-accent,#4c6ef5);outline:none}.waitlist-modal input::-moz-placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal input::placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal .error-message{color:#ff5252;font-size:.875rem;margin-bottom:1rem}.modal-actions{display:flex;gap:1rem;margin-top:1.5rem}.modal-actions button{border-radius:8px;cursor:pointer;flex:1;font-size:1rem;font-weight:500;padding:.75rem 1.5rem;transition:all .2s}.modal-actions .btn-secondary{background:transparent;border:1px solid #333;border:1px solid var(--theme-fg-200,#333);color:#fff;color:var(--theme-fg,#fff)}.modal-actions .btn-secondary:hover:not(:disabled){background:#222;background:var(--theme-fg-100,#222)}.modal-actions .btn-primary{background:#4c6ef5;background:var(--theme-accent,#4c6ef5);border:none;color:#fff}.modal-actions .btn-primary:hover:not(:disabled){background:#4263eb;background:var(--theme-accent-hover,#4263eb)}.modal-actions button:disabled{cursor:not-allowed;opacity:.5}\n</style><script type=\"module\" src=\"/_astro/page.DSySmlfp.js\"></script></head> <body class=\"text-surface-900 min-h-screen font-sans flex flex-col\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <header class=\"site-header sticky top-0 z-30\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <div class=\"site-header__inner\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/\" class=\"site-header__logo\" style=\"color: var(--theme-fg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 241.3\" class=\"site-header__logo-img\" aria-label=\"gel\" role=\"img\"><path d=\"M74.4,165.92c25.83,1.12,30.04-24.56,28.92-55.87-1.54-32.29-2.81-60.08-33.69-60.08-27.09,0-39.87,29.62-38.04,63.03,1.68,27.65,11.23,51.52,42.81,52.92ZM298.43,101.35c38.6.28,57.83-6.04,57.83-24.42,0-21.48-22.6-36.64-51.52-37.06-36.08-.56-57.13,11.79-57.13,32.85,0,16.42,18.95,28.35,50.81,28.64ZM0,113.56C0,61.76,13.62,30.18,53.48,30.18c16.7,0,17.55,1.4,33.41,1.4,18.67,0,33.27-11.37,51.52-11.37s16.14,27.37,33.13,29.9c29.76,4.49,42.25-30.32,122.26-30.32,99.52,0,103.31,41.55,130.4,35.23,25.97-6.18-17.41-55.03,15.44-55.03,26.53,0,33.69,48.29,33.69,83.8,0,41.69-6.74,86.61,4.21,96.86,7.44,6.46,22.46,6.88,22.46,15.72,0,11.93-29.9,14.18-46.18,8.98-27.93-8.98-3.65-60.5-22.46-74.82-15.58-11.79-32,5.19-66.96,5.47-42.53.28-50.53-10.53-81.98-10.53-24.56,0-38.88,12.07-38.88,26.25,0,24.14,25.41,42.11,57.41,42.11,46.74,0,64.71-21.9,85.63-21.9,8.42,0,14.04,3.09,14.04,8.98,0,16.84-37.2,32.99-104.58,32.99-73.13,0-89.14-41.55-118.19-39.02-19.09,1.68-11.93,27.79-23.3,43.09-11.65,15.58-34.25,23.44-72.99,23.3-38.18-.14-73.41-3.93-73.41-20.63,0-6.74,6.88-10.81,17.13-10.81,15.72,0,30.46,13.76,57.83,13.76,34.67,0,30.46-35.09.7-36.92-13.34-.98-29.34,4.21-42.53,2.11C13.48,184.03,0,154.55,0,113.56Z\" fill=\"currentColor\"></path></svg> </a> <nav class=\"site-header__nav flex gap-6 items-end\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/about\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">about</a> <a href=\"/account\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">account</a> </nav> </div> </header>  <main class=\"flex-1\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">  <div class=\"max-w-6xl mx-auto px-4 py-6\"> <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"> <!-- Left: Image only on desktop --> <div class=\"hidden lg:block\"> <img src=\"https://api.gel.now/api/events/719/images/poster/2630e4debc30920886ae647b96136cc0.webp\" alt=\"TCB - The Toni Cade Bambara School of Organizing\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Right panel (desktop) / Main content (mobile) --> <div> <!-- Image on mobile only --> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/719/images/poster/2630e4debc30920886ae647b96136cc0.webp\" alt=\"TCB - The Toni Cade Bambara School of Organizing\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">TCB - The Toni Cade Bambara School of Organizing</h1>  </div> <p class=\"text-surface-600 mb-4\"> Saturday, July 18, 2026 · 2:30 PM – 5:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/143\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Lordship Hub </a> <p class=\"text-sm text-surface-600\">Lordship Rec, Off Higham Road</p> <p class=\"text-sm text-surface-600\">London</p> </div>  <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://www.eventbrite.co.uk/e/tcb-the-toni-cade-bambara-school-of-organizing-registration-1991305021925\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Overview<br />A biography of the Black feminist writer, filmmaker and cultural worker, whose life became a masterclass in art, community, and resistance.<br /><br /><br />TCB - The Toni Cade Bambara School of Organizing (2025, 105 minutes) is a biography of the influential writer, filmmaker and cultural worker, who with humor and deep insight, inspired a generation of artists to dedicate themselves to community empowerment. The film is structured as a series of lessons on cultural organizing, gleaned from Bambara's life and shared by her friends, colleagues and students.<br /><br />This is the second screening of of HCC's Summer Programme Making the Revolution Irresistible.<br /><br />About the film & filmmakers<br /><br />Trailer (on the official film site).<br /><br />AWARDS<br /><br />Best Feature Documentary (Juried)<br />2025 BlackStar Film Festival (USA)<br /><br />Best Feature Documentary (Audience)<br />2025 BlackStar Film Festival (USA)<br /><br />Feature Documentary – Award of Excellence in Creativity<br />2025 Seventh Art Independent International Film Festival (India)<br /><br />Audience Choice Award<br />2026 Seattle Black Film Festival (USA)<br /><br /><br /><br />LOUIS MASSIAH: Director & Producer<br /><br />Louis Massiah is a documentary filmmaker and the founder of the Scribe Video Center in<br /><br />Philadelphia, He has developed production methodologies that assist first time makers author their own stories, including the Precious Places Community History project, a collection of 150 documentaries; Muslim Voices of Philadelphia; The Great Migration - A City Transformed, and The Tenants of Lenapehocking in the Age of Magnets.<br /><br />Massiah’s documentaries include The Bombing of Osage Avenue, W.E.B. Du Bois – A Biography in Four Voices, Cecil B. Moore, two films for the Eyes on the Prize II series, A is for Anarchist, B is for Brown and TCB – The Toni Cade Bambara School of Organizing.<br /><br /><br /><br />MONICA HENRIQUEZ: Director & Editor<br /><br /><br /><br />Monica Henriquez is a Venezuelan/Dutch freelance film and video editor/director, based in the UK since 1978. She trained at the BBC in the 1980s, and worked as an editor for Channel Four (UK) in several projects on Latin America, notably the Marc Karlin Nicaragua Series (1985-1991); Faction Films Fidel (1998). For the U.S. network PBS, she was editor of WEB Du Bois – A Biography in Four Voices (1995), and was researcher/associate producer of The Hugo Chavez Show Frontline (2008). She was Producer/Director of Gynecological Chronicles (1992) and Director/Editor of Murder & the Feather Boa (1996), both for Channel Four UK. Recently she was the Editor/Director with Louis Massiah as Producer/Director of TCB - The Toni Cade Bambara School of Organizing.<br /><br /><br /><br />About our Guest Speakers<br /><br /><br />Dr SM Rodriguez is a scholar-activist and Assistant Professor of Gender, Rights and Human Rights at LSE's Department of Gender Studies. Their research examines the impact of racialisation, criminalisation, ableism, and gendered and sexual control on people of African descent. Their first monograph, The Economies of Queer Inclusion: Transnational Organizing for LGBTI Rights in Uganda (2019), analysed the effects of transnational advocacy on Ugandan LGBTI organising during the period in which Uganda's \"Kill the Gays Bill\" was under consideration.<br /><br />Their current work explores the globalisation of abolitionist feminist praxis and the political processes shaping gender and sexual identification, including the Nonbinary Identity Project. They have also launched Black Queer Movements, a global knowledge-exchange hub for LGBTIQ activists of African descent, and The Black Professors Pipeline, a UK racial equity initiative in higher education.<br /><br /><br /><br />Monica Henriquez is a Venezuelan/Dutch freelance film and video editor/director, based in the UK since 1978. She trained at the BBC in the 1980s, and worked as an editor for Channel Four (UK) in several projects on Latin America, notably the Marc Karlin Nicaragua Series (1985-1991); Faction Films Fidel (1998). For the U.S. network PBS, she was editor of WEB Du Bois – A Biography in Four Voices (1995), and was researcher/associate producer of The Hugo Chavez Show Frontline (2008). She was Producer/Director of Gynecological Chronicles (1992) and Director/Editor of Murder & the Feather Boa (1996), both for Channel Four UK. Recently she was the Editor/Director with Louis Massiah as Producer/Director of TCB - The Toni Cade Bambara School of Organizing.<br /><br />Booking / Waiting List / Cancellation<br /><br /><br />Please only book if you are confident you will be able to attend, as seating at this venue is limited. Due to safety regulations, walk-in entry cannot be guaranteed.<br /><br />The registration form includes a small number of questions collected for reporting purposes. All data will be anonymised. Each attendee is required to complete the form. If you are booking on behalf of someone else and do not know an answer, please enter or select' N/A' where applicable.<br /><br />Due to the venue’s limited capacity, the event may sell out.If this happens, you can be added to the waiting list. When a ticket becomes available, you will receive an email to book it, and you will have 24 hours to complete your booking.<br /><br />If you are unable to attend the event, please cancel your ticket(s) so that your place can be offered to someone else.<br /><br />Why your donations are important?<br /><br />Please read carefully! We’re introducing a Community Pricing to help cover the costs of our events. Choose the ticket tier that best reflects your current circumstances— considering income, housing, caring responsibilities, health, and day-to-day financial pressures. We trust you to choose what feels right. More on this system here.<br /><br />HCC is run by volunteers and does not receive any funding at the moment. Every donation you make will help us to support local venues and to organise other free screenings.<br /><br />In a time of rising living costs and persistent barriers for marginalised communities in producing and accessing films that reflect their experiences and aspirations, we are committed to making our screenings free or pay-what-you-can.<br /><br />About the venue<br /><br />Lordship Hub is a vibrant community centre and café at the heart of Lordship Rec, Tottenham’s largest park. The building is fully accessible, but located inside the park. If you need to be dropped off next to the building's main entrance (with the ramp), please contact us early so we can arrange the park's gate to be open. If you have any accessibility needs or questions, please contact us at haringeycommunitycinema@gmail.com.<br /><br />About HCC<br /><br />Haringey Community Cinema (HCC) was launched in April 2025 and is run by volunteers. Inspired by Brixton Community Cinema, HCC is aimed at bringing residents of Haringey together through film. Our mission is to showcase films that challenge, inspire, and spark critical reflection—films that make us think and act. Visit our website.<br /><br /><br /><br />About Haringey & Tottenham For a Free Palestine<br />Organising in Haringey and Tottenham in solidarity with Palestine. To follow us: Instagram.<br /><br />Covid Policy<br /><br />HCC does not currently have an official COVID-19 policy. However, we remain mindful that many people are still vulnerable to the virus. We kindly ask attendees to take the following precautions to help keep our events safe and accessible for everyone:<br /><br />If possible, please take a lateral flow test before attending.<br />If you test positive or are experiencing any COVID-19 symptoms, please do not attend, even if you feel well.<br />We welcome and encourage the use of masks inside the venue for those who wish to wear them.<br />Please be considerate of others' comfort levels and respect requests for physical distance.<br />Thank you for helping us create a safer and more inclusive space.</div>   </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]