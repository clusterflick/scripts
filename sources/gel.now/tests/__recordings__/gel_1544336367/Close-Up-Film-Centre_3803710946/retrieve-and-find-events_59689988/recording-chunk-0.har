t.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"2jt9Qt\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,842],&quot;name&quot;:[0,&quot;The Video Catalogue: Making and Re-making in Palestine, 2018-2026&quot;],&quot;start_time&quot;:[0,&quot;2026-08-15T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-15T22:00:00Z&quot;],&quot;poster&quot;:[0,&quot;3b89fda76af20c2c0d952aa52fcb65dc.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;An evening of short films followed by a projection of living archival materials with live musical accompaniment, all centred around the genocide in Gaza.\\n\\nAttendees:\\n\\nZoom: Mahdi Atiya Karira, Puppeteer and writer\\n\\nLacking professional training or a local puppetry tradition in the Gaza Strip, Ativa Karira honed his skills by learning from Palestinian artists in Jerusalem and West Bank cultural centers, as well as from experienced Egyptian puppeteers. He takes pride in having been the first to \\&quot;introduce the art of string puppetry to the Gaza Strip.\\&quot; He founded the Khuyut Theatre (\\&quot;Theatre of Strings\\&quot;) in Gaza City, where—prior to the war—he trained around fifteen young people, including twelve women, in the construction and manipulation of string puppets. The troupe created nearly eighty puppets and performed plays written by Mahdi, primarily for young audiences. In addition to his small home workshop, Mahdi worked in a larger space at Holst Park in Gaza City, a site dedicated to children&#39;s education and recreation. In early 2019, Khuyut Theatre garnered international media attention for its ingenuity in repurposing materials despite the blockade—such as extracting pigments from fishing gear to create paints. Over the past two years, his home, scripts, most of his puppets, his sets, and his workshop have been destroyed during repeated bombardments of Gaza.\\n\\nIn-person: Henry Plavidal, producer and editor.\\n\\nPlavidal’s work focuses on social issues, art, and conflict. He has worked in the field of socially engaged and journalistic cinema in numerous countries, addressing diverse subjects and causes, notably in Palestine. As part of a documentary filmmaking team, he has received awards from ARTE and Al Jazeera.\\n\\nThis screening is hosted by The Video Catalogue: an occasional screening series that seeks to bring together archival materials and surprising cinema. @thevideocatalogue\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,5],&quot;name&quot;:[0,&quot;film&quot;]}],[0,{&quot;id&quot;:[0,6],&quot;name&quot;:[0,&quot;theatre&quot;]}],[0,{&quot;id&quot;:[0,7],&quot;name&quot;:[0,&quot;performance&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,2156],&quot;artist_name&quot;:[0,&quot;Mahdi Atiya Karira&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2157],&quot;artist_name&quot;:[0,&quot;Henry Plavidal&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,136],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1THrHlGivx3E4NNy&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,106],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,724],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,12],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,80],&quot;quantity_sold&quot;:[0,25],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,725],&quot;name&quot;:[0,&quot;Unwaged/Student&quot;],&quot;price&quot;:[0,7],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,19],&quot;quantity_sold&quot;:[0,3],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,726],&quot;name&quot;:[0,&quot;Pay-it-forward Ticket&quot;],&quot;description&quot;:[0,&quot;Pay for a ticket for yourself &amp; someone for whom cost is a barrier. &quot;],&quot;price&quot;:[0,24],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,30],&quot;quantity_sold&quot;:[0,7],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,true],&quot;min_price&quot;:[0,15],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,727],&quot;name&quot;:[0,&quot;NOTAFLOF&quot;],&quot;price&quot;:[0,5],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,20],&quot;quantity_sold&quot;:[0,4],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,true],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,22],&quot;name&quot;:[0,&quot;documentary&quot;]}],[0,{&quot;id&quot;:[0,60],&quot;name&quot;:[0,&quot;Palestine&quot;]}],[0,{&quot;id&quot;:[0,155],&quot;name&quot;:[0,&quot;screening&quot;]}],[0,{&quot;id&quot;:[0,225],&quot;name&quot;:[0,&quot;archive&quot;]}],[0,{&quot;id&quot;:[0,250],&quot;name&quot;:[0,&quot;talk&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">An evening of short films followed by a projection of living archival materials with live musical accompaniment, all centred around the genocide in Gaza.<br /><br />Attendees:<br /><br />Zoom: Mahdi Atiya Karira, Puppeteer and writer<br /><br />Lacking professional training or a local puppetry tradition in the Gaza Strip, Ativa Karira honed his skills by learning from Palestinian artists in Jerusalem and West Bank cultural centers, as well as from experienced Egyptian puppeteers. He takes pride in having been the first to \"introduce the art of string puppetry to the Gaza Strip.\" He founded the Khuyut Theatre (\"Theatre of Strings\") in Gaza City, where—prior to the war—he trained around fifteen young people, including twelve women, in the construction and manipulation of string puppets. The troupe created nearly eighty puppets and performed plays written by Mahdi, primarily for young audiences. In addition to his small home workshop, Mahdi worked in a larger space at Holst Park in Gaza City, a site dedicated to children's education and recreation. In early 2019, Khuyut Theatre garnered international media attention for its ingenuity in repurposing materials despite the blockade—such as extracting pigments from fishing gear to create paints. Over the past two years, his home, scripts, most of his puppets, his sets, and his workshop have been destroyed during repeated bombardments of Gaza.<br /><br />In-person: Henry Plavidal, producer and editor.<br /><br />Plavidal’s work focuses on social issues, art, and conflict. He has worked in the field of socially engaged and journalistic cinema in numerous countries, addressing diverse subjects and causes, notably in Palestine. As part of a documentary filmmaking team, he has received awards from ARTE and Al Jazeera.<br /><br />This screening is hosted by The Video Catalogue: an occasional screening series that seeks to bring together archival materials and surprising cinema. @thevideocatalogue<br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/136\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> The Horse Hospital </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layou