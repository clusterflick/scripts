47\",\"foreground\":\"#472c10\",\"accent\":\"#1e3a8a\"}};\n\n      (function () {\n        try {\n          const storedThemeId = localStorage.getItem(\"gel-theme\");\n          let theme;\n\n          // Check if custom theme is selected\n          if (storedThemeId === \"custom\") {\n            const customThemeStr = localStorage.getItem(\"gel-custom-theme\");\n            if (customThemeStr) {\n              const customColors = JSON.parse(customThemeStr);\n              theme = {\n                background: customColors.background,\n                foreground: customColors.foreground,\n                accent: \"#4c6ef5\",\n              };\n            }\n          } else if (storedThemeId && themesData[storedThemeId]) {\n            theme = themesData[storedThemeId];\n          }\n\n          if (theme) {\n            const root = document.documentElement;\n\n            // Update data-theme-id attribute so components can read it\n            root.setAttribute(\"data-theme-id\", storedThemeId);\n\n            // Set base theme colors\n            root.style.setProperty(\"--theme-bg\", theme.background);\n            root.style.setProperty(\"--theme-fg\", theme.foreground);\n            root.style.setProperty(\"--theme-accent\", theme.accent);\n            root.style.setProperty(\n              \"--theme-accent-hover\",\n              `color-mix(in oklch, ${theme.accent} 85%, black 15%)`,\n            );\n\n            // Set color-mix variations\n            root.style.setProperty(\n              \"--theme-fg-950\",\n              `color-mix(in oklch, ${theme.foreground} 100%, ${theme.background} 0%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-900\",\n              `color-mix(in oklch, ${theme.foreground} 90%, ${theme.background} 10%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-800\",\n              `color-mix(in oklch, ${theme.foreground} 80%, ${theme.background} 20%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-700\",\n              `color-mix(in oklch, ${theme.foreground} 70%, ${theme.background} 30%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-600\",\n              `color-mix(in oklch, ${theme.foreground} 60%, ${theme.background} 40%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-500\",\n              `color-mix(in oklch, ${theme.foreground} 50%, ${theme.background} 50%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-400\",\n              `color-mix(in oklch, ${theme.foreground} 40%, ${theme.background} 60%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-300\",\n              `color-mix(in oklch, ${theme.foreground} 30%, ${theme.background} 70%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-200\",\n              `color-mix(in oklch, ${theme.foreground} 20%, ${theme.background} 80%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-100\",\n              `color-mix(in oklch, ${theme.foreground} 10%, ${theme.background} 90%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-50\",\n              `color-mix(in oklch, ${theme.foreground} 5%, ${theme.background} 95%)`,\n            );\n          }\n        } catch (err) {\n          // localStorage not available or error reading, use SSR theme\n        }\n      })();\n    })();</script><link rel=\"stylesheet\" href=\"/_astro/about.DxE5t7jF.css\">\n<style>.ticket{align-items:center;display:flex;flex-direction:column;gap:15px;justify-content:center;padding:15px;width:100%}.ticket img{border-radius:10px;display:block;height:auto;max-width:500px;width:100%}.ticket .download-btn{background-color:#111;border:none;border-radius:8px;color:#f7f7f9;cursor:pointer;font-size:1rem;font-weight:500;padding:12px 24px;transition:background-color .2s ease}.ticket .download-btn:hover{background-color:#333}.ticket .download-btn:active{background-color:#000}.waitlist-modal-overlay{align-items:center;background:#000000b3;display:flex;justify-content:center;inset:0;padding:1rem;position:fixed;z-index:1000}.waitlist-modal{background:#1a1a1a;background:var(--theme-bg,#1a1a1a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:12px;max-width:400px;padding:2rem;position:relative;width:100%}.modal-close{background:none;border:none;color:#888;color:var(--theme-fg-400,#888);cursor:pointer;font-size:1.5rem;line-height:1;padding:.25rem;position:absolute;right:1rem;top:1rem}.modal-close:hover,.waitlist-modal h2{color:#fff;color:var(--theme-fg,#fff)}.waitlist-modal h2{font-size:1.5rem;margin:0 0 .5rem}.waitlist-modal .tier-info{color:#4c6ef5;color:var(--theme-accent,#4c6ef5);font-size:1.125rem;margin-bottom:1rem}.waitlist-description{color:#888;color:var(--theme-fg-400,#888);font-size:.875rem;line-height:1.5;margin-bottom:1.5rem}.waitlist-modal .form-group{margin-bottom:1rem}.waitlist-modal label{color:#fff;color:var(--theme-fg,#fff);display:block;font-size:.875rem;margin-bottom:.5rem}.waitlist-modal input{background:#0a0a0a;background:var(--theme-fg-50,#0a0a0a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:8px;color:#fff;color:var(--theme-fg,#fff);font-size:1rem;padding:.75rem 1rem;width:100%}.waitlist-modal input:focus{border-color:#4c6ef5;border-color:var(--theme-accent,#4c6ef5);outline:none}.waitlist-modal input::-moz-placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal input::placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal .error-message{color:#ff5252;font-size:.875rem;margin-bottom:1rem}.modal-actions{display:flex;gap:1rem;margin-top:1.5rem}.modal-actions button{border-radius:8px;cursor:pointer;flex:1;font-size:1rem;font-weight:500;padding:.75rem 1.5rem;transition:all .2s}.modal-actions .btn-secondary{background:transparent;border:1px solid #333;border:1px solid var(--theme-fg-200,#333);color:#fff;color:var(--theme-fg,#fff)}.modal-actions .btn-secondary:hover:not(:disabled){background:#222;background:var(--theme-fg-100,#222)}.modal-actions .btn-primary{background:#4c6ef5;background:var(--theme-accent,#4c6ef5);border:none;color:#fff}.modal-actions .btn-primary:hover:not(:disabled){background:#4263eb;background:var(--theme-accent-hover,#4263eb)}.modal-actions button:disabled{cursor:not-allowed;opacity:.5}\n</style><script type=\"module\" src=\"/_astro/page.DSySmlfp.js\"></script></head> <body class=\"text-surface-900 min-h-screen font-sans flex flex-col\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <header class=\"site-header sticky top-0 z-30\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <div class=\"site-header__inner\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/\" class=\"site-header__logo\" style=\"color: var(--theme-fg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 241.3\" class=\"site-header__logo-img\" aria-label=\"gel\" role=\"img\"><path d=\"M74.4,165.92c25.83,1.12,30.04-24.56,28.92-55.87-1.54-32.29-2.81-60.08-33.69-60.08-27.09,0-39.87,29.62-38.04,63.03,1.68,27.65,11.23,51.52,42.81,52.92ZM298.43,101.35c38.6.28,57.83-6.04,57.83-24.42,0-21.48-22.6-36.64-51.52-37.06-36.08-.56-57.13,11.79-57.13,32.85,0,16.42,18.95,28.35,50.81,28.64ZM0,113.56C0,61.76,13.62,30.18,53.48,30.18c16.7,0,17.55,1.4,33.41,1.4,18.67,0,33.27-11.37,51.52-11.37s16.14,27.37,33.13,29.9c29.76,4.49,42.25-30.32,122.26-30.32,99.52,0,103.31,41.55,130.4,35.23,25.97-6.18-17.41-55.03,15.44-55.03,26.53,0,33.69,48.29,33.69,83.8,0,41.69-6.74,86.61,4.21,96.86,7.44,6.46,22.46,6.88,22.46,15.72,0,11.93-29.9,14.18-46.18,8.98-27.93-8.98-3.65-60.5-22.46-74.82-15.58-11.79-32,5.19-66.96,5.47-42.53.28-50.53-10.53-81.98-10.53-24.56,0-38.88,12.07-38.88,26.25,0,24.14,25.41,42.11,57.41,42.11,46.74,0,64.71-21.9,85.63-21.9,8.42,0,14.04,3.09,14.04,8.98,0,16.84-37.2,32.99-104.58,32.99-73.13,0-89.14-41.55-118.19-39.02-19.09,1.68-11.93,27.79-23.3,43.09-11.65,15.58-34.25,23.44-72.99,23.3-38.18-.14-73.41-3.93-73.41-20.63,0-6.74,6.88-10.81,17.13-10.81,15.72,0,30.46,13.76,57.83,13.76,34.67,0,30.46-35.09.7-36.92-13.34-.98-29.34,4.21-42.53,2.11C13.48,184.03,0,154.55,0,113.56Z\" fill=\"currentColor\"></path></svg> </a> <nav class=\"site-header__nav flex gap-6 items-end\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/about\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">about</a> <a href=\"/account\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">account</a> </nav> </div> </header>  <main class=\"flex-1\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">  <div class=\"max-w-6xl mx-auto px-4 py-6\"> <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"> <!-- Left: Image only on desktop --> <div class=\"hidden lg:block\"> <img src=\"https://api.gel.now/api/events/879/images/poster/8334b6687d1064400f19a8ba1d823006.webp\" alt=\"Pre-launch • Ambient Sauna | Danniella Dee\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Right panel (desktop) / Main content (mobile) --> <div> <!-- Image on mobile only --> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/879/images/poster/8334b6687d1064400f19a8ba1d823006.webp\" alt=\"Pre-launch • Ambient Sauna | Danniella Dee\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Pre-launch • Ambient Sauna | Danniella Dee</h1>  </div> <p class=\"text-surface-600 mb-4\"> Sunday, August 30, 2026 · 4:00 PM – 8:30 PM </p> <div class=\"mb-6\"> <a href=\"/venues/31\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Sauna Social Club </a> <p class=\"text-sm text-surface-600\">Railway Arch 842 Brayards Road</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/2278\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Danniella Dee </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://tr.ee/8hAwJm9s-B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Pre-launch • Join us for the first weekend in our new venue, just two doors down from the original space you know and love! With the main launch party on Monday 31st, come down early for an exclusive preview and be the first to try out the new setup.<br /><br />For our Sunday pre-launch matinee, we’re excited to welcome Coventry-born and based artist, selector and producer Danniella Dee for an extended dub & reggae session. From singing as a chorister beneath Coventry Cathedral’s vaults to touring as her dad’s roadie with The Specials, she grew up between the worlds of sacred, strict rehearsals and bass-rattling rebellion. Today, alongside writing and producing her own music, she hosts The Baddis Sound on NTS Radio, exploring a deep love of reggae and the stories woven through it.<br /><br />*Book your 70-minute sauna session, arrive early and stay late for 4 hours of music in the lounge*<br /><br />ABOUT AMBIENT SAUNA<br />Our silent Treehouse sauna and the chatty Herbal sauna are both equipped with a sound system for deep listening. Our Bunker sauna, the Tea Loft listening lounge and yard offer a social setting, perfect for a catch up and meeting new friends.<br /><br />ABOUT SAUNA SOCIAL CLUB<br />The Sauna Social Club is London's first dedicated sauna and ambient listening space. We blend saunas and ice baths with ambient music, making the perfect place to relax and recharge. We've grown out of a need for more healthy spaces to listen to great music. Our goal is to create a space that's designed for comfort and wellbeing that doesn't centre around consumption.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/132\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Sauna Social Club </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://www.saunasocialclub.co.uk/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Website </a><a href=\"https://soundcloud.com/sauna-social-club\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Soundcloud </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object.fromEntries(Object.entries(t).map(([l,e])=>[l,o(e)]));class y extends HTMLElement{constructor(){super(...arguments);d(this,\"Component\");d(this,\"hydrator\");d(this,\"hydrate\",async()=>{var b;if(!this.hydrator||!this.isConnected)return;let e=(b=this.parentElement)==null?void 0:b.closest(\"astro-island[ssr]\");if(e){e.addEventListener(\"astro:hydrate\",this.hydrate,{once:!0});return}let c=this.querySelectorAll(\"astro-slot\"),n={},h=this