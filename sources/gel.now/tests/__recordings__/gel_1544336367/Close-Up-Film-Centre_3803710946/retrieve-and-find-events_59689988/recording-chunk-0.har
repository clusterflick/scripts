er:1px solid #333;border:1px solid var(--theme-fg-200,#333);color:#fff;color:var(--theme-fg,#fff)}.modal-actions .btn-secondary:hover:not(:disabled){background:#222;background:var(--theme-fg-100,#222)}.modal-actions .btn-primary{background:#4c6ef5;background:var(--theme-accent,#4c6ef5);border:none;color:#fff}.modal-actions .btn-primary:hover:not(:disabled){background:#4263eb;background:var(--theme-accent-hover,#4263eb)}.modal-actions button:disabled{cursor:not-allowed;opacity:.5}\n</style><script type=\"module\" src=\"/_astro/page.DSySmlfp.js\"></script></head> <body class=\"text-surface-900 min-h-screen font-sans flex flex-col\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <header class=\"site-header sticky top-0 z-30\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <div class=\"site-header__inner\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/\" class=\"site-header__logo\" style=\"color: var(--theme-fg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 241.3\" class=\"site-header__logo-img\" aria-label=\"gel\" role=\"img\"><path d=\"M74.4,165.92c25.83,1.12,30.04-24.56,28.92-55.87-1.54-32.29-2.81-60.08-33.69-60.08-27.09,0-39.87,29.62-38.04,63.03,1.68,27.65,11.23,51.52,42.81,52.92ZM298.43,101.35c38.6.28,57.83-6.04,57.83-24.42,0-21.48-22.6-36.64-51.52-37.06-36.08-.56-57.13,11.79-57.13,32.85,0,16.42,18.95,28.35,50.81,28.64ZM0,113.56C0,61.76,13.62,30.18,53.48,30.18c16.7,0,17.55,1.4,33.41,1.4,18.67,0,33.27-11.37,51.52-11.37s16.14,27.37,33.13,29.9c29.76,4.49,42.25-30.32,122.26-30.32,99.52,0,103.31,41.55,130.4,35.23,25.97-6.18-17.41-55.03,15.44-55.03,26.53,0,33.69,48.29,33.69,83.8,0,41.69-6.74,86.61,4.21,96.86,7.44,6.46,22.46,6.88,22.46,15.72,0,11.93-29.9,14.18-46.18,8.98-27.93-8.98-3.65-60.5-22.46-74.82-15.58-11.79-32,5.19-66.96,5.47-42.53.28-50.53-10.53-81.98-10.53-24.56,0-38.88,12.07-38.88,26.25,0,24.14,25.41,42.11,57.41,42.11,46.74,0,64.71-21.9,85.63-21.9,8.42,0,14.04,3.09,14.04,8.98,0,16.84-37.2,32.99-104.58,32.99-73.13,0-89.14-41.55-118.19-39.02-19.09,1.68-11.93,27.79-23.3,43.09-11.65,15.58-34.25,23.44-72.99,23.3-38.18-.14-73.41-3.93-73.41-20.63,0-6.74,6.88-10.81,17.13-10.81,15.72,0,30.46,13.76,57.83,13.76,34.67,0,30.46-35.09.7-36.92-13.34-.98-29.34,4.21-42.53,2.11C13.48,184.03,0,154.55,0,113.56Z\" fill=\"currentColor\"></path></svg> </a> <nav class=\"site-header__nav flex gap-6 items-end\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/about\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">about</a> <a href=\"/account\" class=\"text-surface-600 hover:text-surface-900 hover:underline\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">account</a> </nav> </div> </header>  <main class=\"flex-1\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\">  <div class=\"max-w-6xl mx-auto px-4 py-6\"> <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\"> <!-- Left: Image only on desktop --> <div class=\"hidden lg:block\"> <img src=\"https://api.gel.now/api/events/650/images/poster/ca001d16e66d5883c301f77f9a1ba45f.webp\" alt=\"Noise Art Workshop\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Right panel (desktop) / Main content (mobile) --> <div> <!-- Image on mobile only --> <div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/650/images/poster/ca001d16e66d5883c301f77f9a1ba45f.webp\" alt=\"Noise Art Workshop\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Noise Art Workshop</h1>  </div> <p class=\"text-surface-600 mb-4\"> Friday, July 24, 2026 · 6:00 PM – 9:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/34\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Pelican House </a> <p class=\"text-sm text-surface-600\">144 Cambridge Heath Road</p> <p class=\"text-sm text-surface-600\">London</p> </div>  <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://www.outsavvy.com/event/37024/noise-art-workshop\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">The workshop is a beginner's intro to creating sound art on Pure Data. The goal is to work towards a basic foundation in generating noise using Pure Data, controlling and altering audio signals using number generators. The workshop aims to provide all the basic skills needed to utilise Pure Data's audio processing functions, and provides a jumping off point for attendees to create their own unique pieces of sound art. As an introduction to Pure Data's as a visual programming language, attendees will learn how to use basic objects such as message objects, bangs and sliders, waveform generators including oscillator, noise and phasor, effects such as low pass filters, as well as writing elements into an array to create visualisations of their waveforms. The final outcome can range from retro beep boop sounds to intense bursts of noise.<br /><br /> <br /><br />Come for two hours of noise, and an hour of music, snacks, and drinks.<br /><br /> <br /><br />Technical requirements:<br />•⁠  ⁠Screen/projector for demonstration<br />•⁠  ⁠Visitors will need to each have a device with Pure Data vanilla downloaded<br />https://puredata.info/downloads/pure-data</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/322\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> KNOTS </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>