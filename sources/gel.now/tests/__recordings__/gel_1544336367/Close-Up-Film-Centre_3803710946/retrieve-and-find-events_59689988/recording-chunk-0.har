(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Z2eTjQA\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,867],&quot;name&quot;:[0,&quot;Ibrahim Alfa Jnr. &amp; feeo&quot;],&quot;start_time&quot;:[0,&quot;2026-08-27T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-27T23:30:00Z&quot;],&quot;poster&quot;:[0,&quot;bb5623d6a6a9d23b79385cc4eb6cb434.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;\\nPresenting a double bill of vanguard techno producer Ibrahim Alfa Jnr. and vocalist and producer feeo at Ormside on Thursday 27th August. Ahead of carnival weekend celebrations and commemorations, we welcome two artists whose practices channel experiences of blackness via the collapsing and re-contextualisation of diasporic music idioms.\\n\\nWelcoming Ibrahim Alfa Jnr. to Ormside for his first UK show in a decade. A 90s veteran of UK techno, Alfa embodies resilience, having overcome serious health issues and systemic obstacles over the past few years. In response, his newest work ‘Infinite Black Inside’ (FO) tenderly serves fractured pulses and bass-heavy experiments, drawing on a full spectrum of radical Black music and a lifetime of experience. Free Jazz meets footwork, techno and dub – filtered through Alfa’s own lens to form a sonic imprint entirely his own, imbued with hope.\\n\\nfeeo is the solo project of London-based artist and vocalist Theodora Laird. Working across electronics, written word and performance – feeo investigates the feedback and tension between personal and political story. In her 2025 debut album ‘Goodness’ (AD93), feeo explores opposing forces of darkness and lightness, delivered via static hum, tape drones and whispers of dance music forms. On the 27th feeo presents a new solo performance at Ormside – her first London show since headlining ICA in February of this year.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,3],&quot;name&quot;:[0,&quot;exhibition&quot;]}],[0,{&quot;id&quot;:[0,5],&quot;name&quot;:[0,&quot;film&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,1639],&quot;artist_name&quot;:[0,&quot;feeo&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2236],&quot;artist_name&quot;:[0,&quot;Ibrahim Alfa&quot;],&quot;