\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":628,\"name\":\"Concession \",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":1,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":629,\"name\":\"Regular\",\"price\":20,\"currency\":\"GBP\",\"quantity_available\":150,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":785,\"name\":\"Dave Bixby, live in London\",\"start_time\":\"2026-09-20T19:00:00Z\",\"end_time\":\"2026-09-20T23:00:00Z\",\"poster\":\"8a84a011f16933297cee0556b933e908.webp\",\"background\":\"\",\"description\":\"life is beautiful records presents the final EU/UK tour for the legendary US folk artist Dave Bixby, known for his acclaimed 1969 album 'Ode to Quetzalcoatl', which garnered him a cult following amongst vinyl collectors and outsider folk aficionados. \\n\\nthe London date of this tour will be the final concert of this tour, Live at St Giles, Camberwell on the 20th September 2026.\\n\\npreluding Bixby's performance will be 'orchestra379', a collective improvisation project, with a fluctuating lineup for each occasion, curated by artist \\u0026 founder of life is beautiful, aloisius. this iteration of orchestra379 shall be specifically curated in honour fittingly for the opening for Dave Bixby's final London show.\\n\\nsoundtracking before \\u0026 between the live performances, will be Zakia Sewell, known for their NTS \\u0026 BBC Radio 6 shows, such as 'Questing' \\u0026 'Dream Time'.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"},{\"id\":7,\"name\":\"performance\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2009,\"artist_name\":\"Dave Bixby\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2010,\"artist_name\":\"orchestra379\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2208,\"artist_name\":\"Zakia Sewell\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":217,\"name\":\"Live at St Giles\",\"address\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":301,\"name\":\"life is beautiful records\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":709,\"name\":\"first release\",\"price\":11,\"currency\":\"GBP\",\"quantity_available\":20,\"quantity_sold\":20,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":1,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":710,\"name\":\"general entry\",\"price\":13,\"currency\":\"GBP\",\"quantity_available\":380,\"quantity_sold\":73,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"depends_on_tier_id\":709,\"dependency_sold_out\":true,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":2,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":890,\"name\":\"Everybody to Kenmure Street - Community Screening with Lewisham Anti Raids\",\"start_time\":\"2026-09-21T18:30:00Z\",\"end_time\":\"2026-09-21T21:26:00Z\",\"poster\":\"22a11b48a4885b45675a09396fdfd67c.webp\",\"background\":\"\",\"description\":\"In May 2021, a UK Home Office dawn raid triggers one of the most spontaneous and successful acts of civil resistance in recent memory. In Pollokshields, Scotland’s most diverse neighbourhood, hundreds of residents rush to the streets to stop the deportation of their neighbours. In today’s increasingly far-right political environment of immigration raids, deportation flights and border violence, Everybody to Kenmure Street is an empowering reminder of the importance of collective action.\\n\\n \\n\\nThe screening will be followed by a casual chat with Lewisham Anti Raids @lewisham_anti_raids on the organising they do in the area, and how you can get involved.\\n\\n \\n\\nAll are welcome, no matter your organising experience! The film is rated 12A.\\n\\n \\n\\nPay What You Can tickets are available from £1-8. This event is part of a series of community screenings around London with local anti raids groups, organised by april forrest lin 林森. All ticket revenue will be donated to Lewisham Anti Raids after event costs have been covered.\\n\\n \\n\\n18:30 - Doors open\\n\\n19:00 - Film screening\\n\\n20:45 - Chat with Lewisham Anti Raids\\n\\n21:00 - Chat ends, space stays open\\n\\n21:30 - Event ends\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://www.outsavvy.com/event/38278/everybody-to-kenmure-street-community-screening-with-lewisham-anti-raids\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":5,\"name\":\"film\"},{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":36,\"name\":\"Piehouse Co-Op\",\"address\":\"213-214 Edward Place\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":155,\"name\":\"screening\"},{\"id\":195,\"name\":\"migrant rights\"},{\"id\":222,\"name\":\"community\"},{\"id\":623,\"name\":\"anti-raids\"},{\"id\":624,\"name\":\"collective action\"}]},{\"id\":846,\"name\":\"The PGs + Gem Stark\",\"start_time\":\"2026-09-22T19:30:00Z\",\"end_time\":\"2026-09-22T23:00:00Z\",\"poster\":\"0a29434e4cac0b36dcb54ab15b16cc7b.webp\",\"background\":\"\",\"description\":\"New Lands is back. New music at your favourite community owned pub. This week from The PGs and Gem Stark.\\n\\nThe PGs are local singers Mary Currie and Alison Craig and musicians Marcus Holdaway, Nick Haeffner. Together they will be playing a selection from Mary, and Gareth Williams’ ( “This Heat”) iconic album from the eighties “Flaming Tunes.” Along with some of their own kickin’songs.\\n\\nGem Stark is a folksinger from the North-West of England now situated in South-East London influenced by Only Connect questions and other such nonsense she doesn’t quite understand. With an antsy fingerstyle guitar and quivering voice, too restless for the country but too lackadaisical for the city, her sincere sensibilities are especially meaningful to anyone that has cried to the hum of a PAT-failed lamp in a second-hand bookshop within a 30-mile radius of the Peak District.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":762,\"artist_name\":\"The PGs\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2171,\"artist_name\":\"Auntie\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":8,\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road \",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":5,\"name\":\"The Ivy House\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":734,\"name\":\"General Admission\",\"price\":7,\"currency\":\"GBP\",\"quantity_available\":150,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":788,\"name\":\"Curbside Lambsear | Stamp Rack | C.Y Charisse\",\"start_time\":\"2026-09-25T19:30:00Z\",\"end_time\":\"2026-09-25T23:00:00Z\",\"poster\":\"ac566a3ae97948823b07d8059acbe3f9.webp\",\"background\":\"\",\"description\":\"Curbside Lambsear explore rough textures and soft intentions, weaving together elements of pop, folk, and improvisation with influences of drone, dub, and post-punk. With a set from Stamp Rack (Daniel S. Evans and Mike O’Malley) and a DJ set from C.Y Charisse.\\n\\n-- \\n\\nCurbside Lambsear is Annabelle Mödlinger and Magdalena McLean. The collaboration explores rough textures and soft intentions, weaving together elements of pop, folk, and improvisation with influences of drone, dub, and post-punk. \\n\\nThe project began as a way for Magdalena and Annabelle to experiment with writing music together, using early sessions to learn new instruments, the process of recording and writing on DAWs. \\n\\nTheir musical output is the result of time spent together in the studio fusing disparate influences into collage; phone notes, little poems written on public transport, field recordings, sample loops, rehearsal voice memos and string melodies merge, realign, and sometimes coalesce into songs.\\n\\n-- \\n\\nStamp Rack is a duo of Mike O’Malley and Daniel S. Evans. \\n\\nMike O’Malley is a guitarist and producer based in London, best known for his work as part of the band caroline.\\n\\nDaniel S. Evans is a multi-instrumentalist and producer based in London. He plays as part of the experimental folk groups Shovel Dance Collective, Sullow, and The Greater London Banjo Trio, and as Meanders in a duo with Jasper Llewellyn.\\n\\n-- \\n\\nC.Y CHARISSE is a London-based music archivist. Working with forgotten records, field recordings, and damaged media, her hybrid DJ sets excavate musical histories, reconstructing fractured identities through the sonic languages of dub, drone, and noise.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1627,\"artist_name\":\"Curbside Lambsear\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2013,\"artist_name\":\"Stamp Rack\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2050,\"artist_name\":\"C.Y Charisse\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":136,\"name\":\"The Horse Hospital\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":682,\"name\":\"General Admission\",\"price\":12,\"currency\":\"GBP\",\"quantity_available\":80,\"quantity_sold\":14,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":683,\"name\":\"Unwaged / Student\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":20,\"quantity_sold\":5,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":684,\"name\":\"Solidarity\",\"price\":14,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":1,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":8,\"name\":\"experimental\"},{\"id\":37,\"name\":\"noise\"},{\"id\":103,\"name\":\"music\"},{\"id\":165,\"name\":\"live music\"},{\"id\":261,\"name\":\"experimental music\"}]},{\"id\":871,\"name\":\"FLOORJAM 008 with MoMA Ready, LORA S, Ellaweez, Ki Pharaoh \\u0026 Damsel\",\"start_time\":\"2026-09-25T23:00:00Z\",\"end_time\":\"2026-09-26T05:00:00Z\",\"poster\":\"7998a06d2240f03dc72f09dc48c276e3.webp\",\"background\":\"\",\"description\":\"FLOORJAM is back with a blazing line up featuring some of the most exciting names in electronic music.\\n\\nOur eight party in the series sees NY-based stalwart MoMA Ready joins us bringing his brilliant take all facets of Black electronic music to the Bermondsey hub that is Ormside Projects.\\n\\nEllaweez joins hot off the back of supporting DJ Bone on his EU tour, alongside London favourite Ki Pharaoh of WA.dgtl and FLOORJAM residents Lora S and Damsel.\\n\\nWe're excited to reconvene with our growing community of dancers.\\n\\n\\\"For the dancers, for the shakers, for the groovers, for the 4am crew. Euphoric cuts on the dancefloor for yours truly.\\\"\\n\\nBY US, FOR US ALL\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://ra.co/events/2499928\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":580,\"artist_name\":\"Damsel\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2248,\"artist_name\":\"MoMA Ready\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2249,\"artist_name\":\"LORA S\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2251,\"artist_name\":\"Ellaweeez\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2252,\"artist_name\":\"Ki Pharoah\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":2,\"name\":\"Ormside Projects\",\"address\":\"Penarth Centre, 32 Ormside Street\",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":53,\"name\":\"Ormside Projects\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":9,\"name\":\"house\"}]},{\"id\":581,\"name\":\"Silhouettes Project\",\"start_time\":\"2026-09-27T13:00:00Z\",\"end_time\":\"2026-09-27T21:00:00Z\",\"poster\":\"1d81eeed1af011e974e83afbd5cfaab9.webp\",\"background\":\"\",\"description\":\"Silhouettes Project is landing at the Fox \\u0026 Firkin.\\n\\nDisrupting the norms of traditional genre and collaborative music-making processes, The Silhouettes Project is a musical collective in the heart of East London’s thriving cultural scene. Masterminded by Jaden Osei-Bonsu (Eerf Evil) and Asher Korner (Asher Kosher), the collective’s Hackney studio and creative hub has become a vital space for artists to connect and create, creating a new blueprint for community, alternative industry structures, and developing top-level talent across the creative arts.  Established through Root 73, a non-profit arts organisation that has quickly morphed into a recording studio, record label and an apprenticeship scheme for young people searching for experience in the industry, The Silhouettes Project’s testament to community, youth and the empowerment of rising voices remains as steady as the rhythms coursing through the music.  Their pioneering, self-sustaining ecosystem has become a notable success story, birthing the beautiful, innovative material that made up their debut album The Silhouettes Project Vol. I. Championing some of the most exciting talents across the UK including ENNY, Bel Cobain, Nix Northwest, Lex Amor and 30 more artists, rappers and producers, the collective earned well over 50M+ streams, critical acclaim across the likes of  The Guardian, Highsnobriety and Clash, and went on to perform Glastonbury and other festivals across Europe.\\n\\nSupported by a grassroots music grant from Arts Council England, helping us continue to champion emerging artists and live music in the community.  All events support Lewisham Donation Hub, a local charity providing vital support to those facing acute hardship across South East London.  The largest pub garden in SE London will have street food, drinks, and a laid-back summer atmosphere. Families are welcome, with free entry for children, market stalls, and activities to keep little ones entertained.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"promoters\":[{\"id\":296,\"name\":\"Fox and Firkin\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":86,\"name\":\"hiphop\"},{\"id\":164,\"name\":\"modern jazz\"},{\"id\":167,\"name\":\"R\\u0026B\"},{\"id\":169,\"name\":\"fusion\"}]},{\"id\":767,\"name\":\"perspectives•\",\"start_time\":\"2026-09-27T15:00:00Z\",\"end_time\":\"2026-09-27T23:00:00Z\",\"poster\":\"ede9e432a7584508a6d6f6e3c6f95a14.webp\",\"background\":\"\",\"description\":\"𝚘𝚗 𝚜𝚞𝚗𝚍𝚊𝚢 𝟸𝟽𝚝𝚑 𝚜𝚎𝚙𝚝𝚎𝚖𝚋𝚎𝚛, 𝚙𝚎𝚛𝚜𝚙𝚎𝚌𝚝𝚒𝚟𝚎𝚜• 𝚙𝚛𝚎𝚜𝚎𝚗𝚝𝚜 𝚊 𝚍𝚊𝚢𝚝𝚒𝚖𝚎 𝚊𝚞𝚍𝚒𝚘-𝚟𝚒𝚜𝚞𝚊𝚕 𝚎𝚡𝚙𝚎𝚛𝚒𝚎𝚗𝚌𝚎 𝚊𝚝 𝚌𝚕𝚞𝚋 𝚌𝚑𝚎𝚎𝚔, 𝚋𝚛𝚒𝚡𝚝𝚘𝚗.\\n\\n𝚙𝚎𝚛𝚜𝚙𝚎𝚌𝚝𝚒𝚟𝚎𝚜• 𝚖𝚘𝚟𝚎𝚜 𝚋𝚎𝚢𝚘𝚗𝚍 𝚝𝚑𝚎 𝚌𝚘𝚗𝚟𝚎𝚗𝚝𝚒𝚘𝚗𝚊𝚕 𝚍𝚊𝚗𝚌𝚎𝚏𝚕𝚘𝚘𝚛, 𝚌𝚘𝚖𝚋𝚒𝚗𝚒𝚗𝚐 𝚒𝚖𝚖𝚎𝚛𝚜𝚒𝚟𝚎 𝚜𝚙𝚊𝚝𝚒𝚊𝚕 𝚍𝚎𝚜𝚒𝚐𝚗 𝚠𝚒𝚝𝚑 𝚏𝚘𝚛𝚠𝚊𝚛𝚍-𝚝𝚑𝚒𝚗𝚔𝚒𝚗𝚐 𝚜𝚘𝚞𝚗𝚍 𝚍𝚎𝚜𝚒𝚐𝚗𝚜 𝚊𝚗𝚍 𝚕𝚒𝚟𝚎 𝚎𝚡𝚙𝚎𝚛𝚒𝚎𝚗𝚌𝚎𝚜, 𝚏𝚎𝚊𝚝𝚞𝚛𝚒𝚗𝚐 𝚍𝚎𝚋𝚞𝚝 𝚙𝚎𝚛𝚏𝚘𝚛𝚖𝚊𝚗𝚌𝚎𝚜 𝚏𝚛𝚘𝚖 𝚒𝚗𝚝𝚎𝚛𝚗𝚊𝚝𝚒𝚘𝚗𝚊𝚕 𝚕𝚒𝚟𝚎 𝚊𝚛𝚝𝚒𝚜𝚝𝚜 𝚊𝚗𝚍 𝚊 𝚌𝚞𝚜𝚝𝚘𝚖 𝚕𝚒𝚐𝚑𝚝𝚒𝚗𝚐 𝚒𝚗𝚜𝚝𝚊𝚕𝚕𝚊𝚝𝚒𝚘𝚗.\\n\\n𝚠𝚎 𝚠𝚒𝚕𝚕 𝚋𝚎 𝚓𝚘𝚒𝚗𝚎𝚍 𝚋𝚢 𝚝𝚑𝚎 𝚏𝚘𝚕𝚕𝚘𝚠𝚒𝚗𝚐 𝚊𝚛𝚝𝚒𝚜𝚝𝚜:\\n\\n• 𝚝𝚎𝚖𝚙𝚕𝚎 𝚛𝚊𝚝 [𝚕𝚒𝚟𝚎]\\n• 𝚏𝚘𝚛𝚎𝚜𝚝\\n• 𝚊𝚕𝚒𝚌𝚒𝚊\\n• 𝚎𝚗𝚊 𝚋. [𝚕𝚒𝚟𝚎]\\n• 𝙰𝙽𝙽𝚇 \\n\\n𝚠𝚒𝚝𝚑 𝚕𝚒𝚐𝚑𝚝𝚒𝚗𝚐 \\u0026 𝚜𝚙𝚊𝚝𝚒𝚊𝚕 𝚍𝚎𝚜𝚒𝚐𝚗 𝚋𝚢 𝚖𝚎𝚝𝚊𝚕 𝚞𝚙𝚊, 𝚗𝚒𝚌𝚘𝚕𝚎 𝚐𝚘𝚛𝚍𝚘𝚗 + 𝚜𝚎𝚊 𝚑𝚘\\n\\n𝚊𝚛𝚝𝚠𝚘𝚛𝚔 𝚋𝚢 @𝚍𝚎𝚎𝚋_𝚊𝚑 •\\n\\n𝚙𝚎𝚛𝚜𝚙𝚎𝚌𝚝𝚒𝚟𝚎𝚜• 𝚒𝚜 𝚜𝚞𝚙𝚙𝚘𝚛𝚝𝚎𝚍 𝚋𝚢 𝚝𝚑𝚎 𝚎𝚊𝚛𝚕𝚢 𝚌𝚊𝚛𝚎𝚎𝚛 𝚙𝚛𝚘𝚖𝚘𝚝𝚎𝚛 𝚏𝚞𝚗𝚍 𝚠𝚑𝚒𝚌𝚑 𝚒𝚜 𝚖𝚊𝚗𝚊𝚐𝚎𝚍 𝚋𝚢 𝚙𝚛𝚜 𝚏𝚘𝚞𝚗𝚍𝚊𝚝𝚒𝚘𝚗 𝚊𝚗𝚍 𝚏𝚞𝚗𝚍𝚎𝚍 𝚋𝚢 𝚊𝚛𝚝𝚜 𝚌𝚘𝚞𝚗𝚌𝚒𝚕 𝚎𝚗𝚐𝚕𝚊𝚗𝚍 𝚞𝚜𝚒𝚗𝚐 𝚜𝚞𝚙𝚙𝚘𝚛𝚝𝚒𝚗𝚐 𝚐𝚛𝚊𝚜𝚜𝚛𝚘𝚘𝚝𝚜 𝚖𝚞𝚜𝚒𝚌 𝚏𝚞𝚗𝚍𝚒𝚗𝚐 𝚏𝚛𝚘𝚖 𝚍𝚌𝚖𝚜.\\n\\n𝚌𝚞𝚛𝚊𝚝𝚎𝚍 𝚋𝚢 𝚊𝚗𝚗𝚡 𝚊𝚗𝚍 𝚗𝚒𝚌𝚘𝚕𝚎 𝚐𝚘𝚛𝚍𝚘𝚗.\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":7,\"name\":\"performance\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":21,\"name\":\"Club Cheek\",\"address\":\"302-304 Barrington Rd\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":341,\"name\":\"perspectives•\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":665,\"name\":\"Low wage\",\"price\":12,\"currency\":\"GBP\",\"quantity_available\":10,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":true,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":666,\"name\":\"Early bird\",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":10,\"quantity_sold\":10,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":667,\"name\":\"1st Release\",\"price\":18,\"currency\":\"GBP\",\"quantity_available\":15,\"quantity_sold\":6,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":668,\"name\":\"Final Release\",\"price\":20,\"currency\":\"GBP\",\"quantity_available\":120,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":8,\"name\":\"experimental\"},{\"id\":10,\"name\":\"techno\"},{\"id\":210,\"name\":\"dub techno\"},{\"id\":314,\"name\":\"installation\"},{\"id\":384,\"name\":\"audiovisual\"},{\"id\":548,\"name\":\"live\"}]},{\"id\":893,\"name\":\"Out Of Body Pop 10\",\"start_time\":\"2026-10-04T12:00:00Z\",\"end_time\":\"2026-10-04T20:30:00Z\",\"poster\":\"014fdb46115745d154d6232613ab5481.webp\",\"background\":\"\",\"description\":\"Our 10th party is here!\\n\\nWe ran oobp1 on 13.09.2020 - a time when we couldn't dance, but we could still paint and be together. \\n\\nWe have kept working to make a day party that gives our people what they want. Gathering a wide variety of feedback, bringing elements in and out, finessing an event format that we call ‘neuro-inclusive’.\\n\\nAt oobp10 you will have the freedom to move between distinct spaces, with distinct activities. \\nBetween loudness and quietness. \\nBetween dark walls covered in projections and bright walls that you decorate with our free art materials.\\nDrink drinks.\\nEat pizza. \\nLet your creativity flow with our paintbrushes, or follow the meditative process of knotting paracord. \\nExist between the space, the street, and the canal (we allow re-entry).\\n\\nThe dancefloor will host DJs who have kept oobp alive over the years, not least Don Sinini, our resident wavey emo dancehall don, and Will Soer aka dj dyspraxic/ \\\"dis swag’s sick!\\\", our founder (he did the first oobp radio show on 18.10.2016). \\n\\nWe will also have 2 x dj+dj pairs coming over from 2 other events that we love...\\n...from The Surfers Club we've got PrettyBoyRio+Raidaa, bringing neo soul, uptempo r’n’b, hip hop, inviting us to ride the wave...\\n...from Bodyswap we have Harietta+Eli La Nuit, bringing Dancey Synths’n’more from Dalston Superstore, where they play futurist music (and oobp pillars) from Frank Ocean to Sophie.\\n\\nCome and find your flow.\\n\\n...\\n\\n\\nWHAT YOU CAN EXPECT\\n\\n(the link for our venue map and Instagram account is at the bottom of this page)\\n\\n1. a low-lit indoor Dancefloor with DJ sets, projected visuals and no flashing lights. Each set has a distinct sonic theme, see set times above!\\n\\n2. a covered, outdoor Painting + Social Area paints and art tools provided for everyone, plus the guided, meditative sensory activity of knotting\\n\\n3. a bar with alcohol and non-alc options, plus pizza on sale inside the venue (inc vegan options) until 18:00\\n\\n4. from 15:00 onwards we will have a Quiet area in the HWK cafe space, where you can paint or use one of our colouring-in books without conversation\\n\\n5. re-entry is allowed all day\\nHWK is 5 mins walk from the canal, if you want to literally touch grass then walk past Barge East\\nwe're also 10 mins walk from the V\\u0026A storehouse which is free and very cool\\n\\n6. genderless toilets and no-tolerance of harassment - we ask that you respect each other's space and think about those around you, especially if you’re a big guy with a loud voice like our founder Will!\\n\\n7. any profits from the event will go to Arts Emergency, a charity that helps young people from underprivileged backgrounds get into the arts\\n\\n…\\n\\nWe want to actively include people, and build a more ideal space for everyone, together.\\n\\nBeing neuro-inclusive doesn't mean that we're only focused on serving neurodivergent people or that we are fully accessible for everyone, but we will always work to improve the accessibility of OOBP in attainable ways as we develop. For a more deeply accessible, differentiated experience, we'd recommend checking out Disco Neurotico (for example, they run events with silent disco technology to avoid sensory overwhelm on the dancefloor)\\n\\nIf you have any questions for us in the runnup to the event, please message our @outofbodypop instagram account.\\n\\nOur music policy is wide but specific; we want to look forwards, exploring experimental but accessible sounds, music that’s fun and interesting, which you don’t tend to hear in clubs. Syncopated rhythms and big chords in all sorts of different forms.\\n\\nWe will be offering free paints and art tools for everyone to use, including a mix of white and pastel-coloured paper.\\n\\nWe are happy for you to take photos or videos, there will be lots of cute visual things to look at! We just ask that you keep it within reason (especially on the dancefloor) and the OOBP team will do the same; we have team members who we know are happy to be filmed, we won’t stand around at the side of the dancefloor filming everyone else or get up in their face with a DSLR when they’re dancing.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":2,\"name\":\"gig\"},{\"id\":9,\"name\":\"workshop\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":668,\"artist_name\":\"Rosy Ross\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":943,\"artist_name\":\"RAIDAA\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2290,\"artist_name\":\"Don Sinini\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2291,\"artist_name\":\"PrettyBoyRio\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2292,\"artist_name\":\"OPKD\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2293,\"artist_name\":\"Eli La Nuit\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2294,\"artist_name\":\"Harietta\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2295,\"artist_name\":\"Will Soer\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2296,\"artist_name\":\"Haig\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2297,\"artist_name\":\"Angus\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2298,\"artist_name\":\"DJeddy\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2299,\"artist_name\":\"Tem\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":70,\"name\":\"HWK London\",\"address\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":102,\"name\":\"Out Of Body Pop\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":96,\"name\":\"out of body pop\"}]},{\"id\":882,\"name\":\"Sienna Melella + antematterz\",\"start_time\":\"2026-10-06T19:30:00Z\",\"end_time\":\"2026-10-06T22:00:00Z\",\"poster\":\"eac2156ed30293d347886ae6300050d7.webp\",\"background\":\"\",\"description\":\"New Lands returns to The Ivy House with Sienna Mellella + antematterz.\\nSienna Melella, singer-songwriter, London.\\nantematterz is the solo project of Lucas Souza, who began releasing music under this name in November 2020. Since then, the artist has been building a solid and coherent career, which also involved co-creating the band roadkill, a project that allowed him to explore new creative dynamics and mature as a musician.\\nOver the past six years, antematterz has dedicated his time to developing his second album, Giving up The Blade, a work that reflects this artistic evolution and where the influences that shape his sound identity are clearly audible, from Bright Eyes to Death Cab for Cutie, passing through the vocal melodies of Big Thief. The result is a sound that crosses the intimacy of Indie Folk with electronic elements, transporting us to an introspective and emotional universe, built with time and intention.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2280,\"artist_name\":\"sienna melella\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2281,\"artist_name\":\"antematterz\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":8,\"name\":\"The Ivy House\",\"address\":\"40 Stuart Road \",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":5,\"name\":\"The Ivy House\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":791,\"name\":\"General Admission\",\"price\":7,\"currency\":\"GBP\",\"quantity_available\":136,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":122,\"name\":\"folk\"},{\"id\":140,\"name\":\"Indie\"},{\"id\":166,\"name\":\"alternative-folk\"}]},{\"id\":821,\"name\":\"DEAFKIDS, KOMBI \\u0026 Brava | Real Life Presents\",\"start_time\":\"2026-10-20T18:00:00Z\",\"end_time\":\"2026-10-20T22:30:00Z\",\"poster\":\"40fa064f491d9acbeae4b5fe7b8bcec7.webp\",\"background\":\"\",\"description\":\"New Cross Live Presents\\n\\nDeaf Kids\\nBrazilian legends blending the raw spirit of noise punk, global rhythms and experimental electronics into a sonic assault since 2010. Armed with a brand new album 'Cicatrizes Do Futuro' they're here to shake London to the ground.\\n\\nKombi\\nAmbient drones by Joao of TEST\\n\\nBrava\\nOutsider house music with a hardcore MC, LDN via San Sebastian\\n\\nTuesday 20th October\\nNew Cross Inn, Nearest stations New Cross Gate and New Cross\\nDoors 6pm\\n£17\\n14+, u16s with an adult 18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/deaf-kids\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2108,\"artist_name\":\"DEAFKIDS\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2109,\"artist_name\":\"KOMBI\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2110,\"artist_name\":\"Brava\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":9,\"name\":\"house\"},{\"id\":13,\"name\":\"electronic\"},{\"id\":37,\"name\":\"noise\"},{\"id\":71,\"name\":\"metal\"},{\"id\":73,\"name\":\"South London\"},{\"id\":123,\"name\":\"brazilian\"},{\"id\":149,\"name\":\"live electronic\"},{\"id\":409,\"name\":\"globalmusic\"}]},{\"id\":847,\"name\":\"The TEJ Quartet + arps \\u0026 Big Oil\",\"start_time\":\"2026-10-20T19:30:00Z\",\"end_time\":\"2026-10-20T23:00:00Z\",\"poster\":\"71b995c7e8d869e23928bcf0c5ec977a.webp\",\"background\":\"\",\"description\":\"An entirely instrumental special edition of New Lands! \\n\\nThe TEJ Quartet is built around the idiosyncratic and hypnozting guitar work of Toby Evans-Jesra (Lobby, Leather.head, Piglet). He is joined by three incredible guitarists who symphonise and explore every sonic space between quiet and loud, between jarring and joy. \\n\\nAlso performing will be arps \\u0026 Big Oil, who will be debuting a very special live collaboration, merging arps' lush, ambient, amphibian-infused dreamscapes and Big Oil's primitive-inspired fingerpicked guitar.\",\"is_featured\":false,\"poster_small\":\"\",\"is_pr