//api.gel.now/api/events/823/images/poster/1f7114f8d142f4c3c05c522e32abb8a8.webp\" alt=\"Noisy Women Present | Phil Minton's Almost Instant Feral Choir\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Noisy Women Present | Phil Minton&#39;s Almost Instant Feral Choir</h1>  </div> <p class=\"text-surface-600 mb-4\"> Thursday, August 6, 2026 · 7:30 PM – 10:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/17\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> The Horse Hospital </a> <p class=\"text-sm text-surface-600\">Colonnade</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/2111\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Noisy Women Present </a> <span> · </span> <a href=\"/artists/2112\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Feral Choir </a> <span> · </span> <a href=\"/artists/2113\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Phil Minton </a> <span> · </span> <a href=\"/artists/2126\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Jenni Roditii </a> <span> · </span> <a href=\"/artists/2172\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Faradena Afifi </a> <span> · </span> <a href=\"/artists/2173\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Jo Morrison </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;v