ster/283b6a5f96330153f6b1882cdaad3f0e.webp\" alt=\"Threshold Houseboys Choir: Form Grows Rampant\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Threshold Houseboys Choir: Form Grows Rampant</h1>  </div> <p class=\"text-surface-600 mb-4\"> Saturday, August 29, 2026 · 7:30 PM – 10:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/17\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> The Horse Hospital </a> <p class=\"text-sm text-surface-600\">Colonnade</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/2197\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Peter Christopherson </a> <span> · </span> <a href=\"/artists/2198\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Coil </a> <span> · </span> <a href=\"/artists/2199\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Threshold Houseboys Choir </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object.fromEntries(Object.entries(t).map(([l,e])=>[l,o(e)]));class y extends HTMLElement{constructor(){super(...arguments);d(this,\"Component\");d(this,\"hydrator\");d(this,\"hydrate\",async()=>{var b;if(!this.hydrator||!this.isConnected)return;let e=(b=this.parentElement)==null?void 0:b.closest(\"astro-island[ssr]\");if(e){e.addEventListener(\"astro:hydrate\",this.hydrate,{once:!0});return}let c=this.querySelectorAll(\"astro-slot\"),n={},h=this.querySelectorAll(\"template[data-astro-template]\");for(let r of h){let s=r.closest(this.tagName);s!=null&&s.isSameNode(this)&&(n[r.getAttribute(\"data-astro-template\")||\"default\"]=r.innerHTML,r.remove())}for(let r of c){let s=r.closest(this.tagName);s!=null&&s.isSameNode(this)&&(n[r.getAttribute(\"name\")||\"default\"]=r.innerHTML)}let p;try{p=this.hasAttribute(\"props\")?m(JSON.parse(this.getAttribute(\"props\"))):{}}catch(r){let s=this.getAttribute(\"component-url\")||\"<unknown>\",v=this.getAttribute(\"component-export\");throw v&&(s+=` (export ${v})`),console.error(`[hydrate] Error parsing props for component ${s}`,this.getAttribute(\"props\"),r),r}let u;await this.hydrator(this)(this.Component,p,n,{client:this.getAttribute(\"client\")}),this.removeAttribute(\"ssr\"),this.dispatchEvent(new CustomEvent(\"astro:hydrate\"))});d(this,\"unmount\",()=>{this.isConnected||this.dispatchEvent(new CustomEvent(\"astro:unmount\"))})}disconnectedCallback(){document.removeEventListener(\"astro:after-swap\",this.unmount),document.addEventListener(\"astro:after-swap\",this.unmount,{once:!0})}connectedCallback(){if(!this.hasAttribute(\"await-children\")||document.readyState===\"interactive\"||document.readyState===\"complete\")this.childrenConnectedCallback();else{let e=()=>{document.removeEventListener(\"DOMContentLoaded\",e),c.disconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Z1LOanE\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,852],&quot;name&quot;:[0,&quot;Threshold Houseboys Choir: Form Grows Rampant&quot;],&quot;start_time&quot;:[0,&quot;2026-08-29T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-29T22:00:00Z&quot;],&quot;poster&quot;:[0,&quot;283b6a5f96330153f6b1882cdaad3f0e.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;A very rare screening of the now out of print DVD film of Peter Christopherson’s solo project ‘Threshold Houseboys Choir’ Form Grows Rampant.\\n\\n\\&quot;In 2003 I was invited to attend the Ginjae Festival in Krabi Town in the south of Thailand. Ginjae literally means vegetarian, though the connection is obscure. \\n\\nThe major celebrations of this festival take place on the nearby island of Phuket, but there, the atmosphere is one of spectacle, rather than purpose. I had been told about a very different celebration, based around a small chinese shrine or holy place, behind a Toyota dealership in Krabi Town, some 50 kilometres from Phuket island, on the mainland. The Ginjae Festival takes place on the 9th full moon of the year. Over the course of ten days (during which participants wear white and abstain from meat, alcohol and sex) a series of rituals are performed. intended to keep the world spinning on the correct axis. To bring merit and good luck to the village, and to scare away malign spirits that might otherwise bring misfortune to the neighbourhood; especially at busy intersections, accident black spots, etc... \\n\\nThe participants setting out from the shrine we visited were all young men, led by a young &#39;khatoey\\&quot; holy man. For the most part they were tattooed tearaways or troublemakers and not the kind of person you would expect to see the local shop-keepers on their knees praying to by the side of the road. In all cases that I witnessed, the rituals were carried out while the participants were in trance or possessed states; often lasting several hours. The boys were trained in, and induced into these states by their holy man, in whom they had complete trust. \\n\\nRemoved from immediate contact with the present by these mental states, the boys seemed not to feel pain. Though as their expressions show, this was not always the case when the trance weakened. Their trances also assisted their speedy recovery - along with the ice-water that their assistants poured on their wounds from kettles throughout the ritual. I saw most of these boys in the days that followed and they appeared to have suffered no ill-effects. and indeed to be almost completely scar free. Certainly emotionally they seemed buoyed by events, as did the worshippers in the neighbourhoods they passed through. \\n\\nBy contrast I was admitted to hospital for several days, suffering from some undiagnosed disorder, which I ascribe to temporarily becoming inadvertent host to one of the evil spirits that their rituals disturbed. \\n\\nIn this work my interpretation of the rituals - my focus and my music - ape entirely personal, and not directly connected to purpose of the Ginjae Festival. I simply believe I saw and filmed something profound, transcendent; the deity incarnate even; in the most unlikely of settings and want to share that with you. \\n\\nAs Jhonn said: \\&quot;We all get the gods we deserve...\\&quot;\\n\\n- Peter Christopherson Bangkok January 3rd 2007\\n\\nScreening starts at 8:30pm.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,false],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,5],&quot;name&quot;:[0,&quot;film&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,2197],&quot;artist_name&quot;:[0,&quot;Peter Christopherson&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2198],&quot;artist_name&quot;:[0,&quot;Coil&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2199],&quot;artist_name&quot;:[0,&quot;Threshold Houseboys Choir&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,136],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1THrHlGivx3E4NNy&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,106],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,752],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,90],&quot;quantity_sold&quot;:[0,3],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,1443],&quot;url&quot;:[0,&quot; https://www.youtube.com/watch?v=sVYQ8ZQ467Y&quot;],&quot;display_title&quot;:[0,&quot;Form Grows Rampant - Trailer&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-08-07T11:31:35.509108Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-07T11:31:35.509108Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,607],&quot;name&quot;:[0,&quot;coil&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">A very rare screening of the now out of print DVD film of Peter Christopherson’s solo project ‘Threshold Houseboys Choir’ Form Grows Rampant.<br /><br />\"In 2003 I was invited to attend the Ginjae Festival in Krabi Town in the south of Thailand. Ginjae literally means vegetarian, though the connection is obscure. <br /><br />The major celebrations of this festival take place on the nearby island of Phuket, but there, the atmosphere is one of spectacle, rather than purpose. I had been told about a very different celebration, based around a small chinese shrine or holy place, behind a Toyota dealership in Krabi Town, some 50 kilometres from Phuket island, on the mainland. The Ginjae Festival takes place on the 9th full moon of the year. Over the course of ten days (during which participants wear white and abstain from meat, alcohol and sex) a series of rituals are performed. intended to keep the world spinning on the correct axis. To bring merit and good luck to the village, and to scare away malign spirits that might otherwise bring misfortune to the neighbourhood; especially at busy intersections, accident black spots, etc... <br /><br />The participants setting out from the shrine we visited were all young men, led by a young 'khatoey\" holy man. For the most part they were tattooed tearaways or troublemakers and not the kind of person you would expect to see the local shop-keepers on their knees praying to by the side of the road. In all cases that I witnessed, the rituals were carried out while the participants were in trance or possessed states; often lasting several hours. The boys were trained in, and induced into these states by their holy man, in whom they had complete trust. <br /><br />Removed from immediate contact with the present by these mental states, the boys seemed not to feel pain. Though as their expressions show, this was not always the case when the trance weakened. Their trances also assisted their speedy recovery - along with the ice-water that their assistants poured on their wounds from kettles throughout the ritual. I saw most of these boys in the days that followed and they appeared to have suffered no ill-effects. and indeed to be almost completely scar free. Certainly emotionally they seemed buoyed by events, as did the worshippers in the neighbourhoods they passed through. <br /><br />By contrast I was admitted to hospital for several days, suffering from some undiagnosed disorder, which I ascribe to temporarily becoming inadvertent host to one of the evil spirits that their rituals disturbed. <br /><br />In this work my interpretation of the rituals - my focus and my music - ape entirely personal, and not directly connected to purpose of the Ginjae Festival. I simply believe I saw and filmed something profound, transcendent; the deity incarnate even; in the most unlikely of settings and want to share that with you. <br /><br />As Jhonn said: \"We all get the gods we deserve...\"<br /><br />- Peter Christopherson Bangkok January 3rd 2007<br /><br />Screening starts at 8:30pm.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/136\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> The Horse Hospital </a>  </p> <div class=\"mt-6\">  <div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Form Grows Rampant - Trailer </p> <iframe\n    width=\"100%\"\n    height=\"315\"\n    src=\"https://www.youtube.com/embed/sVYQ8ZQ467Y\"\n    frameborder=\"0\"\n    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n    allowfullscreen\n  ></iframe> </div> </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-90