disconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"Z1qQYqz\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,544],&quot;name&quot;:[0,&quot;Abigail Toll | Seán Being / Oliver Turvey (viola duo) | Flynn McHardy&quot;],&quot;start_time&quot;:[0,&quot;2026-07-26T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-07-26T22:30:00Z&quot;],&quot;poster&quot;:[0,&quot;18305efea72f54f20eb0c73c75e4df0b.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;An evening of experimental music from the sound artist and composer Abigail Toll, a viola duo comprised of Seán Being and Oliver Turvey, and a solo set from Flynn McHardy.\\n\\nAbigail Toll is a sound artist and composer working with electroacoustic composition, chamber ensembles, extended tuning systems, and multichannel installation. Her practice constructs deep-listening environments from ongoing research into psychoacoustics and resonance. Her second album Idol (Superpang, 2025), nominated for the German Critic’s Prize and her debut Matrices of Vision (Shelter Press, 2023) was presented as an ensemble commission by KW Institute of Contemporary Art at the Klosterruine. \\n\\nOliver Turvey is an artist working across sound and performance. A longtime member of the group Midlight, he also performs with Hilary Woods and Gabriel Ferrandini. His practice sits at the intersection of site- and subject-specific improvisation, utilising electronics, violin, viola, DIY instruments, and spoken word. \\n\\nSeán Being is an Irish musician working across a range of modes of composition and performance. They have collaborated widely among circles in Ireland, Portugal and London, including lately as a member of Irish group Princ€ss and as instigator of the riverside event series, Car Musick. They work with site-specific solo performance through a variety of means—recently plainchant, feedback, pianos and car horns—thinking through spatial, social and historical bases of music performance. Seán has an MA from the Dutch Art Institute (2024) and currently lives in London.\\n\\nFlynn McHardy is a London based musician. He works with guitar and electronics in solo and collaborative contexts. He is concerned with the investigation of listening as both method and material. His work has been released by Superpang and has featured on BBC 3’s Late Junction, NTS Radio, and Resonance Extra. He also plays in the band Hedgehog.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,369],&quot;artist_name&quot;:[0,&quot;Oliver Turvey&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1456],&quot;artist_name&quot;:[0,&quot;Seán Being&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1457],&quot;artist_name&quot;:[0,&quot;Abigail Toll&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1861],&quot;artist_name&quot;:[0,&quot;Flynn McHardy&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,278],&quot;name&quot;:[0,&quot;Oliver Turvey&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TdpkJGXAcGFoCDP&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,252],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,444],&quot;name&quot;:[0,&quot;Waged&quot;],&quot;price&quot;:[0,14],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,90],&quot;quantity_sold&quot;:[0,9],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,445],&quot;name&quot;:[0,&quot;Low / Unwaged&quot;],&quot;price&quot;:[0,7],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,20],&quot;quantity_sold&quot;:[0,13],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,1121],&quot;url&quot;:[0,&quot;https://www.thehorsehospital.com/events/abigail-toll-sean-being-oliver-turvey-hilary-woods&quot;],&quot;display_title&quot;:[0,&quot;Horse Hospital Listing&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-07-06T19:38:36.626269Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-07-06T19:38:36.626269Z&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">An evening of experimental music from the sound artist and composer Abigail Toll, a viola duo comprised of Seán Being and Oliver Turvey, and a solo set from Flynn McHardy.<br /><br />Abigail Toll is a sound artist and composer working with electroacoustic composition, chamber ensembles, extended tuning systems, and multichannel installation. Her practice constructs deep-listening environments from ongoing research into psychoacoustics and resonance. Her second album Idol (Superpang, 2025), nominated for the German Critic’s Prize and her debut Matrices of Vision (Shelter Press, 2023) was presented as an ensemble commission by KW Institute of Contemporary Art at the Klosterruine. <br /><br />Oliver Turvey is an artist working across sound and performance. A longtime member of the group Midlight, he also performs with Hilary Woods and Gabriel Ferrandini. His practice sits at the intersection of site- and subject-specific improvisation, utilising electronics, violin, viola, DIY instruments, and spoken word. <br /><br />Seán Being is an Irish musician working across a range of modes of composition and performance. They have collaborated widely among circles in Ireland, Portugal and London, including lately as a member of Irish group Princ€ss and as instigator of the riverside event series, Car Musick. They work with site-specific solo performance through a variety of means—recently plainchant, feedback, pianos and car horns—thinking through spatial, social and historical bases of music performance. Seán has an MA from the Dutch Art Institute (2024) and currently lives in London.<br /><br />Flynn McHardy is a London based musician. He works with guitar and electronics in solo and collaborative contexts. He is concerned with the investigation of listening as both method and material. His work has been released by Superpang and has featured on BBC 3’s Late Junction, NTS Radio, and Resonance Extra. He also plays in the band Hedgehog.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/278\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Oliver Turvey </a>  </p> <div class=\"mt-6\"> <div class=\"flex flex-wrap gap-3\"> <a href=\"https://www.thehorsehospital.com/events/abigail-toll-sean-being-oliver-turvey-hilary-woods\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Horse Hospital Listing </a> </div>  </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"def