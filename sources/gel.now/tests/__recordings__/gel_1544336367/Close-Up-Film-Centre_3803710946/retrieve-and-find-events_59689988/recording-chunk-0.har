ings and ticketing platform built for a more equitable, transparent way into London&#39;s grassroots nightlife, arts and culture scene)\\n\\nCome fill your pieholes with us as we toast one year of cancelling ourselves x\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,1650],&quot;artist_name&quot;:[0,&quot;tba&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,221],&quot;name&quot;:[0,&quot;Secret Location (TBA)&quot;],&quot;address&quot;:[0,&quot;&quot;],&quot;capacity&quot;:[0,0],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,267],&quot;name&quot;:[0,&quot;WORMHOLE&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TgjSSGvCaedRPFZ&quot;],&quot;ticket_email&quot;