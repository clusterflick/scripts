71,\"name\":\"General Admission\",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":250,\"quantity_sold\":2,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":772,\"name\":\"Concession Ticket (low / unwaged, access)\",\"price\":8,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":1,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":8,\"name\":\"experimental\"},{\"id\":13,\"name\":\"electronic\"},{\"id\":14,\"name\":\"ambient\"},{\"id\":521,\"name\":\"radio\"},{\"id\":611,\"name\":\"sunshine\"}]},{\"id\":750,\"name\":\"London Radical Bookfair\",\"start_time\":\"2026-09-06T11:00:00Z\",\"end_time\":\"2026-09-06T17:00:00Z\",\"poster\":\"e50bf9dc3d8c15acd1aba2bc22e1700d.webp\",\"background\":\"\",\"description\":\"The London Radical Bookfair’s key aim is to create a welcoming space for readers and organisers to exchange ideas, discover new writing, and build connections across movements and communities.\\n\\nOrganised by BookLove and Housmans Bookshop on behalf of the Alliance of Radical Booksellers, the free event will run from 11am–5pm and is open to everyone.\\n\\nVisitors can expect a stimulating mix of stalls, books, pamphlets, magazines and zines covering subjects including politics, history, feminism, anti-racism, climate justice, queer liberation, trade unionism, internationalism and community organising. The fair will also provide opportunities to meet writers, campaigners and independent publishers working at the forefront of radical thought and activism.\\n\\nThe London Radical Bookfair is intended as a welcoming and inclusive event for the whole community. Alongside political and independent publishing, the fair will include children’s books, family-friendly materials and accessible spaces for people of all ages to browse, learn and take part. \",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"is_free\":true,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":211,\"name\":\"Stanley Arts\",\"address\":\"12 South Norwood Hill\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":346,\"name\":\"radical press\"},{\"id\":348,\"name\":\"publishing\"},{\"id\":532,\"name\":\"bookfair\"}]},{\"id\":791,\"name\":\"WORMHOLE [day party]\",\"start_time\":\"2026-09-06T13:00:00Z\",\"end_time\":\"2026-09-06T22:00:00Z\",\"poster\":\"c8e318dd71df926980aa20ca2552ada0.webp\",\"background\":\"\",\"description\":\"Holy hell, can you believe it's nearly been a year since the first WORMHOLE got cancelled? A year since Jerzy got lost and never made it to London with his tomatoes? Neither can we. So come celebrate it with us :)\\n\\nCome mourn one year since WORMHOLE began, at a brand new secret venue we're calling the WORM FACTORY, this time it's extra special because it's our birthday. Get those earholes and bumholes primed and grab a ticket for a Sunday day party on Sunday 6th September.\\n\\nLocation: top secret, somewhere in East London. Accessible via DLR. We'll drop the address a few days before (hopefully it's near you, but even if it isn't then its defintiely worth making the journey for. we promise!!\\n\\nAccessibility: there is a lift and accessible toilet!\\n\\nTickets live now via the link in bio, and on GEL (a new listings and ticketing platform built for a more equitable, transparent way into London's grassroots nightlife, arts and culture scene)\\n\\nCome fill your pieholes with us as we toast one year of cancelling ourselves x\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1650,\"artist_name\":\"tba\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":221,\"name\":\"Secret Location (TBA)\",\"address\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":267,\"name\":\"WORMHOLE\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":686,\"name\":\"Early Worm\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":50,\"quantity_sold\":50,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":687,\"name\":\"F