ed\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1706,\"artist_name\":\"Rabz\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2089,\"artist_name\":\"Bok Bok\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2237,\"artist_name\":\"D3NIM\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2238,\"artist_name\":\"Lil C\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2239,\"artist_name\":\"Nico Adomako\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2240,\"artist_name\":\"ohjeelo\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2241,\"artist_name\":\"Sylvere\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":2,\"name\":\"Ormside Projects\",\"address\":\"Penarth Centre, 32 Ormside Street\",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":53,\"name\":\"Ormside Projects\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":850,\"name\":\"Critical Movement\",\"start_time\":\"2026-08-29T14:00:00Z\",\"end_time\":\"2026-08-30T17:00:00Z\",\"poster\":\"f1be0f8a4971d32af03da986cca976e8.webp\",\"background\":\"\",\"description\":\"How can one transition from the stillness of meditation into a creative movement task? Is it possible to distinguish authentic impulses for movement from the starting moment of embodied habits?\\n\\nCritical Movement offers a practical exploration of performance training, specifically how intentional movement can emerge from states of deep attention and stillness. Drawing on the Pali concept of samadhi (meditative concentration) alongside personal phenomenological experience, participants will explore movement beyond habitual patterns and performative expectations. \\n\\nThe investigation of neutrality as equanimity sits at the core of this workshop — not passive, but a dynamic process of ego-softening, attentive witnessing, and embodied presence. It combines yoga-informed somatic awareness, meditation, micro-movement investigation, and ideas from Queer Phenomenology, particularly Sara Ahmed's writing on perception and orientation. Participants will examine how non-judgemental observation and subtle bodily sensations can become sources of creative action, resisting the speed and productivity-driven ethos that dominates much of contemporary artistic practice.\\n\\nDesigned as a conversational laboratory, the workshop fosters collective enquiry, reciprocal listening, and horizontal exchange, welcoming movers, performers, educators, choreographers, and artists interested in contemplative practice, movement research, critical pedagogy, and queer embodied methodologies.\\n\\nBoth sessions will be investigating the same questions, with different exercises and practices. Attending both sessions will foster a deeper understanding of the work, but each session offers a full individual experience.\\n\\nLuis Odriozola is a performer, movement director, and actor movement teacher. From an embodied queer movement perspective, his work researches methodologies and practices that seek a balance between the rigour of classic traditions and via negativa, versus the need for perspectives rooted in Black feminism and via positiva actor training.\\n\\nHe studied acting in Spain, then completed the Choreographic Creation, Dance Research and Training Program at Forum Dança in Lisbon, and the MFA Movement: Directing and Teaching at CSSD in London. He was a member of the ensemble 'Dynamika Metamorfozy' at the Grotowski Institute and neTTtheatre company in Poland, and as an actor, movement and yoga teacher he has worked in schools including LAMDA and CCSD in London, and with community and youth groups in Spain and Poland.\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://www.outsavvy.com/event/38557/critical-movement\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":9,\"name\":\"workshop\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2175,\"artist_name\":\"Luis Odriozola\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":104,\"name\":\"London Performance Studios\",\"address\":\"Penarth Centre, Ormside Street\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":178,\"name\":\"London Performance Studios\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":31,\"name\":\"meditation\"},{\"id\":32,\"name\":\"movement\"},{\"id\":145,\"name\":\"performance\"},{\"id\":255,\"name\":\"somatics\"},{\"id\":514,\"name\":\"movement workshop\"}]},{\"id\":878,\"name\":\"Pre-launch • Ambient Sauna | Guohan, Stella Z \\u0026 Voision Xi (Live) \",\"start_time\":\"2026-08-29T18:00:00Z\",\"end_time\":\"2026-08-29T22:30:00Z\",\"poster\":\"190ac732f1cbe47cf1a7b58896b0297a.webp\",\"background\":\"\",\"description\":\"Pre-launch • Join us for the first weekend in our new venue, just two doors down from the original space you know and love! With the main launch party on Monday 31st, come down early for an exclusive preview and be the first to try out the new setup.\\n\\nOn Saturday we welcome Ambient Sauna regular Stella Z, Shanghai-based vocalist and composer Voision Xi, and London-based producer Guohan. Stella Z weaves together organic textures, object sounds, and nature-inspired atmospheres with psychedelic rhythms. Voision Xi brings a live performance rooted in warm, expressive vocals, jazz improvisation, and poetic songwriting, while Guohan rounds off the programme with deep grooves, organic rhythms, and beautifully imperfect electronic arrangements embracing human nuance.\\n\\n*Book your 70-minute sauna session, arrive early and stay late for 4 hours of music in the lounge*\\n\\nABOUT AMBIENT SAUNA\\nOur silent Treehouse sauna and the chatty Herbal sauna are both equipped with a sound system for deep listening. Our Bunker sauna, the Tea Loft listening lounge and yard offer a social setting, perfect for a catch up and meeting new friends.\\n\\nABOUT SAUNA SOCIAL CLUB\\nThe Sauna Social Club is London's first dedicated sauna and ambient listening space. We blend saunas and ice baths with ambient music, making the perfect place to relax and recharge. We've grown out of a need for more healthy spaces to listen to great music. Our goal is to create a space that's designed for comfort and wellbeing that doesn't centre around consumption.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://tr.ee/otHCSeSGE6\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":false,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2275,\"artist_name\":\"stella z\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2276,\"artist_name\":\"Guohan\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2277,\"artist_name\":\"Voision Xi\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":31,\"name\":\"Sauna Social Club\",\"address\":\"Railway Arch 842 Brayards Road\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":132,\"name\":\"Sauna Social Club\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":14,\"name\":\"ambient\"},{\"id\":23,\"name\":\"jazz\"},{\"id\":42,\"name\":\"sauna\"},{\"id\":94,\"name\":\"listening\"},{\"id\":103,\"name\":\"music\"},{\"id\":165,\"name\":\"live music\"},{\"id\":602,\"name\":\"electronic music\"},{\"id\":616,\"name\":\"altenative\"}]},{\"id\":856,\"name\":\"Friends of Mairi Ella\",\"start_time\":\"2026-08-29T19:00:00Z\",\"end_time\":\"2026-08-29T23:30:00Z\",\"poster\":\"321385542e1013c8c25a8f4a88e8235f.webp\",\"background\":\"\",\"description\":\"Charity gig supporting 999 club, a homeless charity working in South East London\\n\\nHello friends,\\n\\nIt would have been my dear friend Mairi Ella’s birthday this August, so i am throwing a fundraiser gig in her memory.\\n\\nThe lineup:\\n\\nSWEETCHEEKS\\n\\nLondon based hyper-pop numetal band daring to ask ‘what if Britney was in Slipknot?’ Setting girly pop melodies and anime synth lines against gnarly riffs, blast beats and harsh vocals, sweetcheeks is equal parts sugary and savage. Their wild and immersive live shows featuring K-pop style choreography have become the talk of the capital since their debut performance last year.\\n\\nVAUDEVILLES:\\n\\nthree-piece Garage Rock 'n' Roll band based in Manchester. Tearing through live shows with the energy of “a greyhound on meth”, the band play songs that combine infectious melodies with a strong dose of ripping riffs.\\n\\nTHE SPANISH INQUISITIONS\\n\\nLondon based saccharine goo rockers: covered in jam and surrounded by flies. Five members, each stickier than the last.\\n\\nSCOUT PARKS\\n\\nCanadian writer and musician living in London. He gained a love of folk music, playing around the campfires of his early years in Canada. Then an interlude studying classical music, singing opera in Reykjavik, before back to the singer songwriter world. Catch him round London frequenting open mics like Song Miners and Jamboree Poetry Mondays.\\n\\nall proceeds will go towards 999 club, a homeless charity working in south london. mairi ella always did everything in her power to help the homeless, wether that was emptying her wallet, giving the clothes off her back or sitting down and chatting with the people she would meet living on the streets. she was an incredible woman and friend and i miss her every day. if you aren’t able to attend the show, or would like to donate more than the ticket price, there is also a justgiving link in my bio.\\n\\nlooking forward to seeing you all there,\\n\\nBaby Niamh x\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://www.eventbrite.com/e/friends-of-mairi-ella-tickets-1996879934639?utm_experiment=test_share_listing\\u0026aff=ebdsshios\\u0026sg=b91ffa50f1b0f49a18e634cc1e3d0e28fad846847f8940f869e6dce21e0fc7cf2238b323066c4379b8c5797cb723252e525030c9837712280697e042ce4dde43fbd471edc7e2cc367174ab03ec\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":false,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2212,\"artist_name\":\"Sweetcheeks\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2213,\"artist_name\":\"Vaudevilles\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2214,\"artist_name\":\"The Spanish Inquisitions\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2215,\"artist_name\":\"Scout Parks\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":140,\"name\":\"Deptford Junction\",\"address\":\"Unit 8, Titan Business Estate, Ffinch St\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":221,\"name\":\"Deptford Junction\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":100,\"name\":\"fundraiser\"},{\"id\":356,\"name\":\"charity\"},{\"id\":366,\"name\":\"alt-folk\"},{\"id\":371,\"name\":\"Rock\"},{\"id\":506,\"name\":\"nu metal\"},{\"id\":610,\"name\":\"garage rock\"}]},{\"id\":852,\"name\":\"Threshold Houseboys Choir: Form Grows Rampant\",\"start_time\":\"2026-08-29T19:30:00Z\",\"end_time\":\"2026-08-29T22:00:00Z\",\"poster\":\"283b6a5f96330153f6b1882cdaad3f0e.webp\",\"background\":\"\",\"description\":\"A very rare screening of the now out of print DVD film of Peter Christopherson’s solo project ‘Threshold Houseboys Choir’ Form Grows Rampant.\\n\\n\\\"In 2003 I was invited to attend the Ginjae Festival in Krabi Town in the south of Thailand. Ginjae literally means vegetarian, though the connection is obscure. \\n\\nThe major celebrations of this festival take place on the nearby island of Phuket, but there, the atmosphere is one of spectacle, rather than purpose. I had been told about a very different celebration, based around a small chinese shrine or holy place, behind a Toyota dealership in Krabi Town, some 50 kilometres from Phuket island, on the mainland. The Ginjae Festival takes place on the 9th full moon of the year. Over the course of ten days (during which participants wear white and abstain from meat, alcohol and sex) a series of rituals are performed. intended to keep the world spinning on the correct axis. To bring merit and good luck to the village, and to scare away malign spirits that might otherwise bring misfortune to the neighbourhood; especially at busy intersections, accident black spots, etc... \\n\\nThe participants setting out from the shrine we visited were all young men, led by a young 'khatoey\\\" holy man. For the most part they were tattooed tearaways or troublemakers and not the kind of person you would expect to see the local shop-keepers on their knees praying to by the side of the road. In all cases that I witnessed, the rituals were carried out while the participants were in trance or possessed states; often lasting several hours. The boys were trained in, and induced into these states by their holy man, in whom they had complete trust. \\n\\nRemoved from immediate contact with the present by these mental states, the boys seemed not to feel pain. Though as their expressions show, this was not always the case when the trance weakened. Their trances also assisted their speedy recovery - along with the ice-water that their assistants poured on their wounds from kettles throughout the ritual. I saw most of these boys in the days that followed and they appeared to have suffered no ill-effects. and indeed to be almost completely scar free. Certainly emotionally they seemed buoyed by events, as did the worshippers in the neighbourhoods they passed through. \\n\\nBy contrast I was admitted to hospital for several days, suffering from some undiagnosed disorder, which I ascribe to temporarily becoming inadvertent host to one of the evil spirits that their rituals disturbed. \\n\\nIn this work my interpretation of the rituals - my focus and my music - ape entirely personal, and not directly connected to purpose of the Ginjae Festival. I simply believe I saw and filmed something profound, transcendent; the deity incarnate even; in the most unlikely of settings and want to share that with you. \\n\\nAs Jhonn said: \\\"We all get the gods we deserve...\\\"\\n\\n- Peter Christopherson Bangkok January 3rd 2007\\n\\nScreening starts at 8:30pm.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":false,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":5,\"name\":\"film\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2197,\"artist_name\":\"Peter Christopherson\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2198,\"artist_name\":\"Coil\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2199,\"artist_name\":\"Threshold Houseboys Choir\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":136,\"name\":\"The Horse Hospital\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":752,\"name\":\"General Admission\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":90,\"quantity_sold\":3,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":607,\"name\":\"coil\"}]},{\"id\":869,\"name\":\"RALLY x Scenic Route x ORMSIDE : Jump Source / spirit blue / Thredd / anu \\u0026 404 eros\",\"start_time\":\"2026-08-29T23:00:00Z\",\"end_time\":\"2026-08-30T05:00:00Z\",\"poster\":\"e3c649ceae890d0a1bdf4714caf801a7.webp\",\"background\":\"\",\"description\":\"anu \\u0026 404 eros\\nJump Source\\nspirit blue\\nThredd\\n\\nOrmside hosts RALLY x Scenic Route for the official RALLY 2026 Afterparty programme. DJ Sets from anu \\u0026 404 eros, Jump Source, spirit blue, and Thredd. Southwark Park was just the warm up.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://ra.co/events/2493603\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1016,\"artist_name\":\"Thredd\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2242,\"artist_name\":\"anu \\u0026 404 eros\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2243,\"artist_name\":\"Jump Source\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":