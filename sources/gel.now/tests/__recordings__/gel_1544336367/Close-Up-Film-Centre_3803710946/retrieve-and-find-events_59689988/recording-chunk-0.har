});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"1W22zW\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,679],&quot;name&quot;:[0,&quot;SLIVER • 004&quot;],&quot;start_time&quot;:[0,&quot;2026-08-08T23:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-09T07:00:00Z&quot;],&quot;poster&quot;:[0,&quot;380ffbfcb3ec419f4ed6cc52679cf2a7.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;from the deepest of dreams we astir from our bliss \\nwhispers breathe in the air, an awakening not to be missed ⟢\\n\\n⟡ 08.08 • S L I V E R • 23:00-07:00 ⟡\\n\\nANNX\\nMATRIARK B2B MONA SAGE\\nSLINKY KINKY\\nTANGELA\\n\\nFlowing, moving, growing, evolving…\\n\\nA celebration of excellence in London&#39;s queer trance and techno scenes ⟢\\n\\nAfter a one-year hiatus since our last encounter, our 4th edition births a brand new season of SLIVER.\\n\\nOur re-birth inhabits our city&#39;s favourite Steam Room at FOLD and we’re excited to invite two international artists to guide us in ritual alongside a selection of our favourite local enchanters, including a new SLIVER resident debut.\\n\\nSLIVER is first and foremost a FLINTA+ and queer space. Anyone with an open heart who is a part of the queer communities or considers themselves an active ally is welcome to celebrate with us.\\n\\nAt its core, we believe that each sliver shines just as bright as the next. There will be no hierarchy and set times are to remain unannounced.\\n\\n~~~~~~~~~~~~~~~~~~~~~~~~~ \\n\\na r t i s t s :\\n\\n⟡ a n n x ⟡\\nInspired by cities and dancefloors where she’s lived and explored, ANNX’s unique seductive sound echos within her psychedelic selections across trance, prog, psy, techno, tech house, dubstep and more.\\n\\nAnna’s commitment to the scene goes beyond the booth, she carefully identifies niche sounds that are missing in the UK and has become a staple for psychedelic music on London’s club circuit. In 2021, she founded Whomp, a non-profit party in London which she now co-runs with Lora Mipsum. In 2023, she started a brand-new project perspectives• with lighting designer Nicole Gordon. Most recently, she joined the Above Below music team.\\n\\n\\n⟡ m e l a t i ⟡ \\nMelati steps in for Matriark who can no longer make it to London for her b2b with Mona Sage. \\n\\nSpawned from an unapologetically deep, psychedelic and sensual sound, Melati meanders the wider realms of techno, trance and psy, weaved together in a style that favours mesmeric blends with technical precision.\\n\\nAs an artist, venue manager and promoter, Melati’s relationship with music is intrinsic to every aspect of their life. From a Masters of Architecture that explores the spatial, social and political position of nightclubs in a city to a tangible body of on-the-ground work in venues, Melati has lived and breathed the spaces in which we find sanctuary throughout all of their adult career.\\n\\n\\n⟡ m o n a s a g e ⟡\\nBorn into a family of musicians in sunny Toulouse, it’s evident where Mona got her natural musical flair from.\\n\\nMona’s famously energetic, eclectic arsenal of tracks mirror her own vibrant personality. A desire to entertain sees her sets meticulously weave between techno, breakbeats, electro and all the rich, deep and driving bits in between.\\n\\n\\n⟡ s l i n k y k i n k y ⟡\\nWith a thirst for growth, she moves with a intuitive flow that is felt through her sets. She builds a cocoon of energy on the dancefloor, weaving high-energy pumpers, psychedelic textures and chuggy, hypnotic techno, pulling every room she touches into a trance.\\n\\nEvery set is constructed with intent: a dialogue between physical movement and emotional resonance. Slinky Kinky’s performances are designed to charge the atmosphere, pulling dancers into her orbit and keeping them there until the very last beat.\\n\\n\\n⟡ t a n g e l a ⟡\\nTangela’s style of aural storytelling is as distinct as it is varied. She guides the listener through deep, subby, subterranean worlds; encouraging listeners to float up through spacious, textural soundscapes full of unexpected turns, all with a nimble and playful touch.\\n\\nWith her strength lying in versatility of genre, her sound is undeniably psychedelic, &amp; one with deep connection to the Australian bush she soundtracks so regularly. She transports you with intention to moments in leafy clearings, hazy morning rays poking through the gumtrees, thumping kicks drenched in subby, dubby, gurgling undertones.\\n\\n\\n~~~~~~~~~~~~~~~~~~~~~~~~~ \\n\\ne n j o y m e n t :\\nThis is a space for celebration, exploration, expression and positive release. It is encouraged to participate mindfully with awareness of yourself and the space you fill.\\n\\nb o u n d a r i e s :\\nPlease leave any assumptions of gender, sexuality, race, ability or identity at the door and proceed to interact with those who give enthusiastic consent. We expect the community to treat themselves, each other and the space with kindness and respect.\\n\\nn o u r i s h m e n t :\\nWe implore you to immerse yourself in the party, the music and the space and enjoy it at your own pace. We will not be serving food this time, so feel free to bring snacks to fuel your body to dance until the sunrise. The venue will not permit liquids of any form.\\n\\nl i m i t s :\\nStrictly 21+.\\nPhysical ID is mandatory for entry.\\nPhotography will not be permitted.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,557],&quot;artist_name&quot;:[0,&quot;Matriark&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1820],&quot;artist_name&quot;:[0,&quot;Mona Sage&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1821],&quot;artist_name&quot;:[0,&quot;Slinky Kinky&quot;],&quot;gov_n