lor .2s ease}.ticket .download-btn:hover{background-color:#333}.ticket .download-btn:active{background-color:#000}.waitlist-modal-overlay{align-items:center;background:#000000b3;display:flex;justify-content:center;inset:0;padding:1rem;position:fixed;z-index:1000}.waitlist-modal{background:#1a1a1a;background:var(--theme-bg,#1a1a1a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:12px;max-width:400px;padding:2rem;position:relative;width:100%}.modal-close{background:none;border:none;color:#888;color:var(--theme-fg-400,#888);cursor:pointer;font-size:1.5rem;line-height:1;padding:.25rem;position:absolute;right:1rem;top:1rem}.modal-close:hover,.waitlist-modal h2{color:#fff;color:var(--theme-fg,#fff)}.waitlist-modal h2{font-size:1.5rem;margin:0 0 .5rem}.waitlist-modal .tier-info{color:#4c6ef5;color:var(--theme-accent,#4c6ef5);font-size:1.125rem;margin-bottom:1rem}.waitlist-description{color:#888;color:var(--theme-fg-400,#888);font-size:.875rem;line-height:1.5;margin-bottom:1.5rem}.waitlist-modal .form-group{margin-bottom:1rem}.waitlist-modal label{color:#fff;color:var(--theme-fg,#fff);display:block;font-size:.875rem;margin-bottom:.5rem}.waitlist-modal input{background:#0a0a0a;background:var(--theme-fg-50,#0a0a0a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:8px;color:#fff;color:var(--theme-fg,#fff);font-size:1rem;padding:.75rem 1rem;width:100%}.waitlist-modal input:focus{border-color:#4c6ef5;border-color:var(--theme-accent,#4c6ef5);outline:none}.waitlist-modal input::-moz-placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal input::placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal .error-message{color:#ff5252;font-size:.875rem;margin-bottom:1rem}.modal-actions{display:flex;gap:1rem;margin-top:1.5rem}.modal-actions button{border-radius:8px;cursor:pointer;flex:1;font-size:1rem;font-weight:500;padding:.75rem 1.5rem;transition:all .2s}.modal-actions .btn-secondary{background:trans