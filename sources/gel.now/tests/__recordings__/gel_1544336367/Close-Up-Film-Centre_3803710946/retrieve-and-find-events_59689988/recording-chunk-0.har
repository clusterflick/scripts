}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"1mepCl\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,646],&quot;name&quot;:[0,&quot;Minor Renaissance #1: Alexander Tucker &amp; Magda Drozd&quot;],&quot;start_time&quot;:[0,&quot;2026-07-22T19:30:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-07-22T23:30:00Z&quot;],&quot;poster&quot;:[0,&quot;d6dd840c1a96c3c5337543e7991f0ebc.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Minor Renaissance — concert series for experimental contemporary practices\\n# 1 with Alexander Tucker &amp; Magda Drozd\\n\\n22 July 2026 \\nDoors 19:30 \\n\\nThe Horse Hospital \\n\\nMinor Renaissance, a concert series for experimental music, invites audiences to listen for new relationships between instruments and electronics, between composed and improvised material, between inherited techniques and wayward contemporary practices. Rather than a rebirth announced by a movement, it points to smaller transformations — fragile, unfinished, and briefly held in common. Curated by Magda Drozd. \\n\\n&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,952],&quot;artist_name&quot;:[0,&quot;Magda Drozd&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;Magda Drozd, born 1987 in Warsaw, is a composer, violinist, and sound artist living in Zürich and London. On the label Präsens Editionen, she has previously released four solo music projects: Songs for Plants (2019), 18 Floors (2021), Viscera (2023) and Divided by Dusk (2026).\\nFurther releases have followed on Hallow Ground for their compilation \\&quot;Epiphanies\\&quot;, on Flaming Pines for the concept album \\&quot;Cassette Album\\&quot; by Salomé Voegelin, and on her own label Rivercore, a platform for experimental music.\\nTogether with Nicola Genovese, she founded the duo Sopraterra, which released the LP ‚Seven Dances to Embrace the Hollow‘ on Präsens Editionen and La Becque Editions in 2025.\\n&quot;],&quot;image&quot;:[0,&quot;2bb7e46e8bec5a8c9e557c31829e1222.webp&quot;],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,26],&quot;url&quot;:[0,&quot;https://www.magdadrozd.com/&quot;],&quot;display_title&quot;:[0,&quot;Website&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-04-28T11:37:22.332184Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-04-28T11:37:22.332184Z&quot;]}],[0,{&quot;id&quot;:[0,27],&quot;url&quot;:[0,&quot;https://www.instagram.com/magda_drozd_/&quot;],&quot;display_title&quot;:[0,&quot;Instagram&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-04-28T11:37:22.332878Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-04-28T11:37:22.332878Z&quot;]}]]],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1697],&quot;artist_name&quot;:[0,&quot;Alexander Tucker&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,175],&quot;name&quot;:[0,&quot;Magda Drozd&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TPOUWGrFHBiqRRl&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,145],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,554],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,12],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,80],&quot;quantity_sold&quot;:[0,8],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,555],&quot;name&quot;:[0,&quot;Low/Unwaged&quot;],&quot;description&quot;:[0,&quot;No one turned away at the door. &quot;],&quot;price&quot;:[0,7],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,40],&quot;quantity_sold&quot;:[0,4],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,261],&quot;name&quot;:[0,&quot;experimental music&quot;]}],[0,{&quot;id&quot;:[0,327],&quot;name&quot;:[0,&quot;contemporary&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Minor Renaissance — concert series for experimental contemporary practices<br /># 1 with Alexander Tucker & Magda Drozd<br /><br />22 July 2026 <br />Doors 19:30 <br /><br />The Horse Hospital <br /><br />Minor Renaissance, a concert series for experimental music, invites audiences to listen for new relationships between instruments and electronics, between composed and improvised material, between inherited techniques and wayward contemporary practices. Rather than a rebirth announced by a movement, it points to smaller transformations — fragile, unfinished, and briefly held in common. Curated by Magda Drozd. <br /><br /></div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/175\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Magda Drozd </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin:bottom right\"><button class=\"\n            w-15 h-15 sm:w-16 sm:h-16\n            rounded-full\n            shadow-2xl\n            backdrop-blur-md\n            flex items-center justify-center\n            transition-all duration-200\n            hover:scale