5.webp\" alt=\"Montez x Forma Summer Party\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Montez x Forma Summer Party</h1>  </div> <p class=\"text-surface-600 mb-4\"> Saturday, July 18, 2026 · 1:00 PM – 8:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/59\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> FormaHQ </a> <p class=\"text-sm text-surface-600\">140 Great Dover Street</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1199\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> James Jordan Johnson </a> <span> · </span> <a href=\"/artists/1634\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> NWAKKE </a> <span> · </span> <a href=\"/artists/1914\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> D Mortimer </a> <span> · </span> <a href=\"/artists/1915\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Soledad Santana </a> <span> · </span> <a href=\"/artists/1916\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Kaz De Roiste </a> <span> · </span> <a href=\"/artists/1917\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Josh Quinton </a> <span> · </span> <a href=\"/artists/1918\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Dream Sequence </a> <span> · </span> <a href=\"/artists/1919\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Babeworld </a> <span> · </span> <a href=\"/artists/1920\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> M Lissoni </a> <span> · </span> <a href=\"/artists/1921\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Krystle Patel </a> <span> · </span> <a href=\"/artists/1922\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Jala Wahid (Slow Crush) </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://docs.google.com/forms/d/e/1FAIpQLSfyLrAFGWV6ijpOp9ummIssNvw5AD4WKmPayjAkCcyrbDErQA/viewform?mc_cid=3f931055cc&mc_eid=b2fe007f4a\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Join us for our annual summer party, this year in collaboration with Montez Press.<br /><br />To celebrate their four month residency at FormaHQ, we are co-curating a special day-long event with Montez Press and Montez Press Radio in our rooftop garden on Great Dover Street. Featuring performances, installations and readings from:<br /><br />NWAKKE<br />D Mortimer<br />Soledad Santana<br />Kaz De Roiste<br />Josh Quinton<br />Dream Sequence<br />Babeworld<br />James Jordan Johnson<br />M Lissoni<br />Krystle Patel<br />Jala Wahid (Slow Crush)<br />+ more to be announced<br /><br /><br />Come along for drinks, food and fun. Montez Press Radio will be broadcasting live throughout the day.<br /><br />Free entry, everyone welcome!</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/362\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Montez Press Radio </a> ,  <a href=\"/promoters/363\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Forma </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object.fromEntries(Object.entries(t).map(([l,e])=>[l,o(e)]));class y extends HTMLElement{constructor(){super(...arguments);d(this,\"Component\");d(this,\"hydrator\");d(this,\"hydrate\",async()=>{var b;if(!this.hydrator||!this.isConnected)return;let e=(b=this.parentElement)==null?void 0:b.closest(\"astro-island[