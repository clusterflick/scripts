ster/ac566a3ae97948823b07d8059acbe3f9.webp\" alt=\"Curbside Lambsear | Stamp Rack | C.Y Charisse\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Curbside Lambsear | Stamp Rack | C.Y Charisse</h1>  </div> <p class=\"text-surface-600 mb-4\"> Friday, September 25, 2026 · 7:30 PM – 11:00 PM </p> <div class=\"mb-6\"> <a href=\"/venues/17\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> The Horse Hospital </a> <p class=\"text-sm text-surface-600\">Colonnade</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1627\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Curbside Lambsear </a> <span> · </span> <a href=\"/artists/2013\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Stamp Rack </a> <span> · </span> <a href=\"/artists/2050\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> C.Y Charisse </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object