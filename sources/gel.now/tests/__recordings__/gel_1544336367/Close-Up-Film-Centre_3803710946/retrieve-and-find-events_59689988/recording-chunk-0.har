          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"events\":[{\"id\":477,\"name\":\"Real Life Presents - Moral Law | Straightedge Metalcore\",\"start_time\":\"2026-11-23T18:00:00Z\",\"end_time\":\"2026-11-23T22:30:00Z\",\"poster\":\"97b43a46a58461d312057a8d767c076d.webp\",\"background\":\"\",\"description\":\"Real Life Presents\\n\\nMoral Law\\nStraight edge mosh warriors on New Age Records\\n\\n+ support from\\nRebel\\nKent hardcore\\n\\n\\u0026 more UKHC coming soon...\\n\\nNew Cross Inn, nearest stations New Cross Gate and New Cross\\nDoors 6pm\\n£11\\n\\n14+, u16s with an adult 18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/moral-law\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1330,\"artist_name\":\"Moral Law\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1331,\"artist_name\":\"Rebel\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":73,\"name\":\"South London\"},{\"id\":81,\"name\":\"ukhc\"},{\"id\":82,\"name\":\"metalcore\"},{\"id\":290,\"name\":\"Straightedge\"}]},{\"id\":739,\"name\":\"Sunday Best | Real Life Presents\",\"start_time\":\"2026-11-27T19:00:00Z\",\"end_time\":\"2026-11-27T23:00:00Z\",\"poster\":\"80f7e68070c0d8e887369401b447afe8.webp\",\"background\":\"\",\"description\":\"Real Life Presents\\n\\nSunday Best\\nUnderground London Emo-punks. \\\"Cleopatra, In A Past Life\\\" out now.\\n\\nA very special headline set from some of our closest friends. More news (including some incredible supports) coming soon...\\n\\nFriday November 27th\\nSebright Arms, nearest stations Bethnal Green and Cambridge Heath\\n£10\\nDoors 7pm\\n18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/sunday-best-2\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1910,\"artist_name\":\"Sunday Best\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":208,\"name\":\"Sebright Arms\",\"address\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":69,\"name\":\"punk\"},{\"id\":80,\"name\":\"emo\"},{\"id\":81,\"name\":\"ukhc\"},{\"id\":213,\"name\":\"East London\"},{\"id\":334,\"name\":\"post-hardcore\"},{\"id\":519,\"name\":\"pop-punk\"}]},{\"id\":738,\"name\":\"Restraining Order | Real Life Presents\",\"start_time\":\"2026-11-30T18:00:00Z\",\"end_time\":\"2026-11-30T22:30:00Z\",\"poster\":\"780df81d385ce882f2214064450d0609.webp\",\"background\":\"\",\"description\":\"Real Life Presents\\n\\nRestraining Order\\nFast-stomping, side-to-side, Massachusetts hardcore. \\n\\nClobber\\nLondon's most massive\\n\\nAku\\nBN1 side-to-side crew\\n\\nBullet\\nNew New Wave Of UKHC\\n\\nMonday 30th November\\nNew Cross Inn, nearest stations New Cross Gate and New Cross\\n£15\\nDoors 6pm\\n14+, u16s with an adult 18+\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/restraining-order-1\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":396,\"artist_name\":\"Bullet\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1909,\"artist_name\":\"Restraining Order\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2265,\"artist_name\":\"Clobber\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2266,\"artist_name\":\"Aku\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":69,\"name\":\"punk\"},{\"id\":73,\"name\":\"South London\"},{\"id\":81,\"name\":\"ukhc\"},{\"id\":419,\"name\":\"hardcore punk\"}]},{\"id\":770,\"name\":\"Discus Music Residency January 2027 - RIGHT HERE RIGHT NOW\",\"start_time\":\"2027-01-17T19:30:00Z\",\"end_time\":\"2027-01-17T22:00:00Z\",\"poster\":\"0cfc0499abf3846d15c2ce4e1aa72787.webp\",\"background\":\"\",\"description\":\"The Discus Music residency at the Horse Hospital, Colonnade WC1N 1JD, takes place on the third Sunday of each month throughout 2027, and rotates between three artists on the label:  Hi Res Heart, Right Here Right Now and The Martin Pyne Ensemble.\\n\\nThe venue is fully seated.\\n\\nSUNDAY 17th JANUARY 2027 – DOORS 7.30 PM\\nRIGHT HERE RIGHT NOW \\n\\nCharlotte Keeffe – trumpet\\nAshley John Long - double bass\\nBen Handysides – drums \\nMoss Freed – guitar\\n\\nDescribed by Jazzwise as \\\"avant-garde for all,\\\" Charlotte Keeffe’s Music-making is a vibrant tapestry of textures and gestures, inspired by everything, everywhere, and everyone. Keeffe’s passionate approach to free improvisation invites listeners into a raw, expressive world where anything is possible… \\n\\nHer trumpets are Sound Brushes - painting bold sonic landscapes alongside her musical brothers, Ashley John Long on double bass, Ben Handysides on drums and Moss Freed on guitar, forging a rich breeding ground for Musical liberation.\\n\\n\\\"The radical spirit of offhand precarity frequently bubbles over into an effervescent sense of the imperative to explore. In a word? Fearless.\\\" - PRESTO MUSIC\\n\\n\\\"A messy emporium of raw, raucous realness. Alive.” Keeffe and her quartet nailed it.\\\" - Sammy Stein, FREE JAZZ BLOG\\n\\n\\\"Charlotte Keeffe is rapidly developing a reputation as one of UK’s finest improvisers.\\\" - Tony Dudley-Evans\\n\\nDiscus Music: discusmusic.bandcamp.com / discus-music.org\\nWe are a large Sheffield based independent label for creative music with over 200 CD/DL releases, curated by Martin Archer. As well as the residency group leaders Martin Archer, Charlotte Keeffe and Martin Pyne, artists on the label include Keith Tippett, Julie Tippetts, Paul Dunmall, Cecil Taylor, Tony Oxley, Pat Thomas, Laura Cole, Let Spin, Das Rad, Orchestra Of The Upper Atmosphere, Uroboro, Stephen Grew, Guy Segers, Corey Mwamba, Robert Mitchell, Alya Al-Sultani, Inclusion Principle, Johnny Hunter, Mick Beck, Billy Marrows, Jan Todd / frostlake, Faith Brackenbury, Tony Bianco, The Exu, Faradena Afifi, Steve Beresford, Paul Khimasia Morgan, Laura Jurd, Keir Cooper, Ron Caines, Matthew Bourne, Chris Sharkey, Carla Diratz, Theo May, Paul Taylor, This Celestial Engine, Fjall, Walt Shaw, Steve Tromans, Rachel Musson, Mark Sanders, James Mainwaring, Ricard Scott, Army Of Briars, Nick Robonson, Michael Bardon, Bo Meson, Juxtavoices, Alex Ward and many more.\\n\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":331,\"name\":\"Discus Music\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":672,\"name\":\"Concession\",\"description\":\"Special price for unwaged attendees\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":673,\"name\":\"Standard\",\"description\":\"Standard general admission\",\"price\":12.5,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":674,\"name\":\"Supporter\",\"description\":\"A voluntary higher price for those who wish to show additional support for this concert series\",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":23,\"name\":\"jazz\"},{\"id\":163,\"name\":\"Free improvisation\"}]},{\"id\":771,\"name\":\"Discus Music Residency February 2027 – MARTIN PYNE TRIO\",\"start_time\":\"2027-02-21T19:30:00Z\",\"end_time\":\"2027-02-21T22:00:00Z\",\"poster\":\"1b7b1209a04fd72599f38a8073cd2884.webp\",\"background\":\"\",\"description\":\"The Discus Music residency at the Horse Hospital, Colonnade WC1N 1JD, takes place on the third Sunday of each month throughout 2027, and rotates between three artists on the label:  Hi Res Heart, Right Here Right Now and The Martin Pyne Ensemble.\\n\\nThe venue is fully seated.\\n\\nSUNDAY 21st FEBRUARY 2027 – DOORS 7.30 PM\\nMARTIN PYNE'S CHALK HORSES TRIO\\n\\nMartin Pyne – vibraphone / balafon\\nDavid Beebee – electric piano\\nAngus Bishop - drums\\n\\n+ SUPPORT\\nJosephine Davies – solo saxophone \\n\\nCHALK HORSES TRIO came together to record music which featured on half of Martin Pyne’s new double album TRIOS (Discus). This represents the latest stage in a journey exploring the intersecting sonorities of vibraphone and rhodes piano, which began on Pyne and Beebee’s duo album Ripples, and continued on The Act Of Noticing where they were joined by saxophonist Josephine Davies to form the trio Espial.\\n\\nTonight Josephine will open the evening with a short solo set before joining the trio for the second part of their performance. \\n\\nExpect lush impressionism, dark atmospheres, lyrical melodies, intricate textures and intoxicating grooves. \\n\\n“Just gorgeous, pure music. Softly, as in a morning sunrise.” – Darren Bergstein, Downtown Music Gallery NYC\\nReviewing Ripples\\n\\n“Debussy was creating elements of modern jazz decades before it emerged and if he were alive today, one could imagine this is the kind of combo he might put together.” – Dominic Rivron, INTERNATIONAL TIMES”\\nReviewing The Act Of Noticing\\n\\n\\nDiscus Music: discusmusic.bandcamp.com / discus-music.org\\n\\nWe are a large Sheffield based independent label for creative music with over 200 CD/DL releases, curated by Martin Archer. As well as the residency group leaders Martin Archer, Charlotte Keeffe and Martin Pyne, artists on the label include Keith Tippett, Julie Tippetts, Paul Dunmall, Cecil Taylor, Tony Oxley, Pat Thomas, Laura Cole, Let Spin, Das Rad, Orchestra Of The Upper Atmosphere, Uroboro, Stephen Grew, Guy Segers, Corey Mwamba, Robert Mitchell, Alya Al-Sultani, Inclusion Principle, Johnny Hunter, Mick Beck, Billy Marrows, Jan Todd / frostlake, Faith Brackenbury, Tony Bianco, The Exu, Faradena Afifi, Steve Beresford, Paul Khimasia Morgan, Laura Jurd, Keir Cooper, Ron Caines, Matthew Bourne, Chris Sharkey, Carla Diratz, Theo May, Paul Taylor, This Celestial Engine, Fjall, Walt Shaw, Steve Tromans, Rachel Musson, Mark Sanders, James Mainwaring, Ricard Scott, Army Of Briars, Nick Robinson, Michael Bardon, Bo Meson, Juxtavoices, Alex Ward and many more.\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":331,\"name\":\"Discus Music\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":675,\"name\":\"Concession\",\"description\":\"Special price for unwaged attendees\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":676,\"name\":\"Standard\",\"description\":\"Standard general admission\",\"price\":12.5,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":677,\"name\":\"Supporter\",\"description\":\"A voluntary higher price for those who wish to show additional support for this concert series\",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":23,\"name\":\"jazz\"},{\"id\":163,\"name\":\"Free improvisation\"}]},{\"id\":731,\"name\":\"Discus Music Residency March 2027 - HI RES HEART\",\"start_time\":\"2027-03-21T19:30:00Z\",\"end_time\":\"2027-03-21T22:00:00Z\",\"poster\":\"6430a3e5d75c60319297da2dbd32acdc.webp\",\"background\":\"\",\"description\":\"The Discus Music residency at the Horse Hospital, Colonnade WC1N 1JD takes place on the third Sunday of each month throughout 2027, and rotates between three artists on the label:  Hi Res Heart, Right Here Right Now and The Martin Pyne Ensemble. The venue is fully seated.\\n\\nSUNDAY 21st MARCH 2027 – DOORS 7.30 PM\\nHI RES HEART\\nMartin Archer – saxophones\\nCharlotte Keeffe – trumpet\\nGraham Clark – violin\\nMichael Bardon – double bass\\nMartin Pyne – drums, vibraphone\\nMelanie Little – dance\\n\\nHi Res Heart is an improvising group where spaciousness and fire co-exist. Even when the music is at its most abstract, the spirit of the blues is never too far away. The music is often direct and melodic in an open ended flow which reacts to the moment, while the unusual percussion set up of drum set, hand percussion and vibraphone provides an ever changing textural and rhythmic counterpoint. For this performance we are joined, as we are whenever space and budget permit, by the creative dance of Melanie Little.\\n\\n\\\"This is resolutely experimental jazz inventiveness, with room left for each musician's creativity.\\\" - Guy Stuckens RADIO AIR LIBRE\\n\\n\\\"There are too many highlights to mention. It may have its roots in the music of 70s Chicago, but it’s superfluous to know this: Hi Res Heart transcend them to create a music of their own that is very much of the 2020s. I could listen to this music all day.\\\" - Dominic Rivron, INTERNATIONAL TIMES\\n\\n\\\"Will have all your senses on full alert.\\\" - PAULA MCADAM\\n\\n\\\"Superb examples of what the group can do without charts in front of them. Fans of free jazz and free improvisation will find plenty to get excited about.\\\" - Peter Thelen, EXPOSÉ\\n\\n\\\"Wild, florid and fantastic in its scope; a must for all those seeking adventure.\\\" - Mr Olivetti, FREQ\\n\\n\\\"Seven meticulously crafted plays, each as captivating as the last, each with its own unique character.\\\" - Marie Mesmer, HIGHLANDS\\n\\n+ SUPPORT\\n\\nDiscus Music: discusmusic.bandcamp.com / discus-music.org\\n\\nWe are a large Sheffield based independent label for creative music with over 200 CD/DL releases, curated by Martin Archer. As well as the residency group leaders Martin Archer, Charlotte Keeffe and Martin Pyne, artists on the label include Keith Tippett, Julie Tippetts, Paul Dunmall, Cecil Taylor, Tony Oxley, Pat Thomas, Laura Cole, Let Spin, Das Rad, Orchestra Of The Upper Atmosphere, Uroboro, Stephen Grew, Guy Segers, Corey Mwamba, Robert Mitchell, Alya Al-Sultani, Inclusion Principle, Johnny Hunter, Mick Beck, Billy Marrows, Jan Todd / frostlake, Faith Brackenbury, Tony Bianco, The Exu, Faradena Afifi, Steve Beresford, Paul Khimasia Morgan, Laura Jurd, Keir Cooper, Ron Caines, Matthew Bourne, Chris Sharkey, Carla Diratz, Theo May, Paul Taylor, This Celestial Engine, Fjall, Walt Shaw, Steve Tromans, Rachel Musson, Mark Sanders, James Mainwaring, Ricard Scott, Army Of Briars, Nick Robonson, Michael Bardon, Bo Meson, Juxtavoices, Alex Ward and many more.\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":331,\"name\":\"Discus Music\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":649,\"name\":\"Standard\",\"description\":\"Standard general admission.\",\"price\":12.5,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":650,\"name\":\"Supporter\",\"description\":\"A voluntary higher price for those who wish to show additional support for this concert series .\",\"price\":15,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":651,\"name\":\"Concession\",\"description\":\"Special price for unwaged attendees.\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":102,\"name\":\"improvisation\"},{\"id\":495,\"name\":\"#dance\"},{\"id\":513,\"name\":\"free jazz\"}]}],\"total_count\":106,\"limit\":100,\"offset\":100}",
