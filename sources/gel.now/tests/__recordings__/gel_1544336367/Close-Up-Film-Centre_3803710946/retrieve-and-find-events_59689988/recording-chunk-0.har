nsition:all .2s}.modal-actions .btn-secondary{background:transparent;border:1px solid #333;border:1px solid var(--theme-fg-200,#333);color:#fff;color:var(--theme-fg,#fff)}.modal-actions .btn-secondary:hover:not(:disabled){background:#222;background:var(--theme-fg-100,#222)}.modal-actions .btn-primary{background:#4c6ef5;background:var(--theme-accent,#4c6ef5);border:none;color:#fff}.modal-actions .btn-primary:hover:not(:disabled){background:#4263eb;background:var(--theme-accent-hover,#4263eb)}.modal-actions button:disabled{cursor:not-allowed;opacity:.5}\n</style><script type=\"module\" src=\"/_astro/page.DSySmlfp.js\"></script></head> <body class=\"text-surface-900 min-h-screen font-sans flex flex-col\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <header class=\"site-header sticky top-0 z-30\" style=\"background-color: var(--theme-bg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <div class=\"site-header__inner\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <a href=\"/\" class=\"site-header__logo\" style=\"color: var(--theme-fg); --themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\" data-astro-cid-sckkx6r4> <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 241.3\" class=\"site-header__logo-img\" aria-label=\"gel\" role=\"img\"><path d=\"M74.4,165.92c25.83,1.12,30.04-24.56,28.92-55.87-1.54-32.29-2.81-60.08-33.69-60.08-27.09,0-39.87,29.62-38.04,63.03,1.68,27.65,11.23,51.52,42.81,52.92ZM298.43,101.35c38.6.28,57.83-6.04,57.83-24.42,0-21.48-22.6-36.64-51.52-37.06-36.08-.56-57.13,11.79-57.13,32.85,0,16.42,18.95,28.35,50.81,28.64ZM0,113.56C0,61.76,13.62,30.18,53.48,30.18c16.7,0,17.55,1.4,33.41,1.4,18.67,0,33.27-11.37,51.52-11.37s16.14,27.37,33.13,29.9c29.76,4.49,42.25-30.32,122.26-30.32,99.52,0,103.31,41.55,130.