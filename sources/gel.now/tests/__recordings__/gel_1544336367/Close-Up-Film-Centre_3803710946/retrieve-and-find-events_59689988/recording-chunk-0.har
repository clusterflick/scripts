ject-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Zu</h1>  </div> <p class=\"text-surface-600 mb-4\"> Tuesday, August 18, 2026 · 6:00 PM – 10:30 PM </p> <div class=\"mb-6\"> <a href=\"/venues/65\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> New Cross Inn </a> <p class=\"text-sm text-surface-600\">323 New Cross Road</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/477\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Zu </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://pit.live/events/zu-1\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">Real Life Presents<br /><br />Zu<br />An Italian jazz-punk-noise explosion, and you can dance to it. Shook the building to it's core last summer and back to do it all again, armed with a new album. <br /><br />New Cross Inn, nearest stations New Cross Gate and New Cross<br />£17</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/94\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Real Life Presents </a>  </p> <div class=\"mt-6\">  <div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\"> Zu </p> <a href=\"https://zuband.bandcamp.com/album/ferrum-sidereum\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-sm text-surface-600 hover:text-surface-900 hover:underline\"> Zu </a> </div> </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(a(t)),5:t=>new Set(a(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>1/0*t},o=t=>{let[l,e]=t;return l in i?i[l](e):void 0},a=t=>t.map(o),m=t=>typeof t!=\"object\"||t===null?t:Object.fromEntries(Object.entries(t).map(([l,e])=>[l,o(e)]));class y extends HTMLElem