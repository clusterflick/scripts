nd the first building to be bought under the “community right to bid” provisions of the Localism Act.\\n\\nWe are a safe space for people of all ages, their children, and quite often, their pets. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,5],&quot;name&quot;:[0,&quot;The Ivy House&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TGzfQKEnoNUB9Nl&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,226],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,353],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,9.55],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,150],&quot;quantity_sold&quot;:[0,15],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,73],&quot;name&quot;:[0,&quot;South London&quot;]}],[0,{&quot;id&quot;:[0,108],&quot;name&quot;:[0,&quot;peckham&quot;]}],[0,{&quot;id&quot;:[0,109],