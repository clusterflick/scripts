;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2131],&quot;artist_name&quot;:[0,&quot;Macy See&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2132],&quot;artist_name&quot;:[0,&quot;Maxou&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,41],&quot;name&quot;:[0,&quot;SET Social&quot;],&quot;address&quot;:[0,&quot;55a Nigel Road&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;United Kingdom&quot;],&quot;postcode&quot;:[0,&quot;SE15 4NP&quot;],&quot;capacity&quot;:[0,230],&quot;description&quot;:[0,&quot;SET Social is our not-for-profit arts and social club in Peckham, run by London-based arts organisation and registered charity, SET. Bringing together a café, bar, library, and garden under one roof, the space operates under a Club Premises Certificate licence and runs as a members’ club, with membership helping to keep the doors open and the venue in everyday use as a community-led arts and social centre.\\n\\nAt the heart of SET Social is an exciting and diverse arts and music programme, spanning everything from screenings and workshops to live music and DJ sets. Open seven days a week, the space invites people to drop in – whether that’s for a quiet coffee, time in the library or garden, or a late night at the bar.\\n\\nMembership costs just £12 a year and is reinvested directly into the space, while also supporting SET’s wider charitable projects across London. As a member, you have full access to the venue, events, and late nights, and you’re welcome to bring guests along. With an inclusive ethos always, SET Social remains open and welcoming to all, prioritising affordability, accessibility, self-expression, and a community-focused approach.\\n\\nMore information can also be found at: https://setspace.uk/social/&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,348],&quot;name&quot;:[0,&quot;Dillon Home&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1Tp8HbK0tb1kVh0A&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,323],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,605],&quot;name&quot;:[0,&quot;POOR QUEERS (sold out)&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,70],&quot;quantity_sold&quot;:[0,70],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,606],&quot;name&q