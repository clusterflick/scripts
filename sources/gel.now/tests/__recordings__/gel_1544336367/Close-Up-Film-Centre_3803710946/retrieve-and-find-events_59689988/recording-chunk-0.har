en mb-6\"> <img src=\"https://api.gel.now/api/events/590/images/poster/4429fe816ec5e1dd2e77101629508932.webp\" alt=\"Złom with excel dj, new flesh, Wash Electra, london community laptop orchestra\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">Złom with excel dj, new flesh, Wash Electra, london community laptop orchestra</h1>  </div> <p class=\"text-surface-600 mb-4\"> Saturday, July 18, 2026 · 7:30 PM – 11:59 PM </p> <div class=\"mb-6\"> <a href=\"/venues/3\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Spanners </a> <p class=\"text-sm text-surface-600\">Arch 504, Ridgway Rd</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/84\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> New Flesh </a> <span> · </span> <a href=\"/artists/237\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> London Community Laptop Orchestra </a> <span> · </span> <a href=\"/artists/788\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Excel DJ </a> <span> · </span> <a href=\"/artists/1258\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Wash Electra </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <h2 class=\"text-lg font-medium text-surface-900 mb-4\">Tickets</h2> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,typeof o!=\"symbol\"?o+\"\":o,a);{let i={0:t=>m(t),1:t=>a(t),2:t=>new RegExp(t),3:t=>new Dat