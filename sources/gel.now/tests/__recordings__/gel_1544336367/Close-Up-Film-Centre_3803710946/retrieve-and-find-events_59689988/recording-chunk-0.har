dated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,708],&quot;name&quot;:[0,&quot;our trans+ slivers&quot;],&quot;description&quot;:[0,&quot;DM us on insta @sliver.ldn for the code. No questions, no assumptions, no judgement ♡&quot;],&quot;price&quot;:[0,15],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,50],&quot;quantity_sold&quot;:[0,34],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,true],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,false],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,1445],&quot;url&quot;:[0,&quot;https://soundcloud.com/peopleandplacesldn/people-places-039-annx-1?in=annx-anna-whomp/sets/mixes&amp;si=96b2edb9627d4012b4cc2b6cae76a255&amp;utm_source=clipboard&amp;utm_medium=text&amp;utm_campaign=social_sharing&quot;],&quot;display_title&quot;:[0,&quot;&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;]}],[0,{&quot;id&quot;:[0,1446],&quot;url&quot;:[0,&quot;https://on.soundcloud.com/CCE2PBYvqHeb9bdAIH&quot;],&quot;display_title&quot;:[0,&quot;&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;]}],[0,{&quot;id&quot;:[0,1447],&quot;url&quot;:[0,&quot;https://on.soundcloud.com/pF08TUkohK3QQ4txhn&quot;],&quot;display_title&quot;:[0,&quot;&quot;],&quot;is_embedded&quot;:[0,true],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,2],&quot;date_created&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T18:08:54.408194Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,10],&quot;name&quot;:[0,&quot;techno&quot;]}],[0,{&quot;id&quot;:[0,26],&quot;name&quot;:[0,&quot;trance&quot;]}],[0,{&quot;id&quot;:[0,463],&quot;name&quot;:[0,&quot;psy&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">from the deepest of dreams we astir from our bliss <br />whispers breathe in the air, an awakening not to be missed ⟢<br /><br />⟡ 08.08 • S L I V E R • 23:00-07:00 ⟡<br /><br />ANNX<br />MATRIARK B2B MONA SAGE<br />SLINKY KINKY<br />TANGELA<br /><br />Flowing, moving, growing, evolving…<br /><br />A celebration of excellence in London's queer trance and techno scenes ⟢<br /><br />After a one-year hiatus since our last encounter, our 4th edition births a brand new season of SLIVER.<br /><br />Our re-birth inhabits our city's favourite Steam Room at FOLD and we’re excited to invite two international artists to guide us in ritual alongside a selection of our favourite local enchanters, including a new SLIVER resident debut.<br /><br />SLIVER is first and foremost a FLINTA+ and queer space. Anyone with an open heart who is a part of the queer communities or considers themselves an active ally is welcome to celebrate with us.<br /><br />At its core, we believe that each sliver shines just as bright as the next. There will be no hierarchy and set times are to remain unannounced.<br /><br />~~~~~~~~~~~~~~~~~~~~~~~~~ <br /><br />a r t i s t s :<br /><br />⟡ a n n x ⟡<br />Inspired by cities and dancefloors where she’s lived and explored, ANNX’s unique seductive sound echos within her psychedelic selections across trance, prog, psy, techno, tech house, dubstep and more.<br /><br />Anna’s commitment to the scene goes beyond the booth, she carefully identifies niche sounds that are missing in the UK and has become a staple for psychedelic music on London’s club circuit. In 2021, she founded Whomp, a non-profit party in London which she now co-runs with Lora Mipsum. In 2023, she started a brand-new project perspectives• with lighting designer Nicole Gordon. Most recently, she joined the Above Below music team.<br /><br /><br />⟡ m e l a t i ⟡ <br />Melati steps in for Matriark who can no longer make it to London for her b2b with Mona Sage. <br /><br />Spawned from an unapologetically deep, psychedelic and sensual sound, Melati meanders the wider realms of techno, trance and psy, weaved together in a style that favours mesmeric blends with technical precision.<br /><br />As an artist, venue manager and promoter, Melati’s relationship with music is intrinsic to every aspect of their life. From a Masters of Architecture that explores the spatial, social and political position of nightclubs in a city to a tangible body of on-the-ground work in venues, Melati has lived and breathed the spaces in which we find sanctuary throughout all of their adult career.<br /><br /><br />⟡ m o n a s a g e ⟡<br />Born into a family of musicians in sunny Toulouse, it’s evident where Mona got her natural musical flair from.<br /><br />Mona’s famously energetic, eclectic arsenal of tracks mirror her own vibrant personality. A desire to entertain sees her sets meticulously weave between techno, breakbeats, electro and all the rich, deep and driving bits in between.<br /><br /><br />⟡ s l i n k y k i n k y ⟡<br />With a thirst for growth, she moves with a intuitive flow that is felt through her sets. She builds a cocoon of energy on the dancefloor, weaving high-energy pumpers, psychedelic textures and chuggy, hypnotic techno, pulling every room she touches into a trance.<br /><br />Every set is constructed with intent: a dialogue between physical movement and emotional resonance. Slinky Kinky’s performances are designed to charge the atmosphere, pulling dancers into her orbit and keeping them there until the very last beat.<br /><br /><br />⟡ t a n g e l a ⟡<br />Tangela’s style of aural storytelling is as distinct as it is varied. She guides the listener through deep, subby, subterranean worlds; encouraging listeners to float up through spacious, textural soundscapes full of unexpected turns, all with a nimble and playful touch.<br /><br />With her strength lying in versatility of genre, her sound is undeniably psychedelic, & one with deep connection to the Australian bush she soundtracks so regularly. She transports you with intention to moments in leafy clearings, hazy morning rays poking through the gumtrees, thumping kicks drenched in subby, dubby, gurgling undertones.<br /><br /><br />~~~~~~~~~~~~~~~~~~~~~~~~~ <br /><br />e n j o y m e n t :<br />This is a space for celebration, exploration, expression and positive release. It is encouraged to participate mindfully with awareness of yourself and the space you fill.<br /><br />b o u n d a r i e s :<br />Please leave any assumptions of gender, sexuality, race, ability or identity at the door and proceed to interact with those who give enthusiastic consent. We expect the community to treat themselves, each other and the space with kindness and respect.<br /><br />n o u r i s h m e n t :<br />We implore you to immerse yourself in the party, the music and the space and enjoy it at your own pace. We will not be serving food this time, so feel free to bring snacks to fuel your body to dance until the sunrise. The venue will not permit liquids of any form.<br /><br />l i m i t s :<br />Strictly 21+.<br />Physical ID is mandatory for entry.<br />Photography will not be permitted.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/327\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> SLIVER </a>  </p> <div class=\"mt-6\">  <div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\">  </p> <iframe width=\"100%\" height=\"400\" scrolling=\"no\" frameborder=\"no\" allow=\"autoplay; encrypted-media\" src=\"https://w.soundcloud.com/player/?visual=true&url=https%3A%2F%2Fapi.soundcloud.com%2Ftracks%2F1286351440&show_artwork=true\"></iframe> </div><div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\">  </p> <iframe width=\"100%\" height=\"400\" scrolling=\"no\" frameborder=\"no\" allow=\"autoplay; encrypted-media\" src=\"https://w.soundcloud.com/player/?visual=true&url=https%3A%2F%2Fapi.soundcloud.com%2Ftracks%2F2163439995&show_artwork=true\"></iframe> </div><div class=\"mt-4\"> <p class=\"text-sm text-surface-600 mb-1\">  </p> <iframe width=\"100%\" height=\"400\" scrolling=\"no\" frameborder=\"no\" allow=\"autoplay; encrypted-media\" src=\"https://w.soundcloud.com/player/?visual=true&url=https%3A%2F%2Fapi.soundcloud.com%2Ftracks%2F2251019129&show_artwork=true\"></iframe> </div> </div> </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"