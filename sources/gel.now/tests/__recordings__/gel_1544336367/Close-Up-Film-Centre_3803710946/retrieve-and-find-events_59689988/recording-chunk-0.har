e,\"external_url\":\"https://pit.live/events/locked-shut\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1568,\"artist_name\":\"Locked Shut\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":71,\"name\":\"metal\"},{\"id\":82,\"name\":\"metalcore\"},{\"id\":404,\"name\":\"South East London\"},{\"id\":419,\"name\":\"hardcore punk\"}]},{\"id\":851,\"name\":\"Hoxton Cabal 1st Birthday: Grace Sands, Benebe b2b Special Guest, Phil James, Fari Mond\",\"start_time\":\"2026-09-11T21:30:00Z\",\"end_time\":\"2026-09-12T03:00:00Z\",\"poster\":\"9a36b728bf0ab6160dfdf325cef8d8db.webp\",\"background\":\"\",\"description\":\"Hoxton Cabal turns one this September, and we are putting on a special line-up to celebrate!  \\n\\nFor a vinyl-only night it is only fitting that we invite the almighty Grace Sands to help us blow out our first candle. \\n\\nExpect those absolutely classic, deep and cheeky house cuts from Grace. Benebe will be joined for a special b2b by a surprise guest to close out the party with, well, you’ll find out!  \\n\\nFriends of the Cabal Phil James and Fari Mond will get us into the groove in true Cabal style. \\n\\nCapacity is limited to 80.  \\n\\nSee you down there…\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2193,\"artist_name\":\"Grace Sands\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2194,\"artist_name\":\"Benebe\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2195,\"artist_name\":\"Phil james\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2196,\"artist_name\":\"Fari Mond\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":144,\"name\":\"Hoxton Cabin\",\"address\":\"132 Kingsland Road\",\"city\":\"\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":223,\"name\":\"Didsomeonesay…\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":750,\"name\":\"First Release\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":10,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":751,\"name\":\"General Admission\",\"price\":13,\"currency\":\"GBP\",\"quantity_available\":30,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":9,\"name\":\"house\"},{\"id\":19,\"name\":\"deep house\"},{\"id\":117,\"name\":\"vinyl\"}]},{\"id\":870,\"name\":\"Expert Death x Untitled 909: Azu Tiwaline, ophélie, basic chanel + Sarjan\",\"start_time\":\"2026-09-11T22:00:00Z\",\"end_time\":\"2026-09-12T05:00:00Z\",\"poster\":\"e937cf55acb7a18c8c41e88d074fbffd.webp\",\"background\":\"\",\"description\":\"Expert Death and Untitled 909 team up for an end-of-summer shindig.\\n\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://ra.co/events/2483969\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":600,\"artist_name\":\"Basic Chanel\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2245,\"artist_name\":\"Azu Tiwaline\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2246,\"artist_name\":\"ophélie\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2247,\"artist_name\":\"Sarjan\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":2,\"name\":\"Ormside Projects\",\"address\":\"Penarth Centre, 32 Ormside Street\",\"city\":\"London\",\"country\":\"U.K.\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":53,\"name\":\"Ormside Projects\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":891,\"name\":\"Materials: A Festival of Visual Culture and Politics\",\"start_time\":\"2026-09-12T10:00:00Z\",\"end_time\":\"2026-09-12T21:00:00Z\",\"poster\":\"d83591b9f7e02852d81f1eb77e613940.webp\",\"background\":\"\",\"description\":\"Join us at Pelican House for the second Materials Festival, where we explore visual and spatial practices as a force for radical imagination and transformative social change. \\n​The theme for this year is embedded practice: what does it mean to develop a creative practice that is genuinely embedded in a place or community? How can we organise with our neighbours, colleagues and friends to respond to our shared material struggles? And what is our vision of the “good life” that we’re all building towards?\\n\\n​We’ll start the day at 10am, with free snacks and a pay-what-you-can lunch. Bookworkers and Beyond will be running a Publishing Fair, and we’ll be displaying London’s Ours, an exhibition of visual materials from the Greater London Council 1981–1986. After 6pm we’ll have a special performance by Circle Dance and a social with drinks and music.\\n\\n​Conversations\\n​Multitudes\\n\\n​Migrants in Culture\\n\\n​Common Knowledge\\n\\n​Lola Olufemi\\n\\n​Sarah Stein Lubrano\\n\\n​Unit 38\\n\\n​House of Annetta\\n\\n​Case studies\\n​Slow + Dirty Press\\n\\n​FAT Studio\\n\\n​Wards Corner Community Plan\\n\\n​Tottenham Family Fight Back\\n\\n​Workshops\\n​Artists \\u0026 Culture Workers\\n\\n​Autonomous Design Group\\n\\n​Cooperation Town\\n\\n​Section of Architectural Workers\\n\\n​The Department of Information \\u0026 Propaganda\\n\\n​The People’s Prop Department\\n\\n​workers.coop\\n\\n​Bookworkers \\u0026 Beyond Publishing Fair\\n​BOOKS\\n\\n​F.A.T. Studio\\n\\n​Migrants in Culture\\n\\n​PageMasters\\n\\n​Slow + Dirty Press\\n\\n​Sticky Fingers Publishing\\n\\n​and more to be confirmed!\\n\\n​Open studios with Pelican residents\\n​Common Knowledge\\n\\n​Migrants in Culture\\n\\n​Unit 38\\n\\n​Plus!\\n​Circle Dance presents: Neither Albion Nor Britannia\\n\\n​London's Ours! A GLC Exhibition\\n\\n​Collective art marking with the London School of Solarpunk\\n\\n​Bethnal Green walking tours\\n\\n​Free childcare for children over 5\\n\\n​Organised by Common Knowledge and Unit 38, with support from the Rosa Luxemburg Stiftung and Pelican House.\\n\\n​All profits from ticket sales will be distributed between our speakers. Email us if you're unwaged and would like come — no one turned away for lack of funds.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://luma.com/p8mapcri\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"},{\"id\":3,\"name\":\"exhibition\"},{\"id\":7,\"name\":\"performance\"},{\"id\":9,\"name\":\"workshop\"},{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"venues\":[{\"id\":34,\"name\":\"Pelican House\",\"address\":\"144 Cambridge Heath Road\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":403,\"name\":\"Materials\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":625,\"name\":\"visual culture\"},{\"id\":626,\"name\":\"publishing fair\"}]},{\"id\":874,\"name\":\"SLSA x The Horse Hospital present: FUTURE FREQUENCIES\",\"start_time\":\"2026-09-12T19:00:00Z\",\"end_time\":\"2026-09-12T23:00:00Z\",\"poster\":\"8bcf9ce085f4c2e4d3da8d739312e4ce.webp\",\"background\":\"\",\"description\":\"South London Space Agency and The Horse Hospital present FUTURE FREQUENCIES, a new event series bringing spoken word, grime, vocal improvisation together with experimental electronics. Come through for the open mic spoken word jam and stay for live sets from Pouya Ehsaei, GRANDMIXXER, Alya Al-Sultani, and Mez\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"},{\"id\":7,\"name\":\"performance\"},{\"id\":9,\"name\":\"workshop\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":1405,\"artist_name\":\"Alya Al-Sultani\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1929,\"artist_name\":\"Grandmixxer\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2271,\"artist_name\":\"Pouya Ehsaei\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2273,\"artist_name\":\"Mez\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":136,\"name\":\"The Horse Hospital\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":786,\"name\":\"LOW INCOME/ UNWAGED\",\"price\":5,\"currency\":\"GBP\",\"quantity_available\":50,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":false,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":787,\"name\":\"STANDARD\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":98,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":97,\"name\":\"grime\"},{\"id\":212,\"name\":\"open mic\"},{\"id\":238,\"name\":\"spoken word\"}]},{\"id\":836,\"name\":\"Small Car NRG\",\"start_time\":\"2026-09-12T20:00:00Z\",\"end_time\":\"2026-09-13T02:00:00Z\",\"poster\":\"3d5bb1e9dc1c02ab03dd2dbc03bf879a.webp\",\"background\":\"\",\"description\":\"Small Car NRG is pulling in for a pitstop at Avalon Cafe where it all began! Multiple laps around the Surrey Canal Speedway completed, fresh fluids, detailing, engine remapped to to the GTI version (Great Tunes Included).\\n\\nVery very excited to be inviting Memory Palace over from Barcelona for her first show in London! Operating at the intersection of IDM, bass, techno, and trance, her sets explore the idea of sonic spiralling, rhythms looping inward, melodies pulling the room tighter together until everyone is moving within the same pulse. A meditation in motion, drifting between introspection and release, always tinted with a dark, driving undercurrent.\\n\\nSpecial guests incoming :)\\n\\nAs always we will be starting the night off with Tweakers Welcome which is a supportive and low-pressure environment to practice DJing in a real club, on a real soundsystem!\\n\\nSign up form on our instagram @smallcarnrg\\n\\nLets have it 🙂\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":360,\"artist_name\":\"Small Car NRG\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2142,\"artist_name\":\"Memory Palace\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":18,\"name\":\"Avalon Cafe\",\"address\":\"Unit D, Industrial Estate, Juno Way\",\"city\":\"London\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":93,\"name\":\"Small Car NRG\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":718,\"name\":\"Pay what you can\",\"description\":\"We have some pay what you can tickets available. \",\"price\":0,\"currency\":\"GBP\",\"quantity_available\":40,\"quantity_sold\":1,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":3,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":719,\"name\":\"Early bird\",\"price\":8,\"currency\":\"GBP\",\"quantity_available\":50,\"quantity_sold\":2,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":720,\"name\":\"General\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":100,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":false,\"sort_order\":1,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}]},{\"id\":506,\"name\":\"Erode / Sinister Feeling / Bullet | Real Life x Tombstone\",\"start_time\":\"2026-09-14T19:00:00Z\",\"end_time\":\"2026-09-14T22:30:00Z\",\"poster\":\"40496f589e4b81396e960cb4a259a4c2.webp\",\"background\":\"\",\"description\":\"Real Life \\u0026 Tombstone Present\\nTrouble from Baltimore...\\n\\nErode\\nViolent death metal hardcore on DAZE\\n\\nSinister Feeling\\nGnarled stomping powerviolence\\n\\n+ Support from\\nBullet\\nAction from London\\nhttps://www.instagram.com/bullethxc/\\n\\nFlesh Prison\\nEvil from Brighton\\nhttps://www.instagram.com/fleshprisonuk/\\n\\nWasting Thirst\\nViolence from the South\\nhttps://www.instagram.com/wastingthirst/\\n\\n\\nAnd more...\\n\\nMonday 14th September\\n£11\\nDoors 7pm\\nOld Blue Last, nearest stations Old Street and Shoreditch High Street\\n38 Great Eastern St, London EC2A 3ES\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/erode-x-sinister-feeling-1\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":396,\"artist_name\":\"Bullet\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1399,\"artist_name\":\"Erode\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1400,\"artist_name\":\"Sinister Feeling\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1514,\"artist_name\":\"Flesh Prison\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1911,\"artist_name\":\"Wasting Thirst\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":165,\"name\":\"Old Blue Last\",\"address\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":81,\"name\":\"ukhc\"},{\"id\":83,\"name\":\"grindcore\"},{\"id\":213,\"name\":\"East London\"},{\"id\":349,\"name\":\"powerviolence\"},{\"id\":419,\"name\":\"hardcore punk\"}]},{\"id\":326,\"name\":\"Real Life Presents | Bulldoze / Kartel / Mindless / Ballkick / Paresthesia\",\"start_time\":\"2026-09-15T18:00:00Z\",\"end_time\":\"2026-09-15T23:00:00Z\",\"poster\":\"335525e14f40c9e4ee0da82007645159.webp\",\"background\":\"\",\"description\":\"Real Life Presents\\n\\nBulldoze\\nBack once again for a 3rd legendary lesson in beatdowns. Still here and strong.\\n\\n+ support from\\nKartel\\nReturning LBU heavyweights\\n\\nMindless\\nThe most dangerous men in Kent\\n\\nBallkick\\nHardcore punk rage\\n\\nParesthesia\\nDeath metal hardcore youth\\n\\nNew Cross Inn, nearest stations New Cross and New Cross Gate\\n\\n£20\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"https://pit.live/events/bulldoze-3\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"}],\"is_free\":true,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":402,\"artist_name\":\"Paresthesia\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":955,\"artist_name\":\"Bulldoze\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1354,\"artist_name\":\"Kartel\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1355,\"artist_name\":\"Mindless\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1356,\"artist_name\":\"Ballkick\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":65,\"name\":\"New Cross Inn\",\"address\":\"323 New Cross Road\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":94,\"name\":\"Real Life Presents\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":68,\"name\":\"hardcore\"},{\"id\":73,\"name\":\"South London\"},{\"id\":74,\"name\":\"heavy\"},{\"id\":81,\"name\":\"ukhc\"}]},{\"id\":853,\"name\":\"Coby Sey / Miriam Adefris / Elliot Galvin / Tom Skinner (Quartet) | dove, Christine Kirubi\",\"start_time\":\"2026-09-15T19:00:00Z\",\"end_time\":\"2026-09-15T23:00:00Z\",\"poster\":\"7c74e517fcf77e2df6a0c50840114617.webp\",\"background\":\"\",\"description\":\"Coby Sey is a songwriter, producer, vocalist, multi-instrumentalist, and DJ who, after years spent navigating the DIY artist scene in South East London, has developed a distinctive presence as an artist and performer.\\n\\nCoby’s recorded work spans live instrumentation, sample-based productions, and experimental music, blending recognizable motifs of hip hop, noise, jazz, and grime into a dubbed-out anaesthesia.\\n\\nHe employs an open-door approach to sharing and creating music, which is evident in his long-term collaborations with Mica Levi and Tirzah, as well as with peers such as Dean Blunt, TYSON, Laurel Halo, and Speakers Corner Quartet. He is also a founding member of London’s CURL collective (alongside Mica and Brother May) and hosts a long-running monthly show on NTS.\\n\\n-- \\n\\nMiriam Adefris is a harpist based in London. Rooted in both improvisation and composed structures, her solo sets amalgamate diverse musical influences from classical and experimental to jazz. She has recently released a debut album with her new band Flur to critical acclaim. Notable collaborations include performances with Floating Points, Shabaka Hutchings and singer Ganavya.\\n\\n--\\n\\nElliot Galvin is a long-time trailblazer in the UK jazz firmament with five solo albums that have seen him top album of the year lists at the likes of Downbeat and Jazzwise, as well as being a member of the Mercury nominated Dinosaur, and collaborating with Shabaka Hutchings, Emma-Jean Thackray, Norma Winstone, Marius Neset and Mark Lockheart.\\n\\nGalvin has also earned a fierce reputation as a borderless improvisor having released records with the likes of Mark Sanders and his now labelmate Binker Golding. In 2020 he released an entirely improvised piano album and was named The Guardian album of the month and BBC Music magazine’s album of the year. His latest album The Ruin features Shabaka Hutchings, Sebastian Rochford, Ruth Goller and the Ligeti Quartet, released on Gearbox Records, and was named Gilles Peterson's jazz album of the year 2025 and editor’s pick in Downbeat Magazine.\\n\\n--\\n\\nThe drummer, composer, and producer Tom Skinner has been a vital and central figure in London’s underground music scene. He was one of two drummers in Sons of Kemet, the ecstatically militant quartet that turned the fight against British colonial oppression into a brass-band party. And he remains one-third of The Smile, a trio with Thom Yorke and Jonny Greenwood. He has released solo music as Hello Skinny and under his own name.\\n\\n--\\n\\ndove, Christine Kirubi is a poet-artist based in London. She is the author of WILDPLASSEN published by the87press in 2024.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":2,\"name\":\"gig\"},{\"id\":10,\"name\":\"talk\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":152,\"artist_name\":\"Coby Sey\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1084,\"artist_name\":\"dove / Christine Kirubi\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":1204,\"artist_name\":\"Tom Skinner\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2203,\"artist_name\":\"Miriam Adefris\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2204,\"artist_name\":\"Elliot Galvin\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"venues\":[{\"id\":17,\"name\":\"The Horse Hospital\",\"address\":\"Colonnade\",\"city\":\"London\",\"country\":\"\",\"capacity\":0,\"contact_email\":\"\",\"on_listings_site\":false,\"wheelchair_accessible\":false,\"accessible_bathrooms\":false,\"hearing_loop\":false,\"accessible_parking\":false,\"lift_access\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"promoters\":[{\"id\":136,\"name\":\"The Horse Hospital\",\"contact_email\":\"\",\"stripe_account_id\":\"\",\"ticket_email\":\"\",\"custom_domain\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"ticket_tiers\":[{\"id\":753,\"name\":\"General Admission\",\"price\":12,\"currency\":\"GBP\",\"quantity_available\":80,\"quantity_sold\":4,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":754,\"name\":\"Unwaged/Student\",\"price\":10,\"currency\":\"GBP\",\"quantity_available\":17,\"quantity_sold\":2,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":755,\"name\":\"Solidarity\",\"price\":14,\"currency\":\"GBP\",\"quantity_available\":28,\"quantity_sold\":0,\"resale_listed_count\":0,\"hidden\":false,\"password_protected\":false,\"is_pwyc\":false,\"is_free\":false,\"resale_enabled\":true,\"resale_when_event_sold_out\":true,\"sort_order\":0,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"}],\"tags\":[{\"id\":23,\"name\":\"jazz\"},{\"id\":102,\"name\":\"improvisation\"},{\"id\":163,\"name\":\"Free improvisation\"},{\"id\":211,\"name\":\"poetry\"},{\"id\":238,\"name\":\"spoken word\"},{\"id\":513,\"name\":\"free jazz\"}]},{\"id\":849,\"name\":\"Algorave // decelerate\",\"start_time\":\"2026-09-16T18:45:00Z\",\"end_time\":\"2026-09-16T23:00:00Z\",\"poster\":\"b098ea6fc3a93e6b354df95e8b93c168.webp\",\"background\":\"\",\"description\":\"London? Live? Coding? is hosting OG live coder \\u003ca href=\\\"https://www.youtube.com/watch?v=dIpzU71LAQQ\\\"\\u003eAlex McLean\\u003c/a\\u003e (who coined the term ‘algorave’) to collaborate on a new type of party. Depending on how it goes, it could be one of a kind! 🦙\\n\\nIt’s going to be a capital-a Algorave in the truest sense: Live coded dance music and visuals in a dark room with big speakers, with code projected for your pleasure. But in Algorave: decelerate we’re going to constrain the 22+ strong national/international lineup - the performers must play at a pre-specified BPM, with each performance slot decreasing in speed throughout the night. So we’ll start with hyper nosebleed techno from airhorn expert \\u003ca href=\\\"https://www.youtube.com/watch?v=ttDQRBQEyBs\\\"\\u003etodepond\\u003c/a\\u003e, and finish locked in to something like tripped-out dubby trance from \\u003ca href=\\\"https://www.youtube.com/watch?v=9iPRPIe_PbQ\\\"\\u003edigital selves\\u003c/a\\u003e.\\n\\nSomewhere in there we’ll also have an infiltration from the Sheffield Algorave scene, with \\u003ca href=\\\"https://www.nts.live/shows/ashley-plenty-vibes/episodes/ashley-plenty-vibes-9th-august-2026\\\"\\u003eDJ MYNA\\u003c/a\\u003e and \\u003ca href=\\\"https://www.youtube.com/live/414h7Vqk2r8?si=49J0K9efxjtFQdVk\\u0026t=22312\\\"\\u003eEpiploke\\u003c/a\\u003e (the latter being Alex’s from-scratch live code duo with Heavy Lifting) coming down from the North’s home of bleep and bassline… Along with \\u003ca href=\\\"https://www.youtube.com/watch?v=rpJhDR8XnDo\\\"\\u003ehellocatfood\\u003c/a\\u003e down from Birmingham, \\u003ca href=\\\"https://www.youtube.com/watch?v=rFuzW8Qw1oQ\\\"\\u003ePondskater\\u003c/a\\u003e coming from Germany and a whole host of talent from the insurgent London scene. The packed lineup will be kept perfectly to time by a friendly but fair robot. 🤖👍\\n\\nWith techbro accelerationism destroying the world, algorave is one example of humans using handmade code creatively and collectively, with this decelerationist algorave creating a brief opportunity to imagine a different future for ourselves.\\n\\n\\u003cem\\u003e\\\"The scene at an algorave is often what you'd expect from any good techno night - a dark room, engaging visuals. a decent, bass-heavy speaker set-up, and lots of people ready to dance. .. performers at algoraves respond to each other and the audience in real time, often projecting the lines of code onto the walls as they type. lt’s coding as improvisation and experiment..\\\" — The Wire magazine\\u003c/em\\u003e\\n\\n\\u003cem\\u003eLive coders write computer programs live, while the programs generate their music, but the focus is on people dancing and seriously enjoying themselves\\\" — Dazed and Confused\\u003c/em\\u003e\\n\\n\\u003cem\\u003e\\\".. not so much a revolution as a de-volution, a rolling back to the backend of music production, where the possibilities of the encoded information inside computer software is open and endless\\\" — Mixmag\\u003c/em\\u003e\\n\\n\\u003cem\\u003e\\\"... loud, disorientating and brilliant\\\" — The Guardian\\u003c/em\\u003e\\n\\nA collaboration between London? Live? Coding? and the Pattern Clubs of Sheffield and London.\",\"is_featured\":false,\"poster_small\":\"\",\"is_preview\":false,\"external_url\":\"\",\"is_announced\":true,\"is_on_listings_site\":true,\"resale_queue_enabled\":true,\"is_test_event\":false,\"is_cancelled\":false,\"categories\":[{\"id\":1,\"name\":\"club\"},{\"id\":2,\"name\":\"gig\"}],\"is_free\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\",\"artists\":[{\"id\":2174,\"artist_name\":\"Epiploke\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"Epiploke is a live coding duo made up of Lucy (aka Heavy Lifting) and Alex (aka Yaxu). Their music draws inspiration from mind-expanding patterns and rhythms from Ancient Greek and South Indian Carnatic traditions. Lucy co-founded SONA sound art collective and has performed widely including as part of TYPE and TYKE. Alex co-founded the algorave movement, instigated the free/open source TidalCycles and Strudel live coding environments and has also performed a lot around Europe. Lucy and Alex now regularly co-organise Algoraves, workshops and festivals back home in Sheffield UK as part of ‘Sheffield Pattern Club‘.\",\"image\":\"988647fb0873ba2315f6e576a993647e.webp\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2176,\"artist_name\":\"Todepond\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"Todepond is a todepond.\",\"image\":\"0a3f697b63310ac2b39a4cf44dfd06da.webp\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2177,\"artist_name\":\"Jane\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2178,\"artist_name\":\"mags?\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2180,\"artist_name\":\"Liimxa\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2181,\"artist_name\":\"illo\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2182,\"artist_name\":\"nadya via proxy\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2183,\"artist_name\":\"Seasonings\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2184,\"artist_name\":\"MYNA\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2185,\"artist_name\":\"mah:alias\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2186,\"artist_name\":\"Pondskater\",\"gov_name\":\"\",\"contact_email\":\"\",\"bio\":\"\",\"on_listings_site\":false,\"date_created\":\"0001-01-01T00:00:00Z\",\"date_updated\":\"0001-01-01T00:00:00Z\"},{\"id\":2187,\"artist_name\":\"v21\",\"gov_name\":\"\