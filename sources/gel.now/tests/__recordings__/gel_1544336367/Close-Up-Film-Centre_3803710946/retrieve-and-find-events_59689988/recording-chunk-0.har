=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,545],&quot;name&quot;:[0,&quot;Fran &amp; Flora present a night of contemporary Yiddish music, feat. Merlin &amp; Polina Shepherd, Ilana Cravitz String Band and Fran &amp; Flora&quot;],&quot;start_time&quot;:[0,&quot;2026-08-30T19:15:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-08-30T23:00:00Z&quot;],&quot;poster&quot;:[0,&quot;2e77bc561f41b4c089bd3ef65f5a2767.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Experimental-folk duo Fran &amp; Flora curate a special night at The Horse Hospital celebrating contemporary Yiddish culture, showcasing some of the UK’s most acclaimed klezmer artists.\\n\\nFran &amp; Flora present brand new material from their upcoming third album; Klezmer clarinet and piano-vocal duo Merlin &amp; Polina Shepherd perform a selection of original compositions; fiddler Ilana Cravitz + string band share a first public outing of selected tunes from Beregovsky&#39;s recently uncovered Tish Nign collection.\\n\\nABOUT THE ARTISTS\\n\\nFRAN &amp; FLORA\\n“time-travels brilliantly between solid folk origins and avant garde play with a surprise at every corner\\&quot; - Jude Rogers, The Guardian\\n\\nFran &amp; Flora&#39;s critically acclaimed releases and performances have led to their rise in prominence across folk and avant-garde musical landscapes alike. As leading women of their generation their sophomore album Precious Collection (Hidden Notes Records&#39;24) was The Guardian’s ‘Top 10 Best Folk Albums of the Year’. Presenting uniquely reworked Yiddish music (collected from archival recordings &amp; manuscripts) and original compositions for strings, electronics and voice they create an unrivalled evocative and &#39;border-defying&#39; (Mojo) aesthetic.\\nFar from recreating music from a bygone era their intricately sculpted contemporary sound remains &#39;as experimental as it is accessible&#39; (The Guardian). Fran &amp; Flora perform and teach at festivals globally. \\n\\nMERLIN &amp; POLINA SHEPHERD\\n\\&quot;the Led Zeppelin of contemporary Yiddish music.\\&quot; – Seth Rogovoy, author, &#39;The Essential Klezmer&#39;\\n\\nMerlin &amp; Polina Shepherd Duo (clarinets, voice, piano) perform together in a way that is rarely encountered. They play music from several linked cultures with improvisation, freedom and spontaneity. The Duo’s playful approach to their root traditions – klezmer, Slavic, East European and southern Medite­rranean – is full of knowledge and deference. It creates a unique sound that embraces the e­nduring spirit of folklore and takes the listener to new dimensions.\\n\\nThey have been performing as a duo since 2004. Apart from their own concerts, they collaborate internationally with performers of various disciplines: a baroque orchestra, a punk band, contemporary dancers, DJs, and theatre productions.\\n\\nILANA CRAVITZ is one of the world’s best-known klezmer fiddlers and is also in demand as a producer, editor, and Yiddish dance leader. Based in London, Ilana tours internationally and regularly helps to set up and run Yiddish culture festivals. She has introduced thousands of people to klezmer through her performances and teaching. Ilana was a co-founder of the London Klezmer Quartet and her book ‘Klezmer Fiddle – A How-To Guide’, is published by Oxford University Press.\\nIlana Cravitz’ Tish Nigumim String Band play a hand-picked selection of tunes from ‘Jewish Songs Without Words’ - an anthology of 215 tunes collected by Moshe Beregovski (1892-1961) that was prepared for publication in the late 1950s and then kept in the Vernadsky National Library, Kiev.\\nNigunim are tunes without words, composed to be sung, catchy and lift the spirits. \\nBeregovski’s book of nigunim was the fourth of five volumes of Jewish music painstakingly assembled by this dedicated Soviet Jewish ethnomusicologist. Tragically, he did not live to see them published. \\nIlana Cravitz is now working on an English edition of this volume, with its glimpses into a now-lost world.\\n\\n\\nThis event is open to the public, and is the closing event to the Jewish Music Institute’s Yiddish Cultural Weekend. \\nWith support from the JMI.\\n\\nDoors 7:15pm\\nMusic 7:45pm - 10:00pm\\nCurfew 11:00pm&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,7],&quot;name&quot;:[0,&quot;performance&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,1202],&quot;artist_name&quot;:[0,&quot;Francesca Ter-Berg&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1273],&quot;artist_name&quot;:[0,&quot;Flora Curzon&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1274],&quot;artist_name&quot;:[0,&quot;Ilana Cravitz&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1275],&quot;artist_name&quot;:[0,&quot;Merlin Shepherd&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1480],&quot;artist_name&quot;:[0,&quot;Fran &amp; Flora&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1890],&quot;artist_name&quot;:[0,&quot;Polina Shepherd&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,248],&quot;name&quot;:[0,&quot;Fran &amp; Flora&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1TYNBj2cwkoZkH2M&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,221],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,446],&quot;name&quot;:[0,&quot;Concession&quot;],&quot;price&quot;:[0,12],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,25],&quot;quantity_sold&quot;:[0,10],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,447],&quot;name&quot;:[0,&quot;Regular Price&quot;],&quot;price&quot;:[0,16],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,60],&quot;quantity_sold&quot;:[0,16],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,448],&quot;name&quot;:[0,&quot;Supporter&quot;],&quot;price&quot;:[0,25],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,5],&quot;quantity_sold&quot;:[0,2],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,false],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,308],&quot;name&quot;:[0,&quot;klezmer&quot;]}],[0,{&quot;id&quot;:[0,327],&quot;name&quot;:[0,&quot;contemporary&quot;]}],[0,{&quot;id&quot;:[0,375],&quot;name&quot;:[0,&quot;Yiddish Culture Weekend&quot;]}],[0,{&quot;id&quot;:[0,376],&quot;name&quot;:[0,&quot;JMI&quot;]}],[0,{&quot;id&quot;:[0,377],&quot;name&quot;:[0,&quot;Fran &amp; Flora&quot;]}],[0,{&quot;id&quot;:[0,378],&quot;name&quot;:[0,&quot;London&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Experimental-folk duo Fran & Flora curate a special night at The Horse Hospital celebrating contemporary Yiddish culture, showcasing some of the UK’s most acclaimed klezmer artists.<br /><br />Fran & Flora present brand new material from their upcoming third album; Klezmer clarinet and piano-vocal duo Merlin & Polina Shepherd perform a selection of original compositions; fiddler Ilana Cravitz + string band share a first public outing of selected tunes from Beregovsky's recently uncovered Tish Nign collection.<br /><br />ABOUT THE ARTISTS<br /><br />FRAN & FLORA<br />“time-travels brilliantly between solid folk origins and avant garde play with a surprise at every corner\" - Jude Rogers, The Guardian<br /><br />Fran & Flora's critically acclaimed releases and performances have led to their rise in prominence across folk and avant-garde musical landscapes alike. As leading women of their generation their sophomore album Precious Collection (Hidden Notes Records'24) was The Guardian’s ‘Top 10 Best Folk Albums of the Year’. Presenting uniquely reworked Yiddish music (collected from archival recordings & manuscripts) and original compositions for strings, electronics and voice they create an unrivalled evocative and 'border-defying' (Mojo) aesthetic.<br />Far from recreating music from a bygone era their intricately sculpted contemporary sound remains 'as experimental as it is accessible' (The Guardian). Fran & Flora perform and teach at festivals globally. <br /><br />MERLIN & POLINA SHEPHERD<br />\"the Led Zeppelin of contemporary Yiddish music.\" – Seth Rogovoy, author, 'The Essential Klezmer'<br /><br />Merlin & Polina Shepherd Duo (clarinets, voice, piano) perform together in a way that is rarely encountered. They play music from several linked cultures with improvisation, freedom and spontaneity. The Duo’s playful approach to their root traditions – klezmer, Slavic, East European and southern Medite­rranean – is full of knowledge and deference. It creates a unique sound that embraces the e­nduring spirit of folklore and takes the listener to new dimensions.<br /><br />They have been performing as a duo since 2004. Apart from their own concerts, they collaborate internationally with performers of various disciplines: a baroque orchestra, a punk band, contemporary dancers, DJs, and theatre productions.<br /><br />ILANA CRAVITZ is one of the world’s best-known klezmer fiddlers and is also in demand as a producer, editor, and Yiddish dance leader. Based in London, Ilana tours internationally and regularly helps to set up and run Yiddish culture festivals. She has introduced thousands of people to klezmer through her performances and teaching. Ilana was a co-founder of the London Klezmer Quartet and her book ‘Klezmer Fiddle – A How-To Guide’, is published by Oxford University Press.<br />Ilana Cravitz’ Tish Nigumim String Band play a hand-picked selection of tunes from ‘Jewish Songs Without Words’ - an anthology of 215 tunes collected by Moshe Beregovski (1892-1961) that was prepared for publication in the late 1950s and then kept in the Vernadsky National Library, Kiev.<br />Nigunim are tunes without words, composed to be sung, catchy and lift the spirits. <br />Beregovski’s book of nigunim was the fourth of five volumes of Jewish music painstakingly assembled by this dedicated Soviet Jewish ethnomusicologist. Tragically, he did not live to see them published. <br />Ilana Cravitz is now working on an English edition of this volume, with its glimpses into a now-lost world.<br /><br /><br />This event is open to the public, and is the closing event to the Jewish Music Institute’s Yiddish Cultural Weekend. <br />With support from the JMI.<br /><br />Doors 7:15pm<br />Music 7:45pm - 10:00pm<br />Curfew 11:00pm</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/248\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Fran &amp; Flora </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <astro-island uid=\"194iIp\" prefix=\"r5\" component-url=\"/_astro/FloatingThemeSwitcher.D_12sDBb.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;data-astro-cid-sckkx6r4&quot;:[0,true]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;FloatingThemeSwitcher&quot;,&quot;value&quot;:true}\" await-children><div class=\"\n        fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40\n        transition-all duration-300 ease-in-out\n        w-15 sm:w-16\n      \" style=\"transform-origin:bottom right\"><button class=\"\n            w-15 h-15 sm:w-16 sm:h-16\n            rounded-full\n            shadow-2xl\n            backdrop-blur-md\n            flex items-center just