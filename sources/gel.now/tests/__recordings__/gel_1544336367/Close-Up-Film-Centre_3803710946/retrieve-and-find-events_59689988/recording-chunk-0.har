t;Mez&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,136],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;contact_email&quot;:[0,