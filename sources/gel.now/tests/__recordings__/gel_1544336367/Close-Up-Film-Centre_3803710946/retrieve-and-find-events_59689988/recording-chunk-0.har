          "content": {
            "mimeType": "text/html",
            "text": "<!DOCTYPE html><html lang=\"en\" data-theme-id=\"grey\" data-astro-cid-sckkx6r4 style=\"--themeBackground: #f0f0f0;--themeForeground: #2b2b2b;--themeAccent: #4c6ef5;\"> <head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\"><link rel=\"shortcut icon\" href=\"/favicon.ico\"><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\"><meta name=\"apple-mobile-web-app-title\" content=\"MyWebSite\"><link rel=\"manifest\" href=\"/site.webmanifest\"><title>Tufan ~ Closing Party ☆</title><meta name=\"description\" content=\"grassroots events london\"><!-- Initialize theme from localStorage immediately to prevent flash --><script>(function(){const themesData = {\"grey\":{\"id\":\"grey\",\"name\":\"Charcoal Granite\",\"background\":\"#f0f0f0\",\"foreground\":\"#2b2b2b\",\"accent\":\"#4c6ef5\"},\"grey-indigo\":{\"id\":\"grey-indigo\",\"name\":\"Grey Indigo\",\"background\":\"#3525a1\",\"foreground\":\"#d6d6d6\",\"accent\":\"#4c6ef5\"},\"coral-chocolate\":{\"id\":\"coral-chocolate\",\"name\":\"Coral Chocolate\",\"background\":\"#45301f\",\"foreground\":\"#ff8a7d\",\"accent\":\"#4c6ef5\"},\"mint-teal\":{\"id\":\"mint-teal\",\"name\":\"Teal Mint\",\"background\":\"#cfffa8\",\"foreground\":\"#284654\",\"accent\":\"#4c6ef5\"},\"lavender-plum\":{\"id\":\"lavender-plum\",\"name\":\"Plum Lavender\",\"background\":\"#fbd6ff\",\"foreground\":\"#442f61\",\"accent\":\"#4c6ef5\"},\"olive-lime\":{\"id\":\"olive-lime\",\"name\":\"Lime Olive\",\"background\":\"#403716\",\"foreground\":\"#a6d636\",\"accent\":\"#4c6ef5\"},\"aqua-night\":{\"id\":\"aqua-night\",\"name\":\"Aqua Night\",\"background\":\"#28384f\",\"foreground\":\"#8fffda\",\"accent\":\"#4c6ef5\"},\"peach-brown\":{\"id\":\"peach-brown\",\"name\":\"Brown Peach\",\"background\":\"#ffa347\",\"foreground\":\"#472c10\",\"accent\":\"#1e3a8a\"}};\n\n      (function () {\n        try {\n          const storedThemeId = localStorage.getItem(\"gel-theme\");\n          let theme;\n\n          // Check if custom theme is selected\n          if (storedThemeId === \"custom\") {\n            const customThemeStr = localStorage.getItem(\"gel-custom-theme\");\n            if (customThemeStr) {\n              const customColors = JSON.parse(customThemeStr);\n              theme = {\n                background: customColors.background,\n                foreground: customColors.foreground,\n                accent: \"#4c6ef5\",\n              };\n            }\n          } else if (storedThemeId && themesData[storedThemeId]) {\n            theme = themesData[storedThemeId];\n          }\n\n          if (theme) {\n            const root = document.documentElement;\n\n            // Update data-theme-id attribute so components can read it\n            root.setAttribute(\"data-theme-id\", storedThemeId);\n\n            // Set base theme colors\n            root.style.setProperty(\"--theme-bg\", theme.background);\n            root.style.setProperty(\"--theme-fg\", theme.foreground);\n            root.style.setProperty(\"--theme-accent\", theme.accent);\n            root.style.setProperty(\n              \"--theme-accent-hover\",\n              `color-mix(in oklch, ${theme.accent} 85%, black 15%)`,\n            );\n\n            // Set color-mix variations\n            root.style.setProperty(\n              \"--theme-fg-950\",\n              `color-mix(in oklch, ${theme.foreground} 100%, ${theme.background} 0%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-900\",\n              `color-mix(in oklch, ${theme.foreground} 90%, ${theme.background} 10%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-800\",\n              `color-mix(in oklch, ${theme.foreground} 80%, ${theme.background} 20%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-700\",\n              `color-mix(in oklch, ${theme.foreground} 70%, ${theme.background} 30%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-600\",\n              `color-mix(in oklch, ${theme.foreground} 60%, ${theme.background} 40%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-500\",\n              `color-mix(in oklch, ${theme.foreground} 50%, ${theme.background} 50%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-400\",\n              `color-mix(in oklch, ${theme.foreground} 40%, ${theme.background} 60%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-300\",\n              `color-mix(in oklch, ${theme.foreground} 30%, ${theme.background} 70%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-200\",\n              `color-mix(in oklch, ${theme.foreground} 20%, ${theme.background} 80%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-100\",\n              `color-mix(in oklch, ${theme.foreground} 10%, ${theme.background} 90%)`,\n            );\n            root.style.setProperty(\n              \"--theme-fg-50\",\n              `color-mix(in oklch, ${theme.foreground} 5%, ${theme.background} 95%)`,\n            );\n          }\n        } catch (err) {\n          // localStorage not available or error reading, use SSR theme\n        }\n      })();\n    })();</script><link rel=\"stylesheet\" href=\"/_astro/about.DxE5t7jF.css\">\n<style>.ticket{align-items:center;display:flex;flex-direction:column;gap:15px;justify-content:center;padding:15px;width:100%}.ticket img{border-radius:10px;display:block;height:auto;max-width:500px;width:100%}.ticket .download-btn{background-color:#111;border:none;border-radius:8px;color:#f7f7f9;cursor:pointer;font-size:1rem;font-weight:500;padding:12px 24px;transition:background-color .2s ease}.ticket .download-btn:hover{background-color:#333}.ticket .download-btn:active{background-color:#000}.waitlist-modal-overlay{align-items:center;background:#000000b3;display:flex;justify-content:center;inset:0;padding:1rem;position:fixed;z-index:1000}.waitlist-modal{background:#1a1a1a;background:var(--theme-bg,#1a1a1a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:12px;max-width:400px;padding:2rem;position:relative;width:100%}.modal-close{background:none;border:none;color:#888;color:var(--theme-fg-400,#888);cursor:pointer;font-size:1.5rem;line-height:1;padding:.25rem;position:absolute;right:1rem;top:1rem}.modal-close:hover,.waitlist-modal h2{color:#fff;color:var(--theme-fg,#fff)}.waitlist-modal h2{font-size:1.5rem;margin:0 0 .5rem}.waitlist-modal .tier-info{color:#4c6ef5;color:var(--theme-accent,#4c6ef5);font-size:1.125rem;margin-bottom:1rem}.waitlist-description{color:#888;color:var(--theme-fg-400,#888);font-size:.875rem;line-height:1.5;margin-bottom:1.5rem}.waitlist-modal .form-group{margin-bottom:1rem}.waitlist-modal label{color:#fff;color:var(--theme-fg,#fff);display:block;font-size:.875rem;margin-bottom:.5rem}.waitlist-modal input{background:#0a0a0a;background:var(--theme-fg-50,#0a0a0a);border:1px solid #333;border:1px solid var(--theme-fg-200,#333);border-radius:8px;color:#fff;color:var(--theme-fg,#fff);font-size:1rem;padding:.75rem 1rem;width:100%}.waitlist-modal input:focus{border-color:#4c6ef5;border-color:var(--theme-accent,#4c6ef5);outline:none}.waitlist-modal input::-moz-placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal input::placeholder{color:#666;color:var(--theme-fg-400,#666)}.waitlist-modal .error-message{color:#ff5252;font-size:.875rem;margin-bottom:1rem}.modal-actions{display:flex;gap:1rem;margin-top:1.5rem}.modal-actions button{border-radius:8px;cursor:pointer;flex:1;font-size:1rem;font-weight:500;padding:.75rem 1.5rem;transition:all .2s}.modal-actions .btn-secondary{background:transparent