ack(){if(!this.hasAttribute(\"await-children\")||document.readyState===\"interactive\"||document.readyState===\"complete\")this.childrenConnectedCallback();else{let e=()=>{document.removeEventListener(\"DOMContentLoaded\",e),c.disconnect(),this.childrenConnectedCallback()},c=new MutationObserver(()=>{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"ZPrrOR\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,853],&quot;name&quot;:[0,&quot;Coby Sey / Miriam Adefris / Elliot Galvin / Tom Skinner (Quartet) | dove, Christine Kirubi&quot;],&quot;start_time&quot;:[0,&quot;2026-09-15T19:00:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-09-15T23:00:00Z&quot;],&quot;poster&quot;:[0,&quot;7c74e517fcf77e2df6a0c50840114617.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;Coby Sey is a songwriter, producer, vocalist, multi-instrumentalist, and DJ who, after years spent navigating the DIY artist scene in South East London, has developed a distinctive presence as an artist and performer.\\n\\nCoby’s recorded work spans live instrumentation, sample-based productions, and experimental music, blending recognizable motifs of hip hop, noise, jazz, and grime into a dubbed-out anaesthesia.\\n\\nHe employs an open-door approach to sharing and creating music, which is evident in his long-term collaborations with Mica Levi and Tirzah, as well as with peers such as Dean Blunt, TYSON, Laurel Halo, and Speakers Corner Quartet. He is also a founding member of London’s CURL collective (alongside Mica and Brother May) and hosts a long-running monthly show on NTS.\\n\\n-- \\n\\nMiriam Adefris is a harpist based in London. Rooted in both improvisation and composed structures, her solo sets amalgamate diverse musical influences from classical and experimental to jazz. She has recently released a debut album with her new band Flur to critical acclaim. Notable collaborations include performances with Floating Points, Shabaka Hutchings and singer Ganavya.\\n\\n--\\n\\nElliot Galvin is a long-time trailblazer in the UK jazz firmament with five solo albums that have seen him top album of the year lists at the likes of Downbeat and Jazzwise, as well as being a member of the Mercury nominated Dinosaur, and collaborating with Shabaka Hutchings, Emma-Jean Thackray, Norma Winstone, Marius Neset and Mark Lockheart.\\n\\nGalvin has also earned a fierce reputation as a borderless improvisor having released records with the likes of Mark Sanders and his now labelmate Binker Golding. In 2020 he released an entirely improvised piano album and was named The Guardian album of the month and BBC Music magazine’s album of the year. His latest album The Ruin features Shabaka Hutchings, Sebastian Rochford, Ruth Goller and the Ligeti Quartet, released on Gearbox Records, and was named Gilles Peterson&#39;s jazz album of the year 2025 and editor’s pick in Downbeat Magazine.\\n\\n--\\n\\nThe drummer, composer, and producer Tom Skinner has been a vital and central figure in London’s underground music scene. He was one of two drummers in Sons of Kemet, the ecstatically militant quartet that turned the fight against British colonial oppression into a brass-band party. And he remains one-third of The Smile, a trio with Thom Yorke and Jonny Greenwood. He has released solo music as Hello Skinny and under his own name.\\n\\n--\\n\\ndove, Christine Kirubi is a poet-artist based in London. She is the author of WILDPLASSEN published by the87press in 2024.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}],[0,{&quot;id&quot;:[0,10],&quot;name&quot;:[0,&quot;talk&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,152],&quot;artist_name&quot;:[0,&quot;Coby Sey&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1084],&quot;artist_name&quot;:[0,&quot;dove / Christine Kirubi&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,1204],&quot;artist_name&quot;:[0,&quot;Tom Skinner&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2203],&quot;artist_name&quot;:[0,&quot;Miriam Adefris&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2204],&quot;artist_name&quot;:[0,&quot;Elliot Galvin&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,17],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;address&quot;:[0,&quot;Colonnade&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;country&quot;:[0,&quot;&quot;],&quot;postcode&quot;:[0,&quot;WC1N 1JD&quot;],&quot;capacity&quot;:[0,120],&quot;description&quot;:[0,&quot;The Horse Hospital is an artist-led, not-for-profit independent arts venue in central London.\\n\\nEstablished in 1993 by Roger K. Burton, THH has uplifted countercultural and experimental art across music, performance, film, fashion, and visual art. It has also served as a living archive of countercultural activity and ‘outsider art.’ \\n\\nAs of 2025, The Horse Hospital is run by The Horse Hospital Collective. This collective has been entrusted with the responsibility of continuing, expanding upon and reaffirming The Horse Hospital’s originating vision, with a renewed focus on providing a home for DIY cultural practices. \\n\\nThe THH Collective’s internally-directed programme runs concurrently with usage of the space by wider communities through our Open Access scheme, as well as provision through direct hire. &quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;wheelchair_accessible&quot;:[0,false],&quot;accessible_bathrooms&quot;:[0,false],&quot;hearing_loop&quot;:[0,false],&quot;accessible_parking&quot;:[0,false],&quot;lift_access&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;promoters&quot;:[1,[[0,{&quot;id&quot;:[0,136],&quot;name&quot;:[0,&quot;The Horse Hospital&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;stripe_account_id&quot;:[0,&quot;acct_1THrHlGivx3E4NNy&quot;],&quot;ticket_email&quot;:[0,&quot;&quot;],&quot;listmonk_list_id&quot;:[0,106],&quot;custom_domain&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;is_billing_promoter&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;ticket_tiers&quot;:[1,[[0,{&quot;id&quot;:[0,753],&quot;name&quot;:[0,&quot;General Admission&quot;],&quot;price&quot;:[0,12],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,80],&quot;quantity_sold&quot;:[0,4],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,754],&quot;name&quot;:[0,&quot;Unwaged/Student&quot;],&quot;price&quot;:[0,10],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,17],&quot;quantity_sold&quot;:[0,2],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,755],&quot;name&quot;:[0,&quot;Solidarity&quot;],&quot;price&quot;:[0,14],&quot;currency&quot;:[0,&quot;GBP&quot;],&quot;quantity_available&quot;:[0,28],&quot;quantity_sold&quot;:[0,0],&quot;resale_listed_count&quot;:[0,0],&quot;hidden&quot;:[0,false],&quot;password_protected&quot;:[0,false],&quot;is_pwyc&quot;:[0,false],&quot;is_free&quot;:[0,false],&quot;resale_enabled&quot;:[0,true],&quot;resale_when_event_sold_out&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;tags&quot;:[1,[[0,{&quot;id&quot;:[0,23],&quot;name&quot;:[0,&quot;jazz&quot;]}],[0,{&quot;id&quot;:[0,102],&quot;name&quot;:[0,&quot;improvisation&quot;]}],[0,{&quot;id&quot;:[0,163],&quot;name&quot;:[0,&quot;Free improvisation&quot;]}],[0,{&quot;id&quot;:[0,211],&quot;name&quot;:[0,&quot;poetry&quot;]}],[0,{&quot;id&quot;:[0,238],&quot;name&quot;:[0,&quot;spoken word&quot;]}],[0,{&quot;id&quot;:[0,513],&quot;name&quot;:[0,&quot;free jazz&quot;]}]]]}],&quot;user&quot;:[0]}\" ssr client=\"load\" opts=\"{&quot;name&quot;:&quot;TicketForm&quot;,&quot;value&quot;:true}\" await-children><section class=\"relative\"><div class=\"border border-surface-300 rounded\"><div class=\"text-[color:var(--theme-fg)] text-[1.1rem] font-semibold text-center p-2.5 flex h-full\">Loading ticket options...</div></div></section><!--astro:end--></astro-island> </div> <div class=\"mt-6 text-surface-700\">Coby Sey is a songwriter, producer, vocalist, multi-instrumentalist, and DJ who, after years spent navigating the DIY artist scene in South East London, has developed a distinctive presence as an artist and performer.<br /><br />Coby’s recorded work spans live instrumentation, sample-based productions, and experimental music, blending recognizable motifs of hip hop, noise, jazz, and grime into a dubbed-out anaesthesia.<br /><br />He employs an open-door approach to sharing and creating music, which is evident in his long-term collaborations with Mica Levi and Tirzah, as well as with peers such as Dean Blunt, TYSON, Laurel Halo, and Speakers Corner Quartet. He is also a founding member of London’s CURL collective (alongside Mica and Brother May) and hosts a long-running monthly show on NTS.<br /><br />-- <br /><br />Miriam Adefris is a harpist based in London. Rooted in both improvisation and composed structures, her solo sets amalgamate diverse musical influences from classical and experimental to jazz. She has recently released a debut album with her new band Flur to critical acclaim. Notable collaborations include performances with Floating Points, Shabaka Hutchings and singer Ganavya.<br /><br />--<br /><br />Elliot Galvin is a long-time trailblazer in the UK jazz firmament with five solo albums that have seen him top album of the year lists at the likes of Downbeat and Jazzwise, as well as being a member of the Mercury nominated Dinosaur, and collaborating with Shabaka Hutchings, Emma-Jean Thackray, Norma Winstone, Marius Neset and Mark Lockheart.<br /><br />Galvin has also earned a fierce reputation as a borderless improvisor having released records with the likes of Mark Sanders and his now labelmate Binker Golding. In 2020 he released an entirely improvised piano album and was named The Guardian album of the month and BBC Music magazine’s album of the year. His latest album The Ruin features Shabaka Hutchings, Sebastian Rochford, Ruth Goller and the Ligeti Quartet, released on Gearbox Records, and was named Gilles Peterson's jazz album of the year 2025 and editor’s pick in Downbeat Magazine.<br /><br />--<br /><br />The drummer, composer, and producer Tom Skinner has been a vital and central figure in London’s underground music scene. He was one of two drummers in Sons of Kemet, the ecstatically militant quartet that turned the fight against British colonial oppression into a brass-band party. And he remains one-third of The Smile, a trio with Thom Yorke and Jonny Greenwood. He has released solo music as Hello Skinny and under his own name.<br /><br />--<br /><br />dove, Christine Kirubi is a poet-artist based in London. She is the author of WILDPLASSEN published by the87press in 2024.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/136\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> The Horse Hospital </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pas