{var n;((n=this.lastChild)==null?void 0:n.nodeType)===Node.COMMENT_NODE&&this.lastChild.nodeValue===\"astro:end\"&&(this.lastChild.remove(),e())});c.observe(this,{childList:!0}),document.addEventListener(\"DOMContentLoaded\",e)}}async childrenConnectedCallback(){let e=this.getAttribute(\"before-hydration-url\");e&&await import(e),this.start()}async start(){let e=JSON.parse(this.getAttribute(\"opts\")),c=this.getAttribute(\"client\");if(Astro[c]===void 0){window.addEventListener(`astro:${c}`,()=>this.start(),{once:!0});return}try{await Astro[c](async()=>{let n=this.getAttribute(\"renderer-url\"),[h,{default:p}]=await Promise.all([import(this.getAttribute(\"component-url\")),n?import(n):()=>()=>{}]),u=this.getAttribute(\"component-export\")||\"default\";if(!u.includes(\".\"))this.Component=h[u];else{this.Component=h;for(let f of u.split(\".\"))this.Component=this.Component[f]}return this.hydrator=p,this.hydrate},e,this)}catch(n){console.error(`[astro-island] Error hydrating ${this.getAttribute(\"component-url\")}`,n)}}attributeChangedCallback(){this.hydrate()}}d(y,\"observedAttributes\",[\"props\"]),customElements.get(\"astro-island\")||customElements.define(\"astro-island\",y)}})();</script><astro-island uid=\"ZNfxOy\" prefix=\"r3\" component-url=\"/_astro/TicketForm.Dq4RAzMK.js\" component-export=\"default\" renderer-url=\"/_astro/client.DYKcjN1Z.js\" props=\"{&quot;event&quot;:[0,{&quot;id&quot;:[0,849],&quot;name&quot;:[0,&quot;Algorave // decelerate&quot;],&quot;start_time&quot;:[0,&quot;2026-09-16T18:45:00Z&quot;],&quot;end_time&quot;:[0,&quot;2026-09-16T23:00:00Z&quot;],&quot;poster&quot;:[0,&quot;b098ea6fc3a93e6b354df95e8b93c168.webp&quot;],&quot;background&quot;:[0,&quot;&quot;],&quot;description&quot;:[0,&quot;London? Live? Coding? is hosting OG live coder &lt;a href=\\&quot;https://www.youtube.com/watch?v=dIpzU71LAQQ\\&quot;&gt;Alex McLean&lt;/a&gt; (who coined the term ‘algorave’) to collaborate on a new type of party. Depending on how it goes, it could be one of a kind! 🦙\\n\\nIt’s going to be a capital-a Algorave in the truest sense: Live coded dance music and visuals in a dark room with big speakers, with code projected for your pleasure. But in Algorave: decelerate we’re going to constrain the 22+ strong national/international lineup - the performers must play at a pre-specified BPM, with each performance slot decreasing in speed throughout the night. So we’ll start with hyper nosebleed techno from airhorn expert &lt;a href=\\&quot;https://www.youtube.com/watch?v=ttDQRBQEyBs\\&quot;&gt;todepond&lt;/a&gt;, and finish locked in to something like tripped-out dubby trance from &lt;a href=\\&quot;https://www.youtube.com/watch?v=9iPRPIe_PbQ\\&quot;&gt;digital selves&lt;/a&gt;.\\n\\nSomewhere in there we’ll also have an infiltration from the Sheffield Algorave scene, with &lt;a href=\\&quot;https://www.nts.live/shows/ashley-plenty-vibes/episodes/ashley-plenty-vibes-9th-august-2026\\&quot;&gt;DJ MYNA&lt;/a&gt; and &lt;a href=\\&quot;https://www.youtube.com/live/414h7Vqk2r8?si=49J0K9efxjtFQdVk&amp;t=22312\\&quot;&gt;Epiploke&lt;/a&gt; (the latter being Alex’s from-scratch live code duo with Heavy Lifting) coming down from the North’s home of bleep and bassline… Along with &lt;a href=\\&quot;https://www.youtube.com/watch?v=rpJhDR8XnDo\\&quot;&gt;hellocatfood&lt;/a&gt; down from Birmingham, &lt;a href=\\&quot;https://www.youtube.com/watch?v=rFuzW8Qw1oQ\\&quot;&gt;Pondskater&lt;/a&gt; coming from Germany and a whole host of talent from the insurgent London scene. The packed lineup will be kept perfectly to time by a friendly but fair robot. 🤖👍\\n\\nWith techbro accelerationism destroying the world, algorave is one example of humans using handmade code creatively and collectively, with this decelerationist algorave creating a brief opportunity to imagine a different future for ourselves.\\n\\n&lt;em&gt;\\&quot;The scene at an algorave is often what you&#39;d expect from any good techno night - a dark room, engaging visuals. a decent, bass-heavy speaker set-up, and lots of people ready to dance. .. performers at algoraves respond to each other and the audience in real time, often projecting the lines of code onto the walls as they type. lt’s coding as improvisation and experiment..\\&quot; — The Wire magazine&lt;/em&gt;\\n\\n&lt;em&gt;Live coders write computer programs live, while the programs generate their music, but the focus is on people dancing and seriously enjoying themselves\\&quot; — Dazed and Confused&lt;/em&gt;\\n\\n&lt;em&gt;\\&quot;.. not so much a revolution as a de-volution, a rolling back to the backend of music production, where the possibilities of the encoded information inside computer software is open and endless\\&quot; — Mixmag&lt;/em&gt;\\n\\n&lt;em&gt;\\&quot;... loud, disorientating and brilliant\\&quot; — The Guardian&lt;/em&gt;\\n\\nA collaboration between London? Live? Coding? and the Pattern Clubs of Sheffield and London.&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}],[0,{&quot;id&quot;:[0,2],&quot;name&quot;:[0,&quot;gig&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,2174],&quot;artist_name&quot;:[0,&quot;Epiploke&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;Epiploke is a live coding duo made up of Lucy (aka Heavy Lifting) and Alex (aka Yaxu). Their music draws inspiration from mind-expanding patterns and rhythms from Ancient Greek and South Indian Carnatic traditions. Lucy co-founded SONA sound art collective and has performed widely including as part of TYPE and TYKE. Alex co-founded the algorave movement, instigated the free/open source TidalCycles and Strudel live coding environments and has also performed a lot around Europe. Lucy and Alex now regularly co-organise Algoraves, workshops and festivals back home in Sheffield UK as part of ‘Sheffield Pattern Club‘.&quot;],&quot;image&quot;:[0,&quot;988647fb0873ba2315f6e576a993647e.webp&quot;],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,106],&quot;url&quot;:[0,&quot;https://epiploke.lurk.org/&quot;],&quot;display_title&quot;:[0,&quot;Epiploke homepage&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-08-06T17:47:07.285474Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-06T17:47:07.285474Z&quot;]}]]],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2176],&quot;artist_name&quot;:[0,&quot;Todepond&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;Todepond is a todepond.&quot;],&quot;image&quot;:[0,&quot;0a3f697b63310ac2b39a4cf44dfd06da.webp&quot;],&quot;external_links&quot;:[1,[[0,{&quot;id&quot;:[0,123],&quot;url&quot;:[0,&quot;https://www.todepond.com/#gigs&quot;],&quot;display_title&quot;:[0,&quot;Home&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,0],&quot;date_created&quot;:[0,&quot;2026-08-08T16:07:26.091371Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T16:07:26.091371Z&quot;]}],[0,{&quot;id&quot;:[0,124],&quot;url&quot;:[0,&quot;http://mas.to/@todepond&quot;],&quot;display_title&quot;:[0,&quot;Mastodon&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,1],&quot;date_created&quot;:[0,&quot;2026-08-08T16:07:26.092447Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T16:07:26.092447Z&quot;]}],[0,{&quot;id&quot;:[0,125],&quot;url&quot;:[0,&quot;https://youtube.com/@todepond&quot;],&quot;display_title&quot;:[0,&quot;Youtube&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,2],&quot;date_created&quot;:[0,&quot;2026-08-08T16:07:26.09342Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T16:07:26.09342Z&quot;]}],[0,{&quot;id&quot;:[0,126],&quot;url&quot;:[0,&quot;https://todepond.bandcamp.com/&quot;],&quot;display_title&quot;:[0,&quot;Bandcamp&quot;],&quot;is_embedded&quot;:[0,false],&quot;is_active&quot;:[0,true],&quot;sort_order&quot;:[0,3],&quot;date_created&quot;:[0,&quot;2026-08-08T16:07:26.094446Z&quot;],&quot;date_updated&quot;:[0,&quot;2026-08-08T16:07:26.094446Z&quot;]}]]],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2177],&quot;artist_name&quot;:[0,&quot;Jane&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2178],&quot;artist_name&quot;:[0,&quot;mags?&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2180],&quot;artist_name&quot;:[0,&quot;Liimxa&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_