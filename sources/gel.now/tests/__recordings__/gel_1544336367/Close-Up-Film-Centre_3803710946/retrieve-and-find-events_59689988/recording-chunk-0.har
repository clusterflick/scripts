<div class=\"lg:hidden mb-6\"> <img src=\"https://api.gel.now/api/events/869/images/poster/e3c649ceae890d0a1bdf4714caf801a7.webp\" alt=\"RALLY x Scenic Route x ORMSIDE : Jump Source / spirit blue / Thredd / anu &#38; 404 eros\" class=\"w-full aspect-[3/4] object-cover\"> </div> <!-- Event header -->  <div class=\"flex items-start gap-2 mb-2\"> <h1 class=\"text-2xl font-bold text-surface-900\">RALLY x Scenic Route x ORMSIDE : Jump Source / spirit blue / Thredd / anu &amp; 404 eros</h1>  </div> <p class=\"text-surface-600 mb-4\"> Saturday, August 29, 2026 · 11:00 PM – 5:00 AM </p> <div class=\"mb-6\"> <a href=\"/venues/2\" class=\"text-surface-900 hover:text-surface-600 hover:underline\"> Ormside Projects </a> <p class=\"text-sm text-surface-600\">Penarth Centre, 32 Ormside Street</p> <p class=\"text-sm text-surface-600\">London</p> </div> <div class=\"mb-4\"> <p class=\"text-sm text-surface-600 mb-1\">Artists</p> <div class=\"flex flex-wrap gap-2\">  <a href=\"/artists/1016\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Thredd </a> <span> · </span> <a href=\"/artists/2242\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> anu &amp; 404 eros </a> <span> · </span> <a href=\"/artists/2243\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> Jump Source </a> <span> · </span> <a href=\"/artists/2244\" class=\"text-surface-700 hover:text-surface-900 hover:underline\"> spirit blue </a>  </div> </div> <!-- Tickets section --> <div class=\"mb-8\"> <a href=\"https://ra.co/events/2493603\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 font-medium transition-colors\" style=\"background-color: var(--theme-fg); color: var(--theme-bg);\" onmouseenter=\"this.style.backgroundColor='var(--theme-fg-800)'\" onmouseleave=\"this.style.backgroundColor='var(--theme-fg)'\">\nGet Tickets\n</a> </div> <div class=\"mt-6 text-surface-700\">anu & 404 eros<br />Jump Source<br />spirit blue<br />Thredd<br /><br />Ormside hosts RALLY x Scenic Route for the official RALLY 2026 Afterparty programme. DJ Sets from anu & 404 eros, Jump Source, spirit blue, and Thredd. Southwark Park was just the warm up.</div> <p class=\"mt-6 text-sm text-surface-600\">\nBy   <a href=\"/promoters/53\" class=\"text-surface-600 hover:text-surface-900 hover:underline\"> Ormside Projects </a>  </p>  </div> </div> </div>  </main> <footer class=\"mt-auto max-w-6xl mx-auto px-4 py-8 text-sm text-surface-600 opacity-0 transition-opacity duration-500\" data-footer> <a href=\"/about\" class=\"hover:underline hover:text-surface-900\">&copy; 2026 gel</a> ⋅ <a href=\"/subscribe\" class=\"hover:underline hover:text-surface-900\">subscribe</a> ⋅ <a href=\"/privacy-policy\" class=\"hover:underline hover:text-surface-900\">privacy</a> ⋅ <a href=\"/purchase-policy\" class=\"hover:underline hover:text-surface-900\">purchase policy</a> ⋅ <a href=\"mailto:hello@gel.now\" class=\"hover:underline hover:text-surface-900\">contact us\n</a> </footer> <script type=\"module\">const e=document.querySelector(\"[data-footer]\");e&&new IntersectionObserver(([o])=>{o.isIntersecting&&(e.classList.remove(\"opacity-0\"),e.classList.add(\"opacity-100\"))},{threshold:.1}).observe(e);</script> <!-- Pass user data to client-side via data attribute --> <script>(function(){const userData = undefined;\n\n      if (userData) {\n        document.documentElement.dataset.user = JSON.stringify(userData);\n      }\n    })();</script> <!-- Initialize auth and theme stores --> <script type=\"module\" src=\"/_astro/Layout.astro_astro_type_script_index_0_lang.Cig_QlfO.js\"></script> <style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event(\"astro:load\"));})();</script><script>(()=>{var A=Object.defineProperty;var g=(i,o,a)=>o in i?A(i,o,{enumerable:!0,configurable:!0,writable:!0,value:a}):i[o]=a;var d=(i,o,a)=>g(i,