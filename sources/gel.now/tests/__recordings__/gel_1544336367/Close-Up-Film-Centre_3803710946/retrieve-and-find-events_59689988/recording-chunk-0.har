dark, driving undercurrent.\\n\\nSpecial guests incoming :)\\n\\nAs always we will be starting the night off with Tweakers Welcome which is a supportive and low-pressure environment to practice DJing in a real club, on a real soundsystem!\\n\\nSign up form on our instagram @smallcarnrg\\n\\nLets have it 🙂&quot;],&quot;is_featured&quot;:[0,false],&quot;poster_small&quot;:[0,&quot;&quot;],&quot;is_preview&quot;:[0,false],&quot;external_url&quot;:[0,&quot;&quot;],&quot;is_announced&quot;:[0,true],&quot;is_on_listings_site&quot;:[0,true],&quot;resale_queue_enabled&quot;:[0,true],&quot;is_test_event&quot;:[0,false],&quot;is_cancelled&quot;:[0,false],&quot;categories&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;name&quot;:[0,&quot;club&quot;]}]]],&quot;is_free&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;artists&quot;:[1,[[0,{&quot;id&quot;:[0,360],&quot;artist_name&quot;:[0,&quot;Small Car NRG&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}],[0,{&quot;id&quot;:[0,2142],&quot;artist_name&quot;:[0,&quot;Memory Palace&quot;],&quot;gov_name&quot;:[0,&quot;&quot;],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;bio&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[0,false],&quot;date_created&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;],&quot;date_updated&quot;:[0,&quot;0001-01-01T00:00:00Z&quot;]}]]],&quot;venues&quot;:[1,[[0,{&quot;id&quot;:[0,18],&quot;name&quot;:[0,&quot;Avalon Cafe&quot;],&quot;address&quot;:[0,&quot;Unit D, Industrial Estate, Juno Way&quot;],&quot;city&quot;:[0,&quot;London&quot;],&quot;postcode&quot;:[0,&quot;SE14 5RW&quot;],&quot;capacity&quot;:[0,0],&quot;contact_email&quot;:[0,&quot;&quot;],&quot;on_listings_site&quot;:[