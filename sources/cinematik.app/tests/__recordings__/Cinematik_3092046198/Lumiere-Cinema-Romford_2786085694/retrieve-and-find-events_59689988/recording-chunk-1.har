ssive.cinematik.app/\"},\"startDate\":\"2026-11-29T19:15:00+00:00\",\"endDate\":\"2026-11-29T21:18:00+00:00\",\"identifier\":\"https://tickets.eden-court.co.uk/Online/mapSelect.asp?doWork::WSmap::loadMap=Load\\u0026createBO::WSmap=1\\u0026BOparam::WSmap::loadMap::performance_ids=810E4DBD-E3FF-4478-809F-94B051FD0A6A\\u0026returnTo\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-29T19:15:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Inverness\",\"postalCode\":\"IV3 5SA\",\"streetAddress\":\"Bishops Road\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"57.473071\",\"longitude\":\"-4.230819\"},\"name\":\"Eden Court Theatre: Eden Court\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjYxMzVjZGE1LWIwN2MtNDRjMi05NzEyLWNlYzYzMDhlYzIyZiIsInB1ciI6ImJsb2JfaWQifX0=--314e380462de397aaa9ce4943ef07cf0826830de/EC_cinema.jpg\",\"url\":\"https://www.cinematik.app/venues/eden-court-theatre-eden-court\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://tickets.eden-court.co.uk/Online/mapSelect.asp?doWork::WSmap::loadMap=Load\\u0026createBO::WSmap=1\\u0026BOparam::WSmap::loadMap::performance_ids=810E4DBD-E3FF-4478-809F-94B051FD0A6A\\u0026returnTo\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@t