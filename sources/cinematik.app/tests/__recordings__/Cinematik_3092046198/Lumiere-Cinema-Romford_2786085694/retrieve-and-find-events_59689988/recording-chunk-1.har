ata-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://elevenfiftyfive.cinematik.app/\">elevenfiftyfive</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://escapes.cinematik.app/\">Escapes</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://massive.cinematik.app/\">MASSIVE</a>\n        <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--muted\" href=\"https://www.cinematik.app/\">Cinematik</a>\n      </div>\n    </div>\n\n  <div class=\"mobile-nav-bottom\">\n    <div class=\"mobile-nav-search-row\"\n      data-controller=\"autocomplete\"\n      data-autocomplete-url-value=\"/search/screenings\"\n      data-autocomplete-min-length-value=\"2\">\n      <div data-autocomplete-target=\"results\" class=\"nav-search-results\"></div>\n      <input type=\"text\" name=\"q\" placeholder=\"Search films, venues...\"\n        class=\"mobile-nav-input\"\n        data-autocomplete-target=\"input\"\n        autocomplete=\"off\">\n      <input type=\"hidden\" name=\"hidden_search\" id=\"hidden_search\" data-autocomplete-target=\"hidden\" />\n    </div>\n\n    <div class=\"mobile-nav-footer flex items-center gap-4\">\n    <button type=\"button\" data-action=\"nova--header#toggleSearch\"\n      class=\"theme-toggle rounded-full p-2 shrink-0\" aria-label=\"Search\">\n      <svg class=\"h-[1.15rem] w-[1.15rem]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n    </button>\n\n\n    <button type=\"button\" data-nova--theme-target=\"toggle\" data-action=\"nova--theme#toggle nova--header#toggleMenu\"\n      class=\"theme-toggle rounded-full p-2\" aria-label=\"Toggle theme\">\n      <span data-nova--theme-target=\"icon\" class=\"theme-toggle-icon\" aria-hidden=\"true\">&#9790;</span>\n      <span class=\"sr-only\">Toggle theme</span>\n    </button>\n\n    </div>\n  </div>\n</nav>\n\n</div>\n\n  <div class=\"showtimes-floating-controls\">\n    <a class=\"showtimes-float-btn\" aria-label=\"Back to showtimes\" href=\"/events/marie-antoinette\">\n      <span aria-hidden=\"true\">&larr;</span>\n</a>  </div>\n\n      <div id=\"content\" class=\"flex-1\">\n        \n<div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n        <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://web.cineworld.co.uk/order/showtimes/046-253320/seats\",\"description\":\"Written and directed by Academy Award® winner Sofia Coppola, Marie Antoinette is an electrifying yet intimate re-telling of the turbulent life of one of history's most infamous figures. Kirsten Dunst portrays the ill-fated child princess who married France's young and indifferent King Louis XVI (Jason Schwartzman). \\nFeeling isolated in a royal court rife with scandal and intrigue, Marie Antoinette defied both royalty and commoner by living like a rock star, which served only to seal her fate.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"MASSIVE\",\"url\":\"https://massive.cinematik.app/\"},\"startDate\":\"2026-11-18T19:15:00+00:00\",\"endDate\":\"2026-11-18T21:18:00+00:00\",\"identifier\":\"https://web.cineworld.co.uk/order/showtimes/046-253320/seats\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1