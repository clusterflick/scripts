26-11-21T16:03:00+00:00\",\"identifier\":\"https://www.lumiereromford.com/movies/marie-antoinette/showtimes/2026-11-21?location=romford\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-21T14:00:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Romford\",\"postalCode\":\"RM1 3EE\",\"streetAddress\":\"Lumiere Cinema, Level 3, The Mercury Shopping Centre\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.579434\",\"longitude\":\"0.185693\"},\"name\":\"Romford Film Trust: Lumiere (Romford) \",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjQwMzNiMjhlLTc5ZDYtNDc0Mi05MzMzLWU0MjZhODJhYjgzZCIsInB1ciI6ImJsb2JfaWQifX0=--4710910f291aa53f2f2dd148cc70034caf0fdbc5/logo.png\",\"url\":\"https://www.cinematik.app/venues/romford-film-trust-lumiere-romford\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.lumiereromford.com/movies/marie-antoinette/showtimes/2026-11-21?location=romford\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/marie-antoinett