\" id=\"mailing_list_subscription_email\" />\n    <div class=\"relative w-full sm:flex-1\"\n      role=\"combobox\"\n      aria-label=\"Postcode\"\n      aria-haspopup=\"listbox\"\n      aria-expanded=\"false\"\n      data-controller=\"autocomplete\"\n      data-autocomplete-selected-class=\"bg-white/10 text-white\"\n      data-autocomplete-min-length-value=\"2\"\n      data-autocomplete-url-value=\"/search/postcodes\">\n      <label for=\"mailing_list_subscription_postcode\" class=\"sr-only\">Postcode</label>\n      <input placeholder=\"Postcode\" required=\"required\" autocomplete=\"postal-code\" class=\"nova-input\" data-autocomplete-target=\"input\" type=\"text\" name=\"mailing_list_subscription[postcode]\" id=\"mailing_list_subscription_postcode\" />\n      <div data-autocomplete-target=\"results\" class=\"mailing-postcode-results\"></div>\n    </div>\n  <button name=\"button\" type=\"submit\" class=\"pill-btn pill-btn-lg\">\n    Subscribe\n</button>  <p class=\"w-full text-sm mt-1\" style=\"color: var(--nova-mist);\">\n    Sign up for our mailing lists to be first to hear about upcoming events\n  </p>\n  <div class=\"mbqorzypcnxkgleadu_1794672080\"><style media=\"screen\">.mbqorzypcnxkgleadu_1794672080 {position:absolute!important;height:1px;width:1px;overflow:hidden;}</style><label for=\"mbqorzypcnxkgleadu\">If you are a human, ignore this field</label><input type=\"text\" name=\"mbqorzypcnxkgleadu\" id=\"mbqorzypcnxkgleadu\" autocomplete=\"off\" tabindex=\"-1\" /></div>\n</form>\n    </div>\n  </section>\n\n      <div class=\"ml-sticky\"\n     data-controller=\"nova--mailing-list\"\n     data-nova--mailing-list-scroll-to-value=\"#updates\"\n     data-action=\"seat-map:cart@window->nova--mailing-list#cartChanged\">\n\n  <div class=\"ml-sticky-panel\">\n    <div class=\"ml-sticky-toggle\"\n         data-controller=\"scroll-to\"\n         data-scroll-to-target-value=\"#updates\"\n         data-action=\"click->nova--mailing-list#toggle click->scroll-to#scroll\">