tik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-15T13:30:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Nottingham\",\"postalCode\":\"NG1 3AL\",\"streetAddress\":\"Broadway Cinema, 14-18 Broad Street\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"52.954084\",\"longitude\":\"-1.143788\"},\"name\":\"Broadway Cinema\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6ImUzYTJhMWRkLTAxN2QtNGEyYy1hNjhlLWY4MWJiZjAwM2MzOSIsInB1ciI6ImJsb2JfaWQifX0=--b2cb6a287525635b41cd8ff2f58611ccba06a8ed/Broadway_Wordmark-01-signature.png\",\"url\":\"https://www.cinematik.app/venues/broadway-cinema\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.broadway.org.uk/book/1252602\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/marie-antoinette\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Broadway Cinema\",\"item\":\"https://massive.cinematik.app/book/marie-antoinette-20th-anniversary-4k-restoration-broadway-cinema-2026-11-15\"}]}</script>\n<section class=\"booking-hero relative overflow-hidden\">\n    <div class=\"booking-hero-backdrop\" style='background-image: url(\"https://assets.cinematik.app/rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyMzBhZDlmLTc3ZjUtNGYxZC04MDlhLWVkMjVmZTVkYWE1ZSIsInB1ciI6ImJsb2JfaWQifX0=--d76474776600d70583f23e15dc4d7f8446b35c7c/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOlsxOTIwLDEwODBdfSwicHVyIjoidmFyaWF0aW9uIn19--c307dbb4fd20e9110b605e118455689953083ffe/marie_antoinette_backdrop.jpg\")'>\n    </div>\n  <div class=\"booking-hero-content\">\n    <div class=\"booking-hero-info\">\n      <h1 class=\"event-title flex items-end\">\n        Marie Antoinette (20th Anniversary 4K Restoration)\n        <span class=\"booking-hero-bbfc\">\n          <img class=\"img-fluid bbfc-rating-small inline-block\" alt=\"bbfc-12A\" src=\"https://assets.cinematik.app/assets/bbfc/12A-15bc30f41ab714b5091108ff16f9023c5891b2f74772f14c77fdc0509f45acd8.png\" width=\"20\" height=\"20\" />\n        </span>\n      </h1>\n      <p class=\"booking-hero-venue\">\n        <a href=\"/venues/broadway-cinema\">Broadway Cinema</a>\n      </p>\n    </div>\n  </div>\n</section>\n\n  <div class=\"screening-selector\">\n        <a data-turbo-prefetch=\"false\" class=\"screening-chip \" href=\"/book/marie-antoinette-20th-anniversary-4k-restoration-broadway-cinema-2026-11-14?reset_basket=true\">\n          \n          Sat 14th Nov, 16:45\n</a>        <button name=\"button\" type=\"submit\" class=\"screening-chip screening-chip--active\">\n          \n          Sun 15th Nov, 13:30\n</button>      <div class=\"flex-grow\"></div>\n      <a href=\"/events/marie-antoinette\">\n        See other locations\n</a>  </div>\n\n  <div class=\"booking-page\">\n  <div class=\"booking-page-inner\">\n    <div class=\"booking-sections\">\n      <div class=\"booking-card\">\n        <div class=\"booking-card-header\">\n          <h2>External booking</h2>\n        </div>\n        <div class=\"booking-card-body\">\n          <d