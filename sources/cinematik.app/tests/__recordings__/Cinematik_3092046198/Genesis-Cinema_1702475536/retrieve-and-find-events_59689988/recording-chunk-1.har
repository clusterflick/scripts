00:00\",\"endDate\":\"2026-11-17T22:18:00+00:00\",\"identifier\":\"https://www.grosvenorpicturetheatre.co.uk/checkout/showing/marie-antoinette/508546\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-17T20:15:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Glasgow \",\"postalCode\":\"G12 8SJ\",\"streetAddress\":\"24, Ashton Lane\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"55.874745\",\"longitude\":\"-4.293334\"},\"name\":\"Scotsman Group: Grosvenor Picture Theatre\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjBlMmYyMzUyLTU0YTctNDk4Mi05NGIxLWIyNGQwY2RiODE0ZiIsInB1ciI6ImJsb2JfaWQifX0=--6fd55709d50160696f4cc91f3276dba153e39f20/Grosvenor%20Picture%20Theatre-Logo-001.png\",\"url\":\"https://www.cinematik.app/venues/scotsman-group-grosvenor-picture-theatre\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.grosvenorpicturetheatre.co.uk/checkout/showing/marie-antoinette/508546\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/mar