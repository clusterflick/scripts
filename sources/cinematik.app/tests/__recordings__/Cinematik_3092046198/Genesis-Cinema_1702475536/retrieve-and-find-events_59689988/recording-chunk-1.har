ks\">\n        <button type=\"button\" data-action=\"nova--header#toggleProgrammes\" class=\"mobile-nav-link text-right\">Programmes</button>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://www.eidocinema.com/\">Eido</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://elevenfiftyfive.cinematik.app/\">elevenfiftyfive</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://escapes.cinematik.app/\">Escapes</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://massive.cinematik.app/\">MASSIVE</a>\n        <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--muted\" href=\"https://www.cinematik.app/\">Cinematik</a>\n      </div>\n    </div>\n\n  <div class=\"mobile-nav-bottom\">\n    <div class=\"mobile-nav-search-row\"\n      data-controller=\"autocomplete\"\n      data-autocomplete-url-value=\"/search/screenings\"\n      data-autocomplete-min-length-value=\"2\">\n      <div data-autocomplete-target=\"results\" class=\"nav-search-results\"></div>\n      <input type=\"text\" name=\"q\" placeholder=\"Search films, venues...\"\n        class=\"mobile-nav-input\"\n        data-autocomplete-target=\"input\"\n        autocomplete=\"off\">\n      <input type=\"hidden\" name=\"hidden_search\" id=\"hidden_search\" data-autocomplete-target=\"hidden\" />\n    </div>\n\n    <div class=\"mobile-nav-footer flex items-center gap-4\">\n    <button type=\"button\" data-action=\"nova--header#toggleSearch\"\n      class=\"theme-toggle rounded-full p-2 shrink-0\" aria-label=\"Search\">\n      <svg class=\"h-[1.15rem] w-[1.15rem]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n    </button>\n\n\n    <button type=\"button\" data-nova--theme-target=\"toggle\" data-action=\"nova--theme#toggle nova--header#toggleMenu\"\n      class=\"theme-toggle rounded-full p-2\" aria-label=\"Toggle theme\">\n      <span data-nova--theme-target=\"icon\" class=\"theme-toggle-icon\" aria-hidden=\"true\">&#9790;</span>\n      <span class=\"sr-only\">Toggle theme</span>\n    </button>\n\n    </div>\n  </div>\n</nav>\n\n</div>\n\n  <div class=\"showtimes-floating-controls\">\n    <a class=\"showtimes-float-btn\" aria-label=\"Back to showtimes\" href=\"/events/marie-antoinette\">\n      <span aria-hidden=\"true\">&larr;</span>\n</a>  </div>\n\n      <div id=\"content\" class=\"flex-1\">\n        \n<div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n        <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.myvue.com/book-tickets/summary/10010/HO00021550/464085\",\"description\":\"Written and directed by Academy Award® winner Sofia Coppola, Marie Antoinette is an electrifying yet intimate re-telling of the turbulent life of one of history's most infamous figures. Kirsten Dunst portrays the ill-fated child princess who married France's young and indifferent King Louis XVI (Jason Schwartzman). \\nFeeling isolated in a royal court rife with scandal and intrigue, Marie Antoinette defied both royalty and commoner by living like a rock star, which served only to seal her fate.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"MASSIVE\",\"url\":\"https://massive.cinematik.app/\"},\"startDate\":\"2026-11-17T19:45:00+00:00\",\"endDate\":\"2026-11-17T21:48:00+00:00\",\"identifier\":\"https://www.myvue.com/book-tickets/summary/10010/HO00021550/464085\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-17T19:45:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Edinburgh\",\"postalCode\":\"EH6 6JJ\",\"streetAddress\":\"Ocean Terminal, Ocean Drive, Victoria Dock. Leith\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"55.980687\",\"longitude\":\"-3.177865\"},\"name\":\"Vue: Edinburgh Ocean Terminal\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjhkMzcwYWM2LTRjNjMtNDYxZC04MzY2LTFmYmM5Zjc4YjNlOCIsInB1ciI6ImJsb2JfaWQifX0=--91f97c31348b2c70ba03f3375520c57b51099e0d/IMG_1265.png\",\"url\":\"https://www.cinematik.app/venues/vue-edinburgh-ocean-terminal\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.myvue.com/book-tickets/summary/10010/HO00021550/464085\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/eve