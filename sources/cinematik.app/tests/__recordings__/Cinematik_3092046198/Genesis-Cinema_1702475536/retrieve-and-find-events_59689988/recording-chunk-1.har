:00\",\"identifier\":\"https://www.myvue.com/book-tickets/summary/10053/HO00021550/322525\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-17T19:30:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Newcastle-under-Lyme\",\"postalCode\":\"ST5 1PT\",\"streetAddress\":\"The Square, Market Arcade, High Street\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"53.009563\",\"longitude\":\"-2.226904\"},\"name\":\"Vue: Newcastle Under Lyme\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjhkMzcwYWM2LTRjNjMtNDYxZC04MzY2LTFmYmM5Zjc4YjNlOCIsInB1ciI6ImJsb2JfaWQifX0=--91f97c31348b2c70ba03f3375520c57b51099e0d/IMG_1265.png\",\"url\":\"https://www.cinematik.app/venues/vue-newcastle-under-lyme\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.myvue.com/book-tickets/summary/10053/HO00021550/322525\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/marie-antoinette\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Newcastle Under Lyme\",\"item\":\"ht