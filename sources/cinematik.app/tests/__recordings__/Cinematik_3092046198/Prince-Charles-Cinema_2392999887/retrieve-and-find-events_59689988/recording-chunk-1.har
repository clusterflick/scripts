aXplX3RvX2ZpbGwiOls2MDAsOTAwXX0sInB1ciI6InZhcmlhdGlvbiJ9fQ==--b25f3bb729455dd0de2c52b5625ed7f500f7736c/MA1200x1800.png 600w, /rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOlsxMjAwLDE4MDBdfSwicHVyIjoidmFyaWF0aW9uIn19--e4805fd770aae2b3dc99b01c0ce4a56bb322ce66/MA1200x1800.png 1200w\" sizes=\"67vh\" alt=\"Marie Antoinette (20th Anniversary 4K Restoration)\" class=\"showtimes-poster-image hidden lg:block\" loading=\"eager\" fetchpriority=\"high\" src=\"https://assets.cinematik.app/rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOls2MDAsOTAwXX0sInB1ciI6InZhcmlhdGlvbiJ9fQ==--b25f3bb729455dd0de2c52b5625ed7f500f7736c/MA1200x1800.png\" />\n    </aside>\n\n    <section class=\"showtimes-content-shell\" data-controller=\"nova--info-panel\">\n      <div id=\"film-details\" class=\"showtimes-title-block\" data-controller=\"disclosure\"\n        data-disclosure-event-name-value=\"toggle-film-details\" data-disclosure-remote-toggle-value=\"[data-film-details-toggle]\">\n        <span class=\"showtimes-meta-pill showtimes-status-pill lg:inline-flex\">\n            Now Showing\n        </span>\n        <h1 class=\"event-title mt-1\">\n          Marie Antoinette (20th Anniversary 4K Restoration)\n        </h1>\n          <p class=\"showtimes-tagline\">Rumour. Scandal. Sex. Fame. Revolution.</p>\n        <div class=\"showtimes-overview\">\n          <p>Written and directed by Academy Award® winner Sofia Coppola, Marie Antoinette is an electrifying yet intimate re-telling of the turbulent life of one of history's most infamous figures. Kirsten Dunst portrays the ill-fated child princess who married France's young and indifferent King Louis XVI (Jason Schwartzman). <br>Feeling isolated in a royal court rife with scandal and intrigue, Marie Antoinette defied both royalty and commoner by living like a rock star, which served only to seal her fate.</p>\n        </div>\n\n        <div id=\"film-details-more\" class=\"hidden\" data-disclosure-target=\"more\">\n          <div class=\"showtimes-overview showtimes-synopsis-rest\"></div>\n          <div class=\"detail-card detail-card--flush\">\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Director</span>\n      <span class=\"detail-row-value\">Sofia Coppola</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Cast</span>\n      <span class=\"detail-row-value\">Kirsten Dunst, Jason Schwartzman, Steve Coogan, Judy Davis, Rip Torn, Asia Argento, Molly Shannon, Shirley Henderson, Rose Byrne, Mary Nighy, Danny Huston</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Genre</span>\n      <span class=\"detail-row-value\">Drama, History</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Cert</span>\n      <span class=\"detail-row-value\">12A</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Runtime</span>\n      <span class=\"detail-row-value\">123 min</span>\n    </div>\n</div>\n\n          \n          <div class=\"showtimes-synopsis-actions\">\n              <button type=\"button\" class=\"pill-btn pill-btn-ghost\" onclick=\"window.dispatchEvent(new CustomEvent('trailer:open'))\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>\n                Watch trailer\n              </button>\n              <button type=\"button\" class=\"pill-btn pill-btn-ghost\" onclick=\"window.dispatchEvent(new CustomEvent('share:open'))\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"/><polyline points=\"16 6 12 2 8 6\"/><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"15\"/></svg>\n                Share\n              </button>\n          </div>\n          <p class=\"showtimes-synopsis-less-line\">\n            <button type=\"button\" class=\"nova-link\" data-action=\"disclosure#collapse\" aria-controls=\"film-details-more\">\n              &lsaquo; Hide details\n            </button>\n          </p>\n        </div>\n\n        <div class=\"showtimes-facts\">\n            <span class=\"showtimes-fact\">123 min</span>\n            <span class=\"showtimes-fact\">Drama, History</span>\n            <span class=\"showtimes-fact\">13 Nov - 29 Dec 2026</span>\n            <span class=\"showtimes-fact showtimes-fact--cert\"><img class=\"img-fluid bbfc-rating-small inline-block\" alt=\"bbfc-12A\" src=\"https://assets.cinematik.app/assets/bbfc/12A-15bc30f41ab714b5091108ff16f9023c5891b2f74772f14c77fdc0509f45acd8.png\" width=\"20\" height=\"20\" /></span>\n        </div>\n      </div>\n\n      <div class=\"showtimes-panel\">\n        <form id=\"showtimes-location-form\" data-turbo=\"false\" data-controller=\"autocomplete location-clear\" data-action=\"autocomplete.change-&gt;nova--info-panel#submitLocationForm\" data-autocomplete-min-length-value=\"2\" data-autocomplete-url-value=\"/search/locations\" data-autocomplete-submit-on-enter-value=\"true\" role=\"combobox\" aria-label=\"Location search\" aria-haspopup=\"listbox\" aria-expanded=\"false\" action=\"/locations/update\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"l1uLsJz_UuOpoV2L6ScJMK9vZ-Rsbg2lf0jCm-2s7a-AYcPKlrcVrNrMnGtj17hB9YS722nP4U67yYujMEY4mQ\" />\n          <div class=\"flex items-center gap-2\"