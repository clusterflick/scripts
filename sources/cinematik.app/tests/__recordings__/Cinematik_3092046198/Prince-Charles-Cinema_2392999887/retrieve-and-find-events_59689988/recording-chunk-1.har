ova--theme#toggle nova--header#toggleMenu\"\n      class=\"theme-toggle rounded-full p-2\" aria-label=\"Toggle theme\">\n      <span data-nova--theme-target=\"icon\" class=\"theme-toggle-icon\" aria-hidden=\"true\">&#9790;</span>\n      <span class=\"sr-only\">Toggle theme</span>\n    </button>\n\n    </div>\n  </div>\n</nav>\n\n</div>\n\n  <div class=\"showtimes-floating-controls\">\n    <a class=\"showtimes-float-btn\" aria-label=\"Back to showtimes\" href=\"/events/marie-antoinette\">\n      <span aria-hidden=\"true\">&larr;</span>\n</a>  </div>\n\n      <div id=\"content\" class=\"flex-1\">\n        \n<div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n        <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://whatson.bfi.org.uk/Online/seatSelect.asp?createBO::WSmap=1\\u0026BOparam::WSmap::loadBestAvailable::performance_ids=13E6E6CE-0091-4EFC-8E35-922CF890CFFA\",\"description\":\"Written and directed by Academy Award® winner Sofia Coppola, Marie Antoinette is an electrifying yet intimate re-telling of the turbulent life of one of history's most infamous figures. Kirsten Dunst portrays the ill-fated child princess who married France's young and indifferent King Louis XVI (Jason Schwartzman). \\nFeeling isolated in a royal court rife with scandal and intrigue, Marie Antoinette defied both royalty and commoner by living like a rock star, which served only to seal her fate.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"MASSIVE\",\"url\":\"https://massive.cinematik.app/\"},\"startDate\":\"2026-11-16T14:40:00+00:00\",\"endDate\":\"2026-11-16T16:43:00+00:00\",\"identifier\":\"https://whatson.bfi.org.uk/Online/seatSelect.asp?createBO::WSmap=1\\u0026BOparam::WSmap::loadBestAvailable::performance_ids=13E6E6CE-0091-4EFC-8E35-922CF890CFFA\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-16T14:40:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"London\",\"postalCode\":\"SE1 8XT\",\"streetAddress\":\"BFI Southbank, Belvedere Rd\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.50695\",\"longitude\":\"-0.115944\"},\"name\":\"BFI Southbank\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6ImJjMjFlYzY5LWRkNGQtNDRhZi1iN2I5LTNjZDYyYmQ1NTk1ZCIsInB1ciI6ImJsb2JfaWQifX0=--7ef6acf018cdc95166c602a3f1c77bb5a0035d28/BFI_MONO_LOGO_POS%20(1).jpg\",\"url\":\"https://www.cinematik.app/venues/bfi-southbank\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://whatson.bfi.org.uk/Online/seatSelect.asp?createBO::WSmap=1\\u0026BOparam::WSmap::loadBestAvailable::performance_ids=13E6E6CE-0091-4EFC-8E35-922CF890CFFA\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversar