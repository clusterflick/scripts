-theme-target=\"toggle\" data-action=\"nova--theme#toggle nova--header#toggleMenu\"\n      class=\"theme-toggle rounded-full p-2\" aria-label=\"Toggle theme\">\n      <span data-nova--theme-target=\"icon\" class=\"theme-toggle-icon\" aria-hidden=\"true\">&#9790;</span>\n      <span class=\"sr-only\">Toggle theme</span>\n    </button>\n\n    </div>\n  </div>\n</nav>\n\n</div>\n\n  <div class=\"showtimes-floating-controls\">\n    <a class=\"showtimes-float-btn\" aria-label=\"Back to showtimes\" href=\"/events/marie-antoinette\">\n      <span aria-hidden=\"true\">&larr;</span>\n</a>  </div>\n\n      <div id=\"content\" class=\"flex-1\">\n        \n<div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n        <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Event\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://tickets.eden-court.co.uk/Online/mapSelect.asp?doWork::WSmap::loadMap=Load\\u0026createBO::WSmap=1\\u0026BOparam::WSmap::loadMap::performance_ids=810E4DBD-E3FF-4478-809F-94B051FD0A6A\\u0026returnTo\",\"description\":\"Written and directed by Academy Award® winner Sofia Coppola, Marie Antoinette is an electrifying yet intimate re-telling of the turbulent life of one of history's most infamous figures. Kirsten Dunst portrays the ill-fated child princess who married France's young and indifferent King Louis XVI (Jason Schwartzman). \\nFeeling isolated in a royal court rife with scandal and intrigue, Marie Antoinette defied both royalty and commoner by living like a rock star, which served only to seal her fate.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"MASSIVE\",\"url\":\"https://ma