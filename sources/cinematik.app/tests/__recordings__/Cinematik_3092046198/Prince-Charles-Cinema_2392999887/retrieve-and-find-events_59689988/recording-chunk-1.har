 mobile-nav-link--alt\" href=\"https://www.eidocinema.com/\">Eido</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://elevenfiftyfive.cinematik.app/\">elevenfiftyfive</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://escapes.cinematik.app/\">Escapes</a>\n          <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--alt\" href=\"https://massive.cinematik.app/\">MASSIVE</a>\n        <a data-action=\"nova--header#toggleMenu\" class=\"mobile-nav-link mobile-nav-link--muted\" href=\"https://www.cinematik.app/\">Cinematik</a>\n      </div>\n    </div>\n\n  <div class=\"mobile-nav-bottom\">\n    <div class=\"mobile-nav-search-row\"\n      data-controller=\"autocomplete\"\n      data-autocomplete-url-value=\"/search/screenings\"\n      data-autocomplete-min-length-value=\"2\">\n      <div data-autocomplete-target=\"results\" class=\"nav-search-results\"></div>\n      <input type=\"text\" name=\"q\" placeholder=\"Search films, venues...\"\n        class=\"mobile-nav-input\"\n        data-autocomplete-target=\"input\"\n        autocomplete=\"off\">\n      <input type=\"hidden\" name=\"hidden_search\" id=\"hidden_search\" data-autocomplete-target=\"hidden\" />\n    </div>\n\n    <div class=\"mobile-nav-footer flex items-center gap-4\">\n    <button type=\"button\" data-action=\"nova--header#toggleSearch\"\n      class=\"theme-toggle rounded-full p-2 shrink-0\" aria-label=\"Search\">\n      <svg class=\"h-[1.15rem] w-[1.15rem]\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>\n    </button>\n\n\n    <button type=\"button\" data-nova--theme-target=\"toggle\" data-action=\"nova--theme#toggle nova--header#toggleMenu\"