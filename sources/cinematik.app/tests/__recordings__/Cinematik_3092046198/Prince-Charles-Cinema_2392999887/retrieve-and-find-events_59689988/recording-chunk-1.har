.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-17T19:30:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"London\",\"postalCode\":\"HA1 1HS\",\"streetAddress\":\"St George's Shopping \\u0026 Leisure Centre, St Anne's Road\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.581257\",\"longitude\":\"-0.338683\"},\"name\":\"Vue: Harrow\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjhkMzcwYWM2LTRjNjMtNDYxZC04MzY2LTFmYmM5Zjc4YjNlOCIsInB1ciI6ImJsb2JfaWQifX0=--91f97c31348b2c70ba03f3375520c57b51099e0d/IMG_1265.png\",\"url\":\"https://www.cinematik.app/venues/vue-harrow\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.myvue.com/book-tickets/summary/10006/HO00021550/511133\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/marie-antoinette\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Harrow\",\"item\":\"https://massive.cinematik.app/book/marie-antoinette-20th-anniversary-4k-restoration-vue-harrow-2026-11-17\"}]}</script>\n<section class=\"booking-hero relative ov