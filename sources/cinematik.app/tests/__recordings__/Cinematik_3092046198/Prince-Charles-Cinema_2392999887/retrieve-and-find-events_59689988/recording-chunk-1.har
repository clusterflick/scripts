nB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-18T19:15:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Falkirk\",\"postalCode\":\"FK1 1LW\",\"streetAddress\":\"Central Retail Park, Old Bison Works\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"56.002901\",\"longitude\":\"-3.777022\"},\"name\":\"Cineworld: Falkirk\",\"logo\":null,\"url\":\"https://www.cinematik.app/venues/cineworld-falkirk\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://web.cineworld.co.uk/order/showtimes/052-256763/seats\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration)\",\"item\":\"https://massive.cinematik.app/events/marie-antoinette\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Falkirk\",\"item\":\"https://massive.cinematik.app/book/marie-antoinette-cineworld-falkirk\"}]}</script>\n<section class=\"booking-hero relative overflow-hidden\">\n    <div class=\"booking-hero-backdrop\" style='background-image: url(\"https://assets.cinematik.app/rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyMzBhZDlmLTc3ZjUtNGYxZC04MDlhLWVkMjVmZTVkYWE1ZSIsInB1ciI6ImJsb2JfaWQifX0=--d76474776600d70583f23e15dc4d7f8446b35c7c/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOlsxO