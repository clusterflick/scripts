  el.style.display = 'none';\n          });\n          document.querySelectorAll('.with_js').forEach(function (el) {\n              el.style.display = 'flex';\n          });\n          document.querySelectorAll('.with_js_block').forEach(function (el) {\n              el.style.display = 'block';\n          });\n      })\n    </script>\n    <script>\n    (function (d, t) {\n        // The widget pulls >1MB of CSS/JS from support.cinematikapp.com, so boot\n        // it once the page is idle (or on first interaction) instead of\n        // competing with first paint.\n        var loaded = false;\n        function loadChatwoot() {\n            if (loaded) return;\n            loaded = true;\n            var BASE_URL = \"https://support.cinematikapp.com\";\n            var g = d.createElement(t), s = d.getElementsByTagName(t)[0];\n            g.src = BASE_URL + \"/packs/js/sdk.js\";\n            g.defer = true;\n            g.async = true;\n            s.parentNode.insertBefore(g, s);\n            g.onload = function () {\n                window.chatwootSDK.run({\n                    websiteToken: 'MnoZXuSHdEWVGV7RLDcxJQ1j',\n                    baseUrl: BASE_URL\n                })\n            }\n        }\n        [\"pointerdown\", \"keydown\", \"touchstart\", \"scroll\"].forEach(function (evt) {\n            window.addEventListener(evt, loadChatwoot, { once: true, passive: true });\n        });\n        window.addEventListener(\"load\", function () {\n            var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 1); };\n            idle(function () { setTimeout(loadChatwoot, 3000); });\n        });\n    })(document, \"script\");\n</script>\n\n    <script>\n      window.chatwootSettings = {\n        hideMessageBubble: false\n      };\n    </script>\n  </body>\n</html>\n",
