            "text": "<!DOCTYPE html>\n<html class=\"h-full antialiased\" lang=\"en-GB\">\n  <head>\n    <script>\n//<![CDATA[\nwindow.gon={};gon.full_site_url=\"https://www.cinematik.app\";gon.fb_app_id=952315815464192;\n//]]>\n</script>\n    <meta name=\"csrf-param\" content=\"authenticity_token\" />\n<meta name=\"csrf-token\" content=\"3ZW7nO8xFCTd1kXvSxRTnMe6oOMfGRwjw7KwEDZTjHkukiRNGYPClUA_OlXDSeHSm1DHZdEjoZ5vh_RVoQ6FEg\" />\n    \n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <link rel=\"preload\" href=\"https://assets.cinematik.app/assets/application-d84319dc34169a181be244f82f506f0379d4867b483a702df084b1f7530d5852.js\" as=\"script\">\n    <script src=\"https://assets.cinematik.app/assets/application-d84319dc34169a181be244f82f506f0379d4867b483a702df084b1f7530d5852.js\" data-turbo-track=\"reload\" async=\"async\"></script>\n    <script src=\"https://assets.cinematik.app/assets/ahoy-90cefee3c238222ccf97c3fe1cb08e0ee34925576760719f9aed0f42a57dc4d3.js\" async=\"async\" data-category=\"analytics\" type=\"text/plain\"></script>\n    <link rel=\"stylesheet\" href=\"https://assets.cinematik.app/assets/nova-579d36db38e54892552f7a94e40ced2ecc65a9d697b73156213ee231859edcc0.css\" media=\"all\" data-turbo-track=\"reload\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"https://assets.cinematik.app/icon.svg\" id=\"favicon\" />\n\n      <script src=\"https://js.stripe.com/v3/\" async=\"async\"></script>\n\n\n\n\n      <link data-turbo-track=\"dynamic\" rel=\"canonical\" href=\"https://massive.cinematik.app/book/marie-antoinette-cineworld-boldon-tyne-wear\">\n    <title>Marie Antoinette (20th Anniversary 4K Restora