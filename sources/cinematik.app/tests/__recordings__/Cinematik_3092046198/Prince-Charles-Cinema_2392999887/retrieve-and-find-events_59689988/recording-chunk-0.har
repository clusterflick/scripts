ight-grey pt-4\">\n    </div>\n  </div>\n</div>\n\n</nav>\n        <main id=\"content\" class=\"px-0 h-full\">\n          <div class=\"h-60px lg:h-100px bg-nav\"></div>\n          <div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n          <script src=\"https://assets.cinematik.app/assets/maps-4ab3b856d151030b81c7e3c4677d5fb4e0a1996cb8ec80bb5bdd1746185feed8.js\" defer=\"defer\"></script>\n<script type=\"application/ld+json\">[{\"@context\":\"https://schema.org\",\"@type\":\"EventSeries\",\"name\":\"I See Buildings Fall Like Lightning (Relaxed Screenings) - 23–24 Nov 2026\",\"url\":\"https://www.cinematik.app/events/i-see-buildings-fall-like-lightning-relaxed-screenings-2026-11-23-2026-11-24\",\"description\":\"Childhood friends Patrick, Shiv, Rian, Oli, and Conor played together, skipped school together, and dreamt of the lives they would have one day. Now they’re thirty, and the future they imagined is slipping quietly out of reach. \\n\\nEscapes is proud to partner with Tubi, connecting the UK’s largest free trip to the cinema with the UK’s largest free streaming platform.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"English\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"Escapes\",\"url\":\"https://escapes.cinematik.app/\"},\"startDate\":\"2026-11-23\",\"endDate\":\"2026-11-24\",\"identifier\":\"https://www.cinematik.app/events/i-see-buildings-fall-like-lightning-relaxed-screenings-2026-11-23-2026-11-24\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjM5NmQ3N2FjLTk2ZWUtNDkwNS04YzYwLTU2ZDUwZjdiNjZhZCIsInB1ciI6ImJsb2JfaWQifX0=--cf73f517dec2a6a2079fc461ae9f4d24b270a089/I_see_buildings.png\",\"workPresented\":{\"@type\":\"Movie\",\"name\":\"I See Buildings Fall Like Lightning (Relaxed Screenings)\",\"director\":{\"@type\":\"Person\",\"name\":\"Clio Barnard\"},\"description\":\"\\u003cdiv\\u003eChildhood friends Patrick, Shiv, Rian, Oli, and Conor played together, skipped school together, and dreamt of the lives they would have one day. Now they’re thirty, and the future they imagined is slipping quietly out of reach. \\u003cbr\\u003e\\u003cbr\\u003e\\u003cstrong\\u003eEscapes is proud to partner with Tubi, connecting the UK’s largest free trip to the cinema with the UK’s largest free streaming platform.\\u003c/strong\\u003e\\u003c/div\\u003e\",\"actors\":[{\"@type\":\"Person\",\"name\":\"Anthony Boyle\"},{\"@type\":\"Person\",\"name\":\"Lola Petticrew\"},{\"@type\":\"Person\",\"name\":\"Joe Cole\"},{\"@type\":\"Person\",\"name\":\"Daryl McCormack\"},{\"@type\":\"Person\",\"name\":\"Jay Lycurgo\"},{\"@type\":\"Person\",\"name\":\"Millie Brady\"},{\"@type\":\"Person\",\"name\":\"Lucie Shorthouse\"},{\"@type\":\"Person\",\"name\":\"James Eeles\"},{\"@type\":\"Person\",\"name\":\"Ryan Walker-Edwards\"},{\"@type\":\"Person\",\"name\":\"Sam Brasenell\"}],\"duration\":\"PT1H49M\",\"inLanguage\":\"English\",\"headline\":\"Five friends. Five lives. Countless hopes.\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjM5NmQ3N2FjLTk2ZWUtNDkwNS04YzYwLTU2ZDUwZjdiNjZhZCIsInB1ciI6ImJsb2JfaWQifX0=--cf73f517dec2a6a2079fc461ae9f4d24b270a089/I_see_buildings.png\",\"contentRating\":\"BBFC 15\",\"dateCreated\":\"2026-11-04T15:42:40+00:00\"},\"location\":[{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Romford\",\"postalCode\":\"RM1 3EE\",\"streetAddress\":\"Lumiere Cinema, Level 3, The Mercury Shopping Centre\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.579434\",\"longitude\":\"0.185693\"},\"name\":\"Romford Film Trust: Lumiere (Romford) \",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjQw