   </div>\n  </div>\n</div>\n\n</nav>\n        <main id=\"content\" class=\"px-0 h-full\">\n          <div class=\"h-60px lg:h-100px bg-nav\"></div>\n          <div id=\"flash-container\" class=\"transition-all ease-in-out duration-500 z-50 sticky top-14 lg:top-24\">\n  <div id=\"flash\" aria-live=\"polite\">\n    \n\n    \n  </div>\n</div>\n\n\n          <script src=\"https://assets.cinematik.app/assets/maps-4ab3b856d151030b81c7e3c4677d5fb4e0a1996cb8ec80bb5bdd1746185feed8.js\" defer=\"defer\"></script>\n<script type=\"application/ld+json\">[{\"@context\":\"https://schema.org\",\"@type\":\"EventSeries\",\"name\":\"I See Buildings Fall Like Lightning - 23–24 Nov 2026\",\"url\":\"https://www.cinematik.app/events/i-see-buildings-fall-like-lightning-2026-11-23-2026-11-24\",\"description\":\"Childhood friends Patrick, Shiv, Rian, Oli, and Conor played together, skipped school together, and dreamt of the lives they would have one day. Now they’re thirty, and the future they imagined is slipping quietly out of reach. \\n\\nEscapes is proud to partner with Tubi, connecting the UK’s largest free trip to the cinema with the UK’s largest free streaming platform.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"Escapes\",\"url\":\"https://escapes.cinematik.app/\"},\"startDate\":\"2026-11-23\",\"endDate\":\"2026-11-24\",\"identifier\":\"https://www.cinematik.app/events/i-see-buildings-fall-like-lightning-2026-11-23-2026-11-24\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjJjYmUxOGYzLThkZTItNGYxNy1iNjQxLTcyOTIxNmVmYjZmMyIsInB1ciI6ImJsb2JfaWQifX0=--091c6a491cef59837a2ed27df07ed9093e75ef37/i_see_buildings_fall_like_lightning_poster.jpg\",\"workPresented\":{\"@type\":\"Movie\",\"name\":\"I See Buildings Fall Like Lightning\",\"director\":{\"@type\":\"Person\",\"name\":\"Clio Barnard\"},\"description\":\"\\u003cdiv\\u003eChildhood friends Patrick, Shiv, Rian, Oli, and Conor played together, skipped school together, and dreamt of the lives they would have one day. Now they’re thirty, and the future they imagined is slipping quietly out of reach. \\u003cbr\\u003e\\u003cbr\\u003e\\u003cstrong\\u003eEscapes is proud to partner with Tubi, connecting the UK’s largest free trip to the cinema with the UK’s largest free streaming platform.\\u003c/strong\\u003e\\u003c/div\\u003e\",\"actors\":[{\"@type\":\"Person\",\"name\":\"Anthony Boyle\"},{\"@type\":\"Person\",\"name\":\"Lola Petticrew\"},{\"@type\":\"Person\",\"name\":\"Joe Cole\"},{\"@type\":\"Person\",\"name\":\"Daryl McCormack\"},{\"@type\":\"Person\",\"name\":\"Jay Lycurgo\"},{\"@type\":\"Person\",\"name\":\"Millie Brady\"},{\"@type\":\"Person\",\"name\":\"Lucie Shorthouse\"},{\"@type\":\"Person\",\"name\":\"James Eeles\"},{\"@type\":\"Person\",\"name\":\"Ryan Walker-Edwards\"},{\"@type\":\"Person\",\"name\":\"Sam Brasenell\"}],\"duration\":\"PT1H49M\",\"inLanguage\":\"en\",\"headline\":\"Five friends. Five lives. Countless hopes.\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjJjYmUxOGYzLThkZTItNGYxNy1iNjQxLTcyOTIxNmVmYjZmMyIsInB1ciI6ImJsb2JfaWQifX0=--091c6a491cef59837a2ed27df07ed9093e75ef37/i_see_buildings_fall_like_lightning_poster.jpg\",\"contentRating\":\"BBFC 15\",\"dateCreated\":\"2026-11-04T15:42:33+00:00\"},\"location\":[{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Ystradgynlais\",\"postalCode\":\"SA9 1JJ\",\"streetAddress\":\"The Welfare, Brecon Road\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.778553\",\"longitude\":\"-3.757599\"},\"name\":\"THE YSTRADGYNLAIS MINERS WELFARE AND COMMUNITY HALL TRUST LIMITED: The Welfare Ystradgynlais\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjY0ODQ0NGNhLTRlNTMtNDY3My0