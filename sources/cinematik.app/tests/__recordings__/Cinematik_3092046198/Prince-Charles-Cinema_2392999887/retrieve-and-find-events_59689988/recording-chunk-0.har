\"2026-11-14T19:53:00+00:00\",\"identifier\":\"https://whatson.bfi.org.uk/Online/seatSelect.asp?createBO::WSmap=1\\u0026BOparam::WSmap::loadBestAvailable::performance_ids=BAF613C9-DFB8-4989-BCB6-0F34D7395657\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjkyZWIyNDg2LTEyZWEtNDhkOC1iZGQ0LWNkZmFhZmU2NjNkMiIsInB1ciI6ImJsb2JfaWQifX0=--ea0820dde54e3bd6f696055972c98e99f6c1b614/MA1200x1800.png\",\"doorTime\":\"2026-11-14T17:50:00+00:00\",\"performer\":[{\"@type\":\"Person\",\"name\":\"Kirsten Dunst\"},{\"@type\":\"Person\",\"name\":\"Jason Schwartzman\"}],\"location\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"London\",\"postalCode\":\"SE1 8XT\",\"streetAddress\":\"BFI Southbank, Belvedere Rd\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"51.50695\",\"longitude\":\"-0.115944\"},\"name\":\"BFI Southbank\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6ImJjMjFlYzY5LWRkNGQtNDRhZi1iN2I5LTNjZDYyYmQ1NTk1ZCIsInB1ciI6ImJsb2JfaWQifX0=--7ef6acf018cdc95166c602a3f1c77bb5a0035d28/BFI_MONO_LOGO_POS%20(1).jpg\",\"url\":\"https://www.cinematik.app/venues/bfi-southbank\"},\"superEvent\":{\"@type\":\"EventSeries\",\"name\":\"Marie Antoinette (20th Anniversary 4K Restoration) - 13 Nov - 29 Dec 2026\",\"url\":\"https://www.cinematik.app/events/marie-antoinette\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://whatson.bfi.org.uk/Online/seatSelect.asp?createBO::WSmap=1\\u0026BOparam::WSmap::loadBestAvailable::performance_ids=BAF613C9-DFB8-4989-BCB6-0F34D7395657\",\"availability\":\"https://schema.org/InStock\"}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://massive.cinematik.app/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Marie Antoinette (20th Annive