es/firstsite-ltd-firstsite-cinema\"},{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Ilkeston\",\"postalCode\":\"DE7 5QB\",\"streetAddress\":\"Market Pl\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":\"52.970993\",\"longitude\":\"-1.309724\"},\"name\":\"CINEGOGH Ltd: Scala Cinema Ilkeston\",\"logo\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjBiNzEwMjQzLWNiZTktNGFiOC1hZTU1LWYxYTY2MWJiMjEzYyIsInB1ciI6ImJsb2JfaWQifX0=--23e0625186c7b0ac145db1406e7525542532db4f/page-loader.png\",\"url\":\"https://www.cinematik.app/venues/cinegogh-ltd-scala-cinema-ilkeston\"}],\"subEvent\":[{\"@type\":\"Event\",\"name\":\"I See Buildings Fall Like Lightning - 23–24 Nov 2026\",\"url\":\"https://www.cinematik.app/book/i-see-buildings-fall-like-lightning-the-ystradgynlais-miners-welfare-and-community-hall-trust-limited-the-welfare-ystradgynlais-2026-11-23\",\"description\":\"Childhood friends Patrick, Shiv, Rian, Oli, and Conor played together, skipped school together, and dreamt of the lives they would have one day. Now they’re thirty, and the future they imagined is slipping quietly out of reach. \\n\\nEscapes is proud to partner with Tubi, connecting the UK’s largest free trip to the cinema with the UK’s largest free streaming platform.\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"eventStatus\":\"https://schema.org/EventScheduled\",\"inLanguage\":\"en\",\"organizer\":{\"@type\":\"Organization\",\"name\":\"Escapes\",\"url\":\"https://escapes.cinematik.app/\"},\"startDate\":\"2026-11-23T14:00:00+00:00\",\"endDate\":\"2026-11-23T15:49:00+00:00\",\"identifier\":\"https://www.cinematik.app/book/i-see-buildings-fall-like-lightning-the-ystradgynlais-miners-welfare-and-community-hall-trust-limited-the-welfare-ystradgynlais-2026-11-23\",\"image\":\"https://www.cinematik.app/rails/active_storage/blobs/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjJjYmUxOGYzLThkZTItNGYx