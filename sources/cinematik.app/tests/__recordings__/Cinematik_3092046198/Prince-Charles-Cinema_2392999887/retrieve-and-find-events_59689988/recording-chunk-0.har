iwicmVzaXplX3RvX2ZpbGwiOlsxOTIwLDEwODBdfSwicHVyIjoidmFyaWF0aW9uIn19--c307dbb4fd20e9110b605e118455689953083ffe/your_mother_your_mother_your_mother_backdrop.jpg\" />\n        <img srcset=\"/rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjliMDE3OGM1LTg4ZjktNGEzYy05YmYwLWJkNDc2Zjc2MTFjOSIsInB1ciI6ImJsb2JfaWQifX0=--56a2d149936953bbdf340bc5f42ed59ab17bd7e5/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOls2MDAsOTAwXX0sInB1ciI6InZhcmlhdGlvbiJ9fQ==--b25f3bb729455dd0de2c52b5625ed7f500f7736c/your_mother.png 600w, /rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjliMDE3OGM1LTg4ZjktNGEzYy05YmYwLWJkNDc2Zjc2MTFjOSIsInB1ciI6ImJsb2JfaWQifX0=--56a2d149936953bbdf340bc5f42ed59ab17bd7e5/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOlsxMjAwLDE4MDBdfSwicHVyIjoidmFyaWF0aW9uIn19--e4805fd770aae2b3dc99b01c0ce4a56bb322ce66/your_mother.png 1200w\" sizes=\"67vh\" alt=\"Your Mother Your Mother Your Mother\" class=\"showtimes-poster-image hidden lg:block\" loading=\"eager\" fetchpriority=\"high\" src=\"https://assets.cinematik.app/rails/active_storage/representations/proxy/eyJfcmFpbHMiOnsiZGF0YSI6IjliMDE3OGM1LTg4ZjktNGEzYy05YmYwLWJkNDc2Zjc2MTFjOSIsInB1ciI6ImJsb2JfaWQifX0=--56a2d149936953bbdf340bc5f42ed59ab17bd7e5/eyJfcmFpbHMiOnsiZGF0YSI6eyJmb3JtYXQiOiJ3ZWJwIiwicmVzaXplX3RvX2ZpbGwiOls2MDAsOTAwXX0sInB1ciI6InZhcmlhdGlvbiJ9fQ==--b25f3bb729455dd0de2c52b5625ed7f500f7736c/your_mother.png\" />\n    </aside>\n\n    <section class=\"showtimes-content-shell\" data-controller=\"nova--info-panel\">\n      <div id=\"film-details\" class=\"showtimes-title-block\" data-controller=\"disclosure\"\n        data-disclosure-event-name-value=\"toggle-film-details\" data-disclosure-remote-toggle-value=\"[data-film-details-toggle]\">\n        <span class=\"showtimes-meta-pill showtimes-status-pill lg:inline-flex\">\n            Now Showing\n        </span>\n        <h1 class=\"event-title mt-1\">\n          Your Mother Your Mother Your Mother\n        </h1>\n          <p class=\"showtimes-tagline\">To be a parent is to be at war.</p>\n        <div class=\"showtimes-overview\">\n          <p>From writer-director Bassam Tariq, Your Mother Your Mother Your Mother stars Mahershala Ali as Latif, a devoutly religious hitman who struggles to balance work, faith and fatherhood. When his wife dies, he embarks on a desperate journey across Houston to protect his children, confronting the forces closing in around him - and the beliefs threatening to unravel within.</p>\n        </div>\n\n        <div id=\"film-details-more\" class=\"hidden\" data-disclosure-target=\"more\">\n          <div class=\"showtimes-overview showtimes-synopsis-rest\"></div>\n          <div class=\"detail-card detail-card--flush\">\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Director</span>\n      <span class=\"detail-row-value\">Bassam Tariq</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Cast</span>\n      <span class=\"detail-row-value\">Mahershala Ali, John Cho, Giancarlo Esposito, Abubakr Ali, Laith Nakli, Adia, Jahleel Kamara, Tiffany Boone, Tramell Tillman, John Henry Ward, Alyssa Kim</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Genre</span>\n      <span class=\"detail-row-value\">Drama, Crime, Thriller, Action</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Cert</span>\n      <span class=\"detail-row-value\">15</span>\n    </div>\n    <div class=\"detail-row\">\n      <span class=\"detail-row-label\">Runtime</span>\n      <span class=\"detail-row-value\">112 min</span>\n    </div>\n</div>\n\n          \n          <div class=\"showtimes-synopsis-actions\">\n              <button type=\"button\" class=\"pill-btn pill-btn-ghost\" onclick=\"window.dispatchEvent(new CustomEvent('trailer:open'))\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>\n                Watch trailer\n              </button>\n              <button type=\"button\" class=\"pill-btn pill-btn-ghost\" onclick=\"window.dispatchEvent(new CustomEvent('share:open'))\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"/><polyline points=\"16 6 12 2 8 6\"/><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"15\"/></svg>\n                Share\n              </button>\n          </div>\n          <p class=\"showtimes-synopsis-less-line\">\n            <button type=\"button\" class=\"nova-link\" data-action=\"disclosure#collapse\" aria-controls=\"film-details-more\">\n              &lsaquo; Hide details\n            </button>\n          </p>\n        </div>\n\n        <div class=\"showtimes-facts\">\n            <span class=\"showtimes-fact\">112 min</span>\n            <span class=\"showtimes-fact\">Drama, Crime</span>\n            <span class=\"showtimes-fact\">17 November 2026</span>\n            <span class=\"showtimes-fact showtimes-fact--cert\"><img class=\"img-fluid bbfc-rating-small inline-block\" alt=\"bbfc-15\" src=\"https://assets.cinematik.app/assets/bbfc/15-7cf1f075c2e26c90e8886460ef53c401ee69670749e89700b4865cca71ba7401.png\" width=\"20\" height=\"20\" /></span>\n        </div>\n      </div>\n\n\n      <div>\n      <div class=\"showtimes-screenings-panel\">\n        <div class=\"showtimes-venue-scroll\">\n          <turbo-frame id=\"screenings-list\">\n              <div class=\"showtimes-panel\">\n                <div id=\"showtimes-date-tabs\" class=\"showtimes-date-tabs\">\n                    <a class=\"showtime-date-tab is-active \" data-turbo-frame=\"screenings-list\" data-turbo-action=\"advance\" data-date=\"2026-11-17\" data-controller=\"ahoy\" data-action=\"click-&gt;ahoy#trackEvent\" data-ahoy-event-name-value=\"date_tab_clicked\" data-ahoy-event-properties-value=\"{&quot;date&quot;:&quot;2026-11-17&quot;}\" href=\"/events/your-mother-your-mother-your-mother-2026-11-17?date=2026-11-17\">Tue 17th Nov</a>\n                </div>\n              </div>\n\n              <div class=\"showtimes-public-note\"><div class=\"trix-content\">\n  <div>After the film, we will switch from cinema to sound as a live vinyl listening experience from @eli1ah, @lounouronline and <a href=\"https://www.instagram.com/charlie_fracture/\">@charlie_fracture</a> starts as the credits roll.<br><br><strong>1155 Soundsystem </strong>is a new screening concept where cinema meets sound. Each event pairs a standout film with artists and cultural voices who respond through conversation and musical selections played live in the cinema, <strong>turning the post-screening moment into a shared listening experience</strong>.</div>\n</div>\n</div>\n\n            <div data-nova--info-panel-target=\"venueArea\" class=\"showtimes-venue-area\">\n                <section id=\"showtimes-venue-list\" class=\"showtimes-venue-list\">\n                      <article class=\"showtimes-venue-card\">\n                        <div class=\"showtimes-venue-header\">\n                          <h3 class=\"showtimes-venue-name\">Genesis Cinema, London <span class=\"showtimes-venue-chain\">Genesis Entertainment Mile End Ltd</span></h3>\n                        </div>\n                        <p class=\"showtimes-venue-address\">\n                          93-95 Mile End Road, London, E1 4UJ, GB\n                        </p>\n                        <div class=\"showtime-chip-row\">\n                                  <a data-turbo=\"false\" data-controller=\"ahoy\" data-action=\"click-&gt;ahoy#trackEvent\" data-ahoy-event-name-value=\"showtime_clicked\" data-ahoy-event-properties-value=\"{&quot;url&quot;:&quot;/book/your-mother-your-mother-your-mother-genesis-entertainment-mile-end-ltd-genesis-cinema&quot;,&quot;label&quot;:&quot;18:30&quot;}\" class=\"showtime-chip\" href=\"/book/your-mother-your-mother-your-mother-genesis-entertainment-mile-end-ltd-genesis-cinema\">18:30</a>\n                        </div>\n                      </article>\n                </section>\n            </div>\n\n          </turbo-frame>\n\n            <div data-nova--info-panel-target=\"map\" class=\"hidden\"\n              data-map-token=\"[REDACTED]\"\n              data-map-user-location=\"\">\n              <div class=\"showtimes-map-container\">\n                <turbo-frame id=\"map-panel\">\n                <div class=\"showtimes-map-skeleton skeleton-shimmer\">Loading&hellip;</div>\n                </turbo-frame>\n              </div>\n              <button type=\"button\" class=\"pill-btn pill-btn-lg mt-4 lg:ml-4\"\n                data-action=\"nova--info-panel#close\">\n                <span aria-hidden=\"true\">&larr;</span> Back to Showtimes\n              </button>\n            </div>\n        </div>\n      </div>\n      </div>\n    </section>\n  </div>\n\n  <footer class=\"nova-section text-center py-6 text-sm\" style=\"color: var(--nova-mist);\">\n      <a class=\"underline hover:no-underline\" href=\"/events/your-mother-your-mother-your-mother-2026-11-17/press\">For press / media kit</a>\n  </footer>\n\n</main>\n\n      </div>\n      \n    </div>\n        <section id=\"updates\" class=\"border-y border-[var(--nova-line)] bg-slate/80\">\n    <div class=\"nova-section py-14 md:py-20\">\n        <h2 class=\"display-title display-title--compact max-w-3xl text-balance\">Sign up now for a chance to join The Guest List and attend our screenings and experiences</h2>\n        <form target=\"_top\" class=\"mt-7 flex max-w-xl flex-col gap-3 sm:flex-row sm:flex-wrap\" action=\"/mailing_list_subscriptions\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"zwbaW6N3ijA2QajKvNa3262_T62NCuRqqRL4UCkZAj0iv