r=\"Email\" required=\"required\" class=\"w-full border-gray-300 focus:ring-blue-500 focus:border-blue-500 px-4 py-2 text-black\" type=\"email\" name=\"mailing_list_subscription[email]\" id=\"mailing_list_subscription_email\" />\n            </div>\n            <div class=\"w-full md:w-auto flex-grow flex items-center gap-4\">\n              <div class=\"relative flex-grow\"\n                data-action=\"dropdown#toggle\"\n                data-controller=\"autocomplete\"\n                data-autocomplete-selected-class=\"bg-nav text-white\"\n                data-autocomplete-min-length-value=\"2\"\n                data-autocomplete-url-value=\"/search/postcodes\">\n                <input placeholder=\"Postcode\" required=\"required\" class=\"w-full border-gray-300 focus:ring-blue-500 focus:border-blue-500 text-black px-4 py-2 pr-10\" data-autocomplete-target=\"input\" type=\"text\" name=\"mailing_list_subscription[postcode]\" id=\"mailing_list_subscription_postcode\" />\n                <div class=\"absolute inset-y-0 right-2 flex items-center bg-red\" data-controller=\"tooltip\" data-tooltip-content-value=\"Your postcode helps us send you relevant information about what’s on near you.\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" class=\"fill-current icon-smallish text-gray-500 inline-block\"><path d=\"M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z\"></path></svg>\n\n                </div>\n                <div data-autocomplete-target=\"results\"\n                  class=\"absolute bottom-full w-full bg-black text-white border border-gray-400 shadow-lg z-50\">\n                </div>\n              </div>\n              <div>\n                <button name=\"button\" type=\"submit\" class=\"btn btn-primary h-10 pt-0 justify-center whitespace-nowrap\"><span class=\"when-enabled\">Subscribe</span><span class=\"when-disabled\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" class=\"animate-spin inline-block h-4 w-4 mr-2\">\n  <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n  <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n</svg>\nSubmitting...</span></button>\n              </div>\n            </div>\n          <div class=\"qaizlocpwyjvfxgn_1794672194\"><style media=\"screen\">.qaizlocpwyjvfxgn_1794672194 {display:none;}</style><label for=\"qaizlocpwyjvfxgn\">If you are a human, ignore this field</label><input type=\"text\" name=\"qaizlocpwyjvfxgn\" id=\"qaizlocpwyjvfxgn\" autocomplete=\"off\" tabindex=\"-1\" /></div>\n        </div>\n        <div class=\"w-full basis-full flex flex-col md:items-center pb-2\">\n          <p class=\"w-full py-1 md:py-2\">\n            Sign up for our mailing lists to be first to hear about upcoming events\n          </p>\n            \n            <div class=\"flex flex-col md:flex-row md:items-center gap-4 mt-2 md:mt-0\">\n                <label class=\"text-project-text text-sm !normal-case flex items-center gap-1.5\">\n                  <input type=\"checkbox\" name=\"mailing_list_subscription[lists][]\" id=\"ml_sticky_system-project\" value=\"Escapes\" class=\"rounded border-gray-400 text-black focus:ring-blue-500 shrink-0 mb-1\" checked=\"checked\" />\n                  <span>Escapes</span>\n                </label>\n                <label class=\"text-project-text text-sm !normal-case flex items-center gap-1.5\">\n                  <input type=\"checkbox\" name=\"mailing_list_subscription[lists][]\" id=\"ml_sticky_system-cinematik\" value=\"Cinematik\" class=\"rounded border-gray-400 text-black focus:ring-blue-500 shrink-0 mb-1\" />\n                  <span>Cinematik</span>\n                </lab