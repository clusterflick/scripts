-link:hover {\n      background-color: #F26339;\n  }\n\n  .btn,\n  .form-group {\n      font-family: ApfelGrotezk, sans-serif;\n  }\n\n  .btn-primary {\n      border: 1px solid#1E293B;\n      background-color: #1E293B;\n      color: #F5E8D1;\n  }\n\n  a.btn-primary  {\n    color: #F5E8D1 !important;\n  }\n\n  .btn-primary:hover {\n      border: 1px solid #1E293B !important;\n      background-color: rgba(255,255,255,0.2) !important;\n      color: #1E293B !important;\n  }\n\n  .btn-primary:focus {\n      border: 1px solid #1E293B !important;\n      background-color: #1E293B;\n  }\n\n  .btn-secondary {\n      border-color: #1E293B;\n      color: #1E1E1C;\n  }\n\n  .btn-secondary:focus {\n      color: #1E1E1C;\n      --tw-ring-color: #1E293B;\n  }\n\n  .btn-secondary .on-white {\n      color: #F5E8D1;\n  }\n\n  .btn-secondary .outline {\n      color: #1E293B;\n  }\n\n  .project-header {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  .press-release-header {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  .press-release-description {\n    text-transform: unset;\n    color: #1E1E1C;\n  }\n\n  .project-description {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  /* Utilities */\n\n  .text-button-text {\n      color: #F5E8D1;\n  }\n\n  .text-highlight {\n      color: #F26339;\n  }\n\n  .border-highlight {\n      border-color: #F26339;\n  }\n\n  .bg-text-color-subtle {\n      background-color: color-mix(in srgb, #1E1E1C 8%, transparent);\n  }\n\n  .fill-highlight {\n      fill: #F26339;\n  }\n\n  .hover\\:text-highlight:hover {\n      color: #F26339;\n  }\n\n  .focus\\:text-highlight:focus {\n      color: #F26339;\n  }\n\n  .focus\\:ring-highlight:focus {\n      --tw-ring-color: #F26339;\n  }\n\n  .hover\\:text-nav:hover {\n      color: #1AA04A;\n  }\n\n  .bg-nav {\n      background-color: #1AA04A;\n  }\n\n  .fill-text-color {\n      fill: #1E1E1C;\n  }\n\n  .text-project-text {\n      color: #1E1E1C;\n  }\n\n  .bg-form-color {\n