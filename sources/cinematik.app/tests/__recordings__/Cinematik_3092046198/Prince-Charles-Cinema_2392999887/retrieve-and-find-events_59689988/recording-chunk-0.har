top-menu,\n  #desktop-menu a,\n  #desktop-menu button,\n  #desktop-menu div {\n      color: #1E1E1C;\n  }\n\n  .cart-film-title {\n      a {\n          color: #1AA04A !important;\n      }\n\n  }\n\n  .border-cine-green {\n      border-color: #F26339;\n  }\n\n  .nav-link-cine-location {\n      color: #1E1E1C;\n  }\n\n  .nav-link-cine {\n      color: #1E1E1C !important;\n  }\n\n  .nav-link-cine-mobile {\n      color: #1E1E1C;\n  }\n\n  #mobile-menu-dialog {\n      color: #1E1E1C;\n  }\n\n  .text-cine-light-grey {\n      color: #1E1E1C;\n  }\n\n  .bg-form-color-body.text-cine-light-grey {\n      color: #1E1E1C;\n  }\n\n  .bg-project-highlight.text-cine-light-grey {\n      color: #1E1E1C;\n  }\n\n  .bg-alternative {\n      background-color: #1AA04A;\n  }\n\n  .text-against-alt-background {\n      color: #1E1E1C;\n  }\n\n  .footer-link-cine {\n      color: #1E1E1C;\n  }\n\n  .footer-link-cine:hover {\n      color: #1E1E1C;\n      text-decoration: underline;\n  }\n\n  .footer-link-cine.active {\n      color: #1E1E1C;\n      text-decoration: underline;\n  }\n\n  #content {\n      background-color: #F1BBCE;\n  }\n\n  #footer {\n      background-color: #1AA04A;\n      border-color: #F26339;\n  }\n\n  /* The Cinematik wordmark SVG hard-codes a white fill on an inner <g>;\n     override (incl. that group) so it follows the footer text colour and\n     stays visible on light footers. */\n  #footer svg,\n  #footer svg g,\n  #footer svg path {\n      fill: #1E1E1C !important;\n  }\n\n  #shortlist-section {\n      background-color: #1AA04A;\n      border-color: #F26339;\n  }\n\n  .event-tile {\n      color: #1E1E1C !important;\n      border-color: #F26339;\n  }\n\n  .nav-link-cine:hover, .nav-link-cine:focus, .nav-link-cine:active,\n  .nav-link-cine-location:hover, .nav-link-cine-location:focus, .nav-link-cine-location:active {\n      color: #1E1E1C !important;\n      text-decoration: underline;\n      border-color: transparent !important;\n  }\n\n  a.account-link, a.account-link:visited, a.account-link:active, a.account-link:focus, a.account-link:hover {\n      background-color: #F26339;\n  }\n\n  .btn,\n  .form-group {\n      font-family: ApfelGrotezk, sans-serif;\n  }\n\n  .btn-primary {\n      border: 1px solid#1E293B;\n      background-color: #1E293B;\n      color: #F5E8D1;\n  }\n\n  a.btn-primary  {\n    color: #F5E8D1 !important;\n  }\n\n  .btn-primary:hover {\n      border: 1px solid #1E293B !important;\n      background-color: rgba(255,255,255,0.2) !important;\n      color: #1E293B !important;\n  }\n\n  .btn-primary:focus {\n      border: 1px solid #1E293B !important;\n      background-color: #1E293B;\n  }\n\n  .btn-secondary {\n      border-color: #1E293B;\n      color: #1E1E1C;\n  }\n\n  .btn-secondary:focus {\n      color: #1E1E1C;\n      --tw-ring-color: #1E293B;\n  }\n\n  .btn-secondary .on-white {\n      color: #F5E8D1;\n  }\n\n  .btn-secondary .outline {\n      color: #1E293B;\n  }\n\n  .project-header {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  .press-release-header {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  .press-release-description {\n    text-transform: unset;\n    color: #1E1E1C;\n  }\n\n  .project-description {\n      text-transform: unset;\n      color: #1E1E1C;\n  }\n\n  /* Utilities */\n\n  .text-button-text {\n      color: #F5E8D1;\n  }\n\n  .text-highlight {\n      color: #F26339;\n  }\n\n  .border-highlight {\n      border-color: #F26339;\n  }\n\n  .bg-text-color-subtle {\n      background-color: color-mix(in srgb, #1E1E1C 8%, transparent);\n  }\n\n  .fill-highlight {\n      fill: #F26339;\n  }\n\n  .hover\\:text-highlight:hover {\n      color: #F26339;\n  }\n\n  .focus\\:text-highlight:focus {\n      color: #F26339;\n  }\n\n  .focus\\:ring-highlight:focus {\n      --tw-ring-color: #F26339;\n  }\n\n  .hover\\:text-nav:hover {\n      color: #1AA04A;\n  }\n\n  .bg-nav {\n      background-color: #1AA04A;\n  }\n\n  .fill-text-color {\n      fill: #1E1E1C;\n  }\n\n  .text-project-text {\n      color: #1E1E1C;\n  }\n\n  .bg-form-color {\n      background-color: #F4C743;\n  }\n\n  .hover\\:bg-form-color:hover {\n      background-color: #F4C743;\n  }\n\n  .bg-form-color-body {\n      background-color: #F5DFAD;\n  }\n\n  .massive-title,\n  .film-details {\n      color: #1E1E1C;\n  }\n\n  .hover\\:bg-landing-page:hover {\n      background-color: #F1BBCE;\n  }\n\n  .bg-button-text {\n      background-color: #F5E8D1;\n  }\n\n  .hover\\:bg-button-text:hover {\n      background-color: #F5E8D1;\n  }\n\n  .project-font {\n      font-family: Yport, sans-serif;\n  }\n\n  .default-font {\n      font-family: Grotesk, sans-serif;\n  }\n\n  .font-sans {\n      font-family: ApfelGrotezk, sans-serif;\n  }\n\n  .bg-landing-page {\n      background-color: #F1BBCE;\n  }\n\n  .bg-project-highlight {\n      background-color: #F26339;\n  }\n\n  .bg-button-color {\n      background-color: #1E293B;\n  }\n\n  .bg-content-background {\n      background-color: #F5E8D1;\n  }\n\n  .border-project-highlight {\n      border-color: #F26339;\n  }\n\n  .border-landing-page {\n      border-color: #F1BBCE;\n  }\n\n  /* Gradient utility for share panels */\n  .bg-gradient-share-panel {\n      background-image: linear-gradient(to bottom right, color-mix(in srgb, #F1BBCE 8%, white), white, white);\n  }\n\n  .not-liked-text, .not-liked, .liked-text, .liked, .like, .voted-text, .voted, .vote-without-access, .not-voted-text, .not-voted  {\n      svg {\n          color: #F26339\n      }\n  }\n\n  .hover\\:bg-nav:hover {\n      background-color: #1AA04A;\n      color: white;\n  }\n\n  .notice.notice-offer, .notice.notice-success, .notice.notice-info, .notice.notice-warning, .notice.notice-error {\n      background-color: #1E293B;\n      color: white;\n\n      svg {\n          color: white;\n      }\n  }\n</style>\n  </head>\n  <body class=\"overscroll-none sm:overscroll-auto h-auto font-sans antialiased font-normal leading-normal \" data-advertising-partner-value=\"\">\n    <!-- Goo