ment\":false,\"terms_and_conditions_timestamp\":\"2026-10-28T13:12:50.383895Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":0,\"label\":\"Nafs - day rave series\",\"start_date\":\"Sun, Nov 29, 2026 3:00 PM\",\"lowest_price\":\"$20\",\"current_step\":\"success\",\"event_type\":\"regular\",\"event_step_status\":{\"event-details\":true,\"event-media\":true,\"pre-approval-tickets\":false,\"pre-approval-fields\":false,\"general-tickets\":true,\"seating-event\":false,\"seating-event-pre-approval\":false,\"rsvp\":false,\"event-preview\":true},\"venue_thumbnail_url\":null,\"checkout_link\":\"https://tzkrti.com/checkout/4888?page=1&city=london&country=gb&category=events\",\"sale_status\":\"On Sale\",\"fees\":{\"refund\":{\"type\":\"percentage\",\"value\":\"5\",\"source\":\"environment\"},\"ticket\":{\"buyer\":null,\"organizer\":{\"type\":\"percentage\",\"value\":\"7\",\"source\":\"user\"},\"shared\":false}},\"category\":{\"id\":1,\"name\":{\"ar\":\"موسيقى\",\"en\":\"Music\"},\"parent_id\":26,\"slug\":\"music\",\"label\":\"Music\"},\"place_obj\":{\"id\":982,\"city_id\":14885,\"seated_venue_id\":null,\"label\":\"The living womb | The living womb\",\"slug\":\"the-living-womb-the-living-womb\",\"name\":{\"ar\":\"The living womb\",\"en\":\"The living womb\"},\"description\":{\"ar\":\"\",\"en\":\"\"},\"content\":{\"ar\":\"\",\"en\":\"\"},\"social_links\":null,\"latitude\":\"51.5387716\",\"longitude\":\"-0.0238715\",\"address\":\"Smeed Rd, Fish Island, London E3 2NR, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-10-05T18:31:02.000000Z\",\"updated_at\":\"2026-10-05T18:31:02.000000Z\",\"user_id\":60871,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":null},\"from_date_only\":\"2026-11-29\",\"to_date_only\":\"2026-11-29\",\"from_time_only\":\"03:00 PM\",\"to_time_only\":\"11:00 PM\",\"country_id\":239},{\"id\":5037,\"name\":{\"ar\":\"GAG\",\"en\":\"GAG\"},\"content\":{\"ar\":\"<p><strong>Friday 4 December · 10pm–4am · Colour Factory, Hackney Wick</strong></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>What is GAG? It’s not a straight answer. It started as a friends group four years ago, and grew into one of London’s largest Arab communities. Now we’re throwing a party to celebrate.&nbsp;</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>All welcome 🤍</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Some of the most exciting Arab and SWANA artists from London, Berlin and Barcelona for one night of Arabic pop, disco, house and techno.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Performances:</strong> Salma Zahore · Tarek Khwiss</p><p><strong>Music:</strong> Ashtattz · Tareq · DJ Aboalaa · Seksu · 3MR</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>We cover phone cameras at the door, so everyone can dance freely.&nbsp;</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Six hours of music you won’t hear anywhere else in London!</p>\",\"en\":\"<p><strong>Friday 4 December · 10pm–4am · Colour Factory, Hackney Wick</strong></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>What is GAG? It’s not a straight answer. It started as a friends group four years ago, and grew into one of London’s largest Arab communities. Now we’re throwing a party to celebrate.&nbsp;</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>All welcome 🤍</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Some of the most exciting Arab and SWANA artists from London, Berlin and Barcelona for one night of Arabic pop, disco, house and techno.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Performances:</strong> Salma Zahore · Tarek Khwiss</p><p><strong>Music:</strong> Ashtattz · Tareq · DJ Aboalaa · Seksu · 3MR</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>We cover phone cameras at the door, so everyone can dance freely.&nbsp;</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Six hours of music you won’t hear anywhere else in London!</p>\"},\"image\":\"images/vDJKSKMmvDTGCRDY9LC3I9PuTQKOMMVTIPh7PE8e.jpg\",\"images\":{\"youtube\":{\"id\":null,\"link\":null,\"resource\":\"\"},\"instagram_story\":\"images/WkLu9muqAzuGi8TuhvtBH1UvDG4QE99y5UHkKJBK.jpg\",\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"كولور فاكتوري\",\"en\":\"Colour Factory\"},\"place_id\":1016,\"city_id\":14885,\"slug\":\"gag\",\"from_date\":\"2026-12-04 20:00\",\"to_date\":\"2026-12-05 02:00\",\"ticket_types\":[{\"fees\":0,\"name\":\"Lowincome_0\",\"color\":null,\"index\":0,\"price\":\"12\",\"currency\":\"GBP\",\"due_date\":null,\"fees_vat\":0,\"label_ar\":\"Low income\",\"label_en\":\"Low income\",\"pay_free\":false,\"quantity\":\"20\",\"description\":null,\"hide_ticket\":true,\"pay_as_need\":false,\"max_quantity\":\"1\",\"min_quantity\":\"1\",\"sell_to_time\":null,\"fees_vat_rate\":0,\"sell_end_date\":null,\"ticket_active\":false,\"description_ar\":\"\",\"description_en\":\"\",\"sell_from_date\":null,\"sell_from_time\":null,\"disable_selling\":false,\"exchange_prices\":{\"AED\":58.72,\"AUD\":22.72,\"EUR\":14.24,\"GBP\":12,\"ILS\":50.24,\"JOD\":11.36,\"TRY\":799.52,\"USD\":16},\"fees_before_v