ن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"regular\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"358086888128\",\"is_pending_review\":\"0\",\"is_already_selling\":\"1\",\"agree_terms_and_conditions\":true,\"already_submitted_for_review\":true,\"duplicate_good_to_know_payment\":false,\"terms_and_conditions_timestamp\":\"2026-11-01T09:47:46.749435Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":1,\"label\":\"Halloween Party\",\"start_date\":\"Sun, Nov 1, 2026 6:30 PM\",\"lowest_price\":\"$56\",\"current_step\":\"success\",\"event_type\":\"regular\",\"event_step_status\":{\"event-details\":true,\"event-media\":true,\"pre-approval-tickets\":false,\"pre-approval-fields\":false,\"general-tickets\":true,\"seating-event\":false,\"seating-event-pre-approval\":false,\"rsvp\":false,\"event-preview\":true},\"venue_thumbnail_url\":null,\"checkout_link\":\"https://tzkrti.com/checkout/5049?page=2&city=london&country=gb&category=events\",\"sale_status\":\"Finished\",\"fees\":{\"refund\":{\"type\":\"percentage\",\"value\":\"5\",\"source\":\"environment\"},\"ticket\":{\"buyer\":null,\"organizer\":{\"type\":\"percentage\",\"value\":\"7\",\"source\":\"user\"},\"shared\":false}},\"category\":{\"id\":24,\"name\":{\"ar\":\"فعاليات اجتماعية\",\"en\":\"Social Events\"},\"parent_id\":33,\"slug\":\"social-events\",\"label\":\"Social Events\"},\"city_model\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"place_obj\":{\"id\":1023,\"city_id\":14885,\"seated_venue_id\":null,\"label\":\"Notting Hill Arts Club | Notting Hill Arts Club\",\"slug\":\"notting-hill-arts-club-notting-hill-arts-club\",\"name\":{\"ar\":\"Notting Hill Arts Club\",\"en\":\"Notting Hill Arts Club\"},\"description\":{\"ar\":\"\",\"en\":\"\"},\"content\":{\"ar\":\"\",\"en\":\"\"},\"social_links\":null,\"latitude\":\"51.509255\",\"longitude\":\"-0.1944909\",\"address\":\"21 Notting Hill Gate, London W11 3JQ, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-10-24T11:39:29.000000Z\",\"updated_at\":\"2026-10-24T11:39:29.000000Z\",\"user_id\":106039,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":null},\"from_date_only\":\"2026-11-01\",\"to_date_only\":\"2026-11-01\",\"from_time_only\":\"06:30 PM\",\"to_time_only\":\"11:30 PM\",\"country_id\":239},{\"id\":5044,\"name\":{\"ar\":\"Perfomance | felix taylor & Chloe Filani\",\"en\":\"Perfomance | felix taylor & Chloe Filani\"},\"content\":{\"ar\":\"<p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">Poet and performer Chloe Filani joins felix taylor for a one off, improvised performance of sound and poetry.&nbsp;&nbsp;</span></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">&nbsp;</span></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">The two have worked together on recorded projects but never in a live setting. They will use this opportunity to explore ways in which Chloe's unique performance style may meld with modes and ideas felix is exploring while in residence.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">This event is part felix taylor's residency in </span><a href=\\\"https://mosaicrooms.org/exhibitions-2026-2#sounding-towards\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgba(0, 0, 0, 0.847);\\\">sounding towards - -</a><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">. </span>During his residency and takeover, felix will be exploring the power of score as a technology of both memory and communication. felix will be writing and rehearsing new music, using the site as an open studio to develop new methods for both composition and improvisation. He will write scores, record and perform with a range of collaborators including Jemma Desai, Samra Mayanja, Abi Asisa, Oscar Taylor and students from Harris Girls' Academy East Dulwich. </p>\",\"en\":\"<p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">Poet and performer Chloe Filani joins felix taylor for a one off, improvised performance of sound and poetry.&nbsp;&nbsp;</span></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">&nbsp;</span></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">The two have worked together on recorded projects but never in a live setting. They will use this opportunity to explore ways in which Chloe's unique performance style may meld with modes and ideas felix is exploring while in residence.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">This event is part felix taylor's residency in </span><a href=\\\"https://mosaicrooms.org/exhibitions-2026-2#sounding-towards\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgba(0, 0, 0, 0.847);\\\">sounding towards - -</a><span style=\\\"color: rgba(0, 0, 0, 0.847);\\\">. </span>During his residency and takeover, felix will be exploring the power of score as a technology of both memory and communication. felix will be writing and rehearsing new music, using the site as an open studio to develop new methods for both composition and improvisation. He will write scores, record and perform with a range of collaborators including Jemma Desai, Samra Mayanja, Abi Asisa, Oscar Taylor and students from Harris Girls' Academy East Dulwich. </p>\"},\"image\":\"images/vkmVbsYsLWeAiSv7mXEyymz3fGkGgoMHat36mNqh.jpg\",\"images\":{\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"place_id\":727,\"city_id\":14885,\"slug\":\"perfomance-felix-taylor-chloe-filani\",\"from_date\":\"2026-10-31 17:00\",\"to_date\":\"2026-10-31 19:00\",\"ticket_types\":[],\"category_id\":1,\"user_id\":59377,\"published\":1,\"private\":null,\"created_at\":\"2026-10-23T09:41:02.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":1,\"currency\":\"GBP\",\"starting_from\":[],\"cta_label\":null,\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"rsvp\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"357509056213\",\"is_pending_review\":\"0\",\"is_already_selling\":\"0\",\"agree_terms_and_conditions\":true,\"already_submitted_for_review\":true,\"duplicate_good_to_know_payment\":false,\"terms_and_conditions_timestamp\":\"2026-10-23T16:04:45.469672Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":1,\"label\":\"Perfomance | felix taylor & Chlo