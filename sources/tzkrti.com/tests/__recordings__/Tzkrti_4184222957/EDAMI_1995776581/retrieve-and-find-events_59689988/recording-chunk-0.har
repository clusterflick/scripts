\"address\":\"226 Cromwell Rd, London SW5 0SW, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-06-16T21:19:48.000000Z\",\"updated_at\":\"2026-06-16T21:19:48.000000Z\",\"user_id\":59377,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":null},\"from_date_only\":\"2026-10-31\",\"to_date_only\":\"2026-10-31\",\"from_time_only\":\"07:00 PM\",\"to_time_only\":\"09:00 PM\",\"country_id\":239},{\"id\":4787,\"name\":{\"ar\":\"Artist Talk | Dahaleez Collective\",\"en\":\"Artist Talk | Dahaleez Collective\"},\"content\":{\"ar\":\"<p><span style=\\\"color: rgb(0, 0, 0);\\\">Join us for a special in person artists talk with members of Dahaleez Collective </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Majdal Nateel</strong><span style=\\\"color: rgb(0, 0, 0);\\\">, </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Salman Nawati </strong><span style=\\\"color: rgb(0, 0, 0);\\\">and </span><strong>Fidaa Alhassanat</strong>. </p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Majdal, Salman and Fidaa will discuss their sonic installation </span><em style=\\\"color: rgb(0, 0, 0);\\\">From–To</em><span style=\\\"color: rgb(0, 0, 0);\\\">, on display in our basement gallery as part of </span><em style=\\\"color: rgb(0, 0, 0);\\\">sounding towards - -</em><span style=\\\"color: rgb(0, 0, 0);\\\">. The work is an auditory archive assembled from recordings gathered in Gaza City during 2024 and 2025, holding what was, what is, and what refuses to disappear.&nbsp;</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">The conversation will extend beyond the installation to explore Dahaleez Collective's wider practice: their formation in Gaza in 2021, and their ongoing work and practice that seeks ways to reclaim and sustain visions of liberation.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">The artists will be in conversation with </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Angelina Radaković</strong><span style=\\\"color: rgb(0, 0, 0);\\\">, Head of Curatorial at Mosaic Rooms.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">This event is co-presented with </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Shubbak</strong><span style=\\\"color: rgb(0, 0, 0);\\\">.</span></p>\",\"en\":\"<p><span style=\\\"color: rgb(0, 0, 0);\\\">Join us for a special in person artists talk with members of Dahaleez Collective </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Majdal Nateel</strong><span style=\\\"color: rgb(0, 0, 0);\\\">, </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Salman Nawati </strong><span style=\\\"color: rgb(0, 0, 0);\\\">and </span><strong>Fidaa Alhassanat</strong>. </p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">Majdal, Salman and Fidaa will discuss their sonic installation </span><em style=\\\"color: rgb(0, 0, 0);\\\">From–To</em><span style=\\\"color: rgb(0, 0, 0);\\\">, on display in our basement gallery as part of </span><em style=\\\"color: rgb(0, 0, 0);\\\">sounding towards - -</em><span style=\\\"color: rgb(0, 0, 0);\\\">. The work is an auditory archive assembled from recordings gathered in Gaza City during 2024 and 2025, holding what was, what is, and what refuses to disappear.&nbsp;</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">The conversation will extend beyond the installation to explore Dahaleez Collective's wider practice: their formation in Gaza in 2021, and their ongoing work and practice that seeks ways to reclaim and sustain visions of liberation.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">The artists will be in conversation with </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Angelina Radaković</strong><span style=\\\"color: rgb(0, 0, 0);\\\">, Head of Curatorial at Mosaic Rooms.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">This event is co-presented with </span><strong style=\\\"color: rgb(0, 0, 0);\\\">Shubbak</strong><span style=\\\"color: rgb(0, 0, 0);\\\">.</span></p>\"},\"image\":\"images/NxiTLcxiZNq5ElvvFdAN5F7PdZWhVHqskqqfw3kp.jpg\",\"images\":{\"instagram_story\":\"\",\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"place_id\":727,\"city_id\":14885,\"slug\":\"artist-talk-dahaleez-collective\",\"from_date\":\"2026-10-29 17:00\",\"to_date\":\"2026-10-29 19:00\",\"ticket_types\":[],\"category_id\":2,\"user_id\":59377,\"published\":1,\"private\":null,\"created_at\":\"2026-09-24T12:02:12.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":1,\"currency\":\"GBP\",\"starting_from\":[],\"cta_label\":null,\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"rsvp\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"3502544719