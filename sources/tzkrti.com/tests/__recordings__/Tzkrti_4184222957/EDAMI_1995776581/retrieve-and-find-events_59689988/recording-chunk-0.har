_name_other\":\"\"},{\"fees\":0,\"name\":\"Finalrelease_7\",\"color\":null,\"index\":7,\"price\":\"28\",\"currency\":\"GBP\",\"due_date\":null,\"fees_vat\":0,\"label_ar\":\"Final release\",\"label_en\":\"Final release\",\"pay_free\":false,\"quantity\":\"40\",\"description\":null,\"hide_ticket\":true,\"pay_as_need\":false,\"max_quantity\":\"4\",\"min_quantity\":null,\"sell_to_time\":null,\"fees_vat_rate\":0,\"sell_end_date\":null,\"ticket_active\":false,\"description_ar\":\"\",\"description_en\":\"\",\"sell_from_date\":null,\"sell_from_time\":null,\"disable_selling\":false,\"exchange_prices\":{\"AED\":138.86,\"AUD\":54.11,\"EUR\":33.68,\"GBP\":28,\"ILS\":119.95,\"JOD\":26.86,\"TRY\":1892.65,\"USD\":37.84},\"fees_before_vat\":0,\"sell_start_date\":null,\"ticket_type_name\":\"other\",\"pay_as_need_config\":{\"max\":null,\"step\":null},\"ticket_type_name_other\":\"\"}],\"category_id\":1,\"user_id\":103883,\"published\":1,\"private\":0,\"created_at\":\"2026-10-21T13:36:29.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":0,\"currency\":\"GBP\",\"starting_from\":{\"AED\":89.27,\"AUD\":34.78,\"EUR\":21.65,\"GBP\":18,\"ILS\":77.11,\"JOD\":17.27,\"TRY\":1216.7,\"USD\":24.32},\"cta_label\":{\"ar\":\"\",\"en\":\"\",\"external_link\":\"\"},\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"regular\",\"agenda\":{\"ar\":\"<p>We’ve brought together some of the most exciting queer Arab artists from London, Berlin and Barcelona</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Performance </strong></p><p><strong>Salma Zahore</strong> </p><p>Iconic Lebanese drag artist who has performed from Barcelona to Paris to Amsterdam. Unapologetically Arab.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Tarek Khwiss</strong> </p><p>Legendary dancer and choreographer bringing some heat. </p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Music </strong></p><p><strong>Seksu</strong> </p><p>London-based Algerian DJ and founder of Bledi. Iconic club tracks blended with anthems from across the Arab world and North Africa.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Ashtattz</strong></p><p>Cairo-born, Barcelona-based DJ and the force behind Takhnis. Arab rhythms meet house, electro and club sounds.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Tareq </strong></p><p>One half of Boys’ Shorts. You’ve seen him at Feel It, DILF and Horse Meat Disco. House, techno and disco.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>DJ Aboalaa</strong></p><p>The hottest Arabic DJ in Berlin, bringing 90s and 00s Arabic dance pop. The mystery guest of the night.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>3MR</strong> </p><p> Co-founder of Drip and Erotica club, taking you home sweaty with everything from Haifa to hard techno.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Host</strong></p><p><strong>Hasan</strong> <strong>Kilani</strong></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Produced by</strong></p><p><strong>@its_3mr_okay × @omarighazal</strong></p>\",\"en\":\"<p>We’ve brought together some of the most exciting queer Arab artists from London, Berlin and Barcelona</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Performance </strong></p><p><strong>Salma Zahore</strong> </p><p>Iconic Lebanese drag artist who has performed from Barcelona to Paris to Amsterdam. Unapologetically Arab.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Tarek Khwiss</strong> </p><p>Legendary dancer and choreographer bringing some heat. </p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Music </strong></p><p><strong>Seksu</strong> </p><p>London-based Algerian DJ and founder of Bledi. Iconic club tracks blended with anthems from across the Arab world and North Africa.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Ashtattz</strong></p><p>Cairo-born, Barcelona-based DJ and the force behind Takhnis. Arab rhythms meet house, electro and club sounds.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Tareq </strong></p><p>One half of Boys’ Shorts. You’ve seen him at Feel It, DILF and Horse Meat Disco. House, techno and disco.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>DJ Aboalaa</strong></p><p>The hottest Arabic DJ in Berlin, bringing 90s and 00s Arabic dance pop. The mystery guest of the night.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>3MR</strong> </p><p> Co-founder of Drip and Erotica club, taking you home sweaty with everything from Haifa to hard techno.</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Host</strong></p><p><strong>Hasan</strong> <strong>Kilani</strong></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong>Produced by</strong></p><p><strong>@its_3mr_okay × @omarighazal</strong></p>\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"<p>18+ event</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Valid photo ID required. No ID, no entry</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Phone cameras will be covered with stickers</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>No smart glasses</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Our photographer will capture the artists only, not the crowd</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>The room is reached by stairs, with no step-free access</p>\",\"en\":\"<p>18+ event</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>Valid photo ID required. No ID, no entry</p><p style=\