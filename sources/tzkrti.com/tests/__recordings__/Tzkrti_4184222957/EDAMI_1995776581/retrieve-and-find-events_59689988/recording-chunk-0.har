der Chaou&Nourredine Dziri\",\"start_date\":\"Sat, Dec 12, 2026 7:00 PM\",\"lowest_price\":\"$68\",\"current_step\":\"success\",\"event_type\":\"seats\",\"event_step_status\":{\"event-details\":true,\"event-media\":true,\"pre-approval-tickets\":false,\"pre-approval-fields\":false,\"general-tickets\":false,\"seating-event\":true,\"seating-event-pre-approval\":false,\"rsvp\":false,\"event-preview\":true},\"venue_thumbnail_url\":\"https://cdn-thumbnails.seatsio.net/region/eu/workspaceKey/84602b85-4af4-4edf-b274-8482d06cdf28/charts/ec1d621e-7fde-bb69-43e5-c204e936b863/version/published/thumbnail/46\",\"checkout_link\":\"https://tzkrti.com/checkout/5174?page=2&city=london&country=gb&category=events\",\"sale_status\":\"On Sale\",\"fees\":{\"refund\":{\"type\":\"percentage\",\"value\":\"5\",\"source\":\"environment\"},\"ticket\":{\"buyer\":null,\"organizer\":{\"type\":\"percentage\",\"value\":\"7\",\"source\":\"user\"},\"shared\":false}},\"category\":{\"id\":1,\"name\":{\"ar\":\"موسيقى\",\"en\":\"Music\"},\"parent_id\":26,\"slug\":\"music\",\"label\":\"Music\"},\"place_obj\":{\"id\":1034,\"city_id\":14885,\"seated_venue_id\":1437422,\"label\":\"Shaam Hall\",\"slug\":\"shaam-hall\",\"name\":{\"ar\":\"Shaam Hall\",\"en\":\"Shaam Hall\"},\"description\":{\"ar\":\"\",\"en\":\"\"},\"content\":{\"ar\":\"\",\"en\":\"\"},\"social_links\":{\"facebook\":\"\",\"whatsapp\":\"\",\"instagram\":\"\"},\"latitude\":\"51.5295559\",\"longitude\":\"-0.2697655\",\"address\":\"857a Coronation Rd, London NW10 7PP, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-11-04T12:03:56.000000Z\",\"updated_at\":\"2026-11-04T12:03:56.000000Z\",\"user_id\":null,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":{\"id\":1437422,\"place_id\":null,\"key\":\"ec1d621e-7fde-bb69-43e5-c204e936b863\",\"name\":\"Shaam Hall - London\",\"status\":\"PUBLISHED\",\"tags\":null,\"archived\":0,\"publishedVersionThumbnailUrl\":\"https://cdn-thumbnails.seatsio.net/region/eu/workspaceKey/84602b85-4af4-4edf-b274-8482d06cdf28/charts/ec1d621e-7fde-bb69-43e5-c204e936b863/version/published/thumbnail/46\",\"draftVersionThumbnailUrl\":null,\"created_at\":\"2026-11-04T12:00:57.000000Z\",\"updated_at\":\"2026-11-05T14:35:22.000000Z\"}},\"from_date_only\":\"2026-12-12\",\"to_date_only\":\"2026-12-12\",\"from_time_only\":\"07:00 PM\",\"to_time_only\":\"11:00 PM\",\"country_id\":239}],\"title\":null},\"hasMore\":false,\"page\":2,\"strategy\":\"LOCAL_WITH_PAST\",\"banner\":null,\"pastEvents\":{\"items\":[{\"id\":4835,\"name\":{\"ar\":\"Book Launch | Huna:  A Memoir of Revolution, Prison, and Becoming\",\"en\":\"Book Launch | Huna:  A Memoir of Revolution, Prison, and Becoming\"},\"content\":{\"ar\":\"<p><em style=\\\"color: rgb(36, 36, 36);\\\">What does it mean to remain 'here' when here is not a physical space?</em></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>In partnership with Wasafiri magazine, join us for the book launch of <em>Huna: A Memoir of Revolution, Prison, and Becoming</em> by <strong style=\\\"color: rgb(36, 36, 36);\\\">Abdelrahman ElGendy</strong><span style=\\\"color: rgb(36, 36, 36);\\\">. In the book, ElGendy begins from that word, huna, here, inspired by the popular protest song \\\"Sawfa Nabqa Huna\\\". </span><em style=\\\"color: rgb(36, 36, 36);\\\">Huna </em><span style=\\\"color: rgb(36, 36, 36);\\\">emerges from six years of political imprisonment in Egypt and grapples with revolutionary hereness and witness inside a revolution, prison cells, and exile, reckoning with what it means to inhabit a space designed to erase you and find ways to be. </span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(36, 36, 36);\\\">ElGendy will be join in conversation with historian and award-winning translator </span><strong style=\\\"color: rgb(36, 36, 36);\\\">Hazem Jamjoum</strong><span style=\\\"color: rgb(36, 36, 36);\\\">. The conversation will span multiple topics and questions, begining with </span><em style=\\\"color: rgb(36, 36, 36);\\\">Huna </em><span style=\\\"color: rgb(36, 36, 36);\\\">and open outward: toward prison literature, cross-prison solidarity, and the resonances between prison movements in Egypt and Palestine, as well as the ways in which they may refuse easy comparison. What can prisoners teach us when we stop treating them as mere spectacles and begin listening to them as theorists and meaning-makers? Can well-intentioned superhumanisation of political prisoners be as harmful as dehumanisation?</span></p>\",\"en\":\"<p><em style=\\\"color: rgb(36, 36, 36);\\\">What does it mean to remain 'here' when here is not a physical space?</em></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>In partnership with Wasafiri magazine, join us for the book launch of <em>Huna: A Memoir of Revolution, Prison, and Becoming</em> by <strong style=\\\"color: rgb(36, 36, 36);\\\">Abdelrahman ElGendy</strong><span style=\\\"color: rgb(36, 36, 36);\\\">. In the book, ElGendy begins from that word, huna, here, inspired by the popular protest song \\\"Sawfa Nabqa Huna\\\". </span><em style=\\\"color: rgb(36, 36, 36);\\\">Huna </em><span style=\\\"color: rgb(36, 36, 36);\\\">emerges from six years of political imprisonment in Egypt and grapples with revolutionary hereness and witness inside a revolution, prison cells, and exile, reckoning with what it means to inhabit a space designed to erase you and find ways to be. </span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"color: rgb(36, 36, 36);\\\">ElGendy will be join in conversation with historian and award-winning translator </span><strong style=\\\"color: rgb(36, 36, 36);\\\">Hazem Jamjoum</strong><span style=\\\"color: rgb(36, 36, 36);\\\">. The conversation will span multiple topics and questions, begining with </span><em style=\\\"color: rgb(36, 36, 36);\\\">Huna </em><span style=\\\"color: rgb(36, 36, 36);\\\">and open outward: toward prison literature, cross-prison solidarity, and the resonances between prison movements in Egypt and Palestine, as well as the ways in which they may refuse easy comparison. What can prisoners teach us when we stop treating them as mere spectacles and begin listening to them as theorists and meaning-makers? Can well-intentioned superhumanisation of political prisoners be as harmful as dehumanisation?</span></p>\"},\"image\":\"images/IYIPI6FNx7gJbvF9CHMOZZattXrkSIB8nk9scW7M.jpg\",\"images\":{\"instagram_story\":\"\",\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"place_id\":727,\"city_id\":14885,\"slug\":\"book-launch-huna-a-memoir-of-revolution-prison-and-becoming\",\"from_date\":\"2026-11-03 17:00\",\"to_date\":\"2026-11-03 19:00\",\"ticket_types\":[],\"category_id\":18,\"user_id\":59377,\"published\":1,\"private\":null,\"created_at\":\"2026-09-30T14:27:22.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":1,\"currency\":\"GBP\",\"starting_from\":[],\"cta_label\":null,\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"rsvp\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"351676316384\",\"is_pending_review\":\"0\",\"is_already_selling\":\"1\",\"agree_terms_and_conditions\":true,\"already_submitted_for_review\":true,\"duplicate_good_to_know_payment\":false,\"terms_and_conditions_timestamp\":\"2026-10-29T13:57:45.991390Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":1,\"label\":\"Book Launch | Huna:  A Memoir of Revolution, Prison, and Becoming\",\"start_date\":\"Tue, Nov 3, 2026 7:00 PM\",\"lowest_price\":null,\"current_step\":\"rsvp\",\"event_type\":\"rsvp\",\"event_step_status\":{\"event-details\":true,\"event-media\":true,\"pre-approval-tickets\":false,\"pre-approval-fields\":false,\"general-tickets\":false,\"seating-event\":false,\"seating-event-pre-approval\":false,\"rsvp\":false,\"event-preview\":false},\"venue_thumbnail_url\":null,\"checkout_link\":\"https://tzkrti.com/checkout/4835?page=2&city=london&country=gb&category=events\",\"sale_status\":\"Finished\",\"fees\":{\"refund\":{\"type\":\"percentage\",\"value\":\"5\",\"source\":\"environment\"},\"ticket\":{\"buyer\":null,\"organizer\":{\"type\":\"percentage\",\"value\":\"7\",\"source\":\"user\"},\"shared\":false}},\"category\":{\"id\":18,\"name\":{\"ar\":\"أدب\",\"en\":\"Literature\"},\"parent_id\":27,\"slug\":\"literature\",\"label\":\"Literature\"},\"city_model\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"place_obj\":{\"id\":727,\"city_id\":14885,\"seated_venue_id\":null,\"label\":\"Mosaic Rooms | Mosaic Rooms\",\"slug\":\"mosaic-rooms-mosaic-rooms\",\"name\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"description\":{\"ar\":\"\",\"en\":\"\"},\"content\":{\"ar\":\"\",\"en\":\"\"},\"social_links\":null,\"latitude\":\"51.4949507\",\"longitude\":\"-0.1952534\",\"address\":\"226 Cromwell Rd, London SW5 0SW, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-06-16T21:19:48.000000Z\",\"updated_at\":\"2026-06-16T21:19:48.000000Z\",\"user_id\":59377,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":null},\"from_date_only\":\"2026-11-03\",\"to_date_only\":\"2026-11-03\",\"from_time_only\":\"07:00 PM\",\"to_time_only\":\"09:00 PM\",\"country_id\":239},{\"id\":4873,\"name\":{\"ar\":\"أيام السينما الفلسطينية حول العالم : \\\"مبارك مبارك النسيان \\\" و \\\"مع حسن في غزة\\\"\",\"en\":\"Palestine Cinema Days Around the World: Blessed Blessed Oblivion & With Hasan in Gaza\"},\"content\":{\"ar\":\"<p class=\\\"ql-direction-rtl\\\"><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">يتعاون كل من&nbsp; LUX و Mosaic Rooms&nbsp; لتقديم عرض سينمائي خاص يجمع بين فيلم \\\"مبارك مبارك النسيان\\\" (2010) - 21 دقيقة، للمخرجة جمانة منّاع، من مجموعة LUX وفيلم \\\"مع حسن في غزة\\\" (2025) - 106 دقائق، للمخرج كمال الجعفري، وذلك ضمن فعاليات أيام السينما الفلسطينية حول العالم.&nbsp;</span></p>\",\"en\":\"<p><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">LUX</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> and </span><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Mosaic Rooms </strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">are collaborating for a special screening of </span><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Jumana Manna’</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">s </span><em style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Blessed Blessed Oblivion </em><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">(2010, 21’) from the LUX collection, alongside </span><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Kamal Aljafari</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">’s </span><em style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">With Hasan in Gaza </em><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">(2025, 106’) as part of the </span><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Palestine Cinema Days Around the World</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">. Presented together, these two films provide a rich portrait of Palestinian daily life, one in East Jerusalem, the other in Gaza. In particular, they have a focus on the manifestations of masculinity in Palestine, looking beyond the stereotypes of Palestinian men that have often circulated in Western media.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Jumana Manna’s </span><em style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Blessed Blessed Oblivion</em><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> weaves together a portrait of masculine performativity in East Jerusalem, as manifested in gyms, barber shops and body parlours. Inspired by Kenneth Anger’s </span><em style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Scorpio Rising</em><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> (1963), the video uses visual collage and the soundtrack as ironic commentary on stereotyped male “thug” culture in Palestine. Close-up fragments construct an eroticised and parodic montage of bodies, cars and places, intersected by snippets of dialogue and a monologue about the art of a car wash. Simultaneously psychologizing the characters and being seduced by them, the film director finds herself in a double bind similar to the conflicted desire that animates her protagonist as he drifts between abject rants, declamations of heroic poetry and unashamed self-praise.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><em style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">With Hasan in Gaza</em><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> looks back at a journey the filmmaker made in 2001, from the north to the south of Gaza, searching for the man with whom he had spent seven months in an Israeli prison over a decade earlier. Aljafari recently rediscovered the footage in his archive and edited it into this filmic journal of daily life in Gaza, with all of its moments of vibrancy. The film captures children at play, </span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p>-----</p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Organised by </span><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Filmlab Palestine</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">, the 4th edition of </span><a href=\\\"https://flp.ps/node/319\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"><strong>Palestine Cinema Days Around The World</strong></a><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> takes place on 2 November 2026, the 109th anniversary of the Balfour Declaration. Palestine Cinema Days Around the World is a global platform that transcends borders to bring Palestinian stories to the forefront of the world’s conscience. Palestine Cinema Days have grown into a borderless, community-driven act of cultural resistance to protect our stories against systematic erasure, silencing, and distortion.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><strong style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">LUX</strong><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> is an arts organisation that supports and promotes visual artists working with the moving image. Founded in 2002 as a charity and not-for-profit limited company, the organisation builds on a long lineage of predecessors (The London Film-Makers’ Co-operative, London Video Arts and The Lux Centre) which stretch back to the 1960s.</span></p><p style=\\\"height: 22px;\\\" style=\\\"height: 22px;\\\"></p><p><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\">Founded in London in 2008 by the A.M. Qattan Foundation, </span><a href=\\\"https://tzkrti.com/en/organizer/event-wizard/create/mosaicrooms.org\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"><strong>Mosaic Rooms</strong></a><span style=\\\"background-color: transparent; color: rgb(0, 0, 0);\\\"> supports and amplifies contemporary culture from the Arab world and beyond. Now operating as an independent charity, Mosaic Rooms enters a new chapter, while remaining rooted in its founding values.</span></p>\"},\"image\":\"images/4L51rrAvHUSNFPQKQRln6jLhGPfR4ewL148jGymp.png\",\"images\":{\"instagram_story\":\"images/QQE16gRzKAzPBDb3VBiNtwg3omWJxLfcjckulChF.png\",\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"place_id\":727,\"city_id\":14885,\"slug\":\"palestine-cinema-days-around-the-world-blessed-blessed-oblivion-with-hasan-in-gaza\",\"from_date\":\"2026-11-02 14:00\",\"to_date\":\"2026-11-02 16:00\",\"ticket_types\":[],\"category_id\":5,\"user_id\":59377,\"published\":1,\"private\":null,\"created_at\":\"2026-10-05T12:16:14.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":1,\"currency\":\"GBP\",\"starting_from\":[],\"cta_label\":null,\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"rsvp\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"dual\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"352226691817\",\"is_pending_review\":\"0\",\"is_already_selling\":\"0\",\"agree_terms_and_conditions\":true,\"already_submitted_for_review\":true,\"duplicate_good_to_know_payment\":false,\"terms_and_conditions_timestamp\":\"2026-10-05T13:54:02.325644Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":1,\"label\":\"Palestine Cinema Days Around the World: Blessed Blessed Oblivion & With Hasan in Gaza\",\"start_date\":\"Mon, Nov 2, 2026 4:00 PM\",\"lowest_price\":null,\"current_step\":\"rsvp\",\"event_type\":\"rsvp\",\"event_step_status\":{\"event-details\":true,\"event-media\":true,\"pre-approval-tickets\":false,\"pre-approval-fields\":false,\"general-tickets\":false,\"seating-event\":false,\"seating-event-pre-approval\":false,\"rsvp\":false,\"event-preview\":false},\"venue_thumbnail_url\":null,\"checkout_link\":\"https://tzkrti.com/checkout/4873?page=2&city=london&country=