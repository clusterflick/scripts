eated_venue_id\":null,\"label\":\"Mosaic Rooms | Mosaic Rooms\",\"slug\":\"mosaic-rooms-mosaic-rooms\",\"name\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"description\":{\"ar\":\"\",\"en\":\"\"},\"content\":{\"ar\":\"\",\"en\":\"\"},\"social_links\":null,\"latitude\":\"51.4949507\",\"longitude\":\"-0.1952534\",\"address\":\"226 Cromwell Rd, London SW5 0SW, UK\",\"icon\":null,\"image\":null,\"published\":1,\"created_at\":\"2026-06-16T21:19:48.000000Z\",\"updated_at\":\"2026-06-16T21:19:48.000000Z\",\"user_id\":59377,\"city\":{\"id\":14885,\"name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"slug\":\"london\",\"timezone\":null,\"latitude\":\"51.5072° N\",\"longitude\":\"0.1276° W\",\"published\":1,\"is_capital\":0,\"country_id\":239,\"currency_code\":\"GBP\",\"created_at\":\"2025-05-18T06:37:06.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"unlisted\":0,\"country\":{\"id\":239,\"name\":{\"ar\":\"المملكة المتحدة\",\"en\":\"United Kingdom\"},\"timezone\":\"Europe/London\",\"date_format\":\"D, d M Y H:i\",\"iso\":\"GB\",\"currency_code\":\"GBP\",\"latitude\":\"55.3780510\",\"longitude\":\"-3.4359730\",\"published\":1,\"created_at\":\"2025-05-18T06:36:44.000000Z\",\"updated_at\":\"2026-07-06T08:46:12.000000Z\",\"vat\":0,\"continent\":\"europe\"}},\"seated_venue\":null},\"from_date_only\":\"2026-10-29\",\"to_date_only\":\"2026-10-29\",\"from_time_only\":\"07:00 PM\",\"to_time_only\":\"09:00 PM\",\"country_id\":239},{\"id\":4764,\"name\":{\"ar\":\"Rhythm Race Revolution | Architectures of Self-Determination through Sound\",\"en\":\"Rhythm Race Revolution | Architectures of Self-Determination through Sound\"},\"content\":{\"ar\":\"<p>In this session, we will explore the ways in which collectives of artists and avant-garde thinkers and dreamers have refused to submit to the rhythms of an oppressive system which both exploits cultural workers and commodifies the music and the artist alike. We will traverse the worlds of the savant Black Jazz and Strata East labels, as well as the feminist label Olivia. The pulse of improvisation and experimentation will be the thread that we unweave to see how new ways of being can indeed transpire.&nbsp;</p>\",\"en\":\"<p>In this session, we will explore the ways in which collectives of artists and avant-garde thinkers and dreamers have refused to submit to the rhythms of an oppressive system which both exploits cultural workers and commodifies the music and the artist alike. We will traverse the worlds of the savant Black Jazz and Strata East labels, as well as the feminist label Olivia. The pulse of improvisation and experimentation will be the thread that we unweave to see how new ways of being can indeed transpire.&nbsp;</p>\"},\"image\":\"images/O93HCGdIhDpEvOka4RPOlzPrqjYJmjz3Vl5eANzW.jpg\",\"images\":{\"banner_default_image\":\"false\"},\"place\":{\"ar\":\"Mosaic Rooms\",\"en\":\"Mosaic Rooms\"},\"place_id\":727,\"city_id\":14885,\"slug\":\"rhythm-race-revolution-architectures-of-self-determination-through-sound\",\"from_date\":\"2026-10-28 17:00\",\"to_date\":\"2026-10-28 19:00\",\"ticket_types\":[],\"category_id\":2,\"user_id\":59377,\"published\":1,\"private\":null,\"created_at\":\"2026-09-21T14:17:33.000000Z\",\"gateway\":\"Stripe_eu\",\"seatsIo\":[],\"rsvp\":1,\"currency\":\"GBP\",\"starting_from\":[],\"cta_label\":null,\"city_name\":{\"ar\":\"لندن\",\"en\":\"London\"},\"unlisted\":0,\"extra_detail\":{\"type\":\"rsvp\",\"agenda\":{\"ar\":\"\",\"en\":\"\"},\"language\":\"english\",\"is_reviewed\":\"1\",\"good_to_know\":{\"ar\":\"\",\"en\":\"\"},\"hubspot_deal_id\":\"349600960237\",\"is_pending_review\":\"0\",\"is_already_selling\":\"0\",\"agree_terms_and_conditions\":true,\"already_submitted_for_review\":true,\"duplicate_good_to_know_payment\":false,\"terms_and_conditions_timestamp\":\"2026-09-21T14:18:35.846655Z\"},\"feature_private\":0,\"seo\":null,\"is_past\":1,\"label\":\"Rhythm Race Revolution | Architectures of Self-Determination through Sound\",\"start_date\":\"Wed, Oct 