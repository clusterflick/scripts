            "text": "<!DOCTYPE html>\n<html lang=\"en\"\n    xmlns:og=\"https://opengraphprotocol.org/schema/\"\n    xmlns:fb=\"https://www.facebook.com/2008/fbml\">\n<head >\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<!-- Google tag (gtag.js) -->\n\t\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-4PTXJBFFTQ\"></script>\n\t\t<script>\n\t\t\t  window.dataLayer = window.dataLayer || [];\n\t\t\t  function gtag(){dataLayer.push(arguments);}\n\t\t\t  gtag(\"js\", new Date());\n\n\t\t\t  gtag(\"config\", \"G-4PTXJBFFTQ\");\n\t\t</script><meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v28.0 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<title>The Night Is Short, Walk On Girl - Japanese Film Club</title>\n\t<link rel=\"canonical\" href=\"https://japanesefilm.club/the-night-is-short-walk-on-girl/\" />\n\t<meta property=\"og:locale\" content=\"en_GB\" />\n\t<meta property=\"og:type\" content=\"article\" />\n\t<meta property=\"og:title\" content=\"The Night Is Short, Walk On Girl - Japanese Film Club\" />\n\t<meta property=\"og:description\" content=\"Walk through an eccentric, colourful journey of love, life and youthful exuberance unlike anything you’ve seen before. From pub crawls to festivals, book fairs to impromptu musical performances, the night is short and there’s much to take in - how can “Senpai” possibly grab the attention of the apple of his eye?\" />\n\t<meta property=\"og:url\" content=\"https://japanesefilm.club/the-night-is-short-walk-on-girl/\" />\n\t<meta property=\"og:site_name\" content=\"Japanese Film Club\" />\n\t<meta property=\"article:modified_time\" content=\"2026-07-09T11:21:40+00:00\" />\n\t<meta property=\"og:image\" content=\"https://japanesefilm.club/wp-content/uploads/2026/07/MV5BOWJlY2U0YjYtMmFjNC00ODBkLWI1YjEtNDQxMzAzZmY5N2UwXkEyXkFq