pg 1024w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-300x169.jpg 300w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-768x432.jpg 768w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920.jpg 1200w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /><noscript><img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"360\" src=\"https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-640x360.jpg\" class=\"img-fluid modal-xl align-none size-medium wp-image-4314\" alt=\"kei_yuu-kashii_1920 | MadeGood\" srcset=\"https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-640x360.jpg 640w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-1024x576.jpg 1024w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-300x169.jpg 300w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920-768x432.jpg 768w, https://japanesefilm.club/wp-content/uploads/2026/01/kei_yuu-kashii_1920.jpg 1200w\" sizes=\"auto, (max-width: 640px) 100vw, 640px\" /></noscript><br />\n</a></p>\n<p><a href=\"https://japanesefilm.club/wp-content/uploads/2026/01/nozomi_shiori-sekine_1920.jpg\" data-fslightbox=\"gallery\" class=\"col-12 article_image\"><br />\n<img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"360\" src=\"//japanesefilm.club/wp-content/plugins/a3-lazy-load/assets/images/lazy_placeholder.gif\" data-lazy-type=\"image\" data-src=\"https://japanesefilm.club/wp-content/uploads/2026/01/nozomi_shiori-sekine_1920-640x360.jpg\" class=\"lazy lazy-hidden img-fluid modal-xl align-none size-medium wp-image-4313\" alt=\"nozomi_shiori-sekine_1920 | MadeGood\" srcset=\"\" data-srcset=\"https://japanesefilm.club/wp-content/uploads/2026/01/nozomi_shiori-sekine_1920-640x360.jpg 640w, https://japanesefilm.club/wp-content/uploads/2026/01/nozomi_shiori-sekine_1920-1024x576.jpg 1024w, https://japanesefilm.club/wp-content/uploads/20