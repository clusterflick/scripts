=\"png_title_image\"></noscript></div>\n\t\t<div class=\"vod_items col-12 offset-xl-1 col-xl-11 order-2 order-md-1\" >\n\t\t\t<h1>Chapter, Cardiff</h1>\n\t\t</div>\n\t\t\n\t\t<div class=\"excerpt col-12 col-md-9 col-lg-8 col-xl-7 offset-xl-1 venue order-3 \" >\n\t\t\t<div class=\"meta_bits right top\">\n\t\t\t\t<div class=\"meta_bit director_country_release text-truncate venue_event\">Chapter Arts Centre, Market Road, Canton, Cardiff CF5 1QE - <a class=\"gmap_link\" href=\"#gmap\">view map ›</a></div>\n\t\t\t</div>\n\t\t\t<p> \n\t\t\t\t<div class=\"meta_bits right bottom\">\n\t\t\t\t\t\n\t\t\t\t</div>\n\t\t\t</p>\n\t\t</div>\n\t</div>\n\t<div class=\"feed_divider\"></div>\n</div><div class=\"row\">\n\t\t\t\t\t\t<div class=\"col-12 col-lg-10 col-xl-9 offset-xl-1 screening_schedule\" id=\"screening_schedule\">\n\t\t\t\t\t\t\t<div class=\"screening_schedule_items\"><div class=\"item screening_schedule normal row g-0\">\n\t\t\t\t                    <div class=\"col-12 col-md-10 order-1\">\n\t\t\t\t                        <h5><a href=\"https://japanesefilm.club/linda-linda-linda/\">Linda Linda Linda - 4K Restoration</a> - <a class=\"cinema_title\" href=\"https://japanesefilm.club/chapter-cardiff/\">Chapter, Cardiff</a></h5>\n\t\t\t\t                        \n\t\t\t\t                        <h6>Screening Date TBC</h6>\n\t\t\t\t                        \n\t\t\t\t                    </div>\n\t\t\t\t                     <div class=\"gy-2 gy-md-0 col-12 col-md-2 order-4 order-md-2\">\n\t                                    <div class=\"seven_day_button light sold_out\"\">TBC</div>\n\t                                </div>\n\t\t\t\t                </div></div></div></div>\n\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t<div class=\"col-12 col-md-9 col-lg-8 offset-xl-1 col-xl-7 col-xxl-6 article_text tv\" >\n\t\t\t\t\t\t\t<div class=\"newsletter_box\">\n\t\t\t\t\t<h5>Get Discount Tickets For Japanese Film Club Now!</h5>\n\t\t\t\t\t<form class=\"user_registration advert\"  method=\"post\" action=\"https://japanesefilm.club/chapter-cardiff/\">\n\n\t\t\t\t\t<div class=\"cf-turnstile\" \n                        data-sitekey=\"0x4AAAAAADOa7z6oxF-yCNHC\" \n                        data-callback=\"onTurnstileSuccess\"\n                        data-theme=\"light\"></div>\n\n                        <input type=\"email\" name=\"email_address\" class=\"first_step_email\" placeholder=\"Email address\" required=\"\">\n                        <input type=\"submit\" class=\"first_step_button\" value=\"Join now ›\">\n                    </form>\n                    <p>Sign up for the FREE Japanese Film Club newsletter now to gain access to discount and early access tickets to all our events. <span class=\"extra_text\"></span></p>\n\t\t\t\t</div><p>Find your new favourite film or rediscover a classic, and experience cinema like nowhere else!</p>\n<p>Chapter takes the lead in independent cinema in Wales, presenting the best of Welsh, UK and international film.</p>\n<p>Alongside new releases, Chapter brings a range of festivals and curated seasons, with talks, Q&#038;As and events offering our audiences an enriched cinema experience and insight into the thriving film industry in Wales.</p>\n<p>Chapter is proud to be Film Hub Wales, one of eight around the UK, formed as part of the British Film Institute: Film Audience Network. Through Film Hub for Wales, we bring more films, to more people, in more places across the country.</p>\n\t<div class=\"google_map\" id=\"gmap\">\n                        <iframe\n                            height=\"250\"\n                            frameborder=\"0\" style=\"border:0\"\n                            referrerpolicy=\"no-referrer-when-downgrade\"\n                            src=\"https://www.google.com/maps/embed/v1/place?key=AIzaSyBJSQLszF9zjGkapwqGQ0H-Kefa_tIrzQk&q=Chapter+Arts+Centre,+Market+Road,+Canton,+Cardiff+CF5+1QE\" allowfullscreen>\n                        </iframe>\n                    </div></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div></div>\n\t\t\t</div></div></div><footer class=\"entry-footer\"></footer></article></main><footer class=\"site-footer\"><div class=\"wrap\"> <div class=\"copyright\">\n    \t<p>This website and its content is copyright of MadeGood Films - © MadeGood Films 2026 All rights reserved.</p></div></div><p></p></div></footer></div><script type=\"speculationrules\">\n{\"prefetch\":[{\"source\":\"document\",\"where\":{\"and\":[{\"href_matches\":\"/*\"},{\"not\":{\"href_matches\":[\"/wp-*.php\",\"/wp-admin/*\",\"/wp-content/uploads/*\",\"/wp-content/*\",\"/wp-content/plugins/*\",\"/wp-content/themes/madegood/*\",\"/wp-content/themes/genesis/*\",\"/*\\\\?(.+)\"]}},{\"not\":{\"selector_matches\":\"a[rel~=\\\"nofollow\\\"]\"}},{\"not\":{\"selector_matches\":\".no-prefetch, .no-prefetch a\"}}]},\"eagerness\":\"conservative\"}]}\n</script>\n<script id=\"bootstrap-js-js\" src=\"https://japanesefilm.club/wp-content/themes/madegood/bootstrap-5.3.8-dist/js/bootstrap.bundle.min.js?ver=5.3.0\"></script>\n<script id=\"vimeojs-js\" src=\"https://player.vimeo.com/api/player.js\"></script>\n<script id=\"jquery_csv-js\" src=\"https://japanesefilm.club/wp-content/themes/madegood/scripts/jquery.csv.js\"></script>\n<script id=\"sitewidescripts-js-extra\">\nvar cart_ajax = {\"ajaxurl\":\"https://japanesefilm.club/wp-admin/admin-ajax.php\",\"nonce\":\"9e4d2ebcec\"};\nvar merch_cart_ajax = {\"ajaxurl\":\"https://japanesefilm.club/wp-admin/admin-ajax.php\",\"nonce\":\"03cda98be4\"};\nvar tvod_cart_ajax = {\"ajaxurl\":\"https://japanesefilm.club/wp-admin/admin-ajax.php\",\"nonce\":\"6617fc120c\"};\n//# sourceURL=sitewidescripts-js-extra\n</script>\n<script id=\"sitewidescripts-js\" src=\"https://japanesefilm.club/wp-content/themes/madegood/scripts/sitewidescripts.js\"></script>\n<script id=\"fs_lightbox-js\" src=\"https://japanesefilm.club/wp-content/themes/madegood/scripts/fslightbox-pro/fslightbox.js\"></script>\n<script id=\"splide_4_js-js\" src=\"https://japanesefilm.club/wp-