            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"ca72935d-ee1c-42ab-9612-bfc8554e1c10\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Revival London Archive Sale\",\"description\":\"<h2>Revival London turns 6!<br></h2><p>To mark six years of slow fashion, creativity, and community impact, we're having a pop up!<br></p><p>We’re celebrating with an <strong>Archive Sale Pop Up</strong> and inviting you to shop exclusive<strong> Revival London</strong> pieces at massively discounted prices. Think past collections, one-off designs, samples, and archive gems - truly one-of-a-kind pieces you won't find anywhere else, and once they're gone, they're gone. Whether you've been with us since the beginning or you're just discovering Revival, this is your chance to take home a piece of the journey.<br></p><p>Expect good music, great company, and a celebratory atmosphere. It's a celebration after all!<br></p><p>We're delighted to have <strong>Living Things</strong> pouring the drinks and <strong>Proper</strong> keeping everyone fuelled with snacks throughout the day.<br></p><p>Come through, find a piece that's truly you, meet the community, and toast six years of doing things differently with us. See you there! 💛</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-26T11:00:00.000\",\"endDate\":\"2026-09-26T17:00:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"cd719e6e-824d-4f1d-8167-03e207064b69\",\"address\":\"108 Stable Street, London N1C 4DQ, UK\",\"locationName\":\"KioskN1C\",\"latitude\":51.5358238,\"longitude\":-0.1261497},\"image\":{\"filePath\":\"events/ca72935d-ee1c-42ab-9612-bfc8554e1c10/e66d4222-d68b-411d-8968-a0f22e019685/9419ef17-26a7-43dc-ab8f-70073d506e90.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Fca72935d-ee1c-42ab-9612-bfc8554e1c10%2Fe66d4222-d68b-411d-8968-a0f22e019685%2F9419ef17-26a7-43dc-ab8f-70073d506e90.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"3eaf38da-bc2a-4f3c-bc02-cbd8662b131c\",\"name\":\"General Admission\",\"description\":\"\",\"maxQuantity\":null,\"sold\":25,\"leftSeats\":false,\"startDate\":\"2026-09-04T00:00:00.000\",\"endDate\":\"2026-09-26T00:00:00.000\",\"price\":\"0.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"ca72935d-ee1c-42ab-9612-bfc8554e1c10\",\"programId\":null}],\"seats\":null,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":1,\"eventsCount\":51,\"attendeesCount\":13,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"revival-london\",\"bio\":\"\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"not-onboarded\",\"createdAt\":\"2026-08-18T10:02:23.696Z\",\"updatedAt\":\"2026-09-03T16:49:10.995Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Rosette Ale\",\"eventsNumber\":50,\"image\":{\"filePath\":\"founders/f10b0004-1fb8-4644-b491-8a1b151699ab/22eed1e1-0a8c-4a35-9a35-c688d692f2cb.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2Ff10b0004-1fb8-4644-b491-8a1b151699ab%2F22eed1e1-0a8c-4a35-9a35-c688d692f2cb.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/2ba4cb1f-5147-40f0-b482-32221c6d90e7/preview/4ecc03b4-1951-401f-a493-c81be660c615.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F2ba4cb1f-5147-40f0-b482-32221c6d90e7%2Fpreview%2F4ecc03b4-1951-401f-a493-c81be660c615.webp\"},{\"filePath\":\"companies/2ba4cb1f-5147-40f0-b482-32221c6d90e7/preview/8fadc3fd-c77d-4a1e-8d50-2cb4889f7b07.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F2ba4cb1f-5147-40f0-b482-32221c6d90e7%2Fpreview%2F8fadc3fd-c77d-4a1e-8d50-2cb4889f7b07.webp\"},{\"filePath\":\"companies/2ba4cb1f-5147-40f0-b482-32221c6d90e7/preview/b1d01d82-9b5b-464c-8c9c-640880050edc.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F2ba4cb1f-5147-40f0-