          "headersSize": 230,
          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"7a18a139-107c-42da-af7f-53e7e9e24cf6\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"The Spoken Room\",\"description\":\"<p><strong>The Spoken Room is a poetry workshop with a live band.</strong><br></p><p>We’ll start the evening with a guided writing session led by our poet facilitator, using prompts to help you slow down, reflect and put your thoughts into words.<br></p><p>Later in the night, anyone who wants to share can perform what they’ve written. Before you begin, you’ll tell the band the feeling or atmosphere you want behind your piece, and they’ll improvise around your words live.<br></p><p>You don’t need to be a poet, you don’t need to have anything prepared, and there’s absolutely no pressure to perform. You can come to write, listen, meet people and simply enjoy the room.<br></p><p>For this edition, we’re bringing The Spoken Room to <strong>Tower Bridge Collective</strong> as part of their program called <strong>Sounds of LDN</strong>.<br></p><p><strong>Sunday 27 September</strong><br><strong>Tower Bridge Collective</strong><br><strong>7PM to 10:30PM</strong><br></p><p>Come with an open mind. We’ll take care of the rest.</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-27T19:00:00.000\",\"endDate\":\"2026-09-27T22:30:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"946ff86f-1250-4fbf-b025-4b8b39d94c00\",\"address\":\"1 Shad Thames, Horselydown Lane, London, UK\",\"locationName\":\"The Tower Bridge Collective\",\"latitude\":51.504017,\"longitude\":-0.075912},\"image\":{\"filePath\":\"events/7a18a139-107c-42da-af7f-53e7e9e24cf6/fbce4640-8341-4110-91e9-0f23a086ccdc/58ae0d03-f8f4-4c1d-9ca4-7e0e420048c5.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F7a18a139-107c-42da-af7f-53e7e9e24cf6%2Ffbce4640-8341-4110-91e9-0f23a086ccdc%2F58ae0d03-f8f4-4c1d-9ca4-7e0e420048c5.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"88a0d45a-8c2f-4c54-8764-addb99d8b621\",\"name\":\"Single Admission\",\"description\":\"• Entry to The Spoken Room\\n• Guided poetry and writing workshop\\n• Writing prompts and exercises\\n• Live band throughout the sharing session\\n• The opportunity to perform your piece with live improvised accompaniment\",\"maxQuantity\":null,\"sold\":24,\"leftSeats\":false,\"startDate\":\"2026-08-31T15:24:00.000\",\"endDate\":\"2026-09-27T19:30:00.000\",\"price\":\"5.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"7a18a139-107c-42da-af7f-53e7e9e24cf6\",\"programId\":null}],\"seats\":60,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":311,\"eventsCount\":55,\"attendeesCount\":1564,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"sonderhaus-cic\",\"bio\":\"A creative London community hosting art nights, cultural experiences, and social events for people who want connection, expression, and good energy.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2025-11-27T11:44:29.092Z\",\"updatedAt\":\"2026-03-30T16:03:04.957Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Peter Ajuchi\",\"eventsNumber\":0,\"image\":{\"filePath\":\"founders/3d6b9af8-5d1c-4c90-9132-c3182ca1ebce/90ea0e8e-ff1f-46ce-a983-2f906896ea07.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F3d6b9af8-5d1c-4c90-9132-c3182ca1ebce%2F90ea0e8e-ff1f-46ce-a983-2f906896ea07.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/cca88a24-0acf-4be9-8b8b-3794ad34d6ca/preview/f7f18a48-b55d-463f-873f-1bd2c3eacc7e.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2Fcca88a24-0acf-4be9-8b8b-3794ad34d6ca%2Fpreview%2Ff7f18a48-b55d-463f-873f-1bd2c3eacc7e.webp\"},{\"filePath\":\"companies/cca88a24-0acf-4be9-8b8b-3794ad34d6ca/preview/c8b8ef2e-38cb-4347-b7db-6ba39ca1a24b.webp\",\"url\":\