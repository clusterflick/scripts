          "headersSize": 230,
          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"75b7a751-c89f-483b-9bc0-3288a9105b11\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"BOAT PARTY | END OF SUMMER - LATINAS SOCIETY\",\"description\":\"<h2>PERREO A BORDO 🚤🔥<br></h2><p>Get ready to have the <strong>ultimate Reggaeton party while taking in some of the best views of London at sunset! 🌅</strong><br></p><p>We can’t wait to have you on our <strong>first-ever boat party on Friday, 25th September</strong> bringing you a full night of <strong>Reggaeton, Dembow &amp; Perreo</strong> with <strong>2 amazing DJs live on board</strong> keeping you dancing from start to finish. 🔥<br></p><p>📍 <strong>Boarding:</strong> 6:30 PM MILLBANK MILLENNIUM PIER <br>🚤 <strong>Boat departs:</strong> 7:00 PM SHARP</p><p>Please make sure you arrive at the location <strong>on time</strong> ..the boat will leave at 7 PM and unfortunately cannot wait for late arrivals.<br></p><p>🔞 <strong>18+ ONLY</strong><br>🪪 <strong>Valid ID is required</strong></p><p>Get your best fit ready and bring your friends!<br></p><p><strong>Nos vemos a bordo!🔥</strong></p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-25T18:30:00.000\",\"endDate\":\"2026-09-25T23:00:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"eb79251d-89f5-4e6b-81da-bed1b09b2cbe\",\"address\":\"Millbank, London SW1P 4QP, UK\",\"locationName\":\"Millbank Millennium Pier\",\"latitude\":51.492747,\"longitude\":-0.1252357},\"image\":{\"filePath\":\"events/75b7a751-c89f-483b-9bc0-3288a9105b11/838d5f8d-288b-4800-83b1-071cc35ddf4a/d4f82b4d-651a-4711-8384-d9c42fb11789.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F75b7a751-c89f-483b-9bc0-3288a9105b11%2F838d5f8d-288b-4800-83b1-071cc35ddf4a%2Fd4f82b4d-651a-4711-8384-d9c42fb11789.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"65b8d006-ce66-42a6-83fa-7a6da6888543\",\"name\":\"Second Release - Pa' Que RetoZen\",\"description\":\"🚤 Access to the boat\\n🔥 4 hours of Reggaeton, Dembow & Perreo\\n🌅 London views & sunset experience\\n🎧 2 DJs live on board\",\"maxQuantity\":30,\"sold\":11,\"leftSeats\":false,\"startDate\":\"2026-09-08T12:30:00.000\",\"endDate\":\"2026-09-19T23:00:00.000\",\"price\":\"23.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"75b7a751-c89f-483b-9bc0-3288a9105b11\",\"programId\":null},{\"id\":\"1d19df52-38d3-4dad-a428-74441adce59a\",\"name\":\"PERREO A BORDO | Early Bird🔥\",\"description\":\"Limited early access tickets..\\n🚤 Access to the boat\\n🔥 4 hours of Reggaeton, Dembow & Perreo\\n🌅 London views & sunset experience\\n🎧 2 DJs live on board\",\"maxQuantity\":15,\"sold\":15,\"leftSeats\":false,\"startDate\":\"2026-08-28T18:20:00.000\",\"endDate\":\"2026-09-01T23:00:00.000\",\"price\":\"18.00\",\"status\":\"sold-out\",\"isPrivate\":false,\"eventId\":\"75b7a751-c89f-483b-9bc0-3288a9105b11\",\"programId\":null},{\"id\":\"507ec347-addb-414f-a391-eec05571ddcf\",\"name\":\" First Release — BICHOTA💃\",\"description\":\"Limited early access tickets..\\n🚤 Access to the boat\\n🔥 4 hours of Reggaeton, Dembow & Perreo\\n🌅 London views & sunset experience\\n🎧 2 DJs live on board\",\"maxQuantity\":32,\"sold\":32,\"leftSeats\":false,\"startDate\":\"2026-09-01T15:30:00.000\",\"endDate\":\"2026-09-08T23:00:00.000\",\"price\":\"20.00\",\"status\":\"sold-out\",\"isPrivate\":false,\"eventId\":\"75b7a751-c89f-483b-9bc0-3288a9105b11\",\"programId\":null}],\"seats\":77,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":101,\"eventsCount\":15,\"attendeesCount\":401,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"latinas-society\",\"bio\":\"Latinas Society is all about empowerment, connection, and celebration. It's a space where Latin women across the UK come together to share experiences, support one another, and grow personally and professionally.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2025-11-18T11:16:24.576Z\",\"updatedAt\":\"2026-04-13T16:59:31.880Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Katya Rivas\",\"eventsNumber\":0,\"image\":null},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[],\"id\":\"028f21c3-5edf-46ad-a63b-43eb3d8b52a0\",\"name\":\"Latinas Society\",\"image\":{\"filePath\":\"companies/028f21c3-5edf-46ad-a63b-43eb3d8b52a0/80174931-e1d4-41bb-b0cb-b928a511fb71.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F028f21c3-5edf-46ad-a63b-43eb3d8b52a0%2F80174931-e1d4-41bb-b0cb-b928a511fb71.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"bancontact_payments\",\"blik_payments\",\"card_payments\",\"eps_payments\",\"klarna_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":58,\"likedCount\":11,\"seatsFriendsOccupied\":0,\"isBought\":false,\"isHideNumberSeats\":true,\"isFromExternal\":false,\"isNotifySalesToggled\":false,\"pods\":[],\"events\":[],\"currency\":\"gbp\",\"timeZone\":\"Europe/London\",\"slug\":\"boat-party-end-of-summer-latinas-society\",\"timeZoneAbbreviation\":\"BST\",\"createdAt\":\"2026-08-28T17:11:01.043Z\",\"accessStatus\":{\"allowedToJoin\":true,\"isFollowRequested\":false,\"isAccessRequested\":false,\"needsFollow\":false,\"needsAccess\":false},\"isWaiverRequired\":false}",
