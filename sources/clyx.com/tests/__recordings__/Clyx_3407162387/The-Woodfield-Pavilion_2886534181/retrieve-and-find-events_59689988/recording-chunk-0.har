            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"b51eb8f2-ab18-4a78-90cd-4dbc578093ef\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"TEXTS I NEVER SENT\",\"description\":\"<p>‘I love you’, ‘how dare you’ ‘I miss you’… these are ‘TEXTS I NEVER SENT’ Second Space is back with another thought provoking theme at GoHub Stuido on Thursday 24th September.<br><br>5 open mic artists chosen at random.<br>5 headliners.<br><br>DOORS AND OPEN MIC SIGN UPS: 6.30pm<br>SHOW STARTS: 7pm.<br><br>You dont wanna miss this one📲</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-24T19:00:00.000\",\"endDate\":\"2026-09-24T21:30:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"33c504c2-9a62-49f9-b3b8-6d6abc0f3208\",\"address\":\"222 Brixton Road, London, UK\",\"locationName\":\"GoHub Studio\",\"latitude\":51.4720993,\"longitude\":-0.1130211},\"image\":{\"filePath\":\"events/b51eb8f2-ab18-4a78-90cd-4dbc578093ef/3147b0dc-4275-4a4f-842f-61e8438aa78a/76f253b6-c217-4787-a65b-a035349498c9.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Fb51eb8f2-ab18-4a78-90cd-4dbc578093ef%2F3147b0dc-4275-4a4f-842f-61e8438aa78a%2F76f253b6-c217-4787-a65b-a035349498c9.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"443dc07f-e8ea-40e8-9dc9-c2f12a49ee16\",\"name\":\"EARLY BIRD TICKETS\",\"description\":\"Early Bird Tickets-grab em quick!\",\"maxQuantity\":null,\"sold\":3,\"leftSeats\":false,\"startDate\":\"2026-07-29T15:26:00.000\",\"endDate\":\"2026-09-19T15:26:00.000\",\"price\":\"13.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"b51eb8f2-ab18-4a78-90cd-4dbc578093ef\",\"programId\":null},{\"id\":\"8af3e33a-82b1-4db1-b9d9-35f58b4bfa65\",\"name\":\"GENERAL RELEASE\",\"description\":\"General Release Tickets\",\"maxQuantity\":null,\"sold\":3,\"leftSeats\":false,\"startDate\":\"2026-07-29T15:27:00.000\",\"endDate\":\"2026-09-24T20:27:00.000\",\"price\":\"16.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"b51eb8f2-ab18-4a78-90cd-4dbc578093ef\",\"programId\":null}],\"seats\":60,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":148,\"eventsCount\":15,\"attendeesCount\":300,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"second-space\",\"bio\":\"Typically we know a first space to be home, a second space to be the work place, and a third space is a community…\\n\\nWhat if we merged all three? \\n\\n‘SECOND SPACE’ is a Spoken Word, Music and Open Mic night hosted monthly at the incredible GoHub Studio in the heart of Brixton. \\nThe best emerging artists in UK come to showcase their work in a space that feels like home. \\nSECOND SPACE: Your second home, and your first community.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-03-14T13:49:21.691Z\",\"updatedAt\":\"2026-03-29T11:33:34.800Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Anna-Margarita\",\"eventsNumber\":1,\"image\":{\"filePath\":\"founders/4a247b64-442c-48fd-a2ba-93889433c320/dd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F4a247b64-442c-48fd-a2ba-93889433c320%2Fdd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/3dd00187-9189-41ef-a605-e382b4006d1f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F3dd00187-9189-41ef-a605-e382b4006d1f.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/74318570-731e-4ab3-ba15-1191ece2e798.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F74318570-731e-4ab3-ba15-1191ece2e798.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5