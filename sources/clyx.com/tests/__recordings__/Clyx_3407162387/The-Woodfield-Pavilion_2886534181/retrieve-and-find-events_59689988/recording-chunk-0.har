            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"07c5590c-3219-4fd6-b535-a1f357684f17\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"DISS TRACKS\",\"description\":\"<p>What are the greatest Diss Tracks of all time? Kendrick's 'Not Like Us'? Chip's 'Coward'? You're about to hear some original diss tracks from the best emerging poets, rappers, singers and spoken word artists live at Second Space.<br><br>5 phenomenal headline artists- including the previous months open mic winner!<br><br>5 Open Mic performances picked at random on the night!<br><br>Music all night from the formidable, fire, flames soundsbyshaq on the decks. <br><br>See you there, you don't want to miss this one!</p>\",\"salesStartDate\":null,\"startDate\":\"2026-10-15T19:00:00.000\",\"endDate\":\"2026-10-15T21:30:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"27b38f7e-c1cd-4bdf-a971-e4c3ac0e788a\",\"address\":\"222 Brixton Road, London SW9 6AH, UK\",\"locationName\":\"GoHub Studio\",\"latitude\":51.4720993,\"longitude\":-0.1130211},\"image\":{\"filePath\":\"events/07c5590c-3219-4fd6-b535-a1f357684f17/217667c8-c37c-4293-8bce-ff712b0a3047/c4a80d54-ca2c-4504-8051-8a149e27d1cc.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F07c5590c-3219-4fd6-b535-a1f357684f17%2F217667c8-c37c-4293-8bce-ff712b0a3047%2Fc4a80d54-ca2c-4504-8051-8a149e27d1cc.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"b17d52ad-2d6c-460b-9fc2-d2d9e4527b09\",\"name\":\"EARLY BIRD\",\"description\":\"Early Bird Tickets\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-10-01T12:30:00.000\",\"price\":\"12.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"07c5590c-3219-4fd6-b535-a1f357684f17\",\"programId\":null},{\"id\":\"45cb1cf3-04cd-4078-8e25-e45d6ba1b128\",\"name\":\"GENERAL RELEASE\",\"description\":\"General Release tickets\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-10-15T19:30:00.000\",\"price\":\"16.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"07c5590c-3219-4fd6-b535-a1f357684f17\",\"programId\":null}],\"seats\":null,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":148,\"eventsCount\":15,\"attendeesCount\":300,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"second-space\",\"bio\":\"Typically we know a first space to be home, a second space to be the work place, and a third space is a community…\\n\\nWhat if we merged all three? \\n\\n‘SECOND SPACE’ is a Spoken Word, Music and Open Mic night hosted monthly at the incredible GoHub Studio in the heart of Brixton. \\nThe best emerging artists in UK come to showcase their work in a space that feels like home. \\nSECOND SPACE: Your second home, and your first community.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-03-14T13:49:21.691Z\",\"updatedAt\":\"2026-03-29T11:33:34.800Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Anna-Margarita\",\"eventsNumber\":1,\"image\":{\"filePath\":\"founders/4a247b64-442c-48fd-a2ba-93889433c320/dd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F4a247b64-442c-48fd-a2ba-93889433c320%2Fdd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/3dd00187-9189-41ef-a605-e382b4006d1f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F3dd00187-9189-41ef-a605-e382b4006d1f.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/74318570-731e-4ab3-ba15-1191ece2e798.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F74318570-731e-4ab3-ba15-1191ece2e798.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/8a433cbf-3235-4234-9ff6-3ead313ebfa7.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F8a433cbf-3235-4234-9ff6-3ead313ebfa7.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/1a42109c-0bc4-4a95-ac97-aa464e94580b.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F1a42109c-0bc4-4a95-ac97-aa464e94580b.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/ae33f918-7668-4c54-a39f-0d973a65ce81.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2Fae33f918-7668-4c54-a39f-0d973a65ce81.webp\"}],\"id\":\"886d7532-bffe-46d7-bd85-79cebf5ff82b\",\"name\":\"SECOND SPACE.\",\"image\":{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/5db93e84-59e9-4e6f-a52b-b6904d1e6178.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2F5db93e84-59e9-4e6f-a52b-b6904d1e6178.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"bancontact_payments\",\"blik_payments\",\"card_payments\",\"eps_payments\",\"klarna_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":0,\"likedCount\":0,\"seatsFriendsOccupied\":0,\"isBought\":false,\"isHideNumberSeats\":true,\"isFromExternal\":false,\"isNotifySalesToggled\":false,\"pods\":[],\"events\":[],\"currency\":\"gbp\",\"timeZone\":\"Europe/London\",\"slug\":\"diss-tracks\",\"timeZoneAbbreviation\":\"BST\"