          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"f68612a3-224f-4ddb-8eb5-d03b2d3b723c\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Karaoke Night | Latinas Society\",\"description\":\"<p>Welcome to our <strong>Karaoke Night &amp; Room del desamoor </strong>with Latinas Society! 🎤❤️‍🔥<br></p><p>Get ready for <strong>2.5 hours of karaoke</strong> in a luxury karaoke space in the heart of Soho, where you can sing your heart out, embrace your despecho y cantar de TODOOO!<br></p><p>And we’re not stopping there… 👀<br></p><p>After karaoke, we’re taking the party into the night with an <strong>after-party until midnight</strong>.</p><p><br>🔞 <strong>18+ EVENT — PHYSICAL ID REQUIRED FOR ENTRY.</strong></p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-17T19:00:00.000\",\"endDate\":\"2026-09-18T00:00:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"8d6e8c3c-f878-4c8c-a33e-29d1d49d404c\",\"address\":\"47 Whitcomb St., London WC2H 7DH, UK\",\"locationName\":\"U9 Karaoke & Cocktail Bar\",\"latitude\":51.5098725,\"longitude\":-0.1314789},\"image\":{\"filePath\":\"events/e1779285-f44c-40a6-b116-317c43b686e4/0345cf14-05f9-49a0-a9ea-911f0a962ea6/d0ca5b2e-4e52-4fe4-945b-a4c47da08877.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Fe1779285-f44c-40a6-b116-317c43b686e4%2F0345cf14-05f9-49a0-a9ea-911f0a962ea6%2Fd0ca5b2e-4e52-4fe4-945b-a4c47da08877.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"6e0777c8-ab4c-4755-b358-5a03dd323c12\",\"name\":\"🎤  KARAOKE GIRLS ONLY + AFTER PARTY\",\"description\":\"Your ticket includes:\\n\\n🎤 2 hours & 45 minutes of karaoke  7:00 PM–9:45 PM (we can stay until later)\\n🥨 Snacks included\\n🥃 Tequila shot included\\n❤️‍🔥 Full access to the Karaoke Night \\n\",\"maxQuantity\":null,\"sold\":17,\"leftSeats\":false,\"startDate\":\"2026-09-03T17:30:00.000\",\"endDate\":\"2026-09-17T19:00:00.000\",\"price\":\"20.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"f68612a3-224f-4ddb-8eb5-d03b2d3b723c\",\"programId\":null}],\"seats\":100,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":101,\"eventsCount\":15,\"attendeesCount\":401,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"latinas-society\",\"bio\":\"Latinas Society is all about empowerment, connection, and celebration. It's a space where Latin women across the UK come together to share experiences, support one another, and grow personally and professionally.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2025-11-18T11:16:24.576Z\",\"updatedAt\":\"2026-04-13T16:59:31.880Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Katya Rivas\",\"eventsNumber\":0,\"image\":null},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[],\"id\":\"028f21c3-5edf-46ad-a63b-43eb3d8b52a0\",\"name\":\"Latinas Society\",\"image\":{\"filePath\":\"companies/028f21c3-5edf-46ad-a63b-43eb3d8b52a0/80174931-e1d4-41bb-b0cb-b928a511fb71.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F028f21c3-5edf-46ad-a63b-43eb3d8b52a0%2F80174931-e1d4-41bb-b0cb-b928a511fb71.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"bancontact_payments\",\"blik_payments\",\"card_payments\",\"eps_payments\",\"klarna_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":17,\"likedCount\":2,\"seatsFriendsOccupied\":0,\"isBought\":false,\"isHideNumberSeats\":true,\"isFromExternal\":false,\"isNotifySalesToggled\":false,\"pods\":[],\"events\":[],\"currency\":\"gbp\",\"timeZone\":\"Europe/London\",\"slug\":\"karaoke-night-latinas-society\",\"timeZoneAbbreviation\":\"BST\",\"createdAt\":\"2026-09-03T16:46:40.192Z\",\"acces