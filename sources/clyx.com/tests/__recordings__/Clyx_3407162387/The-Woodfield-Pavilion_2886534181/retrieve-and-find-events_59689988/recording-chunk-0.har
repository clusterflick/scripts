          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"25cc0603-2fcd-4057-9adc-3594e119d429\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"'I LOVE YOU...BUT'\",\"description\":\"<p>Best words in the English language are 'I LOVE YOU' right?? What if 'but' followed those words? Kinda painful innit? Lets explore that together with poetry, spoken word, and sensational vibes as always!!<br><br>5 phenomenal headline artists- including the previous months open mic winner!<br><br>5 Open Mic performances picked at random on the night!<br><br>Music all night from the formidable, fire, flames soundsbyshaq on the decks.<br><br> See you there, you don't want to miss this one!</p><p><br></p>\",\"salesStartDate\":null,\"startDate\":\"2026-11-19T19:00:00.000\",\"endDate\":\"2026-11-19T21:30:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"2b4373bd-ff20-4db8-a4fe-5dc18e974912\",\"address\":\"222 Brixton Road, London, UK\",\"locationName\":\"GoHub Studio\",\"latitude\":51.4720993,\"longitude\":-0.1130211},\"image\":{\"filePath\":\"events/25cc0603-2fcd-4057-9adc-3594e119d429/76489111-410f-4ff1-8018-c91afeffc102/0131dcd0-370f-4bd7-a560-85330982f47e.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F25cc0603-2fcd-4057-9adc-3594e119d429%2F76489111-410f-4ff1-8018-c91afeffc102%2F0131dcd0-370f-4bd7-a560-85330982f47e.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"d51023d4-0f05-4ff4-a905-9152658f95a9\",\"name\":\"EARLY BIRD\",\"description\":\"Early Bird Tickets\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-10-30T12:30:00.000\",\"price\":\"12.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"25cc0603-2fcd-4057-9adc-3594e119d429\",\"programId\":null},{\"id\":\"f998be80-86f5-4d85-8bbe-701eac16c1c4\",\"name\":\"GENERAL RELEASE \",\"description\":\"General Release Tickets\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-11-19T19:30:00.000\",\"price\":\"16.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"25cc0603-2fcd-4057-9adc-3594e119d429\",\"programId\":null}],\"seats\":null,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":148,\"eventsCount\":15,\"attendeesCount\":300,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"second-space\",\"bio\":\"Typically we know a first space to be home, a second space to be the work place, and a third space is a community…\\n\\nWhat if we merged all three? \\n\\n‘SECOND SPACE’ is a Spoken Word, Music and Open Mic night hosted monthly at the incredible GoHub Studio in the heart of Brixton. \\nThe best emerging artists in UK come to showcase their work in a space that feels like home. \\nSECOND SPACE: Your second home, and your first community.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-03-14T13:49:21.691Z\",\"updatedAt\":\"2026-03-29T11:33:34.800Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Anna-Margarita\",\"eventsNumber\":1,\"image\":{\"filePath\":\"founders/4a247b64-442c-48fd-a2ba-93889433c320/dd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F4a247b64-442c-48fd-a2ba-93889433c320%2Fdd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/3dd00187-9189-41ef-a605-e382b4006d1f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F3dd00187-9189-41ef-a605-e382b4006d1f.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/74318570-731e-4ab3-ba15-1191ece2e798.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d753