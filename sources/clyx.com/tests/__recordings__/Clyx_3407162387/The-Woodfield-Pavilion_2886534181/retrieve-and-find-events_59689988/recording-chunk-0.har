          "headersSize": 229,
          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"ec03ce1c-b484-4fb4-8471-ef21e4459d0c\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Meet Us Outside x Gravitate\",\"description\":\"<p><strong>Event 004 — A Walk to Balance</strong><br><br><em>Meet Us Outside x Gravitate</em><br></p><p>The equinox is the one day the light and the dark hold each other in perfect balance - the sun sits directly over the equator, and day and night land almost exactly even. For Event 004, we're marking that turning point the way we know how: on our feet, outside, making something with our hands along the way.<br></p><p>We're teaming up with our friends at Gravitate for a one-day hike and creative session out at Box Hill &amp; Westhumble in the Surrey Hills. Meet at Victoria Station at 9:15am, train out together, walk, take some time to land with our breath, guided by Natalia and pause for a creative workshop along the trail, before heading back into London by 3:30pm.<br><br>We'll be pressing and printing with whatever the land offers us that day, so what you take home is made from the exact spot and season it was picked in. <br></p><p><strong>When:</strong> Sunday 20 September 2026, 9:15am – 3:30pm <br><strong>Meet:</strong> Victoria Station<br><strong>Where:</strong> Box Hill &amp; Westhumble (open return train from Victoria) <br><strong>Includes:</strong> Guided hike, breathwork + a creative flower printing workshop <br><br></p><p>Come ready to walk, get artsy and get outside. Comfy shoes you don't mind getting muddy, layers + a waterproof just in case, water bottle, snacks and lunch for the hike, small backpack.</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-20T09:15:00.000\",\"endDate\":\"2026-09-20T15:30:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"8bf3de27-7f41-42bc-a9af-3535cb5c5716\",\"address\":\"Victoria Railway Station, Buckingham Palace Road, London, UK\",\"locationName\":\"Box Hill & Westhumble\",\"latitude\":51.4942095,\"longitude\":-0.1467259},\"image\":{\"filePath\":\"events/ec03ce1c-b484-4fb4-8471-ef21e4459d0c/9aa0b1a1-763b-46e6-810a-374241246241/e44f02b5-19d9-4fbc-94b8-a331016a0410.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Fec03ce1c-b484-4fb4-8471-ef21e4459d0c%2F9aa0b1a1-763b-46e6-810a-374241246241%2Fe44f02b5-19d9-4fbc-94b8-a331016a0410.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"856d9272-9f2b-4168-a378-120fcc949b4c\",\"name\":\"Guided Hike, Breathwork & Art workshop\",\"description\":\"Your ticket includes a full-day guided 8km hike in Box Hill & Westhumble, some time to land with guided breathwork along the way and a creative art nature inspired workshop on the trail (materials included).\",\"maxQuantity\":10,\"sold\":6,\"leftSeats\":false,\"startDate\":\"2026-09-08T18:00:00.000\",\"endDate\":\"2026-09-18T12:00:00.000\",\"price\":\"10.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"ec03ce1c-b484-4fb4-8471-ef21e4459d0c\",\"programId\":null}],\"seats\":10,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":13,\"eventsCount\":4,\"attendeesCount\":30,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"meet-us-outside\",\"bio\":\"We're Meet Us Outside - a London community that gets people moving, breathing, and pausing outdoors. Our events blend walks, breathwork, and fun with real time to be present and connect with others. Whether you're new to this or been doing it for years, come as you are. \",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-07-24T11:17:56.489Z\",\"updatedAt\":\"2026-07-24T12:08:37.487Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Natalia + Carmen\",\"eventsNumber\":2,\"image\":{\"filePath\":\"founders/8092388c-b32e-4c41-8bcc-931f5f15c35b/60b186b7-f767-43fc-8526-38d74d7177fb.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F8092388c-b32e-4c41-8bcc-931f5f15c35b%2F60b186b7-f767-43fc-8526-38d74d7177fb.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/1b2dd525-5bd8-4270-92a2-9c5adaf2fbba/preview/e7edda91-6207-4e68-9951-a5845e6383ea.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1b2dd525-5bd8-4270-92a2-9c5adaf2fbba%2Fpreview%2Fe7edda91-6207-4e68-9951-a5845e6383ea.webp\"},{\"filePath\":\"companies/1b2dd525-5bd8-4270-92a2-9c5adaf2fbba/preview/967ee4bf-a45e-443b-acc1-ecf65028e60b.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1b2dd525-5bd8-4270-92a2-9c5adaf2fbba%2Fpreview%2F967ee4bf-a45e-443b-acc1-ecf65028e60b.webp\"},{\"filePath\":\"companies/1b2dd525-5bd8-4270-92a2-9c5adaf2fbba/preview/b566068a-dba9-467d-afb7-b637a46596f6.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1b2dd525-5bd8-4270-92a2-9c5adaf2fbba%2Fpreview%2Fb566068a-dba9-467d-afb7-b637a46596f6.webp\"},{\"filePath\":\"companies/1b2dd525-5bd8-4270-92a2-9c5adaf2fbba/preview/2c41cc7d-983d-4c96-b4b9-d5f1056e03d2.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1b2dd525-5bd8-4270-92a2-9c5adaf2fbba%2Fpreview%2F2c41cc7d-983d-4c96-b4b9-d5f1056e03d2.webp\"}],\"id\":\"1b2dd525-5bd8-4270-92a2-9c5adaf2fbba\",\"name\":\"Meet Us Outside\",\"image\":{\"filePath\":\"companies/1b2dd525-5bd8-4270-92a2-9c5adaf2fbba/2a776293-53fa-45b8-bf81-6ce399ab5d44.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1b2dd525-5bd8-4270-92a2-9c5adaf2fbba%2F2a776293-53fa-45b8-bf81-6ce399ab5d44.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"blik_payments\",\"card_payments\",\"eps_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"sea