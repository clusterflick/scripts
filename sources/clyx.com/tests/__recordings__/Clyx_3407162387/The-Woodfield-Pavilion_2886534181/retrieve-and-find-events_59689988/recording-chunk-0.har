          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"bcfda108-16d3-460d-bffe-a0caaed2823b\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Raqueta y Reggaeton: East London\",\"description\":\"<p>Raqueta comes back to East London!</p><p><br>Join us for our second event at the iconic Lee Valley Hockey &amp; Tennis Centre, where we will have our tennis, reggaeton and great vibes as always!</p><p><br>📅 Sunday September 27th</p><p>🕓 4:15PM – 5:45PM Tennis at Lee Valley (E20 3AD)</p><p>🕕 6:15PM - 10PM Social at Lord Napier Star (E9 5ER)</p><p><br>70 SPOTS AVAILABLE</p><p>🎶 Reggaeton vibes while you play</p><p>🎾 Social + high-energy tennis</p><p>🎾 Tennis drills + games led by coaches</p><p>🍻 Post-tennis social 6:15pm – 10pm at The Lord Napier Star (20 min walk away) where we will have our own bar rented for the social with more reggaeton!</p><p>🥳 All equipment provided!</p><p>🍊 Water and light snacks provided</p><p>🤝 All levels welcome</p><p><br>Important: no refunds unless the event is cancelled</p><p><br>We can’t wait to see you all back in East London 💚💚</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-27T16:15:00.000\",\"endDate\":\"2026-09-27T22:00:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"aed24d2f-74f0-4400-b3e1-3e7e81b8d7e0\",\"address\":\"Leadmill Lane, London, UK\",\"locationName\":\"Lee valley hockey and tennis centre \",\"latitude\":51.5543254,\"longitude\":-0.0162437},\"image\":{\"filePath\":\"events/bcfda108-16d3-460d-bffe-a0caaed2823b/78d9324d-bf11-414c-8177-79dd3942f6ab/a03edb67-07ec-40f0-a187-7e0bd8cb3d1c.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Fbcfda108-16d3-460d-bffe-a0caaed2823b%2F78d9324d-bf11-414c-8177-79dd3942f6ab%2Fa03edb67-07ec-40f0-a187-7e0bd8cb3d1c.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"d5fa27b6-6d1e-4a12-9432-ec89bb252fb3\",\"name\":\"Final release \",\"description\":\"\",\"maxQuantity\":52,\"sold\":0,\"leftSeats\":false,