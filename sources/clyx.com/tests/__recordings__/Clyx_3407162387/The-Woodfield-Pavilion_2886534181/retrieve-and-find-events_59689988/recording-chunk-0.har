            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"f2963417-dc91-49fe-bf48-3dfefb29a21d\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"September Film Club 2 - Resident Evil \",\"description\":\"<p><strong>Resident Evil is finally hitting cinemas! This September 19th we will be heading over to the cinema and watching it at film club. We'll have your snacks, drinks, games, pub quiz, prizes and posters... All you have to do is bring yourself!<br><br>Whether you're a fan of the games or love Zach Cregger, we promise you a great day out! SO here's to hoping we see you at the cinema!</strong></p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-19T15:00:00.000\",\"endDate\":\"2026-09-19T22:30:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"3de632ed-592c-44bc-aad0-33d28b253599\",\"address\":\"Leicester Square, London, UK\",\"locationName\":\"Vue West End \",\"latitude\":51.5105486,\"longitude\":-0.130845},\"image\":{\"filePath\":\"events/f2963417-dc91-49fe-bf48-3dfefb29a21d/5db2b236-2d9b-4e25-a91d-355e7b0b6ce3/4c2fbe0f-358e-455b-b061-12bbe4f71d7d.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2Ff2963417-dc91-49fe-bf48-3dfefb29a21d%2F5db2b236-2d9b-4e25-a91d-355e7b0b6ce3%2F4c2fbe0f-358e-455b-b061-12bbe4f71d7d.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"b43510e7-6948-450b-857d-cd05a14d685c\",\"name\":\"Social Ticket Only \",\"description\":\"Social Ticket, Snacks, Alcoholic Drink + Soft Drinks, Games, Pub Quiz, Prizes + Posters \",\"maxQuantity\":null,\"sold\":2,\"leftSeats\":false,\"startDate\":\"2026-08-30T20:05:00.000\",\"endDate\":\"2026-09-19T15:00:00.000\",\"price\":\"14.50\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"f2963417-dc91-49fe-bf48-3dfefb29a21d\",\"programId\":null},{\"id\":\"6f9c999d-ace3-4a35-8b33-7bf469a017f6\",\"name\":\"General Admission \",\"description\":\"Cinema Ticket, Social Ticket, Snacks, Soft Drinks, Games, Pub Quiz, Prizes + P