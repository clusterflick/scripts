            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"193cda9e-8e08-4885-a218-2604c8635b86\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"RTG MIDWEEK SOCIAL\",\"description\":\"<p><strong>Midweek social with organised games, great energy, and a welcoming atmosphere.<br><br>FAQS<br><br>How do the sessions run?<br>We would start with an ice breaker. Each court is organised by skill level; Beginners (20 minutes of coaching plus social play), intermediate (7 minutes games with rotations), Advanced (First to 7 points, the winners stay on for 2 games)<br><br>Can I come alone? Definitely!, we are a friendly and welcoming community at RTG and solo players are always to join<br><br>Is parking available? Yes, there is fe parking on site and the venue is easily accessible via public transport </strong><br><br><strong>Refund Policy We are unable to offer refunds within 48 hours of the event</strong></p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-23T19:30:00.000\",\"endDate\":\"2026-09-23T21:30:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"8970073c-e324-4a9d-8cda-bf9206985121\",\"address\":\"1 Triumph Road, London E6 5LW, UK\",\"locationName\":\"Rocket Padel Beckton\",\"latitude\":51.5137624,\"longitude\":0.0560228},\"image\":{\"filePath\":\"events/193cda9e-8e08-4885-a218-2604c8635b86/9ad0c851-65fe-44ad-9304-b464021e5338/9603ae5f-33b1-4f85-b1f3-4f2d2988b78f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F193cda9e-8e08-4885-a218-2604c8635b86%2F9ad0c851-65fe-44ad-9304-b464021e5338%2F9603ae5f-33b1-4f85-b1f3-4f2d2988b78f.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"18303593-f797-464e-9fa4-729f8657b378\",\"name\":\"GENERAL ADMISSION\",\"description\":\"GENERAL ADMISSION\",\"maxQuantity\":null,\"sold\":5,\"leftSeats\":false,\"startDate\":\"2026-09-09T18:00:00.000\",\"endDate\":\"2026-09-23T21:30:00.000\",\"price\":\"20.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"193cda9e-8e08-4885-a218-2604c8635b86\",\"programId\":null}],\"seats\":25,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":40,\"eventsCount\":29,\"attendeesCount\":211,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"rtg-padel\",\"bio\":\"RTG Padel is a London-based padel community hosting socials, events and private hires 🎾. We bring people together through sport, good vibes ✨ and competitive games for all levels 💪.\\n\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-04-10T08:57:59.499Z\",\"updatedAt\":\"2026-04-24T11:59:08.144Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"RTG PADEL\",\"eventsNumber\":19,\"image\":{\"filePath\":\"founders/e5032f6b-c98f-43ce-8279-5b72b3f86ef2/9b7a1f45-1710-44e5-ac01-0fb3d6c3a2f2.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2Fe5032f6b-c98f-43ce-8279-5b72b3f86ef2%2F9b7a1f45-1710-44e5-ac01-0fb3d6c3a2f2.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/7a2ef793-fa85-4a8e-8aa7-30df20695bc5/preview/bc1a3d57-16ac-45b8-b03d-0daca6bb70d0.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F7a2ef793-fa85-4a8e-8aa7-30df20695bc5%2Fpreview%2Fbc1a3d57-16ac-45b8-b03d-0daca6bb70d0.webp\"},{\"filePath\":\"companies/7a2ef793-fa85-4a8e-8aa7-30df20695bc5/preview/714a6cd1-1a45-4bf3-a18b-043863d88c79.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F7a2ef793-fa85-4a8e-8aa7-30df20695bc5%2Fpreview%2F714a6cd1-1a45-4bf3-a18b-043863d88c79.webp\"},{\"filePath\":\"companies/7a2ef793-fa85-4a8e-8aa7-30df20695bc5/preview/95f5c2bf-750c-4dcc-9e39-2df9eec06f24.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F7a2ef793-fa85-4a8e-8aa7-30df20695bc5%2Fpreview%2F95f5c2bf-750c-4dcc-9e39-2df9eec06f24.webp\"}],\"id\":\"7a2ef793-fa85-4a8e-8aa7-30df20695bc5\",\