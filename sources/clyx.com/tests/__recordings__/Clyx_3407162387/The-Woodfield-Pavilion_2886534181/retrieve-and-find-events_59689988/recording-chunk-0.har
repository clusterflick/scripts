          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"5fbcf004-ba37-472e-870a-1a6c492674b4\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"London's Biggest Warehouse Art Exhibition Party \",\"description\":\"<p><u>The Interactive Warehouse Exhibition Party You Weren’t Supposed to Know About</u><br><br>Paint on walls with a professional artist, live RnB music, drinks, a limited edition fashion collection &amp; a room full of creative professionals .<br><br><br><u>What do you get? </u><br><strong><br></strong></p><ul><li><p><strong><u>Live Interactive Art</u>:</strong> Lisbon-based multidisciplinary artist André Drean Lopes brings his signature blue-and-white <em>azulejo</em>-inspired palette to life through live art and artisanal fashion design.</p></li></ul><p><br><br></p><ul><li><p><strong><u>Live R&amp;B</u>:</strong> Atmospheric live music builds in energy throughout the night, transitioning lighting and ambient sounds as the live performance unfolds.</p></li></ul><p></p><p><br></p><ul><li><p><strong><u>Experimental Food Menu</u>:</strong> Taste an interactive concept menu that challenges traditional dining formats, using food as a medium to complement the artwork.</p></li></ul><p><br></p><p></p><ul><li><p><strong><u>Exclusive Fashion Drop</u>:</strong> Browse and purchase limited-edition collaborative apparel and small accessories created with clothing brand Custard Shop.</p></li></ul><p><br></p><p></p><ul><li><p><strong><u>Creative Networking</u>:</strong> Connect, collaborate, and share ideas with fellow creative professionals, artists, and founders across food, music, dance, photography, fashion, and art.</p></li></ul><p><br></p><p><br></p><p><strong><u>Event Details</u></strong><br><br><br><strong><u>Where:</u></strong> Candid Arts Centre, 3 Torrens St, London EC1V 1NQ</p><p><strong><u>When:</u></strong> 19th of September 2026 <br>6:30pm - 11:00pm<br><br><br>Please note we have a no-refund policy. All ticket sales are final and non-refundable, except where a refund is required by applicable law or where the event is cancelled by Sixth Space.</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-19T18:30:00.000\",\"endDate\":\"2026-09-19T23:00:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"eaa2c519-8692-4017-99c2-732ade6e060d\",\"address\":\"3 Torrens St, London EC1V 1NQ, UK\",\"locationName\":\"Candid Arts Trust\",\"latitude\":51.5323505,\"longitude\":-0.1052823},\"image\":{\"filePath\":\"events/88643b27-2e9f-4364-b1c4-619f946c2162/3378753f-533a-4b24-8811-ed3ab2d8db68/a600ac3f-a47e-402c-b712-13df488e52b2.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F88643b27-2e9f-4364-b1c4-619f946c2162%2F3378753f-533a-4b24-8811-ed3ab2d8db68%2Fa600ac3f-a47e-402c-b712-13df488e52b2.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"6c5b8210-e7f3-4777-8d62-06b886a8df87\",\"name\":\"General Release \",\"description\":\"Your ticket includes a welcome glass of champagne, a curated experimental food menu, a boiler suit to let you get messy with the paint supplies to draw/paint/write on the gallery walls, access to live R&B performances, and live custom screen-printing.\",\"maxQuantity\":null,\"sold\":85,\"leftSeats\":false,\"startDate\":\"2026-08-28T08:35:00.000\",\"endDate\":\"2026-09-19T11:00:00.000\",\"price\":\"22.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"5fbcf004-ba37-472e-870a-1a6c492674b4\",\"programId\":null}],\"seats\":140,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":8,\"eventsCount\":2,\"attendeesCount\":102,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"sixth-space\",\"bio\":\"We are a curated events space supporting creatives, bringing back human connection through community. Where creatives can come together and share ideas, create discussions and learn from each other. \\n\\nSixth Space is what it means to be part of a collective, bringing together the six forms of creativity: Food, music, art, dance, fashion & photography.\\n\\nSix expressions of creativity, one community.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-06-24T13:17:15.914Z\",\"updatedAt\":\"2026-06-24T13:21:46.252Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Emily Tedder\",\"eventsNumber\":1,\"image\":{\"filePath\":\"founders/08bf8978-db16-480d-b6db-2c1768271cd1/054e32f8-7a7e-4b4b-8166-22355d0bd122.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F08bf8978-db16-480d-b6db-2c1768271cd1%2F054e32f8-7a7e-4b4b-8166-22355d0bd122.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[],\"id\":\"f9a0f954-e345-45ac-aa8c-6323885a213b\",\"name\":\"Sixth Space\",\"image\":{\"filePath\":\"companies/f9a0f954-e345-45ac-aa8c-6323885a213b/d24eccc7-071b-4914-b13b-bbc916f33b21.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2Ff9a0f954-e345-45ac-aa8c-6323885a213b%2Fd24eccc7-071b-4914-b13b-bbc916f33b21.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"blik_payments\",\"card_payments\",\"eps_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":125,\"likedCount\":23,\"seatsFriendsOccupied\":0,\"isBought\":false,\"isHideNumberSeats\":true,\"isFromExternal\":false,\"isNotifySalesToggled\":false,\"pods\":[],\"events\":[],\"currency\":\"gbp\",\"timeZone\":\"Europe/London\",\"slug\":\"london-s-biggest-warehouse-art-exhibition-party\",\"timeZoneAbbreviation\":\"BST\",\"createdAt\":\"2026-08-16T09:26:13.198Z\",\"accessStatus\":{\"allowedToJoin\":true,\"isFollowRequested\":false,\"isAccessRequested\":false,\"needsFollow\":false,\"needsAccess\":false},\"isWaiverRequired\":false}",
