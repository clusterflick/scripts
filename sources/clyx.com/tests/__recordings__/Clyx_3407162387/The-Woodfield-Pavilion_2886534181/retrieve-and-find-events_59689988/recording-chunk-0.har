          ],
          "headersSize": 229,
          "cookies": [],
          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"01af992d-6390-40c5-a3f7-56a612d73028\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Cooking on Decks x Mama Ky's Caribbean Soulfood\",\"description\":\"<p><strong>Cooking on Decks is back.</strong><br></p><p>A laid-back Saturday built around music, food, and community.</p><p>DJs playing full sets from the kitchen, good energy in the room, and space to actually enjoy being present.<br></p><p>Expect a slow afternoon with DJs soundtracking the day, food flowing from <strong>Mama Ky’s</strong>, conversations happening naturally, and no pressure to rush anywhere. Come through to eat, listen, catch up with friends, or just sit back and take it in.<br></p><p>Whether you’ve been before or it’s your first time, Cooking on Decks is about creating an easy, welcoming space where everything feels intentional but never forced.<br></p><p><strong>Good music, good food, good people.</strong><br></p><p>Celebrating something? Whether it’s a birthday, leaving drinks, a reunion, or any special occasion, feel free to get in touch and we’ll see how we can make it part of the day.</p>\",\"salesStartDate\":null,\"startDate\":\"2026-10-03T12:00:00.000\",\"endDate\":\"2026-10-03T17:00:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"4bb1cc8e-a007-4291-b603-3e2433c6144e\",\"address\":\"72 Rivington St, London EC2A 3AY, United Kingdom\",\"locationName\":\"Bread and Butter Lounge\",\"latitude\":51.5261287,\"longitude\":-0.0792793},\"image\":{\"filePath\":\"events/01af992d-6390-40c5-a3f7-56a612d73028/7f2ba641-f1f2-42ae-9d93-b53a6dc552e4/34b092ea-5e96-406d-b2ce-efad27976de7.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F01af992d-6390-40c5-a3f7-56a612d73028%2F7f2ba641-f1f2-42ae-9d93-b53a6dc552e4%2F34b092ea-5e96-406d-b2ce-efad27976de7.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"de435b56-19f4-4bf9-a9f3-1f003a331986\",\"name\":\"Early bird\",\"description\":\"Entry to Cooking on Decks + £5 off drinks before 2PM.\\n\\nFood and drinks are purchased separately on the day.\\n\\nCooking on Decks is filmed and shared on YouTube and social platforms as part of the ongoing Sonderhaus series.\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-14T06:40:00.000\",\"endDate\":\"2026-10-02T14:00:00.000\",\"price\":\"10.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"01af992d-6390-40c5-a3f7-56a612d73028\",\"programId\":null},{\"id\":\"71172ad9-d766-4da0-8d74-51ae09992e33\",\"name\":\"General entry\",\"description\":\"Entry to Cooking on Decks + £5 off drinks before 2PM.\\n\\nFood and drinks are purchased separately on the day.\\n\\nCooking on Decks is filmed and shared on YouTube and social platforms as part of the ongoing Sonderhaus series.\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-14T06:40:00.000\",\"endDate\":\"2026-10-02T14:00:00.000\",\"price\":\"15.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"01af992d-6390-40c5-a3f7-56a612d73028\",\"programId\":null}],\"seats\":65,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":311,\"eventsCount\":55,\"attendeesCount\":1564,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"sonderhaus-cic\",\"bio\":\"A creative London community hosting art nights, cultural experiences, and social events for people who want connection, expression, and good energy.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2025-11-27T11:44:29.092Z\",\"updatedAt\":\"2026-03-30T16:03:04.957Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Peter Ajuchi\",\"eventsNumber\":0,\"image\":{\"filePath\":\"founders/3d6b9af8-5d1c-4c90-9132-c3182ca1ebce/90ea0e8e-ff1f-46ce-a983-2f906896ea07.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F3d6b9af8-5d1c-4c90-9132-c3182ca1ebce%2F90ea0e