          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"7957c209-9c54-4c64-8126-aed1cae3b30f\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"CHBC Weekly Session 24/09\",\"description\":\"<p>Come along to our weekly badminton session for a fun, friendly game and a chance to get active. Whether you're a complete beginner or you've been playing for years, everyone is welcome. It's all about enjoying the game, meeting new people, and having a good time.<br></p><p>Don't forget to bring a bottle of water, and if you have your own badminton racket, bring it along. If not, we've got rackets you can borrow.<br></p><p><strong>Playing till the shuttle drops...</strong><br></p><p><em>DISCLAIMER</em></p><p><u>The venue is a NUT-FREE zone, please could you NOT bring nuts or nut-based products into the venue in any form.</u><br></p><p>All our links: <a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" class=\\\"editor-link\\\" href=\\\"https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&amp;ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc\\\"><u>https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&amp;ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc</u></a></p>\",\"salesStartDate\":\"2026-09-18T11:00:00.000Z\",\"startDate\":\"2026-09-24T18:30:00.000\",\"endDate\":\"2026-09-24T20:30:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"f6bde80a-616b-40e7-923f-16fdc5b20a6b\",\"address\":\"Lambs Lane South, Rainham, UK\",\"locationName\":\"Harris Academy Rainham\",\"latitude\":51.5165879,\"longitude\":0.206678},\"image\":{\"filePath\":\"events/7957c209-9c54-4c64-8126-aed1cae3b30f/c3415d59-c097-42d7-9d9c-dd34ea4d2752/587c391d-52ba-4a77-951c-b3eb355c87b6.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F7957c209-9c54-4c64-8126-aed1cae3b30f%2Fc3415d59-c097-42d7-9d9c-dd34ea4d2752%2F587c391d-52ba-4a77-951c-b3eb355c87b6.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"7084df31-cae8-4d40-9e16-b33f86d9ed4a\",\"name\":\"Admission\",\"description\":\"\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-18T12:00:00.000\",\"endDate\":\"2026-09-24T19:30:00.000\",\"price\":\"9.00\",\"status\":\"scheduled\",\"isPrivate\":false,\"eventId\":\"7957c209-9c54-4c64-8126-aed1cae3b30f\",\"programId\":null}],\"seats\":23,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":28,\"eventsCount\":23,\"attendeesCount\":119,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"ch-badminton-club\",\"bio\":\"A community? A club? A society? Who knows?! We are just a group of people who enjoy playing badminton!\\n\\nThere’s always space for you, so we hope to see you soon!\\n\\nAll our links: https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-07-08T08:46:11.594Z\",\"updatedAt\":\"2026-07-08T11:11:40.168Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"\",\"eventsNumber\":12,\"image\":null},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[],\"id\":\"26e9ca66-9159-4df9-9e49-044f064ed603\",\"name\":\"C.H Badminton Club\",\"image\":{\"filePath\":\"companies/26e9ca66-9159-4df9-9e49-044f064ed603/bfa3d1fa-aea5-4bd2-892e-73e90d024f25.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F26e9ca66-9159-4df9-9e49-044f064ed603%2Fbfa3d1fa-aea5-4bd2-892e-73e90d024f25.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"bancontact_payments\",\"blik_payments\",\"card_payments\",\"eps_payments\",\"klarna_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":0