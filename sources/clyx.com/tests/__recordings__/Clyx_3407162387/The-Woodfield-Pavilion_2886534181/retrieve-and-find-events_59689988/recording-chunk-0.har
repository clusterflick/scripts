          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"e94bb2ae-9ddf-4104-b14a-1d4c5c1a2bab\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"Live at Juliana's by ROHY Music\",\"description\":\"<p>LIVE AT JULIANA'S 🎶 <br><br>Join us for an evening of live R&amp;B, meaningful conversations and great company. <br><br>Live at Juliana's is an intimate after-work social celebrating the next generation of R&amp;B talent while bringing together young creatives, modern professionals and music lovers in one space. Whether you're looking to discover new artists, meet like-minded people, catch up with old friends or make new connections, this is an evening designed for good music and even better community. <br><br>Come unwind, connect and experience a night where music brings people together. <br><br>✨ 25 September 2026 <br>📍Anthologist <br>🎵 Presented by ROHY Music in collaboration with Juliana's Social Club See you there.<br><br>PSA:</p><p>🚭 No smoking</p><p>🚫 No drugs</p><p>If you see anything that doesn't look right, including abuse or someone making you or someone else uncomfortable, please report it to Kwame and we will take appropriate action.<br></p><p>Disclaimer: 📸🎥 Please be aware that photography and videography will take place at this event. By attending, you may be photographed or filmed, and this content may be used for promotional and social media purposes by Juliana’s Social Club</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-25T20:00:00.000\",\"endDate\":\"2026-09-25T23:00:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"0f6d40b2-0341-43ba-b7d4-713cae9dd276\",\"address\":\"Gresham Street, London, UK\",\"locationName\":\"The Anthologist\",\"latitude\":51.5154254,\"longitude\":-0.0933486},\"image\":{\"filePath\":\"events/23028cb5-9ba9-4a66-952c-390e5af68b1a/1a243e96-6733-48ea-8e17-9da4e64acf96/8a63dacf-026f-4b0b-867c-497c55eb328b.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F23028cb5-9ba9-4a66-952c-390e5af68b1a%2F1a243e96-6733-48ea-8e17-9da4e64acf96%2F8a63dacf-026f-4b0b-867c-497c55eb328b.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"cc2a926d-018e-40db-bee7-6243dbeba3e6\",\"name\":\"Our Guests\",\"description\":\"\",\"maxQuantity\":null,\"sold\":30,\"leftSeats\":false,\"startDate\":\"2026-07-26T01:00:00.000\",\"endDate\":\"2026-09-25T20:00:00.000\",\"price\":\"15.99\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"e94bb2ae-9ddf-4104-b14a-1d4c5c1a2bab\",\"programId\":null}],\"seats\":100,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":58,\"eventsCount\":28,\"attendeesCount\":85,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"juliana-s-social-club-1\",\"bio\":\"London's home for modern professionals and corporates. A community-led social club that combines curated events, hospitality, and meaningful connection.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-07-24T13:58:39.626Z\",\"updatedAt\":\"2026-07-24T14:05:46.008Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"@chrrymartin\",\"eventsNumber\":24,\"image\":{\"filePath\":\"founders/6035df1a-593f-4b82-a170-a2b60117207a/f877ef31-ad83-4d3f-9ce2-3735621b477f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F6035df1a-593f-4b82-a170-a2b60117207a%2Ff877ef31-ad83-4d3f-9ce2-3735621b477f.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/1e70e4dc-0fa2-4354-8c0a-25907e9e7cda/preview/b86a8cea-5953-49c8-b762-48cfd1a4c2e5.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F1e70e4dc-0fa2-4354-8c0a-25907e9e7cda%2Fpreview%2Fb86a8cea-5953-49c8-b762-48cfd1a4c2e5.webp\"},{\"filePath\":\"companies/1e70e4dc-0fa2-4354-8c0a-25907e9e7cda/preview/c2e5b30a-30a4-484e-99c3-dfec560fc968.webp\",\"url\":\"https://storage.googleapis.com/clyx-prod