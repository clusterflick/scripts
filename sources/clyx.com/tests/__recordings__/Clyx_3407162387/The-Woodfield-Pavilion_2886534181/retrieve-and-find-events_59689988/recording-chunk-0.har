          "redirectURL": "",
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"91fe261e-f7f8-4573-b0d8-1f120d798338\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"HHC 2ND ANNIVERSARY CELEBRATION - BASEBALL\",\"description\":\"<p>WE’RE TURNING 2! 🥹🥳 To celebrate two years of HHC, we’re heading to The 108 Centre in Brent Cross for an afternoon of baseball, good vibes and even better company. ⚾️🏟️</p><p>Here’s everything you need to know:<br></p><p>📅 Saturday 26th September</p><p>📍 The 108, Brent Cross, London NW2 1LT</p><p>⏰ 3pm–6pm<br></p><p>Whether you’ve been hiking with us from day one or you’re brand new to the HHC community, everyone is welcome! 🫂🤲<br></p><p>PLEASE NOTE: We’ll also be heading for dinner nearby afterwards! This is completely optional, so feel free to join us for dinner or just come along for the baseball. 🍽️😋</p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-26T15:00:00.000\",\"endDate\":\"2026-09-26T18:00:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"c5e79271-c1f9-48e2-be67-aa053b9bead7\",\"address\":\"Brent Terrace, Brent Cross, London, UK\",\"locationName\":\"The 108\",\"latitude\":51.5715727,\"longitude\":-0.2262886},\"image\":{\"filePath\":\"events/505cabd5-d347-44ae-b941-1109a473a6ad/63ba0030-04fd-41a9-954a-7a9fe1a48c49/e1870942-5460-417c-b161-882763e4bd2d.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F505cabd5-d347-44ae-b941-1109a473a6ad%2F63ba0030-04fd-41a9-954a-7a9fe1a48c49%2Fe1870942-5460-417c-b161-882763e4bd2d.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"0c3a257c-911e-4787-b5df-9321e3f1b8f7\",\"name\":\"Standard Release\",\"description\":\"\",\"maxQuantity\":null,\"sold\":3,\"leftSeats\":false,\"startDate\":\"2026-08-22T12:00:00.000\",\"endDate\":\"2026-09-25T22:00:00.000\",\"price\":\"10.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"91fe261e-f7f8-4573-b0d8-1f120d798338\",\"programId\":null}],\"seats\":25,\"isLiked\":false,\"url\":null,