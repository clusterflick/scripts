            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"644f7d2d-dc0d-4b7b-a6d7-b26a2d6f6e67\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"'HOME' - Second Home\",\"description\":\"<p>Second Home welcomes Second Space back for another beautiful East London event under the theme 'HOME'. <br><br>A night of Open Mic and 3 featured headliners. <br><br>BUY AN OPEN MIC TICKET TO PERFORM! All who buy an open mic ticket are guaranteed to perform. <br><br>Theme for open mic-ers is not a requirement, just come with your best bars! <br><br>Winner of the open mic competition will Headline a Second Space event in the future.</p>\",\"salesStartDate\":null,\"startDate\":\"2026-10-26T19:00:00.000\",\"endDate\":\"2026-10-26T21:30:00.000\",\"isPromoCodeAvailable\":true,\"location\":{\"id\":\"9f0d172b-fc3b-4258-937b-404592d998f7\",\"address\":\"68-80 Hanbury Street, London, UK\",\"locationName\":\"Second Home\",\"latitude\":51.51983360000001,\"longitude\":-0.0716142},\"image\":{\"filePath\":\"events/644f7d2d-dc0d-4b7b-a6d7-b26a2d6f6e67/82191eff-59d0-4fe0-bffc-c88ae7f4934d/f31af4ea-253e-4e66-ae6a-e7a5584e9607.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F644f7d2d-dc0d-4b7b-a6d7-b26a2d6f6e67%2F82191eff-59d0-4fe0-bffc-c88ae7f4934d%2Ff31af4ea-253e-4e66-ae6a-e7a5584e9607.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"4201f3a4-75a4-4471-86fd-0b10e61d1e61\",\"name\":\"OPEN MIC TICKET\",\"description\":\"Buy an open mic ticket to perform! Winner gets to headline a future Second Space event\",\"maxQuantity\":12,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-10-26T19:30:00.000\",\"price\":\"12.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"644f7d2d-dc0d-4b7b-a6d7-b26a2d6f6e67\",\"programId\":null},{\"id\":\"895f8856-0f48-4d79-a362-0395f9a7f1d8\",\"name\":\"AUDIENCE TICKET\",\"description\":\"\",\"maxQuantity\":null,\"sold\":0,\"leftSeats\":false,\"startDate\":\"2026-09-15T12:30:00.000\",\"endDate\":\"2026-10-26T19:30:00.000\",\"price\":\"15.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"644f7d2d-dc0d-4b7b-a6d7-b26a2d6f6e67\",\"programId\":null}],\"seats\":null,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":148,\"eventsCount\":15,\"attendeesCount\":300,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"second-space\",\"bio\":\"Typically we know a first space to be home, a second space to be the work place, and a third space is a community…\\n\\nWhat if we merged all three? \\n\\n‘SECOND SPACE’ is a Spoken Word, Music and Open Mic night hosted monthly at the incredible GoHub Studio in the heart of Brixton. \\nThe best emerging artists in UK come to showcase their work in a space that feels like home. \\nSECOND SPACE: Your second home, and your first community.\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-03-14T13:49:21.691Z\",\"updatedAt\":\"2026-03-29T11:33:34.800Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"Anna-Margarita\",\"eventsNumber\":1,\"image\":{\"filePath\":\"founders/4a247b64-442c-48fd-a2ba-93889433c320/dd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/founders%2F4a247b64-442c-48fd-a2ba-93889433c320%2Fdd351b9c-ab54-4e98-b8ef-d2c577ada94f.webp\"}},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/3dd00187-9189-41ef-a605-e382b4006d1f.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-46d7-bd85-79cebf5ff82b%2Fpreview%2F3dd00187-9189-41ef-a605-e382b4006d1f.webp\"},{\"filePath\":\"companies/886d7532-bffe-46d7-bd85-79cebf5ff82b/preview/74318570-731e-4ab3-ba15-1191ece2e798.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F886d7532-bffe-