          "content": {
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"id\":\"8c31d3dc-25e8-41bd-b5ec-d62061b47dad\",\"target\":\"event\",\"eventType\":\"manual\",\"isPrivate\":false,\"isTransferEnabled\":false,\"name\":\"CHBC Weekly Session 17/09\",\"description\":\"<p>Come along to our weekly badminton session for a fun, friendly game and a chance to get active. Whether you're a complete beginner or you've been playing for years, everyone is welcome. It's all about enjoying the game, meeting new people, and having a good time.<br></p><p>Don't forget to bring a bottle of water, and if you have your own badminton racket, bring it along. If not, we've got rackets you can borrow.<br></p><p><strong>Playing till the shuttle drops...</strong><br></p><p><em>DISCLAIMER</em></p><p><u>The venue is a NUT-FREE zone, please could you NOT bring nuts or nut-based products into the venue in any form.</u><br></p><p>All our links: <a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" class=\\\"editor-link\\\" href=\\\"https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&amp;ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc\\\"><u>https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&amp;ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc</u></a></p>\",\"salesStartDate\":null,\"startDate\":\"2026-09-17T18:30:00.000\",\"endDate\":\"2026-09-17T20:30:00.000\",\"isPromoCodeAvailable\":false,\"location\":{\"id\":\"ff835934-3e6b-45f4-8d8c-c9ce662d891d\",\"address\":\"Lambs Lane South, Rainham, UK\",\"locationName\":\"Harris Academy Rainham\",\"latitude\":51.5165879,\"longitude\":0.206678},\"image\":{\"filePath\":\"events/8c31d3dc-25e8-41bd-b5ec-d62061b47dad/9b2c4bc0-4286-450f-9687-06b3390560ae/30ed9550-0af8-429d-8311-6de50cd43061.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/events%2F8c31d3dc-25e8-41bd-b5ec-d62061b47dad%2F9b2c4bc0-4286-450f-9687-06b3390560ae%2F30ed9550-0af8-429d-8311-6de50cd43061.webp\"},\"programId\":null,\"program\":null,\"tiers\":[{\"id\":\"f19b28b1-4e7c-4c73-9ba8-5e8c52a4510e\",\"name\":\"Admission\",\"description\":\"\",\"maxQuantity\":null,\"sold\":4,\"leftSeats\":false,\"startDate\":\"2026-09-11T12:00:00.000\",\"endDate\":\"2026-09-17T19:30:00.000\",\"price\":\"9.00\",\"status\":\"on-sale\",\"isPrivate\":false,\"eventId\":\"8c31d3dc-25e8-41bd-b5ec-d62061b47dad\",\"programId\":null}],\"seats\":23,\"isLiked\":false,\"url\":null,\"checkInEnabled\":false,\"company\":{\"followersCount\":28,\"eventsCount\":23,\"attendeesCount\":119,\"isFollowed\":false,\"isFollowRequested\":false,\"slug\":\"ch-badminton-club\",\"bio\":\"A community? A club? A society? Who knows?! We are just a group of people who enjoy playing badminton!\\n\\nThere’s always space for you, so we hope to see you soon!\\n\\nAll our links: https://linktr.ee/chbadmintonclub?utm_source=linktree_profile_share&ltsid=3635795a-7f48-4ccb-a0f0-57c07a29c2bc\",\"type\":\"community\",\"status\":\"active\",\"stripeConnectOnboardingStatus\":\"onboarded\",\"createdAt\":\"2026-07-08T08:46:11.594Z\",\"updatedAt\":\"2026-07-08T11:11:40.168Z\",\"active\":true,\"url\":null,\"founder\":{\"name\":\"\",\"eventsNumber\":12,\"image\":null},\"isPrivate\":false,\"isShownPreviewImagesPopup\":true,\"previewImages\":[],\"id\":\"26e9ca66-9159-4df9-9e49-044f064ed603\",\"name\":\"C.H Badminton Club\",\"image\":{\"filePath\":\"companies/26e9ca66-9159-4df9-9e49-044f064ed603/bfa3d1fa-aea5-4bd2-892e-73e90d024f25.webp\",\"url\":\"https://storage.googleapis.com/clyx-production-bucket/companies%2F26e9ca66-9159-4df9-9e49-044f064ed603%2Fbfa3d1fa-aea5-4bd2-892e-73e90d024f25.webp\"},\"country\":\"GB\",\"photos\":[],\"photosCount\":0,\"activatedPaymentMethods\":[\"bancontact_payments\",\"blik_payments\",\"card_payments\",\"eps_payments\",\"klarna_payments\",\"link_payments\",\"transfers\"]},\"city\":{\"id\":\"ef6c2cc0-ef51-4f87-8835-ae615b6b7841\",\"name\":\"London\",\"country\":\"UK\",\"timeZone\":\"Europe/London\",\"longitude\":-0.1275862,\"latitude\":51.5072178},\"seatsOccupied\":4,\"likedCount\":0,\"seatsF