cd7e-edea-42fd-8dde-b5934a3d7339\">\n  \n    \n      \n            <div class=\"field field--name-field-title field--type-string field--label-hidden field__item\"><h2>Stay informed</h2>\n</div>\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Local events, initiatives, and news</p>\n</div>\n      \n            <div class=\"field field--name-field-block-link field--type-link field--label-hidden field__item\"><a href=\"/your-community\">Your Community</a></div>\n      \n  </div>\n<div id=\"block-bbd-localgov-acrosstheboroughblock\" class=\"block block-block-content block-block-content17236a01-0ad7-40e6-921b-2f6174bc115c\">\n  \n    \n      \n            <div class=\"field field--name-field-title field--type-string field--label-hidden field__item\"><h2>Across the borough</h2>\n</div>\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Find out what's on in Southwark</p>\n</div>\n      \n            <div class=\"field field--name-field-block-link field--type-link field--label-hidden field__item\"><a href=\"/southwark-presents\">Southwark Presents</a></div>\n      \n  </div>\n<div id=\"block-bbd-localgov-newsinsouthwarkblock\" class=\"block block-block-content block-block-contentcd4e8b1b-31d8-4a89-a19d-d697a9879653\">\n  \n    \n      \n            <div class=\"field field--name-field-title field--type-string field--label-hidden field__item\"><h2>News in Southwark</h2>\n</div>\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Read the latest news</p>\n</div>\n      \n            <div class=\"field field--name-field-block-link field--type-link field--label-hidden field__item\"><a href=\"/news\">News in Southwark</a></div>\n      \n  </div>\n\n    </div>\n\n    \n  </div>\n\n              </div>\n            \n                  </div>\n      </div>\n    </div>\n  </div>\n</header>\n\n\n\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--messages region region-messages\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--messages\">\n      <div data-drupal-messages-fallback class=\"hidden\"></div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n<main class=\"main\" id=\"main-content\"> \n  \n                    <div>\n      \n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      <div id=\"block-bbd-localgov-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n      \n\n  \n\n\n\n\n<article about=\"/southwark-presents/harold-moody-and-not-our-problem-nunhead-library\" class=\"localgov-event node node--type-localgov-event node--with-restricted-width node--promoted node--view-mode-full\">\n  \n  \n\n  <div class=\"lgd-container padding-horizontal\">\n              \n    <div class=\"node__restricted-width-section\">\n      \n                    \n                    \n      \n      \n                          \n      <div class=\"localgov-event__content node__content\">\n        \n        \n\n\n\n<div class=\"localgov-add-to-calendar\">\n\n<button class=\"localgov-add-to-calendar__trigger\" type=\"button\" name=\"addToCalendarTrigger\">\n  \n\n\n<span aria-hidden=\"true\" class=\"lgd-icon localgov-add-to-calendar__trigger-icon\">\n  <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"><!--! Font Awesome Free 6.1.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d=\"M152 64H296V24C296 10.75 306.7 0 320 0C333.3 0 344 10.75 344 24V64H384C419.3 64 448 92.65 448 128V448C448 483.3 419.3 512 384 512H64C28.65 512 0 483.3 0 448V128C0 92.65 28.65 64 64 64H104V24C104 10.75 114.7 0 128 0C141.3 0 152 10.75 152 24V64zM48 448C48 456.8 55.16 464 64 464H384C392.8 464 400 456.8 400 448V192H48V448z\"/></svg></span>  <span class=\"localgov-add-to-calendar__trigger-text\">\n    Add to Calendar\n  </span>\n</button>\n\n  <dialog class=\"localgov-add-to-calendar__dialog\">\n    <div class=\"localgov-add-to-calendar__dialog-close\">\n      <button class=\"localgov-add-to-calendar__dialog-close-button\" type=\"button\" name=\"closeAddToCalendarDialog\">\n        Close\n      </button>\n    </div>\n    <div class=\"localgov-add-to-calendar__items\">\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"    https://www.google.com/calendar/r/eventedit?text=Harold Moody and Not Our Problem - Nunhead Library \n          &dates=\n              20261021T161500Z\n              /20261021T180000Z\n                  &location=Nunhead Library, London, SE15 3RW\n        \" target=\"_blank\" rel=\"nofollow\">Add to Google Calendar</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ADTSTART:20261021T161500Z%0ADTEND:20261021T180000Z%0ASUMMARY:Harold Moody and Not Our Problem - Nunhead Library %0ALOCATION: Nunhead Library, London, SE15 3RW%0AEND:VEVENT%0AEND:VCALENDAR\">Add to iCal</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ADTSTART:20261021T161500Z%0ADTEND:20261021T180000Z%0ASUMMARY:Harold Moody and Not Our Problem - Nunhead Library %0ALOCATION: Nunhead Library, London, SE15 3RW%0AEND:VEVENT%0AEND:VCALENDAR\">Add to Outlook</a>\n      </div>\n\n    </div>\n  </dialog>\n\n</div>\n\n        \n<div  class=\"event-hero\">\n    \n<div  class=\"event-intro\">\n    \n<div  class=\"text-wrapper\">\n    <a href=\"/southwark-presents\" class=\"link-back\">Back</a>\n<div  class=\"event-intro-wrapper\">\n    <div><div id=\"block-bbd-localgov-breadcrumbs\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/southwark-presents\">Southwark Presents</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Harold Moody and Not Our Problem - Nunhead Library\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Harold Moody and Not Our Problem - Nunhead Library </h1>\n</div>\n      \n            <div class=\"share-links-field-wrapper extra-field-wrapper field field--name-extra-field-bbd-extra-fields-share-links field--type-extra-field field--label-hidden field__item\"></div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">  <p>Harold Moody and Not Our Problem is a screening of two powerful documentaries exploring Black history in Southwark. Through the story of Dr Harold Moody’s campaign for racial equality and accounts of community experiences of racism in 1980s Southwark, the films offer insight into the challenges, activism, and resilience of Black communities. Suitable for adults, this thought-provoking event takes place on Wednesday 21 October, from 5.15pm to 7pm, at Nunhead Library, 88-136 Gordon Road, SE15 3RB.</p>\n\n\n</div>\n      \n  </div>\n  </div>\n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_3_2_2x/public/2026-09/Dr%20Harold%20Moody%20%28date%20unknown%29.jpg?h=175866a9&amp;itok=hDPIFpxp 1x\" media=\"(min-width: 768px)\" type=\"image/jpeg\" width=\"1536\" height=\"1024\"/>\n                  <img loading=\"eager\" width=\"768\" height=\"512\" src=\"/sites/default/files/styles/large_3_2_768x512/public/2026-09/Dr%20Harold%20Moody%20%28date%20unknown%29.jpg?h=175866a9&amp;itok=F_BO106M\" alt=\"Watch two compelling documentaries exploring Dr Harold Moody’s fight for racial equality and the experiences of Black communities in 1980s Southwark. Suitable for adults.\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n            <div class=\"field field--name-field-caption field--type-string field--label-hidden field__item\">Discover powerful stories of courage, activism, and community as two documentaries explore Dr Harold Moody’s fight for racial equality and the experiences of Black communities in 1980s Southwark.</div>\n      \n</div>\n</div>\n      \n  </div>\n  </div>\n<div  class=\"event-content\">\n    \n<div  class=\"event-column column-first\">\n    \n<div  class=\"date-wrapper\">\n  <h2>Date</h2>\n    \n      <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"event-next-date\">\n    <div class=\"field__label\">Date: </div>\n    <p class=\"field field-date date-recur-date\"><time datetime=\"2026-10-21T17:15:00Z\">Wednesday, 21 October 2026</time>\n</p>\n  </div>\n\n      <div class=\"event-time\">\n      <div class=\"field__label\">Time: </div>\n      <p class=\"field field-time date-recur-time\"><time datetime=\"2026-10-21T17:15:00Z\">5:15pm</time>\n - <time datetime=\"2026-10-21T19:00:00Z\">7:00pm</time>\n</p>\n    </div>\n  \n</div>\n          </div>\n  \n  <div class=\"field field--name-field-how-often field--type-string field--label-above\">\n    <div class=\"field__label\">How often</div>\n              <div class=\"field__item\">once</div>\n          </div>\n\n  </div>\n      <div class=\"field field--name-extra-field-bbd-extra-field-bbd-event-date-slider field--type-extra-field field--label-hidden field__items\">\n              <div class=\"field__item\"></div>\n          </div>\n  \n  <div class=\"field field--name-body field--type-text-with-summary field--label-above\">\n    <div class=\"field__label\">Description</div>\n              <div class=\"field__item\"><p><strong>Harold Moody and </strong><em><strong>Not Our Problem</strong></em> is a thought-provoking documentary screening exploring Black history in Southwark through the themes of racial equality, activism, and community resilience. The films examine Dr Harold Moody’s pioneering campaign against racial discrimination in Britain and share powerful accounts of the experiences of Black communities living in Southwark during the 1980s. Together, they offer valuable insights into local history and the ongoing struggle for social justice, encouraging reflection and discussion. Suitable for adults, the event takes place on <strong>Wednesday 21 October, from 5.15pm to 7pm, at Nunhead Library</strong>.</p></div>\n          </div>\n\n  </div>\n<div  class=\"event-column\">\n    \n<div  class=\"tickets-wrapper\">\n  <h2>Tickets</h2>\n    \n      <div class=\"field field--name-field-ticket-price field--type-entity-reference-revisions field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13176\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n            <div class=\"field field--name-field-name field--type-string field--label-hidden field__item\">Free</div>\n      \n            <div class=\"field field--name-field-price field--type-string field--label-hidden field__item\">Free</div>\n      \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13177\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n            <div class=\"field field--name-field-name field--type-string field--label-hidden field__item\">Free</div>\n      \n            <div class=\"field field--name-field-price field--type-string field--label-hidden field__item\">Free</div>\n      \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13178\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n          </div>\n  \n  </div>\n<div  class=\"how-to-get-wrapper accessibility-wrapper\">\n  <h2>How to get there</h2>\n    \n  <div class=\"field field--name-field-by-bus field--type-string-long field--label-above\">\n    <div class=\"field__label\">By bus</div>\n              <div class=\"field__item\">Bus: P12, 78 </div>\n          </div>\n\n  <div class=\"field field--name-field-by-train field--type-string-long field--label-above\">\n    <div class=\"field__label\">By train</div>\n              <div class=\"field__item\">Train: Nunhead</div>\n          </div>\n\n  </div>\n<div  class=\"accessibility-wrapper\">\n  <h2>Accessibility</h2>\n    \n            <div class=\"field field--name-field-accessibility-details field--type-text-long field--label-hidden field__item\"><p>This library has:</p><ul><li>ramped&nbsp;access</li><li>disabled access toilet</li><li>computers with screen magnification and audio assistance for visually impaired users</li></ul></div>\n      \n  </div>\n  <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-above\">\n    <div class=\"field__label\">Location</div>\n              <div class=\"field__item\">\n<article>\n      \n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">Nunhead Library</span><br>\n<span class=\"address-line2\">Gordon Road</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"postal-code\">SE15 3RW</span><br>\n<span class=\"country\">United Kingdom</span></p><a href=\"https://google.com/maps?q=Nunhead%20Library%20Gordon%20Road%20London%20SE15%203RW%20GB\" class=\"address-map-link\" target=\"_blank\">Show on maps</a></div>\n          </div>\n  </article>\n</div>\n          </div>\n\n  </div>\n  </div>\n<div  class=\"event-content event-content-lower\">\n    \n<div  class=\"event-column column-first-lower\">\n    <div class=\"field--name-field-other-events-like-this\"><div class=\"field__label\">Other events like this</div><div class=\"field--items field__items view view-automate-related-events view-id-automate_related_events view-display-id-block_1\">\n  \n    \n      \n      <div class=\"view-content\">\n          <div class=\"field__item views-row\">\n<article about=\"/southwark-presents/guy-fox-drawing-challenge-canada-water-library\" class=\"node node--type-localgov-event node--promoted node--view-mode-featured-event\">\n  \n  <div class=\"node__content\">\n    <a href=\"/southwark-presents/guy-fox-drawing-challenge-canada-water-library\" class=\"field-group-link card-link\" hreflang=\"en\">\n<div  class=\"image-wrapper\">\n    \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hi