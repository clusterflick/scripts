class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/southwark-presents\">Southwark Presents</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Film club presents: A Última Imagem at Canada Water Library\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Film club presents:  A Última Imagem at Canada Water Library</h1>\n</div>\n      \n            <div class=\"share-links-field-wrapper extra-field-wrapper field field--name-extra-field-bbd-extra-fields-share-links field--type-extra-field field--label-hidden field__item\"></div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">  <p>A free screening of Benedito Ferreira’s A Última Imagem / The Last Image (2021, 1hr 11m)</p>\n\n\n</div>\n      \n  </div>\n  </div>\n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_3_2_2x/public/2026-09/TLI_still12%20%281%29.jpg?h=d1cb525d&amp;itok=c5mKC7rD 1x\" media=\"(min-width: 768px)\" type=\"image/jpeg\" width=\"1536\" height=\"1024\"/>\n                  <img loading=\"eager\" width=\"768\" height=\"512\" src=\"/sites/default/files/styles/large_3_2_768x512/public/2026-09/TLI_still12%20%281%29.jpg?h=d1cb525d&amp;itok=Noqno8T7\" alt=\"Two actors in pink suits on the beach\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n  </div>\n  </div>\n<div  class=\"event-content\">\n    \n<div  class=\"event-column column-first\">\n    \n<div  class=\"date-wrapper\">\n  <h2>Date</h2>\n    \n      <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"event-next-date\">\n    <div class=\"field__label\">Date: </div>\n    <p class=\"field field-date date-recur-date\"><time datetime=\"2026-10-05T13:00:00Z\">Monday, 5 October 2026</time>\n</p>\n  </div>\n\n      <div class=\"event-time\">\n      <div class=\"field__label\">Time: </div>\n      <p class=\"field field-time date-recur-time\"><time datetime=\"2026-10-05T13:00:00Z\">1:00pm</time>\n - <time datetime=\"2026-10-05T15:00:00Z\">3:00pm</time>\n</p>\n    </div>\n  \n</div>\n          </div>\n  \n  <div class=\"field field--name-field-how-often field--type-string field--label-above\">\n    <div class=\"field__label\">How often</div>\n              <div class=\"field__item\">Special edition of our film club, which is weekly on a Monday</div>\n          </div>\n\n  </div>\n      <div class=\"field field--name-extra-field-bbd-extra-field-bbd-event-date-slider field--type-extra-field field--label-hidden field__items\">\n              <div class=\"field__item\"></div>\n          </div>\n  \n  <div class=\"field field--name-body field--type-text-with-summary field--label-above\">\n    <div class=\"field__label\">Description</div>\n              <div class=\"field__item\"><p>In this special edition of our weekly film club, where we will be screening Brazilian director Ferreira’s avant-garde queer film. The film will be in Portuguese (Brazilian) and French, with English subtitles throughout.</p><p><em>“Two Beneditos, the director and his character, blind and gay, in search of a film about their friendship and about the last image the character remembers having seen.”</em></p></div>\n          </div>\n\n  </div>\n<div  class=\"event-column\">\n    \n<div  class=\"tickets-wrapper\">\n  <h2>Tickets</h2>\n    \n      <div class=\"field field--name-field-ticket-price field--type-entity-reference-revisions field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_12867\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_12868\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_12869\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n          </div>\n  \n  </div>\n<div  class=\"how-to-get-wrapper accessibility-wrapper\">\n  <h2>How to get there</h2>\n    \n  <div class=\"field field--name-field-by-bus field--type-string-long field--label-above\">\n    <div class=\"field__label\">By bus</div>\n              <div class=\"field__item\">1, 47, 188, 199, 225, 381, C10, P12</div>\n          </div>\n\n  <div class=\"field field--name-field-by-train field--type-string-long field--label-above\">\n    <div class=\"field__label\">By train</div>\n              <div class=\"field__item\">South Bermondsey</div>\n          </div>\n\n  <div class=\"field field--name-field-by-tube field--type-string-long field--label-above\">\n    <div class=\"field__label\">By tube</div>\n              <div class=\"field__item\">Canada Water, Surrey Quays, Rotherhithe</div>\n          </div>\n\n  </div>\n<div  class=\"accessibility-wrapper\">\n  <h2>Accessibility</h2>\n    \n            <div class=\"field field--name-field-accessibility-details field--type-text-long field--label-hidden field__item\"><p>https://www.accessable.co.uk/london-borough-of-southwark/access-guides/canada-water-library</p></div>\n      \n  </div>\n  <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-above\">\n    <div class=\"field__label\">Location</div>\n              <div class=\"field__item\">\n<article>\n      \n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">21 Surrey Quays Road</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"postal-code\">SE16 7AR</span><br>\n<span class=\"country\">United Kingdom</span></p><a href=\"https://google.com/maps?q=21%20Surrey%20Quays%20Road%20London%20SE16%207AR%20GB\" class=\"address-map-link\" target=\"_blank\">Show on maps</a></div>\n          </div>\n  </article>\n</div>\n          </div>\n\n  </div>\n  </div>\n<div  class=\"event-content event-content-lower\">\n    \n<div  class=\"event-column column-first-lower\">\n    <div class=\"field--name-field-other-events-like-this\"><div class=\"field__label\">Other events like this</div><div class=\"field--items field__items view view-automate-related-events view-id-automate_related_events view-display-id-block_1\">\n  \n    \n      \n      <div class=\"view-content\">\n          <div class=\"field__item views-row\">\n<article about=\"/southwark-presents/guy-fox-drawing-challenge-canada-water-library\" class=