nect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n\n  <script>\n    window.cludo_engineId = 13695;\n    window.cludo_language = \"en\";\n    window.cludo_searchUrl = \"/\"; //Search URL - change this to reflect the actual search URL\n    window.cludo_searchInputSelectors = [\"#cludo-search-input\", \"#views-exposed-form-localgov-sitewide-search-sitewide-search-page-block\"]; //Array of CSS selectors for input fields that should trigger search\n  </script>\n  <script src=\"/themes/custom/bbd_localgov/libraries/CludoSearch/js/cludo-search-results.js\" type=\"text/javascript\"></script>\n  <script src=\"/themes/custom/bbd_localgov/libraries/CludoSearch/js/search-script.min.js\" type=\"text/javascript\" onload=\"\"></script>\n\n  </head>\n  <body class=\"sticky-header no-js path-node page-node-type-southwark-presents-landing-page\">\n        <script>\n      document.querySelector('body').classList.remove('no-js');\n    </script>\n        <a href=\"#main-content\" class=\"visually-hidden focusable skip-link\">\n      Skip to main content\n    </a>\n    <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P59KV5\" height=\"0\" width=\"0\" style=\"display:none;visibility:hidden;\"></iframe>\n</noscript>\n      <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    \n\n\n    \n\n\n<header class=\"lgd-header\">\n  <div class=\"lgd-container\">\n    <div class=\"lgd-row\">\n      <div class=\"lgd-row__full\">\n        <div class=\"lgd-header__inner\">\n          \n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--header region region-header\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--header\">\n            <div class=\"branding\">\n      <div class=\"branding__item branding__item--logo\">\n        <a href=\"/\" rel=\"home\" class=\"branding__logo\">\n          <img src=\"/themes/custom/bbd_localgov/logo.svg\" alt=\"Southwark Council - Hom