eld field-time list-recur-date\"><time datetime=\"2033-07-15T10:00:00Z\">Fri 15 July 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-07-15T10:00:00Z\">10:00am</time>\n-<time datetime=\"2034-10-06T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n          <li>\n                  <div class=\"event-date\">\n            <div class=\"event-label\">Date: </div>\n            <div class=\"field field-time list-recur-date\"><time datetime=\"2033-08-19T10:00:00Z\">Fri 19 August 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-08-19T10:00:00Z\">10:00am</time>\n-<time datetime=\"2034-11-09T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n          <li>\n                  <div class=\"event-date\">\n            <div class=\"event-label\">Date: </div>\n            <div class=\"field field-time list-recur-date\"><time datetime=\"2033-09-16T10:00:00Z\">Fri 16 September 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-09-16T10:00:00Z\">10:00am</time>\n-<time datetime=\"2034-12-07T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n          <li>\n                  <div class=\"event-date\">\n            <div class=\"event-label\">Date: </div>\n            <div class=\"field field-time list-recur-date\"><time datetime=\"2033-10-21T10:00:00Z\">Fri 21 October 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-10-21T10:00:00Z\">10:00am</time>\n-<time datetime=\"2035-01-11T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n          <li>\n                  <div class=\"event-date\">\n            <div class=\"event-label\">Date: </div>\n            <div class=\"field field-time list-recur-date\"><time datetime=\"2033-11-18T10:00:00Z\">Fri 18 November 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-11-18T10:00:00Z\">10:00am</time>\n-<time datetime=\"2035-02-08T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n          <li>\n                  <div class=\"event-date\">\n            <div class=\"event-label\">Date: </div>\n            <div class=\"field field-time list-recur-date\"><time datetime=\"2033-12-16T10:00:00Z\">Fri 16 December 2033</time>\n</div>\n          </div>\n        \n                  <div class=\"event-time\">\n            <div class=\"event-label\">Time: </div>\n            <div class=\"field field-time list-recur-time\"><time datetime=\"2033-12-16T10:00:00Z\">10:00am</time>\n-<time datetime=\"2035-03-09T14:01:00Z\">2:01pm</time>\n</div>\n          </div>\n              </li>\n      </ul>\n</div>\n</div>\n          </div>\n  \n  <div class=\"field field--name-body field--type-text-with-summary field--label-above\">\n    <div class=\"field__label\">Description</div>\n              <div class=\"field__item\"><p><strong>Pembroke House is delighted to launch Artists' Table - Every 3rd Friday of the Month, starting on the 19th September 10am-12noon.</strong></p><p>The Artists’ Table is a monthly gathering for local artists (all art forms) to learn about each other’s work, exchange ideas and advice and offer support and understanding. Whether you have a project to share, a question to figure out or are looking to find your next collaborator, if you are a creative in South London, join us to nurture your practice, replenish your energy, and feel part of a community of artists.<br><br>Each session will include a facilitated opportunity to share your work, challenges and opportunities as well as time to work alongside each other.<br><br>Tea and coffee provided!<br>&nbsp;</p><p>Join us at the Walworth Living Room: All Saints Hall, Surrey Square Road, SE17 2JU from 10am - 12noon.&nbsp;<strong>Please register here to let us know you are coming: https://www.eventbrite.com/e/artists-table-tickets-1678676559779?aff=oddtdtcreator</strong></p></div>\n          </div>\n\n<div  class=\"date-wrapper\">\n  <h2>Social media</h2>\n    \n  <div class=\"field field--name-field-instagram field--type-link field--label-above\">\n    <div class=\"field__label\">Instagram</div>\n              <div class=\"field__item\"><a href=\"https://www.instagram.com/pembrokehouse\">https://www.instagram.com/pembrokehouse</a></div>\n          </div>\n\n  </div>\n  </div>\n<div  class=\"event-column\">\n    \n<div  class=\"tickets-wrapper\">\n  <h2>Tickets</h2>\n    \n      <div class=\"field field--name-field-ticket-price field--type-entity-reference-revisions field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_6268\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n            <div class=\"field field--name-field-name field--type-string field--label-hidden field__item\">All tickets</div>\n      \n            <div class=\"field field--name-field-price field--type-string field--label-hidden field__item\">Free</div>\n      \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_6269\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_6270\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n          </div>\n  \n            <div class=\"field field--name-field-book-tickets field--type-link field--label-hidden field__item\"><a href=\"https://www.eventbrite.com/e/artists-table-tickets-1678676559779?aff=oddtdtcreator\">https://www.eventbrite.com/e/artists-table-tickets-1678676559779?aff=oddtdtcrea…</a></div>\n      \n  </div>\n<div  class=\"accessibility-wrapper\">\n  <h2>Accessibility</h2>\n    \n            <div class=\"field field--name-field-venue-details field--type-link field--label-hidden field__item\"><a href=\"https://www.pembrokehouse.org.uk/events/artists-table/\">Visit event website</a></div>\n      \n  </div>\n  <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-above\">\n    <div class=\"field__label\">Location</div>\n              <div class=\"field__item\">\n<article>\n      \n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">Walworth Living Room</span><br>\n<span class=\"address-line2\">Surrey Square</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"postal-code\">SE17 2JU</span><br>\n<span class=\"country\">United Kingdom</span></p><a href=\"https://google.com/maps?q=Walworth%20Living%20Room%20Surrey%20Square%20London%20SE17%202JU%20GB\" class=\"address-map-link\" target=\"_blank\">Show on maps</a></div>\n          </div>\n  </article>\n</div>\