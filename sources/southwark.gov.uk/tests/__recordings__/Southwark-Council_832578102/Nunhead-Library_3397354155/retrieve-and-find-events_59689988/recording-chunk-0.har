block-system block-system-main-block\">\n  \n    \n      \n\n  \n\n\n\n\n\n  \n  \n  \n\n<article about=\"/southwark-presents\" data-component-id=\"localgov_base:display-full\" class=\"southwark-presents-landing-page node node--promoted node--view-mode-full node--type-southwark-presents-landing-page\">\n\n  <div class=\"lgd-container padding-horizontal\">\n    \n    \n\n    \n    \n      <div class=\"southwark-presents-landing-page__content node__content\">\n        \n<div  class=\"event-hero\">\n    \n<div  class=\"event-intro\">\n    \n<div  class=\"text-wrapper\">\n    <div><div id=\"block-bbd-localgov-breadcrumbs\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Southwark Presents\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Southwark Presents</h1>\n</div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">Find out what&#039;s on in Southwark. From big arts organisations to local community groups, everyone is welcome to submit their cultural events to be listed here.<br />\r\nIf you need any assistance with events or have any questions about Southwark Presents, please email: culture@southwark.gov.uk</div>\n      \n      <div class=\"field field--name-field-ctas field--type-link field--label-hidden field__items\">\n              <div class=\"field__item\"><a href=\"/list-your-event\">Add your event</a></div>\n          </div>\n  \n  </div>\n<div  class=\"image-wrapper\">\n    \n            <div class=\"field field--name-field-media-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_21_9/public/2024-10/ballet-don-quijote-895062_1920.jpg?h=9d6e018e&amp;itok=0m0pvsLS 1x\" media=\"(min-width: 768px)\" type=\"image/jpeg\" width=\"1440\" height=\"620\"/>\n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2024-10/ballet-don-quijote-895062_1920.jpg?h=9d6e018e&amp;itok=8IXvFKGr\" alt=\"A dramatic scene from the ballet Don Quixote\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n            <div class=\"field field--name-field-caption field--type-string field--label-hidden field__item\">Ballet</div>\n      \n</div>\n</div>\n      \n  </div>\n  </div>\n  </div>\n            <div class=\"field field--name-field-events field--type-viewsreference field--label-hidden field__item\"><div class=\"views-element-container\"><div class=\"view view-southwark-events view-id-southwark_events view-display-id-block_1 js-view-dom-id-8b2bb40c3334f57bd9d381c43ab1b9e0884215c18c0afe4cc8e7e3cbf001ae05\">\n  \n    \n        <div class=\"view-filters\">\n      <form class=\"views-exposed-form bef-exposed-form\" data-drupal-selector=\"views-exposed-form-southwark-events-block-1\" action=\"/southwark-presents\" method=\"get\" id=\"views-exposed-form-southwark-events-block-1\" accept-charset=\"UTF-8\">\n  \n\n<div class=\"js-form-item form-item js-form-type-select form-item-event-categories js-form-item-event-categories\">\n      <label for=\"edit-event-categories\">Event type</label>\n          <select data-drupal-selector=\"edit-event