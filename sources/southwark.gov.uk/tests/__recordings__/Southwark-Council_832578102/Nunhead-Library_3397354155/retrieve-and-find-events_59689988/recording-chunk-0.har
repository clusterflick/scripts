ss=\"block block-system block-system-main-block\">\n  \n    \n      \n\n  \n\n\n\n\n\n  \n  \n  \n\n<article about=\"/southwark-presents\" data-component-id=\"localgov_base:display-full\" class=\"southwark-presents-landing-page node node--promoted node--view-mode-full node--type-southwark-presents-landing-page\">\n\n  <div class=\"lgd-container padding-horizontal\">\n    \n    \n\n    \n    \n      <div class=\"southwark-presents-landing-page__content node__content\">\n        \n<div  class=\"event-hero\">\n    \n<div  class=\"event-intro\">\n    \n<div  class=\"text-wrapper\">\n    <div><div id=\"block-bbd-localgov-breadcrumbs\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Southwark Presents\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Southwark Presents</h1>\n</div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">Find out what&#039;s on in Southwark. From big arts organisations to local community groups, everyone is welcome to submit their cultural events to be listed here.<br />\r\nIf you need any assistance with events or have any questions about Southwark Presents, please email: culture@southwark.gov.uk</div>\n      \n      <div class=\"field field--name-field-ctas field--type-link field--label-hidden field__items\">\n              <div class=