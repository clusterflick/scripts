\">\n  \n    \n      \n            <div class=\"field field--name-field-title field--type-string field--label-hidden field__item\"><h2>Across the borough</h2>\n</div>\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Find out what's on in Southwark</p>\n</div>\n      \n            <div class=\"field field--name-field-block-link field--type-link field--label-hidden field__item\"><a href=\"/southwark-presents\">Southwark Presents</a></div>\n      \n  </div>\n<div id=\"block-bbd-localgov-newsinsouthwarkblock\" class=\"block block-block-content block-block-contentcd4e8b1b-31d8-4a89-a19d-d697a9879653\">\n  \n    \n      \n            <div class=\"field field--name-field-title field--type-string field--label-hidden field__item\"><h2>News in Southwark</h2>\n</div>\n      \n            <div class=\"field field--name-body field--type-text-with-summary field--label-hidden field__item\"><p>Read the latest news</p>\n</div>\n      \n            <div class=\"field field--name-field-block-link field--type-link field--label-hidden field__item\"><a href=\"/news\">News in Southwark</a></div>\n      \n  </div>\n\n    </div>\n\n    \n  </div>\n\n              </div>\n            \n                  </div>\n      </div>\n    </div>\n  </div>\n</header>\n\n\n\n\n\n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--messages region region-messages\">\n\n          <div class=\"lgd-container padding-horizontal\">\n    \n    <div class=\"lgd-region__inner lgd-region__inner--messages\">\n      <div data-drupal-messages-fallback class=\"hidden\"></div>\n\n    </div>\n\n          </div>\n    \n  </div>\n\n\n<main class=\"main\" id=\"main-content\"> \n  \n                    <div>\n      \n  \n  \n  \n\n  <div class=\"lgd-region lgd-region--content region region-content\">\n\n    \n    <div class=\"lgd-region__inner lgd-region__inner--content\">\n      <div id=\"block-bbd-localgov-localgov-mainpagecontent-scarfolk--2\" class=\"block block-system block-system-main-block\">\n  \n    \n      \n\n  \n\n\n\n\n\n  \n  \n  \n\n<article about=\"/southwark-presents\" data-component-id=\"localgov_base:display-full\" class=\"southwark-presents-landing-page node node--promoted node--view-mode-full node--type-southwark-presents-landing-page\">\n\n  <div class=\"lgd-container padding-horizontal\">\n    \n    \n\n    \n    \n      <div class=\"southwark-presents-landing-page__content node__content\">\n        \n<div  class=\"event-hero\">\n    \n<div  class=\"event-intro\">\n    \n<div  class=\"text-wrapper\">\n    <div><div id=\"block-bbd-localgov-breadcrumbs\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Southwark Presents\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Southwark Presents</h1>\n</div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">Find out what&#039;s on in Southwark. From big arts organisations to local community groups, everyone is welcome to submit their cultural events to be listed here.<br />\r\nIf you need any assistance with events or have any questions about Southwark Presents, please email: culture@southwark.gov.uk</div>\n      \n      <div class=\"field field--name-field-ctas field--type-link field--label-hidden field__items\">\n              <div class=\"field__item\"><a href=\"/list-your-event\">Add your event</a></div>\n          </div>\n  \n  </div>\n<div  class=\"image-wrapper\">\n    \n            <div class=\"field field--name-field-media-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_21_9/public/2024-10/ballet-don-quijote-895062_1920.jpg?h=9d6e018e&amp;itok=0m0pvsLS 1x\" media=\"(min-width: 768px)\" type=\"image/jpeg\" width=\"1440\" height=\"620\"/>\n                  <img loading=\"eager\" width=\"600\" height=\"600\" src=\"/sites/default/files/styles/square_medium/public/2024-10/ballet-don-quijote-895062_1920.jpg?h=9d6e018e&amp;itok=8IXvFKGr\" alt=\"A dramatic scene from the ballet Don Quixote\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n            <div class=\"field field--name-field-caption field--type-string field--label-hidden field__item\">Ballet</div>\n      \n</div>\n</div>\n      \n  </div>\n  </div>\n  </div>\n            <div class=\"field field--name-field-events field--type-viewsreference field--label-hidden field__item\"><div class=\"views-element-container\"><div class=\"view view-southwark-events view-id-southwark_events view-display-id-block_1 js-view-dom-id-84f0d88030b294dcdb155f7eb78710ea801e4d268380a57f9e6a64db2191bb8a\">\n  \n    \n        <div class=\"view-filters\">\n      <form class=\"views-exposed-form bef-exposed-form\" data-drupal-selector=\"views-exposed-form-southwark-events-block-1\" action=\"/southwark-presents\" method=\"get\" id=\"views-exposed-form-southwark-events-block-1\" accept-charset=\"UTF-8\">\n  \n\n<div class=\"js-form-item form-item js-form-type-select form-item-event-categories js-form-item-event-categories\">\n      <label for=\"edit-event-categories\">Event type</label>\n          <select data-drupal-selector=\"edit-event-categories\" multiple=\"multiple\" name=\"event_categories[]\" id=\"edit-event-categories\" size=\"9\" class=\"form-select\"><option value=\"All\">All event types</option><option value=\"533\">Latin American Heritage Month</option><option value=\"233\">Black History Month</option><option value=\"269\">Children and families</option><option value=\"124\">Comedy</option><option value=\"160\">Craft</option><option value=\"19\">Dance</option><option value=\"128\">Exhibition</option><option value=\"129\" selected=\"selected\">Film</option><option value=\"130\">Food and drink</option><option value=\"131\">Free</option><option value=\"127\">Health and wellbeing</option><option value=\"132\">Heritage</option><option value=\"133\">Into nature</option><option value=\"126\">Learning</option><option value=\"142\">LGBTQ+</option><option value=\"60\">Libraries</option><option value=\"134\">Markets and fairs</option><option value=\"135\">Music</option><option value=\"141\">Networking and social</option><option value=\"136\">Online events</option><option value=\"137\">Poetry</option><option value=\"138\">Sport and fitness</option><option value=\"139\">Talks</option><option value=\"123\">Theatre</option><option value=\"140\">Visual art</option><option value=\"185\">Walks</option><option value=\"274\">Youth and One Hub</option></select>\n      </div>\n\n\n<div class=\"js-form-item form-item js-form-type-select form-item-event-price js-form-item-event-price\">\n      <label for=\"edit-event-price\">Price</label>\n          <select data-drupal-selector=\"edit-event-price\" id=\"edit-event-price\" name=\"event_price\" class=\"form-select\"><option value=\"All\" selected=\"selected\">- Any -</option><option value=\"1\">Free</option><option value=\"2\">Paid</option><option value=\"41\">Pay what you can</option><option value=\"168\">Special offer</option></select>\n      </div>\n\n\n<div class=\"js-form-item form-item js-form-type-select form-item-localgov-event-locality js-form-item-localgov-event-locality\">\n      <label for=\"edit-localgov-event-locality\">Neighbourhood</label>\n          <select data-drupal-selector=\"edit-localgov-event-locality\" multiple=\"multiple\" name=\"localgov_event_locality[]\" id=\"edit-localgov-event-locality\" size=\"9\" class=\"form-select\"><option value=\"All\">All neighbourhoods</option><option value=\"42\">Bankside</option><option value=\"43\">Bermondsey</option><option value=\"44\">Borough</option><option value=\"50\">Elephant and Castle</option><option value=\"45\">Camberwell</option><option value=\"47\">Denmark Hill</option><option value=\"49\">Dulwich</option><option value=\"239\">East Dulwich</option><option value=\"55\">Nunhead</option><option value=\"56\">Peckham</option><option value=\"57\">Rotherhithe</option><option value=\"58\">Surrey Quays</option><option value=\"59\">Walworth</option></select>\n      </div>\n\n\n<div class=\"js-form-item form-item js-form-type-date form-item-date-min js-form-item-date-min\">\n      <label for=\"edit-date-min\">Min</label>\n          <input class=\"bef-datepicker form-date\" autocomplete=\"off\" data-drupal-selector=\"edit-date-min\" type=\"date\" id=\"edit-date-min\" name=\"date_min\" value=\"\" size=\"30\" />\n\n      </div>\n\n\n<div class=\"js-form-item form-item js-form-type-date form-item-date-max js-form-item-date-max\">\n      <label for=\"edit-date-max\">Max</label>\n          <input class=\"bef-datepicker form-date\" autocomplete=\"off\" data-drupal-selector=\"edit-date-max\" type=\"date\" id=\"edit-date-max\" name=\"date_max\" value=\"\" size=\"30\" />\n\n      </div>\n\n\n<div class=\"js-form-item form-item js-form-type-textfield form-item-search js-form-item-search\">\n      <label for=\"edit-search\">Search</label>\n          <input placeholder=\"Search here\" data-drupal-selector=\"edit-search\" type=\"text\" id=\"edit-search\" name=\"search\" value=\"\" size=\"30\" maxlength=\"128\" class=\"form-text\" />\n\n      </div>\n<div data-drupal-