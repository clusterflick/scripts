.65 64 64 64H104V24C104 10.75 114.7 0 128 0C141.3 0 152 10.75 152 24V64zM48 448C48 456.8 55.16 464 64 464H384C392.8 464 400 456.8 400 448V192H48V448z\"/></svg></span>  <span class=\"localgov-add-to-calendar__trigger-text\">\n    Add to Calendar\n  </span>\n</button>\n\n  <dialog class=\"localgov-add-to-calendar__dialog\">\n    <div class=\"localgov-add-to-calendar__dialog-close\">\n      <button class=\"localgov-add-to-calendar__dialog-close-button\" type=\"button\" name=\"closeAddToCalendarDialog\">\n        Close\n      </button>\n    </div>\n    <div class=\"localgov-add-to-calendar__items\">\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"    https://www.google.com/calendar/r/eventedit?text=Black Feminist Communities: A Conversation with Stella Dadzie and Suzanne Scafe at Una Marson Library\n          &dates=\n              20261020T163000Z\n              /20261020T183000Z\n                  &location=62 Thurlow Street, London, SE17 2GN\n        \" target=\"_blank\" rel=\"nofollow\">Add to Google Calendar</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ADTSTART:20261020T163000Z%0ADTEND:20261020T183000Z%0ASUMMARY:Black Feminist Communities: A Conversation with Stella Dadzie and Suzanne Scafe at Una Marson Library%0ALOCATION: 62 Thurlow Street, London, SE17 2GN%0AEND:VEVENT%0AEND:VCALENDAR\">Add to iCal</a>\n      </div>\n\n      <div class=\"localgov-add-to-calendar__item\">\n        <a href=\"data:text/calendar;charset=utf8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ADTSTART:20261020T163000Z%0ADTEND:20261020T183000Z%0ASUMMARY:Black Feminist Communities: A Conversation with Stella Dadzie and Suzanne Scafe at Una Marson Library%0ALOCATION: 62 Thurlow Street, London, SE17 2GN%0AEND:VEVENT%0AEND:VCALENDAR\">Add to Outlook</a>\n      </div>\n\n    </div>\n  </dialog>\n\n</div>\n\n        \n<div  class=\"event-hero\">\n    \n<div  class=\"event-intro\">\n    \n<div  class=\"text-wrapper\">\n    <a href=\"/southwark-presents\" class=\"link-back\">Back</a>\n<div  class=\"event-intro-wrapper\">\n    <div><div id=\"block-bbd-localgov-breadcrumbs\" class=\"block block-system block-system-breadcrumb-block\">\n  \n    \n      \n  \n\n  <nav class=\"breadcrumbs\" aria-labelledby=\"system-breadcrumbs\">\n    <h2 id=\"system-breadcrumbs\" class=\"visually-hidden\">Breadcrumbs</h2>\n    <ol class=\"breadcrumbs__list\">\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/\">Home</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                      <a class=\"breadcrumbs__link\" href=\"/southwark-presents\">Southwark Presents</a>\n                    </li>\n              <li class=\"breadcrumbs__item\">\n                        Black Feminist Communities: A Conversation with Stella Dadzie and Suzanne Scafe at Una Marson Library\n                  </li>\n                </ol>\n  </nav>\n\n  </div>\n</div>\n\n            <div class=\"field field--name-extra-field-bbd-extra-fields-title field--type-extra-field field--label-hidden field__item\"><h1 class=\"title-field page-title\">Black Feminist Communities: A Conversation with Stella Dadzie and Suzanne Scafe at Una Marson Library</h1>\n</div>\n      \n            <div class=\"share-links-field-wrapper extra-field-wrapper field field--name-extra-field-bbd-extra-fields-share-links field--type-extra-field field--label-hidden field__item\"></div>\n      \n            <div class=\"field field--name-field-summary field--type-string-long field--label-hidden field__item\">  <p>A Conversation with Stella Dadzie and Suzanne Scafe</p>\n\n\n</div>\n      \n  </div>\n  </div>\n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_3_2_2x/public/2026-09/Black-Feminist-Communities-Eventbrite-image.png?h=c855054e&amp;itok=zq4Q1adW 1x\" media=\"(min-width: 768px)\" type=\"image/png\" width=\"1536\" height=\"1024\"/>\n                  <img loading=\"eager\" width=\"768\" height=\"512\" src=\"/sites/default/files/styles/large_3_2_768x512/public/2026-09/Black-Feminist-Communities-Eventbrite-image.png?h=c855054e&amp;itok=nxTwuHMe\" alt=\"Photos of authors Stella Dadzie and Suzanne Scafe\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n</div>\n</div>\n      \n  </div>\n  </div>\n<div  class=\"event-content\">\n    \n<div  class=\"event-column column-first\">\n    \n<div  class=\"date-wrapper\">\n  <h2>Date</h2>\n    \n      <div class=\"field field--name-localgov-event-date field--type-date-recur field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"event-next-date\">\n    <div class=\"field__label\">Date: </div>\n    <p class=\"field field-date date-recur-date\"><time datetime=\"2026-10-20T17:30:00Z\">Tuesday, 20 October 2026</time>\n</p>\n  </div>\n\n      <div class=\"event-time\">\n      <div class=\"field__label\">Time: </div>\n      <p class=\"field field-time date-recur-time\"><time datetime=\"2026-10-20T17:30:00Z\">5:30pm</time>\n - <time datetime=\"2026-10-20T19:30:00Z\">7:30pm</time>\n</p>\n    </div>\n  \n</div>\n          </div>\n  \n  <div class=\"field field--name-field-how-often field--type-string field--label-above\">\n    <div class=\"field__label\">How often</div>\n              <div class=\"field__item\">Once</div>\n          </div>\n\n  </div>\n      <div class=\"field field--name-extra-field-bbd-extra-field-bbd-event-date-slider field--type-extra-field field--label-hidden field__items\">\n              <div class=\"field__item\"></div>\n          </div>\n  \n  <div class=\"field field--name-body field--type-text-with-summary field--label-above\">\n    <div class=\"field__label\">Description</div>\n              <div class=\"field__item\"><p>Join authors Stella Dadzie and Suzanne Scafe for a conversation exploring Black feminist, activism and community organising, and their impact on the communities they serve.</p><p>The event will include a screening of a film about the journey of the East London Black Women’s Organisation (ELBWO), made by The Young Historians, followed by an informal conversation and audience Q&amp;A.</p><p><strong>About the authors:</strong></p><ul><li><strong>Stella Dadzie</strong> is a published writer and feminist historian, best known for The Heart of the Race: Black Women's lives in Britain which won the 1985 Martin Luther King Award for Literature, and was re published by Verso in 2018 as a Feminist Classic. Her work on enslaved women, A Kick in the Belly: Women, Slavery &amp; Resistance was published by Verso in October 2020 to much acclaim. Her latest book, A Whole Heap of Mix Up, was published in October 2025. Stella is a founder member of OWAAD (Organisation of Women of African and Asian Descent), a national umbrella group for Black women that emerged in the late 1970s as part of the British Civil Rights movement. She has been described as one of the “grandmothers“ of Black Feminism in the UK. Her personal archive in Brixton‘s Black Cultural Archives is one of the most visited by researchers and scholars from across the world.</li><li><strong>Suzanne Scafe</strong> has been a life-long educator, working as a teacher in London and the Caribbean. She has taught in community projects, supplementary schools, secondary schools, and in Further and Higher Education institutions. She is the co-author of The Heart of the Race and, most recently, Reading to Resist: Contemporary Black British Women Writers (2026). &nbsp;She is currently a Visiting Professor at the Centre for for Literary and Intermedial Crossings, Vrije Universiteit, Brussel (Free University, Brussels).&nbsp;</li></ul><p>&nbsp;</p></div>\n          </div>\n\n  </div>\n<div  class=\"event-column\">\n    \n<div  class=\"tickets-wrapper\">\n  <h2>Tickets</h2>\n    \n      <div class=\"field field--name-field-ticket-price field--type-entity-reference-revisions field--label-hidden field__items\">\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13205\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n            <div class=\"field field--name-field-name field--type-string field--label-hidden field__item\">General Admission</div>\n      \n            <div class=\"field field--name-field-price field--type-string field--label-hidden field__item\">Free</div>\n      \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13206\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n              <div class=\"field__item\">\n  <div class=\"paragraph paragraph--type--ticket-price clearfix paragraph--view-mode--default\" id=\"ticket_price_13207\">\n    <div class=\"paragraph-inner-holder inner-wrapper\">\n              \n          </div>\n  </div>\n</div>\n          </div>\n  \n            <div class=\"field field--name-field-book-tickets field--type-link field--label-hidden field__item\"><a href=\"https://blackfeminist.eventbrite.co.uk\">https://blackfeminist.eventbrite.co.uk</a></div>\n      \n  </div>\n<div  class=\"how-to-get-wrapper accessibility-wrapper\">\n  <h2>How to get there</h2>\n    \n  <div class=\"field field--name-field-by-bus field--type-string-long field--label-above\">\n    <div class=\"field__label\">By bus</div>\n              <div class=\"field__item\">42, 136, 343</div>\n          </div>\n\n  <div class=\"field field--name-field-by-train field--type-string-long field--label-above\">\n    <div class=\"field__label\">By train</div>\n              <div class=\"field__item\">Nearest station: Elephant &amp; Castle</div>\n          </div>\n\n  <div class=\"field field--name-field-by-tube field--type-string-long field--label-above\">\n    <div class=\"field__label\">By tube</div>\n              <div class=\"field__item\">Nearest station: Elephant &amp; Castle</div>\n          </div>\n\n  </div>\n<div  class=\"accessibility-wrapper\">\n  <h2>Accessibility</h2>\n    \n            <div class=\"field field--name-field-venue-details field--type-link field--label-hidden field__item\"><a href=\"https://www.stelladadzie.com/\">Visit event website</a></div>\n      \n  </div>\n  <div class=\"field field--name-localgov-event-location field--type-entity-reference field--label-above\">\n    <div class=\"field__label\">Location</div>\n              <div class=\"field__item\">\n<article>\n      \n  <div class=\"field field--name-postal-address field--type-address field--label-above\">\n    <div class=\"field__label\">Address</div>\n              <div class=\"field__item\"><p class=\"address\" translate=\"no\"><span class=\"address-line1\">62 Thurlow Street</span><br>\n<span class=\"locality\">London</span><br>\n<span class=\"administrative-area\">Southwark</span><br>\n<span class=\"postal-code\">SE17 2GN</span><br>\n<span class=\"country\">United Kingdom</span></p><a href=\"https://google.com/maps?q=62%20Thurlow%20Street%20London%20SWK%20SE17%202GN%20GB\" class=\"address-map-link\" target=\"_blank\">Show on maps</a></div>\n          </div>\n  </article>\n</div>\n          </div>\n\n  </div>\n  </div>\n<div  class=\"event-content event-content-lower\">\n    \n<div  class=\"event-column column-first-lower\">\n    <div class=\"field--name-field-other-events-like-this\"><div class=\"field__label\">Other events like this</div><div class=\"field--items field__items view view-automate-related-events view-id-automate_related_events view-display-id-block_1\">\n  \n    \n      \n      <div class=\"view-content\">\n          <div class=\"field__item views-row\">\n<article about=\"/southwark-presents/guy-fox-drawing-challenge-canada-water-library\" class=\"node node--type-localgov-event node--promoted node--view-mode-featured-event\">\n  \n  <div class=\"node__content\">\n    <a href=\"/southwark-presents/guy-fox-drawing-challenge-canada-water-library\" class=\"field-group-link card-link\" hreflang=\"en\">\n<div  class=\"image-wrapper\">\n    \n            <div class=\"field field--name-localgov-event-image field--type-entity-reference field--label-hidden field__item\"><div>\n  \n  \n            <div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\">    <picture>\n                  <source srcset=\"/sites/default/files/styles/large_3_2_2x/public/2026-09/Guy%20Fox%201.jpg?h=f6d1b408&amp;itok=FnwHZTgQ 1x\" media=\"(min-width: 768px)\" type=\"image/jpeg\" width=\"1536\" height=\"1024\"/>\n                  <img loading=\"eager\" width=\"768\" height=\"512\" src=\"/sites/default/files/styles/large_3_2_768x512/public/2026-09/Guy%20Fox%201.jpg?h=f6d1b408&amp;itok=RdsPFork\" alt=\"Yellow Background with Image of a Fox\" typeof=\"foaf:Image\" />\n\n  </picture>\n\n</div>\n      \n            <div class=\"field field--name-field-caption field--type-string field--label-hidden field__item\">Guy Fox</div>\n      \n</div>\n</div>\n      \n<div  class=\"tags-wrapper\">\n    \n            <div class=\"field field--name-extra-field-bbd-extra-field-bbd-event-date field--type-extra-field field--label-hidden field__item\"><span class=\"date-field\">28 October 2026</span>\n</div>\n      \n            <div class=\"field field--name-localgov-event-locality field--type-entity-reference field--label-hidden field__item\">Surrey Quays</div>\n      \n  </div>\n  </div>\n<div  class=\"text-wrapper\">\n    \n            <div