.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"PNFFF Short Film Night\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfff-short-film-night%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfff-short-film-night%2F&text=PNFFF%20Short%20Film%20Night\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfff-short-film-night%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Wednesday 09th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">PNFFF Short Film Night</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t8:00PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Peckhamplex Cinema        \t</div>\n\n\t\t\t<div id=\"post-99347\" class=\"post-99347 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-peckham-nunhead-free-film-festival filmfestival-peckham-nunhead cat_peckham-nunhead-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p>At <strong>PeckhamPlex</strong> on <strong>Wednesday 9 September</strong> at <strong>8.00pm</strong> we will host the 3rd edition of our <strong>Short Film Night</strong>. Showcasing local and independent talent with a diverse and varied programme.</p>\n<p><img fetchpriority=\"high\" decoding=\"async\" class=\"aligncenter size-medium wp-image-99348\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-300x300.jpeg\" alt=\"\" width=\"300\" height=\"300\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-300x300.jpeg 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-150x150.jpeg 150w, https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-268x268.jpeg 268w, https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-85x85.jpeg 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026-170x170.jpeg 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026.jpeg 722w\" sizes=\"(max-width: 300px) 85vw, 300px\" /></p>\n<p><strong>Free event, no booking needed. Arrive early to secure a seat.</strong></p>\n<p><em>PeckhamPlex is London’s favourite, and cheapest, independent multiplex cinema which screens blockbuster, independent, foreign language, and art house films every day at an affordable price for all. </em></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t15\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Peckhamplex Cinema </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">95A Rye Lane</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SE15 4ST</span>\n\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/peckhamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://www.twitter.com/freefilmfest\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#40302e262626002632252526292c2d262533342936212c336e2f3227\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n