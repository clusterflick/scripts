"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fsearching-for-sugar-man%2F&text=SEARCHING%20FOR%20SUGAR%20MAN%20%28Limited%20tickets%20%26%238211%3B%20please%20book%20via%20Eventbrite%20%26%238211%3B%20link%20below%29\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fsearching-for-sugar-man%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Tuesday 22nd September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">SEARCHING FOR SUGAR MAN (Limited tickets &#8211; please book via Eventbrite &#8211; link below)</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t7:30PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Love &amp; Dye        \t</div>\n\n\t\t\t<div id=\"post-98668\" class=\"post-98668 tribe_events type-tribe_events status-publish has-post-thumbnail hentry filmfestival-raynes-park\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong><img fetchpriority=\"high\" decoding=\"async\" class=\"size-full wp-image-98669 alignright\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Sugar-Man-web.jpg\" alt=\"\" width=\"225\" height=\"225\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Sugar-Man-web.jpg 225w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Sugar-Man-web-150x150.jpg 150w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Sugar-Man-web-85x85.jpg 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Sugar-Man-web-170x170.jpg 170w\" sizes=\"(max-width: 225px) 85vw, 225px\" />Two men set out to find out what happened to a once-popular musician in this investigative documentary. References to rumours about the singer&#8217;s suicide turn out to be unfounded.</strong></p>\n<p>Space is extremely limited so tickets for this event must be booked at the link below:<br />\n<a href=\"https://www.eventbrite.co.uk/e/1994947687235?aff=oddtdtcreator\">https://www.eventbrite.co.uk/e/1994947687235?aff=oddtdtcreator</a></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tMalik Bendjelloul\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t12\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t86 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2012\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tSweden/UK/Finland\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Love &amp; Dye </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">187 Worple Road</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">Raynes Park</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SW20 8RE</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\t\t\t<dt> Website: </dt>\n\t\t\t<dd class=\"url\"> <a href=\"https://www.loveanddye.com/\" target=\"_blank\">https://www.loveanddye.com/</a> </dd>\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t                        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#c3b1a2