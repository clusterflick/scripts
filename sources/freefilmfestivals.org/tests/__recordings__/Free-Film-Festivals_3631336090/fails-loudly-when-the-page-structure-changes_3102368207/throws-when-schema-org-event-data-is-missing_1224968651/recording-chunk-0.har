film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/Human-Traffic.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/human-traffic/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">09th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Human Traffic</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 9 @ 8:00 pm<br />\n                                        The Carpet Shop\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Human Traffic (1999) comes to The Carpet Shop on Wednesday 9 September as part of the Peckham and Nunhead Free Film Festival. A cult classic&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/human-traffic/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                        