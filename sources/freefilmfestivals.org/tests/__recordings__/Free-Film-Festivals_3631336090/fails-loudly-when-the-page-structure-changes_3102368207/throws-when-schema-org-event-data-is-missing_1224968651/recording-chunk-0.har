als.org%2Fevent%2Fthis-is-spinal-tap-2%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Sunday 20th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">THIS IS SPINAL TAP</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t7:30PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> The Leather Bottle        \t</div>\n\n\t\t\t<div id=\"post-98615\" class=\"post-98615 tribe_events type-tribe_events status-publish has-post-thumbnail hentry filmfestival-raynes-park\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><img fetchpriority=\"high\" decoding=\"async\" class=\"size-medium wp-image-98617 alignright\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-300x198.png\" alt=\"\" width=\"300\" height=\"198\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-300x198.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-768x508.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-580x380.png 580w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-85x56.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website-170x112.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Spinal-Tap-website.png 901w\" sizes=\"(max-width: 300px) 85vw, 300px\" /><strong>Turn it up to 11! Spinal Tap, one of England&#8217;s loudest bands, is chronicled by film director Marty DiBergi (the late Rob Reiner) on what proves to be a fateful tour. </strong></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tRob Reiner\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t15\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t82 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t1984\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUSA\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">The Leather Bottle </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">277 Kingston Rd, London SW19 3NW<