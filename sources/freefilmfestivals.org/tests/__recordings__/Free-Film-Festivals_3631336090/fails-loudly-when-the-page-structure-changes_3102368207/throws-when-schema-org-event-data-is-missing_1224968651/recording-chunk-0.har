ss=\"site-header-menu\">\n                            \n                                                            <nav id=\"site-navigation\" class=\"main-navigation\" role=\"navigation\" aria-label=\"Primary menu\">\n                                    <div class=\"menu-top-left-container\"><ul id=\"menu-top-left\" class=\"primary-menu\"><li id=\"menu-item-27\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-27\"><a href=\"https://freefilmfestivals.org/about-us/\">About</a></li>\n<li id=\"menu-item-678\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-678\"><a href=\"https://freefilmfestivals.org/explore-our-festivals/\">Explore Our Festivals</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-115\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-115\"><a href=\"https://freefilmfestivals.org/filmfestival/new-cross-deptford/\">New Cross &amp; Deptford</a></li>\n\t<li id=\"menu-item-1902\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-1902\"><a href=\"https://freefilmfestivals.org/filmfestival/west-norwood/\">West Norwood</a></li>\n\t<li id=\"menu-item-113\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-113\"><a href=\"https://freefilmfestivals.org/filmfestival/herne-hill/\">Herne Hill</a></li>\n\t<li id=\"menu-item-116\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-116\"><a href=\"https://freefilmfestivals.org/filmfestival/peckham-nunhead/\">Peckham &amp; Nunhead</a></li>\n\t<li id=\"menu-item-318\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-318\"><a href=\"https://freefilmfestivals.org/filmfestival/charlton/\">Charlton &amp; Woolwich</a></li>\n\t<li id=\"menu-item-686\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-686\"><a href=\"https://freefilmfestivals.org/filmfestival/catford/\">Catford</a></li>\n\t<li id=\"menu-item-118\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-118\"><a href=\"https://freefilmfestivals.org/filmfestival/streatham/\">Streatham</a></li>\n\t<li id=\"menu-item-111\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-111\"><a href=\"https://freefilmfestivals.org/filmfestival/camberwell/\">Camberwell</a></li>\n\t<li id=\"menu-item-2667\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-2667\"><a href=\"https://freefilmfestivals.org/filmfestival/beckenham-mansion/\">Beckenham Mansion Family</a></li>\n\t<li id=\"menu-item-9568\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"Crazy Stupid Love (OUTDOORS) &#8211; pre film mixer\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fcrazy-stupid-love-outdoors-pre-film-mixer%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fcrazy-stupid-love-outdoors-pre-film-mixer%2F&text=Crazy%20Stupid%20Love%20%28OUTDOORS%29%20%26%238211%3B%20pre%20film%20mixer\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fcrazy-stupid-love-outdoors-pre-film-mixer%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Thursday 10th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">Crazy Stupid Love (OUTDOORS) &#8211; pre film mixer</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t7:00PM        \t\t\t(Doors open 7pm)\n\t\t\t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> The Manor Arms        \t</div>\n\n\t\t\t<div id=\"post-99637\" class=\"post-99637 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tag-streatham-free-film-festival tribe_events_cat-streatham tribe_events_cat-streatham-free-film-festival filmfestival-streatham cat_streatham cat_streatham-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><img fetchpriority=\"high\" decoding=\"async\" class=\"alignnone  wp-image-99638\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-300x149.png\" alt=\"\" width=\"499\" height=\"248\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-300x149.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-1024x510.png 1024w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-768x382.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-1536x765.png 1536w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-85x42.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-170x85.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-510x253.png 510w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster-1200x598.png 1200w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Crazy-Stupid-Poster.png 1928w\" sizes=\"(max-width: 499px) 85vw, 499px\" /></p>\n<p>&nbsp;</p>\n<p>Love, Laughs &amp; a Little Dutch Courage&#8230;</p>\n<p>Looking for love, new friends, or simply a fun night out? Join us for a special screening of the romantic comedy favourite Crazy, Stupid, Love—with a relaxed pre-film singles social to get the conversation flowing.</p>\n<p>We&#8217;ll be kicking things off in The Snug at The Manor Arms, where you can mingle over a drink and collect a traffic light badge to match your mood:<br />\nGreen – Happy to chat!<br />\nAmber – Maybe&#8230; come and say hello.<br />\nRed – Just here to enjoy the evening.</p>\n<p>Whether you&#8217;re looking for romance, friendship or just a great night with fellow film lovers, everyone is welcome.</p>\n<p>After the social, we&#8217;ll head out to The Manor Arms Beer Garden for an outdoor screening of Crazy, Stupid, Love. Bring a blanket, wrap up warm and settle in for an evening packed with heart, humour and unforgettable performances. It&#8217;s the perfect recipe for a summer night—great company, great cinema and maybe even a little movie magic.</p>\n<p>Bar open throughout.</p>\n<p>Thank you to Youngs &amp; The Manor Arms</p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tGlenn Ficarra, John Requa\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t12\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t1hr 58\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2011\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">The Manor Arms </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">Mitcham Lane</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\t<abbr class=\"tribe-region tribe-events-abbr\" title=\"Streatham\">Streatham</abbr>\n\n\t<span class=\"tribe-postal-code\">SW16 6LQ</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/streathamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://twitter.com/streathamfilm\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#a0d3d4d2c5c1d4c8c1cde0c6d2c5c5c6c9cccdc6c5d3d4c9d6c1ccd38ecfd2c7\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://twitter.com/streathamfilm\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://twitter.com/streathamfilm</a>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+'://platform.twitter.com/widgets.js';fjs.parentNode.insertBefore(js,fjs);}}(document, 'script', 'twitter-wjs');</script></div>\n            <div class=\"fb-like\" data-href=\"http://www.facebook.com/streathamfreefilmfestival\" data-layout=\"button_count\" data-action=\"like\" data-show-faces=\"false\" data-share=\"false\"></div>\n        </div>    \n    \n</div>\n\n<div class=\"sidebar-search sidebar-section\">\n\t<h4>Search</h4>\n    <div class=\"searchpanel\">\n\t\t\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://freefilmfestivals.org/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\" />\n\t</label>\t\n</form>\n    </div>\n</div>\n\n<div class=\"sidebar-news sidebar-section\">\n\t<h4>Latest News</h4>\n    \n    \t\t<div class=\"news_story\">\n\t\t\t<h5><a href=\"https://freefilmfestivals.org/2023/09/01/46-free-film-screenings-in-south-london-begin-today-with-free-film-festivals/\">46 free film screenings in South London begin today, with Free Film Festivals</a></h5>\n            <strong>1st September 2023</strong> - <p>The Free Film Festivals September season begins today! We have 46 film screenings taking place this month across Peckham and Nunhead, Streatham, New Cross &amp;&#8230;</p>\n\t\t\t\n\t\t</div>\n\t    <div class=\"readall\"><a href=\"/category/blog\"><strong>READ ALL</strong></a></div>\n    \n</div>\n\n<div class=\"sidebar-twitter sidebar-section\">\n\t<h4> <span class=\"genericon genericon-twitter\"></span>Latest Tweets</h4>\n        \t<a height=\"200\" data-screen-name=\"StreathamFilm\" class=\"twitter-timeline\" data-theme=\"light\" data-chrome=\"transparent nofooter noheader noborders\"  href=\"https://twitter.com/streathamfilm\" data-widget-id=\"696411500521660416\">Tweets by @@StreathamFilm</a>\n    \t<script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+\"://platform.twitter.com/widgets.js\";fjs.parentNode.insertBefore(js,fjs);}}(document,\"script\",\"twitter-wjs\");</script>          \n    </div>                    </div>\n                </div>\n                \n                <div class=\"divide\"></div>\n                \n                                \n                <div class=\"fff-calendar-container\" style=\"padding-left:0; margin-top:20px;\">\n                \n                \t<div class=\"calendar-heading\">\n\n\t\t\t\t\t\t<a name=\"cal\"></a>\n                        \n\t\t\t\t\t\t<h2>All Events</h2>\n                        \n                        <div class=\"cal-menu\">                    \t\n                            <span class=\"icon-cal\">Calendar</span>\n                            <span class=\"icon-list\">List</span>\n                            <span class=\"icon-images icon-cal-selected\">Images</span>                        \n                        </div>\n                        \n                        <div style=\"clear:both\"></div>\n                                        \t\n                    </div>\n                \t\n                    <div class=\"films\">\n                    \t<div class=\"filmimages\" style=\"display:block\">\t\t\t\t\t\t\t<div class=\"film-image-list col-1\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/Screenshot-2026-08-03-at-11.03.27.png); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://freefilmfestivals.org/event/jurassic-park-outdoors/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"ov