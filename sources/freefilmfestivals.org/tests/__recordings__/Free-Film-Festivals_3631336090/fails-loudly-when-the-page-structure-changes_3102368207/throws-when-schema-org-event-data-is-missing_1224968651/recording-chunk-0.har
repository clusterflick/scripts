\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n    \t\n            \t<div class=\"left-panel-footer col-3\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:30px;\">\n                    \n                    <div class=\"devshare\">\n                    Share\n                    <div class=\"dev-share-buttons\" data-share-title=\"Charlton &amp; Woolwich\" data-share-text=\"Share\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=freefilmfestivals.org%2Ffilmfestival%2Fcharlton%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=freefilmfestivals.org%2Ffilmfestival%2Fcharlton%2F&text=Film%20Festivals%3A%20%3Cspan%3ECharlton%20%26amp%3B%20Woolwich%3C%2Fspan%3E\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=freefilmfestivals.org%2Ffilmfestival%2Fcharlton%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                    </div>\n                    \n                                                \n                                                        \t<h2 style=\"margin-top:40px; margin-bottom:20px;\">Next Festival</h2>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"picture-frame\" style=\"background-image:url(https://freefilmfestivals.org/wp-content/uploads/2017/03/CWFFF2016-780x462.jpg); background-size:cover; background-repeat:no-repeat;\">\n\t\t\t\t\t\t\t\t<img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/picture-frame.png\" alt=\"picture frame\" />\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"picture-title-stuff\">\n\t\t\t\t\t\t\t\t<a href=\"https://freefilmfestivals.org/filmfestival/charlton/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/picture-frame-details.png\" alt=\"picture frame details\" /></a>\n\t\t\t\t\t\t\t\t<div class=\"picture-title-stuff-copy\">\n\t\t\t\t\t\t\t\t\t<h3><a href=\"https://freefilmfestivals.org/filmfestival/charlton/\">Charlton &amp; Woolwich</a></h3>\n\t\t\t\t\t\t\t\t\t<div class=\"film-date\">6-14 September 2024 (TBC)</div>                                \n\t\t\t\t\t\t\t\t</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t</div>                        \n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<div class=\"next-festival-copy\">\n\t\t\t\t\t\t\t<p><strong>Charlton &amp; Woolwich Free Film Festival</strong> is back! Our eighth festival will take place between<strong> 6-14 September 2024 (TBC).</strong> Click on the &#8216;Festival archive&#8217; link below to see what happened last year.</p>\n<p>If you&#8217;d like to<strong> get involved</strong> in planning the <strong>2024 festival</strong> we&#8217;d love to hear from you. Simply contact us (see contact details at the top of the right hand column of this page). We are part of Free Film Festivals, a network of volunteer-powered neighbourhood free film festivals.</p>\n<p>All the ways to contact us or hear about our updates</p>\n<ul>\n<li><span style=\"color: #3366ff;\"><span style=\"color: #0000ff;\"><a style=\"color: #0000ff;\" href=\"https://freefilmfestivals.org/filmfestival/charlton/\" target=\"_blank\" rel=\"noopener\">Website</a></span></span></li>\n<li><span style=\"color: #3366ff;\">Twitter: <a href=\"https://twitter.com/CWFilmFestival\" target=\"_blank\" rel=\"noopener\"><span style=\"color: #3366ff;\">@CWFilmFestival</span></a></span></li>\n<li><span style=\"color: #3366ff;\">Instagram: <a style=\"color: #800080;\" href=\"https://www.instagram.com/charltonwoolwichfff/\" target=\"_blank\" rel=\"noopener\">@CharltonWoolwichFFF</a></span></li>\n<li><span style=\"color: #3366ff;\">Facebook: <a style=\"color: #0000ff;\" href=\"https://www.facebook.com/CharltonWoolwichFFF/\" target=\"_blank\" rel=\"noopener\">@CharltonWoolwichFFF</a></span></li>\n<li><span style=\"color: #3366ff;\">? You can also sign up to our <a href=\"https://freefilmfestivals.us20.list-manage.com/subscribe?u=22294ae6795ba6c7d35e36803&amp;id=1b7ce2bf95\" target=\"_blank\" rel=\"noopener\">mailing list</a><br />\n</span></li>\n</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t                    \n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/CharltonWoolwichFFF/\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://www.twitter.com/CWFilmFestival\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#d2b5b3a4bbbcb7b3a1a6beb7ab92b5bfb3bbbefcb1bdbf\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://www.twitter.com/CWFilmFestival\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://www.twitter.com/CWFilmFestival</a>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+'://platform.twitter.com/widgets.js';fjs.parentNode.insertBefore(js,fjs);}}(document, 'script', 'twitter-wjs');</script></div>\n            <div class=\"fb-like\" data-href=\"https://www.facebook.com/Cha