vals.org/wp-content/themes/freefilmfestivals/images/picture-frame-details.png\" alt=\"picture frame details\" /></a>\n\t\t\t\t\t\t\t\t\t<div class=\"picture-title-stuff-copy\">\n\t\t\t\t\t\t\t\t\t\t<h3><a href=\"https://freefilmfestivals.org/event/mamma-mia/\">Mamma Mia!</a></h3>\n\t\t\t\t\t\t\t\t\t\t<div class=\"film-date\">August 21 @ 8:00 pm</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"film-venue\">St George&#8217;s Garrison Church, Woolwich</div>\n\t\t\t\t\t\t\t\t\t</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n                                \n                                <div class=\"next-festival-copy\">\n\t\t\t\t\t\t\t\t<p>This year we have two Special Screenings around London.</p>\n<p>On behalf of Charlton and Woolwich Free Film Festival we are showing <strong>Mamma Mia!</strong> at the <strong>Garrison Church Charlton on Friday 21st August 2026</strong>.</p>\n<p>We are also showing <strong>Paddington in Peru</strong> (tbc) at <strong>Fortune Green</strong> in North London on <strong>Saturday 22nd August 2026</strong>.</p>\n<p>Please join as at the screenings!</p>\n<p>Other Screenings Free Film Festivals have been involved in:</p>\n<ul>\n<li>The Garrison Church Charlton</li>\n<li>Fortune Green</li>\n<li>The Old Waiting Room</li>\n<li>The Brixton Project</li>\n</ul>\n<p>More screenings coming soon!</p>\n<p>Get in touch if you would like us to power your next screening!</p>\n                                </div>\n\t\t\t\t\t\t\t\t                    \n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t                        \n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t        </div>    \n    \n</div>\n\n<div class=\"sidebar-search sidebar-section\">\n\t<h4>Search</h4>\n    <div class=\"searchpanel\">\n\t\t\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://freefilmfestivals.org/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\" />\n\t</label>\t\n</form>\n    </div>\n</div>\n\n<div class=\"sidebar-news sidebar-section\">\n\t<h4>Latest News</h4>\n    \n    \t\t<div class=\"news_story\">\n\t\t\t<h5><a href=\"https://freefilmfestivals.org/2023/10/14/5-harry-potter-%f0%9f%8e%83-halloween-screening-woolwich-home-movie-day-and-save-the-white-swan/\">CANCELLED: £5 Harry Potter &#8211; 🎃 Hallowe&#8217;en screening, Woolwich + Home Movie Day and Save The White Swan</a></h5>\n            <strong>14th October 2023</strong> - <p>Note that the Harry Potter event has been cancelled. If you&#8217;re subscribed to the Charlton and Woolwich Free Film Festival&#8217;s mailing list you&#8217;ll have received&#8230;</p>\n\t\t\t\n\t\t</div>\n\t    <div class=\"readall\"><a href=\"/category/blog\"><strong>READ ALL</strong></a></div>\n    \n</div>\n\n<div class=\"sidebar-twitter sidebar-section\">\n\t<h4> <span class=\"genericon genericon-twitter\"></span>Latest Tweets</h4>\n        \t<a height=\"200\" data-screen-name=\"freefilmfests\" class=\"twitter-timeline\" data-theme=\"light\" data-chrome=\"transparent nofooter noheader noborders\"  href=\"https://twitter.com/freefilmfests\" data-widget-id=\"696411500521660416\">Tweets by @freefilmfests</a>\n    \t<script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+\"://platform.twitter.com/widgets.js\";fjs.parentNode.insertBefore(js,fjs);}}(document,\"script\",\"twitter-wjs\");</script>              \n    </div>                    </div>\n                </div>\n                \n                <div class=\"divide\"></div>\n    \n   \t\t\t\n   \t\t\t\n   \t\t\t\n   \t\t\t\n   \t\t\t\n    \t\t\t<div class=\"fff-calendar-container\" style=\"padding-left:0;\">\n                \n                \t<div class=\"calendar-heading\">\n\n\t\t\t\t\t\t<a name=\"cal\"></a>\n                        \n\t\t\t\t\t\t<h2>All Events</h2>\n                        \n                        <div class=\"cal-menu\"> \n                            <span class=\"icon-cal\n                                                        \">Calendar</span>\n                            <span class=\"icon-list\">List</span>\n                            <span class=\"icon-images\n                                                        \">Images</span>                                                    \n                        </div>\n                        \n                        <div style=\"clear:both\"></div>\n                                        \t\n                    </div>\n                \t\n                    <div class=\"films\">\n                    \t\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"filmimages\">\t\t\t\t\t\t\t<div class=\"film-image-list col-1\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2022/08/mamma-mia-0-poster_1-scaled.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://freefilmfestivals.org/event/mamma-mia/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n\t\t\t\t\t\t\t\t\t\t<div class=\"mini-film-date\">21st August 2026</div>\t                            \t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<h3 class=\"mini-film-title\">Mamma Mia!</h3>            \n\t\t\t\t\t\t\t\t\t<div class=\"mini-film-venue\">St George&#8217;s Garrison Church, Woolwich<br />\n\t\t\t\t\t\t\t\t\t8:00PM</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\t\t\t\t\n\t\t\t\t\t\t\t</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"film-image-list col-1\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2025/04/PADDINGTON-IN-PERU-1-1-scaled.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"https://freefilmfestivals.org/event/paddington-in-peru-2/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n\t\t\t\t\t\t\t\t\t\t<div class=\"mini-film-date\">22nd August 2026</div>\t                            \t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<h3 class=\"mini-film-title\">Paddington in Peru</h3>            \n\t\t\t\t\t\t\t\t\t<div class=\"mini-film-venue\">Fortune Green<br />\n\t\t\t\t\t\t\t\t\t8:00PM</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\t\t\t\t\n\t\t\t\t\t\t\t</div>\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t                        </div>\n                        \n                        \n                        \n                        <div class=\"filmlist\">    \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2022/08/mamma-mia-0-poster_1-scaled.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/mamma-mia/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">21st August 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Mamma Mia!</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        August 21 @ 8:00 pm<br />\n                                        St George&#8217;s Garrison Church, Woolwich\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Set on an idyllic Greek island, the plot serves as a background for a wealth of ABBA hit songs. Donna, an independent, single mother who&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/mamma-mia/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2025/04/PADDINGTON-IN-PERU-1-1-scaled.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/paddington-in-peru-2/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">22nd August 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Paddington in Peru</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        August 22 @ 8:00 pm<br />\n                                        Fortune Green\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>When Paddington discovers his Aunt Lucy is missing he and the Brown family head to Peru to find her. Join us at Fortune Green for&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/paddington-in-peru-2/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                                    </div>\n                        \n                        \n                        \n                        <div id=\"filmdiv\" class=\"filmcal\"><div class=\"cal-title\"><a href=\"?view=cal&calmonth=7&calyear=2026\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/btn-previous.png\" alt=\"Previous\" /></a>August 2026<a href=\"?view=cal&calmonth=9&calyear=2026\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/btn-next.png\" alt=\"Previous\" /></a></div><table cellpadding=\"0\" cellspacing=\"0\" class=\"calendar\"><tr class=\"calendar-row\"><td class=\"calendar-day-head\">Sun</td><td class=\"calendar-day-head\">Mon</td><td class=\"calendar-day-head\">Tue</td><td class=\"calendar-day-head\">Wed</td><td class=\"calendar-day-head\">Thu</td><td class=\"calendar-day-head\">Fri</td><td class=\"calendar-day-head\">Sat</td></tr><tr class=\"calendar-row\"><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day-np\" style=\"border-top:none;\"> </td><td class=\"calendar-day\" style=\"border-right:none; border-top:none;\"><div class=\"day-number\">1</div></td></tr><tr class=\"calendar-row\"><td class=\"calendar-day\"><div class=\"day-number\">2</div></td><td class=\"calendar-day\"><div class=\"day-number\">3</div></td><td class=\"calendar-day\"><div class=\"day-number\">4</div></td><td class=\"calendar-day\"><div class=\"day-number\">5</div></td><td class=\"calendar-day\"><div class=\"day-number\">6</div></td><td class=\"calendar-day\"><div class=\"day-number\">7</div></td><td class=\"calendar-day\" style=\"border-right:none;\"><div class=\"day-number\">8</div></td></tr><tr class=\"calendar-row\"><td class=\"calendar-day\"><div class=\"day-number\">9</div></td><td class=\"calendar-day\"><div class=\"day-number\">10</div></td><td class=\"calendar-day\"><div class=\"day-number\">11</div></td><td class=\"calendar-day\"><div class=\"day-number\">12</div></td><td class=\"calendar-day\"><div class=\"day-number\">13</div></td><td class=\"calendar-day\"><div class=\"day-number\">14</div></td><td class=\"calendar-day\" style=\"border-right:none;\"><div class=\"day-number\">15</div></td></tr><tr class=\"calendar-row\"