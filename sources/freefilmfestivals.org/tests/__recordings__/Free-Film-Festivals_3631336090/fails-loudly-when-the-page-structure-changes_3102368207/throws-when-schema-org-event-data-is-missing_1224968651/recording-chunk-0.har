u-item-type-taxonomy menu-item-object-filmfestival menu-item-2667\"><a href=\"https://freefilmfestivals.org/filmfestival/beckenham-mansion/\">Beckenham Mansion Family</a></li>\n\t<li id=\"menu-item-9568\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"North of the Sun\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fnorth-of-the-sun%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fnorth-of-the-sun%2F&text=North%20of%20the%20Sun\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fnorth-of-the-sun%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Saturday 19th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">North of the Sun</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t1:00PM        \t\t\t(Doors open 12:30pm)\n\t\t\t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> The Woodfield Pavilion        \t</div>\n\n\t\t\t<div id=\"post-99725\" class=\"post-99725 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tag-streathamfreefilmfestival-sfff2026-northofthesun-documentaryfilm-adventurecinema-surffilm-communitycinema-freefilmfestival-volunteerpoweredcinema tribe_events_cat-streatham tribe_events_cat-streatham-free-film-festival filmfestival-streatham cat_streatham cat_streatham-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p>&nbsp;</p>\n<p><img decoding=\"async\" class=\"alignnone size-medium wp-image-99660\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2-300x166.png\" alt=\"\" width=\"300\" height=\"166\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2-300x166.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2-768x426.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2-85x47.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2-170x94.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/08/North-of-the-Sun-2.png 974w\" sizes=\"(max-width: 300px) 85vw, 300px\" /></p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>🏄❄️🎬 AN ARCTIC ADVENTURE: NORTH OF THE SUN 🎬❄️🏄</p>\n<p>Join Streatham Free Film Festival for a special screening of North of the Sun (Nordfor Sola), the award-winning documentary that combines breathtaking landscapes, surfing adventure and an inspiring story of simple living.</p>\n<p>Following two friends who spend nine months living in a handmade shelter on a remote beach above the Arctic Circle, the film captures an extraordinary journey of self-sufficiency, friendship and connection with nature. Along the way, they uncover the shocking amount of plastic waste washing up on one of the world&#8217;s most beautiful coastlines, turning their adventure into a powerful environmental story.</p>\n<p>Funny, uplifting and visually stunning, North of the Sun is a reminder that some of life&#8217;s greatest adventures come from slowing down and seeing the world differently.</p>\n<p>🎟️ Free entry<br />\n🎬 North of the Sun<br />\n🏄 An award-winning surfing and adventure documentary<br />\n🌍 Inspiring, thought-provoking and beautifully filmed<br />\n🍻 Bar open throughout the evening<br />\n🍿 Popcorn optional, wanderlust guaranteed</p>\n<p>Join us for an unforgettable evening of adventure, environmental discovery and big-screen escapism from the edge of the Arctic.</p>\n<p>#StreathamFreeFilmFestival #SFFF2026 #NorthOfTheSun #DocumentaryFilm #AdventureCinema #SurfFilm #CommunityCinema #FreeFilmFestival #VolunteerPoweredCinema</p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tInge Wegge and Jørn Nyseth Ranum\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tPG\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t46 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2012\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tNorway\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">The Woodfield Pavilion </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">Woodfield Recreation Ground, Tooting Bec Common, 16A Abbotswood Road</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SW16 1AP</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\t\t\t<dt> Website: </dt>\n\t\t\t<dd class=\"url\"> <a href=\"https://www.thewoodfield.org/\" target=\"_blank\">https://www.thewoodfield.org/</a> </dd>\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/streathamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://twitter.com/streathamfilm\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#9deee9eff8fce9f5fcf0ddfbeff8f8fbf4f1f0fbf8eee9f4ebfcf1eeb3f2effa\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://twitter.com/streathamfilm\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://twitter.com/streathamfilm</a>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+'://platform.twitter.com/widgets.js';fjs.parentNode.insertBefore(js,fjs);}}(document, 'script', 'twitter-wjs');</script></div>\n            <div class=\"fb-like\" data-href=\"http://www.facebook.com/streathamfreefilmfestival\" data-layout=\"button_count\" data-actio