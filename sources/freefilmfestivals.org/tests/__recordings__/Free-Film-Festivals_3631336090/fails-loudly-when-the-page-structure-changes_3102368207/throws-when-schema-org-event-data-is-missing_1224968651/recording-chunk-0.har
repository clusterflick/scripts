st-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/Blue-Velvet.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/blue-velvet/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">04th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Blue Velvet</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 4 @ 8:00 pm<br />\n                                        Peckhamplex Cinema\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Join us at Peckhamplex on Friday 4th September as we open up the 17th Peckham &amp; Nunhead Free Film Festival with a special 40th anniversary&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/blue-velvet/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div c