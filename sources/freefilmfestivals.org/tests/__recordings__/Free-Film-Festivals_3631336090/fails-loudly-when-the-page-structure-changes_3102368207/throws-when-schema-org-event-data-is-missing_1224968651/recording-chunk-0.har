       \t\t\t\t\t\t                        \n                        <div class=\"header-festival-logo\">\n                            <a href=\"/filmfestival/peckham-nunhead\"><img src=\"https://freefilmfestivals.org/wp-content/uploads/2025/08/PNFFF-Logo-2025-170x170.jpg\" alt=\"Festival Logo\"/></a>\n                        </div>\n                        <div class=\"header-title\">\n                            <h2><a href=\"/filmfestival/peckham-nunhead\">Peckham &amp; Nunhead<br />Free Film Festival</a></h2>\n                        </div>\n                        <div class=\"header-sub-title\">\n                            <h3><a href=\"/filmfestival/peckham-nunhead\">4th-13th September 2026</a></h3>                            \n                        </div>\n                        \n                                        \n                </div>\n                </div>\n                        \n        \t<div class=\"header-banner-menus\">\n            \n            \t<div class=\"header-banner-menus-inner\">\n                \n                    <div class=\"col-2\">  \n                          \n                        <button id=\"menu-toggle\" class=\"menu-toggle\">Menu</button>\n\n                        <div id=\"site-header-menu\" class=\"site-header-menu\">\n                            \n                                                            <nav id=\"site-navigation\" class=\"main-navigation\" role=\"navigation\" aria-label=\"Primary menu\">\n                                    <div class=\"menu-top-left-container\"><ul id=\"menu-top-left\" class=\"primary-menu\"><li id=\"menu-item-27\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-27\"><a href=\"https://freefilmfestivals.org/about-us/\">About</a></li>\n<li id=\"menu-item-678\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-678\"><a href=\"https://freefilmfestivals.org/explore-our-festivals/\">Explore Our Fest