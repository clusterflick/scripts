onomy menu-item-object-filmfestival menu-item-2667\"><a href=\"https://freefilmfestivals.org/filmfestival/beckenham-mansion/\">Beckenham Mansion Family</a></li>\n\t<li id=\"menu-item-9568\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"Inside Out 2\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Finside-out-2-2%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Finside-out-2-2%2F&text=Inside%20Out%202\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Finside-out-2-2%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Saturday 12th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">Inside Out 2</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t11:00AM        \t\t\t(Doors open 10:30am)\n\t\t\t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Streatham Library        \t</div>\n\n\t\t\t<div id=\"post-99714\" class=\"post-99714 tribe_events type-tribe_events status-publish hentry tag-streathamfreefilmfestival-sfff2026-insideout2-familycinema-communitycinema tribe_events_cat-streatham tribe_events_cat-streatham-free-film-festival filmfestival-streatham cat_streatham cat_streatham-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><img fetchpriority=\"high\" decoding=\"async\" class=\"alignnone  wp-image-99649\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters-300x181.png\" alt=\"\" width=\"424\" height=\"256\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters-300x181.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters-768x463.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters-85x51.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters-170x103.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Inside-Out-Characters.png 998w\" sizes=\"(max-width: 424px) 85vw, 424px\" /></p>\n<p>&nbsp;</p>\n<p>🧠🌈 A JOYFUL FAMILY FILM WITH INSIDE OUT 2 🌈🧠</p>\n<p>Join Streatham Free Film Festival for a special screening of Disney and Pixar&#8217;s Inside Out 2—a heartwarming, hilarious and beautifully animated adventure for all ages.</p>\n<p>Riley is growing up, and her emotions are about to face a whole new challenge as unexpected feelings arrive at Headquarters. Full of humour, imagination and plenty of heart, Inside Out 2 explores the ups and downs of growing up in a way that will resonate with children, parents and anyone who remembers being a teenager.</p>\n<p>Bring the whole family for an uplifting community cinema experience packed with laughs, colourful characters and emotional moments that will stay with you long after the credits roll.</p>\n<p>🎟️ Free entry<br />\n🎬 Buggy parking available<br />\n👨‍👩‍👧‍👦 Perfect for families<br />\n🌟 Funny, moving and full of heart<br />\n🍿 Popcorn optional, emotions guaranteed &#8211; tuck shop open or BYP</p>\n<p>Whether you&#8217;re Team Joy, Anxiety, Sadness or all of the above, don&#8217;t miss this chance to enjoy one of the year&#8217;s most popular family films on the big screen with your local community.</p>\n<p>&nbsp;</p>\n<p>Pre film short &#8211; Hair Love</p>\n<p>#StreathamFreeFilmFestival #SFFF2026 #InsideOut2 #FamilyCinema #CommunityCinema</p>\n<p>&nbsp;</p>\n<p>With thanks to Streatham Library.</p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tKelsey Mann\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tU\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t96 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2023\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUSA\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Streatham Library </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">63 Streatham High Road, Streatham</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\t<abbr class=\"tribe-region tribe-events-abbr\" title=\"Streatham\">Streatham</abbr>\n\n\t<span class=\"tribe-postal-code\">SW16 1PN</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\t\t\t<dt> Website: </dt>\n\t\t\t<dd class=\"url\"> <a href=\"https://funpalaces.co.uk/discover/streatham-librarys-fun-palace/#\" target=\"_blank\">https://funpalaces.co.uk/discover/streatham-librarys-fun-palace/#</a> </dd>\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t