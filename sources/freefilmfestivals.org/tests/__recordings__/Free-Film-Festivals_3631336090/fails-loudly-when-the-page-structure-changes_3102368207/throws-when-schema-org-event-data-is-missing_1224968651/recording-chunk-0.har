my menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"PNFFF’S LATENIGHTFREAKOUT2 Meiko Kaji Double Bill, Featuring…  Blind Woman&#8217;s Curse (1970) &amp; Female Prisoner #701: Scorpion (1972)\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfffs-latenightfreakout2-meiko-kaji-double-bill-featuring-blind-womans-curse-1970-female-prisoner-701-scorpion-1972%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfffs-latenightfreakout2-meiko-kaji-double-bill-featuring-blind-womans-curse-1970-female-prisoner-701-scorpion-1972%2F&text=PNFFF%E2%80%99S%20LATENIGHTFREAKOUT2%20Meiko%20Kaji%20Double%20Bill%2C%20Featuring%E2%80%A6%20%20Blind%20Woman%26%238217%3Bs%20Curse%20%281970%29%20%26amp%3B%20Female%20Prisoner%20%23701%3A%20Scorpion%20%281972%29\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpnfffs-latenightfreakout2-meiko-kaji-double-bill-featuring-blind-womans-curse-1970-female-prisoner-701-scorpion-1972%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Thursday 10th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">PNFFF’S LATENIGHTFREAKOUT2 Meiko Kaji Double Bill, Featuring…  Blind Woman&#8217;s Curse (1970) &amp; Female Prisoner #701: Scorpion (1972)</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t8:00PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> AMP Studios        \t</div>\n\n\t\t\t<div id=\"post-99333\" class=\"post-99333 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-peckham-nunhead-free-film-festival filmfestival-peckham-nunhead cat_peckham-nunhead-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong>Thursday 10 September</strong> at <strong>8pm</strong>, at <strong>AMP Studios, 897a Old Kent Rd, SE15 1NL.</strong></p>\n<p><img fetchpriority=\"high\" decoding=\"async\" class=\"size-medium wp-image-99334 aligncenter\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-300x169.jpeg\" alt=\"\" width=\"300\" height=\"169\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-300x169.jpeg 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-1024x576.jpeg 1024w, https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-768x432.jpeg 768w, https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-85x48.jpeg 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701-170x96.jpeg 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701.jpeg 1200w\" sizes=\"(max-width: 300px) 85vw, 300px\" /></p>\n<p>We commence this Meiko Kaji double bill with the eye-popping visuals and sensational fight sequences of <strong>Blind Woman&#8217;s Curse</strong>! A bizarre blend of the female Yakuza film and traditional Japanese ghost story, with a strong dash of grotesque-erotica. Blind Woman&#8217;s Curse is a delirious mash-up of classic genre tropes, with Meiko Kaji (Lady Snowblood) in her first starring role.</p>\n<p>2nd part of our double bill we have <strong>Female Prisoner #701: Scorpion</strong>, where, after being betrayed by the detective she had fallen in love with, young Matsu (Kaji) is sent to a female prison full of sadistic guards and disobedient prisoners. Enduring gruelling conditions, she becomes determined to escape to exact revenge upon the man who betrayed her.</p>\n<p>Shunya Ito&#8217;s heavily stylised take on the &#8216;women in prison&#8217; picture was where Kaji established the character that would define her career: Scorpion, a symbol of revenge and survival, and an unlikely icon of female strength in a man&#8217;s world. Her near-silent, single-minded pursuit of revenge later becoming a key influence for Quentin Tarantino&#8217;s Kill Bill.</p>\n<p><strong>Free event. No booking needed. Arrive early to secure a seat.</strong></p>\n<p><strong>Doors: 7:00pm, Screening: 8:00pm</strong></p>\n<p><em>AMP Studios is an unusual vintage industrial-style venue in Peckham. The unique architecture and exposed Victorian brickwork tells a story like no other. What was once an unloved storage space under the railway is now a beautiful urban oasis off the Old Kent Road. </em></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tTeruo Ishii (Blind Woman's Curse) / Shunya Ito (Female Prisoner #701: Scorpion)\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t18\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t84 mins  /  87 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t1970 / 1972\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tJapan\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">AMP Studios </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">897a Old Kent Rd</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SE15 1NL</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/peckhamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://www.twitter.com/freefilmfest\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#2c5c424a4a4a6c4a5e49494a4540414a495f58455a4d405f02435e4b\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://www.twitter.com/freefilmfest\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://www.twitter.com/freefilmfest</a>\n    <script data-cfasync=\"false\" src=\"/cdn-