an class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fzootropolis-2-kids-screening%2F&text=ZOOTROPOLIS%202%20%28Kids%2FParents%2FCarers%2FGuardians%20screening%20%26%238211%3B%20booking%20required%29\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fzootropolis-2-kids-screening%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Wednesday 23rd September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">ZOOTROPOLIS 2 (Kids/Parents/Carers/Guardians screening &#8211; booking required)</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t4:00PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Raynes Park Community Church        \t</div>\n\n\t\t\t<div id=\"post-98671\" class=\"post-98671 tribe_events type-tribe_events status-publish has-post-thumbnail hentry filmfestival-raynes-park\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong><img fetchpriority=\"high\" decoding=\"async\" class=\"size-medium wp-image-98672 alignright\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-300x250.png\" alt=\"\" width=\"300\" height=\"250\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-300x250.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-1024x853.png 1024w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-768x640.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-85x71.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-170x142.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web-1200x1000.png 1200w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Zootopia-2-web.png 1253w\" sizes=\"(max-width: 300px) 85vw, 300px\" />Brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.</strong></p>\n<p><strong><em>This is a screening for parents/guardians and kids. Booking via Eventbrite is essential at the link below:<br />\n<a href=\"https://www.eventbrite.co.uk/e/1994949899853?aff=oddtdtcreator\">https://www.eventbrite.co.uk/e/1994949899853?aff=oddtdtcreator</a><br />\n</em></strong></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t Jared Bush, Byron Howard\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tPG\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t108 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2025\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUSA\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Raynes Park Community Church </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">496 Kingston Rd, Raynes Park</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SW20 8DX</span>\n\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t                        <a target=\"_blank\" href=\"/cd