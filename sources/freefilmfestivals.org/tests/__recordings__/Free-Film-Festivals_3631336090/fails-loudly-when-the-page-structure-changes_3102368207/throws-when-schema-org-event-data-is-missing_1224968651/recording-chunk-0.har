onomy menu-item-object-filmfestival menu-item-111\"><a href=\"https://freefilmfestivals.org/filmfestival/camberwell/\">Camberwell</a></li>\n\t<li id=\"menu-item-2667\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-2667\"><a href=\"https://freefilmfestivals.org/filmfestival/beckenham-mansion/\">Beckenham Mansion Family</a></li>\n\t<li id=\"menu-item-9568\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"Pre-Festival Film Pub Quiz\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpre-festival-film-pub-quiz-2%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpre-festival-film-pub-quiz-2%2F&text=Pre-Festival%20Film%20Pub%20Quiz\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fpre-festival-film-pub-quiz-2%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Wednesday 02nd September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">Pre-Festival Film Pub Quiz</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t8:00PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> The Ivy House        \t</div>\n\n\t\t\t<div id=\"post-99353\" class=\"post-99353 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-peckham-nunhead-free-film-festival filmfestival-peckham-nunhead cat_peckham-nunhead-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p>As we return for the 17th Peckham &amp; Nunhead Free Film Festival, join us on <strong>Wednesday 2nd September</strong> at <strong>8.00pm</strong> at <strong>The Ivy House, 40 Stuart Rd, Nunhead SE15 3BE</strong> for a great warm up to get you in the right mood, a <strong>film-themed pub quiz</strong>!</p>\n<p><img fetchpriority=\"high\" decoding=\"async\" class=\"aligncenter size-medium wp-image-58584\" src=\"https://freefilmfestivals.org/wp-content/uploads/2025/08/film-quiz-300x232.jpeg\" alt=\"\" width=\"300\" height=\"232\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2025/08/film-quiz-300x232.jpeg 300w, https://freefilmfestivals.org/wp-content/uploads/2025/08/film-quiz-85x66.jpeg 85w, https://freefilmfestivals.org/wp-content/uploads/2025/08/film-quiz-170x131.jpeg 170w, https://freefilmfestivals.org/wp-content/uploads/2025/08/film-quiz.jpeg 357w\" sizes=\"(max-width: 300px) 85vw, 300px\" /></p>\n<p>Free to enter, with prizes to be won! Tell your friends and loved ones and get a team together of <strong>maximum 6 people</strong>. All welcome from film buffs to novices. Pre-booking your table is <strong>highly recommended</strong> by contacting the lovely people at The Ivy House pub <a href=\"https://bookings.designmynight.com/book?source=partner&amp;venue_id=5f02e92bd4ea515f107acedd\">here</a>.</p>\n<p><em>The Ivy House (in its current guise) was founded in 2013 after the building was saved by residents and locals from impending residential demolishment. We are lucky to have our home be a Grade-II listed building and the first in London (and possibly the UK) to be listed as an Asset of Community Value.</em></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">The Ivy House </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">40 Stuart Road</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SE15 3BE</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/peckhamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://www.twitter.com/freefilmfest\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#f78799919191b791859292919e9b9a919284839e81969b84d9988590\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://www.twitter.com/freefilmfest\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://www.twitter.com/freefilmfest</a>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+'://platform.twitter.com/widgets.js';fjs.parentNode.insertBefore(js,fjs);}}(document, 'script', 'twitter-wjs');</script></div>\n            <div class=\"fb-like\" data-href=\"https://www.facebook.com/peckhamfreefilmfestival\" data-layout=\"button_count\" data-action=\"like\" data-show-faces=\"false\" data-share=\"false\"></div>\n        </div>    \n    \n</div>\n\n<div class=\"sidebar-search sidebar-section\">\n\t<h4>Search</h4>\n    <div class=\"searchpanel\">\n\t\t\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://freefilmfestivals.org/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\" />\n\t</label>\t\n</form>\n    </div>\n</div>\n\n<div class=\"sidebar-news sidebar-section\">\n\t<h4>Latest News</h4>\n    \n    \t\t<div class=\"news_story\">\n\t\t\t<h5><a href=\"https://freefilmfestivals.org/2026/04/26/short-film-open-call-peckham-nunhead-2026/\">Short Film Open Call Peckham &amp; Nunhead Festival 2026</a></h5>\n            <strong>26th April 2026</strong> - <p>Short Film Open Call Peckham &amp; Nunhead Festival 2026 is now live. The Peckham &amp; Nunhead Free Film Festival (PNFFF) 2026 is excited to announce&#8230;</p>\n\t\t\t\n\t\t</div>\n\t    <div class=\"readall\"><a href=\"/category/blog\"><strong>READ ALL</strong></a></div>\n    \n</div>\n\n<div class=\"sidebar-twitter sidebar-section\">\n\t<h4> <span class=\"genericon genericon-twitter\"></span>Latest Tweets</h4>\n        \t<a height=\"200\" data-screen-name=\"FreeFilmFest\" class=\"twitter-timeline\" data-theme=