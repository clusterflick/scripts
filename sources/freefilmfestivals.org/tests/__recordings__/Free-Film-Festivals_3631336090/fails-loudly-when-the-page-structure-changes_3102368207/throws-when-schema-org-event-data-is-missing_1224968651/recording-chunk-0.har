mg src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"MINARI\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fminari%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fminari%2F&text=MINARI\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fminari%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Thursday 24th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">MINARI</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t7:30PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Poppy&#8217;s Funerals        \t</div>\n\n\t\t\t<div id=\"post-98676\" class=\"post-98676 tribe_events type-tribe_events status-publish has-post-thumbnail hentry filmfestival-raynes-park\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong><img fetchpriority=\"high\" decoding=\"async\" class=\"size-medium wp-image-98678 alignright\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-300x239.png\" alt=\"\" width=\"300\" height=\"239\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-300x239.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-1024x815.png 1024w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-768x611.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-85x68.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-170x135.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web-1200x955.png 1200w, https://freefilmfestivals.org/wp-content/uploads/2026/07/Minari-web.png 1452w\" sizes=\"(max-width: 300px) 85vw, 300px\" />In this touching Oscar nominated film a Korean American family moves to an Arkansas farm in search of its own American dream. Amidst the challenges of new life in the strange and rugged Ozarks, they discover the undeniable resilience of family and what really makes a home.</strong></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t Lee Isaac Chung\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t12\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t115 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2020\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUSA\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Poppy&#8217;s Funerals </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">46 Coombe Ln, Raynes Park</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">SW20 0LA</span>\n\n\t<span class=\"tribe-country-name\">United Kingdom</span>\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\