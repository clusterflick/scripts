festivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"Wiener Dog\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fweiner-dog%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fweiner-dog%2F&text=Wiener%20Dog\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fweiner-dog%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Saturday 19th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">Wiener Dog</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t1:00PM        \t\t\t(Doors open 12:30pm)\n\t\t\t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> The Mud Room, 25 Leigham Ct Rd, London SW16 2ND        \t</div>\n\n\t\t\t<div id=\"post-99632\" class=\"post-99632 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tag-streathamfreefilmfestival-sfff2026-wienerdog-dogfriendlylondon-freefilmfestival-themudroom-volunteerpoweredcinema tag-streatham tribe_events_cat-streatham tribe_events_cat-streatham-free-film-festival filmfestival-streatham cat_streatham cat_streatham-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><img fetchpriority=\"high\" decoding=\"async\" class=\"alignnone wp-image-99633\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car-300x212.png\" alt=\"\" width=\"451\" height=\"319\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car-300x212.png 300w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car-768x543.png 768w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car-85x60.png 85w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car-170x120.png 170w, https://freefilmfestivals.org/wp-content/uploads/2026/08/Weiner-dog-car.png 992w\" sizes=\"(max-width: 451px) 85vw, 451px\" /></p>\n<p>🐾🎬 DOG-FRIENDLY FILM SCREENING : WIENER-DOG 🎬🐾</p>\n<p>Join Streatham Free Film Festival for a tail-waggingly unique screening of Wiener-Dog at The Mud Room dog grooming parlour!</p>\n<p>This darkly funny and wonderfully offbeat film follows one dachshund on an unexpected journey through a series of lives, loves and misadventures. Screening it in a real dog grooming parlour makes this one of the most fitting venues of the festival—and yes, well-behaved dogs are very welcome to attend.</p>\n<p>Bring your canine companion, meet fellow dog lovers, and enjoy a free movie in one of Streatham&#8217;s most unusual pop-up screening spaces.</p>\n<p>🐶 Dog-friendly screening<br />\n🎟️ Free entry<br />\n📍 The Mud Room, Streatham<br />\n🎬 Wiener-Dog<br />\n🍿 Popcorn optional, dogs encouraged</p>\n<p>Join us for an unforgettable evening of cinema, community and canine charm.</p>\n<p>Doors open 30 mins before the film start time</p>\n<p>#StreathamFreeFilmFestival #SFFF2026 #WienerDog #DogFriendlyLondon #FreeFilmFestival #TheMudRoom #VolunteerPoweredCinema</p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tTodd Solondz\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t15\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t88 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t2016\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUSA\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">The Mud Room, 25 Leigham Ct Rd, London SW16 2ND </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">The Mud Room, 25 Leigham Court Road</span>\n\t\n\t\t<span class=\"tribe-delimiter\">,</span>\n\t\t<span class=\"tribe-locality\">London</span><span class=\"tribe-delimiter\">,</span>\n\n\n\t<span class=\"tribe-postal-code\">25 Leigham SW16 2ND</span>\n\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"