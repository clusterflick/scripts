rwell</a></li>\n\t<li id=\"menu-item-2667\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-2667\"><a href=\"https://freefilmfestivals.org/filmfestival/beckenham-mansion/\">Beckenham Mansion Family</a></li>\n\t<li id=\"menu-item-9568\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9568\"><a href=\"https://freefilmfestivals.org/filmfestival/other/\">Other Screenings</a></li>\n\t<li id=\"menu-item-51732\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-51732\"><a href=\"https://freefilmfestivals.org/filmfestival/raynes-park/\">Raynes Park</a></li>\n\t<li id=\"menu-item-9572\" class=\"menu-item menu-item-type-taxonomy menu-item-object-filmfestival menu-item-9572\"><a href=\"https://freefilmfestivals.org/filmfestival/south-social/\">South Social</a></li>\n</ul>\n</li>\n<li id=\"menu-item-2570\" class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-2570\"><a href=\"/whats-on/?view=cal\">What&#8217;s On</a></li>\n</ul></div>                                </nav><!-- .main-navigation -->\n                                                        \n                        </div><!-- .site-header-menu -->\n                    </div>\n                    \n                    \n                    \n                    <div class=\"col-2\">        \n                        <div class=\"top-navigation menualignright\" aria-label=\"Top Right Menu\">\n                            <div class=\"menu-top-right-container\"><ul id=\"menu-top-right\" class=\"top-menu\"><li id=\"menu-item-680\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-680\"><a href=\"https://freefilmfestivals.org/start-a-festival/\">Start A Festival</a></li>\n<li id=\"menu-item-31\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-31\"><a href=\"https://freefilmfestivals.org/get-involved/\">Get Involved</a></li>\n<li id=\"menu-item-30\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-30\"><a href=\"https://freefilmfestivals.org/contact-us/\">Contact</a></li>\n</ul></div>                        </div>                                            \n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"header-banner-logo\">\n            \t<a href=\"https://freefilmfestivals.org/\" rel=\"home\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/round-logo.png\" alt=\"Free Film Festivals Logo\"/></a>\n            </div>\n        \t\n            \n            \n        </div>\t            \n\n<div id=\"content\" class=\"site-content\" style=\"position:relative;\">\n \n\t<div class=\"content-topper\">\n    \t&nbsp;\n    </div>\n    \n \t<div class=\"site-content-inner\">   \n \n \t\t\n        <div id=\"primary\" class=\"content-area\">\n            <main id=\"main\" class=\"site-main\" role=\"main\">\n            \n            \t<div class=\"left-panel-main col-3\" style=\"padding-top:0px;\">\n                \t<div class=\"left-panel-main-inner\" style=\"padding-top:25px;\">\n                    \n                                            <div class=\"devshare\">\n                        Share\n                        <div class=\"dev-share-buttons\" data-share-title=\"The Slumber Party Massacre\" data-share-text=\"\"><a target=\"_blank\" href=\"https://www.facebook.com/sharer.php?u=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fthe-slumber-party-massacre%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--facebook\"><span class=\"genericon genericon-facebook\"></span></a> <a target=\"_blank\" href=\"https://twitter.com/intent/tweet?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fthe-slumber-party-massacre%2F&text=The%20Slumber%20Party%20Massacre\" class=\"dev-share-buttons__item dev-share-buttons__item--twitter\"><span class=\"genericon genericon-twitter\"></span></a> <a target=\"_blank\" href=\"https://plus.google.com/share?url=https%3A%2F%2Ffreefilmfestivals.org%2Fevent%2Fthe-slumber-party-massacre%2F\" class=\"dev-share-buttons__item dev-share-buttons__item--google\"><span class=\"genericon genericon-google\"></span></a> </div> \n                        </div>\n                                        \n                    <div id=\"tribe-events\" class=\"tribe-no-js\" data-live_ajax=\"1\" data-datepicker_format=\"0\" data-category=\"\" data-featured=\"\"><div class=\"tribe-events-before-html\"></div><span class=\"tribe-events-ajax-loading\"><img class=\"tribe-events-spinner-medium\" src=\"https://freefilmfestivals.org/wp-content/plugins/the-events-calendar/src/resources/images/tribe-loading.gif\" alt=\"Loading Events\" /></span>\t\t\t\t\t\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<!-- Notices -->\n\t\n\t<h2 class=\"tribe-events-single-event-date\">Saturday 12th September 2026</h2>\n    \n\t<h1 class=\"tribe-events-single-event-title\">The Slumber Party Massacre</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\t\n    \n    \t    \t\t            \t<span class=\"tribe-events-cost\">Free</span>\n\t            <span class=\"free\">(No ticket required - First come first served)</span>            \n\t\t\t\t</div>\n    \n    <div class=\"tribe-time-header tribe-clearfix\">\t\t\n\t\t7:00PM        \t</div>\n    \n    <div class=\"tribe-venue-header tribe-clearfix\">\t\t\n    \t        \t<span>INDOOR:</span> Feminist Library        \t</div>\n\n\t\t\t<div id=\"post-99363\" class=\"post-99363 tribe_events type-tribe_events status-publish has-post-thumbnail hentry tribe_events_cat-peckham-nunhead-free-film-festival filmfestival-peckham-nunhead cat_peckham-nunhead-free-film-festival\">\n\t\t\t\n            <!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong>The Slumber Party Massacre</strong> (1982) comes to the <strong>Feminist Library</strong> on <strong>Saturday 12 September</strong> for a special screening celebrating this cult slasher classic.</p>\n<p><img fetchpriority=\"high\" decoding=\"async\" class=\"aligncenter size-medium wp-image-99365\" src=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-300x169.jpg\" alt=\"\" width=\"300\" height=\"169\" srcset=\"https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-300x169.jpg 300w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-1024x576.jpg 1024w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-768x432.jpg 768w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-1536x864.jpg 1536w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-85x48.jpg 85w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-170x96.jpg 170w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre-1200x675.jpg 1200w, https://freefilmfestivals.org/wp-content/uploads/2026/07/the-slumber-party-massacre.jpg 1920w\" sizes=\"(max-width: 300px) 85vw, 300px\" /></p>\n<p>Directed by Amy Holden Jones and written by feminist author Rita Mae Brown, <em>The Slumber Party Massacre</em> follows a group of high school friends whose sleepover takes a terrifying turn when an escaped serial killer begins stalking the neighbourhood. Blending suspense, dark humour and sharp social commentary, the film has earned a lasting reputation as both an entertaining slasher and a clever subversion of the genre&#8217;s conventions.</p>\n<p><em>The Feminist Library is a unique community archive and event space in South London, home to one of the UK&#8217;s most significant collections of feminist literature and history. Now in its 51st year, the Feminist Library is home to a renowned archive and a vibrant programme of talks, workshops, screenings and community events. </em></p>\n\t\t\t</div>\n            \n            <!-- .tribe-events-single-event-description -->\n\t\t\t\n\t\t\t<!-- Event meta -->\n\t\t\t\t\t\t\n\t\t\t\n\t<div class=\"tribe-events-single-section tribe-events-event-meta primary tribe-clearfix\">\n\n\n<div class=\"tribe-events-meta-group tribe-events-meta-group-other\">\n\t<h3 class=\"tribe-events-single-section-title\"> Other </h3>\n\t<dl>\n\t\t\t\t\t<dt> Director </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tAmy Holden Jones\t\t\t</dd>\n\t\t\t\t\t<dt> Certificate </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t18\t\t\t</dd>\n\t\t\t\t\t<dt> Running Time </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t76 mins\t\t\t</dd>\n\t\t\t\t\t<dt> Year </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\t1982\t\t\t</dd>\n\t\t\t\t\t<dt> Country </dt>\n\t\t\t<dd class=\"tribe-meta-value\">\n\t\t\t\tUnited States\t\t\t</dd>\n\t\t\t</dl>\n</div>\n<div class=\"tribe-events-meta-group tribe-events-meta-group-venue\">\n\t<dl>\n\t\t\n\t\t<dd class=\"tribe-venue\">Feminist Library </dd>\n\n\t\t\t\t\t<dd class=\"tribe-venue-location\">\n\t\t\t\t<address class=\"tribe-events-address\">\n\t\t\t\t\t<span class=\"tribe-address\">\n\n<span class=\"tribe-street-address\">Sojourner Truth Centre, 161 Sumner Road</span>\n\t\n\n\n\t<span class=\"tribe-postal-code\">SE15 6JL</span>\n\n\n</span>\n\t\t\t\t\t\n\t\t\t\t</address>\n\t\t\t</dd>\n\t\t\n\t\t\n\t\t\n\t\t\t</dl>\n</div>\n\n\t</div>\n\n\n\t\t\t\n                        \t\t\n            \n\t\t</div> <!-- #post-x -->\n\t\t\t\t\n\n</div><!-- #tribe-events-content -->\n\t\t\t\t\t<div class=\"tribe-events-after-html\"></div></div><!-- #tribe-events -->\n<!--\nThis calendar is powered by The Events Calendar.\nhttp://evnt.is/18wn\n-->\n                \t\n                    </div>\n                </div>\n                \n                <div id=\"sidepanel-right\" class=\"right-panel-main col-1\">\n                \t<div class=\"right-panel-main-inner\">\n                \t<div class=\"sidebar-contact sidebar-section\">\n\t<h4>Contact</h4>\n    <div class=\"sidebar-social\">\n    \t        <a target=\"_blank\" href=\"https://www.facebook.com/peckhamfreefilmfestival\"><span class=\"genericon genericon-facebook-alt\"></span></a>        <a target=\"_blank\" href=\"https://www.twitter.com/freefilmfest\"><span class=\"genericon genericon-twitter\"></span></a>        <a target=\"_blank\" href=\"/cdn-cgi/l/email-protection#3e4e505858587e584c5b5b58575253585b4d4a57485f524d10514c59\"><span class=\"genericon genericon-mail\"></span></a>\n\t\t\n        \n    </div>\n    \n    <div style=\"margin-top:30px;\">        \n\t    <div><a href=\"https://twitter.com/https://www.twitter.com/freefilmfest\" class=\"twitter-follow-button\" data-show-count=\"false\" data-size=\"large\">Follow @https://www.twitter.com/freefilmfest</a>\n    <script data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"></script><script>!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0],p=/^http:/.test(d.location)?'http':'https';if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src=p+'://platform.twitter.com/widgets.js';fjs.parentNode.insertBefore(js,fjs);}}(document, 'script', 'twitter-wjs');</script></div>\n            <div class=\"fb-like\" data-href=\"https://www.facebook.com/peckhamfreefilmfestival\" data-layout=\"button_count\" data-action=\"like\" data-show-faces=\"false\" data-share=\"false\"></div>\n        </div>    \n    \n</div>\n\n<div class=\"sidebar-search sidebar-section\">\n\t<h4>Search</h4>\n    <div class=\"searchpanel\">\n\t\t\n<form role=\"search\" method=\"get\" class=\"search-form\" action=\"https://freefilmfestivals.org/\">\n\t<label>\n\t\t<span class=\"screen-reader-text\">Search for:</span>\n\t\t<input type=\"search\" class=\"search-field\" placeholder=\"Search &hellip;\" value=\"\" name=\"s\" title=\"Search for:\" />\n\t</label>\t\n</form>\n    </div>\n</div>\n\n<div class=\"sideba