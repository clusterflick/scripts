alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">04th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Blue Velvet</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 4 @ 8:00 pm<br />\n                                        Peckhamplex Cinema\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Join us at Peckhamplex on Friday 4th September as we open up the 17th Peckham &amp; Nunhead Free Film Festival with a special 40th anniversary&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/blue-velvet/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/Blair-Witch-Project.jpeg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/the-blair-witch-project/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">05th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">The Blair Witch Project</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 5 @ 8:30 pm<br />\n                                        Nunhead Cemetery\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Returning to one of the most popular venues in the 17 year history of the Peckham and Nunhead Free Film Festival, this years film was&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/the-blair-witch-project/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/a-bugs-life.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/a-bugs-life-2/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">06th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">A Bug&#8217;s Life</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 6 @ 2:30 pm<br />\n                                        Buchan Road TRA Community Hall\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>A film for all the family at Buchan Hall, 86 Buchan Road, London SE15 3HQ on Sunday 6th September, at 2.30pm with a screening of&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/a-bugs-life-2/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/the-mastermind.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/the-mastermind/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">06th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">The Mastermind</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 6 @ 7:30 pm<br />\n                                        The Ivy House\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Sunday 6th September, at 7.30pm, at The Ivy House, 40 Stuart Rd, Nunhead, SE15 3BE. Following its triumphant premiere at Cannes, filmmaker Kelly Reichardt delivers&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/the-mastermind/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/paddington-2.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/paddington-2-4/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">07th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Paddington 2</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 7 @ 7:30 pm<br />\n                                        Christ Church Peckham\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>The film festival presents a modern classic with a British icon, recently voted one of the country’s favourite family films, Paddington 2, at Christ Church&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/paddington-2-4/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/moonlight.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/moonlight-3/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">07th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Moonlight</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 7 @ 8:30 pm<br />\n                                        Watson’s General Telegraph\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>The free film festival for the first time comes to local gem Watson’s General Telegraph, 108 Forest Hill Rd, London SE22 0RS on Monday 7th&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/moonlight-3/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/the-scratchings.jpeg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/the-scratchings-screening-film-quiz/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">08th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">The Scratchings &#8211; Screening &amp; Film Quiz</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 8 @ 7:30 pm<br />\n                                        The Man of Kent\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Join us for the premiere of The Scratchings on Tuesday 8th September, 7pm at The Man of Kent, 4 Nunhead Green, London, SE15 3QF. This&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/the-scratchings-screening-film-quiz/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/burning-an-illusion.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/burning-an-illusion/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">08th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Burning An Illusion</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 8 @ 8:00 pm<br />\n                                        Peckham Palms\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Join us on Tuesday 8 September at Peckham Palms (Peckham Palms Arcade, 1-14 Bournemouth Close, London, SE15 4PB) for Menelik Shabazz’s debut Burning An Illusion&#8230;.</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/burning-an-illusion/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/Human-Traffic.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/human-traffic/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">09th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Human Traffic</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 9 @ 8:00 pm<br />\n                                        The Carpet Shop\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Human Traffic (1999) comes to The Carpet Shop on Wednesday 9 September as part of the Peckham and Nunhead Free Film Festival. A cult classic&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/human-traffic/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/PNFFF-Event-Form-Short-Film-Night-2026.jpeg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/pnfff-short-film-night/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">09th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">PNFFF Short Film Night</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 9 @ 8:00 pm<br />\n                                        Peckhamplex Cinema\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>At PeckhamPlex on Wednesday 9 September at 8.00pm we will host the 3rd edition of our Short Film Night. Showcasing local and independent talent with&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/pnfff-short-film-night/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/female-prisoner-701.jpeg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/pnfffs-latenightfreakout2-meiko-kaji-double-bill-featuring-blind-womans-curse-1970-female-prisoner-701-scorpion-1972/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">10th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">PNFFF’S LATENIGHTFREAKOUT2 Meiko Kaji Double Bill, Featuring…  Blind Woman&#8217;s Curse (1970) &amp; Female Prisoner #701: Scorpion (1972)</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 10 @ 8:00 pm<br />\n                                        AMP Studios\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>Thursday 10 September at 8pm, at AMP Studios, 897a Old Kent Rd, SE15 1NL. We commence this Meiko Kaji double bill with the eye-popping visuals&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/pnfffs-latenightfreakout2-meiko-kaji-double-bill-featuring-blind-womans-curse-1970-female-prisoner-701-scorpion-1972/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/08/labyrinth.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/labyrinth-3/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">11th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">Labyrinth</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 11 @ 8:30 pm<br />\n                                        Brenchley Gardens Community Centre\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>The film festival presents a night of magic under the stars with an outdoor screening of Jim Henson’s classic modern-day fairytale Labyrinth, at 8.30pm, adjacent&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/labyrinth-3/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2024/08/One-Minute-Film-Challenge-scaled.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/one-minute-film-challenge-2/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">12th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">One Minute Film Challenge</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 12 @ 10:00 am<br />\n                                        Mountview Academy of Theatre Arts\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>An introduction to filmmaking that allows participants to create &amp; produce a narrative piece limited to 1 minute in edited length. They will utilise industry&#8230;</p>\n\t\n                                        <div class=\"readmore\">\n                                            <a href=\"https://freefilmfestivals.org/event/one-minute-film-challenge-2/\">Read More</a>\n                                        </div> \t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\t\t\t\t\t\n                                </div>\t\t\t\t\n                            </div>\n                                \n                            <div class=\"film-list-list\">\n                                <div class=\"col-1\">\n                                    <div class=\"highlight-white\" style=\"background:url(https://freefilmfestivals.org/wp-content/uploads/2026/07/the-invisibles.jpg); background-repeat:no-repeat; background-position:center top; background-size:cover\">\n                                        <a href=\"https://freefilmfestivals.org/event/rough-as-owt-cinema-workshop-hosted-by-sean-grundy-writer-director-of-new-musical-film-the-invisibles/\"><img src=\"https://freefilmfestivals.org/wp-content/themes/freefilmfestivals/images/event-window-white.png\" alt=\"overlay\" /></a>                                \n                                        <div class=\"mini-film-date\">12th September 2026</div>\t                            \t\t\t\t\t\n                                    </div>\n                                </div>                                \n                                <div class=\"col-3 detail-list\">\n                                    <h3 class=\"mini-film-title\">rOUGH (aS oWT) cINEMA wORKSHOP: Hosted by Sean Grundy, writer/director of new Musical film tHE iNVISIBLES</h3>            \n                                    <div class=\"mini-film-venue\">\n                                        September 12 @ 2:00 pm<br />\n                                        Mountview Academy of Theatre Arts\t\t\t\t\t\t\t\t\t\t\t\n                                    </div>\t\n                                    <div class=\"mini-film-copy\">\n                                        <p>