          "content": {
            "mimeType": "text/plain; charset=utf-8",
            "text": "[\n  {\n    \"name\": \"QUEERHUB Festival\",\n    \"url\": \"https://queerhub.uk/festival\",\n    \"events\": [\n      {\n        \"id\": \"queerhub-2026-10-23\",\n        \"title\": \"QUEERHUB Film Festival: Friday\",\n        \"venue\": \"lfs.org.uk\",\n        \"start\": \"2026-10-23T18:00\",\n        \"url\": \"https://queerhub.uk/festival\",\n        \"description\": \"Across the two nights, the programme combines shared screenings with a different curated film block each evening, followed by a filmmaker Q&A. After the screenings, the evening opens up into a more relaxed space for conversation, with snacks, filmmakers, guests and the wider QUEERHUB community coming together beyond the screen.\",\n        \"films\": [\n          {\n            \"title\": \"The Swimsuit\",\n            \"directors\": [\"Amina Krami\"],\n            \"year\": 2025\n          },\n          { \"title\": \"Fan Letter\", \"directors\": [\"Zeb Daemen\"], \"year\": 2024 },\n          {\n            \"title\": \"Clean Slate\",\n            \"directors\": [\"Emily May Jampel\"],\n            \"year\": 2025\n          },\n          {\n            \"title\": \"Fish & Chips\",\n            \"directors\": [\"Macadie Amoroso\"],\n            \"year\": 2026\n          },\n          {\n            \"title\": \"At the Twilight of Dawns\",\n            \"directors\": [\"Tomy Cadic\"],\n            \"year\": 2025\n          },\n          {\n            \"title\": \"THIS TOWN AIN'T BIG ENOUGH FOR THE BOTH OF US\",\n            \"directors\": [\"Ben Stitch\"],\n            \"year\": 2026\n          },\n          {\n            \"title\": \"Quinn\",\n            \"directors\": [\"Stefano Usberghi\", \"Gianluca Mangiasciutti\"],\n            \"year\": 2026\n          }\n        ]\n      },\n      {\n        \"id\": \"queerhub-2026-10-24\",\n        \"title\": \"QUEERHUB Film Festival: Saturday\",\n        \"venue\": \"lfs.org.uk\",\n        \"start\": \"2026-10-24T17:30\",\n        \"url\": \"https://queerhub.uk/festival\",\n        \"description\": \"Across the two nights, the programme combines shared screenings with a different curated film block each evening, followed by a filmmaker Q&A. After the screenings, the evening opens up into a more relaxed space for conversation, with snacks, filmmakers, guests and the wider QUEERHUB community coming together beyond the screen.\",\n        \"films\": [\n          {\n            \"title\": \"Full Fat\",\n            \"directors\": [\"Louisa Connolly-Burnham\"],\n            \"year\": 2026\n          },\n          {\n            \"title\": \"The Motorcycle\",\n            \"directors\": [\"Matteo Giampetruzzi\"],\n            \"year\": 2025\n          },\n          {\n            \"title\": \"Midnight Bloom\",\n            \"directors\": [\"Adam Fergler\"],\n            \"year\": 2026\n          },\n          {\n            \"title\": \"You and Me makes Three\",\n            \"directors\": [\"Emmalie El fadli\"],\n            \"year\": 2025\n          },\n          { \"title\": \"Cris\", \"directors\": [\"Jonay García\"], \"year\": 2025 },\n          {\n            \"title\": \"A Tattoo\",\n            \"directors\": [\"Kamil Dobrosielski\"],\n            \"year\": 2026\n          },\n          { \"title\": \"Baby Talk\", \"directors\": [\"Lizzie Cater\"], \"year\": 2025 },\n          { \"title\": \"Magic 8\", \"directors\": [\"Robyn Faye\"], \"year\": 2026 }\n        ]\n      }\n    ]\n  }\n]\n",
