perty=\"og:description\" content=\"Classic Christmas films screened inside hidden forest cinemas in beautiful venues across the country.\"/><meta property=\"og:url\" content=\"https://www.enchantedchristmascinema.co.uk\"/><meta property=\"og:site_name\" content=\"Enchanted Christmas Cinema\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:image\" content=\"https://www.enchantedchristmascinema.co.uk/images/venues/york.jpg\"/><meta property=\"og:image:alt\" content=\"Enchanted Christmas Cinema — York\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Enchanted Christmas Cinema\"/><meta name=\"twitter:description\" content=\"Classic Christmas films screened inside hidden forest cinemas in beautiful venues across the country.\"/><meta name=\"twitter:image\" content=\"https://www.enchantedchristmascinema.co.uk/images/venues/york.jpg\"/><link rel=\"icon\" href=\"/icon.png?42955e7308e4936d\" type=\"image/png\" sizes=\"512x512\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?42955e7308e4936d\" type=\"image/png\" sizes=\"512x512\"/><meta name=\"next-size-adjust\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" noModule=\"\"></script></head><body><noscript><img height=\"1\" width=\"1\" style=\"display:none\" src=\"https://www.facebook.com/tr?id=1354231593278965&amp;ev=PageView&amp;noscript=1\" alt=\"\"/></noscript><canvas id=\"snow-canvas\" aria-hidden=\"true\"></canvas><main class=\"onsale_page__OR_gw\"><header class=\"SiteHeader_bar__q7Gwt \"><a class=\"SiteHeader_logo__XTR9l \" aria-label=\"Enchanted Christmas Cinema home\" tabindex=\"-1\" href=\"/\"><img src=\"/images/logo-circle.png\" alt=\"\" width=\"48\" height=\"48\"/></a><nav class=\"SiteHeader_nav__xC76B \" aria-label=\"Main\"><a href=\"/#locations\">Venues</a><a href=\"#faqs\">FAQs</a><a href=\"#contact\">Contact</a></nav><div class=\"SiteHeader_actions__nI1Mb\"><a href=\"#tickets\" class=\"SiteHeader_book__4gm3G\">Book now</a><button type=\"button\" class=\"SiteHeader_menuButton__TVn_0\" aria-expanded=\"false\" aria-label=\"Open menu\"><span></span><span></span><span></span></button></div></header><section class=\"onsale_hero__9DwUj\"><img src=\"/images/venues/camden.jpg\" alt=\"Camden, London\" class=\"onsale_heroImg__tI6hq\"/><div class=\"onsale_heroFade__Gs2hQ\" aria-hidden=\"true\"></div><a aria-label=\"Enchanted Christmas Cinema home\" href=\"/\"><img alt=\"Enchanted Christmas Cinema\" loading=\"lazy\" width=\"1672\" height=\"941\" decoding=\"async\" data-nimg=\"1\" class=\"onsale_heroLogo__mB7OH\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=1920&amp;q=75&amp;dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75&amp;dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=3840&amp;q=75&amp;dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\"/></a></section><div class=\"onsale_header__842g2\" id=\"about\"><h1 class=\"section-title\">Camden, London</h1><p class=\"onsale_subtitle__Y1Vom\">11th – 24th Dec</p><p class=\"onsale_runNote__nbykR\">Limited two-week run</p><p class=\"onsale_blurb__mJAEz\">Set inside an abandoned cinema in the heart of Camden, you&#x27;ll have to explore woodland tunnels to find a cosy forest cinema complete with a bar serving mulled wine, popcorn and festive treats, where it snows before every screening.</p></div><section class=\"TVScreen_section___jJxt\" aria-label=\"A peek inside\"><div class=\"TVScreen_tv__0OS9O \"><button type=\"button\" class=\"TVScreen_screen__2du3A\" aria-label=\"Switch the TV off\" aria-pressed=\"true\"><video src=\"/videos/camden-tv.mp4\" autoPlay=\"\" muted=\"\" playsInline=\"\" preload=\"auto\" class=\"TVScreen_video__F83Qv\" aria-label=\"Inside an Enchanted Christmas Cinema\"></video><span class=\"TVScreen_dot__u7sBK\" aria-hidden=\"true\"></span></button><img src=\"/images/tv-frame.webp\" alt=\"\" class=\"TVScreen_frame__odwJb\" aria-hidden=\"true\"/></div></section><div class=\"onsale_pricesBlock__cz923\"><button type=\"button\" class=\"onsale_pricesLink__Z35VN\"><div class=\"TicketPricing_row__vxAjV\"><div class=\"TicketPricing_ticket__8z2HM\"><div class=\"TicketPricing_label__m_3U7\">Adult</div><div class=\"TicketPricing_price__bJYYx\">£19</div></div><div class=\"TicketPricing_ticket__8z2HM\"><div class=\"TicketPricing_label__m_3U7\">Child</div><div class=\"TicketPricing_price__bJYYx\">£14</div><div class=\"TicketPricing_subLabel__pWDP0\">(under 12)</div></div></div><p class=\"onsale_pricesFootnote__29Myz\">Prices may vary by screening.</p></button></div><section class=\"PosterCarousel_section__Biccm\" aria-label=\"Films showing at Camden, London\"><div class=\"PosterCarousel_track__aYynQ\"><button type=\"button\" class=\"PosterCarousel_card__otObK\"><img src=\"/images/posters/elf.jpg\" alt=\"Elf\"/><div class=\"PosterCarousel_overlay__EyqiJ\"></div><span class=\"PosterCarousel_title__1z9U0\">Elf</span></button><button type=\"button\" class=\"PosterCarousel_card__otObK\"><img src=\"/images/posters/home-alone.jpg\" alt=\"Home Alone\"/><div class=\"PosterCarousel_overlay__EyqiJ\"></div><span class=\"PosterCarousel_title__1z9U0\">Home Alone</span></button><button type=\"button\" class=\"PosterCarousel_card__otObK\"><img src=\"/images/posters/muppet-christmas-carol.jpg\" alt=\"The Muppet Christmas Carol\"/><div class=\"PosterCarousel_overlay__EyqiJ\"></div><span class=\"PosterCarousel_title__1z9U0\">The Muppet Christmas Carol</span></button><button type=\"button\" class=\"PosterCarousel_card__otObK\"><img src=\"/images/posters/love-actually.jpg\" alt=\"Love Actually\"/><div class=\"PosterCarousel_overlay__EyqiJ\"></div><span class=\"PosterCarousel_title__1z9U0\">Love Actually</span></button><button type=\"button\" class=\"PosterCarousel_card__otObK\"><img src=\"/images/posters/the-holiday.jpg\" a