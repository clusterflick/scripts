gs\\\":[{\\\"time\\\":\\\"12:00\\\",\\\"film\\\":\\\"The Grinch\\\",\\\"poster\\\":\\\"/images/posters/the-grinch.jpg\\\"},{\\\"time\\\":\\\"14:00\\\",\\\"film\\\":\\\"The Muppet Christmas Carol\\\",\\\"poster\\\":\\\"/images/posters/muppet-christmas-carol.jpg\\\"},{\\\"time\\\":\\\"16:00\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"},{\\\"time\\\":\\\"18:15\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"20:15\\\",\\\"film\\\":\\\"Love Actually\\\",\\\"poster\\\":\\\"/images/posters/love-actually.jpg\\\"}]},{\\\"key\\\":\\\"2026-12-21\\\",\\\"label\\\":\\\"Mon 21st Dec\\\",\\\"screenings\\\":[{\\\"time\\\":\\\"12:00\\\",\\\"film\\\":\\\"The Muppet Christmas Carol\\\",\\\"poster\\\":\\\"/images/posters/muppet-christmas-carol.jpg\\\"},{\\\"time\\\":\\\"14:00\\\",\\\"film\\\":\\\"The Nightmare Before Christmas\\\",\\\"poster\\\":\\\"/images/posters/nightmare-before-christmas.jpg\\\"},{\\\"time\\\":\\\"16:00\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"18:15\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"},{\\\"time\\\":\\\"20:15\\\",\\\"film\\\":\\\"The Holiday\\\",\\\"poster\\\":\\\"/images/posters/the-holiday.jpg\\\"}]},{\\\"key\\\":\\\"2026-12-22\\\",\\\"label\\\":\\\"Tue 22nd Dec\\\",\\\"screenings\\\":[{\\\"time\\\":\\\"12:00\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"},{\\\"time\\\":\\\"14:00\\\",\\\"film\\\":\\\"The Muppet Christmas Carol\\\",\\\"poster\\\":\\\"/images/posters/muppet-christmas-carol.jpg\\\"},{\\\"time\\\":\\\"16:00\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"},{\\\"time\\\":\\\"18:15\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"20:15\\\",\\\"film\\\":\\\"Love Actually\\\",\\\"poster\\\":\\\"/images/posters/love-actually.jpg\\\"}]},{\\\"key\\\":\\\"2026-12-23\\\",\\\"label\\\":\\\"Wed 23rd Dec\\\",\\\"screenings\\\":[{\\\"time\\\":\\\"12:00\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"14:00\\\",\\\"film\\\":\\\"How the Grinch Stole Christmas\\\",\\\"poster\\\":\\\"/images/posters/how-the-grinch-stole-christmas.jpg\\\"},{\\\"time\\\":\\\"16:00\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"18:15\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"},{\\\"time\\\":\\\"20:15\\\",\\\"film\\\":\\\"The Holiday\\\",\\\"poster\\\":\\\"/images/posters/the-holiday.jpg\\\"}]},{\\\"key\\\":\\\"2026-12-24\\\",\\\"label\\\":\\\"Thu 24th Dec\\\",\\\"screenings\\\":[{\\\"time\\\":\\\"12:00\\\",\\\"film\\\":\\\"The Muppet Christmas Carol\\\",\\\"poster\\\":\\\"/images/posters/muppet-christmas-carol.jpg\\\"},{\\\"time\\\":\\\"14:00\\\",\\\"film\\\":\\\"Home Alone\\\",\\\"poster\\\":\\\"/images/posters/home-alone.jpg\\\"},{\\\"time\\\":\\\"16:00\\\",\\\"film\\\":\\\"Elf\\\",\\\"poster\\\":\\\"/images/posters/elf.jpg\\\"}]}]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"Quote_section__dHB5c\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"wrap\\\",\\\"children\\\":[\\\"$\\\",\\\"blockquote\\\",null,{\\\"children\\\":[\\\"“\\\",\\\"It’s a great family tradition and the perfect way to kick off Christmas.\\\",\\\"”\\\"]}]}]}],[\\\"$\\\",\\\"$L15\\\",null,{\\\"venueName\\\":\\\"Camden\\\",\\\"categories\\\":[{\\\"category\\\":\\\"General\\\",\\\"items\\\":[{\\\"question\\\":\\\"Is the cinema indoors?\\\",\\\"answer\\\":[\\\"Yes! You certainly don't need to worry about the weather when visiting our venue. The experience and cinema screen are all located indoors.\\\"]},{\\\"question\\\":\\\"Is there an age restriction?\\\",\\\"answer\\\":[\\\"The recommended age for the experience is 4 years and over. Kids' prices are available for select shows, and babes in arms are welcome. Please note that there is limited buggy storage on site, and buggies are not permitted inside the cinema or experience. All property left unattended is at your own risk.\\\",\\\"Anyone aged 17 or under must be accompanied by an adult aged 18 or over at all times (this includes within the cinema). Age certification for films applies regardless. For 15 and 18 rated films, our staff are legally required to ask for proof that you are old enough to watch an age-restricted film if they have any doubt. To prove your age, we require official ID that includes a photo and date of birth, such as a passport or driving licence.\\\"]},{\\\"question\\\":\\\"Is food and drink included in my ticket?\\\",\\\"answer\\\":[\\\"Food and drink aren't included in your ticket, but you won't go short! Our cosy bar serves mulled wine, alcoholic and soft drinks, popcorn and festive treats, so grab your favourites before the film starts. There's no hot food, but you're in the heart of Camden, with plenty of places to eat before or after your show.\\\"]},{\\\"question\\\":\\\"Can I bring my own food and drink to the venue?\\\",\\\"answer\\\":[\\\"We're afraid not! We have plenty of cinema snacks and drink options available, so you won't be short of festive treats!\\\"]},{\\\"question\\\":\\\"How do I redeem my pre-purchased food and drink?\\\",\\\"answer\\\":[\\\"You can redeem your pre-purchased food and drink at any of our bars when ordering. Easy peasy!\\\"]}]},{\\\"category\\\":\\\"Getting here\\\",\\\"items\\\":[{\\\"question\\\":\\\"Where is the venue located?\\\",\\\"answer\\\":[\\\"Enchanted Christmas Cinema is located at The Plaza, 14 The Parkway, London NW1 7AA.\\\"]},{\\\"question\\\":\\\"What time should I arrive?\\\",\\\"answer\\\":[\\\"Please arrive at least 30 minutes before your show start time, so you have enough time to get your drinks and snacks before finding your seats. Films start promptly at the time on your ticket (no 20 minutes of adverts like at a standard cinema).\\\"]},{\\\"question\\\":\\\"What are the nearest transport links?\\\",\\\"answer\\\":[\\\"The Plaza is right by Camden Town station, so it's easy to reach by public transport.\\\",\\\"Tube: Camden Town (Northern line) is the closest station, just a few minutes' walk away. Mornington Crescent (Northern line) is also nearby, roughly a 10-minute walk.\\\",\\\"Overground: Camden Road station is around a 12-minute walk.\\\",\\\"Bus: Several routes stop close by, including the 27, 88, 134, 214 and 253.\\\",\\\"We recommend using [Citymapper](https://citymapper.com) or the [TfL Journey Planner](https://tfl.gov.uk/plan-a-journey/) to plan your journey in advance.\\\"]},{\\\"question\\\":\\\"Is there parking?\\\",\\\"answer\\\":[\\\"We don't have parking at the venue, and street parking in Camden is limited, so we'd recommend travelling by public transport if you can.\\\",\\\"If you'd prefer to drive, you can pre-book a space at a nearby car park through [JustPark](https://www.justpark.com/uk/parking/london/camden-town/NW1-7NB/).\\\",\\\"Camden is outside the Congestion Charge zone, but please check [TfL's website](https://tfl.gov.uk) for any other charges that might apply to your vehicle.\\\"]}]},{\\\"category\\\":\\\"Facilities\\\",\\\"items\\\":[{\\\"question\\\":\\\"Is there a cloakroom?\\\",\\\"answer\\\":[\\\"There are no cloakroom or luggage storage facilities on site. Bags larger than A4 are not permitted. If you are planning on arriving with luggage, we advise using luggage storage facilities before you arrive.\\\"]},{\\\"question\\\":\\\"Are buggies allowed?\\\",\\\"answer\\\":[\\\"Buggies are not permitted inside the cinema or experience. However, there is limited buggy storage available in the communal areas of the venue. All property left unattended is at your own risk.\\\"]},{\\\"question\\\":\\\"What happens when I arrive?\\\",\\\"answer\\\":[\\\"Your tickets will be scanned as you arrive, so please make sure they are downloaded and ready to scan. Screenshots of tickets will not be accepted. Once you have entered the venue, you will have a chance to get your snacks and drinks before exploring the woodland tunnels to the enchanted forest cinema.\\\"]}]},{\\\"category\\\":\\\"Ticketing\\\",\\\"items\\\":[{\\\"question\\\":\\\"What's the difference in seating?\\\",\\\"answer\\\":[\\\"All standard seats are priced the same and are allocated with a row and seat number. The auditorium is purpose-built for these kinds of events, so all seats have a fantastic view of the screen. There is also a limited supply of cosy sofa seats in each screening, charged at a premium price.\\\"]},{\\\"question\\\":\\\"I can't find my tickets\\\",\\\"answer\\\":[\\\"Your tickets are emailed to you as soon as you complete your booking. If you can't see the email, please check your spam or junk folder. The email includes a QR code, and you can add it to Apple Wallet or Google Wallet by opening the email on your phone.\\\",\\\"Still can't find them? Email us at hello@enchantedchristmascinema.co.uk with the name and email address you booked with, and we'll help.\\\"]},{\\\"question\\\":\\\"Do you offer free tickets for carers?\\\",\\\"answer\\\":[\\\"Carer tickets are free of charge. When booking your chosen date, please select the carer ticket option from the drop-down menu. Each carer ticket must be purchased with at least one other full-price ticket. Access cards will be checked when your tickets are scanned.\\\"]},{\\\"question\\\":\\\"I can no longer attend, can I get a refund?\\\",\\\"answer\\\":[\\\"All ticket sales are final and non-refundable, except in extreme circumstances (please get in touch and we'll review this on a case-by-case basis).\\\"]},{\\\"question\\\":\\\"Can I exchange my tickets?\\\",\\\"answer\\\":[\\\"Yes, subject to availability, you can exchange your ticket for a different date up to 7 days before your original screening, directly through the Beyonk ticketing system.\\\"]}]},{\\\"category\\\":\\\"Accessibility\\\",\\\"items\\\":[{\\\"question\\\":\\\"Is the venue wheelchair accessible?\\\",\\\"answer\\\":[\\\"Unfortunately, this venue is not wheelchair accessible. The building is older and has a lot of stairs, and its original lift is no longer in use, so there is no step-free route to the cinema.\\\",\\\"Our experience takes guests on a long, winding route through the building to reach the screening. A shorter route is available for guests with limited mobility, but please be aware that there are stairs on every route, including the shorter one.\\\",\\\"If you're unsure whether the venue will work for you or someone in your party, please get in touch at hello@enchantedchristmascinema.co.uk before booking and we'll be happy to talk you through what to expect.\\\"]},{\\\"question\\\":\\\"What should I expect during the experience?\\\",\\\"answer\\\":[\\\"This is not your standard cinema. There will be lights, decorations and possible use of haze and snow machines. You will explore dark and small spaces, and some surfaces may be uneven due to the use of bark and woodland theming.\\\",\\\"If you have any concerns and would like a full breakdown of what will happen at the experience, please contact us at hello@enchantedchristmascinema.co.uk.\\\"]}]},{\\\"category\\\":\\\"Contact\\\",\\\"items\\\":[{\\\"question\\\":\\\"How do I contact you?\\\",\\\"answer\\\":[\\\"Hello@EnchantedChristmasCinema.co.uk\\\"]}]}]}],[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"Footer_footer__pQtti\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lc\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"Footer_logo__fUEOF\\\",\\\"aria-label\\\":\\\"Enchanted Christmas Cinema home\\\",\\\"children\\\":[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"/images/logo-circle.png\\\",\\\"alt\\\":\\\"\\\",\\\"width\\\":\\\"84\\\",\\\"height\\\":\\\"84\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"Footer_social__cGivK\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"http