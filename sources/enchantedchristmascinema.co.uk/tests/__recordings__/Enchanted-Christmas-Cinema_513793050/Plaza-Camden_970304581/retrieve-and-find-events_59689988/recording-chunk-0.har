            "text": "<!DOCTYPE html><html lang=\"en\" class=\"__variable_b930d9 __variable_f4296f __variable_1b579c __variable_9d9336\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/5c0c2bcbaa4149ca-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/942a3b44c5e07f09-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/a65324f02aa278dc-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/eaead17c7dbfcd5d-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"https://www.facebook.com/tr?id=1354231593278965&amp;ev=PageView&amp;noscript=1\"/><link rel=\"preload\" as=\"image\" href=\"/images/venues/york.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/logo.png\"/><link rel=\"preload\" as=\"image\" href=\"/images/venues/southampton.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/venues/camden.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/home-alone.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/elf.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/love-actually.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/the-holiday.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/muppet-christmas-carol.jpg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c445fced2a89bef3.css?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/4af5087dc7a64fca.css?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/18f1e6cd2f34dd2f.css?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-72618b5fc15e0ee5.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\"/><script src=\"/_next/static/chunks/fd9d1056-e3d373074663785d.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/117-b47c3a4ff87e93d3.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-2dcde4753ea0d175.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/972-e0f47e4c479dc526.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-fd0d0435544efb65.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/3-f13fbeb38ee19037.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-d6e30be5f0036e28.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" async=\"\"></script><link rel=\"preload\" href=\"https://orbmcp.com/orb.js\" as=\"script\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/the-grinch.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/nightmare-before-christmas.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/miracle-on-34th-street.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/films/how-the-grinch-stole-christmas.jpg\"/><link rel=\"preload\" as=\"image\" href=\"/images/logo-circle.png\"/><title>Enchanted Christmas Cinema</title><meta name=\"description\" content=\"Classic Christmas films screened inside hidden, candlelit forest cinemas. Three UK cities this winter — York, Southampton and Camden, London. York tickets on sale now.\"/><meta property=\"og:title\" content=\"Enchanted Christmas Cinema\"/><meta property=\"og:description\" content=\"Classic Christmas films screened inside hidden forest cinemas in beautiful venues across the country.\"/><meta property=\"og:url\" content=\"https://www.enchantedchristmascinema.co.uk\"/><meta property=\"og:site_name\" content=\"Enchanted Christmas Cinema\"/><meta property=\"og:locale\" content=\"en_GB\"/><meta property=\"og:image\" content=\"https://www.enchantedchristmascinema.co.uk/images/venues/york.jpg\"/><meta property=\"og:image:alt\" content=\"Enchanted Christmas Cinema — York\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Enchanted Christmas Cinema\"/><meta name=\"twitter:description\" content=\"Classic Christmas films screened inside hidden forest cinemas in beautiful venues across the country.\"/><meta name=\"twitter:image\" content=\"https://www.enchantedchristmascinema.co.uk/images/venues/york.jpg\"/><link rel=\"icon\" href=\"/icon.png?42955e7308e4936d\" type=\"image/png\" sizes=\"512x512\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png?42955e7308e4936d\" type=\"image/png\" sizes=\"512x512\"/><meta name=\"next-size-adjust\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js?dpl=dpl_Go5QdHqMn6BJpjJ1UNkhMZ9fRdb1\" noModule=\"\"></script></head><body><noscript><img height=\"1\" width=\"1\" style=\"display:none\" src=\"https://www.facebook.com/tr?id=1354231593278965&amp;ev=PageView&amp;noscript=1\" alt=\"\"/></noscript><canvas id=\"snow-canvas\" aria-hidden=\"true\"></canvas><main><section class=\"Hero_hero__bqvNd\"><img src=\"/images/venues/york.jpg\" alt=\"Inside an Enchanted Christmas Cinema screening\" class=\"Hero_bg__CkeFF\"/><div class=\"Hero_fade__YY26S\" aria-hidden=\"true\"></div><div class=\"Hero_sparkle__KUXA9\" aria-hidden=\"true\"></div><img src=\"/images/logo.png\" alt=\"Enchanted Christmas Cinema\" class=\"Hero_logo__1CbeS\"/><div class=\"Hero_content__WDVga\"><h1>Discover a Hidden<br/>Forest Cinema…</h1><p class=\"Hero_sub__mpF_z\">Classic Christmas films screened in<br/>truly magical venues, this winter.</p><a href=\"#locations\" class=\"Hero_scrollCue__HovjE\" aria-label=\"Scroll to locations\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 30 30\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 6L15 16L26 6\" stroke=\"#e6c65c\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path><path d=\"M4 16L15 26L26 16\" stroke=\"#e6c65c\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\"0.55\"></path></svg></a></div></section><section class=\"Tagline_section___X__i\"><div class=\"wrap\"><p>This Christmas, discover a brand new way to enjoy your favourite festive films. We&#x27;re turning beautiful indoor venues around the country into hidden enchanted forest cinemas, packed full of surprises, creating the perfect setting for your Christmas movie traditions!</p></div></section><section id=\"locations\" class=\"VenueTickets_section__sJnUx\"><div class=\"wrap\"><div class=\"VenueTickets_heading__yI7Lp\"><h2 class=\"section-title\">LOCATIONS</h2></div><div class=\"VenueTickets_grid__lh0jS\"><a class=\"VenueTickets_ticket__Ktu0U\" href=\"/venue/southampton-onsale\"><div class=\"VenueTickets_imageWrap__OMFDd\"><img src=\"/images/venues/southampton.jpg\" alt=\"Southampton\"/><div class=\"VenueTickets_imageOverlay__cYmCX\"></div><span class=\"VenueTickets_ribbon__3ltEM\">On sale now</span><h3 class=\"VenueTickets_cityName__NCM39\">Southampton</h3><p class=\"VenueTickets_imageDates__pNHWb\">16th – 18th Dec</p></div><div class=\"VenueTickets_info__Oxovu\"><p class=\"VenueTickets_blurb__GHGMX\">Teaming up with renowned music venue Turner Sims, we have transformed this music hall into an enchanted forest cinema where you will enjoy a live music performance and snowfall before every screening.</p><span class=\"VenueTickets_button__vGz2X \">Book now<svg width=\"16\" height=\"10\" viewBox=\"0 0 16 10\" aria-hidden=\"true\"><path d=\"M1 5H15M15 5L11 1M15 5L11 9\" stroke=\"currentColor\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></a><a class=\"VenueTickets_ticket__Ktu0U\" href=\"/venue/york-onsale\"><div class=\"VenueTickets_imageWrap__OMFDd\"><img src=\"/images/venues/york.jpg\" alt=\"York\"/><div class=\"VenueTickets_imageOverlay__cYmCX\"></div><span class=\"VenueTickets_ribbon__3ltEM\">On sale now</span><h3 class=\"VenueTickets_cityName__NCM39\">York</h3><p class=\"VenueTickets_imageDates__pNHWb\">21st – 23rd Dec</p></div><div class=\"VenueTickets_info__Oxovu\"><p class=\"VenueTickets_blurb__GHGMX\">Set in a secret 100-year-old auditorium inside the Yorkshire Museum, you&#x27;ll find a cosy woodland setting complete with a bar serving mulled wine, popcorn and festive treats, where it snows before every screening.</p><span class=\"VenueTickets_button__vGz2X \">Book now<svg width=\"16\" height=\"10\" viewBox=\"0 0 16 10\" aria-hidden=\"true\"><path d=\"M1 5H15M15 5L11 1M15 5L11 9\" stroke=\"currentColor\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></a><a class=\"VenueTickets_ticket__Ktu0U\" href=\"/venue/camden-onsale\"><div class=\"VenueTickets_imageWrap__OMFDd\"><img src=\"/images/venues/camden.jpg\" alt=\"Camden, London\"/><div class=\"VenueTickets_imageOverlay__cYmCX\"></div><span class=\"VenueTickets_ribbon__3ltEM\">On sale now</span><h3 class=\"VenueTickets_cityName__NCM39\">Camden, London</h3><p class=\"VenueTickets_imageDates__pNHWb\">11th – 24th Dec</p></div><div class=\"VenueTickets_info__Oxovu\"><p class=\"VenueTickets_blurb__GHGMX\">Set inside an abandoned cinema in the heart of Camden, you&#x27;ll have to explore woodland tunnels to find a cosy forest cinema complete with a bar serving mulled wine, popcorn and festive treats, where it snows before every screening.</p><span class=\"VenueTickets_button__vGz2X \">Book now<svg width=\"16\" height=\"10\" viewBox=\"0 0 16 10\" aria-hidden=\"true\"><path d=\"M1 5H15M15 5L11 1M15 5L11 9\" stroke=\"currentColor\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></span></div></a></div></div></section><section class=\"FilmStrip_section__gBWU8\" aria-label=\"What&#x27;s on this season\"><div class=\"FilmStrip_heading__Npa95\"><p>Showing this Christmas</p></div><div class=\"FilmStrip_track__2sCWZ\"><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/home-alone.jpg\" alt=\"Home Alone\" style=\"object-position:center 20%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Home Alone</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/elf.jpg\" alt=\"Elf\" style=\"object-position:center 15%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Elf</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/love-actually.jpg\" alt=\"Love Actually\" style=\"object-position:center\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Love Actually</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/the-holiday.jpg\" alt=\"The Holiday\" style=\"object-position:35% center\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">The Holiday</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/muppet-christmas-carol.jpg\" alt=\"Muppet Christmas Carol\" style=\"object-position:center 30%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Muppet Christmas Carol</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/the-grinch.jpg\" alt=\"The Grinch\" style=\"object-position:center 20%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">The Grinch</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/nightmare-before-christmas.jpg\" alt=\"Nightmare Before Christmas\" style=\"object-position:25% center\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Nightmare Before Christmas</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/miracle-on-34th-street.jpg\" alt=\"Miracle on 34th Street\" style=\"object-position:center 25%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Miracle on 34th Street</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/how-the-grinch-stole-christmas.jpg\" alt=\"How the Grinch Stole Christmas\" style=\"object-position:center 15%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">How the Grinch Stole Christmas</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/home-alone.jpg\" alt=\"Home Alone\" style=\"object-position:center 20%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Home Alone</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/elf.jpg\" alt=\"Elf\" style=\"object-position:center 15%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Elf</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/love-actually.jpg\" alt=\"Love Actually\" style=\"object-position:center\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Love Actually</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/the-holiday.jpg\" alt=\"The Holiday\" style=\"object-position:35% center\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">The Holiday</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/muppet-christmas-carol.jpg\" alt=\"Muppet Christmas Carol\" style=\"object-position:center 30%\"/><div class=\"FilmStrip_overlay__EvWtU\"></div><span class=\"FilmStrip_title___sgpu\">Muppet Christmas Carol</span></div><div class=\"FilmStrip_card__0khMl\"><img src=\"/images/films/the-grinch.jpg\" alt=\"The Grinch\" style=\"object-position:center 20%\"/><div class=\"FilmStrip_overlay__E