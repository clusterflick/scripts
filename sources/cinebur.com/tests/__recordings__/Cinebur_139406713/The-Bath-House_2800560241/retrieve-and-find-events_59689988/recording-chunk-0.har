            "text": "{\n  \"documents\": [\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/0JkxX6nlAP4vizHCmTea\",\n      \"fields\": {\n        \"name\": {\n          \"stringValue\": \"CINEMA & DINNER: BEFORE SUNRISE\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/NVSSNzDTyB1v8RH5S3BQ\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Before Sunrise\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2026-10-21T17:00:00Z\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2026-10-21T18:41:00Z\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"10\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"The Agora Hotel\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur, and can't wait to welcome you to The Agora Hotel. See you there!\"\n        },\n        \"entry_tickets\": {\n          \"arrayValue\": {\n            \"values\": [\n              {\n                \"mapValue\": {\n                  \"fields\": {\n                    \"capacity\": {\n                      \"integerValue\": \"10\"\n                    },\n                    \"current_availability\": {\n                      \"integerValue\": \"10\"\n                    },\n                    \"description\": {\n                      \"stringValue\": \"Entry to the event seated at the heart of our iconic courtyard. Come early to reserve a spot at one of our comfy sun-beds.\"\n                    },\n                    \"name\": {\n                      \"stringValue\": \"The Agora Moviegoer\"\n                    },\n                    \"pric