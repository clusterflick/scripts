   \"description\": {\n          \"stringValue\": \"We are excited to invite you to another event on Cinebur! We can’t wait to welcome you to Shoreditch Arts Club’s intimate theatre lounge for an unforgettable night and true social cinema experience. Our event will feature an award-winning, culturally-impactful selection from Cinebur’s upcoming seasonal curation. Prepare for an indulgent evening in our cosy cinema room, replete with a signature cocktail and other surprises for the night.\"\n        },\n        \"name\": {\n          \"stringValue\": \"THE SOCIAL CINEMA EXPERIENCE\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Tokyo Story\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/alqfSDSZFnQkH2WVMPpY\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-04-09T20:30:00Z\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Shoreditch Arts Club\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2024-04-09T18:30:00Z\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"24\"\n        }\n      },\n      \"createTime\": \"2024-03-10T20:44:36.496335Z\",\n      \"updateTime\": \"2024-07-04T23:30:51.683039Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/PbgMePOaV31i0976WvRl\",\n      \"fields\": {\n        \"film_name\": {\n          \"stringValue\": \"Catch Me If You Can\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"20\"\n        },\n        \"entry_tickets\": {\n          \"arrayValue\": {\n            \"values\": [\n              {\n                \"mapValue\": {\n                  \"fields\": {\n                    \"capacity\": {\n                      \"integerValue\": \"20\"\n                    },\n                  