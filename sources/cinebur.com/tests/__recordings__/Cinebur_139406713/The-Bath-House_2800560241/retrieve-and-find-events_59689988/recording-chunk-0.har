no's \\\"I Am Love\\\".\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"The Agora Hotel\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2023-09-21T17:30:00Z\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/YlaBNTMmpjDJy4w6jf6l\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"name\": {\n          \"stringValue\": \"A ROMANTIC MOVIE NIGHT AT AGORA'S TERRACE\"\n        }\n      },\n      \"createTime\": \"2023-09-05T13:05:05.972063Z\",\n      \"updateTime\": \"2024-05-29T18:56:33.300687Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/4LPBpdZ69HnfuKnloM1h\",\n      \"fields\": {\n        \"name\": {\n          \"stringValue\": \"SUNSET CINEMA: ZORBA THE GREEK\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Zorba the Greek\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/C420Jms57NnBl7CNHBoX\"\n        },\n        \"entry_tickets\": {\n          \"arrayValue\": {\n            \"values\": [\n              {\n                \"mapValue\": {\n                  \"fields\": {\n                    \"capacity\": {\n                      \"integerValue\": \"20\"\n                    },\n                    \"current_availability\": {\n                      \"integerValue\": \"9\"\n                    },\n                    \"description\": {\n                      \"stringValue\": \"Your ticket entrance to the cinema experience.\"\n                    },\n                    \"name\": {\n                      \"stringValue\": \"Golden Hour Pass\"\n                    },\n                    \"price\": {\n                      \"doubleValue\": 10\n                    }\n                  }\n                }\n              }\n            ]\n          }\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2026-09-21T20:22:00Z\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"20\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/d3jnCWj5ueEFkCZ0IE8Q\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"20\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2026-09-21T17:00:00Z\"\n        },\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur, and can't wait to welcome you to Canaves Epitome. See you there!\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Canaves Collection Santorini\"\n        }\n      },\n      \"createTime\": \"2026-08-13T12:01:46.760975Z\",\n      \"updateTime\": \"2026-09-21T08:31:56.890911Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/4RzCC1DaBza3nBg5HuEX\",\n      \"fields\": {\n        \"end_time\": {\n          \"timestampValue\": \"2023-07-28T17:00:00Z\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"141\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2023-07-28T15:15:00Z\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/0weOXZQ656beTEytSrEw\"\n        },\n        \"name\": {\n          \"stringValue\": \"CINEBUR'S PREMIERE IN GREECE\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"187\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/6Vjok2uOlYjBTCSCPOAl\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"Launch Event\"\n        },\n        \"description\": {\n          \"stringValue\": \"Join us on the 28th for a very special evening marking Cinebur’s first event in Greece, hosted by our launch partner, the Basil & Elise Goulandris Foundation.\\n\\nThe Goulandris Foundation will be screening the recent 4K restoration of Hiroshima, mon Amour (1959), one of the most celebrated cult classics of international cinema. The event will be followed by a short discussion of the cinema industry as well as a Q&A session with Cinebur’s co-founder.\\n\\nWe look forward to seeing you there, and welcoming you into the Cinebur community!\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"The Basil & Elise Goulandris Foundation\"\n        }\n      },\n      \"createTime\": \"2023-07-06T06:12:57.825791Z\",\n      \"updateTime\": \"2024-06-07T20:17:29.846463Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/4gndiHq27VxmBKmTQc0s\",\n      \"fields\": {\n        \"total_capacity\": {\n          \"integerValue\": \"40\"\n        },\n        \"name\": {\n          \"stringValue\": \"DEX.CINEMA SUNDAYS\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Dexamenes°°\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur, and can't wait to welcome you to The Silo. See you there!\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/S0y04EopMlbkHbvKcxj2\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2026-09-06T20:21:00Z\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"22\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2026-09-06T18:30:00Z\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Blowup\"\n        },\n        \"entry_tickets\": {\n          \"arrayValue\": {\n            \"values\": [\n              {\n                \"mapValue\": {\n                  \"fields\": {\n                    \"capacity\": {\n                      \"integerValue\": \"40\"\n                    },\n                    \"name\": {\n                      \"stringValue\": \"Silo Cinema Entry\"\n                    },\n                    \"current_availability\": {\n                      \"integerValue\": \"8\"\n                    },\n                    \"price\": {\n                      \"doubleValue\": 10\n                    },\n                    \"description\": {\n                      \"stringValue\": \"Your entrance ticket to the screening.\"\n                    }\n                  }\n                }\n              }\n            ]\n          }\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/apbiu2Nyd6Yp80bai1aC\"\n        }\n      },\n      \"createTime\": \"2026-08-10T05:40:12.591247Z\",\n      \"updateTime\": \"2026-09-06T15:26:45.402351Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/54spA9OEexbs5tgExYuN\",\n      \"fields\": {\n        \"description\": {\n          \"stringValue\": \"We are excited to invite you to another event on Cinebur! We can’t wait to welcome you to Shoreditch Arts Club’s intimate theatre lounge for an unforgettable night and true social cinema experience. Our event will feature OMEN, an award-winning debut from Baloji now premiering in the UK on Cinebur and in cinemas. Prepare for an indulgent evening in our cosy cinema room, replete with a signature cocktail and other surprises for the night.\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Omen\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Shoreditch Arts Club\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"24\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"9\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/ycxu8Nh3gnXtMbR1qw5C\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2024-05-21T18:30:00Z\"\n        },\n        \"name\": {\n          \"stringValue\": \"SHOREDITCH ARTS CLUB'S LAVISH MOVIE NIGHT\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/alqfSDSZFnQkH2WVMPpY\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-05-21T20:30:00.852Z\"\n        }\n      },\n      \"createTime\": \"2024-04-21T17:26:35.007151Z\",\n      \"updateTime\": \"2024-07-04T23:24:23.796799Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/5QBbJpLaY3NljLUyoJjv\",\n      \"fields\": {\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"description\": {\n          \"stringValue\": \"Get ready for a cozy summer night as we launch our FIRST EVER Summer Cinema Series under the stars!📽✨We're kicking things off with a modern classic movie owning 16 awards & 47 nominations - \\\"I AM LOVE\\\" / \\\"IO SONO L'AMORE\\\" (2009) 🇮🇹Location: Blue Spice Bar (grass area)Get comfy & enjoy the film with your favorite summer drink & snacks. Don't miss this unforgettable experience! ✨Limited spaces available!\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/YlaBNTMmpjDJy4w6jf6l\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"0\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"I Am Love\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/8QgpXPKXLOhY3VenXizR\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"40\"\n        },\n        \"name\": {\n          \"stringValue\": \"SUMMER CINEMA NIGHT UNDER THE STARS\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2024-05-31T17:00:00Z\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Blue Spice\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-05-31T18:53:00Z\"\n        }\n      },\n      \"createTime\": \"2024-05-16T23:18:11.438079Z\",\n      \"updateTime\": \"2024-05-31T16:49:22.895903Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/5hYfXrmExs6SBv9ektuE\",\n      \"fields\": {\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur, and can't wait to welcome you to The Silo. See you there!\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/7pKD4M94xXgc2x3LJvkc\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2026-08-23T18:30:00Z\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"Paris, Texas\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/S0y04EopMlbkHbvKcxj2\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n  