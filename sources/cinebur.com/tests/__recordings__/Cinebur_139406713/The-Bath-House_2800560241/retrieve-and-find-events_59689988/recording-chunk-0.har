name\": {\n          \"stringValue\": \"WINGS OF DESIRE\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/DM72EC8Vr2QaCKL8QoBN\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-04-14T20:00:00.533Z\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/3M9kAxNs6ZWBIGTdSEfM\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"host_name\": {\n          \"stringValue\": \"To Bar Athens\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"32\"\n        },\n        \"name\": {\n          \"stringValue\": \"CINEMA HIDEAWAY UNDER THE STARS\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"description\": {\n          \"stringValue\": \"Join us at To Bar for our very first Cinebur event, proudly presented by Three Dots & a Dash. On April 14th, we will be mixing award-winning cinema in with our famous bottled cocktails, lovingly prepared by our professional mixology masters. We can’t wait to welcome you to our classic cocktail bar environment and look forward to many great conversations after a thought-provoking film. \"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"0\"\n        }\n      },\n      \"createTime\": \"2024-03-31T16:50:38.233647Z\",\n      \"updateTime\": \"2024-05-29T18:54:41.812687Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/gY7kL0nqRpvCjBKUIF7y\",\n      \"fields\": {\n        \"name\": {\n          \"stringValue\": \"OPEN AIR CINEMA NIGHTS: EPISODE 2\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2023-09-08T17:45:00Z\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/S4f6n16uiEyRF2iDfrYe\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"42\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Home for Cooperation\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/YlaBNTMmpjDJy4w6jf6l\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"60\"\n        },\n        \"description\": {\n          \"stringValue\": \"Join us at the Home Café for an evening of film, warmth, and dialogue. We will begin the evening by showcasing “Quinunc”, a short film production by Harris Ayiotou. After a 10-minute Q&A with the producers, we will continue with a showcase of “I Am Love”, the first instalment in Luca Guadagnino's self-described Desire trilogy.\\n\\n“Divided Still” will begin screening at 8PM, while “I Am Love” will be screened at 8:45PM.\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2023-09-08T19:45:00Z\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"Movie Screening\"\n        }\n      },\n      \"createTime\": \"2023-08-24T14:41:16.593711Z\",\n      \"updateTime\": \"2024-05-29T18:54:37.508239Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/gZ3EMIckKuhxGzTL7yRt\",\n      \"fields\": {\n        \"name\": {\n          \"stringValue\": \"DEX.SUNDAYS ARE FOR CINEMA\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"40\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/S0y04EopMlbkHbvKcxj2\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Dexamenes°°\"\n        },\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur