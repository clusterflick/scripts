0:00.787Z\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"To Bar Athens\"\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/YlaBNTMmpjDJy4w6jf6l\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"film_name\": {\n          \"stringValue\": \"I Am Love\"\n        }\n      },\n      \"createTime\": \"2024-09-10T16:33:58.996751Z\",\n      \"updateTime\": \"2024-09-22T16:55:21.833903Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/RfIhYxYRccUJPSBAervC\",\n      \"fields\": {\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/wBQgsPqLu4n7k17mYBL0\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2024-05-10T17:30:00.543Z\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-05-10T19:32:00.307Z\"\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"name\": {\n          \"stringValue\": \"SOCIAL CINEMA IN PERU'S ARTSPACE\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Perú Athens\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"15\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/Byq9jlhdQj05AhPNbXTK\"\n        },\n        \"film_name\": {\n          \"stringValue\": \"ALL THE BEAUTY AND THE BLOODSHED\"\n        },\n        \"description\": {\n          \"stringValue\": \"Peru is excited to host the first film screening as a collaboration with Cinebur. Our space is focusing on creative expression and multidisciplinary workshops connecting all art fields and raising interesting dialogues. We emphasize a lot on bringing to light the artwork and life of important women artists from all art history, known and less famous. So, there could not be a better film to start with, as the biography of Nan Goldin, such a notable and wonderful artist. Her life was like a movie anyhow, with so many aspects to think on. We can't wait to see you in Peru and enjoy together this night!\"\n        },\n        \"ticket_availability\": {\n          \"integerValue\": \"1\"\n        }\n      },\n      \"createTime\": \"2024-04-04T18:32:21.317247Z\",\n      \"updateTime\": \"2024-05-29T18:54:50.136303Z\"\n    },\n    {\n      \"name\": \"projects/cinebur-ltd/databases/(default)/documents/events/RgDt4dBZynKLjwNdfeMG\",\n      \"fields\": {\n        \"film_name\": {\n          \"stringValue\": \"Identifying Features\"\n        },\n        \"venue_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/venues/S4f6n16uiEyRF2iDfrYe\"\n        },\n        \"total_capacity\": {\n          \"integerValue\": \"50\"\n        },\n        \"host_name\": {\n          \"stringValue\": \"Home for Cooperation\"\n        },\n        \"event_date\": {\n          \"timestampValue\": \"2024-07-10T18:00:00.195Z\"\n        },\n        \"name\": {\n          \"stringValue\": \"MOVIE NIGHT ON THE BUFFER ZONE\"\n        },\n        \"ticket_availability\": {\n          \"doubleValue\": 23\n        },\n        \"event_type\": {\n          \"stringValue\": \"MOVIE SCREENING\"\n        },\n        \"is_coming_soon\": {\n          \"booleanValue\": false\n        },\n        \"film_reference\": {\n          \"referenceValue\": \"projects/cinebur-ltd/databases/(default)/documents/films/Dw7XVzyayY682bHWvu6Z\"\n        },\n        \"description\": {\n          \"stringValue\": \"We are looking forward to another event on Cinebur, and can't wait to welcome you to The Home Café. See you there!\"\n        },\n        \"end_time\": {\n          \"timestampValue\": \"2024-07