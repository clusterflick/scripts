          "content": {
            "mimeType": "application/json; charset=UTF-8",
            "text": "[{\n  \"found\": {\n    \"name\": \"projects/cinebur-ltd/databases/(default)/documents/films/GttKGTPtQ3Ujc4ejxqSB\",\n    \"fields\": {\n      \"release_date\": {\n        \"integerValue\": \"1954\"\n      },\n      \"name\": {\n        \"stringValue\": \"Seven Samurai\"\n      },\n      \"director_name\": {\n        \"stringValue\": \"Akira Kurosawa\"\n      },\n      \"genre\": {\n        \"stringValue\": \"Adventure\"\n      },\n      \"description\": {\n        \"stringValue\": \"Farmers from a village exploited by bandits hire a veteran samurai for protection, who gathers six other samurai to join him. Recognized by the Academy Awards, BAFTA, and Venice, Seven Samurai is undoubtedly the most famous of legendary Japanese director Kurosawa's masterpieces - a milestone in cinema history. \"\n      },\n      \"runtime\": {\n        \"integerValue\": \"206\"\n      }\n    },\n    \"createTime\": \"2024-06-23T02:44:54.425658Z\",\n    \"updateTime\": \"2024-06-23T02:45:10.871966Z\"\n  },\n  \"readTime\": \"2026-10-25T11:06:24.115264Z\"\n}\n,\r\n{\n  \"found\": {\n    \"name\": \"projects/cinebur-ltd/databases/(default)/documents/films/Ma4yYEQ3uUe7TRMHZs8s\",\n    \"fields\": {\n      \"trailer_link\": {\n        \"stringValue\": \"https://youtu.be/qQ3UvYy872g?is=nujo48sncM7L8kXr\"\n      },\n      \"release_date\": {\n        \"integerValue\": \"1955\"\n      },\n      \"name\": {\n        \"stringValue\": \"French Cancan\"\n      },\n      \"director_name\": {\n        \"stringValue\": \"Jean Renoir\"\n      },\n      \"genre\": {\n        \"stringValue\": \"Musical\"\n      },\n      \"description\": {\n        \"stringValue\": \"FRENCH CANCAN: The son of Impressionist painter Pierre-Auguste Renoir brings his father's world to life in Technicolor, conjuring Belle Époque Montmartre with the warmth and colour of a canvas come alive. Jean Gabin leads this irresistible story of the impresario who dreamed up the cancan and turned a humble washerwoman into the star of the Moulin Rouge, in a film that is itself a love letter to the joy of performance. A perfect 100% on Rotten Tomatoes, and easy to see why.\"\n      },\n      \"runtime\": {\n        \"integerValue\": \"105\"\n      }\n    },\n    \"createTime\": \"2026-10-17T07:36:17.844335Z\",\n    \"updateTime\": \"2026-10-17T07:36:17.844335Z\"\n  },\n  \"readTime\": \"2026-10-25T11:06:24.115264Z\"\n}\n,\r\n{\n  \"found\": {\n    \"name\": \"projects/cinebur-ltd/databases/(default)/documents/films/SLvDCuseUpN5zin4SLCt\",\n    \"fields\": {\n      \"trailer_link\": {\n        \"stringValue\": \"https://youtu.be/4plqh6obZW4?is=d57zI13kuW45nNng\"\n      },\n      \"release_date\": {\n        \"integerValue\": \"1975\"\n      },\n      \"name\": {\n        \"stringValue\": \"Rocky Horror Picture Show\"\n      },\n      \"director_name\": {\n        \"stringValue\": \"Jim Sharman\"\n      },\n      \"genre\": {\n        \"stringValue\": \"Comedy Horror\"\n      },\n      \"description\": {\n        \"stringValue\": \"Tim Curry's Frank-N-Furter is one of cinema's most liberating creations! You'll meet a character who walks into the room and gives everyone in the audience silent permission to be exactly who they are. Dismissed as a flop upon its initial release, it has since become a timeless classic and is now preserved by the Library of Congress as a national treasure. Rocky Horror Picture Show is the longest-running theatrical release in history, built entirely on the devotion of audiences who dress up, sing along, and return again and again. Costumes welcome. Happy Halloween! 🎃\"\n      },\n      \"runtime\": {\n        \"integerValue\": \"100\"\n      }\n    },\n    \"createTime\": \"2026-10-20T18:14:09.388337Z\",\n    \"updateTime\": \"2026-10-23T10:46:29.460756Z\"\n  },\n  \"readTime\": \"2026-10-25T11:06:24.115264Z\"\n}\n]",
