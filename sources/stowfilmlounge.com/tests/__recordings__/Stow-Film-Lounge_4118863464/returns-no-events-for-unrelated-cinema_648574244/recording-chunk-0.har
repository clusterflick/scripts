"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-c0faa4bd14e5ccdffc6c {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-c0faa4bd14e5ccdffc6c .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/81576dee-e803-41a8-9338-bb495cc86e12_1017/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/81576dee-e803-41a8-9338-bb495cc86e12_1017/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"9926818e84416c1d987b\" id=\"block-9926818e84416c1d987b\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center sqs-stretched\"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ticketlab.app/event/39327#/\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n     Reserve your free tickets\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-9926818e84416c1d987b {\n    --sqs-block-content-flex: 1;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-9926818e84416c1d987b {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/2328ad91-4a65-4ef8-869d-177344382b88_847/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/2328ad91-4a65-4ef8-869d-177344382b88_847/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"5f3f166e9289daf1cfee\" id=\"block-5f3f166e9289daf1cfee\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We return to Langthorne Park’s Amphitheatre for another evening of wonderful atmospheric outdoor cinema. In collaboration with Leytonstone Toy Library, this is our fourth year in this fabulous space. </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">This wonderful slapstick dark comedy is a real family treat. When their string magnate father, Rudolf Smuntz, dies, brothers Ernie (Nathan Lane) and Lars (Lee Evans) move into his decrepit mansion. Struggling to keep a promise to never sell the now unprofitable string factory, the brothers decide that restoring the house, the last built by a famous architect, could bring them a great deal of money. But during their restoration attempts, Ernie and Lars are continually frustrated by a malicious mouse that keeps destroying their efforts. </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Venue:&nbsp;Langthorne Park, Birch Grove, E11 4YG</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Refreshments: The community hub cafe will be open. </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Doors:&nbsp;Open 19:00, Film 19:45, Close 20:00</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Seating: Please note that temporary seating will not be available so please bring camping chairs, cushions and blankets.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-5f3f166e9289daf1cfee {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-5f3f166e9289daf1cfee .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-5f3f166e9289daf1cfee {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-5f3f166e9289daf1cfee {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-5f3f166e9289daf1cfee {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-5f3f166e9289daf1cfee {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-5f3f166e9289daf1cfee .sqs-html-content {\n            \n            }\n        }\n    \n  @media 