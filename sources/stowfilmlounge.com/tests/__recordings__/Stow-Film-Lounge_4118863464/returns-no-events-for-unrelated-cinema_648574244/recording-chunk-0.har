\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/81576dee-e803-41a8-9338-bb495cc86e12_1017/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/81576dee-e803-41a8-9338-bb495cc86e12_1017/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"0b5da9d312156b3b92b7\" id=\"block-0b5da9d312156b3b92b7\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center sqs-stretched\"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://wansteadfringe.org/event/kinema-zootropolis-2/\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    TICKETS AVAILABLE HERE\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-0b5da9d312156b3b92b7 {\n    --sqs-block-content-flex: 1;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-0b5da9d312156b3b92b7 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/2328ad91-4a65-4ef8-869d-177344382b88_847/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/2328ad91-4a65-4ef8-869d-177344382b88_847/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"6db92684d9d7b1bac4dd\" id=\"block-6db92684d9d7b1bac4dd\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We return to Wanstead in E11 for their annual Kinema, an integral part of the yearly Wanstead Fringe Festival. Always a very welcoming family focused evening, this is our twelfth year of collaboration in this ever-popular cultural festival.   </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">The delightful sequel of this buddy cop comedy sees brave rabbit cop Judy Hopps and her friend, the fox Nick Wilde, team up again to crack a new case, the most perilous and intricate of their careers.  </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Venue:&nbsp;Wanstead Cricket Club, Overton Drive, E11 2LW</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Refreshments: TBC </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Doors:&nbsp;Open 19:00, Film 19:45, Close 20:00</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Tickets: Adults £10, Child £6 </p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Seating: Please note that temporary seating will not be available so please bring camping chairs, cushions and blankets.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-6db92684d9d7b1bac4dd {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-6db92684d9d7b1bac4dd .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-6db92684d9d7b1bac4dd {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-6db92684d9d7b1bac4dd {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-6db92684d9d7b1bac4dd {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-6db92684d9d7b1bac4dd {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-6db92684d9d7b1bac4dd .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div></div></div></div>\n    </div>\n  \n  </div>\n  \n</section>\n\n      \n    \n      \n        \n        \n\n\n  \n  \n\n\n\n\n\n\n\n\n\n\n\n<section\n  data-test=\"page-section\"\n  \n  data-section-theme=\"black\"\n  class='page-section \n    \n      layout-engine-section\n    \n    background-width--full