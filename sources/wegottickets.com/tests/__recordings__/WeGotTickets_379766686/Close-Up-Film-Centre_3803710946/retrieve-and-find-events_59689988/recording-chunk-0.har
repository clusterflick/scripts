Tickets Ltd 2026\n                    </div>\n                </div>\n            </div>\n\n            <script>\n    function agree_to_cookies() {\n        document.cookie = \"allow_cookies=Yes; expires=Fri, 31 Dec 9999 23:59:59 GMT; path=/\";\n        const cookie_notification = document.getElementById('cookie_agreement');\n        cookie_notification.parentNode.removeChild(cookie_notification);\n        return false;\n    }\n</script>\n<div id=\"cookie_agreement\" class=\"alert alert-cookie\">\n    <a id=\"agree_to_cookies\" class=\"cookie-accept-button button\" href=\"#\" onclick=\"agree_to_cookies()\">\n        Allow cookies\n    </a>\n    <p>\n        We use cookies to provide the best user experience possible.\n        <br>\n        Read our <a href=\"https://wegottickets.com/cookies\">cookies policy</a> to find out more.\n    </p>\n</div>\n        </footer>\n\n        \n\n        <script>\n            function toggleAccordion(header) {\n                const ul = header.nextElementSibling;\n                const isOpen = ul.classList.contains('open');\n\n                // Close all other accordions\n                document.querySelectorAll('h4').forEach(h => {\n                    const list = h.nextElementSibling;\n                    if (list && list !== ul) {\n                        list.classList.remove('open');\n                        h.classList.remove('active');\n                    }\n                });\n\n                // Toggle current accordion\n                if (isOpen) {\n                    ul.classList.remove('open');\n                    header.classList.remove('active');\n                } else {\n                    ul.classList.add('open');\n                    header.classList.add('active');\n                }\n            }\n\n            // Initialize - all sections closed by default\n            document.addEventListener('DOMContentLoaded', function() {\n                document.querySelectorAll('ul:not(.always-open)').forEach(ul => {\n                    ul.classList.remove('open');\n                });\n            });\n        </script>\n        \n    <script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a2c458a35982261f',t:'MTc4NjkyNDI3OA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
