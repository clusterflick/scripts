ckets.com?cc=cs-header\" target=\"_blank\" class=\"ticketYourEvent neutral-filled\">Ticket your event</a>\n                                </li>\n                            </ul>\n                        </div>\n                        <ul id=\"mobile-nav\">\n                            <li class=\"css-menu\">\n                                <a class=\"menu-over\">\n                                    <img src=\"https://wegottickets.com/images/hamburger.png\" alt=\"Menu\" title=\"Main menu\"/>\n                                </a>\n                                <a class=\"css-menu-button advance-filled\" tabindex=\"1\" href=\"#\">\n                                    <img src=\"https://wegottickets.com/images/hamburger.png\" alt=\"Menu\" title=\"Main menu\"/>\n                                </a>\n                                <ul class=\"dropdown-menu\">\n                                    <li><a title=\"Basket\" id=\"Basket\" href=\"https://wegottickets.com/basket\" class=\"advance-filled\">Basket (0)</a></li>\n                                    <li><a title=\"Ticket your event\" href=\"https://clients.wegottickets.com?cc=cs-header\" target=\"_blank\">Ticket your event</a></li>\n                                    <li>\n    <a id=\"LoginLink\" title=\"Log in\" class=\"login \" href=\"https://wegottickets.com/account\">Log in</a>\n</li>\n<li>\n    <a id=\"Register\" title=\"Register\" class=\"register\" href=\"https://wegottickets.com/register\">Register</a>\n</li>\n\n                                </ul>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"content block-group\" id=\"Search-container\">\n            <div class=\"block block-header-search\">\n                <form id=\"search-form\" action=\"/searchresults\" method=\"post\">\n                    <input\n                        class=\"search-form\"\n                        type=\"text\"\n                        name=\"unified_query\"\n                        placeholder=\"Search\"\n                        required\n                    >\n                    <input class=\"button advance-filled search-form\" type=\"submit\" value=\"Search\" aria-label=\"Search\" />\n                </form>\n            </div>\n        </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"filled block-group block-group-flex\" id=\"LinkBlock\">\n        <div class=\"link-block\">\n            <a href=\"/af/664/find/genre/general\">Music</a>\n            <a href=\"/af/664/find/genre/comedy\">Comedy</a>\n            <a href=\"https://wegottickets.tixculture.com/\" target=\"_blank\">West End Theatre</a>\n            <a href=\"/external/token/ajxcjv\" target=\"_blank\">Regional Theatre</a>\n            <a href=\"/af/664/this-weekend\">This Weekend</a>\n            \n        </div>\n    </div>\n    <div id=\"WrapperInner\">\n        <div id=\"Page\" class=\"clearfix\">\n            <div id=\"Content\" class=\"clearfix\">\n                <div id=\"extra_content\"></div><script src=\"https://wegottickets.com/../js/search_list.js\"></script>\n\n<div class=\"content block-group\">\n    <div></div>\n    \n    \n    \n    \n    \n\n    \n        <div id=\"queryFeedbackRefineButton\">\n            <div id=\"searched-for\">\n                <div id=\"queryFeedback\"><table class=\"queryParametersTable\"><tbody><tr><th>Genre: </th><td>Film</td></tr><tr><th>Region: </th><td>London</td></tr></tbody></table></div>\n                <p>(1 event found)</p>\n                \n            </div>\n            <a id=\"refine_search\" class=\"button\">Refine your search</a>\n        </div>\n\n        <div id=\"refine_search_container\" class=\"form-buttons-margin\">\n            <div id=\"search_again\"><script src=\"https://wegottickets.com/js/advform.js?updated=2024-05-17\"></script>\n\n<form method=\"post\" action=\"/searchresults/adv\">\n    <div class=\"content block-group\">\n 