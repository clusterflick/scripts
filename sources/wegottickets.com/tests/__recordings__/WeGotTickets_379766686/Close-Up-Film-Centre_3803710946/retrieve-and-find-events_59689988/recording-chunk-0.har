ach(h => {\n                    const list = h.nextElementSibling;\n                    if (list && list !== ul) {\n                        list.classList.remove('open');\n                        h.classList.remove('active');\n                    }\n                });\n\n                // Toggle current accordion\n                if (isOpen) {\n                    ul.classList.remove('open');\n                    header.classList.remove('active');\n                } else {\n                    ul.classList.add('open');\n                    header.classList.add('active');\n                }\n            }\n\n            // Initialize - all sections closed by default\n            document.addEventListener('DOMContentLoaded', function() {\n                document.querySelectorAll('ul:not(.always-open)').forEach(ul => {\n                    ul.classList.remove('open');\n                });\n            });\n        </script>\n        \n    <script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a2c458a1fa57e902',t:'MTc4NjkyNDI3OA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>\n</html>\n",
