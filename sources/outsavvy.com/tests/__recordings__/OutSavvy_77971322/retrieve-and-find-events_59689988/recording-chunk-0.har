                   <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"TheaterEvent\",\"name\": \"Bank Holiday Monday with The D.E Experience\",\"startDate\": \"2026-08-31T16:00:00+01:00\",\"endDate\": \"2026-08-31T22:00:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/38362/bank-holiday-monday-with-the-de-experience\",\"image\" : \"https://cdn.outsavvy.com/events/daadd861-1c3c-4f93-b7f0-73bc448ca1ca.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"BANK HOLIDAY MONDAY CABARETCLINIC WITH THE D.E. EXPERIENCE MONDAY 31ST AUGUST‘Sister Edna will see you now’For August Bank Holiday Monday, following The RVT Sports Day outside, there&#39;s something special happening at The Royal Vauxhall Tavern… Clinic with the one and only D.E. ExperienceCome and feel the love at the perfect recovery from a hectic Bank Holiday weekend, a laid back, soulful chill-out to ease us back into our gorgeous lives with epic songs and Edna putting the world to rights as only she can.  THERE WILL BE TICKETS ON THE DOOR FROM 4PM ON THE DAYDoors are at 4pmWith DJ Simon Le Vans This event is 18+Advance tickets are &#163;11 plus booking fee. No Refunds.RVT Sports Day is a free event in the park behind the venue, but you must buy tickets for cabaret inside The RVT.PLEASE NOTE: This event will be mostly standing with only a very few seats in the venue, first come first serve. If you have access questions please contact dave@vauxhalltavern.com. ALL BAGS AND COATS MUST BE CHECKED IN TO CLOAKROOM DANCING ON THE STAGE IS AT YOUR OWN RISK The RVT is an LGBTQ+ venue, please respect our space. No hen/stag parties\",\"location\": {\"@type\": \"Place\",\"name\": \"Royal Vauxhall Tavern\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Royal Vauxhall Tavern, 372 Kennington Ln\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE11 5HY\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.48634\", \"longitude\" : \"-0.121779\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-08-31T15:00:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38362/bank-holiday-monday-with-the-de-experience\",\"lowPrice\":11,\"highPrice\":11,\"availabilityStarts\":\"2026-07-29T13:24:05+01:00\",\"validFrom\":\"2026-07-29T13:24:05+01:00\",\"offers\":[{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-08-31T15:00:00+01:00\",\"name\":\"General Admission single\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38362/bank-holiday-monday-with-the-de-experience\",\"price\":11,\"availabilityStarts\":\"2026-07-29T13:24:05+01:00\",\"validFrom\":\"2026-07-29T13:24:05+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/royalvauxhalltavern\", \"description\" : \"The much loved Royal Vauxhall Tavern is an iconic London LGBTQ+ cabaret, performance and club night destination and is the award winning Best London Cabaret Venue. We are home to the most diverse line up of events, shows and performers in the UK with every area of the LGBTQ+ community represented, supported and welcomed. Please note: Most events at The RVT are a mix of standing and sitting with limited seats allocated on a first come first serve basis.  The venue is accessible, but we do not have a disabled toilet, we do not believe the venue is a safe environment for animals, all our events feature loud music and flashing lights, but fully trained assistance animals can be admitted at the owners risk, in accordance with the Equality act 2010. If you have access requirements or questions please contact dave@vauxhalltavern.com. \", \"name\" : \"The Royal Vauxhall Tavern\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 38362,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 12,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/38362/bank-holiday-monday-with-the-de-experience';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.a