rch-nav-item-container'><div class='search-nav-item-image-container'><figure class='search-nav-item-image'><img src='https://res.cloudinary.com/outsavvy/image/fetch/c_fill,h_60,w_123/\" + item.ImageUrl + \"' alt='\" + item.Name + \"' class='search-nav-item-theimage'><div class='feature-price'>\" + item.Price + \"</div></figure></div><div class='search-nav-title-container'><p class='search-nav-title'>\" + item.Name + \"</p><p class='search-nav-description search-nav-description-date'>\" + item.Date + \"</p><p class='search-nav-description'>\" + item.Location + \"</p></div></div></a>\";\r\n                            $('.results-list').append(rows);\r\n                        });\r\n\r\n                        $(\".results-holder\").show();\r\n\r\n                    },\r\n                    error: function (result) {\r\n                        //alert(\"Due to unexpected errors we were unable to load data\");\r\n                    }\r\n                });\r\n\r\n                $(\"#predicitvesearch\").focus();\r\n            }, 500);\r\n        }\r\n\r\n    </script>\r\n\r\n    \r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/eventCss/b27ef4f78a7af86754b7dbe2a55cdf67edad90ca726dfa3576df63302589d8feda40457d76dbdbad08ee319e781afdf14238cdfb4de0ecc33f1b1b88af7f5b79/\"/>\r\n\r\n\r\n    <meta name=\"keywords\" content=\"OutSavvy, Canal Film Club X Fringe! Queer Film Fest Closing Night Shorts: Life On The Margins, Canal Film Club X Fringe! Queer Film Fest Closing Night Shorts: Life On The Margins tickets, Canal Film Club X Fringe! Queer Film Fest Closing Night Shorts: Life On The Margins London, Canal Film Club X Fringe! Queer Film Fest Closing Night Shorts: Life On The Margins London tickets, london events, cinema, community, screening, film\" /></head>\r\n<body>\r\n\r\n    \r\n    <form method=\"post\" action=\"/event/39169/canal-film-club-x-fringe-queer-film-fest-closing-night-shorts-life-on-the-margins\" id=\"Form1\">\r\n<input type=\"hidden\" n