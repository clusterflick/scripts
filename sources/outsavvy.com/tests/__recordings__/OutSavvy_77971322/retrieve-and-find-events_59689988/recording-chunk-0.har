 <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Programmers of Tomorrow fundraiser screening #3: Night of the Comet (1984)\",\"startDate\": \"2026-10-22T19:30:00+01:00\",\"endDate\": \"2026-10-22T21:30:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/38389/programmers-of-tomorrow-fundraiser-screening-3-night-of-the-comet-1984\",\"image\" : \"https://cdn.outsavvy.com/events/3f2c8065-7633-4de0-b1e9-d7717d68ab22.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Where in LA do you wait out the apocalypse? The cinema and the shopping mall of course. The Cinema of Tomorrow (F.K.A PEPCOT) presents the final of three screenings on the theme of ‘Movies at the Movies’. Night of the Comet (1984) is a sci-fi zom-com about sisterhood that whirls ecstaticly across a lusciously depicted and (almost) empty Los Angeles. Our main characters - sisters Regina and Samantha Belmont - were frequently cited by the creators of Buffy the Vampire Slayer. They are the quick-quipping, ass-kicking, fashion-forward blueprints. Roger Ebert and Gene Siskel agreed, throwing a big two thumbs up at this grade-A B-movie. &#128077;&#128077; This event is part of Programmers of Tomorrow (PoT): A season of workshops and screenings for the future of film exhibition. Consisting of two free workshops, three fundraiser screenings and a film festival all-dayer, PoT is spreading knowledge about film programming, building community around the love of movies, and facilitating first timers to put on their first ever public screening.  Read more about it and how to get involved.This screening is a fundraiser for both PoT and its venue, the Cinema Museum. The Cinema Museum is currently raising money to buy its amazing building and cement its place as the living archive of London&#39;s cinema history. Doors will open at 6.30pm for drinks and snacks amidst the ephemera of cinemas past, showtime at 7.30pm. AccessThere is one step to get into the museum, and a lift to get into the screening hall.Accessible and all gender toilets available.Carers free, service dogs welcome.No one turned away for lack of funds. Please email us for a discounted or free ticket.If you have any other questions or requests do get in touch. cinemaoftomorrowldn@gmail.com\",\"location\": {\"@type\": \"Place\",\"name\": \"The Cinema Museum\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Cinema Museum, 2 Dugard Way\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE11 4TH\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.49229\", \"longitude\" : \"-0.1052203\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-10-22T18:30:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38389/programmers-of-tomorrow-fundraiser-screening-3-night-of-the-comet-1984\",\"lowPrice\":12,\"highPrice\":9,\"availabilityStarts\":\"2026-07-24T12:05:42+01:00\",\"validFrom\":\"2026-07-24T12:05:42+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-10-22T18:30:00+01:00\",\"name\":\"Fundraiser Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38389/programmers-of-tomorrow-fundraiser-screening-3-night-of-the-comet-1984\",\"price\":12,\"availabilityStarts\":\"2026-07-24T12:05:42+01:00\",\"validFrom\":\"2026-07-24T12:05:42+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-10-22T18:30:00+01:00\",\"name\":\"Standard Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38389/programmers-of-tomorrow-fundraiser-screening-3-night-of-the-comet-1984\",\"price\":9,\"availabilityStarts\":\"2026-07-24T12:05:42+01:00\",\"validFrom\":\"2026-07-24T12:05:42+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/cinema-of-tomorrow\", \"description\" : \"The South London-based film club F.K.A. PEPCOT (Peckham Experimental Prototype Cinema of Tomorrow) is evolving into simply… The Cinema of Tomorrow, a microcinema in the making for South East London. \", \"name\" : \"Cinema of Tomorrow\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 38389,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 7030,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n     