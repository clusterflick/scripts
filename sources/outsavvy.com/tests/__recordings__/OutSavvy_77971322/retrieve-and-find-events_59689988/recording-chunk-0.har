th: 100%; margin-top: 5px; text-align: center;\" class=\"sharevent jssocials\">\r\n                            <div class=\"jssocials-shares\">\r\n\r\n                                <div class=\"jssocials-share\">\r\n\r\n                                    <div onclick=\"loveevent(38969)\" class='like-button' title=\"Unlove This Event\" style=\"cursor: pointer;\">\r\n                                        <div class='like-icon'>\r\n                                            <div class='heart-animation-1'></div>\r\n                                            <div class='heart-animation-2'></div>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                                <div class=\"jssocials-share\">\r\n\r\n                                    <div onclick=\"showShareModal()\" class=\"jssocials-share jssocials-share-share\" style=\"cursor: pointer; margin: 0;\" data-original-title=\"Share This Event\">\r\n\r\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28px\" height=\"28px\" viewBox=\"0 0 24 24\" fill=\"none\">\r\n                                            <path opacity=\"1\" d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" fill=\"#FFF\"></path>\r\n                                            <path d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                            <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">Lost in the Foxglove Presents: In defense of messiness. Visualizer Screening</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p>Lost in the Foxglove presents a visualiser screening of second self-published poetry collection: <i>In defense of messiness</i>. Serving as an expansion to IDOM's literary universe, Bulla filmed and directed her first ever moving picture rendition of the book.&nbsp;<br><br>The evening will begin with the screening, followed by a 1:1 Q&amp;A with Bulla, chaired by esteemed director and photographer, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.instagram.com/kiers/?hl=en-gb\">Kiera Simpson</a> (<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.kierasimpson.com\">kierasimpson.com</a>). Afterwards, three London-based creatives positioned across various industries will join the panel and expand the conversation.<br><br>That's not all! There will also be a microbiome kissing booth facilitated by inimitable artist, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.instagram.com/emma_s_walker/\">Emma Walker</a>. Designer and artist, <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.instagram.com/r.osew/\">Rose</a> will be selling one of one garments inspired by the poetry collection. And <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.instagram.com/toothgems_cutie/\">Tooth Gems Cutie</a> will have a variety of tooth gems on offer.&nbsp;<br><br>Lastly! Guests will be able to purchase special, second edition signed copies of <i>In defense of messiness</i>. which will include select handwritten (&amp; scanned) poems and a little more insight into the inspiration behind the collection. <i>These can be purchased in advance with your ticket, or in person.&nbsp;</i></p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Rhizomatic!%2c+83+Smeed+Road%2c+London%2c+E3+2NR\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0234224&lat=51.53825&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Rhizomatic!%2c+83+Smeed+Road%2c+London%2c+E3+2NR\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0234224&lat=51.53825&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n                    <p><span class=locName>Rhizomatic!</span><br/>83 Smeed Road, London, E3 2NR</p>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line