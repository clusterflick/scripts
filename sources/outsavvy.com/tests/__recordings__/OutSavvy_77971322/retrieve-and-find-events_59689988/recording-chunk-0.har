n-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">Trancestors</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p><strong>Transcestors&nbsp;</strong></p><p>with EJ Scott</p><p>&nbsp;</p><p>Doors at 6pm</p><p>Action at 7pm</p><p>Carriages 9.30pm</p><p>&nbsp;</p><p>Who were the gender outlaws in the London of the 70’s, ’80's and ’90’s?&nbsp; How did trans people identify and how did trans culture reveal itself before the T-revolution of the 21st century?</p><p>&nbsp;</p><p>EJ Scott speaks with Nando Messias, &nbsp;Jason Barker and others about transcestory, identity, the mental health of the marginalised and the magic of transformation</p><p>&nbsp;</p><p>Plus research from the TV/TS Group to the Beaumont Society, from the ‘drag' balls at Porchester Hall to developments at the gender identity clinic at Charing Cross Hospital &nbsp;</p><p>&nbsp;</p><p>Free tea, coffee and biscuits</p><p>&nbsp;</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Wheatsheaf+Community+Hall%2c+off+Wheatsheaf+Lane%2c+London%2c+SW8+2UP\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1252938&lat=51.48093&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Wheatsheaf+Community+Hall%2c+off+Wheatsheaf+Lane%2c+London%2c+SW8+2UP\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1252938&lat=51.48093&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n                    <p><span class=locName>Wheatsheaf Community Hall</span><br/>off Wheatsheaf Lane, London, SW8 2UP</p>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line-red\">Tagged\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/londonevents><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 48 48\">\r\n  <title>location</title>\r\n  <g id=\"Layer_2\" data-name=\"Layer 2\">\r\n    <g id=\"invisible_box\" data-name=\"invisible box\">\r\n      <rect width=\"48\" height=\"48\" fill=\"none\"/>\r\n    </g>\r\n    <g id=\"icons_Q2\" data-name=\"icons Q2\">\r\n      <path d=\"M24,14a3,3,0,1,1-3,3,2.9,2.9,0,0,1,3-3m0-4a7,7,0,1,0,7,7,7,7,0,0,0-7-7Z\"/>\r\n      <path d=\"M24,6c7.4,0,13,6,13,14S28.4,36.7,24,41.2C19.6,36.7,11,27.5,11,20S16.6,6,24,6m0-4C14.1,2,7,10.1,7,20S18.5,41.3,22.6,45.4a1.9,1.9,0,0,0,2.8,0C29.5,41.3,41,30.1,41,20S33.9,2,24,2Z\"/>\r\n    </g>\r\n  </g>\r\n</svg><span>London Events</span></a><a href=/hashtag/wheatsheafcommunityhall><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" height=\"25px\" width=\"25px\" version=\"1.1\" id=\"_x32_\" viewBox=\"0 0 512 512\" xml:space=\"preserve\">\r\n<g>\r\n\t<path class=\"st0\" d=\"M320.707,0L37.037,69.971v417.625L320.447,512l154.516-26.258V62.568L320.707,0z M290.346,471.742   l-92.584-7.974v-79.426l-55.086-0.677v75.36l-68.109-5.866V99.367l215.779-53.224V471.742z\"/>\r\n\t<polygon class=\"st0\" points=\"271.25,76.933 226.537,86.32 226.537,138.956 271.25,131.246  \"/>\r\n\t<polygon class=\"st0\" points=\"118.574,112.033 87.416,