     </div>\r\n\r\n                    </div>\r\n\r\n                    \r\n                    <div class=\"top-header-margin\"></div>\r\n                    \r\n\r\n                    <!-- HEADER -->\r\n\r\n                    \r\n\r\n    \r\n\r\n        <div id=\"page-events-wrapper\">\r\n\r\n            \r\n\r\n            <div class=\"event-header page\">\r\n                <div class=\"event-header-image_blurry\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/3d4272a0-a5e6-45fa-acc6-cac8274954ee.jpg\" class=\"event-header-image lazy\" alt=\"Film: \"Everybody to Kenmure Street\" (in association with Tower Hamlets Stand Up to Racism) header\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/3d4272a0-a5e6-45fa-acc6-cac8274954ee.jpg\" class=\"area-main-feature area-main-feature-small lazy\" alt=\"Film: \"Everybody to Kenmure Street\" (in association with Tower Hamlets Stand Up to Racism) tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n    