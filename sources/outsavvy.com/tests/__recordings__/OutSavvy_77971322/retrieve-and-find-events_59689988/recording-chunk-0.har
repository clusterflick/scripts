iance4Choice presents... Wholly Trinity: Abortion, Art and Activism in Northern Ireland tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/4ae2c5d5-0577-4159-894a-c088df7d891c.png\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"Alliance4Choice presents... Wholly Trinity: Abortion, Art and Activism in Northern Ireland tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Alliance4Choice presents... Wholly Trinity: Abortion, Art and Activism in Northern Ireland</p>\r\n\r\n                        <div class=\"event-item event-item-venue\">\r\n\r\n                            <svg width=\"26px\" height=\"26px\" viewBox=\"0 0 512.000000 512.000000\" class=\"ticket-header-icon\">\r\n\r\n                                <g transform=\"translate(0.000000,512.000000) scale(0.100000,-0.100000)\" fill=\"#000000\" stroke=\"none\">\r\n                                    <path d=\"M2360 5109 c-202 -23 -396 -80 -58