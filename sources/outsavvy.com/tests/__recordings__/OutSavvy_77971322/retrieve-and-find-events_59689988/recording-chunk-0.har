        <div class=\"container container-header\">\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </div>\r\n\r\n                    \r\n                    <div class=\"top-header-margin\"></div>\r\n                    \r\n\r\n                    <!-- HEADER -->\r\n\r\n                    \r\n\r\n    \r\n\r\n        <div id=\"page-events-wrapper\">\r\n\r\n            \r\n\r\n            <div class=\"event-header page event-header-website\">\r\n                <div class=\"event-header-image_blurry\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/706fbde3-501e-484b-b15c-ce20c3056a03.jpg\" class=\"event-header-image lazy\" alt=\"\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/706fbde3-501e-484b-b15c-ce20c3056a03.jpg\" class=\"area-main-feature area-main-feature-website lazy\" alt=\"Solve-Along-A-Murder-She-Wrote: New episode \"Armed Response\" tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/75867949-1b76-447c-be4d-9ea628edd0e7.jpg\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"Solve-Along-A-Murder-She-Wrote: New episode \"Armed Response\" tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Solve-Along-A-Murder-She-Wrote: New episode \"Armed Response\"</p>\r\n\r\n                        <div class=\"event-item event-item-venue\">\r\n\r\n                            <svg width=\"26px\" height=\"26px\" viewBox=\"0 0 512.000000 512.000000\" class=\"ticket-header-icon\">\r\n\r\n                                <g transform=\"translate(0.000000,512.000000) scale(0.100000,-0.100000)\" fill=\"#000000\" stroke=\"none\">\r\n                                    <path d=\"M2360 5109 c-202 -23 -396 -80 -585 -173 -376 -185 -656 -466 -835 -839 -326 -676 -210 -1403 383 -2397 169 -283 326 -517 722 -1075 132 -187 279 -396 327 -465 90 -131 124 -160 188 -160 64 0 98 29 188 160 48 69 195 278 327 465 388 546 559 801 724 1079 533 897 674 1550 470 2181 -38 117 -141 326 -218 440 -368 550 -1033 858 -1691 784z m495 -319 c681 -143 1170 -714 1202 -1405 16 -333 -84 -701 -317 -1165 -183 -365 -385 -682 -920 -1438 -140 -199 -257 -361 -260 -361 -3 0 -31 37 -62 82 -31 45 -154 219 -273 387 -236 332 -471 679 -582 860 -415 676 -601 1199 -580 1635 26 547 334 1023 827 1274 150 77 311 126 490 151 106 15 361 4 475 -20z\" />\r\n                                    <path d=\"M2380 4201 c-339 -74 -601 -323 -691 -656 -18 -65 -22 -107 -22 -225 0 -118 4 -160 22 -225 88 -324 340 -570 668 -652 103 -26 323 -23 428 6 317 85 560 329 646 646 18 65 22 107 22 225 0 118 -4 160 -22 225 -86 318