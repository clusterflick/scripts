1.8 1.9v22.3c0 1-.8 1.9-1.8 1.9H1.8c-1 0-1.8-.8-1.8-1.9V1.9C0 .8.8 0 1.8 0z\" fill=\"#0081c9\"></path><path d=\"M31 12.9l2.8-3.2h-4.1l-.7.9-.7-.9H17.5l-.7 1.8-.8-1.8h-3.5v2.5l-1.2-2.5H8.7l-3.2 6.7H9l.5-1.1h1l.5 1.1h17l.9-1.1.9 1.1H34l-3-3.5zm-18.1 2.5h-1.4l-.5-1.1H8.8l-.5 1.1H7l2.3-4.7h1.4l2.2 4.7zm7.1 0h-1.3V12l-1.5 3.4h-1L14.7 12v3.3h-1.3v-4.7h1.9l1.4 3.3 1.3-3.3h2v4.8zm5.8 0h-4.6v-4.7h4.6v.9h-3.2v1h2.9v.8h-2.9v1.2h3.3v.8zm3.1-1.7l-1.4 1.6H26l2.1-2.5-2-2.3h1.6l1.2 1.5 1.2-1.5h1.5l-2 2.3 2.1 2.5h-1.6l-1.2-1.6z\" fill=\"#fff\"></path><path fill=\"#fff\" d=\"M9.9 11.8l-.8 1.7h1.6l-.7-1.7z\"></path></svg>\n                                                </div>\n                                                <div class=\"card-holder infopop\" title=\"Apple Pay\">\n                                                    <svg width=\"27\" height=\"18\" viewBox=\"0 0 39 26\">\n                                                        <path d=\"M1.82 0h35.36c1 0 1.82.83 1.82 1.85v22.3c0 1.02-.82 1.85-1.82 1.85H1.82C.82 26 0 25.17 0 24.15V1.85C0 .83.82 0 1.82 0z\" fill=\"#f5f6f8\"></path><path d=\"M37.18.65c.65 0 1.18.54 1.18 1.2v22.3c0 .66-.53 1.2-1.18 1.2H1.82c-.65 0-1.18-.54-1.18-1.2V1.85c0-.66.53-1.2 1.18-1.2h35.36m0-.65H1.82C.82 0 0 .83 0 1.85v22.3C0 25.17.82 26 1.82 26h35.36c1.01 0 1.82-.83 1.82-1.85V1.85C39 .83 38.18 0 37.18 0z\" opacity=\"0.1\"></path><g><path d=\"M10.57 9.1c.32-.4.54-.93.48-1.48-.47.02-1.04.31-1.37.71-.3.34-.56.9-.49 1.42.53.05 1.05-.26 1.38-.65M11.05 9.86c-.76-.05-1.41.43-1.77.43-.36 0-.92-.41-1.52-.4-.78.01-1.51.45-1.91 1.16-.82 1.41-.22 3.5.58 4.65.39.57.85 1.19 1.47 1.17.58-.02.81-.38 1.51-.38s.91.38 1.52.36c.64-.01 1.03-.57 1.42-1.14.44-.65.62-1.27.64-1.31-.01-.01-1.23-.48-1.24-1.88-.01-1.17.95-1.73 1-1.76-.56-.79-1.41-.88-1.7-.9\"></path>\n                                                            <g>\n                                                                <path d=\"M18.64 8.27c1.65 0 2.81 1.14 2.81 2.8 0 1.67-1.18 2.81-2.85 2.81h-1.83v2