div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Tongue on Cheek: erotic queer films + writing workshop\",\"startDate\": \"2026-09-01T19:00:00+01:00\",\"endDate\": \"2026-09-01T21:00:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/38823/tongue-on-cheek-erotic-queer-films-writing-workshop\",\"image\" : \"https://cdn.outsavvy.com/events/c9f971a9-faf4-4356-98a4-a5e5362c5b58.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"⭐️ Join us for an evening of queer erotic short films to ignite the imagination (and the loins) ⭐️ Watching sex on screen has mostly been relegated to the domestic sphere; gone are the days of gay porn theatres and its attendant thrills of cruising between rows of crushed velvet.  But to encounter the erotic, we must venture out of our comfort zone and come cheek to cheek with the unknown. Gaze into the glory hole, and something long and purple might just gaze back.Following the screening, writer Ashe Mckenzie will facilitate an erotica writing workshop with prompts for you to transfigure your most scintillating fantasies into prose.  All profits from the ticket sales will go directly to a Palestinian friend to fund their medical evacuation. For more information, please visit: https://www.gofundme.com/f/help-abood-rebuild-his-life \",\"location\": {\"@type\": \"Place\",\"name\": \"The People&#39;s Letters Bookshop\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The People&#39;s Letters Bookshop, 395 Cambridge Heath Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E2 9RA\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.53062\", \"longitude\" : \"-0.0564691\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-01T18:00:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38823/tongue-on-cheek-erotic-queer-films-writing-workshop\",\"lowPrice\":8,\"highPrice\":8,\"availabilityStarts\":\"2026-08-17T18:01:52+01:00\",\"validFrom\":\"2026-08-17T18:01:52+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-01T18:00:00+01:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38823/tongue-on-cheek-erotic-queer-films-writing-workshop\",\"price\":8,\"availabilityStarts\":\"2026-08-17T18:01:52+01:00\",\"validFrom\":\"2026-08-17T18:01:52+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/jjambbong-film-club\", \"description\" : \"Community film club serving up a greasy soup of Asian cinema.\", \"name\" : \"Jjambbong Film Club\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 38823,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 5046,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n  