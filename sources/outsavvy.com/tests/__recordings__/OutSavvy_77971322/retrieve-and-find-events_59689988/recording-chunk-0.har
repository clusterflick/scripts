                          <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">Tickets Off Sale</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/5a9f93bd-91f8-46b9-a54a-563b5dd5009b.jpg\" alt=\"Bank Holiday Monday with The D.E Experience\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"TRANSMISSIONS x DREAM EMULATOR PRESENT: eXistenZ ***VHS***\",\"startDate\": \"2026-09-09T19:00:00+01:00\",\"endDate\": \"2026-09-09T22:00:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39159/transmissions-x-dream-emulator-present-existenz-vhs\",\"image\" : \"https://cdn.outsavvy.com/events/b0f43b4a-652e-41a0-b3d0-0c850de1d0df.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"A London institution, Dalston Superstore&#39;s weekly film night Transmissions joins forces once again with the distinguished pixel farmers at Dream Emulator (Silent Hill Rave) for a very special VHS presentation of David Cronenberg&#39;s seductive cyberpunk Thriller eXistenZ (1999).The team who brought you the Rio&#39;s late-night screening of Crimes of the Future (2022) in March are back with another career high from the Canadian auteur that dives into a sticky, characteristically perverse take on virtual reality gaming where guns with teeth for bullets and fleshy consoles mark an eerie landscape you&#39;ll never want to leave.Jennifer Jason Leigh, Jude Law, Ian Holm, and Willem Dafoe star in a film about the pleasures and perils of giving your mind over to digital playgrounds; harnessing the era&#39;s anxieties and lacing them with hybrid flesh-tech eroticism and a propulsive, slippery energy that makes it one of Cronenberg&#39;s most memorable works.Join us in the bowels of Dalston Superstore, then sit back, and breathe calmly.The game has already begun.  Unfortunately subtitles are unavailable due to the format.Seating is a mixture of benches, backed chairs, bar stools, and floor space, and is first come, first served.\",\"location\": {\"@type\": \"Place\",\"name\": \"Dalston Superstore\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Dalston Superstore, 117 Kingsland High Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E8 2PB\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.5501\", \"longitude\" : \"-0.0753984\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-09T18:00:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39159/transmissions-x-dream-emulator-present-existenz-vhs\",\"lowPrice\":5,\"highPrice\":0,\"availabilityStarts\":\"2026-07-15T22:49:17+01:00\",\"validFrom\":\"2026-07-15T22:49:17+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-09T18:00:00+01:00\",\"name\":\"Free Entry (suggested for trans attendees)\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39159/transmissions-x-dream-emulator-present-existenz-vhs\",\"price\":0,\"availabilityStarts\":\"2026-07-15T22:49:17+01:00\",\"validFrom\":\"2026-07-15T22:49:17+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-09T18:00:00+01:00\",\"name\":\"Donor Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39159/transmissions-x-dream-emulator-present-existenz-vhs\",\"price\":5,\"availabilityStarts\":\"2026-07-15T22:49:17+01:00\",\"validFrom\":\"2026-07-15T22:49:17+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-09T18:00:00+01:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39159/transmissions-x-dream-emulator-present-existenz-vhs\",\"price\":0,\"availabilityStarts\":\"2026-07-15T22:49:17+01:00\",\"validFrom\":\"2026-07-15T22:49:17+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/transmissions1\", \"description\" : \"\", \"name\" : \"TRANSMISSIONS\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 39159,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 2433,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/39159/transmissions-x-dream-emulator-present-existenz-vhs';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.t