=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Trancestors\",\"startDate\": \"2027-03-03T19:00:00+00:00\",\"endDate\": \"2027-03-03T21:30:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/37098/trancestors\",\"image\" : \"https://cdn.outsavvy.com/events/bbdd22a1-67e8-4c0d-bb76-0924357db119.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Transcestors with EJ Scott Doors at 6pmAction at 7pmCarriages 9.30pm Who were the gender outlaws in the London of the 70’s, ’80&#39;s and ’90’s?  How did trans people identify and how did trans culture reveal itself before the T-revolution of the 21st century? EJ Scott speaks with Nando Messias,  Jason Barker and others about transcestory, identity, the mental health of the marginalised and the magic of transformation Plus research from the TV/TS Group to the Beaumont Society, from the ‘drag&#39; balls at Porchester Hall to developments at the gender identity clinic at Charing Cross Hospital   Free tea, coffee and biscuits \",\"location\": {\"@type\": \"Place\",\"name\": \"Wheatsheaf Community Hall\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Wheatsheaf Community Hall, off Wheatsheaf Lane\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SW8 2UP\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.48093\", \"longitude\" : \"-0.1252938\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2027-03-03T18:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/37098/trancestors\",\"lowPrice\":15,\"highPrice\":5,\"availabilityStarts\":\"2026-06-09T13:10:00+01:00\",\"validFrom\":\"2026-06-09T13:10:00+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2027-03-03T18:00:00+00:00\",\"name\":\"Classy Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/37098/trancestors\",\"price\":15,\"availabilityStarts\":\"2026-06-09T13:10:00+01:00\",\"validFrom\":\"2026-06-09T13:10:00+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2027-03-03T17:00:00+00:00\",\"name\":\"Cheap Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/37098/trancestors\",\"price\":5,\"availabilityStarts\":\"2026-06-10T13:36:39+01:00\",\"validFrom\":\"2026-06-10T13:36:39+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2027-03-03T18:00:00+00:00\",\"name\":\"Ordinary Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/37098/trancestors\",\"price\":10,\"availabilityStarts\":\"2026-07-20T15:11:22+01:00\",\"validFrom\":\"2026-07-20T15:11:22+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/duckie\", \"description\" : \"\", \"name\" : \"Duckie\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 37098,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 787,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/37098/trancestors';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: fu