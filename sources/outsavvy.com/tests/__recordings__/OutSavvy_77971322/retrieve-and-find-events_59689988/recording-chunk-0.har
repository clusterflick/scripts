0.426,104.23 150.426,153.027 190.012,146.202  \"/>\r\n\t<polygon class=\"st0\" points=\"118.576,203.184 87.416,207.448 87.416,253.722 118.576,250.622  \"/>\r\n\t<polygon class=\"st0\" points=\"190.012,192.792 150.426,198.154 150.426,246.952 190.012,243.052  \"/>\r\n\t<polygon class=\"st0\" points=\"271.25,181.04 226.537,187.097 226.537,238.911 271.25,234.506  \"/>\r\n\t<polygon class=\"st0\" points=\"271.25,286.135 226.537,288.889 226.537,340.702 271.25,339.6  \"/>\r\n\t<polygon class=\"st0\" points=\"190.012,291.476 150.426,293.914 150.426,342.712 190.012,341.737  \"/>\r\n\t<polygon class=\"st0\" points=\"118.574,296.198 87.416,298.136 87.416,344.409 118.574,343.634  \"/>\r\n</g>\r\n</svg><span>The Peoples Letters</span></a><a href=/hashtag/workshop><span>Workshop</span></a><a href=/hashtag/screening><span>Screening</span></a><a href=/hashtag/fundraiser><span>Fundraiser</span></a><a href=/hashtag/writing><span>Writing</span></a>\r\n                                </span>\r\n                            </div>\r\n\r\n                        \r\n\r\n                    </div>\r\n                    <div style=\"margin-top: 14px; margin-bottom: 14px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n        <div class=\"line-red-holder\">\r\n            <h4 class=\"line-red\">The Lineup\r\n\r\n            </h4>\r\n        </div>\r\n\r\n        <div id=\"lineup\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n                    <div class=\"content-body\">\r\n                        <div class=\"event-description\">\r\n                            <span><p><strong>Organsier Bios:</strong></p><p>Emily Jisoo Bowles is a film critic and a film programmer at Queer East Festival. Her writing can be found in A Rabbit's Foot, Documentary Magazine, and more.</p><p>Ashe McKenzie is a writer and qualified educator. Her upmarket contemporary novel was shortlisted for Merkybooks New Writers Prize 2024/25 and the 2026 London Writers Award. Her writing practice is interested in the intersections between diverging lives and through this practice, questions whether we are who we are perceived to be. As a community builder, she has been co-running the Writers Gym at the London Vagina Museum for 2 years and continues to give back to her community through collaborations with other writers and organisers.</p></span>\r\n                        </div>\r\n                    </div>\r\n                    <div style=\"margin-top: 24px; margin-bottom: 24px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n        \r\n\r\n        <div id=\"need-to-know\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <div class=\"line-red-holder\">\r\n                        <h4 class=\"line-red\">What You Need To Know\r\n\r\n                        </h4>\r\n                    </div>\r\n\r\n                    <div class=\"event-description\">\r\n                        \r\n\r\n                        <p>\r\n                            Age restriction: 18+ only\r\n                        </p>\r\n                        \r\n                    </div>\r\n\r\n                    <div style=\"margin-top: 44px; margin-bottom: 44px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n        <section class=\"hosted-by-control\">\r\n\r\n            <div class=\"line-red-holder\">\r\n                <h4 class=\"line-red\">Hosted By\r\n\r\n                </h4>\r\n            </div>\r\n\r\n            <div class=\"hosted-by-control__layout\">\r\n\r\n                \r\n\r\n\r\n                <div class=\"hosted-by-control__content\">\r\n\r\n                    <div class=\"hosted-by-control__name\">\r\n\r\n                        <a href=\"/organiser/jjambbong-film-club\" target=\"_blank\"