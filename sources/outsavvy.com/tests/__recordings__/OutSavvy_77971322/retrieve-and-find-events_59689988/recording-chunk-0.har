            "mimeType": "text/html; charset=utf-8",
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tIt's October 3rd: A Mean Girls Party! Tickets | 03 Oct @ Two Brewers, London | £10 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script async src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/7fe0f610674626944167a99dcfa57a351cfe742a930afe976c016bb3f608223c5956cdd8ab3167f15d9b50a337b27eba0ccb8113b99bd5e19f1cee33041b1821/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2026-08-31\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"Welcome to Northshore Academy… Well, actually it&#39;s in the two brewers… It&#39;s October 3rd, and that can only mean one thing: MEAN GIRLS.   We&#39;re hosting an interactive, “quote-a-long” screening of the iconic 2004 classic, with drag hosts, a Mean Girls Quiz and plenty of 00&#39;s nostalgia.  Expect silliness galore as we poke fun, shout-out iconic quotes and get involved in London&#39;s campest viewing party.  Doors @ 6.30Party starts @ 7pmHosted by Woe Addams and Pixie Polite.  So what are you waiting for? Limited tickets available so don&#39;t miss out, it&#39;s gonna be so FETCH.  &amp;lt;3 \" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"It&#39;s October 3rd: A Mean Girls Party! Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/39097/mean-girls-party\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/d1170a23-43c4-4e1f-b234-fd3cf529878c.jpg\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"It's October 3rd: A Mean Girls Party! Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/39097/mean-girls-party\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/d1170a23-43c4-4e1f-b234-fd3cf529878c.jpg?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"Welcome to Northshore Academy… Well, actually it&#39;s in the two brewers… It&#39;s October 3rd, and that can only mean one thing: MEAN GIRLS.   We&#39;re hosting an interactive, “quote-a-long” screening of the iconic 2004 classic, with drag hosts, a Mean Girls Quiz and plenty of 00&#39;s nostalgia.  Expect silliness galore as we poke fun, shout-out iconic quotes and get involved in London&#39;s campest viewing party.  Doors @ 6.30Party starts @ 7pmHosted by Woe Addams and Pixie Polite.  So what are you waiting for? Limited tickets available so don&#39;t miss out, it&#39;s gonna be so FETCH.  &amp;lt;3 \" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/39097/mean-girls-party\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | It&#39;s October 3rd: A Mean Girls Party! | Saturday 3rd October 2026 @ Two Brewers | £10 | Find event and ticket information for TwoBox Productions\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(docum