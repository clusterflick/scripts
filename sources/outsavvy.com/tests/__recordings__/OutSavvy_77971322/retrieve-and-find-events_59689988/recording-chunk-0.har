                <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">Tickets Off Sale</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/5a9f93bd-91f8-46b9-a54a-563b5dd5009b.jpg\" alt=\"Bank Holiday Monday with The D.E Experience\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Fringe! Queer Film and Arts Fest Presents: Video Home Self (Shorts)\",\"startDate\": \"2026-09-19T13:00:00+01:00\",\"endDate\": \"2026-09-19T15:00:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39033/fringe-queer-film-and-arts-fest-presents-video-home-self-shorts\",\"image\" : \"https://cdn.outsavvy.com/events/a71a50c0-818c-44bd-97bc-6871df826cfb.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"There’s no place like home?Join Fringe.  Queer Film and Arts Fest at the Museum of the Home for a programme of short films.Drawing on home video aesthetics and archival media, this programme explores how film formats shape our understanding of selfhood through place, relationships, memory and family. Making memories, or deconstructing them, these works chase ghosts, unravel inherited narratives, reconfigure the past, and embrace transformation. Rather than stewing in the comfort of nostalgia, this strand asks what it means to process memory as home.The screening will take place in Hive Room 3 at the Museum of the Home. Runtime: 86 minutes + IntroIn various languages with English subtitlesCW: Sexual content\",\"location\": {\"@type\": \"Place\",\"name\": \"Museum of the Home\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Museum of the Home, 136 Kingsland Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E2 8EA\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.53152\", \"longitude\" : \"-0.07644\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-19T12:00:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39033/fringe-queer-film-and-arts-fest-presents-video-home-self-shorts\",\"lowPrice\":6,\"highPrice\":6,\"availabilityStarts\":\"2026-08-25T13:20:42+01:00\",\"validFrom\":\"2026-08-25T13:20:42+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-19T12:00:00+01:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39033/fringe-queer-film-and-arts-fest-presents-video-home-self-shorts\",\"price\":6,\"availabilityStarts\":\"2026-08-25T13:20:42+01:00\",\"validFrom\":\"2026-08-25T13:20:42+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/fringe\", \"description\" : \"Fringe.  is a film and arts festival rooted in London&#39;s queer creative scene and welcoming everyone. We&#39;re not-for-profit and run by a team of passionate volunteers. From feature films to experimental art, workshops to talks and wild parties to tickle every one of the senses. With our signature blend of eye opening movies, DIY and experimental work, the thoughtful, the provocative and the strange.Fringe.  Fest was launched in 2011, by a group of queer creatives as a community response to arts cuts carnage. Our mission is to offer a dynamic, representative and unmistakably fresh alternative to other film and arts festivals.\", \"name\" : \"Fringe! Queer Film &amp; Arts Fest\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 39033,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 27,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(resu