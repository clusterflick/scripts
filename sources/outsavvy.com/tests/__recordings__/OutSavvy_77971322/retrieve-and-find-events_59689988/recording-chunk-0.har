            "mimeType": "text/html; charset=utf-8",
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tTRANSMISSIONS PRESENTS: Bug + Cronenberg short The Nest Tickets | 16 Sep @ Dalston Superstore, London | Pay What You Can to £5 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script async src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/7fe0f610674626944167a99dcfa57a351cfe742a930afe976c016bb3f608223c5956cdd8ab3167f15d9b50a337b27eba0ccb8113b99bd5e19f1cee33041b1821/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2026-08-30\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"The legendary director of The Exorcist (1973) adapts Tracy Letts&#39; paranoid stage thriller in Bug (2006), starring Michael Shannon and Ashley Judd as lovers who are either uncovering a horrifying conspiracy, or sharing the same delusion.Searingly performed and viscerally disturbing, this William Friedkin deep cut screens right after an even rarer short by David Cronenberg, The Nest (2013), where the director stars as a back-alley surgeon during a consultation with a woman who believes there is something living beneath her skin.Find us downstairs at Dalston Superstore for a skin-crawling double bill as we travel deeper into two months of body horror.  Subtitles will be displayed for Bug.Seating is a mixture of benches, backed chairs, bar stools, and floor space, and is first come, first served.\" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"TRANSMISSIONS PRESENTS: Bug + Cronenberg short The Nest Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/39161/transmissions-presents-bug-cronenberg-short-the-nest\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/e76e08e0-b46d-4f32-be12-234b6cf1c2f5.png\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"TRANSMISSIONS PRESENTS: Bug + Cronenberg short The Nest Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/39161/transmissions-presents-bug-cronenberg-short-the-nest\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/e76e08e0-b46d-4f32-be12-234b6cf1c2f5.png?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"The legendary director of The Exorcist (1973) adapts Tracy Letts&#39; paranoid stage thriller in Bug (2006), starring Michael Shannon and Ashley Judd as lovers who are either uncovering a horrifying conspiracy, or sharing the same delusion.Searingly performed and viscerally disturbing, this William Friedkin deep cut screens right after an even rarer short by David Cronenberg, The Nest (2013), where the director stars as a back-alley surgeon during a consultation with a woman who believes there is something living beneath her skin.Find us downstairs at Dalston Superstore for a skin-crawling double bill as we travel deeper into two months of body horror.  Subtitles will be displayed for Bug.Seating is a mixture of benches, backed chairs, bar stools, and floor space, and is first come, first served.\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/39161/transmissions-presents-bug-cronenberg-short-the-nest\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | TRANSMISSIONS PRESENTS: Bug + Cronenberg short The Nest | Wednesday 16th September 2026 @ Dalston Superstore | Pay What You Can to £5 | Find event and ticket information for TRANSMISSIONS\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n        function showShareModal() {\r\n            $('#shareModa