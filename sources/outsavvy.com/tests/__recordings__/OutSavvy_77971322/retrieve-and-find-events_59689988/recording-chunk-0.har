      holder.querySelector(\".event-date-card\");\n\n        if (!card)\n            return;\n\n        var gap = 14;\n        var amount =\n            (card.offsetWidth + gap) * 2;\n\n        holder.scrollBy({\n            left: amount * direction,\n            behavior: \"smooth\"\n        });\n}\n\nfunction selectEventDate(card, eventDateId) {\n\n    selectDateCard(card);\n\n    document.getElementById(\"HiddenDate\").value =\n        eventDateId;\n\n    __doPostBack(\n        'ctl00$FullWidth$SelectTickets$ButtonDateRefresh',\n        ''\n    );\n    }\n\n\n    function scrollToSelectedDate() {\n\n        var holder =\n            document.getElementById(\"event-date-scroll\");\n\n        if (!holder)\n            return;\n\n        var selected =\n            holder.querySelector(\".event-date-card--selected\");\n\n        if (!selected)\n            return;\n\n        var position =\n            selected.offsetLeft -\n            ((holder.clientWidth - selected.offsetWidth) / 2);\n\n        if (position < 0)\n            position = 0;\n\n        holder.scrollLeft = position;\n    }\n\n    function appQueueRefresh() {\n        var iframe = document.createElement('iframe');\n        iframe.setAttribute('src', \"queuepass:webToNativeCall\");\n        document.documentElement.appendChild(iframe);\n        iframe.parentNode.removeChild(iframe);\n        iframe = null;\n        Android.queueRefresh();\n    }\n\n    var jsonDates = [{\"EventDateId\":81282,\"StartDate\":\"2026-09-03\",\"DisplayDate\":\"Thursday 3rd September 2026 \",\"DisplayPrice\":\"FREE\",\"CssClass\":\"availability-green\",\"Times\":[{\"EventDateId\":81282,\"Time\":\"7:00 PM\",\"DisplayPrice\":\"FREE\",\"DisplayDate\":\"Thursday 3rd September 2026  @ 7:00 PM\"},{\"EventDateId\":81283,\"Time\":\"7:00 PM\",\"DisplayPrice\":\"FREE\",\"DisplayDate\":\"Thursday 3rd September 2026  @ 7:00 PM\"}]},{\"EventDateId\":81284,\"StartDate\":\"2026-09-10\",\"DisplayDate\":\"Thursday 10th September 2026  @ 7:00 