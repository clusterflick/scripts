n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"CAMP CLASSICS presents STARRBOOTY at The Divine\",\"startDate\": \"2026-09-17T19:30:00+01:00\",\"endDate\": \"2026-09-17T21:30:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39044/camp-classics-presents-starrbooty-at-the-divine\",\"image\" : \"https://cdn.outsavvy.com/events/11e5644a-76bc-4dc6-bf8e-50212a08e5be.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"CAMP CLASSICS presents STARRBOOTY at The Divine.CAMP CLASSICS is a queer film club. We screen films that are queer, camp, silly, retro, sometimes glazed over, or with cult followings, but mostly films that make you realise you don’t need a trillion-dollar budget and an all-star cast to make a film that has an impact.  On September 17th, we&#39;ll be showing RuPaul&#39;s 2007 cracked out classic, that previously only existed on PornHub, at the iconic East London venue - The Divine. Directed by Mike Ruiz, this little-known work of art stars Rupaul as Agent Starrbooty as she goes undercover as a prostitute in search of her adopted niece. Expect nudity, debauchery, a makeover montage and 90 minutes of pure psychotic fever dream madness that will leave you in stitches.  Doors 7.30Film 8.00Duration 90 mins CAMP CLASSICS is a great place to meet other queers with twisted minds so come for the giggles and stay for the vibes. &amp;lt;3 ACCESS INFO:Unfortunately, both floors of The Divine are not currently accessible as we do nothave a lift.- The ground floor, main bar of The Divine has level access.- There is an accessible toilet in the main bar.- The cabaret and club space are in the basement of the venue. There is no lift.- There are 17 wide steps down to the basement with handrails on either side, this iswhere the show will take place.- There are two sets of gender-neutral toilets downstairs, they are not wide enoughfor wheelchairs.If you need further information, please refer to The Divine ‘About’ page on thewebsite. www.thedivine.co.uk or email us direct on info@thedivine.co.uk\",\"location\": {\"@type\": \"Place\",\"name\": \"The Divine\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Divine, 33-35 Stoke Newington Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"N16 8BJ\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.55179\", \"longitude\" : \"-0.0753553\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-17T19:29:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39044/camp-classics-presents-starrbooty-at-the-divine\",\"lowPrice\":6,\"highPrice\":0,\"availabilityStarts\":\"2026-08-25T21:10:44+01:00\",\"validFrom\":\"2026-08-25T21:10:44+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-17T19:29:00+01:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39044/camp-classics-presents-starrbooty-at-the-divine\",\"price\":6,\"availabilityStarts\":\"2026-08-25T21:10:44+01:00\",\"validFrom\":\"2026-08-25T21:10:44+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-09-17T19:29:00+01:00\",\"name\":\"Carer Companion Ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39044/camp-classics-presents-starrbooty-at-the-divine\",\"price\":0,\"availabilityStarts\":\"2026-08-25T21:10:44+01:00\",\"validFrom\":\"2026-08-25T21:10:44+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/camp-classics\", \"description\" : \"CAMP CLASSICS is a queer film club. We screen films that are queer, camp, silly, retro, sometimes glazed over, or with cult followings, but mostly films that make you realise you don’t need a trillion-dollar budget and an all-star cast to make a film that has an impact. \", \"name\" : \"CAMP CLASSICS\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 39044,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 7914,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button