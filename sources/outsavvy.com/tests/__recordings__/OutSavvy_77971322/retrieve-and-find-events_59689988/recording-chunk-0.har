  <h4 class=\"heading-4\">Support\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"https://partners.outsavvy.com\">\r\n                                <h4 class=\"heading-4\">Add Event\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    <div class=\"nav-menu-links-wrap\">\r\n\r\n                        <label for=\"locationBtn\">\r\n                            <div class=\"location-popup\" style=\"text-align: left; padding-top: 10px; padding-bottom: 10px; margin: 0;\">\r\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 1024 1024\" fill=\"#000000\">\r\n                                    <path d=\"M800 416a288 288 0 1 0-576 0c0 118.144 94.528 272.128 288 456.576C705.472 688.128 800 534.144 800 416zM512 960C277.312 746.688 160 565.312 160 416a352 352 0 0 1 704 0c0 149.312-117.312 330.688-352 544z\"></path>\r\n                                    <path d=\"M512 512a96 96 0 1 0 0-192 96 96 0 0 0 0 192zm0 64a160 160 0 1 1 0-320 160 160 0 0 1 0 320z\"></path>\r\n                                </svg>\r\n                                <p>Newham</p>\r\n                            </div>\r\n                        </label>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/accountlogin\">\r\n                                <h4 class=\"heading-4\">Login\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"/event/38362/bank-holiday-monday-with-the-de-experience\" aria-label=\"Bank Holiday Monday with The D.E Experience\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">Tickets Off Sale</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/5a9f93bd-91f8-46b9-a54a-563b5dd5009b.jpg\" alt=\"Bank Holiday Monday with The D.E Experience\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Bank Holiday Monday with The D.E Experience\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Royal Vauxhall Tavern - Monday 31st August 2026</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Solve-Along-A-Murder-She-Wrote: New episode &quot;Armed Response&quot;\",\"startDate\": \"2026-10-15T19:00:00+01:00\",\"endDate\": \"2026-10-15T23:45:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response\",\"image\" : \"https://cdn.outsavvy.com/events/706fbde3-501e-484b-b15c-ce20c3056a03.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"The cult hit event Solve-Along-A-Murder-She-Wrote continues its residency at the Royal Vauxhall Tavern with a presentation of the classic episode “Armed Response”. Jessica Fletcher is holed up in hospital but that&#39;s not enough to stop her solving a murder in Texas, against a background of oil tycoons, feuding doctors and heartbroken nurses. Can you solve the crime before Jessica Fletcher?“Armed Response” follows riotous presentations of “A Fashionable Way to Die”, “Old Habit Die Hard&quot;, &quot;Jessica Behind Bars&quot;, “Sing a Song of Murder”, “Broadway Malady”, “If It&#39;s Thursday, It Must Be Beverly” and many more.   Solve-Along-A-Murder-She-Wrote is a unique and hilarious night featuring games, prizes and audience participation, with special permission from NBC Universal Television. See the show Time Out rated one of 2021 and 2019’s 50 Great Nights Out in London that has played to sell-out audiences across the UK and Australia. Can you solve the crime before JB Fletcher? Hosted by super-fan Tim Benzie, Solve-Along-A-Murder-She-Wrote features: * A race to solve to the crime, via the Fameometer and the Suspiciometer. * A Cabot Cove quiz and raffle. * A singalong to the theme tune with new lyrics. * Clips and biogs of the campy guest stars. Tim Benzie is obsessed with Murder, She Wrote, having watched the original series when it was first broadcast, and now relishing the repeats on television everywhere. An award-winning playwright and co-writer of the Royal Vauxhall Tavern’s 2017-2025 pantos (‘Goosed’, ‘Rubbed’, ‘Slipped&#39;, ‘Pricked’, ‘Cracked’, ‘Tossed’ and ‘Wolfed’). He is the co-producer of the camp club night PopHorror. Tickets: &#163;11 early-bird&#163;15 guaranteed seating until sold out. Must be seated by 7:45pm to keep the seats. &#163;15 limited seating - first come, first served. Get there for 7pm doors for your best chance for a seat.&#163;16 on the door (limited number - doors at 7pm)Times: Doors open at 7pmShow is at 7:45pmThis year we are reducing the number of guaranteed seats and increasing the seats available from 7pm. There are approximately 30 guaranteed seats but an additional 60 seats are available from 7pm doors. (Holders of guaranteed seat tickets must be seated by 8pm to keep the seats.)The RVT offers bar services and capacity for standing room. NB this is a seating and standing venue.THE CRITICS SPEAK. &quot;If you get a chance to see this show live: run, don&#39;t walk.”Newsweek&quot;You’ll be swept away with Jessica Fletcher feels … it has the BEST HOST.”Time Out London“A complete triumph”The Scotsman&quot;As soon as I saw it was on at the [Edinburgh] Fringe I elbowed my way through the other BW reviewers, pushed a couple of them over … just so I could get to the front of the queue and see this show again. And it did not disappoint ... I&#39;d go again in a heartbeat.”5 stars *****Broadway World“I’d challenge anyone to sit through this show and not get utterly invested in figuring out whodunit, whilst smiling at the comfort that this 80’s drama brings.”4 stars ****West End Wilma“It didn’t take long for Benzie to have the audience in stitches and he had the whole crowd in the palm of his hand the entire evening.”Bristol 24/7 ”For a funny, campy evening, there is little that could beat Solve-Along-A-Murder-She-Wrote’s unique qualities and Benzie’s wit and charm. Personally this reviewer can’t wait to revisit Cabot Cove. Never mind &#39;whodunnit&#39;, more like &#39;yougottadoit. &quot;4 stars ****The Reviews Hub “A unique and thoroughly enjoyable theatre experience”Blue Curtains Brisbane**AccessibilityRoyal Vauxhall Tavern welcomes all people with disabilities and access needs and we will try and assist with your access requirements.We strongly advise you to contact us before your visit. Limited free personal assistance tickets are available for most events and we can try to reserve seating if needed, there are seats with an upward step to the raised area and small stools on ground level.The RVT has an accessible main door, with a small ramp for wheelchairs and is flat throughout the main area. There are toilet cubicles that can be accessed without steps, but are not wheelchair accessible.On busy events we can’t always guarantee a clear view of the stage for people in wheelchairs, and the cabaret area does get very busy.\",\"location\": {\"@type\": \"Place\",\"name\": \"Royal Vauxhall Tavern\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Royal Vauxhall Tavern, 372 Kennington Lane\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE11 5HY\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.48635\", \"longitude\" : \"-0.1218389\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-10-15T18:00:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response\",\"lowPrice\":16,\"highPrice\":12,\"availabilityStarts\":\"2026-07-15T13:31:35+01:00\",\"validFrom\":\"2026-07-15T13:31:35+01:00\",\"offers\":[{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-15T18:00:00+01:00\",\"name\":\"Guaranteed seating for these tickets. Must be seated by 7:45pm to keep the seats\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response\",\"price\":16,\"availabilityStarts\":\"2026-07-15T13:44:15+01:00\",\"validFrom\":\"2026-07-15T13:44:15+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-10-15T18:00:00+01:00\",\"name\":\"Seating not guaranteed for these tickets. Doors open at 7pm, arrive early for your best chance \",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response\",\"price\":16,\"availabilityStarts\":\"2026-07-15T13:44:15+01:00\",\"validFrom\":\"2026-07-15T13:44:15+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-15T18:00:00+01:00\",\"name\":\"Early bird until sold out: guaranteed seating\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response\",\"price\":12,\"availabilityStarts\":\"2026-07-15T13:31:35+01:00\",\"validFrom\":\"2026-07-15T13:31:35+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/solve-along-a-murder-she-wrote\", \"description\" : \"Solve-Along-A-Murder-She-Wrote celebrates all things 80s television mysteries had to offer – contrived scenarios.  No DNA evidence.  Massive hair.  Has-been guest stars.  And of course taking centre stage is film and Broadway star Angela Lansbury as novelist/detective JB Fletcher. Can you solve the crime before Cabot Cove’s best amateur sleuth? Hosted by super-fan Tim Benzie, Solve-Along-A-Murder-She-Wrote features: * A race to solve to the crime, with a Whodunit Poll, a Fame-o-meter and a Suspicio-meter. * A Cabot Cove quiz. * Clips and biogs of the campy guest stars.  Solve-Along-A-Murder-She-Wrote premiered at London’s Royal Vauxhall Tavern in August 2018 and has since played to sold-out houses, touring to Birmingham, Bristol, Brighton, the Sydney Cabaret Festival and the legendary Prince Charles Cinema in Leicester Square. One of Time OutLondon’s 50 Great Nights Out 2019.Tim Benzie is a superfan of Murder, She Wrote, having watched the original series live when it was first broadcast, and now relishing the repeats on television everywhere.Tim is an award-winning playwright and co-writer of the Royal Vauxhall Tavern 2017 and 2018 pantos ‘Goosed’ and ‘Rubbed’ and the upcoming 2019 panto ‘Slipped’. He is the co-producer of cabaret club night PopHorror with Paul Joseph and has starred in PopHorror immersive events “Horror Prom” and “Camp Friday 13th”. For press tickets and enquiries please email solvealonga@gmail.com. For videos and images visit us at www.solvealongamurdershewrote.comand follow us on Instagram, Twitter and Facebook. \", \"name\" : \"Solve Along A Murder She Wrote\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 38017,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 554,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/38017/solve-along-a-murder-she-wrote-new-episode-armed-response';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.test(a) || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\\-(n|u)|c55\\/|capi|ccwa|cdm\\-|cell|chtm|cldc|cmd\\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\\-s|dev