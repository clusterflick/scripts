 <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28px\" height=\"28px\" viewBox=\"0 0 24 24\" fill=\"none\">\r\n                                            <path opacity=\"1\" d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" fill=\"#FFF\"></path>\r\n                                            <path d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                            <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">Film: \"Everybody to Kenmure Street\" (in association with Tower Hamlets Stand Up to Racism)</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p>The film follows the events of a 2021 Home Office immigration raid on Kenmure Street in Glasgow's Pollokshields neighbourhood at dawn on the day of <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Eid_al-Fitr\">Eid al-Fatir</a>. Local residents gathered to prevent the detention of individuals, with hundreds surrounding the Home Office van. Through crowd-sourced footage, archival material, and dramatised scenes, the documentary presents a chronological account of the protest, which successfully prevented&nbsp;the detention. &nbsp;</p><p>The film was awarded the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/Al_Jazeera\">Al Jazeera</a>&nbsp;Documentary Award at Cannes Docs, and has Emma&nbsp;Thompson voicing the part of a participant who wished to remain anonymous, a subject known in the film only as \"Van Man,\" an activist who launched the protest by climbing under the van and wrapping his arm around one of the axles. &nbsp;It also won the Special Jury Award for Civil Resistance at its premiere at the <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://en.wikipedia.org/wiki/2026_Sundance_Film_Festival\">2026 Sundance Film Festiva</a>l. &nbsp;</p><p>“This is a film that will have you punching the air”</p><p>— &nbsp;★★★★★ The Herald</p><p>“A spirited and imperative portrait of collective action… a crucial documentary”</p><p>— &nbsp;RogerEbert.com</p><p>“It’s a morale boosting film”</p><p>— &nbsp;★★★★ The Guardian</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Oxford+House%2c++Derbyshire+Street%2c+London%2c+E2+6HG\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0612937&lat=51.52639&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Oxford+House%2c++Derbyshire+Street%2c+London%2c+E2+6HG\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0612937&lat=51.52639&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n                    <p><span class=locName>Oxford House</span><br/> Derbyshire Street, London, E2 6HG</p>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line-red\">Tagged\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/londonevents><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 48 48\">\r\n  <title>location</title>\r\n  <g id=\"Layer_2\" data-name=\"Layer 2\">\r\n    <g id=\"invisible_box\" data-name=\"invisible box\">\r\n      <rect width=\"48\" height=\"48\" fill=\"none\"/>\r\n    </g>\r\n    <g id=\"icons_Q2\" data-name=\"icons Q2\">\r\n      <path d=\"M24,14a3,3,0,1,1-3,3,2.9,2.9,0,0,1,3-3m0-4a7,7,0,1,0,7,7,7,7,0,0,0-7-7Z\"/>\r\n      <path d=\"M24,6c7.4,0,13,6,13,14S28.4,36.7,24,41.2C19.6,36.7,11,27.5,11,20S16.6,6,24,6m0-4C14.1,2,7,10.1,7,20S18.5,41.3,22.6,45.4a1.9,1.9,0,0,0,2.8,0C29.5,41.3,41,30.1,41,20S33.9,2,24,2Z\"/>\r\n    </g>\r\n  </g>\r\n</svg><span>London Events</span></a><a href=/hashtag/documentary><span>Documentary</span></a><a href=/hashtag/film><span>Film</span></a>\r\n                                </span>\r\n                        