-1c7139a8033e.png\" class=\"event-header-image lazy\" alt=\"\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/90f5b9d9-5093-4fc0-a134-1c7139a8033e.png\" class=\"area-main-feature area-main-feature-website lazy\" alt=\"HIV THE NAKED TRUTH - 6TH YEAR ANNIVERSARY - FILM PREMIERE - BRIGHTON 2026 tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/31f56910-fc27-47d8-8b53-0d8be73b7563.png\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"HIV THE NAKED TRUTH - 6TH YEAR ANNIVERSARY - FILM PREMIERE - BRIGHTON 2026 tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">HIV THE NAKED TRUTH - 6TH YEAR ANNIVERSARY - FILM PREMIERE - BRIGHTON 2026</p>\r\n\r\n                        <div class=\"event-i