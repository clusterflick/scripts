                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/38727/drag-race-uk-season-8-viewing-party';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.test(a) || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\\-(n|u)|c55\\/|capi|ccwa|cdm\\-|cell|chtm|cldc|cmd\\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\\-s|devi|dica|dmob|do(c|p)o|ds(12|\\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\\-|_)|g1 u|g560|gene|gf\\-5|g\\-mo|go(\\.w|od)|gr(ad|un)|haie|hcit|hd\\-(m|p|t)|hei\\-|hi(pt|ta)|hp( i|ip)|hs\\-c|ht(c(\\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\\-(20|go|ma)|i230|ia