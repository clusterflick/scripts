                                          <path opacity=\"1\" d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" fill=\"#FFF\"></path>\r\n                                            <path d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                            <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">HIV THE NAKED TRUTH - 6TH YEAR ANNIVERSARY - FILM PREMIERE - BRIGHTON 2026</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><ul><li>To mark our <strong>6th year anniversary</strong> we are screening our 2020 poignant <strong>1 HOUR</strong> film in Brighton for <strong>World AIDS Day 2026&nbsp;</strong></li><li><strong>Saturday 28th November from 11AM-13:00PM at the Duke of York's Picturehouse in Brighton!</strong></li><li><i><strong>(Only 8mins from brighton railway station)</strong></i></li><li>The profit from this event is in support of two community based HIV charities : <strong>Positive East </strong>in London and <strong>Lunch Positive</strong> in Brighton!</li><li>The Film includes performing artists from around the world - it was filmed &amp; created during Covid_19 shot in different countries : the film includes incredible world class artists such as <i>Mara Galeazzi, Sasha Mukhamedov, Danilo Palmieri, Arun Blair-Mangat &amp; many more talented artists</i></li></ul><p><strong>‘WE HOPE TO BRING OUR HIV COMMUNITY TOGETHER AND MAKE IT A DAY TO REMEMBER FOR AN IMPORTANT CAUSE - CELEBRATING ALL OUR HARD WORK &amp; ACHIEVEMENTS OVER THE LAST SIX YEARS!’&nbsp;</strong></p><ul><li>WE HOPE TO SEE YOU THERE X</li></ul><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Duke+of+Yorks+Picturehouse%2c++Preston+Road%2c+Brighton+%26+Hove%2c+Brighton%2c+BN1+4NA\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1275862&lat=51.50722&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Duke+of+Yorks+Picturehouse%2c++Preston+Road%2c+Brighton+%26+Hove%2c+Brighton%2c+BN1+4NA\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1275862&lat=51.50722&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n                    <p><span class=locName>Duke of Yorks Picturehouse</span><br/> Preston Road, Brighton & Hove, Brighton, BN1 4NA</p>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line-red\">Tagged\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/brightonandhoveevents><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 48 48\">\r\n  <title>location</title>\r\n  <g id=\"Layer_2\" data-name=\"Layer 2\">\r\n    <g id=\"invisible_box\" data-name=\"invisible box\">\r\n      <rect width=\"48\" height=\"48\" fill=\"none\"/>\r\n    </g>\r\n    <g id=\"icons_Q2\" data-name=\"icons Q2\">\r\n      <path d=\"M24,14a3,3,0,1,1-3,3,2.9,2.9,0,0,1,3-3m0-4a7,7,0,1,0,7,7,7,7,0,0,0-7-7Z\"/>\r\n      <path d=\"M24,6c7.4,0,13,6,13,14S28.4,36.7,24,41.2C19.6,36.7,11,27.5,11,20S16.6,6,24,6m0-4C14.1,2,7,10.1,7,20S18.5,41.3,22.6,45.4a1.9,1.9,0,0,0,2.8,0C29.5,41.3,41,30.1,41,20S33.9,2,24,2Z\"/>\r\n    </g>\r\n  </g>\r\n</svg><span>Brighton and Hove Events</span></a><a href=/hashtag/bisexual><span>Bisexual</span></a><a href=/hashtag/gaymen><span>Gay Men</span></a><a href=/hashtag/bipoc><span>BIPOC</span></a><a href=/hashtag/queer><span>Queer</span></a><a href=/hashtag/community><span>Community</span></a><a href=/hashtag/screening><span>Screening</span></a><a href=/hashtag/fundraiser><span>Fundraiser</span></a><a href=/hashtag/film><span>Film</span></a>\r\n                                </span>\r\n                            </div>\r\n\r\n                        \r\n\r\n                    </div>\r\n                    <div style=\"margin-top: 14px; margin-bottom: 14px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n        <div class=\"line-red-holder\">\r\n            <h4 class=\"line-red\">The Lineup\r\n\r\n            </h4>\r\n        </div>\r\n\r\n        <div id=\"lineup\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n                    <div class=\"content-body\">\r\n                        <div class=\"event-description\">\r\n                            <span><ul><li>The<strong> 1 HOUR</strong> Film includes performing artists from around the world - it was filmed &amp; created during Covid_19 shot in many different countries : the film includes incredible world class artists such as <i>Mara Galeazzi, Sasha Mukhamedov, Danilo Palmieri, Arun Blair-Mangat &amp; many more talented artists…</i></li></ul></span>\r\n                        </div>\r\n                    </div>\r\n                    <div style=\"margin-top: 24px; margin-bottom: 24px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n        \r\n\r\n        <div class=\"line-red-holder\">\r\n            <h4 class=\"line-red\">Our Vibe\r\n\r\n            </h4>\r\n        </div>\r\n\r\n        <div class=\"music-container \" id=\"music-container\">\r\n            <div class=\"music-info\">\r\n                <h4 id=\"title\">\r\n                    <label id=\"labelSongName\">Til It Happens To You by Lady Gaga</label>\r\n                </h4>\r\n                <div class=\"progress-container\" id=\"progress-container\">\r\n                    <div class=\"progress\" id=\"progress\"></div>\r\n                </div>\r\n            </div>\r\n\r\n            <audio src='https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview115/v4/fb/8b/c7/fb8bc7d7-b78d-16ca-7a6a-0ac0b00e248e/mzaf_7501128715230775605.plus.aac.p.m4a' id=\"audio\"></audio>\r\n\r\n     