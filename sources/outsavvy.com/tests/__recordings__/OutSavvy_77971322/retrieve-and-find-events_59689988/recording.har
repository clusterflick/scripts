ooter-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"The Golden Spurtle screening + porridge championship!\",\"startDate\": \"2025-11-06T19:00:00:00+00:00\",\"endDate\": \"2025-11-06T21:00:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/30137/the-golden-spurtle-screening-porridge-championship\",\"image\" : \"https://cdn.outsavvy.com/events/60e041c4-9a1f-47e6-83a8-23fff3299566.png\",\"eventStatus\" : \"https://schema.org/EventCancelled\",\"description\" : \"Waltham Forest Cinema Project and Good Shepherd Studios presents a night of film and serious porridge making in Leytonstone. Porridge. A simple bowl of oats, but for many a daily staple and the stuff that life is built on. Every year, the tiny town of Carrbridge in Scotland puts porridge in the spotlight for the Golden Spurtle competition, crowning one contestant as the world’s best porridge maker. This beautiful documentary finds that the ways people make porridge are as wild and unique as the people doing the making.Join us for this screening where 2023 Golden Spurtle winner Adam Kiani and Forridge co-founder James Leach will join us to judge Waltham Forest’s best oats. We have a limited number of tickets for those who want to sample the best porridge from Waltham Forest and help crown the borough&#39;s best porridge maker, along with a world champion.Please note: We will be screening the film with descriptive subtitles for added accessibility.6:30PM – Doors 7PM – Screening 8:15PM – 9PM Q&amp;amp;A with 2023 Golden Spurtle winner Adam Kiani and James Leach, with judging of Waltham Forest&#39;s Best Porridge maker.Screening tickets: &#163;7 • Screening + porridge tasting &#163;12Directed by Constantine CostiFilm run time 75 minsTRAILER\",\"location\": {\"@type\": \"Place\",\"name\": \"Good Shepherd Studios\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Good Shepherd Studios, 15A Davies Lane\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E11 3DR\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.56425\", \"longitude\" : \"0.0122061\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"0001-01-01T00:00:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/30137/the-golden-spurtle-screening-porridge-championship\",\"lowPrice\":0,\"highPrice\":0,\"availabilityStarts\":\"0001-01-01T00:00:00:00+00:00\",\"validFrom\":\"0001-01-01T00:00:00:00+00:00\"},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/waltham-forest-cinema-project\", \"description\" : \"We want to bring a new independent cinema project to Waltham Forest. Until we own our own space, we&#39;re putting on events across the borough to show the kind of fun and community building we want to have in our full cinema. \", \"name\" : \"Waltham Forest Cinema Project\"}},{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"The Golden Spurtle screening + porridge championship!\",\"startDate\": \"2025-11-13T19:00:00:00+00:00\",\"endDate\": \"2025-11-13T21:00:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/30137/the-golden-spurtle-screening-porridge-championship\",\"image\" : \"https://cdn.outsavvy.com/events/60e041c4-9a1f-47e6-83a8-23fff3299566.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Waltham Forest Cinema Project and Good Shepherd Studios presents a night of film and serious porridge making in Leytonstone. Porridge. A simple bowl of oats, but for many a daily staple and the stuff that life is built on. Every year, the tiny town of Carrbridge in Scotland puts porridge in the spotlight for the Golden Spurtle competition, crowning one contestant as the world’s best porridge maker. This beautiful documentary finds that the ways people make porridge are as wild and unique as the people doing the making.Join us for this screening where 2023 Golden Spurtle winner Adam Kiani and Forridge co-founder James Leach will join us to judge Waltham Forest’s best oats. We have a limited number of tickets for those who want to sample the best porridge from Waltham Forest and help crown the borough&#39;s best porridge maker, along with a world champion.Please note: We will be screening the film with descriptive subtitles for added accessibility.6:30PM – Doors 7PM – Screening 8:15PM – 9PM Q&amp;amp;A with 2023 Golden Spurtle winner Adam Kiani and James Leach, with judging of Waltham Forest&#39;s Best Porridge maker.Screening tickets: &#163;7 • Scr