aterTicketTypes$ctl04$HiddenFieldDiscountId\" id=\"FullWidth_SelectTickets_RepeaterTicketCategories_RepeaterTicketTypes_0_HiddenFieldDiscountId_3\" />\r\n\r\n                                                \r\n\r\n                                                \r\n\r\n                                                    <div class=\"strikethrough bottomborder\">\r\n                                                        \r\n\r\n                                                        <div class=\"ticket-group\">\r\n\r\n                                                            <div class=\"ticket-detail ticket-detail-name\">\r\n\r\n                                                                \r\n\r\n                                                                <div class=\"ticket-name-holder\">\r\n                                                                    <span class=\"ticket-name\">\r\n                                                                        Support the Festival <span class=\"ticket-status\"> <span class='waiting-list'>Off Sale</span></span>\r\n                                                                    </span>\r\n\r\n                                                                </div>\r\n\r\n                                                                \r\n                                                            </div>\r\n\r\n                                                            <div class=\"ticket-detail ticket-detail-price text-right\">\r\n\r\n                                                                DONATION\r\n\r\n                                                                <div class=\"fees\">\r\n                                                                    Booking Fee: Added\r\n                                                                </div>\r\n\r\n                                                                \r\n\r\n                                                            </div>\r\n