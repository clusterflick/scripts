s=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"/event/29613/queer-house-party-does-brighton\" aria-label=\"Queer House Party - Brighton w/ Dykes on Decks & Crushed\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">£11 to £16</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/3da4ddef-7ff3-4948-b6b7-02092648c8d7.jpg\" alt=\"Queer House Party does Brighton\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Queer House Party does Brighton\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Concorde 2 - Saturday 15th November 2025</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Queerkamp by Chris Westendorp &amp; Lucas van der Rhee \",\"startDate\": \"2025-11-12T19:00:00:00+00:00\",\"endDate\": \"2025-11-12T21:00:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/31110/queerkamp-by-chris-westendorp-lucas-van-der-rhee\",\"image\" : \"https://cdn.outsavvy.com/events/872633fd-ca9e-47e6-983f-964b80b24914.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Spectra Presents: Queerkamp, a film by Chris Westendorp and Lucas van der Rhee&#128197; Wednesday 12 November&#128342; 7.00pm&#128205; UCL East Community Cinema – One Pool StreetSensitive and deeply observational, Queerkamp offers an intimate glimpse into the world of a queer youth summer camp, where young people spend a week among peers who share similar experiences and questions of identity. With tenderness and courage, the film captures moments of vulnerability, joy and self-discovery as the participants begin to embrace who they are, often for the first time.Through its gentle, empathetic lens, Queerkamp reveals the quiet strength and resilience that emerge in this safe space, celebrating the transformative power of queer community.Queerkamp dir. Chris Westendorp &amp;amp; Lucas van der Rhee | 60 min | 2024Queerkamp will be preceded by the short film A film, My Body by one of our recent UCL East alumni Maar Dinu. This deeply personal film blends digital and analogue techniques, exploring the relationship between the human body and the film’s body, both undergoing processes of transformation to reach their final form. As the film develops, scratches, and reassembles itself, it mirrors the body’s own processes of change, healing, and self-definition. ⚠️ Please note: A Film, My Body contains graphic imagery of body modification performance art. If you prefer to skip the film please arrive for 7.30pm. A Film, My Body dir. Maar Dinu  | 23 min | 2025\",\"location\": {\"@type\": \"Place\",\"name\": \"UCL East - One Pool Street\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"UCL East - One Pool Street, 1 Pool Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E20 2AF\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.53827\", \"longitude\" : \"-0.0097532\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-12T18:30:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31110/queerkamp-by-chris-westendorp-lucas-van-der-rhee\",\"lowPrice\":0,\"highPrice\":0,\"availabilityStarts\":\"2025-10-22T16:38:21:21+01:00\",\"validFrom\":\"2025-10-22T16:38:21:21+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-12T18:30:00:00+00:00\",\"name\":\"Free entry\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31110/queerkamp-by-chris-westendorp-lucas-van-der-rhee\",\"price\":0,\"availabilityStarts\":\"2025-10-22T16:38:21:21+01:00\",\"validFrom\":\"2025-10-22T16:38:21:21+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/spectra-queer-non-fiction-films-at-ucl-east\", \"description\" : \"&#120138;&#120161;&#120150;&#120148;&#120165;&#120163;&#120146; &#127800;, is a film club hosted at UCL East, dedicated to showcasing queer stories in documentary, non-fiction works, and artist moving image.Our name reflects the light spectrum in film—a range of colours symbolising diverse voices and narratives. \", \"name\" : \"Spectra, Queer Non Fiction Films at UCL East\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/31110/queerkamp-by-chris-westendorp-lucas-van-der-rhee';\r\n            return;\r\n                        \r\n\r\n            // Send the like to the service\r\n            $.ajax({\r\n                type: \"POST\",\r\n                contentType: \"applica