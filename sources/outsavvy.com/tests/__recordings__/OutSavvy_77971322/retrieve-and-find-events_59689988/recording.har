/path>\r\n                        </svg>\r\n                        </h4>\r\n                    </div>\r\n\r\n                    <div class=\"organiserblock\">\r\n                        <div class=\"organiser-center\">\r\n\r\n                            \r\n                            <div class=\"left-half\">\r\n                                <img class=\"organiser-logo\" height=\"142\" width=\"200\" data-src=\"https://cdn.outsavvy.com/logo/52464457-9297-481a-abfc-27323ffa89d2.png\" alt=\"Devianza Cabaret\" />\r\n                            </div>\r\n                            \r\n\r\n                            <div class=\"right-half\">\r\n\r\n                                <div class=\"organiser-name\">\r\n                                    Devianza Cabaret\r\n                                </div>\r\n\r\n                                <p class=\"organiser-event\">Organiser of Devianza On Screen: Mario Bava's \"Black Sabbath\" - A Halloween Film Screening & Cabaret</p>\r\n\r\n                                <div class=\"organiser-link\">\r\n                                    <a href=\"/organiser/devianza-cabaret\" target=\"_blank\" class=\"organiser-button\">View Organiser\r\n                                    </a>\r\n                                    <a href=\"/partnercontact/2882/29949\" class=\"organiser-button\">Contact Organiser\r\n                                    </a>\r\n                                </div>\r\n\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n    \r\n\r\n\r\n                                </div>\r\n                                <div id=\"sidebar\" class=\"sidebarevent\">\r\n                                    \r\n\r\n    \r\n\r\n        <div id=\"scrollingDiv\" class=\"event-details-side\">\r\n            <div class=\"payment-header\" style=\"margin-top: 0px;\">Event Details</div>\r\n