dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">6:45 PM – FESTIVAL CLOSING  – EVENING SESSION </h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p><strong>&nbsp;🗓 Saturday 1st November, 7pm start (doors 6.45pm)</strong><br><strong>📍&nbsp; Pelican House (144 Cambridge Heath Rd, Bethnal Green, London E1 5QJ)&nbsp; &nbsp;</strong></p><p><strong>🔎 Room: Common Room&nbsp;</strong></p><p>Rating: Suitable for ages 16+&nbsp;<br>Duration: 1 hour 15 minutes<br>💬 Includes a Q&amp;A session with the Festival Curator from Brazil</p><p>&nbsp;</p><figure class=\"image image_resized\" style=\"width:33.83%;\"><img style=\"aspect-ratio:532/377;\" src=\" https://cdn.outsavvy.com/eventembed/274fcbdf-4123-41a4-ae1f-3c01185dd644.png  \" width=\"532\" height=\"377\"></figure><p><strong>InDUBtável 2 – A Reggae Document (Brazil/SP, UK, France &amp; Spain)&nbsp;</strong><br><i>Documentary, 17′, 2023. Director: William Sernagiotto.</i><br><i>English subtitles.</i></p><p><br>The independent documentary about Reggae and Sound System “InDUBtável”, which already has a “demo” version (containing records from 2003 to 2009), now receives its official version, reinforcing the fact that it is one of the first films made in the country about this musical genre.</p><p>For 75 minutes, the film discusses the relevance of the ABC and Greater SP region in the context of Reggae music and the current Sound System. Spoken in 4 languages, it contains images of presentations, festivals and testimonials captured in Brazil, France, Spain and England between 2016 and 2019. The cast includes more than 40 characters from the national and international scene.</p><p>&nbsp;</p><p><strong>🎶 &nbsp;The evening flows into a closing gathering - an open space for music, sharing, and conversation.</strong></p><p>&nbsp;</p><h2><strong>Sinopse em português</strong></h2><p><strong>InDUBtável 2 – Reggae Documento (Brasil/SP, Reino Unido, França e Espanha)</strong><br>Documentário, 17′, 2023. Direção: William Sernagiotto.<br>Legenda em Português.</p><p>O documentário independente sobre Reggae e Sound System “InDUBtável”, que já possui uma versão “demo” (contendo registros de 2003 à 2009), agora recebe a sua versão oficial, reforçando o fato de ser um dos primeiros filmes realizados no país sobre esse gênero musical.&nbsp;</p><p>Durante 75 minutos, o longa aborda a relevância da região do ABC e grande SP perante o cenário da música Reggae e Sound System atual. Falado em 4 idiomas (legendado em português e inglês).</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/londonevents>London Events </a><a href=/hashtag/pelicanhouse>Pelican House </a><a href=/hashtag/festival>Festival </a><a href=/hashtag/screening>Screening </a><a href=/hashtag/documentary>Documentary </a><a href=/hashtag/film>Film </a>\r\n                                </span>\r\n                            </div>\r\n\r\n                        \r\n\r\n                    </div>\r\n                    <div style=\"margin-top: 14px; margin-bottom: 14px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n        <div id=\"organiser\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <div class=\"line-red-holder\">\r\n                        <h4 class=\"line-red\">Organised By\r\n                        <svg width=\"100%\" height=\"7\" viewBox=\"0 0 135 7\" fill=\"none\" preserveAspectRatio=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"po