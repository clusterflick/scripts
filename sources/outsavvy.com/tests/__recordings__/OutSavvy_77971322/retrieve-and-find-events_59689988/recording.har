     <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">£11 to £16</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/3da4ddef-7ff3-4948-b6b7-02092648c8d7.jpg\" alt=\"Queer House Party does Brighton\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Queer House Party does Brighton\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Concorde 2 - Saturday 15th November 2025</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Palestine Cinema Days: When I Saw You\",\"startDate\": \"2025-11-03T19:30:00:00+00:00\",\"endDate\": \"2025-11-03T22:00:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"image\" : \"https://cdn.outsavvy.com/events/113118df-a09d-400c-9a35-5f68aa70a075.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"As part of the Palestine Cinema Days festival, Lambeth Mutual Aid are screening WHEN I SAW YOU to raise money for mutual aid in Gaza.The second film by Palestinian director Annemarie Jacir, When I Saw You is set in a refugee camp in Jordan following the Six-Day War in 1967. Tarek, a young Palestinian boy who longs to be reunited with his father, secretly sets out on his own and encounters a group of young freedom fighters. Together, they embark on a journey of adventure, driven by an unshakable resolve to be free. No prizes for guessing why we at LMA might have wanted to screen this :)We&#39;ve teamed up for this screening with COLDHARBOUR BLUE, our local independent cinema in Brixton. Although this is a fundraiser for mutual aid in Gaza, and we&#39;d love if everyone could buy a Generous ticket, we don&#39;t want anyone to miss out: if you want to come but can&#39;t afford the unwaged price, message us on instagram and we&#39;ll get you in another way.Unwaged: &#163;2.50Basic ticket: &#163;5Extra ticket: &#163;7.50Generous ticket: &#163;10\",\"location\": {\"@type\": \"Place\",\"name\": \"Coldharbour Blue\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Coldharbour Blue, 259-260 Hardess Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE24 0HN\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.46507\", \"longitude\" : \"-0.1011974\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-03T18:30:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"lowPrice\":10,\"highPrice\":2.5,\"availabilityStarts\":\"2025-10-20T09:15:10:10+01:00\",\"validFrom\":\"2025-10-20T09:15:10:10+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-03T18:30:00:00+00:00\",\"name\":\"unwaged\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"price\":2.5,\"availabilityStarts\":\"2025-10-20T09:15:10:10+01:00\",\"validFrom\":\"2025-10-20T09:15:10:10+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-03T18:30:00:00+00:00\",\"name\":\"basic\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"price\":5,\"availabilityStarts\":\"2025-10-20T09:15:10:10+01:00\",\"validFrom\":\"2025-10-20T09:15:10:10+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-03T18:30:00:00+00:00\",\"name\":\"extra\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"price\":7.5,\"availabilityStarts\":\"2025-10-20T09:15:10:10+01:00\",\"validFrom\":\"2025-10-20T09:15:10:10+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-03T18:30:00:00+00:00\",\"name\":\"generous\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\",\"price\":10,\"availabilityStarts\":\"2025-10-20T09:15:10:10+01:00\",\"validFrom\":\"2025-10-20T09:15:10:10+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/lambeth-mutual-aid\", \"description\" : \"\", \"name\" : \"Lambeth Mutual Aid\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/31052/palestine-cinema-days-when-i-saw-you';\r\n            return;\r\n                        \r\n\r\n            // Send the like to the service\r\n            $.ajax({\r\n                type: \"POST\",\r\n                contentType: \"application/json; charset=utf-8\",\r\n                url: \"/Default.aspx/AddEventLike\",\r\n                data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                contentType: \"application/json; charset=utf-8\",\r\n                dataType: \"json\",\r\n                success: function (r) {\r\n                    if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                        $('a.like-button' + eventid).toggleClass('liked');\r\n                        $(\".hiddenLike\").slideDow