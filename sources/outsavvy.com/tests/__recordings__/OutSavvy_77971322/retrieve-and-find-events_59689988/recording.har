            "size": 230897,
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tPalestine Cinema Days: When I Saw You Tickets | 03 Nov @ Coldharbour Blue, London | £2.50 to £10 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/48b1003e3f996725d29958c6407c7628d895b6c59423ce86809d490268602a4108a2f455d42039841e6a37763c49dbae39bb99ea85f2d7ab12be682be45831a8/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2025-10-27\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"As part of the Palestine Cinema Days festival, Lambeth Mutual Aid are screening WHEN I SAW YOU to raise money for mutual aid in Gaza.The second film by Palestinian director Annemarie Jacir, When I Saw You is set in a refugee camp in Jordan following the Six-Day War in 1967. Tarek, a young Palestinian boy who longs to be reunited with his father, secretly sets out on his own and encounters a group of young freedom fighters. Together, they embark on a journey of adventure, driven by an unshakable resolve to be free. No prizes for guessing why we at LMA might have wanted to screen this :)We&#39;ve teamed up for this screening with COLDHARBOUR BLUE, our local independent cinema in Brixton. Although this is a fundraiser for mutual aid in Gaza, and we&#39;d love if everyone could buy a Generous ticket, we don&#39;t want anyone to miss out: if you want to come but can&#39;t afford the unwaged price, message us on instagram and we&#39;ll get you in another way.Unwaged: &#163;2.50Basic ticket: &#163;5Extra ticket: &#163;7.50Generous ticket: &#163;10\" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"Palestine Cinema Days: When I Saw You Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/113118df-a09d-400c-9a35-5f68aa70a075.jpg\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"Palestine Cinema Days: When I Saw You Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/113118df-a09d-400c-9a35-5f68aa70a075.jpg?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"As part of the Palestine Cinema Days festival, Lambeth Mutual Aid are screening WHEN I SAW YOU to raise money for mutual aid in Gaza.The second film by Palestinian director Annemarie Jacir, When I Saw You is set in a refugee camp in Jordan following the Six-Day War in 1967. Tarek, a young Palestinian boy who longs to be reunited with his father, secretly sets out on his own and encounters a group of young freedom fighters. Together, they embark on a journey of adventure, driven by an unshakable resolve to be free. No prizes for guessing why we at LMA might have wanted to screen this :)We&#39;ve teamed up for this screening with COLDHARBOUR BLUE, our local independent cinema in Brixton. Although this is a fundraiser for mutual aid in Gaza, and we&#39;d love if everyone could buy a Generous ticket, we don&#39;t want anyone to miss out: if you want to come but can&#39;t afford the unwaged price, message us on instagram and we&#39;ll get you in another way.Unwaged: &#163;2.50Basic ticket: &#163;5Extra ticket: &#163;7.50Generous ticket: &#163;10\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/31052/palestine-cinema-days-when-i-saw-you\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | Palestine Cinema Days: When I Saw You | Monday 3rd November 2025 @ Coldharbour Blue | £2.50 to £10 | Find event and ticket information for Lambeth Mutual Aid\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        f