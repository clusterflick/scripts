                         \r\n\r\n                                                    <div class=\"bottomborder\">\r\n                                                        \r\n\r\n                                                        <div class=\"ticket-group\">\r\n\r\n                                                            <div class=\"ticket-detail ticket-detail-name\">\r\n\r\n                                                                \r\n\r\n                                                                <div class=\"ticket-name-holder\">\r\n\r\n                                                                    <span class=\"ticket-name\">\r\n                                                                        Pay what you can <span class=\"ticket-status\"></span>\r\n                                                                    </span>\r\n\r\n                                                                    \r\n\r\n                                                                </div>\r\n\r\n                                                                <div class='ticket-time-holder'><i class='sub-margin'><img src='https://cdn.outsavvy.com/website/icon-clock.png' width='20px' height='20px' alt='time icon' /> 5:30 PM - 10:00 PM</i></div>\r\n                                                            </div>\r\n\r\n                                                            <div class=\"ticket-detail ticket-detail-price text-right\">\r\n\r\n                                                                \r\n\r\n                                                                    <div class=\"input-currency\">\r\n                                                                        <div class=\"input-currency-symbol\">£</div>\r\n                                                                        <input name=\"ctl00$FullWidth$SelectTickets$RepeaterTicketCategories$ctl01$RepeaterTicketTypes$ctl01$TextBoxPayWhatYouCan\" type=\"text\" maxle