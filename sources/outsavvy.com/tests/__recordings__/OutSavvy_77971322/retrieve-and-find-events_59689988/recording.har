has step-free accessThere is a wheelchair space in the screen - please contact us beforehand if you require this\",\"location\": {\"@type\": \"Place\",\"name\": \"Hackney Picturehouse\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Hackney Picturehouse, 270 Mare Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E8 1HE\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.54468\", \"longitude\" : \"-0.0550042\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-06T17:00:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/30848/saving-face-screening-social-18\",\"lowPrice\":13.5,\"highPrice\":13.5,\"availabilityStarts\":\"2025-10-12T16:01:19:19+01:00\",\"validFrom\":\"2025-10-12T16:01:19:19+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-06T17:00:00:00+00:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/30848/saving-face-screening-social-18\",\"price\":13.5,\"availabilityStarts\":\"2025-10-12T16:01:19:19+01:00\",\"validFrom\":\"2025-10-12T16:01:19:19+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/lez-girls-community\", \"description\" : \"\", \"name\" : \"Lez Girls Community\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/30848/saving-face-screening-social-18';\r\n            return;\r\n                        \r\n\r\n            // Send the like to the service\r\n            $.ajax({\r\n                type: \"POST\",\r\n                contentType: \"application/json; charset=utf-8\",\r\n                url: \"/Default.aspx/Add