                                          <path d=\"M1.8 0h35.4c1 0 1.8.8 1.8 1.9v22.3c0 1-.8 1.9-1.8 1.9H1.8c-1 0-1.8-.8-1.8-1.9V1.9C0 .8.8 0 1.8 0z\" fill=\"#0081c9\"></path><path d=\"M31 12.9l2.8-3.2h-4.1l-.7.9-.7-.9H17.5l-.7 1.8-.8-1.8h-3.5v2.5l-1.2-2.5H8.7l-3.2 6.7H9l.5-1.1h1l.5 1.1h17l.9-1.1.9 1.1H34l-3-3.5zm-18.1 2.5h-1.4l-.5-1.1H8.8l-.5 1.1H7l2.3-4.7h1.4l2.2 4.7zm7.1 0h-1.3V12l-1.5 3.4h-1L14.7 12v3.3h-1.3v-4.7h1.9l1.4 3.3 1.3-3.3h2v4.8zm5.8 0h-4.6v-4.7h4.6v.9h-3.2v1h2.9v.8h-2.9v1.2h3.3v.8zm3.1-1.7l-1.4 1.6H26l2.1-2.5-2-2.3h1.6l1.2 1.5 1.2-1.5h1.5l-2 2.3 2.1 2.5h-1.6l-1.2-1.6z\" fill=\"#fff\"></path><path fill=\"#fff\" d=\"M9.9 11.8l-.8 1.7h1.6l-.7-1.7z\"></path></svg>\r\n                                                </div>\r\n                                                <div class=\"card-holder infopop\" title=\"Apple Pay\">\r\n                                                    <svg width=\"27\" height=\"18\" viewBox=\"0 0 39 26\">\r\n                                                        <path d=\"M1.82 0h35.36c1 0 1.82.83 1.82 1.85v22.3c0 1.02-.82 1.85-1.82 1.85H1.82C.82 26 0 25.17 0 24.15V1.85C0 .83.82 0 1.82 0z\" fill=\"#f5f6f8\"></path><path d=\"M37.18.65c.65 0 1.18.54 1.18 1.2v22.3c0 .66-.53 1.2-1.18 1.2H1.82c-.65 0-1.18-.54-1.18-1.2V1.85c0-.66.53-1.2 1.18-1.2h35.36m0-.65H1.82C.82 0 0 .83 0 1.85v22.3C0 25.17.82 26 1.82 26h35.36c1.01 0 1.82-.83 1.82-1.85V1.85C39 .83 38.18 0 37.18 0z\" opacity=\"0.1\"></path><g><path d=\"M10.57 9.1c.32-.4.54-.93.48-1.48-.47.02-1.04.31-1.37.71-.3.34-.56.9-.49 1.42.53.05 1.05-.26 1.38-.65M11.05 9.86c-.76-.05-1.41.43-1.77.43-.36 0-.92-.41-1.52-.4-.78.01-1.51.45-1.91 1.16-.82 1.41-.22 3.5.58 4.65.39.57.85 1.19 1.47 1.17.58-.02.81-.38 1.51-.38s.91.38 1.52.36c.64-.01 1.03-.57 1.42-1.14.44-.65.62-1.27.64-1.31-.01-.01-1.23-.48-1.24-1.88-.01-1.17.95-1.73 1-1.76-.56-.79-1.41-.88-1.7-.9\"></path>\r\n                                                            <g>\r\n                                                                <path d=\"M18.64 8.27c1.65 0 2.81 1.14 2.81 2.8 0 1.67-1.18 2.81-2.85 2.81h-1.83v2.91h-1.32V8.27h3.19zm-1.88 4.5h1.52c1.15 0 1.81-.62 1.81-1.7s-.66-1.69-1.8-1.69h-1.52v3.39zM21.77 15.03c0-1.09.83-1.72 2.37-1.81l1.65-.1v-.47c0-.69-.46-1.07-1.26-1.07-.67 0-1.15.34-1.25.87h-1.19c.04-1.11 1.08-1.91 2.48-1.91 1.51 0 2.5.79 2.5 2.02v4.24h-1.22v-1.02h-.03c-.35.67-1.12 1.09-1.95 1.09-1.24-.01-2.1-.74-2.1-1.84zm4.02-.55V14l-1.47.09c-.83.05-1.26.36-1.26.9 0 .52.45.86 1.15.86.9 0 1.58-.57 1.58-1.37zM28.19 19.08v-1.02c.08.01.28.02.39.02.59 0 .92-.25 1.12-.89l.12-.38-2.24-6.21h1.38l1.56 5.04h.03l1.56-5.04h1.35l-2.32 6.52c-.53 1.5-1.14 1.99-2.43 1.99-.11.01-.43-.01-.52-.03z\"></path>\r\n                                                            </g>\r\n                                                        </g></svg>\r\n                                                </div>\r\n                                                <div class=\"card-holder infopop\" title=\"Google Pay\">\r\n                                                    <svg width=\"27\" height=\"18\" viewBox=\"0 0 39 26\">\r\n                                                        <path d=\"M1.82 0h35.36c1 0 1.82.83 1.82 1.85v22.3c0 1.02-.82 1.85-1.82 1.85H1.82C.82 26 0 25.17 0 24.15V1.85C0 .83.82 0 1.82 0z\" fill=\"#f5f6f8\"></path><path d=\"M18.74 9.58v2.83h1.73c.41 0 .75-.14 1.02-.42.28-.28.42-.61.42-1 0-.38-.14-.71-.42-.99a1.33 1.33 0 0 0-1.02-.43l-1.73.01zm0 3.83v3.28h-1.03v-8.1h2.74c.7 0 1.29.23 1.78.7s.74 1.04.74 1.71c0 .69-.25 1.26-.74 1.72-.48.46-1.07.69-1.78.69h-1.71zM24.01 15c0 .27.11.5.34.68.23.18.5.27.8.27.43 0 .82-.16 1.16-.49.34-.32.51-.71.51-1.14-.32-.26-.77-.38-1.35-.38-.42 0-.77.1-1.05.31-.27.19-.41.44-.41.75m1.34-4.04c.76 0 1.37.21 1.81.62.44.41.66.98.66 1.69v3.42h-.99v-.77h-.05c-.43.63-1 .95-1.71.95-.61 0-1.12-.18-1.52-.54-.41-.36-.61-.82-.61-1.36 0-.57.22-1.03.65-1.37.43-.34 1.01-.51 1.73-.51.61 0 1.12.11 1.52.34v-.23c0-.36-.14-.67-.43-.92-.27-.25-.63-.38-1-.38-.58 0-1.03.25-1.37.74l-.91-