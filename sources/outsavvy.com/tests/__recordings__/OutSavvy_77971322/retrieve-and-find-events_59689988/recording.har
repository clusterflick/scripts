            "size": 228558,
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tHocus Pocus Movie Night Tickets | 28 Oct @ The Clapham Grand, London | £16 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/48b1003e3f996725d29958c6407c7628d895b6c59423ce86809d490268602a4108a2f455d42039841e6a37763c49dbae39bb99ea85f2d7ab12be682be45831a8/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2025-10-15\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"Welcome to London’s spookiest screening of Hocus Pocus in our haunted Victorian Theatre™DOOR 6:30PM / LIVE SHOW &amp;amp; FILM 7:30PM / MOVIE ENDS: APPROX 9:30PM“Oh look, another glorious movie night. Makes me sick. ” &#129326;The SistERSss are back for our annual spell binding screening of Hocus Pocus on our Monstrousy huge screen, staring your host for the evening, our Sanderson-ish Sisters &#129497;&#129497;&#129497;So, pop on your best witch garms, dig out a broomstick, grab your creepy crew and come get spooky with us &#127875;Expect:The full movie uninterrupted on a massive 25ft screen &#128250;Our Dreamteam Hosts &amp;amp; show team &#127908;The Witchiest Witch Costume Comp &#129351;Spooky Skeleton dance-offs ☠️Cauldron cocktails &#127865;Ooky spooky decor &#127962;️Haunted hotdogs &amp;amp; nasty nachos (Vegan bad-ness too) &#127789;Pop corn for only &#163;3 &#127871;Our Movie nights are like no other, alongside watching Hocus Pocus uninterrupted on our massive (25 ft. ) HD Screen, we have a whole lot more in store for you before &amp;amp; after the film, including The Grand’s Dream Team hosts &amp;amp; show team, all the confetti, games and even the occasional balloon drop. &#127880;Feel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar &amp;amp; food stalls stay open during the movie. Alas, there is no club night after this screening. It’s is a Tuesday after all… &#128514;For any show / venue info, please contact info@claphamgrand.comFor any accessibility requirements / tickets, please contact access@claphamgrand.com\" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"Hocus Pocus Movie Night Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/30069/hocus-pocus-movie-night\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/19ab6980-a34d-4c7d-ae96-33b1882d78cd.jpg\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"Hocus Pocus Movie Night Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/30069/hocus-pocus-movie-night\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/19ab6980-a34d-4c7d-ae96-33b1882d78cd.jpg?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"Welcome to London’s spookiest screening of Hocus Pocus in our haunted Victorian Theatre™DOOR 6:30PM / LIVE SHOW &amp;amp; FILM 7:30PM / MOVIE ENDS: APPROX 9:30PM“Oh look, another glorious movie night. Makes me sick. ” &#129326;The SistERSss are back for our annual spell binding screening of Hocus Pocus on our Monstrousy huge screen, staring your host for the evening, our Sanderson-ish Sisters &#129497;&#129497;&#129497;So, pop on your best witch garms, dig out a broomstick, grab your creepy crew and come get spooky with us &#127875;Expect:The full movie uninterrupted on a massive 25ft screen &#128250;Our Dreamteam Hosts &amp;amp; show team &#127908;The Witchiest Witch Costume Comp &#129351;Spooky Skeleton dance-offs ☠️Cauldron cocktails &#127865;Ooky spooky decor &#127962;️Haunted hotdogs &amp;amp; nasty nachos (Vegan bad-ness too) &#127789;Pop corn for only &#163;3 &#127871;Our Movie nights are like no other, alongside watching Hocus Pocus uninterrupted on our massive (25 ft. ) HD Screen, we have a whole lot more in store for you before &amp;amp; after the film, including The Grand’s Dream Team hosts &amp;amp; show team, all the confetti, games and even the occasional balloon drop. &#127880;Feel free to sing-along, heckle the bad guys and cheer for your heroes, a costume is never un-appreciated (in fact we often give out prizes for the best or worst), the bar &amp;amp; food stalls stay open during the movie. Alas, there is no club night after this screening. It’s is a Tuesday after all… &#128514;For any show / venue info, please contact info@claphamgrand.comFor any accessibility requirements / tickets, please contact access@claphamgrand.com\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/30069/hocus-pocus-movie-night\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | Hocus Pocus Movie Night | Tuesday 28th October 2025 @ The Clapham Grand | £16 | Find event and ticket information for The Clapham Grand\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n    </script>\r\n\r\n<link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-57x57.png\" /><link rel=\"apple-touch-icon\" sizes=\"60x60\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-60x60.png\" /><link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-72x72.png\" /><link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-76x76.png\" /><link rel=\"apple-touch-icon\" sizes=\"114x114\" href=\"https://cdn.outsavvy.com/website/favicon/app