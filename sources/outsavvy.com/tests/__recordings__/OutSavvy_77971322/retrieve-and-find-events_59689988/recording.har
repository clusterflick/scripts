                               \r\n\r\n                                                                    <div class=\"input-currency\">\r\n                                                                        <div class=\"input-currency-symbol\">£</div>\r\n                                                                        <input name=\"ctl00$FullWidth$SelectTickets$RepeaterTicketCategories$ctl01$RepeaterTicketTypes$ctl02$TextBoxPayWhatYouCan\" type=\"text\" maxlength=\"10\" id=\"FullWidth_SelectTickets_RepeaterTicketCategories_RepeaterTicketTypes_0_TextBoxPayWhatYouCan_1\" class=\"donationinput\" onfocus=\"moveCursorToEnd(this)\" onclick=\"moveCursorToEnd(this)\" onkeyup=\"doPostBack(this);\" placeholder=\"Min. £1\" title=\"Enter the price you can pay min. £1\" />\r\n                                                                    </div>\r\n\r\n                                                                    <div class=\"fees\" style=\"text-transform: uppercase;\">\r\n                                                                        Booking Fee: Added\r\n                                                                    </div>\r\n\r\n                                                                    \r\n                                                            </div>\r\n\r\n                                                            \r\n                                                                <div class=\"ticket-detail ticket-detail-quantity\">\r\n\r\n                                                                    <div class=\"ticket-dropdown-holder\">\r\n                                                                        <div class=\"ticket-dropdown-title-holder\">\r\n                                                                            <label for=\"ctl00_FullWidth_SelectTickets_RepeaterTicketCategories_ctl01_RepeaterTicketTypes_ctl02_DropDownListPayWhatYouCanTicket\" class=\"ticket-dropdown-title\">Qty</label><select n