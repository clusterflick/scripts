   <span class=\"moreDetails\">More Details</span>\r\n\r\n                                                                    <span class=\"hideDetails\">Hide Details</span>\r\n\r\n                                                                    <div style=\"display: none;\" class=\"ticket-details\">\r\n\r\n                                                                        \r\n                                                                            <span>\r\n                                                                                <p><p>Your contribution directly supports this London edition of Mostra do Filme Marginal by helping cover travel for one of our curators from Brazil. Any additional funds raised will go towards sustaining the festival’s ongoing work in Brazil.</p></p>\r\n                                                                            </span>\r\n                                                                        \r\n\r\n                                                                    </div>\r\n                                                                </div>\r\n\r\n                                                            </div>\r\n\r\n                                                        \r\n\r\n                                                    </div>\r\n\r\n                                                \r\n\r\n                                            \r\n\r\n                                                <input type=\"hidden\" name=\"ctl00$FullWidth$SelectTickets$RepeaterTicketCategories$ctl01$RepeaterTicketTypes$ctl02$HiddenFieldDealId\" id=\"FullWidth_SelectTickets_RepeaterTicketCategories_RepeaterTicketTypes_0_HiddenFieldDealId_1\" value=\"145133\" />\r\n                                                <input type=\"hidden\" name=\"ctl00$FullWidth$SelectTickets$RepeaterTicketCategories$ctl01$RepeaterTicketTypes$ctl02$HiddenFieldDiscountId\" id=\"FullWidth_SelectTickets_RepeaterTicketCategories_Repeat