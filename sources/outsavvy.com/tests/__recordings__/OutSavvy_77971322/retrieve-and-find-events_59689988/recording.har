hed\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <div class=\"feature-price\">£11 to £16</div>\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/3da4ddef-7ff3-4948-b6b7-02092648c8d7.jpg\" alt=\"Queer House Party does Brighton\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    Queer House Party does Brighton\r\n                                </h2>\r\n                                \r\n                                <div class=\"banner-entry-location\">Concorde 2 - Saturday 15th November 2025</div>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"DanceEvent\",\"name\": \"Queer Mixer Night \",\"startDate\": \"2025-11-24T17:30:00:00+00:00\",\"endDate\": \"2025-11-24T22:00:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/31018/queer-mixer-night\",\"image\" : \"https://cdn.outsavvy.com/events/2f0ec410-c7bc-4316-8b17-47934c4b3e79.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"&#127752; QUEER MIXER FUNDRAISER NIGHT &#127752;Support a Bold New Short Film following a Queer, County Lines Story Join us for a vibrant, feel-good Queer Mixer that’s raising funds for an important new short film, ‘Blurred Lines’, exploring queer experiences in county lines, told powerfully through a female perspective. This is more than just a party it&#39;s a celebration of queer creativity, survival, and community resilience. &#128165; WHAT TO EXPECT &#128165;✨ Tarot Readings Get your cards read by our mystical in-house reader&#127987;️‍&#127752; Queer Market Stalls Featuring handmade art, zines, crafts &amp;amp; more&#127908; Open Mic Sing, poetry, spoken word, share the stage is yours&#127828; Hot Food Come hungry, leave happy. Vegan options available and gluten free&#127867; Drinks Affordable bar serving all your favourites, from as little as &#163;4 &#127912; Badge Making Create your own loud &amp;amp; proud wearable art&#128087; &#163;2 Vintage Clothes Rack Dig for treasure and slay sustainably This night is all about connection, queerness, and mutual support helping to bring a vital, underrepresented story to life on screen. Proceeds go directly toward the production of the short film,‘Blurred Lines’, which sheds light on the intersection of queerness, gender identity, and survival in the context of the county lines network a narrative rarely seen and urgently needed.Whether you&#39;re coming to meet new people, support queer film, or just have a good time  everyone is welcome (queer joy essential). &#127903;️ Tickets, pay what you can Suggested donation: &#163;7.50Follow the film project @blurredlinesshortfilm_Come through, bring your crew, and let’s make queer film happen together.  &#128150; &#127909; We’re also running a Crowdfunder to support the film and every donation helps bring this urgent story to the screen. You can contribute on the night or online. Whether you&#39;re here to mingle, perform, shop, eat, all are welcome. &#128150;Let’s raise the roof and some funds. Crowdfunder: https://www.crowdfunder.co.uk/p/blurred-lines---queer-county-lines-short-film-1?fbclid=PAdGRleANgPr1leHRuA2FlbQIxMQABp5Hu-MdBEFh6G8UH9FfCWN1ZDgrXuTLYNcIiaESEF6Diiy3oVaJbeEtW72eq_aem_EQJM0GJLgvWj88D4oPeYDQ\",\"location\": {\"@type\": \"Place\",\"name\": \"18 Ashwin St\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"18 Ashwin St, 18 Ashwin Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E8 4SA\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.54693\", \"longitude\" : \"-0.0745306\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-24T16:30:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31018/queer-mixer-night\",\"lowPrice\":20,\"highPrice\":0,\"availabilityStarts\":\"2025-10-18T10:44:00:00+01:00\",\"validFrom\":\"2025-10-18T10:44:00:00+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-24T16:30:00:00+00:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31018/queer-mixer-night\",\"price\":0,\"availabilityStarts\":\"2025-10-18T10:44:00:00+01:00\",\"validFrom\":\"2025-10-18T10:44:00:00+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-24T16:30:00:00+00:00\",\"name\":\"Pay it forward ticket \",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31018/queer-mixer-night\",\"price\":15,\"availabilityStarts\":\"2025-10-18T10:48:00:00+01:00\",\"validFrom\":\"2025-10-18T10:48:00:00+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2025-11-24T16:30:00:00+00:00\",\"name\":\"Entry plus a drink and meal \",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/31018/queer-mixer-night\",\"price\":20,\"availabilityStarts\":\"2025-10-18T10:48:30:30+01:00\",\"validFrom\":\"2025-10-18T10:48:30:30+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/evulve-production\", \"description\" : \"\", \"name\" : \"Evulve Production\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\