 lazy\" alt=\"Lesbian Leaders in the ’30s Republican Spain + queer short films header\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/d79f4b1a-a178-47e3-bbb6-ebcd20ba09ea.png\" class=\"area-main-feature area-main-feature-small lazy\" alt=\"Lesbian Leaders in the ’30s Republican Spain + queer short films tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Lesbian Leaders in the ’30s Republican Spain + queer short films</p>\r\n\r\n                        <div class=\"event-item event-item-venue\">\r\n\r\n                            <svg width=\"26px\" height=\"26px\" viewBox=\"0 0 512.000000 512.000000\" class=\"ticket-header-icon\">\r\n\r\n                                <g transform=\"translate(0.000000,512.000000) scale(0.100000,-0.100000)\" fill=\"#000000\" stroke=\"none\">\r\n                                    <path d=\"M2360 5109 c-202 -23 -396 -80 -585 -173 -376 -185 -656 -466 -835 -839 -326 -676 -210 -1403 383 -2397 169 -283 326 -517 722 -1075 132 -187 279 -396 327 -465 90 -131 124 -160 188 -160 64 0 98 