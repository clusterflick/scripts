\r\n\r\n                    </div>\r\n\r\n                    \r\n                    <div class=\"top-header-margin\"></div>\r\n                    \r\n\r\n                    <!-- HEADER -->\r\n\r\n                    \r\n\r\n    \r\n\r\n        <div id=\"page-events-wrapper\">\r\n\r\n            \r\n\r\n            <div class=\"event-header page event-header-website\">\r\n                <div class=\"event-header-image_blurry\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/8c32c00f-9c2f-4a7b-8568-b9ad77a18ee7.jpg\" class=\"event-header-image lazy\" alt=\"\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/8c32c00f-9c2f-4a7b-8568-b9ad77a18ee7.jpg\" class=\"area-main-feature area-main-feature-website lazy\" alt=\"Programmers of Tomorrow: Film Festival All-Dayer tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/807c0c5e-7c24-47a8-80a6-332d25345805.jpg\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"Programmers of Tomorrow: Film Festival All-Dayer tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n<div class=\"urgency-signals\">\r\n    <div class=\"urgency-message\">\r\n        <i class=\"urgency-image\">\r\n            <svg id=\"fi_10760659\" enable-background=\"new 0 0 512 512\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"m300.043 496c24.441-36.144 26.693-75.182 6.757-117.114-5.544 22.497-15.685 36.151-30.425 40.962 13.688-39.09 2.25-81.323-34.314-126.697-.789 46.863-12.051 81.001-33.786 102.414-29.942 29.47-29.59 62.728 1.056 99.774-127.217-67.702-145.166-158.502-53.846-272.4 5.663 27.516 19.389 44.409 41.177 50.679-23.75-100.781 1.238-186.654 74.961-257.618.453 157.485 48.746 171.483 109.805 241.781 65.926 84.361 27.184 181.716-81.385 238.219z\" fill=\"#ffb632\" fill-rule=\"evenodd\"></path></svg>\r\n        </i>\r\n        <span id=\"MainContent_HotEvent_UrgencyLabel\">Tickets going fast!</span>\r\n    </div>\r\n</div>\r\n\r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Programmers of Tomorrow: Film Festival All-Dayer</p>\r\n\r\n                        <div class=\"event-item event-item-venue\">\r\n\r\n                            <svg width=\"26px\" height=\"26px\" viewBox=\"0 0 512.000000 512.000000\" class=\"ticket-header-icon\">\r\n\r\n                                <g transform=\"translate(0.000000,512.000000) scale(0.100000,-0.100000)\" fill=\"#000000\" stroke=\"none\">\r\n                                    <path d=\"M2360 5109 c-202 -23 -396 -80 -585 -173 -376 -185 -656 -466 -835 -839 -326 -676 -210 -1403 383 -2397 169 -283 326 -517 722 -1075 132 -187 279 -396 327 -465 90 -131 124 -160 188 -1