t.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function updateStickyTicketButton(hasTickets) {\n\n            var button = document.getElementById('stickyTicketButton');\n\n            if (!button) return;\n\n            if (hasTickets) {\n                button.href = '#checkout';\n            }\n            else {\n                button.href = '#anchor';\n            }\n        }\r\n\r\nfunction startConfirm(button, shouldValidate) {\r\n\r\n    // Run custom validation if this page has it\r\n    if (typeof validate === 'function' && shouldValidate) {\r\n        if (!validate()) {\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // Prevent a second click\r\n    if (button.dataset.processing === 'true') {\r\n        return false;\r\n    }\r\n\r\n    button.dataset.processing = 'true';\r\n    button.classList.add('is-loading');\r\n\r\n            return true;\r\n}\r\n\r\nwindow.addEventListener('pageshow', function() {\n\n    document.querySelectorAll('.loading-button').forEach(function(button) {\n        button.dataset.processing = 'false';\n        button.classList.remove('is-loading');\n    });\n\n});\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n        function showShareModal() {\r\n            $('#shareModal').reveal({\r\n                animation: 'fadeAndPop',                   //fade, fadeAndPop, none\r\n                animationspseeed: 300,                       //how fast animtions are\r\n                closeonbackgroundclick: true,              //if you click background will modal close?\r\n                dismissmodalclass: 'close-reveal-modal'    //the class of a button or element that will close an open modal\r\n            });\r\n        }\r\n\r\n    </script>\r\n\r\n<link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-57x57.png\" /><link rel=\"apple-touch-icon\" sizes=\"60x60\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-60x60.png\" /><link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-72x72.png\" /><link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-76x76.png\" /><link rel=\"apple-touch-icon\" sizes=\"114x114\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-114x114.png\" /><link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-120x120.png\" /><link rel=\"apple-touch-icon\" sizes=\"144x144\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-144x144.png\" /><link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-152x152.png\" /><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-180x180.png\" /><link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"https://cdn.outsavvy.com/website/favicon/android-icon-192x192.png\" /><link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"https://cdn.outsavvy.com/website/favicon/favicon-32x32.png\" /><link rel=\"icon\" type=\"image/png\" sizes=\"96x96\" href=\"https://cdn.outsavvy.com/website/favicon/favicon-96x96.png\" /><link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"https://cdn.outsavvy.com/website/favicon/favicon-16x16.png\" /><link rel=\"shortcut icon\" href=\"https://cdn.outsavvy.com/website/favicon/favicon.ico\" /><link rel=\"manifest