            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tFILM LOVERS MIX & MINGLE  Tickets | Multiple Dates @ The Arzner Cinema, London | Pay What You Can to £12 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script async src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/7769677a7968bf74e504bc7599959c8f5cdfe69ca94b0638a17c981254064d3f3540f1cb22d8839bc7820c9608d113eb98efe7ea68fbf7cc1ac3c817446e0c56/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2026-10-30\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"A low pressure mix &amp;amp; mingle event with a ✨QUEER MADE SHORT FILM SCREENING ✨ for queers looking for Love &amp;amp; ConnectionYou can expect a room full of lovely lgbtq+ babes, a queer-made short film to watch and plenty of time to chat about it.  Enjoy a short film screening and do some organised mixing.  Chat in groups of 6 for 30 mins at a time, with half of the group switching tables for each round so you get to meet lots of people in a more relaxed way It&#39;s the type of event where you can come alone, or bring along your queer friends.  Allys welcome if they are with you. ✨Please choose the reduced cost ticket price if you need to and if you need a free ticket - message me on outsavvy and I&#39;ll give you one ✨I WANT YOU THERE MORE THAN I WANT YOUR MONEY. Schedule The timing of the film will vary slightly but generally the film is screened at the start of the event check the instagram to see the schedule for this month and what film we will be screening. Venue Details:Open friendly vibeFidget/stim toysConversation cardsLow lighting - no flashingLow-level background musicStep free entrance Air con in the cinema but not in the bar - though there are multiple fans and an outdoor areaA large accessible toilet\" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"FILM LOVERS MIX &amp; MINGLE  Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/663efec3-8e94-4708-a596-97c6257a83a3.png\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"FILM LOVERS MIX & MINGLE  Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/663efec3-8e94-4708-a596-97c6257a83a3.png?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"A low pressure mix &amp;amp; mingle event with a ✨QUEER MADE SHORT FILM SCREENING ✨ for queers looking for Love &amp;amp; ConnectionYou can expect a room full of lovely lgbtq+ babes, a queer-made short film to watch and plenty of time to chat about it.  Enjoy a short film screening and do some organised mixing.  Chat in groups of 6 for 30 mins at a time, with half of the group switching tables for each round so you get to meet lots of people in a more relaxed way It&#39;s the type of event where you can come alone, or bring along your queer friends.  Allys welcome if they are with you. ✨Please choose the reduced cost ticket price if you need to and if you need a free ticket - message me on outsavvy and I&#39;ll give you one ✨I WANT YOU THERE MORE THAN I WANT YOUR MONEY. Schedule The timing of the film will vary slightly but generally the film is screened at the start of the event check the instagram to see the schedule for this month and what film we will be screening. Venue Details:Open friendly vibeFidget/stim toysConversation cardsLow lighting - no flashingLow-level background musicStep free entrance Air con in the cinema but not in the bar - though there are multiple fans and an outdoor areaA large accessible toilet\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | FILM LOVERS MIX &amp; MINGLE  | Wednesday 25th November 2026 (+ 1 other date) @ The Arzner Cinema | Pay What You Can to £12 | Find event and ticket information for Queer Love Co\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function updateStickyTicketButton(hasTickets) {\n\n            var button = document.getElementById('stickyTicketButton');\n\n            if (!button) return;\n\n            if (hasTickets) {\n                button.href = '#checkout';\n            }\n            else {\n                button.href = '#anchor';\n            }\n        }\r\n\r\nfunction startConfirm(button, shouldValidate) {\r\n\r\n    // Run custom validation if this page has it\r\n    if (typeof validate === 'function' && shouldValidate) {\r\n        if (!validate()) {\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // Prevent a second click\r\n    if (button.dataset.processing === 'true') {\r\n        return false;\r\n    }\r\n\r\n    button.dataset.processing = 'true';\r\n    button.classList.add('is-loading');\r\n\r\n            return true;\r\n}\r\n\r\nwindow.addEventListener('pageshow', function() {\n\n    document.querySelectorAll('.loading-button').forEach(function(button) {\n        button.dataset.processing = 'false';\n        button.classList.remove('is-loading');\n    });\n\n});\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n        function showShareModal() {\r\n            $('#shareModal').reveal({\r\n                animation: 'fadeAndPop',                   //fade, fadeAndPop, none\r\n                animationspseeed: 300,                       //how fast animtions are\r\n                clo