ard) {\n\n        var holder =\n            document.getElementById(\"event-date-scroll\");\n\n        if (!holder)\n            return;\n\n        var current =\n            holder.querySelector(\".event-date-card--selected\");\n\n        if (current) {\n            current.classList.remove(\"event-date-card--selected\");\n        }\n\n        card.classList.add(\"event-date-card--selected\");\n    }\n\n\n    function scrollEventDates(direction) {\n\n        var holder =\n            document.getElementById(\"event-date-scroll\");\n\n        if (!holder)\n            return;\n\n        var card =\n            holder.querySelector(\".event-date-card\");\n\n        if (!card)\n            return;\n\n        var gap = 14;\n        var amount =\n            (card.offsetWidth + gap) * 2;\n\n        holder.scrollBy({\n            left: amount * direction,\n            behavior: \"smooth\"\n        });\n    }\n\n    function selectEventDate(card, eventDateId) {\n\n        selectDateCard(card);\n\n        document.getElementById(\"HiddenDate\").value =\n            eventDateId;\n\n        __doPostBack(\n        'ctl00$FullWidth$SelectTickets$ButtonDateRefresh',\n            ''\n        );\n    }\n\n    function scrollToSelectedDate() {\n\n        var holder =\n            document.getElementById(\"event-date-scroll\");\n\n        if (!holder)\n            return;\n\n        var selected =\n            holder.querySelector(\".event-date-card--selected\");\n\n        if (!selected)\n            return;\n\n        var position =\n            selected.offsetLeft -\n            ((holder.clientWidth - selected.offsetWidth) / 2);\n\n        if (position < 0)\n            position = 0;\n\n        holder.scrollLeft = position;\n    }\n\n    function appQueueRefresh() {\n        var iframe = document.createElement('iframe');\n        iframe.setAttribute('src', \"queuepass:webToNativeCall\");\n        document.documentElement.appendChild(iframe);\n        iframe.parentNode.removeChild(iframe);\n        iframe = null;\n\n            Android.queueRefresh();\n        \n    }\n\n    var jsonDates = [{\"EventDateId\":82846,\"StartDate\":\"2026-11-20\",\"DisplayDate\":\"Friday 20th November 2026  @ 7:00 PM\",\"DisplayPrice\":\"Sold Out\",\"CssClass\":\"availability-red\",\"Times\":[]}]\n\n    function formatDate(date) {\n        var d = new Date(date),\n            month = '' + (d.getMonth() + 1),\n            day = '' + d.getDate(),\n            year = d.getFullYear();\n\n        if (month.length < 2)\n            month = '0' + month;\n        if (day.length < 2)\n            day = '0' + day;\n\n        return [year, month, day].join('-');\n    }\n\n    $(document).ready(function () {\n\n        $(\".datepicker\").flatpickr({\n            inline: true,\n            monthSelectorType: \"static\",\n            yearSelectorType: \"static\",\n            minDate: \"2026-11-20\",\n            maxDate: \"2026-11-20\",\n            dateFormat: \"Y-m-d\",\n            enable: [\"2026-11-20\"],\n            onChange: function (selectedDates, dateStr, instance) {\n                $.each(jsonDates, function (index, element) {\n                    if (jsonDates[index].StartDate == dateStr) {\n                        if (jsonDates[index].Times.length == 0) {\n                            $(\".date-display\").show();\n                            var displayText = jsonDates[index].DisplayDate;\n                            $(\"#date-display-title\").text(displayText);\n                            $(\"#date-display-price\").text(jsonDates[index].DisplayPrice);\n                            $(\".time-picker\").hide();\n                            $('.confirm-button').addClass('active');\n                            $(\"#HiddenDatePicker\").val(jsonDates[index].EventDateId);\n                             }\n                             else {\n                                 // Now create some time pickers \n                                 $(\".date-display\").hide();\n                                 $(\".time-picker\").show();\n                                 $(\"#time-picker-control\").empty();\n                                 $('.confirm-button').addClass('inactive');\n                                 $('.confirm-button').removeClass('active');\n\n                                 $.each(jsonDates[index].Times, function (index2, element2) {\n                                     var button = document.createElement(\"button\");\n                                     button.type = \"button\";\n                                     button.setAttribute(\"class\", \"time-button\");\n                                     button.id = \"timebutton\" + jsonDates[index].Times[index2].EventDateId;\n                                     button.innerHTML = jsonDates[index].Times[index2].Time;\n                                     button.value = jsonDates[index].Times[index2].EventDateId;\n                                     button.addEventListener(\"click\", function () {\n                                         $(\".date-display\").show();\n                                         $(\".time-button\").removeClass(\"selected\");\n                                         $(\"#timebutton\" + jsonDates[index].Times[index2].EventDateId).addClass(\"selected\");\n                                         button.class = \"selected\";\n                                         $('.confirm-button').addClass('active');\n                                         $('.confirm-button').removeClass('inactive');\n                                         $(\"#HiddenDatePicker\").val(jsonDates[index].Times[index2].EventDateId);\n                                         $.each(jsonDates[index].Times, function (index3, element3) {\n                                             if (jsonDates[index].Times[index3].EventDateId == button.value) {\n                                                 $(\"#date-display-price\").text(jsonDates[index].Times[index3].DisplayPrice);\n                                                 $(\"#date-display-title\").text(jsonDates[index].Times[index3].DisplayDate);\n                                             }\n                                         });\n                                     });\n                                     var textBox = document.getElementById(\"time-picker-control\");\n                                     textBox.appendChild(button);\n                                 });\n                             }\n                         }\n                     });\n            },\n            onDayCreate: function (dObj, dStr, fp, dayElem) {\n                if (typeof jsonDates !== \"undefined\" && jsonDates) {\n                    $.each(jsonDates, function (index, element) {\n                        var theDate = formatDate(dayElem.dateObj);\n                        if (jsonDates[index].StartDate == theDate) {\n                            dayElem.className += ' ' + jsonDates[index].CssClass;\n                        }\n                    });\n                }\n            }\n        });\n\n        $('.confirm-button').on('click', function (e) {\n\n            e.preventDefault();\n\n            var selectedDate =\n                $(\"#HiddenDatePicker\").val();\n\n                 if (!selectedDate) {\n                     return;\n                 }\n\n                 $(\"#HiddenDate\").val(selectedDate);\n\n                 __doPostBack(\n                     'ctl00$FullWidth$SelectTickets$ButtonRefresh',\n                     ''\n                 );\n             });\n    });\n\n</script>\r\n\r\n<div class=\"ticket-select-holder\">\r\n\r\n    \r\n\r\n        <div id=\"moveTo\">&nbsp;</div>\r\n\r\n        \r\n\r\n            <div class=\"line-red-holder\">\r\n                <h4 class=\"line-red\">Date\n   \n                        </h4>\r\n            </div>\r\n\r\n            \r\n            <div class=\"chosen-date-holder\">\r\n\r\n                <div class=\"date-header-title\">\r\n\r\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"-1 0 32 32\" class=\"ticket-header-icon\">\r\n\r\n                        <!-- Calendar outline -->\r\n                        <path fill=\"rgba(255,90,95)\" d=\"\r\n        M26 8H2V6\r\n        C2 4.896 2.896 4 4 4\r\n        H8V5\r\n        C8 5.553 8.447 6 9 6\r\n        C9.553 6 10 5.553 10 5\r\n        V4H20V5\r\n        C20 5.553 20.447 6 21 6\r\n        C21.553 6 22 5.553 22 5\r\n        V4H26\r\n        C27.104 4 28 4.896 28 6\r\n        V8ZM28 28\r\n        C28 29.104 27.104 30 26 30\r\n        H4\r\n        C2.896 30 2 29.104 2 28\r\n        V10H28V28ZM26 2H22V1\r\n        C22 .448 21.553 0 21 0\r\n        C20.447 0 20 .448 20 1\r\n        V2H10V1\r\n        C10 .448 9.553 0 9 0\r\n        C8.447 0 8 .448 8 1\r\n        V2H4\r\n        C1.791 2 0 3.791 0 6\r\n        V28\r\n        C0 30.209 1.791 32 4 32\r\n        H26\r\n        C28.209 32 30 30.209 30 28\r\n        V6\r\n        C30 3.791 28.209 2 26 2Z\">\r\n                        </path>\r\n\r\n                        <!-- Large centred tick -->\r\n                        <path d=\"M8.5 19\r\n           L13.2 23.5\r\n           L22 14\"\r\n                            fill=\"none\" stroke=\"rgba(255,90,95)\" stroke-width=\"3.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                        </path>\r\n\r\n                    </svg>\r\n\r\n                    <span>Friday 20th November 2026  @ 7:00 PM - 9:00 PM</span>\r\n                </div>\r\n\r\n\r\n            </div>\r\n\r\n            <div id=\"FullWidth_SelectTickets_UpdateDateSelector\">\r\n\t\r\n\r\n                    \r\n</div><div id=\"FullWidth_SelectTickets_UpdateDateSummary\">\r\n\t\r\n\r\n                    \r\n\r\n                    <div id=\"calendarModal\" class=\"reveal-modal\" style=\"visibility: hidden;\">\r\n\r\n                        <div class=\"datepicker-holder\" style=\"display: none;\">\r\n\r\n                            <h2 class=\"datepicker-title\"></h2>\r\n\r\n                            <div class=\"datepicker\"></div>\r\n\r\n                            <div class=\"time-picker\" style=\"display: none;\">\r\n\r\n                                <h2 class=\"time-picker-title\">Select an event time</h2>\r\n\r\n                                <div id=\"time-picker-control\">\r\n                                </div>\r\n\r\n                            </div>\r\n\r\n                            <div class=\"date-display\" style=\"display: none;\">\r\n\r\n                                <div class=\"date-header-title\">\r\n                                    <span id=\"date-display-title\"></span>\r\n                                </div>\r\n\r\n                                <span id=\"date-display-price\"></span>\r\n\r\n                            </div>\r\n\r\n                            \r\n                            <ul class=\"availability-list\">\r\n                                <li class=\"availability-item\">\r\n                                    <span class=\"availability-dot availability-dot--good\"></span>\r\n                                    <span class=\"availability-label\">Good Availability</span>\r\n                                </li>\r\n                                <li class=\"availability-item\">\r\n                                    <span class=\"availability-dot availability-dot--low\"></span>\r\n                                    <span class=\"availability-label\">Low</span>\r\n                                </li>\r\n                                <li class=\"availability-item\">\r\n                                    <span class=\"availability-dot availability-dot--soldout\"></span>\r\n                                    <span class=\"availability-label\">Sold Out</span>\r\n                                </li>\r\n                                <li class=\"availability-item\">\r\n                                    <span class=\"availability-dot availability-dot--waitinglist\"></span>\r\n                                    <span class=\"availability-label\">Waiting List</span>\r\n                                </li>\r\n                            </ul>\r\n                            \r\n\r\n                            <div class=\"modal_actions\">\r\n                                <div>\r\n                                    <button class=\"datepicker-close\" type=\"button\" onclick=\"closeModal()\">Cancel</button>\r\n                                </div>\r\n                                <div>\r\n                                    <button class=\"confirm-button inactive\" type=\"button\">Confirm</button>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div class=\"close-reveal-modal\">&#215;</div>\r\n\r\n                        </div>\r\n\r\n                    </div>\r\n\r\n\r\n                \r\n</div><div id=\"FullWidth_SelectTickets_Update1\">\r\n\t\r\n\r\n                <input type=\"submit\" name=\"ctl00$FullWidth$SelectTickets$ButtonDateRefresh\" value=\"\" id=\"FullWidth_SelectTickets_ButtonDateRefresh\" style=\"display: none;\" />\r\n\r\n                <input name=\"ctl00$FullWidth$SelectTickets$HiddenShowDates\" type=\"hidden\" id=\"HiddenShowDates\" />\r\n\r\n                \r\n\r\n                <div id=\"FullWidth_SelectTickets_LoadingSpinner\" class=\"loading\" style=\"display: none;\">\r\n                    <img src=\"https://cdn.outsavvy.com/website/outsavvyloadingnew.gif\" style=\"margin: 0 auto; width: 85px; height: auto; padding: 20px;\" alt=\"Loading image\" />\r\n                </div>\r\n\r\n                <div id=\"FullWidth_SelectTickets_PlaceholderTickets\">\r\n\t\t\r\n\r\n                    <div id=\"FullWidth_SelectTickets_LoadingTicketBox\" class=\"ticket-box-loader\">\r\n\r\n                        \r\n\r\n                        \r\n\r\n                        \