\"#000000\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                                            <path d=\"M5 12L19 12\" stroke=\"#000000\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                                            <path d=\"M5 17L19 17\" stroke=\"#000000\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                                        </svg>\r\n                                                    </span>\r\n                                                </div>\r\n                                            </label>\r\n\r\n                                        </div>\r\n\r\n                                    </div>\r\n                                </li>\r\n\r\n                            </ul>\r\n                        </nav>\r\n\r\n                        <div class=\"container container-header\">\r\n                            \r\n                            \r\n                        </div>\r\n\r\n                    </div>\r\n\r\n                    \r\n                    <div class=\"top-header-margin\"></div>\r\n                    \r\n\r\n                    <!-- HEADER -->\r\n\r\n                    \r\n\r\n    \r\n\r\n        <div id=\"page-events-wrapper\">\r\n\r\n            \r\n\r\n            <div class=\"event-header page event-header-website\">\r\n                <div class=\"event-header-image_blurry\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/4c4735c3-313e-402a-b030-f0f98fc4e41f.jpg\" class=\"event-header-image lazy\" alt=\"\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/4c4735c3-313e-402a-b030-f0f98fc4e41f.jpg\" class=\"area-main-feature area-main-feature-website lazy\" alt=\"Solve-Along-A-Murder-She-Wrote: New episode \"Dead Man's Gold\" tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/1fa7d59b-2dd4-42a5-baa5-7d16c403a258.jpg\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"Solve-Along-A-Murder-She-Wrote: New episode \"Dead Man's Gold\" tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Solve-Along-A-Murder-She-Wrote: New episode \"Dead Man's Gold\"</p>\r\n\r\n                        <div class=\"event-item event-item-venue\">\r\n\r\n                            <svg width=\"26px\" height=\"26px\" viewBox=\"0 0 512.000000 512.000000\" class=\"ticket-header-icon\">\r\n\r\n                                <g transform=\"translate(0.000000,512.000000) scale(0.100000,-0.100000)\" fill=\"#000000\" stroke=\"no