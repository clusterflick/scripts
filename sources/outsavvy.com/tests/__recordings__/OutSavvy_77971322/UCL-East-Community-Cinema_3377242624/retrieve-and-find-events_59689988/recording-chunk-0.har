M331,379 L333,379 C334.104,379 335,378.104 335,377 L335,375 C335,373.896 334.104,373 333,373 L331,373 C329.896,373 329,373.896 329,375 L329,377 C329,378.104 329.896,379 331,379 L331,379 Z M331,383 L333,383 L333,385 L331,385 L331,383 Z M331,387 L333,387 C334.104,387 335,386.104 335,385 L335,383 C335,381.896 334.104,381 333,381 L331,381 C329.896,381 329,381.896 329,383 L329,385 C329,386.104 329.896,387 331,387 L331,387 Z\" id=\"calendar\" sketch:type=\"MSShapeGroup\">\r\n                                        </path>\r\n                                    </g>\r\n                                </g>\r\n                            </svg>\r\n                            <div>\r\n                                <span id=\"MainContent_LabelDate2\">Friday 20th November 2026 at 7:00 PM</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n\r\n                        <div id=\"shareevent2\" style=\"font-size: 14px; width: 100%; margin-top: 5px; text-align: center;\" class=\"sharevent jssocials\">\r\n                            <div class=\"jssocials-shares\">\r\n\r\n                                <div class=\"jssocials-share\">\r\n\r\n                                    <div onclick=\"loveevent(39621)\" class='like-button' title=\"Unlove This Event\" style=\"cursor: pointer;\">\r\n                                        <div class='like-icon'>\r\n                                            <div class='heart-animation-1'></div>\r\n                                            <div class='heart-animation-2'></div>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                                <div class=\"jssocials-share\">\r\n\r\n                                    <div onclick=\"showShareModal()\" class=\"jssocials-share jssocials-share-share\" style=\"cursor: pointer; margin: 0;\" data-original-title=\"Share This Event\">\r\n\r\n                                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28px\" height=\"28px\" viewBox=\"0 0 24 24\" fill=\"none\">\r\n                                            <path opacity=\"1\" d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" fill=\"#FFF\"></path>\r\n                                            <path d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                            <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">Lesbian Leaders in the ’30s Republican Spain + queer short films</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><h3><strong>Romancero Books with the support of the Office for Cultural and Scientific Affairs of the Spanish Embassy in London, &nbsp;AC/E Programme for the Internalisation of Spanish Culture presents the VI London Festival of Queer Spanish Culture</strong></h3><p>&nbsp;</p><h3>Book Launch + Queer Shorts Screening</h3><h3><i>Lesbian Leaders in the ’30s Republican Spain – Mujeres Libres y feministas</i> by &nbsp;Isabella Lorusso in conversation with Jorge Gárriz</h3><p><i>Lesbian Leaders in the ’30s Republican Spain</i> by the Italian journalist and writer Isabella Lorusso, is a work of oral history that gathers the first-hand testimonies of Spanish women who militated within the POUM and the anarchist movement during the 1930s, in the years of the Popular Front and the Spanish Civil War. Through these women's own voices, Lorusso reconstructs a period of intense political and social upheaval, giving space to memories long overshadowed by official historiography — among them the experience of Lucía Sánchez Saornil, the openly lesbian poet who co-founded the anarcho-feminist organisation Mujeres Libres, one of the era's clearest examples of a lesbian woman occupying a position of political leadership. The book stands as a vivid testament to a generation of women who fought simultaneously against fascism and for their own emancipation, and whose radical vision of freedom — sexual, social and political — continues to resonate today.</p><p>&nbsp;</p><p>&nbsp;</p><h3>Cinema Mentire presents:<br><strong>Será Inmortal: Latin American Shorts on Queer Memories and Archives</strong></h3><p>Queer memory erased and recovered, religious and pagan rituals, archives, Catholicism, and sodomy.</p><p>Across Argentina, Chile, Cuba, Mexico, Puerto Rico, and Uruguay, these works trace how those who refused to conform have navigated the machinery of repression. Through the lens of these filmmakers, memory becomes an archive of survival, desire and a site of political resistance.</p><p>From intimacy and performance to street protest and historical testimony, the programme brings together distinct generations across Latin America. Together, these seven shorts confront silence to assert that those who resist will not be forgotten.</p><p>&nbsp;</p><h2><strong>Popsicles</strong></h2><h2><strong>Dir. Gloria Camiruaga | Chile | 1984 | 5 min.</strong></h2><h2>A group of girls recite Hail Mary while licking popsicles until they discover plastic soldiers in the ice. Given the dictatorship of Augusto Pinochet in Chile at the time, the combination of the sensual and the playful creates a biting commentary.</h2><h2>&nbsp;</h2><h2><strong>Muerde sin miedo</strong></h2><h2><strong>Dir. Cristóbal Guerra | Puerto Rico | 2025 | 11 min.</strong></h2><h2>In this modern, queer retelling of an Antillean legend, a message from the heart of the islands awakens ancestral revenge in a couple. One day, amid passion, desire, and rage, the landscape’s wound compels them to repeat an act of the past.</h2><h2>&nbsp;</h2><h2><strong>Playback</strong></h2><h2><strong>Dir. Agustina Comedi | Argentina | 2019 | 15 min.</strong></h2><h2>Memories woven through unique footage where the actresses of Kalas Group resist trans genocide by turning the stage into a trench.</h2><h2>&nbsp;</h2><h2><strong>Soy una lesbiana de este país</strong></h2><h2><strong>Dir. Rocío Llambí Scirgalea | Uruguay | 2025 | 8 min.</strong></h2><h2>A photograph titled “Soy una lesbiana de este país” shows a hidden figure at its centre. A first-person quest unfolds through fragments of archives, geographies, eras, and personal accounts to locate the protagonist of that photograph.&nbsp;</h2><h2>&nbsp;</h2><h2><strong>Fuego</strong></h2><h2><strong>Dir. Jorge Bordello | Mexico | 2016 | 3 min.</strong></h2><h2>Illustrations mix with excerpts from Luis Felipe Fabre’s poems from&nbsp;<i>Sodomía en la Nueva España</i>, while fire and sounds of sex blend with sounds of protest, and blood is spilt against prosecution.</h2><h2>&nbsp;</h2><h2><strong>Casa Particular</strong></h2><h2><strong>Dir. Gloria Camiruaga | Chile | 1990 | 9 min.</strong></h2><h2>A documentary referencing a performance carried out in 1990 by members of the artistic duo Yeguas del Apocalipsis, formed by poet Francisco Casas and writer Pedro Lemebel. The film also includes testimonies from transvestites in the brothel, in bars and in surrounding locations.</h2><h2>&nbsp;</h2><h2><strong>Será inmortal quien merezca serlo</strong></h2><h2><strong>Dir. Nay Mendl | Cuba | 2024 | 19 min.</strong></h2><h2>Sergio, Ubaldo, Yolexquis, and Winston belong to different generations of the Cuban gay community. They reflect on a time during the Cuban Revolution when homosexuals were sent by train to concentration camps.</h2><p>Cinema Mentiré</p><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.cinemamentire.co.uk/\"><u>Cinema Mentiré</u></a><strong> </strong>is a pop-up film club bringing a taste of rare classic and contemporary Latin American films to UK audiences.</p><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.cinemamentire.co.uk/\">https://www.cinemamentire.co.uk/</a><br>&nbsp;</p><p>Event in English.</p><p>Check the Festival's website to know about our other events:</p><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://bit.ly/LFQSC26\">https://bit.ly/LFQSC26</a></p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Hundred+Years+Gallery%2c+13+Pearson+Street%2c+London%2c+E2+8JD\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0761847&lat=51.53305&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Hundred+Years+Gallery%2c+13+Pearson+Street%2c+London%2c+E2+8JD\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"ht