ath>\r\n                                            <path opacity=\"1\" d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" fill=\"#FFF\"></path>\r\n                                            <path opacity=\"1\" d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" fill=\"#FFF\"></path>\r\n                                            <path d=\"M21 6C21 7.65685 19.6569 9 18 9C16.3431 9 15 7.65685 15 6C15 4.34315 16.3431 3 18 3C19.6569 3 21 4.34315 21 6Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M21 18C21 19.6569 19.6569 21 18 21C16.3431 21 15 19.6569 15 18C15 16.3431 16.3431 15 18 15C19.6569 15 21 16.3431 21 18Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M9 12C9 13.6569 7.65685 15 6 15C4.34315 15 3 13.6569 3 12C3 10.3431 4.34315 9 6 9C7.65685 9 9 10.3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                                            <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                            <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">CAMP x CAMP CLASSICS presents VEGAS IN SPACE +afterparty at The Divine</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p>On November 26th, for <strong>ONE NIGHT ONLY</strong>, queer party <strong>CAMP</strong> teams up with queer film club <strong>CAMP CLASSICS</strong> at <strong>The Divine,</strong> for <strong>THE CAMPEST NIGHT OF THE YEAR</strong>. No other place can you get your nails done, watch a film, see a drag show, and have a dance all in one gloriously camp evening. With performances by <strong>Olli Banks </strong>(@ollibanks), <strong>Mark Crampton</strong> (@irish_nosher), AND nails from <strong>Mason</strong> (@droopyleftlid). Followed by afterparty with <strong>CAMP DJs @danieleckhoff</strong> b2b <strong>@cool.boy.club</strong>.&nbsp;</p><p><i>Afterparty included in £9 screening ticket, £9 OTD for CAMP afterparty.&nbsp;</i></p><p>For this legendary event, we are screening <strong>Vegas in Space (1991).</strong> Three male soldiers are ordered to change their sex (via a pill) and are sent on an undercover mission as showgirls to the female-dominated planet of <strong>Clitoris</strong>, where they must manoeuver complex politics and decadent parties to uncover a plot to disrupt the most important pleasure planet in the Universe.&nbsp;</p><p>A <strong>drag queen space adventure</strong> filmed in \"Glamourama\" that was inspired by a drag queen theme party thrown by <strong>Ginger Quest</strong>. Filmed entirely in one apartment (on a budget paid for with sex work), this film is absolute bliss insanity.&nbsp;</p><p>&nbsp;</p><p><strong>Doors 6:30 (basement)</strong></p><p><strong>Film 7-9 (w/ interval+performances)</strong></p><p><strong>Party 9-1 (upstairs)</strong></p><p>&nbsp;</p><p><strong>CAMP</strong> is a london-based queer party centred on silly extravagant over-the-top fun. <strong>CAMP</strong> welcomes everyone, especially those ready to act a fool and serve ridiculous looks, with a new theme at every event. <strong>CAMP</strong> founders <strong>@danieleckhoff </strong>and <strong>@cool.boy.club</strong> wanted to distil the frenetic energy of house parties and the playful escapism of fancy dress, creating the ultimate dress-up party for all clowns and queers in London! With an incredible selection of local queer talent, every <strong>CAMP</strong> party promises a night of dancing and surprises. Expect silly poppy remixes + energetic bouncy sounds ♪(๑ᴖ◡ᴖ๑)♪</p><p>&nbsp;</p><p><strong>CAMP CLASSICS </strong>is a queer film club run by <strong>@ty_chapman</strong>. We screen films that are queer, camp, silly, retro, sometimes glazed over, or with cult followings, but mostly films that make you realise you don’t need a trillion-dollar budget and an all-star cast to make a film that has an impact. <strong>CAMP CLASSICS</strong> is a great place to meet other queers with twisted minds so come for giggles and stay for vibes. &lt;3</p><p>&nbsp;</p><p><strong>ACCESS INFO:</strong><br>Unfortunately, both floors of The Divine are not currently accessible as we do not<br>have a lift.<br>- The ground floor, main bar of The Divine has level access.<br>- There is an accessible toilet in the main bar.<br>- The cabaret and club space are in the basement of the venue. There is no lift.<br>- There are 17 wide steps down to the basement with handrails on either side, this is<br>where the show will take place.<br>- There are two sets of gender-neutral toilets downstairs, they are not wide enough<br>for wheelchairs.<br>If you need further information, please refer to The Divine ‘About’ page on the<br>website. www.thedivine.co.uk or email us direct on info@thedivine.co.uk</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=The+Divine%2c+33-35+Stoke+Newington+Road%2c+London%2c+N16+8BJ\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0753553&lat=51.55179&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=The+Divine%2c+33-35+Stoke+Newington+Road%2c+London%2c+N16+8BJ\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 250\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0753553&lat=51.55179&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n            <p><span class=locName>The Divine</span><br/>33-35 Stoke Newington Road, London, N16 8BJ</p>\r\n\r\n        </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line-red\">Tagged\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/londonevents><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 48 48\">\r\n  <title>location</title>\r\n  <g id=\"Layer_2\" data-name=\"Layer 2\">\r\n    <g id=\"invisible_box\" data-name=\"invisible box\">\r\n      <rect width=\"48\" height=\"48\" fill=\"none\"/>\r\n    </g>\r\n    <g id=\"icons_Q2\" data-name=\"icons Q2\">\r\n      <path d=\"M24,14a3,3,0,1,1-3,3,2.9,2.9,0,0,1,3-3m0-4a7,7,0,1,0,7,7,7,7,0,0,0-7-7Z\"/>\r\n      <path d=\"M24,6c7.4,0,13,6,13,14S28.4,36.7,24,41.2C19.6,36.7,11,27.5,11,20S16.6,6,24,6m0-4C14.1,2,7,10.1,7,20S18.5,41.3,22.6,45.4a1.9,1.9,0,0,0,2.8,0C29.5,41.3,41,30.1,41,20S33.9,2,24,2Z\"/>\r\n    </g>\r\n  </g>\r\n</svg><span>London Events</span></a><a href=/hashtag/thedivine><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" height=\"25px\" width=\"25px\" version=\"1.1\" id=\"_x32_\" viewBox=\"0 0 512 512\" xml:space=\"preserve\">\r\n<g>\r\n\t<path class=\"st0\" d=\"M320.707,0L37.037,69.971v417.625L320.447,512l154.516-26.258V62.568L320.707,0z M290.346,471.742   l-92.584-7.974v-79.426l-55.086-0.677v75.36l-68.109-5.866V99.367l215.779-53.224V471.742z\"/>\r\n\t<polygon class=\"st0\"