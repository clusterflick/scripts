        <div class='os-organiser-info'>\r\n\r\n                <div class=\"hosted-by-control__name\">\r\n\r\n                <h1 class=\"hosted-by-control__name-text\">Spectra, Queer Non Fiction Films at UCL East</h1>\r\n\r\n  \r\n  <span class=\"hosted-by-control__badge\" title=\"Top Organiser\">\r\n      <span class=\"os-achievement-medal os-medal-gold\">\r\n          <svg viewBox=\"0 0 24 24\" width=\"45\" height=\"45\" aria-hidden=\"true\">\r\n              <path d=\"M8 2h3l1 5H9L8 2Z\" fill=\"#206ce4\" opacity=\".75\" />\r\n              <path d=\"M16 2h-3l-1 5h3l1-5Z\" fill=\"#206ce4\" opacity=\".55\" />\r\n              <circle cx=\"12\" cy=\"14\" r=\"7\" fill=\"currentColor\" />\r\n              <circle cx=\"12\" cy=\"14\" r=\"4\" fill=\"rgba(255,255,255,.28)\" />\r\n          </svg>\r\n      </span>\r\n  </span>\r\n\r\n  \r\n\r\n\r\n                    </div>\r\n\r\n\r\n                <div class=\"profile-meta\">On OutSavvy for 2 years!</div>\r\n\r\n  \r\n                <div class=\"os-meta\">\r\n\r\n                  \r\n\r\n                    <div class=\"content-wrap\">\r\n\r\n                        <a href=\"https://www.instagram.com/spectra.queernonfiction\" target=\"_blank\">🔗 https://www.instagram.com/spectra.queernonfiction</a>\r\n\r\n                    </div>\r\n\r\n                  \r\n                </div>\r\n  \r\n\r\n                <div class=\"os-actions\">\r\n                    \r\n\r\n                           <div title=\"Join the mailing list and access exclsuive pre sales and invites from this event organiser\" class=\"follow-button\">\r\n                          <a id=\"MainContent_ImageButton1\" href=\"javascript:__doPostBack(&#39;ctl00$MainContent$ImageButton1&#39;,&#39;&#39;)\"><svg enable-background='new 0 0 100 100' height='512' viewBox='0 0 100 100' width='512' xmlns='http://www.w3.org/2000/svg'><path d='m87 24h-62c-4.4 0-8 3.6-8 8v3c0 1.1.9 2 2 2s2-.9 2-2v-3c0-.4.1-.8.2-1.2l22.4 19.2-22.4 19.2c-.1-.4-.2-.8-.2-1.2v-3c0-