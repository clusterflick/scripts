            "mimeType": "text/html; charset=utf-8",
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<!--[if lt IE 7]> \t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie6 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 7]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie7 lte9 lte8 lte7 \">\t<![endif]-->\r\n<!--[if IE 8]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie8 lte9 lte8 \">\t\t<![endif]-->\r\n<!--[if IE 9]>\t\t\t\t\t<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\" class=\"ie ie9 lte9 \">\t\t\t\t<![endif]-->\r\n<!--[if (gt IE 9)|!(IE)]><!-->\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\r\n<!--<![endif]-->\r\n<head id=\"Head1\"><title>\r\n\tProgrammers of Tomorrow: Film Festival All-Dayer Tickets | 29 Nov @ The Cinema Museum, London | £9 to £15 | OutSavvy\r\n</title>\r\n\r\n    <script type=\"text/javascript\">\r\n        window.dataLayer = window.dataLayer || [];\r\n\r\n        function gtag() { dataLayer.push(arguments); }\r\n\r\n        if (window.location.hash ? window.location.hash == '#cs-scan' : false) {\r\n            gtag(\"consent\", \"default\", { ad_storage: \"granted\", ad_user_data: \"granted\", ad_personalization: \"granted\", analytics_storage: \"granted\", functionality_storage: \"granted\", personalization_storage: \"granted\", security_storage: \"granted\", wait_for_update: 500 });\r\n        }\r\n        else {\r\n            gtag(\"consent\", \"default\", {\r\n                ad_storage: \"denied\",\r\n                ad_user_data: \"denied\",\r\n                ad_personalization: \"denied\",\r\n                analytics_storage: \"denied\",\r\n                functionality_storage: \"granted\",\r\n                personalization_storage: \"granted\",\r\n                security_storage: \"granted\",\r\n                wait_for_update: 500,\r\n            });\r\n        }\r\n\r\n        gtag(\"set\", \"ads_data_redaction\", true);\r\n\r\n        gtag(\"set\", \"developer_id.dZTlmZj\", true);\r\n    </script>\r\n\r\n    <script async src=\"https://consent.studio/outsavvy.com/banner.js\"></script>\r\n\r\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/combres.axd/siteCss/7769677a7968bf74e504bc7599959c8f5cdfe69ca94b0638a17c981254064d3f3540f1cb22d8839bc7820c9608d113eb98efe7ea68fbf7cc1ac3c817446e0c56/\"/><script type=\"text/javascript\" src=\"/combres.axd/siteJs/4ea27d3d3dfdcea6aa2256650964498a5d720acb896b38d1bcbc2a81e57470911dd600418c7f575901cd7b3741c1b3a433126ce5ab0a56f134539cecb5333ade/\"></script>\r\n\r\n    <meta name=\"Priority\" content=\"1.0\" />\r\n    <meta name=\"ChangeFrequency\" content=\"daily\" />\r\n\r\n    <meta http-equiv=\"last-modified\" name=\"LastModified\" content=\"2026-11-03\" />\r\n\r\n    \r\n    <meta name=\"robots\" content=\"index, follow\" />\r\n    \r\n\r\n    <meta property=\"og:description\" content=\"The Cinema of Tomorrow presents a film festival all-dayer where 3 people/collectives will screen films in public for the 1st time, and the audience gets 3 shows for the price of 1.  This is the grand finale of Programmers of Tomorrow: A Season of Workshops and Screenings for the Future of Film Exhibition (PoT). Come on down for some eclectic movies, truly fresh programming and heaps of do-it-together community spirit. Line-upDoors will be open 45 mins before each screening (and 15 minutes after the screenings have started). Although your ticket is for the entire day and allows for re-entry please do not arrive in the middle of a film.12.45 Talking About Trees (2019), presented by Talking About Trees3.30 Emuthi Puthi (2022), presented by Brown Women in Film6.30 Speed Racer (2008), presented by Simran SangheraFoodEmpanadas (veg &amp;amp; meaty) and pot noodles with a selection of exciting toppings will be available. The museum also has a licensed bar, soft drinks and snacks.ShoppingA physical media stall will be piled high with zines, VHSs and film culture treats to take home with you.FundraiserProceeds for this event are split evenly between supporting the Programmers of Tomorrow and its venue, the Cinema Museum in Kennington. The museum is currently raising money to buy its amazing building and cement its place as the living archive of London&#39;s cinema history. AccessThere is one step to get into the museum, and a lift to get into the screening hall.Accessible and all gender toilets available. Carers free, service dogs welcome.No one turned away for lack of funds (NOTAFLOF). Please email us for a discounted or free ticket.If you have any other questions or requests do get in touch. cinemaoftomorrowldn@gmail.comCinema of Tomorrow is a film club and microcinema in the making for South East London\" />\r\n    <meta property=\"og:locale\" content=\"en_GB\" />\r\n    <meta property=\"og:locale:alternate\" content=\"en_US\" />\r\n    <meta property=\"og:site_name\" content=\"OutSavvy\" />\r\n    <meta property=\"og:type\" content=\"website\" />\r\n    <meta property=\"og:title\" content=\"Programmers of Tomorrow: Film Festival All-Dayer Tickets - London - OutSavvy\" />\r\n    <meta property=\"og:url\" content=\"https://www.outsavvy.com/event/40777/programmers-of-tomorrow-film-festival-all-dayer\" />\r\n    <meta property=\"og:image:type\" content=\"image/jpg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/8c32c00f-9c2f-4a7b-8568-b9ad77a18ee7.jpg\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"Programmers of Tomorrow: Film Festival All-Dayer Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/40777/programmers-of-tomorrow-film-festival-all-dayer\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/8c32c00f-9c2f-4a7b-8568-b9ad77a18ee7.jpg?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"The Cinema of Tomorrow presents a film festival all-dayer where 3 people/collectives will screen films in public for the 1st time, and the audience gets 3 shows for the price of 1.  This is the grand finale of Programmers of Tomorrow: A Season of Workshops and Screenings for the Future of Film Exhibition (PoT). Come on down for some eclectic movies, truly fresh programming and heaps of do-it-together community spirit. Line-upDoors will be open 45 mins before each screening (and 15 minutes after the screenings have started). Although your ticket is for the entire day and allows for re-entry please do not arrive in the middle of a film.12.45 Talking About Trees (2019), presented by Talking About Trees3.30 Emuthi Puthi (2022), presented by Brown Women in Film6.30 Speed Racer (2008), presented by Simran SangheraFoodEmpanadas (veg &amp;amp; meaty) and pot noodles with a selection of exciting toppings will be available. The museum also has a licensed bar, soft drinks and snacks.ShoppingA physical media stall will be piled high with zines, VHSs and film culture treats to take home with you.FundraiserProceeds for this event are split evenly between supporting the Programmers of Tomorrow and its venue, the Cinema Museum in Kennington. The museum is currently raising money to buy its amazing building and cement its place as the living archive of London&#39;s cinema history. AccessThere is one step to get into the museum, and a lift to get into the screening hall.Accessible and all gender toilets available. Carers free, service dogs welcome.No one turned away for lack of funds (NOTAFLOF). Please email us for a discounted or free ticket.If you have any other questions or requests do get in touch. cinemaoftomorrowldn@gmail.comCinema of Tomorrow is a film club and microcinema in the making for South East London\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/40777/programmers-of-tomorrow-film-festival-all-dayer\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | Programmers of Tomorrow: Film Festival All-Dayer | Sunday 29th November 2026 @ The Cinema Museum | £9 to £15 | Find event and ticket information for Cinema of Tomorrow\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function updateStickyTicketButton(hasTickets) {\n\n            var button = document.getElementById('stickyTicketButton');\n\n            if (!button) return;\n\n            if (hasTickets) {\n                button.href = '#checkout';\n            }\n            else {\n                button.href = '#anchor';\n            }\n        }\r\n\r\nfunction startConfirm(button, shouldValidate) {\r\n\r\n    // Run custom validation if this page has it\r\n    if (typeof validate === 'function' && shouldValidate) {\r\n        if (!validate()) {\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // Prevent a second click\r\n    if (button.dataset.processing === 'true') {\r\n        return false;\r\n    }\r\n\r\n    button.dataset.processing = 'true';\r\n    button.classList.add('is-loading');\r\n\r\n            return true;\r\n}\r\n\r\nwindow.addEventListener('pageshow', function() {\n\n    document.querySelectorAll('.loading-button').forEach(function(button) {\n        button.dataset.processing = 'false';\n        button.classList.remove('is-loading');\n    });\n\n});\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n        function showShareModal() {\r\n            $('#shareModal').reveal({\r\n                animation: 'fadeAndPop',                   //fade, fadeAndPop, none\r\n                animationspseeed: 300,                       //how fast animtions are\r\n                closeonbackgroundclick: true,              //if you click background will modal close?\r\n                dismissmodalclass: 'close-reveal-modal'    //the class of a button or element that will close an open modal\r\n            });\r\n        }\r\n\r\n    </script>\r\n\r\n<link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-57x57.png\" /><link rel=\"apple-touch-icon\" sizes=\"60x60\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-60x60.png\" /><link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-72x72.png\" /><link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"https://cdn.outsavvy.com/webs