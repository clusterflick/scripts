"text-align: left; padding-top: 10px; padding-bottom: 10px; margin: 0;\">\r\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 1024 1024\" fill=\"#000000\">\r\n                                    <path d=\"M800 416a288 288 0 1 0-576 0c0 118.144 94.528 272.128 288 456.576C705.472 688.128 800 534.144 800 416zM512 960C277.312 746.688 160 565.312 160 416a352 352 0 0 1 704 0c0 149.312-117.312 330.688-352 544z\"></path>\r\n                                    <path d=\"M512 512a96 96 0 1 0 0-192 96 96 0 0 0 0 192zm0 64a160 160 0 1 1 0-320 160 160 0 0 1 0 320z\"></path>\r\n                                </svg>\r\n                                <p>London</p>\r\n                            </div>\r\n                        </label>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/accountlogin\">\r\n                                <h4 class=\"heading-4\">Login\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"https://www.outsavvy.com/hashtag/christmas\" aria-label=\"Follow the link for all the events\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/6d4f50e7-a1ee-4c85-9b39-0265fab3e2ec.png\" alt=\"The Festive Season!\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    The Festive Season!\r\n                                </h2>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Walking Sculpture Workshop \",\"startDate\": \"2026-12-05T10:00:00+00:00\",\"endDate\": \"2026-12-05T14:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/41006/walking-sculpture-workshop\",\"image\" : \"https://cdn.outsavvy.com/events/7b82c618-00af-42b7-9256-b9cf61a96e3d.jpg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"A Wearable Art &amp;amp; Short Film Workshop with Estere Dzelme &amp;amp; Fred LinkUnleash your inner living artwork.  Join artists Estere Dzelme and Fred Link for a hands-on, high-energy creative workshop inspired by the pioneering Greek performance and body-artist Leda Papaconstantinou.Together, we’ll be turning the body into a canvas constructing weird, funny, camp, and sculptural costumes using a treasure trove of up-cycled materials, found objects, foil, Modroc, tactile haberdashery, and everyday scrap.Whether you want to build a towering cardboard shoulder pad, a wearable trash-chic masterpiece, or an absurd geometric suit, this workshop is all about playful self-expression, tactile experimentation, and having a laugh with custom attire.&#127909; What to ExpectPart 1: The Build (Wearable Sculptures)Dive into a rich selection of up-cycled and bio-friendly materials. Guided by Estere and Fred, you’ll draft, construct, and layer custom wearable elements directly onto the body or as outlandish costume pieces.Part 2: The Action &amp;amp; Short FilmOnce in full regalia, we’ll step out to bring our walking sculptures to life.  We will shoot a collaborative short film featuring everyone’s creations in motion, striking poses, interacting, and capturing the energy of our wearable art.Part 3: Screening &amp;amp; SocialWrap up the session, celebrate each other&#39;s creations, and get ready to see yourselves immortalised in the workshop video reel. &#127912; Key Details &amp;amp; What’s IncludedAll Materials Provided: A huge collection of upcycled textiles, plastics, wire, structural pieces, paints, tapes, and tactile materials will be ready for you to harvest.Bring Your Own (Optional): Have strange trash, old garments, odd trinkets, or weird fabrics gathering dust at home? Bring them along to incorporate. What to Wear: Wear comfortable base layers (like a tight t-shirt, leggings, or jeans) that you don&#39;t mind sticking, taping, or building around.Skill Level: All levels welcome.  No prior art, design, or costume experience needed—just bring an open mind and a willingness to play.&#128467;️ Event InfoDate &amp;amp; Time: 6.12.26 | 10AM-2PMLocation: Hackney Downs Studios\",\"location\": {\"@type\": \"Place\",\"name\": \"Hackney Downs Studios (Creative Workspace)\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Hackney Downs Studios (Creative Workspace), 17 Amhurst Terrace\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E8 2BT\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.55473\", \"longitude\" : \"-0.0675652\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-05T09:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/41006/walking-sculpture-workshop\",\"lowPrice\":10,\"highPrice\":0,\"availabilityStarts\":\"2026-10-28T16:05:44+00:00\",\"validFrom\":\"2026-10-28T16:05:44+00:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-05T09:00:00+00:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/41006/walking-sculpture-workshop\",\"price\":10,\"availabilityStarts\":\"2026-10-28T16:05:44+00:00\",\"validFrom\":\"2026-10-28T16:05:44+00:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-05T09:00:00+00:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/41006/walking-sculpture-workshop\",\"price\":0,\"availabilityStarts\":\"2026-10-28T16:05:44+00:00\",\"validFrom\":\"2026-10-28T16:05:44+00:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/fodder\", \"description\" : \"\", \"name\" : \"Fodder\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 41006,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 7607,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/41006/walking-sculpture-workshop';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|