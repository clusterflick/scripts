3431 9 12Z\" stroke=\"#323232\" stroke-width=\"2\"></path>\r\n                        <path d=\"M8.7207 10.6397L15.0001 7.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                        <path d=\"M8.70605 13.353L15 16.5\" stroke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                    </svg>\r\n                    Share\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        \r\n\r\n        <section class=\"os-about\">\r\n            <div>\r\n\r\n                \r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">About Spectra, Queer Non Fiction Films at UCL East\r\n                        \r\n                         \r\n                    </h4>\r\n                </div>\r\n\r\n\r\n                <div class=\"content-body\">\r\n                    <p><p>𝕊𝕡𝕖𝕔𝕥𝕣𝕒 🌸, is a film club hosted at UCL East, dedicated to showcasing queer stories in documentary, non-fiction works, and artist moving image.<br><br>Our name reflects the light spectrum in film—a range of colours symbolising diverse voices and narratives.<br>&nbsp;</p></p>\r\n                </div>\r\n\r\n                \r\n\r\n                <div class=\"os-about-links\">\r\n\r\n                    <div class=\"line-red-holder\">\r\n                        <h4 class=\"line-red\">Spectra, Queer Non Fiction Films at UCL East Socials\r\n        \r\n                        </h4>\r\n                    </div>\r\n\r\n                    <div style=\"font-size: 12px; width: 100%;\" class=\"sharevent jssocials\">\r\n                        <div class=\"jssocials-shares\">\r\n                            \r\n                            <div class=\"jssocials-share jssocials-share-instagram\">\r\n                                <a target=\"_blank\" href=\"https://www.instagram.com/spectra.queernonfiction\" class=\"jssocials-shar