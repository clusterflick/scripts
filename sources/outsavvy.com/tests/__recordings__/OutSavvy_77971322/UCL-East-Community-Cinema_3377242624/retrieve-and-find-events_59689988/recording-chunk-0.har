 + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|m