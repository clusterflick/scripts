.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/591cbd0f-4615-4d55-bf03-2fca63e8baef.JPG\" class=\"event-header-image lazy\" alt=\"\" />\r\n                </div>\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 675\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/591cbd0f-4615-4d55-bf03-2fca63e8baef.JPG\" class=\"area-main-feature area-main-feature-website lazy\" alt=\"Canal Film Club - On The Road tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"event-header page event-header-mobile\">\r\n                <div class=\"image area-main-feature\">\r\n                    <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 750 750\"%3E%3C/svg%3E' data-src=\"https://cdn.outsavvy.com/events/f1748507-a526-4fb9-8693-5de608de8b6d.JPG\" class=\"area-main-feature area-main-feature-mobile lazy\" alt=\"Canal Film Club - On The Road tickets\" />\r\n                </div>\r\n            </div>\r\n\r\n            \r\n        </div>\r\n\r\n    \r\n\r\n    \r\n\r\n\r\n\r\n                    <div id=\"section\" class=\"sectionevent\">\r\n\r\n                        <div id=\"PanelMainSection\">\r\n\t\r\n                            <div class=\"container clearfix \">\r\n                                \r\n                                <div id=\"primary\" class=\"\">\r\n                                    \r\n\r\n    \r\n\r\n    \r\n\r\n        <div class=\"main-content\">\r\n            <div class=\"content-inner\">\r\n                <div class=\"event-details-mobile\">\r\n\r\n                    <div class=\"event-details\" style=\"text-align: center;\">\r\n\r\n                        <p class=\"event-item event-item-name\">Canal Film Club - On The Road</p>\r\n\r\n                        <div class=\"event-item event-item