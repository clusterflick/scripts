itions\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <ul class=\"event-points\">\r\n            \r\n                <li>\r\n                    No Violence or Verbal Abuse Tolerated</li>\r\n            \r\n                <li>\r\n                    No Refunds</li>\r\n            \r\n                <li>\r\n                    No Verbal or Physical Abuse to staff or audience members</li>\r\n            \r\n                <li>\r\n                    No Homophobia or Transphobia tolerated </li>\r\n            \r\n                </ul>\r\n                            <div style=\"margin-top: 44px; margin-bottom: 44px\">\r\n                            </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n            \r\n\r\n        <section class=\"hosted-by-control\">\r\n\r\n            <div class=\"line-red-holder\">\r\n                <h4 class=\"line-red\">Hosted By\r\n\r\n                </h4>\r\n            </div>\r\n\r\n            <div class=\"hosted-by-control__layout\">\r\n\r\n                \r\n\r\n\r\n                <a href=\"/organiser/hiv-the-naked-truth\"\r\n                    class=\"hosted-by-control__image-link\">\r\n\r\n                    <img src='https://cdn.outsavvy.com/website/preloader.jpg' class=\"hosted-by-control__image lazy\" data-src=\"https://cdn.outsavvy.com/logo/fe789a6b-a83b-4f96-b5f1-31f40c756d93.jpg\" alt=\"HIV The Naked Truth\" />\r\n\r\n                </a>\r\n\r\n                \r\n\r\n\r\n                <div class=\"hosted-by-control__content\">\r\n\r\n                    <div class=\"hosted-by-control__name\">\r\n\r\n                        <a href=\"/organiser/hiv-the-naked-truth\" target=\"_blank\" class=\"hosted-by-control__name-text\">HIV The Naked Truth</a>\r\n\r\n                        \r\n                        <span class=\"hosted-by-control__badge\" title=\"Trusted Organiser\">\r\n                            <span cla