                  </div>\r\n\r\n                    <div class=\"nav-menu-links-wrap\">\r\n\r\n                        <label for=\"locationBtn\">\r\n                            <div class=\"location-popup\" style=\"text-align: left; padding-top: 10px; padding-bottom: 10px; margin: 0;\">\r\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 1024 1024\" fill=\"#000000\">\r\n                                    <path d=\"M800 416a288 288 0 1 0-576 0c0 118.144 94.528 272.128 288 456.576C705.472 688.128 800 534.144 800 416zM512 960C277.312 746.688 160 565.312 160 416a352 352 0 0 1 704 0c0 149.312-117.312 330.688-352 544z\"></path>\r\n                                    <path d=\"M512 512a96 96 0 1 0 0-192 96 96 0 0 0 0 192zm0 64a160 160 0 1 1 0-320 160 160 0 0 1 0 320z\"></path>\r\n                                </svg>\r\n                                <p>London</p>\r\n                            </div>\r\n                        </label>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/accountlogin\">\r\n                                <h4 class=\"heading-4\">Login\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"https://www.outsavvy.com/hashtag/christmas\" aria-label=\"Follow the link for all the events\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/6d4f50e7-a1ee-4c85-9b39-0265fab3e2ec.png\" alt=\"The Festive Season!\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    The Festive Season!\r\n                                </h2>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"DanceEvent\",\"name\": \"CAMP x CAMP CLASSICS presents VEGAS IN SPACE +afterparty at The Divine\",\"startDate\": \"2026-11-26T06:30:00+00:00\",\"endDate\": \"2026-11-27T01:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/40809/camp-x-camp-classics-presents-vegas-in-space-afterparty-at-the-divine\",\"image\" : \"https://cdn.outsavvy.com/events/d84d11b9-ce2b-45e8-9413-f25d891a150a.jpeg\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"On November 26th, for ONE NIGHT ONLY, queer party CAMP teams up with queer film club CAMP CLASSICS at The Divine, for THE CAMPEST NIGHT OF THE YEAR. No other place can you get your nails done, watch a film, see a drag show, and have a dance all in one gloriously camp evening. With performances by Olli Banks (@ollibanks), Mark Crampton (@irish_nosher), AND nails from Mason (@droopyleftlid). Followed by afterparty with CAMP DJs @danieleckhoff b2b @cool.boy.club. Afterparty included in &#163;9 screening ticket, &#163;9 OTD for CAMP afterparty. For this legendary event, we are screening Vegas in Space (1991). Three male soldiers are ordered to change their sex (via a pill) and are sent on an undercover mission as showgirls to the female-dominated planet of Clitoris, where they must manoeuver complex politics and decadent parties to uncover a plot to disrupt the most important pleasure planet in the Universe. A drag queen space adventure filmed in &quot;Glamourama&quot; that was inspired by a drag queen theme party thrown by Ginger Quest. Filmed entirely in one apartment (on a budget paid for with sex work), this film is absolute bliss insanity.  Doors 6:30 (basement)Film 7-9 (w/ interval+performances)Party 9-1 (upstairs) CAMP is a london-based queer party centred on silly extravagant over-the-top fun. CAMP welcomes everyone, especially those ready to act a fool and serve ridiculous looks, with a new theme at every event. CAMP founders @danieleckhoff and @cool.boy.club wanted to distil the frenetic energy of house parties and the playful escapism of fancy dress, creating the ultimate dress-up party for all clowns and queers in London.  With an incredible selection of local queer talent, every CAMP party promises a night of dancing and surprises. Expect silly poppy remixes + energetic bouncy sounds ♪(๑ᴖ◡ᴖ๑)♪ CAMP CLASSICS is a queer film club run by @ty_chapman. We screen films that are queer, camp, silly, retro, sometimes glazed over, or with cult followings, but mostly films that make you realise you don’t need a trillion-dollar budget and an all-star cast to make a film that has an impact. CAMP CLASSICS is a great place to meet other queers with twisted minds so come for giggles and stay for vibes. &amp;lt;3 ACCESS INFO:Unfortunately, both floors of The Divine are not currently accessible as we do nothave a lift.- The ground floor, main bar of The Divine has level access.- There is an accessible toilet in the main bar.- The cabaret and club space are in the basement of the venue. There is no lift.- There are 17 wide steps down to the basement with handrails on either side, this iswhere the show will take place.- There are two sets of gender-neutral toilets downstairs, they are not wide enoughfor wheelchairs.If you need further information, please refer to The Divine ‘About’ page on thewebsite. www.thedivine.co.uk or email us direct on info@thedivine.co.uk\",\"location\": {\"@type\": \"Place\",\"name\": \"The Divine\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Divine, 33-35 Stoke Newington Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"N16 8BJ\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.55179\", \"longitude\" : \"-0.0753553\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-26T05:30:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40809/camp-x-camp-classics-presents-vegas-in-space-afterparty-at-the-divine\",\"lowPrice\":9,\"highPrice\":0,\"availabilityStarts\":\"2026-10-20T17:05:03+01:00\",\"validFrom\":\"2026-10-20T17:05:03+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-26T05:30:00+00:00\",\"name\":\"film+party\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40809/camp-x-camp-classics-presents-vegas-in-space-afterparty-at-the-divine\",\"price\":9,\"availabilityStarts\":\"2026-10-20T17:05:03+01:00\",\"validFrom\":\"2026-10-20T17:05:03+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-26T05:30:00+00:00\",\"name\":\"free carer ticket\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40809/camp-x-camp-classics-presents-vegas-in-space-afterparty-at-the-divine\",\"price\":0,\"availabilityStarts\":\"2026-10-20T17:05:03+01:00\",\"validFrom\":\"2026-10-20T17:05:03+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/camp-classics\", \"description\" : \"CAMP CLASSICS is a queer film club. We screen films that are queer, camp, silly, retro, sometimes glazed over, or with cult followings, but mostly films that make you realise you don’t need a trillion-dollar budget and an all-star cast to make a film that has an impact. \", \"name\" : \"CAMP CLASSICS\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 40809,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 7914,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n            