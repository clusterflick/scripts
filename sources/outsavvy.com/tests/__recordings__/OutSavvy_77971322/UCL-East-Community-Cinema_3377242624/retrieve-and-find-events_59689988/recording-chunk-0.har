g-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">HIV THE NAKED TRUTH - 6TH YEAR ANNIVERSARY - FILM PREMIERE - BRIGHTON 2026</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><ul><li>To mark our <strong>6th year anniversary</strong> we are screening our 2020 poignant <strong>1 HOUR</strong> film in Brighton for <strong>World AIDS Day 2026&nbsp;</strong></li><li><strong>Saturday 28th November from 11AM-13:00PM at the Duke of York's Picturehouse in Brighton!</strong></li><li>The profit from this event is in support of two community based HIV charities : <strong>Positive East </strong>in London and <strong>Lunch Positive</strong> in Brighton!</li><li>The Film includes performing artists from around the world - it was filmed &amp; created during Covid_19 shot in different countries : the film includes incredible world class artists such as <i>Mara Galeazzi, Sasha Mukhamedov, Danilo Palmieri, Arun Blair-Mangat &amp; Andrea Walker &amp; many more talented artists</i></li><li>The Red Carpet Premiere will be hosted by <strong>Asttina Mandella</strong> &amp; <strong>Mimi Chanel</strong></li><li><p>Ticket entry Includes a post film <strong>Q&amp;A</strong> with an introduction from the <strong>Mayor of Brighton &amp; Hove</strong> - the panel includes <i>Andrea Walker, Joshua Royal</i>, &amp; representatives from <i>Lunch Positive </i>in Brighton<i> &amp; Positive East </i>in London</p><p>&nbsp;</p></li><li>Dress Code : <strong>DRESS TO IMPRESS!</strong></li></ul><p>&nbsp;</p><p><strong>‘WE HOPE TO BRING OUR HIV COMMUNITY TOGETHER AND MAKE IT A DAY TO REMEMBER FOR AN IMPORTANT CAUSE - CELEBRATING ALL OUR HARD WORK &amp; ACHIEVEMENTS OVER THE LAST SIX YEARS!’&nbsp;</strong></p><p>&nbsp;</p><ul><li>WE HOPE TO SEE YOU THERE X</li></ul><p>&nbsp;</p><p>&nbsp;</p><p>&nbsp;</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Duke+of+Yorks+Picturehouse%2c++Preston+Road%2c+Brighton+%26+Hove%2c+Brighton%2c+BN1+4NA\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1275862&lat=51.50722&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Duke+of+Yorks+Picturehouse%2c++Preston+Road%2c+Brighton+%26+Hove%2c+Brighton%2c+BN1+4NA\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 250\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.1275862&lat=51.50722&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-left: 0px;\">\r\n\r\n            <p><span class=locName>Duke of Yorks Picturehouse</span><br/> Preston Road, Brighton & Hove, Brighton, BN1 4NA</p>\r\n\r\n        </div>\r\n\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n\r\n\r\n\r\n                            <div class=\"line-red-holder\">\r\n                                <h4 class=\"line-red\">Tagged\r\n\r\n                                </h4>\r\n                            </div>\r\n\r\n                            <div class=\"eventtags\">\r\n                                <span class=\"eventspan\">\r\n                                    <a href=/hashtag/brightonandhoveevents><svg class=\"svgfill\" xmlns=\"http://www.w3.org/2000/svg\" width=\"800px\" height=\"800px\" viewBox=\"0 0 48 48\">\r\n  <title>location</title>\r\n  <g id=\"Layer_2\" data-name=\"Layer 2\">\r\n    <g id=\"invisible_box\" data-name=\"invisible box\">\r\n      <rect width=\"48\" height=\"48\" fill=\"none\"/>\r\n    </g>\r\n    <g id=\"icons_Q2\" data-name=\"icons Q2\">\r\n      <path d=\"M24,14a3,3,0,1,1-3,3,2.9,2.9,0,0,1,3-3m0-4a7,7,0,1,0,7,7,7,7,0,0,0-7-7Z\"/>\r\n      <path d=\"M24,6c7.4,0,13,6,13,14S28.4,36.7,24,41.2C19.6,36.7,11,27.5,11,20S16.6,6,24,6m0-4C14.1,2,7,10.1,7,20S18.5,41.3,22.6,45.4a1.9,1.9,0,0,0,2.8,0C29.5,41.3,41,30.1,41,20S33.9,2,24,2Z\"/>\r\n    </g>\r\n  </g>\r\n</svg><span>Brighton and Hove Events</span></a><a href=/hashtag/bisexual><span>Bisexual</span></a><a href=/hashtag/gaymen><span>Gay Men</span></a><a href=/hashtag/bipoc><span>BIPOC</span></a><a href=/hashtag/queer><span>Queer</span></a><a href=/hashtag/community><span>Community</span></a><a href=/hashtag/screening><span>Screening</span></a><a href=/hashtag/fundraiser><span>Fundraiser</span></a><a href=/hashtag/film><span>Film</span></a>\r\n                                </span>\r\n                            </div>\r\n\r\n                        \r\n\r\n                    </div>\r\n                    <div style=\"margin-top: 14px; margin-bottom: 14px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n        <div class=\"line-red-holder\">\r\n            <h4 class=\"line-red\">The Lineup\r\n\r\n            </h4>\r\n        </div>\r\n\r\n        <div id=\"lineup\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n                    <div class=\"content-body\">\r\n                        <div class=\"event-description\">\r\n                            <span><ul><li>The Red Carpet Premiere will be hosted by <strong>Asttina Mandella</strong> &amp; <strong>Mimi Chanel</strong></li><li>The<strong> 1 HOUR</strong> Film includes performing artists from around the world - it was filmed &amp; created during Covid_19 shot in many different countries : the film includes incredible world class artists such as <i>Mara Galeazzi, Sasha Mukhamedov, Danilo Palmieri, Arun Blair-Mangat, Andrea Walker &amp; many more talented artists…</i></li><li>Ticket entry Includes a post film<i> <strong>Q&amp;A</strong> </i>with an introduction from the<i> <strong>Mayor of Brighton &amp; Hove</strong> - </i>the panel includes <i>Andrea Walker, Joshua Royal, </i>&amp; representatives from<i> Lunch Positive i</i>n Brighton &amp;<i> Positive East </i>in London</li></ul><p>&nbsp;</p><ul><li>DRESS CODE : <strong>DRESS TO IMPRESS!</strong></li></ul></span>\r\n                        </div>\r\n                    </div>\r\n                    <div style=\"margin-top: 24px; margin-bottom: 24px\">\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n        \r\n\r\n        <div class=\"line-red-holder\">\r\n            <h4 class=\"line-red\">Our Vibe\r\n\r\n            </h4>\r\n        </div>\r\n\r\n        <div class=\"music-container \" id=\"music-container\">\r\n            <div class=\"music-info\">\r\n                <h4 id=\"title\">\r\n                    <label id=\"labelSongName\">Til It Happens To You by Lady Gaga</label>\r\n                </h4>\r\n                <div class=\"progress-container\" id=\"progress-container\">\r\n                    <div class=\"progress\" id=\"progress\"></div>\r\n                </div>\r\n            </div>\r\n\r\n            <audio src='https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/53/ce/9e/53ce9e71-ddc8-41e1-0a89-de5b7880c610/mzaf_10354333202880332934.plus.aac.p.m4a' id=\"audio\"></audio>\r\n\r\n            <div class=\"image-container\">\r\n                <img alt=\"music-cover\" id=\"cover\" src=\"https://cdn.outsavvy.com/website/favicon/favicon-96x96.png\" data-src='https://is1-ssl.mzstatic.com/image/thumb/Music115/v4/4a/77/74/4a77744c-da74-0547-8130-a355ef460f3a/00602547585028.rgb.jpg/110x110bb.jpg' class=\"lazy\" />\r\n            </div>\r\n\r\n            <div class=\"control-container\">\r\n                <div class=\"navigation\">\r\n\r\n                    <div id=\"play\" class=\"action-button action-button-big\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" fill=\"#cdc2d0\" version=\"1.1\" id=\"playbutton\" width=\"30px\" height=\"30px\" viewBox=\"0 0 163.861 163.861\" xml:space=\"preserve\">\r\n                            <g>\r\n                                <path d=\"M34.857,3.613C20.084-4.861,8.107,2.081,8.107,19.106v125.637c0,17.042,11.977,23.975,26.75,15.509L144.67,97.275   c14.778-8.477,14.778-22.211,0-30.686L34.857,3.613z\" />\r\n                            </g>\r\n                        </svg>\r\n\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlin