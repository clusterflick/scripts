pg\" />\r\n    <meta property=\"og:image:width\" content=\"1200\" />\r\n    <meta property=\"og:image:height\" content=\"584\" />\r\n    <meta property=\"og:image\" content=\"https://cdn.outsavvy.com/events/9670b0ee-b465-4274-9df8-447782f23478.png\" />\r\n\r\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\r\n    <meta name=\"twitter:site\" content=\"@OutSavvy\" />\r\n    <meta name=\"twitter:title\" content=\"Drag Race UK Season 8 FINALE Viewing Party at Betty & Joan's (hosted by Michael Marouli) Tickets - London - OutSavvy\" />\r\n    <meta name=\"twitter:url\" content=\"https://www.outsavvy.com/event/39012/rpdruk8-bjs\" />\r\n    <meta name=\"twitter:app:name:iphone\" content=\"OutSavvy\" />\r\n    <meta name=\"twitter:app:id:iphone\" content=\"722344276\" />\r\n    <meta name=\"twitter:image\" content=\"https://cdn.outsavvy.com/events/9670b0ee-b465-4274-9df8-447782f23478.png?width=1200\" />\r\n    <meta name=\"twitter:description\" content=\"Drag Race UK Season 8 &#128132;✨ Finale Viewing PartyNov 5th at 7pm Hosted by Michael Marouli (Drag Race UK Season 5 &amp;amp; Winner of Down Under vs The World)With special guest Kyran Thrax (Winner of Drag Race UK Season 6) This event will sell out, and you will not be able to join without a ticket, so grab a FREE ticket now.  ARRIVE BY 6:30pm TO GUARANTEE ENTRY (seat not guaranteed)Once we hit capacity, you may have to wait.\" />\r\n\r\n    <link rel=\"canonical\" href=\"https://www.outsavvy.com/event/39012/rpdruk8-bjs\" />\r\n\r\n    <meta name=\"description\" content=\"OutSavvy | Drag Race UK Season 8 FINALE Viewing Party at Betty &amp; Joan&#39;s (hosted by Michael Marouli) | Thursday 5th November 2026 @ Betty &amp; Joan’s | FREE | Find event and ticket information for Betty &amp; Joan&#39;s\" />\r\n\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n\r\n            var cookieEnabled = navigator.cookieEnabled;\r\n\r\n            // When cookieEnabled flag is present and false then cookies are disabled.\r\n            if (cookieEnabled === false) {\r\n                window.location.replace(\"http://www.outsavvy.com\");\r\n            }\r\n\r\n            // try to set a test cookie if we can't see any cookies and we're using \r\n            // either a browser that doesn't support navigator.cookieEnabled\r\n            // or IE (which always returns true for navigator.cookieEnabled)\r\n            if (!document.cookie && (cookieEnabled === null || /*@cc_on!@*/false)) {\r\n                document.cookie = \"testcookie=1\";\r\n\r\n                if (!document.cookie) {\r\n                    window.location.replace(\"http://www.outsavvy.com\");\r\n                } else {\r\n                    document.cookie = \"testcookie=; expires=\" + new Date(0).toUTCString();\r\n                }\r\n            }\r\n\r\n        });\r\n\r\n        function updateStickyTicketButton(hasTickets) {\n\n            var button = document.getElementById('stickyTicketButton');\n\n            if (!button) return;\n\n            if (hasTickets) {\n                button.href = '#checkout';\n            }\n            else {\n                button.href = '#anchor';\n            }\n        }\r\n\r\nfunction startConfirm(button, shouldValidate) {\r\n\r\n    // Run custom validation if this page has it\r\n    if (typeof validate === 'function' && shouldValidate) {\r\n        if (!validate()) {\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // Prevent a second click\r\n    if (button.dataset.processing === 'true') {\r\n        return false;\r\n    }\r\n\r\n    button.dataset.processing = 'true';\r\n    button.classList.add('is-loading');\r\n\r\n            return true;\r\n}\r\n\r\nwindow.addEventListener('pageshow', function() {\n\n    document.querySelectorAll('.loading-button').forEach(function(button) {\n        button.dataset.processing = 'false';\n        button.classList.remove('is-loading');\n    });\n\n});\r\n\r\n        function toggleShowPassword(clientId) {\r\n            let x = document.getElementById(clientId);\r\n            if (x.type === \"password\") {\r\n                x.type = \"text\";\r\n            } else {\r\n                x.type = \"password\";\r\n            }\r\n        }\r\n\r\n        function showShareModal() {\r\n            $('#shareModal').reveal({\r\n                animation: 'fadeAndPop',                   //fade, fadeAndPop, none\r\n                animationspseeed: 300,                       //how fast animtions are\r\n                closeonbackgroundclick: true,              //if you click background will modal close?\r\n                dismissmodalclass: 'close-reveal-modal'    //the class of a button or element that will close an open modal\r\n            });\r\n        }\r\n\r\n    </script>\r\n\r\n<link rel=\"apple-touch-icon\" sizes=\"57x57\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-57x57.png\" /><link rel=\"apple-touch-icon\" sizes=\"60x60\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-60x60.png\" /><link rel=\"apple-touch-icon\" sizes=\"72x72\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-72x72.png\" /><link rel=\"apple-touch-icon\" sizes=\"76x76\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-76x76.png\" /><link rel=\"apple-touch-icon\" sizes=\"114x114\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-114x114.png\" /><link rel=\"apple-touch-icon\" sizes=\"120x120\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-120x120.png\" /><link rel=\"apple-touch-icon\" sizes=\"144x144\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-144x144.png\" /><link rel=\"apple-touch-icon\" sizes=\"152x152\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-152x152.png\" /><link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"https://cdn.outsavvy.com/website/favicon/apple-icon-180x180.png\" /><link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"https://cdn.o