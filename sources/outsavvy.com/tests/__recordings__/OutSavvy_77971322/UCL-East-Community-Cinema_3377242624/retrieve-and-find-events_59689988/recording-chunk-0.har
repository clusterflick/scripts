   <path d=\"M800 416a288 288 0 1 0-576 0c0 118.144 94.528 272.128 288 456.576C705.472 688.128 800 534.144 800 416zM512 960C277.312 746.688 160 565.312 160 416a352 352 0 0 1 704 0c0 149.312-117.312 330.688-352 544z\"></path>\r\n                                    <path d=\"M512 512a96 96 0 1 0 0-192 96 96 0 0 0 0 192zm0 64a160 160 0 1 1 0-320 160 160 0 0 1 0 320z\"></path>\r\n                                </svg>\r\n                                <p>London</p>\r\n                            </div>\r\n                        </label>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/accountlogin\">\r\n                                <h4 class=\"heading-4\">Login\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"https://www.outsavvy.com/hashtag/christmas\" aria-label=\"Follow the link for all the events\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/6d4f50e7-a1ee-4c85-9b39-0265fab3e2ec.png\" alt=\"The Festive Season!\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    The Festive Season!\r\n                                </h2>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"MusicEvent\",\"name\": \"Canal Film Club - On The Road\",\"startDate\": \"2026-11-15T19:00:00+00:00\",\"endDate\": \"2026-11-15T23:30:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/41138/canal-film-club-on-the-road\",\"image\" : \"https://cdn.outsavvy.com/events/591cbd0f-4615-4d55-bf03-2fca63e8baef.JPG\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"We danced with the Faeries in our forest this summer, but now the season continues with our first ever Winter event. Journey down the river to our next resting place: Autumn Three. Partied too hard over the summer? Don’t worry - we did too. We’re inviting you to our cosiest event, it&#39;s time to hole up for the season. Screening a mystery film program, live music performance and ambient sets on the Autumn Three sound system. Doors 7pmFilm from 7:30Live music &amp;amp; performance 9pmAmbient DJ’s 9:30 Matthew and Hanna will be serving up delights from the Autumn Three Tea Bar, so please don’t bring your own. Leave your boots (and worries) on the shelves at the door as you enter and bring all your softness to the space. Accessibility:The venue has 6 steps down to access the main space (pls DM @canalfilmclub for more details). The gender neutral toilets are within the main space with no extra steps.The tea bar and upper mezzanine can be located up a small spiral staircase. Drinks can be paid for &amp;amp; brought down to the main space if stairs are a problem.This is an indoor/warehouse style venue. Seating is on cushions/beanbags and chairs around the space. Please contact us if you need to reserve a chair with a back support. Ticket pricingThis is a non profit event and tickets are priced via suggested amounts to enable us to put on these events, pay for kit and pay our artists and safeguarding team. There are free tickets too if you can&#39;t contribute right now, Just DM @canalfilmclub Build Community / Safer spaceThis is an indoor venue and we will have welfare present during the event. If anything makes you concerned or uncomfortable, please speak to the door or bar staff. \",\"location\": {\"@type\": \"Place\",\"name\": \"Autumn Three\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"Autumn Three, Unit 3, 39 Autumn Street\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E3 2TT\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.53531\", \"longitude\" : \"-0.01995\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-15T19:00:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/41138/canal-film-club-on-the-road\",\"lowPrice\":5,\"highPrice\":5,\"availabilityStarts\":\"2026-11-03T01:02:41+00:00\",\"validFrom\":\"2026-11-03T01:02:41+00:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-15T19:00:00+00:00\",\"name\":\"General Admission\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/41138/canal-film-club-on-the-road\",\"price\":5,\"availabilityStarts\":\"2026-11-03T01:02:41+00:00\",\"validFrom\":\"2026-11-03T01:02:41+00:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/canal-film-club\", \"description\" : \"Canal Film Club is a series of pop-up outdoor Screenings and Parties coming to a canal near you.  Come and join our Gory, Campy and Gorgeously Blasphemous community of Queerdos and film lovers alike to celebrate all the silliness this summer will bring &amp;lt;3Dance with us.  Scream with us.  Fall in the canal with us.  PRESENTING B-MOVIE SEASON. Our six upcoming monthly editions of Canal Film Club offer a dive into cinema’s ugly younger siblings from April - September. Beaming towards you with Alien Vampires, Satanists &amp;amp; Seances, The Freshest of Femme Fatales, Lesbian Nuns, Sausage munching baskets and all fine things. \", \"name\" : \"Canal Film Club\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 41138,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 3955,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/41138/canal-film-club-on-the-road';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.test(a) || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\\-(n|u)|c55\\/|capi|ccwa|cdm\\-|cell|chtm|cldc|cmd\\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\\-s|devi|dica|dmob|do(c|p)o|ds(12|\\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|f