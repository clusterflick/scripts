n\r\n        <section class=\"hosted-by-control\">\r\n\r\n            <div class=\"line-red-holder\">\r\n                <h4 class=\"line-red\">Hosted By\r\n\r\n                </h4>\r\n            </div>\r\n\r\n            <div class=\"hosted-by-control__layout\">\r\n\r\n                \r\n\r\n\r\n                <a href=\"/organiser/transmissions1\"\r\n                    class=\"hosted-by-control__image-link\">\r\n\r\n                    <img src='https://cdn.outsavvy.com/website/preloader.jpg' class=\"hosted-by-control__image lazy\" data-src=\"https://cdn.outsavvy.com/logo/36badefa-4f1d-4145-8f77-5ffd30851f55.jpg\" alt=\"TRANSMISSIONS\" />\r\n\r\n                </a>\r\n\r\n                \r\n\r\n\r\n                <div class=\"hosted-by-control__content\">\r\n\r\n                    <div class=\"hosted-by-control__name\">\r\n\r\n                        <a href=\"/organiser/transmissions1\" target=\"_blank\" class=\"hosted-by-control__name-text\">TRANSMISSIONS</a>\r\n\r\n                        \r\n                        <span class=\"hosted-by-control__badge\" title=\"Top Organiser\">\r\n                            <span class=\"os-achievement-medal os-medal-gold\">\r\n                                <svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" aria-hidden=\"true\">\r\n                                    <path d=\"M8 2h3l1 5H9L8 2Z\" fill=\"#206ce4\" opacity=\".75\" />\r\n                                    <path d=\"M16 2h-3l-1 5h3l1-5Z\" fill=\"#206ce4\" opacity=\".55\" />\r\n                                    <circle cx=\"12\" cy=\"14\" r=\"7\" fill=\"currentColor\" />\r\n                                    <circle cx=\"12\" cy=\"14\" r=\"4\" fill=\"rgba(255,255,255,.28)\" />\r\n                                </svg>\r\n                            </span>\r\n                        </span>\r\n\r\n                        \r\n                    </div>\r\n\r\n                    <div class=\"hosted-by-control__stats\">\r\n\r\n                    