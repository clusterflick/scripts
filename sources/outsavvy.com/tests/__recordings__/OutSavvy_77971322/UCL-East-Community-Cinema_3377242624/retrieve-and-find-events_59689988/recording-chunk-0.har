px\" viewBox=\"0 0 1024 1024\" fill=\"#000000\">\r\n                                    <path d=\"M800 416a288 288 0 1 0-576 0c0 118.144 94.528 272.128 288 456.576C705.472 688.128 800 534.144 800 416zM512 960C277.312 746.688 160 565.312 160 416a352 352 0 0 1 704 0c0 149.312-117.312 330.688-352 544z\"></path>\r\n                                    <path d=\"M512 512a96 96 0 1 0 0-192 96 96 0 0 0 0 192zm0 64a160 160 0 1 1 0-320 160 160 0 0 1 0 320z\"></path>\r\n                                </svg>\r\n                                <p>London</p>\r\n                            </div>\r\n                        </label>\r\n\r\n                        \r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/accountlogin\">\r\n                                <h4 class=\"heading-4\">Login\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"https://www.outsavvy.com/hashtag/christmas\" aria-label=\"Follow the link for all the events\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/6d4f50e7-a1ee-4c85-9b39-0265fab3e2ec.png\" alt=\"The Festive Season!\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    The Festive Season!\r\n                                </h2>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp; neurodivergent friendly]\",\"startDate\": \"2026-09-28T18:30:00+01:00\",\"endDate\": \"2026-09-28T21:30:00+01:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"image\" : \"https://cdn.outsavvy.com/events/42b2fcd1-b564-427f-b1e3-3105e3c8e33b.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp;amp; neurodivergent friendly]A film night for POC with niche interests. For fans of sci-fi, futuristic things, de-colonising space, mind benders, dystopias and alien vibes - with a lil discussion afterwards to talk about the film ★[soft drinks available to purchase at The Common Press + bring your own snacks]The purpose is to create a casual gathering of sci-fi film lovers who haven’t been able to take up space in a genre that’s typically predominantly white and to expand the narratives of science fiction from other cultures, featuring sci-fi films that focus on black &amp;amp; brown narratives. Beginning with a focus on Afro-sci fi, the intention is to continue watching films from other cultural identities and heritages that explore sci-fi in their own ways too. A place where it’s okay to feel off in the world &amp;amp; recreate  With an intention to set these up regularly, this is a re-launch to set the ball rolling again..  After a wonderful return last month with Crumbs, our next screening takes us to Cameroon, with Les Saignantes. Please note, this event is POC OnlyTitle: Les Saignantes [The Bleeders] Film description: Sci-Fi Erotic Horror set in Cameroon: Vampiric femmes fatales emasculate high-ranking Cameroonian officials through ancient rituals of Mevoungou [contains nudity]Trailer: https://youtu.be/kesSVI-FXjc?si=AAoF_BUwd3_H2-tlSchedule Outline:18:30 - Doors Open19:00 - Film Starts20:30 - Film ends20:40 - Discussion on film21:30 - Event ends Organiser: Niito [artist name iNKOGNiiTO] A music/visual artist and cinema projectionist - currently bleeding the concept of their artistry into reality through curating queer &amp;amp; neurodivergent friendly black &amp;amp; brown centred sci-fi film nights. Niito is starting to explore cosmic re-indiginising in micro communities. Curating spaces that de-center the white gaze through a sci-fi lens to create an alternative futuristic scene. Other key words: speculative non-fiction, decolonising space, afro nomads, befriending alienation, mundane absurdism.\",\"location\": {\"@type\": \"Place\",\"name\": \"The Common Press Shoreditch\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Common Press Shoreditch, 118  Bethnal Green Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E2 6DG\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.52496\", \"longitude\" : \"-0.0711741\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-09-28T17:30:00+01:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"lowPrice\":0,\"highPrice\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"offers\":[{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-09-28T17:30:00+01:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-09-28T17:30:00+01:00\",\"name\":\"Free entry\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/the-common-press\", \"description\" : \"The Common Press CIC is a not-for-profit queer bookshop that means so much to the community. More than just a bookshop, we are a sanctuary for storytelling, queer culture, and a vital third space for the LGBTQIA+ community. As London’s first consciously queer intersectional bookshop caf&#233;, we host a plethora of events each week and stock over 7,000 curated books on trans-inclusive feminism, anti-colonialism, anti-fascism, ecopolitics, and self-care. We also make great coffee, tea, and know how to throw incredible book events, workshops, social events and parties. Drop by to see us soon in Shoreditch or Dalston :)  Shoreditch Address: 118 Bethnal Green Road, London, E2 6DFDalston: 97 Stoke Newington Road, London, N16 8BX\", \"name\" : \"The Common Press\"}},{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp; neurodivergent friendly]\",\"startDate\": \"2026-10-29T18:30:00+00:00\",\"endDate\": \"2026-10-29T21:30:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"image\" : \"https://cdn.outsavvy.com/events/42b2fcd1-b564-427f-b1e3-3105e3c8e33b.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp;amp; neurodivergent friendly]A film night for POC with niche interests. For fans of sci-fi, futuristic things, de-colonising space, mind benders, dystopias and alien vibes - with a lil discussion afterwards to talk about the film ★[soft drinks available to purchase at The Common Press + bring your own snacks]The purpose is to create a casual gathering of sci-fi film lovers who haven’t been able to take up space in a genre that’s typically predominantly white and to expand the narratives of science fiction from other cultures, featuring sci-fi films that focus on black &amp;amp; brown narratives. Beginning with a focus on Afro-sci fi, the intention is to continue watching films from other cultural identities and heritages that explore sci-fi in their own ways too. A place where it’s okay to feel off in the world &amp;amp; recreate  With an intention to set these up regularly, this is a re-launch to set the ball rolling again..  After a wonderful return last month with Crumbs, our next screening takes us to Cameroon, with Les Saignantes. Please note, this event is POC OnlyTitle: Les Saignantes [The Bleeders] Film description: Sci-Fi Erotic Horror set in Cameroon: Vampiric femmes fatales emasculate high-ranking Cameroonian officials through ancient rituals of Mevoungou [contains nudity]Trailer: https://youtu.be/kesSVI-FXjc?si=AAoF_BUwd3_H2-tlSchedule Outline:18:30 - Doors Open19:00 - Film Starts20:30 - Film ends20:40 - Discussion on film21:30 - Event ends Organiser: Niito [artist name iNKOGNiiTO] A music/visual artist and cinema projectionist - currently bleeding the concept of their artistry into reality through curating queer &amp;amp; neurodivergent friendly black &amp;amp; brown centred sci-fi film nights. Niito is starting to explore cosmic re-indiginising in micro communities. Curating spaces that de-center the white gaze through a sci-fi lens to create an alternative futuristic scene. Other key words: speculative non-fiction, decolonising space, afro nomads, befriending alienation, mundane absurdism.\",\"location\": {\"@type\": \"Place\",\"name\": \"The Common Press Shoreditch\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Common Press Shoreditch, 118  Bethnal Green Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E2 6DG\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.52496\", \"longitude\" : \"-0.0711741\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-29T17:30:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"lowPrice\":0,\"highPrice\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"offers\":[{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-29T17:30:00+00:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-29T17:30:00+00:00\",\"name\":\"Free entry\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-09-14T19:45:35+01:00\",\"validFrom\":\"2026-09-14T19:45:35+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/the-common-press\", \"description\" : \"The Common Press CIC is a not-for-profit queer bookshop that means so much to the community. More than just a bookshop, we are a sanctuary for storytelling, queer culture, and a vital third space for the LGBTQIA+ community. As London’s first consciously queer intersectional bookshop caf&#233;, we host a plethora of events each week and stock over 7,000 curated books on trans-inclusive feminism, anti-colonialism, anti-fascism, ecopolitics, and self-care. We also make great coffee, tea, and know how to throw incredible book events, workshops, social events and parties. Drop by to see us soon in Shoreditch or Dalston :)  Shoreditch Address: 118 Bethnal Green Road, London, E2 6DFDalston: 97 Stoke Newington Road, London, N16 8BX\", \"name\" : \"The Common Press\"}},{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp; neurodivergent friendly]\",\"startDate\": \"2026-11-23T18:30:00+00:00\",\"endDate\": \"2026-11-23T22:00:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"image\" : \"https://cdn.outsavvy.com/events/42b2fcd1-b564-427f-b1e3-3105e3c8e33b.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"Afro Sci-Fi Film Club 4 the Global Majority [queer &amp;amp; neurodivergent friendly]A film night for POC with niche interests. For fans of sci-fi, futuristic things, de-colonising space, mind benders, dystopias and alien vibes - with a lil discussion afterwards to talk about the film ★[soft drinks available to purchase at The Common Press + bring your own snacks]The purpose is to create a casual gathering of sci-fi film lovers who haven’t been able to take up space in a genre that’s typically predominantly white and to expand the narratives of science fiction from other cultures, featuring sci-fi films that focus on black &amp;amp; brown narratives. Beginning with a focus on Afro-sci fi, the intention is to continue watching films from other cultural identities and heritages that explore sci-fi in their own ways too. A place where it’s okay to feel off in the world &amp;amp; recreate  With an intention to set these up regularly, this is a re-launch to set the ball rolling again..  After a wonderful return last month with Crumbs, our next screening takes us to Cameroon, with Les Saignantes. Please note, this event is POC OnlyTitle: Les Saignantes [The Bleeders] Film description: Sci-Fi Erotic Horror set in Cameroon: Vampiric femmes fatales emasculate high-ranking Cameroonian officials through ancient rituals of Mevoungou [contains nudity]Trailer: https://youtu.be/kesSVI-FXjc?si=AAoF_BUwd3_H2-tlSchedule Outline:18:30 - Doors Open19:00 - Film Starts20:30 - Film ends20:40 - Discussion on film21:30 - Event ends Organiser: Niito [artist name iNKOGNiiTO] A music/visual artist and cinema projectionist - currently bleeding the concept of their artistry into reality through curating queer &amp;amp; neurodivergent friendly black &amp;amp; brown centred sci-fi film nights. Niito is starting to explore cosmic re-indiginising in micro communities. Curating spaces that de-center the white gaze through a sci-fi lens to create an alternative futuristic scene. Other key words: speculative non-fiction, decolonising space, afro nomads, befriending alienation, mundane absurdism.\",\"location\": {\"@type\": \"Place\",\"name\": \"The Common Press Shoreditch\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Common Press Shoreditch, 118  Bethnal Green Road\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"E2 6DG\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.52496\", \"longitude\" : \"-0.0711741\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-23T17:30:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"lowPrice\":0,\"highPrice\":0,\"availabilityStarts\":\"2026-10-19T19:46:26+01:00\",\"validFrom\":\"2026-10-19T19:46:26+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-11-23T17:30:00+00:00\",\"name\":\"Pay what you can\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-10-19T19:46:26+01:00\",\"validFrom\":\"2026-10-19T19:46:26+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-11-23T17:30:00+00:00\",\"name\":\"Free entry\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly\",\"price\":0,\"availabilityStarts\":\"2026-10-19T19:46:26+01:00\",\"validFrom\":\"2026-10-19T19:46:26+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/the-common-press\", \"description\" : \"The Common Press CIC is a not-for-profit queer bookshop that means so much to the community. More than just a bookshop, we are a sanctuary for storytelling, queer culture, and a vital third space for the LGBTQIA+ community. As London’s first consciously queer intersectional bookshop caf&#233;, we host a plethora of events each week and stock over 7,000 curated books on trans-inclusive feminism, anti-colonialism, anti-fascism, ecopolitics, and self-care. We also make great coffee, tea, and know how to throw incredible book events, workshops, social events and parties. Drop by to see us soon in Shoreditch or Dalston :)  Shoreditch Address: 118 Bethnal Green Road, London, E2 6DFDalston: 97 Stoke Newington Road, London, N16 8BX\", \"name\" : \"The Common Press\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 39678,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 1953,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/39678/afro-sci-fi-film-club-4-the-global-majority-queer-neurodivergent-friendly';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (function (a) { if (/(android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.test(a) || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\\-(n|u)|c55\\/|capi|ccwa|cdm\\-|cell|chtm|cldc|cmd\\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\\-s|devi|dica|dmob|do(c|p)o|ds(12|\\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\\-|_)|g1 u|g560|gene|gf\\-5|g\\-mo|go(\\.w|od)|gr(ad|un)|haie|hcit|hd\\-(m|p|t)|hei\\-|hi(pt|ta)|hp( i|ip)|hs\\-c|ht(c(\\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\\-(20|go|ma)|i230|iac( |\\-|\\/)|ibro|id