                         </a>\r\n                        </div>\r\n\r\n                        <div class=\"nav-menu-link\">\r\n                            <a href=\"/register\">\r\n                                <h4 class=\"heading-4\">Register\r\n                                </h4>\r\n                            </a>\r\n                        </div>\r\n                        \r\n                    </div>\r\n\r\n                    \r\n\r\n<div class=\"nav-advert\">\r\n    <div id=\"eventscontent\" class=\"module-box row\">\r\n\r\n        <div class=\"newspanel\" id=\"tab-all\" style=\"display: block;\">\r\n\r\n            <div class=\"row row-16\">\r\n                <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\">\r\n                    <a href=\"https://www.outsavvy.com/hashtag/christmas\" aria-label=\"Follow the link for all the events\">\r\n                        <article class=\"entry\" style=\"margin-bottom: 0px;\">\r\n                            <div class=\"thumb-bg-holder entry__bg-img-holder\">\r\n                                \r\n                                <img class=\"lazy\" src='https://cdn.outsavvy.com/website/preloader.jpg' data-src=\"https://cdn.outsavvy.com/bannerimage/6d4f50e7-a1ee-4c85-9b39-0265fab3e2ec.png\" alt=\"The Festive Season!\" />\r\n                                <div class=\"bottom-gradient\"></div>\r\n                            </div>\r\n                            <div class=\"thumb-text-holder\">\r\n                                <h2 class=\"thumb-entry-title\">\r\n                                    The Festive Season!\r\n                                </h2>\r\n                                \r\n                            </div>\r\n                        </article>\r\n                    </a>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class=\"menu_footer_buttons\">\r\n                    <div class=\"nav-coll-links\">\r\n\r\n                        \r\n                        <a class=\"nav-coll-link\" href=\"/accountlogin\">Login</a>\r\n                        <a class=\"nav-coll-link\" href=\"/register\">Register</a>\r\n                        \r\n                    </div>\r\n                </div>\r\n\r\n                <footer class=\"menu_footer\">\r\n\r\n                    <div id=\"footer-apps\">\r\n                        <div class=\"actions\">\r\n                            <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                            <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"menu_footer_links\">\r\n                        <a class=\"menu_footer_link\" href=\"/aboutus\">About</a>\r\n                        <a class=\"menu_footer_link\" href=\"/support\">Support</a>\r\n                        <a class=\"menu_footer_link\" href=\"/resell\">ReSell</a>\r\n                        <a class=\"menu_footer_link\" href=\"/contactus\">Contact</a>\r\n                    </div>\r\n                </footer>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        \r\n\r\n    \r\n\r\n        <script type=\"application/ld+json\">\r\n        [{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"FILM LOVERS MIX &amp; MINGLE \",\"startDate\": \"2026-10-28T18:30:00+00:00\",\"endDate\": \"2026-10-28T22:30:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"image\" : \"https://cdn.outsavvy.com/events/663efec3-8e94-4708-a596-97c6257a83a3.png\",\"eventStatus\" : \"http://schema.org/EventScheduled\",\"description\" : \"A low pressure mix &amp;amp; mingle event with a ✨QUEER MADE SHORT FILM SCREENING ✨ for queers looking for Love &amp;amp; ConnectionYou can expect a room full of lovely lgbtq+ babes, a queer-made short film to watch and plenty of time to chat about it.  Enjoy a short film screening and do some organised mixing.  Chat in groups of 6 for 30 mins at a time, with half of the group switching tables for each round so you get to meet lots of people in a more relaxed way It&#39;s the type of event where you can come alone, or bring along your queer friends.  Allys welcome if they are with you. ✨Please choose the reduced cost ticket price if you need to and if you need a free ticket - message me on outsavvy and I&#39;ll give you one ✨I WANT YOU THERE MORE THAN I WANT YOUR MONEY. Schedule The timing of the film will vary slightly but generally the film is screened at the start of the event check the instagram to see the schedule for this month and what film we will be screening. Venue Details:Open friendly vibeFidget/stim toysConversation cardsLow lighting - no flashingLow-level background musicStep free entrance Air con in the cinema but not in the bar - though there are multiple fans and an outdoor areaA large accessible toilet\",\"location\": {\"@type\": \"Place\",\"name\": \"The Arzner Cinema\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Arzner Cinema, 10 Bermondsey Square\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE1 3UN\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.49764\", \"longitude\" : \"-0.0807161\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-28T21:30:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"lowPrice\":12,\"highPrice\":0,\"availabilityStarts\":\"2026-07-23T18:19:46+01:00\",\"validFrom\":\"2026-07-23T18:19:46+01:00\",\"offers\":[{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-28T21:30:00+00:00\",\"name\":\"GENERAL ADMISSION\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":12,\"availabilityStarts\":\"2026-09-02T16:26:14+01:00\",\"validFrom\":\"2026-09-02T16:26:14+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-28T21:30:00+00:00\",\"name\":\"Reduced Cost \",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":6,\"availabilityStarts\":\"2026-07-23T18:19:46+01:00\",\"validFrom\":\"2026-07-23T18:19:46+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-10-28T21:30:00+00:00\",\"name\":\"PWYC REDUCED COST\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":0,\"availabilityStarts\":\"2026-09-02T16:26:14+01:00\",\"validFrom\":\"2026-09-02T16:26:14+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/queer-love-co\", \"description\" : \"Queer Love Co events are designed to make it easier for lgbtqia+ folks meet new people and connect for friendship, romance and community \", \"name\" : \"Queer Love Co\"}},{\"@context\": \"http://schema.org\",\"@type\": \"ScreeningEvent\",\"name\": \"FILM LOVERS MIX &amp; MINGLE \",\"startDate\": \"2026-11-25T18:30:00+00:00\",\"endDate\": \"2026-11-25T22:30:00+00:00\",\"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\"url\" : \"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"image\" : \"https://cdn.outsavvy.com/events/663efec3-8e94-4708-a596-97c6257a83a3.png\",\"eventStatus\" : \"ht