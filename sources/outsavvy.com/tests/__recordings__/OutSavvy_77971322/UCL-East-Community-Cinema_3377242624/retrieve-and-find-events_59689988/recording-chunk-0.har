✨QUEER MADE SHORT FILM SCREENING ✨ for queers looking for Love &amp;amp; ConnectionYou can expect a room full of lovely lgbtq+ babes, a queer-made short film to watch and plenty of time to chat about it.  Enjoy a short film screening and do some organised mixing.  Chat in groups of 6 for 30 mins at a time, with half of the group switching tables for each round so you get to meet lots of people in a more relaxed way It&#39;s the type of event where you can come alone, or bring along your queer friends.  Allys welcome if they are with you. ✨Please choose the reduced cost ticket price if you need to and if you need a free ticket - message me on outsavvy and I&#39;ll give you one ✨I WANT YOU THERE MORE THAN I WANT YOUR MONEY. Schedule The timing of the film will vary slightly but generally the film is screened at the start of the event check the instagram to see the schedule for this month and what film we will be screening. Venue Details:Open friendly vibeFidget/stim toysConversation cardsLow lighting - no flashingLow-level background musicStep free entrance Air con in the cinema but not in the bar - though there are multiple fans and an outdoor areaA large accessible toilet\",\"location\": {\"@type\": \"Place\",\"name\": \"The Arzner Cinema\",\"address\": { \"@type\" : \"PostalAddress\",\"streetAddress\" : \"The Arzner Cinema, 10 Bermondsey Square\",\"addressLocality\" : \"London\",\"addressRegion\" : \"England\",\"postalCode\" : \"SE1 3UN\" },\"geo\" : {\"@type\" : \"GeoCoordinates\", \"latitude\" : \"51.49764\", \"longitude\" : \"-0.0807161\"} },\"offers\": {\"@type\": \"AggregateOffer\", \"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-23T21:30:00+00:00\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"lowPrice\":12,\"highPrice\":0,\"availabilityStarts\":\"2026-07-23T18:19:46+01:00\",\"validFrom\":\"2026-07-23T18:19:46+01:00\",\"offers\":[{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-23T21:30:00+00:00\",\"name\":\"GENERAL ADMISSION\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":12,\"availabilityStarts\":\"2026-09-02T16:26:14+01:00\",\"validFrom\":\"2026-09-02T16:26:14+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/OutOfStock\", \"availabilityEnds\":\"2026-12-23T21:30:00+00:00\",\"name\":\"Reduced Cost \",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":6,\"availabilityStarts\":\"2026-07-23T18:19:46+01:00\",\"validFrom\":\"2026-07-23T18:19:46+01:00\",\"@type\":\"Offer\"},{\"availability\":\"http://schema.org/InStock\", \"availabilityEnds\":\"2026-12-23T21:30:00+00:00\",\"name\":\"PWYC REDUCED COST\",\"priceCurrency\":\"GBP\",\"url\":\"https://www.outsavvy.com/event/40731/film-lovers-mix-mingle\",\"price\":0,\"availabilityStarts\":\"2026-09-02T16:26:14+01:00\",\"validFrom\":\"2026-09-02T16:26:14+01:00\",\"@type\":\"Offer\"}]},\"organizer\" : { \"@type\" : \"Organization\", \"url\" : \"https://www.outsavvy.com/organiser/queer-love-co\", \"description\" : \"Queer Love Co events are designed to make it easier for lgbtqia+ folks meet new people and connect for friendship, romance and community \", \"name\" : \"Queer Love Co\"}}]\r\n        </script>\r\n\r\n    \r\n\r\n    \r\n\r\n    <script type=\"text/javascript\">\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesLove\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventId: 40731,\n                    userId: ''\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const doesLove = data.d;\n\n                    if (doesLove) {\n                        document.body.classList.add(\"is-following\");\n                    }\n\n                });\n\n        });\r\n\r\n        window.addEventListener(\"load\", function () {\n\n            fetch(\"/Default.aspx/GetDoesFollowOrganiser\", {\n                method: \"POST\",\n                headers: {\n                    \"Content-Type\": \"application/json\"\n                },\n                body: JSON.stringify({\n                    eventPartnerid: 3157,\n                    userId: ''\n\n                })\n            })\n                .then(r => r.json())\n                .then(data => {\n\n                    const result = data.d;\n\n                    const button = document.querySelector(\".follow-organiser\");\n\n                    if (!button)\n                        return;\n\n                    if (result.CssClass.length > 0)\n                        button.classList.add(result.CssClass);\n\n                    const span = button.querySelector(\"span\");\n\n                    if (span)\n                        span.textContent = result.Text;\n\n                });\n\n        });\n\r\n\r\n        function followorganiser(eventpartnerid) {\r\n\r\n            const button = document.querySelector(\".follow-organiser\");\r\n\r\n            if (button.classList.contains(\"following-button\")) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.remove(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Follow\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddFollowOrganiser\",\r\n                    data: '{ userId: \"\", partnerId: \"' + eventpartnerid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            button.classList.add(\"following-button\");\r\n                            const span = button.querySelector(\"span\");\n                            if (span)\n                                span.textContent = \"Following\";\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n\r\n        function loveevent(eventid) {\r\n\r\n             \r\n            window.location.href = '/accountlogin?returnURL=/event/40731/film-lovers-mix-mingle';\r\n            return;\r\n                        \r\n\r\n            if (document.body.classList.contains('is-following')) {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/RemoveEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\" }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.remove(\"is-following\");\r\n                            $(\".hiddenLike\").hide();\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            } else {\r\n                // Send the like to the service\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    url: \"/Default.aspx/AddEventLike\",\r\n                    data: '{ userId: \"\", eventId: \"' + eventid + '\", isWebsite: true }',\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    dataType: \"json\",\r\n                    success: function (r) {\r\n                        if (r.d != 'undefined' && r.d != '' && r.d != null) {\r\n                            document.body.classList.add(\"is-following\");\r\n                            $(\".hiddenLike\").slideDown(\"slow\", function () {\r\n                                // Animation complete.\r\n                            });\r\n                        }\r\n                    },\r\n                    failure: function (r) {\r\n                    },\r\n                    error: function (r) {\r\n                    }\r\n                });\r\n            }\r\n        }\r\n\r\n        $(document).ready(function () {\r\n\r\n            let check = false;\r\n            (func