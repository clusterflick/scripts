roke=\"#323232\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n                                        </svg>\r\n                                    </div>\r\n\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n\r\n                        \r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"hiddenLike\" style=\"display: none;\">\r\n\r\n            <div class=\"row app-notification\" style=\"display: inline-block; background-image: url(https://cdn.outsavvy.com/website/page-bg-dark.png); margin-bottom: 20px;\">\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n                <div class=\"col-lg-10 col-md-10 col-sm-12 col-xs-12 col\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-lg-4 col-md-4 col-sm-12 col-xs-12 col\" style=\"display: flex; align-items: flex-end;\">\r\n                            <img src=\"https://cdn.outsavvy.com/website/preloader.jpg\" data-src=\"https://cdn.outsavvy.com/website/app-notification.jpg\" class=\"app-intro lazy\" />\r\n                        </div>\r\n                        <div class=\"col-lg-8 col-md-8 col-sm-12 col-xs-12 col event-description\">\r\n                            <h3 style=\"text-align: center;\">Track your loved events in your profile or on the OutSavvy App</h3>\r\n                            <ul>\r\n                                <li>Store your tickets securely on the app</li>\r\n                                <li>Browse and buy tickets on the go</li>\r\n                                <li>Get app notifications when tickets go on sale to make sure you are first in the queue</li>\r\n                            </ul>\r\n\r\n                            <div class=\"actions\" style=\"text-align: center; margin-top: 20px;\">\r\n                                <a class=\"btn ui-gradient-green btn-app-store btn-download shadow-lg\" href=\"https://apps.apple.com/gb/app/outsavvy/id722344276\" target=\"_blank\"><span>Available on the</span> <span>App Store</span></a>\r\n                                <a class=\"btn ui-gradient-blue btn-google-play btn-download shadow-lg\" href=\"https://play.google.com/store/apps/details?id=com.outsavvyapp\" target=\"_blank\"><span>Available on </span><span>Google Play</span></a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-1 col-md-1 col-sm-0 col-xs-0 col\"></div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div id=\"description\">\r\n            <div style=\"margin-bottom: 0\">\r\n                <section>\r\n\r\n                    <h1 class=\"event-item event-item-name\">IDENTITY! Chats Palace - Preview Exhibition tickets with Film Screening</h1>\r\n\r\n                    \r\n\r\n                    <div class=\"content-body\">\r\n\r\n                        <div class=\"line-red-holder\">\r\n                            <h4 class=\"line-red\" style=\"margin-top: 5px;\">Details\r\n\r\n                            </h4>\r\n                        </div>\r\n\r\n                        <div class=\"event-description\">\r\n                            <span><p>COME AND SEE THE TRANS RAGE EXHIBITION!</p><p>4 VENUES. 40 DAYS. 70+ WORKS.</p><p>&nbsp;</p><p>Trans Rage Exhibition 2026</p><p>IDENTITY! Preview Event at Chats Palace, E9 6DF</p><p>18 NOV &nbsp;6PM-10PM</p><p>&nbsp;</p><p>The IDENTITY! Exhibition is in collaboration with Loud &amp; Queer!</p><p>&nbsp;</p><p>About Loud &amp; Queer:</p><p>Loud &amp; Queer is a vibrant online platform amplifying LGBTQ+ voices, celebrating queer creativity, and sharing powerful stories of LGBTQ+ individuals and their impact across the world.</p><p>Experience Loud &amp; Queer and the incewdible art and stories that come with it!</p><p>&nbsp;</p><p>Tickets are pay what you can!</p><p>There is a bar to buy drinks!</p><p>Come and experience Trans RAGE first hand!</p></span>\r\n                        </div>\r\n\r\n                        \r\n\r\n<div class=\"map-event\">\r\n\r\n    <div id=\"event_map\" class=\"event-map\">\r\n\r\n        <div class=\"map-container\">\r\n\r\n            <div class=\"col-lg-12 col-md-12 col-sm-12 col-xs-12\" style=\"padding-right: 0px; padding-left: 0px;\">\r\n\r\n                <div class=\"line-red-holder\">\r\n                    <h4 class=\"line-red\">Location\r\n    \r\n                    </h4>\r\n                </div>\r\n\r\n                <div class=\"map-padding website-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Chats+Palace%2c+42-44+Brooksbys+Walk%2c+London%2c+E9+6DF\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 200\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0428147&lat=51.55023&w=800&h=200&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n                <div class=\"map-padding mobile-map\">\r\n\r\n                    <a href=\"https://www.google.com/maps/search/?api=1&z=12&query=Chats+Palace%2c+42-44+Brooksbys+Walk%2c+London%2c+E9+6DF\" target=\"_blank\" onclick=\"return confirm('Would you like to open Google Maps?');\">\r\n\r\n                        <img src='data:image/svg+xml,%3Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 250\"%3E%3C/svg%3E' data-src=\"/Services/MapboxHandler.ashx?lng=-0.0428147&lat=51.55023&w=500&h=250&zoom=16\" class=\"lazy\" alt=\"Event location map\" />\r\n\r\n                    </a>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        <div class=\"col-lg-12 col-md-12 col-sm-12 