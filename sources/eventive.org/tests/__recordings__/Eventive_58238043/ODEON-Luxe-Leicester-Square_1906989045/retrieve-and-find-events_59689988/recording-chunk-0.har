ilm\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"ITHAQUA\",\"sort_key\":\"ITHAQUA\",\"description\":\"<p>Hammer returns with a gripping survival horror. Canada, the 1800s. American mercenary Cole Franklin is recruited as a hired gun at the remote outpost of Fort William struggling to survive the decline of the fur trade. With dwindling supplies, the keepers of the Fort blackmail Cole into leading a trading party to a nearby Indigenous village where they discover a massacre and encounter the remaining half-crazed inhabitants for the bloodshed. Though the trading party survives with minimal losses and returns to the Fort with a bonanza of food and furs, the supernatural force responsible for the carnage follows them back.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784578381795temp-1784578381752-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"110\",\"language\":\"ENGLISH\",\"country\":\"Canada\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Casey Walker\",\"cast\":\"Luke Hemsworth, Kevin Durand, Michael Pitt, Presley Allard\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.562Z\",\"updated_at\":\"2026-07-25T11:41:32.952Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T20:56:25.105Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_con