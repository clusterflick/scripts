ntervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0ad\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SYNTHESIZED\",\"sort_key\":\"SYNTHESIZED\",\"description\":\"<p>Computer repairman Martyn is also an adept musician and plays 1980s synth pop in the local bars to unappreciative audiences. He loves his wife Valkyrie as much as he does his computers. After some harrowing events disrupt his life, his marriage crumbles and he retreats to music for solace hoping it will calm his inner turmoil.  But music can summon the darkness as well as soothe the soul and his dark emotions lead to a violent murderous rage. Soon it’s not long before Martyn is hitting more than just the keys on his synthesizer keyboard.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784762980749temp-1784762980734-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"100\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"London\",\"rating\":\"18\"},\"credits\":{\"director\":\"Chris Green\",\"cast\":\"Thomas Turgoose, Kiran Landa, Sacha Parkinson, Chris Coghill, Hannah Traylan, Neil Bell & Yanick Ghanty. \"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.635Z\",\"updated_at\":\"2026-08-07T15:09:37.730Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-24T22:27:12.049Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use