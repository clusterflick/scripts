3,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e04c\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"DUKE MITCHELL\",\"sort_key\":\"DUKE MITCHELL\",\"description\":\"<p>The Duke Mitchell team are back once more to help celebrate the 27th edition of FrightFest with a film party that will bring together the festival audience, the festival guests, the festival organisers and anyone else you can think of in a loving in of cinema never before seen or experienced! Having spent the last 12 months looking for more bizarro, gonzo, eye-ball popping, mind melding content, THE DUKE MITCHELL FILM PARTY will be THE only place to be late night Saturday at FrightFest. If you want to lose your sanity in a maelstrom of celluloid tinged madness, expect trailers, trains, scary PSA's, delightful discoveries but most importantly, utter chaos. You have been warned.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784762898473temp-1784762898464-cover.jpg\",\"unballoted\":false,\"details\":{\"rating\":\"18\"},\"credits\":{},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e03a\",\"name\":\"Special Event\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.506Z\",\"updated_at\":\"2026-07-25T11:44:38.607Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-25T23:10:53.826Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\