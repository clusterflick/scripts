,\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":60,\"ticket_buckets\":[{\"id\":\"6a5ea70d46d929fd78f8b1e0\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":60,\"quantity_sold\":60,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0a7\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SPIDER ISLAND\",\"sort_key\":\"SPIDER ISLAND\",\"description\":\"<p>FrightFest welcomes back Christopher Smith, director of such noted past favourite choices as CREEP, BLACK DEATH, TRIANGLE and  SEVERANCE, with his latest comedy horror, an eight-legged nightmare creature feature. On a secluded private tropical island, The Oceania Pearl Hotel invites a group of famous social media influencers to its opening party to help solidify its place as the world’s most luxurious new resort destination. But beneath its glossy exterior, the hotel hides a nightmarish secret…the subterranean caves have been disturbed during construction and awakened a horde of deadly spiders, and they are ready to reclaim their island paradise.  </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579580040temp-1784579579825-cover.jpg\",\"unba