,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1784763228568temp-1784763228563-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1784763228771temp-1784763228761-avatar.jpg\"},\"custom_email_text\":\"<p>Your order and payment have been processed successfully, Thank you. Please see the details of your order below.&nbsp;&nbsp;&nbsp;</p><p>&nbsp;</p><p>Your pass guarantees your seat in the <strong>Main Screen</strong> for the duration of the day. Films in the Discovery Screens will require a separate ticket.&nbsp;&nbsp;</p><p>A limited number of free discovery film tickets will be available to pass-holders, free of charge closer to the festival.&nbsp;&nbsp;</p><p>&nbsp;</p><p>You can either print your ticket or simply download your confirmation and QR code to keep them handy for scanning upon arrival. You will be issued with a lanyard which should be worn at all times in the Cinema. Please also make a note of your seat number.&nbsp;&nbsp;</p><p>&nbsp;</p><p>Please Note: <strong>This is an over 18’s event</strong> and no children are allowed entry. All sales are final. FrightFest does not refund tickets.&nbsp;&nbsp;</p><p><br></p><p>Please take a moment to read the FrightFest Code of Conduct which can be found here: <a href=\\\"https://frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/&nbsp;&nbsp;&nbsp;</a></p><p><br></p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18.&nbsp;</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.&nbsp;</p><p>&nbsp;</p><p><a href=\\\"https://frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71a46d929fd78f8b2bb\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"COMPLIANCE\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 1\",\"venue\":{\"id\":\"6a53d8f172ba3569f93d018c\",\"name\":\"ODEON Luxe West End - Discovery Screen 1\",\"short_name\":\"Discovery Screen 1\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":166,\"color\":\"#99c6ef\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"18b3da24-c60c-ecd9-f718-b6803037dd63\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a64966ab8d304b716d49458\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a64966ab8d304b716d49459\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a64966ab8d304b716d4945a\"},{\"key\":\"4\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a64966ab8d304b716d4945b\"}]},\"is_dated\":true,\"start_time\":\"2026-08-31T09:30:00.000Z\",\"end_time\":\"2026-08-31T11:34:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":168,\"ticket_buckets\":[{\"id\":\"6a5ea71a46d929fd78f8b2be\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":119,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":109,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fbd126541c7db742acde0\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":23,\"quantity_scanned\":0,\"quantity_remaining\":16,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e03e\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"COMPLIANCE\",\"sort_key\":\"COMPLIANCE\",\"description\":\"<p>Sam Cornell, a young crisis manager for tech startup UVisit, has been tasked with cleaning up the fallout from a sexual assault scandal that threatens to undo a multi-million dollar deal. As she tries her best to contain the story while still supporting the uncooperative victim of a horrific crime, Sam unwittingly becomes a pawn in a deadly game set by a shadowy, all-powerful organization with vast resources. Trapped between a dark past and increasingly uncertain future, Sam has no choice but to take part in a wide-reaching, violent conspiracy to bring down UVisit and its investors.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577183062temp-1784577182891-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"104\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Kyle Mangione-Smith\",\"cast\":\"Megan Wilcox, Lindsey Normington, Charlie Wood, Neil Wachs\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.489Z\",\"updated_at\":\"2026-07-25T11:45:44.664Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:47:44.657Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70c46d929fd78f8b1d1\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"ODDITIES\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-31T09:45:00.000Z\",\"end_time\":\"2026-08-31T11:36:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":57,\"ticket_buckets\":[{\"id\":\"6a5ea70c46d929fd78f8b1d4\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":57,\"quantity_sold\":19,\"quantity_scanned\":0,\"quantity_remaining\":38,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e088\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"ODDITIES\",\"sort_key\":\"ODDITIES\",\"description\":\"<p>An expansion of director Tyler Savage’s 2023 award-winning short, a genre-bending horror thriller following the fates of two self-destructive best friends who accidentally kill their drug dealer. With no other recourse than to flee town, they  stop at a seemingly sleepy roadside antique shop run by genre royalty Adrienne Barbeau (star of THE FOG and ESCAPE FROM NEW YORK). But the duo quickly discover that the owner isn't quite as sweet as she seems when she offers to help them out. And soon it’s out of the frying pan and into the fire as events take the darkest of turns.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579176763temp-1784579176693-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"91\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Tyler Savage\",\"cast\":\"Adrienne Barbeau, Xander Berkeley, Lovie Simone, Lilimar.\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.582Z\",\"updated_at\":\"2026-07-25T11:40:27.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-07-25T10:39:06.935Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71946d929fd78f8b2af\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"BUNNY RABBIT\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 2\",\"venue\":{\"id\":\"6a53dc50f89ce2f3d85a453d\",\"name\":\"ODEON Luxe West End - Discovery Screen 2\",\"short_name\":\"Discovery Screen 2\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":74,\"color\":\"#ff8fdc\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"e2b15fdc-5d76-c3e8-6bee-9835d6ec4e83\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a5977c395de359ee0fb3d1d\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5977c395de359ee0fb3d1e\"},{\"key\":\"3\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a5977c395de359ee0fb3d1f\"},{\"key\":\"4\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a5977c395de359ee0fb3d20\"}]},\"is_dated\":true,\"start_time\":\"2026-08-31T09:50:00.000Z\",\"end_time\":\"2026-08-31T11:39:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":72,\"ticket_buckets\":[{\"id\":\"6a5ea71946d929fd78f8b2b2\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":31,\"quantity_scanned\":0,\"quantity_remaining\":15,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb2bed1e9f887d1b7f51a\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e037\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BUNNY RABBIT\",\"sort_key\":\"BUNNY RABBIT\",\"description\":\"<p>In  the aftermath of a climate-collapsed 2030 Australia, young Bunny roams the ruins of the post-apocalyptic world she never got to grow up in. Raised by her deceased father on old books and B-movies, she now lives alone in the shack they once shared. Supplies are scarce and food is running out. There is nothing left to hunt… Except other people! Inspired by MAD MAXploitation movies, this incredible feature debut by musician/advertising creative James Branson is a deeply engrossing character study brimming with visceral dread and unforgettable imagery and is the genre breakout of the year.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576915393temp-1784576915252-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"89\",\"language\":\"ENGLISH\",\"country\":\"Australia\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"James Branson\",\"cast\":\"Kate Wilson, Andy Golledge, Saxon Cook, Ontrei\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.481Z\",\"updated_at\":\"2026-07-25T11:46:00.906Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:17:18.238Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea8a1f4ac0bac8eff4878\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"SEOUL STATION\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"venue\":{\"id\":\"6a53d19a120a5c364136d42b\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"short_name\":\"Discovery Screen 3\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":41,\"color\":\"#8d95ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"faf60e2b-1976-4811-97c8-389557fc83d2\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649526f9d9051f6887b481\"},{\"key\":\"2\",\"label\":\"Passholder Tickets\",\"color\":\"#FBA700\",\"_id\":\"6a649526f9d9051f6887b482\"},{\"key\":\"3\",\"label\":\"Single Tickets\",\"color\":\"#F53F3F\",\"_id\":\"6a649526f9d9051f6887b483\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649526f9d9051f6887b484\"}]},\"is_dated\":true,\"start_time\":\"2026-08-31T10:00:00.000Z\",\"end_time\":\"2026-08-31T11:37:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":41,\"ticket_buckets\":[{\"id\":\"6a5ea8a1f4ac0bac8eff487b\",\"name\":\"Single Tickets\",\"price\":1499,\"unlimited\":false,\"quantity\":24,\"quantity_sold\":4,\"quantity_scanned\":0,\"quantity_remaining\":20,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f8e2ce7408878fda49a9b\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e096\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SEOUL STATION\",\"sort_key\":\"SEOUL STATION\",\"description\":\"<p>Go back to where it all began in the award-winning animated prequel to that made director Yeon Sang-ho famous. One day before events in that rip-roaring zombie shocker, amid busy passers-by, a homeless man with a bleeding neck-wound finds refuge in bustling Seoul Station. Ignored by everyone, the bitten vagabond slowly succumbs to his lethal trauma and dies, only to become a ravenous reanimated corpse, attacking and spreading his virulent disease. Is all hope lost? Are the walking dead the only monsters? A teenage runaway, her layabout boyfriend and desperate father will soon find out.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579406387temp-1784579406332-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2016\",\"language\":\"South Korean\",\"country\":\"South Korea\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"South Korean\",\"runtime\":\"92\"},\"credits\":{\"director\":\"Yeon Sang-ho\",\"cast\":\"Ryu Seung-ryong, Shim Eun-kyung, Lee Joon, Lee Sang-hee.\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e021\",\"name\":\"Retrospective\",\"color\":\"#ff8fdc\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"hidden\",\"created_at\":\"2026-07-20T12:56:25.602Z\",\"updated_at\":\"2026-07-25T11:39:26.039Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:03:45.983Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloti