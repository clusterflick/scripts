ue,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f90b3d1e9f887d1b4f7cb\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0ab\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SWEET VIOLENCE\",\"sort_key\":\"SWEET VIOLENCE\",\"description\":\"<p>In the tradition of such past FrightFest favourites as BIG BAD WOLVES and RABIES come the feature debut of the most exciting talent in South America. After cutting his teeth on the short film festival circuit with LA MUJER ROTA (2012), TOOTH FAIRY (2017) and LA HORA AZUL (2022), Jermias Segovia now bursts on to the international scene with  a gritty shocker. A family plans to murder their daughter’s killer after he is released from a twenty-year prison sentence. Still pleading innocence, the ex-convict tries to rebuild his life until the ghosts of the past return to haunt him  </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579629361temp-1784579629296-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"93\",\"language\":\"Uruguay\",\"country\":\"Uruguay\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Spanish\"},\"credits\":{\"director\":\"Jeremias Segovia\",\"cast\":\"Esteban Bigliardi, Javier Chavez