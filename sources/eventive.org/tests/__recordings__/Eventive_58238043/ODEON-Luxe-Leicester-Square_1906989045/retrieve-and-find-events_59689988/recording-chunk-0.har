andalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":40,\"ticket_buckets\":[{\"id\":\"6a5ea8a5f4ac0bac8eff48c3\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":23,\"quantity_sold\":23,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f9d83be81240a6e95bc06\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0bb\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE FLESH ITSELF\",\"sort_key\":\"FLESH ITSELF, THE\",\"description\":\"<p>Three deserter soldiers from the South American Paraguayan War in 1870  struggle to survive as they cross a desolate border region. Stumbling upon an isolated house inhabited only by a mysterious farmer and a silent young woman, it seems like they have found a safe haven. But the place soon reveals disturbing secrets and as night falls, the desperate soldiers realize they may have escaped the horrors of war only to step into something far more sinister. A psychological horror thriller in the tradition of THE INNOCENTS, in which shadows and layers of sounds suggest alternate truths and sensual apprehension. </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579839308temp-1784579839200-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"97\",\"language\":\"Brazil\",\"country\":\"Brazil\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Brazillian\"},\"credits\":{\"director\":\"Ian SBF\",\"cast\":\"Jorge Guerreiro, George Sauma, Pierri Baitelli, Jade Mascarenhas\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.657Z\",\"updated_at\":\"2026-07-25T11:36:46.284Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:51:53.737Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a635c1179950a537fa7f8b3\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"HOARDER\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 2\",\"venue\":{\"id\":\"6a53dc50f89ce2f3d85a453d\",\"name\":\"ODEON Luxe West End - Discovery Screen 2\",\"short_name\":\"Discovery Screen 2\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":74,\"color\":\"#ff8fdc\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"e2b15fdc-5d76-c3e8-6bee-9835d6ec4e83\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a5977c395de359ee0fb3d1d\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5977c395de359ee0fb3d1e\"},{\"key\":\"3\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a5977c395de359ee0fb3d1f\"},{\"key\":\"4\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a5977c395de359ee0fb3d20\"}]},\"is_dated\":true,\"start_time\":\"2026-08-29T17:10:00.000Z\",\"end_time\":\"2026-08-29T19:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":72,\"ticket_buckets\":[{\"id\":\"6a635cf1473691ee6a8290db\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":46,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a635cf1473691ee6a8290de\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5d4e4a0f0b954a322d6a7c\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"HOARDER\",\"sort_key\":\"HOARDER\",\"description\":\"<p>From James Owen, the director of FrightFest 2022 entry <em>Bite</em>, comes his latest horror thriller. Medical student Melissa Knowles and her reluctant colleague Eric are making routine house calls to administer flu vaccines. When they step into Fred Hunt's decaying, junk-crammed home, something immediately feels wrong. Fred seems like a harmless old recluse, but when Eric vanishes, Melissa's search pulls her deeper into the house's chaotic mess, revealing a labyrinth of tunnels carved through the piles of junk, twisting into suffocating darkness. And beneath it all, below the creaking floorboards, something stirs. Watching. Waiting.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784887097409temp-1784887097399-cover.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"premiere\":\"World\",\"rating\":\"18\",\"runtime\":\"90\",\"year\":\"2026\"},\"credits\":{\"cast\":\"Daisy Jelley, Paul Casar, David Sterne, Annabella Lanyon, Terry Bamberger.\",\"director\":\"James Owen\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-19T22:23:06.494Z\",\"updated_at\":\"2026-07-25T11:42:36.675Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:12:04.458Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\