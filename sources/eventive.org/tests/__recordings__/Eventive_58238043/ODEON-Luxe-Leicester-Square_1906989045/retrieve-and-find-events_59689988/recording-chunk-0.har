3,\"quantity_sold\":23,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f9ec0abfb2d0f1fce446e\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e056\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"FROGMAN RETURNS\",\"sort_key\":\"FROGMAN RETURNS\",\"description\":\"<p>FROGMAN became a cult sensation in 2023 following a trio of childhood friends trying to find the truth about the urban legend of the Frogman in the small Ohio town of Loveland. But as they got deeper into their investigation, they realized the hoax was anything but. Now director Anthony Cousins returns with the even wackier cryptid sequel because there’s unfinished business in Loveland and Dallas, Amy, and Frogman are back to settle the score. If you’re late to the FROGMAN party, time to hop aboard the amphibian shock express with another found footage curio delivering surreality in spades.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577579449temp-1784577579401-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"77\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\