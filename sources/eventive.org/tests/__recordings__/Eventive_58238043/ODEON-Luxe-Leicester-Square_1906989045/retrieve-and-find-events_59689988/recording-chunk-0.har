:true,\"virtual_intervals\":null},{\"id\":\"6a5fc273838b066bbaf5d27c\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0d9\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"ZIP WIRE\",\"sort_key\":\"ZIP WIRE\",\"description\":\"<p>Hang on tight! When Amy Watson was 13 years old, she watched her mother die from an incurable disease. Determined to find a cure, Amy becomes a dedicated researcher at a high-security pharmaceutical company. When her groundbreaking discovery is stolen and her partner murdered, she’s thrust into a deadly game of cat-and-mouse high in the Dolomite mountains. With no escape, her only salvation being across a treacherous aerial runway, Amy must outsmart the mysterious enemy, face her debilitating fear of heights and summon every ounce of courage to protect the world-changing research – and herself – before it’s too late.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784580197902temp-1784580197827-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"88\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Howard J. Ford\",\"cast\":\"MyAnna Buring, Joseph Millson, Saffron Burrows, Silvia Presente\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.698Z\",\"updated_at\":\"2026-07-25T11:33:13.146Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:45:38.450Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71c46d929fd78f8b2e5\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"MEAT KILLS\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 2\",\"venue\":{\"id\":\"6a53dc50f89ce2f3d85a453d\",\"name\":\"ODEON Luxe West End - Discovery Screen 2\",\"short_name\":\"Discovery Screen 2\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":74,\"color\":\"#ff8fdc\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"e2b15fdc-5d76-c3e8-6bee-9835d6ec4e83\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a5977c395de359ee0fb3d1d\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5977c395de359ee0fb3d1e\"},{\"key\":\"3\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a5977c395de359ee0fb3d1f\"},{\"key\":\"4\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a5977c395de359ee0fb3d20\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T10:20:00.000Z\",\"end_time\":\"2026-08-30T12:06:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":72,\"ticket_buckets\":[{\"id\":\"6a5ea71c46d929fd78f8b2e8\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":36,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb138e12a191ba904b287\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e07e\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"MEAT KILLS\",\"sort_key\":\"MEAT KILLS\",\"description\":\"<p>133 million pigs suffer in cruel European livestock farms. For Mirthe, this is unbearable. To prove herself worthy to ‘Animal Army’ a radical activist group led by the fearless Nasha, she secretly films the horrors of a local pig farm, earning her a mission to free the pigs, but when they return at night the cages are empty, the pigs already slaughtered. Enraged, Nasha shifts her focus to revenge, targeting and torturing the farmer’s children. As the farm becomes a bloody battleground, Mirthe must navigate between Nasha’s vengeance and the farmer’s fury if she wants to get out alive.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579027626temp-1784579027563-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"86\",\"language\":\"Netherlands\",\"country\":\"Netherlands\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Dutch\"},\"credits\":{\"director\":\"Martijn Smits\",\"cast\":\"Caro Derkx, Emma Josten, Sweder de Sitter, Sem Ben Yakar\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.569Z\",\"updated_at\":\"2026-07-25T11:41:04.974Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:13:18.389Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scene