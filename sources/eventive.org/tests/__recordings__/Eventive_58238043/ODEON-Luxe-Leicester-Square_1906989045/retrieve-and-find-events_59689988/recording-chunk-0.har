ing\":8,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fa103d473a286c011ad4a\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e062\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"GHOSTKEEPER\",\"sort_key\":\"GHOSTKEEPER\",\"description\":\"<p>Long-regarded as the Canadian answer to Stanley Kubrick’s THE SHINING, the  4K restoration of the Canuxploitation supernatural slasher classic based on the Wendigo legend. During a New Year’s Eve snowmobiling trip, three friends veer off the path to explore a private property. Stranded by a heavy snowfall, they stumble upon an abandoned hotel and seek refuge for the night. But before long, they meet a menacing woman who shares the building with her knife-wielding son and a mysterious creature who feeds on human flesh. Wintry isolation and madness rule in an essential entry in the New Year’s Eve horror canon.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577753180temp-1784577753117-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"1981\",\"runtime\":\"87\",\"language\":\"ENGLISH\",\"country\":\"Canada\",\"premiere\":\"Retrospective\",\"rating\":\"18\"},\"credits\":{\"direct