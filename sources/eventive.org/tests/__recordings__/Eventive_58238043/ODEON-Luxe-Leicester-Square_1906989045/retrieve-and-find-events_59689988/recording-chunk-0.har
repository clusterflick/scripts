ice\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":37,\"quantity_scanned\":0,\"quantity_remaining\":9,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb1c00e7279c0ecf97ae9\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e046\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"DO YOU WANT TO PLAY?\",\"sort_key\":\"DO YOU WANT TO PLAY?\",\"description\":\"<p>When American high school student Emily plays with an Ouija board at a party, she becomes the unwilling host for a sadistic killer’s soul who held Westlake in a grip of gruesome terror. Its cause is an Ouija app programmed by the charismatic Owen, a rich kid obsessed with the supernatural. Now Emily’s boyfriend Tommy must team up with Owen, his rival for her affections and ex-best friend - and a defrocked Jesuit priest turned occult expert - to perform a dangerous, ad-hoc exorcism before Emily is consumed by evil and the demonic infection spreads through the school.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577311801temp-1784577311584-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"94\",\"language\":\"ENGLISH\",\"country\"