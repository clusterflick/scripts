able_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e070\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"HYENA\",\"sort_key\":\"HYENA\",\"description\":\"<p>After a brutal breakup, Nicole finds herself drawn into a dangerous world of online sex work where money is the driving force for extreme fantasy. Under the influence of the charismatic Rachel, her life takes a darker turn when she becomes the target of a serial killer. Detectives Dan and Hugh discover Nicole and Rachel at a gruesome car crash scene, with two dead bodies.. One being Nicole's lover and the other an unidentified victim. Racing against time, the detectives must protect Nicole and unravel the mystery of the serial killer, while confronting their own demons.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784578081042temp-1784578080923-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"84\",\"language\":\"ENGLISH\",\"country\":\"Canada\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Matthew John Ninaber\",\"cast\":\"Storm Steenson, Kristen Kaster, Matthew John Rene Ninaber, Jeremy Benjamin Ninaber\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.552Z\",\"updated_at\":\"2026-07-25T11:42:08.774Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:56:13.560Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_defa