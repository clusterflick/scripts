e,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb7d74105535f7280b3d6\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e02a\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BINDING EVA\",\"sort_key\":\"BINDING EVA\",\"description\":\"<p>A stunning feature debut from award-winning short film director Conscian Morgan. Deep in the Forest of Dean, Felix, a small-time criminal on the run, returns again and again to the same moment of judgement, and the same impossible choice. Because Felix’s journey is towards a shocking realisation that love and self-sacrifice are everything while discovering what it means to care beyond himself. Shot with a minimal crew for long days and nights in the mud and rain, the double bass and cello score mirrors the unsettling melancholy regarding the cost of a redemption that comes too late.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576773816temp-1784576773758-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"76\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Conscian Morgan\",\"cast\":\"Ryan Ralph Gerrard, Catherine Deevy, Darcey Wood\"},\"expand