_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fbdb3359442e79f5811eb\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c1b401c5b05fa64df30\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0b7\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE BROOK\",\"sort_key\":\"BROOK, THE\",\"description\":\"<p>Moving to the village of his mother’s youth, art student Jacob discovers his grandad’s old video camera shows one hour into the past. In Elmbrook, a place steeped in strange folklore and whispered legends, the community believe their village is protected by a puma that watches over the “good.” But when one of the good locals mysteriously vanishes, Jacob and his friends, armed with the video camera, uncover clues that pull them deeper into Elmbrook’s bizarre secrets. Soon the search for answers spirals into a dangerous mystery as they uncover a vengeful serial killer with a connection to the past.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579794985temp-1784579794929-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"93\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Paul Stainthorpe\",\"cast\":\"Connor Lawson, Helen Chong, Kylie Ann Ford, Jill Dellow\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e02c\",\"name\":\"First 