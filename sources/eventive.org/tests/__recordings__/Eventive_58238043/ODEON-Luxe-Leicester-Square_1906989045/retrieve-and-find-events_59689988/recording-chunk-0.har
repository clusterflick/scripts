quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fa02b43263b8e2735088e\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e034\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BUDDY\",\"sort_key\":\"BUDDY\",\"description\":\"<p>Imagine your favorite cuddly kids’ TV character growing up - not getting any wiser, but turning into an axe-wielding nightmare! Meet Buddy, a bright orange unicorn, the cheerleading star of a children’s television show designed to teach kindness, sharing and simple morals. With its wholesome tone and sing-song vocals, it’s the perfect kiddie entertainment. Until Buddy snaps and transforms into a terrifying monster and young Freddy must escape from the show she’s trapped inside. Grotesque, funny and genuinely creepy, and definitely not for children; it’s trippy and disorienting, but also unexpectedly emotional, finding moments of sadness and tenderness amid the carnage.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576892926temp-1784576892831-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"95\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Casper Kelly\",\"cast\":\"Cristin Miloti, Topher Grace, Michael Shannon, Patton Oswalt\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.478Z\",\"updated_at\":\"2026-07-25T11:46:09.488Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:54:53.008Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea8a1f4ac0bac8eff487e\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"SWEET VIOLENCE\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"venue\":{\"id\":\"6a53d19a120a5c364136d42b\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"short_name\":\"Discovery Screen 3\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":41,\"color\":\"#8d95ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"faf60e2b-1976-4811-97c8-389557fc83d2\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649526f9d9051f6887b481\"},{\"key\":\"2\",\"label\":\"Passholder Tickets\",\"color\":\"#FBA700\",\"_id\":\"6a649526f9d9051f6887b482\"},{\"key\":\"3\",\"label\":\"Single Tickets\",\"color\":\"#F53F3F\",\"_id\":\"6a649526f9d9051f6887b483\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649526f9d9051f6887b484\"}]},\"is_dated\":true,