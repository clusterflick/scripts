de_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f865df05a88c4a9bddfd5\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e085\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"NIGHT AFTER NIGHT\",\"sort_key\":\"NIGHT AFTER NIGHT\",\"description\":\"<p>From Josh Lobo, the rising star director of I TRAPPED THE DEVIL, a unique sci-fi shocker inspired by J-Horror, acclaimed novelist Kobo Abe, sci-fi icon J.G. Ballard and the satirical black comedy OFFICE SPACE. The contrasting lives of two overnight security guards at a private university snap into focus as their grip on reality begins to unnervingly unravel after the appearance of a mysterious mute figure who returns each and every night without any explanation. Body Horror with a startling twist starring a host of genre luminaries and featuring a score by Simon Waskow of CUCKOO and LUZ fame.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579156128temp-1784579156058-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"88\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Josh Lobo\",\"cast\":\"Scott Poythress, Johnny Sibilly, AJ Bowen, Alexis Louder\"},\"expanded_credits\":[],\"ta