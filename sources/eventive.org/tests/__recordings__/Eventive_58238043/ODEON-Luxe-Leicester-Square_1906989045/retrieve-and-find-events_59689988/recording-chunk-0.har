ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70946d929fd78f8b1a7\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"GHOST IN THE CELL\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-29T22:10:00.000Z\",\"end_time\":\"2026-08-30T00:11:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":57,\"ticket_buckets\":[{\"id\":\"6a5ea70946d929fd78f8b1aa\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":57,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":18,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e060\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"GHOST IN THE CELL\",\"sort_key\":\"GHOST IN THE CELL\",\"description\":\"<p>A high-security prison run by a tyrannical warden is rocked by a spate of gruesome murders with bodies put on morbidly spectacular display. Who is the perpetrator, and who will be next? Between spontaneous dance-offs, sudden prayers, political statements, ecological issues and balletic fistfights, the inmates must overcome internal gang rivalry to decipher the motive behind the killings and pacify their otherworldly enemy. A sensation at the 2026 Berlin Film Festival, Indonesian genre wizard Joko Anwar crafts a gleefully grotesque yet disarming horror-comedy that balances levity with graphic brutality for the year’s most irreverent genre fireworks.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577727200temp-1784577727009-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"106\",\"language\":\"Indonesia\",\"country\":\"Indonesia\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Indonesian\"},\"credits\":{\"director\":\"Joko Anwar\",\"cast\":\"Abimana Aryasatya, Endy Arfian, Bront Palarae, Morgan Oey\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.531Z\",\"updated_at\":\"2026-07-25T11:43:22.707Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-07-25T10:30:46.935Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a557021faa71501b5d01860\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"Day Pass - Sunday £60\",\"description\":\"<p>Please reserve your Main Screen Thursday seat here! Once you have selected your seat it is yours for the entire day, so please keep a note of your seat number. You'll find your seat number in your confirmation email or by visiting <a href=\\\"https://frightfest.eventive.org/tickets\\\" target=\\\"_blank\\\">My Tickets</a> and clicking \\\"Show barcode\\\" next to your Pass.&nbsp;</p><p>&nbsp;</p><p>Your pass only guarantees your seat in the <strong>Main Screen</strong>. For discovery screen films, you will need a separate ticket. There will be a number of free discovery tickets made available to passholders on Saturday 22nd August 2026 at 12pm.&nbsp;</p><p>&nbsp;</p><p>Closer to the time you will be sent further details and a 'discovery ticket' pass which will allow you to log in and order discovery tickets.&nbsp;</p><p>For any queries, please email <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p><p>&nbsp;</p><p>For more information on accessibility please see the dedicate page under the 'Menu' Header.&nbsp;</p><p>&nbsp;</p><p><strong>PLEASE NOTE THIS IS AN OVER 18'S EVENT ONLY</strong>. Valid ID may be required. All ticket sales are final and we do not offer refunds.&nbsp;</p>\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Sunday Day Pass\",\"venue\":{\"id\":\"6a53bf2b512145cd2b4709ee\",\"name\":\"ODEON Luxe Leicester Square - Sunday Day Pass\",\"short_name\":\"Main Screen - Sunday Day Pass\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":108,\"color\":\"#9207f9\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"6e65c988-2b22-f78a-578b-746f210ad105\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a73a58a362c2ccf99c5a964\"},{\"key\":\"2\",\"label\":\"Day Pass\",\"color\":\"#00A5D6\",\"_id\":\"6a73a58a362c2ccf99c5a965\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T09:00:00.000Z\",\"end_time\":\"2026-08-30T22:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"tickets_button_label\":\"Choose your seat\",\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":115,\"ticket_buckets\":[{\"id\":\"6a59772a9a0577e2b8c08569\",\"name\":\"Day Pass\",\"price\":6000,\"unlimited\":false,\"quantity\":107,\"quantity_sold\":107,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[],\"updated_at\":\"2026-08-15T20:48:28.514Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1784763250498temp-1784763250493-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1784763250707temp-1784763250699-avatar.jpg\"},\"custom_email_text\":\"<p>Your order and payment have been processed successfully, Thank you. Please see the details of your order below.&nbsp;&nbsp;&nbsp;</p><p>&nbsp;</p><p>Your pass guarantees your seat in the <strong>Main Screen</strong> for the duration of the day. Films in the Discovery Screens will require a separate ticket.&nbsp;&nbsp;</p><p>A limited number of free discovery film tickets will be available to pass-holders, free of charge closer to the festival.&nbsp;&nbsp;</p><p>&nbsp;</p><p>You can either print your ticket or simply download your confirmation and QR code to keep them handy for scanning upon arrival. You will be issued with a lanyard which should be worn at all times in the Cinema. Please also make a note of your seat number.&nbsp;&nbsp;</p><p>&nbsp;</p><p>Please Note: <strong>This is an over 18’s event</strong> and no children are allowed entry. All sales are final. FrightFest does not refund tickets.&nbsp;&nbsp;</p><p><br></p><p>Please take a moment to read the FrightFest Code of Conduct which can be found here: <a href=\\\"https://frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/&nbsp;&nbsp;&nbsp;</a></p><p><br></p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18.&nbsp;</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.&nbsp;</p><p>&nbsp;</p><p><a href=\\\"https://frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea89cf4ac0bac8eff4830\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"REMANENCE: A VOLTAGE COSMIC HORROR\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"venue\":{\"id\":\"6a53d19a120a5c364136d42b\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"short_name\":\"Discovery Screen 3\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":41,\"color\":\"#8d95ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"faf60e2b-1976-4811-97c8-389557fc83d2\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649526f9d9051f6887b481\"},{\"key\":\"2\",\"label\":\"Passholder Tickets\",\"color\":\"#FBA700\",\"_id\":\"6a649526f9d9051f6887b482\"},{\"key\":\"3\",\"label\":\"Single Tickets\",\"color\":\"#F53F3F\",\"_id\":\"6a649526f9d9051f6887b483\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649526f9d9051f6887b484\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T09:45:00.000Z\",\"end_time\":\"2026-08-30T11:25:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":41,\"ticket_buckets\":[{\"id\":\"6a5ea89cf4ac0bac8eff4833\",\"name\":\"Single Tickets\",\"price\":1499,\"unlimited\":false,\"quantity\":24,\"quantity_sold\":11,\"quantity_scanned\":0,\"quantity_remaining\":13,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f8fe9e7408878fda5740e\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e090\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"REMANENCE: A VOLTAGE COSMIC HORROR\",\"sort_key\":\"REMANENCE: A VOLTAGE COSMIC HORROR\",\"description\":\"<p>A high voltage cosmic tale from Kapel Furman, director of the 2020 FrightFest attraction SKULL: THE MASK. Two paramedics in Novo Hamburgo stumble upon treasure in an old basement. They accidentally open a dimensional portal, unleashing The Engineer, a creature who can travel between multiverses, now determined to reclaim its gold at any cost. Influenced by classic monster movies from the Universal  catalogue and Hammer Studios, but mixing it with the visual impact of comic books and using a dynamic camera style, Furman describes REMANENCE as a combo of Steven Spielberg’s ‘Amazing Stories’ and Martin Scorsese’s BRINGING OUT THE DEAD.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784640459709temp-1784640459599-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"80\",\"language\":\"Brazil\",\"country\":\"Brazil\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Brazillian\"},\"credits\":{\"director\":\"Kapel Furman\",\"cast\":\"Ricardo Gelli, Ricardo Oliveira, Clarissa Kiste, Cecilia Guedes\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.595Z\",\"updated_at\":\"2026-07-25T11:39:52.609Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:01:45.587Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea8a7f4ac0bac8eff48d8\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"FROGMAN\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"venue\":{\"id\":\"6a4d7692d104ae98644c1bbc\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"short_name\":\"Discovery Screen 4\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":40,\"color\":\"#c8cdd0\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"6b3f0bd6-f219-b12b-c112-ce0741445a23\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649530cdfcbae85ee3f677\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a649530cdfcbae85ee3f678\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a649530cdfcbae85ee3f679\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649530cdfcbae85ee3f67a\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T10:00:00.000Z\",\"end_time\":\"2026-08-30T11:41:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":40,\"ticket_buckets\":[{\"id\":\"6a5ea8a7f4ac0bac8eff48db\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":23,\"quantity_sold\":17,\"quantity_scanned\":0,\"quantity_remaining\":6,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f9e71ad6592364ddfd367\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e054\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"FROGMAN\",\"sort_key\":\"FROGMAN\",\"description\":\"<p>Return to where the FROGMAN urban legend started. Three friends go back to one of their home towns, Loveland, many years after the mythic creature was first spotted. Since then the town has commercialised and cashed-in on the cryptid craze, but where there’s mysterious croaks is there a hoax? Adrift researcher Dallas is desperate to prove what he once saw as a child was real and so begins his own last chance saloon journey of self discovery. A slow-burn, body horror that reviewers called a fresh take on the found footage genre and created a whole fan base. </p>\",\"cover_image\":\"https://static-a.eventive.org/1784577554617temp-1784577554560-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2023\",\"runtime\":\"81\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"Retrospective\",\"rating\":\"18\"},\"credits\":{\"director\":\"Anthony Cousins\",\"cast\":\"Nathan Tymoshuk, Chelsey Grant, Benny Barrett, Ali Daniels\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e021\",\"name\":\"Retrospective\",\"color\":\"#ff8fdc\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.517Z\",\"updated_at\":\"2026-07-25T11:44:02.494Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:52:43.936Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70d46d929fd78f8b1e9\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"THE LAST TEMPTATION OF BECKY\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T10:00:00.000Z\",\"end_time\":\"2026-08-30T11:49:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":57,\"ticket_buckets\":[{\"id\":\"6a5ea70d46d929fd78f8b1ec\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":57,\"quantity_sold\":55,\"quantity_scanned\":0,\"quantity_remaining\":2,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0c1\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE LAST TEMPTATION OF BECKY\",\"sort_key\":\"LAST TEMPTATION OF BECKY, THE\",\"description\":\"<p>The third in the breakout indie action-thriller franchise starring Lulu Wilson as Becky Hooper, a teenage girl who repeatedly winds up in the path of violent criminals, yet turns out to be far more dangerous herself. After first confronting escaped neo-Nazi convicts, then facing far-right extremists, Becky is now a CIA field agent going undercover in Poland to infiltrate a family running an inn at The Wolf's Lair, one of Hitler's WWII bunkers, planning to spark the Fourth Reich. In the biggest, bloodiest and most unhinged installment yet, Becky must take matters in her own capable hands to stop them.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579887131temp-1784579886998-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"89\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Jenn Wexler\",\"cast\":\"Lulu Wilson, Neil Patrick Harris, Kate Siegel, James Urbaniak\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.667Z\",\"updated_at\":\"2026-07-25T11:36:21.570Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-07-25T10:31:35.039Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71746d929fd78f8b291\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"ZIP WIRE\",\"description\":\"\",\"sh