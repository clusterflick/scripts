":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e33008539818467faadc\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6aa7d5e53dcc4c2b42caa9cb\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Carry with Both Hands\",\"sort_key\":\"Carry with Both Hands\",\"description\":\"<p>Leah is caught in the middle of her family's divided view points on politics, culture and religious identity, and the ever-changing boundaries of acceptance.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384500328temp-1789384499778-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384227538temp-1789384226485-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384226256temp-1789384225349-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"runtime\":\"15\",\"year\":\"2026\"},\"credits\":{\"director\":\"Tim Rogg\",\"producer\":\"Andrew St Maur\",\"screenwriter\":\"Paz Kaiba\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-09-14T11:09:25.161Z\",\"updated_at\":\"2026-09-14T11:14:59.776Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc