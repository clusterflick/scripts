uantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b57\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Safe House\",\"sort_key\":\"Safe House, The\",\"description\":\"<p>This stylish and quirky Parisien family drama, from veteran director Lionel Baier, competed for the prestigious Golden Bear award at the Berlinale. Student uprisings rock the streets of Paris during May 1968. A boy (Ethan Chimienti) is sent to stay with his grandparents (Dominique Reymond and Michel Blanc), in their labyrinthine apartment, as his parents participate in the protests. Also staying at the apartment are the boy’s two uncles (William Lebghil and Aurélien Gabrielli), as well as his Jewish great-grandmother (Liliane Rovère). As the protests escalate, the boy discovers a hidden saferoom beneath the floorboards. When an unexpected visitor seeks refuge, the family’s long-hidden secrets are revealed.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788432089836temp-1788432089688-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788432098615temp-1788432098373-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788432098142temp-1788432097918-still.jpg\",\"trailer_url\":\"https://youtu.be/r4lzk2upmzs\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"92\",\"language\":\"French\",\"country\":\"Switzerland, France, Luxembourg\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Lionel Baier\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.715Z\",\"updated_at\":\"2026-09-03T10:41:37.917Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b2c\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Maurice Dancing\",\"sort_key\":\"Maurice Dancing\",\"description\":\"<p>A delightful musical animation about the long life of Holocaust survivor, Maurice Peltz, who arrived in the UK as a refugee, in 1939, and went on to become an accomplished ballroom dancer: even dancing with the King! Set to the tune of <em>In The Mood</em>, composed by Joe Garland, and performed here by Joe Loss &amp; His Band. </p><p><br></p><p>November 5th, 2026, marks Maurice's 100th birthday.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789059362504temp-1789059362364-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789059402951temp-1789059402727-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789059402514temp-1789059402295-still.jpg\",\"trailer_url\":\"https://youtu.be/QZ-KoapkCV4\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"subtitle_language\":\"English\",\"year\":\"2026\",\"runtime\":\"4\"},\"credits\":{\"director\":\"Zoom Rockman\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785279\",\"name\":\"Animation\",\"color\":\"#62feb6\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.642Z\",\"updated_at\":\"2026-09-14T11:19:55.671Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:46:49.232Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708ea415f2c5e1404d935\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"DOC DAY: We Met at Grossinger's\",\"description\":\"<h2>PART OF DOC DAY AT CURZON BLOOMSBURY</h2><h3>+ Pre-Feature Short <em>Oslo Court</em></h3><h4>This film will be shown in Screen 5 (The Renoir)</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £20.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>For all enquiries relating to your booking, please contact Curzon directly.</p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Curzon Bloomsbury\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ea\",\"name\":\"Curzon Bloomsbury\",\"short_name\":\"Curzon Bloomsbury\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838.\\nFor Customer Service queries, call: 01233 555644.\",\"address\":\"The Brunswick Centre, London WC1N 1AW\",\"default_capacity\":null,\"color\":\"#8d95ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-15T11:20:00.000Z\",\"end_time\":\"2026-11-15T13:20:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c525bba412e1e2417d2\",\"name\":\"+ Pre-Feature Short\",\"color\":\"#3697ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/BLO1-113620/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b43\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"We Met at Grossinger's\",\"sort_key\":\"We Met at Grossinger's\",\"description\":\"<p>Grossinger’s was the fabled Jewish holiday resort in the Catskill Mountains, New York State — the so-called ‘Borscht Belt’. It was the inspiration for the setting of the all-time classic film, Dirty Dancing. In its golden era in the 50s and 60s, it welcomed luminaries like First Lady, Eleanor Roosevelt, legendary comedian, Jerry Lewis, baseball star, Jackie Robinson, and Hollywood royalty, Elizabeth Taylor, through its hallowed doors. We are taken on a journey through the resort's full chronological history: from its initial founding by the Grossinger family, up to the present-day plans to redevelop the site.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931967574temp-1787931967513-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931966499temp-1787931966454-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=oB86n-qIaII\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"104\",\"language\":\"English\",\"country\":\"USA\"},\"credits\":{\"director\":\"Paula Eiselt\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b44\",\"name\":\"International Documentary Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.686Z\",\"updated_at\":\"2026-09-03T10:09:05.775Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":