color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b08\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Dead Parent Club\",\"sort_key\":\"Dead Parent Club, The\",\"description\":\"<p>Ollie’s dad has unexpectedly died, and neither is ready to let go. With an unlikely sidekick, Ollie embarks on a chaotic, thoughtful quest for peace.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384640832temp-1789384640425-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384641823temp-1789384641080-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384635564temp-1789384634882-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Mark Fleischmann\",\"producer\":\"Jesse Romain\",\"screenwriter\":\"Mark Fleischmann\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.576Z\",\"updated_at\":\"2026-09-14T11:17:20.423Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.569Z\",\"updated_at\":\"2026-08-28T15:45:16.569Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Jack Levy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.572Z\",\"updated_at\":\"2026-09-09T11:18:46.060Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-12T16:29:12.728Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1791216134562temp-1791216134446-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1791216134901temp-1791216134816-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4b08\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: Liverpool\",\"description\":\"<h4>This film will be shown in Screen 2</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £15.30</strong></p><p><strong>Students / Over 60s (with valid ID): £10.99</strong></p><p><strong>Universal Credit: £6.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><span style=\\\"color: rgb(44, 54, 58);\\\">In amongst these brand new cinematic gems, we're offering a much-requested second Liverpudlian outing of the wonderful short documentary, </span><em style=\\\"color: rgb(44, 54, 58);\\\">Primordial Chicken Soup</em><span style=\\\"color: rgb(44, 54, 58);\\\">, which features an extraordinarily effervescent group of Jewish women from Liverpool.</span></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">﻿This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"FACT Picturehouse Liverpool\",\"venue\":{\"id\":\"6a3000f01f63771bc47851f4\",\"name\":\"FACT Picturehouse Liverpool\",\"short_name\":\"FACT Picturehouse Liverpool\",\"description\":\"For all booking enquiries, please call the venue directly: 0151 707 4444\",\"address\":\"88 Wood St, Liverpool L1 4DQ\",\"default_capacity\":null,\"color\":\"#cef2ec\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-30T18:30:00.000Z\",\"end_time\":\"2026-11-30T20:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/013-67660/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6aa2debf0cc7efb13db3af41\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Primordial Chicken Soup\",\"sort_key\":\"Primordial Chicken Soup\",\"description\":\"<p>Friendship that lasts a lifetime — <em>Primordial Chicken Soup</em> explores the deep connection formed between eight Scouse Jewish women who first met over fifty-five years ago.</p>\",\"cover_image\":\"https://static-a.eventive.org/17573402145418ee5b38afca480808254.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/1757603415947461188370caaf75cfe7a.jpg?w=300\",\"still_image\":\"https://static-a.eventive.org/1757340225010c85d62076adb23f0f9df.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"genre\":\"Short, Documentary\",\"language\":\"English\",\"runtime\":\"5\",\"year\":\"2025\"},\"credits\":{\"director\":\"Barney Pell Scholes, Daisy Abboudi\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"697a276a2dc50f0e1d447a1c\",\"type\":\"vod\",\"label\":\"Primoridal 1920.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"408738a7-7952-4ba7-b656-d281562b7888\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":371242,\"file_size\":565679529,\"created_at\":\"2026-01-28T15:12:42.615Z\",\"updated_at\":\"2026-01-29T13:07:45.103Z\",\"platform\":\"ev_next\",\"caption_tracks\":[{\"title\":\"English\",\"url\":\"https://storage.googleapis.com/eventive-static/9b0eca99f495fcde46bef6b0e335724e.vtt\"}]},\"created_at\":\"2026-09-10T16:45:51.367Z\",\"updated_at\":\"2026-09-15T09:46:19.508Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b