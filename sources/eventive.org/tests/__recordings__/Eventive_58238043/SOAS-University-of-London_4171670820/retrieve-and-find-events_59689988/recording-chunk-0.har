ww.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70646d929fd78f8b183\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"BIG BABY\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-27T22:00:00.000Z\",\"end_time\":\"2026-08-27T23:58:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":60,\"ticket_buckets\":[{\"id\":\"6a5ea70646d929fd78f8b186\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":60,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":42,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e028\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BIG BABY\",\"sort_key\":\"BIG BABY\",\"description\":\"<p>From the team behind LITTLE BITES and produced by Cher, a nightmare involving a maniac killer in a baby mask inspires horror screenwriter Adam Lewis's new script. As more nightmares, visions, and real life terror begin to challenge Adam's sanity, he finds himself in a desperate struggle to control his writing, his reality, and who will be Big Baby's next victim. Director Spider One turns the slasher genre inside out to craft a meta script about creation and those creations coming to life, a terrifying premise about an impossible task with deadly consequences.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576746295temp-1784576746212-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"103\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Spider One\",\"cast\":\"Krsy Fox, Brandon Scott, Adam Marcinowski, Catherine Corcoran.\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.465Z\",\"updated_at\":\"2026-07-25T11:46:51.943Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T20:51:09.438Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a556fd645099d8e56707885\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"Day Pass - Friday £72\",\"description\":\"<p>Please reserve your Main Screen Thursday seat here! Once you have selected your seat it is yours for the entire day, so please keep a note of your seat number. You'll find your seat number in your confirmation email or by visiting <a href=\\\"https://frightfest.eventive.org/tickets\\\" target=\\\"_blank\\\">My Tickets</a> and clicking \\\"Show barcode\\\" next to your Pass.&nbsp;</p><p>&nbsp;</p><p>Your pass only guarantees your seat in the <strong>Main Screen</strong>. For discovery screen films, you will need a separate ticket. There will be a number of free discovery tickets made available to passholders on Saturday 22nd August 2026 at 12pm.&nbsp;</p><p>&nbsp;</p><p>Closer to the time you will be sent further details and a 'discovery ticket' pass which will allow you to log in and order discovery tickets.&nbsp;</p><p>For any queries, please email <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p><p>&nbsp;</p><p>For more information on accessibility please see the dedicate page under the 'Menu' Header.&nbsp;</p><p>&nbsp;</p><p><strong>PLEASE NOTE THIS IS AN OVER 18'S EVENT ONLY</strong>. Valid ID may be required. All ticket sales are final and we do not offer refunds.&nbsp;</p>\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Friday Day Pass\",\"venue\":{\"id\":\"6a53d452dfa7c468b313344f\",\"name\":\"ODEON Luxe Leicester Square - Friday Day Pass\",\"short_name\":\"Main Screen - Friday Day Pass\",\"description\":\"\",\"address\":\"\",\"default_capacity\":108,\"color\":\"#9207f9\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"d030d83c-c9b4-4c72-7ce2-346992279faa\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5fc1414105535f72844d74\"},{\"key\":\"2\",\"label\":\"Day Pass\",\"color\":\"#00A5D6\",\"_id\":\"6a5fc1414105535f72844d75\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T09:00:00.000Z\",\"end_time\":\"2026-08-28T22:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"tickets_button_label\":\"Choose your seat\",\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":114,\"ticket_buckets\":[{\"id\":\"6a59742723da6d17c87adb1f\",\"name\":\"Day Pass\",\"price\":7200,\"unlimited\":false,\"quantity\":112,\"quantity_sold\":107,\"quantity_scanned\":0,\"quantity_remaining\":5,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[],\"updated_at\":\"2026-08-15T20:46:10.375Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1784763189562temp-1784763189556-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1784763189767temp-1784763189756-avatar.jpg\"},\"custom_email_text\":\"<p>Your order and payment have been processed successfully, Thank you. Please see the details of your order below.&nbsp;&nbsp;&nbsp;</p><p>&nbsp;</p><p>Your pass guarantees your seat in the <strong>Main Screen</strong> for the duration of the day. Films in the Discovery Screens will require a separate ticket.&nbsp;&nbsp;</p><p>A limited number of free discovery film tickets will be available to pass-holders, free of charge closer to the festival.&nbsp;&nbsp;</p><p>&nbsp;</p><p>You can either print your ticket or simply download your confirmation and QR code to keep them handy for scanning upon arrival. You will be issued with a lanyard which should be worn at all times in the Cinema. Please also make a note of your seat number.&nbsp;&nbsp;</p><p>&nbsp;</p><p>Please Note: <strong>This is an over 18’s event</strong> and no children are allowed entry. All sales are final. FrightFest does not refund tickets.&nbsp;&nbsp;</p><p><br></p><p>Please take a moment to read the FrightFest Code of Conduct which can be found here: <a href=\\\"https://frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/&nbsp;&nbsp;&nbsp;</a></p><p><br></p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18.&nbsp;</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.&nbsp;</p><p>&nbsp;</p><p><a href=\\\"https://frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70b46d929fd78f8b1bf\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"IMPOSTERS\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T09:30:00.000Z\",\"end_time\":\"2026-08-28T11:32:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":60,\"ticket_buckets\":[{\"id\":\"6a5ea70b46d929fd78f8b1c2\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":60,\"quantity_sold\":21,\"quantity_scanned\":0,\"quantity_remaining\":39,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e072\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"IMPOSTERS\",\"sort_key\":\"IMPOSTERS\",\"description\":\"<p>Paul and Marie’s infant son Theo disappears during a housewarming party. One fateful night, a stranger knocks at their door telling the grieving parents about a cave that can return their child to them. While Paul is sceptical, Marie heads to the cave solo. She returns, covered in blood and holding a baby, who appears to be Theo. A shocked Paul fails to get any answers from her since she can’t seem to remember what happened. He soon begins to realize the baby his wife brought back may not be their son and that she may also know it.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784578103737temp-1784578103637-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"102\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"English\",\"rating\":\"18\"},\"credits\":{\"director\":\"Caleb Phillips\",\"cast\":\"Jessica Rothe, Charlie Barnett, Yul Vazquez, Bates Wilden\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.554Z\",\"updated_at\":\"2026-07-25T11:42:00.452Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T20:51:58.229Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71a46d929fd78f8b2c1\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"DEAD EYES\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 2\",\"venue\":{\"id\":\"6a53dc50f89ce2f3d85a453d\",\"name\":\"ODEON Luxe West End - Discovery Screen 2\",\"short_name\":\"Discovery Screen 2\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":74,\"color\":\"#ff8fdc\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"e2b15fdc-5d76-c3e8-6bee-9835d6ec4e83\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a5977c395de359ee0fb3d1d\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5977c395de359ee0fb3d1e\"},{\"key\":\"3\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a5977c395de359ee0fb3d1f\"},{\"key\":\"4\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a5977c395de359ee0fb3d20\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T09:45:00.000Z\",\"end_time\":\"2026-08-28T11:52:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":72,\"ticket_buckets\":[{\"id\":\"6a5ea71a46d929fd78f8b2c4\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":31,\"quantity_scanned\":0,\"quantity_remaining\":15,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fae2c31ef9492b0dc720e\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e042\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"DEAD EYES\",\"sort_key\":\"DEAD EYES\",\"description\":\"<p>A completely first person film. Sean and his fiancée Grace venture into a remote forest with two friends to search for Sean’s missing father, Paul, who vanished after the death of his young daughter, Lilly. Returning to the place of tragedy, Sean is forced to face his inner demons when they uncover Paul’s horrifying secret... he’s been cloning Lilly in a desperate attempt to bring her back. The forest now crawls with cannibalistic mutant girls, each battling to prove their identity as the real Lilly,  as Sean and Grace grapple with unsettling questions about life, death, and rebirth.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577255606temp-1784577255564-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"82\",\"language\":\"ENGLISH\",\"country\":\"Australia\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Richard Williams\",\"cast\":\"Ana Thu Nguyen, Charles Cottier, Mischa Heywood, Stephen Phillips\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.494Z\",\"updated_at\":\"2026-07-25T11:45:20.718Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:08:46.960Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71546d929fd78f8b26d\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"TERRESTRIAL\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 1\",\"venue\":{\"id\":\"6a53d8f172ba3569f93d018c\",\"name\":\"ODEON Luxe West End - Discovery Screen 1\",\"short_name\":\"Discovery Screen 1\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":166,\"color\":\"#99c6ef\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"18b3da24-c60c-ecd9-f718-b6803037dd63\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a64966ab8d304b716d49458\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a64966ab8d304b716d49459\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a64966ab8d304b716d4945a\"},{\"key\":\"4\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a64966ab8d304b716d4945b\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T09:45:00.000Z\",\"end_time\":\"2026-08-28T11:35:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":166,\"ticket_buckets\":[{\"id\":\"6a5ea71546d929fd78f8b270\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":119,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":80,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb87f4105535f7281031c\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"max_quantity_per_person\":1,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0af\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"TERRESTRIAL\",\"sort_key\":\"TERRESTRIAL\",\"description\":\"<p>Four college friends hold a weekend reunion at a beautiful and incredibly expensive Los Angeles mansion belonging to Allen, a rising science fiction star author. Painting his life as idyllic, Allen’s envious and then suspicious friends soon start finding cracks in his supposedly fabulous existence, career and lifestyle.  As Allen’s story slowly unravels, strange events begin to blur the lines between reality and imagination as his three friends soon learn they are involved in something they never ever signed up for. An unusual thriller with GALAXY QUEST style elements from HOT TUB TIME MACHINE director Steve Pink.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579695724temp-1784579695605-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"90\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Steve Pink\",\"cast\":\"Jermaine Fowler, Pauline Chalamet, Edy Modica, Brendan Hunt\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.638Z\",\"updated_at\":\"2026-07-25T11:37:35.583Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:40:32.731Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea89cf4ac0bac8eff4836\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"SALMOKJI: WHISPERING WATER\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"venue\":{\"id\":\"6a53d19a120a5c364136d42b\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"short_name\":\"Discovery Screen 3\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":41,\"color\":\"#8d95ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"faf60e2b-1976-4811-97c8-389557fc83d2\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649526f9d9051f6887b481\"},{\"key\":\"2\",\"label\":\"Passholder Tickets\",\"color\":\"#FBA700\",\"_id\":\"6a649526f9d9051f6887b482\"},{\"key\":\"3\",\"label\":\"Single Tickets\",\"color\":\"#F53F3F\",\"_id\":\"6a649526f9d9051f6887b483\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649526f9d9051f6887b484\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T10:00:00.000Z\",\"end_time\":\"2026-08-28T11:40:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":false,\"unlimited\":false,\"quantity\":41,\"ticket_buckets\":[{\"id\":\"6a5ea89cf4ac0bac8eff4839\",\"name\":\"Single Tickets\",\"price\":1499,\"unlimited\":false,\"quantity\":24,\"quantity_sold\":24,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f860f588fcd77378d133c\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e094\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SALMOKJI: WHISPERING WATER\",\"sort_key\":\"SALMOKJI: WHISPERING WATER\",\"description\":\"<p>The highest-grossing Korean horror film of all time arrives at FrightFest. A road-view filming crew is sent to a remote reservoir to reshoot footage previously deemed unusable due to unexplained visual distortions. Led by Su-in, the team documents the surrounding roads and landscape, but during a routine review of the recordings, they notice unfamiliar figures and unsettling details that none of them recall encountering while filming. Investigating further, they learn the reservoir is linked to a past crime and that something dreadful is rumoured to lurk beneath the surface. For once you enter Salmokji, you may never get out alive… </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579378177temp-1784579378153-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"95\",\"language\":\"South Korea\",\"country\":\"South Korea\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"South Korean\"},\"credits\":{\"director\":\"Lee Sang-min\",\"cast\":\"Kim Hye-yoon, Lee Jong-won.\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.600Z\",\"updated_at\":\"2026-07-25T11:39:34.783Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:56:59.528Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please con