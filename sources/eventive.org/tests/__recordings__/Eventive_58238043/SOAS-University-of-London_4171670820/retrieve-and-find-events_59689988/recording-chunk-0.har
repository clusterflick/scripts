",\"price\":1700,\"unlimited\":true,\"quantity_sold\":12,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e262474b7d224985a947\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e262474b7d224985a94b\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b4b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"To Kill a Nazi\",\"sort_key\":\"To Kill a Nazi\",\"description\":\"<p>Fresh from its World Premiere at the Dances With Films festival in LA, the true story of Michel Cojot’s life unfolds with all the tension and intrigue of a John Le Carre spy thriller. Born to Jewish parents in France, Cojot's father was arrested, and deported to Auschwitz during World War Two. His mother, who was a convert to Judaism, disguised herself and Michel as Catholics, to protect them. After the war ended, Michel learned that notorious Nazi, Klaus Barbie, had signed his father’s arrest warrant. Knowing that Barbie had successfully escaped justice for his war crimes by fleeing to Argentina, Michel planned a mission of revenge. Unbeknownst to him, fate had other ideas in mind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931972730temp-1787931972696-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931971790temp-1787931971721-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=srnAE-hbd54\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"101\",\"language\":\"English, French, Hebrew\",\"country\":\"USA, France\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Boaz Dvir\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b44\",\"name\":\"International Documentary Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.699Z\",\"updated_at\":\"2026-09-03T10:10:27.528Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:40:52.087Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e3415f2c5e1404d8a2\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Tell Me Everything\",\"description\":\"<h3>+ Q&amp;A with director Moshe Rosenthal</h3><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £20.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>For all enquiries relating to your booking, please contact Curzon directly. Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong>This event is part of the New Israel Fund strand.</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Sally and Jonathan Lewis</h4>\",\"short_description\":\"\",\"location\":\"Curzon Mayfair\",\"venue\":{\"id\":\"6a3000f01f63771bc478520c\",\"name\":\"Curzon Mayfair\",\"short_name\":\"Curzon Mayfair\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838\",\"address\":\"Curzon Mayfair\\n38 Curzon St\\nLondon W1J 7TY\",\"default_capacity\":null,\"color\":\"#608ea4\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"cd261459-295f-302d-71e8-8c70ad0ba790\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"675c5c67a9d65c62d8dea834\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call box office to book)\",\"color\":\"#4176A5\",\"_id\":\"675c5c67a9d65c62d8dea835\"},{\"key\":\"3\",\"label\":\"Guests\",\"color\":\"#d3d3d3\",\"_id\":\"675c5c67a9d65c62d8dea836\"},{\"key\":\"4\",\"label\":\"Companion Seat (Call box office to book)\",\"color\":\"#49A3BA\",\"_id\":\"675c5c67a9d65c62d8dea837\"}]},\"is_dated\":true,\"start_time\":\"2026-11-08T17:30:00.000Z\",\"end_time\":\"2026-11-08T19:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/MAY1-34612/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b85\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Tell Me Everything\",\"sort_key\":\"Tell Me Everything\",\"description\":\"<p>A wonderfully nuanced coming-of-age story and the second feature from hotshot Israeli director Moshe Rosenthal (Karoake, Opening Night Gala at the 2022 UK Jewish Film Festival). Boaz (Yair Mazor as a child, and Ido Tako as an adult) is a pop-music-obsessed 12 year old, who idolises his father, Meir (Assi Cohen). But Boaz soon discovers a devastating secret about his dad that shakes the very foundations of his life. Premiering in the UK, following its debut at Sundance, where it became the first Israeli film to screen at the festival in a decade. A sensation of Israeli cinema, it opened the Jerusalem Film Festival, and was nominated for a record-breaking 16 Israel Film Academy Awards, including Best Picture.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787932041480temp-1787932041367-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932040119temp-1787932039929-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"109\",\"language\":\"Hebrew\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Moshe Rosenthal\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b41\",\"name\":\"Best Film Award Nominee\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b81\",\"name\":\"New Israel Fund Strand\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":