\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:41:57.665Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1790068882628temp-1790068882596-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1790068882863temp-1790068882843-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e5415f2c5e1404d8b6\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Rosenthal: The Great Showman\",\"description\":\"<p><strong>PRICES:</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (Student Rush Tickets, 10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual armchairs. Sofas can only be bought as two seats together, for a combined total price of £34.00 (or £10.00 for Student Rush tickets).</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Fiona and Peter Needleman</h4>\",\"short_description\":\"\",\"location\":\"Everyman Belsize Park\",\"venue\":{\"id\":\"6a3000f01f63771bc478520d\",\"name\":\"Everyman Belsize Park\",\"short_name\":\"Everyman Belsize Pk\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"203 Haverstock Hill\\nBelsize Park\\nLondon \\nNW3 4QG\",\"default_capacity\":null,\"color\":\"#a326ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"fe3b9596-ce5c-1015-a950-49d47c25d6d6\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"2-Seater Sofa: Sold as a pair\",\"color\":\"#286A22\",\"_id\":\"6abbe46acc7d5284510a8855\"},{\"key\":\"2\",\"label\":\"Single armchair\",\"color\":\"#992C4E\",\"_id\":\"6abbe46acc7d5284510a8856\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6abbe46acc7d5284510a8857\"},{\"key\":\"5\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6abbe46acc7d5284510a8858\"},{\"key\":\"6\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6abbe46acc7d5284510a8859\"}]},\"is_dated\":true,\"start_time\":\"2026-11-09T20:45:00.000Z\",\"end_time\":\"2026-11-09T22:45:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a998444517101185b345661\",\"name\":\"Single armchair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":6,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"rush_line_price\":null,\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a998444517101185b345664\",\"name\":\"2-Seater Sofa: Sold as a pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":24,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b54\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rosenthal: The Great Showman\",\"sort_key\":\"Rosenthal: The Great Showman\",\"description\":\"<p>A remarkable retelling of a true story, based on the life of beloved German-Jewish television host, Hans Rosenthal. Germany, 1978: Hans (Florian Lukas) has risen to the very top of the light entertainment world, with his wildly successful nightly quiz show Dalli, Dalli. To maintain his jovial persona, Hans hides his Jewish identity and his past as a Holocaust survivor from his adoring audience. But when the 40th anniversary of Kristallnacht falls on the same night as the live special anniversary edition of Dalli, Dalli, Hans must decide what is more important to him — maintaining this façade, or confronting the hard truths of the past.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931979261temp-1787931979224-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/