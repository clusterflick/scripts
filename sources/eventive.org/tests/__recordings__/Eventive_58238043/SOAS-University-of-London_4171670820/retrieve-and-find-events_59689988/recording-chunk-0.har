lse,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb22c30cda3f6686038fc\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0d3\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"WELCOME TO G-TOWN\",\"sort_key\":\"WELCOME TO G-TOWN\",\"description\":\"<p>59-Aliens invade Glasgow in a splatter-comedy from upstart twins Nathan and Ben McQuaid. Inspired by the early Peter Jackson cult items BAD TASTE and MEET THE FEEBLES,  Bill is a media studies graduate struggling to get a job. His search for employment sees him stumble upon an office filled with strange characters clad in kilts and Jimmy hats who talk in a peculiar manner. They are a group of shape-shifting aliens, and when their leader sends one of them to spy on him, Bill and best friends Pete and Ronnie find themselves embroiled in the aliens’ plans for world domination.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784580109066temp-1784580109021-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"85\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"English\",\"rating\":\"18\"},\"credits\":{\"director\":\"Nathan & Ben McQuaid\",\"cast\":\"Danny McAllen, Mark Dallas, Stan Ross, Ruben Ros\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visi