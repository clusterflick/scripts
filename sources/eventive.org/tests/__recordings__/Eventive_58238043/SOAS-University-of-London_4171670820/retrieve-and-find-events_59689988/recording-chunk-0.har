name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6aa7d5e53dcc4c2b42caa9cb\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Carry with Both Hands\",\"sort_key\":\"Carry with Both Hands\",\"description\":\"<p>Leah is caught in the middle of her family's divided view points on politics, culture and religious identity, and the ever-changing boundaries of acceptance.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384500328temp-1789384499778-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384227538temp-1789384226485-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384226256temp-1789384225349-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"runtime\":\"15\",\"year\":\"2026\"},\"credits\":{\"director\":\"Tim Rogg\",\"producer\":\"Andrew St Maur\",\"screenwriter\":\"Paz Kaiba\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-09-14T11:09:25.161Z\",\"updated_at\":\"2026-09-14T11:14:59.776Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.569Z\",\"updated_at\":\"2026-08-28T15:45:16.569Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T10:19:12.391Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1789396709078temp-1789396708887-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1789396709463temp-1789396709313-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9ec382b8ce534df6e8ba02\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Israeli Shorts (Shorts Programme)\",\"description\":\"<p><strong>PRICE:</strong></p><p><strong>All online shorts packages are completely free to watch.</strong></p><p>Running time: 85 mins.</p><p><br></p><p><strong>Six UK premieres from Israel, showcasing the breadth of emerging filmmaking talent.</strong></p><p>Our in-cinema exclusive <em>Butcher's Stain</em> — nominated for Best Live Action Short at the 2026 Oscars and winner of a 2025 Student Academy Award Silver Medal — follows an Arab-Israeli butcher accused of tearing down hostage posters, and asks whether his colleagues can see past his ethnicity. In <em>Frequency</em>, written and directed by Mindi Ehrlich (<em>Pink Lady</em>), a young woman who has left her Orthodox community fights to re-establish contact with her son. <em>The Insurance Fairy</em> finds a cash-strapped mother staging a gas leak — until her son hides. <em>The Eulogy</em> lightens the mood with two brothers grieving very differently. <em>Not My Weekend</em>, Israeli Academy Award-nominated, sees divorced Sharon weighing up her childcare cmittments against a ticket to the Nova Music Festival on October 7th. Online exclusive <em>Love Letter to my Brother</em> follows twins divided when one becomes ultra-Orthodox.</p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc4785278\",\"name\":\"Short Film Programme\",\"color\":\"#f2416e\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6a9ec382b8ce534df6e8ba05\",\"name\":\"Virtual Admission\",\"price\":0,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":19,\"quantity_scanned\":0,\"quantity_remaining\":131,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a61c67debe054b8d1803300\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Frequency\",\"sort_key\":\"Frequency\",\"description\":\"<p>A young woman who has left her Orthodox community is heartbroken at the loss of contact with her son. They meet secretly on his birthday, and try to rekindle their relationship, but is it too late? Short Independent Competition, Tel Aviv International Student Film Festival, 2025. Written and directed by Mindi Ehrlich (writer of Pink Lady).</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967415569temp-1788967415533-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967405146temp-1788967405107-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967423532temp-1788967423405-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"Israel\",\"language\":\"Hebrew\",\"runtime\":\"16\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Mindi Ehrlich\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\