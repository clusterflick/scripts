ble_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0bf\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE GLORIOUS DEAD\",\"sort_key\":\"GLORIOUS DEAD, THE\",\"description\":\"<p>FrightFest welcomes back the Adams family who have won the bloody hearts of genre enthusiasts worldwide for their extraordinary work ethic, inspiration, passion and love of horror. Now comes the shocking fable of  a small-town sheriff and her deputy who awaken to a changed world where blood drips from taps, people and pets vanish, fleshy creatures roam the woods and the hamlet descends into chaos. By noon the skies turn  white with snow and the dirt cannot keep the dead down as the shattered community buckles under the pressure and as the sun sets all hell has frozen over. </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579862496temp-1784579862328-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"80\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"International\",\"rating\":\"18\"},\"credits\":{\"director\":\"Toby Poser, John Adams\",\"cast\":\"Toby Poser, Lulu Adams, Zelda Adams, John Adams\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.664Z\",\"updated_at\":\"2026-07-25T11:36:29.573Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-07-25T10:34:03.924Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71f46d929fd78f8b31b\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"Perfect Organism, Perfect Horror\",\"description\":\"<p>Perfect Organism, Perfect Horror: How Alien inspired the Alien: Isolation series.</p><p><br></p><p>Join us as we welcome the developers of the critically acclaimed&nbsp;<em>Alien: Isolation</em>™, and its upcoming sequel&nbsp;<em>Alien: Isolation 2</em>™, to the stage. This exclusive FrightFest panel session will be a deep dive into the creation of this compelling survival horror video game series, and the pivotal role that the 1979 sci-fi horror classic&nbsp;<em>Alien&nbsp;</em>played in inspiring its creation.</p>\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 1\",\"venue\":{\"id\":\"6a53d8f172ba3569f93d018c\",\"name\":\"ODEON Luxe West End - Discovery Screen 1\",\"short_name\":\"Discovery Screen 1\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":166,\"color\":\"#99c6ef\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"18b3da24-c60c-ecd9-f718-b6803037dd63\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a64966ab8d304b716d49458\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a64966ab8d304b716d49459\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a64966ab8d304b716d4945a\"},{\"key\":\"4\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a64966ab8d304b716d4945b\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T12:30:00.000Z\",\"end_time\":\"2026-08-30T14:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false