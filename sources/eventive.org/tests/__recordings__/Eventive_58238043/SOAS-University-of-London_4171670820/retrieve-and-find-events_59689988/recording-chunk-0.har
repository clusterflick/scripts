ick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":166,\"ticket_buckets\":[{\"id\":\"6a5ea71246d929fd78f8b240\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":119,\"quantity_sold\":61,\"quantity_scanned\":0,\"quantity_remaining\":58,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb78df05a88c4a9c5c7e4\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":30,\"quantity_scanned\":0,\"quantity_remaining\":9,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a804f512c125b2186bc3403\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e066\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"GRIN\",\"sort_key\":\"GRIN\",\"description\":\"<p>Welsh-born Lawrence Fowler and his father Geoff have been steadily turning out evil doll shockers since 2018 with THE CURSE OF THE WITCH’S DOLL followed by assorted marionette menacers in their JACK IN THE BOX (2019) trilogy. Now comes another franchise possibility with GRIN. Following a horrific crime committed when they were young, a group of four friends think it will remain a secret forever until they discover and play a vintage board game. When the game unwittingly summons the grotesque clown demon ‘Grin’, it soon becomes clear the evil entity targets those who have committed terrible sins.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577812141temp-1784577811792-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"81\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Lawrence Fowler\",\"cast\":\"Gareth Tidball, Simon Davies, Lucas Edwards, Virginia Gilchrist\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.539Z\",\"updated_at\":\"2026-07-25T11:47:58.558Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T11:41:01.717Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71846d929fd78f8b2a3\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"BLOOD SECRET\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 2\",\"venue\":{\"id\":\"6a53dc50f89ce2f3d85a453d\",\"name\":\"ODEON Luxe West End - Discovery Screen 2\",\"short_name\":\"Discovery Screen 2\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":74,\"color\":\"#ff8fdc\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"e2b15fdc-5d76-c3e8-6bee-9835d6ec4e83\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a5977c395de359ee0fb3d1d\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a5977c395de359ee0fb3d1e\"},{\"key\":\"3\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a5977c395de359ee0fb3d1f\"},{\"key\":\"4\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a5977c395de359ee0fb3d20\"}]},\"is_dated\":true,\"start_time\":\"2026-08-27T21:45:00.000Z\",\"end_time\":\"2026-08-27T23:21:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":72,\"ticket_buckets\":[{\"id\":\"6a5ea71846d929fd78f8b2a6\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":46,\"quantity_sold\":29,\"quantity_scanned\":0,\"quantity_remaining\":17,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f7233eed55053da8e43d0\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804f512c125b2186bc3403\",\"6a804e190a759551798b743a\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e02e\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BLOOD SECRET\",\"sort_key\":\"BLOOD SECRET\",\"description\":\"<p>From Cameron Francis, director of last year’s FrightFest acclaimed breakout hit, COVER. Secrets... Lies... Bodies... Nothing stays buried forever. While visiting her best friend, a woman starts to question reality when she's confronted by seemingly supernatural events. As her sanity unravels, she comes to the terrifying realization that she might not survive the night. Set in one location, but given an epic look in John Carpenter-inspired wide-screen, claustrophobia, both mentally and physically, is the overwhelming mood of Francis’ latest miniature gem exploring the universal themes of regret, remorse and ultimately searching for forgiveness. </p>\",\"cover_image\":\"https://static-a.eventive.org/1784576794154temp-1784576794096-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"81\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Cameron Francis\",\"cast\":\"Katherine Lozon, Tiana Akers, Garin Jones, Cory Stark\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.471Z\",\"updated_at\":\"2026-07-25T11:46:34.850Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T11:41:27.988Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71046d929fd78f8b21f\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"BOWELS OF HELL\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 1\",\"venue\":{\"id\":\"6a53d8f172ba3569f93d018c\",\"name\":\"ODEON Luxe West End - Discovery Screen 1\",\"short_name\":\"Discovery Screen 1\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":166,\"color\":\"#99c6ef\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"18b3da24-c60c-ecd9-f718-b6803037dd63\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a64966ab8d304b716d49458\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a64966ab8d304b716d49459\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a64966ab8d304b716d4945a\"},{\"key\":\"4\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a64966ab8d304b716d4945b\"}]},\"is_dated\":true,\"start_time\":\"2026-08-27T21:50:00.000Z\",\"end_time\":\"2026-08-27T23:48:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":166,\"ticket_buckets\":[{\"id\":\"6a5ea71046d929fd78f8b222\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":119,\"quantity_sold\":44,\"quantity_scanned\":0,\"quantity_remaining\":75,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb81d58184f15c15aca87\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":38,\"quantity_scanned\":0,\"quantity_remaining\":1,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a804f512c125b2186bc3403\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e032\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"BOWELS OF HELL\",\"sort_key\":\"BOWELS OF HELL\",\"description\":\"<p>Get ready for fecal fear and scatalogical splatter in a heart-felt gross-out shocker to scare you shitless! Malu is cracking up due to the weight of past trauma that leaves her with a strong aversion to toilets. She’s also unwilling to use her rebellious teenage child’s preferred pronouns and adopted name Genesis. But then a strange curse turns toilets into deadly monsters and she is hurled into a surreal nightmare where motherhood, grief, and existential terror can’t simply be flushed away. Gagging Grand Guignol in a midnight madness mix of lunatic lavatories and close encounters of the turd kind. </p>\",\"cover_image\":\"https://static-a.eventive.org/1784576871012temp-1784576870705-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"111\",\"language\":\"Brazil\",\"country\":\"Brazil\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Brazillian\"},\"credits\":{\"director\":\"Gurcius Gewdner, Gustavo Vinagre\",\"cast\":\"Martha Nowill, Benjamin Damini, Majeca Angelucci, Rodrigo Apresentador\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"vi