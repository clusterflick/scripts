sold\":7,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b71\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Where To?\",\"sort_key\":\"Where To?\",\"description\":\"<p>A poignant and beautifully considered exploration of empathy and coexistence told through a distinctly humanistic lens. Hassan (Ehab Salami) is a Palestinian Uber driver in Berlin who spends his nights shuttling the city’s inhabitants from one location to another. One night, he picks up Amir (Ido Tako), a young gay Israeli man who has recently moved to the city. As Hassan's and Amir’s paths cross again and again over the years, an unlikely and unexpected bond forms between them. This mesmeric, moving film is premiering in the UK following its debut at the prestigious Berlinale. It was nominated for 11 awards at the Israel Film Academy Awards, including Best Picture.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787932019306temp-1787932019276-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932018405temp-1787932018298-poster.jpg\",\"trailer_url\":\"https://youtu.be/xDrkxDh_oGQ\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"96\",\"language\":\"Hebrew, Arabic\",\"country\":\"Israel, Germany\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Assaf Machnes\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b6f\",\"name\":\"Perspectives Strand\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b12\",\"name\":\"Arabic Language\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.761Z\",\"updated_at\":\"2026-09-03T09:59:34.770Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:42:54.565Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e6415f2c5e1404d8ce\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Holofiction\",\"description\":\"<h3>+ Q&amp;A with director Michal Kosakowski</h3><p><strong>PRICES:</strong></p><p><strong>Front two rows: £15.00</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Premium Seat (extra width and legroom): £21.50</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual seats.</p><p>Sofas can only be bought as two seats together, for a combined total price of £34.00.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>The Association of Jewish Refugees</h4><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/428409bc77b54b81951ce603c15ccc3b.png\\\" width=\\\"227\\\"></p>\",\"short_description\":\"\",\"location\":\"Phoenix Cinema Screen 1\",\"venue\":{\"id\":\"6a99730ef0ab0a9c42cbf3d6\",\"name\":\"Phoenix Cinema Screen 1\",\"short_name\":\"Phoenix Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"52 High Road\\nEast Finchley\\nLondon N2 9PJ\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"5b8d1728-e836-4af9-915d-513002a54a17\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ac7bbdd331f37456b9ad382\"},{\"key\":\"2\",\"label\":\"Premium Seat (wider, more legroom)\",\"color\":\"#FCA700\",\"_id\":\"6ac7bbdd331f37456b9ad383\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6ac7bbdd331f37456b9ad384\"},{\"key\":\"4\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ac7bbdd331f37456b9ad385\"},{\"key\":\"5\",\"label\":\"Two-Seater Sofa: Sold as a Pair\",\"color\":