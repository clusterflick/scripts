"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e023\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"ANOTHER\",\"sort_key\":\"ANOTHER\",\"description\":\"<p>Joey is a grief-stricken author haunted by the death of her husband Ben, a brilliant physicist. When he inexplicably appears one morning, alive and well, making breakfast in their kitchen, Joey is thrust into a waking nightmare where grief, memory, and her reality begin to unravel. A genre-blending mashup of science fiction, mystery and horror, brought to life with practical effects and a lot of twists and turns, ANOTHER is an atmospheric and emotional  meditation on grief, love, and fractured reality with inspiration pulled from such creative storytellers as M. Night Shyamalan, Christopher Nolan and Denis Villeneuve.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576479491temp-1784576479454-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"93\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Andy Chen\",\"cast\":\"Bob Morley, India de Beaufort, Doug Jones, Heather Langenkamp\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.456Z\",\"updated_at\":\"2026-07-25T10:54:01.752Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:09:30.206Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea89ef4ac0bac8eff4842\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"SHORT FILM SHOWCASE 1\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"venue\":{\"id\":\"6a53d19a120a5c364136d42b\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 3\",\"short_name\":\"Discovery Screen 3\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":41,\"color\":\"#8d95ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"faf60e2b-1976-4811-97c8-389557fc83d2\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a649526f9d9051f6887b481\"},{\"key\":\"2\",\"label\":\"Passholder Tickets\",\"color\":\"#FBA700\",\"_id\":\"6a649526f9d9051f6887b482\"},{\"key\":\"3\",\"label\":\"Single Tickets\",\"color\":\"#F53F3F\",\"_id\":\"6a649526f9d9051f6887b483\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a649526f9d9051f6887b484\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T15:00:00.000Z\",\"end_time\":\"2026-08-28T17:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":false,\"unlimited\":false,\"quantity\":41,\"ticket_buckets\":[{\"id\":\"6a5ea89ef4ac0bac8eff4845\",\"name\":\"Single Tickets\",\"price\":1499,\"unlimited\":false,\"quantity\":24,\"quantity_sold\":24,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5f859ce2e35c5eb2fc3e91\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e098\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SHORT FILM SHOWCASE 1\",\"sort_key\":\"SHORT FILM SHOWCASE 1\",\"description\":\"<p><strong>Goodbye, Monster (International Premiere)</strong>&nbsp;</p><p>Director: Luke Barnett.&nbsp;With: Kue Lawrence, Luke Barnett, Patton Oswalt, Tina Majorino. USA 2026.&nbsp;7 min.&nbsp;</p><p><br></p><p>A coming-of-age story about a boy and his monster.&nbsp;</p><p>&nbsp;</p><p><strong>Priority Ride (World Premiere)</strong>&nbsp;</p><p>Director: Noah Lang.&nbsp;With: Jennifer Gouchoe, Bill Sebastian. USA 2026.&nbsp;9 min.&nbsp;</p><p><br></p><p>During a quiet ride home, a woman begins to notice the small things about her driver that don’t quite add up.&nbsp;</p><p>&nbsp;</p><p><strong>Leopard (UK Premiere)</strong>&nbsp;</p><p>Director: Dan Abramovici.&nbsp; With: Emma Ho, Luca Villacis.&nbsp; CANADA 2025.&nbsp;11min.&nbsp;</p><p>&nbsp;</p><p>Diego is being a dick, and Tish doesn’t know why. Is he jealous because his little sister is an incredible artist while he’s just a poser playing JV soccer (sorry, \\\"football\\\")? Or is it because their parents have been fighting ever since they immigrated to Canada? Tish is gonna find out.&nbsp;</p><p>&nbsp;</p><p><strong>TLSM (UK Premiere)</strong>&nbsp;</p><p>Director: Filip Momirovski.&nbsp;With: Damjan Krstevski, Angela Stojanovska, Sinan Rakipovski.&nbsp; NORTH MACEDONIA 2025.&nbsp;14 min.&nbsp;</p><p>&nbsp;</p><p>A boy prepares for a final showdown with his bullies. A spirit from Macedonian folktales interferes&nbsp;</p><p>&nbsp;</p><p><strong>The Shirt Off Your Back (UK Premiere)</strong>&nbsp;</p><p>Director: David Robinson-Smith.&nbsp;With: Eden Wendt, Blye Hawk.&nbsp; AUSTRALIA 2025.&nbsp;9min.&nbsp;</p><p>&nbsp;</p><p>A dark fairytale about two brothers re-living a strange encounter with a man on Christmas Day, their memories shifting until the truth becomes something unknowable—something that quietly, irrevocably changes them.&nbsp;</p><p>&nbsp;</p><p><strong>Sounds Good (World Premiere)</strong>&nbsp;</p><p>Director: Richard Mulock. With: Jake Lambie.&nbsp;USA 2026.&nbsp;2min.&nbsp;</p><p>&nbsp;</p><p>While listening to some music, a man hears something he wasn't expecting&nbsp;</p><p>&nbsp;</p><p><strong>Book U Can Ask ???s (European Premiere)</strong>&nbsp;</p><p>Director: Casimir Nozkowski.&nbsp; With: Maura Madden, Will Carlough.&nbsp; USA 2025. 6min.&nbsp;</p><p>&nbsp;</p><p>A stoner uses the internet to help a ghost find the correct address of its murderer's descendants.&nbsp;</p><p>&nbsp;</p><p><strong>Feed The Dark (International Premiere)</strong>&nbsp;</p><p>Director: Rob Himebaugh.&nbsp; With: Emily Mutimer, Timothy James Willard.&nbsp;USA 2025. 7min.&nbsp;</p><p>&nbsp;</p><p>Snowbound high in the mountains, a ski patroller realizes her injured colleague has been possessed by a ravenous demon.&nbsp;</p><p>&nbsp;</p><p><strong>Saturday Morning Coffee (International Premiere)</strong>&nbsp;</p><p>Director: Erick Freitas.&nbsp;With: Tommy Manna, Erick Freitas. USA 2025. 4min.&nbsp;</p><p>A suburban Dad's perfect life gets turned upside down in a flash when an intruder appears.&nbsp;</p><p>&nbsp;</p><p><strong>In A Room, Sitting Still (UK Premiere)</strong>&nbsp;</p><p>Director: Adrián Nassar.&nbsp;With: Duong Hong Ngoc, Yo-won Sun.&nbsp;SOUTH KOREA 2025.&nbsp;7min.&nbsp;</p><p>&nbsp;</p><p>After killing her friend’s boyfriend, Do-yeon recounts her memory of the events and the feelings that led her to that point.&nbsp;</p><p>&nbsp;</p><p><strong>Bait</strong> <strong>(UK Premiere)</strong>&nbsp;</p><p>Director: Martha G. Ayerbe With: Ramón Barea, Xavi Sáez, Aniol Cisquella. SPAIN 2025. 16min.&nbsp;</p><p>&nbsp;</p><p>On a hunting trip, young Martín accompanies his father and his father’s boss. As the day progresses, each man’s inner tensions and frustrations come to light, putting Martín’s sensitivity and quiet strength to the test.&nbsp;</p><p>&nbsp;</p>\",\"cover_image\":\"https://static-a.eventive.org/1786006105865temp-1786006105832-cover.jpg\",\"unballoted\":false,\"details\":{\"rating\":\"18\",\"runtime\":\"93\"},\"credits\":{},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.605Z\",\"updated_at\":\"2026-08-06T08:48:25.830Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:57:41.887Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea71146d929fd78f8b231\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"FACES OF DEATH\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe West End - Discovery Screen 1\",\"venue\":{\"id\":\"6a53d8f172ba3569f93d018c\",\"name\":\"ODEON Luxe West End - Discovery Screen 1\",\"short_name\":\"Discovery Screen 1\",\"description\":\"\",\"address\":\"ODEON Luxe West End, 38a Leicester Square. London WC2H 7DX.\",\"default_capacity\":166,\"color\":\"#99c6ef\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"18b3da24-c60c-ecd9-f718-b6803037dd63\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a64966ab8d304b716d49458\"},{\"key\":\"2\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a64966ab8d304b716d49459\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a64966ab8d304b716d4945a\"},{\"key\":\"4\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a64966ab8d304b716d4945b\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T17:00:00.000Z\",\"end_time\":\"2026-08-28T18:57:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":166,\"ticket_buckets\":[{\"id\":\"6a5ea71146d929fd78f8b234\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":119,\"quantity_sold\":114,\"quantity_scanned\":0,\"quantity_remaining\":5,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb9481098bdcb6da60848\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":39,\"quantity_sold\":39,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e050\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"FACES OF DEATH\",\"sort_key\":\"FACES OF DEATH\",\"description\":\"<p>The meta slasher retooling of the cult 1978 mondo classic that caused a controversial moral panic. Margot Romero works as a content moderator for the Kino video-hosting website, where she decides whether to pass or flag the clips that fly onto the platform at speed. Even though mostly detached from the  shocking imagery she has to view, she raises concerns over a series of murder videos that appear alarmingly real. Her fears brushed aside, Margot begins a personal investigation and discovers, with the help of her horror-fan roommate, the demises are modeled on those from the original Video Nasty tape.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784577465094temp-1784577464970-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"97\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Daniel Goldhaber\",\"cast\":\"Barbie Ferreira, Dacre Montgomery, Josie Totah, Charli XCX\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.511Z\",\"updated_at\":\"2026-07-25T11:44:21.596Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:41:47.025Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea70e46d929fd78f8b1f5\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"THE PITCHFORK RETREAT\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Single Tickets\",\"venue\":{\"id\":\"6a53d79a6c5535dfd9936a4d\",\"name\":\"ODEON Luxe Leicester Square - Single Tickets\",\"short_name\":\"Main Screen - Single Tickets\",\"description\":\"\",\"address\":\"\",\"default_capacity\":57,\"color\":\"#f22313\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"aad0d885-2851-1b2a-2d4a-7ab95f4b7deb\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a6e3c9a1dde808a7926d17e\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a6e3c9a1dde808a7926d17f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T17:20:00.000Z\",\"end_time\":\"2026-08-28T19:14:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":true,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":60,\"ticket_buckets\":[{\"id\":\"6a5ea70e46d929fd78f8b1f8\",\"name\":\"Single Ticket\",\"price\":1499,\"unlimited\":false,\"quantity\":60,\"quantity_sold\":47,\"quantity_scanned\":0,\"quantity_remaining\":13,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0c9\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE PITCHFORK RETREAT\",\"sort_key\":\"PITCHFORK RETREAT, THE\",\"description\":\"<p>We all take secrets to the grave! Three genre writers, Matt, Mandy and Nikolai, journey to a secluded island for a life-changing competition at the high-stakes horror Jigsaw retreat. But the top prize comes with a price as they realize there is nowhere to hide when the darkness from within comes to light. For they must tap into their inner demons on the spiral into a vortex of terror if they are to win. From the producers of the TERRIFIER franchise comes a host of genre legends, including the last appearance of CANDYMAN star Tony Todd, in a unique anthology.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784580014894temp-1784580014760-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"94\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Gregory Van Voorhis, Nicole Van Woorhis\",\"cast\":\"Tony Todd, Danielle Harris, Dee Wallace, Adrienne Barbeau\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.677Z\",\"updated_at\":\"2026-07-25T11:35:47.835Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T20:53:53.211Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea8a3f4ac0bac8eff48a2\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"CRAZY LIPS\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"venue\":{\"id\":\"6a4d7692d104ae98644c1bbc\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"short_name\":\"Discovery Screen 4\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":40,\"color\":\"#c8cdd0\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"6b3f0bd6-f219-b12b-c112-ce0741445a23\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a91747e38c1ba4a4427323c\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a91747e38c1ba4a4427323d\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a91747e38c1ba4a4427323e\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a91747e38c1ba4a4427323f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-28T17:30:00.000Z\",\"end_time\":\"2026-08-28T19:15:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_num