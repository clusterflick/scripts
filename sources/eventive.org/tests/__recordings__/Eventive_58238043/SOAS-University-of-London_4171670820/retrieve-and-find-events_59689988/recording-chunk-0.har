e,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6ac75f3069dcb5d9d9c655cd\",\"name\":\"Adult Standard\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":84,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac75f3069dcb5d9d9c655d0\",\"name\":\"Under 35s (with valid ID)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":15,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac75f3069dcb5d9d9c655dc\",\"name\":\"Premium Seat (wider, more legroom)\",\"price\":2150,\"unlimited\":true,\"quantity_sold\":12,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac75f3069dcb5d9d9c655f4\",\"name\":\"Two-Seater Sofa: Sold as a Pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac75f3069dcb5d9d9c65604\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":24,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac75f3069dcb5d9d9c65608\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":4,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b49\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Long Journey Home\",\"sort_key\":\"Long Journey Home, The\",\"description\":\"<p>A vital cinematic testament to the Jews of Iraq. Once home to an estimated 180,000 Jews, whose ancestors had been living in the country for over 2,500 years — today, almost none remain. Researcher and filmmaker, David Kahtan, has spent over 20 years putting together this comprehensive documentary. It chronicles the entire history of the Jews of Iraq, from ancient Babylon, through the violent pogrom of the Farhud, and the mass exodus in the 1950s, right up to the modern day. As 2026 marks the 85th anniversary of the Farhud, this is a timely reminder of a lost Jewish community.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788893997425temp-1788893997267-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788893997898temp-1788893997626-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788894012469temp-1788894012217-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"94\",\"language\":\"English, Hebrew, Arabic\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"David Kahtan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b44\",\"name\":\"International Documentary Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b12\",\"name\":\"Arabic Language\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.695Z\",\"updated_at\":\"2026-09-25T09:08:00.848Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:47:07.511Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708ea415f2c5e1404d939\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"DOC DAY: The Righteous Road Trip\",\"description\":\"<h2>PART OF DOC DAY AT CURZON BLOOMSBURY</h2><h3>+ Q&amp;A with Vanessa Roth and co-producerJustin Cohen MBE</h3><h3>+ Pre-Feature Short <em>That's How You Make a Torah</em></h3><h4>This film will be shown in Screen 5 (The Renoir)</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £20.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>For all enquiries relating to your booking, please contact Curzon directly.</p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Group Nexus</h4><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/beebb134c29b91944cbfd3b0b7802f53.png\\\" width=\\\"134\\\"></p>\",\"short_description\":\"\",\"location\":\"Curzon Bloomsbury\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ea\",\"name\":\"Curzon Bloomsbury\",\"short_name\":\"Curzon Bloomsbury\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838.\\nFor Customer Service queries, call: 01233 555644.\",\"address\":\"The Brunswick Centre, London WC1N 1AW\",\"default_capacity\":null,\"color\":\"#8d95ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-15T14:00:00.000Z\",\"end_time\":\"2026-11-15T16:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6aa94c525bba412e1e2417d2\",\"name\":\"+ Pre-Feature Short\",\"color\":\"#3697ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/BLO1-113621/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b52\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Righteous Road Trip\",\"sort_key\":\"Righteous Road Trip, The\",\"description\":\"<p>An extraordinary emotional and physical journey, with Jewish humanitarian activist, Jonny Daniels, directed by Oscar-winning filmmaker, Vanessa Roth. We follow along with Jonny, as he travels around Poland, Slovakia, and Hungary, during Christmas time, visiting the surviving members of the Righteous Among the Nations — people who put their lives, and the lives of their families, at risk to save Jews during the Holocaust. Jonny brings them Christmas gifts, as he does every year, encouraging them to recount their stories of bravery, courage, and love. A timely reminder of humanity’s capacity to do good, even when faced by evil.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931977179temp-1787931977144-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931976035temp-1787931976008-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=QhxYDn1ZF3g\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"40\",\"language\":\"English\",\"country\":\"USA\"},\"credits\":{\"director\":\"Vanessa Roth\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.707Z\",\"updated_at\":\"2026-09-03T10:10:55.566Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a9e977f799024940ee8ed56\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"That's How You Make a Torah\",\"sort_key\":\"That's How You Make a Torah\",\"description\":\"<p>The first Torah scribed by a man dates from the year 3 BCE, but the first Torah written by a woman didn't happen until 2007. This short documentary is about two of the first known women to ever scribe a Torah: Jen Taylor Friedman, based in Cambridge, and Rabbi Linda Motzkin, from the USA, who not only writes Torah, but makes her own Kosher parchment, too.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789492309349temp-1789492309185-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789492309846temp-1789492309586-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789492316929temp-1789492316649-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United States\",\"language\":\"English\",\"runtime\":\"10\",\"year\":\"2025\"},\"credits\":{\"animator\":null,\"cast\":null,\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Lauren Greenhall\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":null,\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785277\",\"name\":\"Pre-feature\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b1b\",\"name\":\"Real to Reel\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785269\",\"name\":\"Short Films\",\"color\":\"#fffc36\",\"visible\":true}],\"imdb_id\":\"tt39132174\",\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6ab97ee40aeccbd171b31c65\",\"type\":\"vod\",\"label\":\"tfs_english_subs (1080p) (2).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"10b9aecb-b57e-4456-9361-403bcb8b2bb0\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":650751.667,\"file_size\":352569373,\"created_at\":\"2026-09-27T20:39:00.093Z\",\"updated_at\":\"2026-09-27T20:39:00.108Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-09-07T10:52:47.865Z\",\"updated_at\":\"2026-09-15T17:11:56.647Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:47:20.707Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa2dd6103ae288a55023233\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Bitesize Britain Shorts\",\"description\":\"<h3>+ Q&amp;As with Filmmakers</h3><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £15.00</strong></p><p><strong>Premium Seat (extra width and legroom): £21.50</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual seats.</p><p>Sofas can only be bought as two seats together, for a combined total price of £30.00.</p><p><br></p><p>Films about British Jewish life don't come more diverse than this sparkling package of shorts. From dark dramas to mini-docs, and charming cartoons to crazy comedies. Indefatigable centenarians rub shoulders with quirky kids, from Glasgow to London via Cardiff, Leeds and Nottingham. Each one of these little gems shines a bright light into a different corner of Jewish life in the UK. Watch out for the world premiere of <em>Rachel Jones Needs a Boyfriend Not Bat-Mitzvah</em>, a hilarious and brilliant film from UK Jewish Film's brand new <em>Changing Perspectives</em> fund.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Phoenix Cinema Screen 1\",\"venue\":{\"id\":\"6a99730ef0ab0a9c42cbf3d6\",\"name\":\"Phoenix Cinema Screen 1\",\"short_name\":\"Phoenix Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"52 High Road\\nEast Finchley\\nLondon N2 9PJ\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"5b8d1728-e836-4af9-915d-513002a54a17\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ac7bbdd331f37456b9ad382\"},{\"key\":\"2\",\"label\":\"Premium Seat (wider, more legroom)\",\"color\":\"#FCA700\",\"_id\":\"6ac7bbdd331f37456b9ad383\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6ac7bbdd331f37456b9ad384\"},{\"key\":\"4\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ac7bbdd331f37456b9ad385\"},{\"key\":\"5\",\"label\":\"Two-Seater Sofa: Sold as a Pair\",\"color\":\"#286A22\",\"_id\":\"6ac7bbdd331f37456