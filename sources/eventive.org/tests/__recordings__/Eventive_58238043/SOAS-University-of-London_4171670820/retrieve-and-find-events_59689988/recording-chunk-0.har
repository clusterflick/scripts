":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"rush_line_price\":null,\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a998504586500171126c2a9\",\"name\":\"2-Seater Sofa: Sold as a pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":32,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b7a\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Think Good\",\"sort_key\":\"Think Good\",\"description\":\"<p>Directed by acclaimed French-Jewish filmmaker Géraldine Nakache, Think Good celebrates its UK premiere, following its debut at Cannes. During a trip to Dubai, secular Jewish lonely heart, Gil (Monia Chokri), meets the handsome and devoutly Orthodox Jacques (Niels Schneider). They swiftly fall in love, get married, and have a daughter together. Their fairytale relationship soon turns into a nightmare as Jacques begins trying to control every aspect of Gil’s life. As his manipulations become increasingly sinister, Gil is torn between her desperation to escape and her desire to hold her family together.</p><p><strong>WARNING: contains scenes of domestic abuse.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1787932028964temp-1787932028856-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932027496temp-1787932027308-poster.jpg\",\"unballoted\":false,\"details\":{