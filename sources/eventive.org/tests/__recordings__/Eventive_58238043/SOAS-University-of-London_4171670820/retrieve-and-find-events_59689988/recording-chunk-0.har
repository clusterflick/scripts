          "content": {
            "mimeType": "application/json",
            "text": "{\"events\":[{\"id\":\"6a9708e2415f2c5e1404d889\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"OPENING NIGHT GALA: When the Night Falls\",\"description\":\"<h1>OPENING NIGHT GALA</h1><h3>+ Introduction by producer Adrien Nussenbaum</h3><p><strong>PRICES:</strong></p><p><strong>Standard Seat: £35.00</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Nadine and Sami Aysoy</h4>\",\"short_description\":\"\",\"location\":\"BFI Southbank - NFT1\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ff\",\"name\":\"BFI Southbank - NFT1\",\"short_name\":\"BFI NFT1\",\"description\":\"\",\"address\":\"BFI Southbank\\nBelvedere Road\\nSouth Bank\\nLondon SE1 8XT\",\"default_capacity\":null,\"color\":\"#ffd500\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"8578198e-3e42-43c6-acd7-010e02178567\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ac7b940a97cb2613996c19c\"},{\"key\":\"2\",\"label\":\"Wheelchair Space\",\"color\":\"#4176A5\",\"_id\":\"6ac7b940a97cb2613996c19d\"},{\"key\":\"6\",\"label\":\"Companion Seat\",\"color\":\"#6EB8E0\",\"_id\":\"6ac7b940a97cb2613996c19e\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#EAEAEA\",\"_id\":\"6ac7b940a97cb2613996c19f\"},{\"key\":\"5\",\"label\":\"Premium Seat (Superior View)\",\"color\":\"#FCA700\",\"_id\":\"6ac7b940a97cb2613996c1a0\"}]},\"is_dated\":true,\"start_time\":\"2026-11-05T20:30:00.000Z\",\"end_time\":\"2026-11-05T22:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94e6b8be7af8433571bad\",\"name\":\"+ Introduction\",\"color\":\"#ffbc57\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6ab2d3e6f7f6b668761d0233\",\"name\":\"Adult Standard\",\"price\":3500,\"unlimited\":true,\"quantity_sold\":190,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a8f175627623f1500e77f47\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"When the Night Falls\",\"sort_key\":\"When the Night Falls\",\"description\":\"<p>From celebrated French filmmaker and actor, Daniel Auteuil, comes a must-see tale of extraordinary courage in the face of unspeakable evil. Based on a true story about the deportation of French Jews, including many children, from Vichy France to the Nazi Occupied Zone during World War Two. Unassuming civil servant, Gilbert Lesage (Antoine Reinartz), is charged with heading up the deportation commission. As the clock ticks towards the Nazi-imposed deadline, Lesage’s conscience wins out. Working together with Jewish-convert Catholic Priest, Father Glasberg (played by Auteuil himself), and humanitarian activist, Lili Tager (Luàna Bajrami), they race against time to save the lives of as many children as possible. Premiering in the UK after its acclaimed debut at Cannes, this is a truly groundbreaking film, exposing the full extent of French collaboration with the Nazi regime.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787765656332temp-1787765656286-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787765656605temp-1787765656569-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/a8d10f839237e97bfb4c73e239d93fa5.jpg\",\"unballoted\":true,\"details\":{\"country\":\"France\",\"language\":\"French\",\"runtime\":\"100\",\"subtitle_language\":\"English\",\"year\":\"2026\"},\"credits\":{\"animator\":null,\"cast\":\"\",\"cinematographer\":\"\",\"co_producer\":null,\"composer\":null,\"director\":\"Daniel Auteuil\",\"editor\":\"\",\"executive_producer\":\"\",\"filmmaker\":null,\"music\":null,\"producer\":\"\",\"production_design\":null,\"screenwriter\":\"\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785262\",\"name\":\"Dramas\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785281\",\"name\":\"Gala Film\",\"color\":\"#ffc636\",\"visible\":true}],\"imdb_id\":\"tt35422726\",\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-26T16:41:58.702Z\",\"updated_at\":\"2026-08-26T17:34:16.284Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:39:39.252Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e2415f2c5e1404d88e\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"The Soundman\",\"description\":\"<h6>\\\"This film is a standout: meditative, innovative, and profoundly moving.\\\"&nbsp;</h6><h3><em>The Hollywood Times</em></h3><h6>\\\"The Soundman is a film like an opera, where music, play and image come together in optimal synergy\\\"</h6><h3><em>Cinemagazine</em></h3><h6>“The Soundman is a poetic declaration of love to the world of sound and at the same time a moving historical drama”</h6><h3><em>Moviebreak</em></h3><p><br></p><p><strong>PRICES:</strong></p><p><strong>Front two rows: £15.00</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Premium Seat (extra width and legroom): £21.50</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual seats.</p><p>Sofas can only be bought as two seats together, for a combined total price of £34.00.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Sandra and Geoffrey</h4><h4>The Marcus Gordon family on behalf of Jewish Blind &amp; Disabled</h4><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/e1e7c9693ee64f73000a449bea061895.jpg\\\" width=\\\"131\\\"></p>\",\"short_description\":\"\",\"location\":\"Phoenix Cinema Screen 1\",\"venue\":{\"id\":\"6a99730ef0ab0a9c42cbf3d6\",\"name\":\"Phoenix Cinema Screen 1\",\"short_name\":\"Phoenix Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"52 High Road\\nEast Finchley\\nLondon N2 9PJ\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"5b8d1728-e836-4af9-915d-513002a54a17\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ac7bbdd331f37456b9ad382\"},{\"key\":\"2\",\"label\":\"Premium Seat (wider, more legroom)\",\"color\":\"#FCA700\",\"_id\":\"6ac7bbdd331f37456b9ad383\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6ac7bbdd331f37456b9ad384\"},{\"key\":\"4\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ac7bbdd331f37456b9ad385\"},{\"key\":\"5\",\"label\":\"Two-Seater Sofa: Sold as a Pair\",\"color\":\"#286A22\",\"_id\":\"6ac7bbdd331f37456b9ad386\"},{\"key\":\"6\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6ac7bbdd331f37456b9ad387\"},{\"key\":\"7\",\"label\":\"Front Rows (standard seat)\",\"color\":\"#ff5d00\",\"_id\":\"6ac7bbdd331f37456b9ad388\"}]},\"is_dated\":true,\"start_time\":\"2026-11-07T20:00:00.000Z\",\"end_time\":\"2026-11-07T22:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buck