_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"max_quantity_per_person\":null,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a804f512c125b2186bc3403\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0a0\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SLAY\",\"sort_key\":\"SLAY\",\"description\":\"<p>Seventeen-year-old Chloe Cruz appears to have it al - social media fame, a devoted boyfriend, and a tightly curated circle of friends. But when one of them is murdered, her carefully constructed world begins to unravel. Hoping to escape the fallout, Chloe and her friends retreat to a secluded, disco-themed cabin in the mountains. As paranoia sets in and tensions rise, it becomes clear they are not alone - and that the killer may be closer than they think. To survive, Chloe must confront the shifting dynamics of her friendships and the fragile identity she’s built online before it’s too late.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579447245temp-1784579447075-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"89\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Kyra Elise Gardner\",\"cast\":\"Zoey Luna, Aya Cash, Malina Pauli Weissman, Shawnee Smith\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.614Z\",\"updated_at\":\"2026-07-25T11:47:49.238Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-15T11:40:39.140Z\",\"is_virtual\":false,\"comscore_include\":true,\"geogra