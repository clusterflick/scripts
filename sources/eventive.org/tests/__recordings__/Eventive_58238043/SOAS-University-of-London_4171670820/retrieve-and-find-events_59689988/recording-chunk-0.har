w_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T10:19:25.717Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1791216042648temp-1791216042532-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1791216042965temp-1791216042880-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6ac7bd2cf3ba732913c8e0f0\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"The Soundman\",\"description\":\"<h6>\\\"This film is a standout: meditative, innovative, and profoundly moving.\\\"&nbsp;</h6><h3><em>The Hollywood Times</em></h3><h6>\\\"The Soundman is a film like an opera, where music, play and image come together in optimal synergy\\\"</h6><h3><em>Cinemagazine</em></h3><h6>“The Soundman is a poetic declaration of love to the world of sound and at the same time a moving historical drama”</h6><h3><em>Moviebreak</em></h3><p><br></p><p><strong>PRICES:</strong></p><p><strong>Standard Seat: £14.00</strong></p><p><strong>Premium Seat: £15.00 </strong></p><p><strong>Standard - Seniors/Students: £13.00 (with valid ID)</strong></p><p><strong>Premium - Seniors/Students: £14.00 (with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>In partnership with</h4><h4>DAVAR</h4><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/a600163f95a640f3603e1b3bb5072359.png\\\" width=\\\"159\\\" style=\\\"max-width: 100%;\\\"></p>\",\"short_description\":\"\",\"location\":\"Bristol Scott Screen 1\",\"venue\":{\"id\":\"6ac7b7aa50c9e56b3553f5ed\",\"name\":\"Bristol Scott Screen 1\",\"short_name\":\"Bristol Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"Bristol Scott\\n51 Northumbria Dr\\nWestbury Park\\nHenleaze\\nBristol BS9 4HN\",\"default_capacity\":null,\"color\":\"#ffbc57\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"1f79d8a9-8f28-b99b-d393-d5e367c678e3\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6accc6b1472c5fa501bab09f\"},{\"key\":\"2\",\"label\":\"Premium Seats\",\"color\":\"#FCA700\",\"_id\":\"6accc6b1472c5fa501bab0a0\"},{\"key\":\"3\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6accc6b1472c5fa501bab0a1\"}]},\"is_dated\":true,\"start_time\":\"2026-11-18T19:30:00.000Z\",\"end_time\":\"2026-11-18T21:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6ac7c8f846cf469ed488b6e1\",\"name\":\"Adult Standard\",\"price\":1400,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac7c8f846cf469ed488b6e8\",\"name\":\"Premium Seats\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac7c8f846cf469ed488b6f8\",\"name\":\"Adult Standard (Concession with valid ID)\",\"price\":1300,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac7c8f846cf469ed488b6fc\",\"name\":\"Premium Seats (Concession with valid ID)\",\"price\":1400,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b4d\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Soundman\",\"sort_key\":\"Soundman, The\",\"description\":\"<p>A beautiful portrayal of young love swept up by the dark tides of history, and a remarkable cinematic depiction of sound. In May 1940, German forces are massing along the borders of Belgium, Luxembourg, and the Netherlands. At a Brussels radio station, Elza (Femke Vanhove) is a talented young voice actor. She’s also, secretly, a Jewish refugee from Vienna. Meanwhile, Berre (Jef Hellemans) is an innovative introverted sound engineer, who creates the sound effects for the station's radio plays. The two fall deeply in love, but as war looms, and Elza’s true identity is exposed, their relationship is put to the ultimate test.</p>\",\"cover_image\":\"https://static-a.eventive.org/1791287981705temp-1791287981644-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1791287989805temp-1791287989748-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1791287989517temp-1791287989461-still.jpg\",\"trailer_url\":\"https://youtu.be/cmLvljVT4pY?si=DMJa4OoocUQVXSSI\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"120\",\"language\":\"Dutch, Hebrew\",\"country\":\"Belgium\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Frank Van Passel\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4f\",\"name\":\"Historical Drama\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b50\",\"name\":\"Dutch Language\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.702Z\",\"updated_at\":\"2026-10-08T14:10:22.745Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:48:56.035Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4adc\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"MANCHESTER OPENING NIGHT GALA: \\nWhen the Night Falls\",\"description\":\"<h4>This film will be shown in Screen 5</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £13.99 </strong></p><p><strong>Senior: £13.49</strong></p><p><strong>Student: £11.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Cineworld Manchester: Didsbury. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Cineworld, you can log in, otherwise click \\\"Continue as Guest\\\" to proceed.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Cineworld directly.</p><p>Box Office: 0330 333 4444</p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Cineworld Manchester: Didsbury\",\"venue\":{\"id\":\"6a3000f01f63771bc47851f5\",\"name\":\"Cineworld Manchester: Didsbury\",\"short_name\":\"Cineworld Didsbury\",\"description\":\"For all booking enquiries, please call the venue directly: 0330 333 4444\",\"address\":\"Parrs Wood Entertainment Centre, Wilmslow Rd, Didsbury, Manchester M20 5PG\",\"default_capacity\":null,\"color\":\"#3697ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-19T19:00:00.000Z\",\"end_time\":\"2026-11-19T21:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3463\",\"name\":\"Manchester\",\"color\":\"#8d95ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.cineworld.co.uk/order/showtimes/051-248620/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a8f175627623f1500e77f47\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"When the Night Falls\",\"sort_key\":\"When the Night Falls\",\"description\":\"<p>From celebrated French filmmaker and actor, Daniel Auteuil, comes a must-see tale of extraordinary courage in the face of unspeakable evil. Based on a true story about the deportation of French Jews, including many children, from Vichy France to the Nazi Occupied Zone during World War Two. Unassuming civil servant, Gilbert Lesage (Antoine Reinartz), is charged with heading up the deportation commission. As the clock ticks towards the Nazi-imposed deadline, Lesage’s conscience wins out. Working together with Jewish-convert Catholic Priest, Father Glasberg (played by Auteuil himself), and humanitarian activist, Lili Tager (Luàna Bajrami), they race against time to save the lives of as many children as possible. Premiering in the UK after its acclaimed debut at Cannes, this is a truly groundbreaking film, exposing the full extent of French collaboration with the Nazi regime.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787765656332temp-1787765656286-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787765656605temp-1787765656569-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/a8d10f839237e97bfb4c73e239d93fa5.jpg\",\"unballoted\":true,\"details\":{\"country\":\"France\",\"language\":\"French\",\"runtime\":\"100\",\"subtitle_language\":\"English\",\"year\":\"2026\"},\"credits\":{\"animator\":null,\"cast\":\"\",\"cinematographer\":\"\",\"co_producer\":null,\"composer\":null,\"director\":\"Daniel Auteuil\",\"editor\":\"\",\"executive_producer\":\"\",\"filmmaker\":null,\"music\":null,\"producer\":\"\",\"production_design\":null,\"screenwriter\":\"\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785262\",\"name\":\"Dramas\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785281\",\"name\":\"Gala Film\",\"color\":\"#ffc636\",\"visible\":true}],\"imdb_id\":\"tt35422726\",\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-26T16:41:58.702Z\",\"updated_at\":\"2026-08-26T17:34:16.284Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T14:38:42.312Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4ae0\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"The Wedding Entertainer\\n(The Tale of Moishe Badhan)\",\"description\":\"<h4>This film will be shown in Screen 11</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £11.99</strong></p><p><strong>Senior: £11.49</strong></p><p><strong>Student: £9.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Cineworld Manchester: Didsbury. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Cineworld, you can log in, otherwise click \\\"Continue as Guest\\\" to proceed.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Cineworld directly.</p><p>Box Office: 0330 333 4444</p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Cineworld Manchester: Didsbury\",\"venue\":{\"id\":\"6a3000f01f63771bc47851f5\",\"name\":\"Cineworld Manchester: Didsbury\",\"short_name\":\"Cineworld Didsbury\",\"description\":\"For all booking enquiries, please call the venue directly: 0330 333 4444\",\"address\":\"Parrs Wood Entertainment Centre, Wilmslow Rd, Didsbury, Manchester M20 5PG\",\"default_capacity\":null,\"color\":\"#3697ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-22T16:30:00.000Z\",\"end_time\":\"2026-11-22T18:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3463\",\"name\":\"Manchester\",\"color\":\"#8d95ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.cineworld.co.uk/order/showtimes/051-248621/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a8f1e17af6296becd5a398b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Wedding Entertainer (The Tale of Moishe Badhan)\",\"sort_key\":\"Wedding Entertainer (The Tale of Moishe Badhan), The\",\"description\":\"<p>An uproarious comedy of errors crossed with a modern Jewish folktale. Moishe (Shuli Rand) used to be the most sought-after Badhan (Hasidic wedding entertainer) in all of Jerusalem. These days, he can’t find a job. Now Moishe must find the money to pay his daughter’s dowry. Fortunately, his wealthy childhood best friend, Bomchik (Tal Friedman), has returned for his son’s wedding. Moishe hopes to persuade Bomchik to hire him as the Badhan. There’s just one problem: Bomchik has already hired someone else. After its World Premiere at the Tribeca Film Festival in New York, this delightful film has been nominated for 12 Israel Film Academy Awards.</p>\",\"cover_image\":\"https://static-a.eventive.org/ff0b3cc54bde4babea140f9b4b60c325.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/1787764771106temp-1787764771064-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/722f7671900a75a2e341d9d1e910a479.jpg\",\"unballoted\":true,\"details\":{\"country\":\"United States, Israel\",\"language\":\"Hebrew, Yiddish\",\"runtime\":\"111\",\"subtitle_language\":\"English\",\"year\":\"2026\"},\"credits\":{\"animator\":null,\"cast\":\"\",\"cinematographer\":\"\",\"co_producer\":null,\"composer\":\"\",\"director\":\"Gidi Dar\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":\"\",\"production_design\":null,\"screenwriter\":\"\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478525f\",\"name\":\"Comedies\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478525e\",\"name\":\"Israeli Films\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785281\",\"name\":\"Gala Film\",\"color\":\"#ffc636\",\"visible\":true},{\"id\":\"6aa81064882ff1e9f1be27c4\",\"name\":\"Centrepiece Gala\",\"color\":\"#608ea4\",\"visible\":true}],\"imdb_id\":\"tt9123406\",\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-26T17:10:47.082Z\",\"updated_at\":\"2026-09-14T15:19:22.984Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T14:41:44.273Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4ae8\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British Jewish Life on Film: Nottingham\",\"description\":\"<h4>This film will be shown in Screen 3</h4><p><strong>PRICES:</strong></p><p><strong>Standard Seat: £12.00</strong></p><p><strong>Seniors (60+) / Blue Light: £10.00</strong></p><p><strong>Students (with valid ID): £9.00</strong></p><p><strong>Disabled, Unwaged: £8.00</strong></p><p><strong>Under 18s: £7.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Broadway Cinema, Nottingham. Clicking the \\\"Order Tickets\\\" will take you to their booking website.</p><p>All orders placed with Broadway Cinema will be subject to a fee of £1.50.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Broadway Cinema directly.</p><p>Box Office: 0115 952 6611 (Open daily from 12.00pm)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><span style=\\\"color: rgb(44, 54, 58);\\\">We're particularly proud to be screening </span><em style=\\\"color: rgb(44, 54, 58);\\\">The Goyfriend</em><span style=\\\"color: rgb(44, 54, 58);\\\"> as part of our selection. The film is set in Nottingham and is written by and stars Jen Hulman who was brought up in the Nottingham Jewish community.&nbsp;</span></p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">﻿This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Nottingham Broadway\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ee\",\"name\":\"Nottingham Broadway\",\"short_name\":\"Nottingham Broadway\",\"description\":\"For all booking enquiries, please call the venue directly: 0115 952 6611\",\"address\":\"Nottingham Broadway\\n14-18 Broad St\\nNottingham NG1 3AL\",\"default_capacity\":null,\"color\":\"#7fff36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_categories\":[]},\"is_dated\":true,\"start_time\":\"2026-11-22T17:30:00.000Z\",\"end_time\":\"2026-11-22T19:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://broadway.org.uk/book/1239001\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Jack Levy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.572Z\",\"updated_at\":\"2026-09-09T11:18:46.060Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b0b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"sort_key\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"description\":\"<p>Rachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931939299temp-1787931939249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931938446temp-1787931938410-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English, Welsh\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Talia Smith\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b08\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Dead Parent Club\",\"sort_key\":\"Dead Parent Club, The\",\"description\":\"<p>Ollie’s dad has unexpectedly died, and neither is ready to let go. With an unlikely sidekick, Ollie embarks on a chaotic, thoughtful quest for peace.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384640832temp-1789384640425-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384641823temp-1789384641080-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384635564temp-1789384634882-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Mark Fleischmann\",\"producer\":\"Jesse Romain\",\"screenwriter\":\"Mark Fleischmann\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.576Z\",\"updated_at\":\"2026-09-14T11:17:20.423Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.569Z\",\"updated_at\":\"2026-08-28T15:45:16.569Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T11:05:29.195Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1791216060692temp-1791216060586-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1791216060950temp-1791216060865-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4ae4\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: Brighton\",\"description\":\"<h4>This film will be shown in Screen !</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £14.50</strong></p><p><strong>Students / Over 60s (with valid ID): £14.50</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Duke's at Komedia Brighton\",\"venue\":{\"id\":\"6a3000f01f63771bc47851eb\",\"name\":\"Duke's at Komedia Brighton\",\"short_name\":\"Dukes at Komedia\",\"description\":\"For all booking enquiries, please call Picturehouse directly on 0871 902 5747.\",\"address\":\"Brighton Komedia\\nGardner House\\n44-47 Gardner St\\nBrighton BN1 1UN\\n\",\"default_capacity\":null,\"color\":\"#ffbc57\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_categories\":[]},\"is_dated\":true,\"start_time\":\"2026-11-22T18:00:00.000Z\",\"end_time\":\"2026-11-22T20:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/019-41534/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Jack Levy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.572Z\",\"updated_at\":\"2026-09-09T11:18:46.060Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b0b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"sort_key\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"description\":\"<p>Rachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931939299temp-1787931939249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931938446temp-1787931938410-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English, Welsh\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Talia Smith\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6aa7d5e53dcc4c2b42caa9cb\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Carry with Both Hands\",\"sort_key\":\"Carry with Both Hands\",\"description\":\"<p>Leah is caught in the middle of her family's divided view points on politics, culture and religious identity, and the ever-changing boundaries of acceptance.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384500328temp-1789384499778-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384227538temp-1789384226485-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384226256temp-1789384225349-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"runtime\":\"15\",\"year\":\"2026\"},\"credits\":{\"director\":\"Tim Rogg\",\"producer\":\"Andrew St Maur\",\"screenwriter\":\"Paz Kaiba\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-09-14T11:09:25.161Z\",\"updated_at\":\"2026-09-14T11:14:59.776Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.569Z\",\"updated_at\":\"2026-08-28T15:45:16.569Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-13T10:18:39.136Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1791216071945temp-1791216071821-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1791216072303temp-1791216072204-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4aec\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"We Met at Grossinger's\",\"description\":\"<h4>This film will be shown in Cinema 1</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £11.15</strong></p><p><strong>Concession (Student, Senior Citizen, Disability): £9.15</strong></p><p><strong>Unwaged: £7.95</strong></p><p><br></p><p>Tickets for this event are sold directly through HOME Cinema Manchester. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact HOME directly.</p><p>Box Office: 0161 200 1500</p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"HOME Manchester\",\"venue\":{\"id\":\"6a3000f01f63771bc47851f0\",\"name\":\"HOME Manchester\",\"short_name\":\"HOME Manchester\",\"description\":\"For all booking enquiries, please call the venue directly: 0161 200 1500\",\"address\":\"2 Tony Wilson Place\\nManchester\\nM15 4FN\",\"default_capacity\":null,\"color\":\"#8d95ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-23T18:15:00.000Z\",\"end_time\":\"2026-11-23T20:15:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3463\",\"name\":\"Manchester\",\"color\":\"#8d95ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.homemcr.org/spektrix/ChooseSeats?EventInstanceId=2038601ADGSDNPHDLCPQJJRLPGKRLTPSB\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b43\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"We Met at Grossinger's\",\"sort_key\":\"We Met at Grossinger's\",\"description\":\"<p>Grossinger’s was the fabled Jewish holiday resort in the Catskill Mountains, New York State — the so-called ‘Borscht Belt’. It was the inspiration for the setting of the all-time classic film, Dirty Dancing. In its golden era in the 50s and 60s, it welcomed luminaries like First Lady, Eleanor Roosevelt, legendary comedian, Jerry Lewis, baseball star, Jackie Robinson, and Hollywood royalty, Elizabeth Taylor, through its hallowed doors. We are taken on a journey through the resort's full chronological history: from its initial founding by the Grossinger family, up to the present-day plans to redevelop the site.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931967574temp-1787931967513-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931966499temp-1787931966454-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=oB86n-qIaII\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"104\",\"language\":\"English\",\"country\":\"USA\"},\"credits\":{\"director\":\"Paula Eiselt\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b44\",\"name\":\"International Documentary Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.686Z\",\"updated_at\":\"2026-09-03T10:09:05.775Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-12T16:28:24.954Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4af4\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: Oxford\",\"description\":\"<h4>This film will be shown in Screen 1</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £14.50</strong></p><p><strong>Students / Over 60s (with valid ID): £10.99</strong></p><p><strong>Universal Credit (with valid ID): £6.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas.</p><p>Clicking the \\\"Order Tickets\\\" will take you to their booking website.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Phoenix Picturehouse Oxford\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ef\",\"name\":\"Phoenix Picturehouse Oxford\",\"short_name\":\"Phoenix Oxford\",\"description\":\"For all booking enquiries, please call Picturehouse directly on 0871 902 5747.\",\"address\":\"Phoenix Picturehouse Oxford\\n57 Walton Street\\nOxford\\nOX2 6AE\",\"default_capacity\":null,\"color\":\"#3697ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-24T18:30:00.000Z\",\"end_time\":\"2026-11-24T20:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/014-39560/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Jack Levy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.572Z\",\"updated_at\":\"2026-09-09T11:18:46.060Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b0b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"sort_key\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"description\":\"<p>Rachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931939299temp-1787931939249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931938446temp-1787931938410-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English, Welsh\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Talia Smith\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\