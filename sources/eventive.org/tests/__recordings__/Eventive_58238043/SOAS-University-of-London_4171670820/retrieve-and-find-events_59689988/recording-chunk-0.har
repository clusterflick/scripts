l_intervals\":null},{\"id\":\"6a5f8a8b2429d5da2fd4d544\",\"name\":\"Passholder Tickets\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3f365982c54a60687e\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0bd\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"THE FRIGHT STUFF\",\"sort_key\":\"FRIGHT STUFF, THE\",\"description\":\"<p>An all-access documentary that takes the viewer behind the scenes of the haunted house industry in America. A fascinating exploration into the beginnings of haunted houses and the 365-day pursuit to give people the fright of their lives, every aspect of the business is detailed from its amazing origins to where the culture is now. Producer and main interviewee John Laflamboy ran the Statesville Haunting Prison in Joliet, Illinois, and his reminiscences of his ups and downs will amaze non-Americans especially with regard to the haunted house construct that sunk in a storm!</p>\",\"cover_image\":\"https://static-a.eventive.org/1784973556264temp-1784973556178-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"71\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Mike Meyer\",\"cast\":\"John Laflamboy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e05c\",\"name\":\"Documentary\",\"color\":\"#cef2ec\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.660Z\",\"updated_at\":\"2026-07-25T11: