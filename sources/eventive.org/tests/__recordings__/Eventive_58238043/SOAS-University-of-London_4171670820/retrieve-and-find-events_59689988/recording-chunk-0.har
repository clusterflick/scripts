reening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b08\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Dead Parent Club\",\"sort_key\":\"Dead Parent Club, The\",\"description\":\"<p>Ollie’s dad has unexpectedly died, and neither is ready to let go. With an unlikely sidekick, Ollie embarks on a chaotic, thoughtful quest for peace.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384640832temp-1789384640425-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384641823temp-1789384641080-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384635564temp-1789384634882-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Mark Fleischmann\",\"producer\":\"Jesse Romain\",\"screenwriter\":\"Mark Fleischmann\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f