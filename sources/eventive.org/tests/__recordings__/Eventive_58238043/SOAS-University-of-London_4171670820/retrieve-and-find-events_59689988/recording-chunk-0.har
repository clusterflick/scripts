icket\",\"price\":0,\"unlimited\":false,\"quantity\":10,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":0,\"reserved_seating_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858bf8e63c2fcc29955639\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e092\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"RUBBERHEAD: THE LIFE & MONSTERS OF STEVE JOHNSON\",\"sort_key\":\"RUBBERHEAD: THE LIFE & MONSTERS OF STEVE JOHNSON\",\"description\":\"<p>Known for his intense work ethic, perfectionism, and obsession with breaking new ground, Steve Johnson has created iconic creature effects for some of the most beloved horror and sci-fi movies in cinema history. A deeply personal documentary/memoir providing an educational portrait of the golden age of special effects makeup, including AN AMERICAN WEREWOLF IN LONDON, PREDATOR and GHOSTBUSTERS. Steve shares endless outrageous anecdotes about his freewheeling adventures in Hollywood, while also telling the inspirational but tragic story of his meteoric rise and subsequent fall from grace. A humorous and heartfelt portrait of one of Hollywood’s most prolific monster makers.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784763026648temp-1784763026631-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"104\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"European\",\"rating\":\"18\"},\"credits\":{\"director\":\"Nick Taylor\",\"cast\":\"Steve Johnson, Linnea Quigley, Tom Holland, Rick Baker\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e05c\",\"name\":\"Documentary\",\"color\":\"#cef2ec\",\"visible\":true