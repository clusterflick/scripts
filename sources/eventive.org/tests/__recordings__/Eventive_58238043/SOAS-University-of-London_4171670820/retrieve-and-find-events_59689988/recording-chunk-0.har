ng_category\":\"3\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a5fb17e7d6a3e5e6e0d7260\",\"name\":\"Passholder Ticket\",\"price\":0,\"unlimited\":false,\"quantity\":18,\"quantity_sold\":17,\"quantity_scanned\":0,\"quantity_remaining\":1,\"reserved_seating_category\":\"4\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[\"6a804e190a759551798b743a\",\"6a858c3034cfd46f50cd2c00\"],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e039\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"CLAIMING YOUR NON-DEPENDENCE\",\"sort_key\":\"CLAIMING YOUR NON-DEPENDENCE\",\"description\":\"<p>Join Producer/Director Jen Handorf and a panel of independent filmmakers for a frank discussion on getting your film made without waiting for permission. From funding workarounds to building your own audience, this session digs into the practical realities of self-reliant filmmaking and self-distribution.  Whether you're stuck on your first short or ready to take your finished film directly to audiences, come away with ideas, actionable plans, and the confidence to find your own route to getting seen.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784763040670temp-1784763040662-cover.jpg\",\"unballoted\":false,\"details\":{\"sponsor\":\"FILM SUSSEX\"},\"credits\":{},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a5e1af9ae9bbda67f65e03a\",\"name\":\"Special Event\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.484Z\",\"updated_at\":\"2026-08-05T23:27:57.037Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:13:43.785Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank you for your order.&nbsp;Please find below your ticket. You just need to produce this on your phone where a member of our team will scan it.&nbsp;<strong>Please arrive on time – there are no trailers.&nbsp;Latecomers may be denied entry.</strong></p><p>&nbsp;</p><p>PLEASE NOTE:- FrightFest is a horror, fantasy, science fiction and thriller film based event for over 18s. Films shown will feature an assortment of the following: supernatural/alien threats, strong language, upsetting scenes, violence, gore, blood, rape, suicide, monstrous menace, tobacco products, creature mayhem, psychological intimidation, sexual imagery, death, child endangerment, maiming, religious profanity, abusive behaviour, bullying, nudity, drug use, strobe lighting and racial stereotyping.</p><p>&nbsp;</p><p>Please Note: This is an <strong>over 18’s</strong> event and no children are allowed entry.&nbsp;All sales are final.&nbsp;<strong>FrightFest does not refund tickets</strong>.&nbsp;</p><p>&nbsp;</p><p>Please ensure you have read and agree to the FrightFest Code of Conduct before attending. This can be found here: <a href=\\\"https://www.frightfest.co.uk/conduct/\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p><p>&nbsp;</p><p>For any queries please contact: <a href=\\\"mailto:tickets@frightfest.co.uk\\\" target=\\\"_blank\\\">tickets@frightfest.co.uk</a>&nbsp;</p>\",\"ledger_tags\":[],\"rules\":[],\"terms_at_checkout\":\"<p>I confirm I am over 18. ID may be required. All sales are final and no refunds are given.</p><p>&nbsp;</p><p>I have read and agree to the FrightFest Code of Conduct.</p><p>&nbsp;</p><p><a href=\\\"https://www.frightfest.co.uk/conduct/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">https://www.frightfest.co.uk/conduct/</a></p>\"},{\"id\":\"6a5ea8a6f4ac0bac8eff48cc\",\"event_bucket\":\"6a17699850d66159f2035097\",\"timezone\":\"Europe/London\",\"name\":\"CRAZY LIPS\",\"description\":\"\",\"short_description\":\"\",\"location\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"venue\":{\"id\":\"6a4d7692d104ae98644c1bbc\",\"name\":\"ODEON Luxe Leicester Square - Discovery Screen 4\",\"short_name\":\"Discovery Screen 4\",\"description\":\"\",\"address\":\"23-26 Leicester Square, London.  WC2H 7JY.\",\"default_capacity\":40,\"color\":\"#c8cdd0\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"6b3f0bd6-f219-b12b-c112-ce0741445a23\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"House\",\"color\":\"#4176A5\",\"_id\":\"6a91747e38c1ba4a4427323c\"},{\"key\":\"2\",\"label\":\"Single Ticket\",\"color\":\"#F53F3F\",\"_id\":\"6a91747e38c1ba4a4427323d\"},{\"key\":\"3\",\"label\":\"Passholder Ticket\",\"color\":\"#FBA700\",\"_id\":\"6a91747e38c1ba4a4427323e\"},{\"key\":\"4\",\"label\":\"House\",\"color\":\"#B2AFB0\",\"_id\":\"6a91747e38c1ba4a4427323f\"}]},\"is_dated\":true,\"start_time\":\"2026-08-30T14:20:00.000Z\",\"end_time\":\"2026-08-30T16:13:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enab