films\":[{\"id\":\"6a91ad0c20625c9624c04b66\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Lansky: The Jewish Godfather\",\"sort_key\":\"Lansky: The Jewish Godfather\",\"description\":\"<p>Notorious Jewish gangster, Meyer Lansky, has become something of a semi-mythical figure in the cultural imagination. This documentary takes a closer look at the real person behind the legend — from his humble origins as a Jewish immigrant to New York, through his meteoric rise within the world of prohibition-era organised crime, up to his anti-Nazi street fighting activities in the lead up to World War Two. It also explores a lesser-known part of Lansky’s legacy — his support for the nascent State of Israel. Featuring interviews with Lansky’s descendants, this is a captivating portrait of a complex Jewish man.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790610555170temp-1790610555072-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790610555561temp-1790610555351-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790610554807temp-1790610554611-still.jpg\",\"trailer_url\":\"https://youtu.be/9yTT83h0qSw\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"77\",\"language\":\"Hebrew, English\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Avi Marzuk\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b64\",\"name\":\"Mavericks Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.737Z\",\"updated_at\":\"2026-09-30T10:22:47.279Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:44:26.070Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e7415f2c5e1404d8f6\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Young Jury Awards 2026\",\"description\":\"<p><strong>PRICES:</strong></p><p><strong>Adult Standard: £6.00</strong></p><p><br></p><p>Don’t miss our Young Jury of filmmakers and film enthusiasts celebrating some of the best short films of this year’s festival.</p><p><br></p><p>Aged 18–30, the jury has selected their top choices from the variety of brilliant short films programmed this year. They’ll be screening their favourite films, awarding the winner, and explaining their choices in a post-screening panel discussion.</p><p><br></p><p>Followed by a complimentary drink and an after-party in the bar.</p><p><br></p><p>Jurors: Bella Darnley, Sasha Georgette, Rafaela Golding, Charlie Harris, Alexandra Hougie, Sam Joseph, Lily Lefkow, Shaked Lev, Hannah Loveridge, Mia Pereira-Mendoza, India Rose, Ben Rusnak, Malka Weissler.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"JW3 Cinema\",\"venue\":{\"id\":\"6a3000f01f63771bc4785204\",\"name\":\"JW3 Cinema\",\"short_name\":\"JW3 Cinema\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"341-351 Finchley Road \\nLondon \\nNW3 6ET\",\"default_capacity\":null,\"color\":\"#ff6b94\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"9b66676b-bdd5-0983-1fcb-f293379a36cd\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ab262e9d7f848654e9c8e14\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call UKJF to book)\",\"color\":\"#4176A5\",\"_id\":\"6ab262e9d7f848654e9c8e15\"},{\"key\":\"3\",\"label\":\"Companion Seat (Call UKJF to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ab262e9d7f848654e9c8e16\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6ab262e9d7f848654e9c8e17\"},{\"key\":\"5\",\"label\":\"House Seats\",\"color\":\"#5d5d5d\",\"_id\":\"6ab262e9d7f848654e9c8e18\"}]},\"is_dated\":true,\"start_time\":\"2026-11-12T19:00:00.000Z\",\"end_time\":\"2026-11-12T21:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc4785269\",\"name\":\"Short Films\",\"color\":\"#fffc36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_