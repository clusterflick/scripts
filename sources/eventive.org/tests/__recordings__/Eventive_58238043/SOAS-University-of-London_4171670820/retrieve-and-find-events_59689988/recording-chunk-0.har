,\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e0ab\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"SWEET VIOLENCE\",\"sort_key\":\"SWEET VIOLENCE\",\"description\":\"<p>In the tradition of such past FrightFest favourites as BIG BAD WOLVES and RABIES come the feature debut of the most exciting talent in South America. After cutting his teeth on the short film festival circuit with LA MUJER ROTA (2012), TOOTH FAIRY (2017) and LA HORA AZUL (2022), Jermias Segovia now bursts on to the international scene with  a gritty shocker. A family plans to murder their daughter’s killer after he is released from a twenty-year prison sentence. Still pleading innocence, the ex-convict tries to rebuild his life until the ghosts of the past return to haunt him  </p>\",\"cover_image\":\"https://static-a.eventive.org/1784579629361temp-1784579629296-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"93\",\"language\":\"Uruguay\",\"country\":\"Uruguay\",\"premiere\":\"UK\",\"rating\":\"18\",\"genre\":\"Spanish\"},\"credits\":{\"director\":\"Jeremias Segovia\",\"cast\":\"Esteban Bigliardi, Javier Chavez, Eduardo Miglionico, Mirella Pascual\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.632Z\",\"updated_at\":\"2026-07-25T11:37:53.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:00:32.428Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtua