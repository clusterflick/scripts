c57894d28\",\"name\":\"Adult Standard (Concession with valid ID)\",\"price\":1300,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6ac7ca8115eb6fbc57894d2c\",\"name\":\"Premium Seats (Concession with valid ID)\",\"price\":1400,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b54\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rosenthal: The Great Showman\",\"sort_key\":\"Rosenthal: The Great Showman\",\"description\":\"<p>A remarkable retelling of a true story, based on the life of beloved German-Jewish television host, Hans Rosenthal. Germany, 1978: Hans (Florian Lukas) has risen to the very top of the light entertainment world, with his wildly successful nightly quiz show Dalli, Dalli. To maintain his jovial persona, Hans hides his Jewish identity and his past as a Holocaust survivor from his adoring audience. But when the 40th anniversary of Kristallnacht falls on the same night as the live special anniversary edition of Dalli, Dalli, Hans must decide what is more important to him — maintaining this façade, or confronting the hard truths of the past.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931979261temp-1787931979224-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931978222temp-1787931978186-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=4f0csTLccBA\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"93\",\"language\":\"German\",\"country\":\"Germany\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Oliver Haffner\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b55\",\"name\":\"German Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"69867f136062a95e658fcbe9\",\"type\":\"vod\",\"label\":\"rosenthal_-_feature_v1 (1080p).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"6af803f6-9775-4776-ad77-914ef5609243\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":5571006.666999999,\"file_size\":2878459245,\"created_at\":\"2026-02-06T23:53:55.669Z\",\"updated_at\":\"2026-10-08T19:21:29.223Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-08-28T15:45:16.710Z\",\"updated_at\":\"2026-09-03T10:00:31.707Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:52:08.903Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6ac392ec229d318fd46e46b3\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"The Soundman\",\"description\":\"<h6>\\\"This film is a standout: meditative, innovative, and profoundly moving.\\\"&nbsp;</h6><h3><em>The Hollywood Times</em></h3><h6>\\\"The Soundman is a film like an opera, where music, play and image come together in optimal synergy\\\"</h6><h3><em>Cinemagazine</em></h3><h6>“The Soundman is a poetic declaration of love to the world of sound and at the same time a moving historical drama”</h6><h3><em>Moviebreak</em></h3><p><br></p><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £14.50</strong></p><p><strong>Students / Over 60s (with valid ID): £10.99</strong></p><p><strong>Universal Credit (with valid ID): £6.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p><br></p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p><br></p><p><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Duke's at Komedia Brighton\",\"venue\":{\"id\":\"6a3000f01f63771bc47851eb\",\"name\":\"Duke's at Komedia Brighton\",\"short_name\":\"Dukes at Komedia\",\"description\":\"For all booking enquiries, please call Picturehouse directly on 0871 902 5747.\",\"address\":\"Brighton Komedia\\nGardner House\\n44-47 Gardner St\\nBrighton BN1 1UN\\n\",\"default_capacity\":null,\"color\":\"#ffbc57\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_categories\":[]},\"is_dated\":true,\"start_time\":\"2026-11-26T18:00:00.000Z\",\"end_time\":\"2026-11-26T20:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/019-41535/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b4d\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Soundman\",\"sort_key\":\"Soundman, The\",\"description\":\"<p>A beautiful portrayal of young love swept up by the dark tides of history, and a remarkable cinematic depiction of sound. In May 1940, German forces are massing along the borders of Belgium, Luxembourg, and the Netherlands. At a Brussels radio station, Elza (Femke Vanhove) is a talented young voice actor. She’s also, secretly, a Jewish refugee from Vienna. Meanwhile, Berre (Jef Hellemans) is an innovative introverted sound engineer, who creates the sound effects for the station's radio plays. The two fall deeply in love, but as war looms, and Elza’s true identity is exposed, their relationship is put to the ultimate test.</p>\",\"cover_image\":\"https://static-a.eventive.org/1791287981705temp-1791287981644-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1791287989805temp-1791287989748-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1791287989517temp-1791287989461-still.jpg\",\"trailer_url\":\"https://youtu.be/cmLvljVT4pY?si=DMJa4OoocUQVXSSI\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"120\",\"language\":\"Dutch, Hebrew\",\"country\":\"Belgium\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Frank Van Passel\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4f\",\"name\":\"Historical Drama\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b50\",\"name\":\"Dutch Language\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.702Z\",\"updated_at\":\"2026-10-08T14:10:22.745Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-12T15:23:46.938Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4b00\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: Bath\",\"description\":\"<h4>This film will be shown in Screen 2</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £14.50</strong></p><p><strong>Students / Over 60s (with valid ID): £10.99</strong></p><p><strong>Universal Credit (with valid ID): £6.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas.</p><p>Clicking the \\\"Order Tickets\\\" will take you to their booking website.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Little Theatre Cinema Bath\",\"venue\":{\"id\":\"6a3000f01f63771bc47851fe\",\"name\":\"Little Theatre Cinema Bath\",\"short_name\":\"Little Theatre Cinema Bath\",\"description\":\"For all booking enquiries, please call Picturehouse directly on 0871 902 5747.\",\"address\":\"The Little Theatre Cinema\\nSt Michael's Place\\nBath\\nBA1 1SG\",\"default_capacity\":null,\"color\":\"#ff8fdc\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-26T18:30:00.000Z\",\"end_time\":\"2026-11-26T20:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/003-43846/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Jack Levy\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.572Z\",\"updated_at\":\"2026-09-09T11:18:46.060Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b0b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"sort_key\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"description\":\"<p>Rachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931939299temp-1787931939249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931938446temp-1787931938410-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English, Welsh\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Talia Smith\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b08\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Dead Parent Club\",\"sort_key\":\"Dead Parent Club, The\",\"description\":\"<p>Ollie’s dad has unexpectedly died, and neither is ready to let go. With an unlikely sidekick, Ollie embarks on a chaotic, thoughtful quest for peace.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789384640832temp-1789384640425-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789384641823temp-1789384641080-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789384635564temp-1789384634882-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Mark Fleischmann\",\"producer\":\"Jesse Romain\",\"screenwriter\":\"Mark Fleischmann\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.576Z\",\"updated_at\":\"2026-09-14T11:17:20.423Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b04\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oslo Court\",\"sort_key\":\"Oslo Court\",\"description\":\"<p>A film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931932656temp-1787931932612-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931931811temp-1787931931771-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Hermione Oldham\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.569Z\",\"updated_at\":\"2026-08-28T15:45:16.569Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b02\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Mizrahi Mismatch\",\"sort_key\":\"Mizrahi Mismatch\",\"description\":\"<p>Judith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.</p>\",\"cover_image\":\"https://static-a.eventive.org/1790069967722temp-1790069967536-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1790069948628temp-1790069948303-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1790069967292temp-1790069966985-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Misha Mansoor\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.565Z\",\"updated_at\":\"2026-09-22T09:39:26.982Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-12T15:25:14.344Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1791216109009temp-1791216108884-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1791216109348temp-1791216109256-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4b04\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: Manchester\",\"description\":\"<h4>This film will be shown in Cinema 1</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £11.15</strong></p><p><strong>Concession (Student, Senior Citizen, Disability): £9.15</strong></p><p><strong>Unwaged: £7.95</strong></p><p><br></p><p>Tickets for this event are sold directly through HOME Cinema Manchester. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact HOME directly.</p><p>Box Office: 0161 200 1500</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><span style=\\\"color: rgb(44, 54, 58);\\\">One of the films we're screening tonight is </span><em style=\\\"color: rgb(44, 54, 58);\\\">Rambling</em><span style=\\\"color: rgb(44, 54, 58);\\\">, which tells the story of a Manchester-based walking group. Local interest is further enhanced by the director of </span><em style=\\\"color: rgb(44, 54, 58);\\\">The Goyfriend</em><span style=\\\"color: rgb(44, 54, 58);\\\">, Ashley Margolis, who was brought up in Manchester,&nbsp;and will be attending a Q&amp;A after the screening alongside Jack Levy, the director of </span><em style=\\\"color: rgb(44, 54, 58);\\\">Rambling.</em></p><p><br></p><p><span style=\\\"color: rgb(255, 255, 255);\\\">﻿</span><strong style=\\\"color: rgb(255, 255, 255); background-color: rgb(43, 41, 37);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"HOME Manchester\",\"venue\":{\"id\":\"6a3000f01f63771bc47851f0\",\"name\":\"HOME Manchester\",\"short_name\":\"HOME Manchester\",\"description\":\"For all booking enquiries, please call the venue directly: 0161 200 1500\",\"address\":\"2 Tony Wilson Place\\nManchester\\nM15 4FN\",\"default_capacity\":null,\"color\":\"#8d95ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-29T15:45:00.000Z\",\"end_time\":\"2026-11-29T17:45:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6aa7f91cd5377103a57d3463\",\"name\":\"Manchester\",\"color\":\"#8d95ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.homemcr.org/spektrix/ChooseSeats?EventInstanceId=2039001AMHGLPPJDGBHSPBGSJQTDGVNRN\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc