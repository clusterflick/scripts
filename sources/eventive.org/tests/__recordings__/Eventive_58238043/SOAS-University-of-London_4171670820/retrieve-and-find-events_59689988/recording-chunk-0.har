3f15601f00ac84a66fa\",\"name\":\"Premium Seat (wider, more legroom)\",\"price\":2150,\"unlimited\":true,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3f15601f00ac84a6712\",\"name\":\"Two-Seater Sofa: Sold as a Pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3f15601f00ac84a6722\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3f15601f00ac84a6726\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b77\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Blue Marks\",\"sort_key\":\"Blue Marks\",\"description\":\"<p>Adapted from Emilie Moatti’s acclaimed Hebrew novel, and featuring iconic Israeli actor, Lior Ashkenazi. A beautiful but challenging story of resilience, revenge, and hope. Iris (Noa Ohayon) is an aspiring fashion designer who has relocated from Israel to Paris, to pursue her dream. Initially, the city seems to offer everything she has been looking for. But after a violent sexual assault, Iris’s life is upended, as she struggles to cope with her lingering trauma. Whilst her mother and her best friend try their best to support her emotionally, ultimately, it is Iris herself who must decide how to break free.</p><p><strong>WARNING: contains scenes of sexual violence.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1787932025916temp-1787932025890-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932025083temp-1787932025060-poster.jpg\",\"trailer_url\":\"https://youtu.be/Nk8Lh4AyRj8\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"110\",\"language\":\"Hebrew, French\",\"country\":\"Israel, France\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Dina Zvi Riklis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b78\",\"name\":\"Resilience Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.773Z\",\"updated_at\":\"2026-09-15T14:20:24.200Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:44:02.534Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e7415f2c5e1404d8f1\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"CENTREPIECE GALA: The Wedding Entertainer (The Tale of Moishe Badhan)\",\"description\":\"<h1>CENTREPIECE GALA</h1><h2>Sponsored by Rosemarie Nathanson Charitable Trust</h2><h3>+ Q&amp;A with director-writer Gidi Dar</h3><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £30.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>For all enquiries relating to your booking, please contact Curzon directly.</p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/b9cd40bf7c256971fb536f7e102c0115.png\\\" width=\\\"175\\\"></p>\",\"short_description\":\"\",\"location\":\"Curzon Mayfair\",\"venue\":{\"id\":\"6a3000f01f63771bc478520c\",\"name\":\"Curzon Mayfair\",\"short_name\":\"Curzon Mayfair\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838\",\"address\":\"Curzon Mayfair\\n38 Curzon St\\nLondon W1J 7TY\",\"default_capacity\":null,\"color\":\"#608ea4\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"cd261459-295f-302d-71e8-8c70ad0ba790\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"675c5c67a9d65c62d8dea834\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call box office to book)\",\"color\":\"#4176A5\",\"_id\":\"675c5c67a9d65c62d8dea835\"},{\"key\":\"3\",\"label\":\"Guests\",\"color\":\"#d3d3d3\",\"_id\":\"675c5c67a9d65c62d8dea836\"},{\"key\":\"4\",\"label\":\"Companion Seat (Call box office to book)\",\"color\":\"#49A3BA\",\"_id\":\"675c5c67a9d65c62d8dea837\"}]},\"is_dated\":true,\"start_time\":\"2026-11-12T18:00:00.000Z\",\"end_time\":\"2026-11-12T20:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/MAY1-34613/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a8f1e17af6296becd5a398b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Wedding Entertainer (The Tale of Moishe Badhan)\",\"sort_key\":\"Wedding Entertainer (The Tale of Moishe Badhan), The\",\"description\":\"<p>An uproarious comedy of errors crossed with a modern Jewish folktale. Moishe (Shuli Rand) used to be the most sought-after Badhan (Hasidic wedding entertainer) in all of Jerusalem. These days, he can’t find a job. Now Moishe must find the money to pay his daughter’s dowry. Fortunately, his wealthy childhood best friend, Bomchik (Tal Friedman), has returned for his son’s wedding. Moishe hopes to persuade Bomchik to hire him as the Badhan. There’s just one problem: Bomchik has already hired someone else. After its World Premiere at the Tribeca Film Festival in New York, this delightful film has been nominated for 12 Israel Film Academy Awards.</p>\",\"cover_image\":\"https://static-a.eventive.org/ff0b3cc54bde4babea140f9b4b60c325.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/1787764771106temp-1787764771064-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/722f7671900a75a2e341d9d1e910a479.jpg\",\"unballoted\":true,\"details\":{\"country\":\"United States, Israel\",\"language\":\"Hebrew, Yiddish\",\"runtime\":\"111\",\"subtitle_language\":\"English\",\"year\":\"2026\"},\"credits\":{\"animator\":null,\"cast\":\"\",\"cinem