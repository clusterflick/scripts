ctions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"still\":\"https://static-a.eventive.org/1788794123833temp-1788794123701-default.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9ec382b8ce534df6e8ba0c\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Family Matters (Shorts Programme)\",\"description\":\"<p><strong>PRICE:</strong></p><p><strong>All online shorts packages are completely free to watch.</strong></p><p>Running time: 63 mins.</p><p><br></p><p>Beautiful and tender films, exploring the fundamental importance of family bonds: how family roots us, uplifts us, and steers us through the darkest of times.</p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc4785278\",\"name\":\"Short Film Programme\",\"color\":\"#f2416e\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6a9ec382b8ce534df6e8ba0f\",\"name\":\"Virtual Admission\",\"price\":0,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":20,\"quantity_scanned\":0,\"quantity_remaining\":130,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a61c76cf8ed275fee85e561\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Butterfly\",\"sort_key\":\"Butterfly\",\"description\":\"<p>Nominated for Best Animated Short Film at the 2026 Oscars, this mesmerising short, entirely hand-painted in oils and pastels on glass, follows the extraordinary and tragic life of Alfred Nakache, a French-Jewish Olympic swimmer, and Auschwitz survivor, and the family he was devoted to, and for whose love he kept on surviving. Winner of the Crystal Bear for Best Short Film, at the Berlin International Film Festival, 2024. Also winner of the André Martin Award for Best French Short Film at the Annecy International Animation Film Festival, 2024, and César Award nominee for Best Animated Short Film, in 2025. </p>\",\"cover_image\":\"https://static-a.eventive.org/1789657614749temp-1789657614691-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789657551818temp-1789657551760-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789657614485temp-1789657614344-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"France\",\"language\":\"French\",\"runtime\":\"15\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Florence Miailhe\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b1e\",\"name\":\"Family Matters\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a61c77bbcc1a7d2006797be\",\"type\":\"vod\",\"label\":\"PAPILLON_H.264_VO.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"de65083b-2a63-483a-af0f-1058f573ca39\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":900010.667,\"file_size\":2974167678,\"created_at\":\"2026-07-23T07:49:15.743Z\",\"updated_at\":\"2026-07-23T07:49:15.759Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-07-23T07:49:00.023Z\",\"updated_at\":\"2026-09-17T15:06:54.342Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c1d7c102d5d6d62085c4\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Parents\",\"sort_key\":\"Parents\",\"description\":\"<p>A touching and gentle film, embracing grief, and the strong pull of family. Noah, carer for his father with dementia, attends the wedding of his ex-girlfriend, Hannah. They still care deeply about each other, forever bound together by the death of their daughter. Starring Katrine Greis-Rosenthal (The Bridge) and Niklas Herskind (Borgen).</p><p><strong>WARNING: contains themes of grief, and bad language.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1789657856518temp-1789657856476-cover.jpg\",\"po