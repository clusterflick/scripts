uantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2df6b339459d4bd9a794f\",\"name\":\"Two-Seater Sofa: Sold as a Pair\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":16,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2df6b339459d4bd9a795f\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":13,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2df6b339459d4bd9a7963\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6aa2debf0cc7efb13db3af41\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Primordial Chicken Soup\",\"sort_key\":\"Primordial Chicken Soup\",\"description\":\"<p>Friendship that lasts a lifetime — <em>Primordial Chicken Soup</em> explores the deep connection formed between eight Scouse Jewish women who first met over fifty-five years ago.</p>\",\"cover_image\":\"https://static-a.eventive.org/17573402145418ee5b38afca480808254.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/1757603415947461188370caaf75cfe7a.jpg?w=300\",\"still_image\":\"https://static-a.eventive.org/1757340225010c85d62076adb23f0f9df.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"genre\":\"Short, Documentary\",\"language\":\"English\",\"runtime\":\"5\",\"year\":\"2025\"},\"credits\":{\"director\":\"Barney Pell Scholes, Daisy Abboudi\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"697a276a2dc50f0e1d447a1c\",\"type\":\"vod\",\"label\":\"Primoridal 1920.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"408738a7-7952-4ba7-b656-d281562b7888\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":371242,\"file_size\":565679529,\"created_at\":\"2026-01-28T15:12:42.615Z\",\"updated_at\":\"2026-01-29T13:07:45.103Z\",\"platform\":\"ev_next\",\"caption_tracks\":[{\"title\":\"English\",\"url\":\"https://storage.googleapis.com/eventive-static/9b0eca99f495fcde46bef6b0e335724e.vtt\"}]},\"created_at\":\"2026-09-10T16:45:51.367Z\",\"updated_at\":\"2026-09-15T09:46:19.508Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b2c\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Maurice Dancing\",\"sort_key\":\"Maurice Dancing\",\"description\":\"<p>A delightful musical animation about the long life of Holocaust survivor, Maurice Peltz, who arrived in the UK as a refugee, in 1939, and went on to become an accomplished ballroom dancer: even dancing with the King! Set to the tune of <em>In The Mood</em>, composed by Joe Garland, and performed here by Joe Loss &amp; His Band. </p><p><br></p><p>November 5th, 2026, marks Maurice's 100th birthday.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789059362504temp-1789059362364-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789059402951temp-1789059402727-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789059402514temp-1789059402295-still.jpg\",\"trailer_url\":\"https://youtu.be/QZ-KoapkCV4\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"subtitle_language\":\"English\",\"year\":\"2026\",\"runtime\":\"4\"},\"credits\":{\"director\":\"Zoom Rockman\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785279\",\"name\":\"Animation\",\"color\":\"#62feb6\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.642Z\",\"updated_at\":\"2026-09-14T11:19:55.671Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b00\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Last Jewel\",\"sort_key\":\"Last Jewel, The\",\"description\":\"<p>At 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today's Hatton Garden, he and his shop are the last of their kind.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931928687temp-1787931928661-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931927770temp-1787931927748-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"5\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Rob Kaplan\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.561Z\",\"updated_at\":\"2026-08-28T15:45:16.561Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c113ebe054b8d17fc170\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rubinstein's\",\"sort_key\":\"Rubinstein's\",\"description\":\"<p>An anxious Jade, struggling to find a truly worthy gift for her girlfriend, steps into an antique jewellers, run by two old Jewish men. In Rubinstein's store she finds a solidarity she didn’t know she needed. Starring Anton Lesser (<em>The Crown</em>, <em>Game of Thrones</em>).</p>\",\"cover_image\":\"https://static-a.eventive.org/1789059272520temp-1789059272413-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789059279962temp-1789059279773-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789059279535temp-1789059279340-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United Kingdom\",\"language\":\"English\",\"runtime\":\"14\",\"year\":\"2025\"},\"credits\":{\"director\":\"Tommy Ross-Williams\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b26\",\"name\":\"Rainbow Collection\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a9e96804ea6c8047845932d\",\"name\":\"LGBTQ+\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785277\",\"name\":\"Pre-feature\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a7b07b47f1543daed8a5a65\",\"type\":\"vod\",\"label\":\"rubinstein's_(2026,_short)_dir._tommy_ross-williams (1080p).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"6ab6428a-6d96-4110-9c95-8042893b4c25\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":860586.667,\"file_size\":506039420,\"created_at\":\"2026-08-11T11:29:56.807Z\",\"updated_at\":\"2026-08-11T11:29:56.819Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-07-23T07:21:55.226Z\",\"updated_at\":\"2026-09-10T16:54:39.337Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b0b\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"sort_key\":\"Rachel Jones Needs a Boyfriend Not a Bat-Mitzvah\",\"description\":\"<p>Rachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931939299temp-1787931939249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931938446temp-1787931938410-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"15\",\"language\":\"English, Welsh\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Talia Smith\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b09\",\"name\":\"Changing Perspectives Film Fund\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0c\",\"name\":\"Welsh Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.580Z\",\"updated_at\":\"2026-08-28T15:45:16.580Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:47:33.880Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{\"cover\":\"https://static-a.eventive.org/1790613605058temp-1790613605007-cover.jpg\",\"avatar\":\"https://static-a.eventive.org/1790613605328temp-1790613605295-avatar.jpg\"},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708ea415f2c5e1404d93d\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"DOC DAY: Father Father\",\"description\":\"<h2>PART OF DOC DAY AT CURZON BLOOMSBURY</h2><h3>+ Q&amp;A with director Jake Witzenfeld, and protagonists Khader Abu-Seif and Aviv Agami</h3><h4>This film will be shown in Screen 5 (The Renoir)</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £20.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>For all enquiries relating to your booking, please contact Curzon directly.</p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong>This event is part of the New Israel Fund strand.</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Curzon Bloomsbury\",\"venue\":{\"id\":\"6a3000f01f63771bc47851ea\",\"name\":\"Curzon Bloomsbury\",\"short_name\":\"Curzon Bloomsbury\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838.\\nFor Customer Service queries, call: 01233 555644.\",\"address\":\"The Brunswick Centre, London WC1N 1AW\",\"default_capacity\":null,\"color\":\"#8d95ff\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-15T16:00:00.000Z\",\"end_time\":\"2026-11-15T18:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/BLO1-113622/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b83\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Father Father\",\"sort_key\":\"Father Father\",\"description\":\"<p>From director Jake Witzenfeld and British BAFTA-nominated producer Kat Mansoor comes a truly remarkable story of love conquering all. Aviv, a Jewish Israeli, and Khader, his Palestinian-Israeli husband, are trying to have a child through surrogacy. When they find out that Israeli law requires both parents to be of the same religion to be eligible, they find a surrogate in the USA instead. As their baby grows, against the backdrop of anti-government protests, the horrors of October 7th, and the following war in Gaza, Aviv and Khader's relationship will be pushed to the absolute limit.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788432511640temp-1788432511590-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788432511858temp-1788432511822-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788432511390temp-1788432511355-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"69\",\"language\":\"Hebrew, Arabic, English\",\"country\":\"Israel, UK\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Jake Witzenfeld\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b81\",\"name\":\"New Israel Fund Strand\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\"