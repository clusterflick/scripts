9c9947383c4ee\",\"name\":\"Premium Seat (wider, more legroom)\",\"price\":2150,\"unlimited\":true,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e42ec8a9c9947383c506\",\"name\":\"Two-Seater Sofa: Sold as a Pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":10,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e42ec8a9c9947383c516\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e42ec8a9c9947383c51a\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b73\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Oxygen\",\"sort_key\":\"Oxygen\",\"description\":\"<p>Described by Haaretz as the best Israeli film of 2025, Netalie Braun’s powerful and acclaimed debut film explores the lengths a mother will go to, to protect her son. Anat (Dana Igvy) is a single mother and a teacher. Her son, Ido (Ben Sultan), has recently returned from the Lebanese border, on leave from his combat unit. When fighting resumes, Ido volunteers to return to his unit, against his mother's wishes. Anat must decide how far she will go, to keep her son safe. Oxygen skilfully explores the conflict between a parent’s protective instincts and society’s demand for military sacrifice. Winner of Best Film at the Jerusalem Film Festival.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788431998285temp-1788431998228-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788431998541temp-1788431998501-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788432009090temp-1788432009045-still.jpg\",\"trailer_url\":\"https://youtu.be/XtLi4znQEjA\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"95\",\"language\":\"Hebrew\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Netalie Braun\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b6f\",\"name\":\"Perspectives Strand\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\