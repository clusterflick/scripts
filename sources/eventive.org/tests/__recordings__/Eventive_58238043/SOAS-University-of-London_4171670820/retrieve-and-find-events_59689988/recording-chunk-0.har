9\",\"name\":\"Premium Seat (wider, more legroom)\",\"price\":2150,\"unlimited\":true,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3d355f310edb1fe77f1\",\"name\":\"Two-Seater Sofa: Sold as a Pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3d355f310edb1fe7801\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e3d355f310edb1fe7805\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b46\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Holofiction\",\"sort_key\":\"Holofiction\",\"description\":\"<p>A mesmerising experimental documentary, deconstructing the tropes and repetitions that appear in fictional depictions of the Holocaust. It takes as its basis the famous Claude Lanzmann quote that attempting to depict the Holocaust in fiction represents the “gravest transgression”. Filmmaker, Michal Kosakowski, demonstrates in extraordinary detail how fictional films and television shows depicting the Holocaust frequently utilise almost identical imagery and visual motifs — sometimes even using the same actors in opposing roles. Premiering in the UK, after screening at the prestigious Venice Film Festival, this is a must-see for anyone interested in film history, or in the visual language of cinema.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788894061422temp-1788894061196-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788894061987temp-1788894061639-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788894070014temp-1788894069677-still.jpg\",\"trailer_url\":\"https://youtu.be/MPm0Czg3fng\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"102\",\"language\":\"No Dialogue\",\"country\":\"Germany Austria\"},\"credits\":{\"director\":\"Michal Kosakowski\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b44\",\"name\":\"International Documentary Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b47\",\"name\":\"Experimental Documentary\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":