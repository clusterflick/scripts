d\":\"5dd16a51cb714c002f548a83\",\"name\":\"BLOOM\",\"sort_key\":\"BLOOM\",\"description\":\"<p>In desperate straits Lily is surprised when she is contacted about a last will and testament made by her great aunt. With no love lost between this distant relative due to a past dark incident, she learns she has inherited a struggling desert nursery. It seems to be just the  answer to her financial woes and she devotes herself to bringing it back to life. But as her garden flourishes with her prize bloom, the Scarlet Widow, her need to sustain the business becomes something she can no longer control as she’s possessed by the inescapable spectre of the past.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784576818397temp-1784576818219-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"82\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Stefan Colson\",\"cast\":\"Megan Carrasquillo, Robert Craighead, Jadon Cal Fitzpatrick, Cara Leoni\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.473Z\",\"updated_at\":\"2026-07-25T11:46:25.503Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T12:16:50.594Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"custom_email_text\":\"<p>Thank 