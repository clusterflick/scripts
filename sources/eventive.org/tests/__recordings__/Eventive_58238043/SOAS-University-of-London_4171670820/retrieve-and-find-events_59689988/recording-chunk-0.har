:\"5\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e2c9c1390d73a8c2f4e3\",\"name\":\"Front Rows (standard seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":6,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6aa2e2c9c1390d73a8c2f4e7\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a300841525bdd62d12dda09\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rose\",\"sort_key\":\"Rose\",\"description\":\"<p>Françoise Fabian (My Night at Maud’s, Belle de Jour, Call My Agent), Grégory Montel (Call My Agent), and Aure Atika (The Night Manager, OSS 117: Cairo, Nest of Spies) star in this warm-hearted Parisian Jewish family drama. When patriarch, Philippe, dies, his wife, Rose, feels that her life is over. A chance dinner party, however, re-ignites her joie de vivre, much to the discomfort of her three loving but somewhat dysfunctional children. Unsure how to deal with this new vivacious version of their mother, Rose’s children's concerns can’t stop her celebrating life again. Honest, beautifully observed, and laced with a treasure trove of Yiddish and Mizrahi songs, this is a life-affirming and accomplished debut feature, from director Aurélie Saada. Michael Etherton</p>\",\"cover_image\":\"https://static-a.eventive.org/1788430768283temp-1788430767517-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788430769663temp-1788430768506-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788430786446temp-1788430785379-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"France\",\"language\":\"French\",\"runtime\":\"103\",\"subtitle_language\":\"English\",\"year\":\"2020\"},\"credits\":{\"director\":\"Aurélie Saada\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-06-15T14:12:17.610Z\",\"updated_at\":\"2026-09-03T10:19:45.377Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:41:38.492Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e4415f2c5e1404d8ac\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Dust Bowls and Jewish Souls: Another Side of Woody Guthrie\",\"description\":\"<h3>+ Q&amp;A with Will Kaufman, scholar and leading expert on Woody Guthrie</h3><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (Student Rush Tickets, 10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual armchairs. Sofas can only be bought as two seats together, for a combined total price of £34.00 (or £10.00 for Student Rush tickets).</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Everyman Belsize Park\",\"venue\":{\"id\":\"6a3000f01f63771bc478520d\",\"name\":\"Everyman Belsize Park\",\"short_name\":\"Everyman Belsize Pk\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"203 Haverstock Hill\\nBelsize Park\\nLondon \\nNW3 4QG\",\"default_capacity\":null,\"color\":\"#a326ff\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"fe3b9596-ce5c-1015-a950-49d47c25d6d6\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"2-Seater Sofa: Sold as a pair\",\"color\":\"#286A22\",\"_id\":\"6abbe46acc7d5284510a8855\"},{\"key\":\"2\",\"label\":\"Single armchair\",\"color\":\"#992C4E\",\"_id\":\"6abbe46acc7d5284510a8856\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6abbe46acc7d5284510a8857\"},{\"key\":\"5\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6abbe46acc7d5284510a8858\"},{\"key\":\"6\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6abbe46acc7d5284510a8859\"}]},\"is_dated\":true,\"start_time\":\"2026-11-09T18:30:00.000Z\",\"end_time\":\"2026-11-09T20:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a997a8a6f410ecd9be320e9\",\"name\":\"Single armchair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":4,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"rush_line_price\":null,\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a997a8a6f410ecd9be320ec\",\"name\":\"2-Seater Sofa: Sold as a pair\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":16,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b63\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Dust Bowls and Jewish Souls: Another Side of Woody Guthrie\",\"sort_key\":\"Dust Bowls and Jewish Souls: Another Side of Woody Guthrie\",\"description\":\"<p>A fascinating exploration of the Jewish influences that helped shape the music of Woody Guthrie, the influential American folk singer who inspired Bob Dylan, amongst so many others. Guthrie’s second wife, Marjorie Greenblatt, was a Jewish professional dancer, whilst her mother, Aliza, was a well-known Yiddish poet. Guthrie and Aliza developed a close bond through their artistic spirits and shared socialist politics. Guthrie went on to write a number of songs influenced by his interest in Jewish culture. Features original interviews with Guthrie and Marjorie’s children, Arlo and Nora, who provide delightful personal insights and anecdotes, to enhance the story.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787932004873temp-1787932004748-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932003875temp-1787932003652-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=5J2m11R2oDw\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"89\",\"language\":\"English\",\"country\":\"USA\"},\"credits\":{\"director\":\"Steven Pressman\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b64\",\"name\":\"Mavericks Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.734Z\",\"updated_at\":\"2026-09-03T10:09:37.431Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:41:48.491Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e4415f2c5e1404d8b1\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Pears Short Film Fund Premieres\",\"description\":\"<h3>+ Q&amp;As with Filmmakers</h3><p><strong>PRICES:</strong></p><p><strong>Front two rows: £15.00</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Premium Seat (extra width and legroom): £21.50</strong></p><p><strong>Under 35s: £14.00 (Admission with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual seats.</p><p>Sofas can only be bought as two seats together, for a combined total price of £34.00.</p><p><br></p><p>The Pears Short Film Fund at UK Jewish Film was established in 2008 to encourage and support the production and exhibition of short films on themes around British-Jewish life, history, and culture.</p><p>The winners receive up to £15,000 for the production of a new short film, which is premiered at the UK Jewish Film Festival. Application details for the 2027 Pears Short Film Fund at UK Jewish Film can be found at <a href=\\\"https://ukjewishfilm.org/pears-short-film-fund\\\" target=\\\"_blank\\\">ukjewishfilm.org/pears-short-film-fund</a>.</p><p><br></p><p>This evening also includes the World Premiere screening of <em>Carry with Both Hands,</em> from UK Jewish Film's brand new <em>Changing Perspectives﻿</em> fund.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><p><a href=\\\"https://pearsfoundation.org.uk/\\\" target=\\\"_blank\\\"><img src=\\\"https://storage.googleapis.com/eventive-static/85256e1cd1a8a887178371ffdad6e22d.jpg\\\" width=\\\"211\\\" style=\\\"max-width: 100%;\\\"></a></p>\",\"short_description\":\"\",\"location\":\"Phoenix Cinema Screen 1\",\"venue\":{\"id\":\"6a99730ef0ab0a9c42cbf3d6\",\"name\":\"Phoenix Cinema Screen 1\",\"short_name\":\"Phoenix Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"52 High Road\\nEast Finchley\\nLondon N2 9PJ\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"5b8d17