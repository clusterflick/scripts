l\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9ec382b8ce534df6e8ba20\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Blumenthal\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p><p><br></p><p>Part of our Best of 30 strand, showcasing some of the best films to feature in the UK Jewish Film Festival over the past 30 years.</p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6a9ec382b8ce534df6e8ba23\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":19,\"quantity_scanned\":0,\"quantity_remaining\":131,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a7adef87f1543daed8904cc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Blumenthal\",\"sort_key\":\"Blumenthal\",\"description\":\"<p>Even after his death, celebrated playwright, Harold Blumenthal (Brian Cox) — a plagiarist, womaniser, and narcissist, who died laughing at his own joke — continues to provoke his nearest and dearest. His brother, Saul, whose memoir was the source material for Harold’s most successful plays, suffers from severe constipation, and his nephew, Ethan, is too wrapped up in his own neurosis to notice that he might have a (real) problem. Their respective ‘shiksa’ partners start wondering — and not a moment too soon — what they have got themselves into. Introducing us to a new generation of self-obsessed Jewish New Yorkers, this comedy strikes the perfect balance between its flawed but loveable characters’ intellectual pursuits, and their bowel movements.</p><p><br></p><p><strong>Warning: contains scenes of a sexual nature.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1787931949015temp-1787931948997-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931948072temp-1787931948062-poster.jpg\",\"unballoted\":false,\"details\":{\"country\":\"USA\",\"language\":\"English\",\"runtime\":\"96\",\"year\":\"2012\"},\"credits\":{\"director\":\"Seth Fisher\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a7adf3d1a326e6aceb146b9\",\"type\":\"vod\",\"label\":\"Blumenthal.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"e54b64f7-4613-4aa1-8a43-aa2cc8ce3e1a\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":5185194.666999999,\"file_size\":880111661,\"created_at\":\"2026-08-11T08:37:17.296Z\",\"updated_at\":\"2026-08-11T08:37:17.311Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-08-11T08:36:08.170Z\",\"updated_at\":\"2026-08-28T16:01:31.341Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-08T17:06:07.069Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[\"country-GB\"],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9ec382b8ce534df6e8ba2a\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Inside the Mossad\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p><p><br></p><p>Part of our Best of 30 strand, showcasing some of the best films to feature in the UK Jewish Film Festival over the past 30 years.</p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc4785260\",\"name\":\"Documentaries\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6a9ec382b8ce534df6e8ba2d\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":22,\"quantity_scanned\":0,\"quantity_remaining\":128,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a61c9373bf8902a30acf133\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Inside the Mossad\",\"sort_key\":\"Inside the Mossad\",\"description\":\"<p>Like the CIA and MI6, Mossad, Israel’s intelligence agency, has spawned many myths since its foundation in 1950. The tales behind its top-secret operations have been the basis for books and films that in turn have fed the imagination of fans of conspiracy theories the world over. For Inside The Mossad, former heads and agents break their silence, and talk for the very first time about what it is like to work for one the most enigmatic institutions in the world. </p>\",\"cover_image\":\"https://static-a.eventive.org/1787931953289temp-1787931953249-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931952281temp-1787931952248-poster.jpg\",\"unballoted\":false,\"details\":{\"language\":\"English, Hebrew\",\"runtime\":\"80\",\"year\":\"2028\",\"country\":\"Germany, Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"animator\":null,\"cast\":\"Ram Ben Barak, Gad Shimron, Yossi Alpher\",\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Duki Dror\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":\"Yossi Melman\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"imdb_id\":\"tt7085648\",\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a64f