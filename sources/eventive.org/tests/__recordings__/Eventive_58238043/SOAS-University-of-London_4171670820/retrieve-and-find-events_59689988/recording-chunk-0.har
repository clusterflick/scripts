\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Grandfather Puzzle\",\"sort_key\":\"Grandfather Puzzle, The\",\"description\":\"<p>A devoted granddaughter explores the life story of her 100-year-old Hungarian grandfather: a Holocaust survivor, who now never wants to talk about the past, preferring jigsaw puzzles instead. She visits his childhood home in Hungary to document the past, and in doing so, begins to explore her own identity and sense of belonging. </p>\",\"cover_image\":\"https://static-a.eventive.org/e326f37dd0c6168cee4a666f6d896703.jpg?fit=crop&w=960&h=380\",\"poster_image\":\"https://static-a.eventive.org/86ae2578937450cbc6c5017133bd321b.jpg?w=300\",\"still_image\":\"https://static-a.eventive.org/cdc2c5094bfed75a8dc5c5391a7349b6.jpg\",\"unballoted\":false,\"details\":{\"language\":\"English, Hungarian\",\"runtime\":\"25\",\"year\":\"2025\",\"country\":\"UK\",\"subtitle_language\":\"English\"},\"credits\":{\"animator\":null,\"cast\":\"Ora DeKornfeld\",\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Ora DeKornfeld\",\"editor\":\"Ora DeKornfeld\",\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":\"Noémi Veronika Szakonyi, Máté Artur Vincze\",\"production_design\":null,\"screenwriter\":\"Ora DeKornfeld\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b1e\",\"name\":\"Family Matters\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b21\",\"name\":\"Hungarian Language\",\"color\":\"#ff8fdc\",\"visi