oting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6ac8efc6421c638ce550f38f\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Rosenthal: The Great Showman\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6ac8f0b729fea59b494efb75\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":4,\"quantity_scanned\":0,\"quantity_remaining\":146,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b54\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rosenthal: The Great Showman\",\"sort_key\":\"Rosenthal: The Great Showman\",\"description\":\"<p>A remarkable retelling of a true story, based on the life of beloved German-Jewish television host, Hans Rosenthal. Germany, 1978: Hans (Florian Lukas) has risen to the very top of the light entertainment world, with his wildly successful nightly quiz show Dalli, Dalli. To maintain his jovial persona, Hans hides his Jewish identity and his past as a Holocaust survivor from his adoring audience. But when the 40th anniversary of Kristallnacht falls on the same night as the live special anniversary edition of Dalli, Dalli, Hans must decide what is more important to him — maintaining this façade, or confronting the hard truths of the past.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931979261temp-1787931979224-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931978222temp-1787931978186-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=4f0csTLccBA\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"93\",\"language\":\"German\",\"country\":\"Germany\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Oliver Haffner\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b55\",\"name\":\"German Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"69867f136062a95e658fcbe9\",\"type\":\"vod\",\"label\":\"rosenthal_-_feature_v1 (1080p).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"6af803f6-9775-4776-ad77-914ef5609243\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":5571006.666999999,\"file_size\":2878459245,\"created_at\":\"2026-02-06T23:53:55.669Z\",\"updated_at\":\"2026-10-08T19:21:29.223Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-08-28T15:45:16.710Z\",\"updated_at\":\"2026-09-03T10:00:31.707Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T13:48:39.001Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[\"country-GB\"],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6ac8f0db7245645205600053\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Girls Like Us\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6ac8f11caeed7807a7c85503\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":3,\"quantity_scanned\":0,\"quantity_remaining\":147,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b5c\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Girls Like Us\",\"sort_key\":\"Girls Like Us\",\"description\":\"<p>Winner of three Ophir Awards from the Israeli Film Academy, Girls Like Us is a gritty, but deeply moving portrayal of life on the fringes of Israeli society. Shahar (Hili Yosef Zada) is a 17-year-old girl from a complicated family background. Her father has been committed to a psychiatric hospital whilst her mother is an alcoholic. Shahar must fend for herself and raise her younger sister alone. She attends a school for at-risk girls and finds a sense of sisterhood amongst her classmates. When 19-year-old Perry (Hadar Dror), a soldier-counsellor, arrives at the school, she and Shahar develop a strong emotional bond through their shared trauma.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931991543temp-1787931991522-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931987109temp-1787931986936-poster.jpg\",\"trailer_url\":\"https://youtu.be/lemkOF0kREw\",\"unballoted\":false,\"details\":{\"year\":\"2024\",\"runtime\":\"83\",\"language\":\"Hebrew\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Lee Gilat\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b5a\",\"name\":\"Identity Strand\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6aca77781312003e076c8d06\",\"type\":\"vod\",\"label\":\"girls_like_us_eng (1080p).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"cd04a273-659e-46ee-bc47-fa4e632eb130\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":5245973.333,\"file_size\":2649540704,\"created_at\":\"2026-10-10T17:35:52.802Z\",\"updated_at\":\"2026-10-10T17:35:52.814Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-08-28T15:45:16.721Z\",\"updated_at\":\"2026-09-03T09:57:49.230Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T13:50:20.241Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[\"country-GB\"],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6accc169f6d034049e90901d\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Labors of Love: The Life and Legacy of Henrietta Szold\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p><p><br></p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6accc1dfa82fd845b8663caa\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":2,\"quantity_scanned\":0,\"quantity_remaining\":148,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6acb78bd5fb45c4d2a7e8f03\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Labors of Love: The Life and Legacy of Henrietta Szold\",\"sort_key\":\"Labors of Love: The Life and Legacy of Henrietta Szold\",\"description\":\"Long overlooked yet hugely influential, a towering Jewish American humanitarian finally receives her due in this inspiring biography of the visionary Zionist and women’s rights leader who helped shape modern Jewish life. As founder of Hadassah, builder of a modern healthcare and social service system in pre-state Israel, and fierce advocate for education and Jewish–Arab cooperation, Henrietta Szold was a force of nature who galvanized a global network of Jewish women. Her boldest achievement, Youth Aliyah, rescued thousands of Jewish children from Nazi-occupied Europe. Through archival footage, intimate letters, and firsthand reflections lifted by Tovah Feldshuh’s stirring narration, this rousing tribute honors a trailblazer whose moral clarity, courage, and humanity continue to echo today.\",\"cover_image\":\"https://static-a.eventive.org/1791803716362temp-1791803716223-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1791803716878temp-1791803716601-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1791803000208temp-1791802999969-still.jpg\",\"unballoted\":false,\"details\":{\"language\":null,\"runtime\":\"78\",\"year\":\"2026\"},\"credits\":{\"animator\":null,\"cast\":null,\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Abby Ginzberg\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":null,\"sound_design\":null},\"expanded_credits\":[],\"tags\":[],\"imdb_id\":null,\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6accb61902a9d50fe632c973\",\"type\":\"vod\",\"label\":\"go2films_-_labors_of_love_-_english_-_for_preview (1080p).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"98de2048-5531-4404-9112-19c88c5cf226\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":4659753.333,\"file_size\":2423154492,\"created_at\":\"2026-10-12T10:27:37.602Z\",\"updated_at\":\"2026-10-12T10:27:37.617Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-10-11T11:53:33.739Z\",\"updated_at\":\"2026-10-12T11:15:16.221Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-12T11:18:36.884Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[\"country-GB\"],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6aa80388d60d7c117dcc4b14\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"British-Jewish Life on Film: York\",\"description\":\"<h4>This film will be shown in Screen 3</h4><p><strong>PRICES:</strong></p><p><strong>Adult: £14.50</strong></p><p><strong>Student / Over 60s (with valid ID): £10.99</strong></p><p><strong>Universal Credit (with valid ID): £6.99</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p>&nbsp;</p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p><br></p><p>We are proud to present <em>British Jewish Life on Film 2026: </em>an evening of brand new films about British Jewish life. These films were all commissioned this year by UKJF's Film Factory, with the aim of demonstrating the absolute diversity of our community. A series of mini-documentaries and short dramas tell Jewish stories from the length and breadth of the UK.</p><p><br></p><p>You'll laugh, you'll cry, you'll be entertained, you'll discover things you didn't know, and just by turning up to the screening you'll meet other local members of the Jewish community.</p><p><br></p><p>Above all else, you're guaranteed to leave feeling a renewed sense of Jewish pride.&nbsp;</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"City Screen Picturehouse York\",\"venue\":{\"id\":\"6a3000f01f63771bc478520a\",\"name\":\"City Screen Picturehouse York\",\"short_name\":\"City Screen York\",\"description\":\"For all booking enquiries, please contact Picturehouse directly on 0871 902 5747\",\"address\":\"City Screen Picturehouse York\\n13–17 Coney Street\\nYork\\nYO1 9QL\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":false,\"comscore_include\":false},\"is_dated\":true,\"start_time\":\"2026-11-18T18:30:00.000Z\",\"end_time\":\"2026-11-18T20:30:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa7f91cd5377103a57d3460\",\"name\":\"British Jewish Life on Film\",\"color\":\"#ff8fdc\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/018-32311/seats\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04afc\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"King of the Jews\",\"sort_key\":\"King of the Jews\",\"description\":\"<p>When Alice and Benj's eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra's gleefully murderous rehearsal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788344937313temp-1788344937283-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788344937509temp-1788344937488-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788344937062temp-1788344936948-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"7\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Katie Lambert\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.550Z\",\"updated_at\":\"2026-09-02T10:28:56.946Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afe\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Fish, Chips & Faith\",\"sort_key\":\"Fish, Chips & Faith\",\"description\":\"<p>Fish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931926719temp-1787931926616-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931925569temp-1787931925377-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Micaela Blitz, Miriam Rosenberg\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478526b\",\"name\":\"Dangoor UKJF Short Doc Fund\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.556Z\",\"updated_at\":\"2026-09-09T11:19:34.628Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04b06\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Rambling\",\"sort_key\":\"Rambling\",\"description\":\"<p>Over the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931934825temp-1787931934741-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931933876temp-1787931933813-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"6\",\"language\":\"English\",\"country\":\"UK\"},