3761 0048 to book)\",\"color\":\"#49A3BA\",\"_id\":\"6abbdad92d3a1d63d6ba89d0\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6abbdad92d3a1d63d6ba89d1\"}]},\"is_dated\":true,\"start_time\":\"2026-11-12T20:00:00.000Z\",\"end_time\":\"2026-11-12T22:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c525bba412e1e2417d2\",\"name\":\"+ Pre-Feature Short\",\"color\":\"#3697ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a99a243d0ec1bea7c95fbea\",\"name\":\"Adult Standard\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":15,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a99a243d0ec1bea7c95fbed\",\"name\":\"Under 35s (with valid ID)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b6a\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Neuilly-Poissy\",\"sort_key\":\"Neuilly-Poissy\",\"description\":\"<p>An anarchic French-Jewish comedy with an uplifting message about the importance of cross-cultural understanding. Daniel (Max Boublil) seems like a man who has it all. A successful restaurant owner, he lives in a swanky apartment in one of the richest parts of Paris. But when his financial misconduct is exposed, Daniel is sent to prison and his luxurious life comes crashing down around him. Forced to hide his Jewish identity, Daniel uses his Tunisian heritage and pretends to be a Muslim. As his wife, Lisa (Mélanie Bernier), desperately tries to secure his freedom, Daniel must go to increasingly extreme lengths to keep his secret hidden.</p>\",\"cover_image\":\"https://static-a.eventive.org/1791306590242temp-1791306590025-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1791306579955temp-1791306579640-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1791306602191temp-1791306601870-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2024\",\"runtime\":\"94\",\"language\":\"French\",\"country\":\"France\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Grégory Boutboul\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b64\",\"name\":\"Mavericks Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527f\",\"name\":\"Comedy\",\"color\":\"#ffdeee\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b32\",\"name\":\"Comedy Drama\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.748Z\",\"updated_at\":\"2026-10-06T17:10:01.867Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a91ad0c20625c9624c04afa\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Goyfriend\",\"sort_key\":\"Goyfriend, The\",\"description\":\"<p>Aviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as 'one of us'.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789395207832temp-1789395207615-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789395225063temp-1789395224739-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789395224557temp-1789395224245-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"17\",\"language\":\"English\",\"country\":\"UK\"},\"credits\":{\"director\":\"Ashley Margolis\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc478527d\",\"name\":\"Pears Short Film Fund\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.542Z\",\"updated_at\":\"2026-09-14T14:13:44.244Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:44:47.292Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e8415f2c5e1404d904\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Shana\",\"description\":\"<h4>This film will be shown in Screen 4.</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £19.45</strong></p><p><strong>Students/Over 60s: £17.45 (Admission with valid ID)</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p><strong>Please note: tickets for this event are unreserved. You cannot purchase specific seats.</strong></p><p><br></p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Lord and Lady Collins of Mapesbury</h4>\",\"short_description\":\"\",\"location\":\"Picturehouse Central\",\"venue\":{\"id\":\"6a3000f01f63771bc4785209\",\"name\":\"Picturehouse Central\",\"short_name\":\"Picturehouse Central\",\"description\":\"For all booking enquiries, please call the venue directly: 0871 902 5747\",\"address\":\"Corner of Great Windmill Street and Shaftesbury Avenue, Piccadilly, London, W1D 7DH\",\"default_capacity\":null,\"color\":\"#ffd500\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"2f0ede00-af54-b297-b756-35c9e6e954ad\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"General Admission\",\"color\":\"#C5112F\",\"_id\":\"6abb90febe943bcc4a4b73d0\"},{\"key\":\"2\",\"label\":\"Wheelchair Space\",\"color\":\"#2F50A1\",\"_id\":\"6abb90febe943bcc4a4b73d1\"},{\"key\":\"3\",\"label\":\"Companion Space\",\"color\":\"#F2B950\",\"_id\":\"6abb90febe943bcc4a4b73d2\"},{\"key\":\"4\",\"label\":\"General Admission\",\"color\":\"#FF4E50\",\"_id\":\"6abb90febe943bcc4a4b73d3\"},{\"key\":\"5\",\"label\":\"Reserved\",\"color\":\"#CC254A\",\"_id\":\"6abb90febe943bcc4a4b73d4\"}]},\"is_dated\":true,\"start_time\":\"2026-11-12T20:15:00.000Z\",\"end_time\":\"2026-11-12T22:15:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6ab131691cd3660bb1842566\",\"name\":\"Unreserved Seating\",\"color\":\"#cef2ec\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/022-122400/tickets\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b6c\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Shana\",\"sort_key\":\"Shana\",\"description\":\"<p>You’ve never met anyone like Shana before. Fresh from its premiere in the prestigious Cannes Directors’ Fortnight selection comes a riotous story about a Jewish woman living life on the edge. Shana’s life (portrayed by the utterly magnetic Eva Huault) is a mess. Her drug-dealer boyfriend is in prison, she is constantly falling out with her friends, and her relationship with her family is tumultuous at best. When her Moroccan Jewish grandmother dies, leaving her precious ring to her granddaughter, Shana tries make a fresh start. Framed around the ten plagues of Passover, this is a vibrant and authentic debut feature from up-and-coming filmmaker, Lisa Pinell.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787932014950temp-1787932014873-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932013813temp-1787932013565-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=kClDa_QGp8M\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"84\",\"language\":\"French\",\"country\":\"France\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Lila, Pinell\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b41\",\"name\":\"Best Film Award Nominee\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b64\",\"name\":\"Mavericks Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527f\",\"name\":\"Comedy\",\"color\":\"#ffdeee\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b32\",\"name\":\"Comedy Drama\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b23\",\"name\":\"French Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.752Z\",\"updated_at\":\"2026-09-03T10:00:46.596Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:44:57.322Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e8415f2c5e1404d8fa\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Oxygen\",\"description\":\"<p><strong>PRICES:</strong></p><p><strong>Front two rows: £15.00</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Premium Seat (extra width and legroom): £21.50</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><br></p><p>Please note: this cinema has two-seater sofas as well as individual seats.</p><p>Sofas can only be bought as two seats together, for a combined total price of £34.00.</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>Voicevale</h4><p><br></p><p><img src=\\\"https://storage.googleapis.com/eventive-static/fdeb52b29c92bae3e415e9e6826e6946.jpg\\\" width=\\\"179\\\"></p>\",\"short_description\":\"\",\"location\":\"Phoenix Cinema Screen 1\",\"venue\":{\"id\":\"6a99730ef0ab0a9c42cbf3d6\",\"name\":\"Phoenix Cinema Screen 1\",\"short_name\":\"Phoenix Scr1\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"52 High Road\\nEast Finchley\\nLondon N2 9PJ\",\"default_capacity\":null,\"color\":\"#fffc36\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"5b8d1728-e836-4af9-915d-513002a54a17\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ac7bbdd331f37456b9ad382\"},{\"key\":\"2\",\"label\":\"Premium Seat (wider, more legroom)\",\"color\":\"#FCA700\",\"_id\":\"6ac7bbdd331f37456b9ad383\"},{\"key\":\"3\",\"label\":\"Wheelchair Space (call 020 3761 0048 to book)\",\"color\":\"#4176A5\",\"_id\":\"6ac7bbdd331f37456b9ad384\"},{\"key\":\"4\",\"label\":\"Companion Seat (call 020 3761 0048 to book)\",\"color\":\"#49A3BA\",\"_