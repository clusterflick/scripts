le_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a998d70ab111acc6b78660c\",\"name\":\"Premium\",\"price\":1800,\"unlimited\":true,\"quantity_sold\":15,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"2\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b5e\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Neither Day nor Night\",\"sort_key\":\"Neither Day nor Night\",\"description\":\"<p>In this engrossing Jewish morality tale for the modern day, Shmuel (Eli Menashe) is the patriarch of an Orthodox Sephardi family, in the Haredi hub of B’nei Brak. His son, Rafael (Adam Hatuka Peled), is an outstanding Torah student who has his heart set on attending an elite yeshivah. When Rafael’s application is turned down, in favour of a less gifted student from a wealthy family, Shmuel confronts the endemic racism within their primarily Ashkenazi community. An award nominee at the Jerusalem Film Festival, this is a thoughtful, compelling, and beautifully shot exploration of racial tensions within Israel’s ultra-religious societies.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787931994231temp-1787931994168-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931993175temp-1787931993020-poster.jpg\",\"trailer_url\":\"https://www.youtube.com/watch?v=UU_pR0QSKAM\",\"unballoted\":false,\"details\":{\"year\":\"2024\",\"runtime\":\"91\",\"language\":\"Hebrew\",\"country\":\"Israel, France\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Phinehas Veuillet\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b5a\",\"name\":\"Identity Strand\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.725Z\",\"updated_at\":\"2026-09-03T09:58:52.686Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:43:19.719Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e7415f2c5e1404d8e7\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Vindicta\",\"description\":\"<h3>+ Q&amp;A with director Dominik Sedlar and members of the cast</h3><h4>This film will be shown in Screen 4.</h4><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £19.45</strong></p><p><strong>Students/Over 60s: £17.45 (Admission with valid ID)</strong></p><p><br></p><p>Tickets for this event are sold directly through Picturehouse Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website. If you already have an account with Picturehouse Cinemas, you can either log in, or click \\\"Continue as Guest\\\" to proceed.</p><p><strong>Please note: tickets for this event are unreserved. You cannot purchase specific seats.</strong></p><p><br></p><p>For all enquiries relating to your booking, please contact Picturehouse directly.</p><p>Picturehouse Ticket Booking Line: 0871 902 5747 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees.)</p><p>Picturehouse Customer Service: 0207 326 2649 (Phone lines are open Monday to Sunday, 10am to 6pm)</p><p><br></p><p><strong>WARNING: contains graphic scenes of sexual violence.</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p><p><br></p><h4>Sponsored by:</h4><h4>The Azouz Foundation</h4>\",\"short_description\":\"\",\"location\":\"Picturehouse Central\",\"venue\":{\"id\":\"6a3000f01f63771bc4785209\",\"name\":\"Picturehouse Central\",\"short_name\":\"Picturehouse Central\",\"description\":\"For all booking enquiries, please call the venue directly: 0871 902 5747\",\"address\":\"Corner of Great Windmill Street and Shaftesbury Avenue, Piccadilly, London, W1D 7DH\",\"default_capacity\":null,\"color\":\"#ffd500\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"2f0ede00-af54-b297-b756-35c9e6e954ad\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"General Admission\",\"color\":\"#C5112F\",\"_id\":\"6abb90febe943bcc4a4b73d0\"},{\"key\":\"2\",\"label\":\"Wheelchair Space\",\"color\":\"#2F50A1\",\"_id\":\"6abb90febe943bcc4a4b73d1\"},{\"key\":\"3\",\"label\":\"Companion Space\",\"color\":\"#F2B950\",\"_id\":\"6abb90febe943bcc4a4b73d2\"},{\"key\":\"4\",\"label\":\"General Admission\",\"color\":\"#FF4E50\",\"_id\":\"6abb90febe943bcc4a4b73d3\"},{\"key\":\"5\",\"label\":\"Reserved\",\"color\":\"#CC254A\",\"_id\":\"6abb90febe943bcc4a4b73d4\"}]},\"is_dated\":true,\"start_time\":\"2026-11-11T18:00:00.000Z\",\"end_time\":\"2026-11-11T20:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c3d49d98ac93d6e069f\",\"name\":\"+ Q&A\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6ab131691cd3660bb1842566\",\"name\":\"Unreserved Seating\",\"color\":\"#cef2ec\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://web.picturehouses.com/order/showtimes/022-122399/tickets\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b7e\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Vindicta\",\"sort_key\":\"Vindicta\",\"description\":\"<p>A visceral and violent tale of Jewish resistance, inspired by the true stories of women who fought the Nazis during World War Two. Hannah (model-turned-actor, Devon Ross) is a young Jewish woman, forced to watch as her parents are brutally murdered. After managing to escape, Hannah becomes fuelled by an insatiable desire for revenge. Using her femininity and sexuality as her weapons, she begins luring in and assassinating unsuspecting German soldiers. When she crosses paths with a handsome Nazi officer named Klaus (Jack Bandeiras), Hannah’s commitment to her cause is tested beyond measure.</p><p><strong>Warning: contains graphic scenes of sexual violence.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1787932036272temp-1787932036127-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932034282temp-1787932033911-poster.jpg\",\"trailer_url\":\"https://youtu.be/aP6MeKwo_Tw\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"120\",\"language\":\"English\",\"country\":\"UK, USA, Croatia\"},\"credits\":{\"director\":\"Dominik Sedlar\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b78\",\"name\":\"Resilience Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4f\",\"name\":\"Historical Drama\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.785Z\",\"updated_at\":\"2026-09-15T14:24:49.342Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:43:29.248Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e9415f2c5e1404d91d\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Remnants\",\"description\":\"<p><strong>PRICES:</strong></p><p><strong>Adult Standard: £17.00</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><strong>JW3 Members: 10% off</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"JW3 Cinema\",\"venue\":{\"id\":\"6a3000f01f63771bc4785204\",\"name\":\"JW3 Cinema\",\"short_name\":\"JW3 Cinema\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"341-351 Finchley Road \\nLondon \\nNW3 6ET\",\"default_capacity\":null,\"color\":\"#ff6b94\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"9b66676b-bdd5-0983-1fcb-f293379a36cd\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ab262e9d7f848654e9c8e14\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call UKJF to book)\",\"color\":\"#4176A5\",\"_id\":\"6ab262e9d7f848654e9c8e15\"},{\"key\":\"3\",\"label\":\"Companion Seat (Call UKJF to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ab262e9d7f848654e9c8e16\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6ab262e9d7f848654e9c8e17\"},{\"key\":\"5\",\"label\":\"House Seats\",\"color\":\"#5d5d5d\",\"_id\":\"6ab262e9d7f848654e9c8e18\"}]},\"is_dated\":true,\"start_time\":\"2026-11-11T18:20:00.000Z\",\"end_time\":\"2026-11-11T20:20:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a998bb9df5c0e6511948dc9\",\"name\":\"Adult Standard\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":15,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a998bb9df5c0e6511948dd0\",\"name\":\"Under 35s (with valid ID)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b6e\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Remnants\",\"sort_key\":\"Remnants\",\"description\":\"<p>From award-winning Israeli screenwriter, Eden Gurion, comes this powerful, poignant story of grief, sisterhood, and music. Rona (Achinoam Moyal) is a 14-year-old teenager whose older sister, Daniela (Anna Stefanie) — an aspiring singer — was killed at the Nova Music Festival on October 7th. Rona, who had a difficult relationship with Daniela, is struggling to come to terms with the loss. Her teacher partners her up with Oren (Barak Shmuel Drexler), whose father was an IDF soldier killed in Gaza, and suggests they participate in the national memorial service together. Rona must decide how to honour the memory of her sister whilst still respecting the grief of others.</p>\",\"cover_image\":\"https://static-a.eventive.org/1787932017417temp-1787932017366-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787932016364temp-1787932016328-poster.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2024\",\"runtime\":\"82\",\"language\":\"Hebrew\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Roman, Shumumov\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b6f\",\"name\":\"Perspectives Strand\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.757Z\",\"updated_at\":\"2026-08-28T15:45:16.757Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:43:38.716Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e6415f2c5e1404d8e2\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"Israeli Shorts\",\"description\":\"<p><strong>PRICES:</strong></p><p><strong>Adult Standard: £14.00</strong></p><p><strong>Under 35s: £10.00 (Admission with valid ID)</strong></p><p><strong>Student Rush: £5.00 (10 minutes before screening, subject to availability, with valid ID)</strong></p><p><br></p><p><strong>UK Jewish Film Members: 20% off</strong></p><p><strong>JW3 Members: 10% off</strong></p><p><br></p><p>Six UK premieres from Israel, showcasing the breadth of emerging filmmaking talent.</p><p>Our in-cinema exclusive <em>Butcher's Stain</em> — nominated for Best Live Action Short at the 2026 Oscars and winner of a 2025 Student Academy Award Silver Medal — follows an Arab-Israeli butcher accused of tearing down hostage posters, and asks whether his colleagues can see past his ethnicity. In <em>Frequency</em>, written and directed by Mindi Ehrlich (<em>Pink Lady</em>), a young woman who has left her Orthodox community fights to re-establish contact with her son. <em>The Insurance Fairy</em> finds a cash-strapped mother staging a gas leak — until her son hides. <em>The Eulogy</em> lightens the mood with two brothers grieving very differently. <em>Not My Weekend</em>, Israeli Academy Award-nominated, sees divorced Sharon weighing up her childcare cmittments against a ticket to the Nova Music Festival on October 7th. Online exclusive <em>Love Letter to my Brother</em> follows twins divided when one becomes ultra-Orthodox.</p><p><br></p><h5>Total running time: 94 mins</h5><p><br></p><p><strong>This event is part of the New Israel Fund strand.</strong></p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\"><span class=\\\"ql-cursor\\\">﻿</span>This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"JW3 Cinema\",\"venue\":{\"id\":\"6a3000f01f63771bc4785204\",\"name\":\"JW3 Cinema\",\"short_name\":\"JW3 Cinema\",\"description\":\"For all booking enquiries, please call the UK Jewish Film box office: 020 3176 0048.\",\"address\":\"341-351 Finchley Road \\nLondon \\nNW3 6ET\",\"default_capacity\":null,\"color\":\"#ff6b94\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"9b66676b-bdd5-0983-1fcb-f293379a36cd\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"6ab262e9d7f848654e9c8e14\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call UKJF to book)\",\"color\":\"#4176A5\",\"_id\":\"6ab262e9d7f848654e9c8e15\"},{\"key\":\"3\",\"label\":\"Companion Seat (Call UKJF to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ab262e9d7f848654e9c8e16\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6ab262e9d7f848654e9c8e17\"},{\"key\":\"5\",\"label\":\"House Seats\",\"color\":\"#5d5d5d\",\"_id\":\"6ab262e9d7f848654e9c8e18\"}]},\"is_dated\":true,\"start_time\":\"2026-11-11T20:15:00.000Z\",\"end_time\":\"2026-11-11T22:15:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a998aac15f7b7d0a8f1602a\",\"name\":\"Adult Standard\",\"price\":1400,\"unlimited\":true,\"quantity_sold\":18,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a998aac15f7b7d0a8f16031\",\"name\":\"Under 35s (with valid ID)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":1,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b0f\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Butcher's Stain\",\"sort_key\":\"Butcher's Stain\",\"description\":\"<p>Samir, an Arab-Israeli butcher working in a Tel Aviv supermarket, is accused of tearing down hostage posters in the employees' break room. He tries to prove his innocence, but will his colleagues be able to see past his ethnicity? 2026 Nominee: Oscar, Best Live Action Short Film. 2025 Winner: Student Academy Award, Narrative, Silver Medal.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967454024temp-1788967453867-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967454495temp-1788967454260-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967463348temp-1788967463149-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"26\",\"language\":\"Hebrew, Arabic\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Meyer Levinson-Blount\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b12\",\"name\":\"Arabic Language\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.583Z\",\"updated_at\":\"2026-09-09T15:24:23.146Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c67debe054b8d1803300\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Frequency\",\"sort_key\":\"Frequency\",\"description\":\"<p>A young woman who has left her Orthodox community is heartbroken at the loss of contact with her son. They meet secretly on his birthday, and try to rekindle their relationship, but is it too late? Short Independent Competition, Tel Aviv International Student Film Festival, 2025. Written and directed by Mindi Ehrlich (writer of Pink Lady).</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967415569temp-1788967415533-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967405146temp-1788967405107-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967423532temp-1788967423405-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"Israel\",\"language\":\"Hebrew\",\"runtime\":\"16\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Mindi Ehrlich\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a64fe8c208da979eb0e09ac\",\"type\":\"vod\",\"label\":\"go2films_-_frequency_-_english_-_for_preview.mp4?loc=external&signature=ae89883f825989828f6a3086ad6b335a6be9f8078ca97287ec47cd955b38e0d0&user_id=5122439\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"73791977-9b93-4745-ad3b-e7822f9617a6\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":744680,\"file_size\":1858010632,\"created_at\":\"2026-07-25T18:21:00.526Z\",\"updated_at\":\"2026-07-25T18:21:00.537Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-07-23T07:45:01.307Z\",\"updated_at\":\"2026-09-09T15:23:43.403Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c6aa14fe4c25557514be\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Not My Weekend\",\"sort_key\":\"Not My Weekend\",\"description\":\"<p>Sharon, a divorced woman in her 40s, plans to attend a music festival and hook up with a past lover, but her ex-husband cancels his weekend with their daughter, leaving her with unexpected childcare commitments. Does she go without her daughter? Do they both stay home? Or, together, do they attend what turns out to be the Nova Music Festival on Oct 7th? This compelling watch was nominated for the Best Short Award, Israeli Academy Awards, 2025, and was in the Official Selection at the Jerusalem Film Festival, 2025.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967374735temp-1788967374529-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967365568temp-1788967365274-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967382856temp-1788967382648-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"Israel\",\"language\":\"Hebrew\",\"runtime\":\"18\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Rona Segal\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a64fe68012cb792041adba7\",\"type\":\"vod\",\"label\":\"go2films_-_not_my_weekend_-_english_-_for_preview%20%281080p%29.mp4?loc=external&signature=56dfd453ea3b503ca63e6e0913f0e094d8b2ce4dcb185efe481ad08b751b231b\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"56c26059-e0a9-4b81-ad10-2d7a9995e6e1\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":1136681.6670000001,\"file_size\":528515280,\"created_at\":\"2026-07-25T18:20:24.964Z\",\"updated_at\":\"2026-07-25T18:20:24.977Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-07-23T07:45:46.227Z\",\"updated_at\":\"2026-09-09T15:23:02.645Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c0aebcc1a7d200670e4e\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Eulogy\",\"sort_key\":\"Eulogy, The\",\"description\":\"<p>Two brothers approach their mother's funeral in very different ways: one has too much to say, and the other, despite his money and apparent success, can't get his thoughts together. Added to this, their mother was so large she needs a double plot, and this holds up the proceedings, delaying the dreaded eulogy.</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967336495temp-1788967336433-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967328781temp-1788967328742-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967343541temp-1788967343498-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"Israel\",\"language\":\"Hebrew\",\"runtime\":\"21\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Moran Rosenblatt\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6a61c0c3799d49ad32551d7e\",\"type\":\"vod\",\"label\":\"The Eulogy MP4 6G Eng.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"c18fbcb2-e982-46da-b5dc-bc1305b5d1f1\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":1341833.333,\"file_size\":6607054651,\"created_at\":\"2026-07-23T07:20:35.675Z\",\"updated_at\":\"2026-07-23T07:20:35.691Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-07-23T07:20:14.888Z\",\"updated_at\":\"2026-09-09T15:22:23.495Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a61c3eeebe054b8d18012b8\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Insurance Fairy\",\"sort_key\":\"Insurance Fairy, The\",\"description\":\"<p>In this suspenseful short, a young mother, in need of cash and a new life, plans to call 'the insurance fairy', by causing a gas leak in her home that looks like an accident, but her plans are disrupted by her son’s love of hide and seek. Can they make it out the house in time?</p>\",\"cover_image\":\"https://static-a.eventive.org/1788967524475temp-1788967524435-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788967535068temp-1788967535046-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788967534799temp-1788967534679-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"Israel\",\"language\":\"Hebrew\",\"runtime\":\"13\",\"subtitle_language\":\"English\",\"year\":\"2025\"},\"credits\":{\"director\":\"Tal Haimovich\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b10\",\"name\":\"Israeli Shorts\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\