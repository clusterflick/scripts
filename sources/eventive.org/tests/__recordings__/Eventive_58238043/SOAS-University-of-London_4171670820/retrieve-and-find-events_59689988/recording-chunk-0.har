rd seat)\",\"price\":1500,\"unlimited\":true,\"quantity_sold\":4,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a9990710bcee1c1e3d72318\",\"name\":\"Front Rows (U35s)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"7\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b4d\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Soundman\",\"sort_key\":\"Soundman, The\",\"description\":\"<p>A beautiful portrayal of young love swept up by the dark tides of history, and a remarkable cinematic depiction of sound. In May 1940, German forces are massing along the borders of Belgium, Luxembourg, and the Netherlands. At a Brussels radio station, Elza (Femke Vanhove) is a talented young voice actor. She’s also, secretly, a Jewish refugee from Vienna. Meanwhile, Berre (Jef Hellemans) is an innovative introverted sound engineer, who creates the sound effects for the station's radio plays. The two fall deeply in love, but as war looms, and Elza’s true identity is exposed, their relationship is put to the ultimate test.</p>\",\"cover_image\":\"https://static-a.eventive.org/1791287981705temp-1791287981644-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1791287989805temp-1791287989748-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1791287989517temp-1791287989461-still.jpg\",\"trailer_url\":\"https://youtu.be/cmLvljVT4pY?si=DMJa4OoocUQVXSSI\",\"unballoted\":false,\"details\":{\"year\":\"2025\",\"runtime\":\"120\",\"language\":\"Dutch, Hebrew\",\"country\":\"Belgium\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Frank Van Passel\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4e\",\"name\":\"Memory Strand\",\"color\":\"#ffbc57\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b4f\",\"name\":\"Historical Drama\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b50\",\"name\":\"Dutch Language\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.702Z\",\"updated_at\":\"2026-10-08T14:10:22.745Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:40:21.815Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_