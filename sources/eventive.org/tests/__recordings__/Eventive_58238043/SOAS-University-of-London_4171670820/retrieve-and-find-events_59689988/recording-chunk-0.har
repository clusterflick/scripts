wner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"ZIP WIRE\",\"sort_key\":\"ZIP WIRE\",\"description\":\"<p>Hang on tight! When Amy Watson was 13 years old, she watched her mother die from an incurable disease. Determined to find a cure, Amy becomes a dedicated researcher at a high-security pharmaceutical company. When her groundbreaking discovery is stolen and her partner murdered, she’s thrust into a deadly game of cat-and-mouse high in the Dolomite mountains. With no escape, her only salvation being across a treacherous aerial runway, Amy must outsmart the mysterious enemy, face her debilitating fear of heights and summon every ounce of courage to protect the world-changing research – and herself – before it’s too late.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784580197902temp-1784580197827-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"88\",\"language\":\"ENGLISH\",\"country\":\"UK\",\"premiere\":\"World\",\"rating\":\"18\"},\"credits\":{\"director\":\"Howard J. Ford\",\"cast\":\"MyAnna Buring, Joseph Millson, Saffron Burrows, Silvia Presente\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.698Z\",\"updated_at\":\"2026-07-25T11:33:13.146Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-19T11:45:38.450Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"