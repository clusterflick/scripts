ull}],\"films\":[{\"id\":\"6a5e1af9ae9bbda67f65e085\",\"type\":\"film\",\"event_bucket\":\"6a17699850d66159f2035097\",\"event_bucket_name\":\"FrightFest 2026\",\"owner_id\":\"5dd16a51cb714c002f548a83\",\"name\":\"NIGHT AFTER NIGHT\",\"sort_key\":\"NIGHT AFTER NIGHT\",\"description\":\"<p>From Josh Lobo, the rising star director of I TRAPPED THE DEVIL, a unique sci-fi shocker inspired by J-Horror, acclaimed novelist Kobo Abe, sci-fi icon J.G. Ballard and the satirical black comedy OFFICE SPACE. The contrasting lives of two overnight security guards at a private university snap into focus as their grip on reality begins to unnervingly unravel after the appearance of a mysterious mute figure who returns each and every night without any explanation. Body Horror with a startling twist starring a host of genre luminaries and featuring a score by Simon Waskow of CUCKOO and LUZ fame.</p>\",\"cover_image\":\"https://static-a.eventive.org/1784579156128temp-1784579156058-cover.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"88\",\"language\":\"ENGLISH\",\"country\":\"USA\",\"premiere\":\"UK\",\"rating\":\"18\"},\"credits\":{\"director\":\"Josh Lobo\",\"cast\":\"Scott Poythress, Johnny Sibilly, AJ Bowen, Alexis Louder\"},\"expanded_credits\":[],\"tags\":[],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-07-20T12:56:25.579Z\",\"updated_at\":\"2026-07-25T11:40:35.322Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-08-23T19:36:31.230Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"us