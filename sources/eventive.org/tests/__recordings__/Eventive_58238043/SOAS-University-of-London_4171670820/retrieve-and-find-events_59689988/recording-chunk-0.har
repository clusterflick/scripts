673246-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789657692556temp-1789657692292-still.jpg\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"18\",\"language\":\"Hebrew\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Luba Vikhanski\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b1b\",\"name\":\"Real to Reel\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785271\",\"name\":\"Short Film\",\"color\":\"#cef2ec\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b11\",\"name\":\"Hebrew Language\",\"color\":\"#8d95ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",\"name\":\"English Subtitles\",\"color\":\"#3697ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b1c\",\"name\":\"European Premiere\",\"color\":\"#3697ff\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6ab97fb5bcb6325988b55b51\",\"type\":\"vod\",\"label\":\"Archive in 3 Movements_Luba-ENGLISH_MASTER_H265_Small.mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"261d348b-d052-4e6b-9b25-037df478d38d\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":1078037.333,\"file_size\":1405968262,\"created_at\":\"2026-09-27T20:42:29.092Z\",\"updated_at\":\"2026-09-27T20:42:29.102Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-08-28T15:45:16.608Z\",\"updated_at\":\"2026-09-17T15:08:12.291Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true},{\"id\":\"6a9e977f799024940ee8ed56\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"That's How You Make a Torah\",\"sort_key\":\"That's How You Make a Torah\",\"description\":\"<p>The first Torah scribed by a man dates from the year 3 BCE, but the first Torah written by a woman didn't happen until 2007. This short documentary is about two of the first known women to ever scribe a Torah: Jen Taylor Friedman, based in Cambridge, and Rabbi Linda Motzkin, from the USA, who not only writes Torah, but makes her own Kosher parchment, too.</p>\",\"cover_image\":\"https://static-a.eventive.org/1789492309349temp-1789492309185-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1789492309846temp-1789492309586-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1789492316929temp-1789492316649-still.jpg\",\"unballoted\":false,\"details\":{\"country\":\"United States\",\"language\":\"English\",\"runtime\":\"10\",\"year\":\"2025\"},\"credits\":{\"animator\":null,\"cast\":null,\"cinematographer\":null,\"co_producer\":null,\"composer\":null,\"director\":\"Lauren Greenhall\",\"editor\":null,\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":null,\"production_design\":null,\"screenwriter\":null,\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785277\",\"name\":\"Pre-feature\",\"color\":\"#608ea4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b1b\",\"name\":\"Real to Reel\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785269\",\"name\":\"Short Films\",\"color\":\"#fffc36\",\"visible\":true}],\"imdb_id\":\"tt39132174\",\"comscore_include\":true,\"visibility\":\"visible\",\"virtual_content\":{\"id\":\"6ab97ee40aeccbd171b31c65\",\"type\":\"vod\",\"label\":\"tfs_english_subs (1080p) (2).mp4\",\"status\":\"ready\",\"status_percent\":100,\"ev_next_encoding_id\":\"10b9aecb-b57e-4456-9361-403bcb8b2bb0\",\"live_chat_visible\":true,\"live_chat_participation_enabled\":true,\"live_chat_show_viewer_count\":true,\"ams_drm_enabled\":true,\"duration\":650751.667,\"file_size\":352569373,\"created_at\":\"2026-09-27T20:39:00.093Z\",\"updated_at\":\"2026-09-27T20:39:00.108Z\",\"platform\":\"ev_next\",\"caption_tracks\":[]},\"created_at\":\"2026-09-07T10:52:47.865Z\",\"updated_at\":\"2026-09-15T17:11:56.647Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-09-07T15:16:49.190Z\",\"is_virtual\":true,\"comscore_include\":true,\"geographic_restrictions\":[\"country-GB\"],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":true,\"allow_preorder\":true,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_closed\":false,\"virtual_balloting_inline_during_playback\":false,\"virtual_balloting_consolidated\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9ec382b8ce534df6e8ba16\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"The Shadow of the Day\",\"description\":\"<p><strong>PRICES: £15.00</strong></p><p><strong>Or free with an Online Festival Pass</strong></p><p><br></p><p>Part of our Best of 30 strand, showcasing some of the best films to feature in the UK Jewish Film Festival over the past 30 years.</p>\",\"short_description\":\"\",\"venue\":{},\"is_dated\":true,\"start_time\":\"2026-11-18T00:00:00.000Z\",\"end_time\":\"2026-11-30T23:59:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6a3000f01f63771bc478526f\",\"name\":\"Feature Films\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":false,\"quantity\":150,\"ticket_buckets\":[{\"id\":\"6a9ec382b8ce534df6e8ba19\",\"name\":\"Virtual Admission\",\"price\":1500,\"unlimited\":false,\"quantity\":150,\"quantity_sold\":17,\"quantity_scanned\":0,\"quantity_remaining\":133,\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a300442441690209a220195\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Shadow of the Day\",\"sort_key\":\"Shadow of the Day, The\",\"description\":\"<p>A dramatic and tense love story set in the picturesque Italian town of Ascoli Piceno, where wounded World War One veteran, Luciano (Riccardo Scamarcio), observes the world through the windows of his elegant restaurant, and believes that he can live life according to his own rules, despite the encroaching darkness of Mussolini’s fascism. Set in 1938, two years before Italy entered World War Two, the tension builds as one by one, individual freedoms are restricted. When Anna arrives in the town and begs for employment, it becomes clear that there is more to her story than she has admitted. As they become emotionally involved and the political situation worsens, Luciano finds himself in an impossible situation. <em>Judy Ironside</em></p><p><br></p><p><strong>Warning: contains scenes of a sexual nature.</strong></p>\",\"cover_image\":\"https://static-a.eventive.org/1787931944193temp-1787931944113-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1787931943157temp-1787931942904-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/b34d2876a8cfadea6d34b06a3cbc4d34.jpg\",\"unballoted\":false,\"details\":{\"language\":\"Italian\",\"runtime\":\"128\",\"year\":\"2022\",\"country\":\"Italy\",\"subtitle_language\":\"English\"},\"credits\":{\"animator\":null,\"cast\":\"Riccardo Scamarcio, Benedetta Porcaroli, Waël Sersoub\",\"cinematographer\":\"Michele D'Attanasio\",\"co_producer\":null,\"composer\":\"Michele Braga\",\"director\":\"Giuseppe Piccioni\",\"editor\":\"Esmeralda Calabria\",\"executive_producer\":null,\"filmmaker\":null,\"music\":null,\"producer\":\"\",\"production_design\":\"Isabella Angelini\",\"screenwriter\":\"\",\"sound_design\":null},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b2e\",\"name\":\"Best of 30 Strand\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b14\",\"name\":\"Online\",\"color\":\"#fffc36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527c\",\"name\":\"Drama\",\"color\":\"#f9b6df\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b30\",\"name\":\"Italian Language\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b0d\",