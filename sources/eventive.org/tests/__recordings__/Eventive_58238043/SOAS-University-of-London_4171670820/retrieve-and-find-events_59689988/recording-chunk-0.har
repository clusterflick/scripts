          "content": {
            "mimeType": "application/javascript; charset=utf-8",
            "text": "TENANT = {\"endpoint\":\"https://api.eventive.org/\",\"display_name\":\"Welcome to UK Jewish Film\",\"display_short_name\":\"UK Jewish Film Festival 2026\",\"display_name_article\":\"a\",\"display_timezone\":\"Europe/London\",\"banner_image\":\"https://static-a.eventive.org/c70be2a073f5e77b2575d90ebe3d6c29.png\",\"logo_image\":\"https://static-a.eventive.org/62947c587c3d9444e430fbe735d7d54f.png\",\"display_pass\":\"Online Festival Pass\",\"display_passes\":\"Online Festival Passes\",\"passes_url_pathname\":\"Online_Festival_Passes\",\"display_membership\":\"membership\",\"display_memberships\":\"memberships\",\"memberships_url_pathname\":\"memberships\",\"display_schedule\":\"FESTIVAL SCHEDULE\",\"schedule_url_pathname\":\"FESTIVAL_SCHEDULE\",\"display_film\":\"film\",\"display_films\":\"films\",\"film_url_pathname\":\"films\",\"display_film_guide\":\"film guide\",\"film_guide_url_pathname\":\"films\",\"display_showing\":\"showing\",\"display_showings\":\"showings\",\"palette\":{\"primary1Color\":\"#f05972\",\"accent1Color\":\"#e8ab5a\"},\"invert_colors\":false,\"invert_colors_alt\":true,\"urls_use_slugs\":false,\"additional_routes\":[{\"path\":\"access\",\"display_name\":\"Accessibility \",\"content\":{\"__html\":\"<p>We are proud to work with venues and film distributors that provide increased accessibility options.</p><p><br></p><p>Here you will find the films with subtitles, closed captions, and audio description where available for online and in-person screenings, and links to venue information about step-free access, wheelchair spaces and hearing loops.</p><p><br></p><p><span style=\\\"color: rgb(0, 0, 0);\\\">We accept CEA Card comps for registered companions.</span></p>\\n<style>\\na {\\n  color: #dc3a2f !important;\\n  font-weight: bold;\\n  text-decoration: none;\\n}\\na:hover, a:focus {\\n  color: #eaad52 !important;\\n  font-weight: bold;\\n  text-decoration: underline;\\n  }\\n  .ql-size-large {\\n    color: #eb4d6e !important\\n}\\n</style>\"},\"show_table\":true,\"table_header\":\"\",\"table\":[{\"title\":\"Subtitled Screenings\",\"description\":{\"__html\":\"<p class=\\\"ql-align-center\\\">Film screenings offering English subtitles</p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><span class=\\\"ql-size-large\\\">FULL LIST COMING SOON</span></p>\"},\"show_action_button\":false,\"action_text\":\"\",\"action_link\":\"subtitled-screenings\",\"action_primary\":true},{\"title\":\"Closed Captioned Screenings\",\"description\":{\"__html\":\"<p class=\\\"ql-align-center\\\">Film screenings offering HoH subtitles for the D/deaf or hard of hearing</p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><span class=\\\"ql-size-large\\\">FULL LIST COMING SOON</span></p>\"},\"show_action_button\":false,\"action_text\":\"\",\"action_primary\":true,\"action_link\":\"closed-captioned-screenings\"},{\"title\":\"Relaxed Screenings\",\"description\":{\"__html\":\"<p class=\\\"ql-align-center\\\">Film screenings that have been<span style=\\\"color: rgb(77, 81, 86);\\\"> adapted to be more welcoming and accessible to people with additional needs.</span></p><p><br></p><p class=\\\"ql-align-center\\\"><span class=\\\"ql-size-large\\\">FULL LIST COMING SOON</span></p>\"},\"show_action_button\":false,\"action_text\":\"\",\"action_link\":\"relaxed-screenings\",\"action_primary\":true},{\"title\":\"venue access\",\"description\":{\"__html\":\"<p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\">Useful links to venue information about step-free access, wheelchair spaces and hearing loops.</p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p>\"},\"show_action_button\":true,\"action_text\":\"view venues\",\"action_link\":\"venue-access\",\"action_primary\":true},{\"title\":\"Wheelchair accessible screenings \",\"description\":{\"__html\":\"<p class=\\\"ql-align-center\\\">Film screenings offering Wheelchair accessibility.</p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><br></p><p class=\\\"ql-align-center\\\"><span class=\\\"ql-size-large\\\">FULL LIST COMING SOON</span></p>\"},\"show_action_button\":false,\"action_text\":\"\",\"action_primary\":true,\"action_link\":\"wheelchair-accessible-screenings\"},{\"title\":\"Accessible Pricing\",\"show_action_button\":false,\"description\":{\"__html\":\"<p><strong>We are committed to making as many of our tickets affordable as possible too.</strong></p><p><br></p><p><strong>UNDER 35s</strong></p><p>£10 tickets available at certain cinemas (Phoenix, JW3, Everyman Belsize Park,&nbsp;Bristol Scott, Reel Cinema Borehamwood) for Under 35s.</p><p>Valid ID is required.</p><p>Check our festival schedule to see where the offer is applicable!&nbsp;</p><p><br></p><p><strong>STUDENT RUSH</strong></p><p>£5 Student Rush Tickets are available at certain screenings 10 minutes before the film starts.</p><p>Valid ID is required.</p>\"},\"action_text\":\"\",\"action_primary\":true}],\"hide_title\":false,\"hide_in_menu\":false},{\"path\":\"how-to-watch\",\"show_table\":false,\"table_header\":\"\",\"table\":[],\"display_name\":\"How to Watch\",\"post_table_content\":{\"__html\":\"<p class=\\\"ql-align-center\\\"><a href=\\\"https://ukjewishfilm.eventive.org/welcome\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" class=\\\"ql-size-large\\\" style=\\\"color: rgb(68, 68, 68);\\\"><strong>Back to homepage</strong></a></p>\"},\"hide_in_menu\":true,\"content\":{\"__html\":\"<p><strong class=\\\"ql-size-large\\\">How can I get a ticket?</strong></p><p><br></p><p>To reserve a place for online screenings, simply go to the&nbsp;<a href=\\\"https://ukjewishfilm.eventive.org/schedule\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(0, 0, 242);\\\">schedule</a>, select the film you want to watch, click the ‘Book Now’ button and you will be directed to the bookings page where you can enter your payment details.</p><p><br></p><p>You will receive a booking confirmation email once your order is completed.</p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">How can I watch a film once I’ve booked for it?</strong><strong>&nbsp;</strong></p><p><br></p><p>You will receive an email letting you know when the film you have booked to watch online become available to view. Log into your account on&nbsp;<a href=\\\"http://ukjewishfilm.eventive.org/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(107, 36, 178);\\\">ukjewishfilm.eventive.org</a>&nbsp;and go to “My Tickets” to find the film you want to watch. Click “Watch now” and you will be taken to the online viewing platform. Press play and enjoy!</p><p><br></p><p>Each of our exclusive, online film screenings will be available for a limited time period. This is stated in the information provided on each film's page, as well as a countdown to when the film becomes available.</p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can your online screenings sell out?&nbsp;</strong></p><p><br></p><p>Yes. We have film licence agreements to screen these films with maximum audience limits, as in a regular cinema space.</p><p><br></p><p>&nbsp;</p><p><strong class=\\\"ql-size-large\\\">ONLINE VIEWING GUIDE</strong></p><p><br></p><p><strong class=\\\"ql-size-large\\\">How can I watch the online screenings?&nbsp;&nbsp;</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">All online screenings are only accessible to view in the UK. You can watch films on PCs running Windows 7+, and Intel-based Macs running OSX 10.12+. You can also watch films on Android tablets and phones using Chrome, and on iPhones and iPads using Safari.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">What are the requirements for Windows computers?</strong></p><p><br></p><p><em style=\\\"color: rgb(52, 52, 52);\\\">Windows 7, Windows 8.1 or Windows 10</em></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Supported browsers: Google Chrome, Firefox, Microsoft Edge, Opera. We recommend using the latest version of your browser. Internet Explorer is not supported.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">What are the requirements for Mac computers?</strong></p><p><br></p><p><em style=\\\"color: rgb(52, 52, 52);\\\">Mac OSX 10.12 or later</em></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Supported browsers: Google Chrome, Firefox, Safari, or Opera. We recommend using the latest version of your browser.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">How can I watch the films on my television?&nbsp;</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">You can watch our online screenings in a number of ways: a) on your device (laptop or phone), b) connecting to your television via an HDMI cable, c) casting from a device over WiFi to your television, d) using an app via a set top box.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I watch films on my iPhone/iPad?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Yes, you can watch films using Safari on iOS 11.2 or later.&nbsp;</span><u style=\\\"color: rgb(52, 52, 52);\\\">Please note</u><span style=\\\"color: rgb(52, 52, 52);\\\">&nbsp;that you must have “Screen Mirroring” turned off for films to play.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I watch films on my Android Device?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Yes, you can watch films using Chrome on Android 6.0 or later.&nbsp;</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I Chromecast films?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">You can Chromecast from a Chrome web browser on PC and Mac computers as well as Android devices by selecting the cast button in the bottom right-hand side of the player.&nbsp;</span><a href=\\\"https://vimeo.com/475975604\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(107, 36, 178);\\\"><strong>Watch our video guide for how to Chromecast films</strong></a><span style=\\\"color: rgb(52, 52, 52);\\\">.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I AirPlay films on my AppleTV?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">You can AirPlay from most browsers if you have Apple TV by selecting the AirPlay button in the bottom right-hand side of the player.</span></p><p><br></p><p>&nbsp;</p><p><strong class=\\\"ql-size-large\\\">Can I watch films using Apple TV, Roku or Amazon FireTV?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">You can watch the films on a television using your Apple TV, Roku or Amazon FireTV Stick. Search for the Eventive TV app on the television and download it, then connect to your account following the instructions on screen. All films you have booked for will appear on the app once you have connected to your account.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I connect using an HDMI cable?</strong><strong>&nbsp;</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">An HDMI cable enables you to replicate your computer screen on your television screen. You can replicate the films being streamed on your computer by plugging in your HDMI cable to the port on your computer and the port on your television. You can then use the buttons on your computer to navigate what you are seeing on the television e.g. play, pause, etc.&nbsp;</span><a href=\\\"https://vimeo.com/476016495\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(67, 0, 152);\\\"><strong>Watch our video guide for how to connect using an HDMI cable</strong></a><span style=\\\"color: rgb(52, 52, 52);\\\">.&nbsp;</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Why does video playback stall or not play smoothly?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Our secure streaming platform (</span><strong style=\\\"color: rgb(52, 52, 52);\\\">eventive.org</strong><span style=\\\"color: rgb(52, 52, 52);\\\">) uses adaptive bitrate streaming which means the streaming quality will automatically adjust based on your internet speed. If your internet connection is poor or inconsistent you may experience problems during playback. If you’re on WiFi, try moving closer to your router, or plugging in an Ethernet cable.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Why do I see a black screen if I am watching content with AirPlay on my TV?</strong></p><p><br></p><p>You likely have “Screen Mirroring” turned on in your device settings. Please turn off the screen mirroring setting. To stop mirroring your iOS device, open Control Center, tap Screen Mirroring, then tap Stop Mirroring. Or press the Menu button on your Apple TV Remote. Start AirPlay by selecting the AirPlay button in the bottom right-hand side of the player.&nbsp;</p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Are the online screenings hosted on the UK Jewish Film website?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">No. While our year-round, on-demand platform can be browsed and booked on our website, these exclusive online screenings are being hosted at&nbsp;</span><a href=\\\"http://ukjewishfilm.eventive.org/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(107, 36, 178);\\\"><strong>ukjewishfilm.eventive.org</strong></a><strong>&nbsp;</strong><span style=\\\"color: rgb(52, 52, 52);\\\">through a secure on-demand streaming platform service called Eventive. Once you have purchased your ticket, you will be redirected to the secure platform.&nbsp;</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Will I be able to test my viewing set-up before the online screenings become available?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Yes. Our hosting site Eventive have their own tester film, and we encourage everyone to try it out before watching any films they have purchased.&nbsp;</span></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Visit their&nbsp;</span><a href=\\\"https://watch.eventive.org/account/play/5f0368a74282a70029055ca8\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(107, 36, 178);\\\">Device Compatibility page</a><span style=\\\"color: rgb(52, 52, 52);\\\">&nbsp;and follow the steps to unlock the free test video.</span></p><ul><li>You can test your device(s) for compatibility with our platform</li><li>Confirm that you are able to make a purchase</li><li>Confirm that you are receiving confirmation emails once a purchase has been completed.</li></ul><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I share the screening link with others?</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">No. Links to films are only for the ticket holder/household, and only one user login may be used per film. You may not forward or share the link with others. You are welcome to watch the films with a group of people, but the link cannot be shared.</span></p><p><br></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Can I pause the film half-way through and then pick up where I left off?&nbsp;</strong></p><p><br></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">Yes. Each film is available for a set period from its release date/time and can be watched as you choose over that time period. Once you start watching you have 6 hours to finish.</span></p><p><span style=\\\"color: rgb(52, 52, 52);\\\">﻿</span></p><p><br></p><p><strong class=\\\"ql-size-large\\\">Who can I contact for additional technical support?&nbsp;&nbsp;</strong></p><p><br></p><p>Further viewing FAQs and tips can be found&nbsp;<a href=\\\"https://watch.eventive.org/help\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(107, 36, 178);\\\">here</a>.</p>\"},\"hide_title\":false},{\"path\":\"venue-access\",\"display_name\":\"Venue Access\",\"content\":{\"__html\":\"<p>For information on access facilities and measures in place to keep you safe at each of our partner cinema venues, including step-free access, wheelchair access and hearing loops, please visit each venue's website using the links below.</p><p><br></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Please note that for any access requirements, you must speak to a member of the UK Jewish Film team at the time of booking.</span></p>\"},\"hide_in_menu\":true,\"show_table\":true,\"table\":[{\"description\":{\"__html\":\"<p><a href=\\\"https://whatson.bfi.org.uk/Online/default.asp\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(230, 0, 0);\\\">BFI Southbank</a></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Belvedere Road</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">South Bank</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">London</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">SE1 8XT</strong></p><p><br></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Nearest Station:</span></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Waterloo</span></p><p><a href=\\\"https://whatson.bfi.org.uk/Online/default.asp?BOparam::WScontent::loadArticle::permalink=access-around-bfi-southbank&amp;BOparam::WScontent::loadArticle::context_id=\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(68, 68, 68);\\\"><strong>Access Information</strong></a></p><p><br></p><p><br></p><p><a href=\\\"https://bristolwestburypark.scottcinemas.co.uk/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Bristol Scott Cinema</a></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Northumbria Drive</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Westbury Park</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Bristol</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">BS9 4HN</strong></p><p><br></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Nearest Stations:</span></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Clifton Down, Redland</span></p><p><a href=\\\"https://bristolwestburypark.scottcinemas.co.uk/accessibility\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(68, 68, 68);\\\"><strong>Access Information</strong></a></p><p><br></p><p><br></p><p><a href=\\\"https://www.cineworld.co.uk/cinemas/didsbury/051#/buy-tickets-by-cinema?in-cinema=051&amp;at=2022-09-26&amp;view-mode=list\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(230, 0, 0);\\\">Cineworld Parrs Wood</a></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Parrs Wood Entertainment Centre</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Wilmslow Road</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">Manchester</strong></p><p><strong style=\\\"color: rgb(68, 68, 68);\\\">M20 5PG</strong></p><p><br></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">Nearest Station:</span></p><p><span style=\\\"color: rgb(68, 68, 68);\\\">East Didsbury</span></p><p><a href=\\\"https://www.cineworld.co.uk/accessibility/\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(68, 68, 68);\\\"><strong>Access Information</strong></a></p><p><br></p><p><br></p><p><a href=\\\"https://www.picturehouses.com/cinema/city-screen-picturehouse\\\" rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\" style=\\\"color: rgb(230, 0, 0);\\\">City Screen Picturehouse, York</a></p><p><strong style=\\\"color: rgb(0, 0, 0);\\\">City Screen Picturehouse</strong></p><p><strong style=\\\"color: rgb(0