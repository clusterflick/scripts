o book)\",\"color\":\"#4176A5\",\"_id\":\"6ab262e9d7f848654e9c8e15\"},{\"key\":\"3\",\"label\":\"Companion Seat (Call UKJF to book)\",\"color\":\"#49A3BA\",\"_id\":\"6ab262e9d7f848654e9c8e16\"},{\"key\":\"4\",\"label\":\"Set Aside\",\"color\":\"#878787\",\"_id\":\"6ab262e9d7f848654e9c8e17\"},{\"key\":\"5\",\"label\":\"House Seats\",\"color\":\"#5d5d5d\",\"_id\":\"6ab262e9d7f848654e9c8e18\"}]},\"is_dated\":true,\"start_time\":\"2026-11-14T18:20:00.000Z\",\"end_time\":\"2026-11-14T20:20:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"disable_pass_quick_order\":false,\"credits_disabled\":false,\"tickets_available\":true,\"unlimited\":true,\"quantity\":0,\"ticket_buckets\":[{\"id\":\"6a9989c48fefafc33033ceec\",\"name\":\"Adult Standard\",\"price\":1700,\"unlimited\":true,\"quantity_sold\":19,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null},{\"id\":\"6a9989c58fefafc33033cef3\",\"name\":\"Under 35s (with valid ID)\",\"price\":1000,\"unlimited\":true,\"quantity_sold\":0,\"quantity_scanned\":0,\"quantity_remaining\":9007199254740991,\"reserved_seating_category\":\"1\",\"public\":true,\"autoissue_companion_ticket\":[],\"exclude_capacity\":false,\"lock_admin_only\":false,\"variable_price\":false,\"variable_price_minimum\":0,\"variants\":[],\"applicable_pass_buckets\":[],\"is_active\":true,\"virtual_intervals\":null}],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b68\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"The Mad Dog of Europe\",\"sort_key\":\"Mad Dog of Europe, The\",\"description\":\"<p>The latest documentary from award-winning journalist and BAFTA Breakthrough film director, Rubika Shah. Herman J. Mankiewicz is now one of Hollywood’s most revered screenwriters, most famous for writing the script for Citizen Kane, with Orson Welles. But before all that, the man known as ‘Mank’ tried and failed to get a very different project off the ground. The child of German-Jewish immigrants, Mankiewicz wanted to make a film warning his fellow Americans about the rise of Hitler and the Nazis. The project was titled The Mad Dog of Europe. But this was 1930s America, where virulent antisemitism was rife. And then Joseph Goebbels himself started taking notice...</p>\",\"cover_image\":\"https://static-a.eventive.org/1788894289085temp-1788894289025-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788894273540temp-1788894273491-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788894288777temp-1788894288725-still.jpg\",\"trailer_url\":\"https://youtu.be/3RCWIfKvATk\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"80\",\"language\":\"English\",\"country\":\"France, Germany\"},\"credits\":{\"director\":\"Rubikah Shah\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc478527e\",\"name\":\"Feature Film\",\"color\":\"#c78fff\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"id\":\"6a91ad0c20625c9624c04b64\",\"name\":\"Mavericks Strand\",\"color\":\"#7fff36\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785272\",\"name\":\"Documentary\",\"color\":\"#8186d0\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785276\",\"name\":\"UK Premiere\",\"color\":\"#9df210\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785274\",\"name\":\"English Language\",\"color\":\"#7ac1f4\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785270\",\"name\":\"Browse All Films\",\"color\":\"#51b4a1\",\"visible\":true}],\"comscore_include\":true,\"visibility\":\"visible\",\"created_at\":\"2026-08-28T15:45:16.744Z\",\"updated_at\":\"2026-09-08T19:04:48.723Z\",\"_use_beta_vod_flow_for_new_virtual_content\":true}],\"updated_at\":\"2026-10-09T10:45:38.364Z\",\"is_virtual\":false,\"comscore_include\":true,\"geographic_restrictions\":[],\"geographic_exclusions\":[],\"vague_geographic_restrictions\":false,\"show_in_coming_soon\":false,\"allow_preorder\":false,\"aarp_member_required\":false,\"show_quantity_countdown\":false,\"virtual_balloting_enabled\":false,\"virtual_balloting_inline_during_playback\":false,\"use_default_event_bucket_preroll\":true,\"virtual_content_preroll\":[],\"virtual_content_preroll_visible\":true,\"use_default_event_bucket_postroll\":true,\"virtual_content_postroll\":[],\"virtual_content_postroll_visible\":true,\"virtual_intervals\":null,\"display_ads\":[],\"images\":{},\"ledger_tags\":[],\"rules\":[]},{\"id\":\"6a9708e9415f2c5e1404d913\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"timezone\":\"Europe/London\",\"name\":\"DOCUMENTARY GALA: Shalom\",\"description\":\"<h1>DOCUMENTARY GALA</h1><h3>+ Pre-Feature Short <em>Fish, Chips &amp; Faith</em></h3><p><strong>PRICES:</strong></p><p><strong>Adult Standard: £20.00</strong></p><p><br></p><p>Tickets for this event are sold directly through Curzon Cinemas. Clicking the \\\"Order Tickets\\\" button will take you to their booking website.</p><p>There is a £2.00 booking fee for all bookings made via the Curzon website.</p><p><br></p><p>For all enquiries relating to your booking, please contact Curzon directly.</p><p>Curzon Ticket Booking Line: 08719 642838 (Calls to the ticket booking line cost 13p per minute, plus your service provider fees. Please be aware that there is a £2 booking fee for phone bookings.)</p><p>Curzon Customer Service: 01233 555644 (Local rates service. Please be aware, it is not possible to book tickets via this number.)</p><p><br></p><p><strong style=\\\"background-color: rgb(43, 41, 37); color: rgb(255, 255, 255);\\\">This screening will begin at the advertised time with no ads or trailers.</strong></p>\",\"short_description\":\"\",\"location\":\"Curzon Mayfair\",\"venue\":{\"id\":\"6a3000f01f63771bc478520c\",\"name\":\"Curzon Mayfair\",\"short_name\":\"Curzon Mayfair\",\"description\":\"For all booking enquiries, please call the venue directly: 08719 642838\",\"address\":\"Curzon Mayfair\\n38 Curzon St\\nLondon W1J 7TY\",\"default_capacity\":null,\"color\":\"#608ea4\",\"use_reserved_seating\":true,\"comscore_include\":false,\"seatmap_id\":\"cd261459-295f-302d-71e8-8c70ad0ba790\",\"seatmap_categories\":[{\"key\":\"1\",\"label\":\"Adult Standard\",\"color\":\"#992C4E\",\"_id\":\"675c5c67a9d65c62d8dea834\"},{\"key\":\"2\",\"label\":\"Wheelchair Space (Call box office to book)\",\"color\":\"#4176A5\",\"_id\":\"675c5c67a9d65c62d8dea835\"},{\"key\":\"3\",\"label\":\"Guests\",\"color\":\"#d3d3d3\",\"_id\":\"675c5c67a9d65c62d8dea836\"},{\"key\":\"4\",\"label\":\"Companion Seat (Call box office to book)\",\"color\":\"#49A3BA\",\"_id\":\"675c5c67a9d65c62d8dea837\"}]},\"is_dated\":true,\"start_time\":\"2026-11-14T20:00:00.000Z\",\"end_time\":\"2026-11-14T22:00:00.000Z\",\"cutoff_event_watch_at_availability_end\":false,\"tags\":[{\"id\":\"6aa94c525bba412e1e2417d2\",\"name\":\"+ Pre-Feature Short\",\"color\":\"#3697ff\",\"visible\":true}],\"visibility\":\"visible\",\"hide_tickets_button\":false,\"require_mailing_address\":false,\"require_phone_number\":false,\"rush_line_enabled\":false,\"passholder_ticket_required\":true,\"standalone_ticket_sales_enabled\":true,\"standalone_ticket_sales_unlocked\":false,\"sales_disabled_unless_coupon\":false,\"show_custom_checkout_message\":false,\"external_tickets_url\":\"https://www.curzon.com/ticketing/seats/MAY1-34614/\",\"disable_pass_quick_order\":false,\"credits_disabled\":true,\"tickets_available\":true,\"unlimited\":false,\"quantity\":0,\"ticket_buckets\":[],\"films\":[{\"id\":\"6a91ad0c20625c9624c04b3c\",\"type\":\"film\",\"event_bucket\":\"6a3000f01f63771bc47850df\",\"event_bucket_name\":\"UK Jewish Film Festival 2026\",\"owner_id\":\"5eabd86394261c0075794000\",\"name\":\"Shalom\",\"sort_key\":\"Shalom\",\"description\":\"<p>Winner of the Special Jury Prize at this year’s Docaviv film festival. Can animals teach us about coexistence? What happens to a zoo in a time of war? A unique perspective on the current state of Israel, told from the perspective of the Jerusalem Biblical Zoo. As war breaks out, the zookeepers must decide the fate of their ancient and ailing white rhino, Shalom. The zoo staff are a diverse group of Israelis and Palestinians. Their discussions about the political situation take place within the peaceful island of the zoo. But is this a real utopia, or is it something manufactured for an audience?</p>\",\"cover_image\":\"https://static-a.eventive.org/1788432208649temp-1788432208444-cover.jpg\",\"poster_image\":\"https://static-a.eventive.org/1788432209173temp-1788432208830-poster.jpg\",\"still_image\":\"https://static-a.eventive.org/1788432208246temp-1788432207940-still.jpg\",\"trailer_url\":\"https://youtu.be/FcFrrqDCFJs\",\"unballoted\":false,\"details\":{\"year\":\"2026\",\"runtime\":\"80\",\"language\":\"Hebrew, Arabic, French\",\"country\":\"Israel\",\"subtitle_language\":\"English\"},\"credits\":{\"director\":\"Meital Zvieli\"},\"expanded_credits\":[],\"tags\":[{\"id\":\"6a91ad0c20625c9624c04b3d\",\"name\":\"Best Documentary Award Nominee\",\"color\":\"#ff8fdc\",\"visible\":true},{\"id\":\"6a3000f01f63771bc4785275\",\"name\":\"Cinema Screening\",\"color\":\"#36e2ff\",\"visible\":true},{\"i