witter.com/WFCscreenings\"><img decoding=\"async\" class=\"adjusth\" src=\"/wp-content/uploads/icons/share/twitter_x.png\" alt=\"Twitter\"></a><a href=\"https://bsky.app/profile/wimbledonfilmclub.bsky.social\"><img decoding=\"async\" class=\"adjusth2\" src=\"/wp-content/uploads/icons/share/bluesky.png\" alt=\"Twitter\"></a><a href=\"https://www.threads.com/@wimbledonfilm\"><img decoding=\"async\" class=\"adjusth2\" src=\"/wp-content/uploads/icons/share/threads.png\" alt=\"Twitter\"></a></div>\n</div>\n</div>\n</div>\n</header></div>\n</header>\n\n\n<div class=\"wp-block-group is-layout-constrained wp-container-core-group-is-layout-f843088e wp-block-group-is-layout-constrained\">\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<div class=\"wp-block-columns break-1200 is-layout-flex wp-container-core-columns-is-layout-4f56b541 wp-block-columns-is-layout-flex\" style=\"margin-top:0px;margin-bottom:0px\">\n<div class=\"wp-block-column widen-1200 is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:680px\"><h3 style=\"font-size:30px;font-style:normal;font-weight:500;text-transform:capitalize; padding-left:10px;\" class=\"wp-block-post-title has-system-font-font-family\">A Real Pain</h3></div>\n\n\n\n<div class=\"wp-block-column widen-1200 is-layout-flow wp-container-core-column-is-layout-4a4a2463 wp-block-column-is-layout-flow\" style=\"padding-right:0px;padding-left:0px;flex-basis:330px\"><style type=\"text/css\"> .navigation { overflow:auto; padding:0 10px 5px; border-radius:5px; line-height:1.5; border:1px solid #498A2B; font-size:12pt; } .left { float:left; width:85px; } .mid { float:left; } .right { float:right; }@media only screen and (max-width: 350px) { .navigation { font-size:10pt; } span.hide { display:none; } }@media only screen and (max-width: 1199px) { .navigation { font-size:11pt; } }@media only screen and (min-width: 1200px) and (max-width: 1549px) { span.hide { display:none; } }</style>\n<div class=\"navigation\"><span class=\"left\">&nbsp;</span><span class=\"mid\"><a href=\"https://wimbledonfilmclub.co.uk/chuck-chuck-baby/\" title=\"Chuck Chuck Baby\">Next</a> &raquo;</span><span class=\"right\"><a href=\"/\">Back<span class=\"hide\"> to homepage</span></a></span></div>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:408px\"></div>\n</div>\n</div>\n\n\n\n<main class=\"wp-block-group is-layout-constrained wp-container-core-group-is-layout-eaad8fc0 wp-block-group-is-layout-constrained\" style=\"margin-bottom:-10px\">\n<div class=\"wp-block-columns break-1200 is-layout-flex wp-container-core-columns-is-layout-2896b766 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column widen-1200 has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:680px\"><div class=\"wp-block-template-part\"><div>\n<style>.auto-resizable-iframe { max-width: 660px; max-height: 360px; margin: 0px auto; }.auto-resizable-iframe > div { position: relative; padding-bottom: 56%; height: 0px; }.auto-resizable-iframe iframe { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }</style>\n<div class=\"auto-resizable-iframe\">\n<div><iframe title=\"A REAL PAIN | Official Trailer | Searchlight Pictures\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/b2et8Vpu7Ls?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>\n</div>\n</div>\n\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<style type=\"text/css\">div.scrndate { display: flex; justify-content: space-between; align-items: top; font-weight:500; }hr { border-top:1px solid #498A2B; margin:10px 0; }@media only screen and (max-width: 600px) { div.scrndate { font-size:12pt; } div.scrnvenue { font-size:10pt; } }@media only screen and (min-width: 600px) { div.scrndate { font-size:16pt; } div.scrnvenue { font-size:14pt; } }@media only screen and (min-width: 768px) { div.scrndate { font-size:20pt; } div.scrnvenue { font-size:14pt; } }</style>\n<div class=\"scrndate\"><span>September 16, 2025</span><a href=\"/index-members-choice/\" style=\"text-decoration:none;\"><span style=\"background-color:gold; color:black; padding: 0 10px; border-radius:5px;\">Members&#8217; Choice</span></a><span style=\"white-space:pre; padding-left:5px;\">8:00pm</span></div>\n<hr />\n\n\n\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<div class=\"entry-content wp-block-post-content is-layout-flow wp-block-post-content-is-layout-flow\"><p><i><span style=\"font-weight: 400;\">A Real Pain </span></i><span style=\"font-weight: 400;\">is the second feature as writer/director from actor Jesse Eisenberg (</span><i><span style=\"font-weight: 400;\">The Squid and the Whale</span></i><span style=\"font-weight: 400;\">, </span><i><span style=\"font-weight: 400;\">The Social Network</span></i><span style=\"font-weight: 400;\">). It focuses on two mis-matched Jewish-American cousins, the uptight David (Eisenberg), and free spirit Benji, going on a tour to Poland to explore their family roots. </span></p>\n<p><span style=\"font-weight: 400;\">Eisenberg originally intended to play Benji himself, but on the advice of his sister, who said “</span><i><span style=\"font-weight: 400;\">there is only one person on the planet who could play this part”, </span></i><span style=\"font-weight: 400;\">he instead cast Kieran Culkin: an actor whose work Eisenberg himself had seen little of at the time of casting, but is widely known to TV audiences for his Emmy-winning performance as Roman Roy in </span><i><span style=\"font-weight: 400;\">Succession</span></i><span style=\"font-weight: 400;\">. While Culkin’s bravura performance attracted the most attention, and swept the boards during awards season, the complex and often hilarious dynamic between the two main actors is at the heart of the film and its success.  </span></p>\n<p><span style=\"font-weight: 400;\">Eisenberg’s award-winning screenplay draws on a trip that he himself took with his wife in 2008 to explore his family’s Polish roots. The house shown in the film as the end destination of the cousins’ journey was the home of his great-aunt Doris, who fled the Nazis in 1938; after his 2008 trip Eisenberg took a photo of the house back to show to her. </span></p>\n<p><span style=\"font-weight: 400;\">In recognition of his film Eisenberg was awarded Polish citizenship by President Andrzej Duda, and expressed the hope in his acceptance speech that this would be the first step of his family reconnecting to Poland, where they had lived so long, but to which they no longer felt any connection &#8211; a key theme explored in his film.</span></p>\n<p><i><span style=\"font-weight: 400;\">“</span></i><span style=\"font-weight: 400;\">A Real Pain </span><i><span style=\"font-weight: 400;\">is a sublime, Rolls-Royce version of that often mis-handled genre: the mis-matched buddy comedy … a brilliant portrayal of shifting family dynamics in all its complicated, relatable messiness.” </span></i><span style=\"font-weight: 400;\">Ian Freer, </span><i><span style=\"font-weight: 400;\">Empire Magazine</span></i></p>\n<p><span style=\"font-weight: 400;\">“</span><i><span style=\"font-weight: 400;\">Eisenberg’s accomplished direction makes it seem effortless.” </span></i><span style=\"font-weight: 400;\">Wendy Ide, </span><i><span style=\"font-weight: 400;\">Observer</span></i></p>\n</div>\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<style type=\"text/css\"> hr { border-top:1px solid #498A2B; margin:10px 0; } .share-container { display:flex; flex-wrap:wrap; font-size:10pt; margin:10px 0; } .share-left { float:left; font-size:10pt; margin:4px 6px 5px 0; text-wrap:nowrap; } .share-middle { float:left; margin-right:20px; } .share-right1 { float:left; font-size:10pt; margin:4px 6px 5px 0; } .share-right2 { float:left; font-size:10pt; margin:4px 100px 0 4px; } img { vertical-align:top; }</style>\n<hr>\n<div class=\"share-container\">\n<div class=\"share-left\">Share this film (13275):</div>\n<div class=\"share-middle\"><a href=\"https://twitter.com/share?url=https://wimbledonfilmclub.co.uk/a-real-pain/&#038;text=A+Real+Pain%20-%20at%20the%20Wimbledon%20Film%20Club\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/twitter_x.png\" alt=\"Twitter\" width=30px></a><a href=\"https://www.facebook.com/sharer/sharer.php?u=https://wimbledonfilmclub.co.uk/a-real-pain/\" class=\"fb-xfbml-parse-ignore\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/facebook.png\" alt=\"Facebook\" width=30px></a><a href=\"whatsapp://send?text=https://wimbledonfilmclub.co.uk/a-real-pain/\" data-action=\"share/whatsapp/share\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/whatsapp.png\" alt=\"WhatsApp\" width=30px></a><a href=\"https://www.linkedin.com/sharing/share-offsite/?url=https://wimbledonfilmclub.co.uk/a-real-pain/\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/linkedin.png\" alt=\"LinkedIn\" width=30px></a><a href=\"mailto:?subject=A Real Pain%20at%20the%20Wimbledon%20Film%20Club&#038;body=%0D%0A%0DIn honour of their late grandmother, two mismatched cousins embark on a tour of Poland in this funny, intelligent road trip comedy.  Writer-director-star Jesse Eisenberg won the Best Original Screenplay BAFTA; while a scene-stealing Kieran Culkin swept the awards season board, winning the Oscar for Best Supporting Actor.%0A%0D%0Ahttps://wimbledonfilmclub.co.uk/a-real-pain/\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/email.png\" alt=\"Email\" width=30px></a></div>\n<div class=\"share-right1\">Click for the WFC poster:</div>\n<div class=\"share-right2\"><a href=\"/wp-content/uploads/poster/wfc_poster.php?film_id=13275\" target=\"_blank\"><img decoding=\"async\" style=\"border-radius:2px;\" src=\"/wp-content/uploads/icons/share/wfc.png\" alt=\"WFC\" width=22px></a></div>\n</div>\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background-background-color has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:320px\"><div class=\"wp-block-template-part\"><figure class=\"wp-block-post-featured-image\"><a href=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain.jpg\" title=\"A Real Pain\"><img width=\"1200\" height=\"675\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain.jpg 1200w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain-300x169.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain-1024x576.jpg 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain-768x432.jpg 768w\" sizes=\"(max-width: 1200px) 100vw, 1200px\" /></a></figure>\n\n<style type=\"text/css\">\n.box { display:inline; }\ntable { padding-bottom:15px; }\ntr { vertical-align:top; }\n.bbfc { vertical-align:middle; }\n.scoreboard { width:auto; border:1px solid #498a2b; padding:5px; margin:20px 0px; text-align:center; font-weight:bold; }\n.starlabel { font-size:16pt; padding:5px 0; }\n.starline { padding:5px 0 10px; }\nimg.starpic { vertical-align: middle; padding:0; }\n@media only screen and (max-width: 360px) { .starlabel { font-size:13pt; } }\n</style>\n<div class=\"box\">\n<span style=\"font-weight:500; font-size:20pt\">Film Information</span>\n</div>\n<div class=\"box\">\n<table border=0 cellspacing=0 valign=top width=100%>\n<tr>\n<td nowrap>Release year:</td>\n<td>2024</tr>\n<tr>\n<td nowrap>Running time:&nbsp;&nbsp;</td>\n<td>90 mins</tr>\n<tr>\n<td>Directed by:</td>\n<td>Jesse Eisenberg</tr>\n<tr>\n<td>Language:</td>\n<td>English</tr>\n<tr>\n<td>Country:</td>\n<td>USA</tr>\n<tr>\n<td nowrap>Classification:</td>\n<td><img decoding=\"async\" class=\"bbfc\" src=\"/wp-content/uploads/bbfc/BBFC_15_2019.svg.png\"></tr>\n<tr>\n<td>Genre:</td>\n<td>Comedy, Drama</tr>\n<tr>\n<td>Starring:</td>\n<td>Kieran Culkin,<br />Jesse Eisenberg,<br />Will Sharpe,<br />Jennifer Grey,<br />Kurt Egyiawan,<br />Liza Sadovy,<br />Daniel Oreskes</tr>\n<tr>\n<td>Awards:</td>\n<td>Oscar Best Supporting Actor;<br />BAFTA Best Original Screenplay</tr>\n<tr>\n<td>More info: </p>\n<td><a href=\"https://www.imdb.com/title/tt21823606/?ref_=ttawd_ov_bk\">IMDb</a><br /><a href=\"https://www.rottentomatoes.com/m/a_real_pain\">Rotten Tomatoes</a></tr>\n</table>\n</div>\n<div class=\"scoreboard\">\n<div class=\"starlabel\">WFC Audience Score:&nbsp;&nbsp;80%</div>\n<div class=\"starline\"><img decoding=\"async\" class=\"starpic\" src=\"/wp-content/uploads/stars/full-star.png\"><img decoding=\"async\" class=\"starpic\" src=\"/wp-content/uploads/stars/full-star.png\"><img decoding=\"async\" class=\"starpic\" src=\"/wp-content/uploads/stars/full-star.png\"><img decoding=\"async\" class=\"starpic\" src=\"/wp-content/uploads/stars/full-star.png\"><img decoding=\"async\" class=\"starpic\" src=\"/wp-content/uploads/stars/grey-star.png\"></div>\n</div>\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:400px\"><div class=\"wp-block-template-part\"><div style=\"display:inline;\"><button onclick=\"window.location.href='/archive/'\" style=\"cursor: pointer; background-color:blue; border:none; border-radius: 6px; color:white; padding:15px 22px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:200px\" type=\"button\">Search the Archive</button></p>\n<p style=\"font-size:12pt\">View our 387 screenings by season, country, language and other dimensions.</div>\n<hr style=\"border-top:1px solid #498A2B\">\n\n\n<style> p:target {-webkit-animation: target-fade 2s;-moz-animation: target-fade 2s;-o-animation: target-fade 2s;animation: target-fade 2s;}@-webkit-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-moz-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-o-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}</style>\n\n\n<p class=\"has-small-font-size\" id=\"newsletter\">Sign up for the Wimbledon Film Club mailing list to hear about our upcoming screenings.</p>\n\n\n<!-- Begin Mailchimp Signup Form -->\n<style type=\"text/css\">\n\t#mc_embed_signup {background:#fff; clear:left; font:14px Segoe UI, Arial, sans-serif;  width:300px; padding: 10px 0px 10px 0px;}\n\tlabel {line-height:1; margin:12px 0px 5px 5px;}\n\tinput {line-height:1; margin:12px 0px 5px 0px;}\n\t#mc-embedded-subscribe {cursor: pointer; background-color:#498a2b; border:none; border-radius: 6px; color:white; padding:8px 15px 8px 15px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:110px; }\n\tlabel { float:left; }\n\t#mce-EMAIL { width:226px; float:right; margin-right:12px;}\n\t#mce-FNAME { width:81px; }\n\t#mce-LNAME { width:120px; float:right; margin-right:12px;}\n\t@media only screen and (max-width:360px) { #mce-EMAIL { width:187px; } #mce-FNAME { width:65px } #mce-LNAME { width:96px } #mc_embed_signup { width:260px; } }\n</style>\n<div id=\"mc_embed_signup\">\n<form action=\"https://wimbledonfilmclub.us3.list-manage.com/subscribe/post?u=258b97ba9c4142f4b835ae1de&amp;id=141aeb9fdb\" method=\"post\" autocomplete=\"on\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_blank\" novalidate=\"\">\n    <div id=\"mc_embed_signup_scroll\">\n<div class=\"mc-field-group\">\n\t<div style=\"display:inline-block; width:100%; vertical-align:text-top;\"><label for=\"mce-EMAIL\">Email:&nbsp;</label>\n\t<input type=\"email\" value=\"\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\"></div>\n</div>\n<div class=\"mc-field-group\">\n\t<div style=\"display:inline-block; width:100%; vertical-align:text-top;\"><label for=\"mce-FNAME\">Name:&nbsp;</label>\n\t<input type=\"text\" value=\"\" name=\"FNAME\" class=\"\" id=\"mce-FNAME\">\n\t<label for=\"mce-LNAME\"></label>\n\t<input type=\"text\" value=\"\" name=\"LNAME\" class=\"\" id=\"mce-LNAME\"></div>\n</div>\n\t<div id=\"mce-responses\" class=\"clear\">\n\t\t<div class=\"response\" id=\"mce-error-response\" style=\"display:none\"></div>\n\t\t<div class=\"response\" id=\"mce-success-response\" style=\"display:none\"></div>\n\t</div>    <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->\n    <div style=\"position: absolute; left: -5000px;\" aria-hidden=\"true\"><input type=\"text\" name=\"b_258b97ba9c4142f4b835ae1de_141aeb9fdb\" tabindex=\"-1\" value=\"\"></div>\n    <div style=\"width:100%; background-color:#fff; padding-bottom:5px; overflow:hidden;\">\n\t<div style=\"display:inline-block; width:100%;\">\n\t\t<span style=\"margin:20px 0px 0px 5px; float:left; font-size:10pt; font-style:italic;\">All fields are required</span>\n\t\t<span style=\"margin-right:12px; float:right;\"><input type=\"submit\" value=\"Subscribe\" name=\"subscribe\" id=\"mc-embedded-subscribe\"></span>\n\t</div>\n\t</div>\n    </div>\n</form>\n</div>\n\n<!--End mc_embed_signup-->\n\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-alpha-channel-opacity has-background is-style-wide\" style=\"background-color:#4caf50;color:#4caf50\"/>\n\n\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n\n</div></div>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<hr class=\"wp-block-separator has-text-color has-alpha-channel-opacity has-background is-style-wide\" style=\"background-color:#4d4e53;color:#4d4e53\"/>\n\n\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-28f84493 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-top:10px;padding-right:10px;padding-bottom:10px;padding-left:10px\"><div class=\"wp-block-template-part\"><table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\n<tr>\n<td style=\"font-style:italic; width:51pt\">Season:</td>\n<td style=\"font-size:13pt\"><a href=\"/category/2025-26\">2025-26</a></tr>\n<tr>\n<td style=\"font-style:italic; vertical-align:top;\">Tags:</td>\n<td><a href=\"/tag/class-15\">Classification: 15</a>, <a href=\"/tag/country-usa\">Country: USA</a>, <a href=\"/tag/genre-comedy\">Genre: Comedy</a>, <a href=\"/tag/genre-drama\">Genre: Drama</a>, <a href=\"/tag/language-english\">Language: English</a>, <a href=\"/tag/members-choice\">Members&#8217; Choice</a></tr>\n</table>\n</div></div>\n</div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-alpha-channel-opacity has-background is-style-wide\" style=\"margin-top:0px;margin-bottom:0px;background-color:#4d4e53;color:#4d4e53\"/>\n\n\n\n<div class=\"wp-block-group is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns is-not-stacked-on-mobile is-layout-flex wp-con