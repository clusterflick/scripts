nd-color:#deffcf;padding-top:0px;padding-right:10px;padding-bottom:0px;padding-left:10px;flex-basis:1400px\"><div class=\"wp-block-template-part\"><style type=\"text/css\">.ticker-wrapper { display: flex; background-color: #DEFFCF; padding: 2px 10px 3px 0px; margin: 0 auto; width: 100%; }.ticker-tape-container { overflow-x: hidden; display: flex; }.ticker-tape { --direction: normal; --duration: 20s; --delay: 0s; --iteration-count: 2; --play: running;  display: flex; gap: 10px; flex: 0 0 auto; margin-right: 10px; min-width: 100%; align-items: center;  animation: wfc-ticker var(--duration) linear var(--delay) var(--iteration-count); animation-play-state: var(--play); animation-delay: var(--delay); animation-direction: var(--direction); }@keyframes wfc-ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }.basic-styling { margin: 0px auto; background-color: #DEFFCF; padding: 5px; color: #222222; font-size: 16px; font-family: sans-serif; width: 100%; }.basic-styling span { padding: 0.25rem 1rem; border-radius: 10px; border: 2px solid #DEFFCF; background-color: white; }@media only screen and (max-width: 374px) { .basic-styling { font-size: 14px; } }.ticker-item { display: contents; }</style>\n<div class=\"ticker-wrapper\">\n<div class=\"basic-styling ticker-tape-container\">\n<div class=\"ticker-tape\"><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=16514\">WFC Pub Quiz 2026</a></span><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=15887\">Announcing our 2025-26 Winter Programme and Return to the Curzon</a></span><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=15508\">The WFC and LGBTQ+ Cinema</a></span><span><a class=\"ticker-item\" href=\"/become-member\">Membership is now open</a></span></div>\n<div class=\"ticker-tape\" aria-hidden=\"true\"><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=16514\">WFC Pub Quiz 2026</a></span><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=15887\">Announcing our 2025-26 Winter Programme and Return to the Curzon</a></span><span><a class=\"ticker-item\" href=\"https://wimbledonfilmclub.co.uk/?page_id=15508\">The WFC and LGBTQ+ Cinema</a></span><span><a class=\"ticker-item\" href=\"/become-member\">Membership is now open</a></span></div>\n</div>\n</div>\n</div></div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group is-layout-constrained wp-container-core-group-is-layout-3afb7117 wp-block-group-is-layout-constrained\" style=\"margin-top:0px;margin-bottom:-9px;padding-top:0px;padding-bottom:0px\">\n<div class=\"wp-block-columns break-1200 is-layout-flex wp-container-core-columns-is-layout-aca22cf8 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column widen-1200 has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:680px\"><div class=\"wp-block-template-part\"><style> .hpcontainer { position:relative; object-fit:contain; border-style:none; border-collapse:collapse; border-width:thin; } .memberschoice { position:absolute; top:5px; right:5px; background-color:gold; color:black; padding:6px 10px; border-radius:5px; display:inline-block; font-size:10pt; } .scrndate { position:absolute; top:5px; left:5px; background-color:grey; color:white; padding:0px 10px; border-radius:5px; display:inline-block; font-size:16pt; font-weight:bold; } .datetext2 { display:none; } .homeimg { width: 100%; height: auto; } .bbfc { position: absolute; bottom: 5px; right: 5px; } .soldout { position:absolute; top:150px; left:170px; transform:rotate(-30deg); opacity:0.7; background-color:white; color:black; padding:0px 50px 3px 50px; display:inline-block; font-size:38pt; font-weight:bold; } .flex-container { display:flex; flex-direction:row; justify-content:space-between; } .label { display:inline; font-style:italic; font-weight:normal; font-size:18pt; } .filmname { display:inline-block; font-weight:bold; font-size:24pt; } @media only screen and (max-width: 600px) { .flex-container { flex-direction: column; } .scrndate { opacity:0.7; font-size:12pt; } .datetext1 { display:none; } .datetext2 { display:inline; } .memberschoice { opacity:0.7; padding:3px 10px; } .soldout { position:absolute; top:80px; left:30px; transform:rotate(-15deg); font-size:20pt; } .label { font-size:12pt; }  .filmname { display:block; }  .bbfc_icon { width:30px; } }</style>\n<div style=\"margin-top:0pt; margin-bottom:10pt;\"><span class=\"label\">Next film: </span><a href=\"https://wimbledonfilmclub.co.uk/holy-cow/\"><span class=\"filmname\">Holy Cow</span></a></div>\n<div class=\"hpcontainer\"><a href=\"https://wimbledonfilmclub.co.uk/holy-cow/\"><img width=\"856\" height=\"428\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/image-w856_two_one.jpg\" class=\"homeimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/image-w856_two_one.jpg 856w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/image-w856_two_one-300x150.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/image-w856_two_one-768x384.jpg 768w\" sizes=\"auto, (max-width: 856px) 100vw, 856px\" /></p>\n<div class=\"scrndate\">January 20</div>\n<div class=\"bbfc\"><img decoding=\"async\" class=\"bbfc_icon\" src=\"/wp-content/uploads/bbfc/bbfc_15_big.png\"></div>\n<p></a></div>\n<div class=\"flex-container\">\n<div style=\"display:inline-block; font-size:12pt; margin-right:5px; margin-bottom:5px;\"><span class=\"datetext1\">The screening will be at 8:30pm at the <a href=\"https://maps.app.goo.gl/cibAFgVKJQzUmAxK7\" target=\"_blank\">Curzon Wimbledon</a>.<br />Click the image above for trailer and more information.</span><span class=\"datetext2\">The screening will be at 8:30pm at the <a href=\"https://maps.app.goo.gl/cibAFgVKJQzUmAxK7\" target=\"_blank\">Curzon Wimbledon</a>. Click the image above for trailer and more information.</span></div>\n<div style=\"display:inline-block; font-size:12pt;\">\n<style> .buy_button { cursor: pointer; background-color:#498a2b; border:none; border-radius: 6px; color:white; padding:15px 22px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:200px }</style>\n<div class=\"tt-widget-fallback\"><a href=\"https://www.tickettailor.com/checkout/new-session/id/7388047/chk/043c/\" target=\"_blank\"><button type=\"button\" class=\"buy_button\">Buy Tickets</button></a></div>\n</div>\n</div>\n<div style=\"display:block; font-size:11pt; margin-top:5px;\">Tickets are now on sale for members and non-members.</div>\n<div style=\"display:block; font-size:13pt;\">\n<hr style=\"border-top:1px solid #498A2B\">\n<p><span style=\"font-weight: 400;\">Part time farmer Louise Courvoisiers’ debut film, </span><i><span style=\"font-weight: 400;\">Holy Cow</span></i><span style=\"font-weight: 400;\">, is centred on a family of struggling farmers in the remote Jura region. Being France, cheese is never far away. </span></p>\n<p><span style=\"font-weight: 400;\">Teenage Totone’s (Clément Faveau) carefree drinking and cavorting ways are challenged when he suddenly has to provide for his young sister. The family farm is failing and he manages to get a job in the local dairy, however, that is no way to make ends meet. Can he do so by producing an award winning cheese and so win a competition prize? </span></p>\n<p><span style=\"font-weight: 400;\">Maïwene Barthelemy’s performance is wonderful, as the teenage farmer with whom Totone falls in love. Forcing him to grow up, she challenges his swagger and underlying insecurities. </span></p>\n<p><span style=\"font-weight: 400;\">The stunning countryside of the hills and verdant fields of the Jura is juxtapositioned with hard scrabble rural working class poverty.</span></p>\n<p><span style=\"font-weight: 400;\">The cheesemaking scenes are almost handled with reverence, certainly a great respect for the small-scale artisanal way of life.</span></p>\n<p><span style=\"font-weight: 400;\">It’s a warm hearted coming of age drama with a non professional cast.</span></p>\n<p><i><span style=\"font-weight: 400;\">&#8220;Faveau gives an amazingly subtle performance; Totone doesn’t say much but his fragility and complexity are all there, humour too in the little shrug of a shoulder.&#8221; </span></i><span style=\"font-weight: 400;\">The Guardian</span></p>\n<p><span style=\"font-weight: 400;\">&#8220;<em>[</em></span><em><span style=\"font-weight: 400;\">T</span><span style=\"font-weight: 400;\">]</span></em><i><span style=\"font-weight: 400;\">the filmmaker skewers romantic idylls by depicting the unglamorous realities of working-class country living.&#8221;</span></i><span style=\"font-weight: 400;\"> Sight and Sound</span></p>\n</div>\n<div style=\"font-size:13pt\">\n<p><span style=\"font-weight:bold\">Starring</span>: Clément Faveau, Maïwene Barthelemy, Luna Garret, Mathis Bertrand, Dimitry Baudry.</div>\n<div style=\"font-size:13pt;\">\n<p><span style=\"font-weight:bold\">Awards</span>: Cannes Un Certain Regard – Youth Prize; César Awards: Best First Film, Best Female Revelation (Barthelemy).</div>\n<div style=\"font-size:13px; font-style:italic; text-align:center;\">\n<hr style=\"border-top:1px solid #498A2B; margin:10px 0;\"><span>All films and speakers subject to availability. Film notes provided at each screening. Ticket sales are handled through Ticket Tailor. This includes the opportunity to opt in or out of emails about future screenings.</span></div>\n\n\n<style type=\"text/css\"> hr { border-top:1px solid #498A2B; margin:10px 0; } .share-container { display:flex; flex-wrap:wrap; font-size:10pt; margin:10px 0; } .share-left { float:left; font-size:10pt; margin:4px 6px 5px 0; text-wrap:nowrap; } .share-middle { float:left; margin-right:20px; } .share-right1 { float:left; font-size:10pt; margin:4px 6px 5px 0; } .share-right2 { float:left; font-size:10pt; margin:4px 100px 0 4px; } img { vertical-align:top; }</style>\n<hr>\n<div class=\"share-container\">\n<div class=\"share-left\">Share this website:</div>\n<div class=\"share-middle\"><a href=\"https://twitter.com/share?url=https://wimbledonfilmclub.co.uk&#038;text=Wimbledon+Film+Club\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/twitter_x.png\" alt=\"Twitter\" width=30px></a><a href=\"https://www.facebook.com/sharer/sharer.php?u=https://wimbledonfilmclub.co.uk\" class=\"fb-xfbml-parse-ignore\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/facebook.png\" alt=\"Facebook\" width=30px></a><a href=\"whatsapp://send?text=https://wimbledonfilmclub.co.uk\" data-action=\"share/whatsapp/share\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/whatsapp.png\" alt=\"WhatsApp\" width=30px></a><a href=\"https://www.linkedin.com/sharing/share-offsite/?url=https://wimbledonfilmclub.co.uk\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/linkedin.png\" alt=\"LinkedIn\" width=30px></a><a href=\"mailto:?subject=Wimbledon Film Club&#038;body=%0D%0A%0D%0A%0D%0Ahttps://wimbledonfilmclub.co.uk\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/email.png\" alt=\"Email\" width=30px></a></div>\n</div>\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background-background-color has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:320px\"><div class=\"wp-block-template-part\"><style> .link { display:contents; } .wrapper { margin: -8px 0; } .filmimg {width:100%; height:auto; object-fit:contain}</style>\n<div style=\"margin:0pt 0pt 16pt 0pt; font-weight:500\"><span>Coming Up</span></div>\n<hr style=\"border: 3px solid #498a2b; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/santosh/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"142\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/santosh-2024-ezgif.com-webp-to-jpg-converter-300x142.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/santosh-2024-ezgif.com-webp-to-jpg-converter-300x142.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/santosh-2024-ezgif.com-webp-to-jpg-converter-768x364.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/santosh-2024-ezgif.com-webp-to-jpg-converter.jpg 831w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Santosh</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>February 3</span><span style=\"background-color:gold; color:black; font-weight:normal; font-size:10pt; padding: 2px 5px 2px 5px; border-radius:5px; display: inline-block;\">&nbsp;Members&#8217; Choice&nbsp;</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_15_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid #498a2b; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/chungking-express/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"188\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-300x188.png\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-300x188.png 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-1024x641.png 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-768x481.png 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec.png 1118w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Chungking Express</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>February 17</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid #498a2b; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/all-that-heaven-allows/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"180\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/5-All-that-Heaven-Allows-landscape-updated-23-Dec-300x180.png\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/5-All-that-Heaven-Allows-landscape-updated-23-Dec-300x180.png 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/5-All-that-Heaven-Allows-landscape-updated-23-Dec-1024x614.png 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/5-All-that-Heaven-Allows-landscape-updated-23-Dec-768x461.png 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/5-All-that-Heaven-Allows-landscape-updated-23-Dec.png 1167w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">All That Heaven Allows</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>March 10</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_U_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid #498a2b; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/souleymanes-story/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"200\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/6-Souleymanes-Story-landscape-v3a-300x200.png\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/6-Souleymanes-Story-landscape-v3a-300x200.png 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/6-Souleymanes-Story-landscape-v3a-1024x681.png 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/6-Souleymanes-Story-landscape-v3a-768x511.png 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/6-Souleymanes-Story-landscape-v3a.png 1052w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Souleymane’s Story</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>March 17</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid red; border-radius: 3px;\">\n<div style=\"margin:16pt 0pt 16pt 0pt; font-weight:500\"><span>2025-26 to date</span></div>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/a-real-pain/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"169\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/A-Real-Pain-300x169.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" lo