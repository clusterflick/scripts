ons/share/bluesky.png\" alt=\"Twitter\"></a><a href=\"https://www.threads.com/@wimbledonfilm\"><img decoding=\"async\" class=\"adjusth2\" src=\"/wp-content/uploads/icons/share/threads.png\" alt=\"Twitter\"></a></div>\n</div>\n</div>\n</div>\n</header></div>\n</header>\n\n\n<div class=\"wp-block-group is-layout-constrained wp-container-core-group-is-layout-f843088e wp-block-group-is-layout-constrained\">\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<div class=\"wp-block-columns break-1200 is-layout-flex wp-container-core-columns-is-layout-4f56b541 wp-block-columns-is-layout-flex\" style=\"margin-top:0px;margin-bottom:0px\">\n<div class=\"wp-block-column widen-1200 is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:680px\"><h3 style=\"font-size:30px;font-style:normal;font-weight:500;text-transform:capitalize; padding-left:10px;\" class=\"wp-block-post-title has-system-font-font-family\">Chungking Express</h3></div>\n\n\n\n<div class=\"wp-block-column widen-1200 is-layout-flow wp-container-core-column-is-layout-4a4a2463 wp-block-column-is-layout-flow\" style=\"padding-right:0px;padding-left:0px;flex-basis:330px\"><style type=\"text/css\"> .navigation { overflow:auto; padding:0 10px 5px; border-radius:5px; line-height:1.5; border:1px solid #498A2B; font-size:12pt; } .left { float:left; width:85px; } .mid { float:left; } .right { float:right; }@media only screen and (max-width: 350px) { .navigation { font-size:10pt; } span.hide { display:none; } }@media only screen and (max-width: 1199px) { .navigation { font-size:11pt; } }@media only screen and (min-width: 1200px) and (max-width: 1549px) { span.hide { display:none; } }</style>\n<div class=\"navigation\"><span class=\"left\">&laquo; <a href=\"https://wimbledonfilmclub.co.uk/santosh/\" title=\"Santosh\">Previous</a></span><span class=\"mid\"><a href=\"https://wimbledonfilmclub.co.uk/all-that-heaven-allows/\" title=\"All That Heaven Allows\">Next</a> &raquo;</span><span class=\"right\"><a href=\"/\">Back<span class=\"hide\"> to homepage</span></a></span></div>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:408px\"></div>\n</div>\n</div>\n\n\n\n<main class=\"wp-block-group is-layout-constrained wp-container-core-group-is-layout-eaad8fc0 wp-block-group-is-layout-constrained\" style=\"margin-bottom:-10px\">\n<div class=\"wp-block-columns break-1200 is-layout-flex wp-container-core-columns-is-layout-2896b766 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column widen-1200 has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:680px\"><div class=\"wp-block-template-part\"><div>\n<style>.auto-resizable-iframe { max-width: 660px; max-height: 360px; margin: 0px auto; }.auto-resizable-iframe > div { position: relative; padding-bottom: 56%; height: 0px; }.auto-resizable-iframe iframe { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }</style>\n<div class=\"auto-resizable-iframe\">\n<div><iframe title=\"CHUNGKING EXPRESS 4K | Official Trailer (English)\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/OPCug9jyG9k?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>\n</div>\n</div>\n\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<style type=\"text/css\">div.scrndate { display: flex; justify-content: space-between; align-items: top; font-weight:500; }hr { border-top:1px solid #498A2B; margin:10px 0; }@media only screen and (max-width: 600px) { div.scrndate { font-size:12pt; } div.scrnvenue { font-size:10pt; } }@media only screen and (min-width: 600px) { div.scrndate { font-size:16pt; } div.scrnvenue { font-size:14pt; } }@media only screen and (min-width: 768px) { div.scrndate { font-size:20pt; } div.scrnvenue { font-size:14pt; } }</style>\n<div class=\"scrndate\"><span>February 17</span><span style=\"white-space:pre; padding-left:5px;\">8:30pm</span></div>\n<div class=\"scrnvenue\">At the Curzon Wimbledon (see <a href=\"https://maps.app.goo.gl/cibAFgVKJQzUmAxK7\">map</a>)</div>\n<hr />\n\n\n\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<div class=\"entry-content wp-block-post-content is-layout-flow wp-block-post-content-is-layout-flow\"><p><span style=\"font-weight: 400;\">Wong Kar-wai originally envisaged a three-part anthology but was so taken with the individual stories that he expanded them to the point where it made more sense to separate them into two films. The second film is </span><i><span style=\"font-weight: 400;\">Fallen Angels</span></i><span style=\"font-weight: 400;\"> (1995), a more hard-boiled crime thriller but with the same distinctive visual style and directorial panache. </span></p>\n<p><span style=\"font-weight: 400;\">As the director explained, “</span><i><span style=\"font-weight: 400;\">The main characters of </span></i><span style=\"font-weight: 400;\">Chungking Express</span><i><span style=\"font-weight: 400;\"> are not Faye Wong or Takeshi Kaneshiro, but the city itself, the night and day of Hong Kong. </span></i><span style=\"font-weight: 400;\">Chungking Express</span><i><span style=\"font-weight: 400;\"> and </span></i><span style=\"font-weight: 400;\">Fallen Angels</span><i><span style=\"font-weight: 400;\"> together are the bright and dark of Hong Kong</span></i><span style=\"font-weight: 400;\">.”</span></p>\n<p><span style=\"font-weight: 400;\">The two stories in </span><i><span style=\"font-weight: 400;\">Chungking Express</span></i><span style=\"font-weight: 400;\"> both concern policemen who have just been left by their girlfriends and who retreat into obsessive and maudlin behaviour to deal with the breakup. In each case they encounter very different women, more practical and philosophical, who help them resurface. The two stories have deliberate echoes of each other, giving the feel of a series of variations on a theme, which in turn highlights the important role of music and motifs, such as food and airplanes.</span></p>\n<p><span style=\"font-weight: 400;\">Among the director’s body of work, the film is notable for its wry humour. Where it is more typical of his style is in the saturated colours and kinetic cinematography made famous by his 2000 film, </span><i><span style=\"font-weight: 400;\">In The Mood for Love</span></i><span style=\"font-weight: 400;\">.</span></p>\n<p><i><span style=\"font-weight: 400;\">“Chungking Express … is Hong Kong from the inside … the city refracted through an optic of fast food, Hollywood glamour and early new wave shooting style.” </span></i><span style=\"font-weight: 400;\">Jonathan Romney,</span><i><span style=\"font-weight: 400;\"> The Guardian (</span></i><span style=\"font-weight: 400;\">1995</span><i><span style=\"font-weight: 400;\">)</span></i></p>\n<p><i><span style=\"font-weight: 400;\">“This is the kind of movie you’ll relate to if you love film itself, rather than its surface aspects such as story and stars. If you are attentive to the style, if you think about what Wong is doing, “</span></i><span style=\"font-weight: 400;\">Chungking Express</span><i><span style=\"font-weight: 400;\">” works. If you’re trying to follow the plot, you may feel frustrated.” </span></i><span style=\"font-weight: 400;\">Roger Ebert,</span><i><span style=\"font-weight: 400;\"> rogerebert.com (</span></i><span style=\"font-weight: 400;\">1996</span><i><span style=\"font-weight: 400;\">)</span></i></p>\n</div>\n\n\n<div style=\"height:10px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n<style type=\"text/css\"> hr { border-top:1px solid #498A2B; margin:10px 0; } .share-container { display:flex; flex-wrap:wrap; font-size:10pt; margin:10px 0; } .share-left { float:left; font-size:10pt; margin:4px 6px 5px 0; text-wrap:nowrap; } .share-middle { float:left; margin-right:20px; } .share-right1 { float:left; font-size:10pt; margin:4px 6px 5px 0; } .share-right2 { float:left; font-size:10pt; margin:4px 100px 0 4px; } img { vertical-align:top; }</style>\n<hr>\n<div class=\"share-container\">\n<div class=\"share-left\">Share this film (16116):</div>\n<div class=\"share-middle\"><a href=\"https://twitter.com/share?url=https://wimbledonfilmclub.co.uk/chungking-express/&#038;text=Chungking+Express%20-%20at%20the%20Wimbledon%20Film%20Club\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/twitter_x.png\" alt=\"Twitter\" width=30px></a><a href=\"https://www.facebook.com/sharer/sharer.php?u=https://wimbledonfilmclub.co.uk/chungking-express/\" class=\"fb-xfbml-parse-ignore\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/facebook.png\" alt=\"Facebook\" width=30px></a><a href=\"whatsapp://send?text=https://wimbledonfilmclub.co.uk/chungking-express/\" data-action=\"share/whatsapp/share\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/whatsapp.png\" alt=\"WhatsApp\" width=30px></a><a href=\"https://www.linkedin.com/sharing/share-offsite/?url=https://wimbledonfilmclub.co.uk/chungking-express/\" target=\"_blank\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/linkedin.png\" alt=\"LinkedIn\" width=30px></a><a href=\"mailto:?subject=Chungking Express%20at%20the%20Wimbledon%20Film%20Club&#038;body=%0D%0A%0DTwo melancholic Hong Kong policemen fall in love: one with a mysterious female underworld figure, the other with a beautiful and ethereal waitress at a late-night restaurant he frequents.%0A%0D%0Ahttps://wimbledonfilmclub.co.uk/chungking-express/\"><img decoding=\"async\" src=\"/wp-content/uploads/icons/share/email.png\" alt=\"Email\" width=30px></a></div>\n<div class=\"share-right1\">Click for the WFC poster:</div>\n<div class=\"share-right2\"><a href=\"/wp-content/uploads/poster/wfc_poster.php?film_id=16116\" target=\"_blank\"><img decoding=\"async\" style=\"border-radius:2px;\" src=\"/wp-content/uploads/icons/share/wfc.png\" alt=\"WFC\" width=22px></a></div>\n</div>\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background-background-color has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:320px\"><div class=\"wp-block-template-part\"><figure class=\"wp-block-post-featured-image\"><a href=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec.png\" title=\"Chungking Express\"><img width=\"1118\" height=\"700\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec.png\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec.png 1118w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-300x188.png 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-1024x641.png 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/4-Chungking-Express-landscape-updated-23-Dec-768x481.png 768w\" sizes=\"(max-width: 1118px) 100vw, 1118px\" /></a></figure>\n\n<style type=\"text/css\">\n.box { display:inline; }\ntable { padding-bottom:15px; }\ntr { vertical-align:top; }\n.bbfc { vertical-align:middle; }\n.scoreboard { width:auto; border:1px solid #498a2b; padding:5px; margin:20px 0px; text-align:center; font-weight:bold; }\n.starlabel { font-size:16pt; padding:5px 0; }\n.starline { padding:5px 0 10px; }\nimg.starpic { vertical-align: middle; padding:0; }\n@media only screen and (max-width: 360px) { .starlabel { font-size:13pt; } }\n</style>\n<div class=\"box\">\n<span style=\"font-weight:500; font-size:20pt\">Film Information</span>\n</div>\n<div class=\"box\">\n<table border=0 cellspacing=0 valign=top width=100%>\n<tr>\n<td nowrap>Release year:</td>\n<td>1994</tr>\n<tr>\n<td nowrap>Running time:&nbsp;&nbsp;</td>\n<td>102 mins</tr>\n<tr>\n<td>Directed by:</td>\n<td>Kar-Wai Wong</tr>\n<tr>\n<td>Language:</td>\n<td>Cantonese, Mandarin (English subtitles)</tr>\n<tr>\n<td>Country:</td>\n<td>Hong Kong</tr>\n<tr>\n<td nowrap>Classification:</td>\n<td><img decoding=\"async\" class=\"bbfc\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></tr>\n<tr>\n<td>Genre:</td>\n<td>Comedy, Crime, Romance</tr>\n<tr>\n<td>Starring:</td>\n<td>Brigitte Lin,<br />Takeshi Kaneshiro,<br />Tony Leung Chiu-wai,<br />Faye Wong</tr>\n<tr>\n<td>Awards:</td>\n<td>4 Hong Kong Film Awards:<br />Best Picture,<br />Best Director,<br />Best Actor (Leung),<br />Best Editing</tr>\n<tr>\n<td>More info: </p>\n<td><a href=\"https://www.imdb.com/title/tt0109424/?ref_=fn_t_1\">IMDb</a><br /><a href=\"https://www.rottentomatoes.com/m/chungking_express\">Rotten Tomatoes</a></tr>\n</table>\n</div>\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:400px\"><div class=\"wp-block-template-part\"><div style=\"display:inline;\"><button style=\"background-color:orange; border:none; border-radius: 6px; color:white; padding:15px 22px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:200px\" type=\"button\">Not Yet On Sale</button></p>\n<p style=\"font-size:12pt\">Tickets go on sale to members on February 4, and to non-members on February 7. If you would like to be alerted, sign-up below.</div>\n<hr style=\"border-top:1px solid #498A2B\">\n\n\n<style> p:target {-webkit-animation: target-fade 2s;-moz-animation: target-fade 2s;-o-animation: target-fade 2s;animation: target-fade 2s;}@-webkit-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-moz-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-o-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}</style>\n\n\n<p class=\"has-small-font-size\" id=\"newsletter\">Sign up for the Wimbledon Film Club mailing list to hear about our upcoming screenings.</p>\n\n\n<!-- Begin Mailchimp Signup Form -->\n<style type=\"text/css\">\n\t#mc_embed_signup {background:#fff; clear:left; font:14px Segoe UI, Arial, sans-serif;  width:300px; padding: 10px 0px 10px 0px;}\n\tlabel {line-height:1; margin:12px 0px 5px 5px;}\n\tinput {line-height:1; margin:12px 0px 5px 0px;}\n\t#mc-embedded-subscribe {cursor: pointer; background-color:#498a2b; border:none; border-radius: 6px; color:white; padding:8px 15px 8px 15px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:110px; }\n\tlabel { float:left; }\n\t#mce-EMAIL { width:226px; float:right; margin-right:12px;}\n\t#mce-FNAME { width:81px; }\n\t#mce-LNAME { width:120px; float:right; margin-right:12px;}\n\t@media only screen and (max-width:360px) { #mce-EMAIL { width:187px; } #mce-FNAME { width:65px } #mce-LNAME { width:96px } #mc_embed_signup { width:260px; } }\n</style>\n<div id=\"mc_embed_signup\">\n<form action=\"https://wimbledonfilmclub.us3.list-manage.com/subscribe/post?u=258b97ba9c4142f4b835ae1de&amp;id=141aeb9fdb\" method=\"post\" autocomplete=\"on\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_blank\" novalidate=\"\">\n    <div id=\"mc_embed_signup_scroll