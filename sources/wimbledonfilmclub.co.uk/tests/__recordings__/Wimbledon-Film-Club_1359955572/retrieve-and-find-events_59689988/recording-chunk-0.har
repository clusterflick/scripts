t-weight:normal; font-size:12pt; line-height:1.5;\"><span>September 30</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_15_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/vermiglio/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"169\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/vermiglio-catalogue-picture-01-web-ezgif.com-webp-to-jpg-converter-300x169.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/vermiglio-catalogue-picture-01-web-ezgif.com-webp-to-jpg-converter-300x169.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/vermiglio-catalogue-picture-01-web-ezgif.com-webp-to-jpg-converter-1024x576.jpg 1024w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/vermiglio-catalogue-picture-01-web-ezgif.com-webp-to-jpg-converter-768x432.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/vermiglio-catalogue-picture-01-web-ezgif.com-webp-to-jpg-converter.jpg 1280w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Vermiglio</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>October 14</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_15_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/bright-star/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"169\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/Brightstar1-300x169.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/Brightstar1-300x169.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/Brightstar1-768x432.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/Brightstar1.jpg 970w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Bright Star</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>October 28</span><span style=\"background-color:gold; color:black; font-weight:normal; font-size:10pt; padding: 2px 5px 2px 5px; border-radius:5px; display: inline-block;\">&nbsp;Members&#8217; Choice&nbsp;</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_PG_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/the-marching-band/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"168\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/rsz_the_marching_band-300x168.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/rsz_the_marching_band-300x168.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/rsz_the_marching_band-768x431.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/rsz_the_marching_band.jpg 949w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">The Marching Band</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>November 11</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_15_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/on-becoming-a-guinea-fowl/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"173\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/On-Becoming-A-Guinea-Fowl-image1-e1753369575251-300x173.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/On-Becoming-A-Guinea-Fowl-image1-e1753369575251-300x173.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/On-Becoming-A-Guinea-Fowl-image1-e1753369575251-768x442.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/On-Becoming-A-Guinea-Fowl-image1-e1753369575251.jpg 800w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">On Becoming a Guinea Fowl</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>November 25</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/the-man-without-a-past/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"156\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/manWithoutaPast2-e1753369559268-300x156.jpg\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/manWithoutaPast2-e1753369559268-300x156.jpg 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/manWithoutaPast2-e1753369559268-768x400.jpg 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/07/manWithoutaPast2-e1753369559268.jpg 800w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">The Man Without a Past</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>December 9</span><span style=\"background-color:gold; color:black; font-weight:normal; font-size:10pt; padding: 2px 5px 2px 5px; border-radius:5px; display: inline-block;\">&nbsp;Members&#8217; Choice&nbsp;</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid blue; border-radius: 3px;\"><a class=\"link\" href=\"https://wimbledonfilmclub.co.uk/picnic-at-hanging-rock/\"></p>\n<div class=\"wrapper\">\n<div class=\"filmimg\"><img width=\"300\" height=\"177\" src=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/1-Picture-at-hanging-rock-e1766515282666-300x177.png\" class=\"filmimg\" alt=\"\" decoding=\"async\" loading=\"lazy\" srcset=\"https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/1-Picture-at-hanging-rock-e1766515282666-300x177.png 300w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/1-Picture-at-hanging-rock-e1766515282666-768x453.png 768w, https://wimbledonfilmclub.co.uk/wp-content/uploads/2025/12/1-Picture-at-hanging-rock-e1766515282666.png 797w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></div>\n<div style=\"font-weight:500; font-size:14pt; padding:0; margin:5px 0; line-height:1;\">Picnic at Hanging Rock</div>\n<div style=\"display: flex; justify-content: space-between; align-items: center; font-weight:normal; font-size:12pt; line-height:1.5;\"><span>January 6</span><span><img decoding=\"async\" style=\"vertical-align:middle;\" src=\"/wp-content/uploads/bbfc/BBFC_12A_2019.svg.png\"></span></div>\n</div>\n<p></a></p>\n<hr style=\"border: 3px solid #4d4e53; border-radius: 3px;\">\n</div></div>\n\n\n\n<div class=\"wp-block-column has-background is-layout-flow wp-block-column-is-layout-flow\" style=\"background-color:#f2f2f2;padding-top:18px;padding-right:10px;padding-bottom:10px;padding-left:10px;flex-basis:400px\"><div class=\"wp-block-template-part\"><div style=\"display:inline;\"><button onclick=\"window.location.href='/archive/'\" style=\"cursor: pointer; background-color:blue; border:none; border-radius: 6px; color:white; padding:15px 22px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:200px\" type=\"button\">Search the Archive</button></p>\n<p style=\"font-size:12pt\">View our 387 screenings by season, country, language and other dimensions.</p>\n<style type=\"text/css\">@media only screen and (max-width: 1550px) { span.free1 { display:none; } span.free2 { display:inline-block; } }@media only screen and (min-width: 1550px) { div.bam { display:flex; justify-content: space-between; } span.free1 { display:inline; } span.free2 { display:none; } }</style>\n<hr style=\"border-top:1px solid #4498A2B\">\n<div class=\"bam\" style=\"padding-top:15px; padding-bottom:15px;\"><span><button onclick=\"window.location.href='/become-member/'\" style=\"cursor: pointer; background-color:#498A2B; border:none; border-radius: 6px; color:white; padding:15px 22px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:200px; margin-right:10px;\" type=\"button\">Become a Member</button></span><span class=\"free1\" style=\"font-weight:bold; color:#000000; font-size:11pt; margin-right:15px; text-align:left\">£10 for under-30s &amp; full-time students</span><span class=\"free2\" style=\"font-weight:bold; color:#000000; font-size:11pt; margin-right:15px; text-align:left\"><br />£10 for under-30s &amp; full-time students</span></div>\n</div>\n<hr style=\"border-top:1px solid #498A2B\">\n\n\n<style> p:target {-webkit-animation: target-fade 2s;-moz-animation: target-fade 2s;-o-animation: target-fade 2s;animation: target-fade 2s;}@-webkit-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-moz-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@-o-keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}@keyframes target-fade {from { background-color: red; } /* [1] */to { background-color: transparent; }}</style>\n\n\n<p class=\"has-small-font-size\" id=\"newsletter\">Sign up for the Wimbledon Film Club mailing list to hear about our upcoming screenings.</p>\n\n\n<!-- Begin Mailchimp Signup Form -->\n<style type=\"text/css\">\n\t#mc_embed_signup {background:#fff; clear:left; font:14px Segoe UI, Arial, sans-serif;  width:300px; padding: 10px 0px 10px 0px;}\n\tlabel {line-height:1; margin:12px 0px 5px 5px;}\n\tinput {line-height:1; margin:12px 0px 5px 0px;}\n\t#mc-embedded-subscribe {cursor: pointer; background-color:#498a2b; border:none; border-radius: 6px; color:white; padding:8px 15px 8px 15px; text-align: center; text-decoration: none; display: inline-block; font-size: 18px; width:110px; }\n\tlabel { float:left; }\n\t#mce-EMAIL { width:226px; float:right; margin-right:12px;}\n\t#mce-FNAME { width:81px; }\n\t#mce-LNAME { width:120px; float:right; margin-right:12px;}\n\t@media only screen and (max-width:360px) { #mce-EMAIL { width:187px; } #mce-FNAME { width:65px } #mce-LNAME { width:96px } #mc_embed_signup { width:260px; } }\n</style>\n<div id=\"mc_embed_signup\">\n<form action=\"https://wimbledonfilmclub.us3.list-manage.com/subscribe/post?u=258b97ba9c4142f4b835ae1de&amp;id=141aeb9fdb\" method=\"post\" autocomplete=\"on\" id=\"mc-embedded-subscribe-form\" name=\"mc-embedded-subscribe-form\" class=\"validate\" target=\"_blank\" novalidate=\"\">\n    <div id=\"mc_embed_signup_scroll\">\n<div class=\"mc-field-group\">\n\t<div style=\"display:inline-block; width:100%; vertical-align:text-top;\"><label for=\"mce-EMAIL\">Email:&nbsp;</label>\n\t<input type=\"email\" value=\"\" name=\"EMAIL\" class=\"required email\" id=\"mce-EMAIL\"></div>\n</div>\n<div class=\"mc-field-group\">\n\t<div style=\"display:inline-block; width:100%; vertical-align:text-top;\"><label for=\"mce-FNAME\">Name:&nbsp;</label>\n\t<input type=\"text\" value=\"\" name=\"FNAME\" class=\"\" id=\"mce-FNAME\">\n\t<label for=\"mce-LNAME\"></label>\n\t<input type=\"text\" value=\"\" name=\"LNAME\" class=\"\" id=\"mce-LNAME\"></div>\n</div>\n\t<div id=\"mce-responses\" class=\"clear\">\n\t\t<div class=\"response\" id=\"mce-error-response\" style=\"display:none\"></div>\n\t\t<div class=\"response\" id=\"mce-success-response\" style=\"display:none\"></div>\n\t</div>    <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->\n    <div style=\"position: absolute; left: -5000px;\" aria-hidden=\"true\"><input type=\"text\" name=\"b_258b97ba9c4142f4b835ae1de_141aeb9fdb\" tabindex=\"-1\" value=\"\"></div>\n    <div style=\"width:100%; background-color:#fff; padding-bottom:5px; overflow:hidden;\">\n\t<div style=\"display:inline-block; width:100%;\">\n\t\t<span style=\"margin:20px 0px 0px 5px; float:left; font-size:10pt; font-style:italic;\">All fields are required</span>\n\t\t<span style=\"margin-right:12px; float:right;\"><input type=\"submit\" value=\"Subscribe\" name=\"subscribe\" id=\"mc-embedded-subscribe\"></span>\n\t</div>\n\t</div>\n    </div>\n</form>\n</div>\n\n<!--End mc_embed_signup-->\n\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n\n\n<hr class=\"wp-block-separator has-text-color has-alpha-channel-opacity has-background is-style-wide\" style=\"background-color:#4caf50;color:#4caf50\"/>\n\n\n\