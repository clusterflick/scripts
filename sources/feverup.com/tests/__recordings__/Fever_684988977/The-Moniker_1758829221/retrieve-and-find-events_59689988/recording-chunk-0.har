up.com/social-follow/api\"},\"assets\":{\"url\":\"https://assets-api.feverup.com\"},\"favorites\":{\"url\":\"https://feverup.com/favorites/api\"},\"logging\":{\"url\":\"https://data-logging.apigw.feverup.com\"},\"onSite\":{\"url\":\"https://data-interactive-on-site-api.prod.feverup.com\"}},\"tracking\":{\"mixPanel\":{\"id\":\"011f735c90e1cff24697a19cd38bc535\"},\"facebook\":{\"clientId\":\"212044188860269\"},\"gtm\":{\"id\":\"GTM-T2TC8MV\"}},\"monitoring\":{\"datadog\":{\"appId\":\"b86bb398-9995-4a8a-97a2-19ccd790d284\",\"clientToken\":\"pubb79c9281dffaf968f8fee11a238019ca\",\"site\":\"datadoghq.com\",\"environment\":\"production\",\"enabled\":\"true\",\"useSecureSessionCookie\":\"true\",\"sampleRate\":\"4\",\"sessionReplaySampleRate\":\"0\",\"telemetrySampleRate\":\"0\",\"tracingSampleRate\":\"100\",\"trackResources\":\"true\",\"trackLongTasks\":\"true\",\"trackInteractions\":\"true\"}},\"experimentation\":{\"optimizely\":{\"key\":\"DqiQArRZFijaai4G8NfQ1K\"}},\"google\":{\"storeUrl\":\"https://play.google.com/store/apps/details?id=com.feverup.fever\",\"place\":{\"key\":\"AIzaSyAzz5QA02Lmzl-3YQvjiSvOQmsUKLvuSw4\"},\"maps\":{\"key\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Blockbuster Film Tours at the Old Royal Naval College\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"\\\\u003Cstrong\\\\u003E📱 Smartphone tickets\\\\u003Cbr\\\\u003E\\n⚡ Instant access to your tickets\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\n\\\\u003Cbr\\\\u003E\\n\\n\\n    ⏳ Duration: 1h 30m\\\\u003Cbr\\\\u003E\\n\\n\\n    👉 Experience available in English\\\\u003Cbr\\\\u003E\\n\\n\\n    \\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\n\\n\\n\\n    \\\\u003Cem\\\\u003EDive into the cinematic universe at the Old Royal Naval College and discover why it\\\\u0027s a favorite backdrop for blockbuster hits! From the breathtaking Painted Hall to the enchanting Chapel, see where iconic scenes from The Crown, Les Misérables, Thor, and more were brought to life. Uncover secrets of the trade on a tour that\\\\u0027s as informative as it is magical, making your way through nearly a century of film history. Tours are available on weekends, perfect for a unique outing. Get your tickets for Blockbuster Film Tours at the Old Royal Naval College!\\\\u003C/em\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    🎬 Dive into the heart of iconic film scenes at the Painted Hall \\\\u0026 Chapel.\\\\u003Cbr\\\\u003E🌟 Explore the favorite backdrop of blockbusters like The Crown \\\\u0026 Bridgerton.\\\\u003Cbr\\\\u003E📽️ Get exclusive insights with behind-the-scenes tours every weekend.\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EWhat\\\\u0027s included?\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ✔️ Join our standard site tours departing hourly from the visitor centre (11am-3pm).  \\\\u003Cbr\\\\u003E✔️ Entry to the Visitor Centre of artefacts is included.  \\\\u003Cbr\\\\u003E✔️ The tour takes you into the Chapel of St Peter and St Paul.  \\\\u003Cbr\\\\u003E✔️ Entry to the Painted Hall and the Nelson Room.  \\\\u003Cbr\\\\u003E✔️ Entry to Victorian Skittle Alley (subject to opening, please check on arrival).  \\\\u003Cbr\\\\u003E✔️ Guided Blockbuster Film \\\\u0026 TV Tour, lasting 60 minutes.\\\\u003Cbr\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n    \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EItinerary\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    \\\\u003Cul\\\\u003E\\\\u003Cli\\\\u003EOld Royal Naval College  - \\\\u003Cem\\\\u003EAdmission included\\\\u003C/em\\\\u003E\\\\u003C/li\\\\u003E\\n\\\\u003Cli\\\\u003EThe Painted Hall  - \\\\u003Cem\\\\u003EAdmission included\\\\u003C/em\\\\u003E\\\\u003C/li\\\\u003E\\\\u003C/ul\\\\u003E\\\\u003Cbr\\\\u003E\\n    \\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EAdditional Information\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ♿ Wheelchair accessible and transportation options include accessible facilities.  \\\\u003Cbr\\\\u003E👶 Infants and small children are welcome in a pram or stroller.  \\\\u003Cbr\\\\u003E🐕 Service animals are permitted on this experience.  \\\\u003Cbr\\\\u003E🚆 Public transportation options are conveniently located nearby.  \\\\u003Cbr\\\\u003E🏋️‍♂️ This experience is suitable for all physical fitness levels.  \\\\u003Cbr\\\\u003E🔊 An Audio Guide featuring British Sign Language is available.\\\\u003Cbr\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EWhy choose Fever?\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ✔️ Millions of users book every month.\\\\u003Cbr\\\\u003E\\n                ✔️ The best prices and availability at all times.\\\\u003Cbr\\\\u003E\\n                ✔️ Thousands of unique experiences.\\\\u003Cbr\\\\u003E\\n                ✔️ Verified user reviews.\\\\u003Cbr\\\\u003E\\n                ✔️ 24/7 customer service.\\\\u003Cbr\\\\u003E\\n                \\n\\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\\\u003Chr\\\\u003E\\n\\\\u003Cem\\\\u003EExperience supplied by Old Royal Naval College\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\n\\\\u003Cem\\\\u003EAll ticket sales are final and cannot be refunded, exchanged, or otherwise modified. Click here to check out\\\\u0026nbsp;\\\\u003Ca href=\\\\u0022https://docs.google.com/document/d/e/2PACX-1vSVRJ1Z5-8gFm17oKLfc1rcA_HQk0tfJdZ8J4EOwBjPOBrfX-AvXaaGoq7vPNos-r2V4U4PxCfXUyar/pub\\\\u0022 rel=\\\\u0022noopener\\\\u0022 target=\\\\u0022_blank\\\\u0022\\\\u003Ethe T\\\\u0026amp;Cs\\\\u003C/a\\\\u003E.\\\\u003C/em\\\\u003E\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/90d5c18a-f8f5-11ee-82f5-bed011be9325\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-config\":{\"name\":\"plan\",\"planDetail\":{\"aBTesting\":null,\"accessRules\":[],\"allowMultiSessionPurchase\":true,\"baseLocale\":\"en-GB\",\"category\":\"mix\",\"cityAvailableLocales\":[\"en-GB\",\"es-ES\"],\"cityCountryIsoCode\":\"UK\",\"citySlug\":\"london\",\"citySlugLanguage\":\"en\",\"cityStandardId\":1006886,\"coverImage\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/90d5c18a-f8f5-11ee-82f5-bed011be9325\",\"customLabel\":null,\"defaultLevelDisplay\":\"disabled\",\"defaultPlace\":{\"address\":\"43 King William Walk, London, SE10 9HU\",\"hasPlacePage\":false,\"hidden\":false,\"id\":43633,\"latitude\":51.482429,\"locale\":\"en\",\"longitude\":-0.0092578,\"metroStations\":[],\"name\":\"43 King William Walk\",\"signedMapUrl\":\"https://applications-media.feverup.com/image/upload/f_auto/fever2/place/maps/43633__51.482429_-0.0092578.png\",\"slug\":null},\"defaultSession\":{\"attendText\":\"Join in!\",\"availableTickets\":14,\"currency\":\"GBP\",\"endsAtIso\":\"2026-04-02T14:30:00+01:00\",\"expirationIso\":\"2026-03-31T12:30:00+01:00\",\"hasAvailableTickets\":true,\"id\":367808204,\"label\":\"Blockbuster Film Tours - Old Royal Naval College, Greenwich | Adult (17 - 100) - £16.50\",\"maxNumTickets\":14,\"minNumTickets\":1,\"placeId\":43633,\"price\":16.5,\"startsAtIso\":\"2026-04-02T12:30:00+01:00\",\"surchargePerTicket\":0},\"description\":\"\\\\u003Cstrong\\\\u003E📱 Smartphone tickets\\\\u003Cbr\\\\u003E\\n⚡ Instant access to your tickets\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\n\\\\u003Cbr\\\\u003E\\n\\n\\n    ⏳ Duration: 1h 30m\\\\u003Cbr\\\\u003E\\n\\n\\n    👉 Experience available in English\\\\u003Cbr\\\\u003E\\n\\n\\n    \\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\n\\n\\n\\n    \\\\u003Cem\\\\u003EDive into the cinematic universe at the Old Royal Naval College and discover why it\\\\u0027s a favorite backdrop for blockbuster hits! From the breathtaking Painted Hall to the enchanting Chapel, see where iconic scenes from The Crown, Les Misérables, Thor, and more were brought to life. Uncover secrets of the trade on a tour that\\\\u0027s as informative as it is magical, making your way through nearly a century of film history. Tours are available on weekends, perfect for a unique outing. Get your tickets for Blockbuster Film Tours at the Old Royal Naval College!\\\\u003C/em\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    🎬 Dive into the heart of iconic film scenes at the Painted Hall \\\\u0026 Chapel.\\\\u003Cbr\\\\u003E🌟 Explore the favorite backdrop of blockbusters like The Crown \\\\u0026 Bridgerton.\\\\u003Cbr\\\\u003E📽️ Get exclusive insights with behind-the-scenes tours every weekend.\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EWhat\\\\u0027s included?\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ✔️ Join our standard site tours departing hourly from the visitor centre (11am-3pm).  \\\\u003Cbr\\\\u003E✔️ Entry to the Visitor Centre of artefacts is included.  \\\\u003Cbr\\\\u003E✔️ The tour takes you into the Chapel of St Peter and St Paul.  \\\\u003Cbr\\\\u003E✔️ Entry to the Painted Hall and the Nelson Room.  \\\\u003Cbr\\\\u003E✔️ Entry to Victorian Skittle Alley (subject to opening, please check on arrival).  \\\\u003Cbr\\\\u003E✔️ Guided Blockbuster Film \\\\u0026 TV Tour, lasting 60 minutes.\\\\u003Cbr\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\n    \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EItinerary\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    \\\\u003Cul\\\\u003E\\\\u003Cli\\\\u003EOld Royal Naval College  - \\\\u003Cem\\\\u003EAdmission included\\\\u003C/em\\\\u003E\\\\u003C/li\\\\u003E\\n\\\\u003Cli\\\\u003EThe Painted Hall  - \\\\u003Cem\\\\u003EAdmission included\\\\u003C/em\\\\u003E\\\\u003C/li\\\\u003E\\\\u003C/ul\\\\u003E\\\\u003Cbr\\\\u003E\\n    \\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\n\\n\\n\\n  \\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EAdditional Information\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ♿ Wheelchair accessible and transportation options include accessible facilities.  \\\\u003Cbr\\\\u003E👶 Infants and small children are welcome in a pram or stroller.  \\\\u003Cbr\\\\u003E🐕 Service animals are permitted on this experience.  \\\\u003Cbr\\\\u003E🚆 Public transportation options are conveniently located nearby.  \\\\u003Cbr\\\\u003E🏋️‍♂️ This experience is suitable for all physical fitness levels.  \\\\u003Cbr\\\\u003E🔊 An Audio Guide featuring British Sign Language is available.\\\\u003Cbr\\\\u003E\\n    \\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\n\\\\u003Chr\\\\u003E\\\\u003Cspan style=\\\\u0022font-size: 22px;\\\\u0022\\\\u003E\\\\u003Cstrong\\\\u003EWhy choose Fever?\\\\u003C/strong\\\\u003E\\\\u003C/span\\\\u003E\\\\u003Cbr\\\\u003E\\n    ✔️ Millions of users book every month.\\\\u003Cbr\\\\u003E\\n                ✔️ The best prices and availability at all times.\\\\u003Cbr\\\\u003E\\n                ✔️ Thousands of unique experiences.\\\\u003Cbr\\\\u003E\\n                ✔️ Verified user reviews.\\\\u003Cbr\\\\u003E\\n                ✔️ 24/7 customer service.\\\\u003Cbr\\\\u003E\\n                \\n\\\\u003Cbr\\\\u003E\\\\u0026nbsp;\\n\\n\\\\u003Chr\\\\u003E\\n\\\\u003Cem\\\\u003EExperience supplied by Old Royal Naval College\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\n\\\\u003Cem\\\\u003EAll ticket sales are final and cannot be refunded, exchanged, or otherwise modified. Click here to check out\\\\u0026nbsp;\\\\u003Ca href=\\\\u0022https://docs.google.com/document/d/e/2PACX-1vSVRJ1Z5-8gFm17oKLfc1rcA_HQk0tfJdZ8J4EOwBjPOBrfX-AvXaaGoq7vPNos-r2V4U4PxCfXUyar/pub\\\\u0022 rel=\\\\u0022noopener\\\\u0022 target=\\\\u0022_blank\\\\u0022\\\\u003Ethe T\\\\u0026amp;Cs\\\\u003C/a\\\\u003E.\\\\u003C/em\\\\u003E\",\"enableImageTestExperiment\":false,\"faqId\":null,\"firstActiveSessionDate\":\"2026-04-02T12:30:00+01:00\",\"firstSessionDate\":\"2026-04-02T12:30:00+01:00\",\"gallery\":[\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/90d5c18a-f8f5-11ee-82f5-bed011be9325\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/9622ad42-f8f5-11ee-82f5-bed011be9325\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/9c1be52e-f8f5-11ee-82f5-bed011be9325\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/a7f9b68c-f8f5-11ee-82f5-bed011be9325\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/acf2f05e