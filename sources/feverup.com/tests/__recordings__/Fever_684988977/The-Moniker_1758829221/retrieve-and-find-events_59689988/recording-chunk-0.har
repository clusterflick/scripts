!--]--><!--astro:end--></astro-island> </div> </div> <hr class=\"astro-eulym4nl\"> </div> <script type=\"module\" src=\"/_astro/PlanHeroInfo.astro_astro_type_script_index_0_lang.CF3KGTfm.js\"></script>  </div>  <div id=\"plan-description\" class=\"plan-description astro-4r2zdndd\" data-testid=\"plan-content-description\">⭐ <em>Taste Film believes films should be more than just watched - they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.</em><br />\r\n<br />\r\n<strong>Highlights</strong><br />\r\n🎥 Don’t just watch the film… savour it!<br />\r\n🏴‍☠️ Enjoy a multi-course menu inspired by the film The Goonies (1985)<br />\r\n🍴 Dine in sync with iconic on-screen moments<br />\r\n<br />\r\n<strong>General Info</strong><br />\r\n📅 Date: April and May 2026<br />\r\n🕐 Time: Please check your booking for specific event times.<br />\r\n📍 Location: Parlour, NW10 5LG<br />\r\n👤 Age rating: this film is rated <a href=\"https://www.bbfc.co.uk/release/the-goonies-q29sbgvjdglvbjpwwc0zmza4mzc\">12</a> (minimum age 5)<br />\r\n♿ Accessibility: This venue is not wheelchair accessible<br />\r\n🍽️ The menu: to view the menu, please click <a href=\"https://drive.google.com/file/d/1Bg62s9KnUy2t2D0MwTmuDhfy5fIUvTZ_/view?usp=drive_link\">here</a><br />\r\n❓ Please consult the FAQs of this experience <a href=\"https://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\">here</a><br />\r\n<br />\r\n<strong>Description</strong><br />\r\nHey Guys! Join Taste Film for a nostalgic, treasure-hunting cinematic dining adventure, inspired by The Goonies.<br />\r\n<br />\r\nThis cult 80s classic comes to life through a seven-course menu packed with easter eggs, interactive moments, and unforgettable Italian-American flavours. It’s the PERFECT night out. Perfect for film lovers, foodies, nostalgia seekers, and anyone ready to become a Goonie (or rather… a Foodie).</div> <astro-island uid=\"ZLnMCT\" component-url=\"/_astro/HTMLPlanDescriptionExperimentHandler.idEgzVjh.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;planID&quot;:[0,562315],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionExperimentHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"mcIqm\" component-url=\"/_astro/HTMLPlanDescriptionTabsHandler.mFbmXKWW.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionTabsHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"ZlSSDA\" component-url=\"/_astro/HTMLPlanDescriptionLinkTracking.WlW-Qa2O.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;trackableURLs&quot;:[1,[[0,&quot;https://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub&quot;]]],&quot;planID&quot;:[0,562315],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionLinkTracking&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island>      <script>(()=>{var a=(s,i,o)=>{let r=async()=>{await(await s())()},t=typeof i.value==\"object\"?i.value:void 0,c={rootMargin:t==null?void 0:t.rootMargin},n=new IntersectionObserver(e=>{for(let l of e)if(l.isIntersecting){n.disconnect(),r();break}},c);for(let e of o.children)n.observe(e)};(self.Astro||(self.Astro={})).visible=a;window.dispatchEvent(new Event(\"astro:visible\"));})();</script><!--[--><section class=\"plan-content__block svelte-vu3cyy\" data-testid=\"plan-content-help\"><!----> <!--[--><h2 class=\"plan-conten