00/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-arrow-right-from-bracket fv-reviews-share-button__icon svelte-1ipid5s\" viewBox=\"0 0 512 512\"><path fill=\"currentColor\" d=\"M507.3 267.3c6.2-6.2 6.2-16.4 0-22.6l-128-128c-6.2-6.2-16.4-6.2-22.6 0s-6.2 16.4 0 22.6L457.4 240 176 240c-8.8 0-16 7.2-16 16s7.2 16 16 16l281.4 0L356.7 372.7c-6.2 6.2-6.2 16.4 0 22.6s16.4 6.2 22.6 0l128-128zM176 64c8.8 0 16-7.2 16-16s-7.2-16-16-16L80 32C35.8 32 0 67.8 0 112L0 400c0 44.2 35.8 80 80 80l96 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-96 0c-26.5 0-48-21.5-48-48l0-288c0-26.5 21.5-48 48-48l96 0z\" class=\"svelte-1ipid5s\"></path></svg><!--]--></button><!--]--><!--]--><!--astro:end--></astro-island> <div class=\"plan-hero__actions-favorite astro-eulym4nl\"> <astro-island uid=\"1biCr5\" component-url=\"/_astro/PlanFavoriteButton.CM9oEmpA.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;planId&quot;:[0,562253],&quot;locale&quot;:[0,&quot;en-GB&quot;],&quot;image&quot;:[0,&quot;https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/4cce61b8-fac9-11f0-8364-c6b2232abd39.jpg&quot;],&quot;variant&quot;:[0,&quot;floatingExperiment&quot;],&quot;class&quot;:[0,&quot;astro-eulym4nl&quot;]}\" ssr client=\"idle\" opts=\"{&quot;name&quot;:&quot;PlanFavoriteButton&quot;,&quot;value&quot;:true}\" await-children><!--[--><button class=\"fv-plan-favorites-button svelte-y07y4h fv-plan-favorites-button__floating-experiment\" aria-label=\"Save events you love in one place.\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-heart fa-fw svelte-1ipid5s\" viewBox=\"0 0 512 512\"><path fill=\"currentColor\" d=\"M244 130.6l-12-13.5-4.2-4.7c-26-29.2-65.3-42.8-103.8-35.8c-53.3 9.7-92 56.1-92 110.3v3.5c0 32.3 13.4 63.1 37.1 85.1L253 446.8c.8 .7 1.9 1.2 3 1.2s2.2-.4 3-1.2L443 275.5c23.6-22 37-52.8 37-85.1v-3.5c0-54.2-38.7-100.6-92-110.3c-38.5-7-77.8 6.6-103.8 35.8l-4.2 4.7-12 13.5c-3 3.4-7.4 5.4-12 5.4s-8.9-2-12-5.4zm34.9-57.1C311 48.4 352.7 37.7 393.7 45.1C462.2 57.6 512 117.3 512 186.9v3.5c0 36-13.1 70.6-36.6 97.5c-3.4 3.8-6.9 7.5-10.7 11l-184 171.3c-.8 .8-1.7 1.5-2.6 2.2c-6.3 4.9-14.1 7.5-22.1 7.5c-9.2 0-18-3.5-24.8-9.7L47.2 299c-3.8-3.5-7.3-7.2-10.7-11C13.1 261 0 226.4 0 190.4v-3.5C0 117.3 49.8 57.6 118.3 45.1c40.9-7.4 82.6 3.2 114.7 28.4c6.7 5.3 13 11.1 18.7 17.6l4.2 4.7 4.2-4.7c4.2-4.7 8.6-9.1 13.3-13.1c1.8-1.5 3.6-3 5.4-4.5z\" class=\"svelte-1ipid5s\"></path></svg><!----></button><!--]--><!--astro:end--></astro-island> </div> </div> <hr class=\"astro-eulym4nl\"> </div> <script type=\"module\" src=\"/_astro/PlanHeroInfo.astro_astro_type_script_index_0_lang.CF3KGTfm.js\"></script>  </div>  <div id=\"plan-description\" class=\"plan-description astro-4r2zdndd\" data-testid=\"plan-content-description\">⭐<strong> <em>Taste Film</em></strong><em> believes films should be more than just watched—they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.</em><br />\r\n<br />\r\n<strong>Highlights</strong><br />\r\n🎥 Don’t just watch the film… savour it!<br />\r\n🚨 Enjoy a multi-course menu inspired by the film <em>White Chicks</em> (2004)<br />\r\n🍴 Dine in sync with iconic on-screen moments<br />\r\n<br />\r\n<strong>General Info</strong><br />\r\n📅 Date: April and May, 2026<br />\r\n🕒 Time: select your time directly in the ticket selector <br />\r\n📍 Location: The Moniker <br />\r\n👤 Age rating: this film is rated 15 (min. age 15)<br />\r\n♿ Accessibility: the venue is wheelchair accessible<br />\r\n🍽️ The menu: to view the menu, please click <a href=\"https://drive.google.com/file/d/1eiG_07h6ieqepyskuxnNNyg7_40iVS4Q/view?usp=drive_link\">here</a><br />\r\n❓ Please consult the FAQs of this experience <a href=\"http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\">here</a><br />\r\n<br />\r\n<strong>Description</strong><br />\r\nWe’re going (skin)-deep undercover for our next screening… White Chicks is BACK. Naughty and noughties? Say less. We’re bringing back a fan-favourite experience, bigger, bolder, and more elevated than ever. Bring your friends, bring a date, this is not your average movie night. <br />\r\n<br />\r\nExpecting a salad? Perhaps not. As the film plays, you’ll be served a DIY Neapolitan shot, iconic cheese hors d’oeuvres (IYKYK), a steak date you won’t forget, and plenty more surprises along the way.<br />\r\n<br />\r\nThis one’s outrageous, indulgent, and very 2004. Nostalgia overload.<br />\r\n<br />\r\nWe can’t FRICKIN’ WAIT.</div> <astro-island uid=\"Z2tK4JS\" component-url=\"/_astro/HTMLPlanDescriptionExperimentHandler.idEgzVjh.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;planID&quot;:[0,562253],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionExperimentHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"mcIqm\" component-url=\"/_astro/HTMLPlanDescriptionTabsHandler.mFbmXKWW.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionTabsHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"2pPRY3\" component-url=\"/_astro/HTMLPlanDescriptionLinkTracking.WlW-Qa2O.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;trackableURLs&quot;:[1,[[0,&quot;http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub&quot;]]],&quot;planID&quot;:[0,562253],&quot;class&quot;:[0,&q