anslationKey\":\"footer.links.liveYourCity\",\"href\":\"https://liveyourcity.com/\"},\"abuDhabiLink\":{\"translationKey\":\"footer.links.abuDhabi\",\"href\":\"https://feverup.com/en/abu-dhabi\"},\"appId\":\"5298284f-8a33-4269-99a6-bff6979dd27e\",\"appVersion\":\"4e929b3\",\"api\":{\"search\":{\"url\":\"https://data-search.apigw.feverup.com\"},\"services\":{\"url\":\"https://feverup.com\"},\"recommender\":{\"url\":\"https://feverup.com/recommender-api\"},\"socialFollow\":{\"url\":\"https://feverup.com/social-follow/api\"},\"assets\":{\"url\":\"https://assets-api.feverup.com\"},\"favorites\":{\"url\":\"https://feverup.com/favorites/api\"},\"logging\":{\"url\":\"https://data-logging.apigw.feverup.com\"},\"onSite\":{\"url\":\"https://data-interactive-on-site-api.prod.feverup.com\"}},\"tracking\":{\"mixPanel\":{\"id\":\"011f735c90e1cff24697a19cd38bc535\"},\"facebook\":{\"clientId\":\"212044188860269\"},\"gtm\":{\"id\":\"GTM-T2TC8MV\"}},\"monitoring\":{\"datadog\":{\"appId\":\"b86bb398-9995-4a8a-97a2-19ccd790d284\",\"clientToken\":\"pubb79c9281dffaf968f8fee11a238019ca\",\"site\":\"datadoghq.com\",\"environment\":\"production\",\"enabled\":\"true\",\"useSecureSessionCookie\":\"true\",\"sampleRate\":\"4\",\"sessionReplaySampleRate\":\"0\",\"telemetrySampleRate\":\"0\",\"tracingSampleRate\":\"100\",\"trackResources\":\"true\",\"trackLongTasks\":\"true\",\"trackInteractions\":\"true\"}},\"experimentation\":{\"optimizely\":{\"key\":\"DqiQArRZFijaai4G8NfQ1K\"}},\"google\":{\"storeUrl\":\"https://play.google.com/store/apps/details?id=com.feverup.fever\",\"place\":{\"key\":\"AIzaSyAzz5QA02Lmzl-3YQvjiSvOQmsUKLvuSw4\"},\"maps\":{\"key\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Epic Film \\\\u0026 TV Soundtracks - A Candlelit Experience\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"🎵 \\\\u003Cem\\\\u003EThis experience is brought to you by \\\\u003C/em\\\\u003E\\\\u003Cstrong\\\\u003E\\\\u003Cem\\\\u003ECineDuo London\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E. This concert is not affiliated with the Fever Original Candlelight series.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGeneral Info:\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📅 Date: \\\\u003C/strong\\\\u003E14th March\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E⏰ Time: \\\\u003C/strong\\\\u003E7:30 PM – 8:30 PM (doors open at 7 PM)\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📍 Location: \\\\u003C/strong\\\\u003ESt Saviour\\\\u0027s Pimlico, St. Georges Square, London, SW1V 3QW\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E👤 Age requirement: \\\\u003C/strong\\\\u003Echildren under 14 must be accompanied by an adult and sit within the same band\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E🪑 Seating: \\\\u003C/strong\\\\u003Eunallocated seating within seating bands (first come, first served)\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThis is NOT your usual candle concert...\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EOne duo. One experience.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EYoon and Nurry are your international concert soloists for the evening. They\\\\u0026nbsp;\\\\u003Cem\\\\u003Eare\\\\u003C/em\\\\u003E\\\\u0026nbsp;CineDuo – nobody else.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EShow-Stopping Arrangements.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery arrangement is written exclusively for CineDuo by award-winning arranger Stuart Bramwell\\\\u0026nbsp;– and performed by CineDuo alone.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003ESerious\\\\u0026nbsp;Virtuosity.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EWhat Yoon and Nurry do best. Stuart\\\\u0027s arrangements are\\\\u0026nbsp;\\\\u003Cstrong\\\\u003EREALLY\\\\u0026nbsp;challenging \\\\u003C/strong\\\\u003E– but with\\\\u0026nbsp;big risks\\\\u0026nbsp;come\\\\u0026nbsp;\\\\u003Cstrong\\\\u003EEPIC\\\\u0026nbsp;\\\\u003C/strong\\\\u003Erewards.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EQuality, not Quantity.﻿\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery month, between rehearsals and arranging, the group spend hundreds of hours preparing just a handful of bespoke concerts per year.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EProgramme\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E:\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EMovie Studio Intro Medley (3’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EPirates of the Caribbean Medley (9’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EJack Sparrow, Davy Jones, The Medallion Calls, He’s a Pirate\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThemes from The Lord of the Rings (12’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Bill Galiiford\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EAvatar Medley (6’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EBecoming one of “The People”, The bioluminescence of the night,\\\\u003Cbr\\\\u003EClimbing up “Iknimaya – The Path to Heaven”, The destruction of Hometree\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EHow to Train Your Dragon Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThis Is Berk, Romantic Flight, Forbidden Friendship,\\\\u003Cbr\\\\u003ESee You Tomorrow, Test Drive\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGame of Thrones Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThe Rains of Castamere, The Winds of Winter,\\\\u003Cbr\\\\u003ELight of the Seven, Opening Credits\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cimg src=\\\\u0022https://images.feverup.com/plan/photo/06c4af00-02b3-11f1-ae5b-4657e336d5f3.jpeg\\\\u0022\\\\u003E\\\\u003Cbr\\\\u003E\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8403930c-012b-11f1-ada3-e2293b0dfa43.jpeg\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-config\":{\"name\":\"plan\",\"planDetail\":{\"aBTesting\":null,\"accessRules\":[],\"allowMultiSessionPurchase\":false,\"baseLocale\":\"en-GB\",\"category\":\"concert\",\"cityAvailableLocales\":[\"en-GB\",\"es-ES\"],\"cityCountryIsoCode\":\"UK\",\"citySlug\":\"london\",\"citySlugLanguage\":\"en\",\"cityStandardId\":1006886,\"coverImage\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8403930c-012b-11f1-ada3-e2293b0dfa43.jpeg\",\"customLabel\":null,\"defaultLevelDisplay\":\"disabled\",\"defaultPlace\":{\"address\":\"St.George\\\\u0027s Square, London, SW1V 3QW\",\"hasPlacePage\":false,\"hidden\":false,\"id\":104195,\"latitude\":51.48848779999999,\"locale\":\"en\",\"longitude\":-0.135236,\"metroStations\":[],\"name\":\"St Saviour\\\\u0027s Pimlico Church\",\"signedMapUrl\":\"https://applications-media.feverup.com/image/upload/f_auto/fever2/place/maps/104195__51.48848779999999_-0.135236.png\",\"slug\":null},\"defaultSession\":{\"attendText\":\"Join in!\",\"availableTickets\":14,\"currency\":\"GBP\",\"endsAtIso\":\"2026-03-14T20:30:00+00:00\",\"expirationIso\":\"2026-03-14T19:00:00+00:00\",\"hasAvailableTickets\":true,\"id\":384278886,\"label\":\"7:30 pm Child under 14 £14.00\",\"maxNumTickets\":14,\"minNumTickets\":1,\"placeId\":104195,\"price\":14,\"startsAtIso\":\"2026-03-14T19:30:00+00:00\",\"surchargePerTicket\":0},\"description\":\"🎵 \\\\u003Cem\\\\u003EThis experience is brought to you by \\\\u003C/em\\\\u003E\\\\u003Cstrong\\\\u003E\\\\u003Cem\\\\u003ECineDuo London\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E. This concert is not affiliated with the Fever Original Candlelight series.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGeneral Info:\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📅 Date: \\\\u003C/strong\\\\u003E14th March\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E⏰ Time: \\\\u003C/strong\\\\u003E7:30 PM – 8:30 PM (doors open at 7 PM)\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📍 Location: \\\\u003C/strong\\\\u003ESt Saviour\\\\u0027s Pimlico, St. Georges Square, London, SW1V 3QW\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E👤 Age requirement: \\\\u003C/strong\\\\u003Echildren under 14 must be accompanied by an adult and sit within the same band\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E🪑 Seating: \\\\u003C/strong\\\\u003Eunallocated seating within seating bands (first come, first served)\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThis is NOT your usual candle concert...\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EOne duo. One experience.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EYoon and Nurry are your international concert soloists for the evening. They\\\\u0026nbsp;\\\\u003Cem\\\\u003Eare\\\\u003C/em\\\\u003E\\\\u0026nbsp;CineDuo – nobody else.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EShow-Stopping Arrangements.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery arrangement is written exclusively for CineDuo by award-winning arranger Stuart Bramwell\\\\u0026nbsp;– and performed by CineDuo alone.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003ESerious\\\\u0026nbsp;Virtuosity.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EWhat Yoon and Nurry do best. Stuart\\\\u0027s arrangements are\\\\u0026nbsp;\\\\u003Cstrong\\\\u003EREALLY\\\\u0026nbsp;challenging \\\\u003C/strong\\\\u003E– but with\\\\u0026nbsp;big risks\\\\u0026nbsp;come\\\\u0026nbsp;\\\\u003Cstrong\\\\u003EEPIC\\\\u0026nbsp;\\\\u003C/strong\\\\u003Erewards.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EQuality, not Quantity.﻿\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery month, between rehearsals and arranging, the group spend hundreds of hours preparing just a handful of bespoke concerts per year.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EProgramme\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E:\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EMovie Studio Intro Medley (3’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EPirates of the Caribbean Medley (9’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EJack Sparrow, Davy Jones, The Medallion Calls, He’s a Pirate\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThemes from The Lord of the Rings (12’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Bill Galiiford\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EAvatar Medley (6’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EBecoming one of “The People”, The bioluminescence of the night,\\\\u003Cbr\\\\u003EClimbing up “Iknimaya – The Path to Heaven”, The destruction of Hometree\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EHow to Train Your Dragon Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThis Is Berk, Romantic Flight, Forbidden Friendship,\\\\u003Cbr\\\\u003ESee You Tomorrow, Test Drive\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGame of Thrones Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThe Rains of Castamere, The Winds of Winter,\\\\u003Cbr\\\\u003ELight of the Seven, Opening Credits\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cimg src=\\\\u0022https://images.feverup.com/plan/photo/06c4af00-02b3-11f1-ae5b-4657e336d5f3.jpeg\\\\u0022\\\\u003E\\\\u003Cbr\\\\u003E\",\"enableImageTestExperiment\":false,\"faqId\":null,\"firstActiveSessionDate\":\"2026-03-14T19:30:00+00:00\",\"firstSessionDate\":\"2026-03-14T19:30:00+00:00\",\"gallery\":[\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8403930c-012b-11f1-ada3-e2293b0dfa43.jpeg\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/848310b4-012b-11f1-ada3-e2293b0dfa43.jpeg\",\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8498bfe0-012b-11f1-ada3-e2293b0dfa43.jpeg\"],\"hasAddOns\":false,\"hasSeasons\":false,\"hasShopProducts\":false,\"id\":569419,\"is3dRequired\":false,\"isCalendarSelector\":false,\"isGiveaway\":false,\"isTimeless\":false,\"isUrgent\":false,\"lastActiveSessionDate\":\"2026-03-14T19:30:00+00:00\",\"lastSessionDate\":\"2026-03-14T19:30:00+00:00\",\"linkOutInfo\":null,\"logoUrl\":null,\"mediaGallery\":[{\"category\":{\"role\":\"default\"},\"gAutoEnabled\":true,\"type\":\"image\",\"url\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8403930c-012b-11f1-ada3-e2293b0dfa43.jpeg\"},{\"category\":{\"role\":\"default\"},\"gAutoEnabled\":true,\"type\":\"image\",\"url\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/848310b4-012b-11f1-ada3-e2293b0dfa43.jpeg\"},{\"category\":{\"role\":\"default\"},\"gAutoEnabled\":true,\"type\":\"image\",\"url\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/8498bfe0-012b-11f1-ada3-e2293b0dfa43.jpeg\"}],\"meta\":{\"description\":\"Epic film \\\\u0026 TV soundtracks performed live in an intimate candlelit setting. Get your tickets now!\",\"disallowIndexing\":false,\"jsonIdOverrides\":[{\"type\":\"Product\"}