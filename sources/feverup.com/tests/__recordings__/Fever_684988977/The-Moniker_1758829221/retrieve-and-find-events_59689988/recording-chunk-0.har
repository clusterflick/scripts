oogle.com/store/apps/details?id=com.feverup.fever\\\\u0026hl=en_US\",\"https://apps.apple.com/us/app/fever-local-events-tickets/id497702817\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://support.feverup.com/hc/es/requests/new?showContactLink=true\\\\u0026ticket_form_id=360001032452\",\"contactType\":\"Customer Service\"}],\"founders\":[{\"@type\":\"Person\",\"name\":\"Ignacio Bachiller\",\"sameAs\":[\"https://www.linkedin.com/in/ignacio-bachiller-str%C3%B6hlein-b1024148\",\"https://www.crunchbase.com/person/ignacio-bachiller\"]},{\"@type\":\"Person\",\"name\":\"Francisco Hein\",\"sameAs\":[\"https://www.linkedin.com/in/franhein\",\"https://www.crunchbase.com/person/francisco-hein\"]},{\"@type\":\"Person\",\"name\":\"Alexandre Perez Casares\",\"sameAs\":[\"https://www.linkedin.com/in/alexandre-perez-casares\",\"https://www.crunchbase.com/person/alex-perez\"]}]},\"suffix\":\" | Fever\",\"hideTwitterSite\":false},\"countryCodeForCitySelectorFilter\":null,\"logo\":{\"imageSrc\":\"/logo/fever-logo-white.svg\",\"altTitle\":\"Fever logo\",\"styleName\":\"--fever\",\"imageSrcDark\":\"/logo/fever-logo-black.svg\"},\"hideLoyalty\":false,\"hideWorkWithUs\":false,\"notSupportedMobileApp\":false,\"liveYourCityLink\":{\"translationKey\":\"footer.links.liveYourCity\",\"href\":\"https://liveyourcity.com/\"},\"abuDhabiLink\":{\"translationKey\":\"footer.links.abuDhabi\",\"href\":\"https://feverup.com/en/abu-dhabi\"},\"appId\":\"5298284f-8a33-4269-99a6-bff6979dd27e\",\"appVersion\":\"4e929b3\",\"api\":{\"search\":{\"url\":\"https://data-search.apigw.feverup.com\"},\"services\":{\"url\":\"https://feverup.com\"},\"recommender\":{\"url\":\"https://feverup.com/recommender-api\"},\"socialFollow\":{\"url\":\"https://feverup.com/social-follow/api\"},\"assets\":{\"url\":\"https://assets-api.feverup.com\"},\"favorites\":{\"url\":\"https://feverup.com/favorites/api\"},\"logging\":{\"url\":\"https://data-logging.apigw.feverup.com\"},\"onSite\":{\"url\":\"https://data-interactive-on-site-api.prod.feverup.com\"}},\"tracking\":{\"mixPanel\":{\"id\":\"011f735c90e1cff24697a19cd38bc535\"},\"facebook\":{\"clientId\":\"212044188860269\"},\"gtm\":{\"id\":\"GTM-T2TC8MV\"}},\"monitoring\":{\"datadog\":{\"appId\":\"b86bb398-9995-4a8a-97a2-19ccd790d284\",\"clientToken\":\"pubb79c9281dffaf968f8fee11a238019ca\",\"site\":\"datadoghq.com\",\"environment\":\"production\",\"enabled\":\"true\",\"useSecureSessionCookie\":\"true\",\"sampleRate\":\"4\",\"sessionReplaySampleRate\":\"0\",\"telemetrySampleRate\":\"0\",\"tracingSampleRate\":\"100\",\"trackResources\":\"true\",\"trackLongTasks\":\"true\",\"trackInteractions\":\"true\"}},\"experimentation\":{\"optimizely\":{\"key\":\"DqiQArRZFijaai4G8NfQ1K\"}},\"google\":{\"storeUrl\":\"https://play.google.com/store/apps/details?id=com.feverup.fever\",\"place\":{\"key\":\"AIzaSyAzz5QA02Lmzl-3YQvjiSvOQmsUKLvuSw4\"},\"maps\":{\"key\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Epic Film \\\\u0026 TV Soundtracks - A Candlelit Experience\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"🎵 \\\\u003Cem\\\\u003EThis experience is brought to you by \\\\u003C/em\\\\u003E\\\\u003Cstrong\\\\u003E\\\\u003Cem\\\\u003ECineDuo London\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E. This concert is not affiliated with the Fever Original Candlelight series.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGeneral Info:\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📅 Date: \\\\u003C/strong\\\\u003E13th March\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E⏰ Time: \\\\u003C/strong\\\\u003E6:30 PM – 7:30 PM / 8:30 PM - 9:30 PM (Doors open 30 minutes prior)\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E📍 Location: \\\\u003C/strong\\\\u003EWindsor Parish Church of St John The Baptist, High St, Windsor SL4 1LS\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E👤 Age requirement: \\\\u003C/strong\\\\u003Echildren under 14 must be accompanied by an adult and sit within the same band\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003E🪑 Seating: \\\\u003C/strong\\\\u003Eunallocated seating within seating bands (first come, first served)\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThis is NOT your usual candle concert...\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EOne duo. One experience.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EYoon and Nurry are your international concert soloists for the evening. They\\\\u0026nbsp;\\\\u003Cem\\\\u003Eare\\\\u003C/em\\\\u003E\\\\u0026nbsp;CineDuo – nobody else.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EShow-Stopping Arrangements.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery arrangement is written exclusively for CineDuo by award-winning arranger Stuart Bramwell\\\\u0026nbsp;– and performed by CineDuo alone.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003ESerious\\\\u0026nbsp;Virtuosity.\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EWhat Yoon and Nurry do best. Stuart\\\\u0027s arrangements are\\\\u003Cstrong\\\\u003E\\\\u0026nbsp;REALLY\\\\u0026nbsp;challenging \\\\u003C/strong\\\\u003E– but with\\\\u0026nbsp;big risks\\\\u0026nbsp;come\\\\u0026nbsp;\\\\u003Cstrong\\\\u003EEPIC\\\\u0026nbsp;\\\\u003C/strong\\\\u003Erewards.\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EQuality, not Quantity.﻿\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EEvery month, between rehearsals and arranging, the group spend hundreds of hours preparing just a handful of bespoke concerts per year.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EProgramme\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E:\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EMovie Studio Intro Medley (3’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EPirates of the Caribbean Medley (9’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EJack Sparrow, Davy Jones, The Medallion Calls, He’s a Pirate\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EThemes from The Lord of the Rings (12’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Bill Galiiford\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EAvatar Medley (6’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EBecoming one of “The People”, The bioluminescence of the night,\\\\u003Cbr\\\\u003EClimbing up “Iknimaya – The Path to Heaven”, The destruction of Hometree\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EHow to Train Your Dragon Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThis Is Berk, Romantic Flight, Forbidden Friendship,\\\\u003Cbr\\\\u003ESee You Tomorrow, Test Drive\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGame of Thrones Medley (10’)\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003EArr. Stuart Bramwell\\\\u003Cbr\\\\u003EThe Rains of Castamere, The Winds of Winter,\\\\u003Cbr\\\\u003ELight of the Seven, Opening Credits\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cimg src=\\\\u0022https://images.feverup.com/plan/photo/c2b2c50c-073c-11f1-925c-1af316423b5e.jpeg\\\\u0022\\\\u003E\\\\u003Cbr\\\\u003E\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/1ce6cc18-05b1-11f1-bac3-2642d4033e2a.jpeg\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-confi