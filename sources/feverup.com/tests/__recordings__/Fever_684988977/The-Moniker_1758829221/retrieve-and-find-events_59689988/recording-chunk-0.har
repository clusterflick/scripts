t-children><!--[--><button class=\"fv-plan-favorites-button svelte-y07y4h fv-plan-favorites-button__floating-experiment\" aria-label=\"Save events you love in one place.\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-heart fa-fw svelte-1ipid5s\" viewBox=\"0 0 512 512\"><path fill=\"currentColor\" d=\"M244 130.6l-12-13.5-4.2-4.7c-26-29.2-65.3-42.8-103.8-35.8c-53.3 9.7-92 56.1-92 110.3v3.5c0 32.3 13.4 63.1 37.1 85.1L253 446.8c.8 .7 1.9 1.2 3 1.2s2.2-.4 3-1.2L443 275.5c23.6-22 37-52.8 37-85.1v-3.5c0-54.2-38.7-100.6-92-110.3c-38.5-7-77.8 6.6-103.8 35.8l-4.2 4.7-12 13.5c-3 3.4-7.4 5.4-12 5.4s-8.9-2-12-5.4zm34.9-57.1C311 48.4 352.7 37.7 393.7 45.1C462.2 57.6 512 117.3 512 186.9v3.5c0 36-13.1 70.6-36.6 97.5c-3.4 3.8-6.9 7.5-10.7 11l-184 171.3c-.8 .8-1.7 1.5-2.6 2.2c-6.3 4.9-14.1 7.5-22.1 7.5c-9.2 0-18-3.5-24.8-9.7L47.2 299c-3.8-3.5-7.3-7.2-10.7-11C13.1 261 0 226.4 0 190.4v-3.5C0 117.3 49.8 57.6 118.3 45.1c40.9-7.4 82.6 3.2 114.7 28.4c6.7 5.3 13 11.1 18.7 17.6l4.2 4.7 4.2-4.7c4.2-4.7 8.6-9.1 13.3-13.1c1.8-1.5 3.6-3 5.4-4.5z\" class=\"svelte-1ipid5s\"></path></svg><!----></button><!--]--><!--astro:end--></astro-island> </div> </div> <hr class=\"astro-eulym4nl\"> </div> <script type=\"module\" src=\"/_astro/PlanHeroInfo.astro_astro_type_script_index_0_lang.CF3KGTfm.js\"></script>  </div>  <div id=\"plan-description\" class=\"plan-description astro-4r2zdndd\" data-testid=\"plan-content-description\">⭐ <strong><em>Taste Film</em></strong><em> believes films should be more than just watched—they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.</em><br />\r\n<br />\r\n<strong>Highlights</strong><br />\r\n🎥 Don’t just watch the film… savour it!<br />\r\n🍝 Enjoy a multi-course menu inspired by the film <em>Cloudy with a Chance of Meatballs</em> (2009)<br />\r\n🍴 Dine in sync with iconic on-screen moments<br />\r\n<br />\r\n<strong>General Info</strong><br />\r\n📅 Date: May and June, 2026<br />\r\n🕒 Time: select your time directly in the ticket selector <br />\r\n📍 Location: The Moniker<br />\r\n👤 Age rating: this film is rated U (min. age 5)<br />\r\n♿ Accessibility: the venue is wheelchair accessible<br />\r\n🍽️ The menu: to view the menu, please click <a href=\"https://drive.google.com/file/d/1-v6G2_57K2iVa3pOopQWpYbtuQFnM1_Y/view?usp=sharing\"><u>here</u></a><br />\r\n❓ Please consult the FAQs of this experience <a href=\"http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\"><u>here</u></a><br />\r\n<br />\r\n<strong>Description</strong><br />\r\n<strong>Sunshine, Lollipops and Meatballs?</strong><br />\r\nWant to hear a joke about the weather? Actually…never mind. I'll save it for a rainy day. <br />\r\nReturning after a long dry spell, Taste Film presents Cloudy with a Chance of Meatballs. <br />\r\n<br />\r\n<strong>The Experience</strong><br />\r\nAs the film plays out on screen, you’ll be served a bespoke, cinematic tasting menu inspired by our favourite moments from the film.<br />\r\nExpect science-class DIY cocktails, a meatier shower, a hurricane of spaghetti, and playful surprises along the way. All designed to bring the world of the film straight to your table.<br />\r\nPacked with delicious courses and unexpected twists, this experience invites you to embrace your inner weirdo, get a little chaotic, and remember that it’s okay to be the hero of your own story.</div> <astro-island uid=\"ZqpJIR\" component-url=\"/_astro/HTMLPlanDescriptionExperimentHandler.idEgzVjh.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;planID&quot;:[0,562250],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionExperimentHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"mcIqm\" component-url=\"/_astro/HTMLPlanDescriptionTabsHandler.mFbmXKWW.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionTabsHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"ZB0UNR\" component-url=\"/_astro/HTMLPlanDescriptionLinkTracking.WlW-Qa2O.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;trackableURLs&quot;:[1,[[0,&quot;http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub&quot;]]],&quot;planID&quot;:[0,562250],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionLinkTracking&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island>      <script>(()=>{var a=(s,i,o)=>{let r=async()=>{await(await s())()},t=typeof i.value==\"object\"?i.value:void 0,c={rootMargin:t==null?void 0:t.rootMargin},n=new IntersectionObserver(e=>{for(let l of e)if(l.isIntersecting){n.disconnect(),r();break}},c);for(let e of o.children)n.observe(e)};(self.Astro||(self.Astro={})).visible=a;window.dispatchEvent(new Event(\"astro:visible\"));})();</script><!--[--><section class=\"plan-content__block svelte-vu3cyy\" data-testid=\"plan-content-help\"><!----> <!--[--><h2 class=\"plan-content__block-title svelte-cwjbxa\"><!----> <!--[--><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-user-headset svelte-1ipid5s\" viewBox=\"0 0 448 512\"><path fill=\"currentColor\" d=\"M224 32C135.6 32 64 103.6 64 192v16c0 8.8-7.2 16-16 16s-16-7.2-16-16V192C32 86 118 0 224 0S416 86 416 192v16c0 61.9-50.1 112-112 112H240 224 208c-17.7 0-32-14.3-32-32s14.3-32 32-32h32c17.7 0 32 14.3 32 32h32