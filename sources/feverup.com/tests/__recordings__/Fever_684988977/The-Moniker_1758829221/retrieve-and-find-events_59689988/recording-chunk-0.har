ogging\":{\"url\":\"https://data-logging.apigw.feverup.com\"},\"onSite\":{\"url\":\"https://data-interactive-on-site-api.prod.feverup.com\"}},\"tracking\":{\"mixPanel\":{\"id\":\"011f735c90e1cff24697a19cd38bc535\"},\"facebook\":{\"clientId\":\"212044188860269\"},\"gtm\":{\"id\":\"GTM-T2TC8MV\"}},\"monitoring\":{\"datadog\":{\"appId\":\"b86bb398-9995-4a8a-97a2-19ccd790d284\",\"clientToken\":\"pubb79c9281dffaf968f8fee11a238019ca\",\"site\":\"datadoghq.com\",\"environment\":\"production\",\"enabled\":\"true\",\"useSecureSessionCookie\":\"true\",\"sampleRate\":\"4\",\"sessionReplaySampleRate\":\"0\",\"telemetrySampleRate\":\"0\",\"tracingSampleRate\":\"100\",\"trackResources\":\"true\",\"trackLongTasks\":\"true\",\"trackInteractions\":\"true\"}},\"experimentation\":{\"optimizely\":{\"key\":\"DqiQArRZFijaai4G8NfQ1K\"}},\"google\":{\"storeUrl\":\"https://play.google.com/store/apps/details?id=com.feverup.fever\",\"place\":{\"key\":\"AIzaSyAzz5QA02Lmzl-3YQvjiSvOQmsUKLvuSw4\"},\"maps\":{\"key\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Taste Film presents Cloudy with a Chance of Meatballs (2009)\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"⭐ \\\\u003Cstrong\\\\u003E\\\\u003Cem\\\\u003ETaste Film\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E believes films should be more than just watched—they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n🎥 Don’t just watch the film… savour it!\\\\u003Cbr\\\\u003E\\r\\n🍝 Enjoy a multi-course menu inspired by the film \\\\u003Cem\\\\u003ECloudy with a Chance of Meatballs\\\\u003C/em\\\\u003E (2009)\\\\u003Cbr\\\\u003E\\r\\n🍴 Dine in sync with iconic on-screen moments\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EGeneral Info\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n📅 Date: May and June, 2026\\\\u003Cbr\\\\u003E\\r\\n🕒 Time: select your time directly in the ticket selector\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n📍 Location: The Moniker\\\\u003Cbr\\\\u003E\\r\\n👤 Age rating: this film is rated U (min. age 5)\\\\u003Cbr\\\\u003E\\r\\n♿ Accessibility: the venue is wheelchair accessible\\\\u003Cbr\\\\u003E\\r\\n🍽️ The menu: to view the menu, please click \\\\u003Ca href=\\\\u0022https://drive.google.com/file/d/1-v6G2_57K2iVa3pOopQWpYbtuQFnM1_Y/view?usp=sharing\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003E\\\\u003Cu\\\\u003Ehere\\\\u003C/u\\\\u003E\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n❓ Please consult the FAQs of this experience \\\\u003Ca href=\\\\u0022http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003E\\\\u003Cu\\\\u003Ehere\\\\u003C/u\\\\u003E\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EDescription\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003ESunshine, Lollipops and Meatballs?\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\nWant to hear a joke about the weather? Actually…never mind. I\\\\u0027ll save it for a rainy day.\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\nReturning after a long dry spell, Taste Film presents Cloudy with a Chance of Meatballs.\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EThe Experience\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\nAs the film plays out on screen, you’ll be served a bespoke, cinematic tasting menu inspired by our favourite moments from the film.\\\\u003Cbr\\\\u003E\\r\\nExpect science-class DIY cocktails, a meatier shower, a hurricane of spaghetti, and playful surprises along the way. All designed to bring the world of the film straight to your table.\\\\u003Cbr\\\\u003E\\r\\nPacked with delicious courses and unexpected twists, this experience invites you to embrace your inner weirdo, get a little chaotic, and remember that it’s okay to be the hero of your own story.\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/6365237c-facd-11f0-b2ab-32b2d90b72c8.jpg\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-config\":{\"name\":\"plan\",\"planDetail\":{\"aBTesting\":null,\"accessRules\":[],\"allowMultiSessionPurchase\":true,\"baseLocale\":\"en-GB\",\"category\":\"mix\",\"cityAvailableLocales\":[\"en-GB\",\"es-ES\"],\"cityCountryIsoCode\":\"UK\",\"citySlug\":\"london\",\"citySlugLanguage\":\"en\",\"cityStandardId\":1006886,\"coverImage\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/6365237c-facd-11f0-b2ab-32b2d90b72c8.jpg\",\"customLabel\":{\"backgroundColor\":\"#6f41d7\",\"text\":\"Fever exclusive\",\"textColor\":\"#ffffff\"},\"defaultLevelDisplay\":\"disabled\",\"defaultPlace\":{\"address\":\"25 Fenchurch Ave, London, EC3M 5AD\",\"hasPlacePage\":true,\"hidden\":false,\"id\":107491,\"latitude\":51.51276679999999,\"locale\":\"en\",\"longitude\":-0.08078779999999999,\"metroStations\":[],\"name\":\"The Moniker\",\"signedMapUrl\":\"https://applications-media.feverup.com/image/upload/f_auto