r\",\"imageSrcDark\":\"/logo/fever-logo-black.svg\"},\"hideLoyalty\":false,\"hideWorkWithUs\":false,\"notSupportedMobileApp\":false,\"liveYourCityLink\":{\"translationKey\":\"footer.links.liveYourCity\",\"href\":\"https://liveyourcity.com/\"},\"abuDhabiLink\":{\"translationKey\":\"footer.links.abuDhabi\",\"href\":\"https://feverup.com/en/abu-dhabi\"},\"appId\":\"5298284f-8a33-4269-99a6-bff6979dd27e\",\"appVersion\":\"4e929b3\",\"api\":{\"search\":{\"url\":\"https://data-search.apigw.feverup.com\"},\"services\":{\"url\":\"https://feverup.com\"},\"recommender\":{\"url\":\"https://feverup.com/recommender-api\"},\"socialFollow\":{\"url\":\"https://feverup.com/social-follow/api\"},\"assets\":{\"url\":\"https://assets-api.feverup.com\"},\"favorites\":{\"url\":\"https://feverup.com/favorites/api\"},\"logging\":{\"url\":\"https://data-logging.apigw.feverup.com\"},\"onSite\":{\"url\":\"https://data-interactive-on-site-api.prod.feverup.com\"}},\"tracking\":{\"mixPanel\":{\"id\":\"011f735c90e1cff24697a19cd38bc535\"},\"facebook\":{\"clientId\":\"212044188860269\"},\"gtm\":{\"id\":\"GTM-T2TC8MV\"}},\"monitoring\":{\"datadog\":{\"appId\":\"b86bb398-9995-4a8a-97a2-19ccd790d284\",\"clientToken\":\"pubb79c9281dffaf968f8fee11a238019ca\",\"site\":\"datadoghq.com\",\"environment\":\"production\",\"enabled\":\"true\",\"useSecureSessionCookie\":\"true\",\"sampleRate\":\"4\",\"sessionReplaySampleRate\":\"0\",\"telemetrySampleRate\":\"0\",\"tracingSampleRate\":\"100\",\"trackResources\":\"true\",\"trackLongTasks\":\"true\",\"trackInteractions\":\"true\"}},\"experimentation\":{\"optimizely\":{\"key\":\"DqiQArRZFijaai4G8NfQ1K\"}},\"google\":{\"storeUrl\":\"https://play.google.com/store/apps/details?id=com.feverup.fever\",\"place\":{\"key\":\"AIzaSyAzz5QA02Lmzl-3YQvjiSvOQmsUKLvuSw4\"},\"maps\":{\"key\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Taste Film presents White Chicks (2004)\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"⭐\\\\u003Cstrong\\\\u003E \\\\u003Cem\\\\u003ETaste Film\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E believes films should be more than just watched—they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n🎥 Don’t just watch the film… savour it!\\\\u003Cbr\\\\u003E\\r\\n🚨 Enjoy a multi-course menu inspired by the film \\\\u003Cem\\\\u003EWhite Chicks\\\\u003C/em\\\\u003E (2004)\\\\u003Cbr\\\\u003E\\r\\n🍴 Dine in sync with iconic on-screen moments\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EGeneral Info\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n📅 Date: April and May, 2026\\\\u003Cbr\\\\u003E\\r\\n🕒 Time: select your time directly in the ticket selector\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n📍 Location: The Moniker\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n👤 Age rating: this film is rated 15 (min. age 15)\\\\u003Cbr\\\\u003E\\r\\n♿ Accessibility: the venue is wheelchair accessible\\\\u003Cbr\\\\u003E\\r\\n🍽️ The menu: to view the menu, please click \\\\u003Ca href=\\\\u0022https://drive.google.com/file/d/1eiG_07h6ieqepyskuxnNNyg7_40iVS4Q/view?usp=drive_link\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n❓ Please consult the FAQs of this experience \\\\u003Ca href=\\\\u0022http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EDescription\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\nWe’re going (skin)-deep undercover for our next screening… White Chicks is BACK. Naughty and noughties? Say less. We’re bringing back a fan-favourite experience, bigger, bolder, and more elevated than ever. Bring your friends, bring a date, this is not your average movie night.\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nExpecting a salad? Perhaps not. As the film plays, you’ll be served a DIY Neapolitan shot, iconic cheese hors d’oeuvres (IYKYK), a steak date you won’t forget, and plenty more surprises along the way.\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nThis one’s outrageous, indulgent, and very 2004. Nostalgia overload.\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nWe can’t FRICKIN’ WAIT.\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/4cce61b8-fac9-11f0-8364-c6b2232abd39.jpg\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-config\":{\"name\":\"plan\",\"planDetail\":{\"aBTesting\":null,\"accessRules\":[],\"allowMultiSessionPurchase\":true,\"baseLocale\":\"en-GB\",\"category\":\"mix\",\"cityAvailableLocales\":[\"en-GB\",\"es-ES\"],\"cityCountryIsoCode\":\"UK\",\"citySlug\":\"london\",\"citySlugLanguage\":\"en\",\"cityStandardId\":1006886,\"coverImage\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/4cce61b8-fac9-11f0-8364-c6b2232abd39.jpg\",\"customLabel\":{\"backgroundColor\":\"#6f41d7\",\"text\":\"Fever exclusive\",\"textColor\":\"#ffffff\"},\"defaultLevelDisplay\":\"disabled\",\"defaultPlace\":{\"address\":\"25 Fenchurch Ave, London, EC3M 5AD\",\"hasPlacePage\":true,\"hidden\":false,\"id\":107491,\"latitude\":51.51276679999999,\"locale\":\"en\",\"longitude\":-0.08078779999999999,\"metroStations\":[],\"name\":\"The Moniker\",\"signedMapUrl\":\"https://applications-media.feverup.com/image/upload/f_auto/fever2/place/maps/107491__51.51276679999999_-0.08078779999999999.png\",\"slug\":\"the-moniker\"},\"defaultSession\":{\"attendText\":\"Join in!\",\"availableTickets\":8,\"currency\":\"GBP\",\"endsAtIso\":\"2026-04-25T17:00:00+01:00\",\"expirationIso\":\"2026-04-23T15:00:00+01:00\",\"hasAvailableTickets\":true,\"id\":373458921,\"label\":\"Classic with cocktail\",\"maxNumTickets\":8,\"minNumTickets\":1,\"placeId\":107491,\"price\":82.5,\"startsAtIso\":\"2026-04-25T14:00:00+01:00\",\"surchargePerTicket\":3.3},\"description\":\"⭐\\\\u003Cstrong\\\\u003E \\\\u003Cem\\\\u003ETaste Film\\\\u003C/em\\\\u003E\\\\u003C/strong\\\\u003E\\\\u003Cem\\\\u003E believes films should be more than just watched—they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n🎥 Don’t just watch the film… savour it!\\\\u003Cbr\\\\u003E\\r\\n🚨 Enjoy a multi-course menu inspired by the film \\\\u003Cem\\\\u003EWhite Chicks\\\\u003C/em\\\\u003E (2004)\\\\u003Cbr\\\\u003E\\r\\n🍴 Dine in sync with iconic on-screen moments\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EGeneral Info\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n📅 Date: April and May, 2026\\\\u003Cbr\\\\u003E\\r\\n🕒 Time: select your time directly in the ticket selector\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n📍 Location: The Moniker\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n👤 Age rating: this film is rated 15 (min. age 15)\\\\u003Cbr\\\\u003E\\r\\n♿ Accessibility: the venue is wheelchair accessible\\\\u003Cbr\\\\u003E\\r\\n🍽️ The menu: to view the menu, please click \\\\u003Ca href=\\\\u0022https://drive.google.com/file/d/1eiG_07h6ieqepyskuxnNNyg7_40iVS4Q/view?usp=drive_link\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n❓ Please consult the FAQs of this experience \\\\u003Ca href=\\\\u0022http://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cstrong\\\\u003EDescription\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E\\r\\nWe’re going (skin)-deep undercover for our next screening… White Chicks is BACK. Naughty and noughties? Say less. We’re bringing back a fan-favourite experience, bigger, bolder, and more elevated than ever. Bring your friends, bring a date, this is not your average movie night.\\\\u0026nbsp;\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nExpecting a salad? Perhaps not. As the film plays, you’ll be served a DIY Neapolitan shot, iconic cheese hors d’oeuvres (IYKYK), a steak date you won’t forget, and plenty more surprises along the way.\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nThis one’s outrageous, indulgent, and very 2004. Nostalgia overload.\\\\u003Cbr\\\\u003E\\r\\n\\\\u003Cbr\\\\u003E\\r\\nWe can’t FRICKIN’ WAIT.\",\"enableImageTestExperiment\":false,\"faqId\":null,\"firstActiveSessionDate\":\"2026-04-25T14:00:00+01:00\",\"firstSessionDate\":\"2026-04-25T14:00:00+01:00\",\"gallery\":[\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/4cce61b8-fac9-11f0-8364-c6b2232abd39.jpg\"],\"hasAddOns\":false,\"hasSeasons\":false,\"hasShopProducts\":false,\"id\":562253,\"is