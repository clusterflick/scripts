stro-eulym4nl&quot;]}\" ssr client=\"idle\" opts=\"{&quot;name&quot;:&quot;PlanFavoriteButton&quot;,&quot;value&quot;:true}\" await-children><!--[--><button class=\"fv-plan-favorites-button svelte-y07y4h fv-plan-favorites-button__floating-experiment\" aria-label=\"Save events you love in one place.\"><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-heart fa-fw svelte-1ipid5s\" viewBox=\"0 0 512 512\"><path fill=\"currentColor\" d=\"M244 130.6l-12-13.5-4.2-4.7c-26-29.2-65.3-42.8-103.8-35.8c-53.3 9.7-92 56.1-92 110.3v3.5c0 32.3 13.4 63.1 37.1 85.1L253 446.8c.8 .7 1.9 1.2 3 1.2s2.2-.4 3-1.2L443 275.5c23.6-22 37-52.8 37-85.1v-3.5c0-54.2-38.7-100.6-92-110.3c-38.5-7-77.8 6.6-103.8 35.8l-4.2 4.7-12 13.5c-3 3.4-7.4 5.4-12 5.4s-8.9-2-12-5.4zm34.9-57.1C311 48.4 352.7 37.7 393.7 45.1C462.2 57.6 512 117.3 512 186.9v3.5c0 36-13.1 70.6-36.6 97.5c-3.4 3.8-6.9 7.5-10.7 11l-184 171.3c-.8 .8-1.7 1.5-2.6 2.2c-6.3 4.9-14.1 7.5-22.1 7.5c-9.2 0-18-3.5-24.8-9.7L47.2 299c-3.8-3.5-7.3-7.2-10.7-11C13.1 261 0 226.4 0 190.4v-3.5C0 117.3 49.8 57.6 118.3 45.1c40.9-7.4 82.6 3.2 114.7 28.4c6.7 5.3 13 11.1 18.7 17.6l4.2 4.7 4.2-4.7c4.2-4.7 8.6-9.1 13.3-13.1c1.8-1.5 3.6-3 5.4-4.5z\" class=\"svelte-1ipid5s\"></path></svg><!----></button><!--]--><!--astro:end--></astro-island> </div> </div> <hr class=\"astro-eulym4nl\"> </div> <script type=\"module\" src=\"/_astro/PlanHeroInfo.astro_astro_type_script_index_0_lang.CF3KGTfm.js\"></script>  </div>  <div id=\"plan-description\" class=\"plan-description astro-4r2zdndd\" data-testid=\"plan-content-description\">⭐ <em>Taste Film believes films should be more than just watched - they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.</em><br /><br /><strong>Highlights</strong><br /> 🎥 Don’t just watch the film… savour it!<br /> 🐸 Enjoy a multi-course menu inspired by the film The Princess and The Frog (2009)<br /> 🍴 Dine in sync with iconic on-screen moments<br /><br /><strong>General Info</strong><br /> 📅 Date: April 2026<br /> 🕐 Time: Please check your booking for specific event times.<br /> 📍 Location: Parlour, NW10 5LG<br /> 👤 Age rating: this film is <a href=\"https://www.bbfc.co.uk/release/the-princess-and-the-frog-q29sbgvjdglvbjpwwc00mjiwnzq\">rated U</a> (minimum age 5)<br /> ♿ Accessibility: This venue is not wheelchair accessible<br /> 🍽️ The menu: to view the menu, please click <a href=\"https://drive.google.com/file/d/1TwiKUN0quJtE33iT65z7ejYcRR5FVooV/view\">here</a><br /> ❓ Please consult the FAQs of this experience <a href=\"https://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\">here</a><br />💡When availability is low, please be aware that single tickets are left still purchasable<br /><br /><strong>Description</strong><br /> ✨ From gumbo to beignets, we’re serving up Southern-inspired soul with a side of sparkle. No voodoo here, just big dreams, bold flavours, and a sprinkle of bayou enchantment.<br /><br /> 💫 Back by popular demand and bigger than ever, this sell-out favourite is getting the VIP treatment at Parlour with a premium menu. More courses. More cocktails. More movie magic.<br /><br /> 🎷 It’s food. It’s film. It’s full-on New Orleans Mardi Gras, but in Kensal Green.<br /><br /> Taste Film presents The Princess and the Frog, in collaboration with Parlour.<br /><br /> This one's for the dreamers, the romantics, and anyone who knows good food is worth wishing for.<br /><br /> 🐸 Hop to it, these tickets aren’t waiting around<br /></div> <astro-island uid=\"Z1I9JcI\" component-url=\"/_astro/HTMLPlanDescriptionExperimentHandler.idEgzVjh.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;planID&quot;:[0,569989],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionExperimentHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"mcIqm\" component-url=\"/_astro/HTMLPlanDescriptionTabsHandler.mFbmXKWW.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionTabsHandler&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island> <astro-island uid=\"Z1iEPdp\" component-url=\"/_astro/HTMLPlanDescriptionLinkTracking.WlW-Qa2O.js\" component-export=\"default\" renderer-url=\"/_astro/client.svelte.CPQfNHU-.js\" props=\"{&quot;trackableURLs&quot;:[1,[[0,&quot;https://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub&quot;]]],&quot;planID&quot;:[0,569989],&quot;class&quot;:[0,&quot;astro-4r2zdndd&quot;]}\" ssr client=\"only\" opts=\"{&quot;name&quot;:&quot;HTMLPlanDescriptionLinkTracking&quot;,&quot;value&quot;:&quot;svelte&quot;}\"></astro-island>      <script>(()=>{var a=(s,i,o)=>{let r=async()=>{await(await s())()},t=typeof i.value==\"object\"?i.value:void 0,c={rootMargin:t==null?void 0:t.rootMargin},n=new IntersectionObserver(e=>{for(let l of e)if(l.isIntersecting){n.disconnect(),r();break}},c);for(let e of o.children)n.observe(e)};(self.Astro||(self.Astro={})).visible=a;window.dispatchEvent(new Event(\"astro:visible\"));})();</script><!--[--><section class=\"plan-content__block svelte-vu3cyy\" data-testid=\"plan-content-help\"><!----> <!--[--><h2 class=\"plan-content__block-title svelte-cwjbxa\"><!----> <!--[--><svg xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\" focusable=\"false\" class=\"svg-inline--fa fa-user-headset svelte-1ipid5s\" viewBox=\"0 0 448 512\"><path fill=\"currentColor\" d=\"M224 32C135.6 32 64 103.6 64 192v16c0 8.8-7.2 16-16 16s-16-7.2-16-16V192C32 86 118 0 224 0S416 86 416 192v16