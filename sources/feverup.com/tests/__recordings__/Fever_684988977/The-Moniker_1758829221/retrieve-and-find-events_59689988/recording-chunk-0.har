\":\"AIzaSyDMs02xUjIR6VWW_5Z8XAuLOmRX7HxvlLI\"}},\"queue\":{\"queueIt\":{\"account\":\"feverup\"},\"queuedPlans\":\"\",\"comingSoonPlans\":\"\"},\"fraudDetection\":{\"riskified\":{\"shopDomain\":\"feverup.com\"},\"forter\":{\"siteId\":\"039249618c32\"}}},\"plan-ab-tests\":[{\"value\":\"Taste Film presents The Princess and The Frog (2009)\",\"storedData\":{\"key\":\"fv_plan_name_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"name\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"⭐ \\\\u003Cem\\\\u003ETaste Film believes films should be more than just watched - they should be lived, shared, and tasted. Get ready to embark on a journey where fine food and iconic film moments collide, transforming your night out into an unforgettable adventure.\\\\u003C/em\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EHighlights\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E 🎥 Don’t just watch the film… savour it!\\\\u003Cbr\\\\u003E 🐸 Enjoy a multi-course menu inspired by the film The Princess and The Frog (2009)\\\\u003Cbr\\\\u003E 🍴 Dine in sync with iconic on-screen moments\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EGeneral Info\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E 📅 Date: April 2026\\\\u003Cbr\\\\u003E 🕐 Time: Please check your booking for specific event times.\\\\u003Cbr\\\\u003E 📍 Location: Parlour, NW10 5LG\\\\u003Cbr\\\\u003E 👤 Age rating: this film is \\\\u003Ca href=\\\\u0022https://www.bbfc.co.uk/release/the-princess-and-the-frog-q29sbgvjdglvbjpwwc00mjiwnzq\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Erated U\\\\u003C/a\\\\u003E (minimum age 5)\\\\u003Cbr\\\\u003E ♿ Accessibility: This venue is not wheelchair accessible\\\\u003Cbr\\\\u003E 🍽️ The menu: to view the menu, please click \\\\u003Ca href=\\\\u0022https://drive.google.com/file/d/1TwiKUN0quJtE33iT65z7ejYcRR5FVooV/view\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E ❓ Please consult the FAQs of this experience \\\\u003Ca href=\\\\u0022https://docs.google.com/document/d/e/2PACX-1vSp2K6XG_QIZ2Gg_zrZb2xW9_xXjZJUPTPFAstXgmSUJavlcRlINfSLSKiSYT1VBfylMThAsmy0Fqjs/pub\\\\u0022 rel=\\\\u0022noopener noreferrer\\\\u0022\\\\u003Ehere\\\\u003C/a\\\\u003E\\\\u003Cbr\\\\u003E💡When availability is low, please be aware that single tickets are left still purchasable\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E\\\\u003Cstrong\\\\u003EDescription\\\\u003C/strong\\\\u003E\\\\u003Cbr\\\\u003E ✨ From gumbo to beignets, we’re serving up Southern-inspired soul with a side of sparkle. No voodoo here, just big dreams, bold flavours, and a sprinkle of bayou enchantment.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E 💫 Back by popular demand and bigger than ever, this sell-out favourite is getting the VIP treatment at Parlour with a premium menu. More courses. More cocktails. More movie magic.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E 🎷 It’s food. It’s film. It’s full-on New Orleans Mardi Gras, but in Kensal Green.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E Taste Film presents The Princess and the Frog, in collaboration with Parlour.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E This one\\\\u0027s for the dreamers, the romantics, and anyone who knows good food is worth wishing for.\\\\u003Cbr\\\\u003E\\\\u003Cbr\\\\u003E 🐸 Hop to it, these tickets aren’t waiting around\\\\u003Cbr\\\\u003E\",\"storedData\":{\"key\":\"fv_plan_description_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"description\"},\"isVariant\":false,\"allowUnsafeHtml\":false},{\"value\":\"https://applications-media.feverup.com/image/upload/f_auto,w_720,h_720/fever2/plan/photo/2935f738-05c4-11f1-906b-4aca0ffde141.jpg\",\"storedData\":{\"key\":\"fv_plan_cover_image_ab_test\",\"value\":{}},\"trackingData\":{\"field\":\"cover_image\"},\"isVariant\":false,\"allowUnsafeHtml\":false}],\"page-config\":{\"name\":\"plan\",\"planDetail\":{\"aBTesting\":null,\"accessRules\":[],\"allowMultiSessionPurchase\":true,\"baseLocale\":