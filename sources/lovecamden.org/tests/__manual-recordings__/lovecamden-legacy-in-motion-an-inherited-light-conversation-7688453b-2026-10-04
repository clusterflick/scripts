        {
          "textAlign": 139
        },
        [
          733
        ],
        {
          "text": 734,
          "type": 80
        },
        "Quarterly meetings",
        {
          "type": 728,
          "content": 736
        },
        [
          737
        ],
        {
          "type": 76,
          "attrs": 738,
          "content": 739
        },
        {
          "textAlign": 139
